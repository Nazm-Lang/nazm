// A WebAssembly module (`wasm32-unknown-unknown`). Its authority is its imports: printing is
// `nz.host_write`, which the generated `build/host.mjs` provides.
//
//     nazm build --target wasm32-unknown-unknown . --objects build
//     then link and run as build/link.txt says
use "fib.nz";

fn main(io: IoCap) -> Int ! { io } {
    print("hello from wasm\n");
    // A module with no operating system formats no integer; it says what it computed in text
    // it already has, and ends with status 0.
    if fib(20) == 6765 {
        print("fib(20) is 6765\n");
    } else {
        print("fib(20) is not 6765\n");
    }
    0
}
