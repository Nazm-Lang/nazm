// `@std/dist` in one process: the `Local` transport to a node task, a lost answer timing out
// through `select`, and `retry` asking again with the same idempotency key, which the node answers
// without applying twice. And a frame, encoded and decoded.
use "@std/dist";
use "@std/hash";
use "@std/hashmap";
use "@std/io";

/// A node that adds each request's body to a total once per key, and loses its first answer to key 2.
fn node(requests: Chan[Msg], answers: Chan[Msg]) -> Int ! {} {
    let applied = hashmap_new[Int, Int]();
    let got = vec_new[Msg]();
    let mut total = 0;
    let mut lost = false;
    while chan_recv_of(requests, got) {
        let m = vec_pop(got);
        if m.kind == 9 {
            chan_close_of(answers);
            return 0;
        }
        let answer = match hashmap_get(applied, m.key) {
            Option.Some(value: b) => b,
            Option.None() => {
                total = total + str_len(m.body);
                hashmap_set(applied, m.key, total);
                total
            },
        };
        if m.key == 2 && !lost {
            lost = true;
        } else {
            chan_send_of(answers, Msg(from: "node", key: m.key, kind: 2, body: int_to_str(answer)));
        }
    }
    0
}

fn main(io: IoCap, net: NetCap, time: TimeCap, t: SpawnCap) -> Int ! { io, spawn } {
    let requests = chan_new_of[Msg](4);
    let answers = chan_new_of[Msg](4);
    let to = Local(requests: requests, answers: answers);
    scope {
        spawn node(requests, answers);
        let mut k = 1;
        while k <= 3 {
            let m = Msg(from: "main", key: k, kind: 1, body: "abc");
            match retry(to, net, time, m, 4, 10, 100) {
                Result.Ok(value: a) => { io_println(io, str_concat(str_concat(int_to_str(k), " -> "), a.body)); },
                Result.Err(error: e) => { io_println(io, e); },
            };
            k = k + 1;
        }
        // One ask, no retry, to a key whose answer is lost no more: answered at once.
        match to.ask(net, time, Msg(from: "main", key: 2, kind: 1, body: "abc"), 100) {
            Result.Ok(value: a) => { io_println(io, str_concat("again 2 -> ", a.body)); },
            Result.Err(error: e) => { io_println(io, e); },
        };
        chan_send_of(requests, Msg(from: "main", key: 0, kind: 9, body: ""));
    }
    // A frame: its length, then its fields; and a payload that is not one, refused.
    let frame = msg_encode(Msg(from: "a", key: 7, kind: 1, body: "hello"));
    let payload = bytes_slice(frame, 4, bytes_len(frame));
    match msg_decode(payload) {
        Result.Ok(value: m) => { io_println(io, str_concat(str_concat(m.from, " "), m.body)); },
        Result.Err(error: e) => { io_println(io, e); },
    };
    match msg_decode(bytes_slice(payload, 0, 6)) {
        Result.Ok(value: m) => { io_println(io, "decoded a torn frame"); },
        Result.Err(error: e) => { io_println(io, "a torn frame is refused"); },
    };
    io_println(io, str_concat("frame bytes ", int_to_str(bytes_len(frame))));
    0
}
