// A frame larger than a page: on Windows its probe is the platform's `___chkstk_ms`, which commits
// the stack page by page, and never a function named after LLVM's inline probe.

fn big_frame(n: Int) -> Int {
    let a: [Int; 2000] = [0; 2000]
    let mut b = a
    let mut i = 0
    while i < 2000 {
        b[i] = i * n
        i += 1
    }
    b[1999] + b[3] + a[5]
}

fn main() {
    println(big_frame(3))
    println(big_frame(-2))
}
