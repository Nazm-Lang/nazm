fn worker(out: Chan, n: Int) -> Int {
    if chan_send(out, n) { 1 } else { 0 }
}
fn main(tasks: SpawnCap) -> Int {
    let out = chan_new(8);
    let mut i = 0;
    while i < 3 {
        i = i + 1;
        scope {
            spawn worker(out, if i == 2 { continue; } else { i });
        }
    }
    i
}
