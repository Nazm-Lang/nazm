// `@std/env`: the process's environment (Gate 2).
//
// Imported with `use "@std/env";`. The environment is the outside world's, as the arguments are,
// so every function takes the `IoCap` that allows it. Its entries are in the order the process
// holds them; an entry with no `=` after its first byte is not one. `docs/internal/general-purpose.md` §12.

/// The value of the variable `name`, or `None` when it is not set.
pub fn env_get(io: IoCap, name: Str) -> Option[Str] ! { io } {
    if os_env_has(name) { Option[Str].Some(value: os_env_get(name)) } else { Option[Str].None() }
}

/// Every entry, `NAME=value`, in the environment's order.
pub fn env_vars(io: IoCap) -> Strs ! { io } {
    let out = strs_new();
    let mut i = 0;
    while i < os_env_count() {
        strs_push(out, os_env_at(i));
        i = i + 1;
    }
    out
}
