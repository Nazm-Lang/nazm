// `@std/linalg`: small fixed vectors and matrices over `Float64` (Gate 3).
//
// Imported with `use "@std/linalg";`. The vector maths a control loop needs — three components, a
// 3×3 matrix, their products — as values: nothing allocates, so it runs on a board without a heap
// and under `no-heap`. Every operation is the arithmetic operators and `float_sqrt`, each correctly
// rounded, so a result is the same on every host and under `no-float-nondeterminism`.
// `docs/systems-domains.md` Parts E–J.

/// A vector of three components.
pub struct Vec3 {
    x: Float64,
    y: Float64,
    z: Float64,
}

/// A 3×3 matrix, by rows.
pub struct Mat3 {
    r0: Vec3,
    r1: Vec3,
    r2: Vec3,
}

/// The vector `(x, y, z)`.
pub fn vec3(x: Float64, y: Float64, z: Float64) -> Vec3 ! {} {
    Vec3(x: x, y: y, z: z)
}

/// `a + b`.
pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 ! {} {
    Vec3(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)
}

/// `a - b`.
pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 ! {} {
    Vec3(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)
}

/// `a` times the number `k`.
pub fn vec3_scale(a: Vec3, k: Float64) -> Vec3 ! {} {
    Vec3(x: a.x * k, y: a.y * k, z: a.z * k)
}

/// The dot product of `a` and `b`.
pub fn vec3_dot(a: Vec3, b: Vec3) -> Float64 ! {} {
    a.x * b.x + a.y * b.y + a.z * b.z
}

/// The length of `a`.
pub fn vec3_norm(a: Vec3) -> Float64 ! {} {
    float_sqrt(vec3_dot(a, a))
}

/// `a`, made no longer than `limit` by scaling it down where it is longer: how an actuator's
/// command is bounded.
pub fn vec3_clamp(a: Vec3, limit: Float64) -> Vec3 ! {} {
    let n = vec3_norm(a);
    if n > limit { vec3_scale(a, limit / n) } else { a }
}

/// The matrix whose rows are `r0`, `r1` and `r2`.
pub fn mat3(r0: Vec3, r1: Vec3, r2: Vec3) -> Mat3 ! {} {
    Mat3(r0: r0, r1: r1, r2: r2)
}

/// The identity matrix.
pub fn mat3_identity() -> Mat3 ! {} {
    mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0))
}

/// `m` applied to `v`.
pub fn mat3_apply(m: Mat3, v: Vec3) -> Vec3 ! {} {
    vec3(vec3_dot(m.r0, v), vec3_dot(m.r1, v), vec3_dot(m.r2, v))
}

/// The transpose of `m`.
pub fn mat3_transpose(m: Mat3) -> Mat3 ! {} {
    mat3(
        vec3(m.r0.x, m.r1.x, m.r2.x),
        vec3(m.r0.y, m.r1.y, m.r2.y),
        vec3(m.r0.z, m.r1.z, m.r2.z),
    )
}

/// The product `a · b`.
pub fn mat3_mul(a: Mat3, b: Mat3) -> Mat3 ! {} {
    let t = mat3_transpose(b);
    mat3(mat3_apply(t, a.r0), mat3_apply(t, a.r1), mat3_apply(t, a.r2))
}
