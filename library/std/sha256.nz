// `@std/sha256`: SHA-256, as FIPS 180-4 defines it (R1e, S1).
//
// Imported with `use "@std/sha256";`. `sha256(data)` is the 32-byte digest of a whole buffer;
// `sha256_new`, `sha256_update` and `sha256_finish` give the same digest of data that arrives in
// pieces, whatever the pieces. A hasher is a handle, shared like a `Vec`: an update through one
// copy is seen through every copy. `sha256_finish` pads a copy of what is buffered, so it leaves
// the hasher as it was — more may be added and finished again. Pure Nazm over 32-bit wrapping
// arithmetic and rotations; held to FIPS 180-4's examples (`crates/nazm-cli/tests/hash_vectors.rs`).

/// An incremental SHA-256 hasher.
pub struct Sha256 {
    // The eight state words, big-endian.
    state: Bytes,
    // The block being filled.
    block: Bytes,
    // How many bytes `block` holds, then how many the hasher has been given in all.
    counts: Ints,
}

const K: [UInt32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const H0: [UInt32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// A new hasher, given nothing yet.
pub fn sha256_new() -> Sha256 ! {} {
    let state = bytes_new(32);
    let h = H0;
    for i in 0..8 {
        bytes_write_be(state, 4 * i, h[i]);
    }
    let counts = ints_new();
    ints_push(counts, 0);
    ints_push(counts, 0);
    Sha256(state: state, block: bytes_new(64), counts: counts)
}

// One 64-byte block, `block[at..at + 64]`, into `state`.
fn compress(state: Bytes, block: Bytes, at: Int) -> Int ! {} {
    let k = K;
    let mut w = [UInt32(0); 64];
    for t in 0..16 {
        w[t] = bytes_read_be[UInt32](block, at + 4 * t);
    }
    for t in 16..64 {
        let x = w[t - 15];
        let y = w[t - 2];
        let s0 = rotate_right(x, 7) ^ rotate_right(x, 18) ^ (x >> 3);
        let s1 = rotate_right(y, 17) ^ rotate_right(y, 19) ^ (y >> 10);
        w[t] = wrapping_add(wrapping_add(w[t - 16], s0), wrapping_add(w[t - 7], s1));
    }
    let mut a = bytes_read_be[UInt32](state, 0);
    let mut b = bytes_read_be[UInt32](state, 4);
    let mut c = bytes_read_be[UInt32](state, 8);
    let mut d = bytes_read_be[UInt32](state, 12);
    let mut e = bytes_read_be[UInt32](state, 16);
    let mut f = bytes_read_be[UInt32](state, 20);
    let mut g = bytes_read_be[UInt32](state, 24);
    let mut h = bytes_read_be[UInt32](state, 28);
    for t in 0..64 {
        let big1 = rotate_right(e, 6) ^ rotate_right(e, 11) ^ rotate_right(e, 25);
        let ch = (e & f) ^ (~e & g);
        let t1 = wrapping_add(wrapping_add(wrapping_add(h, big1), wrapping_add(ch, k[t])), w[t]);
        let big0 = rotate_right(a, 2) ^ rotate_right(a, 13) ^ rotate_right(a, 22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = wrapping_add(big0, maj);
        h = g;
        g = f;
        f = e;
        e = wrapping_add(d, t1);
        d = c;
        c = b;
        b = a;
        a = wrapping_add(t1, t2);
    }
    add_word(state, 0, a);
    add_word(state, 4, b);
    add_word(state, 8, c);
    add_word(state, 12, d);
    add_word(state, 16, e);
    add_word(state, 20, f);
    add_word(state, 24, g);
    add_word(state, 28, h);
    0
}

fn add_word(state: Bytes, at: Int, v: UInt32) -> Int ! {} {
    bytes_write_be(state, at, wrapping_add(bytes_read_be[UInt32](state, at), v))
}

/// Give the hasher `data`, after whatever it was given before: `0`.
pub fn sha256_update(h: Sha256, data: Bytes) -> Int ! {} {
    let n = bytes_len(data);
    let mut held = ints_get(h.counts, 0);
    let mut at = 0;
    // Fill a partly filled block first.
    if held > 0 {
        let take = if n < 64 - held { n } else { 64 - held };
        bytes_copy(bytes_slice(h.block, held, held + take), bytes_slice(data, 0, take));
        held = held + take;
        at = take;
        if held == 64 {
            compress(h.state, h.block, 0);
            held = 0;
        }
    }
    // Whole blocks straight from `data`.
    while n - at >= 64 {
        compress(h.state, data, at);
        at = at + 64;
    }
    // What is left waits for more.
    if at < n {
        bytes_copy(bytes_slice(h.block, held, held + n - at), bytes_slice(data, at, n));
        held = held + n - at;
    }
    ints_set(h.counts, 0, held);
    ints_set(h.counts, 1, ints_get(h.counts, 1) + n);
    0
}

/// The digest of everything the hasher has been given: 32 bytes. The hasher is unchanged.
pub fn sha256_finish(h: Sha256) -> Bytes ! {} {
    let state = bytes_new(32);
    bytes_copy(state, h.state);
    let held = ints_get(h.counts, 0);
    let bits = wrap_convert[UInt64](ints_get(h.counts, 1)) << 3;
    // The held bytes, a one bit, zeros, and the length in bits as a big-endian 64-bit number:
    // one block, or two when fewer than nine bytes are free.
    let blocks = if held < 56 { 1 } else { 2 };
    let tail = bytes_new(64 * blocks);
    bytes_copy(tail, bytes_slice(h.block, 0, held));
    bytes_set(tail, held, UInt8(0x80));
    bytes_write_be(tail, 64 * blocks - 8, bits);
    for i in 0..blocks {
        compress(state, tail, 64 * i);
    }
    state
}

/// The SHA-256 digest of `data`: 32 bytes.
pub fn sha256(data: Bytes) -> Bytes ! {} {
    let h = sha256_new();
    sha256_update(h, data);
    sha256_finish(h)
}

/// The SHA-256 digest of `data` as 64 lower-case hexadecimal digits.
pub fn sha256_hex(data: Bytes) -> Str ! {} {
    let digest = sha256(data);
    let digits = "0123456789abcdef";
    let out = bytes_new(64);
    for i in 0..32 {
        let b = Int(bytes_get(digest, i));
        bytes_set(out, 2 * i, UInt8(str_byte(digits, b >> 4)));
        bytes_set(out, 2 * i + 1, UInt8(str_byte(digits, b & 15)));
    }
    bytes_to_str(out)
}
