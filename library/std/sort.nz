// `@std/sort`: sorting the built-in sequences.
//
// Imported with `use "@std/sort";`. Its own module rather than `@std/seq`'s because a sort
// allocates in a loop and calls its ordering through a function value: a restriction profile
// that refuses either (`embedded`) refuses every function of a module it imports, and a
// program that only searches and sums a sequence should not be refused for a sort it never
// calls.

use "@std/hash";
use "@std/hashmap";

/// A new vector holding `xs` sorted by `less`, which says whether its first argument sorts before
/// its second. Stable: elements `less` holds neither way keep their order. A bottom-up merge
/// sort — at most `n log n` calls of `less` — doing exactly what `less` does, so it is
/// polymorphic in its effects. `xs` is unchanged.
pub fn vec_sort_by[T, effects E](xs: Vec[T], less: fn(T, T) -> Bool ! { E }) -> Vec[T] ! { E } {
    let n = vec_len(xs);
    let mut src = vec_new[T]();
    let mut i = 0;
    while i < n { vec_push(src, vec_get(xs, i)); i = i + 1; }
    let mut width = 1;
    while width < n {
        let dst = vec_new[T]();
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            while a < mid || b < hi {
                // The left run's element goes first unless the right one sorts strictly before it.
                let left = if a < mid { if b < hi { !less(vec_get(src, b), vec_get(src, a)) } else { true } } else { false };
                if left { vec_push(dst, vec_get(src, a)); a = a + 1; } else { vec_push(dst, vec_get(src, b)); b = b + 1; }
            }
            lo = hi;
        }
        src = dst;
        width = width * 2;
    }
    src
}

/// The entries of `m` as `(key, value)` pairs ordered by `less`, which says whether its first
/// argument sorts before its second (R1.5, D10): `counts.sort_by(|a, b| a.1 > b.1)` is a count's
/// entries, most first. Stable over the map's table order, and as `vec_sort_by` in its calls of
/// `less` and its effects. `m` is unchanged.
pub fn hashmap_sort_by[K: Hash, V, effects E](m: HashMap[K, V], less: fn((K, V), (K, V)) -> Bool ! { E }) -> Vec[(K, V)] ! { E } {
    let keys = hashmap_keys(m);
    let values = hashmap_values(m);
    let entries = vec_new[(K, V)]();
    let mut i = 0;
    while i < vec_len(keys) { vec_push(entries, (vec_get(keys, i), vec_get(values, i))); i = i + 1; }
    vec_sort_by(entries, less)
}

/// A new sequence holding `xs` in ascending order.
pub fn ints_sort(xs: Ints) -> Ints ! {} {
    let v = vec_new[Int]();
    let mut i = 0;
    while i < ints_len(xs) { vec_push(v, ints_get(xs, i)); i = i + 1; }
    let sorted = vec_sort_by(v, fn(a: Int, b: Int) -> Bool { a < b });
    let out = ints_new();
    i = 0;
    while i < vec_len(sorted) { ints_push(out, vec_get(sorted, i)); i = i + 1; }
    out
}

/// A new sequence holding `xs` in ascending byte order, a prefix first.
pub fn strs_sort(xs: Strs) -> Strs ! {} {
    let v = vec_new[Str]();
    let mut i = 0;
    while i < strs_len(xs) { vec_push(v, strs_get(xs, i)); i = i + 1; }
    let sorted = vec_sort_by(v, fn(a: Str, b: Str) -> Bool { str_before(a, b) });
    let out = strs_new();
    i = 0;
    while i < vec_len(sorted) { strs_push(out, vec_get(sorted, i)); i = i + 1; }
    out
}

/// Sort `xs` itself by `less`, as `vec_sort_by` orders it, and return `0`: every handle to `xs`
/// sees the new order. Stable — elements `less` holds neither way keep their order — and at most
/// `O(n log n)` calls of `less`: runs of sixteen by insertion, then merged bottom-up between `xs`
/// and one scratch vector of its length. Polymorphic in `less`'s effects, as `vec_sort_by` is.
pub fn vec_sort_in_place_by[T, effects E](xs: Vec[T], less: fn(T, T) -> Bool ! { E }) -> Int ! { E } {
    let n = vec_len(xs);
    // Insertion sort within each run: an element moves left only past ones it sorts strictly before.
    let mut lo = 0;
    while lo < n {
        let hi = if lo + 16 < n { lo + 16 } else { n };
        let mut i = lo + 1;
        while i < hi {
            let x = vec_get(xs, i);
            let mut j = i;
            while j > lo && less(x, vec_get(xs, j - 1)) {
                vec_set(xs, j, vec_get(xs, j - 1));
                j = j - 1;
            }
            vec_set(xs, j, x);
            i = i + 1;
        }
        lo = hi;
    }
    if n > 16 {
        let scratch = vec_new[T]();
        let mut k = 0;
        while k < n { vec_push(scratch, vec_get(xs, k)); k = k + 1; }
        let mut src = xs;
        let mut dst = scratch;
        let mut in_xs = true;
        let mut width = 16;
        while width < n {
            let mut at = 0;
            while at < n {
                let mid = if at + width < n { at + width } else { n };
                let hi = if at + 2 * width < n { at + 2 * width } else { n };
                let mut a = at;
                let mut b = mid;
                let mut o = at;
                while o < hi {
                    // The left run's element goes first unless the right one sorts strictly before it.
                    let from_a = if a < mid { if b < hi { !less(vec_get(src, b), vec_get(src, a)) } else { true } } else { false };
                    if from_a { vec_set(dst, o, vec_get(src, a)); a = a + 1; } else { vec_set(dst, o, vec_get(src, b)); b = b + 1; }
                    o = o + 1;
                }
                at = hi;
            }
            let t = src;
            src = dst;
            dst = t;
            in_xs = !in_xs;
            width = width * 2;
        }
        if !in_xs {
            k = 0;
            while k < n { vec_set(xs, k, vec_get(scratch, k)); k = k + 1; }
        }
    }
    0
}

/// Sort `xs` itself into ascending order, and return `0`.
pub fn ints_sort_in_place(xs: Ints) -> Int ! {} {
    let v = vec_new[Int]();
    let mut i = 0;
    while i < ints_len(xs) { vec_push(v, ints_get(xs, i)); i = i + 1; }
    vec_sort_in_place_by(v, fn(a: Int, b: Int) -> Bool { a < b });
    i = 0;
    while i < ints_len(xs) { ints_set(xs, i, vec_get(v, i)); i = i + 1; }
    0
}

/// Sort `xs` itself into ascending byte order, a prefix first, and return `0`.
pub fn strs_sort_in_place(xs: Strs) -> Int ! {} {
    let v = vec_new[Str]();
    let mut i = 0;
    while i < strs_len(xs) { vec_push(v, strs_get(xs, i)); i = i + 1; }
    vec_sort_in_place_by(v, fn(a: Str, b: Str) -> Bool { str_before(a, b) });
    i = 0;
    while i < strs_len(xs) { strs_set(xs, i, vec_get(v, i)); i = i + 1; }
    0
}

// Whether `a` sorts strictly before `b`, byte by byte, a prefix first.
fn str_before(a: Str, b: Str) -> Bool ! {} {
    let n = str_len(a);
    let m = str_len(b);
    let mut i = 0;
    let mut r = 0;
    while r == 0 {
        if i == n { r = if i == m { 2 } else { 1 }; } else {
            if i == m { r = 2; } else {
                let x = str_byte(a, i);
                let y = str_byte(b, i);
                if x < y { r = 1; } else { if x > y { r = 2; } else { i = i + 1; } }
            }
        }
    }
    r == 1
}
