@std/text pub fn text_contains(s: Str, needle: Str) -> Bool ! {}
@std/text pub fn text_repeat(s: Str, n: Int) -> Str ! {}
@std/text pub fn text_split(s: Str, sep: Str) -> Strs ! {}
@std/text pub fn text_is_space(b: Int) -> Bool ! {}
@std/text pub fn text_trim(s: Str) -> Str ! {}
@std/text pub fn text_parse_int(s: Str) -> Result[Int, Str] ! {}
@std/text pub fn text_trim_start(s: Str) -> Str ! {}
@std/text pub fn text_trim_end(s: Str) -> Str ! {}
@std/text pub fn text_is_digit(b: Int) -> Bool ! {}
@std/text pub fn text_is_alpha(b: Int) -> Bool ! {}
@std/text pub fn text_to_upper(s: Str) -> Str ! {}
@std/text pub fn text_to_lower(s: Str) -> Str ! {}
@std/text pub fn text_replace(s: Str, from: Str, to: Str) -> Str ! {}
@std/text pub fn text_count(s: Str, needle: Str) -> Int ! {}
@std/text pub fn text_pad_left(s: Str, width: Int, fill: Str) -> Str ! {}
@std/text pub fn text_pad_right(s: Str, width: Int, fill: Str) -> Str ! {}
@std/text pub fn text_lines(s: Str) -> Strs ! {}
@std/text pub fn text_compare(a: Str, b: Str) -> Int ! {}
