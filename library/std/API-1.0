@std/seq pub fn ints_contains(xs: Ints, x: Int) -> Bool ! {}
@std/seq pub fn ints_sum(xs: Ints) -> Int ! {}
@std/seq pub fn ints_max(xs: Ints) -> Option[Int] ! {}
@std/seq pub fn ints_min(xs: Ints) -> Option[Int] ! {}
@std/seq pub fn strs_index_of(xs: Strs, x: Str) -> Option[Int] ! {}
@std/seq pub fn strs_contains(xs: Strs, x: Str) -> Bool ! {}
@std/seq pub fn vec_index_of[T: Equality](xs: Vec[T], x: T) -> Option[Int] ! {}
@std/seq pub fn vec_map[T, U, effects E](xs: Vec[T], f: fn(T) -> U ! { E }) -> Vec[U] ! { E }
@std/seq pub fn vec_filter[T, effects E](xs: Vec[T], keep: fn(T) -> Bool ! { E }) -> Vec[T] ! { E }
@std/seq pub fn vec_fold[T, A, effects E](xs: Vec[T], init: A, f: fn(A, T) -> A ! { E }) -> A ! { E }
@std/seq pub fn vec_reverse[T](xs: Vec[T]) -> Vec[T] ! {}
@std/seq pub fn vec_slice[T](xs: Vec[T], from: Int, to: Int) -> Vec[T] ! {}
@std/seq pub fn vec_concat[T](a: Vec[T], b: Vec[T]) -> Vec[T] ! {}
@std/seq pub fn vec_any[T, effects E](xs: Vec[T], test: fn(T) -> Bool ! { E }) -> Bool ! { E }
@std/seq pub fn vec_all[T, effects E](xs: Vec[T], test: fn(T) -> Bool ! { E }) -> Bool ! { E }
@std/show pub trait Show
@std/show pub fn show_all[T: Show](v: Vec[T], sep: Str) -> Str ! {}
@std/sort pub fn vec_sort_by[T, effects E](xs: Vec[T], less: fn(T, T) -> Bool ! { E }) -> Vec[T] ! { E }
@std/sort pub fn ints_sort(xs: Ints) -> Ints ! {}
@std/sort pub fn strs_sort(xs: Strs) -> Strs ! {}
@std/test pub fn test_int(what: Str, actual: Int, expected: Int) -> Result[Int, Str] ! {}
@std/test pub fn test_str(what: Str, actual: Str, expected: Str) -> Result[Str, Str] ! {}
@std/test pub fn test_true(what: Str, cond: Bool) -> Result[Bool, Str] ! {}
@std/test pub fn assert_true(what: Str, cond: Bool) -> Result[Int, Str] ! {}
@std/test pub fn assert_eq_int(what: Str, actual: Int, expected: Int) -> Result[Int, Str] ! {}
@std/test pub fn assert_eq_str(what: Str, actual: Str, expected: Str) -> Result[Int, Str] ! {}
@std/test pub fn assert_some[T](what: Str, o: Option[T]) -> Result[T, Str] ! {}
@std/test pub fn assert_ok[T](what: Str, r: Result[T, Str]) -> Result[T, Str] ! {}
@std/test pub fn property[effects E](seed: UInt64, cases: Int, check: fn(Rng) -> Result[Int, Str] ! { E }) -> Result[Int, Str] ! { E }
@std/text pub fn text_starts_with(s: Str, prefix: Str) -> Bool ! {}
@std/text pub fn text_ends_with(s: Str, suffix: Str) -> Bool ! {}
