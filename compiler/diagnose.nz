// The front end's diagnostics driver (R2, `openspec/changes/r2-front-end/design.md`, D4).
//
// Usage: diagnose [--syntax] FILE [LIBRARY [OS ARCH]]
// Output: every diagnostic of the compilation rooted at FILE as one `nazm.diagnostic/1` line, as
// `nazm check --json` writes them. With `--syntax`, the lexer's and the parser's of FILE alone.
// Otherwise the loader's (`load.nz`, the standard modules and the core prelude from LIBRARY,
// `library` by default), then every file's lexer and parser diagnostics at their offsets in the
// whole compilation, then the checker's (`sema.nz`) — over what the parser recovered, after a
// syntax error — where it carries the compilation; where it does not, it says on standard error
// what it stopped at and reports only the missing `main` (design D13). OS and ARCH are the host's
// as Rust's `std::env::consts` names them, which `@cfg` asks of (design D19); without them a
// condition on either stops the checker. FILE is an absolute path: its source root and its
// package, if it is in one, are found upward from it as `root::decide` finds them (design D22); a
// manifest the reference refuses publishes nothing, as the reference publishes no diagnostic of a
// module then. Exits 1 when there was an error.

use "syntax.nz";
use "diag.nz";
use "load.nz";
use "sema.nz";
use "configure.nz";
use "package.nz";

// A line break, written so that no string literal in this file holds one (`selfhost.rs` dumps a
// string's value on one line).
fn nl() -> Str { str_from_byte(10) }

fn main(io: IoCap) -> Int {
    let mut at = 0;
    let mut syntax_only = false;
    if args_count() > 1 {
        if arg(0) == "--syntax" { at = 1; syntax_only = true; }
    }
    if args_count() < at + 1 {
        eprint(str_concat("usage: diagnose [--syntax] FILE [LIBRARY [OS ARCH]]", nl()));
        exit_with(2);
    }
    let path = arg(at);
    let mut library = "library";
    if args_count() > at + 1 { library = arg(at + 1); }
    let mut os = "";
    let mut arch = "";
    if args_count() > at + 3 {
        os = arg(at + 2);
        arch = arg(at + 3);
    }
    if file_exists(path) == false {
        eprint(str_concat(str_concat("cannot read ", path), nl()));
        exit_with(2);
    }
    let d = dg_new();
    if syntax_only {
        let t = sx_tree();
        sx_parse_source(ld_with_newline(read_file(path)), t, d);
    } else {
        check_compilation(path, library, os, arch, d, io);
    }
    let out = strs_new();
    let mut i = 0;
    while i < dg_len(d) {
        strs_push(out, dg_json(d, i));
        strs_push(out, nl());
        i = i + 1;
    }
    print(str_join(out, ""));
    if dg_len(d) > 0 { exit_with(1); }
    0
}

// The compilation rooted at `path`, loaded, parsed and checked, every diagnostic into `d`.
fn check_compilation(path: Str, library: Str, os: Str, arch: Str, d: Diags, io: IoCap) -> Int {
    // The source root, as `root::decide` finds it: the first manifest upward whose source root holds
    // the file, or the first `nazm.root` marker, or the file's own directory.
    if str_len(path) == 0 || str_byte(path, 0) != 47 {
        eprint(str_concat("diagnose: the loader stops at a relative path", nl()));
        return 0;
    }
    let root = pk_decide(path, io);
    let how = pk_root_how(root);
    if how == 0 - 2 {
        eprint(str_concat(str_concat("diagnose: the loader stops at ", pk_root_why(root)), nl()));
        return 0;
    }
    // A manifest that is not one, or a marker that is not empty: the reference refuses the
    // compilation with no diagnostic of a module, so nothing is published.
    if how == 0 - 1 { return 0; }
    if how == 2 {
        eprint(str_concat("diagnose: the loader stops at a `nazm.root` marker", nl()));
        return 0;
    }
    let source_root = pk_root_path(root);
    // A package's compilation (N46): the package and its dependencies, resolved.
    let mut packages = pk_none();
    if how == 1 {
        packages = pk_context(source_root, io);
        if pk_packages_state(packages) != 1 {
            let mut why = pk_packages_why(packages);
            if pk_packages_state(packages) == 0 { why = "a package whose source root is not its manifest's directory's child"; }
            eprint(str_concat(str_concat("diagnose: the loader stops at ", why), nl()));
            return 0;
        }
    }
    let loaded = ld_load(path, library, source_root, packages, d, io);
    // A compilation that could not be loaded reports the loader's diagnostics and nothing else.
    if dg_len(d) > 0 { return 0; }
    let t = sx_tree();
    let mut root_program = 0 - 1;
    let programs = ints_new();
    let bases = ints_new();
    let names = strs_new();
    // The module graph as the loader resolved it: each module's imports, in source order, by
    // the index of the module each names; and whether each module is a standard one.
    let graph = ck_graph();
    let mut i = 0;
    while i < ld_count(loaded) {
        let own = dg_new();
        let program = sx_parse_source(ld_text(loaded, i), t, own);
        if i == 0 { root_program = program; }
        // A module that is not the program's own — a standard one, the prelude or a package's —
        // holds only the authority it is given (R1.5, D8).
        ck_graph_module(graph, ld_program(loaded, i) == false);
        let count = ints_len(sx_items(t, sx_field(t, program, "imports")));
        let mut k = 0;
        while k < count {
            ck_graph_import(graph, ld_import_target(loaded, i, k));
            k = k + 1;
        }
        // The prelude's standard modules it names (R1.5, D9), by the module each is.
        if ld_implicit(loaded, i) != "" {
            let given = split_commas(ld_implicit(loaded, i));
            k = 0;
            while k < strs_len(given) {
                ck_graph_implicit(graph, module_named(loaded, str_concat(str_concat("@std/", strs_get(given, k)), ".nz")));
                k = k + 1;
            }
        }
        ints_push(programs, program);
        ints_push(bases, ld_base(loaded, i));
        strs_push(names, ld_name(loaded, i));
        dg_append(d, own, ld_base(loaded, i));
        i = i + 1;
    }
    let syntax_failed = dg_len(d) > 0;
    // Every attribute held to the vocabulary and every declaration whose `@cfg` does not hold for
    // the host dropped (`attributes::configure`, design D19), before anything resolves a name; its
    // refusals count as the parser's do.
    let unsure = cf_configure(t, programs, bases, d, cf_host(os, arch));
    let parse_failed = dg_len(d) > 0;
    // The checker (`sema.nz`), where it carries the whole compilation (design D13); where it
    // stops, it says why on standard error and reports nothing. After a syntax error it checks
    // what did parse, as the reference does.
    if syntax_failed { ck_graph_syntax_error(graph); }
    if syntax_failed == false && parse_failed { ck_graph_attribute_error(graph); }
    let c = ck_check(t, programs, bases, names, graph);
    let mut stopped = ck_stopped(c);
    if unsure { stopped = "a condition on the host, which was not given"; }
    if stopped == "" {
        dg_append(d, ck_diags(c), 0);
        return 0;
    }
    eprint(str_concat(str_concat("diagnose: the checker stops at ", stopped), nl()));
    // The root owns `main` (`nazm-core/src/check/mod.rs`); a function that failed to parse was
    // never registered, so the missing `main` is not reported after a syntax error.
    if parse_failed == false {
        let functions = sx_items(t, sx_field(t, root_program, "functions"));
        let mut has_main = false;
        let mut k = 0;
        while k < ints_len(functions) {
            if sx_name(t, ints_get(functions, k), "name") == "main" { has_main = true; }
            k = k + 1;
        }
        if has_main == false {
            dg_error(d, "N0204", 0, 0, "this program has no `main` function", "",
                    "`nazm run` evaluates `fn main() -> Int` in the file you named");
        }
    }
    0
}

// The module of this name in load order, or -1.
fn module_named(loaded: Loaded, name: Str) -> Int {
    let mut i = 0;
    while i < ld_count(loaded) {
        if ld_name(loaded, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn split_commas(s: Str) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i <= str_len(s) {
        let end = i == str_len(s);
        let mut cut = end;
        if end == false { cut = str_byte(s, i) == 44; }
        if cut {
            strs_push(out, str_slice(s, from, i));
            from = i + 1;
        }
        i = i + 1;
    }
    out
}
