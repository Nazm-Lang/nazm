// The front end's diagnostics driver (R2, `openspec/changes/r2-front-end/design.md`, D4).
//
// Usage: diagnose [--syntax | --text | --facts | --core | --refs] FILE [LIBRARY [OS ARCH]]
// Output: every diagnostic of the compilation rooted at FILE as one `nazm.diagnostic/1` line, as
// `nazm check --json` writes them. With `--syntax`, the lexer's and the parser's of FILE alone;
// with `--text`, every diagnostic rendered as `nazm check` writes them to standard error (without
// its summary line); with `--facts`, what `nazm doc` would read of the compilation, as
// `facts-dump.nz` prints it (design D24); with `--core`, each function's Core IR as `core.nz`
// lowers it (D25); with `--refs`, the reference index as `facts-dump.nz` prints it (R5 hand-back).
// Otherwise the loader's (`load.nz`, the standard modules and the core prelude from LIBRARY,
// `library` by default), then every file's lexer and parser diagnostics at their offsets in the
// whole compilation, then the checker's (`sema.nz`) — over what the parser recovered, after a
// syntax error — where it carries the compilation; where it does not, it says on standard error
// what it stopped at and reports only the missing `main` (design D13). OS and ARCH are the host's
// as Rust's `std::env::consts` names them, which `@cfg` asks of (design D19); without them a
// condition on either stops the checker. FILE is an absolute path: its source root and its
// package, if it is in one, are found upward from it as `root::decide` finds them (design D22); a
// manifest the reference refuses publishes nothing, as the reference publishes no diagnostic of a
// module then. The whole front end is `facts.nz`'s `fx_check`. Exits 1 when there was an error.

use "syntax.nz";
use "diag.nz";
use "load.nz";
use "facts.nz";
use "facts-dump.nz";
use "core.nz";

// A line break, written so that no string literal in this file holds one (`selfhost.rs` dumps a
// string's value on one line).
fn nl() -> Str { str_from_byte(10) }

fn main(io: IoCap) -> Int {
    let mut at = 0;
    let mut mode = "";
    if args_count() > 1 {
        if arg(0) == "--syntax" || arg(0) == "--text" || arg(0) == "--facts" || arg(0) == "--core" || arg(0) == "--keys" || arg(0) == "--units" || arg(0) == "--refs" {
            at = 1;
            mode = arg(0);
        }
    }
    if args_count() < at + 1 {
        eprint(str_concat("usage: diagnose [--syntax | --text | --facts | --core] FILE [LIBRARY [OS ARCH]]", nl()));
        exit_with(2);
    }
    let path = arg(at);
    let mut library = "library";
    if args_count() > at + 1 { library = arg(at + 1); }
    let mut os = "";
    let mut arch = "";
    if args_count() > at + 3 {
        os = arg(at + 2);
        arch = arg(at + 3);
    }
    if file_exists(path) == false {
        eprint(str_concat(str_concat("cannot read ", path), nl()));
        exit_with(2);
    }
    let mut d = dg_new();
    if mode == "--syntax" {
        let t = sx_tree();
        sx_parse_source(ld_with_newline(read_file(path)), t, d);
    } else {
        let f = checked(path, library, os, arch, mode == "--facts" || mode == "--core" || mode == "--units" || mode == "--refs", io);
        // Where the front end stopped, standard error says at what (design D13).
        if fx_why(f) != "" { eprint(str_concat(str_concat("diagnose: ", fx_why(f)), nl())); }
        if mode == "--text" {
            if fx_refusal(f) != "" { print(str_concat(str_concat("nazm: ", fx_refusal(f)), nl())); }
            print(fx_render(f));
            if fx_failed(f) { exit_with(1); }
            return 0;
        }
        // Core IR, function by function (`core.nz`, design D25): `stops` where the checker
        // stopped, `fails` for a program that does not check.
        // The cache's keys (design D28): each module's, as the reference's cache computes them.
        if mode == "--keys" {
            if fx_carried(f) == false {
                print(str_concat("stops", nl()));
                return 0;
            }
            if fx_refusal(f) != "" {
                print(str_concat("refused", nl()));
                return 0;
            }
            if fx_loaded(f) == false {
                print(str_concat("fails", nl()));
                return 0;
            }
            print(fx_keys(f, os, arch));
            return 0;
        }
        // Core IR as `--core` prints it, from the units filed in the directory after OS ARCH
        // (design D28).
        if mode == "--units" {
            if fx_carried(f) == false {
                print(str_concat("stops", nl()));
                return 0;
            }
            if fx_failed(f) {
                print(str_concat("fails", nl()));
                return 0;
            }
            print(cr_core_units(f, arg(at + 4), fx_check_keys(f, os, arch), io));
            return 0;
        }
        if mode == "--core" {
            if fx_carried(f) == false {
                print(str_concat("stops", nl()));
                return 0;
            }
            if fx_failed(f) {
                print(str_concat("fails", nl()));
                return 0;
            }
            print(cr_core(f));
            return 0;
        }
        if mode == "--refs" {
            print(fd_refs(f));
            return 0;
        }
        if mode == "--facts" {
            print(fd_dump(f));
            return 0;
        }
        d = fx_diags(f);
    }
    let out = strs_new();
    let mut i = 0;
    while i < dg_len(d) {
        strs_push(out, dg_json(d, i));
        strs_push(out, nl());
        i = i + 1;
    }
    print(str_join(out, ""));
    if dg_len(d) > 0 { exit_with(1); }
    0
}

// The compilation, checked as a program — or, as `nazm doc` checks it, as a module, whose root
// need not have `main`.
fn checked(path: Str, library: Str, os: Str, arch: Str, module: Bool, io: IoCap) -> Facts {
    if module { return fx_check_module(path, library, os, arch, io); }
    fx_check(path, library, os, arch, io)
}
