// Module resolution, written in Nazm.
//
// Until now `use` was parsed and thrown away, and the *driver* — `nazm-cli/src/load.rs`,
// written in Rust — read the import graph and handed the compiler one merged buffer. That
// left a hole in the self-hosting claim: the compiler written in Nazm could not build a
// multi-file program on its own, and the release report listed it under *Known
// limitations*. This file closes it.
//
// # The order is the contract
//
// The root first, then its imports depth-first in source order, each file read at most
// once. That is exactly what `load.rs` produces, so both front ends see the same bytes in
// the same order — which matters because offsets into the merged buffer are what
// diagnostics point at. A cycle terminates because the second visit finds the file
// already loaded; it is not an error.
//
// # Where this differs from the driver, and why
//
// `load.rs` keys each file by its **canonical** path, which resolves symbolic links. The
// emitted runtime has eighteen symbols and `realpath` is not among them, so this keys by
// a **textually normalised** path instead: `./x.nz`, `x.nz` and `a/../x.nz` are one key,
// but two names that reach one file through a symbolic link are two keys, and that file
// would be read twice and its functions defined twice. Recorded in `docs/bootstrap.md`
// rather than papered over — it is a real difference in behaviour, not a detail.

use "lex.nz";

// --- paths ----------------------------------------------------------------------------

/// The directory part of `path`, keeping its trailing `/`. `""` when there is none, so
/// joining is always `dir ++ rel`.
fn dir_of(path: Str) -> Str {
    let mut i = str_len(path);
    while i > 0 {
        if str_byte(path, i - 1) == 47 { return str_slice(path, 0, i); }
        i = i - 1;
    }
    ""
}

/// Fold away `.` and `..` so that two spellings of one file are one key.
///
/// A leading `..` is kept: there is nothing above the root of a relative path to cancel
/// it against, and dropping it would silently turn `../x.nz` into `x.nz`.
fn normalise(path: Str) -> Str {
    let parts = strs_new();
    let n = str_len(path);
    let mut from = 0;
    let mut i = 0;
    while i <= n {
        let mut boundary = 0;
        if i == n { boundary = 1; }
        if boundary == 0 {
            if str_byte(path, i) == 47 { boundary = 1; }
        }
        if boundary == 1 {
            let seg = str_slice(path, from, i);
            if str_len(seg) > 0 {
                // 0 ordinary, 1 `.`, 2 `..`. Written as a number because the language has
                // no `&&`, so the alternative is a tower of nested `if`s.
                let mut kind = 0;
                if seg == "." { kind = 1; }
                if seg == ".." { kind = 2; }
                if kind == 0 { strs_push(parts, seg); }
                if kind == 2 {
                    let k = strs_len(parts);
                    let mut cancels = 0;
                    if k > 0 {
                        if strs_get(parts, k - 1) == ".." { cancels = 0; } else { cancels = 1; }
                    }
                    if cancels == 1 { strs_pop(parts); } else { strs_push(parts, seg); }
                }
            }
            from = i + 1;
        }
        i = i + 1;
    }
    let mut lead = "";
    if n > 0 {
        if str_byte(path, 0) == 47 { lead = "/"; }
    }
    str_concat(lead, str_join(parts, "/"))
}

/// Resolve one import against the directory of the file that wrote it. An absolute path
/// stands on its own, exactly as the driver treats one.
fn resolve_import(dir: Str, rel: Str) -> Str {
    if str_len(rel) > 0 {
        if str_byte(rel, 0) == 47 { return normalise(rel); }
    }
    normalise(str_concat(dir, rel))
}

// --- the import graph -------------------------------------------------------------------

fn strs_has(xs: Strs, want: Str) -> Bool {
    let mut i = 0;
    while i < strs_len(xs) {
        if strs_get(xs, i) == want { return true; }
        i = i + 1;
    }
    false
}

/// Every path `src` imports, resolved against `dir`, in source order — with the offset of
/// the quoted path **within `src`**, so a diagnostic about an import can point at the line
/// that wrote it.
///
/// The real lexer does the reading. A second, ad-hoc scanner for `use` lines would be a
/// second definition of what an import is, and the two would drift — a `use` inside a
/// comment or a string is exactly the case a `grep` gets wrong and a lexer does not.
fn imports_of(src: Str, dir: Str, at: Ints) -> Strs {
    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let out = strs_new();
    let mut i = 0;
    while i < ints_len(kinds) {
        if ints_get(kinds, i) == k_use() {
            if i + 1 < ints_len(kinds) {
                if ints_get(kinds, i + 1) == k_str() {
                    let written = strs_get(texts, i + 1);
                    let why = refused_import(written);
                    if str_len(why) > 0 {
                        eprint(str_concat(str_concat(str_concat(str_concat(
                                "the compiler written in Nazm does not resolve `", written),
                                "`: it names "), why), str_from_byte(10)));
                        exit_with(2);
                    }
                    strs_push(out, resolve_import(dir, written));
                    ints_push(at, ints_get(starts, i + 1));
                }
            }
        }
        i = i + 1;
    }
    out
}

/// What an import names that only the reference compiler resolves (N77), or `""`: a
/// standard module, `@std/NAME`, or a module of a package, `NAME:path`. The reference
/// resolves both (`load.rs`); this loader resolves relative paths only, and says so by name
/// rather than looking for a file called `@std/text` and reporting it missing.
fn refused_import(path: Str) -> Str {
    if str_len(path) >= 5 {
        if str_slice(path, 0, 5) == "@std/" { return "a standard library module"; }
    }
    let mut i = 0;
    while i < str_len(path) {
        if str_byte(path, i) == 58 { return "a module of another package"; }
        i = i + 1;
    }
    ""
}

/// Which module owns the byte at `offset`.
///
/// The modules are laid out in load order and `mstart` is where each begins, so this is
/// the last module that starts at or before the offset. A linear scan, over a list that
/// is one entry per source file of one program.
pub fn module_at(mstart: Ints, offset: Int) -> Int {
    let mut owner = 0;
    let mut i = 0;
    while i < ints_len(mstart) {
        if ints_get(mstart, i) <= offset { owner = i; }
        i = i + 1;
    }
    owner
}

/// Whether module `from` directly imports module `to`.
///
/// **Directly.** What `to` in turn imports is not consulted and must not be: that is the
/// non-transitivity rule, and expressing it as "this list and no closure over it" is what
/// keeps it from being reintroduced by a later convenience.
pub fn imports_directly(mfirst: Ints, mcount: Ints, mto: Ints, from: Int, to: Int) -> Bool {
    let first = ints_get(mfirst, from);
    let mut j = 0;
    while j < ints_get(mcount, from) {
        if ints_get(mto, first + j) == to { return true; }
        j = j + 1;
    }
    false
}

/// `root` and everything it imports, as one buffer — **and the module graph**.
///
/// Files are separated by a newline so that a file not ending in one cannot weld its last
/// line to the next file's first. That the text is concatenated is a representation
/// detail of this compiler and **not** a module interface: the boundaries travel beside
/// it, explicitly, in `mstart`, and every semantic question about ownership is answered
/// from those rather than from the text.
///
/// Filled in load order, one entry per module:
///
/// * `mpath`  — the normalised path it was read from;
/// * `mstart` — where its text begins in the returned buffer;
/// * `mfirst`, `mcount` — this module's slice of `mto`/`mat`;
/// * `mto`    — the module each `use` names;
/// * `mat`    — where that `use`'s quoted path is, in the returned buffer.
///
/// A `use` naming a file that is not there ends the program, as it did before. A module
/// importing itself contributes no edge: it already sees all of its own definitions, so
/// the edge could only make it collide with itself.
pub fn load_modules(root: Str, mpath: Strs, mstart: Ints, mfirst: Ints, mcount: Ints,
        mto: Ints, mat: Ints) -> Str {
    let parts = strs_new();
    let stack = strs_new();
    strs_push(stack, normalise(root));

    // The edges as written, before any module has an index: owner, target path, offset.
    let raw_owner = ints_new();
    let raw_path = strs_new();
    let raw_at = ints_new();

    let mut total = 0;
    while strs_len(stack) > 0 {
        let path = strs_pop(stack);
        if strs_has(mpath, path) == false {
            if file_exists(path) == false {
                eprint(str_concat(str_concat("cannot find ", path), str_from_byte(10)));
                exit_with(2);
            }
            let text = read_file(path);
            let me = strs_len(mpath);
            strs_push(mpath, path);
            // Where this file's text begins in the joined buffer. The join inserts one
            // newline between parts, so every module after the first starts one byte
            // later than the sum of the lengths before it.
            ints_push(mstart, total);
            total = total + str_len(text) + 1;
            strs_push(parts, text);

            let at = ints_new();
            let kids = imports_of(strs_get(parts, me), dir_of(path), at);
            let mut i = 0;
            while i < strs_len(kids) {
                ints_push(raw_owner, me);
                strs_push(raw_path, strs_get(kids, i));
                ints_push(raw_at, ints_get(mstart, me) + ints_get(at, i));
                i = i + 1;
            }

            // Pushed in reverse so the stack pops them in source order: the buffer's
            // layout follows the program's text, which is what makes it reproducible.
            let mut j = strs_len(kids);
            while j > 0 {
                strs_push(stack, strs_get(kids, j - 1));
                j = j - 1;
            }
        }
    }

    // Every module has an index now, so the edges can have one too. In module order, so
    // `mfirst`/`mcount` describe a contiguous slice.
    let mut m = 0;
    while m < strs_len(mpath) {
        ints_push(mfirst, ints_len(mto));
        let mut n = 0;
        let mut e = 0;
        while e < ints_len(raw_owner) {
            if ints_get(raw_owner, e) == m {
                let target = path_index(mpath, strs_get(raw_path, e));
                // A self-import adds nothing, and a duplicate import adds it once.
                let mut keep = 0;
                if target >= 0 {
                    if target != m { keep = 1; }
                }
                // Deduplicated against what this module has already taken. `mcount` has
                // no entry for `m` until the loop ends, so `imports_directly` cannot be
                // used here — it would read past the end of it.
                if keep == 1 {
                    let base = ints_get(mfirst, m);
                    let mut d = 0;
                    while d < n {
                        if ints_get(mto, base + d) == target { keep = 0; }
                        d = d + 1;
                    }
                }
                if keep == 1 {
                    ints_push(mto, target);
                    ints_push(mat, ints_get(raw_at, e));
                    n = n + 1;
                }
            }
            e = e + 1;
        }
        ints_push(mcount, n);
        m = m + 1;
    }

    str_join(parts, str_from_byte(10))
}

/// Which module was read from `want`, or `-1`.
fn path_index(mpath: Strs, want: Str) -> Int {
    let mut i = 0;
    while i < strs_len(mpath) {
        if strs_get(mpath, i) == want { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- the core prelude, N12 and N12.1 -------------------------------------------------

/// The core prelude's module key: the reference's `ModuleKey::prelude()`, spelled the same.
///
/// A module's entry in `mpath` is its **key** — for a project file, the normalised path it
/// was read from; for the prelude, this. It is not a path and is never read: the prelude's
/// file is named on the command line, and where it lives on this machine is no part of what
/// it is. Until N12.1 the prelude was whichever module came last, which is an order, not an
/// identity.
pub fn core_key() -> Str { "@core/prelude" }

/// Whether `key` is in the toolchain's namespace: its first component is `@core`. No project
/// module may have such a key, which is what makes [`core_key`] impossible to impersonate —
/// the reference refuses the same first component in `ModuleKey::relative`.
fn reserved_key(key: Str) -> Bool {
    if key == "@core" { return true; }
    if str_len(key) < 6 { return false; }
    str_slice(key, 0, 6) == "@core/"
}

/// Add the core prelude — the file at `core` — as a module keyed [`core_key`], and make
/// every module already loaded import it. Returns the buffer with the prelude's text
/// appended.
///
/// The same shape the reference loader gives a compilation: the prelude after every project
/// module, so no project offset moves, and an ordinary import edge from each of them, so
/// what a module may name and what it depends on treat the prelude as a module it had
/// written `use` for. The edges point at no `use` line because none was written; a
/// diagnostic about the prelude points at the declaration instead. `docs/spec.md`, *The core
/// prelude*.
///
/// **Its identity is its key**, established here and nowhere else: [`core_module`] finds
/// the module by it, and every semantic question about the prelude — which `Result` a `?`
/// accepts, which names a project may not declare — is asked of the module that finds.
/// Where the prelude sits among the modules is a layout decision this function makes and
/// nothing downstream reads. A project module can never hold the key: one whose path is in the
/// `@core` namespace is re-keyed out of it before the prelude is added.
pub fn attach_core(core: Str, src: Str, mpath: Strs, mstart: Ints, mfirst: Ints,
        mcount: Ints, mto: Ints, mat: Ints) -> Str {
    if file_exists(core) == false {
        eprint(str_concat(str_concat("cannot find the core prelude ", core),
                str_from_byte(10)));
        exit_with(2);
    }
    // A project file whose path is in the `@core` namespace is still a project file: it
    // compiles, as the reference compiles it, under a key that is not in that namespace.
    // Its text has already been read, so the key is all that changes.
    let mut p = 0;
    while p < strs_len(mpath) {
        if reserved_key(strs_get(mpath, p)) {
            strs_set(mpath, p, str_concat("./", strs_get(mpath, p)));
        }
        p = p + 1;
    }
    let me = strs_len(mpath);
    // Every module's edges, then the prelude, rebuilt in module order so each module's
    // slice of `mto`/`mat` stays contiguous.
    let to = ints_new();
    let at = ints_new();
    let mut m = 0;
    while m < me {
        let first = ints_get(mfirst, m);
        let n = ints_get(mcount, m);
        ints_set(mfirst, m, ints_len(to));
        let mut e = 0;
        while e < n {
            ints_push(to, ints_get(mto, first + e));
            ints_push(at, ints_get(mat, first + e));
            e = e + 1;
        }
        ints_push(to, me);
        ints_push(at, 0 - 1);
        ints_set(mcount, m, n + 1);
        m = m + 1;
    }
    while ints_len(mto) > 0 { ints_pop(mto); }
    while ints_len(mat) > 0 { ints_pop(mat); }
    let mut c = 0;
    while c < ints_len(to) {
        ints_push(mto, ints_get(to, c));
        ints_push(mat, ints_get(at, c));
        c = c + 1;
    }
    strs_push(mpath, core_key());
    ints_push(mstart, str_len(src) + 1);
    ints_push(mfirst, ints_len(mto));
    ints_push(mcount, 0);
    str_concat(str_concat(src, str_from_byte(10)), read_file(core))
}

/// The core prelude's module: the one keyed [`core_key`], or `-1` when there is none.
///
/// Asked **once**, by `check_program`, and the answer handed to every consumer — so the
/// prelude has one resolution, not one per question.
pub fn core_module(mpath: Strs) -> Int {
    let mut m = 0;
    while m < strs_len(mpath) {
        if strs_get(mpath, m) == core_key() { return m; }
        m = m + 1;
    }
    0 - 1
}
