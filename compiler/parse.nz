// The Nazm parser, written in Nazm — the library.
//
// `compiler/parser.nz` is the command-line driver over this file, split for the same
// reason the tokeniser is: every top-level function is visible to every importer, so a
// library carrying a `main` collides with its importer's.
//
// Second component of the self-hosted compiler. It reads the token arrays
// `compiler/lexer.nz` produces and appends syntax nodes to an arena in **post-order**,
// which is the encoding `crates/nazm-cli/tests/selfhost.rs` compares against the
// reference parser: post-order plus arity is a complete description of a tree, so
// agreement on the dump is agreement on the tree.
//
// # No recursion, and how
//
// Expressions are parsed by **shunting-yard**: an operator stack, a stack of operand
// spans, and one loop. Nesting — parentheses and call arguments — is a sentinel on the
// operator stack rather than a call frame. That is the B5 decision made concrete for the
// hardest part of a parser, and it is why this compiles natively today.
//
// # Scope of this increment
//
// A construct this increment does not parse is named, at its own position, rather than
// left to fail as "expected an expression" — which would be true but useless.
fn refuse_unimplemented(kinds: Ints, starts: Ints, i: Int) -> Int {
    let t = kind_at(kinds, i);
    let mut what = "";
    if t == k_enum() { what = "an enum declared inside a function"; }
    if t == k_struct() { what = "a record declared inside a function"; }
    if what == "" { return 0; }
    die(str_concat(what, ": not implemented yet in this parser"), start_at(starts, i));
    0
}

// Whole functions: parameters, a body of statements, `let` and `let mut`, assignment,
// `while` with nested blocks, `return`, `break`, `continue`, expression statements and a
// block's tail value — over the whole expression grammar (literals, variables, unary
// minus, `+ - * / %`, the six comparisons with their real precedence and associativity,
// parentheses, calls of any arity).
//
// An `if`, a `match` and a block used as an expression (N12.1) all suspend an expression
// part-way to parse a block: the expression stays on the shared stacks and the frame
// machine below parses the block, then resumes it. A construct outside the scope is
// refused by name at its own position, never misparsed.

use "lex.nz";

// --- node kinds --------------------------------------------------------------------

pub fn n_int() -> Int { 1 }
pub fn n_bool() -> Int { 2 }
pub fn n_str() -> Int { 3 }
pub fn n_var() -> Int { 4 }
pub fn n_neg() -> Int { 5 }
pub fn n_bin() -> Int { 6 }
pub fn n_call() -> Int { 7 }
pub fn n_block() -> Int { 8 }
pub fn n_param() -> Int { 9 }
pub fn n_fn() -> Int { 10 }
pub fn n_program() -> Int { 11 }
pub fn n_let() -> Int { 12 }
pub fn n_assign() -> Int { 13 }
pub fn n_while() -> Int { 14 }
pub fn n_return() -> Int { 15 }
pub fn n_break() -> Int { 16 }
pub fn n_continue() -> Int { 17 }
pub fn n_exprstmt() -> Int { 18 }
pub fn n_if() -> Int { 19 }
pub fn n_scope() -> Int { 20 }
pub fn n_spawn() -> Int { 21 }
// Records, added by N9. A declaration and its fields, a construction, and a projection.
pub fn n_record() -> Int { 22 }
pub fn n_structfield() -> Int { 23 }
pub fn n_construct() -> Int { 24 }
pub fn n_fieldread() -> Int { 25 }
// Enums, added by N10. A declaration, its variants and their payload fields; a variant
// construction; one arm of a `match`; and the `match` itself.
pub fn n_enum() -> Int { 26 }
pub fn n_variant() -> Int { 27 }
pub fn n_payload() -> Int { 28 }
pub fn n_makevariant() -> Int { 29 }
pub fn n_arm() -> Int { 30 }
pub fn n_match() -> Int { 31 }
// `operand?` — N12's propagation. One child, the operand; the node's span runs from the
// operand's start to the end of the `?`, so the `?` itself is the node's last byte.
pub fn n_propagate() -> Int { 32 }
// `{ statements; tail }` written where an expression is — N12.1. One child, the `block`
// node, spanning the same bytes: the wrapper is the reference AST's `Expr::Block`, and it
// is what tells a block used as a value from a branch's or a body's.
pub fn n_blockexpr() -> Int { 33 }

pub fn node_name(k: Int) -> Str {
    if k == n_int() { return "int"; }
    if k == n_bool() { return "bool"; }
    if k == n_str() { return "str"; }
    if k == n_var() { return "var"; }
    if k == n_neg() { return "neg"; }
    if k == n_bin() { return "bin"; }
    if k == n_call() { return "call"; }
    if k == n_block() { return "block"; }
    if k == n_param() { return "param"; }
    if k == n_fn() { return "fn"; }
    if k == n_program() { return "program"; }
    if k == n_let() { return "let"; }
    if k == n_assign() { return "assign"; }
    if k == n_while() { return "while"; }
    if k == n_return() { return "return"; }
    if k == n_break() { return "break"; }
    if k == n_continue() { return "continue"; }
    if k == n_exprstmt() { return "exprstmt"; }
    if k == n_if() { return "if"; }
    if k == n_scope() { return "scope"; }
    if k == n_spawn() { return "spawn"; }
    if k == n_record() { return "record"; }
    if k == n_structfield() { return "structfield"; }
    if k == n_construct() { return "construct"; }
    if k == n_fieldread() { return "field"; }
    if k == n_enum() { return "enum"; }
    if k == n_variant() { return "variant"; }
    if k == n_payload() { return "payload"; }
    if k == n_makevariant() { return "makevariant"; }
    if k == n_arm() { return "arm"; }
    if k == n_match() { return "match"; }
    if k == n_propagate() { return "propagate"; }
    if k == n_blockexpr() { return "blockexpr"; }
    "?"
}

// --- operator codes on the shunting-yard stack -------------------------------------
//
// 1..3 are precedence levels and also act as the precedence itself. 90 and 92 are
// sentinels that stop a reduction; 91 is a pending unary minus.

fn prec_of(kind: Int) -> Int {
    if kind == k_eqeq() { return 1; }
    if kind == k_noteq() { return 1; }
    if kind == k_lt() { return 1; }
    if kind == k_lteq() { return 1; }
    if kind == k_gt() { return 1; }
    if kind == k_gteq() { return 1; }
    if kind == k_plus() { return 2; }
    if kind == k_minus() { return 2; }
    if kind == k_star() { return 3; }
    if kind == k_slash() { return 3; }
    if kind == k_percent() { return 3; }
    0
}

fn op_symbol(kind: Int) -> Str {
    if kind == k_eqeq() { return "=="; }
    if kind == k_noteq() { return "!="; }
    if kind == k_lt() { return "<"; }
    if kind == k_lteq() { return "<="; }
    if kind == k_gt() { return ">"; }
    if kind == k_gteq() { return ">="; }
    if kind == k_plus() { return "+"; }
    if kind == k_minus() { return "-"; }
    if kind == k_star() { return "*"; }
    if kind == k_slash() { return "/"; }
    if kind == k_percent() { return "%"; }
    "?"
}

// Whether a decimal literal is above `Int::MAX`.
//
// `Int::MIN`'s magnitude is one greater than `Int::MAX`, so the lexer cannot produce it
// and the negation has to fold with the literal — which means the parser has to know
// which literals are out of range. Same length compares lexicographically because
// decimal digits sort like their values.
fn int_too_large(text: Str) -> Bool {
    let limit = "9223372036854775807";
    if str_len(text) > str_len(limit) { return true; }
    if str_len(text) < str_len(limit) { return false; }
    let mut i = 0;
    while i < str_len(text) {
        let a = str_byte(text, i);
        let b = str_byte(limit, i);
        if a > b { return true; }
        if a < b { return false; }
        i = i + 1;
    }
    false
}

fn sent_paren() -> Int { 90 }
fn sent_unary() -> Int { 91 }
fn sent_call() -> Int { 92 }
fn sent_if() -> Int { 93 }
// A record construction. Told from a call by two tokens at the opening bracket —
// `IDENT ( IDENT :` — which is a decision rather than a guess, because no argument
// expression can begin with a name followed by a colon.
fn sent_construct() -> Int { 94 }
// A `match`, suspended at its `{` exactly as an `if` is suspended at its block's.
fn sent_match() -> Int { 95 }
// A variant construction. Told from a projection by three tokens — `IDENT . IDENT (` —
// which is a decision rather than a guess, because the language has no methods and no
// function values, so nothing else can put a `(` after a field read.
fn sent_variant() -> Int { 96 }

// --- the arena ---------------------------------------------------------------------

fn emit(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, kind: Int, arity: Int, from: Int, to: Int, text: Str) -> Int {
    ints_push(nk, kind);
    ints_push(nar, arity);
    ints_push(nst, from);
    ints_push(nen, to);
    strs_push(ntx, text);
    ints_len(nk)
}

// --- token access -------------------------------------------------------------------

fn kind_at(kinds: Ints, i: Int) -> Int {
    if i < 0 { return 0 - 1; }
    if i >= ints_len(kinds) { return 0 - 1; }
    ints_get(kinds, i)
}

fn start_at(starts: Ints, i: Int) -> Int {
    if i < 0 { return 0; }
    if i >= ints_len(starts) { return 0; }
    ints_get(starts, i)
}

fn end_at(ends: Ints, i: Int) -> Int {
    if i < 0 { return 0; }
    if i >= ints_len(ends) { return 0; }
    ints_get(ends, i)
}

fn text_at(texts: Strs, i: Int) -> Str {
    if i < 0 { return ""; }
    if i >= strs_len(texts) { return ""; }
    strs_get(texts, i)
}

fn die(message: Str, offset: Int) -> Int {
    eprint("parse error at ");
    eprint(int_to_str(offset));
    eprint(": ");
    eprint(message);
    eprint(str_from_byte(10));
    exit_with(1);
    0
}

// --- expressions, by shunting-yard --------------------------------------------------
//
// Returns the token index just past the expression. Every operand's span is kept on
// `vs`/`ve` so a reduction can compute the compound span the reference parser gives:
// a binary node spans from its left operand's start to its right operand's end, a
// negation from the `-` to its operand's end, and a parenthesised expression keeps its
// own span rather than the brackets'.
fn parse_expr(kinds: Ints, starts: Ints, ends: Ints, texts: Strs, from: Int,
        nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs,
        ops: Ints, opat: Ints, cname: Strs, cargs: Ints, cfields: Strs, vs: Ints, ve: Ints,
        status: Ints, resuming: Bool, base: Int, naux: Ints) -> Int {
    // `base` is how deep the operator stack was when *this* expression started. The
    // stacks are shared — an `if` suspends one expression while the expressions inside
    // its blocks are parsed — so every reduction stops here rather than at the bottom.
    // Without it an inner expression reduces past the outer one's `if` sentinel.
    let mut i = from;
    // Resuming means an `if` has just finished and its value is already on the operand
    // stack, so parsing continues from *after* an operand rather than before one.
    let mut skip_primary = resuming;

    while true {
        if skip_primary {
            skip_primary = false;
        } else {
            // --- prefix: any run of unary minus -----------------------------------------
            while kind_at(kinds, i) == k_minus() {
                // `-` immediately before an out-of-range literal is not a negation of it:
                // the two fold into one literal, which is the only way `Int::MIN` can be
                // written. Left for the primary section, which is where literals are made.
                if kind_at(kinds, i + 1) == k_int() {
                    if int_too_large(text_at(texts, i + 1)) { break; }
                }
                ints_push(ops, sent_unary());
                ints_push(opat, start_at(starts, i));
                i = i + 1;
            }

            // --- a primary ---------------------------------------------------------------
            let t = kind_at(kinds, i);
            let mut done_primary = false;

            if t == k_minus() {
                // Only reachable from the fold above: `-` and an out-of-range literal are
                // one node, spanning both.
                let text = text_at(texts, i + 1);
                if text != "9223372036854775808" {
                    die("this integer does not fit in `Int`", start_at(starts, i));
                }
                emit(nk, nar, nst, nen, ntx, n_int(), 0, start_at(starts, i),
                        end_at(ends, i + 1), str_concat("-", text));
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i + 1));
                i = i + 2;
                done_primary = true;
            }
            if t == k_int() {
                if int_too_large(text_at(texts, i)) {
                    die("this integer does not fit in `Int`", start_at(starts, i));
                }
                emit(nk, nar, nst, nen, ntx, n_int(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i));
                i = i + 1;
                done_primary = true;
            }
            if t == k_true() {
                emit(nk, nar, nst, nen, ntx, n_bool(), 0, start_at(starts, i), end_at(ends, i), "true");
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i));
                i = i + 1;
                done_primary = true;
            }
            if t == k_false() {
                emit(nk, nar, nst, nen, ntx, n_bool(), 0, start_at(starts, i), end_at(ends, i), "false");
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i));
                i = i + 1;
                done_primary = true;
            }
            if t == k_str() {
                emit(nk, nar, nst, nen, ntx, n_str(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i));
                i = i + 1;
                done_primary = true;
            }
            if t == k_lparen() {
                // A sentinel, not a frame: nesting is depth on this stack.
                ints_push(ops, sent_paren());
                ints_push(opat, start_at(starts, i));
                i = i + 1;
                continue;
            }
            if t == k_if() {
                // The condition is an ordinary expression; the sentinel is what tells the
                // `{` after it that this is an `if` rather than the end of a statement.
                ints_push(ops, sent_if());
                ints_push(opat, start_at(starts, i));
                i = i + 1;
                continue;
            }
            if t == k_lbrace() {
                // A block where an operand is expected: the block *is* the operand. The
                // frame machine parses it, and this expression resumes after it exactly as
                // it resumes after an `if` — with the operators written before the block
                // still on the stack, untouched, because nothing about them is complete.
                ints_set(status, 0, 3);
                return i;
            }
            if t == k_match() {
                // The scrutinee is an ordinary expression, exactly as an `if`'s condition
                // is, and the sentinel is what tells the `{` after it what it belongs to.
                ints_push(ops, sent_match());
                ints_push(opat, start_at(starts, i));
                i = i + 1;
                continue;
            }
            if t == k_ident() {
                // `name[T, …]` — type arguments, before a call, a construction or a
                // variant, and nowhere else: there is no indexing. They travel on the
                // node's text straight after the name, and from here on `i` is the last
                // token of the head, so the lookahead below reads what follows the `]`.
                let head = text_at(texts, i);
                let head_at = start_at(starts, i);
                let mut targs = "";
                if kind_at(kinds, i + 1) == k_lbracket() {
                    let got = strs_new();
                    let past = type_tail(kinds, starts, ends, texts, i + 2, "[", 1, got);
                    // The list's own closing offset is dropped: a diagnostic about these
                    // arguments points at the name they follow, as the reference's does.
                    targs = before_last_at(strs_get(got, 0));
                    let mut applies = false;
                    if kind_at(kinds, past) == k_lparen() { applies = true; }
                    if kind_at(kinds, past) == k_dot() {
                        if kind_at(kinds, past + 1) == k_ident() {
                            if kind_at(kinds, past + 2) == k_lparen() { applies = true; }
                        }
                    }
                    if applies == false {
                        die("expected `(` after the type arguments", start_at(starts, past));
                    }
                    i = past - 1;
                }
                let named = str_concat(head, targs);
                if making_variant(kinds, i) {
                    // `E.V(…)`. The enum and the variant are one name for the node's
                    // text, because what a variant *is* is its enum and its name.
                    let ename = named;
                    let at = head_at;
                    let vname = text_at(texts, i + 2);
                    let qualified = str_concat(str_concat(ename, "."), vname);
                    i = i + 4;
                    if kind_at(kinds, i) == k_rparen() {
                        // A variant with no payload is still written with its brackets,
                        // and is complete without ever opening a frame.
                        emit(nk, nar, nst, nen, ntx, n_makevariant(), 0, at, end_at(ends, i),
                                str_concat(qualified, "()"));
                        ints_push(vs, at);
                        ints_push(ve, end_at(ends, i));
                        i = i + 1;
                        done_primary = true;
                    } else {
                        if kind_at(kinds, i) != k_ident() {
                            die("expected a payload field name", start_at(starts, i));
                        }
                        if kind_at(kinds, i + 1) != k_colon() {
                            die("expected `:` after a payload field name", start_at(starts, i + 1));
                        }
                        ints_push(ops, sent_variant());
                        ints_push(opat, at);
                        strs_push(cname, qualified);
                        ints_push(cargs, 0);
                        strs_push(cfields, text_at(texts, i));
                        i = i + 2;
                        continue;
                    }
                }
                if done_primary == false {
                    if constructing(kinds, i) {
                        // `Name(field: …)`. The sentinel is a second kind of bracket rather
                        // than a flag on the call one, so the closing `)` cannot build the
                        // wrong node, and the field names are accumulated as they are read.
                        let name = named;
                        let at = head_at;
                        i = i + 2;
                        ints_push(ops, sent_construct());
                        ints_push(opat, at);
                        strs_push(cname, name);
                        ints_push(cargs, 0);
                        strs_push(cfields, text_at(texts, i));
                        i = i + 2;
                        continue;
                    }
                    if kind_at(kinds, i + 1) == k_lparen() {
                        let name = named;
                        let at = head_at;
                        i = i + 2;
                        if kind_at(kinds, i) == k_rparen() {
                            // No arguments: the call is complete without ever opening a frame.
                            emit(nk, nar, nst, nen, ntx, n_call(), 0, at, end_at(ends, i), name);
                            ints_push(vs, at);
                            ints_push(ve, end_at(ends, i));
                            i = i + 1;
                            done_primary = true;
                        } else {
                            ints_push(ops, sent_call());
                            ints_push(opat, at);
                            strs_push(cname, name);
                            ints_push(cargs, 0);
                            continue;
                        }
                    } else {
                        emit(nk, nar, nst, nen, ntx, n_var(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
                        ints_push(vs, start_at(starts, i));
                        ints_push(ve, end_at(ends, i));
                        i = i + 1;
                        done_primary = true;
                    }
                }
            }

            if done_primary == false {
                die("expected an expression", start_at(starts, i));
            }
        }

        // --- everything after an operand ---------------------------------------------
        while true {
            // A projection binds tighter than anything, **including a pending unary
            // minus**: `-p.x` is `-(p.x)`, because the reference parser reads a field
            // chain as part of the operand rather than as an operator over it. Handled
            // before the unary reduction below for exactly that reason. `?` is the other
            // postfix and binds the same way, in any order with `.`: `make()?.x`, `-r?`.
            while true {
                if kind_at(kinds, i) == k_question() {
                    let at = ints_get(vs, ints_len(vs) - 1);
                    let to = end_at(ends, i);
                    pop_val(vs, ve);
                    emit(nk, nar, nst, nen, ntx, n_propagate(), 1, at, to, "");
                    ints_push(vs, at);
                    ints_push(ve, to);
                    i = i + 1;
                    continue;
                }
                if kind_at(kinds, i) != k_dot() { break; }
                if kind_at(kinds, i + 1) != k_ident() {
                    die("expected a field name after `.`", start_at(starts, i + 1));
                }
                let fname = text_at(texts, i + 1);
                let to = end_at(ends, i + 1);
                let at = ints_get(vs, ints_len(vs) - 1);
                pop_val(vs, ve);
                emit(nk, nar, nst, nen, ntx, n_fieldread(), 1, at, to, fname);
                ints_push(vs, at);
                ints_push(ve, to);
                i = i + 2;
            }

            // Pending unary minus binds tighter than any binary operator, so it is
            // applied as soon as its operand exists.
            while ints_len(ops) > base {
                if ints_get(ops, ints_len(ops) - 1) != sent_unary() { break; }
                let at = ints_get(opat, ints_len(opat) - 1);
                pop_op(ops, opat);
                let e = ints_get(ve, ints_len(ve) - 1);
                pop_val(vs, ve);
                emit(nk, nar, nst, nen, ntx, n_neg(), 1, at, e, "");
                ints_push(vs, at);
                ints_push(ve, e);
            }

            let n = kind_at(kinds, i);

            if n == k_lbrace() {
                if innermost_is_if(ops, base) {
                    // The condition is complete. Reduce it to the sentinel and hand
                    // control back: the block is the frame machine's business, and the
                    // stacks stay exactly as they are until it resumes this expression.
                    while ints_len(ops) > base {
                        if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 { break; }
                        reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                    }
                    ints_set(status, 0, 1);
                    return i;
                }
                if innermost_is_match(ops, base) {
                    // The scrutinee is complete. The arms are the main loop's business,
                    // and the stacks stay exactly as they are — the scrutinee's operand
                    // entry sits under the sentinel until the `match` node is built.
                    while ints_len(ops) > base {
                        if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 { break; }
                        reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                    }
                    ints_set(status, 0, 2);
                    return i;
                }
            }

            let p = prec_of(n);

            if p > 0 {
                // Left-associative: reduce everything of equal or higher precedence
                // before pushing, which is what makes `a - b - c` group as `(a-b)-c`.
                while ints_len(ops) > base {
                    let top = ints_get(ops, ints_len(ops) - 1);
                    if prec_of(top) < p { break; }
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                }
                ints_push(ops, n);
                ints_push(opat, start_at(starts, i));
                i = i + 1;
                break;
            }

            if n == k_comma() {
                // Inside a `match`, a comma at the top of an arm body ends it. The
                // operator stack says whether the comma is instead separating arguments
                // of a call or a construction nested in that body.
                if ints_get(status, 1) > 0 {
                    if innermost_is_call(ops, base) == false {
                        while ints_len(ops) > base {
                            if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 {
                                die("this bracket is never closed", ints_get(opat, ints_len(opat) - 1));
                            }
                            reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                        }
                        pop_val(vs, ve);
                        ints_set(status, 0, 0);
                        return i;
                    }
                }
                if innermost_is_call(ops, base) == false { return i; }
                while ints_len(ops) > base {
                    if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 { break; }
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                }
                if ints_get(ops, ints_len(ops) - 1) == sent_variant() {
                    // A trailing comma is allowed and ends the list, so it must not count
                    // as another initialiser.
                    if kind_at(kinds, i + 1) == k_rparen() {
                        i = i + 1;
                        continue;
                    }
                    if kind_at(kinds, i + 1) != k_ident() {
                        die("expected a payload field name", start_at(starts, i + 1));
                    }
                    if kind_at(kinds, i + 2) != k_colon() {
                        die("expected `:` after a payload field name", start_at(starts, i + 2));
                    }
                    strs_set(cfields, strs_len(cfields) - 1,
                            str_concat(str_concat(strs_get(cfields, strs_len(cfields) - 1), ","),
                            text_at(texts, i + 1)));
                    ints_set(cargs, ints_len(cargs) - 1, ints_get(cargs, ints_len(cargs) - 1) + 1);
                    i = i + 3;
                    break;
                }
                if ints_get(ops, ints_len(ops) - 1) == sent_construct() {
                    // A trailing comma is allowed and ends the list, so it must not count
                    // as another initialiser.
                    if kind_at(kinds, i + 1) == k_rparen() {
                        i = i + 1;
                        continue;
                    }
                    if kind_at(kinds, i + 1) != k_ident() {
                        die("expected a field name", start_at(starts, i + 1));
                    }
                    if kind_at(kinds, i + 2) != k_colon() {
                        die("expected `:` after a field name", start_at(starts, i + 2));
                    }
                    strs_set(cfields, strs_len(cfields) - 1,
                            str_concat(str_concat(strs_get(cfields, strs_len(cfields) - 1), ","),
                            text_at(texts, i + 1)));
                    ints_set(cargs, ints_len(cargs) - 1, ints_get(cargs, ints_len(cargs) - 1) + 1);
                    i = i + 3;
                    break;
                }
                ints_set(cargs, ints_len(cargs) - 1, ints_get(cargs, ints_len(cargs) - 1) + 1);
                i = i + 1;
                break;
            }

            if n == k_rparen() {
                if ints_len(ops) == base { return i; }
                while ints_len(ops) > base {
                    if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 { break; }
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
                }
                let top = ints_get(ops, ints_len(ops) - 1);
                if top == sent_paren() {
                    // The brackets contribute no node and no span: `(1 + 2)` is the same
                    // tree as `1 + 2`, which is what the reference parser produces.
                    pop_op(ops, opat);
                    i = i + 1;
                    continue;
                }
                if top == sent_if() { return i; }
                if top == sent_match() { return i; }
                if top == sent_variant() {
                    let at = ints_get(opat, ints_len(opat) - 1);
                    pop_op(ops, opat);
                    let argc = ints_get(cargs, ints_len(cargs) - 1) + 1;
                    let name = strs_get(cname, strs_len(cname) - 1);
                    let fields = strs_get(cfields, strs_len(cfields) - 1);
                    pop_call(cname, cargs);
                    strs_pop(cfields);
                    let to = end_at(ends, i);
                    let mut left = 0;
                    while left < argc { pop_val(vs, ve); left = left + 1; }
                    emit(nk, nar, nst, nen, ntx, n_makevariant(), argc, at, to,
                            str_concat(str_concat(str_concat(name, "("), fields), ")"));
                    ints_push(vs, at);
                    ints_push(ve, to);
                    i = i + 1;
                    continue;
                }
                if top == sent_construct() {
                    let at = ints_get(opat, ints_len(opat) - 1);
                    pop_op(ops, opat);
                    let argc = ints_get(cargs, ints_len(cargs) - 1) + 1;
                    let name = strs_get(cname, strs_len(cname) - 1);
                    let fields = strs_get(cfields, strs_len(cfields) - 1);
                    pop_call(cname, cargs);
                    strs_pop(cfields);
                    let to = end_at(ends, i);
                    let mut dropped = 0;
                    while dropped < argc { pop_val(vs, ve); dropped = dropped + 1; }
                    // `Ty(a,b)` — the type and the field names in the order written,
                    // which is the order their values were computed in.
                    emit(nk, nar, nst, nen, ntx, n_construct(), argc, at, to,
                            str_concat(str_concat(str_concat(name, "("), fields), ")"));
                    ints_push(vs, at);
                    ints_push(ve, to);
                    i = i + 1;
                    continue;
                }
                if top == sent_call() {
                    let at = ints_get(opat, ints_len(opat) - 1);
                    pop_op(ops, opat);
                    let argc = ints_get(cargs, ints_len(cargs) - 1) + 1;
                    let name = strs_get(cname, strs_len(cname) - 1);
                    pop_call(cname, cargs);
                    let to = end_at(ends, i);
                    // The arguments are already in the arena, in order, immediately
                    // before this node — which is exactly what post-order means.
                    let mut drop = 0;
                    while drop < argc { pop_val(vs, ve); drop = drop + 1; }
                    emit(nk, nar, nst, nen, ntx, n_call(), argc, at, to, name);
                    ints_push(vs, at);
                    ints_push(ve, to);
                    i = i + 1;
                    continue;
                }
                return i;
            }

            // Anything else ends the expression. Whatever is still on the operator
            // stack is a real operator awaiting its reduction.
            while ints_len(ops) > base {
                if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 {
                    die("this bracket is never closed", ints_get(opat, ints_len(opat) - 1));
                }
                reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx, naux);
            }
            // The stacks belong to the caller and must come back empty, so the finished
            // expression's own entry is removed here rather than left for the next one.
            pop_val(vs, ve);
            ints_set(status, 0, 0);
            return i;
        }
    }
    i
}

fn pop_op(ops: Ints, opat: Ints) -> Int {
    ints_pop(opat);
    ints_pop(ops)
}

fn pop_val(vs: Ints, ve: Ints) -> Int {
    ints_pop(ve);
    ints_pop(vs)
}

fn pop_call(cname: Strs, cargs: Ints) -> Int {
    strs_pop(cname);
    ints_pop(cargs)
}

fn innermost_is_if(ops: Ints, base: Int) -> Bool {
    let mut i = ints_len(ops) - 1;
    while i >= base {
        let v = ints_get(ops, i);
        if v == sent_if() { return true; }
        if v == sent_match() { return false; }
        if v == sent_call() { return false; }
        if v == sent_paren() { return false; }
        i = i - 1;
    }
    false
}

// The same question for a `match`: whether the `{` now in hand closes a scrutinee or
// belongs to something nested inside it.
fn innermost_is_match(ops: Ints, base: Int) -> Bool {
    let mut i = ints_len(ops) - 1;
    while i >= base {
        let v = ints_get(ops, i);
        if v == sent_match() { return true; }
        if v == sent_if() { return false; }
        if v == sent_call() { return false; }
        if v == sent_paren() { return false; }
        i = i - 1;
    }
    false
}

// `IDENT ( IDENT :` — the two tokens past the bracket that tell a construction from a
// call. Total, because no argument expression can begin with a name followed by a colon.
// `ident ( . ident )* =` — an assignment rather than an expression. `==` is a different
// token, so a comparison in statement position is never mistaken for one.
fn assignment_ahead(kinds: Ints, i: Int) -> Bool {
    let mut at = i + 1;
    while true {
        if kind_at(kinds, at) == k_eq() { return true; }
        if kind_at(kinds, at) != k_dot() { return false; }
        if kind_at(kinds, at + 1) != k_ident() { return false; }
        at = at + 2;
    }
    false
}

fn constructing(kinds: Ints, i: Int) -> Bool {
    if kind_at(kinds, i + 1) != k_lparen() { return false; }
    if kind_at(kinds, i + 2) != k_ident() { return false; }
    kind_at(kinds, i + 3) == k_colon()
}

// `IDENT . IDENT (` — a variant construction rather than a field read. Total, because
// there are no methods and no function values, so a `(` can never follow a projection.
fn making_variant(kinds: Ints, i: Int) -> Bool {
    if kind_at(kinds, i + 1) != k_dot() { return false; }
    if kind_at(kinds, i + 2) != k_ident() { return false; }
    kind_at(kinds, i + 3) == k_lparen()
}

// --- types, as the text a node carries ------------------------------------------------
//
// A type with no arguments is its name, exactly as before N11: `Int`, `Point`. A type with
// arguments carries **where each part is written**, because a diagnostic about one argument
// of `Pair[Int, Vec[Nope]]` points at that argument and the node's own span cannot say
// where it is. Every name is followed by `@` and its offset, and every `]` by `@` and the
// offset just past it:
//
//     Pair@10[Int@15,Vec@20[Str@24]@27]@28
//
// The reference dumper in `crates/nazm-cli/tests/selfhost.rs` writes the same text from
// the reference parser's `TypeName`, so agreeing on the dump is agreeing on every span.
//
// No recursion: the nesting is a counter, because a type is a bracketed list and nothing
// else. `from` is where a type is expected, or — straight after a `[` — where a `]` may
// close an empty list; `open` is how many brackets are already open.
fn type_tail(kinds: Ints, starts: Ints, ends: Ints, texts: Strs, from: Int, head: Str,
        open: Int, out: Strs) -> Int {
    let mut at = from;
    let mut text = head;
    let mut depth = open;
    let mut want_type = true;
    // `[]` parses. It is a type written with the wrong number of arguments, which the
    // checker reports with the count it wanted — the reference's decision, for its reason.
    if depth > 0 {
        if kind_at(kinds, at) == k_rbracket() { want_type = false; }
    }
    while true {
        if want_type {
            if kind_at(kinds, at) != k_ident() {
                die("expected a type", start_at(starts, at));
            }
            text = str_concat(str_concat(str_concat(text, text_at(texts, at)), "@"),
                    int_to_str(start_at(starts, at)));
            at = at + 1;
            want_type = false;
            if kind_at(kinds, at) == k_lbracket() {
                text = str_concat(text, "[");
                depth = depth + 1;
                at = at + 1;
                if kind_at(kinds, at) != k_rbracket() { want_type = true; }
            }
            continue;
        }
        if depth == 0 { break; }
        if kind_at(kinds, at) == k_comma() {
            text = str_concat(text, ",");
            at = at + 1;
            want_type = true;
            continue;
        }
        if kind_at(kinds, at) == k_rbracket() {
            text = str_concat(str_concat(text, "]@"), int_to_str(end_at(ends, at)));
            depth = depth - 1;
            at = at + 1;
            continue;
        }
        die("expected `,` or `]` in the type arguments", start_at(starts, at));
    }
    strs_push(out, text);
    at
}

// Everything before the last `@` — a type argument list without its closing offset.
fn before_last_at(s: Str) -> Str {
    let mut i = str_len(s) - 1;
    while i >= 0 {
        if str_byte(s, i) == 64 { return str_slice(s, 0, i); }
        i = i - 1;
    }
    s
}

// A written type — a field's, a parameter's, a return's. Its text is pushed onto `out`;
// the index just past it is returned.
fn read_type(kinds: Ints, starts: Ints, ends: Ints, texts: Strs, i: Int, what: Str,
        out: Strs) -> Int {
    if kind_at(kinds, i) != k_ident() {
        die(what, start_at(starts, i));
    }
    if kind_at(kinds, i + 1) != k_lbracket() {
        strs_push(out, text_at(texts, i));
        return i + 1;
    }
    type_tail(kinds, starts, ends, texts, i, "", 0, out)
}

// `[A, B]` after a declared name, or nothing: `[A@7,B@10]`, pushed onto `out`. At least
// one name and no trailing comma, as the reference parser has it; whether the names are
// distinct is the checker's question.
fn read_type_params(kinds: Ints, starts: Ints, texts: Strs, i: Int, out: Strs) -> Int {
    if kind_at(kinds, i) != k_lbracket() {
        strs_push(out, "");
        return i;
    }
    let mut at = i + 1;
    let mut text = "[";
    while true {
        if kind_at(kinds, at) != k_ident() {
            die("expected a type parameter", start_at(starts, at));
        }
        text = str_concat(str_concat(str_concat(text, text_at(texts, at)), "@"),
                int_to_str(start_at(starts, at)));
        at = at + 1;
        // `T: Equality` — a requirement, N14, written into the item as `T@5=Equality@8`:
        // after the parameter's own position, where every reader of this list stops, so
        // only the checker's requirement reader sees it.
        if kind_at(kinds, at) == k_colon() {
            if kind_at(kinds, at + 1) != k_ident() {
                die("expected a capability after `:`", start_at(starts, at + 1));
            }
            text = str_concat(str_concat(str_concat(text, "="), text_at(texts, at + 1)),
                    str_concat("@", int_to_str(start_at(starts, at + 1))));
            at = at + 2;
        }
        if kind_at(kinds, at) != k_comma() { break; }
        text = str_concat(text, ",");
        at = at + 1;
    }
    if kind_at(kinds, at) != k_rbracket() {
        die("expected `]` to close the type parameters", start_at(starts, at));
    }
    strs_push(out, str_concat(text, "]"));
    at + 1
}

fn innermost_is_call(ops: Ints, base: Int) -> Bool {
    let mut i = ints_len(ops) - 1;
    while i >= base {
        let v = ints_get(ops, i);
        if v == sent_call() { return true; }
        if v == sent_construct() { return true; }
        if v == sent_variant() { return true; }
        if v == sent_paren() { return false; }
        if v == sent_if() { return false; }
        if v == sent_match() { return false; }
        i = i - 1;
    }
    false
}

// `naux` is the arena's auxiliary-offset column: for a `bin` node it is the **operator's
// own position**, which the node's span (left operand's start to right operand's end)
// does not contain. The reference checker points `N0304` there, and lowering will need
// it for the runtime diagnostics an arithmetic failure reports. It is not part of the
// dump, so the tree comparison is unaffected.
fn set_aux(naux: Ints, nk: Ints, value: Int) -> Int {
    while ints_len(naux) < ints_len(nk) - 1 { ints_push(naux, 0); }
    ints_push(naux, value);
    ints_len(naux)
}

fn pad_aux(naux: Ints, nk: Ints) -> Int {
    while ints_len(naux) < ints_len(nk) { ints_push(naux, 0); }
    ints_len(naux)
}

fn reduce(ops: Ints, opat: Ints, vs: Ints, ve: Ints, nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints) -> Int {
    let op = ints_get(ops, ints_len(ops) - 1);
    let op_at = ints_get(opat, ints_len(opat) - 1);
    pop_op(ops, opat);
    let rend = ints_get(ve, ints_len(ve) - 1);
    pop_val(vs, ve);
    let lstart = ints_get(vs, ints_len(vs) - 1);
    pop_val(vs, ve);
    emit(nk, nar, nst, nen, ntx, n_bin(), 2, lstart, rend, op_symbol(op));
    set_aux(naux, nk, op_at);
    ints_push(vs, lstart);
    ints_push(ve, rend);
    0
}

// --- statements, blocks and functions, by an explicit frame stack --------------------
//
// A block contains statements; a `while` contains a block; a function body is a block.
// That nesting is a stack, and here it is one — `fk`/`fstart`/`fcount`/`ftail`/`faux`/
// `ftext`/`fparams`, innermost last — walked by a single loop. No recursion, which is
// the same reason the expression parser uses sentinels rather than frames.

fn expect(kinds: Ints, starts: Ints, i: Int, want: Int, what: Str) -> Int {
    if kind_at(kinds, i) != want {
        die(what, start_at(starts, i));
    }
    i + 1
}

fn frame_body() -> Int { 1 }
fn frame_while() -> Int { 2 }
fn frame_if_then() -> Int { 3 }
fn frame_if_else() -> Int { 4 }
fn frame_scope() -> Int { 5 }
// A block written as an expression: the expression that reached it is suspended underneath,
// and resumes with the block as its operand once the block closes.
fn frame_blockexpr() -> Int { 6 }

// What to do once the expression now being parsed finally completes. It is a stack
// because an `if` can suspend an expression that was itself the value of a `let`, and
// the `let` still has to be finished afterwards.
fn pend_none() -> Int { 0 }
fn pend_let() -> Int { 1 }
fn pend_assign() -> Int { 2 }
fn pend_return() -> Int { 3 }
fn pend_while() -> Int { 4 }
fn pend_stmt() -> Int { 5 }
fn pend_spawn() -> Int { 6 }
// The body of one `match` arm. The pattern is already read and travels on `ptext`.
fn pend_arm() -> Int { 7 }

// `Enum.Variant(field: binding, …)` — one arm's pattern, as the text its node carries.
// Returns the index just past the `)`; the pattern text is pushed onto `out`.
//
// A field binds a name or is discarded with `_`, which is an ordinary identifier to the
// lexer and a discard only here. `docs/spec.md` gives `_` its meaning inside a pattern
// and nowhere else, so nothing before this point has to know about it.
fn read_pattern(kinds: Ints, starts: Ints, texts: Strs, i: Int, out: Strs) -> Int {
    if kind_at(kinds, i) != k_ident() {
        die("expected an enum name", start_at(starts, i));
    }
    let ename = text_at(texts, i);
    let mut at = i + 1;
    at = expect(kinds, starts, at, k_dot(), "expected `.` between an enum and its variant");
    if kind_at(kinds, at) != k_ident() {
        die("expected a variant name", start_at(starts, at));
    }
    let vname = text_at(texts, at);
    at = at + 1;
    at = expect(kinds, starts, at, k_lparen(), "expected `(` to start the payload");
    let mut text = str_concat(str_concat(str_concat(ename, "."), vname), "(");
    let mut first = true;
    while kind_at(kinds, at) != k_rparen() {
        if first == false { text = str_concat(text, ","); }
        first = false;
        if kind_at(kinds, at) != k_ident() {
            die("expected a payload field name", start_at(starts, at));
        }
        let fname = text_at(texts, at);
        at = at + 1;
        at = expect(kinds, starts, at, k_colon(), "expected `:` after a payload field name");
        if kind_at(kinds, at) != k_ident() {
            die("expected a binding or `_`", start_at(starts, at));
        }
        let bname = text_at(texts, at);
        at = at + 1;
        text = str_concat(str_concat(str_concat(text, fname), ":"), bname);
        if kind_at(kinds, at) == k_comma() { at = at + 1; }
    }
    at = at + 1;
    strs_push(out, str_concat(text, ")"));
    at
}

// Read one arm's pattern and open a pending expression for its body. Returns the index
// of the body's first token.
fn begin_arm(kinds: Ints, starts: Ints, texts: Strs, i: Int,
        pk: Ints, pstart: Ints, ptext: Strs, pdepth: Ints, pbase: Ints,
        fk: Ints, ops: Ints, status: Ints) -> Int {
    let at = start_at(starts, i);
    let next = read_pattern(kinds, starts, texts, i, ptext);
    ints_push(pk, pend_arm());
    ints_push(pstart, at);
    ints_push(pdepth, ints_len(fk));
    ints_push(pbase, ints_len(ops));
    // One more arm body open, which is what lets a `,` at the top of one end it.
    ints_set(status, 1, ints_get(status, 1) + 1);
    expect(kinds, starts, next, k_fatarrow(), "expected `=>` after a pattern")
}

fn push_frame(fk: Ints, fstart: Ints, fcount: Ints, ftail: Ints, faux: Ints, fparams: Ints,
        fvis: Ints, ftext: Strs, kind: Int, start: Int, aux: Int, params: Int, vis: Int,
        text: Str) -> Int {
    ints_push(fk, kind);
    ints_push(fstart, start);
    ints_push(fcount, 0);
    ints_push(ftail, 0);
    ints_push(faux, aux);
    ints_push(fparams, params);
    // 1 when `pub` was written before `fn`, 0 otherwise, and 0 for every frame that is
    // not a function. The parser records **that the word appeared**; what it means is the
    // checker's, exactly as in the reference front end.
    ints_push(fvis, vis);
    strs_push(ftext, text);
    ints_len(fk)
}

fn top(a: Ints) -> Int { ints_get(a, ints_len(a) - 1) }

// An item's auxiliary word: whether `pub` was written, and where the item's **name** is —
// which its node's span, starting at `pub` or the keyword, does not say. Two facts in one
// column because the column already exists and every item has exactly these two; read back
// by `is_public` and `name_offset` in `analyse.nz`.
pub fn item_aux(vis: Int, name_at: Int) -> Int { vis + 2 * name_at }

fn bump(a: Ints) -> Int {
    ints_set(a, ints_len(a) - 1, ints_get(a, ints_len(a) - 1) + 1);
    0
}

// Close an `if`: pop its sentinel, replace the condition's operand entry with the `if`'s
// own span, and emit the node. The children — condition, then-block, and any else-block —
// are already in the arena in that order, which is what post-order means.
// Whether the innermost pending expression is the thing to work on, or whether a block
// opened inside it must be finished first.
fn resumable(pk: Ints, pdepth: Ints, fk: Ints) -> Bool {
    if ints_len(pk) == 0 { return false; }
    ints_get(pdepth, ints_len(pdepth) - 1) == ints_len(fk)
}

fn finish_if(ops: Ints, opat: Ints, vs: Ints, ve: Ints,
        nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs,
        arity: Int, close: Int) -> Int {
    let at = ints_get(opat, ints_len(opat) - 1);
    pop_op(ops, opat);
    pop_val(vs, ve);
    emit(nk, nar, nst, nen, ntx, n_if(), arity, at, close, "");
    ints_push(vs, at);
    ints_push(ve, close);
    0
}

pub fn parse_program(kinds: Ints, starts: Ints, ends: Ints, texts: Strs,
        nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints) -> Int {
    let fk = ints_new();
    let fstart = ints_new();
    let fcount = ints_new();
    let ftail = ints_new();
    let faux = ints_new();
    let fparams = ints_new();
    let fvis = ints_new();
    let ftext = strs_new();

    // The expression machinery, created once: an `if` suspends an expression part-way
    // to parse a block, so these have to outlive a single `parse_expr` call.
    let ops = ints_new();
    let opat = ints_new();
    let cname = strs_new();
    let cargs = ints_new();
    // The field names of each construction being read, innermost last, as one
    // comma-separated string per construction — which is the form the node carries.
    let cfields = strs_new();
    let vs = ints_new();
    let ve = ints_new();
    let status = ints_new();
    ints_push(status, 0);
    // How many `match` arm bodies are open, innermost included. A comma at the top of one
    // ends it; everywhere else a comma separates arguments.
    ints_push(status, 0);
    // Arms read so far, one entry per open `match`.
    let marms = ints_new();

    // What the expression being parsed is *for*, innermost last.
    let pk = ints_new();
    let pstart = ints_new();
    let ptext = strs_new();
    // The block depth the expression was started at. An `if` inside it opens block
    // frames, and while any of those are open the *block* is what needs parsing —
    // the expression is suspended underneath them and must not be resumed early.
    let pdepth = ints_new();
    // How deep the operator stack was when each pending expression started.
    let pbase = ints_new();

    let mut i = 0;
    // Functions **and** records: both are top-level items and both are children of the
    // program node, in the order they were written. The reference dump sorts its two
    // lists back into source order for the same reason.
    let mut items = 0;
    let mut resuming = false;

    while i < ints_len(kinds) {
        // --- an expression is in progress -------------------------------------------
        if resumable(pk, pdepth, fk) {
            i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx,
                    ops, opat, cname, cargs, cfields, vs, ve, status, resuming,
                    ints_get(pbase, ints_len(pbase) - 1), naux);
            resuming = false;
            if ints_get(status, 0) == 1 {
                // Suspended at an `if`'s `{`: the condition is done and the block is
                // the frame machine's business.
                let brace = start_at(starts, i);
                i = i + 1;
                push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                        frame_if_then(), brace, 0, 0, 0, "");
                continue;
            }
            if ints_get(status, 0) == 3 {
                // Suspended at a block used as an operand. Reset here, because the next
                // thing to read this word is whatever the block's first statement is.
                ints_set(status, 0, 0);
                let brace = start_at(starts, i);
                i = i + 1;
                push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                        frame_blockexpr(), brace, 0, 0, 0, "");
                continue;
            }
            if ints_get(status, 0) == 2 {
                // Suspended at a `match`'s `{`: the scrutinee is done, and the arms are
                // read here. Each arm's body is an ordinary pending expression, which is
                // why an `if` inside one works without any machinery of its own.
                i = i + 1;
                ints_push(marms, 0);
                if kind_at(kinds, i) == k_rbrace() {
                    // No arms. The checker refuses it as non-exhaustive; the parser has
                    // nothing to object to.
                    let close = end_at(ends, i);
                    i = i + 1;
                    ints_pop(marms);
                    let mat = ints_get(opat, ints_len(opat) - 1);
                    pop_op(ops, opat);
                    pop_val(vs, ve);
                    emit(nk, nar, nst, nen, ntx, n_match(), 1, mat, close, "");
                    ints_push(vs, mat);
                    ints_push(ve, close);
                    resuming = true;
                    continue;
                }
                i = begin_arm(kinds, starts, texts, i, pk, pstart, ptext, pdepth, pbase,
                        fk, ops, status);
                continue;
            }
            // The expression finished. Complete whatever it was for.
            let what = top(pk);
            let at = top(pstart);
            let text = strs_get(ptext, strs_len(ptext) - 1);
            ints_pop(pk);
            ints_pop(pstart);
            ints_pop(pdepth);
            ints_pop(pbase);
            strs_pop(ptext);

            if what == pend_while() {
                let brace = start_at(starts, i);
                i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start a loop body");
                push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                        frame_while(), brace, at, 0, 0, "");
                continue;
            }
            if what == pend_arm() {
                ints_set(status, 1, ints_get(status, 1) - 1);
                emit(nk, nar, nst, nen, ntx, n_arm(), 1, at, end_at(ends, i - 1), text);
                ints_set(marms, ints_len(marms) - 1, ints_get(marms, ints_len(marms) - 1) + 1);
                if kind_at(kinds, i) == k_comma() {
                    i = i + 1;
                    if kind_at(kinds, i) != k_rbrace() {
                        i = begin_arm(kinds, starts, texts, i, pk, pstart, ptext, pdepth,
                                pbase, fk, ops, status);
                        continue;
                    }
                }
                if kind_at(kinds, i) != k_rbrace() {
                    die("expected `,` or `}` after an arm", start_at(starts, i));
                }
                let close = end_at(ends, i);
                i = i + 1;
                let arms = ints_get(marms, ints_len(marms) - 1);
                ints_pop(marms);
                // The scrutinee's operand entry has been waiting under the sentinel since
                // the `{`; the arms are already in the arena in order.
                let mat = ints_get(opat, ints_len(opat) - 1);
                pop_op(ops, opat);
                pop_val(vs, ve);
                emit(nk, nar, nst, nen, ntx, n_match(), arms + 1, mat, close, "");
                ints_push(vs, mat);
                ints_push(ve, close);
                resuming = true;
                continue;
            }
            if what == pend_stmt() {
                if kind_at(kinds, i) == k_semi() {
                    emit(nk, nar, nst, nen, ntx, n_exprstmt(), 1, at, end_at(ends, i - 1), "");
                    i = i + 1;
                    bump(fcount);
                    continue;
                }
                if kind_at(kinds, i) == k_rbrace() {
                    ints_set(ftail, ints_len(ftail) - 1, 1);
                    continue;
                }
                // An expression that *starts* with `if` or `{` needs no `;` to be a
                // statement — the same rule the reference parser follows, and the reason
                // `if c { … } i = i + 1;` is two statements rather than a tail followed
                // by something impossible.
                if text == "blocklike" {
                    emit(nk, nar, nst, nen, ntx, n_exprstmt(), 1, at, end_at(ends, i - 1), "");
                    bump(fcount);
                    continue;
                }
                die("expected `;` or `}` after this expression", start_at(starts, i));
                continue;
            }
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` to end this statement");
            if what == pend_let() {
                emit(nk, nar, nst, nen, ntx, n_let(), 1, at, semi, text);
            }
            if what == pend_assign() {
                emit(nk, nar, nst, nen, ntx, n_assign(), 1, at, semi, text);
            }
            if what == pend_return() {
                emit(nk, nar, nst, nen, ntx, n_return(), 1, at, semi, "");
            }
            if what == pend_spawn() {
                // The expression parser has just emitted the call. A `spawn` *is* that
                // node with a different kind and a span that starts at the keyword, so it
                // is retagged in place rather than rebuilt — which keeps exactly one
                // definition of how a call's arguments are parsed.
                let last = ints_len(nk) - 1;
                if ints_get(nk, last) != n_call() {
                    die("`spawn` needs a call to a named function", at);
                }
                ints_set(nk, last, n_spawn());
                // Where the callee is written, which the node's span no longer says once
                // it starts at the keyword: the auxiliary column, as a `bin`'s operator is.
                set_aux(naux, nk, ints_get(nst, last));
                ints_set(nst, last, at);
                ints_set(nen, last, semi);
            }
            bump(fcount);
            continue;
        }

        if ints_len(fk) == 0 {
            // --- top level: an import, or a function header ------------------------
            if kind_at(kinds, i) == k_use() {
                // Imports are the driver's business, not the grammar's, and contribute
                // no node — exactly as the reference parser treats them.
                i = i + 1;
                i = expect(kinds, starts, i, k_str(), "expected a quoted path");
                i = expect(kinds, starts, i, k_semi(), "expected `;` after an import");
                continue;
            }
            let fn_start = start_at(starts, i);
            // `pub`, optional. Recorded, not interpreted: it travels on the item node's
            // auxiliary column and the checker decides what it means.
            let mut vis = 0;
            if kind_at(kinds, i) == k_pub() {
                vis = 1;
                i = i + 1;
            }

            // `struct Name { field: Type, … }`. No frame machine and no expression: a
            // field list is names and type names, so one loop reads it.
            if kind_at(kinds, i) == k_struct() {
                i = i + 1;
                if kind_at(kinds, i) != k_ident() {
                    die("expected a record name", start_at(starts, i));
                }
                let tp = strs_new();
                let rname = text_at(texts, i);
                let name_at = start_at(starts, i);
                i = read_type_params(kinds, starts, texts, i + 1, tp);
                i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start the fields");
                let mut nfields = 0;
                while kind_at(kinds, i) != k_rbrace() {
                    if kind_at(kinds, i) != k_ident() {
                        die("expected a field name", start_at(starts, i));
                    }
                    let fname = text_at(texts, i);
                    let fat = start_at(starts, i);
                    i = i + 1;
                    i = expect(kinds, starts, i, k_colon(), "expected `:` after a field name");
                    let ft = strs_new();
                    i = read_type(kinds, starts, ends, texts, i, "expected a field type", ft);
                    let ftype = strs_get(ft, 0);
                    let fto = end_at(ends, i - 1);
                    emit(nk, nar, nst, nen, ntx, n_structfield(), 0, fat, fto,
                            str_concat(str_concat(fname, ":"), ftype));
                    nfields = nfields + 1;
                    if kind_at(kinds, i) == k_comma() { i = i + 1; }
                }
                let close = end_at(ends, i);
                i = i + 1;
                emit(nk, nar, nst, nen, ntx, n_record(), nfields, fn_start, close,
                        str_concat(rname, strs_get(tp, 0)));
                set_aux(naux, nk, item_aux(vis, name_at));
                items = items + 1;
                continue;
            }

            // `enum Name { Variant, Other(field: Type), … }`. Two loops rather than one,
            // because a variant may carry a payload and a payload is a field list —
            // which is the same shape a record's fields are, deliberately.
            if kind_at(kinds, i) == k_enum() {
                i = i + 1;
                if kind_at(kinds, i) != k_ident() {
                    die("expected an enum name", start_at(starts, i));
                }
                let etp = strs_new();
                let ename = text_at(texts, i);
                let ename_at = start_at(starts, i);
                i = read_type_params(kinds, starts, texts, i + 1, etp);
                i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start the variants");
                let mut nvariants = 0;
                while kind_at(kinds, i) != k_rbrace() {
                    if kind_at(kinds, i) != k_ident() {
                        die("expected a variant name", start_at(starts, i));
                    }
                    let vname = text_at(texts, i);
                    let vat = start_at(starts, i);
                    let mut vto = end_at(ends, i);
                    i = i + 1;
                    let mut npayload = 0;
                    if kind_at(kinds, i) == k_lparen() {
                        i = i + 1;
                        // `Eof()` is refused rather than read as a variant with no
                        // payload: one concept gets one spelling, and the spelling for no
                        // payload is no brackets.
                        if kind_at(kinds, i) == k_rparen() {
                            die("this variant has an empty payload, which is written by writing nothing",
                                    vat);
                        }
                        while kind_at(kinds, i) != k_rparen() {
                            if kind_at(kinds, i) != k_ident() {
                                die("expected a payload field name", start_at(starts, i));
                            }
                            let pname = text_at(texts, i);
                            let pat = start_at(starts, i);
                            i = i + 1;
                            i = expect(kinds, starts, i, k_colon(),
                                    "expected `:` after a payload field name");
                            let pt = strs_new();
                            i = read_type(kinds, starts, ends, texts, i,
                                    "expected a payload field type", pt);
                            let ptype = strs_get(pt, 0);
                            let pto = end_at(ends, i - 1);
                            emit(nk, nar, nst, nen, ntx, n_payload(), 0, pat, pto,
                                    str_concat(str_concat(pname, ":"), ptype));
                            npayload = npayload + 1;
                            if kind_at(kinds, i) == k_comma() { i = i + 1; }
                        }
                        vto = end_at(ends, i);
                        i = i + 1;
                    }
                    emit(nk, nar, nst, nen, ntx, n_variant(), npayload, vat, vto, vname);
                    nvariants = nvariants + 1;
                    if kind_at(kinds, i) == k_comma() { i = i + 1; }
                }
                let eclose = end_at(ends, i);
                i = i + 1;
                emit(nk, nar, nst, nen, ntx, n_enum(), nvariants, fn_start, eclose,
                        str_concat(ename, strs_get(etp, 0)));
                set_aux(naux, nk, item_aux(vis, ename_at));
                items = items + 1;
                continue;
            }

            i = expect(kinds, starts, i, k_fn(), "expected `fn`");
            if kind_at(kinds, i) != k_ident() {
                die("expected a function name", start_at(starts, i));
            }
            let ftp = strs_new();
            let name = text_at(texts, i);
            let fname_at = start_at(starts, i);
            i = read_type_params(kinds, starts, texts, i + 1, ftp);
            i = expect(kinds, starts, i, k_lparen(), "expected `(` after the function name");
            let mut params = 0;
            while kind_at(kinds, i) != k_rparen() {
                if kind_at(kinds, i) != k_ident() {
                    die("expected a parameter name", start_at(starts, i));
                }
                let pname = text_at(texts, i);
                let pstart = start_at(starts, i);
                i = i + 1;
                i = expect(kinds, starts, i, k_colon(), "expected `:` after a parameter name");
                let pty = strs_new();
                i = read_type(kinds, starts, ends, texts, i, "expected a type", pty);
                let ptype = strs_get(pty, 0);
                let pend = end_at(ends, i - 1);
                emit(nk, nar, nst, nen, ntx, n_param(), 0, pstart, pend,
                        str_concat(str_concat(pname, ":"), ptype));
                params = params + 1;
                if kind_at(kinds, i) == k_comma() { i = i + 1; }
            }
            i = i + 1;
            i = expect(kinds, starts, i, k_arrow(), "expected `->` and a return type");
            let rty = strs_new();
            let ret_at = start_at(starts, i);
            i = read_type(kinds, starts, ends, texts, i, "expected a return type", rty);
            // A return type always carries where it is written: the `fn` node's span is the
            // whole function, so nothing else could say.
            let mut ret = strs_get(rty, 0);
            if kind_at(kinds, i - 1) == k_ident() {
                ret = str_concat(str_concat(ret, "@"), int_to_str(ret_at));
            }
            let brace = start_at(starts, i);
            i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start the body");
            push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                    frame_body(), brace, fn_start, params, item_aux(vis, fname_at),
                    str_concat(str_concat(str_concat(name, strs_get(ftp, 0)), ":"), ret));
            continue;
        }

        // --- inside a block ---------------------------------------------------------
        let t = kind_at(kinds, i);

        if t == k_rbrace() {
            let close = end_at(ends, i);
            i = i + 1;
            let kind = top(fk);
            let start = top(fstart);
            let count = top(fcount);
            let tail = top(ftail);
            let aux = top(faux);
            let params = top(fparams);
            let vis_of = top(fvis);
            let text = strs_get(ftext, strs_len(ftext) - 1);
            ints_pop(fk);
            ints_pop(fstart);
            ints_pop(fcount);
            ints_pop(ftail);
            ints_pop(faux);
            ints_pop(fparams);
            ints_pop(fvis);
            strs_pop(ftext);
            emit(nk, nar, nst, nen, ntx, n_block(), count + tail, start, close,
                    if tail == 1 { "tail" } else { "" }
                    );
            if kind == frame_if_then() {
                // `else` or not decides the arity, and the `if`'s span runs to whichever
                // block closed last.
                if kind_at(kinds, i) == k_else() {
                    i = i + 1;
                    let brace2 = start_at(starts, i);
                    i = expect(kinds, starts, i, k_lbrace(),
                            "expected `{` after `else`");
                    push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                            frame_if_else(), brace2, 0, 0, 0, "");
                    continue;
                }
                finish_if(ops, opat, vs, ve, nk, nar, nst, nen, ntx, 2, close);
                resuming = true;
                continue;
            }
            if kind == frame_if_else() {
                finish_if(ops, opat, vs, ve, nk, nar, nst, nen, ntx, 3, close);
                resuming = true;
                continue;
            }
            if kind == frame_blockexpr() {
                // The block is the operand the suspended expression was waiting for, with
                // the block's own span — the brace to the brace, as the reference's is.
                emit(nk, nar, nst, nen, ntx, n_blockexpr(), 1, start, close, "");
                ints_push(vs, start);
                ints_push(ve, close);
                resuming = true;
                continue;
            }
            if kind == frame_scope() {
                // The block is the one child, and the `scope` spans from its keyword to
                // the closing brace — the shape `selfhost.rs` writes down for it.
                emit(nk, nar, nst, nen, ntx, n_scope(), 1, aux, close, "");
                bump(fcount);
                continue;
            }
            if kind == frame_while() {
                // The condition was emitted before the body, so the two children are
                // already in post-order and the `while` closes over them.
                emit(nk, nar, nst, nen, ntx, n_while(), 2, aux, close, "");
                bump(fcount);
            } else {
                emit(nk, nar, nst, nen, ntx, n_fn(), params + 1, aux, close, text);
                // The auxiliary column, whose meaning is per node kind: an operator's
                // offset on a `bin`, and here the visibility bit. `set_aux` has to follow
                // the `emit` it belongs to, which is why it is written beside it.
                set_aux(naux, nk, vis_of);
                items = items + 1;
            }
            continue;
        }

        if top(ftail) == 1 {
            die("this block already produced its value; nothing can follow it",
                    start_at(starts, i));
        }

        if t == k_let() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let mut mutable = 0;
            if kind_at(kinds, i) == k_mut() { mutable = 1; i = i + 1; }
            if kind_at(kinds, i) != k_ident() {
                die("expected a name after `let`", start_at(starts, i));
            }
            let name = text_at(texts, i);
            i = i + 1;
            i = expect(kinds, starts, i, k_eq(), "expected `=` in a `let`");
            ints_push(pk, pend_let());
            ints_push(pdepth, ints_len(fk));
            ints_push(pbase, ints_len(ops));
            ints_push(pstart, stmt_start);
            strs_push(ptext, str_concat(str_concat(name, ":"), int_to_str(mutable)));
            continue;
        }

        if t == k_ident() {
            // `ident ( . ident )* =`. The scan walks the path and stops at the first
            // token that is not part of one, so `a.b` as a tail expression and `a == b`
            // in statement position are both left alone.
            if assignment_ahead(kinds, i) {
                let stmt_start = start_at(starts, i);
                let mut name = text_at(texts, i);
                i = i + 1;
                while kind_at(kinds, i) == k_dot() {
                    name = str_concat(str_concat(name, "."), text_at(texts, i + 1));
                    i = i + 2;
                }
                i = i + 1;
                ints_push(pk, pend_assign());
                ints_push(pdepth, ints_len(fk));
                // Exactly one floor per pending expression, because exactly one is
                // popped when it completes. Pushing twice here left a stale floor on top
                // of the stack, and an expression that suspended at an `if` and resumed
                // afterwards read *that* instead of its own — too high, so operators
                // below it were never popped. `let x = 1 + if c { a = 1; a } else { 2 };`
                // silently lost its `+`.
                ints_push(pbase, ints_len(ops));
                ints_push(pstart, stmt_start);
                strs_push(ptext, name);
                continue;
            }
        }

        if t == k_scope() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let brace = start_at(starts, i);
            i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start a scope");
            push_frame(fk, fstart, fcount, ftail, faux, fparams, fvis, ftext,
                    frame_scope(), brace, stmt_start, 0, 0, "");
            continue;
        }

        if t == k_spawn() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            // A task runs a *named* function — there are no function values, so the
            // callee is an identifier and nothing else. Checked here rather than left to
            // the expression parser, which would report whatever it happened to find.
            if kind_at(kinds, i) != k_ident() {
                die("expected a function name after `spawn`", start_at(starts, i));
            }
            if kind_at(kinds, i + 1) != k_lparen() {
                die("expected `(` after the function name in a `spawn`",
                        start_at(starts, i + 1));
            }
            ints_push(pk, pend_spawn());
            ints_push(pdepth, ints_len(fk));
            ints_push(pbase, ints_len(ops));
            ints_push(pstart, stmt_start);
            strs_push(ptext, "");
            continue;
        }

        if t == k_while() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            ints_push(pk, pend_while());
            ints_push(pdepth, ints_len(fk));
            ints_push(pbase, ints_len(ops));
            ints_push(pstart, stmt_start);
            strs_push(ptext, "");
            continue;
        }

        if t == k_return() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            ints_push(pk, pend_return());
            ints_push(pdepth, ints_len(fk));
            ints_push(pbase, ints_len(ops));
            ints_push(pstart, stmt_start);
            strs_push(ptext, "");
            continue;
        }

        // The span of `break;` covers the `;` as well as the keyword, which is what the
        // reference parser records — a statement's span is the statement, semicolon
        // included.
        if t == k_break() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after `break`");
            emit(nk, nar, nst, nen, ntx, n_break(), 0, stmt_start, semi, "");
            bump(fcount);
            continue;
        }

        if t == k_continue() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after `continue`");
            emit(nk, nar, nst, nen, ntx, n_continue(), 0, stmt_start, semi, "");
            bump(fcount);
            continue;
        }

        // An expression: a statement if a `;` follows, the block's value if not.
        refuse_unimplemented(kinds, starts, i);
        ints_push(pk, pend_stmt());
        ints_push(pdepth, ints_len(fk));
        ints_push(pbase, ints_len(ops));
        ints_push(pstart, start_at(starts, i));
        let mut blocklike = 0;
        if t == k_if() { blocklike = 1; }
        if t == k_lbrace() { blocklike = 1; }
        if blocklike == 1 {
            strs_push(ptext, "blocklike");
        } else {
            strs_push(ptext, "");
        }
    }

    if ints_len(fk) > 0 {
        die("this block is never closed", top(fstart));
    }
    emit(nk, nar, nst, nen, ntx, n_program(), items, 0, 0, "");
    pad_aux(naux, nk);
    items
}
