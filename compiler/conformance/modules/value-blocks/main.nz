use "lib.nz";

// Value-producing arm blocks over another module's enum and over the prelude's `Option`.
fn score(n: Int) -> Int {
    let base = match token(n) {
        Token.Word(text: s) => {
            let w = s;
            str_len(w) * 100
        },
        Token.Number(value: v) => {
            let doubled = v * 2;
            doubled
        },
        Token.End() => {
            0
        },
    };
    let extra = match find(n) {
        Option.None() => {
            0
        },
        Option.Some(value: f) => {
            let g = f;
            str_len(g)
        },
    };
    base + extra
}

fn main() -> Int {
    score(0) + score(3) * 10 + score(4) * 1000 + score(15) * 100000
}
