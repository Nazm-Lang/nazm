// A record and an enum exported across a module boundary, compared by an importer that
// knows them only through what this module publishes.

pub struct Point {
    x: Int,
    label: Str,
}

pub enum State {
    Ready,
    Done(code: Int, why: Str),
}

pub fn at(n: Int) -> Point {
    Point(x: n, label: str_concat("p", int_to_str(n)))
}

pub fn finished(code: Int) -> State {
    State.Done(code: code, why: str_concat("code ", int_to_str(code)))
}
