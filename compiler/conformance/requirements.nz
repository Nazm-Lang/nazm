// A type parameter that requires equality, N14: bounded bodies instantiated at `Int`,
// `Str`, a record, an enum, `Box[T]`, `Option[T]` and `Result[T, E]`, and forwarded.
//
// Every answer is folded into one integer by place value, so a comparison that answers
// wrongly in the reference, C2 or C3 changes a digit rather than hiding in a sum.

struct Point {
    x: Int,
    label: Str,
}

enum Shape {
    Plain,
    Named(label: Str),
}

struct Box[T] {
    value: T,
}

fn same[T: Equality](a: T, b: T) -> Bool {
    a == b
}

fn box_same[T: Equality](a: Box[T], b: Box[T]) -> Bool {
    a == b
}

fn option_same[T: Equality](a: Option[T], b: Option[T]) -> Bool {
    a == b
}

fn result_same[T: Equality, E: Equality](a: Result[T, E], b: Result[T, E]) -> Bool {
    a == b
}

// A generic caller passes on only what it requires itself.
fn forward[T: Equality](a: T, b: T) -> Bool {
    same(a, b)
}

fn text(n: Int) -> Str {
    str_concat("n-", int_to_str(n))
}

fn bit(b: Bool, place: Int) -> Int {
    if b { place } else { 0 }
}

fn main() -> Int {
    let mut total = bit(same(3, 3), 1);
    total = total + bit(same(text(1), "n-2"), 10);
    total = total + bit(same(Point(x: 1, label: text(4)), Point(label: "n-4", x: 1)), 100);
    total = total + bit(same(Shape.Plain(), Shape.Named(label: text(5))), 1000);
    total = total + bit(box_same(Box[Str](value: text(6)), Box[Str](value: text(6))), 10000);
    total = total + bit(option_same(Option[Int].Some(value: 7), Option[Int].Some(value: 7)), 100000);
    total = total + bit(result_same(Result[Int, Str].Err(error: text(8)), Result[Int, Str].Ok(value: 8)), 1000000);
    total = total + bit(forward(Box[Int](value: 9), Box[Int](value: 9)), 10000000);
    total
}
