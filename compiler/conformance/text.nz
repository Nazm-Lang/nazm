fn count(s: Str, want: Int) -> Int {
    let mut i = 0;
    let mut n = 0;
    while i < str_len(s) {
        if str_byte(s, i) == want { n = n + 1; }
        i = i + 1;
    }
    n
}

fn main() -> Int {
    let parts = strs_new();
    strs_push(parts, "ba");
    strs_push(parts, "na");
    strs_push(parts, "na");
    let joined = str_join(parts, "");
    if joined == "banana" {
        count(joined, 97) * 100 + str_len(str_slice(joined, 2, 6)) * 10 + str_len(int_to_str(0 - 42))
    } else {
        0 - 1
    }
}
