// expect: N0302
// Arm blocks are checked by the rules every arm is: the two tails disagree.
fn f(o: Option[Int]) -> Int {
    match o {
        Option.None() => {
            1
        },
        Option.Some(value: v) => {
            let s = int_to_str(v);
            s
        },
    }
}

fn main() -> Int {
    f(Option[Int].None())
}
