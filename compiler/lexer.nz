// The tokeniser's command-line driver.
//
// Usage: lexer FILE
// Output: one token per line, `kind start end`, then a final `EOF` line. A lexing error
// prints `error N000n at OFFSET` to standard error and exits 1.

use "lex.nz";

fn main(io: IoCap) -> Int {
    if args_count() < 1 {
        eprint("usage: lexer FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts, io);

    // One allocation for the whole output. `str_concat` in a loop is quadratic in time
    // *and* memory, and with nothing ever freed that is what exhausted memory on large
    // inputs — the same measurement that made `str_join` a built-in (see `emit.nz`).
    let nl = str_from_byte(10);
    let out = strs_new();
    let mut i = 0;
    while i < ints_len(kinds) {
        // The ten compound assignments are one kind here, as `selfhost.rs` maps the reference's.
        let mut k = ints_get(kinds, i);
        if k > 70 { if k <= 79 { k = 70; } }
        strs_push(out, int_to_str(k));
        strs_push(out, " ");
        strs_push(out, int_to_str(ints_get(starts, i)));
        strs_push(out, " ");
        strs_push(out, int_to_str(ints_get(ends, i)));
        strs_push(out, nl);
        i = i + 1;
    }
    strs_push(out, "EOF");
    strs_push(out, nl);
    print(str_join(out, ""));
    ints_len(kinds)
}
