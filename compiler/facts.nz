// The front end's facts about a compilation, for the tools (R2, `openspec/changes/r2-front-end/`
// design D24; what R5's `nazm doc` reads, `openspec/changes/r5-commands/design.md` D10).
//
// `fx_check` runs the whole front end over the compilation rooted at a file — the source root and
// its package found, every module loaded, parsed, configured and checked — exactly as
// `nazm check FILE` does, and keeps what each stage knew. A tool then asks:
//
// - whether the front end carried the compilation (`fx_carried`): only then are its answers the
//   reference's. Where it stopped, `fx_why` says at what, and a tool refuses as the reference
//   never would differently (R5 D5);
// - whether it failed (`fx_failed`), its diagnostics (`fx_diags`) and their text rendering over
//   every file (`fx_render`, `Diagnostic::render` as `nazm check` writes it to standard error);
// - each module's name, text, durable key (`fx_module_key`, `ModuleKey`) and identity as Core IR
//   names it (`fx_module_identity`, `Names::module`), and whether it is the program's own;
// - the checker's numbering of functions, records, enums and traits (`sema.nz`'s `ck_fn_*`,
//   `ck_record_*`, `ck_enum_*`, `ck_trait_*` through `fx_checker`), each one's durable identity
//   (`fx_fn_identity`, `fx_record_identity`, `fx_enum_identity`, `fx_trait_identity`, as
//   `cir::Names` writes them), its declaration's node in `fx_tree` with its spans
//   (`fx_start`, `fx_end`, local to its module's text) and attributes (`fx_deprecated`);
// - what each name a `pub use` chooses resolves to (`fx_reexport_of`).
//
// Types are written as `Types::show` writes them, and effect sets by name (`ck_effect_names`).

use "syntax.nz";
use "diag.nz";
use "load.nz";
use "sema.nz";
use "configure.nz";
use "package.nz";
use "builtins.nz";
use "@std/blake3";

pub struct Facts {
    // Why the front end did not carry the compilation, as the driver says it ("the checker stops
    // at …", "the loader stops at …"); empty where it carried it.
    why: Strs,
    // Whether the reference refuses the compilation without a diagnostic of a module (a manifest
    // that is not one): it fails, publishes nothing, and says why (`refusal`).
    refused: Ints,
    refusal: Strs,
    d: Diags,
    t: Tree,
    c: Ck,
    // Per module, in load order: its name, text (newline included), offset among them, durable
    // key ("" for none) and program node.
    names: Strs,
    texts: Strs,
    bases: Ints,
    keys: Strs,
    programs: Ints,
    // The root file's directory, normalised, which a source's path is shown relative to.
    dir: Strs,
    // The source root, normalised, which a file's place in the language service's identities is
    // relative to ("" until the compilation is rooted).
    sroot: Strs,
    // Whether the dumps of `facts-dump.nz` are written for a compilation that fails too (a comparison's knob, `fx_dump_errors`).
    dump_errors: Ints,
}

// A line break, written so that no string literal in this file holds one.
fn nl() -> Str { str_from_byte(10) }

fn facts_new() -> Facts {
    let t = sx_tree();
    let f = Facts(why: strs_new(), refused: ints_new(), refusal: strs_new(), d: dg_new(), t: t, c: ck_none(t), names: strs_new(), texts: strs_new(), bases: ints_new(),
            keys: strs_new(), programs: ints_new(), dir: strs_new(), sroot: strs_new(), dump_errors: ints_new());
    ints_push(f.dump_errors, 0);
    strs_push(f.sroot, "");
    strs_push(f.why, "");
    ints_push(f.refused, 0);
    strs_push(f.refusal, "");
    strs_push(f.dir, "");
    f
}

fn give_up(f: Facts, why: Str) -> Facts {
    strs_set(f.why, 0, why);
    f
}

// The compilation rooted at `path` (absolute) as a program (`Entry::Required`: the root must have
// `main`), the standard modules and the core prelude read from `library`, `@cfg` asked of `os`
// and `arch` as Rust's `std::env::consts` names them ("" for unknown: a condition on either then
// stops the checker).
pub fn fx_check(path: Str, library: Str, os: Str, arch: Str, io: IoCap) -> Facts { check_as(path, "", strs_new(), strs_new(), library, os, arch, true, false, io) }

// The same, with the source root given (`check --source-root`, `root::decide`'s `given`): "" to
// decide it as `fx_check` does.
pub fn fx_check_in(path: Str, source_root: Str, library: Str, os: Str, arch: Str, io: IoCap) -> Facts {
    check_as(path, source_root, strs_new(), strs_new(), library, os, arch, true, false, io)
}

// The same, where the files at `paths` have the texts `texts` instead of what is on disk: the
// language server's documents not yet saved (`lsp`). A standard module is always the library's.
pub fn fx_check_over(path: Str, source_root: Str, paths: Strs, texts: Strs, library: Str, os: Str, arch: Str, io: IoCap) -> Facts {
    check_as(path, source_root, paths, texts, library, os, arch, true, true, io)
}

// The same compilation as a module (`Entry::Absent`), as `nazm doc` checks one: whether anything
// can run is not asked, so a root without `main` is no error.
pub fn fx_check_module(path: Str, library: Str, os: Str, arch: Str, io: IoCap) -> Facts { check_as(path, "", strs_new(), strs_new(), library, os, arch, false, false, io) }
pub fn fx_check_module_in(path: Str, source_root: Str, library: Str, os: Str, arch: Str, io: IoCap) -> Facts {
    check_as(path, source_root, strs_new(), strs_new(), library, os, arch, false, false, io)
}

// The same compilation as the language service analyses it: a module, over what was loaded when the loader reported errors (an import it
// could not resolve is no edge), so the checker's own diagnostics follow the loader's.
pub fn fx_check_service(path: Str, source_root: Str, library: Str, os: Str, arch: Str, io: IoCap) -> Facts {
    check_as(path, source_root, strs_new(), strs_new(), library, os, arch, false, true, io)
}

// The same as `fx_check_in`, with the profiles in force (`check --profile`): what an `@cfg(profile = "…")` asks.
pub fn fx_check_profiles(path: Str, source_root: Str, library: Str, os: Str, arch: Str, profiles: Strs, io: IoCap) -> Facts {
    check_with(path, source_root, strs_new(), strs_new(), library, os, arch, true, false, profiles, 0 - 1, io)
}

fn check_as(path: Str, given: Str, paths: Strs, texts: Strs, library: Str, os: Str, arch: Str, program: Bool, partial: Bool, io: IoCap) -> Facts {
    check_with(path, given, paths, texts, library, os, arch, program, partial, strs_new(), 0 - 1, io)
}

// The same as the language service analyses a document (`fx_check_over`), as a completion probe (N26): the root file parsed with a hole at byte `hole`, where the grammar has one there. The
// hole found is `fx_hole_kind` (0 for none; 1 a member, 2 a call, 3 a payload) and `fx_hole_span`; the checker is told which callee the hole is in, if it is in a call.
pub fn fx_check_probe(path: Str, source_root: Str, paths: Strs, texts: Strs, library: Str, os: Str, arch: Str, hole: Int, io: IoCap) -> Facts {
    check_with(path, source_root, paths, texts, library, os, arch, true, true, strs_new(), hole, io)
}

fn check_with(path: Str, given: Str, paths: Strs, texts: Strs, library: Str, os: Str, arch: Str, program: Bool, partial: Bool, profiles: Strs, hole: Int, io: IoCap) -> Facts {
    let f = facts_new();
    let d = f.d;
    // The source root, as `root::decide` finds it: the first manifest upward whose source root holds
    // the file, or the first `nazm.root` marker, or the file's own directory.
    if str_len(path) == 0 || str_byte(path, 0) != 47 { return give_up(f, "the loader stops at a relative path"); }
    strs_set(f.dir, 0, pk_parent(pk_normalise(path)));
    let mut root = pk_decide(path, io);
    if given != "" { root = pk_given(path, given, ld_is_directory(given, io)); }
    let how = pk_root_how(root);
    if how == 0 - 2 { return give_up(f, str_concat("the loader stops at ", pk_root_why(root))); }
    // A manifest that is not one, or a marker that is not empty: the reference refuses the
    // compilation with no diagnostic of a module, so nothing is published.
    if how == 0 - 1 {
        ints_set(f.refused, 0, 1);
        strs_set(f.refusal, 0, pk_root_why(root));
        return f;
    }
    if how == 2 { return give_up(f, "the loader stops at a `nazm.root` marker"); }
    let source_root = pk_root_path(root);
    strs_set(f.sroot, 0, pk_normalise(source_root));
    // A package's compilation (N46): the package and its dependencies, resolved.
    let mut packages = pk_none();
    if how == 1 {
        packages = pk_context(source_root, io);
        if pk_packages_state(packages) != 1 {
            let mut why = pk_packages_why(packages);
            if pk_packages_state(packages) == 0 { why = "a package whose source root is not its manifest's directory's child"; }
            return give_up(f, str_concat("the loader stops at ", why));
        }
    }
    let loaded = ld_load_over(path, library, source_root, packages, paths, texts, d, io);
    let mut i = 0;
    while i < ld_count(loaded) {
        strs_push(f.names, ld_name(loaded, i));
        strs_push(f.texts, ld_text(loaded, i));
        ints_push(f.bases, ld_base(loaded, i));
        strs_push(f.keys, module_key(loaded, i, source_root, packages));
        i = i + 1;
    }
    // A compilation that could not be loaded reports the loader's diagnostics and nothing else — but for the language server's, which
    // analyses what was loaded (`partial`: an import the loader did not resolve is no edge).
    if dg_len(d) > 0 && partial == false { return f; }
    let loader_errors = dg_len(d);
    let t = f.t;
    let mut root_program = 0 - 1;
    // The module graph as the loader resolved it: each module's imports, in source order, by
    // the index of the module each names; and whether each module is a standard one.
    let graph = ck_graph();
    i = 0;
    while i < ld_count(loaded) {
        let own = dg_new();
        let mut program = 0 - 1;
        if i == 0 && hole >= 0 { program = sx_parse_source_at(ld_text(loaded, i), t, own, hole); } else { program = sx_parse_source(ld_text(loaded, i), t, own); }
        if i == 0 { root_program = program; }
        // A module that is not the program's own — a standard one, the prelude or a package's —
        // holds only the authority it is given (R1.5, D8).
        ck_graph_module(graph, ld_program(loaded, i) == false);
        let count = ints_len(sx_items(t, sx_field(t, program, "imports")));
        let mut k = 0;
        while k < count {
            ck_graph_import(graph, ld_import_target(loaded, i, k));
            k = k + 1;
        }
        // The prelude's standard modules it names (R1.5, D9), by the module each is.
        if ld_implicit(loaded, i) != "" {
            let given = split_commas(ld_implicit(loaded, i));
            k = 0;
            while k < strs_len(given) {
                ck_graph_implicit(graph, module_named(loaded, str_concat(str_concat("@std/", strs_get(given, k)), ".nz")));
                k = k + 1;
            }
        }
        ints_push(f.programs, program);
        dg_append_in(d, own, ld_base(loaded, i), i);
        i = i + 1;
    }
    let syntax_failed = dg_len(d) > loader_errors;
    // Every attribute held to the vocabulary and every declaration whose `@cfg` does not hold for
    // the host dropped (`attributes::configure`, design D19), before anything resolves a name; its
    // refusals count as the parser's do.
    let unsure = cf_configure(t, f.programs, f.bases, d, cf_host_profiles(os, arch, profiles));
    let parse_failed = dg_len(d) > loader_errors;
    ck_graph_diags(graph, loader_errors, dg_len(d));
    // The checker (`sema.nz`), where it carries the whole compilation (design D13); where it
    // stops, nothing of it is published. After a syntax error it checks what did parse, as the
    // reference does.
    if syntax_failed { ck_graph_syntax_error(graph); }
    if syntax_failed == false && parse_failed { ck_graph_attribute_error(graph); }
    if hole >= 0 {
        // A completion probe: which callee the hole is in, if it is in a call.
        let site = sx_field(t, root_program, "hole");
        let mut callee = 0 - 1;
        if site >= 0 && sx_is_some(t, site) && sx_name(t, sx_unwrap(t, site), "kind") == "2" { callee = sx_s(t, sx_field(t, sx_unwrap(t, site), "a")); }
        ck_graph_probe(graph, callee);
    }
    let c = ck_check(t, f.programs, f.bases, f.names, graph);
    let mut stopped = ck_stopped(c);
    if unsure { stopped = "a condition on the host, which was not given"; }
    let done = Facts(why: f.why, refused: f.refused, refusal: f.refusal, d: d, t: t, c: c, names: f.names, texts: f.texts, bases: f.bases, keys: f.keys, programs: f.programs,
            dir: f.dir, sroot: f.sroot, dump_errors: f.dump_errors);
    if stopped == "" {
        if program {
            dg_append(d, ck_diags(c), 0);
        } else {
            dg_append_without(d, ck_diags(c), "N0204");
        }
        return done;
    }
    strs_set(done.why, 0, str_concat("the checker stops at ", stopped));
    // The root owns `main` (`nazm-core/src/check/mod.rs`); a function that failed to parse was
    // never registered, so the missing `main` is not reported after a syntax error.
    if parse_failed == false && program {
        let functions = sx_items(t, sx_field(t, root_program, "functions"));
        let mut has_main = false;
        let mut k = 0;
        while k < ints_len(functions) {
            if sx_name(t, ints_get(functions, k), "name") == "main" { has_main = true; }
            k = k + 1;
        }
        if has_main == false {
            dg_error(d, "N0204", 0, 0, "this program has no `main` function", "",
                    "`nazm run` evaluates `fn main() -> Int` in the file you named");
        }
    }
    done
}

// The completion hole a probe found in the root file: its kind (0 for none; 1 a member name, 2 a call's callee, 3 a variant's payload), the span it is about (a member's empty name, the callee,
// the variant: module-local bytes), and for a payload whether it is a pattern's.
pub fn fx_hole_kind(f: Facts) -> Int {
    let t = f.t;
    if ints_len(f.programs) == 0 { return 0; }
    let site = sx_field(t, ints_get(f.programs, 0), "hole");
    if site < 0 || sx_is_some(t, site) == false { return 0; }
    let k = sx_name(t, sx_unwrap(t, site), "kind");
    if k == "1" { return 1; }
    if k == "2" { return 2; }
    3
}
pub fn fx_hole_start(f: Facts) -> Int { sx_s(f.t, sx_field(f.t, sx_unwrap(f.t, sx_field(f.t, ints_get(f.programs, 0), "hole")), "a")) }
pub fn fx_hole_end(f: Facts) -> Int { sx_e(f.t, sx_field(f.t, sx_unwrap(f.t, sx_field(f.t, ints_get(f.programs, 0), "hole")), "a")) }
pub fn fx_hole_pattern(f: Facts) -> Bool { sx_name(f.t, sx_unwrap(f.t, sx_field(f.t, ints_get(f.programs, 0), "hole")), "pattern") == "true" }

// Whether the front end carried the whole compilation: every answer below is then the reference's
// — whether it fails (`fx_failed`), with which diagnostics, and what it defines. A compilation the
// reference refuses without a diagnostic of a module is carried, and fails.
pub fn fx_carried(f: Facts) -> Bool { strs_get(f.why, 0) == "" }

// Whether every module was loaded (no loading error): what the checker then reads.
pub fn fx_loaded(f: Facts) -> Bool { ints_len(f.programs) == strs_len(f.names) && ints_len(f.programs) > 0 }

// Why it did not; "" where it did.
pub fn fx_why(f: Facts) -> Str { strs_get(f.why, 0) }

// Whether the compilation fails: an error reported, or the reference's refusal without one.
pub fn fx_failed(f: Facts) -> Bool {
    if ints_get(f.refused, 0) == 1 { return true; }
    let mut i = 0;
    while i < dg_len(f.d) {
        if dg_severity(f.d, i) == "error" { return true; }
        i = i + 1;
    }
    false
}

pub fn fx_diags(f: Facts) -> Diags { f.d }

// Why the reference refuses the compilation without a diagnostic of a module, as `nazm check`
// says it after `nazm: `; "" where it does not.
pub fn fx_refusal(f: Facts) -> Str { strs_get(f.refusal, 0) }

// Every diagnostic as `nazm check` writes them to standard error, in order — without the summary
// line the command adds.
pub fn fx_render(f: Facts) -> Str {
    let out = strs_new();
    let mut i = 0;
    while i < dg_len(f.d) {
        strs_push(out, dg_render(f.d, i, f.names, f.texts, f.bases));
        i = i + 1;
    }
    str_join(out, "")
}

pub fn fx_checker(f: Facts) -> Ck { f.c }
// The comparisons of what a tool reads of a compilation with errors (R8 slice 11): `facts-dump.nz` writes its dumps for such a compilation when asked to.
pub fn fx_dump_errors(f: Facts, on: Bool) -> Int {
    ints_set(f.dump_errors, 0, if on { 1 } else { 0 });
    0
}
pub fn fx_dumps_errors(f: Facts) -> Bool { ints_get(f.dump_errors, 0) == 1 }
pub fn fx_tree(f: Facts) -> Tree { f.t }

pub fn fx_modules(f: Facts) -> Int { strs_len(f.names) }
// The name it is loaded under: the root's path as given, an import's joined to its importer's
// directory, `@std/NAME.nz`, `@core/prelude.nz`.
pub fn fx_module_name(f: Facts, m: Int) -> Str { strs_get(f.names, m) }
pub fn fx_module_text(f: Facts, m: Int) -> Str { strs_get(f.texts, m) }
pub fn fx_module_program(f: Facts, m: Int) -> Int { ints_get(f.programs, m) }
// Where its text begins among the compilation's: an absolute span minus this is local to it.
pub fn fx_module_base(f: Facts, m: Int) -> Int { ints_get(f.bases, m) }
// Its durable key (`ModuleKey`), or "" where it has none (outside the source root).
pub fn fx_module_key(f: Facts, m: Int) -> Str { strs_get(f.keys, m) }
// Whether it is the program's own rather than compiled into the toolchain (a name without `@`).
pub fn fx_module_own(f: Facts, m: Int) -> Bool { str_len(strs_get(f.names, m)) == 0 || str_byte(strs_get(f.names, m), 0) != 64 }

// The module as Core IR names it (`Names::module`): its key, or `#` and its place in load order.
pub fn fx_module_identity(f: Facts, m: Int) -> Str {
    if strs_get(f.keys, m) == "" { return str_concat("#", int_to_str(m)); }
    strs_get(f.keys, m)
}

// A source's path as `nazm doc` shows it: relative to the root file's directory where it is in
// it, else its name.
pub fn fx_module_path(f: Facts, m: Int) -> Str {
    let name = pk_normalise(strs_get(f.names, m));
    let dir = strs_get(f.dir, 0);
    if dir != "" && pk_under(name, dir) && name != dir {
        if dir == "/" { return str_slice(name, 1, str_len(name)); }
        return str_slice(name, str_len(dir) + 1, str_len(name));
    }
    strs_get(f.names, m)
}

// A definition's durable identity (`DefKey`), `MODULE::KIND NAME` — the module by
// `fx_module_identity`.
fn definition(f: Facts, m: Int, kind: Str, name: Str) -> Str {
    str_concat(str_concat(str_concat(fx_module_identity(f, m), "::"), str_concat(kind, " ")), name)
}

pub fn fx_fn_identity(f: Facts, i: Int) -> Str { definition(f, ck_fn_module(f.c, i), "fn", ck_fn_name(f.c, i)) }
pub fn fx_record_identity(f: Facts, r: Int) -> Str { definition(f, ck_record_module(f.c, r), "record", ck_record_name(f.c, r)) }
pub fn fx_record_identity_in(f: Facts, m: Int, r: Int) -> Str { definition(f, m, "record", ck_record_name(f.c, r)) }
pub fn fx_enum_identity(f: Facts, e: Int) -> Str { definition(f, ck_enum_module(f.c, e), "enum", ck_enum_name(f.c, e)) }
pub fn fx_trait_identity(f: Facts, t: Int) -> Str { definition(f, ck_trait_module(f.c, t), "trait", ck_trait_name(f.c, t)) }

// Any type as messages show it (`lsp` hover); the type of the binding the name written at
// `start..end` of module `m` (local offsets) is, or -1.
pub fn fx_show(f: Facts, t: Int) -> Str { ck_show(f.c, t) }
pub fn fx_binding_type_at(f: Facts, m: Int, start: Int, end: Int) -> Int {
    let base = fx_module_base(f, m);
    let b = ck_binding_at(f.c, start + base, end + base);
    if b < 0 { return 0 - 1; }
    ck_binding_ty(f.c, b)
}

// Where what the name written at `start..end` of module `m` (local offsets) refers to is declared
// (`lsp` definition), for a name that is no local: a function called or used as a value, a
// record built or an enum's variant named, a record's or an enum's name written as a type, by its
// declaration's name. Three `Ints`: the module,
// and the name's start and end, local to it; empty where the checker recorded nothing there.
pub fn fx_declaration_at(f: Facts, m: Int, start: Int, end: Int) -> Ints {
    let c = f.c;
    let base = fx_module_base(f, m);
    let s = start + base;
    let e = end + base;
    let out = ints_new();
    let mut g = 0 - 1;
    let site = ck_site_at(c, s, e);
    if site >= 0 { g = ck_site_fn(c, site); }
    if g < 0 {
        let v = ck_fn_value_at(c, s, e);
        if v >= 0 { g = ck_fn_value_fn(c, v); }
    }
    if g >= 0 { return declared_in(f, ck_fn_module(c, g), ck_fn_name_start(c, g), ck_fn_name_end(c, g)); }
    let mut rt = ck_construction_at(c, s, e);
    // A type's name written in a signature, an annotation or a construction's type.
    let tn = ck_type_name_at(c, s, e);
    if rt < 0 && tn >= 0 && ck_type_class(c, tn) == "record" { rt = tn; }
    if tn >= 0 && ck_type_class(c, tn) == "enum" {
        let te = ck_type_enum(c, tn);
        return declared_in(f, ck_enum_module(c, te), ck_enum_name_start(c, te), ck_enum_name_end(c, te));
    }
    let mut r = 0 - 1;
    if rt >= 0 { r = ck_type_record(c, rt); }
    if r >= 0 { return declared_in(f, ck_record_module(c, r), ck_record_name_start(c, r), ck_record_name_end(c, r)); }
    let et = ck_variant_at(c, s, e);
    let mut en = 0 - 1;
    if et >= 0 { en = ck_type_enum(c, et); }
    if en >= 0 { return declared_in(f, ck_enum_module(c, en), ck_enum_name_start(c, en), ck_enum_name_end(c, en)); }
    out
}

fn declared_in(f: Facts, m: Int, s: Int, e: Int) -> Ints {
    let out = ints_new();
    if m < 0 || s <= 0 && e <= 0 { return out; }
    ints_push(out, m);
    ints_push(out, s - fx_module_base(f, m));
    ints_push(out, e - fx_module_base(f, m));
    out
}

// A tree span's ends, local to its module's text.
pub fn fx_start(f: Facts, span: Int) -> Int { sx_s(f.t, span) }
pub fn fx_end(f: Facts, span: Int) -> Int { sx_e(f.t, span) }

// What `@deprecated` says of a declaration (`apidoc::deprecated`): its reason, "" when it gives
// none — and whether it says anything, `fx_is_deprecated`.
pub fn fx_is_deprecated(f: Facts, decl: Int) -> Bool { deprecation(f, decl) >= 0 }
pub fn fx_deprecated(f: Facts, decl: Int) -> Str {
    let a = deprecation(f, decl);
    if a < 0 { return ""; }
    let args = sx_field(f.t, a, "args");
    if sx_is_some(f.t, args) == false { return ""; }
    let list = sx_items(f.t, sx_unwrap(f.t, args));
    if ints_len(list) != 1 { return ""; }
    let only = ints_get(list, 0);
    if sx_text(f.t, only) != "Str" { return ""; }
    sx_name(f.t, only, "value")
}

fn deprecation(f: Facts, decl: Int) -> Int {
    let attrs = sx_items(f.t, sx_field(f.t, decl, "attrs"));
    let mut i = 0;
    while i < ints_len(attrs) {
        if sx_name(f.t, ints_get(attrs, i), "name") == "deprecated" { return ints_get(attrs, i); }
        i = i + 1;
    }
    0 - 1
}

// What the name a `pub use` of module `m` chooses at `start..end` (local) resolves to, as
// `nazm doc` names it: a function's or a type's identity, `MODULE::trait NAME` for a trait; ""
// where it resolves to nothing.
pub fn fx_reexport_of(f: Facts, m: Int, start: Int, end: Int) -> Str {
    let c = f.c;
    let s = start + ints_get(f.bases, m);
    let e = end + ints_get(f.bases, m);
    let mut out = "";
    let mut i = 0;
    while i < ck_reexport_count(c) {
        if ck_reexport_module(c, i) == m && ck_reexport_start(c, i) == s && ck_reexport_end(c, i) == e && out == "" {
            let k = ck_reexport_kind(c, i);
            let x = ck_reexport_target(c, i);
            if k == 1 { out = fx_fn_identity(f, x); }
            if k == 2 {
                if ck_type_record(c, x) >= 0 { out = fx_record_identity(f, ck_type_record(c, x)); }
                if ck_type_enum(c, x) >= 0 { out = fx_enum_identity(f, ck_type_enum(c, x)); }
            }
            if k == 3 { out = fx_trait_identity(f, x); }
        }
        i = i + 1;
    }
    out
}

// The durable key of loaded module `i` (`ModuleKey`, `load.rs`'s `module_key`): `@core/prelude`,
// `@std/NAME`, a dependency package's `NAME@VERSION/PATH`, or its path relative to the source
// root — none outside it, or where its first component holds an `@`.
fn module_key(loaded: Loaded, i: Int, source_root: Str, packages: Packages) -> Str {
    let id = ld_identity(loaded, i);
    if id == "@core/prelude.nz" { return "@core/prelude"; }
    if str_len(id) > 5 && str_slice(id, 0, 5) == "@std/" { return str_slice(id, 0, str_len(id) - 3); }
    if pk_packages_state(packages) == 1 {
        let p = pk_package_of(packages, id);
        if p >= 0 && p != pk_root_package(packages) {
            let rel = below(pk_normalise(id), pk_normalise(pk_source_root(packages, p)));
            if rel == "" { return ""; }
            return str_concat(str_concat(str_concat(pk_name(packages, p), "@"), str_concat(pk_package_version(packages, p), "/")), rel);
        }
    }
    let rel = below(pk_normalise(id), pk_normalise(source_root));
    if rel == "" { return ""; }
    let mut first = 0;
    while first < str_len(rel) && str_byte(rel, first) != 47 {
        if str_byte(rel, first) == 64 { return ""; }
        first = first + 1;
    }
    rel
}

// `path` relative to `root`, both normalised; "" where it is not below it.
fn below(path: Str, root: Str) -> Str {
    if path == root || pk_under(path, root) == false { return ""; }
    if root == "/" { return str_slice(path, 1, str_len(path)); }
    str_slice(path, str_len(root) + 1, str_len(path))
}

// The module of this name in load order, or -1.
fn module_named(loaded: Loaded, name: Str) -> Int {
    let mut i = 0;
    while i < ld_count(loaded) {
        if ld_name(loaded, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn split_commas(s: Str) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i <= str_len(s) {
        let end = i == str_len(s);
        let mut cut = end;
        if end == false { cut = str_byte(s, i) == 44; }
        if cut {
            strs_push(out, str_slice(s, from, i));
            from = i + 1;
        }
        i = i + 1;
    }
    out
}

// --- the cache's keys (`nazm-cache`; R2, design D28) ------------------------------------------------

// `fields` framed as `Framed` frames them (`digest.rs`): each `len:value`, the domain first; its
// BLAKE3, in hexadecimal.
pub fn fx_framed(domain: Str, fields: Strs) -> Str {
    let out = strs_new();
    strs_push(out, int_to_str(str_len(domain)));
    strs_push(out, ":");
    strs_push(out, domain);
    let mut i = 0;
    while i < strs_len(fields) {
        let v = strs_get(fields, i);
        strs_push(out, int_to_str(str_len(v)));
        strs_push(out, ":");
        strs_push(out, v);
        i = i + 1;
    }
    blake3_hex(bytes_from_str(str_join(out, "")))
}

// The checker's identity (`CheckerIdentity::current`), from its fields as the reference generates
// them into `builtins.nz`.
pub fn fx_checker_identity() -> Str { fx_framed("nazm.checker/1", bi_identity()) }

// The host's configuration line (`BuildConfig::host().describe()`).
fn host_describe(os: Str, arch: Str) -> Str {
    let mut target = str_concat(str_concat(arch, "-unknown-"), os);
    if os == "macos" { target = str_concat(arch, "-apple-darwin"); }
    if os == "linux" { target = str_concat(arch, "-unknown-linux-gnu"); }
    if os == "windows" && arch == "x86_64" { target = "x86_64-pc-windows-gnu"; }
    str_concat(str_concat(str_concat(str_concat("os=", os), str_concat(";arch=", arch)), str_concat(";target=", target)), ";features=;packages=;profiles=")
}

fn has_text(s: Str, part: Str) -> Bool {
    let n = str_len(part);
    let mut i = 0;
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == part { return true; }
        i = i + 1;
    }
    false
}

// Module `m`'s source fingerprint (`SourceFingerprint`): its text as the compilation holds it,
// with the configuration where it writes `@cfg`.
pub fn fx_source_fingerprint(f: Facts, m: Int, os: Str, arch: Str) -> Str {
    let mut text = fx_module_text(f, m);
    if has_text(text, "@cfg") { text = str_concat(str_concat(text, str_concat(str_from_byte(0), "@cfg ")), host_describe(os, arch)); }
    let fields = strs_new();
    strs_push(fields, text);
    fx_framed("nazm.source/1", fields)
}

// Each module's check key (`CheckKey`), or "-" where it has none: what a Core IR unit is filed
// under (design D28).
pub fn fx_check_keys(f: Facts, os: Str, arch: Str) -> Strs {
    let c = f.c;
    let checker = fx_checker_identity();
    let keys = strs_new();
    let sources = strs_new();
    let hashes = strs_new();
    let mut m = 0;
    while m < fx_modules(f) {
        strs_push(keys, fx_module_key(f, m));
        m = m + 1;
    }
    m = 0;
    while m < fx_modules(f) {
        strs_push(sources, fx_source_fingerprint(f, m, os, arch));
        let json = ck_interface_json(c, m, keys);
        if json == "" { strs_push(hashes, ""); } else { strs_push(hashes, blake3_hex(bytes_from_str(json))); }
        m = m + 1;
    }
    let out = strs_new();
    m = 0;
    while m < fx_modules(f) {
        strs_push(out, fx_check_key(f, m, checker, keys, sources, hashes));
        m = m + 1;
    }
    out
}

// Each module's key, source fingerprint, published interface, its hash and its check key, as
// the reference's cache computes them (`checking.rs`'s `plan`), one line each — what `run.sh
// keys` compares.
pub fn fx_keys(f: Facts, os: Str, arch: Str) -> Str {
    let c = f.c;
    let checker = fx_checker_identity();
    let out = strs_new();
    strs_push(out, str_concat(str_concat("checker ", checker), nl()));
    let keys = strs_new();
    let hashes = strs_new();
    let sources = strs_new();
    let jsons = strs_new();
    let mut m = 0;
    while m < fx_modules(f) {
        strs_push(keys, fx_module_key(f, m));
        m = m + 1;
    }
    m = 0;
    while m < fx_modules(f) {
        strs_push(sources, fx_source_fingerprint(f, m, os, arch));
        let json = ck_interface_json(c, m, keys);
        strs_push(jsons, json);
        if json == "" { strs_push(hashes, ""); } else { strs_push(hashes, blake3_hex(bytes_from_str(json))); }
        m = m + 1;
    }
    m = 0;
    while m < fx_modules(f) {
        let key = strs_get(keys, m);
        let mut shown = key;
        if shown == "" { shown = "-"; }
        strs_push(out, str_concat(str_concat("module ", shown), nl()));
        strs_push(out, str_concat(str_concat("source ", strs_get(sources, m)), nl()));
        let mut json = strs_get(jsons, m);
        if json == "" { json = "-"; }
        strs_push(out, str_concat(str_concat("interface ", json), nl()));
        let mut hash = strs_get(hashes, m);
        if hash == "" { hash = "-"; }
        strs_push(out, str_concat(str_concat("hash ", hash), nl()));
        strs_push(out, str_concat(str_concat("key ", fx_check_key(f, m, checker, keys, sources, hashes)), nl()));
        m = m + 1;
    }
    str_join(out, "")
}

// Module `m`'s check key (`CheckKey::of`): the checker, its key, its source, and each direct
// import's key and interface hash, sorted and once each; "-" where any is missing.
fn fx_check_key(f: Facts, m: Int, checker: Str, keys: Strs, sources: Strs, hashes: Strs) -> Str {
    let key = strs_get(keys, m);
    if key == "" { return "-"; }
    let pairs = strs_new();
    let mut k = 0;
    while k < ck_module_deps(f.c, m) {
        let d = ck_module_dep(f.c, m, k);
        if strs_get(keys, d) == "" || strs_get(hashes, d) == "" { return "-"; }
        strs_push(pairs, str_concat(str_concat(strs_get(keys, d), str_from_byte(1)), strs_get(hashes, d)));
        k = k + 1;
    }
    // Sorted and deduplicated, by module key then interface (`Dependency`'s order).
    let sorted = strs_new();
    k = 0;
    while k < strs_len(pairs) {
        let p = strs_get(pairs, k);
        let mut at = strs_len(sorted);
        while at > 0 && str_less(p, strs_get(sorted, at - 1)) { at = at - 1; }
        let dup = at > 0 && strs_get(sorted, at - 1) == p;
        if dup == false {
            strs_push(sorted, "");
            let mut j = strs_len(sorted) - 1;
            while j > at {
                strs_set(sorted, j, strs_get(sorted, j - 1));
                j = j - 1;
            }
            strs_set(sorted, at, p);
        }
        k = k + 1;
    }
    let fields = strs_new();
    strs_push(fields, checker);
    strs_push(fields, key);
    strs_push(fields, strs_get(sources, m));
    strs_push(fields, int_to_str(strs_len(sorted)));
    k = 0;
    while k < strs_len(sorted) {
        let p = strs_get(sorted, k);
        let cut = index_of_byte(p, 1);
        strs_push(fields, str_slice(p, 0, cut));
        strs_push(fields, str_slice(p, cut + 1, str_len(p)));
        k = k + 1;
    }
    fx_framed("nazm.check-key/1", fields)
}

fn index_of_byte(s: Str, b: Int) -> Int {
    let mut i = 0;
    while i < str_len(s) && str_byte(s, i) != b { i = i + 1; }
    i
}

// Whether `a` sorts before `b`, byte by byte.
fn str_less(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i); }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

// --- the reference index (R5 hand-back; `ReferenceIndex`, N17) -------------------------------
//
// Every entity the program declares — function, local, record, enum, variant, field, payload
// field, trait, trait method — with where it is declared and every occurrence the checker
// resolved to it, as the reference's `references`, `rename` and `symbols` read them. An entity is
// `0 <= i < fx_ref_count(f)`, in order of its declaration (then of its first use, for one declared
// nowhere); spans are over the whole compilation's text (`fx_module_at` says whose, `fx_module_base`
// makes one local); a use is never the declaration. Meaningful where the checker carried the
// compilation and it did not fail (`fx_carried`, `fx_failed`).
pub fn fx_ref_count(f: Facts) -> Int { ck_ref_count(f.c) }
// `function`, `local`, `record`, `enum`, `variant`, `field`, `payload field`, `trait`, `trait method`
// or `constant`.
pub fn fx_ref_kind(f: Facts, i: Int) -> Str { ck_ref_kind_name(f.c, i) }
// Where it is declared, or -1 for an entity declared nowhere the index holds.
pub fn fx_ref_record(f: Facts, i: Int) -> Int { ck_ref_record(f.c, i) }
pub fn fx_ref_enum(f: Facts, i: Int) -> Int { ck_ref_enum(f.c, i) }
pub fn fx_ref_member(f: Facts, i: Int) -> Str { ck_ref_member(f.c, i) }
pub fn fx_ref_decl_start(f: Facts, i: Int) -> Int { ck_ref_decl_start(f.c, i) }
pub fn fx_ref_decl_end(f: Facts, i: Int) -> Int { ck_ref_decl_end(f.c, i) }
pub fn fx_ref_use_count(f: Facts, i: Int) -> Int { ck_ref_use_count(f.c, i) }
pub fn fx_ref_use_start(f: Facts, i: Int, k: Int) -> Int { ck_ref_use_start(f.c, i, k) }
pub fn fx_ref_use_end(f: Facts, i: Int, k: Int) -> Int { ck_ref_use_end(f.c, i, k) }

// The module whose text holds the offset (absolute), or -1.
pub fn fx_module_at(f: Facts, at: Int) -> Int {
    let mut m = 0;
    while m < strs_len(f.texts) {
        if at >= ints_get(f.bases, m) && at < ints_get(f.bases, m) + str_len(strs_get(f.texts, m)) { return m; }
        m = m + 1;
    }
    0 - 1
}

// --- the call graph (R5 hand-back; `FnDef::call_sites`, N25) ----------------------------------
//
// What the body of function `i` (`ck_fn_*`'s numbering) calls: `fx_call_count(f, i)` calls, `k` in
// the order the checker recorded them, each with where its callee is written (over the whole
// compilation's text) and what it reached (`fx_call_kind`): `function` (`fx_call_function`, a
// function's number), `builtin` (`fx_call_builtin`, its name), `indirect` (a value of function
// type) or `trait method` (a method through a bound on a type parameter: `fx_call_trait`, the
// trait's number, and `fx_call_method`, the method's place in it). A `spawn` is a call
// (`fx_call_spawned`). A generic callee's type arguments are shown as `Types::show` writes them.
pub fn fx_call_count(f: Facts, i: Int) -> Int { ck_call_count(f.c, i) }
pub fn fx_call_start(f: Facts, i: Int, k: Int) -> Int { ck_site_start(f.c, ck_call_site(f.c, i, k)) }
pub fn fx_call_end(f: Facts, i: Int, k: Int) -> Int { ck_site_end(f.c, ck_call_site(f.c, i, k)) }
pub fn fx_call_kind(f: Facts, i: Int, k: Int) -> Str {
    let site = ck_call_site(f.c, i, k);
    if ck_site_trait_method(f.c, site) >= 0 { return "trait method"; }
    if ck_site_fn(f.c, site) >= 0 { return "function"; }
    if ck_site_builtin(f.c, site) >= 0 { return "builtin"; }
    "indirect"
}
pub fn fx_call_function(f: Facts, i: Int, k: Int) -> Int { ck_site_fn(f.c, ck_call_site(f.c, i, k)) }
pub fn fx_call_builtin(f: Facts, i: Int, k: Int) -> Str {
    let b = ck_site_builtin(f.c, ck_call_site(f.c, i, k));
    if b < 0 { return ""; }
    ck_builtin_name(f.c, b)
}
pub fn fx_call_trait(f: Facts, i: Int, k: Int) -> Int {
    let tm = ck_site_trait_method(f.c, ck_call_site(f.c, i, k));
    if tm < 0 { return 0 - 1; }
    ck_method_trait(f.c, tm)
}
pub fn fx_call_method(f: Facts, i: Int, k: Int) -> Int {
    let tm = ck_site_trait_method(f.c, ck_call_site(f.c, i, k));
    if tm < 0 { return 0 - 1; }
    tm - ck_trait_method_first(f.c, ck_method_trait(f.c, tm))
}
pub fn fx_call_spawned(f: Facts, i: Int, k: Int) -> Bool { ck_site_spawned(f.c, ck_call_site(f.c, i, k)) }
pub fn fx_call_type_args(f: Facts, i: Int, k: Int) -> Strs {
    let site = ck_call_site(f.c, i, k);
    let out = strs_new();
    let mut a = 0;
    while a < ck_site_type_arg_count(f.c, site) {
        strs_push(out, ck_show(f.c, ck_site_type_arg(f.c, site, a)));
        a = a + 1;
    }
    out
}

// --- provenance summaries (R5 hand-back; `FnDef::provenance`, N38) ----------------------------
//
// Function `i`'s (`ck_fn_*`'s numbering) provenance, solved for the whole compilation: whether it has
// one (`fx_prov_has`: a checked body does), the origins its result carries whatever it is given
// (`argument`, `file`, `authority`, `unknown`), the positions of the parameters — and, after them,
// the captures — whose provenance its result carries, the positions of the parameters whose value
// may reach the path `write_file` writes to, and the origins the program's calls hand parameter `k`.
// Solved when first asked for, so a tool that does not ask pays nothing.
pub fn fx_prov_has(f: Facts, i: Int) -> Bool { ck_prov_has(f.c, i) }
pub fn fx_prov_origins(f: Facts, i: Int) -> Strs { ck_prov_origins(f.c, i) }
pub fn fx_prov_passes_on(f: Facts, i: Int) -> Ints { ck_prov_passes_on(f.c, i) }
pub fn fx_prov_reaches(f: Facts, i: Int) -> Ints { ck_prov_reaches(f.c, i) }
pub fn fx_prov_receives(f: Facts, i: Int, k: Int) -> Strs { ck_prov_receives(f.c, i, k) }

// --- the sinks, solved (R8 slice 11, task 11.1; `SinkReport`, N52, N80) ---------------------------------------------------------------
//
// Every sink of every checked body — a path written to (`path`), what `print` and `eprint` write (`output`), what is written (`file-data`)
// and where `str_vouch` clears origins (`vouch`) — in function order, with the function it is in, where it is (absolute, the built-in's
// name), the origins that reach it by name in id order, and for each of those one chain from where it entered to the sink: steps, each a place
// and what happened there, nearest the origin first. Solved when first asked for (the program once more; nothing else pays).
pub fn fx_sink_count(f: Facts) -> Int { ck_sink_count(f.c) }
pub fn fx_sink_declined(f: Facts) -> Bool { ck_sink_declined(f.c) }
pub fn fx_sink_function(f: Facts, i: Int) -> Str { ck_sink_function(f.c, i) }
pub fn fx_sink_class(f: Facts, i: Int) -> Str { ck_sink_class(f.c, i) }
pub fn fx_sink_start(f: Facts, i: Int) -> Int { ck_sink_start(f.c, i) }
pub fn fx_sink_end(f: Facts, i: Int) -> Int { ck_sink_end(f.c, i) }
pub fn fx_sink_origins(f: Facts, i: Int) -> Strs { ck_sink_origins(f.c, i) }
pub fn fx_sink_traces(f: Facts, i: Int) -> Int { ck_sink_traces(f.c, i) }
pub fn fx_sink_trace_origin(f: Facts, i: Int, t: Int) -> Str { ck_sink_trace_origin(f.c, i, t) }
pub fn fx_sink_steps(f: Facts, i: Int, t: Int) -> Int { ck_sink_steps(f.c, i, t) }
pub fn fx_sink_step_start(f: Facts, i: Int, t: Int, s: Int) -> Int { ck_sink_step_start(f.c, i, t, s) }
pub fn fx_sink_step_end(f: Facts, i: Int, t: Int, s: Int) -> Int { ck_sink_step_end(f.c, i, t, s) }
pub fn fx_sink_step_note(f: Facts, i: Int, t: Int, s: Int) -> Str { ck_sink_step_note(f.c, i, t, s) }

// --- the calls whose preconditions were proved (R8 slice 11, task 11.1; `Resolution::proved_call`, N87) ----------------------------------
//
// A call whose arguments are all literals, of a function of its module that states a precondition, every clause true for them: where the
// callee is written (absolute) and the witness, each clause as evaluated and the parameters' values (`x > 0 holds, y != 0 holds with x = 3, y = 2`).
pub fn fx_proved_calls(f: Facts) -> Int { ck_proved_call_count(f.c) }
pub fn fx_proved_call_start(f: Facts, i: Int) -> Int { ck_proved_call_start(f.c, i) }
pub fn fx_proved_call_end(f: Facts, i: Int) -> Int { ck_proved_call_end(f.c, i) }
pub fn fx_proved_call_witness(f: Facts, i: Int) -> Str { ck_proved_call_witness(f.c, i) }

// --- a function's effects (R8 slice 9, task 9.1; `FnDef::{declared_effects, inferred_effects, effect_reasons}`, N36) ---
//
// What function `i` (`ck_fn_*`'s numbering) may do, as masks (`io` 1, `spawn` 2, `foreign` 4, the effect parameter 8:
// `fx_effects_names` writes one by name, in effect-id order): its declared set (-1 where it declares none), what its
// body requires (-1 where none was checked: `fx_fn_required`), and what a caller in another module must assume of it
// (`fx_fn_published`: the declared set, or every effect the compatibility bridge covers, `foreign` too where a
// parameter can carry a `ForeignCap`). And why it requires each effect: `fx_reason_count(f, i)` reasons, `k` in
// effect order, the first thing in its body that requires the effect. A reason has the
// effect's id (`fx_reason_effect`), where it is (`fx_reason_start`, `fx_reason_end`, over the whole compilation's
// text), what it is (`fx_reason_source`: `builtin`, `spawn`, `inferred`, `declared`, `undeclared` or `indirect`) and,
// for a `builtin`, its name (`fx_reason_builtin`; "" otherwise) and, for an `inferred`, `declared` or `undeclared`
// one, the callee's function number (`fx_reason_callee`; -1 otherwise).
pub fn fx_fn_declared(f: Facts, i: Int) -> Int { ck_fn_declared(f.c, i) }
pub fn fx_fn_required(f: Facts, i: Int) -> Int { ck_fn_required(f.c, i) }
pub fn fx_fn_published(f: Facts, i: Int) -> Int { ck_fn_published(f.c, i) }
pub fn fx_effects_names(mask: Int) -> Strs { ck_effect_names(mask) }
pub fn fx_reason_count(f: Facts, i: Int) -> Int { ints_len(ck_reasons(f.c, i)) }
fn reason_at(f: Facts, i: Int, k: Int) -> Int { ints_get(ck_reasons(f.c, i), k) }
pub fn fx_reason_effect(f: Facts, i: Int, k: Int) -> Int { ck_reason_effect(f.c, reason_at(f, i, k)) }
pub fn fx_reason_start(f: Facts, i: Int, k: Int) -> Int { ck_reason_start(f.c, reason_at(f, i, k)) }
pub fn fx_reason_end(f: Facts, i: Int, k: Int) -> Int { ck_reason_end(f.c, reason_at(f, i, k)) }
pub fn fx_reason_source(f: Facts, i: Int, k: Int) -> Str { ck_reason_source(f.c, reason_at(f, i, k)) }
pub fn fx_reason_builtin(f: Facts, i: Int, k: Int) -> Str { ck_reason_builtin(f.c, reason_at(f, i, k)) }
pub fn fx_reason_callee(f: Facts, i: Int, k: Int) -> Int { ck_reason_callee(f.c, reason_at(f, i, k)) }
pub fn fx_reason_type(f: Facts, i: Int, k: Int) -> Str { ck_reason_type(f.c, reason_at(f, i, k)) }

fn cat3(a: Str, b: Str, c: Str) -> Str { str_concat(str_concat(a, b), c) }

// --- the diagnostics' identities (R5 hand-back; N30, `nazm.diagnostic-index/1`) ---------------
//
// What the language service says of the compilation's diagnostics, and what `check --summary-json`
// links a command's diagnostics to: the state the identities are of (`fx_state_source`) and each
// diagnostic's id (`fx_diag_ids`, by its place in `fx_diags`) in the canonical order
// (`fx_diag_order`). Of a compilation checked as a module (`fx_check_module*`), as the service
// analyses one: a program's missing `main` is no part of it. Available (`fx_diag_available`) where
// the front end carried the compilation, every module loaded, and the root has a durable key.

// Whether module `m` has a place in the service's identities (every file but the core prelude's),
// and its path there: its durable key, else its path relative to the source root, `..` where it is
// not under it (`Paths::of`).
pub fn fx_file_known(f: Facts, m: Int) -> Bool { strs_get(f.names, m) != "@core/prelude.nz" }
pub fn fx_file_path(f: Facts, m: Int) -> Str {
    if strs_get(f.keys, m) != "" { return strs_get(f.keys, m); }
    relative_to(strs_get(f.sroot, 0), pk_normalise(strs_get(f.names, m)))
}

// `path` relative to `base`, both normalised and absolute; `/`-separated, `..` for each of the
// base's directories it leaves.
fn relative_to(base: Str, path: Str) -> Str {
    let b = path_parts(base);
    let p = path_parts(path);
    let mut common = 0;
    while common < strs_len(b) && common < strs_len(p) && strs_get(b, common) == strs_get(p, common) { common = common + 1; }
    let out = strs_new();
    let mut i = common;
    while i < strs_len(b) {
        strs_push(out, "..");
        i = i + 1;
    }
    i = common;
    while i < strs_len(p) {
        strs_push(out, strs_get(p, i));
        i = i + 1;
    }
    str_join(out, "/")
}

fn path_parts(path: Str) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i <= str_len(path) {
        if i == str_len(path) || str_byte(path, i) == 47 {
            if i > from { strs_push(out, str_slice(path, from, i)); }
            from = i + 1;
        }
        i = i + 1;
    }
    out
}

pub fn fx_diag_available(f: Facts) -> Bool {
    fx_carried(f) && fx_refusal(f) == "" && fx_loaded(f) && fx_module_key(f, 0) != ""
}

// `nazm.diagnostic-index/1`'s `state.source`: BLAKE3 over the root's identity and every loaded
// file's path and exact bytes, in load order.
pub fn fx_state_source(f: Facts) -> Str {
    let fields = strs_new();
    strs_push(fields, "source");
    strs_push(fields, fx_module_key(f, 0));
    strs_push(fields, str_concat("nazm ", strs_get(bi_identity(), 1)));
    let mut m = 0;
    while m < strs_len(f.names) {
        if fx_file_known(f, m) {
            strs_push(fields, fx_file_path(f, m));
            strs_push(fields, strs_get(f.texts, m));
        }
        m = m + 1;
    }
    fx_framed("nazm.diagnostic-index/1", fields)
}

// The file an offset of the compilation is in: the one a stage said, else the last beginning at or
// before it.
fn file_at(f: Facts, known: Int, at: Int) -> Int {
    if known >= 0 { return known; }
    let mut m = 0;
    let mut found = 0;
    while m < ints_len(f.bases) {
        if ints_get(f.bases, m) <= at { found = m; }
        m = m + 1;
    }
    found
}

// A place as the identities write it, `FILE:START-END` (offsets local to the file), "" where there
// is none: the synthetic span, or a file outside the service's identities.
fn place_of(f: Facts, known: Int, s: Int, e: Int) -> Str {
    let m = file_at(f, known, s);
    if s == 0 && e == 0 && m == 0 { return ""; }
    if fx_file_known(f, m) == false { return ""; }
    let base = ints_get(f.bases, m);
    str_concat(str_concat(str_concat(fx_file_path(f, m), ":"), str_concat(int_to_str(s - base), "-")), int_to_str(e - base))
}

// Whether the place `a` sorts before `b` as `Option<SourceSpan>` does: none first, then by file,
// start and end — compared as `(file, start, end)`, the file bytewise. A place is written
// `FILE<TAB>START<TAB>END` here so that none is "".
fn place_less(a: Str, b: Str) -> Bool { place_key_less(place_parts(a), place_parts(b)) }

fn place_parts(p: Str) -> Strs {
    // `FILE:START-END`: the file runs to the last `:`.
    let out = strs_new();
    if p == "" { return out; }
    let mut colon = str_len(p) - 1;
    while colon > 0 && str_byte(p, colon) != 58 { colon = colon - 1; }
    let mut dash = colon;
    while dash < str_len(p) && str_byte(p, dash) != 45 { dash = dash + 1; }
    strs_push(out, str_slice(p, 0, colon));
    strs_push(out, str_slice(p, colon + 1, dash));
    strs_push(out, str_slice(p, dash + 1, str_len(p)));
    out
}

// A run of decimal digits as a number.
fn digits_int(s: Str) -> Int {
    let mut n = 0;
    let mut i = 0;
    while i < str_len(s) {
        n = n * 10 + str_byte(s, i) - 48;
        i = i + 1;
    }
    n
}

fn place_key_less(a: Strs, b: Strs) -> Bool {
    if strs_len(a) == 0 { return strs_len(b) > 0; }
    if strs_len(b) == 0 { return false; }
    if strs_get(a, 0) != strs_get(b, 0) { return str_less(strs_get(a, 0), strs_get(b, 0)); }
    if digits_int(strs_get(a, 1)) != digits_int(strs_get(b, 1)) { return digits_int(strs_get(a, 1)) < digits_int(strs_get(b, 1)); }
    digits_int(strs_get(a, 2)) < digits_int(strs_get(b, 2))
}

// Lists of places, compared as `Vec<Option<SourceSpan>>`: element by element, a prefix first. Each
// list is its places joined by a byte below every other, so that is a comparison of strings
// by their elements: here made by hand.
fn places_less(a: Strs, b: Strs) -> Bool {
    let mut i = 0;
    while i < strs_len(a) && i < strs_len(b) {
        if strs_get(a, i) != strs_get(b, i) { return place_less(strs_get(a, i), strs_get(b, i)); }
        i = i + 1;
    }
    strs_len(a) < strs_len(b)
}

fn diag_secondary(f: Facts, k: Int) -> Strs {
    let out = strs_new();
    let d = fx_diags(f);
    let mut i = 0;
    while i < dg_secondary_count(d, k) {
        strs_push(out, place_of(f, 0 - 1, dg_secondary_start(d, k, i), dg_secondary_end(d, k, i)));
        i = i + 1;
    }
    out
}

fn diag_fixes(f: Facts, k: Int) -> Strs {
    let out = strs_new();
    let d = fx_diags(f);
    let mut i = 0;
    while i < dg_fix_total(d, k) {
        strs_push(out, place_of(f, 0 - 1, dg_fix_span_start(d, k, i), dg_fix_span_end(d, k, i)));
        i = i + 1;
    }
    out
}

fn diag_primary(f: Facts, k: Int) -> Str {
    let d = fx_diags(f);
    place_of(f, dg_file(d, k), dg_start(d, k), dg_end(d, k))
}

// Whether diagnostic `a` goes before `b` in the canonical order: primary place, code, secondary
// places, fix places, then the order the compiler gave them in.
fn diag_less(f: Facts, a: Int, b: Int) -> Bool {
    let d = fx_diags(f);
    let pa = diag_primary(f, a);
    let pb = diag_primary(f, b);
    if pa != pb { return place_less(pa, pb); }
    if dg_code(d, a) != dg_code(d, b) { return str_less(dg_code(d, a), dg_code(d, b)); }
    let sa = diag_secondary(f, a);
    let sb = diag_secondary(f, b);
    if strs_len(sa) != strs_len(sb) || str_join(sa, "|") != str_join(sb, "|") { if places_less(sa, sb) { return true; } if places_less(sb, sa) { return false; } }
    let fa = diag_fixes(f, a);
    let fb = diag_fixes(f, b);
    if strs_len(fa) != strs_len(fb) || str_join(fa, "|") != str_join(fb, "|") { if places_less(fa, fb) { return true; } if places_less(fb, fa) { return false; } }
    a < b
}

// The errors among the diagnostics of `fx_diags` in the canonical order: for each position, which
// one.
pub fn fx_diag_order(f: Facts) -> Ints {
    let order = ints_new();
    let n = dg_len(fx_diags(f));
    let mut i = 0;
    while i < n {
        // The service's list holds the analysis's errors; the checker's warnings are published
        // beside them, with no id.
        if dg_severity(fx_diags(f), i) != "error" {
            i = i + 1;
            continue;
        }
        let mut at = 0;
        while at < ints_len(order) && diag_less(f, ints_get(order, at), i) { at = at + 1; }
        ints_push(order, 0);
        let mut j = ints_len(order) - 1;
        while j > at {
            ints_set(order, j, ints_get(order, j - 1));
            j = j - 1;
        }
        ints_set(order, at, i);
        i = i + 1;
    }
    order
}

// Each diagnostic's id, `CODE@FILE:START-END#N` (`-` for a place it has none), by its place in
// `fx_diags`: N counts the earlier ones in the canonical order with the same code and place.
pub fn fx_diag_ids(f: Facts) -> Strs {
    let d = fx_diags(f);
    let order = fx_diag_order(f);
    let out = strs_new();
    let stems = strs_new();
    let mut i = 0;
    while i < dg_len(d) {
        strs_push(out, "");
        i = i + 1;
    }
    i = 0;
    while i < ints_len(order) {
        let k = ints_get(order, i);
        let mut place = diag_primary(f, k);
        if place == "" { place = "-"; }
        let stem = cat3(dg_code(d, k), "@", place);
        let mut n = 0;
        let mut j = 0;
        while j < strs_len(stems) {
            if strs_get(stems, j) == stem { n = n + 1; }
            j = j + 1;
        }
        strs_push(stems, stem);
        strs_set(out, k, cat3(stem, "#", int_to_str(n)));
        i = i + 1;
    }
    out
}

// --- the types of records' fields (R5 hand-back) ----------------------------------------------
//
// Record `r`'s (`ck_record_*`'s numbering) type, and enum `e`'s — a type for `fx_show` and for the
// by-type readers: `fx_record_field_ty` of a record type's field `i`, `fx_payload_ty` of an enum
// type's variant `v`'s payload field `i` (a definition's as declared, naming its parameters) —
// or -1 where the checker made none.
pub fn fx_record_type(f: Facts, r: Int) -> Int { ck_record_type(f.c, r) }
pub fn fx_enum_type(f: Facts, e: Int) -> Int { ck_enum_type(f.c, e) }
pub fn fx_record_field_ty(f: Facts, t: Int, i: Int) -> Int { ck_record_field_ty(f.c, t, i) }
pub fn fx_payload_ty(f: Facts, t: Int, v: Int, i: Int) -> Int { ck_payload_ty(f.c, t, v, i) }
