// Following `use` from a root file to the whole compilation (R2, slice 3.1) — a port of
// `crates/nazm-service/src/load.rs`.
//
// The root first, then its imports depth-first in source order, each file read once; a standard
// module (`@std/name`) is the toolchain's copy, from the library directory; the core prelude is
// last. Every file is held with the trailing newline a compilation's source map gives it, and a
// diagnostic is published at its offset in the concatenation of them all, as the reference's
// `SourceMap::global` does.
//
// Where it differs from the reference, and why: a file's identity is its **textually normalised**
// path, not its canonical one — the runtime has no `realpath` — so one file reached through a
// symbolic link under two names is read twice (`docs/bootstrap.md` records the same of
// `module.nz`). A package's compilation (N46) is the reference's: `NAME:path` names a module of a
// dependency the importing package declares, a relative import stays inside its package's source
// root, and a dependency's modules are not the program's (`package.nz` resolves the packages).
// Derives (R1c, L2) are not carried yet: a file is read as written.

use "syntax.nz";
use "diag.nz";
use "lex.nz";
use "builtins.nz";
use "package.nz";

// A line break, written so that no string literal in this file holds one (`selfhost.rs` dumps a
// string's value on one line).
fn nl() -> Str { str_from_byte(10) }

pub struct Loaded {
    // Per file, in load order: the name it is published under and its text, newline included.
    names: Strs,
    texts: Strs,
    // Per file, whether it is a standard module, and whether it is a module of the program itself
    // (`ModuleKey::is_program`): under the source root, and no package's.
    standard: Ints,
    program: Ints,
    // Per file, its identity; and the identity each of its imports names, in source order (a
    // run of `targets`: "" where the import did not resolve).
    identities: Strs,
    tfirst: Ints,
    tcount: Ints,
    targets: Strs,
    // Per file, the prelude's standard modules it names (R1.5, D9: `prelude_named`), joined by
    // `,` — which the reference then imports into it, and this loader does not yet.
    implicit: Strs,
}

// The standard modules, by name (`nazm-sema/src/stdlib.rs`, `MODULES`, in its order).
fn std_names() -> Strs {
    let s = strs_new();
    strs_push(s, "args");
    strs_push(s, "audit");
    strs_push(s, "binary");
    strs_push(s, "bitset");
    strs_push(s, "blake3");
    strs_push(s, "bytebuf");
    strs_push(s, "chan");
    strs_push(s, "deque");
    strs_push(s, "dist");
    strs_push(s, "env");
    strs_push(s, "error");
    strs_push(s, "file");
    strs_push(s, "fmt");
    strs_push(s, "fs");
    strs_push(s, "hal");
    strs_push(s, "hash");
    strs_push(s, "hashmap");
    strs_push(s, "hashset");
    strs_push(s, "http");
    strs_push(s, "io");
    strs_push(s, "ioerror");
    strs_push(s, "json");
    strs_push(s, "linalg");
    strs_push(s, "log");
    strs_push(s, "map");
    strs_push(s, "net");
    strs_push(s, "num");
    strs_push(s, "option");
    strs_push(s, "ordmap");
    strs_push(s, "path");
    strs_push(s, "process");
    strs_push(s, "random");
    strs_push(s, "regex");
    strs_push(s, "result");
    strs_push(s, "seq");
    strs_push(s, "sha256");
    strs_push(s, "show");
    strs_push(s, "sort");
    strs_push(s, "test");
    strs_push(s, "text");
    strs_push(s, "time");
    strs_push(s, "tls");
    strs_push(s, "toml");
    s
}

fn starts_with(s: Str, prefix: Str) -> Bool {
    if str_len(prefix) > str_len(s) { return false; }
    str_slice(s, 0, str_len(prefix)) == prefix
}

fn contains(list: Strs, s: Str) -> Bool {
    let mut i = 0;
    while i < strs_len(list) {
        if strs_get(list, i) == s { return true; }
        i = i + 1;
    }
    false
}

fn index_of(list: Strs, s: Str) -> Int {
    let mut i = 0;
    while i < strs_len(list) {
        if strs_get(list, i) == s { return i; }
        i = i + 1;
    }
    0 - 1
}

// The text with the trailing newline a source map gives a file that lacks one.
pub fn ld_with_newline(text: Str) -> Str {
    if str_len(text) == 0 { return nl(); }
    if str_byte(text, str_len(text) - 1) != 10 { return str_concat(text, nl()); }
    text
}

// `path`'s directory as `Path::parent` gives it: "" when there is none.
fn parent(path: Str) -> Str {
    let mut i = str_len(path);
    while i > 0 {
        if str_byte(path, i - 1) == 47 {
            if i - 1 == 0 { return "/"; }
            return str_slice(path, 0, i - 1);
        }
        i = i - 1;
    }
    ""
}

// `Path::join`: an absolute `rel` replaces `dir`; otherwise one `/` between them.
fn join_path(dir: Str, rel: Str) -> Str {
    if starts_with(rel, "/") { return rel; }
    if dir == "" { return rel; }
    if str_byte(dir, str_len(dir) - 1) == 47 { return str_concat(dir, rel); }
    str_concat(str_concat(dir, "/"), rel)
}

// `.` and `..` folded away, so two spellings of one file are one identity. A leading `..` of a
// relative path is kept.
fn normalise(path: Str) -> Str {
    let parts = strs_new();
    let n = str_len(path);
    let absolute = starts_with(path, "/");
    let mut from = 0;
    let mut i = 0;
    while i <= n {
        if i == n || str_byte(path, i) == 47 {
            let seg = str_slice(path, from, i);
            if seg == ".." {
                let k = strs_len(parts);
                if k > 0 && strs_get(parts, k - 1) != ".." {
                    strs_pop(parts);
                } else {
                    if absolute == false { strs_push(parts, ".."); }
                }
            } else {
                if seg != "" && seg != "." { strs_push(parts, seg); }
            }
            from = i + 1;
        }
        i = i + 1;
    }
    let body = str_join(parts, "/");
    if absolute { return str_concat("/", body); }
    body
}

// A diagnostic raised while loading, kept against the file it is in until every file's offset is
// known.
struct Pending {
    file: Ints,
    start: Ints,
    end: Ints,
    message: Strs,
    help: Strs,
    code: Strs,
}

// Whether `s` is UTF-8 as Rust's `str::from_utf8` holds it: no overlong form, no surrogate,
// nothing above U+10FFFF.
fn valid_utf8(s: Str) -> Bool {
    let n = str_len(s);
    let mut i = 0;
    while i < n {
        let b = str_byte(s, i);
        let mut more = 0;
        let mut lo = 128;
        let mut hi = 191;
        if b < 128 {
            more = 0;
        } else {
            if b >= 194 && b <= 223 {
                more = 1;
            } else {
                if b >= 224 && b <= 239 {
                    more = 2;
                    if b == 224 { lo = 160; }
                    if b == 237 { hi = 159; }
                } else {
                    if b >= 240 && b <= 244 {
                        more = 3;
                        if b == 240 { lo = 144; }
                        if b == 244 { hi = 143; }
                    } else {
                        return false;
                    }
                }
            }
        }
        let mut k = 1;
        while k <= more {
            if i + k >= n { return false; }
            let x = str_byte(s, i + k);
            let mut low = 128;
            let mut high = 191;
            if k == 1 {
                low = lo;
                high = hi;
            }
            if x < low || x > high { return false; }
            k = k + 1;
        }
        i = i + 1 + more;
    }
    true
}

fn pend(p: Pending, code: Str, file: Int, start: Int, end: Int, message: Str, help: Str) -> Int {
    strs_push(p.code, code);
    ints_push(p.file, file);
    ints_push(p.start, start);
    ints_push(p.end, end);
    strs_push(p.message, message);
    strs_push(p.help, help);
    0
}

// Whether `path` is a directory, which `read_to_string` refuses to read (and `read_file` traps on).
pub fn ld_is_directory(path: Str, io: IoCap) -> Bool {
    let d = os_dir_open(path);
    let open = os_status(d) >= 0;
    if open { os_close(d); }
    open
}

// Read `root` and everything it imports, the standard modules from `library/std` and the core
// prelude from `library/core/prelude.nz`. Every loading error goes to `d`, published at its
// global offset; the compilation is loaded even then, as far as it could be.
pub fn ld_load(root: Str, library: Str, source_root: Str, packages: Packages, d: Diags, io: IoCap) -> Loaded {
    ld_load_over(root, library, source_root, packages, strs_new(), strs_new(), d, io)
}

// The text a file has: an overlay's where one is given for its path (an editor's unsaved
// buffer), else the file's own; and whether it exists, either way.
fn ov_index(paths: Strs, file: Str) -> Int {
    let want = normalise(file);
    let mut i = 0;
    while i < strs_len(paths) {
        if normalise(strs_get(paths, i)) == want { return i; }
        i = i + 1;
    }
    0 - 1
}
fn ov_exists(paths: Strs, file: Str, io: IoCap) -> Bool { ov_index(paths, file) >= 0 || file_exists(file) }
fn ov_read(paths: Strs, texts: Strs, file: Str, io: IoCap) -> Str {
    let k = ov_index(paths, file);
    if k >= 0 { return strs_get(texts, k); }
    read_file(file)
}

// `ld_load`, where the files at `paths` have the texts `texts` instead of what is on disk (the
// language server's documents not yet saved). A standard module is always the library's.
pub fn ld_load_over(root: Str, library: Str, source_root: Str, packages: Packages, paths: Strs, texts_over: Strs, d: Diags, io: IoCap) -> Loaded {
    let names = strs_new();
    let texts = strs_new();
    let standard = ints_new();
    let in_programs = ints_new();
    let identities = strs_new();
    let tfirst = ints_new();
    let tcount = ints_new();
    let targets = strs_new();
    let implicit = strs_new();
    let table = prelude_table(library, io);
    let pending = Pending(file: ints_new(), start: ints_new(), end: ints_new(), message: strs_new(), help: strs_new(), code: strs_new());
    let stds = std_names();
    // The stack: each entry a path, and whether it is a standard module (its name then).
    let stack = strs_new();
    let stack_std = ints_new();
    strs_push(stack, root);
    ints_push(stack_std, 0);
    while strs_len(stack) > 0 {
        let path = strs_pop(stack);
        let is_std = ints_pop(stack_std) == 1;
        let mut identity = normalise(path);
        let mut name = path;
        if is_std {
            identity = str_concat(str_concat("@std/", path), ".nz");
            name = identity;
        }
        if contains(identities, identity) { continue; }
        let id = strs_len(names);
        let mut file = path;
        if is_std { file = str_concat(str_concat(str_concat(library, "/std/"), path), ".nz"); }
        // A file that cannot be read as text is a module that cannot be read: `read_to_string`
        // fails on one that is not UTF-8, and the loader says why.
        let mut unreadable = "";
        let over = is_std == false && ov_index(paths, file) >= 0;
        if over == false {
            if file_exists(file) == false {
                unreadable = "No such file or directory (os error 2)";
            } else {
                if ld_is_directory(file, io) {
                    unreadable = "Is a directory (os error 21)";
                } else {
                    if valid_utf8(read_file(file)) == false { unreadable = "stream did not contain valid UTF-8"; }
                }
            }
        }
        if unreadable != "" {
            strs_push(identities, identity);
            strs_push(names, name);
            strs_push(texts, nl());
            ints_push(standard, 0);
            ints_push(in_programs, 0);
            ints_push(tfirst, strs_len(targets));
            ints_push(tcount, 0);
            strs_push(implicit, "");
            pend(pending, "N0205", id, 0, 0, str_concat(str_concat("cannot read `", path), "`"), unreadable);
            continue;
        }
        let mut text = "";
        if over { text = ov_read(paths, texts_over, file, io); } else { text = read_file(file); }
        // Parsed for its imports only; its diagnostics are the caller's, from its own parse.
        let t = sx_tree();
        let scratch = dg_new();
        let program = sx_parse_source(text, t, scratch);
        let imports = sx_items(t, sx_field(t, program, "imports"));
        let dir = parent(path);
        let children = strs_new();
        let children_std = ints_new();
        let named = strs_new();
        let mut i = 0;
        while i < ints_len(imports) {
            let imp = ints_get(imports, i);
            let ipath = sx_name(t, imp, "path");
            let span = sx_field(t, imp, "path_span");
            let s = sx_s(t, span);
            let e = sx_e(t, span);
            i = i + 1;
            if starts_with(ipath, "@std/") {
                let sname = str_slice(ipath, 5, str_len(ipath));
                if contains(stds, sname) {
                    strs_push(children, sname);
                    ints_push(children_std, 1);
                    strs_push(named, str_concat(str_concat("@std/", sname), ".nz"));
                } else {
                    strs_push(named, "");
                    let known = strs_new();
                    let mut k = 0;
                    while k < strs_len(stds) {
                        strs_push(known, str_concat(str_concat("`@std/", strs_get(stds, k)), "`"));
                        k = k + 1;
                    }
                    pend(pending, "N0205", id, s, e, str_concat(str_concat("there is no standard module `", ipath), "`"),
                            str_concat("a path beginning with `@std/` names a module the toolchain provides; the standard modules are ", str_join(known, ", ")));
                }
                continue;
            }
            if is_std {
                strs_push(named, "");
                pend(pending, "N0205", id, s, e, str_concat(str_concat("a standard module cannot import `", ipath), "`"), "");
                continue;
            }
            // `NAME:path` (N46): a module of a package the importing package depends on.
            let colon = index_of_byte(ipath, 58);
            let mut target = join_path(dir, ipath);
            let mut within = "";
            let from = pk_package_of(packages, path);
            if from >= 0 { within = pk_source_root(packages, from); }
            if colon >= 0 {
                let pkg = str_slice(ipath, 0, colon);
                if pk_packages_state(packages) != 1 {
                    strs_push(named, "");
                    pend(pending, "N0508", id, s, e, str_concat(str_concat("`", pkg), ":` names a package, and this compilation is not a package's"),
                            "a package is a directory holding `nazm.toml`; build it by naming its directory");
                    continue;
                }
                let dep = pk_dependency(packages, from, pkg);
                if dep < 0 {
                    strs_push(named, "");
                    let mut whose = "this package";
                    if from >= 0 { whose = pk_name(packages, from); }
                    let declared = pk_declared(packages, from);
                    let mut help = "it declares no dependencies; add one under `[dependencies]` in `nazm.toml`";
                    if declared != "" { help = str_concat("it declares ", declared); }
                    pend(pending, "N0508", id, s, e, str_concat(str_concat(str_concat(str_concat("`", pkg), "` is not a dependency of `"), whose), "`"), help);
                    continue;
                }
                target = join_path(pk_source_root(packages, dep), str_slice(ipath, colon + 1, str_len(ipath)));
                within = pk_source_root(packages, dep);
            }
            // Inside a package, an import stays inside the source root it resolves against.
            if within != "" && ov_exists(paths, target, io) && pk_under(normalise(target), within) == false {
                strs_push(named, "");
                pend(pending, "N0205", id, s, e, str_concat(str_concat("`", ipath), "` leaves its package's source root"),
                        "a package reaches another package's modules as `NAME:path`");
                continue;
            }
            if ov_exists(paths, target, io) {
                strs_push(children, target);
                ints_push(children_std, 0);
                strs_push(named, normalise(target));
            } else {
                strs_push(named, "");
                pend(pending, "N0205", id, s, e, str_concat(str_concat("cannot find `", ipath), "`"),
                        str_concat(str_concat("looked for `", target), "`, relative to the importing file"));
            }
        }
        // The prelude's standard modules a program module names (R1.5, D9): never a package's.
        let in_program = is_std == false && is_program(source_root, packages, path);
        let mut given = strs_new();
        // The calls the parser wrote for a form (a map literal's `hashmap_single`).
        let called = strs_new();
        let functions = sx_items(t, sx_field(t, program, "functions"));
        let mut f = 0;
        while f < ints_len(functions) {
            let body = sx_field(t, ints_get(functions, f), "body");
            if sx_is_some(t, body) {
                let names = sx_called_names(t, sx_unwrap(t, body));
                let mut q = 0;
                while q < strs_len(names) {
                    strs_push(called, strs_get(names, q));
                    q = q + 1;
                }
            }
            f = f + 1;
        }
        if in_program {
            let written = strs_new();
            let mut w = 0;
            while w < strs_len(children) {
                if ints_get(children_std, w) == 1 { strs_push(written, strs_get(children, w)); }
                w = w + 1;
            }
            given = prelude_named(table, text, written, called);
        }
        // Pushed in reverse, so they are read in source order; the prelude's after the written.
        let mut g = strs_len(given) - 1;
        while g >= 0 {
            strs_push(stack, strs_get(given, g));
            ints_push(stack_std, 1);
            g = g - 1;
        }
        let mut c = strs_len(children) - 1;
        while c >= 0 {
            strs_push(stack, strs_get(children, c));
            ints_push(stack_std, ints_get(children_std, c));
            c = c - 1;
        }
        strs_push(identities, identity);
        strs_push(names, name);
        strs_push(texts, ld_with_newline(text));
        ints_push(tfirst, strs_len(targets));
        ints_push(tcount, strs_len(named));
        strs_push(implicit, str_join(given, ","));
        let mut k = 0;
        while k < strs_len(named) {
            strs_push(targets, strs_get(named, k));
            k = k + 1;
        }
        if is_std { ints_push(standard, 1); } else { ints_push(standard, 0); }
        if in_program { ints_push(in_programs, 1); } else { ints_push(in_programs, 0); }
    }
    // The core prelude, last.
    strs_push(names, "@core/prelude.nz");
    strs_push(texts, ld_with_newline(read_file(str_concat(library, "/core/prelude.nz"))));
    ints_push(standard, 1);
    ints_push(in_programs, 0);
    strs_push(identities, "@core/prelude.nz");
    ints_push(tfirst, strs_len(targets));
    ints_push(tcount, 0);
    strs_push(implicit, "");
    let loaded = Loaded(names: names, texts: texts, standard: standard, program: in_programs, identities: identities, tfirst: tfirst, tcount: tcount, targets: targets,
            implicit: implicit);
    let mut k = 0;
    while k < strs_len(pending.code) {
        let base = ld_base(loaded, ints_get(pending.file, k));
        dg_error(d, strs_get(pending.code, k), base + ints_get(pending.start, k), base + ints_get(pending.end, k),
                strs_get(pending.message, k), "", strs_get(pending.help, k));
        dg_in_file(d, ints_get(pending.file, k));
        k = k + 1;
    }
    loaded
}

fn index_of_byte(s: Str, b: Int) -> Int {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == b { return i; }
        i = i + 1;
    }
    0 - 1
}

pub fn ld_count(l: Loaded) -> Int { strs_len(l.names) }
pub fn ld_text(l: Loaded, i: Int) -> Str { strs_get(l.texts, i) }
pub fn ld_name(l: Loaded, i: Int) -> Str { strs_get(l.names, i) }
// Its identity: its normalised absolute path, `@std/NAME.nz` or `@core/prelude.nz`.
pub fn ld_identity(l: Loaded, i: Int) -> Str { strs_get(l.identities, i) }
pub fn ld_standard(l: Loaded, i: Int) -> Bool { ints_get(l.standard, i) == 1 }
pub fn ld_program(l: Loaded, i: Int) -> Bool { ints_get(l.program, i) == 1 }

// Whether the file at `path` is a module of the program itself (`ModuleKey::is_program`): a
// dependency package's module is keyed by its package, and any other by its path relative to the
// source root — none for one outside it, or one whose first component holds an `@`.
fn is_program(source_root: Str, packages: Packages, path: Str) -> Bool {
    let at = normalise(path);
    let p = pk_package_of(packages, at);
    if p >= 0 && p != pk_root_package(packages) { return false; }
    let root = normalise(source_root);
    if at == root || pk_under(at, root) == false { return false; }
    let mut rest = str_slice(at, str_len(root) + 1, str_len(at));
    if root == "/" { rest = str_slice(at, 1, str_len(at)); }
    let slash = index_of_byte(rest, 47);
    let mut first = rest;
    if slash >= 0 { first = str_slice(rest, 0, slash); }
    index_of_byte(first, 64) < 0
}

// The prelude's standard modules file `i` names (R1.5, D9), joined by `,`; "" for none.
pub fn ld_implicit(l: Loaded, i: Int) -> Str { strs_get(l.implicit, i) }

// --- the prelude's standard modules (R1.5, D9; `prelude_named`) --------------------------------

// The prelude modules (`stdlib::PRELUDE`), each with its public items' names and its traits'
// methods, the method names its functions answer to and no built-in does, and the prelude modules
// it imports — each list a run of its pool, by entry.
struct PreludeTable {
    entry: Strs,
    nfirst: Ints,
    ncount: Ints,
    names: Strs,
    mfirst: Ints,
    mcount: Ints,
    methods: Strs,
    ifirst: Ints,
    icount: Ints,
    imports: Strs,
}

fn prelude_modules() -> Strs {
    let s = strs_new();
    strs_push(s, "hash");
    strs_push(s, "hashmap");
    strs_push(s, "option");
    strs_push(s, "ordmap");
    strs_push(s, "result");
    strs_push(s, "sort");
    strs_push(s, "text");
    s
}

// The prelude modules' names, read from their sources in the library (`prelude_table`).
fn prelude_table(library: Str, io: IoCap) -> PreludeTable {
    let tb = PreludeTable(entry: strs_new(), nfirst: ints_new(), ncount: ints_new(), names: strs_new(), mfirst: ints_new(), mcount: ints_new(),
            methods: strs_new(), ifirst: ints_new(), icount: ints_new(), imports: strs_new());
    let mods = prelude_modules();
    let builtins = strs_new();
    let rows = bi_rows();
    let mut r = 0;
    while r < strs_len(rows) {
        let row = strs_get(rows, r);
        strs_push(builtins, str_slice(row, 0, index_of_byte(row, 124)));
        r = r + 1;
    }
    let prefixes = strs_new();
    strs_push(prefixes, "vec_");
    strs_push(prefixes, "ints_");
    strs_push(prefixes, "strs_");
    strs_push(prefixes, "bytes_");
    strs_push(prefixes, "str_");
    strs_push(prefixes, "int_");
    let mut e = 0;
    while e < strs_len(mods) {
        let name = strs_get(mods, e);
        let file = str_concat(str_concat(str_concat(library, "/std/"), name), ".nz");
        let t = sx_tree();
        let mut text = "";
        if file_exists(file) { text = read_file(file); }
        let program = sx_parse_source(text, t, dg_new());
        strs_push(tb.entry, name);
        ints_push(tb.nfirst, strs_len(tb.names));
        ints_push(tb.mfirst, strs_len(tb.methods));
        ints_push(tb.ifirst, strs_len(tb.imports));
        let functions = sx_items(t, sx_field(t, program, "functions"));
        let mut i = 0;
        while i < ints_len(functions) {
            let f = ints_get(functions, i);
            if sx_is_some(t, sx_field(t, f, "pub_span")) && sx_is_some(t, sx_field(t, f, "method_of")) == false {
                let fname = sx_name(t, f, "name");
                strs_push(tb.names, fname);
                let cut = index_of_byte(fname, 95);
                if cut >= 0 {
                    let m = str_slice(fname, cut + 1, str_len(fname));
                    let mut builtin = false;
                    let mut p = 0;
                    while p < strs_len(prefixes) {
                        if contains(builtins, str_concat(strs_get(prefixes, p), m)) { builtin = true; }
                        p = p + 1;
                    }
                    if builtin == false { strs_push(tb.methods, m); }
                }
            }
            i = i + 1;
        }
        let records = sx_items(t, sx_field(t, program, "records"));
        i = 0;
        while i < ints_len(records) {
            if sx_is_some(t, sx_field(t, ints_get(records, i), "pub_span")) { strs_push(tb.names, sx_name(t, ints_get(records, i), "name")); }
            i = i + 1;
        }
        let enums = sx_items(t, sx_field(t, program, "enums"));
        i = 0;
        while i < ints_len(enums) {
            if sx_is_some(t, sx_field(t, ints_get(enums, i), "pub_span")) { strs_push(tb.names, sx_name(t, ints_get(enums, i), "name")); }
            i = i + 1;
        }
        let traits = sx_items(t, sx_field(t, program, "traits"));
        i = 0;
        while i < ints_len(traits) {
            let tr = ints_get(traits, i);
            if sx_is_some(t, sx_field(t, tr, "pub_span")) {
                strs_push(tb.names, sx_name(t, tr, "name"));
                let ms = sx_items(t, sx_field(t, tr, "methods"));
                let mut k = 0;
                while k < ints_len(ms) {
                    strs_push(tb.methods, sx_name(t, ints_get(ms, k), "name"));
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        if name == "hashmap" { strs_push(tb.names, "Map"); }
        let imports = sx_items(t, sx_field(t, program, "imports"));
        i = 0;
        while i < ints_len(imports) {
            let path = sx_name(t, ints_get(imports, i), "path");
            if starts_with(path, "@std/") {
                let n = str_slice(path, 5, str_len(path));
                if contains(mods, n) { strs_push(tb.imports, n); }
            }
            i = i + 1;
        }
        ints_push(tb.ncount, strs_len(tb.names) - ints_get(tb.nfirst, e));
        ints_push(tb.mcount, strs_len(tb.methods) - ints_get(tb.mfirst, e));
        ints_push(tb.icount, strs_len(tb.imports) - ints_get(tb.ifirst, e));
        e = e + 1;
    }
    tb
}

fn run_has(pool: Strs, first: Int, count: Int, set: Strs) -> Bool {
    let mut i = 0;
    while i < count {
        if contains(set, strs_get(pool, first + i)) { return true; }
        i = i + 1;
    }
    false
}

// The prelude modules a program module names (`prelude_named`), in the prelude's order, leaving
// out those it imports itself: by an identifier that is one of their items or a call the parser
// wrote for a form (a map literal's `hashmap_single`), or by a method that resolves to one of their
// functions and to no built-in; with the prelude modules those import.
fn prelude_named(tb: PreludeTable, text: Str, written: Strs, called: Strs) -> Strs {
    let idents = strs_new();
    let methods = strs_new();
    named_in(text, idents, methods);
    let wanted = strs_new();
    let mut e = 0;
    while e < strs_len(tb.entry) {
        let name = strs_get(tb.entry, e);
        let named = contains(written, name) || run_has(tb.names, ints_get(tb.nfirst, e), ints_get(tb.ncount, e), idents)
                || run_has(tb.names, ints_get(tb.nfirst, e), ints_get(tb.ncount, e), called)
                || run_has(tb.methods, ints_get(tb.mfirst, e), ints_get(tb.mcount, e), methods);
        if named { strs_push(wanted, name); }
        e = e + 1;
    }
    let mut i = 0;
    while i < strs_len(wanted) {
        let at = index_of(tb.entry, strs_get(wanted, i));
        let mut k = 0;
        while k < ints_get(tb.icount, at) {
            let dep = strs_get(tb.imports, ints_get(tb.ifirst, at) + k);
            if contains(wanted, dep) == false { strs_push(wanted, dep); }
            k = k + 1;
        }
        i = i + 1;
    }
    let out = strs_new();
    e = 0;
    while e < strs_len(tb.entry) {
        let name = strs_get(tb.entry, e);
        if contains(wanted, name) && contains(written, name) == false { strs_push(out, name); }
        e = e + 1;
    }
    out
}

// The identifiers `text` names, and the methods it calls (`x.m(`), into `idents` and `methods` —
// the holes of an interpolated string's too, which the lexer keeps as text (`named_in`, R1.5 4.5).
fn named_in(text: Str, idents: Strs, methods: Strs) -> Int {
    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex_all(text, kinds, starts, ends, texts, dg_new());
    let mut n = 0;
    while n < ints_len(kinds) {
        if ints_get(kinds, n) == k_ident() {
            let name = strs_get(texts, n);
            if contains(idents, name) == false { strs_push(idents, name); }
            let after_dot = n > 0 && ints_get(kinds, n - 1) == k_dot();
            let called = n + 1 < ints_len(kinds) && ints_get(kinds, n + 1) == k_lparen();
            if after_dot && called && contains(methods, name) == false { strs_push(methods, name); }
        }
        if ints_get(kinds, n) == k_fstr() && str_len(strs_get(texts, n)) > 0 {
            let pieces = sx_split(strs_get(texts, n), 124);
            let mut j = 0;
            while j < strs_len(pieces) {
                let piece = strs_get(pieces, j);
                if str_byte(piece, 0) == 72 {
                    // `H:at:align:width:precision:start:end:text`, the text last.
                    let mut cuts = 0;
                    let mut q = 0;
                    while q < str_len(piece) && cuts < 7 {
                        if str_byte(piece, q) == 58 { cuts = cuts + 1; }
                        q = q + 1;
                    }
                    named_in(sx_unesc(str_slice(piece, q, str_len(piece))), idents, methods);
                }
                j = j + 1;
            }
        }
        n = n + 1;
    }
    0
}

// The file the `k`th import of file `i` names, by its index in load order; -1 where it did not
// resolve.
pub fn ld_import_target(l: Loaded, i: Int, k: Int) -> Int {
    if k >= ints_get(l.tcount, i) { return 0 - 1; }
    let want = strs_get(l.targets, ints_get(l.tfirst, i) + k);
    if want == "" { return 0 - 1; }
    index_of(l.identities, want)
}

// Where file `i` begins in the concatenation of the compilation's files.
pub fn ld_base(l: Loaded, i: Int) -> Int {
    let mut base = 0;
    let mut k = 0;
    while k < i {
        base = base + str_len(strs_get(l.texts, k));
        k = k + 1;
    }
    base
}
