// The parser's comparison driver (R2, `openspec/changes/r2-front-end/design.md`, D3).
//
// Usage: tree FILE
// Output: the file's syntax tree as the reference parser's `{:#?}` prints it, spans written
// `start..end`, then every lexing and parsing diagnostic, `error CODE start end message`. It is
// what `compiler/tests/refdump tree` prints for the reference, byte for byte, when they agree.

use "syntax.nz";
use "lex.nz";
use "diag.nz";

// A line break, written so that no string literal in this file holds one (`selfhost.rs` dumps a
// string's value on one line).
fn nl() -> Str { str_from_byte(10) }

fn main(io: IoCap) -> Int {
    if args_count() < 1 {
        eprint(str_concat("usage: tree FILE", nl()));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat(str_concat("cannot read ", path), nl()));
        exit_with(2);
    }
    let src = read_file(path);
    let t = sx_tree();
    let d = dg_new();
    let program = sx_parse_source(src, t, d);
    let out = strs_new();
    sx_print(t, program, 0, out, strs_new());
    strs_push(out, nl());
    let mut i = 0;
    while i < dg_len(d) {
        strs_push(out, "error ");
        strs_push(out, strs_get(d.code, i));
        strs_push(out, " ");
        strs_push(out, int_to_str(ints_get(d.start, i)));
        strs_push(out, " ");
        strs_push(out, int_to_str(ints_get(d.end, i)));
        strs_push(out, " ");
        strs_push(out, lex_esc(strs_get(d.message, i)));
        strs_push(out, nl());
        i = i + 1;
    }
    print(str_join(out, ""));
    0
}
