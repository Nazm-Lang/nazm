// LLVM IR emission for Nazm, written in Nazm.
//
// The fourth component, and the one that makes the others a *compiler*: it turns the node
// arena into LLVM IR text, which `clang` assembles. Same arrangement as `nazm build` —
// `docs/architecture.md` §1 says not to link LLVM in year one, and `clang` reads IR from
// a file — and the same arrangement `docs/bootstrap.md` §4 records: emitting
// LLVM and invoking an external assembler is self-hosting, a wrapper that shells out to
// the Rust compiler is not.
//
// # Scope of this increment
//
// `fn main() -> Int { EXPRESSION }` over integer arithmetic: literals, unary `-`, and
// `+ - * / %` with the **specified** failure behaviour — overflow through
// `llvm.*.with.overflow.i64` and an explicit branch, never `nsw`; division by zero and
// `Int::MIN / -1` guarded before the instruction that would fault; `Int::MIN % -1`
// answered with a constant because `srem` faults on that pair. Every failure reports its
// own source position, resolved here and baked in as a constant, because the generated
// program has no syntax tree to consult.
//
// Anything outside that is refused by name. The checker runs first, so a refusal here is
// about *this backend's coverage*, never about the program being wrong — the same
// distinction `nazm-lir` keeps.
//
// # Why a post-order scan is enough for this subset
//
// The arena is post-order, and an expression's operands are emitted before it. With no
// control flow there are no basic blocks to open, so one left-to-right pass with a stack
// of SSA value numbers emits in exactly the right order. Control flow will need the
// marker walk `compiler/check.nz` uses; it is not needed yet and is not written yet.

use "analyse.nz";
use "module.nz";
use "lex.nz";
use "parse.nz";

// --- output assembly -------------------------------------------------------------

fn nl() -> Str { str_from_byte(10) }

// A double quote and a backslash, built rather than written: v0.1 string literals have
// no escapes (`docs/spec.md`), so a quote cannot appear inside one. Emitting LLVM text
// needs both constantly, which is the clearest argument for escapes the language has
// produced so far — recorded rather than worked around silently.
fn dq() -> Str { str_from_byte(34) }
fn bs() -> Str { str_from_byte(92) }

fn add_line(out: Strs, line: Str) -> Int {
    strs_push(out, line);
    strs_push(out, nl());
    strs_len(out)
}

// One pass and one allocation.
//
// This was `str_concat` in a loop, which is quadratic in time *and* memory — and with
// nothing ever freed, the compiler ran out of memory assembling its own output. That is
// the measurement that made `str_join` a built-in rather than a convenience.
fn join(out: Strs) -> Str {
    str_join(out, "")
}

fn v(n: Int) -> Str { str_concat("%", int_to_str(n)) }

// The LLVM type for one of the checker's type codes.
//
// `Str` is `{ pointer, byte length, owner }` by value; a sequence is a pointer to its
// `{ len, cap, data, rc }` header, which is what gives sequences reference semantics. The
// codes are `compiler/analyse.nz`'s, so the two cannot disagree about what a node holds.
//
// The third field of a `Str` is the allocation whose lifetime keeps the pointer valid, or
// null where nothing has to — a literal, or a process argument. It exists because
// `str_slice` produces an interior pointer and two fields cannot say what owns one. See
// `docs/architecture.md` §7.8; `crates/nazm-lir/src/ir.rs` says the same thing in Rust.
fn llvm_type(t: Int) -> Str {
    if t == t_int() { return "i64"; }
    if t == t_bool() { return "i1"; }
    if t == t_str() { return "{ ptr, i64, ptr }"; }
    if t == t_ints() { return "ptr"; }
    if t == t_strs() { return "ptr"; }
    if t == t_chan() { return "ptr"; }
    // A `Vec` is a sequence header by pointer, whatever it holds: the element's layout is
    // in the operations, not in the handle.
    if is_vec(t) { return "ptr"; }
    // A record is a **named** LLVM aggregate, by value. Named for the reason a function
    // is named by index here: this emitter writes one module for a whole program, so the
    // index is unique by construction and is the same discipline `symbol` uses.
    if is_record(t) { return str_concat("%nz.t", int_to_str(record_of(t))); }
    "void"
}

// --- source positions --------------------------------------------------------------
//
// `line:column`, 1-based, from a byte offset — the same convention the renderer uses, so
// a runtime error from a compiled program points where `nazm run` would.

// Where an offset is: a line and a column, 1-based.
//
// **The first record in this compiler's own source**, and it is here because this is the
// one place the language could not express what the code meant. `line_of` and
// `column_of` were two functions because a function returns one value: the first scanned
// forward counting newlines, the second scanned *backward* looking for one, and every
// diagnostic paid for both. A column falls out of the forward scan for nothing — reset it
// at each newline — so the two passes were never anything but the missing return type.
struct Place {
    line: Int,
    column: Int,
}

fn place_of(src: Str, offset: Int) -> Place {
    let mut i = 0;
    let mut line = 1;
    let mut column = 1;
    while i < offset {
        if str_byte(src, i) == 10 {
            line = line + 1;
            column = 1;
        } else {
            column = column + 1;
        }
        i = i + 1;
    }
    Place(line: line, column: column)
}

fn position(src: Str, path: Str, offset: Int) -> Str {
    let at = place_of(src, offset);
    str_concat(str_concat(path, ":"),
            str_concat(str_concat(int_to_str(at.line), ":"),
            int_to_str(at.column)))
}

// --- the failure helper and its messages --------------------------------------------
//
// Not `llvm.trap`: a process killed by `SIGILL` is not the runtime-error contract
// `docs/spec.md` promises, which is that the program *stops with a diagnostic*. So a
// failing operation calls a generated helper that writes to descriptor 2 and exits 2 —
// the same status `nazm run` uses.

fn escape_byte(b: Int) -> Str {
    if b == 34 { return str_concat(bs(), "22"); }
    if b == 92 { return str_concat(bs(), "5C"); }
    if b < 32 { return str_concat(bs(), hex2(b)); }
    if b > 126 { return str_concat(bs(), hex2(b)); }
    str_from_byte(b)
}

fn hex_digit(d: Int) -> Str {
    if d < 10 { return int_to_str(d); }
    if d == 10 { return "A"; }
    if d == 11 { return "B"; }
    if d == 12 { return "C"; }
    if d == 13 { return "D"; }
    if d == 14 { return "E"; }
    "F"
}

fn hex2(b: Int) -> Str {
    str_concat(hex_digit(b / 16), hex_digit(b % 16))
}

fn escaped(s: Str) -> Str {
    let mut out = "";
    let mut i = 0;
    while i < str_len(s) {
        out = str_concat(out, escape_byte(str_byte(s, i)));
        i = i + 1;
    }
    out
}

// Interned: a program with the same failure twice carries the message once.
fn message_index(msgs: Strs, text: Str) -> Int {
    let mut i = 0;
    while i < strs_len(msgs) {
        if strs_get(msgs, i) == text { return i; }
        i = i + 1;
    }
    strs_push(msgs, text);
    strs_len(msgs) - 1
}

fn failure_text(code: Str, message: Str, at: Str) -> Str {
    str_concat(str_concat(str_concat("nazm: error[", code), str_concat("]: ", message)),
            str_concat(str_concat(" at ", at), nl()))
}

// Emit the branch that reports `msg` and never returns, then continue after it.
//
// The failure block ends in `unreachable`, so it is never a predecessor of anything.
// A guard opens two blocks, so it **must** tell `current` where emission ended up.
// Without that a later `phi` names the block the guard left, not the one that branches to
// it — which clang reports as "PHI node entries do not match predecessors", several
// constructs away from the cause.
fn guard(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints,
        cond: Int, code: Str, message: Str, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let text = failure_text(code, message, at);
    let idx = message_index(msgs, text);
    let fail = take_label(next);
    let cont = take_label(next);
    add_line(out, str_concat(str_concat("  br i1 ", v(cond)),
            str_concat(str_concat(", label %b", int_to_str(fail)),
            str_concat(", label %b", int_to_str(cont)))));
    open_block(out, current, live, str_concat("b", int_to_str(fail)));
    add_line(out, str_concat(str_concat("  call void @nz.fail(ptr @.m", int_to_str(idx)),
            str_concat(", i64 ", str_concat(int_to_str(str_len(text) + 1), ")"))));
    // `@nz.fail` records and returns; it does not end the process. The failure leaves
    // this function by its own exit, so that a `scope` further out can join its tasks
    // before anything is reported — see `docs/spec.md`, *Error propagation*.
    unwind(out, next, current, live, owned, otype, rowns);
    open_block(out, current, live, str_concat("b", int_to_str(cont)));
    cont
}

// Join one scope's tasks and take on the first failure any of them had.
//
// `@nz.fail` keeps the first failure a thread records, so a task's can never displace one
// the body already had — which is the precedence the specification states.
fn emit_join(out: Strs, next: Ints, current: Strs, live: Ints, tids: Int) -> Int {
    let r = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(r)),
            str_concat(" = call { ptr, i64 } @nz.scope_join(ptr ", str_concat(v(tids), ")"))));
    let msg = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(msg)),
            str_concat(" = extractvalue { ptr, i64 } ", str_concat(v(r), ", 0"))));
    let has = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(has)),
            str_concat(" = icmp ne ptr ", str_concat(v(msg), ", null"))));
    let take = take_label(next);
    let cont = take_label(next);
    add_line(out, str_concat(str_concat("  br i1 ", v(has)),
            str_concat(str_concat(", label %b", int_to_str(take)),
            str_concat(", label %b", int_to_str(cont)))));
    open_block(out, current, live, str_concat("b", int_to_str(take)));
    let len = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(len)),
            str_concat(" = extractvalue { ptr, i64 } ", str_concat(v(r), ", 1"))));
    add_line(out, str_concat(str_concat("  call void @nz.fail(ptr ", v(msg)),
            str_concat(str_concat(", i64 ", v(len)), ")")));
    add_line(out, str_concat("  br label %b", int_to_str(cont)));
    open_block(out, current, live, str_concat("b", int_to_str(cont)));
    // The list of task ids is dead the moment the join returns: every task it named has
    // ended, and the blocks it pointed at were freed by the join itself. It is not a Nazm
    // value and no binding can hold it, so it goes through the **uncounted** release —
    // counting it would answer a question about the program's sequences with a number
    // that includes the runtime's own.
    let freed = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(freed)),
            str_concat(" = call i1 @nz.arr_release(ptr ", str_concat(v(tids), ")"))));
    0
}

// Join the open scopes from the innermost down to the one at `from` in `live`.
//
// Innermost first because that is the nesting: an inner scope's tasks are contained by
// the outer one. Every way out of a scope joins it — falling off the end, a failure, and
// each `return`, `break` or `continue` that leaves it. Until N10.1 only the first two
// did here, so a task that failed inside a scope a `break` left was never waited for and
// its failure never seen: the program printed a value where the reference stopped with
// the task's diagnostic. The reference's `join_through`.
fn join_from(out: Strs, next: Ints, current: Strs, live: Ints, from: Int) -> Int {
    let mut i = ints_len(live) - 1;
    while i >= from {
        emit_join(out, next, current, live, ints_get(live, i));
        i = i - 1;
    }
    0
}

// Leave for the failure exit, joining every scope still open, innermost first.
//
// The open scopes are held from index 2 of `live`, innermost last — in the array already
// threaded to every emitter rather than in a parameter added to eleven signatures and to
// everything that calls them.
fn unwind(out: Strs, next: Ints, current: Strs, live: Ints,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    release_temporaries(out, next, owned, otype, rowns);
    join_from(out, next, current, live, 2);
    ints_set(live, 1, 1);
    add_line(out, "  br label %nz.unwind");
    0
}

// If this thread has failed, leave; otherwise carry on in a fresh block.
fn check_failed(out: Strs, next: Ints, current: Strs, live: Ints,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let flag = take_number(next);
    let ok = take_label(next);
    add_line(out, str_concat(str_concat("  ", v(flag)), " = load i1, ptr @nz.failed"));
    // With nothing open to join **and nothing outstanding**, the failure goes straight to
    // the function's exit rather than through a block whose only instruction forwards to
    // it. This is emitted after every call, so the block it saves is worth more than it
    // looks: at `-O0` clang's time tracks the block count, and this is the common case by
    // far. The shortcut is narrowed by exactly the condition that makes it wrong — a
    // temporary this expression is holding has to be released before the failure leaves,
    // and there is nowhere to write that but a block of its own.
    if ints_len(live) == 2 {
        if ints_len(owned) == 0 {
            ints_set(live, 1, 1);
            add_line(out, str_concat(str_concat("  br i1 ", v(flag)),
                    str_concat(", label %nz.unwind, label %b", int_to_str(ok))));
        } else {
            let held = take_label(next);
            add_line(out, str_concat(str_concat("  br i1 ", v(flag)),
                    str_concat(str_concat(", label %b", int_to_str(held)),
                    str_concat(", label %b", int_to_str(ok)))));
            open_block(out, current, live, str_concat("b", int_to_str(held)));
            unwind(out, next, current, live, owned, otype, rowns);
        }
    } else {
        let uw = take_label(next);
        add_line(out, str_concat(str_concat("  br i1 ", v(flag)),
                str_concat(str_concat(", label %b", int_to_str(uw)),
                str_concat(", label %b", int_to_str(ok)))));
        open_block(out, current, live, str_concat("b", int_to_str(uw)));
        unwind(out, next, current, live, owned, otype, rowns);
    }
    open_block(out, current, live, str_concat("b", int_to_str(ok)));
    0
}

// `spawn f(args);` — pack the arguments, start the thread, record it for the join.
//
// # Why the arguments are copied to the heap
//
// The task outlives this stack frame by construction, so it cannot be handed a pointer
// into it. One allocation per spawn carries the whole argument list. Its first eight bytes
// are the thread handle, so the list the scope joins holds one pointer per task and needs
// no second allocation; the next sixteen are where this task leaves its diagnostic if it
// fails, which the join reads after `pthread_join` — a happens-before edge, so no lock.
// The trampoline's release lines, which go into the task's own buffer rather than the
// function being emitted — so they cannot share `emit_release`, and an exhaustive `match`
// is what keeps the two in step.
fn task_release(t: Strs, head: Str, i: Int) -> Int {
    strs_push(t, str_concat(str_concat("  call void ", head),
            str_concat(int_to_str(i), ")")));
    0
}

fn task_release_backing(t: Strs, i: Int) -> Int {
    strs_push(t, str_concat(str_concat(str_concat("  %o", int_to_str(i)),
            " = extractvalue { ptr, i64, ptr } %v"), str_concat(int_to_str(i), ", 2")));
    strs_push(t, str_concat(str_concat("  call void @nz.str_release(ptr %o",
            int_to_str(i)), ")"));
    0
}

fn task_release_helper(t: Strs, r: Int, ty: Int, i: Int) -> Int {
    strs_push(t, str_concat(str_concat(str_concat("  call void @nz.rl", int_to_str(r)),
            str_concat("(", llvm_type(ty))),
            str_concat(str_concat(" %v", int_to_str(i)), ")")));
    0
}

fn emit_spawn(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, tasks: Strs,
        blocks: Strs, owned: Ints, vals: Ints, nar: Ints, ntype: Ints, kids: Ints,
        kid_first: Ints, fnames: Strs, fret: Ints, k: Int, callee: Int, at: Str,
        rowns: Ints, otype: Ints) -> Int {
    let argc = ints_get(nar, k);
    // Popped in reverse, then read back in source order.
    let args = ints_new();
    let mut a = 0;
    while a < argc { ints_push(args, ints_pop(vals)); a = a + 1; }

    // A **named LLVM type** for the argument block rather than hand-computed byte
    // offsets: `{ i64 handle, ptr message, i64 length, … arguments }`. The first three are
    // fixed, because `@nz.spawn` writes the thread handle at offset 0 and the join reads
    // the diagnostic at 8 and 16 from the runtime's own C.
    //
    // It used to be arithmetic — twenty-four bytes for a `Str` and eight for everything
    // else — and that was true of every type the language had when it was written. A
    // record is neither: `struct M { text: Str, }` is twenty-four bytes and was given
    // eight, so the store ran past its slot and the task read the next argument's bytes as
    // its own. Letting LLVM compute the layout is the only version of this that stays
    // correct when a type is added.
    let block = str_concat("%nz.blk", int_to_str(strs_len(tasks)));
    let mut fields = "i64, ptr, i64";
    let mut i = 0;
    while i < argc {
        let t = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + i));
        fields = str_concat(str_concat(fields, ", "), llvm_type(t));
        i = i + 1;
    }
    strs_push(blocks, str_concat(str_concat(block, " = type { "), str_concat(fields, " }")));

    let blk = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(blk)),
            str_concat(str_concat(" = call ptr @malloc(i64 ptrtoint (ptr getelementptr (",
            block), str_concat(", ptr null, i32 1) to i64))", ""))));
    let bad = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(bad)),
            str_concat(" = icmp eq ptr ", str_concat(v(blk), ", null"))));
    guard(out, msgs, next, current, live, bad, "N0406", "out of memory", at, owned, otype, rowns);

    // `malloc` does not zero, and the join reads this slot for every task including the
    // ones that succeeded. Left as the allocator found it, a program that never failed
    // would report.
    let ep = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(ep)),
            str_concat(str_concat(" = getelementptr ", block),
            str_concat(", ptr ", str_concat(v(blk), ", i64 0, i32 1")))));
    add_line(out, str_concat(str_concat("  store ptr null, ptr ", v(ep)), ""));
    let lp = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(lp)),
            str_concat(str_concat(" = getelementptr ", block),
            str_concat(", ptr ", str_concat(v(blk), ", i64 0, i32 2")))));
    add_line(out, str_concat(str_concat("  store i64 0, ptr ", v(lp)), ""));

    // The block **takes** each argument's reference and the trampoline gives it back when
    // the task ends. Not ceremony: a task outlives the statement that started it, so a
    // binding reassigned inside the scope would otherwise release storage the task is
    // still reading. The reference is taken here, on the thread that already holds one.
    i = 0;
    while i < argc {
        let t = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + i));
        let value = ints_get(args, argc - 1 - i);
        let slot = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(slot)),
                str_concat(str_concat(str_concat(" = getelementptr ", block),
                str_concat(", ptr ", v(blk))),
                str_concat(", i64 0, i32 ", int_to_str(i + 3)))));
        own_keep(out, next, owned, value, t, rowns, otype);
        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(t)),
                str_concat(" ", v(value))),
                str_concat(", ptr ", v(slot))));
        i = i + 1;
    }

    // One trampoline per spawn site rather than per callee: two spawns of the same
    // function share one only if their argument types match, and generating per site makes
    // that true without having to check it.
    let name = str_concat("@nz.task", int_to_str(strs_len(tasks)));
    let t = strs_new();
    strs_push(t, str_concat(str_concat("define internal ptr ", name), "(ptr %a) {"));
    strs_push(t, "entry:");
    let mut passed = "";
    i = 0;
    while i < argc {
        let ty = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + i));
        strs_push(t, str_concat(str_concat("  %p", int_to_str(i)),
                str_concat(str_concat(" = getelementptr ", block),
                str_concat(", ptr %a, i64 0, i32 ", int_to_str(i + 3)))));
        strs_push(t, str_concat(str_concat(str_concat("  %v", int_to_str(i)), " = load "),
                str_concat(str_concat(llvm_type(ty), ", ptr %p"), int_to_str(i))));
        if i > 0 { passed = str_concat(passed, ", "); }
        passed = str_concat(passed, str_concat(str_concat(llvm_type(ty), " %v"), int_to_str(i)));
        i = i + 1;
    }
    // The task's return value is discarded, which the specification says outright: results
    // travel through channels, so there is one mechanism rather than two.
    // The *callee's* return type, not the `spawn`'s: a `spawn` produces nothing, so its
    // own node type is unknown and would emit `void` for a function that returns `Int`.
    let mut cret = t_int();
    if callee >= 0 { cret = ints_get(fret, callee); }
    strs_push(t, str_concat(str_concat(str_concat("  %r = call ", llvm_type(cret)),
            str_concat(" ", symbol(callee))),
            str_concat(str_concat("(", passed), ")")));
    // A failure ends the task, not the process. The diagnostic is left here for the
    // scope's join to find, so it is reported by the thread that owns the scope once every
    // sibling has finished.
    strs_push(t, "  %failed = load i1, ptr @nz.failed");
    strs_push(t, "  br i1 %failed, label %publish, label %finished");
    strs_push(t, "publish:");
    strs_push(t, "  %em = load ptr, ptr @nz.errmsg");
    strs_push(t, "  %el = load i64, ptr @nz.errlen");
    strs_push(t, str_concat(str_concat("  %emp = getelementptr ", block),
            ", ptr %a, i64 0, i32 1"));
    strs_push(t, "  store ptr %em, ptr %emp");
    strs_push(t, str_concat(str_concat("  %elp = getelementptr ", block),
            ", ptr %a, i64 0, i32 2"));
    strs_push(t, "  store i64 %el, ptr %elp");
    strs_push(t, "  br label %finished");
    strs_push(t, "finished:");
    // The callee **borrowed** these, exactly as an ordinary call does: the reference the
    // spawn site packed is what kept them alive, and it is given back here, once the call
    // has returned. Whether the task succeeded or failed does not change that, so the
    // release is on the one path both take.
    i = 0;
    while i < argc {
        let ty = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + i));
        // The last two arms were missing until N10 asked this `match` to be exhaustive: a
        // record crossing a task boundary was packed with a reference taken and given
        // back by nobody, so every spawn over one leaked its fields. `unspawn` — the path
        // a task that never started takes — went through `emit_release` and was always
        // right, which is why only a task that *did* start showed it.
        match owns(ty, rowns) {
            Owning.Nothing() => 0,
            Owning.Sequence() => task_release(t, "@nz.seq_release(ptr %v", i),
            Owning.Strings() => task_release(t, "@nz.strs_release(ptr %v", i),
            Owning.Backing() => task_release_backing(t, i),
            Owning.Channel() => task_release(t, "@nz.chan_release(ptr %v", i),
            Owning.Record(at: r) => task_release_helper(t, r, ty, i),
            Owning.Enum(at: r) => task_release_helper(t, r, ty, i),
            // A `Vec` never crosses into a task: the checker refuses it, whatever it holds.
            Owning.Vector(at: _) => 0,
        };
        i = i + 1;
    }
    strs_push(t, "  ret ptr null");
    strs_push(t, "}");
    strs_push(tasks, str_concat(str_join(t, nl()), nl()));

    let tids = ints_get(live, ints_len(live) - 1);
    let rc = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(rc)),
            str_concat(str_concat(" = call i32 @nz.spawn(ptr ", v(tids)),
            str_concat(str_concat(", ptr ", name), str_concat(str_concat(", ptr ", v(blk)), ")")))));
    unspawn(out, next, ntype, kids, kid_first, block, blk, k, argc, rc, current, live, rowns);
    let oom = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(oom)),
            str_concat(" = icmp eq i32 ", str_concat(v(rc), ", -1"))));
    guard(out, msgs, next, current, live, oom, "N0406", "out of memory", at, owned, otype, rowns);
    let nostart = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(nostart)),
            str_concat(" = icmp sgt i32 ", str_concat(v(rc), ", 0"))));
    guard(out, msgs, next, current, live, nostart, "N0404", "this task could not be started", at, owned, otype, rowns);
    0
}

// Give back what a spawn packed for a task that never started.
//
// Emitted between `@nz.spawn` returning non-zero and the guard that reports it: the one
// path where a program is already out of resources must not also be the path that leaks.
fn unspawn(out: Strs, next: Ints, ntype: Ints, kids: Ints, kid_first: Ints,
        block: Str, blk: Int, k: Int, argc: Int, rc: Int, current: Strs, live: Ints,
        rowns: Ints) -> Int {
    let started = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(started)),
            str_concat(" = icmp eq i32 ", str_concat(v(rc), ", 0"))));
    let clean = take_label(next);
    let after = take_label(next);
    add_line(out, str_concat(str_concat("  br i1 ", v(started)),
            str_concat(str_concat(", label %b", int_to_str(after)),
            str_concat(", label %b", int_to_str(clean)))));
    open_block(out, current, live, str_concat("b", int_to_str(clean)));
    let mut i = 0;
    while i < argc {
        let t = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + i));
        if owns_anything(t, rowns) {
            let slot = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(slot)),
                    str_concat(str_concat(str_concat(" = getelementptr ", block),
                    str_concat(", ptr ", v(blk))),
                    str_concat(", i64 0, i32 ", int_to_str(i + 3)))));
            let held = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(held)),
                    str_concat(str_concat(" = load ", llvm_type(t)),
                    str_concat(", ptr ", v(slot)))));
            emit_release(out, next, held, t, rowns);
        }
        i = i + 1;
    }
    add_line(out, str_concat(str_concat("  call void @free(ptr ", v(blk)), ")"));
    add_line(out, str_concat("  br label %b", int_to_str(after)));
    open_block(out, current, live, str_concat("b", int_to_str(after)));
    0
}

// The value a function hands back while a failure is travelling through it. Never read:
// every caller tests the failure flag before it looks at the result.
fn unwind_value(t: Int) -> Str {
    if t == t_int() { return "0"; }
    if t == t_bool() { return "false"; }
    if t == t_str() { return "zeroinitializer"; }
    // Also what a record slot holds before anything is stored in it: every owning field
    // null, so releasing it is a no-op. That is what makes a partly built record safe to
    // clean on a failure part way through a construction.
    if is_record(t) { return "zeroinitializer"; }
    "null"
}

fn take_number(next: Ints) -> Int {
    let n = ints_get(next, 0);
    ints_set(next, 0, n + 1);
    n
}

fn take_label(next: Ints) -> Int {
    let n = ints_get(next, 1);
    ints_set(next, 1, n + 1);
    n
}

// --- expressions ---------------------------------------------------------------------
//
// A post-order scan with a stack of SSA value numbers. Operands are already emitted when
// their operator is reached, which is what post-order means.

fn checked(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints,
        intrinsic: Str, noun: Str, a: Int, b: Int, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let r = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(r)),
            str_concat(str_concat(" = call {i64, i1} @llvm.", intrinsic),
            str_concat(".with.overflow.i64(i64 ",
            str_concat(v(a), str_concat(", i64 ", str_concat(v(b), ")")))))));
    let ov = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(ov)),
            str_concat(" = extractvalue {i64, i1} ", str_concat(v(r), ", 1"))));
    guard(out, msgs, next, current, live, ov, "N0400", str_concat(str_concat("this ", noun), " overflows `Int`"), at, owned, otype, rowns);
    let res = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(res)),
            str_concat(" = extractvalue {i64, i1} ", str_concat(v(r), ", 0"))));
    res
}

// `a == Int::MIN && b == -1` — the one operand pair `sdiv` and `srem` fault on.
fn min_over_minus_one(out: Strs, next: Ints, a: Int, b: Int) -> Int {
    let is_min = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(is_min)),
            str_concat(" = icmp eq i64 ", str_concat(v(a), ", -9223372036854775808"))));
    let is_m1 = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(is_m1)),
            str_concat(" = icmp eq i64 ", str_concat(v(b), ", -1"))));
    let both = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(both)),
            str_concat(" = and i1 ", str_concat(v(is_min), str_concat(", ", v(is_m1))))));
    both
}

fn divide(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, a: Int, b: Int, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let zero = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(zero)),
            str_concat(" = icmp eq i64 ", str_concat(v(b), ", 0"))));
    guard(out, msgs, next, current, live, zero, "N0401", "division by zero", at, owned, otype, rowns);
    let bad = min_over_minus_one(out, next, a, b);
    guard(out, msgs, next, current, live, bad, "N0400", "this division overflows `Int`", at, owned, otype, rowns);
    let res = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(res)),
            str_concat(" = sdiv i64 ", str_concat(v(a), str_concat(", ", v(b))))));
    res
}

// Remainder, whose *only* failure is a zero divisor. `Int::MIN % -1` is mathematically
// zero and zero is representable, so `docs/spec.md` specifies it as `0` — and the `srem`
// instruction faults on that pair anyway, because it computes the quotient. The pair is
// answered with a constant and never reaches the instruction.
fn remainder(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, a: Int, b: Int, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let zero = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(zero)),
            str_concat(" = icmp eq i64 ", str_concat(v(b), ", 0"))));
    guard(out, msgs, next, current, live, zero, "N0401", "division by zero", at, owned, otype, rowns);
    let special = min_over_minus_one(out, next, a, b);
    let is_zero = take_label(next);
    let compute = take_label(next);
    let after = take_label(next);
    add_line(out, str_concat(str_concat("  br i1 ", v(special)),
            str_concat(str_concat(", label %b", int_to_str(is_zero)),
            str_concat(", label %b", int_to_str(compute)))));
    add_line(out, str_concat(str_concat("b", int_to_str(compute)), ":"));
    let r = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(r)),
            str_concat(" = srem i64 ", str_concat(v(a), str_concat(", ", v(b))))));
    add_line(out, str_concat("  br label %b", int_to_str(after)));
    add_line(out, str_concat(str_concat("b", int_to_str(is_zero)), ":"));
    add_line(out, str_concat("  br label %b", int_to_str(after)));
    add_line(out, str_concat(str_concat("b", int_to_str(after)), ":"));
    let res = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(res)),
            str_concat(str_concat(" = phi i64 [ ", v(r)),
            str_concat(str_concat(", %b", int_to_str(compute)),
            str_concat(" ], [ 0, %b", str_concat(int_to_str(is_zero), " ]"))))));
    res
}

fn predicate(op: Str) -> Str {
    if op == "==" { return "eq"; }
    if op == "!=" { return "ne"; }
    // Signed on purpose: `Int` is signed 64-bit, so `-1 < 1` must hold, and `ult` would
    // compare the two's-complement bit patterns and make it false.
    if op == "<" { return "slt"; }
    if op == "<=" { return "sle"; }
    if op == ">" { return "sgt"; }
    if op == ">=" { return "sge"; }
    ""
}

// `==` and `!=` on two `Str`s: equal lengths, then equal bytes.
//
// The length test **guards** the comparison rather than merely preceding it, so `memcmp`
// is only reached when both strings really are that long and no path reads past either
// buffer. That is why this is a branch and a `phi` rather than an `and` of two computed
// values, which would have evaluated the `memcmp` first.
// --- pieces the built-ins share ------------------------------------------------------

// One field out of a record value already in a register.
// One record's retain or release helper.
//
// Written as a function of its own rather than inlined at each site: a record released in
// forty places emits forty calls instead of forty copies of its field walk, and a nested
// record's helper calls the inner record's — which puts the recursion in the emitted
// program, where there is a stack, rather than in this compiler, which has none.
//
// Numbering restarts per function, as it must, and the parameter is named so it does not
// consume the implicit counter.
// The node kinds records added, as one function: a declaration and its fields emit
// nothing, a construction builds a value, and a projection reads one out. Answers `1`
// when it handled the node, so the chain below it gains one level rather than four.
// Replace the field a place's path reaches, starting from a slot.
//
// A record is a value, not a handle, so there is nothing to write *through*: the record
// is read out of its slot, one field inside it is replaced, and the whole thing is stored
// back — rebuilding each level on the way out, because each level is a value too.
//
// The new value has already been produced, and is **taken** before the old one is
// released. That order is the whole of the correctness: `p.name = p.name` and a new value
// backed by the same allocation as the old are both safe because of it.
fn set_field(out: Strs, next: Ints, owned: Ints, value: Int, vt: Int, slot: Int,
        root_t: Int, place: Str, rowns: Ints,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints, otype: Ints) -> Int {
    own_keep(out, next, owned, value, vt, rowns, otype);
    let steps = path_length(place);
    // The aggregate at each level on the way in, so the way out can rebuild it.
    let levels = ints_new();
    let level_t = ints_new();
    let level_at = ints_new();
    let loaded = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(loaded)),
            str_concat(str_concat(" = load ", llvm_type(root_t)),
            str_concat(", ptr %slot", int_to_str(slot)))));
    let mut current_v = loaded;
    let mut current_t = root_t;
    let mut i = 0;
    while i < steps {
        let r = record_of(current_t);
        let decl = field_index(rfirst, rcount, rfname, r, path_step(place, i));
        let at = layout_index(rfirst, rcount, rfname, r, decl);
        ints_push(levels, current_v);
        ints_push(level_t, current_t);
        ints_push(level_at, at);
        current_v = record_field(out, next, current_v, current_t, at);
        current_t = ints_get(rftype, ints_get(rfirst, r) + decl);
        i = i + 1;
    }
    // `current_v` is the old field, released **after** the new value was taken.
    let old = current_v;
    let old_t = current_t;

    let mut built = value;
    let mut built_t = vt;
    let mut back = steps - 1;
    while back >= 0 {
        let agg = ints_get(levels, back);
        let agg_t = ints_get(level_t, back);
        let at = ints_get(level_at, back);
        let n = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(n)),
                str_concat(str_concat(str_concat(" = insertvalue ", llvm_type(agg_t)),
                str_concat(" ", v(agg))),
                str_concat(str_concat(str_concat(", ", llvm_type(built_t)),
                str_concat(" ", v(built))),
                str_concat(", ", int_to_str(at))))));
        built = n;
        built_t = agg_t;
        back = back - 1;
    }
    add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(built_t)),
            str_concat(" ", v(built))),
            str_concat(", ptr %slot", int_to_str(slot))));
    emit_release(out, next, old, old_t, rowns);
    0
}

fn emit_record_node(out: Strs, next: Ints, vals: Ints, owned: Ints,
        nk: Ints, nar: Ints, ntx: Strs, ntype: Ints, nrec: Ints, nslot: Ints,
        kids: Ints, kid_first: Ints, k: Int,
        rowns: Ints, rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints, otype: Ints,
        phi_val: Ints, phi_blk: Strs, nin: Ints,
        current: Strs, live: Ints, frame: Ints, ret_t: Int) -> Int {
    let kind = ints_get(nk, k);
    if kind == n_propagate() {
        return emit_propagate(out, next, current, live, vals, owned, otype, frame, rowns,
                ntype, nrec, nslot, kids, kid_first, k, ret_t, rfirst, rcount, rfname,
                rftype);
    }
    // A declaration is not code. Neither is a field of one, nor a variant of one.
    if kind == n_record() { return 1; }
    if kind == n_structfield() { return 1; }
    if kind == n_enum() { return 1; }
    if kind == n_variant() { return 1; }
    if kind == n_payload() { return 1; }
    // An arm's value is its body's, which is already on the stack. The bindings were
    // stored when the arm's block was opened, which is the only place they can be: the
    // body is a child and runs after.
    if kind == n_arm() { return 1; }

    if kind == n_match() {
        let et = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
        if ints_get(ntype, k) != 0 {
            // One incoming per arm that reached the join; an arm that left is not one.
            ints_push(vals, emit_phi(out, next, owned, otype, rowns, phi_val, phi_blk,
                    ints_get(nin, k), ints_get(ntype, k)));
        }
        // **After** the result is established: each arm retained whatever it handed to
        // the join before branching here, so a payload returned from an arm holds its own
        // reference by the time the value it came out of is let go.
        let mslot = ints_get(nslot, k);
        let dying = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(dying)),
                str_concat(str_concat(" = load ", llvm_type(et)),
                str_concat(", ptr %slot", int_to_str(mslot)))));
        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(et)),
                str_concat(" ", unwind_value(et))),
                str_concat(", ptr %slot", int_to_str(mslot))));
        emit_release(out, next, dying, et, rowns);
        return 1;
    }

    if kind == n_makevariant() {
        let t = ints_get(ntype, k);
        let e = record_of(t);
        let vr = ints_get(nrec, k);
        let tag = variant_tag(rfirst, rcount, rfname, rftype, e, vr);
        let ty = llvm_type(t);
        let vty = llvm_type(t_record(vr));
        let arity = ints_get(nar, k);
        let text = strs_get(ntx, k);
        let args = ints_new();
        let mut a = 0;
        while a < arity { ints_push(args, ints_pop(vals)); a = a + 1; }
        let slot = ints_get(nslot, k);
        if slot < 0 {
            // Nothing to clean, so the value is built in registers: the payload first,
            // then the discriminant and the payload into the enum.
            let mut built = str_concat(vty, " zeroinitializer");
            a = 0;
            while a < arity {
                let value = ints_get(args, arity - 1 - a);
                let decl = field_index(rfirst, rcount, rfname, vr, field_name_at(text, a));
                let at = layout_index(rfirst, rcount, rfname, vr, decl);
                let ft = ints_get(rftype, ints_get(rfirst, vr) + decl);
                let n = take_number(next);
                add_line(out, str_concat(str_concat("  ", v(n)),
                        str_concat(str_concat(" = insertvalue ", built),
                        str_concat(str_concat(str_concat(", ", llvm_type(ft)),
                        str_concat(" ", v(value))),
                        str_concat(", ", int_to_str(at))))));
                built = str_concat(str_concat(vty, " "), v(n));
                a = a + 1;
            }
            let tagged = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(tagged)),
                    str_concat(str_concat(" = insertvalue ", ty),
                    str_concat(" zeroinitializer, i64 ", str_concat(int_to_str(tag), ", 0")))));
            let whole = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(whole)),
                    str_concat(str_concat(str_concat(" = insertvalue ", ty),
                    str_concat(" ", v(tagged))),
                    str_concat(str_concat(", ", built),
                    str_concat(", ", int_to_str(tag + 1))))));
            ints_push(vals, whole);
            return 1;
        }
        // Zeroed — the slot is already zero on every path that reaches here, and this
        // store is what makes that a local fact — and then the **discriminant, before any
        // payload**. Cleanup after a failed initialiser finds the fields to release by
        // dispatching on the tag, so a tag
        // written last would send it looking at variant 0's fields while variant `tag`'s
        // were the ones already taken — and everything produced so far would leak on the
        // one path the program was already failing on.
        add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                str_concat(" ", unwind_value(t))),
                str_concat(", ptr %slot", int_to_str(slot))));
        let empty = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(empty)),
                str_concat(str_concat(" = load ", ty),
                str_concat(", ptr %slot", int_to_str(slot)))));
        let started = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(started)),
                str_concat(str_concat(str_concat(" = insertvalue ", ty),
                str_concat(" ", v(empty))),
                str_concat(", i64 ", str_concat(int_to_str(tag), ", 0")))));
        add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                str_concat(" ", v(started))),
                str_concat(", ptr %slot", int_to_str(slot))));
        a = 0;
        while a < arity {
            let value = ints_get(args, arity - 1 - a);
            let decl = field_index(rfirst, rcount, rfname, vr, field_name_at(text, a));
            let at = layout_index(rfirst, rcount, rfname, vr, decl);
            let ft = ints_get(rftype, ints_get(rfirst, vr) + decl);
            own_keep(out, next, owned, value, ft, rowns, otype);
            let held = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(held)),
                    str_concat(str_concat(" = load ", ty),
                    str_concat(", ptr %slot", int_to_str(slot)))));
            let payload = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(payload)),
                    str_concat(str_concat(" = extractvalue ", ty),
                    str_concat(str_concat(" ", v(held)),
                    str_concat(", ", int_to_str(tag + 1))))));
            let filled = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(filled)),
                    str_concat(str_concat(str_concat(" = insertvalue ", vty),
                    str_concat(" ", v(payload))),
                    str_concat(str_concat(str_concat(", ", llvm_type(ft)),
                    str_concat(" ", v(value))),
                    str_concat(", ", int_to_str(at))))));
            let made = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(made)),
                    str_concat(str_concat(str_concat(" = insertvalue ", ty),
                    str_concat(" ", v(held))),
                    str_concat(str_concat(str_concat(", ", vty),
                    str_concat(" ", v(filled))),
                    str_concat(", ", int_to_str(tag + 1))))));
            add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                    str_concat(" ", v(made))),
                    str_concat(", ptr %slot", int_to_str(slot))));
            a = a + 1;
        }
        let complete = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(complete)),
                str_concat(str_concat(" = load ", ty),
                str_concat(", ptr %slot", int_to_str(slot)))));
        add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                str_concat(" ", unwind_value(t))),
                str_concat(", ptr %slot", int_to_str(slot))));
        own_add(owned, otype, complete, t);
        ints_push(vals, complete);
        return 1;
    }

    if kind == n_construct() {
        let t = ints_get(ntype, k);
        let r = ints_get(nrec, k);
        let ty = llvm_type(t);
        let arity = ints_get(nar, k);
        let text = strs_get(ntx, k);
        // The initialisers are on the value stack in the order they were **written**,
        // which is the order their side effects happened in; each goes to the position
        // the layout gave it, which is unrelated. Keeping the two apart is why the node
        // carries both the names and the arity.
        let args = ints_new();
        let mut a = 0;
        while a < arity { ints_push(args, ints_pop(vals)); a = a + 1; }
        let slot = ints_get(nslot, k);
        if slot < 0 {
            // Nothing to clean, so the value is built in registers.
            let mut built = str_concat(ty, " undef");
            let mut last = 0;
            a = 0;
            while a < arity {
                let value = ints_get(args, arity - 1 - a);
                let decl = field_index(rfirst, rcount, rfname, r, field_name_at(text, a));
                let at = layout_index(rfirst, rcount, rfname, r, decl);
                let ft = ints_get(rftype, ints_get(rfirst, r) + decl);
                let n = take_number(next);
                add_line(out, str_concat(str_concat("  ", v(n)),
                        str_concat(str_concat(" = insertvalue ", built),
                        str_concat(str_concat(str_concat(", ", llvm_type(ft)),
                        str_concat(" ", v(value))),
                        str_concat(", ", int_to_str(at))))));
                built = str_concat(str_concat(ty, " "), v(n));
                last = n;
                a = a + 1;
            }
            ints_push(vals, last);
            return 1;
        }
        // Zeroed first: the slot is reused each time this expression is reached — in a
        // loop, for instance — and what a previous round left in it has been handed on.
        add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                str_concat(" ", unwind_value(t))),
                str_concat(", ptr %slot", int_to_str(slot))));
        a = 0;
        while a < arity {
            let value = ints_get(args, arity - 1 - a);
            let decl = field_index(rfirst, rcount, rfname, r, field_name_at(text, a));
            let at = layout_index(rfirst, rcount, rfname, r, decl);
            let ft = ints_get(rftype, ints_get(rfirst, r) + decl);
            // The initialiser's reference moves into the record, which the frame now
            // owns. Taking it here is what makes the cleanup on a later failure a
            // release rather than a double release.
            own_keep(out, next, owned, value, ft, rowns, otype);
            let held = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(held)),
                    str_concat(str_concat(" = load ", ty),
                    str_concat(", ptr %slot", int_to_str(slot)))));
            let made = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(made)),
                    str_concat(str_concat(str_concat(" = insertvalue ", ty),
                    str_concat(" ", v(held))),
                    str_concat(str_concat(str_concat(", ", llvm_type(ft)),
                    str_concat(" ", v(value))),
                    str_concat(", ", int_to_str(at))))));
            add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                    str_concat(" ", v(made))),
                    str_concat(", ptr %slot", int_to_str(slot))));
            a = a + 1;
        }
        // Complete. The value leaves with the references the slot was holding, and the
        // slot is zeroed so the frame does not release them a second time.
        let whole = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(whole)),
                str_concat(str_concat(" = load ", ty),
                str_concat(", ptr %slot", int_to_str(slot)))));
        add_line(out, str_concat(str_concat(str_concat("  store ", ty),
                str_concat(" ", unwind_value(t))),
                str_concat(", ptr %slot", int_to_str(slot))));
        own_add(owned, otype, whole, ints_get(ntype, k));
        ints_push(vals, whole);
        return 1;
    }

    if kind == n_fieldread() {
        let base = ints_pop(vals);
        let bt = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
        let t = ints_get(ntype, k);
        let r = record_of(bt);
        let at = layout_index(rfirst, rcount, rfname, r, ints_get(nrec, k));
        // **Whether the base was owned decides whether the field must be.** A projection
        // out of a borrowed record is borrowed too: the record is in a slot and nothing in
        // this expression can change it — assignment is a statement — so the slot keeps
        // the field's storage alive. A projection out of an owned temporary must take a
        // reference **before** the temporary is dropped, which is what makes
        // `make().name` valid; the order of these three steps is the whole of it.
        let from_temporary = own_has(owned, base);
        let got = record_field(out, next, base, bt, at);
        if from_temporary {
            if owns_anything(t, rowns) {
                emit_retain(out, next, got, t, rowns);
                own_add(owned, otype, got, t);
            }
        }
        own_drop(out, next, owned, base, bt, rowns, otype);
        ints_push(vals, got);
        return 1;
    }
    0
}

// `operand?`, N12: the `match` it means, emitted where the node is reached.
//
//     match operand {
//         Result.Ok(value: v)  => v,
//         Result.Err(error: e) => return <the function's Result>.Err(error: e),
//     }
//
// The operand is taken over into the node's hidden slot, which the frame releases — so a
// failure anywhere below gives it back, as it gives back a `match`'s scrutinee. Then one
// test of the discriminant:
//
// * **the error path** takes its own reference to the error value, builds the function's
//   `Result` around it, and leaves by exactly the sequence a `return` uses: every open
//   scope joined, the value taken over, every outstanding temporary and then the frame
//   released — the operand's slot among them — and `ret`. The error value survives because
//   it was retained before anything it came out of was let go;
// * **the success path** takes its own reference to the payload, releases the operand now
//   rather than at the end of the function, and carries on with the payload as a
//   temporary this expression owns.
//
// Which variant is the success is the checker's answer, on the node; which enum the
// function returns is the function's declared type. Nothing here asks what a type is
// called.
fn emit_propagate(out: Strs, next: Ints, current: Strs, live: Ints, vals: Ints,
        owned: Ints, otype: Ints, frame: Ints, rowns: Ints,
        ntype: Ints, nrec: Ints, nslot: Ints, kids: Ints, kid_first: Ints, k: Int,
        ret_t: Int, rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints) -> Int {
    let et = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
    let e = record_of(et);
    let ok_vr = ints_get(nrec, k);
    // A `Result` has two variants, so the error is the one that is not the success.
    let v0 = record_of(ints_get(rftype, ints_get(rfirst, e)));
    let v1 = record_of(ints_get(rftype, ints_get(rfirst, e) + 1));
    let mut err_vr = v0;
    if v0 == ok_vr { err_vr = v1; }
    // The same variant of the function's own `Result`: at the same distance from its enum.
    let into = record_of(ret_t);
    let into_vr = into + (err_vr - e);
    let ok_tag = variant_tag(rfirst, rcount, rfname, rftype, e, ok_vr);
    let err_tag = variant_tag(rfirst, rcount, rfname, rftype, e, err_vr);
    let into_tag = variant_tag(rfirst, rcount, rfname, rftype, into, into_vr);
    let ety = llvm_type(et);
    let slot = ints_get(nslot, k);

    let sv = ints_pop(vals);
    own_keep(out, next, owned, sv, et, rowns, otype);
    add_line(out, str_concat(str_concat(str_concat("  store ", ety), str_concat(" ", v(sv))),
            str_concat(", ptr %slot", int_to_str(slot))));
    let tag = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(tag)),
            str_concat(str_concat(" = extractvalue ", ety), str_concat(" ", str_concat(v(sv), ", 0")))));
    let is_ok = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(is_ok)),
            str_concat(str_concat(" = icmp eq i64 ", v(tag)), str_concat(", ", int_to_str(ok_tag)))));
    add_line(out, str_concat(str_concat("  br i1 ", v(is_ok)),
            str_concat(str_concat(", label %", blk("q", k)), str_concat(", label %", blk("r", k)))));

    // The error leaves.
    open_block(out, current, live, blk("r", k));
    let err_t = ints_get(rftype, ints_get(rfirst, err_vr));
    let error = payload_field(out, next, sv, et, err_vr, err_tag, rfirst, rcount, rfname);
    emit_retain(out, next, error, err_t, rowns);
    let vty = llvm_type(t_record(into_vr));
    let filled = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(filled)),
            str_concat(str_concat(str_concat(" = insertvalue ", vty), " zeroinitializer"),
            str_concat(str_concat(str_concat(", ", llvm_type(err_t)), str_concat(" ", v(error))),
            str_concat(", ", int_to_str(layout_index(rfirst, rcount, rfname, into_vr, 0)))))));
    let rty = llvm_type(ret_t);
    let tagged = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(tagged)),
            str_concat(str_concat(" = insertvalue ", rty),
            str_concat(" zeroinitializer, i64 ", str_concat(int_to_str(into_tag), ", 0")))));
    let returned = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(returned)),
            str_concat(str_concat(str_concat(" = insertvalue ", rty), str_concat(" ", v(tagged))),
            str_concat(str_concat(str_concat(", ", vty), str_concat(" ", v(filled))),
            str_concat(", ", int_to_str(into_tag + 1))))));
    // A `return` from here: `n_return`'s sequence, step for step.
    join_from(out, next, current, live, 2);
    release_temporaries(out, next, owned, otype, rowns);
    release_frame(out, next, frame, rowns);
    add_line(out, str_concat(str_concat("  ret ", rty), str_concat(" ", v(returned))));

    // The success carries on.
    open_block(out, current, live, blk("q", k));
    let ok_t = ints_get(rftype, ints_get(rfirst, ok_vr));
    let value = payload_field(out, next, sv, et, ok_vr, ok_tag, rfirst, rcount, rfname);
    if owns_anything(ok_t, rowns) {
        emit_retain(out, next, value, ok_t, rowns);
        own_add(owned, otype, value, ok_t);
    }
    let dying = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(dying)),
            str_concat(str_concat(" = load ", ety), str_concat(", ptr %slot", int_to_str(slot)))));
    add_line(out, str_concat(str_concat(str_concat("  store ", ety), str_concat(" ", unwind_value(et))),
            str_concat(", ptr %slot", int_to_str(slot))));
    emit_release(out, next, dying, et, rowns);
    ints_push(vals, value);
    1
}

// The declared result of the function being emitted, or `Int` outside every function —
// where no `?` can be, but a declaration is still walked.
fn current_return(nrec: Ints, cur_fn: Ints) -> Int {
    let f = ints_get(cur_fn, 0);
    if f < 0 { return t_int(); }
    ints_get(nrec, f)
}

// The one payload field of variant `vr` — declared first — out of enum value `value`.
fn payload_field(out: Strs, next: Ints, value: Int, et: Int, vr: Int, tag: Int,
        rfirst: Ints, rcount: Ints, rfname: Strs) -> Int {
    let payload = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(payload)),
            str_concat(str_concat(" = extractvalue ", llvm_type(et)),
            str_concat(str_concat(" ", v(value)), str_concat(", ", int_to_str(tag + 1))))));
    record_field(out, next, payload, t_record(vr), layout_index(rfirst, rcount, rfname, vr, 0))
}

fn record_helper(out: Strs, next: Ints, r: Int, retain: Bool, rowns: Ints,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints) -> Int {
    ints_set(next, 0, 0);
    ints_set(next, 1, 0);
    let ty = llvm_type(t_record(r));
    let mut name = str_concat("@nz.rl", int_to_str(r));
    if retain { name = str_concat("@nz.rt", int_to_str(r)); }
    if ints_get(rowns, r) == 2 {
        return enum_helper(out, next, r, retain, rowns, rfirst, rcount, rfname, rftype,
                ty, name);
    }
    add_line(out, "");
    add_line(out, str_concat(str_concat("define internal void ", name),
            str_concat(str_concat("(", ty), " %r) {")));
    add_line(out, "entry:");
    // Layout order, which is deterministic and which no program can observe:
    // `docs/spec.md` says a record is destroyed by releasing each field and deliberately
    // does not say in which order.
    let mut pos = 0;
    while pos < ints_get(rcount, r) {
        let decl = layout_field(rfirst, rcount, rfname, r, pos);
        let ft = ints_get(rftype, ints_get(rfirst, r) + decl);
        if owns_anything(ft, rowns) {
            let n = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(n)),
                    str_concat(str_concat(" = extractvalue ", ty),
                    str_concat(" %r, ", int_to_str(pos)))));
            if retain {
                emit_retain(out, next, n, ft, rowns);
            } else {
                emit_release(out, next, n, ft, rowns);
            }
        }
        pos = pos + 1;
    }
    add_line(out, "  ret void");
    add_line(out, "}");
    0
}

// An enum's retain or release helper: a `switch` on the discriminant, then one variant's
// fields.
//
// A record's helper is a fixed sequence of retains; an enum's is *a branch and then* a
// fixed sequence, and which sequence is not known where the copy is written. A variant
// whose payload owns nothing is left out of the table and reaches the exit through the
// switch's default, so a zero-payload arm costs nothing at all.
fn enum_helper(out: Strs, next: Ints, r: Int, retain: Bool, rowns: Ints,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints,
        ty: Str, name: Str) -> Int {
    add_line(out, "");
    add_line(out, str_concat(str_concat("define internal void ", name),
            str_concat(str_concat("(", ty), " %e) {")));
    add_line(out, "entry:");
    let tag = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(tag)),
            str_concat(str_concat(" = extractvalue ", ty), " %e, 0")));
    // The table first, because the `switch` is written before the blocks it names.
    let tags = ints_new();
    let mut pos = 0;
    while pos < ints_get(rcount, r) {
        let decl = layout_field(rfirst, rcount, rfname, r, pos);
        let vt = ints_get(rftype, ints_get(rfirst, r) + decl);
        if owns_anything(vt, rowns) { ints_push(tags, pos); }
        pos = pos + 1;
    }
    let done = str_concat("b", int_to_str(take_label(next)));
    let labels = strs_new();
    let mut t = 0;
    while t < ints_len(tags) {
        strs_push(labels, str_concat("b", int_to_str(take_label(next))));
        t = t + 1;
    }
    let mut table = "";
    let mut u = 0;
    while u < ints_len(tags) {
        table = str_concat(str_concat(table, "i64 "),
                str_concat(str_concat(int_to_str(ints_get(tags, u)), ", label %"),
                str_concat(strs_get(labels, u), " ")));
        u = u + 1;
    }
    // The default is the exit. A discriminant this enum does not have cannot arise in a
    // safe program, and "nothing to release" is the answer that stays correct if one does.
    add_line(out, str_concat(str_concat("  switch i64 ", v(tag)),
            str_concat(str_concat(", label %", done), str_concat(" [ ", str_concat(table, "]")))));
    let mut w = 0;
    while w < ints_len(tags) {
        let at = ints_get(tags, w);
        add_line(out, str_concat(strs_get(labels, w), ":"));
        let decl = layout_field(rfirst, rcount, rfname, r, at);
        let vt = ints_get(rftype, ints_get(rfirst, r) + decl);
        let payload = take_number(next);
        // The variant's payload is one field of the enum, at its tag plus one: the
        // discriminant occupies index 0.
        add_line(out, str_concat(str_concat("  ", v(payload)),
                str_concat(str_concat(" = extractvalue ", ty),
                str_concat(" %e, ", int_to_str(at + 1)))));
        // A variant's payload is record-shaped, so the walk over its fields is the one
        // `record_helper` already generates. One call, and the recursion lives in the
        // emitted program — which is the only place this compiler can put any.
        if retain {
            emit_retain(out, next, payload, vt, rowns);
        } else {
            emit_release(out, next, payload, vt, rowns);
        }
        add_line(out, str_concat(str_concat("  br label %", done), ""));
        w = w + 1;
    }
    add_line(out, str_concat(done, ":"));
    add_line(out, "  ret void");
    add_line(out, "}");
    0
}

// One arm's payload bindings, stored into the slots the checker numbered.
//
// Emitted where the arm's block is opened, which is the only place they can go: the body
// is the arm's child and runs after. A binding takes its **own** reference, exactly as a
// `let` does — the slot is written again on the next turn of a loop, and taking before
// releasing the old value is what makes that safe.
fn arm_bindings(out: Strs, next: Ints, ntx: Strs, nslot: Ints, nrec: Ints,
        arm: Int, mslot: Int, et: Int, owned: Ints, otype: Ints, rowns: Ints,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints) -> Int {
    let vr = ints_get(nrec, arm);
    if vr < 0 { return 0; }
    let base = ints_get(nslot, arm);
    if base < 0 { return 0; }
    let ety = llvm_type(et);
    let vty = llvm_type(t_record(vr));
    let tag = variant_tag(rfirst, rcount, rfname, rftype, record_of(et), vr);
    let text = strs_get(ntx, arm);
    let held = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(held)),
            str_concat(str_concat(" = load ", ety),
            str_concat(", ptr %slot", int_to_str(mslot)))));
    let payload = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(payload)),
            str_concat(str_concat(" = extractvalue ", ety),
            str_concat(str_concat(" ", v(held)),
            str_concat(", ", int_to_str(tag + 1))))));
    let mut n = 0;
    while true {
        let item = field_name_at(text, n);
        if item == "" { break; }
        let binding = after_colon(item);
        // `_` names nothing, so nothing is stored — and the field is still the enum's,
        // still in the value this `match` holds, and still released with it.
        if binding != "_" {
            let decl = field_index(rfirst, rcount, rfname, vr, before_colon(item));
            if decl >= 0 {
                let at = layout_index(rfirst, rcount, rfname, vr, decl);
                let ft = ints_get(rftype, ints_get(rfirst, vr) + decl);
                let got = take_number(next);
                add_line(out, str_concat(str_concat("  ", v(got)),
                        str_concat(str_concat(" = extractvalue ", vty),
                        str_concat(str_concat(" ", v(payload)),
                        str_concat(", ", int_to_str(at))))));
                store_binding(out, next, owned, got, ft, base + decl, rowns, otype);
            }
        }
        n = n + 1;
    }
    0
}

// The discriminant of variant entry `vr` within enum entry `e`.
//
// **The layout boundary**, the enum's half: the position in canonical variant-name order
// is the tag, and nothing above this function knows one. Found by looking for the field of
// the enum whose type is that variant, because an enum's fields *are* its variants.
fn variant_tag(rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints, e: Int, vr: Int) -> Int {
    let mut decl = 0;
    while decl < ints_get(rcount, e) {
        if ints_get(rftype, ints_get(rfirst, e) + decl) == t_record(vr) {
            return layout_index(rfirst, rcount, rfname, e, decl);
        }
        decl = decl + 1;
    }
    0
}

fn record_field(out: Strs, next: Ints, value: Int, rt: Int, at: Int) -> Int {
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(str_concat(" = extractvalue ", llvm_type(rt)),
            str_concat(str_concat(" ", v(value)),
            str_concat(", ", int_to_str(at))))));
    n
}

// Where a field sits in the LLVM struct.
//
// **Canonical, by field name.** `docs/spec.md` makes declaration order non-semantic, so
// laying fields out in name order makes that true of the object file as well: moving two
// field declarations — an edit the language says means nothing — changes no byte here.
// This is the layout boundary; nothing above it knows a position.
fn layout_index(rfirst: Ints, rcount: Ints, rfname: Strs, r: Int, at: Int) -> Int {
    let mine = strs_get(rfname, ints_get(rfirst, r) + at);
    let mut before = 0;
    let mut i = 0;
    while i < ints_get(rcount, r) {
        if str_before(strs_get(rfname, ints_get(rfirst, r) + i), mine) {
            before = before + 1;
        }
        i = i + 1;
    }
    before
}

// Byte-lexicographic order, written out because the language has no `<` on `Str` — it
// would need a collation decision `docs/spec.md` has not made. Field names are
// identifiers, so bytes are the whole of it, and this is the same order the reference
// compiler sorts by.
fn str_before(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) {
        if i >= str_len(b) { return false; }
        let x = str_byte(a, i);
        let y = str_byte(b, i);
        if x < y { return true; }
        if x > y { return false; }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

// The declaration index of the field that sits at layout position `pos`.
fn layout_field(rfirst: Ints, rcount: Ints, rfname: Strs, r: Int, pos: Int) -> Int {
    let mut i = 0;
    while i < ints_get(rcount, r) {
        if layout_index(rfirst, rcount, rfname, r, i) == pos { return i; }
        i = i + 1;
    }
    0
}

fn field(out: Strs, next: Ints, s: Int, index: Str) -> Int {
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(" = extractvalue { ptr, i64, ptr } ",
            str_concat(v(s), str_concat(", ", index)))));
    n
}

// `owner` is LLVM operand text, not a value number: `null` where nothing owns the bytes,
// `%n` where something does. Immortal and external storage then need no tag of their own.
fn make_str(out: Strs, next: Ints, ptr: Int, len: Int, owner: Str) -> Int {
    // `undef` is the standard way to build an aggregate, and **all three** fields are
    // written before it is read — not the poison-producing shortcut the architecture
    // rules mean.
    let a = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(a)),
            str_concat(" = insertvalue { ptr, i64, ptr } undef, ptr ",
            str_concat(v(ptr), ", 0"))));
    let b = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(b)),
            str_concat(str_concat(" = insertvalue { ptr, i64, ptr } ", v(a)),
            str_concat(", i64 ", str_concat(v(len), ", 1")))));
    let whole = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(whole)),
            str_concat(str_concat(" = insertvalue { ptr, i64, ptr } ", v(b)),
            str_concat(", ptr ", str_concat(owner, ", 2")))));
    whole
}

// --- ownership ------------------------------------------------------------------------
//
// The same five rules `docs/spec.md` states and `crates/nazm-lir/src/emit.rs` implements,
// implemented again here because the compiler written in Nazm has to emit the same memory
// semantics as the one written in Rust. Not *similar* semantics: the differential tests
// run the same program through both and compare allocation counts.
//
// `owned` is the set of SSA value numbers holding a reference nobody has taken over yet.
// A small `Ints` used as a set: entries arrive when an expression creates a reference and
// leave the moment something consumes one, so it holds a handful at a time and a linear
// scan is the right shape.

// What a value of this type owns, and therefore what has to happen when something takes
// one on or lets one go.
//
// **The first enum in this compiler's own source**, and it is here because the language
// could not say what the code meant. This was a small integer: `0` nothing, `1` an `Ints`,
// `3` a string backing, `5` a record. Every caller compared it against a number, the two
// cases that carry an index recomputed it from `t` at each site, and a code the function
// never returns was indistinguishable from one it does. N10 added a seventh and every one
// of those comparisons had to be found by hand.
//
// As an enum, the dispatch is exhaustive — adding a kind stops the retain and release
// paths compiling until both have answered — and the index a record or an enum needs is
// **in the value that says it needs one**, so the two cannot disagree.
enum Owning {
    Nothing,
    Sequence,
    Strings,
    Backing,
    Channel,
    Record(at: Int),
    Enum(at: Int),
    // A `Vec` whose elements own something: released by its own helper, which releases
    // each element by `T`'s law before the storage. A `Vec` of `Int` owns only its storage
    // and is a `Sequence`, exactly as an `Ints` is.
    Vector(at: Int),
}

fn owns(t: Int, rowns: Ints) -> Owning {
    if t == t_ints() { return Owning.Sequence(); }
    if t == t_strs() { return Owning.Strings(); }
    if t == t_str() { return Owning.Backing(); }
    if t == t_chan() { return Owning.Channel(); }
    if is_vec(t) {
        if entry_of(t) < ints_len(rowns) {
            if ints_get(rowns, entry_of(t)) == 3 { return Owning.Vector(at: entry_of(t)); }
        }
        return Owning.Sequence();
    }
    if is_record(t) {
        if record_of(t) < ints_len(rowns) {
            // A record owns every field; an enum owns the **active** variant's, which is a
            // runtime question and therefore a branch in the generated helper. `rowns`
            // says which, computed once after the fields are known.
            if ints_get(rowns, record_of(t)) == 1 { return Owning.Record(at: record_of(t)); }
            if ints_get(rowns, record_of(t)) == 2 { return Owning.Enum(at: record_of(t)); }
        }
        return Owning.Nothing();
    }
    Owning.Nothing()
}

// Whether a value of this type owns anything at all — the question most sites ask, and the
// one an exhaustive `match` answers once rather than at each of them.
fn owns_anything(t: Int, rowns: Ints) -> Bool {
    match owns(t, rowns) {
        Owning.Nothing() => false,
        Owning.Sequence() => true,
        Owning.Strings() => true,
        Owning.Backing() => true,
        Owning.Channel() => true,
        Owning.Record(at: _) => true,
        Owning.Enum(at: _) => true,
        Owning.Vector(at: _) => true,
    }
}

// Remove `n` from the set, answering whether it was there.
//
// `otype` is each entry's type, kept in lockstep: a release needs one, and the place that
// needs it has only the number.
fn own_take(owned: Ints, otype: Ints, n: Int) -> Int {
    let mut i = 0;
    while i < ints_len(owned) {
        if ints_get(owned, i) == n {
            // Order does not matter in a set, so the last entry fills the hole. Both
            // arrays move together, or the types stop describing the values.
            ints_set(owned, i, ints_get(owned, ints_len(owned) - 1));
            ints_set(otype, i, ints_get(otype, ints_len(otype) - 1));
            ints_pop(owned);
            ints_pop(otype);
            return 1;
        }
        i = i + 1;
    }
    0
}

// Whether the set holds `n`, without removing it.
fn own_has(owned: Ints, n: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(owned) {
        if ints_get(owned, i) == n { return true; }
        i = i + 1;
    }
    false
}

fn own_add(owned: Ints, otype: Ints, n: Int, t: Int) -> Int {
    ints_push(owned, n);
    ints_push(otype, t);
    0
}

// Release every reference this expression is still holding, on a path that is leaving.
//
// The shared unwind block releases the frame's **slots**, which is right for everything a
// binding holds and says nothing about a value still in a register.
// `str_concat(str_concat(a, b), int_to_str(1 / z))` has the inner result in hand when the
// division fails, and it is nobody's: the call that would have consumed it is on a path
// control never takes. Written at each failure site rather than in the one block they all
// reach, because which temporaries are outstanding is a property of the program point.
fn release_temporaries(out: Strs, next: Ints, owned: Ints, otype: Ints, rowns: Ints) -> Int {
    release_temporaries_from(out, next, owned, otype, rowns, 0)
}

// The same, for the temporaries produced from `from` onwards.
//
// A failure leaves the function, so it releases everything. A `break` or a `continue`
// leaves one loop and must not touch what an expression **around** that loop is still
// holding: releasing that would be a premature free rather than a leak.
fn release_temporaries_from(out: Strs, next: Ints, owned: Ints, otype: Ints, rowns: Ints,
        from: Int) -> Int {
    let mut i = from;
    while i < ints_len(owned) {
        emit_release(out, next, ints_get(owned, i), ints_get(otype, i), rowns);
        i = i + 1;
    }
    0
}

// Everything a `break` or a `continue` abandons: the temporaries this loop's body
// produced, and the values the `match`es opened inside it are holding.
fn leave_loop(out: Strs, next: Ints, owned: Ints, otype: Ints, rowns: Ints, mslots: Ints,
        mstyp: Ints, loop_own: Ints, loop_m: Ints) -> Int {
    if ints_len(loop_own) == 0 {
        return 0;
    }
    release_temporaries_from(out, next, owned, otype, rowns,
            ints_get(loop_own, ints_len(loop_own) - 1));
    release_matched(out, next, mslots, mstyp, rowns,
            ints_get(loop_m, ints_len(loop_m) - 1))
}

// Give back every value a `match` is holding from `from` inwards, on a path that stays in
// the frame.
//
// The slot is the frame's, so a failure and a `return` release it by the ordinary path. A
// `break` or a `continue` takes neither: it carries on in this frame, and the next turn of
// the loop stores over the slot. Zeroed once released, so the frame's own cleanup finds
// null and does nothing.
fn release_matched(out: Strs, next: Ints, mslots: Ints, mstyp: Ints, rowns: Ints,
        from: Int) -> Int {
    let mut i = ints_len(mslots);
    while i > from {
        i = i - 1;
        let t = ints_get(mstyp, i);
        let dying = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(dying)),
                str_concat(str_concat(" = load ", llvm_type(t)),
                str_concat(", ptr %slot", int_to_str(ints_get(mslots, i))))));
        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(t)),
                str_concat(" ", unwind_value(t))),
                str_concat(", ptr %slot", int_to_str(ints_get(mslots, i)))));
        emit_release(out, next, dying, t, rowns);
    }
    0
}

// One `call void` line to a runtime function, which is the shape every retain and release
// takes. `head` is the callee and the open bracket; `arg` is the operand.
fn runtime_call(out: Strs, head: Str, arg: Str) -> Int {
    add_line(out, str_concat(str_concat("  call void ", head), str_concat(arg, ")")));
    0
}

// A generated helper, named by its definition's index and taking the whole value. One per
// record and per enum per direction, so the walk — and, for an enum, the branch on the
// discriminant — lives in the emitted program rather than in this compiler, which has no
// recursion to walk with.
fn helper_call(out: Strs, prefix: Str, r: Int, t: Int, value: Int) -> Int {
    add_line(out, str_concat(str_concat(str_concat("  call void ", prefix),
            str_concat(int_to_str(r), str_concat("(", llvm_type(t)))),
            str_concat(str_concat(" ", v(value)), ")")));
    0
}

// A string's backing is named by the value's third field, which may be null — a literal
// and a process argument own nothing, and acting on null is what says so.
fn backing_call(out: Strs, next: Ints, head: Str, value: Int) -> Int {
    let owner = field(out, next, value, "2");
    runtime_call(out, head, v(owner))
}

// Add a reference to whatever this value owns.
fn emit_retain(out: Strs, next: Ints, value: Int, t: Int, rowns: Ints) -> Int {
    match owns(t, rowns) {
        Owning.Nothing() => 0,
        Owning.Sequence() => runtime_call(out, "@nz.arr_retain(ptr ", v(value)),
        Owning.Strings() => runtime_call(out, "@nz.arr_retain(ptr ", v(value)),
        Owning.Backing() => backing_call(out, next, "@nz.str_retain(ptr ", value),
        Owning.Channel() => runtime_call(out, "@nz.chan_retain(ptr ", v(value)),
        Owning.Record(at: r) => helper_call(out, "@nz.rt", r, t, value),
        Owning.Enum(at: r) => helper_call(out, "@nz.rt", r, t, value),
        // A handle: another reference to the same storage, as for any sequence.
        Owning.Vector(at: _) => runtime_call(out, "@nz.arr_retain(ptr ", v(value)),
    }
}

// Drop a reference. The storage goes when the last one does.
//
// A `Strs` releases every element's backing before its own storage, which is why it cannot
// share the runtime function an `Ints` uses — the one asymmetry between this and the
// retain above.
fn emit_release(out: Strs, next: Ints, value: Int, t: Int, rowns: Ints) -> Int {
    match owns(t, rowns) {
        Owning.Nothing() => 0,
        Owning.Sequence() => runtime_call(out, "@nz.seq_release(ptr ", v(value)),
        Owning.Strings() => runtime_call(out, "@nz.strs_release(ptr ", v(value)),
        Owning.Backing() => backing_call(out, next, "@nz.str_release(ptr ", value),
        Owning.Channel() => runtime_call(out, "@nz.chan_release(ptr ", v(value)),
        Owning.Record(at: r) => helper_call(out, "@nz.rl", r, t, value),
        Owning.Enum(at: r) => helper_call(out, "@nz.rl", r, t, value),
        Owning.Vector(at: r) => runtime_call(out,
                str_concat(str_concat("@nz.vr", int_to_str(r)), "(ptr "), v(value)),
    }
}

// Make `value` a reference this code owns, retaining it if it was only borrowed.
//
// Called where something takes a reference over: a binding, a `return`, a sequence that
// keeps what it is given. A value that was already owned is handed on unchanged, which is
// what keeps `let xs = ints_new();` free of traffic.
fn own_keep(out: Strs, next: Ints, owned: Ints, value: Int, t: Int, rowns: Ints, otype: Ints) -> Int {
    if owns_anything(t, rowns) == false { return 0; }
    if own_take(owned, otype, value) == 1 { return 0; }
    emit_retain(out, next, value, t, rowns)
}

// Release a reference nothing took over: a temporary a callee only borrowed, or a
// statement whose value was discarded. Both are ordinary; neither is an error.
fn own_drop(out: Strs, next: Ints, owned: Ints, value: Int, t: Int, rowns: Ints, otype: Ints) -> Int {
    if owns_anything(t, rowns) == false { return 0; }
    if own_take(owned, otype, value) == 0 { return 0; }
    emit_release(out, next, value, t, rowns)
}

// Release everything this frame is still holding.
//
// Emitted before **every** way out of a function — the tail value, each `return`, and the
// shared unwind block a failure takes — because `docs/spec.md` reclaims on the semantic
// event, and "the closing brace" is not one of them. `frame` holds one type per slot,
// `t_int()` where the slot needs nothing; parameter slots are `t_int()` for that reason,
// which *is* rule 2. A slot never written holds a zeroed value, and releasing a null owner
// is a no-op, so a path that skipped a declaration costs one comparison.
fn release_frame(out: Strs, next: Ints, frame: Ints, rowns: Ints) -> Int {
    let mut i = 0;
    while i < ints_len(frame) {
        let t = ints_get(frame, i);
        if owns_anything(t, rowns) {
            let n = take_number(next);
            add_line(out, str_concat(str_concat("  ", v(n)),
                    str_concat(str_concat(" = load ", llvm_type(t)),
                    str_concat(", ptr %slot", int_to_str(i)))));
            emit_release(out, next, n, t, rowns);
        }
        i = i + 1;
    }
    0
}

// A string backing of `bytes` usable bytes. Answers the allocation; its first byte of text
// is sixteen bytes further on, which `string_data` produces.
fn string_backing(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints,
        bytes: Int, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let own = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(own)),
            str_concat(" = call ptr @nz.str_alloc(i64 ", str_concat(v(bytes), ")"))));
    let null = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(null)),
            str_concat(" = icmp eq ptr ", str_concat(v(own), ", null"))));
    guard(out, msgs, next, current, live, null, "N0406", "out of memory", at, owned, otype, rowns);
    own
}

fn string_data(out: Strs, next: Ints, own: Int) -> Int {
    binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(own)), "i64 16")
}

// Store into a binding's slot, taking the new reference and letting go of the old.
//
// The order is the whole of the correctness: the new reference is taken **first**, so that
// `a = a` — and the re-execution of a `let` in a loop with the same value — cannot drop the
// count to zero between the two steps and free storage that is about to be stored again.
fn store_binding(out: Strs, next: Ints, owned: Ints, value: Int, vt: Int, slot: Int, rowns: Ints, otype: Ints) -> Int {
    if owns_anything(vt, rowns) == false {
        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(vt)),
                str_concat(" ", v(value))),
                str_concat(", ptr %slot", int_to_str(slot))));
        return 0;
    }
    own_keep(out, next, owned, value, vt, rowns, otype);
    let old = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(old)),
            str_concat(str_concat(" = load ", llvm_type(vt)),
            str_concat(", ptr %slot", int_to_str(slot)))));
    add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(vt)),
            str_concat(" ", v(value))),
            str_concat(", ptr %slot", int_to_str(slot))));
    emit_release(out, next, old, vt, rowns);
    0
}

// Release every argument of a call that nothing took over.
fn drop_arguments(out: Strs, next: Ints, owned: Ints, ordered: Ints, ntype: Ints,
        kids: Ints, kid_first: Ints, k: Int, argc: Int, rowns: Ints, otype: Ints) -> Int {
    let mut d = 0;
    while d < argc {
        own_drop(out, next, owned, ints_get(ordered, d),
                ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + d)), rowns, otype);
        d = d + 1;
    }
    0
}

fn require(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints,
        bad: Int, message: Str, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    guard(out, msgs, next, current, live, bad, "N0405", message, at, owned, otype, rowns)
}

fn allocate(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, bytes: Int, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let buf = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(buf)),
            str_concat(" = call ptr @malloc(i64 ", str_concat(v(bytes), ")"))));
    let null = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(null)),
            str_concat(" = icmp eq ptr ", str_concat(v(buf), ", null"))));
    guard(out, msgs, next, current, live, null, "N0406", "out of memory", at, owned, otype, rowns);
    buf
}

fn constant(out: Strs, next: Ints, value: Str) -> Int {
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)), str_concat(" = add i64 ", str_concat(value, ", 0"))));
    n
}

// One instruction of the form `%n = OP TY A[, B]`.
//
// A single writer for the shapes the built-ins need, because assembling these by hand at
// twenty call sites is how a stray comma reaches clang.
fn binop(out: Strs, next: Ints, op: Str, ty: Str, a: Str, b: Str) -> Int {
    let n = take_number(next);
    let rest = if str_len(b) == 0 { a } else { str_concat(a, str_concat(", ", b)) };
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(str_concat(str_concat(" = ", op), str_concat(" ", ty)),
            str_concat(" ", rest))));
    n
}

// A pointer to element `i` of a sequence, bounds-checked.
//
// The check is here rather than inside a shared helper because the diagnostic has to
// name *this* call's source position, and a helper has only one.
// `%n = OP FROM %x to TO`. A cast is not a binary operation and writing it as one loses
// the `to`, which clang rejects with a message about the cast value rather than about
// the missing word.
fn cast(out: Strs, next: Ints, op: Str, from: Str, value: Int, to: Str) -> Int {
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(str_concat(str_concat(" = ", op), str_concat(" ", from)),
            str_concat(str_concat(" ", v(value)), str_concat(" to ", to)))));
    n
}

fn seq_slot(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, handle: Int, index: Int, elem: Str, at: Str,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let len = binop(out, next, "load", "i64,", str_concat("ptr ", v(handle)), "");
    let neg = binop(out, next, "icmp slt", "i64", v(index), "0");
    let past = binop(out, next, "icmp sge", "i64", v(index), v(len));
    let bad = binop(out, next, "or", "i1", v(neg), v(past));
    require(out, msgs, next, current, live, bad, "this index is outside the sequence", at, owned, otype, rowns);
    let df = binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(handle)), "i64 16");
    let data = binop(out, next, "load", "ptr,", str_concat("ptr ", v(df)), "");
    binop(out, next, "getelementptr", str_concat(elem, ","), str_concat("ptr ", v(data)),
            str_concat("i64 ", v(index)))
}

fn string_equality(out: Strs, current: Strs, live: Ints, next: Ints,
        a: Int, b: Int, negate: Bool) -> Int {
    let pa = field(out, next, a, "0");
    let la = field(out, next, a, "1");
    let pb = field(out, next, b, "0");
    let lb = field(out, next, b, "1");
    let same = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(same)),
            str_concat(" = icmp eq i64 ", str_concat(v(la), str_concat(", ", v(lb))))));

    let cmp = take_label(next);
    let join = take_label(next);
    let short = strs_get(current, 0);
    add_line(out, str_concat(str_concat("  br i1 ", v(same)),
            str_concat(str_concat(", label %bc", int_to_str(cmp)),
            str_concat(", label %bj", int_to_str(join)))));
    open_block(out, current, live, str_concat("bc", int_to_str(cmp)));
    let diff = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(diff)),
            str_concat(str_concat(" = call i32 @memcmp(ptr ", v(pa)),
            str_concat(str_concat(", ptr ", v(pb)),
            str_concat(str_concat(", i64 ", v(la)), ")")))));
    let eq = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(eq)),
            str_concat(" = icmp eq i32 ", str_concat(v(diff), ", 0"))));
    let from_cmp = strs_get(current, 0);
    branch(out, live, str_concat("bj", int_to_str(join)));
    open_block(out, current, live, str_concat("bj", int_to_str(join)));
    let outv = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(outv)),
            str_concat(str_concat(" = phi i1 [ false, %", short),
            str_concat(str_concat(" ], [ ", v(eq)),
            str_concat(str_concat(", %", from_cmp), " ]")))));
    if negate == false { return outv; }
    let flipped = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(flipped)),
            str_concat(" = xor i1 ", str_concat(v(outv), ", true"))));
    flipped
}

fn emit_binary(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, op: Str, a: Int, b: Int, at: Str, ot: Int,
        owned: Ints, otype: Ints, rowns: Ints) -> Int {
    let pred = predicate(op);
    if pred != "" {
        // No guard: no comparison can fail. `icmp` on two `i64`s or two `i1`s is total.
        let n = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(n)),
                str_concat(str_concat(" = icmp ", pred),
                str_concat(str_concat(" ", llvm_type(ot)),
                str_concat(" ", str_concat(v(a), str_concat(", ", v(b))))))));
        return n;
    }
    if op == "+" { return checked(out, msgs, next, current, live, "sadd", "addition", a, b, at, owned, otype, rowns); }
    if op == "-" { return checked(out, msgs, next, current, live, "ssub", "subtraction", a, b, at, owned, otype, rowns); }
    if op == "*" { return checked(out, msgs, next, current, live, "smul", "multiplication", a, b, at, owned, otype, rowns); }
    if op == "/" { return divide(out, msgs, next, current, live, a, b, at, owned, otype, rowns); }
    if op == "%" { return remainder(out, msgs, next, current, live, a, b, at, owned, otype, rowns); }
    0 - 1
}

// --- the module ------------------------------------------------------------------------

// The largest slot index any node was given, plus one.
fn slot_count(nk: Ints, nslot: Ints) -> Int {
    let mut most = 0;
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_fn() {
            if ints_get(nslot, k) > most { most = ints_get(nslot, k); }
        }
        k = k + 1;
    }
    most
}

// The runtime, as generated LLVM rather than a linked crate: sequences and files need a
// handful of helpers, and none of them needs stack switching or a custom allocator —
// which is what `docs/architecture.md` reserves `nazm-rt` for.
//
// **Bounds checks are not here.** They live at each call site, because the diagnostic has
// to name that call's source position and a shared helper has only one. What is here is
// allocation, growth and the file system, none of which has a position to report: each
// signals failure by returning null or a negative count, and the call site turns that
// into `N0405`, `N0406` or `N0407`.
//
// Emitted into every module. The Rust backend gates each helper on being reached; this
// one does not yet, so a program that uses no sequence still carries `@nz.arr_new`. That
// is a size cost and not a correctness one, and it is written down rather than hidden.
// The environment variable that asks for a memory report, and the line it prints.
//
// The same two strings `crates/nazm-lir/src/emit.rs` declares, so a program built by this
// compiler and one built by the reference print the same line — which is what lets a
// differential test compare them on reclamation rather than only on values. `cargo xtask
// check`'s `runtime parity` gate holds the two copies together.
fn memory_variable() -> Str {
    "NAZM_MEMORY_REPORT"
}

fn memory_format() -> Str {
    "nazm-memory: sequences allocated=%lld reclaimed=%lld live=%lld strings allocated=%lld reclaimed=%lld live=%lld channels allocated=%lld reclaimed=%lld live=%lld"
}

// The runtime every emitted program carries, as generated LLVM.
//
// **Derived, not transcribed.** Every line below is a line of `crates/nazm-lir/src/emit.rs`'s
// runtime constants with `hidden` changed to `internal`, and `cargo xtask check`'s
// `runtime parity` gate re-derives it and refuses a difference. Two hand-kept copies of a
// memory model is how the Nazm-written compiler came to emit the pre-N7 runtime while the
// Rust one reclaimed; one derivation makes that impossible rather than unlikely.
fn runtime() -> Str {
    let r = strs_new();
    strs_push(r, "define internal ptr @nz.arr_new() {");
    strs_push(r, "entry:");
    strs_push(r, "  %h = call ptr @malloc(i64 32)");
    strs_push(r, "  %bad = icmp eq ptr %h, null");
    strs_push(r, "  br i1 %bad, label %fail, label %ok");
    strs_push(r, "fail:");
    strs_push(r, "  ret ptr null");
    strs_push(r, "ok:");
    strs_push(r, "  store i64 0, ptr %h");
    strs_push(r, "  %capp = getelementptr i8, ptr %h, i64 8");
    strs_push(r, "  store i64 0, ptr %capp");
    strs_push(r, "  %datap = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  store ptr null, ptr %datap");
    strs_push(r, "  ; Born with one reference: the expression that produced it. Whoever consumes that");
    strs_push(r, "  ; expression either takes the reference over or releases it.");
    strs_push(r, "  %rcp = getelementptr i8, ptr %h, i64 24");
    strs_push(r, "  store i64 1, ptr %rcp");
    strs_push(r, "  ret ptr %h");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.arr_retain(ptr %h) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %h, null");
    strs_push(r, "  br i1 %none, label %done, label %bump");
    strs_push(r, "bump:");
    strs_push(r, "  %rcp = getelementptr i8, ptr %h, i64 24");
    strs_push(r, "  %rc = load i64, ptr %rcp");
    strs_push(r, "  %rc2 = add i64 %rc, 1");
    strs_push(r, "  store i64 %rc2, ptr %rcp");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal i1 @nz.arr_release(ptr %h) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %h, null");
    strs_push(r, "  br i1 %none, label %kept, label %drop");
    strs_push(r, "drop:");
    strs_push(r, "  %rcp = getelementptr i8, ptr %h, i64 24");
    strs_push(r, "  %rc = load i64, ptr %rcp");
    strs_push(r, "  %rc2 = sub i64 %rc, 1");
    strs_push(r, "  store i64 %rc2, ptr %rcp");
    strs_push(r, "  %last = icmp sle i64 %rc2, 0");
    strs_push(r, "  br i1 %last, label %free, label %kept");
    strs_push(r, "free:");
    strs_push(r, "  ; The data buffer first, then the header: after the header is freed its `data` field");
    strs_push(r, "  ; may not be read, and reading it is how this would become a use-after-free of its own.");
    strs_push(r, "  %datap = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  %data = load ptr, ptr %datap");
    strs_push(r, "  call void @free(ptr %data)");
    strs_push(r, "  call void @free(ptr %h)");
    strs_push(r, "  ret i1 true");
    strs_push(r, "kept:");
    strs_push(r, "  ret i1 false");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "; The counted pair. `@nz.arr_new` and `@nz.arr_release` are the allocator; these two are");
    strs_push(r, "; the allocator plus the bookkeeping that makes reclamation checkable. The scope machinery");
    strs_push(r, "; uses the uncounted pair for its list of task ids, which is not a Nazm value and must not");
    strs_push(r, "; appear in a report about the program's sequences.");
    strs_push(r, "define internal ptr @nz.seq_new() {");
    strs_push(r, "entry:");
    strs_push(r, "  %h = call ptr @nz.arr_new()");
    strs_push(r, "  %bad = icmp eq ptr %h, null");
    strs_push(r, "  br i1 %bad, label %done, label %count");
    strs_push(r, "count:");
    strs_push(r, "  ; Atomic, unlike the reference count beside it: a *task* may create a sequence of its");
    strs_push(r, "  ; own, so two threads can reach this counter even though `N0321` stops them reaching");
    strs_push(r, "  ; one sequence. Until N8 this was an ordinary load-add-store and a concurrent program");
    strs_push(r, "  ; could under-report what it had allocated.");
    strs_push(r, "  %c = atomicrmw add ptr @nz.seq_allocated, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret ptr %h");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.seq_release(ptr %h) {");
    strs_push(r, "entry:");
    strs_push(r, "  %freed = call i1 @nz.arr_release(ptr %h)");
    strs_push(r, "  br i1 %freed, label %count, label %done");
    strs_push(r, "count:");
    strs_push(r, "  %c = atomicrmw add ptr @nz.seq_reclaimed, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal ptr @nz.arr_grow(ptr %h, i64 %elem) {");
    strs_push(r, "entry:");
    strs_push(r, "  %len = load i64, ptr %h");
    strs_push(r, "  %capp = getelementptr i8, ptr %h, i64 8");
    strs_push(r, "  %cap = load i64, ptr %capp");
    strs_push(r, "  %datap = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  %full = icmp sge i64 %len, %cap");
    strs_push(r, "  br i1 %full, label %grow, label %done");
    strs_push(r, "grow:");
    strs_push(r, "  ; Doubling, with a floor of four. `realloc(null, n)` is `malloc(n)`, so the first");
    strs_push(r, "  ; growth needs no special case. Both products are checked: an element may be a record");
    strs_push(r, "  ; or an enum of any size since N11, and a wrapped size would allocate less than the");
    strs_push(r, "  ; caller is about to write.");
    strs_push(r, "  %twice.r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %cap, i64 2)");
    strs_push(r, "  %twice = extractvalue {i64, i1} %twice.r, 0");
    strs_push(r, "  %twice.o = extractvalue {i64, i1} %twice.r, 1");
    strs_push(r, "  %tiny = icmp slt i64 %twice, 4");
    strs_push(r, "  %want = select i1 %tiny, i64 4, i64 %twice");
    strs_push(r, "  %bytes.r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %want, i64 %elem)");
    strs_push(r, "  %bytes = extractvalue {i64, i1} %bytes.r, 0");
    strs_push(r, "  %bytes.o = extractvalue {i64, i1} %bytes.r, 1");
    strs_push(r, "  %over = or i1 %twice.o, %bytes.o");
    strs_push(r, "  br i1 %over, label %oom, label %sized");
    strs_push(r, "sized:");
    strs_push(r, "  %old = load ptr, ptr %datap");
    strs_push(r, "  %new = call ptr @realloc(ptr %old, i64 %bytes)");
    strs_push(r, "  %failed = icmp eq ptr %new, null");
    strs_push(r, "  br i1 %failed, label %oom, label %kept");
    strs_push(r, "kept:");
    strs_push(r, "  ; The header is updated only after the allocation succeeded, so a failed growth");
    strs_push(r, "  ; leaves the sequence exactly as it was rather than half-resized.");
    strs_push(r, "  store ptr %new, ptr %datap");
    strs_push(r, "  store i64 %want, ptr %capp");
    strs_push(r, "  br label %done");
    strs_push(r, "oom:");
    strs_push(r, "  ret ptr null");
    strs_push(r, "done:");
    strs_push(r, "  %data = load ptr, ptr %datap");
    strs_push(r, "  ret ptr %data");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal ptr @nz.str_alloc(i64 %n) {");
    strs_push(r, "entry:");
    strs_push(r, "  ; Checked, because a length that overflows here would allocate less than the caller is");
    strs_push(r, "  ; about to write. `docs/spec.md` reports it as N0406 at the call site.");
    strs_push(r, "  %r = call {i64, i1} @llvm.uadd.with.overflow.i64(i64 %n, i64 16)");
    strs_push(r, "  %over = extractvalue {i64, i1} %r, 1");
    strs_push(r, "  br i1 %over, label %fail, label %ask");
    strs_push(r, "ask:");
    strs_push(r, "  %room = extractvalue {i64, i1} %r, 0");
    strs_push(r, "  %b = call ptr @malloc(i64 %room)");
    strs_push(r, "  %bad = icmp eq ptr %b, null");
    strs_push(r, "  br i1 %bad, label %fail, label %ok");
    strs_push(r, "fail:");
    strs_push(r, "  ret ptr null");
    strs_push(r, "ok:");
    strs_push(r, "  store i64 1, ptr %b");
    strs_push(r, "  %lenp = getelementptr i8, ptr %b, i64 8");
    strs_push(r, "  store i64 %n, ptr %lenp");
    strs_push(r, "  %c = atomicrmw add ptr @nz.str_allocated, i64 1 monotonic");
    strs_push(r, "  ret ptr %b");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.str_retain(ptr %b) {");
    strs_push(r, "entry:");
    strs_push(r, "  ; Null is immortal or external storage: a literal, or a process argument. Nothing to");
    strs_push(r, "  ; count, and nothing this program may ever free.");
    strs_push(r, "  %none = icmp eq ptr %b, null");
    strs_push(r, "  br i1 %none, label %done, label %bump");
    strs_push(r, "bump:");
    strs_push(r, "  %old = atomicrmw add ptr %b, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.str_release(ptr %b) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %b, null");
    strs_push(r, "  br i1 %none, label %done, label %drop");
    strs_push(r, "drop:");
    strs_push(r, "  %old = atomicrmw sub ptr %b, i64 1 release");
    strs_push(r, "  %last = icmp eq i64 %old, 1");
    strs_push(r, "  br i1 %last, label %free, label %done");
    strs_push(r, "free:");
    strs_push(r, "  fence acquire");
    strs_push(r, "  call void @free(ptr %b)");
    strs_push(r, "  %c = atomicrmw add ptr @nz.str_reclaimed, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "; A `Strs` owns a reference to every string in it, so its storage cannot be released by");
    strs_push(r, "; the helper an `Ints` uses. Elements first, then the array, then the header — the order");
    strs_push(r, "; matters, because reading an element out of a buffer that has already been freed is the");
    strs_push(r, "; use-after-free this whole milestone exists to make impossible.");
    strs_push(r, "define internal void @nz.strs_release(ptr %h) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %h, null");
    strs_push(r, "  br i1 %none, label %done, label %drop");
    strs_push(r, "drop:");
    strs_push(r, "  %rcp = getelementptr i8, ptr %h, i64 24");
    strs_push(r, "  %rc = load i64, ptr %rcp");
    strs_push(r, "  %rc2 = sub i64 %rc, 1");
    strs_push(r, "  store i64 %rc2, ptr %rcp");
    strs_push(r, "  %last = icmp sle i64 %rc2, 0");
    strs_push(r, "  br i1 %last, label %contents, label %done");
    strs_push(r, "contents:");
    strs_push(r, "  %n = load i64, ptr %h");
    strs_push(r, "  %dp = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  %data = load ptr, ptr %dp");
    strs_push(r, "  br label %test");
    strs_push(r, "test:");
    strs_push(r, "  %i = phi i64 [ 0, %contents ], [ %next, %body ]");
    strs_push(r, "  %more = icmp slt i64 %i, %n");
    strs_push(r, "  br i1 %more, label %body, label %storage");
    strs_push(r, "body:");
    strs_push(r, "  %e = getelementptr { ptr, i64, ptr }, ptr %data, i64 %i");
    strs_push(r, "  %op = getelementptr i8, ptr %e, i64 16");
    strs_push(r, "  %owner = load ptr, ptr %op");
    strs_push(r, "  call void @nz.str_release(ptr %owner)");
    strs_push(r, "  %next = add i64 %i, 1");
    strs_push(r, "  br label %test");
    strs_push(r, "storage:");
    strs_push(r, "  call void @free(ptr %data)");
    strs_push(r, "  call void @free(ptr %h)");
    strs_push(r, "  %c = atomicrmw add ptr @nz.seq_reclaimed, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal ptr @nz.cstr(ptr %p, i64 %n) {");
    strs_push(r, "entry:");
    strs_push(r, "  %room = add i64 %n, 1");
    strs_push(r, "  %buf = call ptr @malloc(i64 %room)");
    strs_push(r, "  %bad = icmp eq ptr %buf, null");
    strs_push(r, "  br i1 %bad, label %fail, label %ok");
    strs_push(r, "fail:");
    strs_push(r, "  ret ptr null");
    strs_push(r, "ok:");
    strs_push(r, "  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %p, i64 %n, i1 false)");
    strs_push(r, "  %end = getelementptr i8, ptr %buf, i64 %n");
    strs_push(r, "  store i8 0, ptr %end");
    strs_push(r, "  ret ptr %buf");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal i1 @nz.file_exists(ptr %p, i64 %n) {");
    strs_push(r, "entry:");
    strs_push(r, "  %path = call ptr @nz.cstr(ptr %p, i64 %n)");
    strs_push(r, "  %nopath = icmp eq ptr %path, null");
    strs_push(r, "  br i1 %nopath, label %no, label %open");
    strs_push(r, "open:");
    strs_push(r, "  %f = call ptr @fopen(ptr %path, ptr @.rb)");
    strs_push(r, "  ; The terminated copy has done its job the moment `fopen` returns. Until N8 every file");
    strs_push(r, "  ; operation leaked one of these.");
    strs_push(r, "  call void @free(ptr %path)");
    strs_push(r, "  %missing = icmp eq ptr %f, null");
    strs_push(r, "  br i1 %missing, label %no, label %yes");
    strs_push(r, "yes:");
    strs_push(r, "  %ignored = call i32 @fclose(ptr %f)");
    strs_push(r, "  ret i1 true");
    strs_push(r, "no:");
    strs_push(r, "  ret i1 false");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal { ptr, i64, ptr } @nz.read_file(ptr %p, i64 %n) {");
    strs_push(r, "entry:");
    strs_push(r, "  %path = call ptr @nz.cstr(ptr %p, i64 %n)");
    strs_push(r, "  %nopath = icmp eq ptr %path, null");
    strs_push(r, "  br i1 %nopath, label %fail, label %open");
    strs_push(r, "open:");
    strs_push(r, "  %f = call ptr @fopen(ptr %path, ptr @.rb)");
    strs_push(r, "  call void @free(ptr %path)");
    strs_push(r, "  %missing = icmp eq ptr %f, null");
    strs_push(r, "  br i1 %missing, label %fail, label %measure");
    strs_push(r, "measure:");
    strs_push(r, "  ; SEEK_END is 2 and SEEK_SET is 0 on every target this is verified against.");
    strs_push(r, "  %e = call i32 @fseek(ptr %f, i64 0, i32 2)");
    strs_push(r, "  %len = call i64 @ftell(ptr %f)");
    strs_push(r, "  %unmeasurable = icmp slt i64 %len, 0");
    strs_push(r, "  br i1 %unmeasurable, label %closefail, label %reserve");
    strs_push(r, "reserve:");
    strs_push(r, "  %s = call i32 @fseek(ptr %f, i64 0, i32 0)");
    strs_push(r, "  ; One byte more than the file, so an empty file still owns storage and its pointer");
    strs_push(r, "  ; stays valid to compare.");
    strs_push(r, "  %room = add i64 %len, 1");
    strs_push(r, "  %own = call ptr @nz.str_alloc(i64 %room)");
    strs_push(r, "  %nobuf = icmp eq ptr %own, null");
    strs_push(r, "  br i1 %nobuf, label %closefail, label %read");
    strs_push(r, "read:");
    strs_push(r, "  %buf = getelementptr i8, ptr %own, i64 16");
    strs_push(r, "  %got = call i64 @fread(ptr %buf, i64 1, i64 %len, ptr %f)");
    strs_push(r, "  %c = call i32 @fclose(ptr %f)");
    strs_push(r, "  %short = icmp ne i64 %got, %len");
    strs_push(r, "  br i1 %short, label %partial, label %done");
    strs_push(r, "partial:");
    strs_push(r, "  ; A short read is a failure, and the storage it was going to fill is released rather");
    strs_push(r, "  ; than abandoned.");
    strs_push(r, "  call void @nz.str_release(ptr %own)");
    strs_push(r, "  br label %fail");
    strs_push(r, "done:");
    strs_push(r, "  %a = insertvalue { ptr, i64, ptr } undef, ptr %buf, 0");
    strs_push(r, "  %b = insertvalue { ptr, i64, ptr } %a, i64 %len, 1");
    strs_push(r, "  %b2 = insertvalue { ptr, i64, ptr } %b, ptr %own, 2");
    strs_push(r, "  ret { ptr, i64, ptr } %b2");
    strs_push(r, "closefail:");
    strs_push(r, "  %c2 = call i32 @fclose(ptr %f)");
    strs_push(r, "  br label %fail");
    strs_push(r, "fail:");
    strs_push(r, "  %z = insertvalue { ptr, i64, ptr } undef, ptr null, 0");
    strs_push(r, "  %z2 = insertvalue { ptr, i64, ptr } %z, i64 0, 1");
    strs_push(r, "  %z3 = insertvalue { ptr, i64, ptr } %z2, ptr null, 2");
    strs_push(r, "  ret { ptr, i64, ptr } %z3");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal i64 @nz.write_file(ptr %pp, i64 %pn, ptr %dp, i64 %dn) {");
    strs_push(r, "entry:");
    strs_push(r, "  %path = call ptr @nz.cstr(ptr %pp, i64 %pn)");
    strs_push(r, "  %nopath = icmp eq ptr %path, null");
    strs_push(r, "  br i1 %nopath, label %fail, label %open");
    strs_push(r, "open:");
    strs_push(r, "  %f = call ptr @fopen(ptr %path, ptr @.wb)");
    strs_push(r, "  call void @free(ptr %path)");
    strs_push(r, "  %missing = icmp eq ptr %f, null");
    strs_push(r, "  br i1 %missing, label %fail, label %write");
    strs_push(r, "write:");
    strs_push(r, "  %got = call i64 @fwrite(ptr %dp, i64 1, i64 %dn, ptr %f)");
    strs_push(r, "  %c = call i32 @fclose(ptr %f)");
    strs_push(r, "  %short = icmp ne i64 %got, %dn");
    strs_push(r, "  br i1 %short, label %fail, label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret i64 %got");
    strs_push(r, "fail:");
    strs_push(r, "  ret i64 -1");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal { ptr, i64, ptr } @nz.str_join(ptr %h, ptr %sp, i64 %sn) {");
    strs_push(r, "entry:");
    strs_push(r, "  %n = load i64, ptr %h");
    strs_push(r, "  %dp = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  %data = load ptr, ptr %dp");
    strs_push(r, "  br label %sum");
    strs_push(r, "sum:");
    strs_push(r, "  %i = phi i64 [ 0, %entry ], [ %i2, %sumbody ]");
    strs_push(r, "  %acc = phi i64 [ 0, %entry ], [ %acc2, %sumbody ]");
    strs_push(r, "  %more = icmp slt i64 %i, %n");
    strs_push(r, "  br i1 %more, label %sumbody, label %alloc");
    strs_push(r, "sumbody:");
    strs_push(r, "  %e = getelementptr { ptr, i64, ptr }, ptr %data, i64 %i");
    strs_push(r, "  %lp = getelementptr i8, ptr %e, i64 8");
    strs_push(r, "  %li = load i64, ptr %lp");
    strs_push(r, "  %acc2 = add i64 %acc, %li");
    strs_push(r, "  %i2 = add i64 %i, 1");
    strs_push(r, "  br label %sum");
    strs_push(r, "alloc:");
    strs_push(r, "  ; One separator between each pair, so n-1 of them, and none for an empty sequence.");
    strs_push(r, "  %less = sub i64 %n, 1");
    strs_push(r, "  %neg = icmp slt i64 %less, 0");
    strs_push(r, "  %gaps = select i1 %neg, i64 0, i64 %less");
    strs_push(r, "  %sepbytes = mul i64 %gaps, %sn");
    strs_push(r, "  %total = add i64 %acc, %sepbytes");
    strs_push(r, "  ; One byte more, so an empty result still owns storage and its pointer stays valid.");
    strs_push(r, "  %room = add i64 %total, 1");
    strs_push(r, "  %own = call ptr @nz.str_alloc(i64 %room)");
    strs_push(r, "  %bad = icmp eq ptr %own, null");
    strs_push(r, "  br i1 %bad, label %fail, label %copy");
    strs_push(r, "copy:");
    strs_push(r, "  %buf = getelementptr i8, ptr %own, i64 16");
    strs_push(r, "  br label %loop");
    strs_push(r, "loop:");
    strs_push(r, "  %j = phi i64 [ 0, %copy ], [ %j2, %tail ]");
    strs_push(r, "  %off = phi i64 [ 0, %copy ], [ %off3, %tail ]");
    strs_push(r, "  %more2 = icmp slt i64 %j, %n");
    strs_push(r, "  br i1 %more2, label %body, label %done");
    strs_push(r, "body:");
    strs_push(r, "  %first = icmp eq i64 %j, 0");
    strs_push(r, "  br i1 %first, label %tail, label %gap");
    strs_push(r, "gap:");
    strs_push(r, "  %d1 = getelementptr i8, ptr %buf, i64 %off");
    strs_push(r, "  call void @llvm.memcpy.p0.p0.i64(ptr %d1, ptr %sp, i64 %sn, i1 false)");
    strs_push(r, "  %off1 = add i64 %off, %sn");
    strs_push(r, "  br label %tail");
    strs_push(r, "tail:");
    strs_push(r, "  %off2 = phi i64 [ %off, %body ], [ %off1, %gap ]");
    strs_push(r, "  %e2 = getelementptr { ptr, i64, ptr }, ptr %data, i64 %j");
    strs_push(r, "  %p2 = load ptr, ptr %e2");
    strs_push(r, "  %l2p = getelementptr i8, ptr %e2, i64 8");
    strs_push(r, "  %l2 = load i64, ptr %l2p");
    strs_push(r, "  %d2 = getelementptr i8, ptr %buf, i64 %off2");
    strs_push(r, "  call void @llvm.memcpy.p0.p0.i64(ptr %d2, ptr %p2, i64 %l2, i1 false)");
    strs_push(r, "  %off3 = add i64 %off2, %l2");
    strs_push(r, "  %j2 = add i64 %j, 1");
    strs_push(r, "  br label %loop");
    strs_push(r, "done:");
    strs_push(r, "  %a = insertvalue { ptr, i64, ptr } undef, ptr %buf, 0");
    strs_push(r, "  %b = insertvalue { ptr, i64, ptr } %a, i64 %total, 1");
    strs_push(r, "  %b2 = insertvalue { ptr, i64, ptr } %b, ptr %own, 2");
    strs_push(r, "  ret { ptr, i64, ptr } %b2");
    strs_push(r, "fail:");
    strs_push(r, "  %z = insertvalue { ptr, i64, ptr } undef, ptr null, 0");
    strs_push(r, "  %z2 = insertvalue { ptr, i64, ptr } %z, i64 0, 1");
    strs_push(r, "  %z3 = insertvalue { ptr, i64, ptr } %z2, ptr null, 2");
    strs_push(r, "  ret { ptr, i64, ptr } %z3");
    strs_push(r, "}");
    str_concat(str_join(r, nl()), nl())
}

fn refuse(message: Str, at: Str) -> Int {
    eprint(str_concat(str_concat("nazm: error[N0101]: ", message),
            str_concat(str_concat(" at ", at), nl())));
    eprint(str_concat("nazm: this backend compiles the bootstrap subset; what it refuses still runs under `nazm run`", nl()));
    exit_with(1);
    0
}

// A label for one of a node's basic blocks. Named from the node index and a role, so no
// two constructs can collide and a reader can find the source of any block.
fn blk(role: Str, k: Int) -> Str {
    str_concat(str_concat("b", role), int_to_str(k))
}

fn open_block(out: Strs, current: Strs, live: Ints, name: Str) -> Int {
    add_line(out, str_concat(name, ":"));
    ints_set(live, 0, 1);
    // The block emission is *in* — which is the predecessor a `phi` must name, and is
    // not the label a branch was opened with once that branch has opened blocks of its
    // own. Tracked here so the `phi` can read it back.
    strs_set(current, 0, name);
    0
}

// A branch, unless the block already has a terminator.
//
// `break`, `continue` and `return` end the block they are in, and the boundary between
// two children would otherwise append a second terminator after one — which is invalid
// IR, and the single easiest mistake to make here.
fn branch(out: Strs, live: Ints, target: Str) -> Int {
    if ints_get(live, 0) == 0 { return 0; }
    add_line(out, str_concat("  br label %", target));
    ints_set(live, 0, 0);
    0
}

// Whether the node the scan has reached is on no path control takes.
//
// The block being written has a terminator, so everything the node would do — the call,
// the store, the arithmetic, the construction — happens nowhere. Declarations and the end
// of a function are not evaluated and are not asked: the space between two functions is
// never live, and a function's close is what decides what to do about a body that left.
// A `block`, or a block written as an expression (`blockexpr`, N12.1): neither emits anything
// of its own. One question with one answer, so the two kinds cannot drift apart.
fn block_like(kind: Int) -> Bool {
    if kind == n_block() { return true; }
    if kind == n_blockexpr() { return true; }
    false
}

fn unreachable_here(live: Ints, kind: Int) -> Bool {
    if ints_get(live, 0) == 1 { return false; }
    if kind == n_fn() { return false; }
    if kind == n_program() { return false; }
    if kind == n_param() { return false; }
    if kind == n_record() { return false; }
    if kind == n_structfield() { return false; }
    if kind == n_enum() { return false; }
    if kind == n_variant() { return false; }
    if kind == n_payload() { return false; }
    true
}

// The `phi` at a join, from the incomings its branches really delivered.
//
// `count` is how many branches reached the join with a value: every one that did not
// transferred, and a transferred branch is not a predecessor of the join and has no
// value to give it. One incoming is still a `phi` — valid, and folded by any optimiser —
// so the shape does not depend on how many branches left. Each incoming already holds the
// one reference its branch handed over, so the merged value holds exactly one.
fn emit_phi(out: Strs, next: Ints, owned: Ints, otype: Ints, rowns: Ints,
        phi_val: Ints, phi_blk: Strs, count: Int, t: Int) -> Int {
    let ins = ints_new();
    let blks = strs_new();
    let mut q = 0;
    while q < count {
        let bv = ints_pop(phi_val);
        ints_push(ins, bv);
        strs_push(blks, strs_pop(phi_blk));
        own_take(owned, otype, bv);
        q = q + 1;
    }
    let n = take_number(next);
    if owns_anything(t, rowns) { own_add(owned, otype, n, t); }
    let mut line = str_concat(str_concat("  ", v(n)), str_concat(" = phi ", llvm_type(t)));
    // Popped innermost first, so read back in reverse to list them in branch order.
    let mut w = count - 1;
    while w >= 0 {
        if w < count - 1 { line = str_concat(line, ","); }
        line = str_concat(line,
                str_concat(str_concat(" [ ", v(ints_get(ins, w))),
                str_concat(str_concat(", %", strs_get(blks, w)), " ]")));
        w = w - 1;
    }
    add_line(out, line);
    n
}

// A branch that completed with a value, of a construct that has none.
//
// A `match` one of whose arms produces nothing is itself a `Unit` — the reference folds it
// so, and accepts it as a statement — so the arms that did produce a value produce one
// nobody takes. It is discarded here, as an expression statement discards one: released
// if it was a temporary, inside the branch's own block, because after the join there is
// no branch left to attribute it to. Until N10.2 the checker gave such a `match` its value
// arms' type, and a value arm left its value on the stack for a later node to consume.
fn discard_branch_value(out: Strs, next: Ints, owned: Ints, otype: Ints, rowns: Ints,
        vals: Ints, ntype: Ints, k: Int) -> Int {
    let t = ints_get(ntype, k);
    if t == 0 { return 0; }
    let dropped = ints_pop(vals);
    own_drop(out, next, owned, dropped, t, rowns, otype)
}

// The loop a `break` or `continue` belongs to, or -1.
//
// Walks outward, and a `while` only counts when the path came up through its **body**:
// a loop's condition is not inside that loop, so a transfer raised there belongs to the
// enclosing one. That is the existing language's rule, read out of both reference
// implementations rather than invented here.
fn enclosing_loop(nk: Ints, parent: Ints, childno: Ints, from: Int) -> Int {
    let mut node = from;
    while node >= 0 {
        let p = ints_get(parent, node);
        if p < 0 { return 0 - 1; }
        if ints_get(nk, p) == n_while() {
            if ints_get(childno, node) == 1 { return p; }
        }
        node = p;
    }
    0 - 1
}

// The generated symbol for a function, from **the definition's index**.
//
// Never from the source name: a Nazm identifier would need escaping rules to be safe in an
// LLVM identifier, and the escaping is the bug. It also means no program can collide with
// `@main`, with `@nz.fail`, or with `printf`.
//
// Until 2026-09-22 this took a name and scanned for the first definition with it, which
// was correct while a program had one namespace and silently wrong the moment it did not:
// two modules each defining a private `helper` both emitted `@nz.f0`, and clang refused
// the module with "invalid redefinition". The index comes from the checker now — the same
// resolution the call was type-checked against — so emission never decides what a name
// means and cannot decide it differently.
fn symbol(index: Int) -> Str {
    if index < 0 { return "@nz.unknown"; }
    str_concat("@nz.f", int_to_str(index))
}

// The symbol a call names: a function's own, or — for a call to a generic function — the
// instance the planner chose for it.
// A written type's name without the offset a return type carries: `Int` from `Int@25`.
fn before_at(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 64 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

fn callee_symbol(ncallee: Ints, ninst: Ints, k: Int) -> Str {
    if ints_get(ninst, k) >= 0 { return str_concat("@nz.g", int_to_str(ints_get(ninst, k))); }
    symbol(ints_get(ncallee, k))
}

fn open_function(out: Strs, current: Strs, live: Ints, next: Ints, vals: Ints,
        nk: Ints, nar: Ints, nst: Ints, ntx: Strs, nslot: Ints, ntype: Ints,
        kids: Ints, kid_first: Ints, fnames: Strs, fowner: Ints, mstart: Ints,
        frame: Ints, owned: Ints, k: Int, begin: Int, src: Str, path: Str, rowns: Ints,
        nrec: Ints, otype: Ints, rfirst: Ints, rcount: Ints, rftype: Ints, me_sym: Str) -> Int {
    // Numbering restarts per function: LLVM requires a function's unnamed values to be
    // consecutive from zero, and `%p<n>`/`%slot<n>` are named so they consume none of it.
    ints_set(next, 0, 0);
    let text = strs_get(ntx, k);
    let params = ints_get(nar, k) - 1;
    let first = ints_get(kid_first, k);

    let mut list = "";
    let mut p = 0;
    while p < params {
        if p > 0 { list = str_concat(list, ", "); }
        let pt = ints_get(nrec, ints_get(kids, first + p));
        list = str_concat(list, str_concat(str_concat(llvm_type(pt), " %p"), int_to_str(p)));
        p = p + 1;
    }
    // Which definition this node *is*, by the same rule its callers were resolved with:
    // a module's own name, in the module the declaration sits in. Names are unique within
    // a module (`N0203`), so this is exact.
    let me = owned_index(fnames, fowner, module_at(mstart, ints_get(nst, k)),
            fn_name(text));
    // An instance of a generic function has a symbol of its own, chosen by the planner.
    let mut named = symbol(me);
    if me_sym != "" { named = me_sym; }
    add_line(out, str_concat(str_concat(str_concat("define internal ",
            llvm_type(ints_get(nrec, k))),
            str_concat(" ", named)),
            str_concat(str_concat("(", list), str_concat(") {   ; ", fn_name(text)))));
    add_line(out, "entry:");
    strs_set(current, 0, "entry");
    ints_set(live, 0, 1);

    // Every local gets its storage here, one `alloca` per binding, never on a path that
    // runs more than once: a slot belongs to a binding, not to an execution of it.
    //
    // A slot's *type* comes from the binding that owns it, found by scanning this
    // function's own subtree — which is contiguous in a post-order array, running from
    // `substart[k]` to `k`. The alternative, a map threaded down from the checker, would
    // be a second place for a slot's type to live.
    let slots = ints_get(nslot, k);
    let styp = ints_new();
    let mut fill = 0;
    while fill < slots { ints_push(styp, t_int()); fill = fill + 1; }
    let mut scan = begin;
    while scan <= k {
        let sk = ints_get(nk, scan);
        if sk == n_param() {
            ints_set(styp, ints_get(nslot, scan), ints_get(nrec, scan));
        }
        if sk == n_let() {
            // A binding's type is its initialiser's, which the checker already recorded
            // on the initialiser node.
            ints_set(styp, ints_get(nslot, scan),
                    ints_get(ntype, ints_get(kids, ints_get(kid_first, scan))));
        }
        // A construction that owns something is assembled in a hidden slot of its own, so
        // that an initialiser failing part way through releases what the earlier ones
        // produced. The slot's type is the record's.
        if sk == n_construct() {
            if ints_get(nslot, scan) >= 0 {
                ints_set(styp, ints_get(nslot, scan), ints_get(ntype, scan));
            }
        }
        if sk == n_makevariant() {
            if ints_get(nslot, scan) >= 0 {
                ints_set(styp, ints_get(nslot, scan), ints_get(ntype, scan));
            }
        }
        // The value a `match` is matching lives in a slot the frame releases, so a failure
        // inside any arm gives it back. Its type is the **scrutinee's**, not the match's —
        // the match's is what its arms produce.
        if sk == n_match() {
            if ints_get(nslot, scan) >= 0 {
                ints_set(styp, ints_get(nslot, scan),
                        ints_get(ntype, ints_get(kids, ints_get(kid_first, scan))));
            }
        }
        // And the `Result` a `?` is taking apart, for the same reason: held by the frame
        // from the moment it is stored, so every way out releases it once.
        if sk == n_propagate() {
            if ints_get(nslot, scan) >= 0 {
                ints_set(styp, ints_get(nslot, scan),
                        ints_get(ntype, ints_get(kids, ints_get(kid_first, scan))));
            }
        }
        // An arm's payload bindings occupy one slot each, from `nslot` on, in the
        // variant's **declaration** order — which is how the checker numbered them.
        if sk == n_arm() {
            let base = ints_get(nslot, scan);
            let vr = ints_get(nrec, scan);
            if base >= 0 {
                if vr >= 0 {
                    let mut f = 0;
                    while f < ints_get(rcount, vr) {
                        ints_set(styp, base + f,
                                ints_get(rftype, ints_get(rfirst, vr) + f));
                        f = f + 1;
                    }
                }
            }
        }
        scan = scan + 1;
    }
    let mut sl = 0;
    while sl < slots {
        add_line(out, str_concat(str_concat("  %slot", int_to_str(sl)),
                str_concat(" = alloca ", llvm_type(ints_get(styp, sl)))));
        sl = sl + 1;
    }
    // What this frame must release on the way out: one entry per slot, holding the slot's
    // type or `Int` where nothing has to happen. **Parameter slots are `Int`**, and that
    // exclusion *is* the specification's rule 2 — a callee borrows, so releasing a
    // parameter would destroy storage its caller still holds.
    //
    // No reference number survives a function, so the owned set starts empty too.
    while ints_len(frame) > 0 { ints_pop(frame); }
    while ints_len(owned) > 0 { ints_pop(owned); }
    // In lockstep with it, or every type after the first function describes the wrong
    // value.
    while ints_len(otype) > 0 { ints_pop(otype); }
    sl = 0;
    while sl < slots {
        ints_push(frame, ints_get(styp, sl));
        sl = sl + 1;
    }
    p = 0;
    while p < params {
        ints_set(frame, ints_get(nslot, ints_get(kids, first + p)), t_int());
        p = p + 1;
    }
    // Every owning slot starts zeroed, and a zeroed slot releases to nothing: a null
    // handle, or a string whose owner is null. So a path that never reached a declaration
    // and the shared unwind block a failure takes can both release the whole frame
    // without asking which slots were ever written.
    sl = 0;
    while sl < slots {
        let st = ints_get(frame, sl);
        if owns_anything(st, rowns) {
            add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(st)),
                    str_concat(" ", unwind_value(st))),
                    str_concat(", ptr %slot", int_to_str(sl))));
        }
        sl = sl + 1;
    }
    // Parameters arrive as SSA values and are stored into their slots at once, so the
    // body reads them with the same `load` it uses for any local.
    p = 0;
    while p < params {
        let child = ints_get(kids, first + p);
        let slot = ints_get(nslot, child);
        let pt = ints_get(nrec, child);
        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(pt)),
                str_concat(" %p", int_to_str(p))),
                str_concat(", ptr %slot", int_to_str(slot))));
        p = p + 1;
    }
    0
}

// --- generic instances, N11 --------------------------------------------------------------

// A refusal with its own code: the same shape `refuse` writes, for the two limits on
// instantiation that are not "outside this backend's subset" but facts about the program.
fn refuse_as(code: Str, message: Str, at: Str) -> Int {
    eprint(str_concat(str_concat(str_concat(str_concat("nazm: error[", code), "]: "), message),
            str_concat(str_concat(" at ", at), nl())));
    exit_with(1);
    0
}

// The types a node carries beyond its own — a function's parameters, a generic call's
// settled arguments — as a fresh list.
fn node_types(ntfirst: Ints, ntargs: Ints, k: Int) -> Ints {
    let out = ints_new();
    let at = ints_get(ntfirst, k);
    if at < 0 { return out; }
    let mut i = 0;
    while i < ints_get(ntargs, at) {
        ints_push(out, ints_get(ntargs, at + 1 + i));
        i = i + 1;
    }
    out
}

// How many instances one program may have, and how deeply an instance's argument may
// nest: the reference's stated bounds, reported rather than discovered by running out of
// memory.
fn max_instances() -> Int { 10000 }
fn max_instance_nesting() -> Int { 64 }

// The instance of the generic function whose node is `fnn` for exactly these arguments:
// the one already planned, or a new one at the end of the worklist. Numbered in the order
// the worklist finds them, which is a function of the program alone.
fn request_instance(fnn: Int, args: Ints, inst_fn: Ints, inst_first: Ints, inst_args: Ints,
        tb: Table, src: Str, path: Str, at: Int) -> Int {
    let mut i = 0;
    while i < ints_len(inst_fn) {
        if ints_get(inst_fn, i) == fnn {
            let mut same = true;
            let mut a = 0;
            while a < ints_len(args) {
                if ints_get(inst_args, ints_get(inst_first, i) + a) != ints_get(args, a) {
                    same = false;
                }
                a = a + 1;
            }
            if same { return i; }
        }
        i = i + 1;
    }
    let mut a = 0;
    while a < ints_len(args) {
        if depth_of(tb, ints_get(args, a)) > max_instance_nesting() {
            refuse_as("N0358", "this call needs a generic instance whose type argument nests more than 64 deep",
                    position(src, path, at));
        }
        a = a + 1;
    }
    if ints_len(inst_fn) >= max_instances() {
        refuse_as("N0358", "this program needs more than 10000 generic instances",
                position(src, path, at));
    }
    ints_push(inst_fn, fnn);
    ints_push(inst_first, ints_len(inst_args));
    a = 0;
    while a < ints_len(args) { ints_push(inst_args, ints_get(args, a)); a = a + 1; }
    ints_len(inst_fn) - 1
}

// Whether an entry is a native type: a declaration that is not generic, an application
// that mentions no parameter, or a `Vec` of a concrete type. A generic definition as
// written is not code until it is applied, and neither is anything inside one.
fn emittable(tb: Table, r0: Int) -> Bool {
    let mut r = r0;
    let k = ints_get(tb.kind, r);
    if k == rk_param() { return false; }
    if k == rk_vec() { return is_concrete(tb, t_vec(r)); }
    if k == rk_variant() { r = enum_of_variant(tb.kind, r); }
    if ints_get(tb.tpl, r) < 0 { return generic_count(tb, r) == 0; }
    is_concrete(tb, t_record(r))
}

// Refuse an instance family that would never end: a generic function reachable from one
// of its own calls whose type argument is built from its own parameters — `grow[T]`
// calling `grow[Vec[T]]` — needs a larger instance for every one it has. `N0357`, at the
// call that expands, before any instance is planned; the reference finds the same edge.
fn refuse_expansion(src: Str, path: Str, nk: Ints, nst: Ints, ntx: Strs, parent: Ints,
        ncallee: Ints, fnames: Strs, fowner: Ints, fgc: Ints, mstart: Ints,
        tb: Table, ntfirst: Ints, ntargs: Ints) -> Int {
    // The function each call sits in, found by walking parents, and its node.
    let efrom = ints_new();
    let eto = ints_new();
    let enode = ints_new();
    let efnode = ints_new();
    let mut k = 0;
    while k < ints_len(nk) {
        let mut calls = false;
        if ints_get(nk, k) == n_call() { calls = true; }
        if ints_get(nk, k) == n_spawn() { calls = true; }
        if calls {
            let to = ints_get(ncallee, k);
            if to >= 0 {
                let mut up = k;
                let mut fnode = 0 - 1;
                while up >= 0 {
                    if ints_get(nk, up) == n_fn() {
                        fnode = up;
                        up = 0 - 1;
                    } else {
                        up = ints_get(parent, up);
                    }
                }
                if fnode >= 0 {
                    ints_push(efrom, owned_index(fnames, fowner,
                            module_at(mstart, ints_get(nst, fnode)), fn_name(strs_get(ntx, fnode))));
                    ints_push(eto, to);
                    ints_push(enode, k);
                    ints_push(efnode, fnode);
                }
            }
        }
        k = k + 1;
    }
    let mut e = 0;
    while e < ints_len(efrom) {
        let from = ints_get(efrom, e);
        let to = ints_get(eto, e);
        let mut expanding = false;
        if from >= 0 {
            if ints_get(fgc, from) > 0 {
                if ints_get(fgc, to) > 0 {
                    let own = node_types(ntfirst, ntargs, ints_get(efnode, e));
                    let written = node_types(ntfirst, ntargs, ints_get(enode, e));
                    let mut w = 0;
                    while w < ints_len(written) {
                        let t = ints_get(written, w);
                        if is_param(t) == false {
                            if mentions(tb, t, own) { expanding = true; }
                        }
                        w = w + 1;
                    }
                }
            }
        }
        if expanding {
            // Whether the callee reaches the caller again: a breadth-first walk of the call
            // graph from `to`.
            let seen = ints_new();
            let work = ints_new();
            ints_push(work, to);
            let mut back = false;
            while ints_len(work) > 0 {
                let f = ints_pop(work);
                if f == from { back = true; }
                if contains(seen, f) == false {
                    ints_push(seen, f);
                    let mut x = 0;
                    while x < ints_len(efrom) {
                        if ints_get(efrom, x) == f { ints_push(work, ints_get(eto, x)); }
                        x = x + 1;
                    }
                }
            }
            if back {
                refuse_as("N0357", str_concat(str_concat("`", strs_get(fnames, to)),
                        "` is called with a type argument built from its caller's own, so every instance of it needs a larger one"),
                        position(src, path, ints_get(nst, ints_get(enode, e))));
            }
        }
        e = e + 1;
    }
    0
}

// --- recursion ------------------------------------------------------------------------
//
// The refusal `nazm-lir::lower::report_cycles` makes, made here for the same reason and
// with the same code: this backend emits one native call per call and has no plan for the
// stack a recursive one needs, so it refuses rather than emitting something it cannot
// bound. `nazm run` still runs recursive programs, with a bounded call depth. This is not
// a language rule — `nazm check` accepts recursion, and the specification allows it.
//
// Every *declared* function, not only the reachable ones. Checking reachability would
// mean that deleting a call somewhere else could change whether a function is diagnosed:
// a language-visible rule arriving as a side effect of a backend limitation.
//
// Direct and mutual recursion are one condition found one way, and a cycle that passes
// through a `spawn` is the same condition again: a task is an edge like any other, and
// going through a thread does not bound the stack.
//
// One difference from the reference, and it is a reporting difference rather than a
// contract one: this refuses at the first cycle it finds, where the reference collects
// one diagnostic per function. The set of programs refused is the same.
fn refuse_recursion(src: Str, path: Str, nk: Ints, nst: Ints, ntx: Strs, parent: Ints,
        ncallee: Ints, fnames: Strs, fowner: Ints, mstart: Ints) -> Int {
    // Which function each `fn` node is, by the same rule everything else uses: the
    // definition its own module makes under its name. Counting `fn` nodes in order would
    // have been equivalent until a declaration could be refused and skipped, and a call
    // graph built on a stale numbering names the wrong function.
    let fnof = ints_new();
    let mut k = 0;
    while k < ints_len(nk) {
        ints_push(fnof, 0 - 1);
        k = k + 1;
    }
    k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_fn() {
            ints_set(fnof, k, owned_index(fnames, fowner,
                    module_at(mstart, ints_get(nst, k)), fn_name(strs_get(ntx, k))));
        }
        k = k + 1;
    }

    // One edge per call to a user function, carrying the call's own offset so the refusal
    // points at the call rather than at the function.
    let efrom = ints_new();
    let eto = ints_new();
    let eat = ints_new();
    k = 0;
    while k < ints_len(nk) {
        let mut calls = false;
        if ints_get(nk, k) == n_call() { calls = true; }
        if ints_get(nk, k) == n_spawn() { calls = true; }
        if calls {
            // The callee the **checker** resolved, not a name looked up again here. A
            // built-in is `-2` and is not an edge: it is emitted as instructions, and
            // instructions do not recurse.
            let to = ints_get(ncallee, k);
            if to >= 0 {
                // The function this call sits in, found by walking parents with a loop.
                // A compiler about to refuse recursion should not need it to say so.
                let mut up = k;
                let mut from = 0 - 1;
                while up >= 0 {
                    if ints_get(nk, up) == n_fn() {
                        from = ints_get(fnof, up);
                        up = 0 - 1;
                    } else {
                        up = ints_get(parent, up);
                    }
                }
                if from >= 0 {
                    ints_push(efrom, from);
                    ints_push(eto, to);
                    ints_push(eat, ints_get(nst, k));
                }
            }
        }
        k = k + 1;
    }

    // Depth-first search with an explicit stack: 0 unvisited, 1 on the current path,
    // 2 finished. An edge to a function already on the path closes a cycle.
    let mark = ints_new();
    let mut i = 0;
    while i < strs_len(fnames) {
        ints_push(mark, 0);
        i = i + 1;
    }
    let stack = ints_new();
    let cursor = ints_new();
    let mut root = 0;
    while root < strs_len(fnames) {
        if ints_get(mark, root) == 0 {
            ints_push(stack, root);
            ints_push(cursor, 0);
            ints_set(mark, root, 1);
            while ints_len(stack) > 0 {
                let top = ints_len(stack) - 1;
                let node = ints_get(stack, top);
                // The next edge out of `node`: one flat edge list, scanned forward from
                // where this frame left off. The graph is small, and three arrays read
                // more plainly than a bucketed one.
                let mut e = ints_get(cursor, top);
                let mut at = 0 - 1;
                while e < ints_len(efrom) {
                    if ints_get(efrom, e) == node {
                        at = e;
                        e = ints_len(efrom);
                    } else {
                        e = e + 1;
                    }
                }
                if at < 0 {
                    ints_set(mark, node, 2);
                    ints_pop(stack);
                    ints_pop(cursor);
                } else {
                    ints_set(cursor, top, at + 1);
                    let to = ints_get(eto, at);
                    let m = ints_get(mark, to);
                    if m == 1 {
                        let name = strs_get(fnames, to);
                        let mut what = str_concat(str_concat("a call cycle through `", name), "`");
                        if to == node {
                            what = str_concat(str_concat("a call to `", name), "` from inside itself");
                        }
                        refuse(str_concat(what, " is not in this backend's subset yet"),
                                position(src, path, ints_get(eat, at)));
                    }
                    if m == 0 {
                        ints_push(stack, to);
                        ints_push(cursor, 0);
                        ints_set(mark, to, 1);
                    }
                }
            }
        }
        root = root + 1;
    }
    0
}

fn emit_module(src: Str, path: Str, nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs,
        naux: Ints, nslot: Ints, ntype: Ints, ncallee: Ints,
        parent: Ints, childno: Ints, substart: Ints, kids: Ints, kid_first: Ints,
        fnames: Strs, fret: Ints, fowner: Ints, mstart: Ints,
        out: Strs, msgs: Strs, blobs: Strs, tasks: Strs, blocks: Strs, nrec: Ints, rowns: Ints,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints,
        lo: Int, hi: Int, me_sym: Str, ninst: Ints, generic_fn: Ints, tb: Table) -> Int {
    let next = ints_new();
    ints_push(next, 0);
    // Slot 1 is the block-label counter, separate from slot 0 because the labels are
    // *named* — `b7:`, not `7:` — so LLVM never counts them. Drawing both from one
    // counter left holes in the value sequence, and clang 17 rejects a function that
    // emits `%5` where the implicit counter is still at 3. The two cannot collide: one
    // only ever prints after `%`, the other after `b`.
    ints_push(next, 0);
    let vals = ints_new();

    // Where each function's `define` must be opened: before its subtree begins, since
    // a post-order scan reaches the `fn` node only after its whole body.
    let fn_at = ints_new();
    let mut f = 0;
    while f < ints_len(nk) {
        ints_push(fn_at, 0 - 1);
        f = f + 1;
    }
    f = 0;
    while f < ints_len(nk) {
        if ints_get(nk, f) == n_fn() {
            ints_set(fn_at, ints_get(substart, f), f);
        }
        f = f + 1;
    }

    // Where the loop header of each `while` must be opened: before its condition's
    // subtree begins, because `continue` and the back edge both target it.
    let head_at = ints_new();
    // Where a scope's task list has to be allocated: at the first node of its body.
    let scope_at = ints_new();
    let mut h = 0;
    while h < ints_len(nk) {
        ints_push(head_at, 0 - 1);
        ints_push(scope_at, 0 - 1);
        h = h + 1;
    }
    h = 0;
    while h < ints_len(nk) {
        if ints_get(nk, h) == n_while() {
            let cond = ints_get(kids, ints_get(kid_first, h));
            ints_set(head_at, ints_get(substart, cond), h);
        }
        if ints_get(nk, h) == n_scope() {
            let body = ints_get(kids, ints_get(kid_first, h));
            ints_set(scope_at, ints_get(substart, body), h);
        }
        h = h + 1;
    }

    let current = strs_new();
    strs_push(current, "entry");
    // The state of the block being written, in the one array already threaded to every
    // emitter that opens or closes one — which is why the failure protocol lives here
    // rather than in eleven more parameters.
    //
    //   0  whether the current block can still take instructions
    //   1  whether anything in this function has branched to `%nz.unwind`, so the block
    //      is written only when something reaches it
    let live = ints_new();
    ints_push(live, 1);
    ints_push(live, 0);
    // The current function's ownership state: what each slot must release on the way out,
    // and which SSA values hold a reference nobody has taken over yet. Both are cleared at
    // every `define`, because neither means anything across a function boundary.
    let frame = ints_new();
    let owned = ints_new();
    // The type of each entry in `owned`, in lockstep. A release needs a type, and the
    // place that needs it — a failure leaving the function with a temporary in hand — has
    // only the number.
    let otype = ints_new();
    // How long `owned` was when each branch opened, innermost last. See the boundary
    // between two children below.
    let own_base = ints_new();
    // How long `owned` and `mslots` were when each **loop** started, innermost last.
    // `own_base` cannot answer this: inside an arm its top is the arm's base, and a
    // `break` there is leaving the whole loop, temporaries the loop body produced before
    // the `match` included.
    let loop_own = ints_new();
    let loop_m = ints_new();
    // And where the open scopes stood in `live`: a `break` joins the scopes opened
    // **inside** the loop, and the ones around it are still running.
    let loop_scope = ints_new();
    // The slots of the `match`es currently holding a value, innermost last, with their
    // scrutinee types beside them.
    let mslots = ints_new();
    let mstyp = ints_new();
    // One entry per branch that reached its join with a value, holding the value and the
    // block it came from. `nin` says how many each `if` or `match` received, because a
    // branch that transferred contributes **nothing** — not a stand-in for the value it
    // never produced.
    let phi_val = ints_new();
    let phi_blk = strs_new();
    // The function being emitted: `?` returns in its declared `Result`, which is on its node.
    let cur_fn = ints_new();
    ints_push(cur_fn, 0 - 1);

    // --- what is reachable ---------------------------------------------------------
    //
    // A post-order scan reaches every node, and control does not. `break`, `continue`
    // and `return` end the block they are in, and a value position may contain one — an
    // argument, an operand, an initialiser — so the rest of the enclosing expression is
    // on no path at all. The reference's `Val::Transferred`.
    //
    // **Whether the current block is live is the one answer.** A node reached while it is
    // not was never evaluated: nothing is emitted for it and what its operands left on
    // `vals` is discarded — their ownership was settled by the transfer that ended the
    // block. Nothing reopens a block except a construct whose dispatch really was
    // emitted: `opened` records that, and `joined` whether any branch reached the join.
    // Until 2026-09-23 every join was opened unconditionally, so a construct whose every
    // branch left handed its parent an empty stack and the parent popped someone else's
    // value from it — `N0405` in this compiler, or a `void` operand in what it wrote.
    let depth_at = ints_new();
    let opened = ints_new();
    let joined = ints_new();
    let nin = ints_new();
    let mut each = 0;
    while each < ints_len(nk) {
        ints_push(depth_at, 0);
        ints_push(opened, 0);
        ints_push(joined, 0);
        ints_push(nin, 0);
        each = each + 1;
    }

    let mut k = lo;
    while k <= hi {
        // A generic function is not code until it is instantiated: the whole-program pass
        // steps over its subtree, and each instance is emitted from it afterwards, by a
        // pass over exactly that range with the types substituted.
        let mut skipped = false;
        if me_sym == "" {
            if ints_get(fn_at, k) >= 0 {
                if ints_get(generic_fn, ints_get(fn_at, k)) == 1 { skipped = true; }
            }
        }
        if skipped {
            k = ints_get(fn_at, k) + 1;
            continue;
        }
        let kind = ints_get(nk, k);
        let from = ints_get(nst, k);
        let text = strs_get(ntx, k);

        // A function's definition opens before its body, for the same reason.
        if ints_get(fn_at, k) >= 0 {
            ints_set(cur_fn, 0, ints_get(fn_at, k));
            open_function(out, current, live, next, vals, nk, nar, nst, ntx, nslot, ntype,
                    kids, kid_first, fnames, fowner, mstart, frame, owned,
                    ints_get(fn_at, k), k, src, path, rowns, nrec, otype,
                    rfirst, rcount, rftype, me_sym);
        }

        // How deep the value stack was when the scan arrived here, which is where every
        // node whose subtree starts here found it: what an unreachable node's operands left
        // above this is theirs to discard.
        ints_set(depth_at, k, ints_len(vals));

        // A loop header opens before its condition, never after: `continue` and the back
        // edge both target it, so the condition is re-evaluated on every iteration. Only if
        // the loop is reached — nothing inside an unreachable one can reach its header.
        if ints_get(head_at, k) >= 0 {
            if ints_get(live, 0) == 1 {
                let w = ints_get(head_at, k);
                branch(out, live, blk("h", w));
                open_block(out, current, live, blk("h", w));
            }
        }

        // A scope's task list is allocated before its body, so every `spawn` inside has
        // somewhere to record itself and the join afterwards has something to read. The
        // list is an ordinary sequence header — a task handle is pointer-sized, and a
        // growable array of them is what `@nz.arr_new` already provides. A scope inside a
        // loop allocates a fresh one each time round, because the statement is reached
        // each time round.
        if ints_get(scope_at, k) >= 0 {
            if ints_get(live, 0) == 1 {
                let sc = ints_get(scope_at, k);
                ints_set(opened, sc, 1);
                let tl = take_number(next);
                add_line(out, str_concat(str_concat("  ", v(tl)), " = call ptr @nz.arr_new()"));
                let nomem = take_number(next);
                add_line(out, str_concat(str_concat("  ", v(nomem)),
                        str_concat(" = icmp eq ptr ", str_concat(v(tl), ", null"))));
                guard(out, msgs, next, current, live, nomem, "N0406", "out of memory",
                        position(src, path, ints_get(nst, sc)), owned, otype, rowns);
                // Innermost last: `unwind` reads back from the end, and a `spawn` records into
                // whichever is on top.
                ints_push(live, tl);
            }
        }

        if kind == n_scope() {
            // The closing brace: wait for every task, take on the first failure any of
            // them had, and only then decide whether this program carries on. A scope that
            // was never entered allocated no list; one whose body left has nothing after
            // it to join from, and its list is only this compiler's bookkeeping.
            if ints_get(opened, k) == 1 {
                let closed = ints_pop(live);
                if ints_get(live, 0) == 1 {
                    emit_join(out, next, current, live, closed);
                    check_failed(out, next, current, live, owned, otype, rowns);
                }
            }
        } else {
            if unreachable_here(live, kind) {
                // Never evaluated, so nothing is emitted — no call with an argument missing,
                // no store of a value nobody produced, no arithmetic on half its operands.
                // The operands that did finish before control left are discarded here; the
                // transfer already gave back what they held.
                let floor = ints_get(depth_at, ints_get(substart, k));
                while ints_len(vals) > floor { ints_pop(vals); }
            } else {
                if kind == n_spawn() {
                    emit_spawn(out, msgs, next, current, live, tasks, blocks, owned, vals, nar, ntype,
                            kids, kid_first, fnames, fret, k, ints_get(ncallee, k),
                            position(src, path, from), rowns, otype);
                } else {
                    if emit_record_node(out, next, vals, owned, nk, nar, ntx, ntype, nrec,
                            nslot, kids, kid_first, k, rowns, rfirst, rcount, rfname,
                            rftype, otype, phi_val, phi_blk, nin,
                            current, live, frame, current_return(nrec, cur_fn)) == 1 {
                        // A declaration, a construction, a projection, or a `match`.
                    } else {
                        if kind == n_param() {
                            // Handled by `open_function`, which stored it before the body began.
                        } else {
                            if kind == n_call() {
                                let argc = ints_get(nar, k);
                                let args = ints_new();
                                let mut a = 0;
                                while a < argc { ints_push(args, ints_pop(vals)); a = a + 1; }
                                // A built-in is instructions, not a call: `emit_builtin` returns -1 when
                                // the name is not one, which is how a built-in is told from a user function
                                // without a second name table.
                                let ordered = ints_new();
                                let mut o = argc - 1;
                                while o >= 0 { ints_push(ordered, ints_get(args, o)); o = o - 1; }
                                let callee = before_bracket(text);
                                let mut built = 0 - 1;
                                if is_vec_op(callee) {
                                    // A `Vec` operation is instructions over its element's layout,
                                    // which is the call's own type — or its first argument's.
                                    let mut vt = ints_get(ntype, k);
                                    if callee != "vec_new" {
                                        vt = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
                                    }
                                    built = emit_vec_op(callee, ordered, vt, tb, owned, out, msgs,
                                            next, current, live, position(src, path, from), rowns, otype);
                                } else {
                                    built = emit_builtin(callee, ordered, owned, out, msgs, next, current,
                                            live, position(src, path, from), rowns, otype);
                                }
                                if built >= 0 {
                                    // A built-in borrows its arguments, exactly as a function does,
                                    // so a temporary handed to one is nobody's after it returns.
                                    drop_arguments(out, next, owned, ordered, ntype, kids, kid_first, k, argc, rowns, otype);
                                    ints_push(vals, built);
                                } else {
                                    let mut list = "";
                                    a = argc - 1;
                                    while a >= 0 {
                                        if a < argc - 1 { list = str_concat(list, ", "); }
                                        let at = ints_get(ntype, ints_get(kids, ints_get(kid_first, k) + (argc - 1 - a)));
                                        list = str_concat(list, str_concat(str_concat(llvm_type(at), " "),
                                                v(ints_get(args, a))));
                                        a = a - 1;
                                    }
                                    let n = take_number(next);
                                    add_line(out, str_concat(str_concat("  ", v(n)),
                                            str_concat(str_concat(str_concat(" = call ", llvm_type(ints_get(ntype, k))),
                                            str_concat(" ", callee_symbol(ncallee, ninst, k))),
                                            str_concat(str_concat("(", list), ")"))));
                                    // A callee that failed has already left by its own exit and handed
                                    // back a stand-in. Noticed here, so the failure keeps travelling
                                    // outward instead of this function carrying on with a value that was
                                    // never produced — which would run statements, print, and could loop
                                    // forever on it.
                                    check_failed(out, next, current, live, owned, otype, rowns);
                                    // Rule 3: returning transfers, so what came back is a reference
                                    // this expression now holds. Rule 2: the arguments were only
                                    // borrowed, so a temporary passed in is still nobody's and is
                                    // dropped here.
                                    if owns_anything(ints_get(ntype, k), rowns) { own_add(owned, otype, n, ints_get(ntype, k)); }
                                    drop_arguments(out, next, owned, ordered, ntype, kids, kid_first, k, argc, rowns, otype);
                                    ints_push(vals, n);
                                }
                            } else {
                                if kind == n_str() {
                                    // A literal is known entirely at compile time, so it is a constant pair
                                    // loaded in one instruction rather than assembled from `undef`.
                                    let idx = message_index(blobs, text);
                                    let n = take_number(next);
                                    add_line(out, str_concat(str_concat("  ", v(n)),
                                            str_concat(" = load { ptr, i64, ptr }, ptr @.sv",
                                            int_to_str(idx))));
                                    ints_push(vals, n);
                                } else {
                                    if kind == n_bool() {
                                        let n = take_number(next);
                                        add_line(out, str_concat(str_concat("  ", v(n)),
                                                str_concat(" = or i1 ", str_concat(text, ", false"))));
                                        ints_push(vals, n);
                                    } else {
                                        if block_like(kind) {
                                            // Structure only: a block's value, if it has one, is its tail's and is
                                            // already on the stack — whether the block is a body, a branch, or an
                                            // operand written as a block.
                                        } else {
                                            if kind == n_while() {
                                                // Structure only: the header, the body and the exit are opened at the
                                                // boundaries between its children.
                                            } else {
                                                if kind == n_if() {
                                                    if ints_get(ntype, k) != 0 {
                                                        // Only the branches that reached the join contribute, and each
                                                        // names the block emission *ended* in rather than the label the
                                                        // branch was opened with. The join is open, so at least one did.
                                                        ints_push(vals, emit_phi(out, next, owned, otype, rowns,
                                                                phi_val, phi_blk, ints_get(nin, k), ints_get(ntype, k)));
                                                    }
                                                } else {
                                                    if kind == n_break() {
                                                        let w = enclosing_loop(nk, parent, childno, k);
                                                        if w < 0 { refuse("a `break` with no loop to leave", position(src, path, from)); }
                                                        // The expression this is leaving never finishes, so what it
                                                        // was holding is nobody's: the temporaries this loop produced
                                                        // and the values the `match`es inside it hold.
                                                        leave_loop(out, next, owned, otype, rowns, mslots, mstyp,
                                                                loop_own, loop_m);
                                                        // And the scopes opened inside the loop are joined, innermost
                                                        // first: leaving one is one of the ways out of it.
                                                        join_from(out, next, current, live,
                                                                ints_get(loop_scope, ints_len(loop_scope) - 1));
                                                        branch(out, live, blk("x", w));
                                                    } else {
                                                        if kind == n_continue() {
                                                            let w = enclosing_loop(nk, parent, childno, k);
                                                            if w < 0 { refuse("a `continue` with no loop to repeat", position(src, path, from)); }
                                                            leave_loop(out, next, owned, otype, rowns, mslots, mstyp,
                                                                    loop_own, loop_m);
                                                            join_from(out, next, current, live,
                                                                    ints_get(loop_scope, ints_len(loop_scope) - 1));
                                                            // The header, never the body: `continue` re-evaluates the condition.
                                                            branch(out, live, blk("h", w));
                                                        } else {
                                                            if kind == n_return() {
                                                                let value = ints_pop(vals);
                                                                let vt = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
                                                                // Every scope still open is left, so every one is
                                                                // joined first — the reference's `join_through(0)`.
                                                                // A task's failure is taken on here and reported by
                                                                // the caller's check after the call returns.
                                                                join_from(out, next, current, live, 2);
                                                                // Rule 3. The caller receives a reference that
                                                                // outlives this frame, so it is taken over
                                                                // **before** the frame lets go of everything else
                                                                // — otherwise returning a local would release the
                                                                // storage it is returning.
                                                                own_keep(out, next, owned, value, vt, rowns, otype);
                                                                // Taken over first, so releasing what this
                                                                // statement still holds cannot reach the value
                                                                // being returned. The slots are the frame's and
                                                                // go just below.
                                                                release_temporaries(out, next, owned, otype, rowns);
                                                                release_frame(out, next, frame, rowns);
                                                                add_line(out, str_concat(str_concat("  ret ", llvm_type(vt)), str_concat(" ", v(value))));
                                                                ints_set(live, 0, 0);
                                                            } else {
                                                                if kind == n_var() {
                                                                    let n = take_number(next);
                                                                    add_line(out, str_concat(str_concat("  ", v(n)),
                                                                            str_concat(str_concat(" = load ", llvm_type(ints_get(ntype, k))),
                                                                            str_concat(", ptr %slot", int_to_str(ints_get(nslot, k))))));
                                                                    ints_push(vals, n);
                                                                } else {
                                                                    if kind == n_let() {
                                                                        // The value is already on the stack: its subtree came first.
                                                                        let value = ints_pop(vals);
                                                                        let vt = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
                                                                        store_binding(out, next, owned, value, vt, ints_get(nslot, k), rowns, otype);
                                                                    } else {
                                                                        if kind == n_assign() {
                                                                            // The same store as a `let`, when the place is a plain binding: a
                                                                            // declaration and a reassignment differ in the source and not once the
                                                                            // slot is known, so there is one code path rather than two.
                                                                            let value = ints_pop(vals);
                                                                            let vt = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
                                                                            if path_length(text) == 0 {
                                                                                store_binding(out, next, owned, value, vt, ints_get(nslot, k), rowns, otype);
                                                                            } else {
                                                                                set_field(out, next, owned, value, vt, ints_get(nslot, k),
                                                                                        ints_get(nrec, k), text, rowns,
                                                                                        rfirst, rcount, rfname, rftype, otype);
                                                                            }
                                                                        } else {
                                                                            if kind == n_exprstmt() {
                                                                                // Evaluated for its effects; the value is dropped, exactly as `nazm run`
                                                                                // drops it. **Only if there was one**: a statement-position `if` produces
                                                                                // nothing, and popping for it would take someone else's value.
                                                                                if ints_get(ntype, ints_get(kids, ints_get(kid_first, k))) != 0 {
                                                                                    let dropped = ints_pop(vals);
                                                                                    own_drop(out, next, owned, dropped,
                                                                                            ints_get(ntype, ints_get(kids, ints_get(kid_first, k))), rowns, otype);
                                                                                }
                                                                            } else {
                                                                                if kind == n_int() {
                                                                                    let n = take_number(next);
                                                                                    // Through an `add` rather than inline, so every expression has a value
                                                                                    // number and there is one shape to reason about. `-O2` folds it.
                                                                                    add_line(out, str_concat(str_concat("  ", v(n)),
                                                                                            str_concat(" = add i64 ", str_concat(text, ", 0"))));
                                                                                    ints_push(vals, n);
                                                                                } else {
                                                                                    if kind == n_bin() {
                                                                                        let b = ints_pop(vals);
                                                                                        let a = ints_pop(vals);
                                                                                        let at = position(src, path, ints_get(naux, k));
                                                                                        // The operand type, not the result's: `==` always produces `Bool`, and
                                                                                        // what it compares decides how.
                                                                                        let ot = ints_get(ntype, ints_get(kids, ints_get(kid_first, k)));
                                                                                        let r = if ot == t_str() {
                                                                                            string_equality(out, current, live, next, a, b, text == "!=")
                                                                                        } else {
                                                                                            emit_binary(out, msgs, next, current, live, text, a, b, at, ot, owned, otype, rowns)
                                                                                        };
                                                                                        if r < 0 { refuse(str_concat(str_concat("the operator `", text), "`"), at); }
                                                                                        // Rule 2: a comparison borrows its operands, as a call
                                                                                        // does, so a string compared is nobody's once the
                                                                                        // answer exists. Leaked on every evaluation until N10.1.
                                                                                        if ot == t_str() {
                                                                                            own_drop(out, next, owned, a, ot, rowns, otype);
                                                                                            own_drop(out, next, owned, b, ot, rowns, otype);
                                                                                        }
                                                                                        ints_push(vals, r);
                                                                                    } else {
                                                                                        if kind == n_neg() {
                                                                                            let a = ints_pop(vals);
                                                                                            let zero = take_number(next);
                                                                                            add_line(out, str_concat(str_concat("  ", v(zero)), " = add i64 0, 0"));
                                                                                            let at = position(src, path, from);
                                                                                            // The only negation without a representable result is `-Int::MIN`.
                                                                                            let r = checked(out, msgs, next, current, live, "ssub", "negation", zero, a, at, owned, otype, rowns);
                                                                                            ints_push(vals, r);
                                                                                        } else {
                                                                                            if kind == n_block() {
                                                                                                if text != "tail" {
                                                                                                    refuse("a body with no result expression",
                                                                                                            position(src, path, from));
                                                                                                }
                                                                                            } else {
                                                                                                if kind == n_fn() {
                                                                                                    if llvm_type(ints_get(nrec, k)) == "void" {
                                                                                                        refuse(str_concat(str_concat("a function returning `",
                                                                                                                before_at(after_colon(text))), "`"),
                                                                                                                position(src, path, from));
                                                                                                    }
                                                                                                    // The platform wrapper prints an `Int`, so `main` must
                                                                                                    // produce one. What a `Str` result would mean for a process
                                                                                                    // is a decision nobody has made.
                                                                                                    if fn_name(text) == "main" {
                                                                                                        if before_at(after_colon(text)) != "Int" {
                                                                                                            refuse("a `main` that does not return `Int`",
                                                                                                                    position(src, path, from));
                                                                                                        }
                                                                                                    }
                                                                                                    // A body whose every path returned has nothing to fall off
                                                                                                    // the end with and needs no terminator of its own — the
                                                                                                    // `ret` is already there.
                                                                                                    if ints_get(live, 0) == 1 {
                                                                                                        if ints_len(vals) != 1 {
                                                                                                            refuse("a body that produces no value",
                                                                                                                    position(src, path, from));
                                                                                                        }
                                                                                                        // The tail is a `return` without the keyword, and it obeys the same two
                                                                                                        // rules: take the reference the caller is about to receive, then let the
                                                                                                        // frame go.
                                                                                                        let tv = ints_pop(vals);
                                                                                                        own_keep(out, next, owned, tv, ints_get(nrec, k), rowns, otype);
                                                                                                        release_frame(out, next, frame, rowns);
                                                                                                        add_line(out, str_concat(str_concat("  ret ",
                                                                                                                llvm_type(ints_get(nrec, k))),
                                                                                                                str_concat(" ", v(tv))));
                                                                                                    }
                                                                                                    // The one exit every failure in this function leaves by,
                                                                                                    // written only if something branched to it.
                                                                                                    if ints_get(live, 1) == 1 {
                                                                                                        let rt = ints_get(nrec, k);
                                                                                                        add_line(out, "nz.unwind:");
                                                                                                        // A failure leaves through here from anywhere in the function, so this is
                                                                                                        // the one exit source indentation would never have found. A program that
                                                                                                        // failed still reclaims what it was holding.
                                                                                                        release_frame(out, next, frame, rowns);
                                                                                                        add_line(out, str_concat(str_concat("  ret ",
                                                                                                                llvm_type(rt)),
                                                                                                                str_concat(" ", unwind_value(rt))));
                                                                                                        ints_set(live, 1, 0);
                                                                                                    }
                                                                                                    add_line(out, "}");
                                                                                                    ints_set(live, 0, 0);
                                                                                                    // Values never cross a function boundary. A body that
                                                                                                    // returned on every path can leave some behind, and the
                                                                                                    // next function would inherit them.
                                                                                                    while ints_len(vals) > 0 { ints_pop(vals); }
                                                                                                } else {
                                                                                                    if kind != n_program() {
                                                                                                        refuse(str_concat(str_concat("`", node_name(kind)), "`"),
                                                                                                                position(src, path, from));
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- the boundary between two children ------------------------------------
        //
        // A post-order scan reaches a node after its children, so this is where a
        // branch and a label go: between the condition and the branch that depends on
        // it, and between one branch and the next.
        let p = ints_get(parent, k);
        if p >= 0 {
            let pk = ints_get(nk, p);
            let which = ints_get(childno, k);
            let parity = ints_get(nar, p);

            if pk == n_while() {
                if which == 0 {
                    // A condition that left on every path — `while (if c { break; } else
                    // { continue; })`, which belongs to the loop around this one — has no
                    // value to test, so there is no body to enter and no exit to reach.
                    if ints_get(live, 0) == 1 {
                        let c = ints_pop(vals);
                        add_line(out, str_concat(str_concat("  br i1 ", v(c)),
                                str_concat(str_concat(", label %", blk("y", p)),
                                str_concat(", label %", blk("x", p)))));
                        open_block(out, current, live, blk("y", p));
                        ints_set(opened, p, 1);
                        // The body's temporaries do not dominate the exit either.
                        ints_push(own_base, ints_len(owned));
                        ints_push(loop_own, ints_len(owned));
                        ints_push(loop_m, ints_len(mslots));
                        ints_push(loop_scope, ints_len(live));
                    }
                } else {
                    if ints_get(opened, p) == 1 {
                        // The back edge targets the header, so the condition runs again.
                        branch(out, live, blk("h", p));
                        let base = ints_get(own_base, ints_len(own_base) - 1);
                        while ints_len(owned) > base {
                            ints_pop(owned);
                            ints_pop(otype);
                        }
                        ints_pop(own_base);
                        ints_pop(loop_own);
                        ints_pop(loop_m);
                        ints_pop(loop_scope);
                        // Reached whenever the condition was tested: its false edge.
                        open_block(out, current, live, blk("x", p));
                    }
                }
            }

            if pk == n_match() {
                let mslot = ints_get(nslot, p);
                let et = ints_get(ntype, ints_get(kids, ints_get(kid_first, p)));
                if which == 0 {
                    // A scrutinee that left has no value: no slot is written, no
                    // discriminant read, and no arm is reachable.
                    if ints_get(live, 0) == 1 {
                        ints_set(opened, p, 1);
                        // The scrutinee is complete. The `match` takes it over — a temporary
                        // is already owned and a binding is borrowed, and `own_keep` settles
                        // the difference — and from here the slot holds the reference, so
                        // every exit releases it exactly once.
                        let sv = ints_pop(vals);
                        own_keep(out, next, owned, sv, et, rowns, otype);
                        add_line(out, str_concat(str_concat(str_concat("  store ", llvm_type(et)),
                                str_concat(" ", v(sv))),
                                str_concat(", ptr %slot", int_to_str(mslot))));
                        let tag = take_number(next);
                        add_line(out, str_concat(str_concat("  ", v(tag)),
                                str_concat(str_concat(" = extractvalue ", llvm_type(et)),
                                str_concat(" ", str_concat(v(sv), ", 0")))));
                        // Checking has established that every variant has exactly one arm, so
                        // the default is unreachable for any value this program can build. It
                        // is the first arm rather than `unreachable`: a `switch` whose default
                        // is poison would turn a compiler mistake into undefined behaviour
                        // instead of a wrong answer.
                        let mut table = "";
                        let mut a = 1;
                        while a < parity {
                            let arm = ints_get(kids, ints_get(kid_first, p) + a);
                            let at = variant_tag(rfirst, rcount, rfname, rftype,
                                    record_of(et), ints_get(nrec, arm));
                            table = str_concat(str_concat(table, "i64 "),
                                    str_concat(str_concat(int_to_str(at), ", label %"),
                                    str_concat(blk("a", arm), " ")));
                            a = a + 1;
                        }
                        let first_arm = ints_get(kids, ints_get(kid_first, p) + 1);
                        add_line(out, str_concat(str_concat("  switch i64 ", v(tag)),
                                str_concat(str_concat(", label %", blk("a", first_arm)),
                                str_concat(" [ ", str_concat(table, "]")))));
                        open_block(out, current, live, blk("a", first_arm));
                        arm_bindings(out, next, ntx, nslot, nrec, first_arm, mslot, et,
                                owned, otype, rowns, rfirst, rcount, rfname, rftype);
                        // Held from here until the join, so a `break` or a `continue` out of
                        // an arm gives it back instead of leaving it for the next turn.
                        ints_push(mslots, mslot);
                        ints_push(mstyp, et);
                        // What an arm creates is not visible to its siblings, exactly as an
                        // `if` branch's is not.
                        ints_push(own_base, ints_len(owned));
                    }
                } else {
                    if ints_get(opened, p) == 1 {
                        if ints_get(live, 0) == 1 {
                            // An arm that left is not a predecessor of the join and hands it
                            // nothing; one that fell through is both.
                            ints_set(joined, p, 1);
                            if ints_get(ntype, p) != 0 {
                                // Each arm is brought to the same ownership state inside its own
                                // block and before its jump, which is the only place a retain can
                                // go — after the `phi` there is no arm left to attribute it to.
                                let av = ints_pop(vals);
                                own_keep(out, next, owned, av, ints_get(ntype, p), rowns, otype);
                                own_add(owned, otype, av, ints_get(ntype, p));
                                ints_push(phi_val, av);
                                strs_push(phi_blk, strs_get(current, 0));
                                ints_set(nin, p, ints_get(nin, p) + 1);
                            }
                            if ints_get(ntype, p) == 0 {
                                discard_branch_value(out, next, owned, otype, rowns, vals, ntype, k);
                            }
                        }
                        branch(out, live, blk("j", p));
                        let base = ints_get(own_base, ints_len(own_base) - 1);
                        while ints_len(owned) > base {
                            ints_pop(owned);
                            ints_pop(otype);
                        }
                        if which == parity - 1 {
                            ints_pop(own_base);
                            // No arm is inside it any more; the join below releases it.
                            ints_pop(mslots);
                            ints_pop(mstyp);
                            // Opened only if some arm reached it. Otherwise the `match` never
                            // completes and everything after it is on no path.
                            if ints_get(joined, p) == 1 {
                                open_block(out, current, live, blk("j", p));
                            }
                        } else {
                            let arm = ints_get(kids, ints_get(kid_first, p) + which + 1);
                            open_block(out, current, live, blk("a", arm));
                            arm_bindings(out, next, ntx, nslot, nrec, arm, mslot, et,
                                    owned, otype, rowns, rfirst, rcount, rfname, rftype);
                        }
                    }
                }
            }

            if pk == n_if() {
                if which == 0 {
                    // A condition that left has no value to branch on, so neither branch
                    // is reachable and the `if` never completes.
                    if ints_get(live, 0) == 1 {
                        let c = ints_pop(vals);
                        let other = if parity == 3 { blk("e", p) } else { blk("j", p) };
                        add_line(out, str_concat(str_concat("  br i1 ", v(c)),
                                str_concat(str_concat(", label %", blk("t", p)),
                                str_concat(", label %", other))));
                        open_block(out, current, live, blk("t", p));
                        ints_set(opened, p, 1);
                        // What a branch creates is **not visible to its sibling**, and that
                        // is a dominance fact rather than a preference: a value defined in
                        // the `then` block does not dominate the `else` block, so a failure
                        // over there may not release it. This is where the set's length
                        // before the branch is remembered; the boundary below restores it.
                        ints_push(own_base, ints_len(owned));
                    }
                } else {
                    if ints_get(opened, p) == 1 {
                        // The predecessor is read **after** the branch was emitted, not
                        // before: a branch may have opened blocks of its own for a nested
                        // `if` or a checked-arithmetic guard, and the block a `phi` must
                        // name is the one emission ended in.
                        //
                        // A branch that transferred ended in its own terminator. It is not
                        // a predecessor of the join and it produced nothing, so it adds no
                        // incoming — the `phi` is built from the branches that did.
                        if ints_get(live, 0) == 1 {
                            ints_set(joined, p, 1);
                            if ints_get(ntype, p) != 0 {
                                // A `phi` merges two branches that may have arrived at
                                // ownership differently — one side creating a reference,
                                // the other borrowing one — and a single value cannot be
                                // both. Each branch is brought to the same state here,
                                // **inside its own block and before its jump**, which is the
                                // only place a retain can go: after the `phi` there is no
                                // branch left to attribute it to.
                                let bv = ints_pop(vals);
                                own_keep(out, next, owned, bv, ints_get(ntype, p), rowns, otype);
                                own_add(owned, otype, bv, ints_get(ntype, p));
                                ints_push(phi_val, bv);
                                strs_push(phi_blk, strs_get(current, 0));
                                ints_set(nin, p, ints_get(nin, p) + 1);
                            }
                            if ints_get(ntype, p) == 0 {
                                discard_branch_value(out, next, owned, otype, rowns, vals, ntype, k);
                            }
                        }
                        branch(out, live, blk("j", p));
                        // Back to what was outstanding before the branch. The value this
                        // branch produced already holds its reference — `own_keep` above
                        // saw to that — and the `phi` at the join is what takes it over.
                        let base = ints_get(own_base, ints_len(own_base) - 1);
                        while ints_len(owned) > base {
                            ints_pop(owned);
                            ints_pop(otype);
                        }
                        if which == parity - 1 { ints_pop(own_base); }
                        if which == 1 {
                            // The condition's false edge reaches the `else`, or the join
                            // when there is none, whatever the `then` branch did.
                            if parity == 3 {
                                open_block(out, current, live, blk("e", p));
                            } else {
                                open_block(out, current, live, blk("j", p));
                            }
                        } else {
                            // Only if a branch reached it. Both leaving is the whole `if`
                            // leaving, and what contains it is on no path.
                            if ints_get(joined, p) == 1 {
                                open_block(out, current, live, blk("j", p));
                            }
                        }
                    }
                }
            }
        }

        k = k + 1;
    }

    ints_get(next, 0)
}

fn main() -> Int {
    // The core prelude is the toolchain's, not the project's, so it is named on the
    // command line rather than found beside the program: `library/core/prelude.nz` in this
    // repository, and whatever path a toolchain installs it at. It is read like any source
    // and checked like any module.
    if args_count() < 2 {
        eprint(str_concat("usage: emit FILE CORE-PRELUDE", nl()));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat(str_concat("cannot read ", path), nl()));
        exit_with(2);
    }
    // The root and everything it imports — and **which module is which**. The text is one
    // buffer for the passes that walk bytes; the module boundaries and the import edges
    // travel beside it, because a concatenation is not a module interface and nothing
    // semantic may ask it a question about ownership.
    let mpath = strs_new();
    let mstart = ints_new();
    let mfirst = ints_new();
    let mcount = ints_new();
    let mto = ints_new();
    let mat = ints_new();
    let src = attach_core(arg(1), load_modules(path, mpath, mstart, mfirst, mcount, mto, mat),
            mpath, mstart, mfirst, mcount, mto, mat);

    // The program's IR, or the diagnostics that stopped it before any was written.
    match emit_program(src, path, mpath, mstart, mfirst, mcount, mto, mat) {
        Result.Ok(value: ir) => print(ir),
        Result.Err(error: found) => refused(src, path, found),
    };
    // `exit_with`, not a return: the platform wrapper prints `main`'s value, and this
    // program's standard output *is* the LLVM module. A stray integer at the end of it
    // is a module clang rejects.
    exit_with(0);
    0
}

/// Every diagnostic that stopped a compilation, to standard error, and the exit that
/// says so. The IR was never written: a refusal after it was on standard output would be
/// one nobody could act on.
fn refused(src: Str, path: Str, diags: Vec[Diag]) -> Int {
    let mut d = 0;
    while d < vec_len(diags) {
        let one = vec_get(diags, d);
        eprint(str_concat(str_concat(str_concat("nazm: error[", one.code),
                str_concat("]: ", one.message)),
                str_concat(str_concat(" at ",
                position(src, path, one.start)), nl())));
        d = d + 1;
    }
    exit_with(1);
    1
}

/// Check a loaded program and emit it: the LLVM module, or every diagnostic the front end
/// found.
///
/// The front end is `check_program`, and `?` is how its failure leaves: a program that did
/// not check has no tables to emit from, so there is nothing to do here but hand its
/// diagnostics on. What emission itself refuses — a construct outside this backend's
/// subset, an instance limit — still stops the process where it is found, by the failure
/// protocol that has always owned it.
fn emit_program(src: Str, path: Str, mpath: Strs, mstart: Ints, mfirst: Ints, mcount: Ints,
        mto: Ints, mat: Ints) -> Result[Str, Vec[Diag]] {
    let checked = check_program(src, mpath, mstart, mfirst, mcount, mto, mat)?;
    let nk = checked.nk;
    let nar = checked.nar;
    let nst = checked.nst;
    let nen = checked.nen;
    let ntx = checked.ntx;
    let naux = checked.naux;
    let kids = checked.kids;
    let kid_first = checked.kid_first;
    let nslot = checked.nslot;
    let ntype = checked.ntype;
    let ncallee = checked.ncallee;
    let nrec = checked.nrec;
    let ntfirst = checked.ntfirst;
    let ntargs = checked.ntargs;
    let tb = checked.tb;
    let fnames = checked.fnames;
    let fret = checked.fret;
    let fowner = checked.fowner;
    let fgc = checked.fgc;
    let entry = checked.entry;
    let rnames = tb.names;
    let rkind = tb.kind;
    let rfirst = tb.first;
    let rcount = tb.count;
    let rfname = tb.fname;
    let rftype = tb.ftype;

    let body = strs_new();
    let msgs = strs_new();
    let blobs = strs_new();
    // One trampoline per `spawn` site, accumulated while the body is emitted and appended
    // after it. Its length is also how the runtime knows whether any of this is reached.
    let tasks = strs_new();
    // One named type per spawn site, for the block its arguments travel in.
    let blocks = strs_new();
    let parent = ints_new();
    let childno = ints_new();
    let substart = ints_new();
    build_relations(nk, nar, kids, kid_first, parent, childno, substart);
    // Before a single instruction is written: a refusal that arrived after the IR was on
    // stdout would be a refusal nobody could act on.
    refuse_expansion(src, path, nk, nst, ntx, parent, ncallee, fnames, fowner, fgc, mstart,
            tb, ntfirst, ntargs);
    refuse_recursion(src, path, nk, nst, ntx, parent, ncallee, fnames, fowner, mstart);

    // --- instances ------------------------------------------------------------------
    //
    // `nazm run` is parametric and this backend specialises: one native function per
    // generic function and concrete list of type arguments that the program reaches. Every
    // instance is planned before anything is emitted — a worklist from the calls that
    // concrete code makes, each instance adding the calls its body makes with its own
    // arguments substituted — and every type any instance mentions is interned then, so
    // the table is complete before a single layout or helper is written.
    //
    // `ninst[k]` is the instance a call node calls, in the whole-program pass; each
    // instance's own is in `icall`, beside the substituted `ntype`/`nrec` of every node of
    // its function, in `itype`/`irec` from `ibase[i]`.
    let generic_fn = ints_new();
    let encl = ints_new();
    let ninst = ints_new();
    let mut gi = 0;
    while gi < ints_len(nk) {
        ints_push(generic_fn, 0);
        ints_push(encl, 0 - 1);
        ints_push(ninst, 0 - 1);
        gi = gi + 1;
    }
    let fnode_of = ints_new();
    gi = 0;
    while gi < strs_len(fnames) { ints_push(fnode_of, 0 - 1); gi = gi + 1; }
    gi = 0;
    while gi < ints_len(nk) {
        if ints_get(nk, gi) == n_fn() {
            let f = owned_index(fnames, fowner, module_at(mstart, ints_get(nst, gi)),
                    fn_name(strs_get(ntx, gi)));
            if f >= 0 {
                ints_set(fnode_of, f, gi);
                if ints_get(fgc, f) > 0 { ints_set(generic_fn, gi, 1); }
            }
            let mut j = ints_get(substart, gi);
            while j <= gi { ints_set(encl, j, gi); j = j + 1; }
        }
        gi = gi + 1;
    }
    let inst_fn = ints_new();
    let inst_first = ints_new();
    let inst_args = ints_new();
    let ibase = ints_new();
    let itype = ints_new();
    let irec = ints_new();
    let icall = ints_new();
    gi = 0;
    while gi < ints_len(nk) {
        let gk = ints_get(nk, gi);
        let mut calls = false;
        if gk == n_call() { calls = true; }
        if gk == n_spawn() { calls = true; }
        if calls {
            let f = ints_get(ncallee, gi);
            let mut concrete_site = true;
            if ints_get(encl, gi) >= 0 {
                if ints_get(generic_fn, ints_get(encl, gi)) == 1 { concrete_site = false; }
            }
            if f >= 0 {
                if ints_get(fgc, f) > 0 {
                    if concrete_site {
                        let args = node_types(ntfirst, ntargs, gi);
                        ints_set(ninst, gi, request_instance(ints_get(fnode_of, f), args,
                                inst_fn, inst_first, inst_args, tb, src, path,
                                ints_get(nst, gi)));
                    }
                }
            }
        }
        gi = gi + 1;
    }
    let mut ii = 0;
    while ii < ints_len(inst_fn) {
        let fnn = ints_get(inst_fn, ii);
        let params = node_types(ntfirst, ntargs, fnn);
        let args = ints_new();
        let mut q = 0;
        while q < ints_len(params) {
            ints_push(args, ints_get(inst_args, ints_get(inst_first, ii) + q));
            q = q + 1;
        }
        ints_push(ibase, ints_len(itype));
        let mut j = ints_get(substart, fnn);
        while j <= fnn {
            let jk = ints_get(nk, j);
            ints_push(itype, substitute(tb, ints_get(ntype, j), params, args));
            let mut rec = ints_get(nrec, j);
            let mut is_type = false;
            if jk == n_fn() { is_type = true; }
            if jk == n_param() { is_type = true; }
            if jk == n_assign() { is_type = true; }
            if is_type { rec = substitute(tb, rec, params, args); }
            if jk == n_construct() {
                if rec >= 0 { rec = record_of(substitute(tb, t_record(rec), params, args)); }
            }
            let mut variant = false;
            if jk == n_makevariant() { variant = true; }
            if jk == n_arm() { variant = true; }
            if jk == n_propagate() { variant = true; }
            if variant {
                if rec >= 0 {
                    // The same variant of the substituted enum: at the same distance from
                    // its enum as the definition's is from its own.
                    let e = enum_of_variant(rkind, rec);
                    rec = record_of(substitute(tb, t_record(e), params, args)) + (rec - e);
                }
            }
            ints_push(irec, rec);
            let mut callee_inst = 0 - 1;
            let mut calls = false;
            if jk == n_call() { calls = true; }
            if jk == n_spawn() { calls = true; }
            if calls {
                let f = ints_get(ncallee, j);
                if f >= 0 {
                    if ints_get(fgc, f) > 0 {
                        let written = node_types(ntfirst, ntargs, j);
                        let cargs = ints_new();
                        let mut w = 0;
                        while w < ints_len(written) {
                            ints_push(cargs, substitute(tb, ints_get(written, w), params, args));
                            w = w + 1;
                        }
                        callee_inst = request_instance(ints_get(fnode_of, f), cargs, inst_fn,
                                inst_first, inst_args, tb, src, path, ints_get(nst, j));
                    }
                }
            }
            ints_push(icall, callee_inst);
            j = j + 1;
        }
        settle_now(tb);
        ii = ii + 1;
    }

    // One word per entry: whether anything in it, at any depth, has to be released, and
    // how. `1` a record or a variant that does, `2` an enum that does — a record's helper
    // walks its fields and an enum's branches on its discriminant first — and `3` a `Vec`
    // whose elements own something. Computed after planning, because an instance's
    // entries are part of the program, and in entry order, because a `Vec`'s element is
    // always interned before it. Only for what is emitted: a generic definition as written,
    // and anything that still mentions a parameter, is not a native type.
    let rowns = ints_new();
    let mut r = 0;
    while r < strs_len(rnames) {
        let mut word = 0;
        if emittable(tb, r) {
            if ints_get(rkind, r) == rk_vec() {
                let elem = ints_get(tb.args, ints_get(tb.afirst, r));
                let mut owning = false;
                if elem == t_str() { owning = true; }
                if elem == t_ints() { owning = true; }
                if elem == t_strs() { owning = true; }
                if elem == t_chan() { owning = true; }
                if is_vec(elem) { owning = true; }
                if is_record(elem) {
                    if ints_get(rowns, record_of(elem)) != 0 { owning = true; }
                }
                if owning { word = 3; }
            } else {
                if needs_cleanup(t_record(r), rfirst, rcount, rftype) {
                    if ints_get(rkind, r) == rk_enum() { word = 2; } else { word = 1; }
                }
            }
        }
        ints_push(rowns, word);
        r = r + 1;
    }

    emit_module(src, path, nk, nar, nst, nen, ntx, naux, nslot, ntype, ncallee,
            parent, childno, substart, kids, kid_first, fnames, fret, fowner, mstart,
            body, msgs, blobs, tasks, blocks, nrec, rowns, rfirst, rcount, rfname, rftype,
            0, ints_len(nk) - 1, "", ninst, generic_fn, tb);
    // Each instance, from its definition's own nodes — spans and all, so a failure inside
    // one is reported at the generic definition's line — with the node types substituted.
    ii = 0;
    while ii < ints_len(inst_fn) {
        let fnn = ints_get(inst_fn, ii);
        let lo = ints_get(substart, fnn);
        let mut j = lo;
        while j <= fnn {
            let at = ints_get(ibase, ii) + (j - lo);
            ints_set(ntype, j, ints_get(itype, at));
            ints_set(nrec, j, ints_get(irec, at));
            ints_set(ninst, j, ints_get(icall, at));
            j = j + 1;
        }
        emit_module(src, path, nk, nar, nst, nen, ntx, naux, nslot, ntype, ncallee,
                parent, childno, substart, kids, kid_first, fnames, fret, fowner, mstart,
                body, msgs, blobs, tasks, blocks, nrec, rowns, rfirst, rcount, rfname, rftype,
                lo, fnn, str_concat("@nz.g", int_to_str(ii)), ninst, generic_fn, tb);
        ii = ii + 1;
    }

    // Whether this program can reach a channel. A `spawn` is not the only way: a program
    // may create one, send to it and receive from it without ever starting a task, and
    // until N8 such a program was emitted with no channel runtime at all and clang refused
    // it. The reference compiler decides this from what emission reached; this scans for
    // the call, which needs no state threaded through every emitter.
    let mut uses_channels = false;
    let mut ci = 0;
    while ci < ints_len(nk) {
        if ints_get(nk, ci) == n_call() {
            let nm = strs_get(ntx, ci);
            if str_len(nm) >= 5 {
                if str_slice(nm, 0, 5) == "chan_" { uses_channels = true; }
            }
        }
        ci = ci + 1;
    }
    let mut concurrent = uses_channels;
    if strs_len(tasks) > 0 { concurrent = true; }

    // The header comes last because interning the messages is what discovers them.
    let head = strs_new();
    add_line(head, "; Generated by the Nazm compiler, written in Nazm. Do not edit.");
    add_line(head, str_concat(str_concat(str_concat("source_filename = ", dq()), path), dq()));
    add_line(head, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)");
    add_line(head, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)");
    add_line(head, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)");
    add_line(head, "declare {i64, i1} @llvm.uadd.with.overflow.i64(i64, i64)");
    add_line(head, "declare {i64, i1} @llvm.umul.with.overflow.i64(i64, i64)");
    add_line(head, "declare i32 @printf(ptr noundef, ...)");
    add_line(head, "declare i64 @write(i32, ptr, i64)");
    add_line(head, "declare void @exit(i32) noreturn");
    // pthreads, declared only when a task or a channel reached them. A program with
    // neither neither declares them nor needs to be linked against them.
    if concurrent {
        add_line(head, "declare i32 @pthread_create(ptr, ptr, ptr, ptr)");
        add_line(head, "declare i32 @pthread_join(ptr, ptr)");
        add_line(head, "declare i32 @pthread_mutex_init(ptr, ptr)");
        add_line(head, "declare i32 @pthread_mutex_lock(ptr)");
        add_line(head, "declare i32 @pthread_mutex_unlock(ptr)");
        add_line(head, "declare i32 @pthread_cond_init(ptr, ptr)");
        add_line(head, "declare i32 @pthread_cond_wait(ptr, ptr)");
        add_line(head, "declare i32 @pthread_cond_broadcast(ptr)");
        add_line(head, "declare i32 @pthread_mutex_destroy(ptr)");
        add_line(head, "declare i32 @pthread_cond_destroy(ptr)");
    }
    // The record types this program declares, each as a named LLVM aggregate, in
    // **layout order** — canonical by field name, so moving two field declarations
    // changes no byte of this. Before anything that uses one: a named type referenced
    // before it is defined is opaque to LLVM's textual parser, and an opaque type has no
    // size.
    // Records and variants first, then enums: an enum's aggregate names its variants'
    // payload types, and a named type referenced before it is defined is opaque to LLVM's
    // textual parser — and an opaque type has no size.
    let mut rdef = 0;
    while rdef < strs_len(rnames) {
        let mut declares = emittable(tb, rdef);
        if ints_get(rkind, rdef) == rk_enum() { declares = false; }
        if ints_get(rkind, rdef) == rk_vec() { declares = false; }
        if declares {
            let mut fields = "";
            let mut pos = 0;
            while pos < ints_get(rcount, rdef) {
                if pos > 0 { fields = str_concat(fields, ", "); }
                let decl = layout_field(rfirst, rcount, rfname, rdef, pos);
                fields = str_concat(fields,
                        llvm_type(ints_get(rftype, ints_get(rfirst, rdef) + decl)));
                pos = pos + 1;
            }
            add_line(head, str_concat(str_concat(str_concat("%nz.t", int_to_str(rdef)),
                    str_concat(" = type { ", fields)), str_concat(" }    ; ",
                    strs_get(rnames, rdef))));
        }
        rdef = rdef + 1;
    }
    // An enum is a discriminant followed by **one slot per variant**, in canonical
    // variant-name order — so the slot's index is one past the tag, and moving two
    // variant declarations changes no byte of this. Larger than the union it stands for,
    // and deliberately so: correctness first, and `docs/performance.md` measures the cost.
    let mut edef = 0;
    while edef < strs_len(rnames) {
        let mut declares = false;
        if ints_get(rkind, edef) == rk_enum() { declares = emittable(tb, edef); }
        if declares {
            let mut slots = "i64";
            let mut pos = 0;
            while pos < ints_get(rcount, edef) {
                let decl = layout_field(rfirst, rcount, rfname, edef, pos);
                slots = str_concat(str_concat(slots, ", "),
                        llvm_type(ints_get(rftype, ints_get(rfirst, edef) + decl)));
                pos = pos + 1;
            }
            add_line(head, str_concat(str_concat(str_concat("%nz.t", int_to_str(edef)),
                    str_concat(" = type { ", slots)), str_concat(" }    ; ",
                    strs_get(rnames, edef))));
        }
        edef = edef + 1;
    }
    // The argument-block types, one per spawn site, after the user types they may name.
    let mut bl = 0;
    while bl < strs_len(blocks) {
        add_line(head, strs_get(blocks, bl));
        bl = bl + 1;
    }
    add_line(head, "declare i32 @memcmp(ptr, ptr, i64)");
    add_line(head, "declare i32 @snprintf(ptr noundef, i64, ptr noundef, ...)");
    add_line(head, "declare ptr @malloc(i64)");
    add_line(head, "declare ptr @realloc(ptr, i64)");
    add_line(head, "declare void @free(ptr)");
    add_line(head, "declare ptr @getenv(ptr)");
    add_line(head, "declare i64 @strlen(ptr)");
    add_line(head, "declare ptr @fopen(ptr, ptr)");
    add_line(head, "declare i32 @fseek(ptr, i64, i32)");
    add_line(head, "declare i64 @ftell(ptr)");
    add_line(head, "declare i64 @fread(ptr, i64, i64, ptr)");
    add_line(head, "declare i64 @fwrite(ptr, i64, i64, ptr)");
    add_line(head, "declare i32 @fclose(ptr)");
    add_line(head, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)");
    add_line(head, "@nz.argc = internal global i64 0");
    add_line(head, "@nz.argv = internal global ptr null");
    // The accounting. Six counters, unconditionally, so every emitted program can be
    // asked what it allocated and what it reclaimed — which is how a test compares this
    // compiler's output with the reference compiler's on memory and not only on values.
    add_line(head, "@nz.seq_allocated = internal global i64 0");
    add_line(head, "@nz.seq_reclaimed = internal global i64 0");
    add_line(head, "@nz.str_allocated = internal global i64 0");
    add_line(head, "@nz.str_reclaimed = internal global i64 0");
    add_line(head, "@nz.chan_allocated = internal global i64 0");
    add_line(head, "@nz.chan_reclaimed = internal global i64 0");
    add_line(head, str_concat(str_concat("@.dec = private unnamed_addr constant [5 x i8] c", dq()),
            str_concat("%lld", str_concat(str_concat(bs(), "00"), dq()))));
    add_line(head, str_concat(str_concat("@.rb = private unnamed_addr constant [3 x i8] c", dq()),
            str_concat("rb", str_concat(str_concat(bs(), "00"), dq()))));
    add_line(head, str_concat(str_concat("@.wb = private unnamed_addr constant [3 x i8] c", dq()),
            str_concat("wb", str_concat(str_concat(bs(), "00"), dq()))));
    // `%lld` then a newline then NUL, written as LLVM's own escapes inside a quoted
    // constant — which is why both the quote and the backslash have to be built.
    add_line(head, str_concat(str_concat("@.fmt = private unnamed_addr constant [6 x i8] c", dq()),
            str_concat(str_concat("%lld", str_concat(bs(), "0A")),
            str_concat(str_concat(bs(), "00"), dq()))));
    // The memory report's environment variable and format. The exact text
    // `crates/nazm-lir/src/emit.rs` uses, so a program built by this compiler and one
    // built by the reference print the same line and a differential test can compare
    // them. Lengths are computed here rather than counted by hand, for the reason the
    // reference computes them: a constant whose declared size disagrees with its bytes
    // is rejected by clang at best and truncates at worst.
    let memvar = memory_variable();
    add_line(head, str_concat(str_concat(str_concat("@.memvar = private unnamed_addr constant [",
            int_to_str(str_len(memvar) + 1)),
            str_concat(str_concat(" x i8] c", dq()), memvar)),
            str_concat(str_concat(bs(), "00"), dq())));
    let memfmt = memory_format();
    add_line(head, str_concat(str_concat(str_concat("@.memfmt = private unnamed_addr constant [",
            int_to_str(str_len(memfmt) + 2)),
            str_concat(str_concat(" x i8] c", dq()), memfmt)),
            str_concat(str_concat(str_concat(bs(), "0A"), str_concat(bs(), "00")), dq())));
    add_line(head, "@.membuf = private global [256 x i8] zeroinitializer");
    // `Str` literals: the bytes, and a constant pair naming them. An empty literal still
    // gets a byte of storage so its pointer stays valid to hand to `memcmp`.
    let mut sb = 0;
    while sb < strs_len(blobs) {
        let text = strs_get(blobs, sb);
        let stored = if str_len(text) == 0 { str_from_byte(0) } else { text };
        add_line(head, str_concat(str_concat(str_concat("@.s", int_to_str(sb)),
                str_concat(" = private unnamed_addr constant [",
                int_to_str(str_len(stored)))),
                str_concat(str_concat(str_concat(" x i8] c", dq()), escaped(stored)),
                dq())));
        // The owner is `null`: a literal is immortal, so nothing has to keep it alive and
        // nothing may free it. The cheapest case the third field has, decided here at
        // compile time and costing no instruction.
        add_line(head, str_concat(str_concat(str_concat("@.sv", int_to_str(sb)),
                str_concat(" = private unnamed_addr constant { ptr, i64, ptr } { ptr @.s",
                int_to_str(sb))),
                str_concat(str_concat(", i64 ", int_to_str(str_len(text))), ", ptr null }")));
        sb = sb + 1;
    }

    let mut m = 0;
    while m < strs_len(msgs) {
        let text = strs_get(msgs, m);
        add_line(head, str_concat(str_concat(str_concat("@.m", int_to_str(m)),
                str_concat(" = private unnamed_addr constant [",
                int_to_str(str_len(text) + 1))),
                str_concat(str_concat(str_concat(" x i8] c", dq()), escaped(text)),
                str_concat(str_concat(bs(), "00"), dq()))));
        m = m + 1;
    }
    // Records and returns. A failure inside a `scope` is reported at the closing brace,
    // after every task has been joined, so the thread that fails has to be able to walk
    // back out to that brace — writing the message and exiting here would end the process
    // wherever the failure happened. Thread-local, because two tasks may fail at once and
    // neither may see the other's; first failure per thread wins, so one caused by
    // carrying on with the stand-in value of another cannot displace it.
    add_line(head, "@nz.failed = internal thread_local global i1 false");
    add_line(head, "@nz.errmsg = internal thread_local global ptr null");
    add_line(head, "@nz.errlen = internal thread_local global i64 0");
    add_line(head, "define internal void @nz.fail(ptr %m, i64 %n) {");
    add_line(head, "entry:");
    add_line(head, "  %had = load i1, ptr @nz.failed");
    add_line(head, "  br i1 %had, label %done, label %record");
    add_line(head, "record:");
    add_line(head, "  store i1 true, ptr @nz.failed");
    add_line(head, "  store ptr %m, ptr @nz.errmsg");
    add_line(head, "  store i64 %n, ptr @nz.errlen");
    add_line(head, "  br label %done");
    add_line(head, "done:");
    add_line(head, "  ret void");
    add_line(head, "}");
    // The one place a diagnostic is written and the process ends.
    add_line(head, "define internal void @nz.report() noreturn {");
    add_line(head, "entry:");
    add_line(head, "  %m = load ptr, ptr @nz.errmsg");
    add_line(head, "  %n = load i64, ptr @nz.errlen");
    add_line(head, "  %w = call i64 @write(i32 2, ptr %m, i64 %n)");
    add_line(head, "  call void @exit(i32 2)");
    add_line(head, "  unreachable");
    add_line(head, "}");

    let tail = strs_new();
    // The platform entry point is a wrapper, separate from Nazm's `main`, and **only it
    // prints** — the full 64-bit value, because an exit status is 8 bits and would lie.
    add_line(tail, "define i32 @main(i32 %argc, ptr %argv) {");
    add_line(tail, "entry:");
    // Stashed in globals so `args_count` and `arg` need no parameter threaded through
    // every Nazm function. One fewer than `argc`, because `argv[0]` is the program's own
    // name and is deliberately not visible.
    add_line(tail, "  %a64 = sext i32 %argc to i64");
    add_line(tail, "  %an = sub i64 %a64, 1");
    add_line(tail, "  store i64 %an, ptr @nz.argc");
    add_line(tail, "  store ptr %argv, ptr @nz.argv");
    // The **root** module's `main`, which the checker already located. An imported
    // module's `main` is one of its definitions and not an entry point.
    add_line(tail, str_concat("  %r = call i64 ", str_concat(symbol(entry), "()")));
    // Before the failure is reported, not after: `@nz.report` ends the process and never
    // returns, so a report on the success path alone would say nothing about exactly the
    // runs where reclamation is hardest to get right. A runtime diagnostic, off unless
    // asked for, and not a built-in: no Nazm program may observe how its own storage is
    // managed.
    add_line(tail, "  %want = call ptr @getenv(ptr @.memvar)");
    add_line(tail, "  %quiet = icmp eq ptr %want, null");
    add_line(tail, "  br i1 %quiet, label %nz.checked, label %nz.memreport");
    add_line(tail, "nz.memreport:");
    add_line(tail, "  %seqa = load i64, ptr @nz.seq_allocated");
    add_line(tail, "  %seqr = load i64, ptr @nz.seq_reclaimed");
    add_line(tail, "  %seql = sub i64 %seqa, %seqr");
    add_line(tail, "  %stra = load i64, ptr @nz.str_allocated");
    add_line(tail, "  %strr = load i64, ptr @nz.str_reclaimed");
    add_line(tail, "  %strl = sub i64 %stra, %strr");
    add_line(tail, "  %chana = load i64, ptr @nz.chan_allocated");
    add_line(tail, "  %chanr = load i64, ptr @nz.chan_reclaimed");
    add_line(tail, "  %chanl = sub i64 %chana, %chanr");
    add_line(tail, "  %memout = call i32 (ptr, i64, ptr, ...) @snprintf(ptr @.membuf, i64 256, ptr @.memfmt, i64 %seqa, i64 %seqr, i64 %seql, i64 %stra, i64 %strr, i64 %strl, i64 %chana, i64 %chanr, i64 %chanl)");
    add_line(tail, "  %memlen = sext i32 %memout to i64");
    add_line(tail, "  %memwrote = call i64 @write(i32 2, ptr @.membuf, i64 %memlen)");
    add_line(tail, "  br label %nz.checked");
    add_line(tail, "nz.checked:");
    // The one place a diagnostic is written. By the time control is here every scope
    // `main` opened has been joined, so nothing is still running when the process ends.
    add_line(tail, "  %failed = load i1, ptr @nz.failed");
    add_line(tail, "  br i1 %failed, label %nz.reported, label %nz.finished");
    add_line(tail, "nz.reported:");
    add_line(tail, "  call void @nz.report()");
    add_line(tail, "  unreachable");
    add_line(tail, "nz.finished:");
    add_line(tail, "  %p = call i32 (ptr, ...) @printf(ptr @.fmt, i64 %r)");
    add_line(tail, "  ret i32 0");
    add_line(tail, "}");

    // The task and channel runtime is emitted only when something reached it, so an
    // ordinary program carries none of it. A channel without a `spawn` needs the channel
    // half and not the task half.
    let mut rt = runtime();
    if strs_len(tasks) > 0 {
        rt = str_concat(rt, task_runtime());
    }
    if concurrent {
        rt = str_concat(rt, channel_runtime());
    }
    // One retain and one release helper per record that owns something. A record whose
    // every field is an `Int` gets neither, and no call site emits one either — it costs
    // nothing, one level later than `owns` says so.
    let helpers = strs_new();
    let hnext = ints_new();
    ints_push(hnext, 0);
    ints_push(hnext, 0);
    let mut hr = 0;
    while hr < strs_len(rnames) {
        if ints_get(rowns, hr) == 3 {
            vec_helper(helpers, hnext, hr, ints_get(tb.args, ints_get(tb.afirst, hr)), rowns);
        } else {
            if ints_get(rowns, hr) != 0 {
                record_helper(helpers, hnext, hr, true, rowns, rfirst, rcount, rfname, rftype);
                record_helper(helpers, hnext, hr, false, rowns, rfirst, rcount, rfname, rftype);
            }
        }
        hr = hr + 1;
    }
    Result[Str, Vec[Diag]].Ok(value: str_concat(str_concat(str_concat(join(head), rt),
            str_concat(join(body), join(tasks))),
            str_concat(join(helpers), join(tail))))
}

// --- the built-ins ---------------------------------------------------------------
//
// Each is the instructions it means. Bounds checks live here, at the call site, because
// the diagnostic has to name this call's source position.
//
// Returns the value number, or -1 when `name` is not a built-in — which is how the call
// site tells a built-in from a user function without a second name table.

fn emit_builtin(name: Str, args: Ints, owned: Ints, out: Strs, msgs: Strs, next: Ints,
        current: Strs, live: Ints, at: Str, rowns: Ints,
        otype: Ints) -> Int {
    let a0 = if ints_len(args) > 0 { ints_get(args, 0) } else { 0 };
    let a1 = if ints_len(args) > 1 { ints_get(args, 1) } else { 0 };
    let a2 = if ints_len(args) > 2 { ints_get(args, 2) } else { 0 };

    if name == "str_len" { return field(out, next, a0, "1"); }

    if name == "str_byte" {
        let len = field(out, next, a0, "1");
        let ptr = field(out, next, a0, "0");
        let neg = binop(out, next, "icmp slt", "i64", v(a1), "0");
        let past = binop(out, next, "icmp sge", "i64", v(a1), v(len));
        let bad = binop(out, next, "or", "i1", v(neg), v(past));
        require(out, msgs, next, current, live, bad, "this byte index is outside the `Str`", at, owned, otype, rowns);
        let slot = binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(ptr)),
                str_concat("i64 ", v(a1)));
        let byte = binop(out, next, "load", "i8,", str_concat("ptr ", v(slot)), "");
        // Zero-extended: a byte is `0..=255`, never negative.
        return cast(out, next, "zext", "i8", byte, "i64");
    }

    if name == "str_slice" {
        let len = field(out, next, a0, "1");
        let ptr = field(out, next, a0, "0");
        let neg = binop(out, next, "icmp slt", "i64", v(a1), "0");
        let inv = binop(out, next, "icmp slt", "i64", v(a2), v(a1));
        let past = binop(out, next, "icmp sgt", "i64", v(a2), v(len));
        let x = binop(out, next, "or", "i1", v(neg), v(inv));
        let bad = binop(out, next, "or", "i1", v(x), v(past));
        require(out, msgs, next, current, live, bad, "this slice is not inside the `Str`", at, owned, otype, rowns);
        // No copy: a slice is a pointer, a length and **the same owner**. The view keeps
        // the allocation it was cut from alive, which is what makes a slice that outlives
        // its original ordinary rather than a dangling pointer.
        let start = binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(ptr)),
                str_concat("i64 ", v(a1)));
        let n = binop(out, next, "sub", "i64", v(a2), v(a1));
        let owner = field(out, next, a0, "2");
        // Retained here rather than left to whoever binds the result, because the
        // argument is released as a temporary the moment this built-in returns:
        // `str_slice(str_concat(a, b), 1, 2)` would otherwise free the backing its own
        // result points into.
        add_line(out, str_concat(str_concat("  call void @nz.str_retain(ptr ", v(owner)), ")"));
        let made = make_str(out, next, start, n, v(owner));
        own_add(owned, otype, made, t_str());
        return made;
    }

    if name == "str_join" {
        let sp = field(out, next, a1, "0");
        let sn = field(out, next, a1, "1");
        let r = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(r)),
                str_concat(str_concat(" = call { ptr, i64, ptr } @nz.str_join(ptr ", v(a0)),
                str_concat(str_concat(", ptr ", v(sp)),
                str_concat(", i64 ", str_concat(v(sn), ")"))))));
        let got = field(out, next, r, "0");
        let bad = binop(out, next, "icmp eq", "ptr", v(got), "null");
        guard(out, msgs, next, current, live, bad, "N0406", "out of memory", at, owned, otype, rowns);
        // One allocation, one reference, and this expression is holding it.
        own_add(owned, otype, r, t_str());
        return r;
    }

    if name == "str_concat" {
        let pa = field(out, next, a0, "0");
        let la = field(out, next, a0, "1");
        let pb = field(out, next, a1, "0");
        let lb = field(out, next, a1, "1");
        let n = binop(out, next, "add", "i64", v(la), v(lb));
        // One byte more than needed, so an empty result still owns storage and its
        // pointer stays valid to compare.
        let room = binop(out, next, "add", "i64", v(n), "1");
        let own = string_backing(out, msgs, next, current, live, room, at, owned, otype, rowns);
        let buf = string_data(out, next, own);
        add_line(out, str_concat(str_concat("  call void @llvm.memcpy.p0.p0.i64(ptr ", v(buf)),
                str_concat(str_concat(", ptr ", v(pa)),
                str_concat(str_concat(", i64 ", v(la)), ", i1 false)"))));
        let rest = binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(buf)),
                str_concat("i64 ", v(la)));
        add_line(out, str_concat(str_concat("  call void @llvm.memcpy.p0.p0.i64(ptr ", v(rest)),
                str_concat(str_concat(", ptr ", v(pb)),
                str_concat(str_concat(", i64 ", v(lb)), ", i1 false)"))));
        let made = make_str(out, next, buf, n, v(own));
        own_add(owned, otype, made, t_str());
        return made;
    }

    if name == "str_from_byte" {
        let low = binop(out, next, "icmp slt", "i64", v(a0), "0");
        let high = binop(out, next, "icmp sgt", "i64", v(a0), "255");
        let bad = binop(out, next, "or", "i1", v(low), v(high));
        require(out, msgs, next, current, live, bad, "this is not a byte value", at, owned, otype, rowns);
        let one = constant(out, next, "1");
        let own = string_backing(out, msgs, next, current, live, one, at, owned, otype, rowns);
        let buf = string_data(out, next, own);
        let narrow = cast(out, next, "trunc", "i64", a0, "i8");
        add_line(out, str_concat(str_concat("  store i8 ", v(narrow)), str_concat(", ptr ", v(buf))));
        let n = constant(out, next, "1");
        let made = make_str(out, next, buf, n, v(own));
        own_add(owned, otype, made, t_str());
        return made;
    }

    if name == "int_to_str" {
        // 20 digits is the widest `Int`, plus the NUL `snprintf` insists on writing.
        let room = constant(out, next, "21");
        let own = string_backing(out, msgs, next, current, live, room, at, owned, otype, rowns);
        let buf = string_data(out, next, own);
        let written = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(written)),
                str_concat(str_concat(" = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ", v(buf)),
                str_concat(", i64 21, ptr @.dec, i64 ", str_concat(v(a0), ")")))));
        let n = cast(out, next, "sext", "i32", written, "i64");
        let made = make_str(out, next, buf, n, v(own));
        own_add(owned, otype, made, t_str());
        return made;
    }

    if name == "chan_new" {
        let small = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(small)),
                str_concat(" = icmp slt i64 ", str_concat(v(a0), ", 1"))));
        guard(out, msgs, next, current, live, small, "N0405",
                "a channel needs a capacity of at least 1", at, owned, otype, rowns);
        let c = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(c)),
                str_concat(" = call ptr @nz.chan_new(i64 ", str_concat(v(a0), ")"))));
        let bad = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(bad)),
                str_concat(" = icmp eq ptr ", str_concat(v(c), ", null"))));
        guard(out, msgs, next, current, live, bad, "N0406", "out of memory", at, owned, otype, rowns);
        // Born with one reference, held by this expression — the same rule a sequence
        // follows. Whatever consumes the expression takes it over.
        own_add(owned, otype, c, t_chan());
        return c;
    }

    if name == "chan_send" {
        let ok = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(ok)),
                str_concat(str_concat(" = call i1 @nz.chan_send(ptr ", v(a0)),
                str_concat(str_concat(", i64 ", v(a1)), ")"))));
        return ok;
    }

    // The received value is pushed onto the sequence by the helper rather than returned
    // and pushed here, because the push happens only when there *was* a value and a call
    // site cannot branch without a block of its own. The failure text is passed in: the
    // helper is shared and the position is not.
    if name == "chan_recv" {
        let text = failure_text("N0406", "out of memory", at);
        let idx = message_index(msgs, text);
        let ok = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(ok)),
                str_concat(str_concat(" = call i1 @nz.chan_recv(ptr ", v(a0)),
                str_concat(str_concat(str_concat(", ptr ", v(a1)), ", ptr @.m"),
                str_concat(str_concat(int_to_str(idx), ", i64 "),
                str_concat(int_to_str(str_len(text) + 1), ")"))))));
        // A failed allocation is reported by recording it and returning `false`, which is
        // otherwise how the helper says the channel is closed and drained. Unchecked,
        // `while chan_recv(c, buf)` would read the one as the other.
        check_failed(out, next, current, live, owned, otype, rowns);
        return ok;
    }

    if name == "chan_close" {
        add_line(out, str_concat(str_concat("  call void @nz.chan_close(ptr ", v(a0)), ")"));
        // The language has no unit type and `chan_close` is specified to produce `Int`.
        return constant(out, next, "0");
    }

    if name == "ints_new" { return new_sequence(out, msgs, next, current, live, owned, at, t_ints(), otype, rowns); }
    if name == "strs_new" { return new_sequence(out, msgs, next, current, live, owned, at, t_strs(), otype, rowns); }
    if name == "ints_len" { return binop(out, next, "load", "i64,", str_concat("ptr ", v(a0)), ""); }
    if name == "strs_len" { return binop(out, next, "load", "i64,", str_concat("ptr ", v(a0)), ""); }

    if name == "ints_get" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, "i64", at, owned, otype, rowns);
        return binop(out, next, "load", "i64,", str_concat("ptr ", v(slot)), "");
    }
    if name == "strs_get" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, "{ ptr, i64, ptr }", at, owned, otype, rowns);
        let got = binop(out, next, "load", "{ ptr, i64, ptr },", str_concat("ptr ", v(slot)), "");
        // What comes out of a `Strs` gets **its own** reference to the backing, which is
        // what makes the specification's promise — a `Str` already read out is unaffected
        // by changing the sequence — true by construction rather than true because
        // nothing was ever freed.
        emit_retain(out, next, got, t_str(), rowns);
        own_add(owned, otype, got, t_str());
        return got;
    }
    if name == "ints_set" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, "i64", at, owned, otype, rowns);
        add_line(out, str_concat(str_concat("  store i64 ", v(a2)), str_concat(", ptr ", v(slot))));
        // The index written: the language has no unit type, and the index is the one
        // answer that is always meaningful.
        return a1;
    }
    if name == "strs_set" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, "{ ptr, i64, ptr }", at, owned, otype, rowns);
        // The order is the correctness. The new element's reference is taken **before**
        // the old one is released, so replacing an element with a string that shares its
        // backing cannot drop the count to zero in between.
        let old = binop(out, next, "load", "{ ptr, i64, ptr },", str_concat("ptr ", v(slot)), "");
        emit_retain(out, next, a2, t_str(), rowns);
        add_line(out, str_concat(str_concat("  store { ptr, i64, ptr } ", v(a2)),
                str_concat(", ptr ", v(slot))));
        emit_release(out, next, old, t_str(), rowns);
        return a1;
    }
    if name == "ints_push" {
        return push_sequence(out, msgs, next, current, live, a0, a1, "i64", "8", t_int(), at, rowns, owned, otype);
    }
    if name == "strs_push" {
        return push_sequence(out, msgs, next, current, live, a0, a1, "{ ptr, i64, ptr }", "24",
                t_str(), at, rowns, owned, otype);
    }
    if name == "ints_pop" {
        return pop_sequence(out, msgs, next, current, live, owned, a0, "i64", t_int(), at, rowns, otype);
    }
    if name == "strs_pop" {
        return pop_sequence(out, msgs, next, current, live, owned, a0, "{ ptr, i64, ptr }",
                t_str(), at, rowns, otype);
    }

    if name == "args_count" {
        return binop(out, next, "load", "i64,", "ptr @nz.argc", "");
    }
    if name == "arg" {
        let argc = binop(out, next, "load", "i64,", "ptr @nz.argc", "");
        let neg = binop(out, next, "icmp slt", "i64", v(a0), "0");
        let past = binop(out, next, "icmp sge", "i64", v(a0), v(argc));
        let bad = binop(out, next, "or", "i1", v(neg), v(past));
        require(out, msgs, next, current, live, bad, "this index is outside the arguments", at, owned, otype, rowns);
        // `argv[0]` is the program's own name and is deliberately not visible.
        let shifted = binop(out, next, "add", "i64", v(a0), "1");
        let base = binop(out, next, "load", "ptr,", "ptr @nz.argv", "");
        let slot = binop(out, next, "getelementptr", "ptr,", str_concat("ptr ", v(base)),
                str_concat("i64 ", v(shifted)));
        let text = binop(out, next, "load", "ptr,", str_concat("ptr ", v(slot)), "");
        let len = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(len)),
                str_concat(" = call i64 @strlen(ptr ", str_concat(v(text), ")"))));
        // **External.** The bytes are the process's, outliving every value in the program.
        // Null owner: nothing this program may free and nothing it has to keep alive.
        return make_str(out, next, text, len, "null");
    }

    if name == "print" { return write_bytes(out, next, "1", a0); }
    if name == "eprint" { return write_bytes(out, next, "2", a0); }

    if name == "exit_with" {
        let narrow = cast(out, next, "trunc", "i64", a0, "i32");
        add_line(out, str_concat(str_concat("  call void @exit(i32 ", v(narrow)), ")"));
        add_line(out, "  unreachable");
        // The checker does not know `exit_with` never returns, so a program may write
        // code after it — and that code has to land somewhere legal. A fresh block with
        // no predecessors is exactly that: unreachable, valid, and dropped by any
        // optimiser. The alternative, appending after `unreachable`, is invalid IR.
        let after = take_label(next);
        open_block(out, current, live, str_concat("bu", int_to_str(after)));
        // A value is still owed to whatever contained the call; it is never read.
        return constant(out, next, "0");
    }

    if name == "read_file" {
        let ptr = field(out, next, a0, "0");
        let len = field(out, next, a0, "1");
        let r = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(r)),
                str_concat(str_concat(" = call { ptr, i64, ptr } @nz.read_file(ptr ", v(ptr)),
                str_concat(", i64 ", str_concat(v(len), ")")))));
        let got = field(out, next, r, "0");
        let bad = binop(out, next, "icmp eq", "ptr", v(got), "null");
        guard(out, msgs, next, current, live, bad, "N0407", "this file could not be read", at, owned, otype, rowns);
        // A file's contents are the program's own storage: one allocation, one reference.
        own_add(owned, otype, r, t_str());
        return r;
    }
    if name == "write_file" {
        let pp = field(out, next, a0, "0");
        let pn = field(out, next, a0, "1");
        let dp = field(out, next, a1, "0");
        let dn = field(out, next, a1, "1");
        let n = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(n)),
                str_concat(str_concat(" = call i64 @nz.write_file(ptr ", v(pp)),
                str_concat(str_concat(", i64 ", v(pn)),
                str_concat(str_concat(", ptr ", v(dp)),
                str_concat(", i64 ", str_concat(v(dn), ")")))))));
        let bad = binop(out, next, "icmp slt", "i64", v(n), "0");
        guard(out, msgs, next, current, live, bad, "N0407", "this file could not be written", at, owned, otype, rowns);
        return n;
    }
    if name == "file_exists" {
        let pp = field(out, next, a0, "0");
        let pn = field(out, next, a0, "1");
        let n = take_number(next);
        add_line(out, str_concat(str_concat("  ", v(n)),
                str_concat(str_concat(" = call i1 @nz.file_exists(ptr ", v(pp)),
                str_concat(", i64 ", str_concat(v(pn), ")")))));
        return n;
    }

    0 - 1
}

// --- `Vec[T]`, N11 -----------------------------------------------------------------------
//
// The header every sequence has — `{ len, cap, data, rc }` from `@nz.seq_new` — so a `Vec` is
// allocated, counted, grown and reclaimed by the runtime that already does all four for an
// `Ints`. What is `T`'s is the element's layout, taken from LLVM, and what an element owns,
// taken from `T`'s own law: the same five rules, applied to one more container.

fn is_vec_op(name: Str) -> Bool {
    if name == "vec_new" { return true; }
    if name == "vec_len" { return true; }
    if name == "vec_get" { return true; }
    if name == "vec_set" { return true; }
    if name == "vec_push" { return true; }
    name == "vec_pop"
}

fn emit_vec_op(name: Str, args: Ints, vt: Int, tb: Table, owned: Ints, out: Strs, msgs: Strs,
        next: Ints, current: Strs, live: Ints, at: Str, rowns: Ints, otype: Ints) -> Int {
    let elem = ints_get(tb.args, ints_get(tb.afirst, entry_of(vt)));
    let et = llvm_type(elem);
    let a0 = if ints_len(args) > 0 { ints_get(args, 0) } else { 0 };
    let a1 = if ints_len(args) > 1 { ints_get(args, 1) } else { 0 };
    let a2 = if ints_len(args) > 2 { ints_get(args, 2) } else { 0 };
    if name == "vec_new" {
        return new_sequence(out, msgs, next, current, live, owned, at, vt, otype, rowns);
    }
    if name == "vec_len" {
        return binop(out, next, "load", "i64,", str_concat("ptr ", v(a0)), "");
    }
    if name == "vec_get" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, et, at, owned, otype, rowns);
        let got = binop(out, next, "load", str_concat(et, ","), str_concat("ptr ", v(slot)), "");
        // **Its own copy**, by `T`'s law, before anything else can happen to the slot: the
        // element may be overwritten, popped or released the moment this expression is
        // done, and what it returned must not care.
        if owns_anything(elem, rowns) {
            emit_retain(out, next, got, elem, rowns);
            own_add(owned, otype, got, elem);
        }
        return got;
    }
    if name == "vec_set" {
        let slot = seq_slot(out, msgs, next, current, live, a0, a1, et, at, owned, otype, rowns);
        // The new value's reference is taken **before** the old one is released, so storing
        // a copy of the element itself cannot drop a count to zero in between.
        let old = binop(out, next, "load", str_concat(et, ","), str_concat("ptr ", v(slot)), "");
        emit_retain(out, next, a2, elem, rowns);
        add_line(out, str_concat(str_concat(str_concat("  store ", et), str_concat(" ", v(a2))),
                str_concat(", ptr ", v(slot))));
        emit_release(out, next, old, elem, rowns);
        return a1;
    }
    if name == "vec_push" {
        // The stride, asked of LLVM by the address of element 1 of an array at null: no
        // stage of this compiler knows a byte size, and the target's layout answers it.
        let one = binop(out, next, "getelementptr", str_concat(et, ","), "ptr null", "i64 1");
        let size = cast(out, next, "ptrtoint", "ptr", one, "i64");
        return push_sequence(out, msgs, next, current, live, a0, a1, et, v(size), elem, at,
                rowns, owned, otype);
    }
    // `vec_pop`: a transfer — the vector gives up its reference and this expression holds
    // that same one.
    pop_sequence(out, msgs, next, current, live, owned, a0, et, elem, at, rowns, otype)
}

// A `Vec` of owning elements' release helper: on the last reference, each element released
// by its own law **before** the buffer that holds it, and the buffer before the header —
// then the reclamation counted, as `@nz.seq_release` counts one. The loop is in the
// emitted program; this compiler writes it once per element type.
fn vec_helper(out: Strs, next: Ints, r: Int, elem: Int, rowns: Ints) -> Int {
    ints_set(next, 0, 0);
    ints_set(next, 1, 0);
    let et = llvm_type(elem);
    add_line(out, "");
    add_line(out, str_concat(str_concat("define internal void @nz.vr", int_to_str(r)),
            "(ptr %h) {"));
    add_line(out, "entry:");
    add_line(out, "  %none = icmp eq ptr %h, null");
    add_line(out, "  br i1 %none, label %done, label %drop");
    add_line(out, "drop:");
    add_line(out, "  %rcp = getelementptr i8, ptr %h, i64 24");
    add_line(out, "  %rc = load i64, ptr %rcp");
    add_line(out, "  %rc2 = sub i64 %rc, 1");
    add_line(out, "  store i64 %rc2, ptr %rcp");
    add_line(out, "  %last = icmp sle i64 %rc2, 0");
    add_line(out, "  br i1 %last, label %contents, label %done");
    add_line(out, "contents:");
    add_line(out, "  %n = load i64, ptr %h");
    add_line(out, "  %dp = getelementptr i8, ptr %h, i64 16");
    add_line(out, "  %data = load ptr, ptr %dp");
    add_line(out, "  br label %test");
    add_line(out, "test:");
    add_line(out, "  %i = phi i64 [ 0, %contents ], [ %next, %body ]");
    add_line(out, "  %more = icmp slt i64 %i, %n");
    add_line(out, "  br i1 %more, label %body, label %storage");
    add_line(out, "body:");
    add_line(out, str_concat(str_concat("  %e = getelementptr ", et), ", ptr %data, i64 %i"));
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(str_concat(" = load ", et), ", ptr %e")));
    emit_release(out, next, n, elem, rowns);
    add_line(out, "  %next = add i64 %i, 1");
    add_line(out, "  br label %test");
    add_line(out, "storage:");
    add_line(out, "  call void @free(ptr %data)");
    add_line(out, "  call void @free(ptr %h)");
    add_line(out, "  %c = atomicrmw add ptr @nz.seq_reclaimed, i64 1 monotonic");
    add_line(out, "  br label %done");
    add_line(out, "done:");
    add_line(out, "  ret void");
    add_line(out, "}");
    0
}

fn write_bytes(out: Strs, next: Ints, fd: Str, s: Int) -> Int {
    let ptr = field(out, next, s, "0");
    let len = field(out, next, s, "1");
    let n = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(n)),
            str_concat(str_concat(" = call i64 @write(i32 ", fd),
            str_concat(str_concat(", ptr ", v(ptr)),
            str_concat(", i64 ", str_concat(v(len), ")"))))));
    n
}

fn new_sequence(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints,
        owned: Ints, at: Str, kind: Int,
        otype: Ints, rowns: Ints) -> Int {
    let h = take_number(next);
    // The counted allocator: `@nz.arr_new` is the uncounted one, and a scope's list of
    // task ids uses that so it never appears in a report about the program's sequences.
    add_line(out, str_concat(str_concat("  ", v(h)), " = call ptr @nz.seq_new()"));
    let bad = binop(out, next, "icmp eq", "ptr", v(h), "null");
    guard(out, msgs, next, current, live, bad, "N0406", "out of memory", at, owned, otype, rowns);
    // Born with one reference, held by this expression. `kind` is which sequence: the
    // allocation is the same for both and the **release** is not, so the type recorded
    // here has to be the caller's rather than a default.
    own_add(owned, otype, h, kind);
    h
}

fn push_sequence(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, handle: Int, value: Int,
        elem: Str, size: Str, et: Int, at: Str, rowns: Ints,
        owned: Ints, otype: Ints) -> Int {
    let data = take_number(next);
    add_line(out, str_concat(str_concat("  ", v(data)),
            str_concat(str_concat(" = call ptr @nz.arr_grow(ptr ", v(handle)),
            str_concat(", i64 ", str_concat(size, ")")))));
    let bad = binop(out, next, "icmp eq", "ptr", v(data), "null");
    guard(out, msgs, next, current, live, bad, "N0406", "out of memory", at, owned, otype, rowns);
    let len = binop(out, next, "load", "i64,", str_concat("ptr ", v(handle)), "");
    let slot = binop(out, next, "getelementptr", str_concat(elem, ","), str_concat("ptr ", v(data)),
            str_concat("i64 ", v(len)));
    // The sequence keeps what it is given, so it takes a reference of its own. The
    // caller's value is untouched and is still valid after the call.
    emit_retain(out, next, value, et, rowns);
    add_line(out, str_concat(str_concat(str_concat("  store ", elem), str_concat(" ", v(value))),
            str_concat(", ptr ", v(slot))));
    let grown = binop(out, next, "add", "i64", v(len), "1");
    add_line(out, str_concat(str_concat("  store i64 ", v(grown)), str_concat(", ptr ", v(handle))));
    grown
}

fn pop_sequence(out: Strs, msgs: Strs, next: Ints, current: Strs, live: Ints, owned: Ints,
        handle: Int, elem: Str, et: Int, at: Str, rowns: Ints,
        otype: Ints) -> Int {
    let len = binop(out, next, "load", "i64,", str_concat("ptr ", v(handle)), "");
    let empty = binop(out, next, "icmp sle", "i64", v(len), "0");
    require(out, msgs, next, current, live, empty, "this sequence is empty", at, owned, otype, rowns);
    let last = binop(out, next, "sub", "i64", v(len), "1");
    let df = binop(out, next, "getelementptr", "i8,", str_concat("ptr ", v(handle)), "i64 16");
    let data = binop(out, next, "load", "ptr,", str_concat("ptr ", v(df)), "");
    let slot = binop(out, next, "getelementptr", str_concat(elem, ","), str_concat("ptr ", v(data)),
            str_concat("i64 ", v(last)));
    let value = binop(out, next, "load", str_concat(elem, ","), str_concat("ptr ", v(slot)), "");
    // The length is written back *after* the value is read, so the item is still inside
    // the sequence while it is being fetched. Capacity is left alone.
    add_line(out, str_concat(str_concat("  store i64 ", v(last)), str_concat(", ptr ", v(handle))));
    // A **transfer**: shortening the sequence gives up its reference and this expression
    // takes that same one over. No retain, no release, and the count is unchanged.
    if owns_anything(et, rowns) { own_add(owned, otype, value, et); }
    value
}

// The task runtime: start a thread, record it, join the list, free each block and report
// the first failure any of them had. Derived, like `runtime` above.
fn task_runtime() -> Str {
    let r = strs_new();
    strs_push(r, "define internal i32 @nz.spawn(ptr %h, ptr %fn, ptr %blk) {");
    strs_push(r, "entry:");
    strs_push(r, "  %data = call ptr @nz.arr_grow(ptr %h, i64 8)");
    strs_push(r, "  %oom = icmp eq ptr %data, null");
    strs_push(r, "  br i1 %oom, label %nomem, label %record");
    strs_push(r, "nomem:");
    strs_push(r, "  ret i32 -1");
    strs_push(r, "record:");
    strs_push(r, "  %len = load i64, ptr %h");
    strs_push(r, "  %slot = getelementptr i64, ptr %data, i64 %len");
    strs_push(r, "  %raw = ptrtoint ptr %blk to i64");
    strs_push(r, "  store i64 %raw, ptr %slot");
    strs_push(r, "  %next = add i64 %len, 1");
    strs_push(r, "  store i64 %next, ptr %h");
    strs_push(r, "  %rc = call i32 @pthread_create(ptr %blk, ptr null, ptr %fn, ptr %blk)");
    strs_push(r, "  %bad = icmp ne i32 %rc, 0");
    strs_push(r, "  br i1 %bad, label %undo, label %ok");
    strs_push(r, "undo:");
    strs_push(r, "  store i64 %len, ptr %h");
    strs_push(r, "  ret i32 1");
    strs_push(r, "ok:");
    strs_push(r, "  ret i32 0");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "; Joins every task and reports the first failure any of them had, as { message, length },");
    strs_push(r, "; or { null, 0 } if none did.");
    strs_push(r, ";");
    strs_push(r, "; **Every** task is joined before anything is reported, including after one has been found");
    strs_push(r, "; to have failed — returning at the first would leave the rest running, and a scope that");
    strs_push(r, "; does not contain its tasks is not a scope. The failure taken is the earliest by position");
    strs_push(r, "; in the list, which is the order the tasks were spawned in, so which one is reported does");
    strs_push(r, "; not depend on which thread happened to finish first.");
    strs_push(r, ";");
    strs_push(r, "; No lock is needed. A task writes its own diagnostic into its own argument block before");
    strs_push(r, "; its thread ends, and this reads that block only after `pthread_join` has returned for");
    strs_push(r, "; it, which is a happens-before edge.");
    strs_push(r, "define internal { ptr, i64 } @nz.scope_join(ptr %h) {");
    strs_push(r, "entry:");
    strs_push(r, "  ; The count is read once. Nothing can be added while this runs: the scope's body has");
    strs_push(r, "  ; finished by every path that reaches here, and a task cannot spawn into its parent.");
    strs_push(r, "  %n = load i64, ptr %h");
    strs_push(r, "  %dp = getelementptr i8, ptr %h, i64 16");
    strs_push(r, "  %data = load ptr, ptr %dp");
    strs_push(r, "  br label %test");
    strs_push(r, "test:");
    strs_push(r, "  %i = phi i64 [ 0, %entry ], [ %next, %after ]");
    strs_push(r, "  %msg = phi ptr [ null, %entry ], [ %msg2, %after ]");
    strs_push(r, "  %len = phi i64 [ 0, %entry ], [ %len2, %after ]");
    strs_push(r, "  %more = icmp slt i64 %i, %n");
    strs_push(r, "  br i1 %more, label %body, label %done");
    strs_push(r, "body:");
    strs_push(r, "  %ep = getelementptr i64, ptr %data, i64 %i");
    strs_push(r, "  %raw = load i64, ptr %ep");
    strs_push(r, "  %blk = inttoptr i64 %raw to ptr");
    strs_push(r, "  %tid = load ptr, ptr %blk");
    strs_push(r, "  %rc = call i32 @pthread_join(ptr %tid, ptr null)");
    strs_push(r, "  ; Joined, so the thread has ended and nothing will read this block again. Its arguments");
    strs_push(r, "  ; were released by the trampoline on its way out; this is the block itself, one");
    strs_push(r, "  ; `malloc` per `spawn` that until N8 nothing ever gave back.");
    strs_push(r, "  ; The task's own diagnostic, at a fixed offset in the block it was given.");
    strs_push(r, "  %emp = getelementptr i8, ptr %blk, i64 8");
    strs_push(r, "  %em = load ptr, ptr %emp");
    strs_push(r, "  %elp = getelementptr i8, ptr %blk, i64 16");
    strs_push(r, "  %el = load i64, ptr %elp");
    strs_push(r, "  %none = icmp eq ptr %msg, null");
    strs_push(r, "  %this = icmp ne ptr %em, null");
    strs_push(r, "  %take = and i1 %none, %this");
    strs_push(r, "  ; Read before the block is freed, and the message itself is a constant in the object's");
    strs_push(r, "  ; read-only data rather than anything the block owns — so what is carried out stays");
    strs_push(r, "  ; valid after the free below.");
    strs_push(r, "  call void @free(ptr %blk)");
    strs_push(r, "  br i1 %take, label %first, label %after");
    strs_push(r, "first:");
    strs_push(r, "  br label %after");
    strs_push(r, "after:");
    strs_push(r, "  %msg2 = phi ptr [ %em, %first ], [ %msg, %body ]");
    strs_push(r, "  %len2 = phi i64 [ %el, %first ], [ %len, %body ]");
    strs_push(r, "  %next = add i64 %i, 1");
    strs_push(r, "  br label %test");
    strs_push(r, "done:");
    strs_push(r, "  %r0 = insertvalue { ptr, i64 } undef, ptr %msg, 0");
    strs_push(r, "  %r1 = insertvalue { ptr, i64 } %r0, i64 %len, 1");
    strs_push(r, "  ret { ptr, i64 } %r1");
    strs_push(r, "}");
    str_concat(str_join(r, nl()), nl())
}

// The channel runtime: one mutex, one condition variable, one ring, one reference count.
// Derived, like `runtime` above.
fn channel_runtime() -> Str {
    let r = strs_new();
    strs_push(r, "define internal ptr @nz.chan_new(i64 %cap) {");
    strs_push(r, "entry:");
    strs_push(r, "  %c = call ptr @malloc(i64 64)");
    strs_push(r, "  %bad = icmp eq ptr %c, null");
    strs_push(r, "  br i1 %bad, label %fail, label %ring");
    strs_push(r, "fail:");
    strs_push(r, "  ret ptr null");
    strs_push(r, "; A channel is four allocations, and a failure part-way through must not leave the earlier");
    strs_push(r, "; ones behind. One label per stage, each freeing exactly what has been taken by then —");
    strs_push(r, "; which is `docs/spec.md`'s failure law applied to the runtime's own storage, not only to");
    strs_push(r, "; the program's.");
    strs_push(r, "freec:");
    strs_push(r, "  call void @free(ptr %c)");
    strs_push(r, "  ret ptr null");
    strs_push(r, "freed:");
    strs_push(r, "  call void @free(ptr %d)");
    strs_push(r, "  call void @free(ptr %c)");
    strs_push(r, "  ret ptr null");
    strs_push(r, "freem:");
    strs_push(r, "  call void @free(ptr %m)");
    strs_push(r, "  call void @free(ptr %d)");
    strs_push(r, "  call void @free(ptr %c)");
    strs_push(r, "  ret ptr null");
    strs_push(r, "ring:");
    strs_push(r, "  ; Checked: a capacity large enough to overflow this product would allocate a ring");
    strs_push(r, "  ; smaller than the channel then believes it has.");
    strs_push(r, "  %r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %cap, i64 8)");
    strs_push(r, "  %over = extractvalue {i64, i1} %r, 1");
    strs_push(r, "  br i1 %over, label %freec, label %ask");
    strs_push(r, "ask:");
    strs_push(r, "  %bytes = extractvalue {i64, i1} %r, 0");
    strs_push(r, "  %d = call ptr @malloc(i64 %bytes)");
    strs_push(r, "  %badd = icmp eq ptr %d, null");
    strs_push(r, "  br i1 %badd, label %freec, label %lock");
    strs_push(r, "lock:");
    strs_push(r, "  ; Sized generously on purpose: pthread_mutex_t and pthread_cond_t are opaque and");
    strs_push(r, "  ; differently sized on every platform, and there is no header to ask from here.");
    strs_push(r, "  ; Over-allocating is what makes this portable without a size to get wrong.");
    strs_push(r, "  %m = call ptr @malloc(i64 128)");
    strs_push(r, "  %badm = icmp eq ptr %m, null");
    strs_push(r, "  br i1 %badm, label %freed, label %cond");
    strs_push(r, "cond:");
    strs_push(r, "  %v = call ptr @malloc(i64 128)");
    strs_push(r, "  %badv = icmp eq ptr %v, null");
    strs_push(r, "  br i1 %badv, label %freem, label %init");
    strs_push(r, "init:");
    strs_push(r, "  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)");
    strs_push(r, "  %vi = call i32 @pthread_cond_init(ptr %v, ptr null)");
    strs_push(r, "  store i64 %cap, ptr %c");
    strs_push(r, "  %lenp = getelementptr i8, ptr %c, i64 8");
    strs_push(r, "  store i64 0, ptr %lenp");
    strs_push(r, "  %headp = getelementptr i8, ptr %c, i64 16");
    strs_push(r, "  store i64 0, ptr %headp");
    strs_push(r, "  %closedp = getelementptr i8, ptr %c, i64 24");
    strs_push(r, "  store i64 0, ptr %closedp");
    strs_push(r, "  %datap = getelementptr i8, ptr %c, i64 32");
    strs_push(r, "  store ptr %d, ptr %datap");
    strs_push(r, "  %mp = getelementptr i8, ptr %c, i64 40");
    strs_push(r, "  store ptr %m, ptr %mp");
    strs_push(r, "  %vp = getelementptr i8, ptr %c, i64 48");
    strs_push(r, "  store ptr %v, ptr %vp");
    strs_push(r, "  ; Born with one reference, held by the expression that created it.");
    strs_push(r, "  %rcp = getelementptr i8, ptr %c, i64 56");
    strs_push(r, "  store i64 1, ptr %rcp");
    strs_push(r, "  %n = atomicrmw add ptr @nz.chan_allocated, i64 1 monotonic");
    strs_push(r, "  ret ptr %c");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.chan_retain(ptr %c) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %c, null");
    strs_push(r, "  br i1 %none, label %done, label %bump");
    strs_push(r, "bump:");
    strs_push(r, "  %rcp = getelementptr i8, ptr %c, i64 56");
    strs_push(r, "  %old = atomicrmw add ptr %rcp, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "; The whole of a channel goes at once: the condition variable, the mutex, the ring and the");
    strs_push(r, "; header. Destroying the two primitives is not optional — `pthread_mutex_destroy` releases");
    strs_push(r, "; what the platform allocated behind an opaque handle, and freeing the memory without it");
    strs_push(r, "; leaks whatever that was. Neither can be in use: nothing holds a reference, so no thread");
    strs_push(r, "; is inside a send, a receive or a close.");
    strs_push(r, "define internal void @nz.chan_release(ptr %c) {");
    strs_push(r, "entry:");
    strs_push(r, "  %none = icmp eq ptr %c, null");
    strs_push(r, "  br i1 %none, label %done, label %drop");
    strs_push(r, "drop:");
    strs_push(r, "  %rcp = getelementptr i8, ptr %c, i64 56");
    strs_push(r, "  %old = atomicrmw sub ptr %rcp, i64 1 release");
    strs_push(r, "  %last = icmp eq i64 %old, 1");
    strs_push(r, "  br i1 %last, label %destroy, label %done");
    strs_push(r, "destroy:");
    strs_push(r, "  fence acquire");
    strs_push(r, "  %vp = getelementptr i8, ptr %c, i64 48");
    strs_push(r, "  %v = load ptr, ptr %vp");
    strs_push(r, "  %dv = call i32 @pthread_cond_destroy(ptr %v)");
    strs_push(r, "  call void @free(ptr %v)");
    strs_push(r, "  %mp = getelementptr i8, ptr %c, i64 40");
    strs_push(r, "  %m = load ptr, ptr %mp");
    strs_push(r, "  %dm = call i32 @pthread_mutex_destroy(ptr %m)");
    strs_push(r, "  call void @free(ptr %m)");
    strs_push(r, "  %datap = getelementptr i8, ptr %c, i64 32");
    strs_push(r, "  %data = load ptr, ptr %datap");
    strs_push(r, "  call void @free(ptr %data)");
    strs_push(r, "  call void @free(ptr %c)");
    strs_push(r, "  %n = atomicrmw add ptr @nz.chan_reclaimed, i64 1 monotonic");
    strs_push(r, "  br label %done");
    strs_push(r, "done:");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal i1 @nz.chan_send(ptr %c, i64 %v) {");
    strs_push(r, "entry:");
    strs_push(r, "  %mp = getelementptr i8, ptr %c, i64 40");
    strs_push(r, "  %m = load ptr, ptr %mp");
    strs_push(r, "  %vp = getelementptr i8, ptr %c, i64 48");
    strs_push(r, "  %cv = load ptr, ptr %vp");
    strs_push(r, "  %lenp = getelementptr i8, ptr %c, i64 8");
    strs_push(r, "  %headp = getelementptr i8, ptr %c, i64 16");
    strs_push(r, "  %closedp = getelementptr i8, ptr %c, i64 24");
    strs_push(r, "  %datap = getelementptr i8, ptr %c, i64 32");
    strs_push(r, "  %l = call i32 @pthread_mutex_lock(ptr %m)");
    strs_push(r, "  br label %check");
    strs_push(r, "check:");
    strs_push(r, "  ; Closed is tested first and on every pass, so a channel closed while this sender");
    strs_push(r, "  ; waited refuses rather than queueing into something nobody will drain.");
    strs_push(r, "  %closed = load i64, ptr %closedp");
    strs_push(r, "  %isclosed = icmp ne i64 %closed, 0");
    strs_push(r, "  br i1 %isclosed, label %refuse, label %space");
    strs_push(r, "space:");
    strs_push(r, "  %len = load i64, ptr %lenp");
    strs_push(r, "  %cap = load i64, ptr %c");
    strs_push(r, "  %full = icmp sge i64 %len, %cap");
    strs_push(r, "  br i1 %full, label %wait, label %store");
    strs_push(r, "wait:");
    strs_push(r, "  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)");
    strs_push(r, "  br label %check");
    strs_push(r, "refuse:");
    strs_push(r, "  %u1 = call i32 @pthread_mutex_unlock(ptr %m)");
    strs_push(r, "  ret i1 false");
    strs_push(r, "store:");
    strs_push(r, "  %head = load i64, ptr %headp");
    strs_push(r, "  %sum = add i64 %head, %len");
    strs_push(r, "  %idx = urem i64 %sum, %cap");
    strs_push(r, "  %data = load ptr, ptr %datap");
    strs_push(r, "  %slot = getelementptr i64, ptr %data, i64 %idx");
    strs_push(r, "  store i64 %v, ptr %slot");
    strs_push(r, "  %n1 = add i64 %len, 1");
    strs_push(r, "  store i64 %n1, ptr %lenp");
    strs_push(r, "  %b = call i32 @pthread_cond_broadcast(ptr %cv)");
    strs_push(r, "  %u2 = call i32 @pthread_mutex_unlock(ptr %m)");
    strs_push(r, "  ret i1 true");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal i1 @nz.chan_recv(ptr %c, ptr %seq, ptr %msg, i64 %mn) {");
    strs_push(r, "entry:");
    strs_push(r, "  %mp = getelementptr i8, ptr %c, i64 40");
    strs_push(r, "  %m = load ptr, ptr %mp");
    strs_push(r, "  %vp = getelementptr i8, ptr %c, i64 48");
    strs_push(r, "  %cv = load ptr, ptr %vp");
    strs_push(r, "  %lenp = getelementptr i8, ptr %c, i64 8");
    strs_push(r, "  %headp = getelementptr i8, ptr %c, i64 16");
    strs_push(r, "  %closedp = getelementptr i8, ptr %c, i64 24");
    strs_push(r, "  %datap = getelementptr i8, ptr %c, i64 32");
    strs_push(r, "  %l = call i32 @pthread_mutex_lock(ptr %m)");
    strs_push(r, "  br label %check");
    strs_push(r, "check:");
    strs_push(r, "  ; A queued value wins over the close flag, which is what makes closing end a channel");
    strs_push(r, "  ; rather than discard what is in it.");
    strs_push(r, "  %len = load i64, ptr %lenp");
    strs_push(r, "  %empty = icmp sle i64 %len, 0");
    strs_push(r, "  br i1 %empty, label %maybe, label %take");
    strs_push(r, "maybe:");
    strs_push(r, "  %closed = load i64, ptr %closedp");
    strs_push(r, "  %isclosed = icmp ne i64 %closed, 0");
    strs_push(r, "  br i1 %isclosed, label %drained, label %wait");
    strs_push(r, "wait:");
    strs_push(r, "  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)");
    strs_push(r, "  br label %check");
    strs_push(r, "drained:");
    strs_push(r, "  %u1 = call i32 @pthread_mutex_unlock(ptr %m)");
    strs_push(r, "  ret i1 false");
    strs_push(r, "take:");
    strs_push(r, "  %head = load i64, ptr %headp");
    strs_push(r, "  %cap = load i64, ptr %c");
    strs_push(r, "  %data = load ptr, ptr %datap");
    strs_push(r, "  %slot = getelementptr i64, ptr %data, i64 %head");
    strs_push(r, "  %val = load i64, ptr %slot");
    strs_push(r, "  %h1 = add i64 %head, 1");
    strs_push(r, "  %nh = urem i64 %h1, %cap");
    strs_push(r, "  store i64 %nh, ptr %headp");
    strs_push(r, "  %n1 = sub i64 %len, 1");
    strs_push(r, "  store i64 %n1, ptr %lenp");
    strs_push(r, "  %b = call i32 @pthread_cond_broadcast(ptr %cv)");
    strs_push(r, "  %u2 = call i32 @pthread_mutex_unlock(ptr %m)");
    strs_push(r, "  ; The push happens after the unlock. Growing a sequence may call `realloc`, and holding");
    strs_push(r, "  ; a channel's mutex across an allocation would make every other task on it wait for the");
    strs_push(r, "  ; allocator.");
    strs_push(r, "  %grown = call ptr @nz.arr_grow(ptr %seq, i64 8)");
    strs_push(r, "  %oom = icmp eq ptr %grown, null");
    strs_push(r, "  br i1 %oom, label %nomem, label %push");
    strs_push(r, "nomem:");
    strs_push(r, "  ; Records and returns, like every other failure. `false` is the stand-in `chan_recv`");
    strs_push(r, "  ; hands back while unwinding; the caller checks the flag before it reads it.");
    strs_push(r, "  call void @nz.fail(ptr %msg, i64 %mn)");
    strs_push(r, "  ret i1 false");
    strs_push(r, "push:");
    strs_push(r, "  %sn = load i64, ptr %seq");
    strs_push(r, "  %sslot = getelementptr i64, ptr %grown, i64 %sn");
    strs_push(r, "  store i64 %val, ptr %sslot");
    strs_push(r, "  %sn1 = add i64 %sn, 1");
    strs_push(r, "  store i64 %sn1, ptr %seq");
    strs_push(r, "  ret i1 true");
    strs_push(r, "}");
    strs_push(r, "");
    strs_push(r, "define internal void @nz.chan_close(ptr %c) {");
    strs_push(r, "entry:");
    strs_push(r, "  %mp = getelementptr i8, ptr %c, i64 40");
    strs_push(r, "  %m = load ptr, ptr %mp");
    strs_push(r, "  %vp = getelementptr i8, ptr %c, i64 48");
    strs_push(r, "  %cv = load ptr, ptr %vp");
    strs_push(r, "  %l = call i32 @pthread_mutex_lock(ptr %m)");
    strs_push(r, "  %closedp = getelementptr i8, ptr %c, i64 24");
    strs_push(r, "  store i64 1, ptr %closedp");
    strs_push(r, "  %b = call i32 @pthread_cond_broadcast(ptr %cv)");
    strs_push(r, "  %u = call i32 @pthread_mutex_unlock(ptr %m)");
    strs_push(r, "  ret void");
    strs_push(r, "}");
    str_concat(str_join(r, nl()), nl())
}
