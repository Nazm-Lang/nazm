// The checker's command-line driver.
//
// Usage: check FILE
// Output: one diagnostic per line, `CODE|start|end|message`. Exits 1 if there were any.

use "analyse.nz";
use "lex.nz";
use "parse.nz";

fn main() -> Int {
    if args_count() < 1 {
        eprint("usage: check FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    // One file is one module, and this driver is handed one file — so the graph is one
    // module at offset zero with no imports. The tables exist even here, because the
    // checker asks about ownership unconditionally and a checker that special-cased the
    // single-module program would be a second answer to the same question.
    let mpath = strs_new();
    strs_push(mpath, path);
    let mstart = ints_new();
    ints_push(mstart, 0);
    let mfirst = ints_new();
    ints_push(mfirst, 0);
    let mcount = ints_new();
    ints_push(mcount, 0);
    let mto = ints_new();
    let mat = ints_new();

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    let naux = ints_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx, naux);

    let kids = ints_new();
    let kid_first = ints_new();
    build_children(nk, nar, kids, kid_first);

    // The built-ins share the ordinary function namespace, exactly as `docs/spec.md`
    // says, so a call to one is not an undefined function — and a definition may not take
    // one of their names, which is why they are collected first.
    let bnames = strs_new();
    let bret = ints_new();
    let bfirst = ints_new();
    let bcount = ints_new();
    let bparams = ints_new();
    builtins(bnames, bret, bfirst, bcount, bparams);

    let dcode = strs_new();
    let dstart = ints_new();
    let dend = ints_new();
    let dmsg = strs_new();

    // Records, in three stages before any signature. Names first, for the whole
    // compilation, because a field's type may name a record declared later or in another
    // module; then the field types; then the layouts those fields describe. `docs/spec.md`
    // orders them and says why declaration order is not a dependency.
    let rnames = strs_new();
    let rowner = ints_new();
    let rpub = ints_new();
    let rat = ints_new();
    let rnode = ints_new();
    // What each entry is: a record, an enum, or one of an enum's variants. See
    // `analyse.nz`, *an enum is a record whose fields are its variants*.
    let rkind = ints_new();
    let rfirst = ints_new();
    let rcount = ints_new();
    let rfname = strs_new();
    let rftype = ints_new();
    let rfat = ints_new();
    let tmod = ints_new();
    let tname = strs_new();
    let trec = ints_new();
    collect_records(nk, nar, nst, nen, ntx, naux, mstart,
            rnames, rowner, rpub, rat, rnode, rkind, kids, kid_first,
            dcode, dstart, dend, dmsg);
    check_type_imports(mfirst, mcount, mto, mat, strs_len(mpath),
            rnames, rowner, rpub, tmod, tname, trec, dcode, dstart, dend, dmsg);
    resolve_record_fields(nk, nar, nst, nen, ntx, kids, kid_first,
            rnames, rowner, rat, rnode, rkind, rfirst, rcount, rfname, rftype, rfat,
            tmod, tname, trec, dcode, dstart, dend, dmsg);
    check_record_layouts(rnames, rat, rfirst, rcount, rftype, dcode, dstart, dend, dmsg);

    // Signatures before any body, so a forward reference resolves — the same two-pass
    // shape `nazm-lir::lower` uses, and for the same reason.
    let fnames = strs_new();
    let fret = ints_new();
    let ffirst = ints_new();
    let fcount = ints_new();
    let fparams = ints_new();
    let fowner = ints_new();
    let fpub = ints_new();
    collect_signatures(nk, nar, nst, nen, ntx, naux, kids, kid_first, mstart,
            fnames, fret, ffirst, fcount, fparams, fowner, fpub, bnames,
            rnames, rowner, rpub, rat, rkind, rfirst, rcount, rfname, rftype, rfat,
            tmod, tname, trec,
            dcode, dstart, dend, dmsg);

    // What each module's imports bring in, and the collisions that creates. Nothing here
    // for a one-module program, and it still runs: the pass is not conditional on there
    // being more than one module.
    let vmod = ints_new();
    let vname = strs_new();
    let vfn = ints_new();
    check_imports(mfirst, mcount, mto, mat, strs_len(mpath), fnames, fowner, fpub,
            vmod, vname, vfn, dcode, dstart, dend, dmsg);

    entry_point(fnames, fowner, dcode, dstart, dend, dmsg);

    let nslot = ints_new();
    let ntype = ints_new();
    let ncallee = ints_new();
    let nrec = ints_new();
    check_all(nk, nar, nst, nen, ntx, naux, nslot, ntype, ncallee, nrec,
            kids, kid_first, ints_len(nk) - 1,
            mstart, mfirst, mcount, mto,
            fnames, fret, ffirst, fcount, fparams,
            fowner, fpub, vmod, vname, vfn,
            bnames, bret, bfirst, bcount, bparams,
            rnames, rowner, rkind, rfirst, rcount, rfname, rftype,
            tmod, tname, trec,
            dcode, dstart, dend, dmsg);

    // One allocation for the whole output; see the note in `lexer.nz`.
    let nl = str_from_byte(10);
    let out = strs_new();
    let mut d = 0;
    while d < strs_len(dcode) {
        strs_push(out, strs_get(dcode, d));
        strs_push(out, "|");
        strs_push(out, int_to_str(ints_get(dstart, d)));
        strs_push(out, "|");
        strs_push(out, int_to_str(ints_get(dend, d)));
        strs_push(out, "|");
        strs_push(out, strs_get(dmsg, d));
        strs_push(out, nl);
        d = d + 1;
    }
    print(str_join(out, ""));
    if strs_len(dcode) > 0 { exit_with(1); }
    0
}
