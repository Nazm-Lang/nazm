// Name resolution for Nazm, written in Nazm.
//
// Third component of the self-hosted compiler. It reads the node arena
// `compiler/parse.nz` produces and reports undefined variables (`N0200`) and undefined
// functions (`N0201`) with the spans the reference checker gives them.
//
// # Traversing a post-order arena without recursion
//
// The arena is post-order with arity, which is a stack machine's natural input: one
// left-to-right pass with an operand stack recovers every node's children, because a
// node's children are exactly the `arity` subtrees immediately before it. That pass
// builds a child index, and a second pass walks the tree in *pre-order* from an explicit
// work stack — which is what scoping needs, since a scope opens before the statements
// inside it are seen.
//
// Neither pass recurses. See `docs/bootstrap-design.md`, *Traversal is iterative,
// always*.
//
// Usage: check FILE
// Output: one diagnostic per line, `CODE|start|end|message`, to standard output. Exits 1
// if there were any, 0 if not.

use "parse.nz";

// --- the child index -----------------------------------------------------------------
//
// `kid_first[k]` is where node `k`'s children begin in `kids`, and `nar[k]` says how
// many there are, in source order.

fn build_children(nk: Ints, nar: Ints, kids: Ints, kid_first: Ints) -> Int {
    let stack = ints_new();
    let mut k = 0;
    while k < ints_len(nk) {
        let arity = ints_get(nar, k);
        // The `arity` most recent roots are this node's children. Popped in reverse and
        // written back in order, so `kids` reads left to right like the source does.
        let taken = ints_new();
        let mut t = 0;
        while t < arity {
            ints_push(taken, ints_pop(stack));
            t = t + 1;
        }
        ints_push(kid_first, ints_len(kids));
        let mut j = arity - 1;
        while j >= 0 {
            ints_push(kids, ints_get(taken, j));
            j = j - 1;
        }
        ints_push(stack, k);
        k = k + 1;
    }
    ints_len(stack)
}

// --- scopes ---------------------------------------------------------------------------
//
// A flat stack of names with a stack of marks. Entering a scope pushes a mark; leaving
// truncates back to it. Innermost-first lookup is a backwards scan, which is what the
// reference checker's `Scopes::lookup` does with a vector of maps.

fn scope_enter(marks: Ints, names: Strs) -> Int {
    ints_push(marks, strs_len(names));
    ints_len(marks)
}

fn scope_leave(marks: Ints, names: Strs) -> Int {
    let mark = ints_pop(marks);
    while strs_len(names) > mark {
        strs_pop(names);
    }
    mark
}

fn scope_has(names: Strs, want: Str) -> Bool {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return true; }
        i = i - 1;
    }
    false
}

fn has_function(fnames: Strs, want: Str) -> Bool {
    let mut i = 0;
    while i < strs_len(fnames) {
        if strs_get(fnames, i) == want { return true; }
        i = i + 1;
    }
    false
}

// `name:type` and `name:mut` texts carry two fields; this takes the part before the `:`.
fn before_colon(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 58 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

fn report(dcode: Strs, dstart: Ints, dend: Ints, dmsg: Strs,
          code: Str, from: Int, to: Int, message: Str) -> Int {
    strs_push(dcode, code);
    ints_push(dstart, from);
    ints_push(dend, to);
    strs_push(dmsg, message);
    strs_len(dcode)
}

// --- types ---------------------------------------------------------------------------
//
// Small integers, because the language has no enum. `0` is *unknown*: it is what an
// expression whose type could not be determined gets, and it compares equal to nothing,
// so one mistake produces one diagnostic instead of a cascade — the same recovery rule
// the reference checker follows by continuing with the expected type.

fn t_unknown() -> Int { 0 }
fn t_int() -> Int { 1 }
fn t_bool() -> Int { 2 }
fn t_str() -> Int { 3 }
fn t_ints() -> Int { 4 }
fn t_strs() -> Int { 5 }

fn type_of_name(name: Str) -> Int {
    if name == "Int" { return t_int(); }
    if name == "Bool" { return t_bool(); }
    if name == "Str" { return t_str(); }
    if name == "Ints" { return t_ints(); }
    if name == "Strs" { return t_strs(); }
    t_unknown()
}

fn type_name(t: Int) -> Str {
    if t == t_int() { return "Int"; }
    if t == t_bool() { return "Bool"; }
    if t == t_str() { return "Str"; }
    if t == t_ints() { return "Ints"; }
    if t == t_strs() { return "Strs"; }
    "?"
}

// Two types are compatible when they agree, or when either is unknown — an expression
// already reported once must not be reported again by everything that contains it.
fn agrees(a: Int, b: Int) -> Bool {
    if a == t_unknown() { return true; }
    if b == t_unknown() { return true; }
    a == b
}

fn after_colon(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 58 { return str_slice(s, i + 1, str_len(s)); }
        i = i + 1;
    }
    ""
}

// --- the walk ---------------------------------------------------------------------
//
// One pass that is both pre-order and post-order. Visiting a node pushes, in this order,
// a *leave* marker, a *finish* marker, and its children reversed — so the stack pops the
// children first, then the finish, then the leave. Scoping needs the pre-order half
// (a scope opens before its statements) and typing needs the post-order half (a node's
// type is a function of its children's), and one stack gives both without recursion.
//
//   >= 0           visit node k
//   -(3k + 2)      finish node k: its children are done and their types are on `ts`
//   -(3k + 3)      leave the scope node k opened

fn mark_finish(k: Int) -> Int { 0 - (3 * k + 2) }
fn mark_leave(k: Int) -> Int { 0 - (3 * k + 3) }

fn lookup_type(names: Strs, ntypes: Ints, want: Str) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return ints_get(ntypes, i); }
        i = i - 1;
    }
    t_unknown()
}

fn lookup_mut(names: Strs, nmut: Ints, want: Str) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return ints_get(nmut, i); }
        i = i - 1;
    }
    0
}

fn bind(names: Strs, ntypes: Ints, nmut: Ints, name: Str, ty: Int, mutable: Int) -> Int {
    strs_push(names, name);
    ints_push(ntypes, ty);
    ints_push(nmut, mutable);
    strs_len(names)
}

fn scope_close(marks: Ints, names: Strs, ntypes: Ints, nmut: Ints) -> Int {
    let mark = ints_pop(marks);
    while strs_len(names) > mark {
        strs_pop(names);
        ints_pop(ntypes);
        ints_pop(nmut);
    }
    mark
}

// --- built-in signatures ---------------------------------------------------------
//
// Transcribed from `crates/nazm-core/src/intrinsic.rs`, which is the single source of
// truth for the front end. A test requires every built-in there to be present here, so
// the two cannot drift silently.

fn builtin_index(bnames: Strs, want: Str) -> Int {
    let mut i = 0;
    while i < strs_len(bnames) {
        if strs_get(bnames, i) == want { return i; }
        i = i + 1;
    }
    0 - 1
}

fn add_builtin(bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
               name: Str, ret: Int, p1: Int, p2: Int, p3: Int) -> Int {
    strs_push(bnames, name);
    ints_push(bret, ret);
    ints_push(bfirst, ints_len(bparams));
    let mut n = 0;
    if p1 != t_unknown() { ints_push(bparams, p1); n = n + 1; }
    if p2 != t_unknown() { ints_push(bparams, p2); n = n + 1; }
    if p3 != t_unknown() { ints_push(bparams, p3); n = n + 1; }
    ints_push(bcount, n);
    strs_len(bnames)
}

fn builtins(bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints) -> Int {
    let n = t_unknown();
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_len", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_byte", t_int(), t_str(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_slice", t_str(), t_str(), t_int(), t_int());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_concat", t_str(), t_str(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_from_byte", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "int_to_str", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_new", t_ints(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_len", t_int(), t_ints(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_get", t_int(), t_ints(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_set", t_int(), t_ints(), t_int(), t_int());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_push", t_int(), t_ints(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_pop", t_int(), t_ints(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_new", t_strs(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_len", t_int(), t_strs(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_get", t_str(), t_strs(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_set", t_int(), t_strs(), t_int(), t_str());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_push", t_int(), t_strs(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_pop", t_str(), t_strs(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "args_count", t_int(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "arg", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "read_file", t_str(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "write_file", t_int(), t_str(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "file_exists", t_bool(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "print", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "eprint", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "exit_with", t_int(), t_int(), n, n)
}

// --- user signatures ------------------------------------------------------------------
//
// Collected before any body, so a forward reference resolves — the same two-pass shape
// `nazm-lir::lower` uses, for the same reason.

fn collect_signatures(nk: Ints, nar: Ints, ntx: Strs, kids: Ints, kid_first: Ints,
                      fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints) -> Int {
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_fn() {
            let text = strs_get(ntx, k);
            strs_push(fnames, before_colon(text));
            ints_push(fret, type_of_name(after_colon(text)));
            ints_push(ffirst, ints_len(fparams));
            // Every child but the last is a parameter; the last is the body.
            let arity = ints_get(nar, k);
            let first = ints_get(kid_first, k);
            let mut p = 0;
            while p < arity - 1 {
                let child = ints_get(kids, first + p);
                ints_push(fparams, type_of_name(after_colon(strs_get(ntx, child))));
                p = p + 1;
            }
            ints_push(fcount, arity - 1);
        }
        k = k + 1;
    }
    strs_len(fnames)
}

// --- checking -------------------------------------------------------------------------

fn check_all(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
             kids: Ints, kid_first: Ints, root: Int,
             fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
             bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
             dcode: Strs, dstart: Ints, dend: Ints, dmsg: Strs) -> Int {
    let work = ints_new();
    let marks = ints_new();
    let names = strs_new();
    let ntypes = ints_new();
    let nmut = ints_new();
    let ts = ints_new();          // the type stack: one entry per finished child
    ints_push(work, root);

    while ints_len(work) > 0 {
        let entry = ints_pop(work);

        if entry < 0 {
            let v = 0 - entry;
            if v % 3 == 0 {
                scope_close(marks, names, ntypes, nmut);
                continue;
            }
            // --- finish: the children's types are the top of `ts` ---------------------
            let k = (v - 2) / 3;
            let kind = ints_get(nk, k);
            let arity = ints_get(nar, k);
            let first = ints_get(kid_first, k);
            let text = strs_get(ntx, k);
            let from = ints_get(nst, k);
            let to = ints_get(nen, k);

            if kind == n_bin() {
                let r = ints_pop(ts);
                let l = ints_pop(ts);
                // The operator's own span, from the auxiliary column: the reference
                // points `N0304` at the operator, and the node's span covers both
                // operands instead.
                let op_at = ints_get(naux, k);
                ints_push(ts, check_binary(text, l, r, op_at, op_at + str_len(text),
                                           dcode, dstart, dend, dmsg));
                continue;
            }
            if kind == n_neg() {
                let t = ints_pop(ts);
                if agrees(t, t_int()) == false {
                    // The `-` itself: a negation's span runs to its operand's end, and
                    // the reference reports at the operator.
                    report(dcode, dstart, dend, dmsg, "N0304", from, from + 1,
                           str_concat(str_concat("`-` applies to `Int`, but this is `",
                                                 type_name(t)), "`"));
                }
                ints_push(ts, t_int());
                continue;
            }
            if kind == n_call() {
                ints_push(ts, check_call(text, arity, ts, from, to,
                                         kids, first, nst, nen,
                                         fnames, fret, ffirst, fcount, fparams,
                                         bnames, bret, bfirst, bcount, bparams,
                                         dcode, dstart, dend, dmsg));
                continue;
            }
            if kind == n_if() {
                // Children: condition, then-block, and optionally else-block. The `if`'s
                // type is the branches'; a block's type is its tail's, or unknown.
                let mut else_t = t_unknown();
                if arity == 3 { else_t = ints_pop(ts); }
                let then_t = ints_pop(ts);
                let cond_t = ints_pop(ts);
                if agrees(cond_t, t_bool()) == false {
                    // The condition's own span, which is the first child's.
                    let c = ints_get(kids, first);
                    report(dcode, dstart, dend, dmsg, "N0301",
                           ints_get(nst, c), ints_get(nen, c),
                           str_concat(str_concat("an `if` condition must be `Bool`, but this is `",
                                                 type_name(cond_t)), "`"));
                }
                if arity == 3 {
                    ints_push(ts, then_t);
                } else {
                    ints_push(ts, t_unknown());
                }
                continue;
            }
            // **Every node leaves exactly one entry on `ts`.** A statement's is
            // `unknown` — it has no type — but it is *there*, so a parent can always pop
            // `arity` entries without knowing which children were statements. Anything
            // else makes the pop count depend on the shape of the children, which is how
            // a type stack underflows.
            if kind == n_block() {
                let mut t = t_unknown();
                let mut d = 0;
                while d < arity {
                    let popped = ints_pop(ts);
                    // The tail is the last child, so it is the first one popped.
                    if d == 0 {
                        if text == "tail" { t = popped; }
                    }
                    d = d + 1;
                }
                ints_push(ts, t);
                continue;
            }
            if kind == n_let() {
                let t = ints_pop(ts);
                bind(names, ntypes, nmut, before_colon(text),
                     t, str_to_int_flag(after_colon(text)));
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_assign() {
                let t = ints_pop(ts);
                let want = lookup_type(names, ntypes, text);
                if lookup_mut(names, nmut, text) == 0 {
                    // The name, not the whole statement: an assignment begins with its
                    // target, and the name is as long as the text the node carries.
                    report(dcode, dstart, dend, dmsg, "N0310", from, from + str_len(text),
                           str_concat(str_concat("`", text), "` is not mutable"));
                }
                if agrees(t, want) == false {
                    let value = ints_get(kids, first);
                    report(dcode, dstart, dend, dmsg, "N0300",
                           ints_get(nst, value), ints_get(nen, value),
                           str_concat(str_concat("`", text), "` has a different type"));
                }
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_while() {
                ints_pop(ts);                     // the body block
                let cond_t = ints_pop(ts);
                if agrees(cond_t, t_bool()) == false {
                    let c = ints_get(kids, first);
                    report(dcode, dstart, dend, dmsg, "N0301",
                           ints_get(nst, c), ints_get(nen, c),
                           str_concat(str_concat("a `while` condition must be `Bool`, but this is `",
                                                 type_name(cond_t)), "`"));
                }
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_return() {
                ints_pop(ts);
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_exprstmt() {
                ints_pop(ts);
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_fn() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                continue;
            }
            if kind == n_program() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                continue;
            }
            // `param` and every leaf pushed its own type when it was visited.
            continue;
        }

        // --- visit ------------------------------------------------------------------
        let kind = ints_get(nk, entry);
        let arity = ints_get(nar, entry);
        let first = ints_get(kid_first, entry);
        let text = strs_get(ntx, entry);

        if kind == n_int() { ints_push(ts, t_int()); continue; }
        if kind == n_bool() { ints_push(ts, t_bool()); continue; }
        if kind == n_str() { ints_push(ts, t_str()); continue; }
        if kind == n_break() { ints_push(ts, t_unknown()); continue; }
        if kind == n_continue() { ints_push(ts, t_unknown()); continue; }

        if kind == n_var() {
            if scope_has(names, text) == false {
                report(dcode, dstart, dend, dmsg, "N0200", ints_get(nst, entry),
                       ints_get(nen, entry),
                       str_concat(str_concat("`", text), "` is not defined"));
                ints_push(ts, t_unknown());
            } else {
                ints_push(ts, lookup_type(names, ntypes, text));
            }
            continue;
        }

        if kind == n_param() {
            bind(names, ntypes, nmut, before_colon(text),
                 type_of_name(after_colon(text)), 0);
            ints_push(ts, t_unknown());
            continue;
        }

        if kind == n_fn() {
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
        }
        if kind == n_block() {
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
        }

        ints_push(work, mark_finish(entry));
        let mut j = arity - 1;
        while j >= 0 {
            ints_push(work, ints_get(kids, first + j));
            j = j - 1;
        }
    }
    strs_len(dcode)
}

fn str_to_int_flag(s: Str) -> Int {
    if s == "1" { return 1; }
    0
}

fn is_comparison(op: Str) -> Bool {
    if op == "==" { return true; }
    if op == "!=" { return true; }
    if op == "<" { return true; }
    if op == "<=" { return true; }
    if op == ">" { return true; }
    if op == ">=" { return true; }
    false
}

fn is_ordering(op: Str) -> Bool {
    if op == "<" { return true; }
    if op == "<=" { return true; }
    if op == ">" { return true; }
    if op == ">=" { return true; }
    false
}

fn check_binary(op: Str, l: Int, r: Int, from: Int, to: Int,
                dcode: Strs, dstart: Ints, dend: Ints, dmsg: Strs) -> Int {
    let mut ok = true;
    if is_comparison(op) {
        if is_ordering(op) {
            // Ordering is `Int` only: comparing strings needs a collation decision the
            // language has not made, and ordering booleans is almost always a mistake.
            if agrees(l, t_int()) == false { ok = false; }
            if agrees(r, t_int()) == false { ok = false; }
        } else {
            // Equality works on any single type, but not across two, and **not on a
            // sequence** — where it would have to mean identity or contents.
            if agrees(l, r) == false { ok = false; }
            if l == t_ints() { ok = false; }
            if l == t_strs() { ok = false; }
        }
        if ok == false {
            report(dcode, dstart, dend, dmsg, "N0304", from, to,
                   str_concat(str_concat(str_concat("`", op), "` cannot compare `"),
                              str_concat(type_name(l), "`")));
            return t_bool();
        }
        return t_bool();
    }
    // Arithmetic is `Int` only. No string concatenation with `+`, and `+` on two `Bool`s
    // is a mistake rather than something to define.
    if agrees(l, t_int()) == false { ok = false; }
    if agrees(r, t_int()) == false { ok = false; }
    if ok == false {
        report(dcode, dstart, dend, dmsg, "N0304", from, to,
               str_concat(str_concat(str_concat("`", op), "` does not apply to `"),
                          str_concat(type_name(l), "`")));
    }
    t_int()
}

fn check_call(name: Str, argc: Int, ts: Ints, from: Int, to: Int,
              kids: Ints, first: Int, nst: Ints, nen: Ints,
              fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
              bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
              dcode: Strs, dstart: Ints, dend: Ints, dmsg: Strs) -> Int {
    // The arguments' types are the top `argc` entries, oldest first. Taken off here and
    // compared in order.
    let got = ints_new();
    let mut i = 0;
    while i < argc { ints_push(got, ints_pop(ts)); i = i + 1; }

    let mut want_first = 0 - 1;
    let mut want_count = 0;
    let mut ret = t_unknown();
    let mut params = fparams;
    let mut found = false;

    let bi = builtin_index(bnames, name);
    if bi >= 0 {
        want_first = ints_get(bfirst, bi);
        want_count = ints_get(bcount, bi);
        ret = ints_get(bret, bi);
        params = bparams;
        found = true;
    } else {
        let fi = builtin_index(fnames, name);
        if fi >= 0 {
            want_first = ints_get(ffirst, fi);
            want_count = ints_get(fcount, fi);
            ret = ints_get(fret, fi);
            found = true;
        }
    }

    if found == false {
        report(dcode, dstart, dend, dmsg, "N0201", from, from + str_len(name),
               str_concat(str_concat("`", name), "` is not a function"));
        return t_unknown();
    }

    if want_count != argc {
        report(dcode, dstart, dend, dmsg, "N0303", from, to,
               str_concat(str_concat("`", name), "` was given the wrong number of arguments"));
        return ret;
    }

    let mut a = 0;
    while a < argc {
        // `got` holds them innermost-last, so argument `a` is at `argc - 1 - a`.
        let actual = ints_get(got, argc - 1 - a);
        let expected = ints_get(params, want_first + a);
        if agrees(actual, expected) == false {
            // The argument's own span: the reference points at the value, not the call.
            let node = ints_get(kids, first + a);
            report(dcode, dstart, dend, dmsg, "N0300",
                   ints_get(nst, node), ints_get(nen, node),
                   str_concat(str_concat(str_concat("argument ", int_to_str(a + 1)),
                                         str_concat(" of `", name)),
                              "` has the wrong type"));
        }
        a = a + 1;
    }
    ret
}
fn main() -> Int {
    if args_count() < 1 {
        eprint("usage: check FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    let naux = ints_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx, naux);

    let kids = ints_new();
    let kid_first = ints_new();
    build_children(nk, nar, kids, kid_first);

    // Signatures before any body, so a forward reference resolves — the same two-pass
    // shape `nazm-lir::lower` uses, and for the same reason.
    let fnames = strs_new();
    let fret = ints_new();
    let ffirst = ints_new();
    let fcount = ints_new();
    let fparams = ints_new();
    collect_signatures(nk, nar, ntx, kids, kid_first, fnames, fret, ffirst, fcount, fparams);

    // The built-ins share the ordinary function namespace, exactly as `docs/spec.md`
    // says, so a call to one is not an undefined function.
    let bnames = strs_new();
    let bret = ints_new();
    let bfirst = ints_new();
    let bcount = ints_new();
    let bparams = ints_new();
    builtins(bnames, bret, bfirst, bcount, bparams);

    let dcode = strs_new();
    let dstart = ints_new();
    let dend = ints_new();
    let dmsg = strs_new();
    check_all(nk, nar, nst, nen, ntx, naux, kids, kid_first, ints_len(nk) - 1,
              fnames, fret, ffirst, fcount, fparams,
              bnames, bret, bfirst, bcount, bparams,
              dcode, dstart, dend, dmsg);

    let mut out = "";
    let mut d = 0;
    while d < strs_len(dcode) {
        out = str_concat(out, strs_get(dcode, d));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(dstart, d)));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(dend, d)));
        out = str_concat(out, "|");
        out = str_concat(out, strs_get(dmsg, d));
        out = str_concat(out, str_from_byte(10));
        d = d + 1;
    }
    print(out);
    if strs_len(dcode) > 0 { exit_with(1); }
    0
}


