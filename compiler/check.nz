// The checker's command-line driver.
//
// Usage: check FILE
// Output: one diagnostic per line, `CODE|start|end|message`. Exits 1 if there were any.

use "analyse.nz";

fn main() -> Int {
    if args_count() < 1 {
        eprint("usage: check FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    let naux = ints_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx, naux);

    let kids = ints_new();
    let kid_first = ints_new();
    build_children(nk, nar, kids, kid_first);

    // Signatures before any body, so a forward reference resolves — the same two-pass
    // shape `nazm-lir::lower` uses, and for the same reason.
    let fnames = strs_new();
    let fret = ints_new();
    let ffirst = ints_new();
    let fcount = ints_new();
    let fparams = ints_new();
    collect_signatures(nk, nar, ntx, kids, kid_first, fnames, fret, ffirst, fcount, fparams);

    // The built-ins share the ordinary function namespace, exactly as `docs/spec.md`
    // says, so a call to one is not an undefined function.
    let bnames = strs_new();
    let bret = ints_new();
    let bfirst = ints_new();
    let bcount = ints_new();
    let bparams = ints_new();
    builtins(bnames, bret, bfirst, bcount, bparams);

    let dcode = strs_new();
    let dstart = ints_new();
    let dend = ints_new();
    let dmsg = strs_new();
    let nslot = ints_new();
    let ntype = ints_new();
    check_all(nk, nar, nst, nen, ntx, naux, nslot, ntype, kids, kid_first, ints_len(nk) - 1,
              fnames, fret, ffirst, fcount, fparams,
              bnames, bret, bfirst, bcount, bparams,
              dcode, dstart, dend, dmsg);

    let mut out = "";
    let mut d = 0;
    while d < strs_len(dcode) {
        out = str_concat(out, strs_get(dcode, d));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(dstart, d)));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(dend, d)));
        out = str_concat(out, "|");
        out = str_concat(out, strs_get(dmsg, d));
        out = str_concat(out, str_from_byte(10));
        d = d + 1;
    }
    print(out);
    if strs_len(dcode) > 0 { exit_with(1); }
    0
}


