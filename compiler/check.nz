// The checker's command-line driver.
//
// Usage: check FILE CORE-PRELUDE
// Output: one diagnostic per line, `CODE|start|end|message`. Exits 1 if there were any.

use "analyse.nz";
use "module.nz";

fn main() -> Int {
    if args_count() < 2 {
        eprint("usage: check FILE CORE-PRELUDE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    // One file is one module, and this driver is handed one file — so the graph is that
    // module at offset zero, importing nothing but the core prelude, which every
    // compilation has. The tables exist even here, because the checker asks about
    // ownership unconditionally and a checker that special-cased the single-module
    // program would be a second answer to the same question.
    let mpath = strs_new();
    strs_push(mpath, path);
    let mstart = ints_new();
    ints_push(mstart, 0);
    let mfirst = ints_new();
    ints_push(mfirst, 0);
    let mcount = ints_new();
    ints_push(mcount, 0);
    let mto = ints_new();
    let mat = ints_new();
    let src = attach_core(arg(1), read_file(path), mpath, mstart, mfirst, mcount, mto, mat);

    // The whole front end, as one stage: the checked program, or its diagnostics. This
    // driver's output is the diagnostics, so a program that checked prints nothing.
    let diags = match check_program(src, mpath, mstart, mfirst, mcount, mto, mat) {
        Result.Ok(value: checked) => vec_new[Diag](),
        Result.Err(error: found) => found,
    };

    // One allocation for the whole output; see the note in `lexer.nz`.
    let nl = str_from_byte(10);
    let out = strs_new();
    let mut d = 0;
    while d < vec_len(diags) {
        let one = vec_get(diags, d);
        strs_push(out, one.code);
        strs_push(out, "|");
        strs_push(out, int_to_str(one.start));
        strs_push(out, "|");
        strs_push(out, int_to_str(one.end));
        strs_push(out, "|");
        strs_push(out, one.message);
        strs_push(out, nl);
        d = d + 1;
    }
    print(str_join(out, ""));
    if vec_len(diags) > 0 { exit_with(1); }
    0
}
