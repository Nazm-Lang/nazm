// The Nazm parser, written in Nazm — expressions and function headers.
//
// Second component of the self-hosted compiler. It reads the token arrays
// `compiler/lexer.nz` produces and appends syntax nodes to an arena in **post-order**,
// which is the encoding `crates/nazm-cli/tests/selfhost.rs` compares against the
// reference parser: post-order plus arity is a complete description of a tree, so
// agreement on the dump is agreement on the tree.
//
// # No recursion, and how
//
// Expressions are parsed by **shunting-yard**: an operator stack, a stack of operand
// spans, and one loop. Nesting — parentheses and call arguments — is a sentinel on the
// operator stack rather than a call frame. That is the B5 decision made concrete for the
// hardest part of a parser, and it is why this compiles natively today.
//
// # Scope of this increment
//
// A construct this increment does not parse is named, at its own position, rather than
// left to fail as "expected an expression" — which would be true but useless.
fn refuse_unimplemented(kinds: Ints, starts: Ints, i: Int) -> Int {
    let t = kind_at(kinds, i);
    let mut what = "";
    if t == k_if() { what = "`if`"; }
    if t == k_lbrace() { what = "a block used as an expression"; }
    if what == "" { return 0; }
    die(str_concat(what, ": not implemented yet in this parser"), start_at(starts, i));
    0
}

// Whole functions: parameters, a body of statements, `let` and `let mut`, assignment,
// `while` with nested blocks, `return`, `break`, `continue`, expression statements and a
// block's tail value — over the whole expression grammar (literals, variables, unary
// minus, `+ - * / %`, the six comparisons with their real precedence and associativity,
// parentheses, calls of any arity).
//
// **`if` is not parsed yet**, and neither is a bare block used as an expression. Both
// suspend an expression part-way to parse a block, which the shunting-yard stacks cannot
// yet express; that is the next increment. A construct outside the scope is refused by
// name at its own position, never misparsed.

use "lex.nz";

// --- node kinds --------------------------------------------------------------------

fn n_int() -> Int { 1 }
fn n_bool() -> Int { 2 }
fn n_str() -> Int { 3 }
fn n_var() -> Int { 4 }
fn n_neg() -> Int { 5 }
fn n_bin() -> Int { 6 }
fn n_call() -> Int { 7 }
fn n_block() -> Int { 8 }
fn n_param() -> Int { 9 }
fn n_fn() -> Int { 10 }
fn n_program() -> Int { 11 }
fn n_let() -> Int { 12 }
fn n_assign() -> Int { 13 }
fn n_while() -> Int { 14 }
fn n_return() -> Int { 15 }
fn n_break() -> Int { 16 }
fn n_continue() -> Int { 17 }
fn n_exprstmt() -> Int { 18 }

fn node_name(k: Int) -> Str {
    if k == n_int() { return "int"; }
    if k == n_bool() { return "bool"; }
    if k == n_str() { return "str"; }
    if k == n_var() { return "var"; }
    if k == n_neg() { return "neg"; }
    if k == n_bin() { return "bin"; }
    if k == n_call() { return "call"; }
    if k == n_block() { return "block"; }
    if k == n_param() { return "param"; }
    if k == n_fn() { return "fn"; }
    if k == n_program() { return "program"; }
    if k == n_let() { return "let"; }
    if k == n_assign() { return "assign"; }
    if k == n_while() { return "while"; }
    if k == n_return() { return "return"; }
    if k == n_break() { return "break"; }
    if k == n_continue() { return "continue"; }
    if k == n_exprstmt() { return "exprstmt"; }
    "?"
}

// --- operator codes on the shunting-yard stack -------------------------------------
//
// 1..3 are precedence levels and also act as the precedence itself. 90 and 92 are
// sentinels that stop a reduction; 91 is a pending unary minus.

fn prec_of(kind: Int) -> Int {
    if kind == k_eqeq() { return 1; }
    if kind == k_noteq() { return 1; }
    if kind == k_lt() { return 1; }
    if kind == k_lteq() { return 1; }
    if kind == k_gt() { return 1; }
    if kind == k_gteq() { return 1; }
    if kind == k_plus() { return 2; }
    if kind == k_minus() { return 2; }
    if kind == k_star() { return 3; }
    if kind == k_slash() { return 3; }
    if kind == k_percent() { return 3; }
    0
}

fn op_symbol(kind: Int) -> Str {
    if kind == k_eqeq() { return "=="; }
    if kind == k_noteq() { return "!="; }
    if kind == k_lt() { return "<"; }
    if kind == k_lteq() { return "<="; }
    if kind == k_gt() { return ">"; }
    if kind == k_gteq() { return ">="; }
    if kind == k_plus() { return "+"; }
    if kind == k_minus() { return "-"; }
    if kind == k_star() { return "*"; }
    if kind == k_slash() { return "/"; }
    if kind == k_percent() { return "%"; }
    "?"
}

fn sent_paren() -> Int { 90 }
fn sent_unary() -> Int { 91 }
fn sent_call() -> Int { 92 }

// --- the arena ---------------------------------------------------------------------

fn emit(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, kind: Int, arity: Int, from: Int, to: Int, text: Str) -> Int {
    ints_push(nk, kind);
    ints_push(nar, arity);
    ints_push(nst, from);
    ints_push(nen, to);
    strs_push(ntx, text);
    ints_len(nk)
}

// --- token access -------------------------------------------------------------------

fn kind_at(kinds: Ints, i: Int) -> Int {
    if i < 0 { return 0 - 1; }
    if i >= ints_len(kinds) { return 0 - 1; }
    ints_get(kinds, i)
}

fn start_at(starts: Ints, i: Int) -> Int {
    if i < 0 { return 0; }
    if i >= ints_len(starts) { return 0; }
    ints_get(starts, i)
}

fn end_at(ends: Ints, i: Int) -> Int {
    if i < 0 { return 0; }
    if i >= ints_len(ends) { return 0; }
    ints_get(ends, i)
}

fn text_at(texts: Strs, i: Int) -> Str {
    if i < 0 { return ""; }
    if i >= strs_len(texts) { return ""; }
    strs_get(texts, i)
}

fn die(message: Str, offset: Int) -> Int {
    eprint("parse error at ");
    eprint(int_to_str(offset));
    eprint(": ");
    eprint(message);
    eprint(str_from_byte(10));
    exit_with(1);
    0
}

// --- expressions, by shunting-yard --------------------------------------------------
//
// Returns the token index just past the expression. Every operand's span is kept on
// `vs`/`ve` so a reduction can compute the compound span the reference parser gives:
// a binary node spans from its left operand's start to its right operand's end, a
// negation from the `-` to its operand's end, and a parenthesised expression keeps its
// own span rather than the brackets'.
fn parse_expr(kinds: Ints, starts: Ints, ends: Ints, texts: Strs, from: Int,
              nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs) -> Int {
    let ops = ints_new();       // operator kinds and sentinels
    let opat = ints_new();      // where each entry began, for spans
    let cname = strs_new();     // call names, innermost last
    let cargs = ints_new();     // arguments completed so far, per call
    let vs = ints_new();        // operand span starts
    let ve = ints_new();        // operand span ends
    let mut i = from;

    while true {
        // --- prefix: any run of unary minus -----------------------------------------
        while kind_at(kinds, i) == k_minus() {
            ints_push(ops, sent_unary());
            ints_push(opat, start_at(starts, i));
            i = i + 1;
        }

        // --- a primary ---------------------------------------------------------------
        let t = kind_at(kinds, i);
        let mut done_primary = false;

        if t == k_int() {
            emit(nk, nar, nst, nen, ntx, n_int(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
            ints_push(vs, start_at(starts, i));
            ints_push(ve, end_at(ends, i));
            i = i + 1;
            done_primary = true;
        }
        if t == k_true() {
            emit(nk, nar, nst, nen, ntx, n_bool(), 0, start_at(starts, i), end_at(ends, i), "true");
            ints_push(vs, start_at(starts, i));
            ints_push(ve, end_at(ends, i));
            i = i + 1;
            done_primary = true;
        }
        if t == k_false() {
            emit(nk, nar, nst, nen, ntx, n_bool(), 0, start_at(starts, i), end_at(ends, i), "false");
            ints_push(vs, start_at(starts, i));
            ints_push(ve, end_at(ends, i));
            i = i + 1;
            done_primary = true;
        }
        if t == k_str() {
            emit(nk, nar, nst, nen, ntx, n_str(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
            ints_push(vs, start_at(starts, i));
            ints_push(ve, end_at(ends, i));
            i = i + 1;
            done_primary = true;
        }
        if t == k_lparen() {
            // A sentinel, not a frame: nesting is depth on this stack.
            ints_push(ops, sent_paren());
            ints_push(opat, start_at(starts, i));
            i = i + 1;
            continue;
        }
        if t == k_ident() {
            if kind_at(kinds, i + 1) == k_lparen() {
                let name = text_at(texts, i);
                let at = start_at(starts, i);
                i = i + 2;
                if kind_at(kinds, i) == k_rparen() {
                    // No arguments: the call is complete without ever opening a frame.
                    emit(nk, nar, nst, nen, ntx, n_call(), 0, at, end_at(ends, i), name);
                    ints_push(vs, at);
                    ints_push(ve, end_at(ends, i));
                    i = i + 1;
                    done_primary = true;
                } else {
                    ints_push(ops, sent_call());
                    ints_push(opat, at);
                    strs_push(cname, name);
                    ints_push(cargs, 0);
                    continue;
                }
            } else {
                emit(nk, nar, nst, nen, ntx, n_var(), 0, start_at(starts, i), end_at(ends, i), text_at(texts, i));
                ints_push(vs, start_at(starts, i));
                ints_push(ve, end_at(ends, i));
                i = i + 1;
                done_primary = true;
            }
        }

        if done_primary == false {
            die("expected an expression", start_at(starts, i));
        }

        // --- everything after an operand ---------------------------------------------
        while true {
            // Pending unary minus binds tighter than any binary operator, so it is
            // applied as soon as its operand exists.
            while ints_len(ops) > 0 {
                if ints_get(ops, ints_len(ops) - 1) != sent_unary() { break; }
                let at = ints_get(opat, ints_len(opat) - 1);
                pop_op(ops, opat);
                let e = ints_get(ve, ints_len(ve) - 1);
                pop_val(vs, ve);
                emit(nk, nar, nst, nen, ntx, n_neg(), 1, at, e, "");
                ints_push(vs, at);
                ints_push(ve, e);
            }

            let n = kind_at(kinds, i);
            let p = prec_of(n);

            if p > 0 {
                // Left-associative: reduce everything of equal or higher precedence
                // before pushing, which is what makes `a - b - c` group as `(a-b)-c`.
                while ints_len(ops) > 0 {
                    let top = ints_get(ops, ints_len(ops) - 1);
                    if prec_of(top) < p { break; }
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx);
                }
                ints_push(ops, n);
                ints_push(opat, start_at(starts, i));
                i = i + 1;
                break;
            }

            if n == k_comma() {
                if innermost_is_call(ops) == false { return i; }
                while prec_of(ints_get(ops, ints_len(ops) - 1)) > 0 {
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx);
                }
                ints_set(cargs, ints_len(cargs) - 1, ints_get(cargs, ints_len(cargs) - 1) + 1);
                i = i + 1;
                break;
            }

            if n == k_rparen() {
                if ints_len(ops) == 0 { return i; }
                while prec_of(ints_get(ops, ints_len(ops) - 1)) > 0 {
                    reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx);
                }
                let top = ints_get(ops, ints_len(ops) - 1);
                if top == sent_paren() {
                    // The brackets contribute no node and no span: `(1 + 2)` is the same
                    // tree as `1 + 2`, which is what the reference parser produces.
                    pop_op(ops, opat);
                    i = i + 1;
                    continue;
                }
                if top == sent_call() {
                    let at = ints_get(opat, ints_len(opat) - 1);
                    pop_op(ops, opat);
                    let argc = ints_get(cargs, ints_len(cargs) - 1) + 1;
                    let name = strs_get(cname, strs_len(cname) - 1);
                    pop_call(cname, cargs);
                    let to = end_at(ends, i);
                    // The arguments are already in the arena, in order, immediately
                    // before this node — which is exactly what post-order means.
                    let mut drop = 0;
                    while drop < argc { pop_val(vs, ve); drop = drop + 1; }
                    emit(nk, nar, nst, nen, ntx, n_call(), argc, at, to, name);
                    ints_push(vs, at);
                    ints_push(ve, to);
                    i = i + 1;
                    continue;
                }
                return i;
            }

            // Anything else ends the expression. Whatever is still on the operator
            // stack is a real operator awaiting its reduction.
            while ints_len(ops) > 0 {
                if prec_of(ints_get(ops, ints_len(ops) - 1)) == 0 {
                    die("this bracket is never closed", ints_get(opat, ints_len(opat) - 1));
                }
                reduce(ops, opat, vs, ve, nk, nar, nst, nen, ntx);
            }
            return i;
        }
    }
    i
}

fn pop_op(ops: Ints, opat: Ints) -> Int {
    ints_pop(opat);
    ints_pop(ops)
}

fn pop_val(vs: Ints, ve: Ints) -> Int {
    ints_pop(ve);
    ints_pop(vs)
}

fn pop_call(cname: Strs, cargs: Ints) -> Int {
    strs_pop(cname);
    ints_pop(cargs)
}

fn innermost_is_call(ops: Ints) -> Bool {
    let mut i = ints_len(ops) - 1;
    while i >= 0 {
        let v = ints_get(ops, i);
        if v == sent_call() { return true; }
        if v == sent_paren() { return false; }
        i = i - 1;
    }
    false
}

fn reduce(ops: Ints, opat: Ints, vs: Ints, ve: Ints, nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs) -> Int {
    let op = ints_get(ops, ints_len(ops) - 1);
    pop_op(ops, opat);
    let rend = ints_get(ve, ints_len(ve) - 1);
    pop_val(vs, ve);
    let lstart = ints_get(vs, ints_len(vs) - 1);
    pop_val(vs, ve);
    emit(nk, nar, nst, nen, ntx, n_bin(), 2, lstart, rend, op_symbol(op));
    ints_push(vs, lstart);
    ints_push(ve, rend);
    0
}

// --- statements, blocks and functions, by an explicit frame stack --------------------
//
// A block contains statements; a `while` contains a block; a function body is a block.
// That nesting is a stack, and here it is one — `fk`/`fstart`/`fcount`/`ftail`/`faux`/
// `ftext`/`fparams`, innermost last — walked by a single loop. No recursion, which is
// the same reason the expression parser uses sentinels rather than frames.

fn expect(kinds: Ints, starts: Ints, i: Int, want: Int, what: Str) -> Int {
    if kind_at(kinds, i) != want {
        die(what, start_at(starts, i));
    }
    i + 1
}

fn frame_body() -> Int { 1 }
fn frame_while() -> Int { 2 }

fn push_frame(fk: Ints, fstart: Ints, fcount: Ints, ftail: Ints, faux: Ints, fparams: Ints,
              ftext: Strs, kind: Int, start: Int, aux: Int, params: Int, text: Str) -> Int {
    ints_push(fk, kind);
    ints_push(fstart, start);
    ints_push(fcount, 0);
    ints_push(ftail, 0);
    ints_push(faux, aux);
    ints_push(fparams, params);
    strs_push(ftext, text);
    ints_len(fk)
}

fn top(a: Ints) -> Int { ints_get(a, ints_len(a) - 1) }

fn bump(a: Ints) -> Int {
    ints_set(a, ints_len(a) - 1, ints_get(a, ints_len(a) - 1) + 1);
    0
}

fn parse_program(kinds: Ints, starts: Ints, ends: Ints, texts: Strs,
                 nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs) -> Int {
    let fk = ints_new();
    let fstart = ints_new();
    let fcount = ints_new();
    let ftail = ints_new();
    let faux = ints_new();
    let fparams = ints_new();
    let ftext = strs_new();

    let mut i = 0;
    let mut functions = 0;

    while i < ints_len(kinds) {
        if ints_len(fk) == 0 {
            // --- top level: an import, or a function header ------------------------
            if kind_at(kinds, i) == k_use() {
                // Imports are the driver's business, not the grammar's, and contribute
                // no node — exactly as the reference parser treats them.
                i = i + 1;
                i = expect(kinds, starts, i, k_str(), "expected a quoted path");
                i = expect(kinds, starts, i, k_semi(), "expected `;` after an import");
                continue;
            }
            let fn_start = start_at(starts, i);
            i = expect(kinds, starts, i, k_fn(), "expected `fn`");
            if kind_at(kinds, i) != k_ident() {
                die("expected a function name", start_at(starts, i));
            }
            let name = text_at(texts, i);
            i = i + 1;
            i = expect(kinds, starts, i, k_lparen(), "expected `(` after the function name");
            let mut params = 0;
            while kind_at(kinds, i) != k_rparen() {
                if kind_at(kinds, i) != k_ident() {
                    die("expected a parameter name", start_at(starts, i));
                }
                let pname = text_at(texts, i);
                let pstart = start_at(starts, i);
                i = i + 1;
                i = expect(kinds, starts, i, k_colon(), "expected `:` after a parameter name");
                if kind_at(kinds, i) != k_ident() {
                    die("expected a type", start_at(starts, i));
                }
                let ptype = text_at(texts, i);
                let pend = end_at(ends, i);
                i = i + 1;
                emit(nk, nar, nst, nen, ntx, n_param(), 0, pstart, pend,
                     str_concat(str_concat(pname, ":"), ptype));
                params = params + 1;
                if kind_at(kinds, i) == k_comma() { i = i + 1; }
            }
            i = i + 1;
            i = expect(kinds, starts, i, k_arrow(), "expected `->` and a return type");
            if kind_at(kinds, i) != k_ident() {
                die("expected a return type", start_at(starts, i));
            }
            let ret = text_at(texts, i);
            i = i + 1;
            let brace = start_at(starts, i);
            i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start the body");
            push_frame(fk, fstart, fcount, ftail, faux, fparams, ftext,
                       frame_body(), brace, fn_start, params,
                       str_concat(str_concat(name, ":"), ret));
            continue;
        }

        // --- inside a block ---------------------------------------------------------
        let t = kind_at(kinds, i);

        if t == k_rbrace() {
            let close = end_at(ends, i);
            i = i + 1;
            let kind = top(fk);
            let start = top(fstart);
            let count = top(fcount);
            let tail = top(ftail);
            let aux = top(faux);
            let params = top(fparams);
            let text = strs_get(ftext, strs_len(ftext) - 1);
            ints_pop(fk);
            ints_pop(fstart);
            ints_pop(fcount);
            ints_pop(ftail);
            ints_pop(faux);
            ints_pop(fparams);
            strs_pop(ftext);
            emit(nk, nar, nst, nen, ntx, n_block(), count + tail, start, close,
                 if tail == 1 { "tail" } else { "" });
            if kind == frame_while() {
                // The condition was emitted before the body, so the two children are
                // already in post-order and the `while` closes over them.
                emit(nk, nar, nst, nen, ntx, n_while(), 2, aux, close, "");
                bump(fcount);
            } else {
                emit(nk, nar, nst, nen, ntx, n_fn(), params + 1, aux, close, text);
                functions = functions + 1;
            }
            continue;
        }

        if top(ftail) == 1 {
            die("this block already produced its value; nothing can follow it",
                start_at(starts, i));
        }

        if t == k_let() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let mut mutable = 0;
            if kind_at(kinds, i) == k_mut() { mutable = 1; i = i + 1; }
            if kind_at(kinds, i) != k_ident() {
                die("expected a name after `let`", start_at(starts, i));
            }
            let name = text_at(texts, i);
            i = i + 1;
            i = expect(kinds, starts, i, k_eq(), "expected `=` in a `let`");
            i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx);
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after a `let`");
            emit(nk, nar, nst, nen, ntx, n_let(), 1, stmt_start, semi,
                 str_concat(str_concat(name, ":"), int_to_str(mutable)));
            bump(fcount);
            continue;
        }

        if t == k_ident() {
            if kind_at(kinds, i + 1) == k_eq() {
                let stmt_start = start_at(starts, i);
                let name = text_at(texts, i);
                i = i + 2;
                i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx);
                let semi = end_at(ends, i);
                i = expect(kinds, starts, i, k_semi(), "expected `;` after an assignment");
                emit(nk, nar, nst, nen, ntx, n_assign(), 1, stmt_start, semi, name);
                bump(fcount);
                continue;
            }
        }

        if t == k_while() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx);
            let brace = start_at(starts, i);
            i = expect(kinds, starts, i, k_lbrace(), "expected `{` to start a loop body");
            push_frame(fk, fstart, fcount, ftail, faux, fparams, ftext,
                       frame_while(), brace, stmt_start, 0, "");
            continue;
        }

        if t == k_return() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx);
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after a `return`");
            emit(nk, nar, nst, nen, ntx, n_return(), 1, stmt_start, semi, "");
            bump(fcount);
            continue;
        }

        // The span of `break;` covers the `;` as well as the keyword, which is what the
        // reference parser records — a statement's span is the statement, semicolon
        // included.
        if t == k_break() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after `break`");
            emit(nk, nar, nst, nen, ntx, n_break(), 0, stmt_start, semi, "");
            bump(fcount);
            continue;
        }

        if t == k_continue() {
            let stmt_start = start_at(starts, i);
            i = i + 1;
            let semi = end_at(ends, i);
            i = expect(kinds, starts, i, k_semi(), "expected `;` after `continue`");
            emit(nk, nar, nst, nen, ntx, n_continue(), 0, stmt_start, semi, "");
            bump(fcount);
            continue;
        }

        // An expression: a statement if a `;` follows, the block's value if not.
        refuse_unimplemented(kinds, starts, i);
        let expr_start = start_at(starts, i);
        i = parse_expr(kinds, starts, ends, texts, i, nk, nar, nst, nen, ntx);
        if kind_at(kinds, i) == k_semi() {
            let semi = end_at(ends, i);
            let _ = semi;
            emit(nk, nar, nst, nen, ntx, n_exprstmt(), 1, expr_start,
                 end_at(ends, i - 1), "");
            i = i + 1;
            bump(fcount);
        } else {
            ints_set(ftail, ints_len(ftail) - 1, 1);
        }
    }

    if ints_len(fk) > 0 {
        die("this block is never closed", top(fstart));
    }
    emit(nk, nar, nst, nen, ntx, n_program(), functions, 0, 0, "");
    functions
}

// --- driver --------------------------------------------------------------------------

fn main() -> Int {
    if args_count() < 1 {
        eprint("usage: parser FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx);

    // `kind|arity|start|end|text`, one node per line, in the order they were appended —
    // which is post-order, which is the whole encoding.
    let mut out = "";
    let mut i = 0;
    while i < ints_len(nk) {
        out = str_concat(out, node_name(ints_get(nk, i)));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(nar, i)));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(nst, i)));
        out = str_concat(out, "|");
        out = str_concat(out, int_to_str(ints_get(nen, i)));
        out = str_concat(out, "|");
        out = str_concat(out, strs_get(ntx, i));
        out = str_concat(out, str_from_byte(10));
        i = i + 1;
    }
    print(out);
    ints_len(nk)
}
