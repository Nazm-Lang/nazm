// The parser's command-line driver.
//
// Usage: parser FILE
// Output: one node per line, `kind|arity|start|end|text`, in post-order.

use "parse.nz";
use "lex.nz";

fn main() -> Int {
    if args_count() < 1 {
        eprint("usage: parser FILE");
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let path = arg(0);
    if file_exists(path) == false {
        eprint(str_concat("cannot read ", path));
        eprint(str_from_byte(10));
        exit_with(2);
    }
    let src = read_file(path);

    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    let naux = ints_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx, naux);

    // `kind|arity|start|end|text`, one node per line, in the order they were appended —
    // which is post-order, which is the whole encoding.
    // One allocation for the whole output; see the note in `lexer.nz`.
    let nl = str_from_byte(10);
    let out = strs_new();
    let mut i = 0;
    while i < ints_len(nk) {
        strs_push(out, node_name(ints_get(nk, i)));
        strs_push(out, "|");
        strs_push(out, int_to_str(ints_get(nar, i)));
        strs_push(out, "|");
        strs_push(out, int_to_str(ints_get(nst, i)));
        strs_push(out, "|");
        strs_push(out, int_to_str(ints_get(nen, i)));
        strs_push(out, "|");
        strs_push(out, strs_get(ntx, i));
        strs_push(out, nl);
        i = i + 1;
    }
    print(str_join(out, ""));
    ints_len(nk)
}
