// The standard library and the core prelude, as the repository holds them (R8 slice 12): generated by
// `toolchain/commands/tests/gen-stdlib.py`, never edited. The Rust compiler carries the same bytes
// (`nazm-sema/src/stdlib.rs`); with these the Nazm compiler reads no `NAZM_LIBRARY`.

pub fn sd_names() -> Strs {
    let s = strs_new()
    strs_push(s, "args")
    strs_push(s, "audit")
    strs_push(s, "binary")
    strs_push(s, "bitset")
    strs_push(s, "blake3")
    strs_push(s, "bytebuf")
    strs_push(s, "chan")
    strs_push(s, "config")
    strs_push(s, "deque")
    strs_push(s, "dist")
    strs_push(s, "env")
    strs_push(s, "error")
    strs_push(s, "file")
    strs_push(s, "fmt")
    strs_push(s, "fs")
    strs_push(s, "hal")
    strs_push(s, "hash")
    strs_push(s, "hashmap")
    strs_push(s, "hashset")
    strs_push(s, "http")
    strs_push(s, "io")
    strs_push(s, "ioerror")
    strs_push(s, "json")
    strs_push(s, "linalg")
    strs_push(s, "log")
    strs_push(s, "map")
    strs_push(s, "metrics")
    strs_push(s, "net")
    strs_push(s, "num")
    strs_push(s, "option")
    strs_push(s, "ordmap")
    strs_push(s, "path")
    strs_push(s, "process")
    strs_push(s, "random")
    strs_push(s, "regex")
    strs_push(s, "result")
    strs_push(s, "seq")
    strs_push(s, "sha256")
    strs_push(s, "show")
    strs_push(s, "sort")
    strs_push(s, "test")
    strs_push(s, "text")
    strs_push(s, "time")
    strs_push(s, "tls")
    strs_push(s, "toml")
    s
}

// A standard module's source, "" for a name that is not one.
pub fn sd_std(name: Str) -> Str {
    if name == "args" { return sd_m_args() }
    if name == "audit" { return sd_m_audit() }
    if name == "binary" { return sd_m_binary() }
    if name == "bitset" { return sd_m_bitset() }
    if name == "blake3" { return sd_m_blake3() }
    if name == "bytebuf" { return sd_m_bytebuf() }
    if name == "chan" { return sd_m_chan() }
    if name == "config" { return sd_m_config() }
    if name == "deque" { return sd_m_deque() }
    if name == "dist" { return sd_m_dist() }
    if name == "env" { return sd_m_env() }
    if name == "error" { return sd_m_error() }
    if name == "file" { return sd_m_file() }
    if name == "fmt" { return sd_m_fmt() }
    if name == "fs" { return sd_m_fs() }
    if name == "hal" { return sd_m_hal() }
    if name == "hash" { return sd_m_hash() }
    if name == "hashmap" { return sd_m_hashmap() }
    if name == "hashset" { return sd_m_hashset() }
    if name == "http" { return sd_m_http() }
    if name == "io" { return sd_m_io() }
    if name == "ioerror" { return sd_m_ioerror() }
    if name == "json" { return sd_m_json() }
    if name == "linalg" { return sd_m_linalg() }
    if name == "log" { return sd_m_log() }
    if name == "map" { return sd_m_map() }
    if name == "metrics" { return sd_m_metrics() }
    if name == "net" { return sd_m_net() }
    if name == "num" { return sd_m_num() }
    if name == "option" { return sd_m_option() }
    if name == "ordmap" { return sd_m_ordmap() }
    if name == "path" { return sd_m_path() }
    if name == "process" { return sd_m_process() }
    if name == "random" { return sd_m_random() }
    if name == "regex" { return sd_m_regex() }
    if name == "result" { return sd_m_result() }
    if name == "seq" { return sd_m_seq() }
    if name == "sha256" { return sd_m_sha256() }
    if name == "show" { return sd_m_show() }
    if name == "sort" { return sd_m_sort() }
    if name == "test" { return sd_m_test() }
    if name == "text" { return sd_m_text() }
    if name == "time" { return sd_m_time() }
    if name == "tls" { return sd_m_tls() }
    if name == "toml" { return sd_m_toml() }
    ""
}

pub fn sd_prelude() -> Str {
    let l = strs_new()
    strs_push(l, "// The core prelude: the two types every module can name without importing them.")
    strs_push(l, "//")
    strs_push(l, "// Ordinary source, checked by the ordinary checker like any other module. Nothing about")
    strs_push(l, "// these two enums is special to the compiler except where they live: this file is the")
    strs_push(l, "// module `@core/prelude`, owned by the toolchain rather than by a project, and every")
    strs_push(l, "// module imports it implicitly. `docs/user/spec.md`, *The core prelude*, owns the rules.")
    strs_push(l, "//")
    strs_push(l, "// `?` recognises `Result` by that identity — this module and this name — and never by")
    strs_push(l, "// the shape of its variants, which is why a project may not declare a type of either")
    strs_push(l, "// name.")
    strs_push(l, "")
    strs_push(l, "/// The outcome of something that can fail: a value, or a typed error value.")
    strs_push(l, "pub enum Result[T, E] {")
    strs_push(l, "    Ok(value: T),")
    strs_push(l, "    Err(error: E),")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A value that may be absent. There is no null: `None` is a variant like any other.")
    strs_push(l, "pub enum Option[T] {")
    strs_push(l, "    None,")
    strs_push(l, "    Some(value: T),")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_args() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/args`: a program's command line, parsed against a specification (R1e, S4).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/args\";`. A specification is built by functions: `args_program` makes")
    strs_push(l, "// the top command, `args_command` a sub-command under one, and `args_flag`, `args_option` and their")
    strs_push(l, "// kin declare what each command accepts. `args_parse` reads the arguments — `process_args(io)` of")
    strs_push(l, "// `@std/process`, or any `Strs` — into an `Args`, which is read by name: `args_has`, `args_times`,")
    strs_push(l, "// `args_get`, `args_get_all`, and `args_subcommand` for the sub-command chosen.")
    strs_push(l, "//")
    strs_push(l, "// The command line is read as POSIX and GNU tools read it: `--name`, `--name value` and")
    strs_push(l, "// `--name=value`; `-n`, `-n value` and `-nvalue`; flags bundled as `-abc`, the last of them able")
    strs_push(l, "// to take a value; `--` ending the options, so that every argument after it is positional; `-`")
    strs_push(l, "// alone a positional argument. An option that takes a value takes the next argument whatever it")
    strs_push(l, "// is. A command's options are also accepted after any of its sub-commands is named. `--help` (and")
    strs_push(l, "// `-h`, unless a command takes `-h` for itself) asks for help: parsing stops there, nothing is")
    strs_push(l, "// required, and `args_help_text` is the help of the command reached. Every other mistake is an")
    strs_push(l, "// `Err` naming the command and the argument at fault (\"nazm build: unknown option `--frob`\");")
    strs_push(l, "// nothing traps.")
    strs_push(l, "")
    strs_push(l, "// Kinds of argument, by number.")
    strs_push(l, "fn k_flag() -> Int ! {} { 0 }")
    strs_push(l, "fn k_option() -> Int ! {} { 1 }")
    strs_push(l, "fn k_positional() -> Int ! {} { 2 }")
    strs_push(l, "fn k_rest() -> Int ! {} { 3 }")
    strs_push(l, "")
    strs_push(l, "/// One command: its name, what it does, and the command it is under (-1 for the top one).")
    strs_push(l, "pub struct ArgCmd {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    about: Str,")
    strs_push(l, "    parent: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One argument a command accepts. `name` is its long name (a positional argument's name);")
    strs_push(l, "/// `short` is one byte or empty.")
    strs_push(l, "pub struct ArgDecl {")
    strs_push(l, "    cmd: Int,")
    strs_push(l, "    kind: Int,")
    strs_push(l, "    name: Str,")
    strs_push(l, "    short: Str,")
    strs_push(l, "    value_name: Str,")
    strs_push(l, "    help: Str,")
    strs_push(l, "    default: Str,")
    strs_push(l, "    has_default: Bool,")
    strs_push(l, "    required: Bool,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Two arguments of a command that cannot both be given.")
    strs_push(l, "pub struct ArgConflict {")
    strs_push(l, "    cmd: Int,")
    strs_push(l, "    a: Str,")
    strs_push(l, "    b: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A specification: every command and every argument, in one arena that the commands share.")
    strs_push(l, "pub struct ArgSpec {")
    strs_push(l, "    cmds: Vec[ArgCmd],")
    strs_push(l, "    decls: Vec[ArgDecl],")
    strs_push(l, "    conflicts: Vec[ArgConflict],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A command of a specification, which further arguments and sub-commands are declared on.")
    strs_push(l, "pub struct ArgCommand {")
    strs_push(l, "    spec: ArgSpec,")
    strs_push(l, "    id: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A parsed command line: the command reached, whether help was asked for, and each argument")
    strs_push(l, "/// given, by name, in the order given (a flag's value is empty).")
    strs_push(l, "pub struct Args {")
    strs_push(l, "    spec: ArgSpec,")
    strs_push(l, "    top: Int,")
    strs_push(l, "    cmd: Int,")
    strs_push(l, "    help: Bool,")
    strs_push(l, "    names: Strs,")
    strs_push(l, "    values: Strs,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new specification whose top command is `name` (the program's name, as help shows it), with")
    strs_push(l, "/// `about` saying what it does.")
    strs_push(l, "pub fn args_program(name: Str, about: Str) -> ArgCommand ! {} {")
    strs_push(l, "    let spec = ArgSpec(cmds: vec_new[ArgCmd](), decls: vec_new[ArgDecl](), conflicts: vec_new[ArgConflict]());")
    strs_push(l, "    vec_push(spec.cmds, ArgCmd(name: name, about: about, parent: 0 - 1));")
    strs_push(l, "    ArgCommand(spec: spec, id: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A sub-command `name` of `parent`, chosen by naming it where `parent`'s first positional")
    strs_push(l, "/// argument would be.")
    strs_push(l, "pub fn args_command(parent: ArgCommand, name: Str, about: Str) -> ArgCommand ! {} {")
    strs_push(l, "    vec_push(parent.spec.cmds, ArgCmd(name: name, about: about, parent: parent.id));")
    strs_push(l, "    ArgCommand(spec: parent.spec, id: vec_len(parent.spec.cmds) - 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn declare(c: ArgCommand, kind: Int, name: Str, short: Str, value_name: Str, default: Str, has_default: Bool, required: Bool, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    vec_push(c.spec.decls, ArgDecl(cmd: c.id, kind: kind, name: name, short: short, value_name: value_name, help: help, default: default, has_default: has_default, required: required));")
    strs_push(l, "    c")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A flag `--name` (and `-short`, unless `short` is empty), which takes no value and may be given")
    strs_push(l, "/// any number of times.")
    strs_push(l, "pub fn args_flag(c: ArgCommand, name: Str, short: Str, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_flag(), name, short, \"\", \"\", false, false, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An option `--name VALUE` (and `-short VALUE`, unless `short` is empty), which may be given any")
    strs_push(l, "/// number of times; `value_name` is what help calls its value.")
    strs_push(l, "pub fn args_option(c: ArgCommand, name: Str, short: Str, value_name: Str, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_option(), name, short, value_name, \"\", false, false, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// As `args_option`, with the value `default` when it is not given.")
    strs_push(l, "pub fn args_option_default(c: ArgCommand, name: Str, short: Str, value_name: Str, default: Str, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_option(), name, short, value_name, default, true, false, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// As `args_option`, and an error when it is not given.")
    strs_push(l, "pub fn args_option_required(c: ArgCommand, name: Str, short: Str, value_name: Str, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_option(), name, short, value_name, \"\", false, true, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next positional argument of `c`, read by `name`; when `required`, an error if it is not")
    strs_push(l, "/// given. A required one must be declared before every one that is not.")
    strs_push(l, "pub fn args_positional(c: ArgCommand, name: Str, required: Bool, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_positional(), name, \"\", \"\", \"\", false, required, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every positional argument of `c` after those it declares one by one, read by `name` with")
    strs_push(l, "/// `args_get_all`.")
    strs_push(l, "pub fn args_rest(c: ArgCommand, name: Str, help: Str) -> ArgCommand ! {} {")
    strs_push(l, "    declare(c, k_rest(), name, \"\", \"\", \"\", false, false, help)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The arguments `a` and `b` of `c` (or of a command above it), which cannot both be given.")
    strs_push(l, "pub fn args_conflict(c: ArgCommand, a: Str, b: Str) -> ArgCommand ! {} {")
    strs_push(l, "    vec_push(c.spec.conflicts, ArgConflict(cmd: c.id, a: a, b: b));")
    strs_push(l, "    c")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- looking things up -------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "fn cmd_of(spec: ArgSpec, id: Int) -> ArgCmd ! {} { vec_get(spec.cmds, id) }")
    strs_push(l, "")
    strs_push(l, "fn decl_of(spec: ArgSpec, i: Int) -> ArgDecl ! {} { vec_get(spec.decls, i) }")
    strs_push(l, "")
    strs_push(l, "/// Whether command `inner` is `outer` or under it.")
    strs_push(l, "fn within(spec: ArgSpec, inner: Int, outer: Int) -> Bool ! {} {")
    strs_push(l, "    let mut c = inner;")
    strs_push(l, "    let mut found = false;")
    strs_push(l, "    while c >= 0 {")
    strs_push(l, "        if c == outer { found = true; break; }")
    strs_push(l, "        c = cmd_of(spec, c).parent;")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The declaration a command `cmd` reads as an option or a flag: long name `name` when `short`")
    strs_push(l, "/// is false, short name `name` when it is true; -1 when there is none. The innermost wins.")
    strs_push(l, "fn find_option(spec: ArgSpec, cmd: Int, name: Str, short: Bool) -> Int ! {} {")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    let mut c = cmd;")
    strs_push(l, "    while c >= 0 && found < 0 {")
    strs_push(l, "        for i in 0..vec_len(spec.decls) {")
    strs_push(l, "            let d = decl_of(spec, i);")
    strs_push(l, "            if d.cmd == c && (d.kind == k_flag() || d.kind == k_option()) {")
    strs_push(l, "                let key = if short { d.short } else { d.name };")
    strs_push(l, "                if key == name && key != \"\" { found = i; break; }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        c = cmd_of(spec, c).parent;")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Any declaration named `name` that command `cmd` reads; -1 when there is none.")
    strs_push(l, "fn find_named(spec: ArgSpec, cmd: Int, name: Str) -> Int ! {} {")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    let mut c = cmd;")
    strs_push(l, "    while c >= 0 && found < 0 {")
    strs_push(l, "        for i in 0..vec_len(spec.decls) {")
    strs_push(l, "            let d = decl_of(spec, i);")
    strs_push(l, "            if d.cmd == c && d.name == name { found = i; break; }")
    strs_push(l, "        }")
    strs_push(l, "        c = cmd_of(spec, c).parent;")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The `slot`th positional declaration of `cmd`, the rest if it has run out of single ones; -1.")
    strs_push(l, "fn positional_at(spec: ArgSpec, cmd: Int, slot: Int) -> Int ! {} {")
    strs_push(l, "    let mut seen = 0;")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    let mut rest = 0 - 1;")
    strs_push(l, "    for i in 0..vec_len(spec.decls) {")
    strs_push(l, "        let d = decl_of(spec, i);")
    strs_push(l, "        if d.cmd == cmd && d.kind == k_positional() {")
    strs_push(l, "            if seen == slot { found = i; break; }")
    strs_push(l, "            seen = seen + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if d.cmd == cmd && d.kind == k_rest() && rest < 0 { rest = i; }")
    strs_push(l, "    }")
    strs_push(l, "    if found >= 0 { found } else { rest }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The sub-command of `cmd` named `name`; -1.")
    strs_push(l, "fn find_sub(spec: ArgSpec, cmd: Int, name: Str) -> Int ! {} {")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    for i in 0..vec_len(spec.cmds) {")
    strs_push(l, "        let c = cmd_of(spec, i);")
    strs_push(l, "        if c.parent == cmd && c.name == name { found = i; break; }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn has_subs(spec: ArgSpec, cmd: Int) -> Bool ! {} {")
    strs_push(l, "    let mut found = false;")
    strs_push(l, "    for i in 0..vec_len(spec.cmds) {")
    strs_push(l, "        if cmd_of(spec, i).parent == cmd { found = true; break; }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `cmd`'s name, after the names of the commands above it: `nazm build`.")
    strs_push(l, "fn full_name(spec: ArgSpec, cmd: Int) -> Str ! {} {")
    strs_push(l, "    let c = cmd_of(spec, cmd);")
    strs_push(l, "    if c.parent < 0 { c.name } else { f\"{full_name(spec, c.parent)} {c.name}\" }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How an error or help shows declaration `i`: `--name`, or `<name>` for a positional one.")
    strs_push(l, "fn shown(spec: ArgSpec, i: Int) -> Str ! {} {")
    strs_push(l, "    let d = decl_of(spec, i);")
    strs_push(l, "    if d.kind == k_positional() || d.kind == k_rest() { f\"<{d.name}>\" } else { f\"--{d.name}\" }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What is wrong with the declarations `cmd` reads, or \"\": a name or a short name given twice, a")
    strs_push(l, "/// short name that is not one byte, a required positional argument after one that is not.")
    strs_push(l, "fn check_spec(spec: ArgSpec, cmd: Int) -> Str ! {} {")
    strs_push(l, "    let mut wrong = \"\";")
    strs_push(l, "    let mut optional_seen = false;")
    strs_push(l, "    for i in 0..vec_len(spec.decls) {")
    strs_push(l, "        let d = decl_of(spec, i);")
    strs_push(l, "        if !within(spec, cmd, d.cmd) { continue; }")
    strs_push(l, "        if d.name == \"\" { wrong = \"an argument with no name\"; break; }")
    strs_push(l, "        if d.short != \"\" && (str_len(d.short) != 1 || d.short == \"-\") {")
    strs_push(l, "            wrong = f\"`-{d.short}` is not a one-letter short name\";")
    strs_push(l, "            break;")
    strs_push(l, "        }")
    strs_push(l, "        if d.cmd == cmd && d.kind == k_positional() {")
    strs_push(l, "            if d.required && optional_seen { wrong = f\"the required `<{d.name}>` follows an optional one\"; break; }")
    strs_push(l, "            if !d.required { optional_seen = true; }")
    strs_push(l, "        }")
    strs_push(l, "        for j in 0..i {")
    strs_push(l, "            let e = decl_of(spec, j);")
    strs_push(l, "            if !within(spec, cmd, e.cmd) { continue; }")
    strs_push(l, "            if e.name == d.name { wrong = f\"`{d.name}` is declared twice\"; break; }")
    strs_push(l, "            if d.short != \"\" && e.short == d.short { wrong = f\"`-{d.short}` is declared twice\"; break; }")
    strs_push(l, "        }")
    strs_push(l, "        if wrong != \"\" { break; }")
    strs_push(l, "    }")
    strs_push(l, "    wrong")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn starts_with(s: Str, prefix: Str) -> Bool ! {} {")
    strs_push(l, "    str_len(s) >= str_len(prefix) && str_slice(s, 0, str_len(prefix)) == prefix")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The offset of the first `=` in `s`, or -1.")
    strs_push(l, "fn find_eq(s: Str) -> Int ! {} {")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    for i in 0..str_len(s) {")
    strs_push(l, "        if str_byte(s, i) == 61 { found = i; break; }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn record(names: Strs, values: Strs, name: Str, value: Str) -> Int ! {} {")
    strs_push(l, "    strs_push(names, name);")
    strs_push(l, "    strs_push(values, value);")
    strs_push(l, "    strs_len(names)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn given(names: Strs, name: Str) -> Bool ! {} {")
    strs_push(l, "    let mut found = false;")
    strs_push(l, "    for i in 0..strs_len(names) {")
    strs_push(l, "        if strs_get(names, i) == name { found = true; break; }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn failed(spec: ArgSpec, cmd: Int, what: Str) -> Result[Args, Str] ! {} {")
    strs_push(l, "    Result[Args, Str].Err(error: f\"{full_name(spec, cmd)}: {what}\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- parsing -----------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// `argv` (without the program's name, as `process_args` gives it) read against command `c` and")
    strs_push(l, "/// its sub-commands; an `Err` names the command and the argument at fault.")
    strs_push(l, "pub fn args_parse(c: ArgCommand, argv: Strs) -> Result[Args, Str] ! {} {")
    strs_push(l, "    let spec = c.spec;")
    strs_push(l, "    let mut cmd = c.id;")
    strs_push(l, "    let names = strs_new();")
    strs_push(l, "    let values = strs_new();")
    strs_push(l, "    let mut help = false;")
    strs_push(l, "    let mut options_end = false;")
    strs_push(l, "    let mut slot = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let n = strs_len(argv);")
    strs_push(l, "    let wrong = check_spec(spec, cmd);")
    strs_push(l, "    if wrong != \"\" { return failed(spec, cmd, f\"the specification is wrong: {wrong}\"); }")
    strs_push(l, "    while i < n {")
    strs_push(l, "        let a = strs_get(argv, i);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "        if !options_end && a == \"--\" {")
    strs_push(l, "            options_end = true;")
    strs_push(l, "            continue;")
    strs_push(l, "        }")
    strs_push(l, "        if !options_end && starts_with(a, \"--\") {")
    strs_push(l, "            let body = str_slice(a, 2, str_len(a));")
    strs_push(l, "            let eq = find_eq(body);")
    strs_push(l, "            let name = if eq >= 0 { str_slice(body, 0, eq) } else { body };")
    strs_push(l, "            let d = find_option(spec, cmd, name, false);")
    strs_push(l, "            if d < 0 && name == \"help\" { help = true; break; }")
    strs_push(l, "            if d < 0 { return failed(spec, cmd, f\"unknown option `--{name}`\"); }")
    strs_push(l, "            let decl = decl_of(spec, d);")
    strs_push(l, "            if decl.kind == k_flag() {")
    strs_push(l, "                if eq >= 0 { return failed(spec, cmd, f\"`--{name}` takes no value, and was given `{a}`\"); }")
    strs_push(l, "                record(names, values, decl.name, \"\");")
    strs_push(l, "            } else {")
    strs_push(l, "                if eq >= 0 {")
    strs_push(l, "                    record(names, values, decl.name, str_slice(body, eq + 1, str_len(body)));")
    strs_push(l, "                } else {")
    strs_push(l, "                    if i >= n { return failed(spec, cmd, f\"`--{name}` needs a value `<{decl.value_name}>`\"); }")
    strs_push(l, "                    record(names, values, decl.name, strs_get(argv, i));")
    strs_push(l, "                    i = i + 1;")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            continue;")
    strs_push(l, "        }")
    strs_push(l, "        if !options_end && str_len(a) > 1 && str_byte(a, 0) == 45 {")
    strs_push(l, "            let mut j = 1;")
    strs_push(l, "            let mut wrong_here = \"\";")
    strs_push(l, "            while j < str_len(a) {")
    strs_push(l, "                let b = str_byte(a, j);")
    strs_push(l, "                if b >= 128 { wrong_here = f\"unknown option `{a}`\"; break; }")
    strs_push(l, "                let s = str_slice(a, j, j + 1);")
    strs_push(l, "                j = j + 1;")
    strs_push(l, "                let d = find_option(spec, cmd, s, true);")
    strs_push(l, "                if d < 0 && s == \"h\" { help = true; break; }")
    strs_push(l, "                if d < 0 {")
    strs_push(l, "                    wrong_here = if str_len(a) > 2 { f\"unknown option `-{s}` in `{a}`\" } else { f\"unknown option `-{s}`\" };")
    strs_push(l, "                    break;")
    strs_push(l, "                }")
    strs_push(l, "                let decl = decl_of(spec, d);")
    strs_push(l, "                if decl.kind == k_flag() {")
    strs_push(l, "                    record(names, values, decl.name, \"\");")
    strs_push(l, "                } else {")
    strs_push(l, "                    if j < str_len(a) {")
    strs_push(l, "                        record(names, values, decl.name, str_slice(a, j, str_len(a)));")
    strs_push(l, "                        j = str_len(a);")
    strs_push(l, "                    } else {")
    strs_push(l, "                        if i >= n { wrong_here = f\"`-{s}` needs a value `<{decl.value_name}>`\"; break; }")
    strs_push(l, "                        record(names, values, decl.name, strs_get(argv, i));")
    strs_push(l, "                        i = i + 1;")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            if wrong_here != \"\" { return failed(spec, cmd, wrong_here); }")
    strs_push(l, "            if help { break; }")
    strs_push(l, "            continue;")
    strs_push(l, "        }")
    strs_push(l, "        if !options_end && slot == 0 && has_subs(spec, cmd) {")
    strs_push(l, "            let sub = find_sub(spec, cmd, a);")
    strs_push(l, "            if sub >= 0 {")
    strs_push(l, "                cmd = sub;")
    strs_push(l, "                let wrong_sub = check_spec(spec, cmd);")
    strs_push(l, "                if wrong_sub != \"\" { return failed(spec, cmd, f\"the specification is wrong: {wrong_sub}\"); }")
    strs_push(l, "                continue;")
    strs_push(l, "            }")
    strs_push(l, "            if positional_at(spec, cmd, 0) < 0 { return failed(spec, cmd, f\"unknown command `{a}`\"); }")
    strs_push(l, "        }")
    strs_push(l, "        let p = positional_at(spec, cmd, slot);")
    strs_push(l, "        if p < 0 { return failed(spec, cmd, f\"unexpected argument `{a}`\"); }")
    strs_push(l, "        let decl = decl_of(spec, p);")
    strs_push(l, "        record(names, values, decl.name, a);")
    strs_push(l, "        if decl.kind == k_positional() { slot = slot + 1; }")
    strs_push(l, "    }")
    strs_push(l, "    if !help {")
    strs_push(l, "        for k in 0..vec_len(spec.decls) {")
    strs_push(l, "            let d = decl_of(spec, k);")
    strs_push(l, "            if !within(spec, cmd, d.cmd) || !d.required || given(names, d.name) { continue; }")
    strs_push(l, "            if d.kind == k_positional() {")
    strs_push(l, "                if d.cmd == cmd { return failed(spec, cmd, f\"missing the argument `<{d.name}>`\"); }")
    strs_push(l, "            } else {")
    strs_push(l, "                return failed(spec, cmd, f\"missing the option `--{d.name} <{d.value_name}>`\");")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        for k in 0..vec_len(spec.conflicts) {")
    strs_push(l, "            let x = vec_get(spec.conflicts, k);")
    strs_push(l, "            if within(spec, cmd, x.cmd) && given(names, x.a) && given(names, x.b) {")
    strs_push(l, "                let sa = shown(spec, find_named(spec, cmd, x.a));")
    strs_push(l, "                let sb = shown(spec, find_named(spec, cmd, x.b));")
    strs_push(l, "                return failed(spec, cmd, f\"`{sa}` and `{sb}` cannot be used together\");")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[Args, Str].Ok(value: Args(spec: spec, top: c.id, cmd: cmd, help: help, names: names, values: values))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- reading a parse ---------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// Whether `name` was given at least once.")
    strs_push(l, "pub fn args_has(a: Args, name: Str) -> Bool ! {} {")
    strs_push(l, "    given(a.names, name)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many times `name` was given: `-vvv` is three.")
    strs_push(l, "pub fn args_times(a: Args, name: Str) -> Int ! {} {")
    strs_push(l, "    let mut count = 0;")
    strs_push(l, "    for i in 0..strs_len(a.names) {")
    strs_push(l, "        if strs_get(a.names, i) == name { count = count + 1; }")
    strs_push(l, "    }")
    strs_push(l, "    count")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The last value given for `name`; else its default; else `None`.")
    strs_push(l, "pub fn args_get(a: Args, name: Str) -> Option[Str] ! {} {")
    strs_push(l, "    let mut found = Option[Str].None();")
    strs_push(l, "    for i in 0..strs_len(a.names) {")
    strs_push(l, "        if strs_get(a.names, i) == name { found = Option[Str].Some(value: strs_get(a.values, i)); }")
    strs_push(l, "    }")
    strs_push(l, "    if let Option.None() = found {")
    strs_push(l, "        let d = find_named(a.spec, a.cmd, name);")
    strs_push(l, "        if d >= 0 && decl_of(a.spec, d).has_default {")
    strs_push(l, "            found = Option[Str].Some(value: decl_of(a.spec, d).default);")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value given for `name`, in order; else its default alone; else none.")
    strs_push(l, "pub fn args_get_all(a: Args, name: Str) -> Strs ! {} {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    for i in 0..strs_len(a.names) {")
    strs_push(l, "        if strs_get(a.names, i) == name { strs_push(out, strs_get(a.values, i)); }")
    strs_push(l, "    }")
    strs_push(l, "    if strs_len(out) == 0 {")
    strs_push(l, "        let d = find_named(a.spec, a.cmd, name);")
    strs_push(l, "        if d >= 0 && decl_of(a.spec, d).has_default { strs_push(out, decl_of(a.spec, d).default); }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The sub-commands chosen, outermost first, separated by spaces: `\"\"` when none was, `\"pkg add\"`")
    strs_push(l, "/// for `prog pkg add`.")
    strs_push(l, "pub fn args_subcommand(a: Args) -> Str ! {} {")
    strs_push(l, "    let mut path = \"\";")
    strs_push(l, "    let mut c = a.cmd;")
    strs_push(l, "    while c != a.top && c >= 0 {")
    strs_push(l, "        let cc = cmd_of(a.spec, c);")
    strs_push(l, "        path = if path == \"\" { cc.name } else { f\"{cc.name} {path}\" };")
    strs_push(l, "        c = cc.parent;")
    strs_push(l, "    }")
    strs_push(l, "    path")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `--help` or `-h` was given; parsing stopped there.")
    strs_push(l, "pub fn args_help_wanted(a: Args) -> Bool ! {} {")
    strs_push(l, "    a.help")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The help of the command the parse reached.")
    strs_push(l, "pub fn args_help_text(a: Args) -> Str ! {} {")
    strs_push(l, "    args_help(ArgCommand(spec: a.spec, id: a.cmd))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- help --------------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// The one-line usage of `c`: `Usage: nazm build [options] --target <T> <input> [<files>...]`.")
    strs_push(l, "pub fn args_usage(c: ArgCommand) -> Str ! {} {")
    strs_push(l, "    let spec = c.spec;")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, f\"Usage: {full_name(spec, c.id)} [options]\");")
    strs_push(l, "    for i in 0..vec_len(spec.decls) {")
    strs_push(l, "        let d = decl_of(spec, i);")
    strs_push(l, "        if d.kind == k_option() && d.required && within(spec, c.id, d.cmd) { strs_push(parts, f\"--{d.name} <{d.value_name}>\"); }")
    strs_push(l, "    }")
    strs_push(l, "    for i in 0..vec_len(spec.decls) {")
    strs_push(l, "        let d = decl_of(spec, i);")
    strs_push(l, "        if d.cmd != c.id { continue; }")
    strs_push(l, "        if d.kind == k_positional() { strs_push(parts, if d.required { f\"<{d.name}>\" } else { f\"[<{d.name}>]\" }); }")
    strs_push(l, "        if d.kind == k_rest() { strs_push(parts, f\"[<{d.name}>...]\"); }")
    strs_push(l, "    }")
    strs_push(l, "    if has_subs(spec, c.id) { strs_push(parts, \"<command>\"); }")
    strs_push(l, "    str_join(parts, \" \")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The left column of declaration `d` in help.")
    strs_push(l, "fn left(d: ArgDecl) -> Str ! {} {")
    strs_push(l, "    if d.kind == k_positional() || d.kind == k_rest() {")
    strs_push(l, "        if d.kind == k_rest() { f\"  <{d.name}>...\" } else { f\"  <{d.name}>\" }")
    strs_push(l, "    } else {")
    strs_push(l, "        let short = if d.short == \"\" { \"    \" } else { f\"-{d.short}, \" };")
    strs_push(l, "        let value = if d.kind == k_option() { f\" <{d.value_name}>\" } else { \"\" };")
    strs_push(l, "        f\"  {short}--{d.name}{value}\"")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn right(d: ArgDecl) -> Str ! {} {")
    strs_push(l, "    let mut text = d.help;")
    strs_push(l, "    if d.required && d.kind == k_option() { text = f\"{text} (required)\"; }")
    strs_push(l, "    if d.has_default { text = f\"{text} [default: {d.default}]\"; }")
    strs_push(l, "    text")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Rows of two columns, the second aligned.")
    strs_push(l, "fn table(lefts: Strs, rights: Strs) -> Str ! {} {")
    strs_push(l, "    let mut width = 0;")
    strs_push(l, "    for i in 0..strs_len(lefts) {")
    strs_push(l, "        if str_len(strs_get(lefts, i)) > width { width = str_len(strs_get(lefts, i)); }")
    strs_push(l, "    }")
    strs_push(l, "    let rows = strs_new();")
    strs_push(l, "    for i in 0..strs_len(lefts) {")
    strs_push(l, "        let r = strs_get(rights, i);")
    strs_push(l, "        if r == \"\" { strs_push(rows, strs_get(lefts, i)); } else {")
    strs_push(l, "            strs_push(rows, f\"{str_pad_end(strs_get(lefts, i), width + 2, \" \")}{r}\");")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    str_join(rows, \"\\n\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The help of `c`: what it does, its usage, then its arguments, its options (its own, then those")
    strs_push(l, "/// of the commands above it, then `--help`) and its sub-commands, each with what it does.")
    strs_push(l, "pub fn args_help(c: ArgCommand) -> Str ! {} {")
    strs_push(l, "    let spec = c.spec;")
    strs_push(l, "    let me = cmd_of(spec, c.id);")
    strs_push(l, "    let name = full_name(spec, c.id);")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    strs_push(out, if me.about == \"\" { name } else { f\"{name}: {me.about}\" });")
    strs_push(l, "    strs_push(out, \"\");")
    strs_push(l, "    strs_push(out, args_usage(c));")
    strs_push(l, "    let pl = strs_new();")
    strs_push(l, "    let pr = strs_new();")
    strs_push(l, "    for i in 0..vec_len(spec.decls) {")
    strs_push(l, "        let d = decl_of(spec, i);")
    strs_push(l, "        if d.cmd == c.id && (d.kind == k_positional() || d.kind == k_rest()) {")
    strs_push(l, "            strs_push(pl, left(d));")
    strs_push(l, "            strs_push(pr, right(d));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if strs_len(pl) > 0 {")
    strs_push(l, "        strs_push(out, \"\");")
    strs_push(l, "        strs_push(out, \"Arguments:\");")
    strs_push(l, "        strs_push(out, table(pl, pr));")
    strs_push(l, "    }")
    strs_push(l, "    let ol = strs_new();")
    strs_push(l, "    let or = strs_new();")
    strs_push(l, "    let mut level = c.id;")
    strs_push(l, "    while level >= 0 {")
    strs_push(l, "        for i in 0..vec_len(spec.decls) {")
    strs_push(l, "            let d = decl_of(spec, i);")
    strs_push(l, "            if d.cmd == level && (d.kind == k_flag() || d.kind == k_option()) {")
    strs_push(l, "                strs_push(ol, left(d));")
    strs_push(l, "                strs_push(or, right(d));")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        level = cmd_of(spec, level).parent;")
    strs_push(l, "    }")
    strs_push(l, "    strs_push(ol, if find_option(spec, c.id, \"h\", true) < 0 { \"  -h, --help\" } else { \"      --help\" });")
    strs_push(l, "    strs_push(or, \"Print this help\");")
    strs_push(l, "    strs_push(out, \"\");")
    strs_push(l, "    strs_push(out, \"Options:\");")
    strs_push(l, "    strs_push(out, table(ol, or));")
    strs_push(l, "    if has_subs(spec, c.id) {")
    strs_push(l, "        let cl = strs_new();")
    strs_push(l, "        let cr = strs_new();")
    strs_push(l, "        for i in 0..vec_len(spec.cmds) {")
    strs_push(l, "            let s = cmd_of(spec, i);")
    strs_push(l, "            if s.parent == c.id {")
    strs_push(l, "                strs_push(cl, f\"  {s.name}\");")
    strs_push(l, "                strs_push(cr, s.about);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        strs_push(out, \"\");")
    strs_push(l, "        strs_push(out, \"Commands:\");")
    strs_push(l, "        strs_push(out, table(cl, cr));")
    strs_push(l, "    }")
    strs_push(l, "    f\"{str_join(out, \"\\n\")}\\n\"")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_audit() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/audit`: a state transition's record, written as it happens (Gate 3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/audit\";`. A device controller's state lives in its static atomics; each")
    strs_push(l, "// change of one — an `atomic_store`, `atomic_swap` or `atomic_compare_swap` — is a transition, and")
    strs_push(l, "// the `audit` rule asks the function making it to call `audit_transition`, which writes one")
    strs_push(l, "// structured record, a JSON object on its own line, to the board's UART:")
    strs_push(l, "// `{\"audit\":MACHINE,\"from\":FROM,\"to\":TO}`. Nothing allocates and every loop is counted, so a")
    strs_push(l, "// heapless board, `no-heap` and `bounded-loops` admit it. `docs/internal/systems-domains.md` Parts E–J.")
    strs_push(l, "")
    strs_push(l, "/// The record of `machine` moving from state `from` to `to`, written byte by byte to the UART whose")
    strs_push(l, "/// data register is at `uart`; `0`.")
    strs_push(l, "pub fn audit_transition(uart: Int, m: MmioCap, machine: Int, from: Int, to: Int) -> Int ! {} {")
    strs_push(l, "    audit_text(uart, m, \"{\\\"audit\\\":\");")
    strs_push(l, "    audit_number(uart, m, machine);")
    strs_push(l, "    audit_text(uart, m, \",\\\"from\\\":\");")
    strs_push(l, "    audit_number(uart, m, from);")
    strs_push(l, "    audit_text(uart, m, \",\\\"to\\\":\");")
    strs_push(l, "    audit_number(uart, m, to);")
    strs_push(l, "    mmio_write8(uart, 125);")
    strs_push(l, "    mmio_write8(uart, 10)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The first 32 bytes of `s`, which is all a record's text is.")
    strs_push(l, "fn audit_text(uart: Int, m: MmioCap, s: Str) -> Int ! {} {")
    strs_push(l, "    let n = str_len(s);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 32 {")
    strs_push(l, "        if i < n {")
    strs_push(l, "            mmio_write8(uart, str_byte(s, i));")
    strs_push(l, "        };")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `n` in decimal, a sign first when it is negative.")
    strs_push(l, "fn audit_number(uart: Int, m: MmioCap, n: Int) -> Int ! {} {")
    strs_push(l, "    // The most negative `Int` has no positive: its digits are written from the negated quotient.")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        mmio_write8(uart, 45);")
    strs_push(l, "    };")
    strs_push(l, "    let mut p = 1000000000000000000;")
    strs_push(l, "    let mut started = false;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 19 {")
    strs_push(l, "        let q = n / p % 10;")
    strs_push(l, "        let d = if q < 0 { 0 - q } else { q };")
    strs_push(l, "        if d != 0 || started || i == 18 {")
    strs_push(l, "            mmio_write8(uart, 48 + d);")
    strs_push(l, "            started = true;")
    strs_push(l, "        };")
    strs_push(l, "        p = p / 10;")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_binary() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/binary`: a deterministic binary encoding over `Bytes` (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/binary\";`. A `Writer` gathers fixed-width integers and floats in either")
    strs_push(l, "// byte order, unsigned and zig-zag varints (LEB128), and length-prefixed bytes and strings, and")
    strs_push(l, "// `binary_finish` gives them as one `Bytes`; a `Reader` reads them back in the same order, every")
    strs_push(l, "// read a `Result` whose error names what was short or wrong and where. The same values encode to")
    strs_push(l, "// the same bytes in every implementation and on every platform. `docs/internal/general-purpose.md` §14.")
    strs_push(l, "")
    strs_push(l, "/// Bytes being written: the pieces so far, and their total length.")
    strs_push(l, "pub struct Writer {")
    strs_push(l, "    parts: Vec[Bytes],")
    strs_push(l, "    len: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bytes being read, and where the next read starts.")
    strs_push(l, "pub struct Reader {")
    strs_push(l, "    data: Bytes,")
    strs_push(l, "    pos: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty writer.")
    strs_push(l, "pub fn binary_writer() -> Writer ! {} {")
    strs_push(l, "    let len = ints_new();")
    strs_push(l, "    ints_push(len, 0);")
    strs_push(l, "    Writer(parts: vec_new[Bytes](), len: len)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn push(w: Writer, b: Bytes) -> Int ! {} {")
    strs_push(l, "    vec_push(w.parts, b);")
    strs_push(l, "    ints_set(w.len, 0, ints_get(w.len, 0) + bytes_len(b));")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many bytes `w` holds.")
    strs_push(l, "pub fn binary_len(w: Writer) -> Int ! {} {")
    strs_push(l, "    ints_get(w.len, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Everything written, as one buffer.")
    strs_push(l, "pub fn binary_finish(w: Writer) -> Bytes ! {} {")
    strs_push(l, "    let all = bytes_new(ints_get(w.len, 0));")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(w.parts) {")
    strs_push(l, "        let part = vec_get(w.parts, i);")
    strs_push(l, "        bytes_copy(bytes_slice(all, at, at + bytes_len(part)), part);")
    strs_push(l, "        at = at + bytes_len(part);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    all")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One byte.")
    strs_push(l, "pub fn binary_put_u8(w: Writer, v: UInt8) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(1);")
    strs_push(l, "    bytes_set(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt16`, least significant byte first.")
    strs_push(l, "pub fn binary_put_u16_le(w: Writer, v: UInt16) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(2);")
    strs_push(l, "    bytes_write_le(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt16`, most significant byte first.")
    strs_push(l, "pub fn binary_put_u16_be(w: Writer, v: UInt16) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(2);")
    strs_push(l, "    bytes_write_be(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt32`, least significant byte first.")
    strs_push(l, "pub fn binary_put_u32_le(w: Writer, v: UInt32) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(4);")
    strs_push(l, "    bytes_write_le(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt32`, most significant byte first.")
    strs_push(l, "pub fn binary_put_u32_be(w: Writer, v: UInt32) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(4);")
    strs_push(l, "    bytes_write_be(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt64`, least significant byte first.")
    strs_push(l, "pub fn binary_put_u64_le(w: Writer, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_le(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt64`, most significant byte first.")
    strs_push(l, "pub fn binary_put_u64_be(w: Writer, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_be(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `Int`, two's complement, least significant byte first.")
    strs_push(l, "pub fn binary_put_i64_le(w: Writer, v: Int) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_le(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `Int`, two's complement, most significant byte first.")
    strs_push(l, "pub fn binary_put_i64_be(w: Writer, v: Int) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_be(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `Float64`'s IEEE 754 bits, least significant byte first.")
    strs_push(l, "pub fn binary_put_f64_le(w: Writer, v: Float64) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_le(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `Float64`'s IEEE 754 bits, most significant byte first.")
    strs_push(l, "pub fn binary_put_f64_be(w: Writer, v: Float64) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    bytes_write_be(b, 0, v);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An unsigned varint (LEB128): seven bits a byte, least significant first, the top bit set on")
    strs_push(l, "/// every byte but the last.")
    strs_push(l, "pub fn binary_put_varint(w: Writer, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let mut x = v;")
    strs_push(l, "    let mut n = 1;")
    strs_push(l, "    while x >= UInt64(128) {")
    strs_push(l, "        x = x >> 7;")
    strs_push(l, "        n = n + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let b = bytes_new(n);")
    strs_push(l, "    let mut y = v;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        let low = UInt8(y & UInt64(127));")
    strs_push(l, "        if i + 1 < n {")
    strs_push(l, "            bytes_set(b, i, low | UInt8(128));")
    strs_push(l, "        } else {")
    strs_push(l, "            bytes_set(b, i, low);")
    strs_push(l, "        }")
    strs_push(l, "        y = y >> 7;")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A signed varint: zig-zag (0, -1, 1, -2 … as 0, 1, 2, 3 …), then as `binary_put_varint`.")
    strs_push(l, "pub fn binary_put_zigzag(w: Writer, v: Int) -> Int ! {} {")
    strs_push(l, "    let u = wrap_convert[UInt64](v);")
    strs_push(l, "    let z = (u << 1) ^ wrap_convert[UInt64](v >> 63);")
    strs_push(l, "    binary_put_varint(w, z)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `data` as it is, with no length.")
    strs_push(l, "pub fn binary_put_raw(w: Writer, data: Bytes) -> Int ! {} {")
    strs_push(l, "    let b = bytes_new(bytes_len(data));")
    strs_push(l, "    bytes_copy(b, data);")
    strs_push(l, "    push(w, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `data`, preceded by its length as a varint.")
    strs_push(l, "pub fn binary_put_bytes(w: Writer, data: Bytes) -> Int ! {} {")
    strs_push(l, "    binary_put_varint(w, UInt64(bytes_len(data)));")
    strs_push(l, "    binary_put_raw(w, data)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s`'s bytes, preceded by their length as a varint.")
    strs_push(l, "pub fn binary_put_str(w: Writer, s: Str) -> Int ! {} {")
    strs_push(l, "    binary_put_bytes(w, bytes_from_str(s))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A reader at the start of `data`.")
    strs_push(l, "pub fn binary_reader(data: Bytes) -> Reader ! {} {")
    strs_push(l, "    let pos = ints_new();")
    strs_push(l, "    ints_push(pos, 0);")
    strs_push(l, "    Reader(data: data, pos: pos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Where the next read starts.")
    strs_push(l, "pub fn binary_position(r: Reader) -> Int ! {} {")
    strs_push(l, "    ints_get(r.pos, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many bytes are left.")
    strs_push(l, "pub fn binary_remaining(r: Reader) -> Int ! {} {")
    strs_push(l, "    bytes_len(r.data) - ints_get(r.pos, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The next `n` bytes' start, moving past them, or an `Err` naming what was short.")
    strs_push(l, "fn take(r: Reader, n: Int, what: Str) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let at = ints_get(r.pos, 0);")
    strs_push(l, "    if n < 0 || at + n > bytes_len(r.data) {")
    strs_push(l, "        return Result[Int, Str].Err(error: str_concat(str_concat(what, \" needs more bytes than are left at byte \"), int_to_str(at)));")
    strs_push(l, "    }")
    strs_push(l, "    ints_set(r.pos, 0, at + n);")
    strs_push(l, "    Result[Int, Str].Ok(value: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One byte.")
    strs_push(l, "pub fn binary_get_u8(r: Reader) -> Result[UInt8, Str] ! {} {")
    strs_push(l, "    let at = take(r, 1, \"a byte\")?;")
    strs_push(l, "    Result[UInt8, Str].Ok(value: bytes_get(r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt16`, least significant byte first.")
    strs_push(l, "pub fn binary_get_u16_le(r: Reader) -> Result[UInt16, Str] ! {} {")
    strs_push(l, "    let at = take(r, 2, \"a UInt16\")?;")
    strs_push(l, "    Result[UInt16, Str].Ok(value: bytes_read_le[UInt16](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt16`, most significant byte first.")
    strs_push(l, "pub fn binary_get_u16_be(r: Reader) -> Result[UInt16, Str] ! {} {")
    strs_push(l, "    let at = take(r, 2, \"a UInt16\")?;")
    strs_push(l, "    Result[UInt16, Str].Ok(value: bytes_read_be[UInt16](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt32`, least significant byte first.")
    strs_push(l, "pub fn binary_get_u32_le(r: Reader) -> Result[UInt32, Str] ! {} {")
    strs_push(l, "    let at = take(r, 4, \"a UInt32\")?;")
    strs_push(l, "    Result[UInt32, Str].Ok(value: bytes_read_le[UInt32](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt32`, most significant byte first.")
    strs_push(l, "pub fn binary_get_u32_be(r: Reader) -> Result[UInt32, Str] ! {} {")
    strs_push(l, "    let at = take(r, 4, \"a UInt32\")?;")
    strs_push(l, "    Result[UInt32, Str].Ok(value: bytes_read_be[UInt32](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt64`, least significant byte first.")
    strs_push(l, "pub fn binary_get_u64_le(r: Reader) -> Result[UInt64, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"a UInt64\")?;")
    strs_push(l, "    Result[UInt64, Str].Ok(value: bytes_read_le[UInt64](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `UInt64`, most significant byte first.")
    strs_push(l, "pub fn binary_get_u64_be(r: Reader) -> Result[UInt64, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"a UInt64\")?;")
    strs_push(l, "    Result[UInt64, Str].Ok(value: bytes_read_be[UInt64](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `Int`, least significant byte first.")
    strs_push(l, "pub fn binary_get_i64_le(r: Reader) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"an Int\")?;")
    strs_push(l, "    Result[Int, Str].Ok(value: bytes_read_le[Int](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `Int`, most significant byte first.")
    strs_push(l, "pub fn binary_get_i64_be(r: Reader) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"an Int\")?;")
    strs_push(l, "    Result[Int, Str].Ok(value: bytes_read_be[Int](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `Float64`, least significant byte first.")
    strs_push(l, "pub fn binary_get_f64_le(r: Reader) -> Result[Float64, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"a Float64\")?;")
    strs_push(l, "    Result[Float64, Str].Ok(value: bytes_read_le[Float64](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `Float64`, most significant byte first.")
    strs_push(l, "pub fn binary_get_f64_be(r: Reader) -> Result[Float64, Str] ! {} {")
    strs_push(l, "    let at = take(r, 8, \"a Float64\")?;")
    strs_push(l, "    Result[Float64, Str].Ok(value: bytes_read_be[Float64](r.data, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An unsigned varint: an `Err` for one that runs past the end, or past 64 bits.")
    strs_push(l, "pub fn binary_get_varint(r: Reader) -> Result[UInt64, Str] ! {} {")
    strs_push(l, "    let start = ints_get(r.pos, 0);")
    strs_push(l, "    let mut v = UInt64(0);")
    strs_push(l, "    let mut shift = 0;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        let at = take(r, 1, \"a varint\")?;")
    strs_push(l, "        let b = bytes_get(r.data, at);")
    strs_push(l, "        let low = UInt64(b & UInt8(127));")
    strs_push(l, "        if shift == 63 && low > UInt64(1) {")
    strs_push(l, "            return Result[UInt64, Str].Err(error: str_concat(\"a varint past 64 bits at byte \", int_to_str(start)));")
    strs_push(l, "        }")
    strs_push(l, "        v = v | (low << shift);")
    strs_push(l, "        if b < UInt8(128) {")
    strs_push(l, "            more = false;")
    strs_push(l, "        } else {")
    strs_push(l, "            shift = shift + 7;")
    strs_push(l, "            if shift > 63 {")
    strs_push(l, "                return Result[UInt64, Str].Err(error: str_concat(\"a varint past 64 bits at byte \", int_to_str(start)));")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[UInt64, Str].Ok(value: v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A zig-zag varint.")
    strs_push(l, "pub fn binary_get_zigzag(r: Reader) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let z = binary_get_varint(r)?;")
    strs_push(l, "    let half = wrap_convert[Int](z >> 1);")
    strs_push(l, "    let sign = 0 - wrap_convert[Int](z & UInt64(1));")
    strs_push(l, "    Result[Int, Str].Ok(value: half ^ sign)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next `n` bytes, as they are, sharing `r`'s buffer.")
    strs_push(l, "pub fn binary_get_raw(r: Reader, n: Int) -> Result[Bytes, Str] ! {} {")
    strs_push(l, "    let at = take(r, n, \"a run of bytes\")?;")
    strs_push(l, "    Result[Bytes, Str].Ok(value: bytes_slice(r.data, at, at + n))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bytes preceded by their length as a varint.")
    strs_push(l, "pub fn binary_get_bytes(r: Reader) -> Result[Bytes, Str] ! {} {")
    strs_push(l, "    let n = binary_get_varint(r)?;")
    strs_push(l, "    if n > UInt64(bytes_len(r.data)) {")
    strs_push(l, "        return Result[Bytes, Str].Err(error: str_concat(\"a length longer than the data at byte \", int_to_str(ints_get(r.pos, 0))));")
    strs_push(l, "    }")
    strs_push(l, "    binary_get_raw(r, Int(n))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A string preceded by its length as a varint.")
    strs_push(l, "pub fn binary_get_str(r: Reader) -> Result[Str, Str] ! {} {")
    strs_push(l, "    let b = binary_get_bytes(r)?;")
    strs_push(l, "    Result[Str, Str].Ok(value: bytes_to_str(b))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_bitset() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/bitset`: a growable set of small non-negative integers, one bit each (R1e, S3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/bitset\";`. A `BitSet` holds bit `i` as bit `i % 64` of word `i / 64`")
    strs_push(l, "// of a vector it shares like any handle: copies of a set are the same set. Adding, removing and")
    strs_push(l, "// testing take constant time, adding past the words held grows them; counting, comparing and")
    strs_push(l, "// the set operations take time in the words. A negative member is ordinary failure: never added,")
    strs_push(l, "// never held, never a trap.")
    strs_push(l, "")
    strs_push(l, "/// A set of non-negative `Int`s.")
    strs_push(l, "pub struct BitSet {")
    strs_push(l, "    words: Vec[UInt64],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty set.")
    strs_push(l, "pub fn bitset_new() -> BitSet ! {} {")
    strs_push(l, "    BitSet(words: vec_new[UInt64]())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The bit of `i` within its word.")
    strs_push(l, "fn bit(i: Int) -> UInt64 ! {} {")
    strs_push(l, "    UInt64(1) << (i % 64)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Word `w` of `s`, zero past those held.")
    strs_push(l, "fn word(s: BitSet, w: Int) -> UInt64 ! {} {")
    strs_push(l, "    if w < vec_len(s.words) { vec_get(s.words, w) } else { UInt64(0) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Put `i` in `s`; whether it was not there already (`false`, and nothing added, when `i < 0`).")
    strs_push(l, "pub fn bitset_add(s: BitSet, i: Int) -> Bool ! {} {")
    strs_push(l, "    if i < 0 { false } else {")
    strs_push(l, "        let w = i / 64;")
    strs_push(l, "        while vec_len(s.words) <= w { vec_push(s.words, UInt64(0)); }")
    strs_push(l, "        let old = vec_get(s.words, w);")
    strs_push(l, "        vec_set(s.words, w, old | bit(i));")
    strs_push(l, "        (old & bit(i)) == UInt64(0)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take `i` out of `s`; whether it was there.")
    strs_push(l, "pub fn bitset_remove(s: BitSet, i: Int) -> Bool ! {} {")
    strs_push(l, "    if i < 0 || i / 64 >= vec_len(s.words) { false } else {")
    strs_push(l, "        let w = i / 64;")
    strs_push(l, "        let old = vec_get(s.words, w);")
    strs_push(l, "        vec_set(s.words, w, old & (bit(i) ^ UInt64(18446744073709551615)));")
    strs_push(l, "        (old & bit(i)) != UInt64(0)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `s` holds `i`.")
    strs_push(l, "pub fn bitset_has(s: BitSet, i: Int) -> Bool ! {} {")
    strs_push(l, "    i >= 0 && (word(s, i / 64) & bit(i)) != UInt64(0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many members `s` holds.")
    strs_push(l, "pub fn bitset_count(s: BitSet) -> Int ! {} {")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    for w in 0..vec_len(s.words) { n = n + Int(count_ones(vec_get(s.words, w))); }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Empty `s`, keeping its words; returns `0`.")
    strs_push(l, "pub fn bitset_clear(s: BitSet) -> Int ! {} {")
    strs_push(l, "    for w in 0..vec_len(s.words) { vec_set(s.words, w, UInt64(0)); }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The least member of `s` at or after `from`, or `None`: a walk over the members is this from")
    strs_push(l, "/// `0`, then from each one found plus one.")
    strs_push(l, "pub fn bitset_next(s: BitSet, from: Int) -> Option[Int] ! {} {")
    strs_push(l, "    let start = if from < 0 { 0 } else { from };")
    strs_push(l, "    let mut w = start / 64;")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    if w < vec_len(s.words) {")
    strs_push(l, "        // The first word without the bits below `start`.")
    strs_push(l, "        let first = vec_get(s.words, w) & ((bit(start) - UInt64(1)) ^ UInt64(18446744073709551615));")
    strs_push(l, "        if first != UInt64(0) { found = w * 64 + Int(trailing_zeros(first)); }")
    strs_push(l, "        w = w + 1;")
    strs_push(l, "    }")
    strs_push(l, "    while found < 0 && w < vec_len(s.words) {")
    strs_push(l, "        let x = vec_get(s.words, w);")
    strs_push(l, "        if x != UInt64(0) { found = w * 64 + Int(trailing_zeros(x)); }")
    strs_push(l, "        w = w + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { Option[Int].Some(value: found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every member of `s`, ascending.")
    strs_push(l, "pub fn bitset_items(s: BitSet) -> Ints ! {} {")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    for w in 0..vec_len(s.words) {")
    strs_push(l, "        let mut x = vec_get(s.words, w);")
    strs_push(l, "        while x != UInt64(0) {")
    strs_push(l, "            ints_push(out, w * 64 + Int(trailing_zeros(x)));")
    strs_push(l, "            x = x & (x - UInt64(1));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A new set whose word `w` is `op` of `a`'s and `b`'s: `0` both, `1` either, `2` the first only.")
    strs_push(l, "fn combine(a: BitSet, b: BitSet, op: Int) -> BitSet ! {} {")
    strs_push(l, "    let n = if vec_len(a.words) > vec_len(b.words) { vec_len(a.words) } else { vec_len(b.words) };")
    strs_push(l, "    let out = vec_new[UInt64]();")
    strs_push(l, "    for w in 0..n {")
    strs_push(l, "        let x = word(a, w);")
    strs_push(l, "        let y = word(b, w);")
    strs_push(l, "        vec_push(out, if op == 0 { x & y } else { if op == 1 { x | y } else { x & (y ^ UInt64(18446744073709551615)) } });")
    strs_push(l, "    }")
    strs_push(l, "    BitSet(words: out)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new set of the members of `a` or `b`.")
    strs_push(l, "pub fn bitset_union(a: BitSet, b: BitSet) -> BitSet ! {} {")
    strs_push(l, "    combine(a, b, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new set of the members of both `a` and `b`.")
    strs_push(l, "pub fn bitset_intersection(a: BitSet, b: BitSet) -> BitSet ! {} {")
    strs_push(l, "    combine(a, b, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new set of the members of `a` that are not members of `b`.")
    strs_push(l, "pub fn bitset_difference(a: BitSet, b: BitSet) -> BitSet ! {} {")
    strs_push(l, "    combine(a, b, 2)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `a` and `b` have the same members, however many words each holds.")
    strs_push(l, "pub fn bitset_equal(a: BitSet, b: BitSet) -> Bool ! {} {")
    strs_push(l, "    let n = if vec_len(a.words) > vec_len(b.words) { vec_len(a.words) } else { vec_len(b.words) };")
    strs_push(l, "    let mut same = true;")
    strs_push(l, "    for w in 0..n { if word(a, w) != word(b, w) { same = false; } }")
    strs_push(l, "    same")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_blake3() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/blake3`: BLAKE3's hash, as its reference implementation computes it (R1e, S1).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/blake3\";`. `blake3(data)` is the 32-byte default output of a whole")
    strs_push(l, "// buffer; `blake3_new`, `blake3_update` and `blake3_finish` give the same output of data that")
    strs_push(l, "// arrives in pieces, whatever the pieces. The input is split into chunks of 1024 bytes, each")
    strs_push(l, "// compressed block by block (64 bytes, seven rounds) into a chaining value, and the chunks' values")
    strs_push(l, "// are merged pairwise up a binary tree as they complete — a stack of at most 54 subtree values —")
    strs_push(l, "// whose root is compressed with `ROOT`. A hasher is a handle, shared like a `Vec`; `blake3_finish`")
    strs_push(l, "// leaves it as it was. Unkeyed hashing only: no keyed mode, no key derivation, no longer output.")
    strs_push(l, "// Pure Nazm over 32-bit wrapping arithmetic and rotations; held to the official test vectors")
    strs_push(l, "// (`crates/nazm-cli/tests/hash_vectors.rs`).")
    strs_push(l, "")
    strs_push(l, "/// An incremental BLAKE3 hasher.")
    strs_push(l, "pub struct Blake3 {")
    strs_push(l, "    // The current chunk's chaining value: eight little-endian words.")
    strs_push(l, "    cv: Bytes,")
    strs_push(l, "    // The current chunk's block being filled; zero past what it holds.")
    strs_push(l, "    block: Bytes,")
    strs_push(l, "    // The completed subtrees' chaining values, 32 bytes each, oldest first.")
    strs_push(l, "    stack: Bytes,")
    strs_push(l, "    // The block's length, the blocks of this chunk compressed, the chunk's index, the stack's depth.")
    strs_push(l, "    counts: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "const IV: [UInt32; 8] = [")
    strs_push(l, "    0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19,")
    strs_push(l, "];")
    strs_push(l, "")
    strs_push(l, "const PERMUTATION: [Int; 16] = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8];")
    strs_push(l, "")
    strs_push(l, "const CHUNK_START: UInt32 = 1;")
    strs_push(l, "const CHUNK_END: UInt32 = 2;")
    strs_push(l, "const PARENT: UInt32 = 4;")
    strs_push(l, "const ROOT: UInt32 = 8;")
    strs_push(l, "")
    strs_push(l, "// What a compression is given, before it is decided whether it is the root.")
    strs_push(l, "struct Output {")
    strs_push(l, "    cv: [UInt32; 8],")
    strs_push(l, "    m: [UInt32; 16],")
    strs_push(l, "    counter: UInt64,")
    strs_push(l, "    len: UInt32,")
    strs_push(l, "    flags: UInt32,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The quarter-round, on state words `a`, `b`, `c`, `d` with message words `x` and `y`.")
    strs_push(l, "fn g(s: [UInt32; 16], a: Int, b: Int, c: Int, d: Int, x: UInt32, y: UInt32) -> [UInt32; 16] ! {} {")
    strs_push(l, "    let mut v = s;")
    strs_push(l, "    v[a] = wrapping_add(wrapping_add(v[a], v[b]), x);")
    strs_push(l, "    v[d] = rotate_right(v[d] ^ v[a], 16);")
    strs_push(l, "    v[c] = wrapping_add(v[c], v[d]);")
    strs_push(l, "    v[b] = rotate_right(v[b] ^ v[c], 12);")
    strs_push(l, "    v[a] = wrapping_add(wrapping_add(v[a], v[b]), y);")
    strs_push(l, "    v[d] = rotate_right(v[d] ^ v[a], 8);")
    strs_push(l, "    v[c] = wrapping_add(v[c], v[d]);")
    strs_push(l, "    v[b] = rotate_right(v[b] ^ v[c], 7);")
    strs_push(l, "    v")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn round(s: [UInt32; 16], m: [UInt32; 16]) -> [UInt32; 16] ! {} {")
    strs_push(l, "    // The columns, then the diagonals.")
    strs_push(l, "    let s1 = g(s, 0, 4, 8, 12, m[0], m[1]);")
    strs_push(l, "    let s2 = g(s1, 1, 5, 9, 13, m[2], m[3]);")
    strs_push(l, "    let s3 = g(s2, 2, 6, 10, 14, m[4], m[5]);")
    strs_push(l, "    let s4 = g(s3, 3, 7, 11, 15, m[6], m[7]);")
    strs_push(l, "    let s5 = g(s4, 0, 5, 10, 15, m[8], m[9]);")
    strs_push(l, "    let s6 = g(s5, 1, 6, 11, 12, m[10], m[11]);")
    strs_push(l, "    let s7 = g(s6, 2, 7, 8, 13, m[12], m[13]);")
    strs_push(l, "    g(s7, 3, 4, 9, 14, m[14], m[15])")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn permute(m: [UInt32; 16]) -> [UInt32; 16] ! {} {")
    strs_push(l, "    let p = PERMUTATION;")
    strs_push(l, "    let mut out = m;")
    strs_push(l, "    for i in 0..16 {")
    strs_push(l, "        out[i] = m[p[i]];")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn compress(cv: [UInt32; 8], block: [UInt32; 16], counter: UInt64, len: UInt32, flags: UInt32) -> [UInt32; 16] ! {} {")
    strs_push(l, "    let iv = IV;")
    strs_push(l, "    let mut s = [UInt32(0); 16];")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        s[i] = cv[i];")
    strs_push(l, "    }")
    strs_push(l, "    for i in 0..4 {")
    strs_push(l, "        s[8 + i] = iv[i];")
    strs_push(l, "    }")
    strs_push(l, "    s[12] = wrap_convert[UInt32](counter);")
    strs_push(l, "    s[13] = UInt32(counter >> 32);")
    strs_push(l, "    s[14] = len;")
    strs_push(l, "    s[15] = flags;")
    strs_push(l, "    let mut m = block;")
    strs_push(l, "    for r in 0..7 {")
    strs_push(l, "        s = round(s, m);")
    strs_push(l, "        m = permute(m);")
    strs_push(l, "    }")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        s[i] = s[i] ^ s[i + 8];")
    strs_push(l, "        s[i + 8] = s[i + 8] ^ cv[i];")
    strs_push(l, "    }")
    strs_push(l, "    s")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn chaining_value(o: Output) -> [UInt32; 8] ! {} {")
    strs_push(l, "    let s = compress(o.cv, o.m, o.counter, o.len, o.flags);")
    strs_push(l, "    let mut out = [UInt32(0); 8];")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        out[i] = s[i];")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn words8(b: Bytes, at: Int) -> [UInt32; 8] ! {} {")
    strs_push(l, "    let mut out = [UInt32(0); 8];")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        out[i] = bytes_read_le[UInt32](b, at + 4 * i);")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn words16(b: Bytes) -> [UInt32; 16] ! {} {")
    strs_push(l, "    let mut out = [UInt32(0); 16];")
    strs_push(l, "    for i in 0..16 {")
    strs_push(l, "        out[i] = bytes_read_le[UInt32](b, 4 * i);")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn put8(b: Bytes, at: Int, w: [UInt32; 8]) -> Int ! {} {")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        bytes_write_le(b, at + 4 * i, w[i]);")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parent(left: [UInt32; 8], right: [UInt32; 8]) -> Output ! {} {")
    strs_push(l, "    let mut m = [UInt32(0); 16];")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        m[i] = left[i];")
    strs_push(l, "        m[8 + i] = right[i];")
    strs_push(l, "    }")
    strs_push(l, "    Output(cv: IV, m: m, counter: UInt64(0), len: UInt32(64), flags: PARENT)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The current chunk's last block, as what it would be compressed with.")
    strs_push(l, "fn chunk_output(h: Blake3) -> Output ! {} {")
    strs_push(l, "    let start = if ints_get(h.counts, 1) == 0 { CHUNK_START } else { UInt32(0) };")
    strs_push(l, "    Output(")
    strs_push(l, "        cv: words8(h.cv, 0),")
    strs_push(l, "        m: words16(h.block),")
    strs_push(l, "        counter: UInt64(ints_get(h.counts, 2)),")
    strs_push(l, "        len: UInt32(ints_get(h.counts, 0)),")
    strs_push(l, "        flags: start | CHUNK_END,")
    strs_push(l, "    )")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A chunk begins: its index, the key as its chaining value, an empty block.")
    strs_push(l, "fn start_chunk(h: Blake3, index: Int) -> Int ! {} {")
    strs_push(l, "    put8(h.cv, 0, IV);")
    strs_push(l, "    bytes_copy(h.block, bytes_new(64));")
    strs_push(l, "    ints_set(h.counts, 0, 0);")
    strs_push(l, "    ints_set(h.counts, 1, 0);")
    strs_push(l, "    ints_set(h.counts, 2, index);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A completed chunk's value, `total` chunks done: merged with every subtree it completes.")
    strs_push(l, "fn add_chunk(h: Blake3, value: [UInt32; 8], total: Int) -> Int ! {} {")
    strs_push(l, "    let mut cv = value;")
    strs_push(l, "    let mut t = total;")
    strs_push(l, "    let mut depth = ints_get(h.counts, 3);")
    strs_push(l, "    while t & 1 == 0 {")
    strs_push(l, "        depth = depth - 1;")
    strs_push(l, "        cv = chaining_value(parent(words8(h.stack, 32 * depth), cv));")
    strs_push(l, "        t = t >> 1;")
    strs_push(l, "    }")
    strs_push(l, "    put8(h.stack, 32 * depth, cv);")
    strs_push(l, "    ints_set(h.counts, 3, depth + 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new hasher, given nothing yet.")
    strs_push(l, "pub fn blake3_new() -> Blake3 ! {} {")
    strs_push(l, "    let counts = ints_new();")
    strs_push(l, "    for i in 0..4 {")
    strs_push(l, "        ints_push(counts, 0);")
    strs_push(l, "    }")
    strs_push(l, "    let h = Blake3(cv: bytes_new(32), block: bytes_new(64), stack: bytes_new(54 * 32), counts: counts);")
    strs_push(l, "    start_chunk(h, 0);")
    strs_push(l, "    h")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give the hasher `data`, after whatever it was given before: `0`.")
    strs_push(l, "pub fn blake3_update(h: Blake3, data: Bytes) -> Int ! {} {")
    strs_push(l, "    let n = bytes_len(data);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < n {")
    strs_push(l, "        let held = ints_get(h.counts, 0);")
    strs_push(l, "        let done = ints_get(h.counts, 1);")
    strs_push(l, "        // A full chunk, with more to come, is complete.")
    strs_push(l, "        if 64 * done + held == 1024 {")
    strs_push(l, "            let value = chaining_value(chunk_output(h));")
    strs_push(l, "            let total = ints_get(h.counts, 2) + 1;")
    strs_push(l, "            add_chunk(h, value, total);")
    strs_push(l, "            start_chunk(h, total);")
    strs_push(l, "        } else {")
    strs_push(l, "            // A full block, with more to come, is compressed.")
    strs_push(l, "            if held == 64 {")
    strs_push(l, "                let start = if done == 0 { CHUNK_START } else { UInt32(0) };")
    strs_push(l, "                let s = compress(words8(h.cv, 0), words16(h.block), UInt64(ints_get(h.counts, 2)), UInt32(64), start);")
    strs_push(l, "                for i in 0..8 {")
    strs_push(l, "                    bytes_write_le(h.cv, 4 * i, s[i]);")
    strs_push(l, "                }")
    strs_push(l, "                bytes_copy(h.block, bytes_new(64));")
    strs_push(l, "                ints_set(h.counts, 0, 0);")
    strs_push(l, "                ints_set(h.counts, 1, done + 1);")
    strs_push(l, "            } else {")
    strs_push(l, "                let take = if n - at < 64 - held { n - at } else { 64 - held };")
    strs_push(l, "                bytes_copy(bytes_slice(h.block, held, held + take), bytes_slice(data, at, at + take));")
    strs_push(l, "                ints_set(h.counts, 0, held + take);")
    strs_push(l, "                at = at + take;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The 32-byte output for everything the hasher has been given. The hasher is unchanged.")
    strs_push(l, "pub fn blake3_finish(h: Blake3) -> Bytes ! {} {")
    strs_push(l, "    let mut o = chunk_output(h);")
    strs_push(l, "    let mut depth = ints_get(h.counts, 3);")
    strs_push(l, "    while depth > 0 {")
    strs_push(l, "        depth = depth - 1;")
    strs_push(l, "        o = parent(words8(h.stack, 32 * depth), chaining_value(o));")
    strs_push(l, "    }")
    strs_push(l, "    let s = compress(o.cv, o.m, UInt64(0), o.len, o.flags | ROOT);")
    strs_push(l, "    let out = bytes_new(32);")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        bytes_write_le(out, 4 * i, s[i]);")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The BLAKE3 hash of `data`: 32 bytes.")
    strs_push(l, "pub fn blake3(data: Bytes) -> Bytes ! {} {")
    strs_push(l, "    let h = blake3_new();")
    strs_push(l, "    blake3_update(h, data);")
    strs_push(l, "    blake3_finish(h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The BLAKE3 hash of `data` as 64 lower-case hexadecimal digits.")
    strs_push(l, "pub fn blake3_hex(data: Bytes) -> Str ! {} {")
    strs_push(l, "    let digest = blake3(data);")
    strs_push(l, "    let digits = \"0123456789abcdef\";")
    strs_push(l, "    let out = bytes_new(64);")
    strs_push(l, "    for i in 0..32 {")
    strs_push(l, "        let b = Int(bytes_get(digest, i));")
    strs_push(l, "        bytes_set(out, 2 * i, UInt8(str_byte(digits, b >> 4)));")
    strs_push(l, "        bytes_set(out, 2 * i + 1, UInt8(str_byte(digits, b & 15)));")
    strs_push(l, "    }")
    strs_push(l, "    bytes_to_str(out)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_bytebuf() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/bytebuf`: a growable byte buffer, for building binary output (R1e, S2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/bytebuf\";`. A `ByteBuf` holds its bytes in one buffer it shares like")
    strs_push(l, "// any handle: copies of a `ByteBuf` are the same buffer. Appending takes amortised constant time")
    strs_push(l, "// a byte — the storage doubles when it is full — and reading or overwriting a byte, or patching a")
    strs_push(l, "// number already written, constant time. It is the object writer's and DWARF's buffer: numbers in")
    strs_push(l, "// either byte order, ULEB128 and SLEB128, padding to an alignment, and a field written now and")
    strs_push(l, "// filled in later. Its own module rather than `@std/binary`'s: a `Writer` gathers pieces and is")
    strs_push(l, "// read back by a `Reader`, where a `ByteBuf` is one buffer written in place. An index outside the")
    strs_push(l, "// bytes written is ordinary failure — `None` or `false` — never a trap.")
    strs_push(l, "")
    strs_push(l, "/// Bytes being built: `store` holds one buffer, its capacity, of which the first `meta[0]` bytes")
    strs_push(l, "/// are written.")
    strs_push(l, "pub struct ByteBuf {")
    strs_push(l, "    store: Vec[Bytes],")
    strs_push(l, "    meta: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty buffer.")
    strs_push(l, "pub fn bytebuf_new() -> ByteBuf ! {} {")
    strs_push(l, "    bytebuf_with_capacity(16)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty buffer with room for `n` bytes before it first grows (at least one).")
    strs_push(l, "pub fn bytebuf_with_capacity(n: Int) -> ByteBuf ! {} {")
    strs_push(l, "    let store = vec_new[Bytes]();")
    strs_push(l, "    vec_push(store, bytes_new(if n < 1 { 1 } else { n }));")
    strs_push(l, "    let meta = ints_new();")
    strs_push(l, "    ints_push(meta, 0);")
    strs_push(l, "    ByteBuf(store: store, meta: meta)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many bytes `b` holds.")
    strs_push(l, "pub fn bytebuf_len(b: ByteBuf) -> Int ! {} {")
    strs_push(l, "    ints_get(b.meta, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Empty `b`, keeping its storage; returns `0`.")
    strs_push(l, "pub fn bytebuf_clear(b: ByteBuf) -> Int ! {} {")
    strs_push(l, "    ints_set(b.meta, 0, 0);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Room for `n` more bytes, growing to twice the storage or to what is needed, whichever is more;")
    strs_push(l, "// where they start.")
    strs_push(l, "fn reserve(b: ByteBuf, n: Int) -> Int ! {} {")
    strs_push(l, "    let len = ints_get(b.meta, 0);")
    strs_push(l, "    let old = vec_get(b.store, 0);")
    strs_push(l, "    let cap = bytes_len(old);")
    strs_push(l, "    if len + n > cap {")
    strs_push(l, "        let want = if cap * 2 > len + n { cap * 2 } else { len + n };")
    strs_push(l, "        let fresh = bytes_new(want);")
    strs_push(l, "        bytes_copy(fresh, bytes_slice(old, 0, len));")
    strs_push(l, "        vec_set(b.store, 0, fresh);")
    strs_push(l, "    }")
    strs_push(l, "    ints_set(b.meta, 0, len + n);")
    strs_push(l, "    len")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The storage, as it is now.")
    strs_push(l, "fn storage(b: ByteBuf) -> Bytes ! {} {")
    strs_push(l, "    vec_get(b.store, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append the byte `v`; returns `0`.")
    strs_push(l, "pub fn bytebuf_push(b: ByteBuf, v: UInt8) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 1);")
    strs_push(l, "    bytes_set(storage(b), at, v);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append `data`'s bytes; returns `0`.")
    strs_push(l, "pub fn bytebuf_push_bytes(b: ByteBuf, data: Bytes) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, bytes_len(data));")
    strs_push(l, "    bytes_copy(bytes_slice(storage(b), at, at + bytes_len(data)), data);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append `s`'s bytes, with no length; returns `0`.")
    strs_push(l, "pub fn bytebuf_push_str(b: ByteBuf, s: Str) -> Int ! {} {")
    strs_push(l, "    let n = str_len(s);")
    strs_push(l, "    let at = reserve(b, n);")
    strs_push(l, "    let st = storage(b);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        bytes_set(st, at + i, UInt8(str_byte(s, i)));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt16`, least significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u16_le(b: ByteBuf, v: UInt16) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 2);")
    strs_push(l, "    bytes_write_le(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt16`, most significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u16_be(b: ByteBuf, v: UInt16) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 2);")
    strs_push(l, "    bytes_write_be(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt32`, least significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u32_le(b: ByteBuf, v: UInt32) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 4);")
    strs_push(l, "    bytes_write_le(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt32`, most significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u32_be(b: ByteBuf, v: UInt32) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 4);")
    strs_push(l, "    bytes_write_be(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt64`, least significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u64_le(b: ByteBuf, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 8);")
    strs_push(l, "    bytes_write_le(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a `UInt64`, most significant byte first; returns `0`.")
    strs_push(l, "pub fn bytebuf_put_u64_be(b: ByteBuf, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let at = reserve(b, 8);")
    strs_push(l, "    bytes_write_be(storage(b), at, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append an unsigned LEB128: seven bits a byte, least significant first, the top bit set on")
    strs_push(l, "/// every byte but the last; returns how many bytes it took.")
    strs_push(l, "pub fn bytebuf_put_uleb128(b: ByteBuf, v: UInt64) -> Int ! {} {")
    strs_push(l, "    let mut x = v;")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        let low = UInt8(x & UInt64(127));")
    strs_push(l, "        x = x >> 7;")
    strs_push(l, "        more = x != UInt64(0);")
    strs_push(l, "        bytebuf_push(b, if more { low | UInt8(128) } else { low });")
    strs_push(l, "        n = n + 1;")
    strs_push(l, "    }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append a signed LEB128: seven bits a byte of the two's complement, least significant first,")
    strs_push(l, "/// until what is left is all copies of the sign bit just written; returns how many bytes it took.")
    strs_push(l, "pub fn bytebuf_put_sleb128(b: ByteBuf, v: Int) -> Int ! {} {")
    strs_push(l, "    let mut x = v;")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        let low = UInt8(wrap_convert[UInt64](x) & UInt64(127));")
    strs_push(l, "        x = x >> 7;")
    strs_push(l, "        let sign = (low & UInt8(64)) != UInt8(0);")
    strs_push(l, "        more = !((x == 0 && !sign) || (x == 0 - 1 && sign));")
    strs_push(l, "        bytebuf_push(b, if more { low | UInt8(128) } else { low });")
    strs_push(l, "        n = n + 1;")
    strs_push(l, "    }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Append zero bytes until the length is a multiple of `n` (nothing when `n < 2`); returns the")
    strs_push(l, "/// new length.")
    strs_push(l, "pub fn bytebuf_align_to(b: ByteBuf, n: Int) -> Int ! {} {")
    strs_push(l, "    if n > 1 {")
    strs_push(l, "        let pad = (n - bytebuf_len(b) % n) % n;")
    strs_push(l, "        let at = reserve(b, pad);")
    strs_push(l, "        let st = storage(b);")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        while i < pad {")
    strs_push(l, "            bytes_set(st, at + i, UInt8(0));")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    bytebuf_len(b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The byte at `i`, or `None` outside `0..bytebuf_len(b)`.")
    strs_push(l, "pub fn bytebuf_get(b: ByteBuf, i: Int) -> Option[UInt8] ! {} {")
    strs_push(l, "    if i < 0 || i >= bytebuf_len(b) {")
    strs_push(l, "        Option[UInt8].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        Option[UInt8].Some(value: bytes_get(storage(b), i))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Overwrite the byte at `i` with `v`; whether `i` was inside `0..bytebuf_len(b)` (nothing is")
    strs_push(l, "/// written when it was not).")
    strs_push(l, "pub fn bytebuf_set(b: ByteBuf, i: Int, v: UInt8) -> Bool ! {} {")
    strs_push(l, "    if i < 0 || i >= bytebuf_len(b) {")
    strs_push(l, "        false")
    strs_push(l, "    } else {")
    strs_push(l, "        bytes_set(storage(b), i, v);")
    strs_push(l, "        true")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Whether `n` bytes from `at` are all written.")
    strs_push(l, "fn inside(b: ByteBuf, at: Int, n: Int) -> Bool ! {} {")
    strs_push(l, "    at >= 0 && at + n <= bytebuf_len(b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Overwrite the four bytes at `at` with a `UInt32`, least significant first: a field written")
    strs_push(l, "/// before its value was known. Whether they were all inside the bytes written.")
    strs_push(l, "pub fn bytebuf_patch_u32_le(b: ByteBuf, at: Int, v: UInt32) -> Bool ! {} {")
    strs_push(l, "    if inside(b, at, 4) { bytes_write_le(storage(b), at, v); true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Overwrite the four bytes at `at` with a `UInt32`, most significant first; whether they were")
    strs_push(l, "/// all inside the bytes written.")
    strs_push(l, "pub fn bytebuf_patch_u32_be(b: ByteBuf, at: Int, v: UInt32) -> Bool ! {} {")
    strs_push(l, "    if inside(b, at, 4) { bytes_write_be(storage(b), at, v); true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Overwrite the eight bytes at `at` with a `UInt64`, least significant first; whether they were")
    strs_push(l, "/// all inside the bytes written.")
    strs_push(l, "pub fn bytebuf_patch_u64_le(b: ByteBuf, at: Int, v: UInt64) -> Bool ! {} {")
    strs_push(l, "    if inside(b, at, 8) { bytes_write_le(storage(b), at, v); true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Overwrite the eight bytes at `at` with a `UInt64`, most significant first; whether they were")
    strs_push(l, "/// all inside the bytes written.")
    strs_push(l, "pub fn bytebuf_patch_u64_be(b: ByteBuf, at: Int, v: UInt64) -> Bool ! {} {")
    strs_push(l, "    if inside(b, at, 8) { bytes_write_be(storage(b), at, v); true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The bytes written, as a new buffer of exactly that length: later writes to `b` do not change it.")
    strs_push(l, "pub fn bytebuf_to_bytes(b: ByteBuf) -> Bytes ! {} {")
    strs_push(l, "    let out = bytes_new(bytebuf_len(b));")
    strs_push(l, "    bytes_copy(out, bytes_slice(storage(b), 0, bytebuf_len(b)));")
    strs_push(l, "    out")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_chan() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/chan`: receiving one value from a channel as an `Option`, and sending, collecting and")
    strs_push(l, "// draining many. A channel's element type must be one that may cross into a task (`N0390`), so")
    strs_push(l, "// the helpers over many are written for `Int` and for `Str`, not over a type parameter.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/chan\";`. Channels, `spawn` and `scope` are the language's; this")
    strs_push(l, "// only hides the sequence `chan_recv` appends to, which a program receiving one value at a")
    strs_push(l, "// time would otherwise allocate for itself.")
    strs_push(l, "")
    strs_push(l, "/// The next value from `c`, blocking while it is empty, or `None` once it is closed and")
    strs_push(l, "/// drained.")
    strs_push(l, "pub fn chan_take(c: Chan) -> Option[Int] ! {} {")
    strs_push(l, "    let buf = ints_new();")
    strs_push(l, "    if chan_recv(c, buf) { Option[Int].Some(value: ints_get(buf, 0)) } else { Option[Int].None() }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Send every element of `xs` on `c`, in order, blocking while it is full; how many were sent")
    strs_push(l, "/// before `c` was found closed, which is all of them unless it was.")
    strs_push(l, "pub fn chan_send_all_ints(c: Chan[Int], xs: Vec[Int]) -> Int ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open && i < vec_len(xs) {")
    strs_push(l, "        if chan_send_of(c, vec_get(xs, i)) { i = i + 1; } else { open = false; }")
    strs_push(l, "    }")
    strs_push(l, "    i")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Up to `n` values from `c`, in order, blocking for each; fewer once it is closed and drained.")
    strs_push(l, "pub fn chan_collect_ints(c: Chan[Int], n: Int) -> Vec[Int] ! {} {")
    strs_push(l, "    let out = vec_new[Int]();")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open && vec_len(out) < n { open = chan_recv_of(c, out); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value from `c` until it is closed and drained, in order.")
    strs_push(l, "pub fn chan_drain_ints(c: Chan[Int]) -> Vec[Int] ! {} {")
    strs_push(l, "    let out = vec_new[Int]();")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open { open = chan_recv_of(c, out); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Send every element of `xs` on `c`, in order, blocking while it is full; how many were sent")
    strs_push(l, "/// before `c` was found closed, which is all of them unless it was.")
    strs_push(l, "pub fn chan_send_all_strs(c: Chan[Str], xs: Vec[Str]) -> Int ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open && i < vec_len(xs) {")
    strs_push(l, "        if chan_send_of(c, vec_get(xs, i)) { i = i + 1; } else { open = false; }")
    strs_push(l, "    }")
    strs_push(l, "    i")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Up to `n` values from `c`, in order, blocking for each; fewer once it is closed and drained.")
    strs_push(l, "pub fn chan_collect_strs(c: Chan[Str], n: Int) -> Vec[Str] ! {} {")
    strs_push(l, "    let out = vec_new[Str]();")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open && vec_len(out) < n { open = chan_recv_of(c, out); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value from `c` until it is closed and drained, in order.")
    strs_push(l, "pub fn chan_drain_strs(c: Chan[Str]) -> Vec[Str] ! {} {")
    strs_push(l, "    let out = vec_new[Str]();")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    while open { open = chan_recv_of(c, out); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_config() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/config`: a service's settings from a TOML file and the environment, into a typed record")
    strs_push(l, "// (v1 track C, C4).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/config\";`. `docs/user/spec.md`, *Configuration*, states the rules; the")
    strs_push(l, "// design record is `openspec/changes/v1-every-domain/design.md`, section C. The record is one the")
    strs_push(l, "// program declares with `@derive(json)`: its JSON Schema (`settings_json_schema()`) says which")
    strs_push(l, "// members there are and what each holds, and its decoder (`settings_from_json`) makes the value,")
    strs_push(l, "// so every rule of a derived decoding — renamed members, defaults, `Option`s, ranges — holds here")
    strs_push(l, "// too. A file is read as TOML 1.0; each top-level member may then be set by an environment variable")
    strs_push(l, "// named by a prefix and the member's name, which wins over the file. No new language: the type is")
    strs_push(l, "// carried by the schema and the decoder, which the derive already gives every such record.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "use \"@std/file\";")
    strs_push(l, "use \"@std/env\";")
    strs_push(l, "use \"@std/text\";")
    strs_push(l, "use \"@std/json\";")
    strs_push(l, "use \"@std/toml\";")
    strs_push(l, "")
    strs_push(l, "fn fail(why: Str) -> Result[Str, Str] ! {} {")
    strs_push(l, "    Result[Str, Str].Err(error: why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The environment variable for member `member` under `prefix`: the member's name upper-cased, a")
    strs_push(l, "/// word boundary inside it (`displayName`, `drain-ms`, `log.level`) written `_`, after the prefix.")
    strs_push(l, "pub fn config_env_name(prefix: Str, member: Str) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, prefix);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(member) {")
    strs_push(l, "        let b = str_byte(member, i);")
    strs_push(l, "        if b >= 65 && b <= 90 && i > 0 {")
    strs_push(l, "            let p = str_byte(member, i - 1);")
    strs_push(l, "            if (p >= 97 && p <= 122) || (p >= 48 && p <= 57) { strs_push(parts, \"_\"); }")
    strs_push(l, "        }")
    strs_push(l, "        if b >= 97 && b <= 122 {")
    strs_push(l, "            strs_push(parts, str_from_byte(b - 32));")
    strs_push(l, "        } else {")
    strs_push(l, "            if (b >= 65 && b <= 90) || (b >= 48 && b <= 57) { strs_push(parts, str_from_byte(b)); } else { strs_push(parts, \"_\"); }")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// What one member's schema says an environment variable may carry: `integer`, `number`, `boolean`")
    strs_push(l, "// or `string`, or `\"\"` for a member it cannot (an object or an array).")
    strs_push(l, "fn carried(s: JsonDoc, node: Int, defs: Int) -> Str ! {} {")
    strs_push(l, "    match json_get(s, node, \"anyOf\") {")
    strs_push(l, "        Option.Some(value: any) => {")
    strs_push(l, "            return match json_at(s, any, 0) { Option.Some(value: inner) => carried(s, inner, defs), Option.None() => \"\", };")
    strs_push(l, "        },")
    strs_push(l, "        Option.None() => {},")
    strs_push(l, "    };")
    strs_push(l, "    match json_get(s, node, \"$ref\") {")
    strs_push(l, "        Option.Some(value: r) => {")
    strs_push(l, "            let target = match json_str(s, r) { Option.Some(value: t) => t, Option.None() => \"\", };")
    strs_push(l, "            let name = if text_starts_with(target, \"#/$defs/\") { str_slice(target, 8, str_len(target)) } else { \"\" };")
    strs_push(l, "            let def = if defs >= 0 { json_get(s, defs, name) } else { Option[Int].None() };")
    strs_push(l, "            return match def {")
    strs_push(l, "                Option.Some(value: d) => {")
    strs_push(l, "                    let t = match json_get(s, d, \"type\") { Option.Some(value: k) => match json_str(s, k) { Option.Some(value: x) => x, Option.None() => \"\", }, Option.None() => \"\", };")
    strs_push(l, "                    if t == \"object\" { \"\" } else { \"string\" }")
    strs_push(l, "                },")
    strs_push(l, "                Option.None() => \"\",")
    strs_push(l, "            };")
    strs_push(l, "        },")
    strs_push(l, "        Option.None() => {},")
    strs_push(l, "    };")
    strs_push(l, "    let t = match json_get(s, node, \"type\") { Option.Some(value: k) => match json_str(s, k) { Option.Some(value: x) => x, Option.None() => \"\", }, Option.None() => \"\", };")
    strs_push(l, "    if t == \"integer\" || t == \"number\" || t == \"boolean\" || t == \"string\" { t } else { \"\" }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The node `value` makes in `doc` as a `kind`, or the error naming the variable.")
    strs_push(l, "struct Made {")
    strs_push(l, "    node: Int,")
    strs_push(l, "    why: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn from_env(doc: JsonDoc, var: Str, kind: Str, value: Str) -> Made ! {} {")
    strs_push(l, "    if kind == \"string\" { return Made(node: json_add_str(doc, value), why: \"\"); }")
    strs_push(l, "    if kind == \"boolean\" {")
    strs_push(l, "        if value == \"true\" { return Made(node: json_add_bool(doc, true), why: \"\"); }")
    strs_push(l, "        if value == \"false\" { return Made(node: json_add_bool(doc, false), why: \"\"); }")
    strs_push(l, "        return Made(node: 0, why: str_concat(var, \": expected true or false\"));")
    strs_push(l, "    }")
    strs_push(l, "    if kind == \"integer\" {")
    strs_push(l, "        return match text_parse_int(value) {")
    strs_push(l, "            Result.Ok(value: n) => Made(node: json_add_int(doc, n), why: \"\"),")
    strs_push(l, "            Result.Err(error: e) => Made(node: 0, why: str_concat(str_concat(var, \": expected an integer, \"), e)),")
    strs_push(l, "        };")
    strs_push(l, "    }")
    strs_push(l, "    if kind == \"number\" {")
    strs_push(l, "        let ok = str_len(value) > 0 && float_parses(value);")
    strs_push(l, "        if !ok { return Made(node: 0, why: str_concat(var, \": expected a number\")); }")
    strs_push(l, "        let x = float_parse_raw(value);")
    strs_push(l, "        if !float_is_finite(x) { return Made(node: 0, why: str_concat(var, \": expected a finite number\")); }")
    strs_push(l, "        return Made(node: json_add_float(doc, x), why: \"\");")
    strs_push(l, "    }")
    strs_push(l, "    Made(node: 0, why: str_concat(var, \": a member an environment variable cannot carry\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `t` as nodes of `doc`: a table an object, an array an array, a date or time its text.")
    strs_push(l, "fn from_toml(doc: JsonDoc, t: Toml) -> Int ! {} {")
    strs_push(l, "    match t {")
    strs_push(l, "        Toml.Str(value: v) => json_add_str(doc, v),")
    strs_push(l, "        Toml.Int(value: v) => json_add_int(doc, v),")
    strs_push(l, "        Toml.Float(value: v) => json_add_float(doc, v),")
    strs_push(l, "        Toml.Bool(value: v) => json_add_bool(doc, v),")
    strs_push(l, "        Toml.OffsetDatetime(value: v) => json_add_str(doc, v),")
    strs_push(l, "        Toml.LocalDatetime(value: v) => json_add_str(doc, v),")
    strs_push(l, "        Toml.LocalDate(value: v) => json_add_str(doc, v),")
    strs_push(l, "        Toml.LocalTime(value: v) => json_add_str(doc, v),")
    strs_push(l, "        Toml.Array(items: items) => {")
    strs_push(l, "            let ns = ints_new();")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            while i < chain_len(items) { ints_push(ns, from_toml(doc, chain_get(items, i))); i = i + 1; }")
    strs_push(l, "            json_add_array(doc, ns)")
    strs_push(l, "        },")
    strs_push(l, "        Toml.Table(keys: keys, values: values) => {")
    strs_push(l, "            let ks = strs_new();")
    strs_push(l, "            let ns = ints_new();")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            while i < chain_len(keys) {")
    strs_push(l, "                strs_push(ks, chain_get(keys, i));")
    strs_push(l, "                ints_push(ns, from_toml(doc, chain_get(values, i)));")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "            json_add_object(doc, ks, ns)")
    strs_push(l, "        },")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The settings as one JSON document: the TOML file at `path` (`\"\"`: none), then for each member")
    strs_push(l, "/// of the record `schema` describes, the variable `config_env_name(prefix, member)` when it is")
    strs_push(l, "/// set, which replaces the file's value. An `Err` names the file and `line:column`, or the variable")
    strs_push(l, "/// and what it should have held — a member that is a record or a sequence cannot be set from the")
    strs_push(l, "/// environment, only from the file.")
    strs_push(l, "pub fn config_document(io: IoCap, path: Str, prefix: Str, schema: Str) -> Result[Str, Str] ! { io } {")
    strs_push(l, "    let s = match json_parse(schema) {")
    strs_push(l, "        Result.Ok(value: d) => d,")
    strs_push(l, "        Result.Err(error: e) => { return fail(str_concat(\"the schema is not JSON: \", e)); },")
    strs_push(l, "    };")
    strs_push(l, "    let defs = match json_get(s, json_root(s), \"$defs\") { Option.Some(value: d) => d, Option.None() => 0 - 1, };")
    strs_push(l, "    let mut record = json_root(s);")
    strs_push(l, "    match json_get(s, record, \"$ref\") {")
    strs_push(l, "        Option.Some(value: r) => {")
    strs_push(l, "            let target = match json_str(s, r) { Option.Some(value: t) => t, Option.None() => \"\", };")
    strs_push(l, "            let name = if text_starts_with(target, \"#/$defs/\") { str_slice(target, 8, str_len(target)) } else { \"\" };")
    strs_push(l, "            match if defs >= 0 { json_get(s, defs, name) } else { Option[Int].None() } {")
    strs_push(l, "                Option.Some(value: d) => { record = d; },")
    strs_push(l, "                Option.None() => { return fail(str_concat(\"the schema has no definition of \", target)); },")
    strs_push(l, "            };")
    strs_push(l, "        },")
    strs_push(l, "        Option.None() => {},")
    strs_push(l, "    };")
    strs_push(l, "    let props = match json_get(s, record, \"properties\") {")
    strs_push(l, "        Option.Some(value: p) => p,")
    strs_push(l, "        Option.None() => { return fail(\"the schema is not a record's\"); },")
    strs_push(l, "    };")
    strs_push(l, "    let doc = json_new();")
    strs_push(l, "    let keys = strs_new();")
    strs_push(l, "    let values = ints_new();")
    strs_push(l, "    if str_len(path) > 0 {")
    strs_push(l, "        let text = match file_read_all(io, path) {")
    strs_push(l, "            Result.Ok(value: b) => bytes_to_str(b),")
    strs_push(l, "            Result.Err(error: e) => { return fail(str_concat(str_concat(path, \": \"), io_error_show(e))); },")
    strs_push(l, "        };")
    strs_push(l, "        match toml_parse(text) {")
    strs_push(l, "            Result.Ok(value: t) => {")
    strs_push(l, "                if let Toml.Table(keys: tk, values: tv) = t {")
    strs_push(l, "                    let mut i = 0;")
    strs_push(l, "                    while i < chain_len(tk) {")
    strs_push(l, "                        strs_push(keys, chain_get(tk, i));")
    strs_push(l, "                        ints_push(values, from_toml(doc, chain_get(tv, i)));")
    strs_push(l, "                        i = i + 1;")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            },")
    strs_push(l, "            Result.Err(error: e) => { return fail(str_concat(str_concat(path, \":\"), e)); },")
    strs_push(l, "        };")
    strs_push(l, "    }")
    strs_push(l, "    let mut p = 0;")
    strs_push(l, "    while p < json_len(s, props) {")
    strs_push(l, "        let member = match json_key_at(s, props, p) { Option.Some(value: k) => k, Option.None() => \"\", };")
    strs_push(l, "        let var = config_env_name(prefix, member);")
    strs_push(l, "        match env_get(io, var) {")
    strs_push(l, "            Option.Some(value: v) => {")
    strs_push(l, "                let kind = match json_value_at(s, props, p) { Option.Some(value: n) => carried(s, n, defs), Option.None() => \"\", };")
    strs_push(l, "                let made = from_env(doc, var, kind, v);")
    strs_push(l, "                if str_len(made.why) > 0 { return fail(made.why); }")
    strs_push(l, "                let mut at = 0 - 1;")
    strs_push(l, "                let mut i = 0;")
    strs_push(l, "                while i < strs_len(keys) { if strs_get(keys, i) == member { at = i; } i = i + 1; }")
    strs_push(l, "                if at >= 0 { ints_set(values, at, made.node); } else { strs_push(keys, member); ints_push(values, made.node); }")
    strs_push(l, "            },")
    strs_push(l, "            Option.None() => {},")
    strs_push(l, "        };")
    strs_push(l, "        p = p + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let root = json_add_object(doc, keys, values);")
    strs_push(l, "    Result[Str, Str].Ok(value: json_encode(json_with_root(doc, root)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The settings `config_document` gathers, decoded by `decode` — the record's derived")
    strs_push(l, "/// `…_from_json` — whose `Err`, a path into the document, is answered as it is.")
    strs_push(l, "pub fn config_load[T](io: IoCap, path: Str, prefix: Str, schema: Str, decode: fn(Str) -> Result[T, Str] ! {}) -> Result[T, Str] ! { io } {")
    strs_push(l, "    match config_document(io, path, prefix, schema) {")
    strs_push(l, "        Result.Ok(value: text) => decode(text),")
    strs_push(l, "        Result.Err(error: e) => Result[T, Str].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `config_load` without a file: the environment alone.")
    strs_push(l, "pub fn config_from_env[T](io: IoCap, prefix: Str, schema: Str, decode: fn(Str) -> Result[T, Str] ! {}) -> Result[T, Str] ! { io } {")
    strs_push(l, "    config_load(io, \"\", prefix, schema, decode)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_deque() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/deque`: a double-ended queue, as a ring buffer (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/deque\";`. A `Deque[T]` holds its items in a ring over a `Vec` it")
    strs_push(l, "// shares like any handle: copies of a deque are the same deque. Pushing and popping at either end")
    strs_push(l, "// take amortised constant time — the ring doubles when it is full — and reading an item by its")
    strs_push(l, "// position constant time.")
    strs_push(l, "")
    strs_push(l, "/// A queue of `T`, open at both ends. `meta` holds where the first item is and how many there are.")
    strs_push(l, "pub struct Deque[T] {")
    strs_push(l, "    ring: Vec[Option[T]],")
    strs_push(l, "    meta: Vec[Int],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty deque.")
    strs_push(l, "pub fn deque_new[T]() -> Deque[T] ! {} {")
    strs_push(l, "    let ring = vec_new[Option[T]]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 4 {")
    strs_push(l, "        vec_push(ring, Option[T].None());")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let meta = vec_new[Int]();")
    strs_push(l, "    vec_push(meta, 0);")
    strs_push(l, "    vec_push(meta, 0);")
    strs_push(l, "    Deque[T](ring: ring, meta: meta)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many items `d` holds.")
    strs_push(l, "pub fn deque_len[T](d: Deque[T]) -> Int ! {} {")
    strs_push(l, "    vec_get(d.meta, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The ring slot of position `i`.")
    strs_push(l, "fn deque_slot[T](d: Deque[T], i: Int) -> Int ! {} {")
    strs_push(l, "    (vec_get(d.meta, 0) + i) % vec_len(d.ring)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Twice the ring, the items first in order.")
    strs_push(l, "fn deque_grow[T](d: Deque[T]) -> Int ! {} {")
    strs_push(l, "    let cap = vec_len(d.ring);")
    strs_push(l, "    let items = vec_new[Option[T]]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < cap {")
    strs_push(l, "        vec_push(items, vec_get(d.ring, deque_slot(d, i)));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while j < cap {")
    strs_push(l, "        vec_set(d.ring, j, vec_get(items, j));")
    strs_push(l, "        j = j + 1;")
    strs_push(l, "    }")
    strs_push(l, "    while vec_len(d.ring) < cap * 2 {")
    strs_push(l, "        vec_push(d.ring, Option[T].None());")
    strs_push(l, "    }")
    strs_push(l, "    vec_set(d.meta, 0, 0);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Put `x` at the back of `d`.")
    strs_push(l, "pub fn deque_push_back[T](d: Deque[T], x: T) -> Int ! {} {")
    strs_push(l, "    if deque_len(d) == vec_len(d.ring) {")
    strs_push(l, "        deque_grow(d);")
    strs_push(l, "    }")
    strs_push(l, "    vec_set(d.ring, deque_slot(d, deque_len(d)), Option[T].Some(value: x));")
    strs_push(l, "    vec_set(d.meta, 1, deque_len(d) + 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Put `x` at the front of `d`.")
    strs_push(l, "pub fn deque_push_front[T](d: Deque[T], x: T) -> Int ! {} {")
    strs_push(l, "    if deque_len(d) == vec_len(d.ring) {")
    strs_push(l, "        deque_grow(d);")
    strs_push(l, "    }")
    strs_push(l, "    let head = (vec_get(d.meta, 0) + vec_len(d.ring) - 1) % vec_len(d.ring);")
    strs_push(l, "    vec_set(d.ring, head, Option[T].Some(value: x));")
    strs_push(l, "    vec_set(d.meta, 0, head);")
    strs_push(l, "    vec_set(d.meta, 1, deque_len(d) + 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take the item at the front of `d`, or `None` when it is empty.")
    strs_push(l, "pub fn deque_pop_front[T](d: Deque[T]) -> Option[T] ! {} {")
    strs_push(l, "    if deque_len(d) == 0 {")
    strs_push(l, "        Option[T].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let head = vec_get(d.meta, 0);")
    strs_push(l, "        let x = vec_get(d.ring, head);")
    strs_push(l, "        vec_set(d.ring, head, Option[T].None());")
    strs_push(l, "        vec_set(d.meta, 0, (head + 1) % vec_len(d.ring));")
    strs_push(l, "        vec_set(d.meta, 1, deque_len(d) - 1);")
    strs_push(l, "        x")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take the item at the back of `d`, or `None` when it is empty.")
    strs_push(l, "pub fn deque_pop_back[T](d: Deque[T]) -> Option[T] ! {} {")
    strs_push(l, "    if deque_len(d) == 0 {")
    strs_push(l, "        Option[T].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let at = deque_slot(d, deque_len(d) - 1);")
    strs_push(l, "        let x = vec_get(d.ring, at);")
    strs_push(l, "        vec_set(d.ring, at, Option[T].None());")
    strs_push(l, "        vec_set(d.meta, 1, deque_len(d) - 1);")
    strs_push(l, "        x")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The item at position `i` of `d`, front first, or `None` outside `0..deque_len(d)`.")
    strs_push(l, "pub fn deque_get[T](d: Deque[T], i: Int) -> Option[T] ! {} {")
    strs_push(l, "    if i < 0 || i >= deque_len(d) {")
    strs_push(l, "        Option[T].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        vec_get(d.ring, deque_slot(d, i))")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_dist() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/dist`: the distributed foundation's library contract (Gate 3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/dist\";`. Not a concurrency model of its own — tasks, channels and")
    strs_push(l, "// `select` are the language's — but what two processes need to ask each other things and survive")
    strs_push(l, "// one of them failing:")
    strs_push(l, "//")
    strs_push(l, "// - a node's identity, a value a program holds and passes, never ambient (`NodeId`);")
    strs_push(l, "// - a message, `Msg`, framed over `@std/binary`: four bytes of length, then its fields;")
    strs_push(l, "// - a transport, a trait with a TCP implementation (`Tcp`) and an in-process one (`Local`), whose")
    strs_push(l, "//   one method takes the authority it uses and a deadline;")
    strs_push(l, "// - `retry`, which tries again with exponential backoff, the message's idempotency key the same")
    strs_push(l, "//   each time, so a receiver that records what it applied answers a repeat without applying it")
    strs_push(l, "//   twice;")
    strs_push(l, "// - failure as a `Result`, never a crash.")
    strs_push(l, "//")
    strs_push(l, "// `docs/internal/systems-domains.md` Part N.")
    strs_push(l, "")
    strs_push(l, "use \"@std/binary\";")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "use \"@std/net\";")
    strs_push(l, "use \"@std/time\";")
    strs_push(l, "")
    strs_push(l, "/// A node: its name, and where it listens.")
    strs_push(l, "pub struct NodeId {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    addr: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One message: who sent it, its idempotency key, what kind of request or answer it is, and its")
    strs_push(l, "/// body.")
    strs_push(l, "pub struct Msg {")
    strs_push(l, "    from: Str,")
    strs_push(l, "    key: Int,")
    strs_push(l, "    kind: Int,")
    strs_push(l, "    body: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The node `name` at `addr`.")
    strs_push(l, "pub fn node_id(name: Str, addr: Str) -> NodeId ! {} {")
    strs_push(l, "    NodeId(name: name, addr: addr)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `m` as one frame: its length as four little-endian bytes, then the sender, the key, the kind")
    strs_push(l, "/// and the body.")
    strs_push(l, "pub fn msg_encode(m: Msg) -> Bytes ! {} {")
    strs_push(l, "    let body = binary_writer();")
    strs_push(l, "    binary_put_str(body, m.from);")
    strs_push(l, "    binary_put_i64_le(body, m.key);")
    strs_push(l, "    binary_put_i64_le(body, m.kind);")
    strs_push(l, "    binary_put_str(body, m.body);")
    strs_push(l, "    let payload = binary_finish(body);")
    strs_push(l, "    let w = binary_writer();")
    strs_push(l, "    binary_put_u32_le(w, UInt32(bytes_len(payload)));")
    strs_push(l, "    binary_put_raw(w, payload);")
    strs_push(l, "    binary_finish(w)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The message a frame's payload — the bytes after its length — holds.")
    strs_push(l, "pub fn msg_decode(payload: Bytes) -> Result[Msg, Str] ! {} {")
    strs_push(l, "    let r = binary_reader(payload);")
    strs_push(l, "    let from = binary_get_str(r)?;")
    strs_push(l, "    let key = binary_get_i64_le(r)?;")
    strs_push(l, "    let kind = binary_get_i64_le(r)?;")
    strs_push(l, "    let body = binary_get_str(r)?;")
    strs_push(l, "    if binary_remaining(r) != 0 {")
    strs_push(l, "        return Result[Msg, Str].Err(error: \"a frame holds more than its message\");")
    strs_push(l, "    }")
    strs_push(l, "    Result[Msg, Str].Ok(value: Msg(from: from, key: key, kind: kind, body: body))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One frame written to `s`.")
    strs_push(l, "pub fn tcp_send_msg(s: TcpStream, m: Msg) -> Result[Int, Str] ! { io } {")
    strs_push(l, "    match tcp_write(s, msg_encode(m)) {")
    strs_push(l, "        Result.Ok(value: n) => Result[Int, Str].Ok(value: n),")
    strs_push(l, "        Result.Err(error: e) => Result[Int, Str].Err(error: io_error_show(e)),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One frame read from `s`: at most a mebibyte, refused before it is read when it says it is more.")
    strs_push(l, "pub fn tcp_recv_msg(s: TcpStream) -> Result[Msg, Str] ! { io } {")
    strs_push(l, "    let len = bytes_new(4);")
    strs_push(l, "    match tcp_read_exact(s, len) {")
    strs_push(l, "        Result.Ok(value: n) => {},")
    strs_push(l, "        Result.Err(error: e) => { return Result[Msg, Str].Err(error: io_error_show(e)); },")
    strs_push(l, "    };")
    strs_push(l, "    let n = Int(bytes_read_le[UInt32](len, 0));")
    strs_push(l, "    if n > 1048576 {")
    strs_push(l, "        return Result[Msg, Str].Err(error: \"a frame longer than a mebibyte\");")
    strs_push(l, "    }")
    strs_push(l, "    let payload = bytes_new(n);")
    strs_push(l, "    match tcp_read_exact(s, payload) {")
    strs_push(l, "        Result.Ok(value: got) => {},")
    strs_push(l, "        Result.Err(error: e) => { return Result[Msg, Str].Err(error: io_error_show(e)); },")
    strs_push(l, "    };")
    strs_push(l, "    msg_decode(payload)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A way to ask a node something: `m` there, its answer back, within `timeout_ms`, or why not. The")
    strs_push(l, "/// authority it may use is handed to it: the network's and the clock's.")
    strs_push(l, "pub trait Transport {")
    strs_push(l, "    fn ask(self: Self, net: NetCap, time: TimeCap, m: Msg, timeout_ms: Int) -> Result[Msg, Str] ! { io };")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Over TCP, to `to`: one connection a request.")
    strs_push(l, "pub struct Tcp {")
    strs_push(l, "    to: NodeId,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Transport for Tcp {")
    strs_push(l, "    fn ask(self: Tcp, net: NetCap, time: TimeCap, m: Msg, timeout_ms: Int) -> Result[Msg, Str] ! { io } {")
    strs_push(l, "        let s = match tcp_connect(net, self.to.addr, timeout_ms) {")
    strs_push(l, "            Result.Ok(value: s) => s,")
    strs_push(l, "            Result.Err(error: e) => { return Result[Msg, Str].Err(error: io_error_show(e)); },")
    strs_push(l, "        };")
    strs_push(l, "        tcp_set_timeout(s, timeout_ms);")
    strs_push(l, "        let sent = tcp_send_msg(s, m);")
    strs_push(l, "        let answer = match sent {")
    strs_push(l, "            Result.Ok(value: n) => tcp_recv_msg(s),")
    strs_push(l, "            Result.Err(error: e) => Result[Msg, Str].Err(error: e),")
    strs_push(l, "        };")
    strs_push(l, "        tcp_close(s);")
    strs_push(l, "        answer")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// In process: requests on one channel, answers on another, to a task that serves them.")
    strs_push(l, "pub struct Local {")
    strs_push(l, "    requests: Chan[Msg],")
    strs_push(l, "    answers: Chan[Msg],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Transport for Local {")
    strs_push(l, "    fn ask(self: Local, net: NetCap, time: TimeCap, m: Msg, timeout_ms: Int) -> Result[Msg, Str] ! { io } {")
    strs_push(l, "        if !chan_send_of(self.requests, m) {")
    strs_push(l, "            return Result[Msg, Str].Err(error: \"the node has stopped\");")
    strs_push(l, "        }")
    strs_push(l, "        let cs = vec_new[Chan[Msg]]();")
    strs_push(l, "        vec_push(cs, self.answers);")
    strs_push(l, "        let got = vec_new[Msg]();")
    strs_push(l, "        let i = chan_select_until(cs, got, timeout_ms);")
    strs_push(l, "        if i == 0 && vec_len(got) > 0 {")
    strs_push(l, "            Result[Msg, Str].Ok(value: vec_pop(got))")
    strs_push(l, "        } else {")
    strs_push(l, "            if i == -2 {")
    strs_push(l, "                Result[Msg, Str].Err(error: \"timed out\")")
    strs_push(l, "            } else {")
    strs_push(l, "                Result[Msg, Str].Err(error: \"the node has stopped\")")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `m` asked through `t` until it is answered, at most `attempts` times, waiting `base_ms`, then")
    strs_push(l, "/// twice that, and so on, between tries. The message — its idempotency key above all — is the")
    strs_push(l, "/// same each time. The last failure, if every try failed.")
    strs_push(l, "pub fn retry[T: Transport](t: T, net: NetCap, time: TimeCap, m: Msg, attempts: Int, base_ms: Int, timeout_ms: Int) -> Result[Msg, Str] ! { io } {")
    strs_push(l, "    let mut last = \"no attempt\";")
    strs_push(l, "    let mut wait = base_ms;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < attempts {")
    strs_push(l, "        match t.ask(net, time, m, timeout_ms) {")
    strs_push(l, "            Result.Ok(value: a) => { return Result[Msg, Str].Ok(value: a); },")
    strs_push(l, "            Result.Err(error: e) => { last = e; },")
    strs_push(l, "        };")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "        if i < attempts {")
    strs_push(l, "            time_sleep(time, time_duration_ms(wait));")
    strs_push(l, "            wait = wait * 2;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[Msg, Str].Err(error: str_concat(str_concat(str_concat(\"no answer after \", int_to_str(attempts)), \" tries: \"), last))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_env() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/env`: the process's environment (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/env\";`. The environment is the outside world's, as the arguments are,")
    strs_push(l, "// so every function takes the `IoCap` that allows it. Its entries are in the order the process")
    strs_push(l, "// holds them; an entry with no `=` after its first byte is not one. `docs/internal/general-purpose.md` §12.")
    strs_push(l, "")
    strs_push(l, "/// The value of the variable `name`, or `None` when it is not set.")
    strs_push(l, "pub fn env_get(io: IoCap, name: Str) -> Option[Str] ! { io } {")
    strs_push(l, "    if os_env_has(name) { Option[Str].Some(value: os_env_get(name)) } else { Option[Str].None() }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every entry, `NAME=value`, in the environment's order.")
    strs_push(l, "pub fn env_vars(io: IoCap) -> Strs ! { io } {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < os_env_count() {")
    strs_push(l, "        strs_push(out, os_env_at(i));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_error() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/error`: one error type an application propagates with `?` (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/error\";` beside `use \"@std/ioerror\";`. An `Error` is a message and what")
    strs_push(l, "// the program was doing when it happened, innermost first: a function that cannot go on returns")
    strs_push(l, "// `Err(error_new(…))`, and each caller that knows more adds it with `error_context`. An `IoError`")
    strs_push(l, "// becomes one with `error_from_io`. No exceptions: failure is a value. `docs/internal/general-purpose.md`")
    strs_push(l, "// §13.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "")
    strs_push(l, "/// A failure: what went wrong, and what the program was doing, innermost first.")
    strs_push(l, "pub struct Error {")
    strs_push(l, "    message: Str,")
    strs_push(l, "    context: Vec[Str],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A failure with this message and no context yet.")
    strs_push(l, "pub fn error_new(message: Str) -> Error ! {} {")
    strs_push(l, "    Error(message: message, context: vec_new[Str]())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `e`, saying what the program was doing when it happened.")
    strs_push(l, "pub fn error_context(e: Error, doing: Str) -> Error ! {} {")
    strs_push(l, "    let context = vec_new[Str]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(e.context) {")
    strs_push(l, "        vec_push(context, vec_get(e.context, i));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    vec_push(context, doing);")
    strs_push(l, "    Error(message: e.message, context: context)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `IoError` as an `Error`: its message and kind, and its context if it has one.")
    strs_push(l, "pub fn error_from_io(e: IoError) -> Error ! {} {")
    strs_push(l, "    let base = error_new(str_concat(e.message, str_concat(\" (\", str_concat(io_kind_name(e.kind), \")\"))));")
    strs_push(l, "    if str_len(e.context) == 0 { base } else { error_context(base, e.context) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `e` as one line: what the program was doing, outermost first, then what went wrong.")
    strs_push(l, "pub fn error_show(e: Error) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut i = vec_len(e.context);")
    strs_push(l, "    while i > 0 {")
    strs_push(l, "        i = i - 1;")
    strs_push(l, "        out = str_concat(out, str_concat(vec_get(e.context, i), \": \"));")
    strs_push(l, "    }")
    strs_push(l, "    str_concat(out, e.message)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `r`'s error as an `Error`, so a function returning `Result[T, Error]` can `?` an I/O result.")
    strs_push(l, "pub fn error_io_result[T](r: Result[T, IoError]) -> Result[T, Error] ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => Result[T, Error].Ok(value: v),")
    strs_push(l, "        Result.Err(error: e) => Result[T, Error].Err(error: error_from_io(e)),")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_file() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/file`: files and directories, with every failure a value (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/file\";` beside `use \"@std/ioerror\";`. A `File` is an open file the")
    strs_push(l, "// operating system holds; copies of one are the same file. Whatever names a path takes the")
    strs_push(l, "// `IoCap` that allows it; whatever uses a `File` takes only the file, which reaches nothing but")
    strs_push(l, "// itself — so a function can be handed one file and no other authority. Every function returns a")
    strs_push(l, "// `Result` whose error says what kind of failure it was, the same on every platform. A file not closed stays open until the program ends. `docs/internal/general-purpose.md`")
    strs_push(l, "// §8 is the design record; `docs/user/spec.md`, *Files and handles*, the built-ins beneath.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "")
    strs_push(l, "/// An open file.")
    strs_push(l, "pub struct File {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What a path names.")
    strs_push(l, "pub enum FileKind {")
    strs_push(l, "    Regular,")
    strs_push(l, "    Directory,")
    strs_push(l, "    Other,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `file_metadata` reports: the size in bytes, the kind, the modification time in")
    strs_push(l, "/// nanoseconds since the Unix epoch, and the permission bits.")
    strs_push(l, "pub struct Metadata {")
    strs_push(l, "    size: Int,")
    strs_push(l, "    kind: FileKind,")
    strs_push(l, "    modified_ns: Int,")
    strs_push(l, "    permissions: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What a path itself is, a symbolic link not followed (R1d).")
    strs_push(l, "pub enum EntryKind {")
    strs_push(l, "    Regular,")
    strs_push(l, "    Directory,")
    strs_push(l, "    Symlink,")
    strs_push(l, "    Other,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `file_symlink_metadata` reports (R1d): `Metadata`'s four, about the path itself — a link's")
    strs_push(l, "/// size is its target's length — and the device and inode, which together name one file.")
    strs_push(l, "pub struct LinkMetadata {")
    strs_push(l, "    size: Int,")
    strs_push(l, "    kind: EntryKind,")
    strs_push(l, "    modified_ns: Int,")
    strs_push(l, "    permissions: Int,")
    strs_push(l, "    device: Int,")
    strs_push(l, "    inode: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A file read a chunk at a time, a line at a time (R1.5, 3.5): what `for line in")
    strs_push(l, "/// file_lines(io, path)` reads through. `text` holds the text read and not yet handed out, then the")
    strs_push(l, "/// current line; `at` where the next line starts in it, where the scan for its end resumes, and")
    strs_push(l, "/// whether the file has ended.")
    strs_push(l, "pub struct LineReader {")
    strs_push(l, "    io: IoCap,")
    strs_push(l, "    path: Str,")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "    chunk: Bytes,")
    strs_push(l, "    text: Strs,")
    strs_push(l, "    at: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn opened(h: OsHandle) -> Result[File, IoError] ! {} {")
    strs_push(l, "    let s = os_status(h);")
    strs_push(l, "    if s < 0 { Result[File, IoError].Err(error: io_error_from(s)) } else { Result[File, IoError].Ok(value: File(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The file at `path`, to read.")
    strs_push(l, "pub fn file_open(io: IoCap, path: Str) -> Result[File, IoError] ! { io } {")
    strs_push(l, "    opened(os_open_read(path))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A file at `path` to write, made empty: created if there is none.")
    strs_push(l, "pub fn file_create(io: IoCap, path: Str) -> Result[File, IoError] ! { io } {")
    strs_push(l, "    opened(os_open_write(path, 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The file at `path` to write at its end: created if there is none.")
    strs_push(l, "pub fn file_append(io: IoCap, path: Str) -> Result[File, IoError] ! { io } {")
    strs_push(l, "    opened(os_open_write(path, 1))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new file at `path` to write; `AlreadyExists` if there is one.")
    strs_push(l, "pub fn file_create_new(io: IoCap, path: Str) -> Result[File, IoError] ! { io } {")
    strs_push(l, "    opened(os_open_write(path, 2))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The file at `path`, to read and write.")
    strs_push(l, "pub fn file_open_rw(io: IoCap, path: Str) -> Result[File, IoError] ! { io } {")
    strs_push(l, "    opened(os_open_write(path, 3))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// At most `bytes_len(buf)` bytes into `buf`: how many, `0` at the end.")
    strs_push(l, "pub fn file_read(f: File, buf: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_read(f.handle, buf))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Everything from the current position to the end.")
    strs_push(l, "pub fn file_read_rest(f: File) -> Result[Bytes, IoError] ! { io } {")
    strs_push(l, "    let chunk = bytes_new(65536);")
    strs_push(l, "    let parts = vec_new[Bytes]();")
    strs_push(l, "    let mut total = 0;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    let mut failed = 0;")
    strs_push(l, "    while more {")
    strs_push(l, "        let n = os_read(f.handle, chunk);")
    strs_push(l, "        if n <= 0 {")
    strs_push(l, "            failed = n;")
    strs_push(l, "            more = false;")
    strs_push(l, "        } else {")
    strs_push(l, "            let part = bytes_new(n);")
    strs_push(l, "            bytes_copy(part, bytes_slice(chunk, 0, n));")
    strs_push(l, "            vec_push(parts, part);")
    strs_push(l, "            total = total + n;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if failed < 0 {")
    strs_push(l, "        return Result[Bytes, IoError].Err(error: io_error_from(failed));")
    strs_push(l, "    }")
    strs_push(l, "    let all = bytes_new(total);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(parts) {")
    strs_push(l, "        let part = vec_get(parts, i);")
    strs_push(l, "        bytes_copy(bytes_slice(all, at, at + bytes_len(part)), part);")
    strs_push(l, "        at = at + bytes_len(part);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Bytes, IoError].Ok(value: all)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The whole file at `path`.")
    strs_push(l, "pub fn file_read_all(io: IoCap, path: Str) -> Result[Bytes, IoError] ! { io } {")
    strs_push(l, "    let f = file_open(io, path)?;")
    strs_push(l, "    let all = file_read_rest(f);")
    strs_push(l, "    os_close(f.handle);")
    strs_push(l, "    match all {")
    strs_push(l, "        Result.Ok(value: b) => Result[Bytes, IoError].Ok(value: b),")
    strs_push(l, "        Result.Err(error: e) => Result[Bytes, IoError].Err(error: io_context(e, str_concat(\"reading \", path))),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every byte of `data`, however many writes it takes: `bytes_len(data)`.")
    strs_push(l, "pub fn file_write(f: File, data: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(data) {")
    strs_push(l, "        let n = os_write(f.handle, bytes_slice(data, at, bytes_len(data)));")
    strs_push(l, "        if n < 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_from(n));")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_new(IoErrorKind.Other(), \"the file took no bytes\"));")
    strs_push(l, "        }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s`'s bytes, as `file_write`.")
    strs_push(l, "pub fn file_write_str(f: File, s: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    file_write(f, bytes_from_str(s))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Move to `offset` bytes from the start; the new position.")
    strs_push(l, "pub fn file_seek(f: File, offset: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_seek(f.handle, offset, 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Move to `offset` bytes from the end; the new position.")
    strs_push(l, "pub fn file_seek_end(f: File, offset: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_seek(f.handle, offset, 2))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Where the next read or write is.")
    strs_push(l, "pub fn file_position(f: File) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_seek(f.handle, 0, 1))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The file's data and metadata, on storage.")
    strs_push(l, "pub fn file_sync(f: File) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_sync(f.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `f`; every copy of it is closed.")
    strs_push(l, "pub fn file_close(f: File) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_close(f.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `path` names, following symbolic links.")
    strs_push(l, "pub fn file_metadata(io: IoCap, path: Str) -> Result[Metadata, IoError] ! { io } {")
    strs_push(l, "    let out = bytes_new(32);")
    strs_push(l, "    let s = os_stat(path, out);")
    strs_push(l, "    if s < 0 {")
    strs_push(l, "        return Result[Metadata, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "    }")
    strs_push(l, "    let k = bytes_read_le[Int](out, 8);")
    strs_push(l, "    let kind = if k == 0 { FileKind.Regular() } else { if k == 1 { FileKind.Directory() } else { FileKind.Other() } };")
    strs_push(l, "    Result[Metadata, IoError].Ok(value: Metadata(size: bytes_read_le[Int](out, 0), kind: kind, modified_ns: bytes_read_le[Int](out, 16), permissions: bytes_read_le[Int](out, 24)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `path` names anything at all.")
    strs_push(l, "pub fn file_exists_at(io: IoCap, path: Str) -> Bool ! { io } {")
    strs_push(l, "    os_stat(path, bytes_new(32)) == 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The names in the directory at `path`, sorted by their bytes; never `.` or `..`.")
    strs_push(l, "pub fn dir_list(io: IoCap, path: Str) -> Result[Strs, IoError] ! { io } {")
    strs_push(l, "    let d = os_dir_open(path);")
    strs_push(l, "    let s = os_status(d);")
    strs_push(l, "    if s < 0 {")
    strs_push(l, "        return Result[Strs, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "    }")
    strs_push(l, "    let names = strs_new();")
    strs_push(l, "    let buf = bytes_new(1024);")
    strs_push(l, "    let mut n = os_dir_next(d, buf);")
    strs_push(l, "    while n > 0 {")
    strs_push(l, "        strs_push(names, bytes_to_str(bytes_slice(buf, 0, n)));")
    strs_push(l, "        n = os_dir_next(d, buf);")
    strs_push(l, "    }")
    strs_push(l, "    os_close(d);")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        return Result[Strs, IoError].Err(error: io_context(io_error_from(n), path));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Strs, IoError].Ok(value: sorted(names))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every regular file, directory and symbolic link under the directory `dir`, at any depth, as")
    strs_push(l, "/// `dir` joined to its path below it with `/`, sorted by their bytes; never `dir` itself. An entry")
    strs_push(l, "/// that is none of them (a socket, a device) is left out, as is one gone between being listed and")
    strs_push(l, "/// being looked at. A symbolic link is listed and never followed (R1d, `os_lstat`): a link to a")
    strs_push(l, "/// directory is not walked into, and a dangling or looping link is listed like any other.")
    strs_push(l, "pub fn file_walk(io: IoCap, dir: Str) -> Result[Strs, IoError] ! { io } {")
    strs_push(l, "    let found = strs_new();")
    strs_push(l, "    let base = if str_len(dir) > 0 && str_byte(dir, str_len(dir) - 1) == 47 { str_slice(dir, 0, str_len(dir) - 1) } else { dir };")
    strs_push(l, "    walk_into(io, base, found)?;")
    strs_push(l, "    Result[Strs, IoError].Ok(value: sorted_all(found))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn walk_into(io: IoCap, dir: Str, found: Strs) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let names = dir_list(io, dir)?;")
    strs_push(l, "    let out = bytes_new(48);")
    strs_push(l, "    for name in names {")
    strs_push(l, "        let path = f\"{dir}/{name}\";")
    strs_push(l, "        let s = os_lstat(path, out);")
    strs_push(l, "        if s < 0 {")
    strs_push(l, "            if io_kind_of(s) != IoErrorKind.NotFound() {")
    strs_push(l, "                return Result[Int, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "            }")
    strs_push(l, "        } else {")
    strs_push(l, "            let kind = bytes_read_le[Int](out, 8);")
    strs_push(l, "            if kind == 0 || kind == 3 {")
    strs_push(l, "                strs_push(found, path);")
    strs_push(l, "            }")
    strs_push(l, "            if kind == 1 {")
    strs_push(l, "                strs_push(found, path);")
    strs_push(l, "                walk_into(io, path, found)?;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A merge sort by bytes, for a walk's many paths.")
    strs_push(l, "fn sorted_all(xs: Strs) -> Strs ! {} {")
    strs_push(l, "    let mut from = xs;")
    strs_push(l, "    let mut to = strs_new();")
    strs_push(l, "    let n = strs_len(xs);")
    strs_push(l, "    for i in 0..n {")
    strs_push(l, "        strs_push(to, strs_get(xs, i));")
    strs_push(l, "    }")
    strs_push(l, "    let mut width = 1;")
    strs_push(l, "    while width < n {")
    strs_push(l, "        let mut lo = 0;")
    strs_push(l, "        while lo < n {")
    strs_push(l, "            let mid = if lo + width < n { lo + width } else { n };")
    strs_push(l, "            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };")
    strs_push(l, "            let mut i = lo;")
    strs_push(l, "            let mut j = mid;")
    strs_push(l, "            for k in lo..hi {")
    strs_push(l, "                if i < mid && (j >= hi || !before(strs_get(from, j), strs_get(from, i))) {")
    strs_push(l, "                    strs_set(to, k, strs_get(from, i));")
    strs_push(l, "                    i = i + 1;")
    strs_push(l, "                } else {")
    strs_push(l, "                    strs_set(to, k, strs_get(from, j));")
    strs_push(l, "                    j = j + 1;")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            lo = hi;")
    strs_push(l, "        }")
    strs_push(l, "        let t = from;")
    strs_push(l, "        from = to;")
    strs_push(l, "        to = t;")
    strs_push(l, "        width = 2 * width;")
    strs_push(l, "    }")
    strs_push(l, "    from")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// An insertion sort by bytes: a directory is listed once, and `@std/sort` is not imported so")
    strs_push(l, "// this module stays importable where that one is refused.")
    strs_push(l, "fn sorted(xs: Strs) -> Strs ! {} {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(xs) {")
    strs_push(l, "        let x = strs_get(xs, i);")
    strs_push(l, "        strs_push(out, x);")
    strs_push(l, "        let mut j = strs_len(out) - 1;")
    strs_push(l, "        while j > 0 && before(x, strs_get(out, j - 1)) {")
    strs_push(l, "            strs_set(out, j, strs_get(out, j - 1));")
    strs_push(l, "            j = j - 1;")
    strs_push(l, "        }")
    strs_push(l, "        strs_set(out, j, x);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn before(a: Str, b: Str) -> Bool ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(a) && i < str_len(b) {")
    strs_push(l, "        if str_byte(a, i) != str_byte(b, i) {")
    strs_push(l, "            return str_byte(a, i) < str_byte(b, i);")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_len(a) < str_len(b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A directory at `path`; its parent must exist.")
    strs_push(l, "pub fn dir_create(io: IoCap, path: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_mkdir(path))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A directory at `path` and every missing parent; nothing if it is already one.")
    strs_push(l, "pub fn dir_create_all(io: IoCap, path: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let mut i = 1;")
    strs_push(l, "    while i <= str_len(path) {")
    strs_push(l, "        if i == str_len(path) || str_byte(path, i) == 47 {")
    strs_push(l, "            let prefix = str_slice(path, 0, i);")
    strs_push(l, "            let s = os_mkdir(prefix);")
    strs_push(l, "            if s < 0 && io_kind_of(s) != IoErrorKind.AlreadyExists() {")
    strs_push(l, "                return Result[Int, IoError].Err(error: io_context(io_error_from(s), prefix));")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let out = bytes_new(32);")
    strs_push(l, "    let s = os_stat(path, out);")
    strs_push(l, "    if s < 0 {")
    strs_push(l, "        return Result[Int, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "    }")
    strs_push(l, "    if bytes_read_le[Int](out, 8) != 1 {")
    strs_push(l, "        return Result[Int, IoError].Err(error: io_context(io_error_new(IoErrorKind.NotADirectory(), \"not a directory\"), path));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Remove the empty directory at `path`.")
    strs_push(l, "pub fn dir_remove(io: IoCap, path: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_rmdir(path))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Remove the file at `path`.")
    strs_push(l, "pub fn file_remove(io: IoCap, path: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_unlink(path))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give `from` the name `to`, replacing what `to` named on the same file system.")
    strs_push(l, "pub fn file_rename(io: IoCap, from: Str, to: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_rename(from, to))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A new file beside `path`, under the first name of the form `PATH.nazm-replace-N` that is free.")
    strs_push(l, "struct Temp {")
    strs_push(l, "    file: File,")
    strs_push(l, "    name: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn create_temp(io: IoCap, path: Str) -> Result[Temp, IoError] ! { io } {")
    strs_push(l, "    let mut attempt = 0;")
    strs_push(l, "    while true {")
    strs_push(l, "        let name = str_concat(path, str_concat(\".nazm-replace-\", int_to_str(attempt)));")
    strs_push(l, "        let h = os_open_write(name, 2);")
    strs_push(l, "        let s = os_status(h);")
    strs_push(l, "        if s == 0 {")
    strs_push(l, "            return Result[Temp, IoError].Ok(value: Temp(file: File(handle: h), name: name));")
    strs_push(l, "        }")
    strs_push(l, "        if io_kind_of(s) != IoErrorKind.AlreadyExists() {")
    strs_push(l, "            return Result[Temp, IoError].Err(error: io_context(io_error_from(s), name));")
    strs_push(l, "        }")
    strs_push(l, "        attempt = attempt + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Temp, IoError].Err(error: io_error_new(IoErrorKind.Other(), \"no temporary name was free\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Replace the file at `path` with `data` so that a reader sees either the old file or the new")
    strs_push(l, "/// one, never part of either: a new file beside it, written, put on storage, then renamed over")
    strs_push(l, "/// it — which POSIX makes atomic on one file system.")
    strs_push(l, "pub fn file_replace_atomic(io: IoCap, path: Str, data: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let t = create_temp(io, path)?;")
    strs_push(l, "    let written = file_write(t.file, data);")
    strs_push(l, "    let synced = io_result(os_sync(t.file.handle));")
    strs_push(l, "    os_close(t.file.handle);")
    strs_push(l, "    let failed = match written {")
    strs_push(l, "        Result.Err(error: e) => Option[IoError].Some(value: e),")
    strs_push(l, "        Result.Ok(value: n) => match synced {")
    strs_push(l, "            Result.Err(error: e) => Option[IoError].Some(value: e),")
    strs_push(l, "            Result.Ok(value: z) => Option[IoError].None(),")
    strs_push(l, "        },")
    strs_push(l, "    };")
    strs_push(l, "    match failed {")
    strs_push(l, "        Option.Some(value: e) => {")
    strs_push(l, "            os_unlink(t.name);")
    strs_push(l, "            Result[Int, IoError].Err(error: io_context(e, t.name))")
    strs_push(l, "        },")
    strs_push(l, "        Option.None() => {")
    strs_push(l, "            let r = os_rename(t.name, path);")
    strs_push(l, "            if r < 0 {")
    strs_push(l, "                os_unlink(t.name);")
    strs_push(l, "                return Result[Int, IoError].Err(error: io_context(io_error_from(r), path));")
    strs_push(l, "            }")
    strs_push(l, "            Result[Int, IoError].Ok(value: bytes_len(data))")
    strs_push(l, "        },")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// R1d (`docs/user/spec.md`, *The platform, further*): standard output and errors as files, what a path")
    strs_push(l, "// itself is, permissions, canonical paths, temporary directories and locks.")
    strs_push(l, "")
    strs_push(l, "/// Standard output as a `File`: raw bytes, in order with `print`. Closing it closes the handle and")
    strs_push(l, "/// not the stream.")
    strs_push(l, "pub fn file_stdout(io: IoCap) -> File ! { io } {")
    strs_push(l, "    File(handle: os_stdout())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Standard errors as a `File`, likewise.")
    strs_push(l, "pub fn file_stderr(io: IoCap) -> File ! { io } {")
    strs_push(l, "    File(handle: os_stderr())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn entry_kind(k: Int) -> EntryKind ! {} {")
    strs_push(l, "    if k == 0 { return EntryKind.Regular(); }")
    strs_push(l, "    if k == 1 { return EntryKind.Directory(); }")
    strs_push(l, "    if k == 3 { return EntryKind.Symlink(); }")
    strs_push(l, "    EntryKind.Other()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `path` itself is: a symbolic link is reported as one, never followed.")
    strs_push(l, "pub fn file_symlink_metadata(io: IoCap, path: Str) -> Result[LinkMetadata, IoError] ! { io } {")
    strs_push(l, "    let out = bytes_new(48);")
    strs_push(l, "    let s = os_lstat(path, out);")
    strs_push(l, "    if s < 0 {")
    strs_push(l, "        return Result[LinkMetadata, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "    }")
    strs_push(l, "    Result[LinkMetadata, IoError].Ok(value: LinkMetadata(size: bytes_read_le[Int](out, 0), kind: entry_kind(bytes_read_le[Int](out, 8)), modified_ns: bytes_read_le[Int](out, 16), permissions: bytes_read_le[Int](out, 24), device: bytes_read_le[Int](out, 32), inode: bytes_read_le[Int](out, 40)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Make `path`'s permission bits `mode` (`0` to `0o7777`), following a symbolic link.")
    strs_push(l, "pub fn file_set_permissions(io: IoCap, path: Str, mode: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let s = os_chmod(path, mode);")
    strs_push(l, "    if s < 0 {")
    strs_push(l, "        return Result[Int, IoError].Err(error: io_context(io_error_from(s), path));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The absolute path `path` names, every `.`, `..` and symbolic link resolved; it must exist.")
    strs_push(l, "pub fn file_canonical(io: IoCap, path: Str) -> Result[Str, IoError] ! { io } {")
    strs_push(l, "    let mut room = 1024;")
    strs_push(l, "    while room <= 1048576 {")
    strs_push(l, "        let out = bytes_new(room);")
    strs_push(l, "        let n = os_realpath(path, out);")
    strs_push(l, "        if n >= 0 {")
    strs_push(l, "            return Result[Str, IoError].Ok(value: bytes_to_str(bytes_slice(out, 0, n)));")
    strs_push(l, "        }")
    strs_push(l, "        if io_kind_of(n) != IoErrorKind.InvalidInput() {")
    strs_push(l, "            return Result[Str, IoError].Err(error: io_context(io_error_from(n), path));")
    strs_push(l, "        }")
    strs_push(l, "        room = room * 4;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Str, IoError].Err(error: io_context(io_error_new(IoErrorKind.InvalidInput(), \"the canonical path is too long\"), path))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new, empty directory in `parent` that only this call made, named `nazm-` and twelve random")
    strs_push(l, "/// letters and digits, readable and writable by its owner only: its path, as clean as `parent` is,")
    strs_push(l, "/// so files may be written under it. Nothing removes it. When none could be made — `parent` missing,")
    strs_push(l, "/// not a directory or not writable — the error is of kind `Other`: asking the system why would make")
    strs_push(l, "/// the path the file system's, which a program may not write under (`N0372`).")
    strs_push(l, "pub fn dir_create_temp(io: IoCap, parent: Str) -> Result[Str, IoError] ! { io } {")
    strs_push(l, "    let made = os_mkdtemp(parent);")
    strs_push(l, "    if str_len(made) == 0 {")
    strs_push(l, "        return Result[Str, IoError].Err(error: io_context(io_error_new(IoErrorKind.Other(), \"no temporary directory could be made here\"), parent));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Str, IoError].Ok(value: made)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take an advisory lock on the whole of `f`, exclusive or shared, waiting until it can be had. A")
    strs_push(l, "/// lock belongs to the open file: another open of the same path is another holder, and closing `f`")
    strs_push(l, "/// lets the lock go.")
    strs_push(l, "pub fn file_lock(f: File, exclusive: Bool) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_lock(f.handle, exclusive))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take the lock without waiting: `false` while another holds it.")
    strs_push(l, "pub fn file_try_lock(f: File, exclusive: Bool) -> Result[Bool, IoError] ! { io } {")
    strs_push(l, "    let s = os_try_lock(f.handle, exclusive);")
    strs_push(l, "    if s == 0 {")
    strs_push(l, "        return Result[Bool, IoError].Ok(value: true);")
    strs_push(l, "    }")
    strs_push(l, "    if io_kind_of(s) == IoErrorKind.WouldBlock() {")
    strs_push(l, "        return Result[Bool, IoError].Ok(value: false);")
    strs_push(l, "    }")
    strs_push(l, "    Result[Bool, IoError].Err(error: io_error_from(s))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Let `f`'s lock go.")
    strs_push(l, "pub fn file_unlock(f: File) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_unlock(f.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// R1.5, 3.5: the lines of a file, read a chunk at a time.")
    strs_push(l, "")
    strs_push(l, "/// The lines of the file at `path`, exactly as `text_lines(read_file(path))` gives them — each")
    strs_push(l, "/// without its newline or one carriage return before it, a last line without a newline still a")
    strs_push(l, "/// line — and failing as `read_file` does (`N0407`). In `for line in file_lines(io, path)` the")
    strs_push(l, "/// file is read 64 KiB at a time through `file_lines_open`, `file_lines_next` and")
    strs_push(l, "/// `file_lines_line`, and no list is made, so memory holds a chunk and a line, not the file.")
    strs_push(l, "pub fn file_lines(io: IoCap, path: Str) -> Strs ! { io } {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let r = file_lines_open(io, path);")
    strs_push(l, "    while file_lines_next(r) {")
    strs_push(l, "        strs_push(out, file_lines_line(r));")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A reader of the lines of the file at `path`, before its first line. A file that cannot be")
    strs_push(l, "/// read fails here, as `read_file(path)` would.")
    strs_push(l, "pub fn file_lines_open(io: IoCap, path: Str) -> LineReader ! { io } {")
    strs_push(l, "    let h = os_open_read(path);")
    strs_push(l, "    if os_status(h) != 0 { read_file(path); }")
    strs_push(l, "    let text = strs_new();")
    strs_push(l, "    strs_push(text, \"\");")
    strs_push(l, "    strs_push(text, \"\");")
    strs_push(l, "    let at = ints_new();")
    strs_push(l, "    ints_push(at, 0);")
    strs_push(l, "    ints_push(at, 0);")
    strs_push(l, "    ints_push(at, 0);")
    strs_push(l, "    LineReader(io: io, path: path, handle: h, chunk: bytes_new(65536), text: text, at: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `r` has another line, moving to it: `file_lines_line(r)` is then that line. A read that")
    strs_push(l, "/// fails part way fails as `read_file(path)` would.")
    strs_push(l, "pub fn file_lines_next(r: LineReader) -> Bool ! { io } {")
    strs_push(l, "    let mut s = strs_get(r.text, 0);")
    strs_push(l, "    let mut start = ints_get(r.at, 0);")
    strs_push(l, "    let mut i = ints_get(r.at, 1);")
    strs_push(l, "    while true {")
    strs_push(l, "        let m = str_len(s);")
    strs_push(l, "        while i < m && str_byte(s, i) != 10 { i = i + 1; }")
    strs_push(l, "        if i < m {")
    strs_push(l, "            strs_set(r.text, 1, line_end(s, start, i));")
    strs_push(l, "            ints_set(r.at, 0, i + 1);")
    strs_push(l, "            ints_set(r.at, 1, i + 1);")
    strs_push(l, "            return true;")
    strs_push(l, "        }")
    strs_push(l, "        if ints_get(r.at, 2) != 0 {")
    strs_push(l, "            if start < m {")
    strs_push(l, "                strs_set(r.text, 1, line_end(s, start, m));")
    strs_push(l, "                ints_set(r.at, 0, m);")
    strs_push(l, "                ints_set(r.at, 1, m);")
    strs_push(l, "                return true;")
    strs_push(l, "            }")
    strs_push(l, "            return false;")
    strs_push(l, "        }")
    strs_push(l, "        let n = os_read(r.handle, r.chunk);")
    strs_push(l, "        if n <= 0 {")
    strs_push(l, "            ints_set(r.at, 2, 1);")
    strs_push(l, "            os_close(r.handle);")
    strs_push(l, "            if n < 0 {")
    strs_push(l, "                let io = r.io;")
    strs_push(l, "                read_file(r.path);")
    strs_push(l, "            }")
    strs_push(l, "        } else {")
    strs_push(l, "            s = str_concat(str_slice(s, start, m), bytes_to_str(bytes_slice(r.chunk, 0, n)));")
    strs_push(l, "            i = m - start;")
    strs_push(l, "            start = 0;")
    strs_push(l, "            strs_set(r.text, 0, s);")
    strs_push(l, "            ints_set(r.at, 0, 0);")
    strs_push(l, "            ints_set(r.at, 1, i);")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    false")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The line `file_lines_next` moved to.")
    strs_push(l, "pub fn file_lines_line(r: LineReader) -> Str ! {} {")
    strs_push(l, "    strs_get(r.text, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `r`'s file, if its lines have not all been read: what a `for` over `file_lines` does")
    strs_push(l, "/// when it is left before the end, by `break`. Answers 0.")
    strs_push(l, "pub fn file_lines_close(r: LineReader) -> Int ! { io } {")
    strs_push(l, "    if ints_get(r.at, 2) == 0 {")
    strs_push(l, "        ints_set(r.at, 2, 1);")
    strs_push(l, "        strs_set(r.text, 0, \"\");")
    strs_push(l, "        ints_set(r.at, 0, 0);")
    strs_push(l, "        ints_set(r.at, 1, 0);")
    strs_push(l, "        os_close(r.handle);")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` from `start` to `end`, without one `\\r` before `end`, as `text_lines` cuts a line.")
    strs_push(l, "fn line_end(s: Str, start: Int, end: Int) -> Str ! {} {")
    strs_push(l, "    if end > start && str_byte(s, end - 1) == 13 { str_slice(s, start, end - 1) } else { str_slice(s, start, end) }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_fmt() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/fmt`: turning values into text for people to read.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/fmt\";`. Every function is pure and total. Decimal text for an `Int`")
    strs_push(l, "// is the built-in `int_to_str`; these add widths, other bases and lists.")
    strs_push(l, "")
    strs_push(l, "/// `n` in decimal, padded on the left with `0`s to at least `width` bytes after any `-` sign.")
    strs_push(l, "pub fn fmt_int_zero(n: Int, width: Int) -> Str ! {} {")
    strs_push(l, "    let digits = if n < 0 { str_slice(int_to_str(n), 1, str_len(int_to_str(n))) } else { int_to_str(n) };")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    if n < 0 { strs_push(parts, \"-\"); }")
    strs_push(l, "    let mut short = width - str_len(digits);")
    strs_push(l, "    while short > 0 { strs_push(parts, \"0\"); short = short - 1; }")
    strs_push(l, "    strs_push(parts, digits);")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `n` in decimal, padded on the left with spaces to at least `width` bytes.")
    strs_push(l, "pub fn fmt_int_width(n: Int, width: Int) -> Str ! {} {")
    strs_push(l, "    let s = int_to_str(n);")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut short = width - str_len(s);")
    strs_push(l, "    while short > 0 { strs_push(parts, \" \"); short = short - 1; }")
    strs_push(l, "    strs_push(parts, s);")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `n` in lower-case hexadecimal, without a prefix; a negative `n` is its two's-complement")
    strs_push(l, "/// 64-bit pattern, so `-1` is `ffffffffffffffff`.")
    strs_push(l, "pub fn fmt_hex(n: Int) -> Str ! {} {")
    strs_push(l, "    let digits = \"0123456789abcdef\";")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut nibbles = 0;")
    strs_push(l, "    let mut v = n;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        // The low four bits, computed without division so a negative pattern stays exact.")
    strs_push(l, "        let low = v - (v / 16) * 16;")
    strs_push(l, "        let d = if low < 0 { low + 16 } else { low };")
    strs_push(l, "        strs_push(parts, str_slice(digits, d, d + 1));")
    strs_push(l, "        v = (v - d) / 16;")
    strs_push(l, "        nibbles = nibbles + 1;")
    strs_push(l, "        if nibbles == 16 { more = false; } else { if v == 0 { more = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = strs_len(parts);")
    strs_push(l, "    while i > 0 { i = i - 1; strs_push(out, strs_get(parts, i)); }")
    strs_push(l, "    str_join(out, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `true` or `false`.")
    strs_push(l, "pub fn fmt_bool(b: Bool) -> Str ! {} {")
    strs_push(l, "    if b { \"true\" } else { \"false\" }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `items` joined by `sep` between `open` and `close`: `fmt_list(xs, \", \", \"[\", \"]\")`.")
    strs_push(l, "pub fn fmt_list(items: Strs, sep: Str, open: Str, close: Str) -> Str ! {} {")
    strs_push(l, "    str_concat(str_concat(open, str_join(items, sep)), close)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The decimal text of every element of `xs`, joined by `sep`.")
    strs_push(l, "pub fn fmt_ints(xs: Ints, sep: Str) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < ints_len(xs) { strs_push(parts, int_to_str(ints_get(xs, i))); i = i + 1; }")
    strs_push(l, "    str_join(parts, sep)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_fs() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/fs`: files, read and written as text, each failure a value.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/fs\";`. Every function needs an `IoCap` and says so. What a function")
    strs_push(l, "// here reads carries the built-ins' origins — a file's contents are `file` — because these are")
    strs_push(l, "// ordinary calls the checker follows. A file that exists and still cannot be read is")
    strs_push(l, "// `read_file`'s failure, `N0407`: the check and the read are two steps.")
    strs_push(l, "")
    strs_push(l, "use \"@std/text\";")
    strs_push(l, "")
    strs_push(l, "/// Whether a readable file is at `path`.")
    strs_push(l, "pub fn fs_exists(io: IoCap, path: Str) -> Bool ! { io } {")
    strs_push(l, "    file_exists(path)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The contents of the file at `path`, or an `Err` naming it when there is none.")
    strs_push(l, "pub fn fs_read(io: IoCap, path: Str) -> Result[Str, Str] ! { io } {")
    strs_push(l, "    if file_exists(path) {")
    strs_push(l, "        Result[Str, Str].Ok(value: read_file(path))")
    strs_push(l, "    } else {")
    strs_push(l, "        Result[Str, Str].Err(error: str_concat(\"no such file: \", path))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The lines of the file at `path`, as `text_lines` splits them, or an `Err`.")
    strs_push(l, "pub fn fs_read_lines(io: IoCap, path: Str) -> Result[Strs, Str] ! { io } {")
    strs_push(l, "    match fs_read(io, path) {")
    strs_push(l, "        Result.Ok(value: text) => Result[Strs, Str].Ok(value: text_lines(text)),")
    strs_push(l, "        Result.Err(error: e) => Result[Strs, Str].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Write `text` to the file at `path`, replacing it; the bytes written, or an `Err` naming the")
    strs_push(l, "/// path when it could not be written.")
    strs_push(l, "pub fn fs_write(io: IoCap, path: Str, text: Str) -> Result[Int, Str] ! { io } {")
    strs_push(l, "    let n = write_file(path, text);")
    strs_push(l, "    if n < 0 { Result[Int, Str].Err(error: str_concat(\"cannot write: \", path)) } else { Result[Int, Str].Ok(value: n) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Write `lines` to the file at `path`, each followed by a newline.")
    strs_push(l, "pub fn fs_write_lines(io: IoCap, path: Str, lines: Strs) -> Result[Int, Str] ! { io } {")
    strs_push(l, "    let nl = str_from_byte(10);")
    strs_push(l, "    let body = if strs_len(lines) == 0 { \"\" } else { str_concat(str_join(lines, nl), nl) };")
    strs_push(l, "    fs_write(io, path, body)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new directory that only this call made, readable and writable by its owner only, under")
    strs_push(l, "/// `TMPDIR` — or `/tmp` where that is unset or empty (R1d): its path, or an `Err` saying why.")
    strs_push(l, "/// Nothing removes it.")
    strs_push(l, "pub fn fs_temp_dir(io: IoCap) -> Result[Str, Str] ! { io } {")
    strs_push(l, "    let given = os_env_get(\"TMPDIR\");")
    strs_push(l, "    let parent = if str_len(given) > 0 { given } else { \"/tmp\" };")
    strs_push(l, "    let made = os_mkdtemp(parent);")
    strs_push(l, "    if str_len(made) == 0 {")
    strs_push(l, "        return Result[Str, Str].Err(error: str_concat(\"no temporary directory could be made in \", parent));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Str, Str].Ok(value: made)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_hal() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/hal`: device code against traits, and each board's devices behind them (Gate 3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/hal\";`. A program that drives a UART, a pin or a timer is written")
    strs_push(l, "// against `Uart`, `Pin` and `Timer`, generic over them (`fn blink[P: Pin](p: P, m: MmioCap)`), and")
    strs_push(l, "// a board supplies the impls: the boundary is library-level, made of the traits the language")
    strs_push(l, "// already has (N78), and no device is the language's. Every device method takes an `MmioCap`, so")
    strs_push(l, "// the authority to touch a register is held where it is used, as `mmio_*` asks; a timer reads")
    strs_push(l, "// a tick count, which is the program's own memory. `docs/internal/systems-domains.md` Part C.")
    strs_push(l, "//")
    strs_push(l, "// The impls are the emulated boards' devices: the PL011, NS16550A and CMSDK UARTs, the PL061 GPIO")
    strs_push(l, "// of QEMU's AArch64 `virt` machine, and the MPS2's FPGA LED register, the Cortex-M board's one")
    strs_push(l, "// output that its emulator models. None has run on hardware.")
    strs_push(l, "")
    strs_push(l, "/// A serial port's transmitter: one byte out.")
    strs_push(l, "pub trait Uart {")
    strs_push(l, "    fn put(self: Self, m: MmioCap, byte: Int) -> Int ! {};")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One digital line: driven high or low, and read back.")
    strs_push(l, "pub trait Pin {")
    strs_push(l, "    fn set(self: Self, m: MmioCap, high: Bool) -> Int ! {};")
    strs_push(l, "    fn get(self: Self, m: MmioCap) -> Bool ! {};")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A monotonic count of the board timer's ticks.")
    strs_push(l, "pub trait Timer {")
    strs_push(l, "    fn ticks(self: Self) -> Int ! {};")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An Arm PL011's data register, at `base`.")
    strs_push(l, "pub struct Pl011 {")
    strs_push(l, "    base: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A 16550-compatible UART's transmit register, at `base`.")
    strs_push(l, "pub struct Ns16550 {")
    strs_push(l, "    base: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Arm's CMSDK APB UART, at `base`: the board's runtime enables its transmitter before `main`.")
    strs_push(l, "pub struct CmsdkUart {")
    strs_push(l, "    base: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Uart for Pl011 {")
    strs_push(l, "    fn put(self: Pl011, m: MmioCap, byte: Int) -> Int ! {} {")
    strs_push(l, "        mmio_write8(self.base, byte)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Uart for Ns16550 {")
    strs_push(l, "    fn put(self: Ns16550, m: MmioCap, byte: Int) -> Int ! {} {")
    strs_push(l, "        mmio_write8(self.base, byte)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Uart for CmsdkUart {")
    strs_push(l, "    fn put(self: CmsdkUart, m: MmioCap, byte: Int) -> Int ! {} {")
    strs_push(l, "        mmio_write8(self.base, byte)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every byte of `s` out of `u`, in order; how many.")
    strs_push(l, "pub fn uart_write[U: Uart](u: U, m: MmioCap, s: Str) -> Int ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        u.put(m, str_byte(s, i));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    i")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Line `line` (0–7) of an Arm PL061 at `base`. A PL061 masks each access by its address: bit")
    strs_push(l, "/// `line` of the data is reached at `base + (4 << line)`, and no other line is touched.")
    strs_push(l, "pub struct Pl061 {")
    strs_push(l, "    base: Int,")
    strs_push(l, "    line: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `p`'s line made an output: its bit set in the direction register, the others left as they are.")
    strs_push(l, "pub fn pl061_output(p: Pl061, m: MmioCap) -> Int ! {} {")
    strs_push(l, "    let dir = p.base + 1024;")
    strs_push(l, "    mmio_write32(dir, mmio_read32(dir) | (1 << p.line))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Pin for Pl061 {")
    strs_push(l, "    fn set(self: Pl061, m: MmioCap, high: Bool) -> Int ! {} {")
    strs_push(l, "        mmio_write32(self.base + (4 << self.line), if high { 1 << self.line } else { 0 })")
    strs_push(l, "    }")
    strs_push(l, "")
    strs_push(l, "    fn get(self: Pl061, m: MmioCap) -> Bool ! {} {")
    strs_push(l, "        mmio_read32(self.base + (4 << self.line)) != 0")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bit `bit` of the MPS2's FPGA LED register at `base`: written by reading the register and")
    strs_push(l, "/// changing that bit alone, read back from it.")
    strs_push(l, "pub struct FpgaLed {")
    strs_push(l, "    base: Int,")
    strs_push(l, "    bit: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Pin for FpgaLed {")
    strs_push(l, "    fn set(self: FpgaLed, m: MmioCap, high: Bool) -> Int ! {} {")
    strs_push(l, "        let now = mmio_read32(self.base);")
    strs_push(l, "        let mask = 1 << self.bit;")
    strs_push(l, "        mmio_write32(self.base, if high { now | mask } else { now & (4294967295 ^ mask) })")
    strs_push(l, "    }")
    strs_push(l, "")
    strs_push(l, "    fn get(self: FpgaLed, m: MmioCap) -> Bool ! {} {")
    strs_push(l, "        (mmio_read32(self.base) & (1 << self.bit)) != 0")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A tick count held in an atomic: the board timer's `@interrupt(\"timer\")` handler advances it")
    strs_push(l, "/// (`ticks_advance`), and every other function reads it (`Timer`).")
    strs_push(l, "pub struct Ticks {")
    strs_push(l, "    count: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Timer for Ticks {")
    strs_push(l, "    fn ticks(self: Ticks) -> Int ! {} {")
    strs_push(l, "        atomic_load(self.count)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One more tick of `t`; the count before.")
    strs_push(l, "pub fn ticks_advance(t: Ticks) -> Int ! {} {")
    strs_push(l, "    atomic_add(t.count, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Until `t` has counted `n` more ticks than it had: the ticks it counted.")
    strs_push(l, "pub fn wait_ticks[T: Timer](t: T, n: Int) -> Int ! {} {")
    strs_push(l, "    let start = t.ticks();")
    strs_push(l, "    while t.ticks() - start < n {")
    strs_push(l, "        0;")
    strs_push(l, "    }")
    strs_push(l, "    t.ticks() - start")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_hash() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/hash`: what makes a value a key — a hash and a way to compare two (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/hash\";`. `Hash` is an ordinary trait: the library implements it for")
    strs_push(l, "// every integer type, `Bool` and `Str`, and a program implements it for its own key types, two")
    strs_push(l, "// methods each. `hash` is a fixed function — 64-bit FNV-1a over a value's bytes, mixed by")
    strs_push(l, "// SplitMix64's finaliser — so it is the same in every implementation and every run, and a map's")
    strs_push(l, "// order is reproducible. A map facing keys an adversary chooses takes a seed. Floats are not")
    strs_push(l, "// keys: NaN is not equal to itself. `docs/internal/general-purpose.md` §7 is the design record.")
    strs_push(l, "")
    strs_push(l, "/// A key: a hash, and whether two are the same key. Two keys that are `same` must hash alike.")
    strs_push(l, "pub trait Hash {")
    strs_push(l, "    fn hash(self: Self) -> UInt64 ! {};")
    strs_push(l, "    fn same(self: Self, other: Self) -> Bool ! {};")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "const FNV_OFFSET: UInt64 = 14695981039346656037;")
    strs_push(l, "const FNV_PRIME: UInt64 = 1099511628211;")
    strs_push(l, "")
    strs_push(l, "/// SplitMix64's finaliser: every input bit reaches every output bit.")
    strs_push(l, "pub fn hash_finish(x: UInt64) -> UInt64 ! {} {")
    strs_push(l, "    let a = wrapping_mul(x ^ (x >> 30), UInt64(0xBF58476D1CE4E5B9));")
    strs_push(l, "    let b = wrapping_mul(a ^ (a >> 27), UInt64(0x94D049BB133111EB));")
    strs_push(l, "    b ^ (b >> 31)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The hash of a string's bytes.")
    strs_push(l, "pub fn hash_bytes(s: Str) -> UInt64 ! {} {")
    strs_push(l, "    let mut h = FNV_OFFSET;")
    strs_push(l, "    let n = str_len(s);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        h = wrapping_mul(h ^ UInt64(str_byte(s, i)), FNV_PRIME);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    hash_finish(h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The hash of a 64-bit word's bytes, least significant first.")
    strs_push(l, "pub fn hash_u64(x: UInt64) -> UInt64 ! {} {")
    strs_push(l, "    let mut h = FNV_OFFSET;")
    strs_push(l, "    let mut w = x;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 8 {")
    strs_push(l, "        h = wrapping_mul(h ^ (w & UInt64(255)), FNV_PRIME);")
    strs_push(l, "        w = w >> 8;")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    hash_finish(h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Two hashes as one, in order: for a key made of parts.")
    strs_push(l, "pub fn hash_combine(a: UInt64, b: UInt64) -> UInt64 ! {} {")
    strs_push(l, "    hash_finish(wrapping_add(wrapping_mul(a, FNV_PRIME), b))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Int {")
    strs_push(l, "    fn hash(self: Int) -> UInt64 ! {} { hash_u64(wrap_convert[UInt64](self)) }")
    strs_push(l, "    fn same(self: Int, other: Int) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Int8 {")
    strs_push(l, "    fn hash(self: Int8) -> UInt64 ! {} { hash_u64(wrap_convert[UInt64](self)) }")
    strs_push(l, "    fn same(self: Int8, other: Int8) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Int16 {")
    strs_push(l, "    fn hash(self: Int16) -> UInt64 ! {} { hash_u64(wrap_convert[UInt64](self)) }")
    strs_push(l, "    fn same(self: Int16, other: Int16) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Int32 {")
    strs_push(l, "    fn hash(self: Int32) -> UInt64 ! {} { hash_u64(wrap_convert[UInt64](self)) }")
    strs_push(l, "    fn same(self: Int32, other: Int32) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for UInt8 {")
    strs_push(l, "    fn hash(self: UInt8) -> UInt64 ! {} { hash_u64(UInt64(self)) }")
    strs_push(l, "    fn same(self: UInt8, other: UInt8) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for UInt16 {")
    strs_push(l, "    fn hash(self: UInt16) -> UInt64 ! {} { hash_u64(UInt64(self)) }")
    strs_push(l, "    fn same(self: UInt16, other: UInt16) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for UInt32 {")
    strs_push(l, "    fn hash(self: UInt32) -> UInt64 ! {} { hash_u64(UInt64(self)) }")
    strs_push(l, "    fn same(self: UInt32, other: UInt32) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for UInt64 {")
    strs_push(l, "    fn hash(self: UInt64) -> UInt64 ! {} { hash_u64(self) }")
    strs_push(l, "    fn same(self: UInt64, other: UInt64) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A 128-bit integer (R1b, L13b): its low word's hash and its high word's, combined — as the")
    strs_push(l, "// derived hash of one is.")
    strs_push(l, "impl Hash for Int128 {")
    strs_push(l, "    fn hash(self: Int128) -> UInt64 ! {} {")
    strs_push(l, "        hash_combine(hash_u64(wrap_convert[UInt64](self)), hash_u64(wrap_convert[UInt64](self >> 64)))")
    strs_push(l, "    }")
    strs_push(l, "    fn same(self: Int128, other: Int128) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for UInt128 {")
    strs_push(l, "    fn hash(self: UInt128) -> UInt64 ! {} {")
    strs_push(l, "        hash_combine(hash_u64(wrap_convert[UInt64](self)), hash_u64(UInt64(self >> 64)))")
    strs_push(l, "    }")
    strs_push(l, "    fn same(self: UInt128, other: UInt128) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Bool {")
    strs_push(l, "    fn hash(self: Bool) -> UInt64 ! {} { hash_u64(if self { UInt64(1) } else { UInt64(0) }) }")
    strs_push(l, "    fn same(self: Bool, other: Bool) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Hash for Str {")
    strs_push(l, "    fn hash(self: Str) -> UInt64 ! {} { hash_bytes(self) }")
    strs_push(l, "    fn same(self: Str, other: Str) -> Bool ! {} { self == other }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_hashmap() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/hashmap`: a map from `Hash` keys to values, by open addressing (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/hashmap\";` beside `use \"@std/hash\";`. A `HashMap[K, V]` holds its")
    strs_push(l, "// entries in a table it shares like any handle: copies of a map are the same map. A key's slot is")
    strs_push(l, "// found from its hash by linear probing; a removed entry leaves a marker the probe passes over,")
    strs_push(l, "// and the table doubles before it is three-quarters used, so insert, lookup and removal take")
    strs_push(l, "// expected constant time and growth amortised constant time. Iteration is in table order, which")
    strs_push(l, "// the keys, their order of insertion and the seed decide — the same in every run.")
    strs_push(l, "")
    strs_push(l, "use \"@std/hash\";")
    strs_push(l, "use \"@std/ordmap\";")
    strs_push(l, "")
    strs_push(l, "/// One slot of the table as Gate 2 stored it: never used, used and emptied, or holding an entry.")
    strs_push(l, "/// Kept because the 1.0 interface names it; since R1 (5b.9) the table holds positions instead.")
    strs_push(l, "pub enum Slot[K, V] {")
    strs_push(l, "    Empty,")
    strs_push(l, "    Gone,")
    strs_push(l, "    Full(key: K, value: V, hash: UInt64),")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A map from `K` to `V`. The table, `slots`, holds for each slot `-1` (never used), `-2`")
    strs_push(l, "/// (used and emptied) or the position of its entry in `hashes`, `keys` and `values`, which are")
    strs_push(l, "/// dense: a probe compares hashes, and touches a key only when they are equal, and replacing a")
    strs_push(l, "/// value allocates nothing. `meta` holds how many entries there are, how many slots are not")
    strs_push(l, "/// `-1`, and the entry the last look-up of `m[k]` found, or `-1` (R1, 5b.9: `m[k] += n` then")
    strs_push(l, "/// writes without a second probe). The table's length is a power of two.")
    strs_push(l, "pub struct HashMap[K, V] {")
    strs_push(l, "    slots: Vec[Int],")
    strs_push(l, "    hashes: Vec[UInt64],")
    strs_push(l, "    keys: Vec[K],")
    strs_push(l, "    values: Vec[V],")
    strs_push(l, "    meta: Vec[Int],")
    strs_push(l, "    seed: UInt64,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty map, whose order is the same in every run.")
    strs_push(l, "pub fn hashmap_new[K: Hash, V]() -> HashMap[K, V] ! {} {")
    strs_push(l, "    hashmap_with_seed[K, V](UInt64(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A map holding one entry: where a map literal begins (R1.5, D5), since its first entry settles")
    strs_push(l, "/// the key and value types — `{\"a\": 1, \"b\": 2}` is this, then `hashmap_set` for the rest.")
    strs_push(l, "pub fn hashmap_single[K: Hash, V](key: K, value: V) -> HashMap[K, V] ! {} {")
    strs_push(l, "    let m = hashmap_new[K, V]();")
    strs_push(l, "    hashmap_set(m, key, value);")
    strs_push(l, "    m")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty map hashing under `seed`: a seed from a source of randomness makes its order, and")
    strs_push(l, "/// which keys collide, unpredictable to whoever chooses the keys.")
    strs_push(l, "pub fn hashmap_with_seed[K: Hash, V](seed: UInt64) -> HashMap[K, V] ! {} {")
    strs_push(l, "    let slots = vec_new[Int]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 8 {")
    strs_push(l, "        vec_push(slots, 0 - 1);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let meta = vec_new[Int]();")
    strs_push(l, "    vec_push(meta, 0);")
    strs_push(l, "    vec_push(meta, 0);")
    strs_push(l, "    vec_push(meta, 0 - 1);")
    strs_push(l, "    HashMap[K, V](")
    strs_push(l, "        slots: slots,")
    strs_push(l, "        hashes: vec_new[UInt64](),")
    strs_push(l, "        keys: vec_new[K](),")
    strs_push(l, "        values: vec_new[V](),")
    strs_push(l, "        meta: meta,")
    strs_push(l, "        seed: seed,")
    strs_push(l, "    )")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many keys `m` holds.")
    strs_push(l, "pub fn hashmap_len[K: Hash, V](m: HashMap[K, V]) -> Int ! {} {")
    strs_push(l, "    vec_get(m.meta, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn key_hash[K: Hash](seed: UInt64, key: K) -> UInt64 ! {} {")
    strs_push(l, "    hash_combine(seed, key.hash())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Where `key` is: its slot when present, and `-(the slot it would take) - 1` when not.")
    strs_push(l, "fn hashmap_find[K: Hash, V](m: HashMap[K, V], key: K, h: UInt64) -> Int ! {} {")
    strs_push(l, "    // The vectors are read through `m` at each step: a field read borrows, where a local copy")
    strs_push(l, "    // of each would retain it and release it again on every look-up.")
    strs_push(l, "    let mask = vec_len(m.slots) - 1;")
    strs_push(l, "    let mut i = Int(h & UInt64(mask));")
    strs_push(l, "    let mut free = 0 - 1;")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    let mut looking = true;")
    strs_push(l, "    while looking {")
    strs_push(l, "        let e = vec_get(m.slots, i);")
    strs_push(l, "        // A used slot first: the test a look-up that finds its key makes most.")
    strs_push(l, "        if e >= 0 {")
    strs_push(l, "            if vec_get(m.hashes, e) == h && key.same(vec_get(m.keys, e)) {")
    strs_push(l, "                found = i;")
    strs_push(l, "                looking = false;")
    strs_push(l, "            }")
    strs_push(l, "        } else {")
    strs_push(l, "            if free < 0 { free = i; }")
    strs_push(l, "            if e == 0 - 1 { looking = false; }")
    strs_push(l, "        }")
    strs_push(l, "        i = (i + 1) & mask;")
    strs_push(l, "    }")
    strs_push(l, "    if found >= 0 { found } else { 0 - free - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The first never-used slot on `h`'s probe: where an entry goes when the table is rebuilt.")
    strs_push(l, "fn hashmap_free_slot[K, V](m: HashMap[K, V], h: UInt64) -> Int ! {} {")
    strs_push(l, "    let mask = vec_len(m.slots) - 1;")
    strs_push(l, "    let mut i = Int(h & UInt64(mask));")
    strs_push(l, "    while vec_get(m.slots, i) != 0 - 1 {")
    strs_push(l, "        i = (i + 1) & mask;")
    strs_push(l, "    }")
    strs_push(l, "    i")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Twice the slots, every entry placed again in the order of the slots it held.")
    strs_push(l, "fn hashmap_grow[K: Hash, V](m: HashMap[K, V]) -> Int ! {} {")
    strs_push(l, "    let cap = vec_len(m.slots);")
    strs_push(l, "    let order = vec_new[Int]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < cap {")
    strs_push(l, "        let e = vec_get(m.slots, i);")
    strs_push(l, "        if e >= 0 { vec_push(order, e); }")
    strs_push(l, "        vec_set(m.slots, i, 0 - 1);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    while vec_len(m.slots) < cap * 2 {")
    strs_push(l, "        vec_push(m.slots, 0 - 1);")
    strs_push(l, "    }")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while j < vec_len(order) {")
    strs_push(l, "        let e = vec_get(order, j);")
    strs_push(l, "        vec_set(m.slots, hashmap_free_slot(m, vec_get(m.hashes, e)), e);")
    strs_push(l, "        j = j + 1;")
    strs_push(l, "    }")
    strs_push(l, "    vec_set(m.meta, 1, vec_get(m.meta, 0));")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give `key` the value `value` in `m`, replacing any it had; whether one was replaced.")
    strs_push(l, "pub fn hashmap_set[K: Hash, V](m: HashMap[K, V], key: K, value: V) -> Bool ! {} {")
    strs_push(l, "    // The entry `m[key]` just read, written without probing again.")
    strs_push(l, "    let hit = vec_get(m.meta, 2);")
    strs_push(l, "    if hit >= 0 && key.same(vec_get(m.keys, hit)) {")
    strs_push(l, "        vec_set(m.values, hit, value);")
    strs_push(l, "        return true;")
    strs_push(l, "    }")
    strs_push(l, "    if (vec_get(m.meta, 1) + 1) * 4 > vec_len(m.slots) * 3 {")
    strs_push(l, "        hashmap_grow(m);")
    strs_push(l, "    }")
    strs_push(l, "    let h = key_hash(m.seed, key);")
    strs_push(l, "    let at = hashmap_find(m, key, h);")
    strs_push(l, "    if at >= 0 {")
    strs_push(l, "        let e = vec_get(m.slots, at);")
    strs_push(l, "        vec_set(m.keys, e, key);")
    strs_push(l, "        vec_set(m.values, e, value);")
    strs_push(l, "        true")
    strs_push(l, "    } else {")
    strs_push(l, "        let slot = 0 - at - 1;")
    strs_push(l, "        if vec_get(m.slots, slot) == 0 - 1 {")
    strs_push(l, "            vec_set(m.meta, 1, vec_get(m.meta, 1) + 1);")
    strs_push(l, "        }")
    strs_push(l, "        vec_set(m.slots, slot, vec_len(m.keys));")
    strs_push(l, "        vec_push(m.hashes, h);")
    strs_push(l, "        vec_push(m.keys, key);")
    strs_push(l, "        vec_push(m.values, value);")
    strs_push(l, "        vec_set(m.meta, 0, vec_get(m.meta, 0) + 1);")
    strs_push(l, "        false")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, or `None`.")
    strs_push(l, "pub fn hashmap_get[K: Hash, V](m: HashMap[K, V], key: K) -> Option[V] ! {} {")
    strs_push(l, "    let at = hashmap_find(m, key, key_hash(m.seed, key));")
    strs_push(l, "    if at < 0 {")
    strs_push(l, "        Option[V].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        Option[V].Some(value: vec_get(m.values, vec_get(m.slots, at)))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, which it must hold: `m[key]` (R1, 5b.7). Where it holds none")
    strs_push(l, "/// this traps, as an index out of range does.")
    strs_push(l, "pub fn hashmap_at[K: Hash, V](m: HashMap[K, V], key: K) -> V ! {} {")
    strs_push(l, "    let at = hashmap_find(m, key, key_hash(m.seed, key));")
    strs_push(l, "    vec_get(m.values, vec_get(m.slots, at))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, or `fallback`: what `m[key] += n` reads (R1, 5b.7). The entry")
    strs_push(l, "/// found is remembered for the write that follows (5b.9).")
    strs_push(l, "pub fn hashmap_at_or[K: Hash, V](m: HashMap[K, V], key: K, fallback: V) -> V ! {} {")
    strs_push(l, "    let at = hashmap_find(m, key, key_hash(m.seed, key));")
    strs_push(l, "    if at < 0 {")
    strs_push(l, "        fallback")
    strs_push(l, "    } else {")
    strs_push(l, "        let e = vec_get(m.slots, at);")
    strs_push(l, "        vec_set(m.meta, 2, e);")
    strs_push(l, "        vec_get(m.values, e)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `m` holds `key`.")
    strs_push(l, "pub fn hashmap_has[K: Hash, V](m: HashMap[K, V], key: K) -> Bool ! {} {")
    strs_push(l, "    hashmap_find(m, key, key_hash(m.seed, key)) >= 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take `key` out of `m`, with the value it had, or `None` when it had none.")
    strs_push(l, "pub fn hashmap_remove[K: Hash, V](m: HashMap[K, V], key: K) -> Option[V] ! {} {")
    strs_push(l, "    let at = hashmap_find(m, key, key_hash(m.seed, key));")
    strs_push(l, "    if at < 0 {")
    strs_push(l, "        Option[V].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let e = vec_get(m.slots, at);")
    strs_push(l, "        let gone = vec_get(m.values, e);")
    strs_push(l, "        // Entries move below: no remembered entry survives a removal.")
    strs_push(l, "        vec_set(m.meta, 2, 0 - 1);")
    strs_push(l, "        vec_set(m.slots, at, 0 - 2);")
    strs_push(l, "        vec_set(m.meta, 0, vec_get(m.meta, 0) - 1);")
    strs_push(l, "        // The last entry takes the removed one's place, so the arrays stay dense and nothing")
    strs_push(l, "        // removed stays alive.")
    strs_push(l, "        let last = vec_len(m.keys) - 1;")
    strs_push(l, "        if e != last {")
    strs_push(l, "            let mask = vec_len(m.slots) - 1;")
    strs_push(l, "            let mut i = Int(vec_get(m.hashes, last) & UInt64(mask));")
    strs_push(l, "            while vec_get(m.slots, i) != last {")
    strs_push(l, "                i = (i + 1) & mask;")
    strs_push(l, "            }")
    strs_push(l, "            vec_set(m.slots, i, e);")
    strs_push(l, "            vec_set(m.hashes, e, vec_get(m.hashes, last));")
    strs_push(l, "            vec_set(m.keys, e, vec_get(m.keys, last));")
    strs_push(l, "            vec_set(m.values, e, vec_get(m.values, last));")
    strs_push(l, "        }")
    strs_push(l, "        vec_pop(m.hashes);")
    strs_push(l, "        vec_pop(m.keys);")
    strs_push(l, "        vec_pop(m.values);")
    strs_push(l, "        Option[V].Some(value: gone)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every key of `m`, in table order.")
    strs_push(l, "pub fn hashmap_keys[K: Hash, V](m: HashMap[K, V]) -> Vec[K] ! {} {")
    strs_push(l, "    let out = vec_new[K]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(m.slots) {")
    strs_push(l, "        let e = vec_get(m.slots, i);")
    strs_push(l, "        if e >= 0 { vec_push(out, vec_get(m.keys, e)); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value of `m`, in its keys' order.")
    strs_push(l, "pub fn hashmap_values[K: Hash, V](m: HashMap[K, V]) -> Vec[V] ! {} {")
    strs_push(l, "    let out = vec_new[V]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(m.slots) {")
    strs_push(l, "        let e = vec_get(m.slots, i);")
    strs_push(l, "        if e >= 0 { vec_push(out, vec_get(m.values, e)); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The `n` entries of `m` with the largest values, largest first, a tie ordered by key ascending")
    strs_push(l, "/// (R1.5, D10): `counts.top(10)` is a word count's ten most frequent words. Fewer than `n` when")
    strs_push(l, "/// `m` holds fewer; none when `n` is not positive. Keeps the best `n` seen so far, so it takes")
    strs_push(l, "/// time proportional to the map's size times `n`, and allocates only the result.")
    strs_push(l, "pub fn hashmap_top[K: Ord, V: Ord](m: HashMap[K, V], n: Int) -> Vec[(K, V)] ! {} {")
    strs_push(l, "    let best = vec_new[Int]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(m.slots) {")
    strs_push(l, "        let e = vec_get(m.slots, i);")
    strs_push(l, "        if e >= 0 && n > 0 {")
    strs_push(l, "            // `at` is where `e` belongs among the best so far: after every one before it.")
    strs_push(l, "            let mut at = vec_len(best);")
    strs_push(l, "            while at > 0 && top_before(m, e, vec_get(best, at - 1)) { at = at - 1; }")
    strs_push(l, "            if at < n {")
    strs_push(l, "                if vec_len(best) == n { vec_pop(best); }")
    strs_push(l, "                vec_push(best, e);")
    strs_push(l, "                let mut j = vec_len(best) - 1;")
    strs_push(l, "                while j > at { vec_set(best, j, vec_get(best, j - 1)); j = j - 1; }")
    strs_push(l, "                vec_set(best, at, e);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let out = vec_new[(K, V)]();")
    strs_push(l, "    let mut k = 0;")
    strs_push(l, "    while k < vec_len(best) {")
    strs_push(l, "        let e = vec_get(best, k);")
    strs_push(l, "        vec_push(out, (vec_get(m.keys, e), vec_get(m.values, e)));")
    strs_push(l, "        k = k + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Whether entry `a` of `m` comes before entry `b` in `hashmap_top`'s order: a larger value first,")
    strs_push(l, "// and of equal values the smaller key.")
    strs_push(l, "fn top_before[K: Ord, V: Ord](m: HashMap[K, V], a: Int, b: Int) -> Bool ! {} {")
    strs_push(l, "    let c = vec_get(m.values, a).compare(vec_get(m.values, b));")
    strs_push(l, "    c > 0 || (c == 0 && vec_get(m.keys, a).compare(vec_get(m.keys, b)) < 0)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_hashset() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/hashset`: a set of `Hash` keys, over `@std/hashmap` (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/hashset\";` beside `use \"@std/hash\";`. A `HashSet[K]` is a")
    strs_push(l, "// `HashMap[K, Bool]` and shares its costs and its order.")
    strs_push(l, "")
    strs_push(l, "use \"@std/hash\";")
    strs_push(l, "use \"@std/hashmap\";")
    strs_push(l, "")
    strs_push(l, "/// A set of `K`.")
    strs_push(l, "pub struct HashSet[K] {")
    strs_push(l, "    map: HashMap[K, Bool],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty set, whose order is the same in every run.")
    strs_push(l, "pub fn hashset_new[K: Hash]() -> HashSet[K] ! {} {")
    strs_push(l, "    HashSet[K](map: hashmap_new[K, Bool]())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty set hashing under `seed`.")
    strs_push(l, "pub fn hashset_with_seed[K: Hash](seed: UInt64) -> HashSet[K] ! {} {")
    strs_push(l, "    HashSet[K](map: hashmap_with_seed[K, Bool](seed))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Put `key` in `s`; whether it was not there already.")
    strs_push(l, "pub fn hashset_add[K: Hash](s: HashSet[K], key: K) -> Bool ! {} {")
    strs_push(l, "    !hashmap_set(s.map, key, true)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `s` holds `key`.")
    strs_push(l, "pub fn hashset_has[K: Hash](s: HashSet[K], key: K) -> Bool ! {} {")
    strs_push(l, "    hashmap_has(s.map, key)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take `key` out of `s`; whether it was there.")
    strs_push(l, "pub fn hashset_remove[K: Hash](s: HashSet[K], key: K) -> Bool ! {} {")
    strs_push(l, "    match hashmap_remove(s.map, key) {")
    strs_push(l, "        Option.Some(value: v) => true,")
    strs_push(l, "        Option.None() => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many keys `s` holds.")
    strs_push(l, "pub fn hashset_len[K: Hash](s: HashSet[K]) -> Int ! {} {")
    strs_push(l, "    hashmap_len(s.map)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every key of `s`, in table order.")
    strs_push(l, "pub fn hashset_items[K: Hash](s: HashSet[K]) -> Vec[K] ! {} {")
    strs_push(l, "    hashmap_keys(s.map)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_http() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/http`: HTTP/1.1 over TCP, server and client, and a small router (v1 track C, C2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/http\";` beside `use \"@std/ioerror\";` and `use \"@std/net\";`. The wire")
    strs_push(l, "// format is RFC 9112's and the semantics RFC 9110's; `docs/user/spec.md`, *HTTP*, states what is")
    strs_push(l, "// accepted and what is refused, and the design record is `openspec/changes/v1-every-domain/")
    strs_push(l, "// design.md`, section C. The parsers are pure and see only bytes already received (sans-I/O), so")
    strs_push(l, "// `@std/tls` (C1) supplies decrypted bytes to the same parsers without a change to them: a")
    strs_push(l, "// connection's `tls` field is its TLS session, `0` for plain TCP. Every value a task needs —")
    strs_push(l, "// `Request`, `Response`, `Headers`, `HttpServer`, `HttpConn` — may cross into one.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "use \"@std/net\";")
    strs_push(l, "use \"@std/tls\";")
    strs_push(l, "")
    strs_push(l, "/// Header fields in the order received: each name lower-cased, each value without the")
    strs_push(l, "/// whitespace around it.")
    strs_push(l, "pub struct Headers {")
    strs_push(l, "    lines: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A request: method, target as sent, its path and query, version (`HTTP/1.1` or `HTTP/1.0`),")
    strs_push(l, "/// header fields, the whole body (de-chunked), the router's parameters and the peer's address.")
    strs_push(l, "pub struct Request {")
    strs_push(l, "    method: Str,")
    strs_push(l, "    target: Str,")
    strs_push(l, "    path: Str,")
    strs_push(l, "    query: Str,")
    strs_push(l, "    version: Str,")
    strs_push(l, "    headers: Headers,")
    strs_push(l, "    body: Str,")
    strs_push(l, "    params: Str,")
    strs_push(l, "    peer: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A response: status, header fields, the whole body.")
    strs_push(l, "pub struct Response {")
    strs_push(l, "    status: Int,")
    strs_push(l, "    headers: Headers,")
    strs_push(l, "    body: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What failed: the socket, the protocol (with the status a server answers it with), or a request")
    strs_push(l, "/// for something this module does not do.")
    strs_push(l, "pub enum HttpError {")
    strs_push(l, "    Io(error: IoError),")
    strs_push(l, "    Protocol(status: Int, why: Str),")
    strs_push(l, "    Unsupported(why: Str),")
    strs_push(l, "    Tls(error: TlsError),")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A server's limits and deadlines. `http_serve_options()` gives the defaults.")
    strs_push(l, "pub struct ServeOptions {")
    strs_push(l, "    max_head: Int,")
    strs_push(l, "    max_headers: Int,")
    strs_push(l, "    max_target: Int,")
    strs_push(l, "    max_body: Int,")
    strs_push(l, "    head_timeout_ms: Int,")
    strs_push(l, "    idle_timeout_ms: Int,")
    strs_push(l, "    body_timeout_ms: Int,")
    strs_push(l, "    write_timeout_ms: Int,")
    strs_push(l, "    max_requests: Int,")
    strs_push(l, "    max_connections: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A client's limits and deadline. `http_client_options()` gives the defaults.")
    strs_push(l, "pub struct ClientOptions {")
    strs_push(l, "    timeout_ms: Int,")
    strs_push(l, "    max_head: Int,")
    strs_push(l, "    max_headers: Int,")
    strs_push(l, "    max_body: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A listening server: its listener, whether it is draining, what it has served and accepted, the")
    strs_push(l, "/// gate that caps open connections, its options and its TLS configuration (`0`: plain TCP); and")
    strs_push(l, "/// (C4) its connections, for a drain to close: `open` of them open, `entries` in `conns` (ended")
    strs_push(l, "/// ones among them until they are dropped), looked through under `lock`.")
    strs_push(l, "pub struct HttpServer {")
    strs_push(l, "    listener: TcpListener,")
    strs_push(l, "    draining: Atomic,")
    strs_push(l, "    served: Atomic,")
    strs_push(l, "    accepted: Atomic,")
    strs_push(l, "    gate: Chan,")
    strs_push(l, "    options: ServeOptions,")
    strs_push(l, "    tls: Int,")
    strs_push(l, "    conns: Chan[HttpLive],")
    strs_push(l, "    entries: Atomic,")
    strs_push(l, "    open: Atomic,")
    strs_push(l, "    lock: Chan,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A connection as its server keeps it (C4): its socket and its state — `0` idle, `1` serving a")
    strs_push(l, "/// request, `2` ended.")
    strs_push(l, "pub struct HttpLive {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "    state: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An accepted connection and its TLS session (`0`: plain TCP); (C4) its state as its server")
    strs_push(l, "/// keeps it.")
    strs_push(l, "pub struct HttpConn {")
    strs_push(l, "    stream: TcpStream,")
    strs_push(l, "    tls: Int,")
    strs_push(l, "    state: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `http_serve` did: requests answered and connections accepted.")
    strs_push(l, "pub struct ServeStats {")
    strs_push(l, "    requests: Int,")
    strs_push(l, "    connections: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A URL `http_url_parse` took apart: scheme (lower-cased), host as written, port, and the target")
    strs_push(l, "/// (path and query, `/` when empty).")
    strs_push(l, "pub struct Url {")
    strs_push(l, "    scheme: Str,")
    strs_push(l, "    host: Str,")
    strs_push(l, "    port: Int,")
    strs_push(l, "    target: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A client connection kept open for several requests, in order.")
    strs_push(l, "pub struct HttpClient {")
    strs_push(l, "    stream: TcpStream,")
    strs_push(l, "    authority: Str,")
    strs_push(l, "    options: ClientOptions,")
    strs_push(l, "    pending: Vec[Str],")
    strs_push(l, "    tls: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What a router made of a request: an answer, a path routed for other methods only (those")
    strs_push(l, "/// methods, for `Allow`), or nothing.")
    strs_push(l, "pub enum Routed {")
    strs_push(l, "    Answered(response: Response),")
    strs_push(l, "    NotAllowed(allow: Str),")
    strs_push(l, "    NotFound,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Routes, tried in the order they were added; the first whose method and pattern match answers.")
    strs_push(l, "pub struct Router {")
    strs_push(l, "    step: fn(Request) -> Routed ! { io },")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A request waiting for the serving task's handler, and where its response goes.")
    strs_push(l, "struct Pending {")
    strs_push(l, "    request: Request,")
    strs_push(l, "    reply: Chan[Response],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// What a parse step answers: done (`status` 0, `value`, `at` where it ended), more bytes needed")
    strs_push(l, "// (`status` 1), or the HTTP status refusing it with `why`.")
    strs_push(l, "struct Step {")
    strs_push(l, "    status: Int,")
    strs_push(l, "    value: Str,")
    strs_push(l, "    at: Int,")
    strs_push(l, "    why: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Bytes")
    strs_push(l, "")
    strs_push(l, "fn cr() -> Str ! {} {")
    strs_push(l, "    str_from_byte(13)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn lf() -> Str ! {} {")
    strs_push(l, "    str_from_byte(10)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn crlf() -> Str ! {} {")
    strs_push(l, "    str_concat(str_from_byte(13), str_from_byte(10))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_digit(b: Int) -> Bool ! {} {")
    strs_push(l, "    b >= 48 && b <= 57")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn hex_value(b: Int) -> Int ! {} {")
    strs_push(l, "    if b >= 48 && b <= 57 { b - 48 } else { if b >= 97 && b <= 102 { b - 87 } else { if b >= 65 && b <= 70 { b - 55 } else { 0 - 1 } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// RFC 9110's `tchar`.")
    strs_push(l, "fn is_tchar(b: Int) -> Bool ! {} {")
    strs_push(l, "    if b >= 48 && b <= 57 { return true; }")
    strs_push(l, "    if b >= 65 && b <= 90 { return true; }")
    strs_push(l, "    if b >= 97 && b <= 122 { return true; }")
    strs_push(l, "    b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_token(s: Str) -> Bool ! {} {")
    strs_push(l, "    if str_len(s) == 0 { return false; }")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        if !is_tchar(str_byte(s, i)) { return false; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    true")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A field value's bytes: HTAB, visible ASCII, space and obs-text; never a control or DEL.")
    strs_push(l, "fn is_field_value(s: Str) -> Bool ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        if b != 9 && (b < 32 || b == 127) { return false; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    true")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn lower(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut plain = true;")
    strs_push(l, "    while i < str_len(s) && plain {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        if b >= 65 && b <= 90 { plain = false; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if plain { return s; }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        strs_push(parts, str_from_byte(if b >= 65 && b <= 90 { b + 32 } else { b }));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_ows(b: Int) -> Bool ! {} {")
    strs_push(l, "    b == 32 || b == 9")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn trim_ows(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut a = 0;")
    strs_push(l, "    let mut b = str_len(s);")
    strs_push(l, "    while a < b && is_ows(str_byte(s, a)) { a = a + 1; }")
    strs_push(l, "    while b > a && is_ows(str_byte(s, b - 1)) { b = b - 1; }")
    strs_push(l, "    str_slice(s, a, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The first `needle` in `s` at or after `from`, or -1.")
    strs_push(l, "fn find_from(s: Str, needle: Str, from: Int) -> Int ! {} {")
    strs_push(l, "    let n = str_len(needle);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    let mut i = from;")
    strs_push(l, "    while i + n <= m {")
    strs_push(l, "        if str_byte(s, i) == str_byte(needle, 0) && str_slice(s, i, i + n) == needle { return i; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    0 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn find_byte(s: Str, b: Int, from: Int) -> Int ! {} {")
    strs_push(l, "    let mut i = from;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        if str_byte(s, i) == b { return i; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    0 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A decimal count of at most 18 digits, or -1.")
    strs_push(l, "fn parse_count(s: Str) -> Int ! {} {")
    strs_push(l, "    if str_len(s) == 0 || str_len(s) > 18 { return 0 - 1; }")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        if !is_digit(b) { return 0 - 1; }")
    strs_push(l, "        n = n * 10 + (b - 48);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn done(value: Str, at: Int) -> Step ! {} {")
    strs_push(l, "    Step(status: 0, value: value, at: at, why: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn more() -> Step ! {} {")
    strs_push(l, "    Step(status: 1, value: \"\", at: 0, why: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn refuse(status: Int, why: Str) -> Step ! {} {")
    strs_push(l, "    Step(status: status, value: \"\", at: 0, why: why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Header fields")
    strs_push(l, "")
    strs_push(l, "/// No header fields.")
    strs_push(l, "pub fn http_headers() -> Headers ! {} {")
    strs_push(l, "    Headers(lines: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `h` with the field `name: value` added after the others; the name is lower-cased. A name that")
    strs_push(l, "/// is not a token, or a value holding a control byte, is kept as an invalid field, which a server")
    strs_push(l, "/// answers with 500 and a client refuses to send.")
    strs_push(l, "pub fn http_header_add(h: Headers, name: Str, value: Str) -> Headers ! {} {")
    strs_push(l, "    let v = trim_ows(value);")
    strs_push(l, "    if is_token(name) && is_field_value(v) {")
    strs_push(l, "        Headers(lines: str_concat(h.lines, str_concat(str_concat(lower(name), \":\"), str_concat(v, lf()))))")
    strs_push(l, "    } else {")
    strs_push(l, "        Headers(lines: str_concat(h.lines, str_concat(\":\", lf())))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many fields `h` holds.")
    strs_push(l, "pub fn http_header_count(h: Headers) -> Int ! {} {")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(h.lines) {")
    strs_push(l, "        if str_byte(h.lines, i) == 10 { n = n + 1; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Where field `k` starts, or -1.")
    strs_push(l, "fn field_start(h: Headers, k: Int) -> Int ! {} {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < k {")
    strs_push(l, "        let nl = find_byte(h.lines, 10, at);")
    strs_push(l, "        if nl < 0 { return 0 - 1; }")
    strs_push(l, "        at = nl + 1;")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if at < str_len(h.lines) { at } else { 0 - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Where the line from `at` ends: its line feed, or the end of `lines`.")
    strs_push(l, "fn line_end(lines: Str, at: Int) -> Int ! {} {")
    strs_push(l, "    let nl = find_byte(lines, 10, at);")
    strs_push(l, "    if nl < 0 { str_len(lines) } else { nl }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The colon of the field from `at` to `nl`, or `nl` when it has none (a value built by hand).")
    strs_push(l, "fn colon_of(lines: Str, at: Int, nl: Int) -> Int ! {} {")
    strs_push(l, "    let c = find_byte(lines, 58, at);")
    strs_push(l, "    if c < 0 || c > nl { nl } else { c }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The name of field `i` (from 0), or `\"\"` past the end.")
    strs_push(l, "pub fn http_header_name_at(h: Headers, i: Int) -> Str ! {} {")
    strs_push(l, "    let at = field_start(h, i);")
    strs_push(l, "    if at < 0 { return \"\"; }")
    strs_push(l, "    let nl = line_end(h.lines, at);")
    strs_push(l, "    str_slice(h.lines, at, colon_of(h.lines, at, nl))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value of field `i` (from 0), or `\"\"` past the end.")
    strs_push(l, "pub fn http_header_value_at(h: Headers, i: Int) -> Str ! {} {")
    strs_push(l, "    let at = field_start(h, i);")
    strs_push(l, "    if at < 0 { return \"\"; }")
    strs_push(l, "    let nl = line_end(h.lines, at);")
    strs_push(l, "    let c = colon_of(h.lines, at, nl);")
    strs_push(l, "    if c == nl { \"\" } else { str_slice(h.lines, c + 1, nl) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value of the fields named `name` (any case), in order.")
    strs_push(l, "pub fn http_header_all(h: Headers, name: Str) -> Strs ! {} {")
    strs_push(l, "    let want = lower(name);")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < str_len(h.lines) {")
    strs_push(l, "        let nl = line_end(h.lines, at);")
    strs_push(l, "        let colon = colon_of(h.lines, at, nl);")
    strs_push(l, "        if colon < nl && str_slice(h.lines, at, colon) == want { strs_push(out, str_slice(h.lines, colon + 1, nl)); }")
    strs_push(l, "        at = nl + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The first value of the field named `name` (any case), or `None`.")
    strs_push(l, "pub fn http_header_get(h: Headers, name: Str) -> Option[Str] ! {} {")
    strs_push(l, "    let all = http_header_all(h, name);")
    strs_push(l, "    if strs_len(all) == 0 { Option[Str].None() } else { Option[Str].Some(value: strs_get(all, 0)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether a field named `name` (any case) is present.")
    strs_push(l, "pub fn http_header_has(h: Headers, name: Str) -> Bool ! {} {")
    strs_push(l, "    strs_len(http_header_all(h, name)) > 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `h` without the fields named `name` (any case).")
    strs_push(l, "pub fn http_header_remove(h: Headers, name: Str) -> Headers ! {} {")
    strs_push(l, "    let want = lower(name);")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < str_len(h.lines) {")
    strs_push(l, "        let nl = line_end(h.lines, at);")
    strs_push(l, "        let colon = colon_of(h.lines, at, nl);")
    strs_push(l, "        if str_slice(h.lines, at, colon) != want { strs_push(parts, str_concat(str_slice(h.lines, at, nl), lf())); }")
    strs_push(l, "        at = nl + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Headers(lines: str_join(parts, \"\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The comma-separated elements of every field named `name`, trimmed and lower-cased; empty ones")
    strs_push(l, "// dropped (RFC 9110 §5.6.1).")
    strs_push(l, "fn header_tokens(h: Headers, name: Str) -> Strs ! {} {")
    strs_push(l, "    let all = http_header_all(h, name);")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(all) {")
    strs_push(l, "        let v = strs_get(all, i);")
    strs_push(l, "        let mut start = 0;")
    strs_push(l, "        let mut j = 0;")
    strs_push(l, "        while j <= str_len(v) {")
    strs_push(l, "            if j == str_len(v) || str_byte(v, j) == 44 {")
    strs_push(l, "                let t = trim_ows(str_slice(v, start, j));")
    strs_push(l, "                if str_len(t) > 0 { strs_push(out, lower(t)); }")
    strs_push(l, "                start = j + 1;")
    strs_push(l, "            }")
    strs_push(l, "            j = j + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether some field named `name` lists `token` (any case) among its comma-separated elements,")
    strs_push(l, "/// as `Connection: close` does.")
    strs_push(l, "pub fn http_header_has_token(h: Headers, name: Str, token: Str) -> Bool ! {} {")
    strs_push(l, "    let all = header_tokens(h, name);")
    strs_push(l, "    let want = lower(token);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(all) {")
    strs_push(l, "        if strs_get(all, i) == want { return true; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    false")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Whether every field is a token, a colon and a value without a control byte: what was added")
    strs_push(l, "// through `http_header_add` or parsed always is; one built by hand may not be.")
    strs_push(l, "fn headers_valid(h: Headers) -> Bool ! {} {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < str_len(h.lines) {")
    strs_push(l, "        let nl = find_byte(h.lines, 10, at);")
    strs_push(l, "        if nl < 0 { return false; }")
    strs_push(l, "        let colon = colon_of(h.lines, at, nl);")
    strs_push(l, "        if colon == nl || !is_token(str_slice(h.lines, at, colon)) || !is_field_value(str_slice(h.lines, colon + 1, nl)) { return false; }")
    strs_push(l, "        at = nl + 1;")
    strs_push(l, "    }")
    strs_push(l, "    true")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Messages")
    strs_push(l, "")
    strs_push(l, "/// The reason phrase RFC 9110 gives `status`, or `\"\"`.")
    strs_push(l, "pub fn http_reason(status: Int) -> Str ! {} {")
    strs_push(l, "    if status == 100 { return \"Continue\"; }")
    strs_push(l, "    if status == 101 { return \"Switching Protocols\"; }")
    strs_push(l, "    if status == 200 { return \"OK\"; }")
    strs_push(l, "    if status == 201 { return \"Created\"; }")
    strs_push(l, "    if status == 202 { return \"Accepted\"; }")
    strs_push(l, "    if status == 204 { return \"No Content\"; }")
    strs_push(l, "    if status == 206 { return \"Partial Content\"; }")
    strs_push(l, "    if status == 301 { return \"Moved Permanently\"; }")
    strs_push(l, "    if status == 302 { return \"Found\"; }")
    strs_push(l, "    if status == 303 { return \"See Other\"; }")
    strs_push(l, "    if status == 304 { return \"Not Modified\"; }")
    strs_push(l, "    if status == 307 { return \"Temporary Redirect\"; }")
    strs_push(l, "    if status == 308 { return \"Permanent Redirect\"; }")
    strs_push(l, "    if status == 400 { return \"Bad Request\"; }")
    strs_push(l, "    if status == 401 { return \"Unauthorized\"; }")
    strs_push(l, "    if status == 403 { return \"Forbidden\"; }")
    strs_push(l, "    if status == 404 { return \"Not Found\"; }")
    strs_push(l, "    if status == 405 { return \"Method Not Allowed\"; }")
    strs_push(l, "    if status == 408 { return \"Request Timeout\"; }")
    strs_push(l, "    if status == 409 { return \"Conflict\"; }")
    strs_push(l, "    if status == 410 { return \"Gone\"; }")
    strs_push(l, "    if status == 411 { return \"Length Required\"; }")
    strs_push(l, "    if status == 413 { return \"Content Too Large\"; }")
    strs_push(l, "    if status == 414 { return \"URI Too Long\"; }")
    strs_push(l, "    if status == 415 { return \"Unsupported Media Type\"; }")
    strs_push(l, "    if status == 417 { return \"Expectation Failed\"; }")
    strs_push(l, "    if status == 422 { return \"Unprocessable Content\"; }")
    strs_push(l, "    if status == 429 { return \"Too Many Requests\"; }")
    strs_push(l, "    if status == 431 { return \"Request Header Fields Too Large\"; }")
    strs_push(l, "    if status == 500 { return \"Internal Server Error\"; }")
    strs_push(l, "    if status == 501 { return \"Not Implemented\"; }")
    strs_push(l, "    if status == 502 { return \"Bad Gateway\"; }")
    strs_push(l, "    if status == 503 { return \"Service Unavailable\"; }")
    strs_push(l, "    if status == 504 { return \"Gateway Timeout\"; }")
    strs_push(l, "    if status == 505 { return \"HTTP Version Not Supported\"; }")
    strs_push(l, "    \"\"")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A response with `status`, a `content-type` field (none when `content_type` is `\"\"`) and `body`.")
    strs_push(l, "pub fn http_response(status: Int, content_type: Str, body: Str) -> Response ! {} {")
    strs_push(l, "    let h = if str_len(content_type) > 0 { http_header_add(http_headers(), \"content-type\", content_type) } else { http_headers() };")
    strs_push(l, "    Response(status: status, headers: h, body: body)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A `text/plain; charset=utf-8` response.")
    strs_push(l, "pub fn http_text(status: Int, body: Str) -> Response ! {} {")
    strs_push(l, "    http_response(status, \"text/plain; charset=utf-8\", body)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An `application/json` response.")
    strs_push(l, "pub fn http_json(status: Int, body: Str) -> Response ! {} {")
    strs_push(l, "    http_response(status, \"application/json\", body)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A response with no body and no `content-type`.")
    strs_push(l, "pub fn http_empty(status: Int) -> Response ! {} {")
    strs_push(l, "    http_response(status, \"\", \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `r` with the field `name: value` added (`http_header_add`'s rules).")
    strs_push(l, "pub fn http_with_header(r: Response, name: Str, value: Str) -> Response ! {} {")
    strs_push(l, "    Response(status: r.status, headers: http_header_add(r.headers, name, value), body: r.body)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The path and query of an origin-form target.")
    strs_push(l, "fn split_target(target: Str) -> Step ! {} {")
    strs_push(l, "    let q = find_byte(target, 63, 0);")
    strs_push(l, "    if q < 0 { done(target, str_len(target)) } else { done(str_slice(target, 0, q), q) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A request for a client to send: `method` and `target` (origin form, `/path?query`), `body`,")
    strs_push(l, "/// version `HTTP/1.1`, no fields yet.")
    strs_push(l, "pub fn http_request(method: Str, target: Str, body: Str) -> Request ! {} {")
    strs_push(l, "    let t = split_target(target);")
    strs_push(l, "    let query = if t.at < str_len(target) { str_slice(target, t.at + 1, str_len(target)) } else { \"\" };")
    strs_push(l, "    Request(method: method, target: target, path: t.value, query: query, version: \"HTTP/1.1\", headers: http_headers(), body: body, params: \"\", peer: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `r` with the field `name: value` added (`http_header_add`'s rules).")
    strs_push(l, "pub fn http_request_with_header(r: Request, name: Str, value: Str) -> Request ! {} {")
    strs_push(l, "    Request(method: r.method, target: r.target, path: r.path, query: r.query, version: r.version, headers: http_header_add(r.headers, name, value), body: r.body, params: r.params, peer: r.peer)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with each `%XX` decoded, or `None` for a `%` not followed by two hexadecimal digits.")
    strs_push(l, "pub fn http_percent_decode(s: Str) -> Option[Str] ! {} {")
    strs_push(l, "    if find_byte(s, 37, 0) < 0 { return Option[Str].Some(value: s); }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        if b == 37 {")
    strs_push(l, "            if i + 2 >= str_len(s) { return Option[Str].None(); }")
    strs_push(l, "            let hi = hex_value(str_byte(s, i + 1));")
    strs_push(l, "            let lo = hex_value(str_byte(s, i + 2));")
    strs_push(l, "            if hi < 0 || lo < 0 { return Option[Str].None(); }")
    strs_push(l, "            strs_push(parts, str_from_byte(hi * 16 + lo));")
    strs_push(l, "            i = i + 3;")
    strs_push(l, "        } else {")
    strs_push(l, "            strs_push(parts, str_from_byte(b));")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Option[Str].Some(value: str_join(parts, \"\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The first value of the query parameter `name`, form-decoded (`+` is a space), or `None` when it")
    strs_push(l, "/// is absent or its encoding is malformed.")
    strs_push(l, "pub fn http_query(r: Request, name: Str) -> Option[Str] ! {} {")
    strs_push(l, "    let q = r.query;")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while j <= str_len(q) {")
    strs_push(l, "        if j == str_len(q) || str_byte(q, j) == 38 {")
    strs_push(l, "            let pair = str_slice(q, start, j);")
    strs_push(l, "            let eq = find_byte(pair, 61, 0);")
    strs_push(l, "            let k = if eq < 0 { pair } else { str_slice(pair, 0, eq) };")
    strs_push(l, "            let v = if eq < 0 { \"\" } else { str_slice(pair, eq + 1, str_len(pair)) };")
    strs_push(l, "            match http_percent_decode(plus_to_space(k)) {")
    strs_push(l, "                Option.Some(value: key) => {")
    strs_push(l, "                    if key == name { return http_percent_decode(plus_to_space(v)); }")
    strs_push(l, "                },")
    strs_push(l, "                Option.None() => {},")
    strs_push(l, "            };")
    strs_push(l, "            start = j + 1;")
    strs_push(l, "        }")
    strs_push(l, "        j = j + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Option[Str].None()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn plus_to_space(s: Str) -> Str ! {} {")
    strs_push(l, "    if find_byte(s, 43, 0) < 0 { return s; }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        strs_push(parts, str_from_byte(if b == 43 { 32 } else { b }));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A router's parameters: each name and value as `LENGTH:BYTES`.")
    strs_push(l, "fn param_piece(s: Str) -> Str ! {} {")
    strs_push(l, "    str_concat(str_concat(int_to_str(str_len(s)), \":\"), s)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value the router matched for the pattern's `{name}` (`*` for a trailing `*`), decoded, or")
    strs_push(l, "/// `None`.")
    strs_push(l, "pub fn http_param(r: Request, name: Str) -> Option[Str] ! {} {")
    strs_push(l, "    let p = r.params;")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    let mut key = \"\";")
    strs_push(l, "    let mut is_key = true;")
    strs_push(l, "    while at < str_len(p) {")
    strs_push(l, "        let colon = find_byte(p, 58, at);")
    strs_push(l, "        if colon < 0 { return Option[Str].None(); }")
    strs_push(l, "        let n = parse_count(str_slice(p, at, colon));")
    strs_push(l, "        if n < 0 || colon + 1 + n > str_len(p) { return Option[Str].None(); }")
    strs_push(l, "        let piece = str_slice(p, colon + 1, colon + 1 + n);")
    strs_push(l, "        if is_key {")
    strs_push(l, "            key = piece;")
    strs_push(l, "        } else {")
    strs_push(l, "            if key == name { return Option[Str].Some(value: piece); }")
    strs_push(l, "        }")
    strs_push(l, "        is_key = !is_key;")
    strs_push(l, "        at = colon + 1 + n;")
    strs_push(l, "    }")
    strs_push(l, "    Option[Str].None()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `e` says, for a person.")
    strs_push(l, "pub fn http_error_show(e: HttpError) -> Str ! {} {")
    strs_push(l, "    match e {")
    strs_push(l, "        HttpError.Io(error: x) => io_error_show(x),")
    strs_push(l, "        HttpError.Protocol(status: s, why: w) => str_concat(str_concat(int_to_str(s), \" \"), w),")
    strs_push(l, "        HttpError.Unsupported(why: w) => str_concat(\"unsupported: \", w),")
    strs_push(l, "        HttpError.Tls(error: x) => tls_error_show(x),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Parsing (pure: each step sees the bytes received so far and answers done, more or a refusal)")
    strs_push(l, "")
    strs_push(l, "/// The defaults: a 16 KiB head of at most 100 fields and an 8 KiB target, a 1 MiB body; 10 s for")
    strs_push(l, "/// the head, 60 s idle between requests, 30 s for each body read and each write; 1000 requests a")
    strs_push(l, "/// connection and 10 000 open connections.")
    strs_push(l, "pub fn http_serve_options() -> ServeOptions ! {} {")
    strs_push(l, "    ServeOptions(max_head: 16384, max_headers: 100, max_target: 8192, max_body: 1048576, head_timeout_ms: 10000, idle_timeout_ms: 60000, body_timeout_ms: 30000, write_timeout_ms: 30000, max_requests: 1000, max_connections: 10000)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The defaults: 30 s for each wait, a 64 KiB head of at most 100 fields, a 16 MiB body.")
    strs_push(l, "pub fn http_client_options() -> ClientOptions ! {} {")
    strs_push(l, "    ClientOptions(timeout_ms: 30000, max_head: 65536, max_headers: 100, max_body: 16777216)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The head in `buf`, ignoring empty lines before it (RFC 9112 §2.2): done with `value` its text up")
    strs_push(l, "// to and including the last field's CRLF and `at` just after the empty line; more while incomplete,")
    strs_push(l, "// with `at` where the next call resumes its scan (`scan`, from 0 the first time); 400 for a bare")
    strs_push(l, "// carriage return or line feed, found as soon as it arrives; 431 once `max` bytes hold no end.")
    strs_push(l, "fn find_head(buf: Str, scan: Int, max: Int) -> Step ! {} {")
    strs_push(l, "    let n = str_len(buf);")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    while start + 1 < n && str_byte(buf, start) == 13 && str_byte(buf, start + 1) == 10 {")
    strs_push(l, "        start = start + 2;")
    strs_push(l, "    }")
    strs_push(l, "    let mut i = if scan > start { scan } else { start };")
    strs_push(l, "    while i < n {")
    strs_push(l, "        let b = str_byte(buf, i);")
    strs_push(l, "        if b == 10 {")
    strs_push(l, "            if i == start || str_byte(buf, i - 1) != 13 { return refuse(400, \"a bare line feed\"); }")
    strs_push(l, "            if i >= start + 3 && str_byte(buf, i - 2) == 10 && str_byte(buf, i - 3) == 13 {")
    strs_push(l, "                if i + 1 - start > max { return refuse(431, \"the head is too large\"); }")
    strs_push(l, "                return Step(status: 0, value: str_slice(buf, start, i - 1), at: i + 1, why: \"\");")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if b == 13 && i + 1 < n && str_byte(buf, i + 1) != 10 { return refuse(400, \"a bare carriage return\"); }")
    strs_push(l, "        if i + 1 - start > max { return refuse(431, \"the head is too large\"); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Step(status: 1, value: \"\", at: if n - 1 > start { n - 1 } else { start }, why: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The head's lines, each without its CRLF; a bare CR or LF refused.")
    strs_push(l, "fn head_lines(head: Str) -> Result[Strs, Str] ! {} {")
    strs_push(l, "    let lines = strs_new();")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(head) {")
    strs_push(l, "        let b = str_byte(head, i);")
    strs_push(l, "        if b == 13 {")
    strs_push(l, "            if i + 1 >= str_len(head) || str_byte(head, i + 1) != 10 { return Result[Strs, Str].Err(error: \"a bare carriage return\"); }")
    strs_push(l, "            strs_push(lines, str_slice(head, start, i));")
    strs_push(l, "            i = i + 2;")
    strs_push(l, "            start = i;")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == 10 { return Result[Strs, Str].Err(error: \"a bare line feed\"); }")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if start < str_len(head) { return Result[Strs, Str].Err(error: \"a line without its end\"); }")
    strs_push(l, "    Result[Strs, Str].Ok(value: lines)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Header field lines from `first`, into `Headers`; obs-fold, a space before the colon, a name")
    strs_push(l, "// that is not a token and a value holding a control byte refused (RFC 9112 §5).")
    strs_push(l, "fn parse_fields(lines: Strs, first: Int, max: Int) -> Result[Headers, HttpError] ! {} {")
    strs_push(l, "    let mut h = http_headers();")
    strs_push(l, "    let mut i = first;")
    strs_push(l, "    while i < strs_len(lines) {")
    strs_push(l, "        let l = strs_get(lines, i);")
    strs_push(l, "        if i - first >= max { return Result[Headers, HttpError].Err(error: HttpError.Protocol(status: 431, why: \"too many header fields\")); }")
    strs_push(l, "        if str_len(l) > 0 && is_ows(str_byte(l, 0)) { return Result[Headers, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a folded header line\")); }")
    strs_push(l, "        let colon = find_byte(l, 58, 0);")
    strs_push(l, "        if colon <= 0 { return Result[Headers, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a header line without a name and a colon\")); }")
    strs_push(l, "        let name = str_slice(l, 0, colon);")
    strs_push(l, "        if !is_token(name) { return Result[Headers, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a header name that is not a token\")); }")
    strs_push(l, "        let value = trim_ows(str_slice(l, colon + 1, str_len(l)));")
    strs_push(l, "        if !is_field_value(value) { return Result[Headers, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a control byte in a header value\")); }")
    strs_push(l, "        h = http_header_add(h, name, value);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Headers, HttpError].Ok(value: h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn version_ok(v: Str) -> Int ! {} {")
    strs_push(l, "    if v == \"HTTP/1.1\" || v == \"HTTP/1.0\" { return 0; }")
    strs_push(l, "    if str_len(v) == 8 && str_slice(v, 0, 5) == \"HTTP/\" && is_digit(str_byte(v, 5)) && str_byte(v, 6) == 46 && is_digit(str_byte(v, 7)) { return 505; }")
    strs_push(l, "    400")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The request target's form: its path and query, or why it is refused.")
    strs_push(l, "fn target_path(method: Str, target: Str) -> Result[Request, HttpError] ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(target) {")
    strs_push(l, "        let b = str_byte(target, i);")
    strs_push(l, "        if b <= 32 || b >= 127 { return Result[Request, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a request target with a byte a URI cannot hold\")); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if target == \"*\" {")
    strs_push(l, "        if method == \"OPTIONS\" { return Result[Request, HttpError].Ok(value: http_request(method, \"*\", \"\")); }")
    strs_push(l, "        return Result[Request, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"the asterisk target outside OPTIONS\"));")
    strs_push(l, "    }")
    strs_push(l, "    if str_byte(target, 0) == 47 { return Result[Request, HttpError].Ok(value: http_request(method, target, \"\")); }")
    strs_push(l, "    let low = lower(target);")
    strs_push(l, "    let skip = if str_len(low) > 7 && str_slice(low, 0, 7) == \"http://\" { 7 } else { if str_len(low) > 8 && str_slice(low, 0, 8) == \"https://\" { 8 } else { 0 } };")
    strs_push(l, "    if skip == 0 { return Result[Request, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a request target in no form this server serves\")); }")
    strs_push(l, "    let slash = find_byte(target, 47, skip);")
    strs_push(l, "    let q = find_byte(target, 63, skip);")
    strs_push(l, "    let cut = if slash < 0 { q } else { if q >= 0 && q < slash { q } else { slash } };")
    strs_push(l, "    let origin = if cut < 0 { \"/\" } else { if str_byte(target, cut) == 63 { str_concat(\"/\", str_slice(target, cut, str_len(target))) } else { str_slice(target, cut, str_len(target)) } };")
    strs_push(l, "    let r = http_request(method, origin, \"\");")
    strs_push(l, "    Result[Request, HttpError].Ok(value: Request(method: r.method, target: target, path: r.path, query: r.query, version: r.version, headers: r.headers, body: \"\", params: \"\", peer: \"\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn bad(status: Int, why: Str) -> Result[Request, HttpError] ! {} {")
    strs_push(l, "    Result[Request, HttpError].Err(error: HttpError.Protocol(status: status, why: why))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A request head (its text up to and including the last field's CRLF), checked: the request line,")
    strs_push(l, "// the target's form, the version, the fields, `Host`, and that the body's framing is one this")
    strs_push(l, "// server can read. The body is `\"\"`.")
    strs_push(l, "fn parse_request_head(head: Str, o: ServeOptions) -> Result[Request, HttpError] ! {} {")
    strs_push(l, "    let lines = match head_lines(head) {")
    strs_push(l, "        Result.Ok(value: ls) => ls,")
    strs_push(l, "        Result.Err(error: why) => { return bad(400, why); },")
    strs_push(l, "    };")
    strs_push(l, "    if strs_len(lines) == 0 { return bad(400, \"no request line\"); }")
    strs_push(l, "    let line = strs_get(lines, 0);")
    strs_push(l, "    let sp1 = find_byte(line, 32, 0);")
    strs_push(l, "    if sp1 <= 0 { return bad(400, \"a request line without a method\"); }")
    strs_push(l, "    let sp2 = find_byte(line, 32, sp1 + 1);")
    strs_push(l, "    if sp2 < 0 || sp2 == sp1 + 1 { return bad(400, \"a request line without a target\"); }")
    strs_push(l, "    let method = str_slice(line, 0, sp1);")
    strs_push(l, "    let target = str_slice(line, sp1 + 1, sp2);")
    strs_push(l, "    let version = str_slice(line, sp2 + 1, str_len(line));")
    strs_push(l, "    if !is_token(method) { return bad(400, \"a method that is not a token\"); }")
    strs_push(l, "    let v = version_ok(version);")
    strs_push(l, "    if v == 400 { return bad(400, \"a malformed version\"); }")
    strs_push(l, "    if v == 505 { return bad(505, \"a version other than HTTP/1.1 and HTTP/1.0\"); }")
    strs_push(l, "    if str_len(target) > o.max_target { return bad(414, \"the target is too long\"); }")
    strs_push(l, "    if method == \"CONNECT\" { return bad(501, \"CONNECT is not served\"); }")
    strs_push(l, "    let base = match target_path(method, target) {")
    strs_push(l, "        Result.Ok(value: r) => r,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Request, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let h = match parse_fields(lines, 1, o.max_headers) {")
    strs_push(l, "        Result.Ok(value: h) => h,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Request, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let hosts = strs_len(http_header_all(h, \"host\"));")
    strs_push(l, "    if hosts > 1 { return bad(400, \"more than one Host field\"); }")
    strs_push(l, "    if hosts == 0 && version == \"HTTP/1.1\" { return bad(400, \"an HTTP/1.1 request without Host\"); }")
    strs_push(l, "    let r = Request(method: method, target: base.target, path: base.path, query: base.query, version: version, headers: h, body: \"\", params: \"\", peer: \"\");")
    strs_push(l, "    match framing(h, version == \"HTTP/1.0\", o.max_body) {")
    strs_push(l, "        Result.Ok(value: n) => Result[Request, HttpError].Ok(value: r),")
    strs_push(l, "        Result.Err(error: e) => Result[Request, HttpError].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// How the body is framed: its length, or -1 for chunked. Transfer-Encoding with Content-Length,")
    strs_push(l, "// a coding other than chunked, chunked not last or twice, Transfer-Encoding in HTTP/1.0, and a")
    strs_push(l, "// Content-Length that is not one decimal count are refused (RFC 9112 §6, the smuggling rules).")
    strs_push(l, "fn framing(h: Headers, http10: Bool, max_body: Int) -> Result[Int, HttpError] ! {} {")
    strs_push(l, "    let te = header_tokens(h, \"transfer-encoding\");")
    strs_push(l, "    let has_te = http_header_has(h, \"transfer-encoding\");")
    strs_push(l, "    let cls = http_header_all(h, \"content-length\");")
    strs_push(l, "    if has_te {")
    strs_push(l, "        if strs_len(cls) > 0 { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"both Transfer-Encoding and Content-Length\")); }")
    strs_push(l, "        if http10 { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"Transfer-Encoding in an HTTP/1.0 message\")); }")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        while i < strs_len(te) {")
    strs_push(l, "            if strs_get(te, i) != \"chunked\" { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 501, why: \"a transfer coding other than chunked\")); }")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if strs_len(te) != 1 { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"chunked more than once, or no coding\")); }")
    strs_push(l, "        return Result[Int, HttpError].Ok(value: 0 - 1);")
    strs_push(l, "    }")
    strs_push(l, "    if strs_len(cls) == 0 { return Result[Int, HttpError].Ok(value: 0); }")
    strs_push(l, "    let all = header_tokens(h, \"content-length\");")
    strs_push(l, "    if strs_len(all) == 0 { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"an empty Content-Length\")); }")
    strs_push(l, "    let first = strs_get(all, 0);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(all) {")
    strs_push(l, "        let t = strs_get(all, i);")
    strs_push(l, "        if t != first { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"Content-Length values that differ\")); }")
    strs_push(l, "        let mut j = 0;")
    strs_push(l, "        while j < str_len(t) {")
    strs_push(l, "            if !is_digit(str_byte(t, j)) { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a Content-Length that is not a decimal count\")); }")
    strs_push(l, "            j = j + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let n = parse_count(first);")
    strs_push(l, "    if n < 0 || n > max_body { return Result[Int, HttpError].Err(error: HttpError.Protocol(status: 413, why: \"the body is too large\")); }")
    strs_push(l, "    Result[Int, HttpError].Ok(value: n)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A chunked body in `buf` from `at`, continuing a decode that has `so_far`: `value` is the body,")
    strs_push(l, "// `at` where the message ends. More while incomplete, but `at` and `value` then say how far whole")
    strs_push(l, "// chunks reached, so the next call resumes there (status 2). Refused: a size that is not hex, a")
    strs_push(l, "// size or a body past `max`, a chunk not followed by CRLF, a control byte in an extension, a")
    strs_push(l, "// malformed trailer field (RFC 9112 §7.1).")
    strs_push(l, "fn chunked(buf: Str, at: Int, so_far: Str, max: Int, max_fields: Int) -> Step ! {} {")
    strs_push(l, "    let mut pos = at;")
    strs_push(l, "    let mut body = so_far;")
    strs_push(l, "    while true {")
    strs_push(l, "        let eol = find_from(buf, crlf(), pos);")
    strs_push(l, "        if eol < 0 {")
    strs_push(l, "            if str_len(buf) - pos > 4096 { return refuse(400, \"a chunk line too long\"); }")
    strs_push(l, "            return Step(status: 2, value: body, at: pos, why: \"\");")
    strs_push(l, "        }")
    strs_push(l, "        let line = str_slice(buf, pos, eol);")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        let mut size = 0;")
    strs_push(l, "        while i < str_len(line) && hex_value(str_byte(line, i)) >= 0 {")
    strs_push(l, "            if i >= 15 { return refuse(413, \"a chunk size too large\"); }")
    strs_push(l, "            size = size * 16 + hex_value(str_byte(line, i));")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if i == 0 { return refuse(400, \"a chunk size that is not hexadecimal\"); }")
    strs_push(l, "        while i < str_len(line) && is_ows(str_byte(line, i)) { i = i + 1; }")
    strs_push(l, "        if i < str_len(line) {")
    strs_push(l, "            if str_byte(line, i) != 59 { return refuse(400, \"text after a chunk size\"); }")
    strs_push(l, "            if !is_field_value(str_slice(line, i, str_len(line))) { return refuse(400, \"a control byte in a chunk extension\"); }")
    strs_push(l, "        }")
    strs_push(l, "        if str_len(body) + size > max { return refuse(413, \"the body is too large\"); }")
    strs_push(l, "        if size == 0 {")
    strs_push(l, "            // Trailer fields, then the empty line.")
    strs_push(l, "            let mut t = eol + 2;")
    strs_push(l, "            let mut fields = 0;")
    strs_push(l, "            while true {")
    strs_push(l, "                let e = find_from(buf, crlf(), t);")
    strs_push(l, "                if e < 0 {")
    strs_push(l, "                    if str_len(buf) - t > 4096 { return refuse(431, \"a trailer field too long\"); }")
    strs_push(l, "                    return Step(status: 2, value: body, at: pos, why: \"\");")
    strs_push(l, "                }")
    strs_push(l, "                if e == t { return Step(status: 0, value: body, at: e + 2, why: \"\"); }")
    strs_push(l, "                let field = str_slice(buf, t, e);")
    strs_push(l, "                if find_byte(field, 10, 0) >= 0 || find_byte(field, 13, 0) >= 0 { return refuse(400, \"a bare line end in a trailer\"); }")
    strs_push(l, "                let one = strs_new();")
    strs_push(l, "                strs_push(one, field);")
    strs_push(l, "                match parse_fields(one, 0, 1) {")
    strs_push(l, "                    Result.Ok(value: h) => {},")
    strs_push(l, "                    Result.Err(error: e2) => { return refuse(400, \"a malformed trailer field\"); },")
    strs_push(l, "                };")
    strs_push(l, "                fields = fields + 1;")
    strs_push(l, "                if fields > max_fields { return refuse(431, \"too many trailer fields\"); }")
    strs_push(l, "                t = e + 2;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if str_len(buf) < eol + 2 + size + 2 { return Step(status: 2, value: body, at: pos, why: \"\"); }")
    strs_push(l, "        if str_byte(buf, eol + 2 + size) != 13 || str_byte(buf, eol + 3 + size) != 10 { return refuse(400, \"a chunk not followed by its line end\"); }")
    strs_push(l, "        body = str_concat(body, str_slice(buf, eol + 2, eol + 2 + size));")
    strs_push(l, "        pos = eol + 4 + size;")
    strs_push(l, "    }")
    strs_push(l, "    more()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A complete request — head and body — from `raw`, as a server reads one: `Protocol` with the")
    strs_push(l, "/// status it would answer for anything refused or incomplete, and for bytes after the message.")
    strs_push(l, "pub fn http_parse_request(raw: Str, o: ServeOptions) -> Result[Request, HttpError] ! {} {")
    strs_push(l, "    let head = find_head(raw, 0, o.max_head);")
    strs_push(l, "    if head.status == 1 { return bad(400, \"an incomplete head\"); }")
    strs_push(l, "    if head.status != 0 { return bad(head.status, head.why); }")
    strs_push(l, "    let r = match parse_request_head(head.value, o) {")
    strs_push(l, "        Result.Ok(value: r) => r,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Request, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let n = match framing(r.headers, r.version == \"HTTP/1.0\", o.max_body) {")
    strs_push(l, "        Result.Ok(value: n) => n,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Request, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let body = body_of(raw, head.at, n, o.max_body, o.max_headers);")
    strs_push(l, "    if body.status != 0 { return bad(if body.status == 1 || body.status == 2 { 400 } else { body.status }, if body.status == 1 || body.status == 2 { \"an incomplete body\" } else { body.why }); }")
    strs_push(l, "    if body.at != str_len(raw) { return bad(400, \"bytes after the message\"); }")
    strs_push(l, "    Result[Request, HttpError].Ok(value: with_body(r, body.value))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn with_body(r: Request, body: Str) -> Request ! {} {")
    strs_push(l, "    Request(method: r.method, target: r.target, path: r.path, query: r.query, version: r.version, headers: r.headers, body: body, params: r.params, peer: r.peer)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The body from `at`: `n` bytes, or chunked for -1.")
    strs_push(l, "fn body_of(buf: Str, at: Int, n: Int, max: Int, max_fields: Int) -> Step ! {} {")
    strs_push(l, "    if n >= 0 {")
    strs_push(l, "        if str_len(buf) - at < n { return more(); }")
    strs_push(l, "        return done(str_slice(buf, at, at + n), at + n);")
    strs_push(l, "    }")
    strs_push(l, "    chunked(buf, at, \"\", max, max_fields)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A response head: the status line (`HTTP/1.x`, three digits, a space, a reason) and the fields.")
    strs_push(l, "fn parse_response_head(head: Str, o: ClientOptions) -> Result[Response, HttpError] ! {} {")
    strs_push(l, "    let lines = match head_lines(head) {")
    strs_push(l, "        Result.Ok(value: ls) => ls,")
    strs_push(l, "        Result.Err(error: why) => { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: why)); },")
    strs_push(l, "    };")
    strs_push(l, "    if strs_len(lines) == 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"no status line\")); }")
    strs_push(l, "    let line = strs_get(lines, 0);")
    strs_push(l, "    let shape = str_len(line) >= 12 && str_slice(line, 0, 7) == \"HTTP/1.\" && is_digit(str_byte(line, 7)) && str_byte(line, 8) == 32;")
    strs_push(l, "    if !shape || (str_len(line) > 12 && str_byte(line, 12) != 32) {")
    strs_push(l, "        return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"a malformed status line\"));")
    strs_push(l, "    }")
    strs_push(l, "    let code = str_slice(line, 9, 12);")
    strs_push(l, "    if !is_digit(str_byte(code, 0)) || !is_digit(str_byte(code, 1)) || !is_digit(str_byte(code, 2)) || str_byte(code, 0) == 48 {")
    strs_push(l, "        return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"a malformed status code\"));")
    strs_push(l, "    }")
    strs_push(l, "    if !is_field_value(str_slice(line, 12, str_len(line))) { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"a control byte in the reason\")); }")
    strs_push(l, "    match parse_fields(lines, 1, o.max_headers) {")
    strs_push(l, "        Result.Ok(value: h) => Result[Response, HttpError].Ok(value: Response(status: parse_count(code), headers: h, body: \"\")),")
    strs_push(l, "        Result.Err(error: e) => Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: http_error_show(e))),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// How a response body is framed: none (-2), chunked (-1), a length, or to the close (-3).")
    strs_push(l, "fn response_framing(r: Response, method: Str, max: Int) -> Result[Int, HttpError] ! {} {")
    strs_push(l, "    if method == \"HEAD\" || r.status < 200 || r.status == 204 || r.status == 304 { return Result[Int, HttpError].Ok(value: 0 - 2); }")
    strs_push(l, "    if http_header_has(r.headers, \"transfer-encoding\") {")
    strs_push(l, "        let te = header_tokens(r.headers, \"transfer-encoding\");")
    strs_push(l, "        if strs_len(te) > 0 && strs_get(te, strs_len(te) - 1) == \"chunked\" {")
    strs_push(l, "            if strs_len(te) == 1 { return Result[Int, HttpError].Ok(value: 0 - 1); }")
    strs_push(l, "            return Result[Int, HttpError].Err(error: HttpError.Unsupported(why: \"a transfer coding other than chunked\"));")
    strs_push(l, "        }")
    strs_push(l, "        return Result[Int, HttpError].Ok(value: 0 - 3);")
    strs_push(l, "    }")
    strs_push(l, "    if !http_header_has(r.headers, \"content-length\") { return Result[Int, HttpError].Ok(value: 0 - 3); }")
    strs_push(l, "    match framing(r.headers, false, max) {")
    strs_push(l, "        Result.Ok(value: n) => Result[Int, HttpError].Ok(value: n),")
    strs_push(l, "        Result.Err(error: e) => Result[Int, HttpError].Err(error: HttpError.Protocol(status: 502, why: http_error_show(e))),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A complete response — head and body — from `raw`, as a client reads the answer to `method`: a")
    strs_push(l, "/// body to the end of `raw` when the response has no length.")
    strs_push(l, "pub fn http_parse_response(raw: Str, method: Str, o: ClientOptions) -> Result[Response, HttpError] ! {} {")
    strs_push(l, "    let head = find_head(raw, 0, o.max_head);")
    strs_push(l, "    if head.status != 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: if head.status == 1 { \"an incomplete head\" } else { head.why })); }")
    strs_push(l, "    let r = match parse_response_head(head.value, o) {")
    strs_push(l, "        Result.Ok(value: r) => r,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let n = match response_framing(r, method, o.max_body) {")
    strs_push(l, "        Result.Ok(value: n) => n,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    if n == 0 - 2 { return Result[Response, HttpError].Ok(value: r); }")
    strs_push(l, "    if n == 0 - 3 {")
    strs_push(l, "        if str_len(raw) - head.at > o.max_body { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"the body is too large\")); }")
    strs_push(l, "        return Result[Response, HttpError].Ok(value: Response(status: r.status, headers: r.headers, body: str_slice(raw, head.at, str_len(raw))));")
    strs_push(l, "    }")
    strs_push(l, "    let body = body_of(raw, head.at, n, o.max_body, o.max_headers);")
    strs_push(l, "    if body.status != 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: if body.status == 1 || body.status == 2 { \"an incomplete body\" } else { body.why })); }")
    strs_push(l, "    Result[Response, HttpError].Ok(value: Response(status: r.status, headers: r.headers, body: body.value))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Writing")
    strs_push(l, "")
    strs_push(l, "fn no_body_status(status: Int) -> Bool ! {} {")
    strs_push(l, "    status < 200 || status == 204 || status == 304")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The bytes a server sends for `r`: the status line, the fields (any `content-length`,")
    strs_push(l, "/// `transfer-encoding` and `connection` of `r`'s replaced by the server's own), the body unless")
    strs_push(l, "/// `head_only` or the status has none; `connection: close` when `close`. `Protocol(500)` for a")
    strs_push(l, "/// status outside 100–999 or an invalid field.")
    strs_push(l, "pub fn http_format_response(r: Response, head_only: Bool, close: Bool) -> Result[Str, HttpError] ! {} {")
    strs_push(l, "    if r.status < 100 || r.status > 999 { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 500, why: \"a status outside 100 to 999\")); }")
    strs_push(l, "    if !headers_valid(r.headers) { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 500, why: \"an invalid header field\")); }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, str_concat(str_concat(\"HTTP/1.1 \", int_to_str(r.status)), str_concat(\" \", http_reason(r.status))));")
    strs_push(l, "    strs_push(parts, crlf());")
    strs_push(l, "    let h = http_header_remove(http_header_remove(http_header_remove(r.headers, \"content-length\"), \"transfer-encoding\"), \"connection\");")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let n = http_header_count(h);")
    strs_push(l, "    while i < n {")
    strs_push(l, "        strs_push(parts, str_concat(str_concat(http_header_name_at(h, i), \": \"), str_concat(http_header_value_at(h, i), crlf())));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let bodiless = no_body_status(r.status);")
    strs_push(l, "    if !bodiless {")
    strs_push(l, "        strs_push(parts, str_concat(str_concat(\"content-length: \", int_to_str(str_len(r.body))), crlf()));")
    strs_push(l, "    }")
    strs_push(l, "    if close { strs_push(parts, str_concat(\"connection: close\", crlf())); }")
    strs_push(l, "    strs_push(parts, crlf());")
    strs_push(l, "    if !head_only && !bodiless { strs_push(parts, r.body); }")
    strs_push(l, "    Result[Str, HttpError].Ok(value: str_join(parts, \"\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The bytes a client sends for `r` to `authority` (`host[:port]`, for `host` when `r` has none):")
    strs_push(l, "/// `content-length` when there is a body or the method is POST, PUT or PATCH; `connection: close`")
    strs_push(l, "/// when `close`. `Protocol(400)` for a method that is not a token, a target holding a space or a")
    strs_push(l, "/// control byte, or an invalid field.")
    strs_push(l, "pub fn http_format_request(r: Request, authority: Str, close: Bool) -> Result[Str, HttpError] ! {} {")
    strs_push(l, "    if !is_token(r.method) { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a method that is not a token\")); }")
    strs_push(l, "    if str_len(r.target) == 0 { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"an empty target\")); }")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(r.target) {")
    strs_push(l, "        let b = str_byte(r.target, i);")
    strs_push(l, "        if b <= 32 || b >= 127 { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a target with a byte a URI cannot hold\")); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if !headers_valid(r.headers) { return Result[Str, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"an invalid header field\")); }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, str_concat(str_concat(r.method, \" \"), str_concat(r.target, str_concat(\" HTTP/1.1\", crlf()))));")
    strs_push(l, "    if !http_header_has(r.headers, \"host\") { strs_push(parts, str_concat(str_concat(\"host: \", authority), crlf())); }")
    strs_push(l, "    let h = http_header_remove(http_header_remove(http_header_remove(r.headers, \"content-length\"), \"transfer-encoding\"), \"connection\");")
    strs_push(l, "    let n = http_header_count(h);")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        strs_push(parts, str_concat(str_concat(http_header_name_at(h, i), \": \"), str_concat(http_header_value_at(h, i), crlf())));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if str_len(r.body) > 0 || r.method == \"POST\" || r.method == \"PUT\" || r.method == \"PATCH\" {")
    strs_push(l, "        strs_push(parts, str_concat(str_concat(\"content-length: \", int_to_str(str_len(r.body))), crlf()));")
    strs_push(l, "    }")
    strs_push(l, "    if close { strs_push(parts, str_concat(\"connection: close\", crlf())); }")
    strs_push(l, "    strs_push(parts, crlf());")
    strs_push(l, "    strs_push(parts, r.body);")
    strs_push(l, "    Result[Str, HttpError].Ok(value: str_join(parts, \"\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The wire: bytes in through a buffer, out in full; through the connection's TLS session when it")
    strs_push(l, "// has one (`@std/tls`, C1), which decrypts in and encrypts out.")
    strs_push(l, "")
    strs_push(l, "struct Wire {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "    tls: Int,")
    strs_push(l, "    buf: Bytes,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// What has arrived: `value` the bytes, `at` their count, 0 at the end, a status below 0.")
    strs_push(l, "fn fill(w: Wire) -> Step ! { io } {")
    strs_push(l, "    let n = if w.tls != 0 { tls_wire_read(w.handle, w.tls, w.buf) } else { os_read(w.handle, w.buf) };")
    strs_push(l, "    if n <= 0 { return Step(status: 0, value: \"\", at: n, why: \"\"); }")
    strs_push(l, "    Step(status: 0, value: bytes_to_str(bytes_slice(w.buf, 0, n)), at: n, why: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn send(w: Wire, text: Str) -> Int ! { io } {")
    strs_push(l, "    let data = bytes_from_str(text);")
    strs_push(l, "    if w.tls != 0 { return tls_wire_write(w.handle, w.tls, data); }")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(data) {")
    strs_push(l, "        let n = os_write(w.handle, bytes_slice(data, at, bytes_len(data)));")
    strs_push(l, "        if n < 0 { return n; }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn set_wait(w: Wire, ms: Int) -> Int ! { io } {")
    strs_push(l, "    os_set_timeout(w.handle, ms)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The server")
    strs_push(l, "")
    strs_push(l, "/// A server listening on `addr` (port `0`: one the system picks) with options `o`.")
    strs_push(l, "pub fn http_listen(net: NetCap, addr: Str, o: ServeOptions) -> Result[HttpServer, IoError] ! { io } {")
    strs_push(l, "    match tcp_listen(net, addr) {")
    strs_push(l, "        Result.Ok(value: l) => {")
    strs_push(l, "            let cap = if o.max_connections > 0 { o.max_connections } else { 1 };")
    strs_push(l, "            Result[HttpServer, IoError].Ok(value: HttpServer(listener: l, draining: atomic_new(0), served: atomic_new(0), accepted: atomic_new(0), gate: chan_new(cap), options: o, tls: 0, conns: chan_new_of[HttpLive](2 * cap + 2), entries: atomic_new(0), open: atomic_new(0), lock: chan_new(1)))")
    strs_push(l, "        },")
    strs_push(l, "        Result.Err(error: e) => Result[HttpServer, IoError].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A server listening on `addr` as `http_listen` does, every connection over TLS with configuration")
    strs_push(l, "/// `c` (`tls_server`): the handshake is each connection's first exchange, bounded by")
    strs_push(l, "/// `head_timeout_ms`. `c` stays the caller's.")
    strs_push(l, "pub fn http_listen_tls(net: NetCap, addr: Str, o: ServeOptions, c: TlsConfig) -> Result[HttpServer, IoError] ! { io } {")
    strs_push(l, "    match http_listen(net, addr, o) {")
    strs_push(l, "        Result.Ok(value: s) => Result[HttpServer, IoError].Ok(value: HttpServer(listener: s.listener, draining: s.draining, served: s.served, accepted: s.accepted, gate: s.gate, options: s.options, tls: c.id, conns: s.conns, entries: s.entries, open: s.open, lock: s.lock)),")
    strs_push(l, "        Result.Err(error: e) => Result[HttpServer, IoError].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The address `s` listens on.")
    strs_push(l, "pub fn http_server_addr(s: HttpServer) -> Str ! { io } {")
    strs_push(l, "    tcp_listener_addr(s.listener)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Stop accepting: the listener closes, so a waiting accept wakes `Closed`; each idle connection")
    strs_push(l, "/// (no request under way on it) is closed at once, and each other ends after the request it is")
    strs_push(l, "/// serving, answering it with `connection: close`. Answers how many idle connections it closed.")
    strs_push(l, "pub fn http_drain(s: HttpServer) -> Int ! { io } {")
    strs_push(l, "    atomic_store(s.draining, 1);")
    strs_push(l, "    tcp_listener_close(s.listener);")
    strs_push(l, "    sweep(s, false)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Drain `s` with a deadline (C4), what a termination signal asks of a service: `http_drain`, then")
    strs_push(l, "/// a wait of at most `ms` milliseconds for the connections serving a request to finish; any still")
    strs_push(l, "/// open then are closed, each wait on them waking `Closed`. Answers how many were closed at the")
    strs_push(l, "/// deadline.")
    strs_push(l, "pub fn http_drain_within(t: TimeCap, s: HttpServer, ms: Int) -> Int ! { io } {")
    strs_push(l, "    let deadline = time_now_ms() + ms;")
    strs_push(l, "    http_drain(s);")
    strs_push(l, "    while atomic_load(s.open) > 0 && time_now_ms() < deadline {")
    strs_push(l, "        time_sleep_ms(5);")
    strs_push(l, "    }")
    strs_push(l, "    if atomic_load(s.open) > 0 { sweep(s, true) } else { 0 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The registry of connections: `entries` of them in `conns`, each taken out and put back, or")
    strs_push(l, "// dropped once ended, only while `lock` is held, so a holder may wait for each knowing that no")
    strs_push(l, "// one else has taken it away for good.")
    strs_push(l, "fn lock(s: HttpServer) -> Int ! {} {")
    strs_push(l, "    chan_send(s.lock, 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn unlock(s: HttpServer) -> Int ! {} {")
    strs_push(l, "    let got = ints_new();")
    strs_push(l, "    chan_recv(s.lock, got);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Close each open connection of `s` — only the idle ones unless `all` — and answer how many.")
    strs_push(l, "fn sweep(s: HttpServer, all: Bool) -> Int ! { io } {")
    strs_push(l, "    lock(s);")
    strs_push(l, "    let n = atomic_load(s.entries);")
    strs_push(l, "    let got = vec_new[HttpLive]();")
    strs_push(l, "    let mut closed = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        if chan_recv_of(s.conns, got) {")
    strs_push(l, "            let e = vec_pop(got);")
    strs_push(l, "            let st = atomic_load(e.state);")
    strs_push(l, "            if st == 0 || (all && st == 1) {")
    strs_push(l, "                os_close(e.handle);")
    strs_push(l, "                closed = closed + 1;")
    strs_push(l, "            }")
    strs_push(l, "            chan_send_of(s.conns, e);")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    unlock(s);")
    strs_push(l, "    closed")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Register a connection: first drop up to two ended ones met at the front, so the registry holds")
    strs_push(l, "// at most about twice the open connections.")
    strs_push(l, "fn enter(s: HttpServer, e: HttpLive) -> Int ! {} {")
    strs_push(l, "    lock(s);")
    strs_push(l, "    let got = vec_new[HttpLive]();")
    strs_push(l, "    let mut k = 0;")
    strs_push(l, "    while k < 2 && k < atomic_load(s.entries) {")
    strs_push(l, "        if chan_recv_of(s.conns, got) {")
    strs_push(l, "            let old = vec_pop(got);")
    strs_push(l, "            if atomic_load(old.state) == 2 { atomic_add(s.entries, 0 - 1); } else { chan_send_of(s.conns, old); }")
    strs_push(l, "        }")
    strs_push(l, "        k = k + 1;")
    strs_push(l, "    }")
    strs_push(l, "    chan_send_of(s.conns, e);")
    strs_push(l, "    atomic_add(s.entries, 1);")
    strs_push(l, "    unlock(s);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `http_drain` has been called on `s`.")
    strs_push(l, "pub fn http_draining(s: HttpServer) -> Bool ! {} {")
    strs_push(l, "    atomic_load(s.draining) != 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next connection, once fewer than `max_connections` are open (until then the kernel's")
    strs_push(l, "/// backlog holds new ones). Each accepted connection is served by `http_serve_conn`, which frees")
    strs_push(l, "/// its place.")
    strs_push(l, "pub fn http_accept(s: HttpServer) -> Result[HttpConn, IoError] ! { io } {")
    strs_push(l, "    chan_send(s.gate, 1);")
    strs_push(l, "    match tcp_accept(s.listener) {")
    strs_push(l, "        Result.Ok(value: c) => {")
    strs_push(l, "            atomic_add(s.accepted, 1);")
    strs_push(l, "            let mut t = 0;")
    strs_push(l, "            if s.tls != 0 {")
    strs_push(l, "                // A session for the connection; its handshake is the connection's task's to run.")
    strs_push(l, "                t = os_tls_accept(s.tls);")
    strs_push(l, "                if t < 0 {")
    strs_push(l, "                    tcp_close(c);")
    strs_push(l, "                    release(s);")
    strs_push(l, "                    return Result[HttpConn, IoError].Err(error: io_error_new(IoErrorKind.Other(), tls_error_show(tls_error_from(t, \"\"))));")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            let state = atomic_new(0);")
    strs_push(l, "            atomic_add(s.open, 1);")
    strs_push(l, "            enter(s, HttpLive(handle: c.handle, state: state));")
    strs_push(l, "            Result[HttpConn, IoError].Ok(value: HttpConn(stream: c, tls: t, state: state))")
    strs_push(l, "        },")
    strs_push(l, "        Result.Err(error: e) => {")
    strs_push(l, "            release(s);")
    strs_push(l, "            Result[HttpConn, IoError].Err(error: e)")
    strs_push(l, "        },")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn release(s: HttpServer) -> Int ! {} {")
    strs_push(l, "    let got = ints_new();")
    strs_push(l, "    chan_recv(s.gate, got);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Serve `c`'s requests in order with `h` — keep-alive, pipelined requests in turn — until the")
    strs_push(l, "/// client closes, asks to, errs, waits past a deadline, reaches `max_requests`, or the server")
    strs_push(l, "/// drains; then close it. Answers how many requests it served. Run in a task of its own per")
    strs_push(l, "/// connection, it is the parallel form: the task names its handler, which a task may not be given.")
    strs_push(l, "pub fn http_serve_conn(s: HttpServer, c: HttpConn, h: fn(Request) -> Response ! { io }) -> Int ! { io } {")
    strs_push(l, "    let n = conn_loop(s, c, h);")
    strs_push(l, "    if c.tls != 0 { tls_wire_close(c.stream.handle, c.tls); }")
    strs_push(l, "    atomic_store(c.state, 2);")
    strs_push(l, "    atomic_add(s.open, 0 - 1);")
    strs_push(l, "    tcp_close(c.stream);")
    strs_push(l, "    release(s);")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn answer_error(w: Wire, status: Int, why: Str) -> Int ! { io } {")
    strs_push(l, "    match http_format_response(http_text(status, str_concat(why, lf())), false, true) {")
    strs_push(l, "        Result.Ok(value: t) => send(w, t),")
    strs_push(l, "        Result.Err(error: e) => 0,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn conn_loop(s: HttpServer, c: HttpConn, h: fn(Request) -> Response ! { io }) -> Int ! { io } {")
    strs_push(l, "    let o = s.options;")
    strs_push(l, "    let w = Wire(handle: c.stream.handle, tls: c.tls, buf: bytes_new(16384));")
    strs_push(l, "    let peer = tcp_peer_addr(c.stream);")
    strs_push(l, "    // TLS's handshake first, within the head's deadline; a client that fails it is not served.")
    strs_push(l, "    if c.tls != 0 {")
    strs_push(l, "        set_wait(w, o.head_timeout_ms);")
    strs_push(l, "        if tls_wire_handshake(w.handle, c.tls) < 0 { return 0; }")
    strs_push(l, "    }")
    strs_push(l, "    let mut pending = \"\";")
    strs_push(l, "    let mut served = 0;")
    strs_push(l, "    let mut open = true;")
    strs_push(l, "    let mut wait = 0 - 1;")
    strs_push(l, "    while open {")
    strs_push(l, "        // The head: idle until a byte arrives, then the head's own deadline.")
    strs_push(l, "        let mut head = find_head(pending, 0, o.max_head);")
    strs_push(l, "        let mut ended = false;")
    strs_push(l, "        while head.status == 1 && !ended {")
    strs_push(l, "            let want = if str_len(pending) == 0 { if served == 0 { o.head_timeout_ms } else { o.idle_timeout_ms } } else { o.head_timeout_ms };")
    strs_push(l, "            if want != wait { set_wait(w, want); wait = want; }")
    strs_push(l, "            let f = fill(w);")
    strs_push(l, "            if f.at <= 0 {")
    strs_push(l, "                ended = true;")
    strs_push(l, "                if f.at < 0 && timed_out(f.at) {")
    strs_push(l, "                    if str_len(pending) > 0 { answer_error(w, 408, \"the head did not arrive in time\"); }")
    strs_push(l, "                } else {")
    strs_push(l, "                    if f.at == 0 && str_len(trim_crlf(pending)) > 0 { answer_error(w, 400, \"the connection ended inside a head\"); }")
    strs_push(l, "                }")
    strs_push(l, "            } else {")
    strs_push(l, "                atomic_store(c.state, 1);")
    strs_push(l, "                pending = str_concat(pending, f.value);")
    strs_push(l, "                head = find_head(pending, head.at, o.max_head);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if ended { return served; }")
    strs_push(l, "        if head.status != 0 {")
    strs_push(l, "            answer_error(w, head.status, head.why);")
    strs_push(l, "            return served;")
    strs_push(l, "        }")
    strs_push(l, "        let parsed = parse_request_head(head.value, o);")
    strs_push(l, "        let r = match parsed {")
    strs_push(l, "            Result.Ok(value: r) => r,")
    strs_push(l, "            Result.Err(error: e) => {")
    strs_push(l, "                match e {")
    strs_push(l, "                    HttpError.Protocol(status: st, why: why) => { answer_error(w, st, why); },")
    strs_push(l, "                    HttpError.Io(error: x) => {},")
    strs_push(l, "                    HttpError.Unsupported(why: why) => { answer_error(w, 501, why); },")
    strs_push(l, "                    HttpError.Tls(error: x) => {},")
    strs_push(l, "                };")
    strs_push(l, "                return served;")
    strs_push(l, "            },")
    strs_push(l, "        };")
    strs_push(l, "        let n = match framing(r.headers, r.version == \"HTTP/1.0\", o.max_body) {")
    strs_push(l, "            Result.Ok(value: n) => n,")
    strs_push(l, "            Result.Err(error: e) => { return served; },")
    strs_push(l, "        };")
    strs_push(l, "        // Expect: 100-continue, answered before a body the client is holding back.")
    strs_push(l, "        let expects = http_header_all(r.headers, \"expect\");")
    strs_push(l, "        if strs_len(expects) > 0 {")
    strs_push(l, "            if strs_len(expects) != 1 || lower(strs_get(expects, 0)) != \"100-continue\" {")
    strs_push(l, "                answer_error(w, 417, \"an expectation this server does not meet\");")
    strs_push(l, "                return served;")
    strs_push(l, "            }")
    strs_push(l, "            if r.version == \"HTTP/1.1\" && n != 0 && str_len(pending) == head.at {")
    strs_push(l, "                if send(w, str_concat(str_concat(\"HTTP/1.1 100 Continue\", crlf()), crlf())) < 0 { return served; }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        // The body.")
    strs_push(l, "        let mut body = body_of(pending, head.at, n, o.max_body, o.max_headers);")
    strs_push(l, "        let mut so_far = \"\";")
    strs_push(l, "        while body.status == 1 || body.status == 2 {")
    strs_push(l, "            if o.body_timeout_ms != wait { set_wait(w, o.body_timeout_ms); wait = o.body_timeout_ms; }")
    strs_push(l, "            let f = fill(w);")
    strs_push(l, "            if f.at <= 0 {")
    strs_push(l, "                if f.at < 0 && timed_out(f.at) { answer_error(w, 408, \"the body did not arrive in time\"); }")
    strs_push(l, "                return served;")
    strs_push(l, "            }")
    strs_push(l, "            pending = str_concat(pending, f.value);")
    strs_push(l, "            if body.status == 2 {")
    strs_push(l, "                so_far = body.value;")
    strs_push(l, "                body = chunked(pending, body.at, so_far, o.max_body, o.max_headers);")
    strs_push(l, "            } else {")
    strs_push(l, "                body = body_of(pending, head.at, n, o.max_body, o.max_headers);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if body.status != 0 {")
    strs_push(l, "            answer_error(w, body.status, body.why);")
    strs_push(l, "            return served;")
    strs_push(l, "        }")
    strs_push(l, "        pending = str_slice(pending, body.at, str_len(pending));")
    strs_push(l, "        let req = Request(method: r.method, target: r.target, path: r.path, query: r.query, version: r.version, headers: r.headers, body: body.value, params: \"\", peer: peer);")
    strs_push(l, "        let resp = h(req);")
    strs_push(l, "        served = served + 1;")
    strs_push(l, "        atomic_add(s.served, 1);")
    strs_push(l, "        let close = http_header_has_token(r.headers, \"connection\", \"close\") || (r.version == \"HTTP/1.0\" && !http_header_has_token(r.headers, \"connection\", \"keep-alive\")) || atomic_load(s.draining) != 0 || (o.max_requests > 0 && served >= o.max_requests);")
    strs_push(l, "        let out = if !close && r.version == \"HTTP/1.0\" { http_with_header(resp, \"connection\", \"keep-alive\") } else { resp };")
    strs_push(l, "        let text = match http_format_response(out, r.method == \"HEAD\", close) {")
    strs_push(l, "            Result.Ok(value: t) => t,")
    strs_push(l, "            Result.Err(error: e) => {")
    strs_push(l, "                answer_error(w, 500, http_error_show(e));")
    strs_push(l, "                return served;")
    strs_push(l, "            },")
    strs_push(l, "        };")
    strs_push(l, "        if o.write_timeout_ms != wait { set_wait(w, o.write_timeout_ms); wait = o.write_timeout_ms; }")
    strs_push(l, "        if send(w, text) < 0 { return served; }")
    strs_push(l, "        // Idle again, unless a pipelined request is already here; a drain that began meanwhile")
    strs_push(l, "        // either sees it idle and closes it, or is seen here.")
    strs_push(l, "        atomic_store(c.state, if str_len(pending) > 0 { 1 } else { 0 });")
    strs_push(l, "        if close || (str_len(pending) == 0 && atomic_load(s.draining) != 0) { open = false; }")
    strs_push(l, "    }")
    strs_push(l, "    served")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn timed_out(status: Int) -> Bool ! {} {")
    strs_push(l, "    io_kind_name(io_kind_of(status)) == \"TimedOut\"")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn trim_crlf(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut a = 0;")
    strs_push(l, "    while a < str_len(s) && (str_byte(s, a) == 13 || str_byte(s, a) == 10) { a = a + 1; }")
    strs_push(l, "    str_slice(s, a, str_len(s))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Accept connections on `s` until it drains, each served in a task of its own by the HTTP/1.1")
    strs_push(l, "/// loop; the requests they read are answered by `h`, called on this task, in the order they")
    strs_push(l, "/// arrive. Answers the requests served and connections accepted. For handlers that run in")
    strs_push(l, "/// parallel, spawn `http_serve_conn` per connection instead (a task may not be given a function).")
    strs_push(l, "pub fn http_serve(tasks: SpawnCap, s: HttpServer, h: fn(Request) -> Response ! { io }) -> Result[ServeStats, IoError] ! { io, spawn } {")
    strs_push(l, "    let inbox = chan_new_of[Pending](64);")
    strs_push(l, "    let got = vec_new[Pending]();")
    strs_push(l, "    scope {")
    strs_push(l, "        spawn accept_loop(tasks, s, inbox);")
    strs_push(l, "        while chan_recv_of(inbox, got) {")
    strs_push(l, "            let p = vec_pop(got);")
    strs_push(l, "            chan_send_of(p.reply, h(p.request));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[ServeStats, IoError].Ok(value: ServeStats(requests: atomic_load(s.served), connections: atomic_load(s.accepted)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn accept_loop(tasks: SpawnCap, s: HttpServer, inbox: Chan[Pending]) -> Int ! { io, spawn } {")
    strs_push(l, "    let mut running = true;")
    strs_push(l, "    scope {")
    strs_push(l, "        while running {")
    strs_push(l, "            match http_accept(s) {")
    strs_push(l, "                Result.Ok(value: c) => { spawn dispatched(s, c, inbox); },")
    strs_push(l, "                Result.Err(error: e) => {")
    strs_push(l, "                    if atomic_load(s.draining) != 0 || io_kind_name(e.kind) == \"Closed\" { running = false; }")
    strs_push(l, "                },")
    strs_push(l, "            };")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    chan_close_of(inbox);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn dispatched(s: HttpServer, c: HttpConn, inbox: Chan[Pending]) -> Int ! { io } {")
    strs_push(l, "    let ask = fn(r: Request) -> Response ! { io } {")
    strs_push(l, "        let reply = chan_new_of[Response](1);")
    strs_push(l, "        let got = vec_new[Response]();")
    strs_push(l, "        if chan_send_of(inbox, Pending(request: r, reply: reply)) && chan_recv_of(reply, got) { vec_pop(got) } else { http_text(503, \"the server is stopping\") }")
    strs_push(l, "    };")
    strs_push(l, "    http_serve_conn(s, c, ask)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The router")
    strs_push(l, "")
    strs_push(l, "/// A router with no routes: every request is `NotFound`.")
    strs_push(l, "pub fn http_router() -> Router ! {} {")
    strs_push(l, "    Router(step: fn(r: Request) -> Routed ! { io } { Routed.NotFound() })")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `rt` with a route for `method` (`\"\"`: any) and `pattern` answered by `h`. A pattern is a path")
    strs_push(l, "/// of segments: a literal matches itself, `{name}` one non-empty segment (read with `http_param`,")
    strs_push(l, "/// decoded), and a final `*` the rest of the path (`http_param(r, \"*\")`). A GET route answers HEAD.")
    strs_push(l, "pub fn http_route(rt: Router, method: Str, pattern: Str, h: fn(Request) -> Response ! { io }) -> Router ! {} {")
    strs_push(l, "    let prev = rt.step;")
    strs_push(l, "    Router(step: fn(r: Request) -> Routed ! { io } {")
    strs_push(l, "        let p = prev(r);")
    strs_push(l, "        let tried = match p {")
    strs_push(l, "            Routed.Answered(response: x) => 0,")
    strs_push(l, "            Routed.NotAllowed(allow: a) => 1,")
    strs_push(l, "            Routed.NotFound() => 2,")
    strs_push(l, "        };")
    strs_push(l, "        if tried == 0 { return p; }")
    strs_push(l, "        let m = route_match(pattern, r.path);")
    strs_push(l, "        if m.status != 0 { return p; }")
    strs_push(l, "        if str_len(method) == 0 || r.method == method || (method == \"GET\" && r.method == \"HEAD\") {")
    strs_push(l, "            return Routed.Answered(response: h(Request(method: r.method, target: r.target, path: r.path, query: r.query, version: r.version, headers: r.headers, body: r.body, params: m.value, peer: r.peer)));")
    strs_push(l, "        }")
    strs_push(l, "        match p {")
    strs_push(l, "            Routed.NotAllowed(allow: a) => Routed.NotAllowed(allow: str_concat(str_concat(a, \", \"), method)),")
    strs_push(l, "            Routed.Answered(response: x) => p,")
    strs_push(l, "            Routed.NotFound() => Routed.NotAllowed(allow: method),")
    strs_push(l, "        }")
    strs_push(l, "    })")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `http_route(rt, \"GET\", pattern, h)`.")
    strs_push(l, "pub fn http_router_get(rt: Router, pattern: Str, h: fn(Request) -> Response ! { io }) -> Router ! {} {")
    strs_push(l, "    http_route(rt, \"GET\", pattern, h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `http_route(rt, \"POST\", pattern, h)`.")
    strs_push(l, "pub fn http_router_post(rt: Router, pattern: Str, h: fn(Request) -> Response ! { io }) -> Router ! {} {")
    strs_push(l, "    http_route(rt, \"POST\", pattern, h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `rt` makes of `r`.")
    strs_push(l, "pub fn http_router_find(rt: Router, r: Request) -> Routed ! { io } {")
    strs_push(l, "    let step = rt.step;")
    strs_push(l, "    step(r)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A handler answering through `rt`: 404 for no route, 405 with `allow` for a path routed for")
    strs_push(l, "/// other methods only.")
    strs_push(l, "pub fn http_router_handler(rt: Router) -> fn(Request) -> Response ! { io } ! {} {")
    strs_push(l, "    fn(r: Request) -> Response ! { io } {")
    strs_push(l, "        match http_router_find(rt, r) {")
    strs_push(l, "            Routed.Answered(response: x) => x,")
    strs_push(l, "            Routed.NotAllowed(allow: a) => http_with_header(http_text(405, str_concat(\"method not allowed\", lf())), \"allow\", a),")
    strs_push(l, "            Routed.NotFound() => http_text(404, str_concat(\"not found\", lf())),")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Whether `path` matches `pattern`: `value` holds the parameters.")
    strs_push(l, "fn route_match(pattern: Str, path: Str) -> Step ! {} {")
    strs_push(l, "    if str_len(path) == 0 || str_byte(path, 0) != 47 || str_len(pattern) == 0 || str_byte(pattern, 0) != 47 { return refuse(404, \"\"); }")
    strs_push(l, "    let params = strs_new();")
    strs_push(l, "    let mut pi = 1;")
    strs_push(l, "    let mut si = 1;")
    strs_push(l, "    while true {")
    strs_push(l, "        let pe0 = find_byte(pattern, 47, pi);")
    strs_push(l, "        let pe = if pe0 < 0 { str_len(pattern) } else { pe0 };")
    strs_push(l, "        let seg = str_slice(pattern, pi, pe);")
    strs_push(l, "        if seg == \"*\" && pe == str_len(pattern) {")
    strs_push(l, "            match http_percent_decode(str_slice(path, si, str_len(path))) {")
    strs_push(l, "                Option.Some(value: v) => {")
    strs_push(l, "                    strs_push(params, param_piece(\"*\"));")
    strs_push(l, "                    strs_push(params, param_piece(v));")
    strs_push(l, "                    return done(str_join(params, \"\"), 0);")
    strs_push(l, "                },")
    strs_push(l, "                Option.None() => { return refuse(404, \"\"); },")
    strs_push(l, "            };")
    strs_push(l, "        }")
    strs_push(l, "        if si > str_len(path) { return refuse(404, \"\"); }")
    strs_push(l, "        let se0 = find_byte(path, 47, si);")
    strs_push(l, "        let se = if se0 < 0 { str_len(path) } else { se0 };")
    strs_push(l, "        let got = str_slice(path, si, se);")
    strs_push(l, "        if str_len(seg) >= 2 && str_byte(seg, 0) == 123 && str_byte(seg, str_len(seg) - 1) == 125 {")
    strs_push(l, "            if str_len(got) == 0 { return refuse(404, \"\"); }")
    strs_push(l, "            match http_percent_decode(got) {")
    strs_push(l, "                Option.Some(value: v) => {")
    strs_push(l, "                    strs_push(params, param_piece(str_slice(seg, 1, str_len(seg) - 1)));")
    strs_push(l, "                    strs_push(params, param_piece(v));")
    strs_push(l, "                },")
    strs_push(l, "                Option.None() => { return refuse(404, \"\"); },")
    strs_push(l, "            };")
    strs_push(l, "        } else {")
    strs_push(l, "            if seg != got { return refuse(404, \"\"); }")
    strs_push(l, "        }")
    strs_push(l, "        let p_end = pe == str_len(pattern);")
    strs_push(l, "        let s_end = se == str_len(path);")
    strs_push(l, "        if p_end && s_end { return done(str_join(params, \"\"), 0); }")
    strs_push(l, "        if p_end || s_end { return refuse(404, \"\"); }")
    strs_push(l, "        pi = pe + 1;")
    strs_push(l, "        si = se + 1;")
    strs_push(l, "    }")
    strs_push(l, "    refuse(404, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The client")
    strs_push(l, "")
    strs_push(l, "/// `url` taken apart: `http://` or `https://` (any case), a host — a name, an IPv4 literal or a")
    strs_push(l, "/// bracketed IPv6 one — an optional port (80 and 443 by default), and the target (`/` when")
    strs_push(l, "/// empty). `Protocol(400)` for anything else, and for userinfo or a fragment.")
    strs_push(l, "pub fn http_url_parse(url: Str) -> Result[Url, HttpError] ! {} {")
    strs_push(l, "    let low = lower(url);")
    strs_push(l, "    let scheme = if str_len(low) >= 7 && str_slice(low, 0, 7) == \"http://\" { \"http\" } else { if str_len(low) >= 8 && str_slice(low, 0, 8) == \"https://\" { \"https\" } else { \"\" } };")
    strs_push(l, "    if str_len(scheme) == 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a URL that is not http or https\")); }")
    strs_push(l, "    let start = str_len(scheme) + 3;")
    strs_push(l, "    let mut end = start;")
    strs_push(l, "    while end < str_len(url) && str_byte(url, end) != 47 && str_byte(url, end) != 63 && str_byte(url, end) != 35 { end = end + 1; }")
    strs_push(l, "    let authority = str_slice(url, start, end);")
    strs_push(l, "    let rest = str_slice(url, end, str_len(url));")
    strs_push(l, "    if find_byte(authority, 64, 0) >= 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"userinfo in a URL\")); }")
    strs_push(l, "    if find_byte(rest, 35, 0) >= 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a fragment in a URL\")); }")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(url) {")
    strs_push(l, "        let b = str_byte(url, i);")
    strs_push(l, "        if b <= 32 || b >= 127 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a URL with a byte a URI cannot hold\")); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let mut host = authority;")
    strs_push(l, "    let mut port_text = \"\";")
    strs_push(l, "    if str_len(authority) > 0 && str_byte(authority, 0) == 91 {")
    strs_push(l, "        let close = find_byte(authority, 93, 0);")
    strs_push(l, "        if close < 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"an IPv6 host without its bracket\")); }")
    strs_push(l, "        host = str_slice(authority, 0, close + 1);")
    strs_push(l, "        if close + 1 < str_len(authority) {")
    strs_push(l, "            if str_byte(authority, close + 1) != 58 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"text after an IPv6 host\")); }")
    strs_push(l, "            port_text = str_slice(authority, close + 2, str_len(authority));")
    strs_push(l, "        }")
    strs_push(l, "    } else {")
    strs_push(l, "        let colon = find_byte(authority, 58, 0);")
    strs_push(l, "        if colon >= 0 {")
    strs_push(l, "            host = str_slice(authority, 0, colon);")
    strs_push(l, "            port_text = str_slice(authority, colon + 1, str_len(authority));")
    strs_push(l, "            if str_len(port_text) == 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"an empty port\")); }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if str_len(host) == 0 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a URL without a host\")); }")
    strs_push(l, "    let port = if str_len(port_text) == 0 { if scheme == \"https\" { 443 } else { 80 } } else { parse_count(port_text) };")
    strs_push(l, "    if port < 1 || port > 65535 { return Result[Url, HttpError].Err(error: HttpError.Protocol(status: 400, why: \"a port outside 1 to 65535\")); }")
    strs_push(l, "    Result[Url, HttpError].Ok(value: Url(scheme: scheme, host: host, port: port, target: if str_len(rest) == 0 { \"/\" } else { if str_byte(rest, 0) == 63 { str_concat(\"/\", rest) } else { rest } }))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn authority_of(u: Url) -> Str ! {} {")
    strs_push(l, "    if (u.scheme == \"http\" && u.port == 80) || (u.scheme == \"https\" && u.port == 443) { u.host } else { str_concat(str_concat(u.host, \":\"), int_to_str(u.port)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_ipv4_literal(host: Str) -> Bool ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(host) {")
    strs_push(l, "        let b = str_byte(host, i);")
    strs_push(l, "        if !is_digit(b) && b != 46 { return false; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_len(host) > 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A connection to `url`'s host and port, for `http_send`. An `https` URL is TLS, its server")
    strs_push(l, "/// verified against the platform's trust store; `Io` for a name that does not resolve or a")
    strs_push(l, "/// connection refused, `Tls` for a server that cannot be verified.")
    strs_push(l, "pub fn http_connect(net: NetCap, url: Str, o: ClientOptions) -> Result[HttpClient, HttpError] ! { io } {")
    strs_push(l, "    connect_with(net, url, o, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `http_connect` with the TLS configuration `c` (`tls_client`) for an `https` URL — its own")
    strs_push(l, "/// anchors in place of the platform's store. `c` stays the caller's.")
    strs_push(l, "pub fn http_connect_tls(net: NetCap, url: Str, o: ClientOptions, c: TlsConfig) -> Result[HttpClient, HttpError] ! { io } {")
    strs_push(l, "    connect_with(net, url, o, c.id)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The ALPN names this module speaks.")
    strs_push(l, "fn http_alpn() -> Strs ! {} {")
    strs_push(l, "    let names = strs_new();")
    strs_push(l, "    strs_push(names, \"http/1.1\");")
    strs_push(l, "    names")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The host a certificate must name: the URL's, an IPv6 literal without its brackets.")
    strs_push(l, "fn cert_host(host: Str) -> Str ! {} {")
    strs_push(l, "    if str_len(host) > 1 && str_byte(host, 0) == 91 { str_slice(host, 1, str_len(host) - 1) } else { host }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A connection to `url`; over TLS for `https`, with configuration `cfg`, or the platform's store")
    strs_push(l, "// when it is `0`.")
    strs_push(l, "fn connect_with(net: NetCap, url: Str, o: ClientOptions, cfg: Int) -> Result[HttpClient, HttpError] ! { io } {")
    strs_push(l, "    let u = match http_url_parse(url) {")
    strs_push(l, "        Result.Ok(value: u) => u,")
    strs_push(l, "        Result.Err(error: e) => { return Result[HttpClient, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let addr = if str_byte(u.host, 0) == 91 || is_ipv4_literal(u.host) {")
    strs_push(l, "        str_concat(str_concat(u.host, \":\"), int_to_str(u.port))")
    strs_push(l, "    } else {")
    strs_push(l, "        match net_resolve(net, u.host, u.port) {")
    strs_push(l, "            Result.Ok(value: all) => {")
    strs_push(l, "                if strs_len(all) == 0 { return Result[HttpClient, HttpError].Err(error: HttpError.Io(error: io_context(io_error_new(IoErrorKind.NotFound(), \"no address\"), u.host))); }")
    strs_push(l, "                strs_get(all, 0)")
    strs_push(l, "            },")
    strs_push(l, "            Result.Err(error: e) => { return Result[HttpClient, HttpError].Err(error: HttpError.Io(error: e)); },")
    strs_push(l, "        }")
    strs_push(l, "    };")
    strs_push(l, "    match tcp_connect(net, addr, o.timeout_ms) {")
    strs_push(l, "        Result.Ok(value: s) => {")
    strs_push(l, "            tcp_set_timeout(s, o.timeout_ms);")
    strs_push(l, "            let pending = vec_new[Str]();")
    strs_push(l, "            vec_push(pending, \"\");")
    strs_push(l, "            let mut session = 0;")
    strs_push(l, "            if u.scheme == \"https\" {")
    strs_push(l, "                // No configuration given: the platform's trust store, for this connection alone.")
    strs_push(l, "                let own = if cfg != 0 { 0 } else {")
    strs_push(l, "                    match tls_client(bytes_new(0), http_alpn()) {")
    strs_push(l, "                        Result.Ok(value: c) => c.id,")
    strs_push(l, "                        Result.Err(error: e) => {")
    strs_push(l, "                            tcp_close(s);")
    strs_push(l, "                            return Result[HttpClient, HttpError].Err(error: HttpError.Tls(error: e));")
    strs_push(l, "                        },")
    strs_push(l, "                    }")
    strs_push(l, "                };")
    strs_push(l, "                let t = os_tls_connect(if cfg != 0 { cfg } else { own }, cert_host(u.host));")
    strs_push(l, "                if own != 0 { os_tls_close(own, bytes_new(0)); }")
    strs_push(l, "                let r = if t < 0 { t } else { tls_wire_handshake(s.handle, t) };")
    strs_push(l, "                if r < 0 {")
    strs_push(l, "                    let e = if t < 0 { tls_error_from(t, \"\") } else { tls_wire_error(t, r) };")
    strs_push(l, "                    if t > 0 { os_tls_close(t, bytes_new(0)); }")
    strs_push(l, "                    tcp_close(s);")
    strs_push(l, "                    return Result[HttpClient, HttpError].Err(error: HttpError.Tls(error: e));")
    strs_push(l, "                }")
    strs_push(l, "                session = t;")
    strs_push(l, "            }")
    strs_push(l, "            Result[HttpClient, HttpError].Ok(value: HttpClient(stream: s, authority: authority_of(u), options: o, pending: pending, tls: session))")
    strs_push(l, "        },")
    strs_push(l, "        Result.Err(error: e) => Result[HttpClient, HttpError].Err(error: HttpError.Io(error: e)),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Send `r` on `c` and read its response; the connection stays open for the next request unless")
    strs_push(l, "/// the response closes it. Interim (1xx) responses are skipped.")
    strs_push(l, "pub fn http_send(c: HttpClient, r: Request) -> Result[Response, HttpError] ! { io } {")
    strs_push(l, "    exchange(c, r, false)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn exchange(c: HttpClient, r: Request, close: Bool) -> Result[Response, HttpError] ! { io } {")
    strs_push(l, "    let text = match http_format_request(r, c.authority, close) {")
    strs_push(l, "        Result.Ok(value: t) => t,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let w = Wire(handle: c.stream.handle, tls: c.tls, buf: bytes_new(16384));")
    strs_push(l, "    let sent = send(w, text);")
    strs_push(l, "    if sent < 0 { return Result[Response, HttpError].Err(error: HttpError.Io(error: io_error_from(sent))); }")
    strs_push(l, "    let o = c.options;")
    strs_push(l, "    let mut pending = vec_get(c.pending, 0);")
    strs_push(l, "    while true {")
    strs_push(l, "        let mut head = find_head(pending, 0, o.max_head);")
    strs_push(l, "        while head.status == 1 {")
    strs_push(l, "            let f = fill(w);")
    strs_push(l, "            if f.at < 0 { return Result[Response, HttpError].Err(error: HttpError.Io(error: io_error_from(f.at))); }")
    strs_push(l, "            if f.at == 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"the connection ended before a response\")); }")
    strs_push(l, "            pending = str_concat(pending, f.value);")
    strs_push(l, "            head = find_head(pending, head.at, o.max_head);")
    strs_push(l, "        }")
    strs_push(l, "        if head.status != 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: head.why)); }")
    strs_push(l, "        let resp = match parse_response_head(head.value, o) {")
    strs_push(l, "            Result.Ok(value: x) => x,")
    strs_push(l, "            Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "        };")
    strs_push(l, "        if resp.status == 101 { return Result[Response, HttpError].Err(error: HttpError.Unsupported(why: \"a protocol switch\")); }")
    strs_push(l, "        if resp.status >= 100 && resp.status < 200 {")
    strs_push(l, "            pending = str_slice(pending, head.at, str_len(pending));")
    strs_push(l, "        } else {")
    strs_push(l, "            let n = match response_framing(resp, r.method, o.max_body) {")
    strs_push(l, "                Result.Ok(value: n) => n,")
    strs_push(l, "                Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "            };")
    strs_push(l, "            let mut body = if n == 0 - 2 { done(\"\", head.at) } else { if n == 0 - 3 { more() } else { body_of(pending, head.at, n, o.max_body, o.max_headers) } };")
    strs_push(l, "            let mut eof = false;")
    strs_push(l, "            while body.status == 1 || body.status == 2 {")
    strs_push(l, "                let f = fill(w);")
    strs_push(l, "                if f.at < 0 { return Result[Response, HttpError].Err(error: HttpError.Io(error: io_error_from(f.at))); }")
    strs_push(l, "                if f.at == 0 { eof = true; }")
    strs_push(l, "                if !eof { pending = str_concat(pending, f.value); }")
    strs_push(l, "                if n == 0 - 3 {")
    strs_push(l, "                    if str_len(pending) - head.at > o.max_body { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"the body is too large\")); }")
    strs_push(l, "                    if eof { body = done(str_slice(pending, head.at, str_len(pending)), str_len(pending)); }")
    strs_push(l, "                } else {")
    strs_push(l, "                    if eof { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"the connection ended inside a body\")); }")
    strs_push(l, "                    if body.status == 2 { body = chunked(pending, body.at, body.value, o.max_body, o.max_headers); } else { body = body_of(pending, head.at, n, o.max_body, o.max_headers); }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            if body.status != 0 { return Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: body.why)); }")
    strs_push(l, "            vec_set(c.pending, 0, str_slice(pending, body.at, str_len(pending)));")
    strs_push(l, "            return Result[Response, HttpError].Ok(value: Response(status: resp.status, headers: resp.headers, body: body.value));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Result[Response, HttpError].Err(error: HttpError.Protocol(status: 502, why: \"no response\"))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `c`.")
    strs_push(l, "pub fn http_close(c: HttpClient) -> Int ! { io } {")
    strs_push(l, "    if c.tls != 0 { tls_wire_close(c.stream.handle, c.tls); }")
    strs_push(l, "    tcp_close(c.stream);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One request — `method` to `url` with `body` — on a connection of its own, closed after it.")
    strs_push(l, "pub fn http_fetch(net: NetCap, method: Str, url: Str, body: Str, o: ClientOptions) -> Result[Response, HttpError] ! { io } {")
    strs_push(l, "    let c = match http_connect(net, url, o) {")
    strs_push(l, "        Result.Ok(value: c) => c,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let u = match http_url_parse(url) {")
    strs_push(l, "        Result.Ok(value: u) => u,")
    strs_push(l, "        Result.Err(error: e) => { return Result[Response, HttpError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let r = exchange(c, http_request(method, u.target, body), true);")
    strs_push(l, "    http_close(c);")
    strs_push(l, "    r")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `http_fetch(net, \"GET\", url, \"\", o)`.")
    strs_push(l, "pub fn http_get(net: NetCap, url: Str, o: ClientOptions) -> Result[Response, HttpError] ! { io } {")
    strs_push(l, "    http_fetch(net, \"GET\", url, \"\", o)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_io() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/io`: output with a newline, reading a file as a `Result`, and (Gate 2) standard input.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/io\";`. Every function here needs an `IoCap` and says so: it takes")
    strs_push(l, "// one, and its effect set is `{ io }`, so a caller's authority is as visible as it would be")
    strs_push(l, "// calling the built-ins directly. What a function here reads carries the built-ins' origins —")
    strs_push(l, "// a file's contents are `file` — because they are ordinary calls the checker follows.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "")
    strs_push(l, "/// `s` and a newline on standard output; the byte count.")
    strs_push(l, "pub fn io_println(io: IoCap, s: Str) -> Int ! { io } {")
    strs_push(l, "    print(str_concat(s, str_from_byte(10)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` and a newline on standard error; the byte count.")
    strs_push(l, "pub fn io_eprintln(io: IoCap, s: Str) -> Int ! { io } {")
    strs_push(l, "    eprint(str_concat(s, str_from_byte(10)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The contents of the file at `path`, or an `Err` when there is no such file. A file that")
    strs_push(l, "/// exists and still cannot be read is `read_file`'s failure, `N0407`: the check and the read")
    strs_push(l, "/// are two steps, and the language has no way to make them one.")
    strs_push(l, "pub fn io_read(io: IoCap, path: Str) -> Result[Str, Str] ! { io } {")
    strs_push(l, "    if file_exists(path) {")
    strs_push(l, "        Result[Str, Str].Ok(value: read_file(path))")
    strs_push(l, "    } else {")
    strs_push(l, "        Result[Str, Str].Err(error: str_concat(\"no such file: \", path))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Everything on standard input, to its end (Gate 2). On the task pool the read holds the task's")
    strs_push(l, "/// worker until the system answers.")
    strs_push(l, "pub fn io_stdin_read_all(io: IoCap) -> Result[Bytes, IoError] ! { io } {")
    strs_push(l, "    let h = os_stdin();")
    strs_push(l, "    let chunk = bytes_new(65536);")
    strs_push(l, "    let parts = vec_new[Bytes]();")
    strs_push(l, "    let mut total = 0;")
    strs_push(l, "    let mut n = os_read(h, chunk);")
    strs_push(l, "    while n > 0 {")
    strs_push(l, "        let part = bytes_new(n);")
    strs_push(l, "        bytes_copy(part, bytes_slice(chunk, 0, n));")
    strs_push(l, "        vec_push(parts, part);")
    strs_push(l, "        total = total + n;")
    strs_push(l, "        n = os_read(h, chunk);")
    strs_push(l, "    }")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        return Result[Bytes, IoError].Err(error: io_context(io_error_from(n), \"standard input\"));")
    strs_push(l, "    }")
    strs_push(l, "    let all = bytes_new(total);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(parts) {")
    strs_push(l, "        let part = vec_get(parts, i);")
    strs_push(l, "        bytes_copy(bytes_slice(all, at, at + bytes_len(part)), part);")
    strs_push(l, "        at = at + bytes_len(part);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Bytes, IoError].Ok(value: all)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Standard input's lines, without their newlines; a last line without one is still a line.")
    strs_push(l, "pub fn io_stdin_lines(io: IoCap) -> Result[Strs, IoError] ! { io } {")
    strs_push(l, "    let all = io_stdin_read_all(io)?;")
    strs_push(l, "    let text = bytes_to_str(all);")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(text) {")
    strs_push(l, "        if str_byte(text, i) == 10 {")
    strs_push(l, "            strs_push(out, str_slice(text, start, i));")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if start < str_len(text) {")
    strs_push(l, "        strs_push(out, str_slice(text, start, str_len(text)));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Strs, IoError].Ok(value: out)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What standard input holds, at most `bytes_len(buf)` bytes into `buf` (R1d, P3): how many, `0`")
    strs_push(l, "/// at the end. This and the line reads below take from one buffer, so neither loses what the")
    strs_push(l, "/// other leaves.")
    strs_push(l, "pub fn io_stdin_read(io: IoCap, buf: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let n = os_read(os_stdin(), buf);")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        return Result[Int, IoError].Err(error: io_context(io_error_from(n), \"standard input\"));")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: n)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Exactly `bytes_len(buf)` bytes of standard input into `buf` (R1d, P3) — a frame whose length a")
    strs_push(l, "/// header gave; `UnexpectedEof` if standard input ends first.")
    strs_push(l, "pub fn io_stdin_read_exact(io: IoCap, buf: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let h = os_stdin();")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(buf) {")
    strs_push(l, "        let n = os_read(h, bytes_slice(buf, at, bytes_len(buf)));")
    strs_push(l, "        if n < 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_context(io_error_from(n), \"standard input\"));")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_new(IoErrorKind.UnexpectedEof(), \"standard input ended\"));")
    strs_push(l, "        }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Standard input's next line, without its newline (R1d, P3); `None` at the end. A last line")
    strs_push(l, "/// without a newline is still a line, and a carriage return before the newline is kept. Nothing")
    strs_push(l, "/// after the line is taken, so a frame that follows a header is still there to read.")
    strs_push(l, "pub fn io_stdin_read_line(io: IoCap) -> Result[Option[Str], IoError] ! { io } {")
    strs_push(l, "    let h = os_stdin();")
    strs_push(l, "    let chunk = bytes_new(4096);")
    strs_push(l, "    let mut line = \"\";")
    strs_push(l, "    let mut read = 0;")
    strs_push(l, "    let mut going = true;")
    strs_push(l, "    while going {")
    strs_push(l, "        let n = os_read_line(h, chunk);")
    strs_push(l, "        if n < 0 {")
    strs_push(l, "            return Result[Option[Str], IoError].Err(error: io_context(io_error_from(n), \"standard input\"));")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 {")
    strs_push(l, "            going = false;")
    strs_push(l, "        } else {")
    strs_push(l, "            read = read + n;")
    strs_push(l, "            if bytes_get(chunk, n - 1) == 10 {")
    strs_push(l, "                line = str_concat(line, bytes_to_str(bytes_slice(chunk, 0, n - 1)));")
    strs_push(l, "                return Result[Option[Str], IoError].Ok(value: Option[Str].Some(value: line));")
    strs_push(l, "            }")
    strs_push(l, "            line = str_concat(line, bytes_to_str(bytes_slice(chunk, 0, n)));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if read == 0 {")
    strs_push(l, "        return Result[Option[Str], IoError].Ok(value: Option[Str].None());")
    strs_push(l, "    }")
    strs_push(l, "    Result[Option[Str], IoError].Ok(value: Option[Str].Some(value: line))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_ioerror() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/ioerror`: what went wrong outside the program, as a value (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/ioerror\";`. A built-in that reaches the operating system answers a")
    strs_push(l, "// failure as a status, `-errno`, whose number is the platform's. This module turns one into an")
    strs_push(l, "// `IoError` whose `kind` is the same on every platform — the table from number to kind for each")
    strs_push(l, "// family of platforms is here, in one place — with the system's number and message beside it and")
    strs_push(l, "// what the program was doing, which `io_context` adds. `docs/internal/general-purpose.md` §8 and §13.")
    strs_push(l, "")
    strs_push(l, "/// What kind of failure, the same on every platform.")
    strs_push(l, "pub enum IoErrorKind {")
    strs_push(l, "    NotFound,")
    strs_push(l, "    PermissionDenied,")
    strs_push(l, "    AlreadyExists,")
    strs_push(l, "    WouldBlock,")
    strs_push(l, "    InvalidInput,")
    strs_push(l, "    TimedOut,")
    strs_push(l, "    Interrupted,")
    strs_push(l, "    UnexpectedEof,")
    strs_push(l, "    ConnectionRefused,")
    strs_push(l, "    ConnectionReset,")
    strs_push(l, "    AddressInUse,")
    strs_push(l, "    AddressNotAvailable,")
    strs_push(l, "    BrokenPipe,")
    strs_push(l, "    NotConnected,")
    strs_push(l, "    IsADirectory,")
    strs_push(l, "    NotADirectory,")
    strs_push(l, "    DirectoryNotEmpty,")
    strs_push(l, "    Closed,")
    strs_push(l, "    Cancelled,")
    strs_push(l, "    Other,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A failure: its kind, the system's number (`0` for one the program decided), the system's")
    strs_push(l, "/// message, and what the program was doing, innermost first, joined by `: `.")
    strs_push(l, "pub struct IoError {")
    strs_push(l, "    kind: IoErrorKind,")
    strs_push(l, "    code: Int,")
    strs_push(l, "    message: Str,")
    strs_push(l, "    context: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// macOS's numbers.")
    strs_push(l, "fn darwin_kind(e: Int) -> IoErrorKind ! {} {")
    strs_push(l, "    if e == 2 { return IoErrorKind.NotFound(); }")
    strs_push(l, "    if e == 1 || e == 13 { return IoErrorKind.PermissionDenied(); }")
    strs_push(l, "    if e == 17 { return IoErrorKind.AlreadyExists(); }")
    strs_push(l, "    if e == 35 { return IoErrorKind.WouldBlock(); }")
    strs_push(l, "    if e == 22 || e == 63 { return IoErrorKind.InvalidInput(); }")
    strs_push(l, "    if e == 60 { return IoErrorKind.TimedOut(); }")
    strs_push(l, "    if e == 4 { return IoErrorKind.Interrupted(); }")
    strs_push(l, "    if e == 61 { return IoErrorKind.ConnectionRefused(); }")
    strs_push(l, "    if e == 54 { return IoErrorKind.ConnectionReset(); }")
    strs_push(l, "    if e == 48 { return IoErrorKind.AddressInUse(); }")
    strs_push(l, "    if e == 49 { return IoErrorKind.AddressNotAvailable(); }")
    strs_push(l, "    if e == 32 { return IoErrorKind.BrokenPipe(); }")
    strs_push(l, "    if e == 57 { return IoErrorKind.NotConnected(); }")
    strs_push(l, "    if e == 21 { return IoErrorKind.IsADirectory(); }")
    strs_push(l, "    if e == 20 { return IoErrorKind.NotADirectory(); }")
    strs_push(l, "    if e == 66 { return IoErrorKind.DirectoryNotEmpty(); }")
    strs_push(l, "    if e == 89 { return IoErrorKind.Cancelled(); }")
    strs_push(l, "    IoErrorKind.Other()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Linux's numbers.")
    strs_push(l, "fn linux_kind(e: Int) -> IoErrorKind ! {} {")
    strs_push(l, "    if e == 2 { return IoErrorKind.NotFound(); }")
    strs_push(l, "    if e == 1 || e == 13 { return IoErrorKind.PermissionDenied(); }")
    strs_push(l, "    if e == 17 { return IoErrorKind.AlreadyExists(); }")
    strs_push(l, "    if e == 11 { return IoErrorKind.WouldBlock(); }")
    strs_push(l, "    if e == 22 || e == 36 { return IoErrorKind.InvalidInput(); }")
    strs_push(l, "    if e == 110 { return IoErrorKind.TimedOut(); }")
    strs_push(l, "    if e == 4 { return IoErrorKind.Interrupted(); }")
    strs_push(l, "    if e == 111 { return IoErrorKind.ConnectionRefused(); }")
    strs_push(l, "    if e == 104 { return IoErrorKind.ConnectionReset(); }")
    strs_push(l, "    if e == 98 { return IoErrorKind.AddressInUse(); }")
    strs_push(l, "    if e == 99 { return IoErrorKind.AddressNotAvailable(); }")
    strs_push(l, "    if e == 32 { return IoErrorKind.BrokenPipe(); }")
    strs_push(l, "    if e == 107 { return IoErrorKind.NotConnected(); }")
    strs_push(l, "    if e == 21 { return IoErrorKind.IsADirectory(); }")
    strs_push(l, "    if e == 20 { return IoErrorKind.NotADirectory(); }")
    strs_push(l, "    if e == 39 { return IoErrorKind.DirectoryNotEmpty(); }")
    strs_push(l, "    if e == 125 { return IoErrorKind.Cancelled(); }")
    strs_push(l, "    IoErrorKind.Other()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The kind of `status` on this platform; `Other` for one that is not negative.")
    strs_push(l, "pub fn io_kind_of(status: Int) -> IoErrorKind ! {} {")
    strs_push(l, "    if status >= 0 {")
    strs_push(l, "        return IoErrorKind.Other();")
    strs_push(l, "    }")
    strs_push(l, "    // A handle that is closed: the runtime's status, no system's number.")
    strs_push(l, "    if status == 0 - 65536 {")
    strs_push(l, "        return IoErrorKind.Closed();")
    strs_push(l, "    }")
    strs_push(l, "    // A name the resolver did not answer: the runtime's status too.")
    strs_push(l, "    if status == 0 - 65537 {")
    strs_push(l, "        return IoErrorKind.NotFound();")
    strs_push(l, "    }")
    strs_push(l, "    if os_family() == 0 { darwin_kind(0 - status) } else { linux_kind(0 - status) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The error `status` is: its kind, number and the system's message.")
    strs_push(l, "pub fn io_error_from(status: Int) -> IoError ! {} {")
    strs_push(l, "    IoError(kind: io_kind_of(status), code: 0 - status, message: os_error_text(status), context: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An error the program decided, with no system number: an early end of a file, a deadline.")
    strs_push(l, "pub fn io_error_new(kind: IoErrorKind, message: Str) -> IoError ! {} {")
    strs_push(l, "    IoError(kind: kind, code: 0, message: message, context: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `e`, saying what the program was doing; contexts read outermost first.")
    strs_push(l, "pub fn io_context(e: IoError, doing: Str) -> IoError ! {} {")
    strs_push(l, "    let context = if str_len(e.context) == 0 { doing } else { str_concat(doing, str_concat(\": \", e.context)) };")
    strs_push(l, "    IoError(kind: e.kind, code: e.code, message: e.message, context: context)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `Ok(status)` for a status that is not negative, the error it is otherwise.")
    strs_push(l, "pub fn io_result(status: Int) -> Result[Int, IoError] ! {} {")
    strs_push(l, "    if status >= 0 { Result[Int, IoError].Ok(value: status) } else { Result[Int, IoError].Err(error: io_error_from(status)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A kind's name, as written in `IoErrorKind`.")
    strs_push(l, "pub fn io_kind_name(k: IoErrorKind) -> Str ! {} {")
    strs_push(l, "    match k {")
    strs_push(l, "        IoErrorKind.NotFound() => \"NotFound\",")
    strs_push(l, "        IoErrorKind.PermissionDenied() => \"PermissionDenied\",")
    strs_push(l, "        IoErrorKind.AlreadyExists() => \"AlreadyExists\",")
    strs_push(l, "        IoErrorKind.WouldBlock() => \"WouldBlock\",")
    strs_push(l, "        IoErrorKind.InvalidInput() => \"InvalidInput\",")
    strs_push(l, "        IoErrorKind.TimedOut() => \"TimedOut\",")
    strs_push(l, "        IoErrorKind.Interrupted() => \"Interrupted\",")
    strs_push(l, "        IoErrorKind.UnexpectedEof() => \"UnexpectedEof\",")
    strs_push(l, "        IoErrorKind.ConnectionRefused() => \"ConnectionRefused\",")
    strs_push(l, "        IoErrorKind.ConnectionReset() => \"ConnectionReset\",")
    strs_push(l, "        IoErrorKind.AddressInUse() => \"AddressInUse\",")
    strs_push(l, "        IoErrorKind.AddressNotAvailable() => \"AddressNotAvailable\",")
    strs_push(l, "        IoErrorKind.BrokenPipe() => \"BrokenPipe\",")
    strs_push(l, "        IoErrorKind.NotConnected() => \"NotConnected\",")
    strs_push(l, "        IoErrorKind.IsADirectory() => \"IsADirectory\",")
    strs_push(l, "        IoErrorKind.NotADirectory() => \"NotADirectory\",")
    strs_push(l, "        IoErrorKind.DirectoryNotEmpty() => \"DirectoryNotEmpty\",")
    strs_push(l, "        IoErrorKind.Closed() => \"Closed\",")
    strs_push(l, "        IoErrorKind.Cancelled() => \"Cancelled\",")
    strs_push(l, "        IoErrorKind.Other() => \"Other\",")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `e` as one line: its context, then its message, then its kind.")
    strs_push(l, "pub fn io_error_show(e: IoError) -> Str ! {} {")
    strs_push(l, "    let what = str_concat(e.message, str_concat(\" (\", str_concat(io_kind_name(e.kind), \")\")));")
    strs_push(l, "    if str_len(e.context) == 0 { what } else { str_concat(e.context, str_concat(\": \", what)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The error a C library left in `errno` (read with `c_errno()`): its kind on this platform, its")
    strs_push(l, "/// number and the system's message (Gate 2, §13).")
    strs_push(l, "pub fn io_error_from_errno(errno: Int) -> IoError ! {} {")
    strs_push(l, "    io_error_from(0 - errno)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_json() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/json`: JSON text, parsed into a document and encoded back.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/json\";`. A value cannot own itself through a `Vec` (`N0359`), so a")
    strs_push(l, "// document is an arena: every value is a node in one `Vec`, and an array's or an object's children")
    strs_push(l, "// are a run of node indices in `kids`. A node is named by its index. Numbers are integers, as")
    strs_push(l, "// Nazm's are: a fraction or an exponent is refused, by name. Parsing never traps: malformed text is")
    strs_push(l, "// an `Err` naming the byte offset where it went wrong. (Gate 2) `json_parse_floats` reads a number")
    strs_push(l, "// with a fraction or an exponent as a `Float64` node, which `json_kind` calls a `number` too; and")
    strs_push(l, "// `json_encode_pretty` writes a document indented.")
    strs_push(l, "")
    strs_push(l, "/// One value: its kind, and what that kind holds. An array's elements, or an object's keys and")
    strs_push(l, "/// values alternately, are `count` entries of `kids` from `first`.")
    strs_push(l, "pub struct JsonNode {")
    strs_push(l, "    kind: Int,")
    strs_push(l, "    num: Int,")
    strs_push(l, "    text: Str,")
    strs_push(l, "    first: Int,")
    strs_push(l, "    count: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A document: its nodes, the runs of children they point into, and which node is the root.")
    strs_push(l, "pub struct JsonDoc {")
    strs_push(l, "    nodes: Vec[JsonNode],")
    strs_push(l, "    kids: Ints,")
    strs_push(l, "    root: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Kinds, by number.")
    strs_push(l, "fn k_null() -> Int ! {} { 0 }")
    strs_push(l, "fn k_false() -> Int ! {} { 1 }")
    strs_push(l, "fn k_true() -> Int ! {} { 2 }")
    strs_push(l, "fn k_num() -> Int ! {} { 3 }")
    strs_push(l, "fn k_str() -> Int ! {} { 4 }")
    strs_push(l, "fn k_arr() -> Int ! {} { 5 }")
    strs_push(l, "fn k_obj() -> Int ! {} { 6 }")
    strs_push(l, "// A number with a fraction or an exponent (Gate 2): its `Float64`'s bits in `num`.")
    strs_push(l, "fn k_float() -> Int ! {} { 7 }")
    strs_push(l, "")
    strs_push(l, "/// An empty document whose root is a `null` node, for building one.")
    strs_push(l, "pub fn json_new() -> JsonDoc ! {} {")
    strs_push(l, "    let nodes = vec_new[JsonNode]();")
    strs_push(l, "    vec_push(nodes, JsonNode(kind: k_null(), num: 0, text: \"\", first: 0, count: 0));")
    strs_push(l, "    JsonDoc(nodes: nodes, kids: ints_new(), root: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `doc`, with `node` as its root.")
    strs_push(l, "pub fn json_with_root(doc: JsonDoc, node: Int) -> JsonDoc ! {} {")
    strs_push(l, "    JsonDoc(nodes: doc.nodes, kids: doc.kids, root: node)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The root node of `doc`.")
    strs_push(l, "pub fn json_root(doc: JsonDoc) -> Int ! {} {")
    strs_push(l, "    doc.root")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn add(doc: JsonDoc, n: JsonNode) -> Int ! {} {")
    strs_push(l, "    vec_push(doc.nodes, n);")
    strs_push(l, "    vec_len(doc.nodes) - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new `null` node in `doc`.")
    strs_push(l, "pub fn json_add_null(doc: JsonDoc) -> Int ! {} {")
    strs_push(l, "    add(doc, JsonNode(kind: k_null(), num: 0, text: \"\", first: 0, count: 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new `true` or `false` node in `doc`.")
    strs_push(l, "pub fn json_add_bool(doc: JsonDoc, b: Bool) -> Int ! {} {")
    strs_push(l, "    add(doc, JsonNode(kind: if b { k_true() } else { k_false() }, num: 0, text: \"\", first: 0, count: 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new number node in `doc`.")
    strs_push(l, "pub fn json_add_int(doc: JsonDoc, n: Int) -> Int ! {} {")
    strs_push(l, "    add(doc, JsonNode(kind: k_num(), num: n, text: \"\", first: 0, count: 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new string node in `doc`.")
    strs_push(l, "pub fn json_add_str(doc: JsonDoc, s: Str) -> Int ! {} {")
    strs_push(l, "    add(doc, JsonNode(kind: k_str(), num: 0, text: s, first: 0, count: 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new array node in `doc` whose elements are the nodes `items`, in order.")
    strs_push(l, "pub fn json_add_array(doc: JsonDoc, items: Ints) -> Int ! {} {")
    strs_push(l, "    let first = ints_len(doc.kids);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < ints_len(items) { ints_push(doc.kids, ints_get(items, i)); i = i + 1; }")
    strs_push(l, "    add(doc, JsonNode(kind: k_arr(), num: 0, text: \"\", first: first, count: ints_len(items)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new object node in `doc`: each of `keys` with the node at the same index of `values`. The")
    strs_push(l, "/// shorter of the two decides how many members it has.")
    strs_push(l, "pub fn json_add_object(doc: JsonDoc, keys: Strs, values: Ints) -> Int ! {} {")
    strs_push(l, "    let n = if strs_len(keys) < ints_len(values) { strs_len(keys) } else { ints_len(values) };")
    strs_push(l, "    let key_nodes = ints_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n { ints_push(key_nodes, json_add_str(doc, strs_get(keys, i))); i = i + 1; }")
    strs_push(l, "    let first = ints_len(doc.kids);")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < n { ints_push(doc.kids, ints_get(key_nodes, i)); ints_push(doc.kids, ints_get(values, i)); i = i + 1; }")
    strs_push(l, "    add(doc, JsonNode(kind: k_obj(), num: 0, text: \"\", first: first, count: n))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `node` is: `null`, `bool`, `number`, `string`, `array` or `object`; `\"\"` for no node.")
    strs_push(l, "pub fn json_kind(doc: JsonDoc, node: Int) -> Str ! {} {")
    strs_push(l, "    if node < 0 || node >= vec_len(doc.nodes) { \"\" } else {")
    strs_push(l, "        let k = vec_get(doc.nodes, node).kind;")
    strs_push(l, "        if k == k_null() { \"null\" } else { if k == k_false() || k == k_true() { \"bool\" } else {")
    strs_push(l, "            if k == k_num() || k == k_float() { \"number\" } else { if k == k_str() { \"string\" } else {")
    strs_push(l, "                if k == k_arr() { \"array\" } else { \"object\" } } } } }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many elements an array has, or members an object has; `0` for anything else.")
    strs_push(l, "pub fn json_len(doc: JsonDoc, node: Int) -> Int ! {} {")
    strs_push(l, "    let kind = json_kind(doc, node);")
    strs_push(l, "    if kind == \"array\" || kind == \"object\" { vec_get(doc.nodes, node).count } else { 0 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The node of an array's element `i`, or `None`.")
    strs_push(l, "pub fn json_at(doc: JsonDoc, node: Int, i: Int) -> Option[Int] ! {} {")
    strs_push(l, "    if json_kind(doc, node) != \"array\" || i < 0 || i >= json_len(doc, node) { Option[Int].None() } else {")
    strs_push(l, "        Option[Int].Some(value: ints_get(doc.kids, vec_get(doc.nodes, node).first + i))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The key of an object's member `i`, or `None`.")
    strs_push(l, "pub fn json_key_at(doc: JsonDoc, node: Int, i: Int) -> Option[Str] ! {} {")
    strs_push(l, "    if json_kind(doc, node) != \"object\" || i < 0 || i >= json_len(doc, node) { Option[Str].None() } else {")
    strs_push(l, "        let k = ints_get(doc.kids, vec_get(doc.nodes, node).first + 2 * i);")
    strs_push(l, "        Option[Str].Some(value: vec_get(doc.nodes, k).text)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The node of an object's member `i`'s value, or `None`.")
    strs_push(l, "pub fn json_value_at(doc: JsonDoc, node: Int, i: Int) -> Option[Int] ! {} {")
    strs_push(l, "    if json_kind(doc, node) != \"object\" || i < 0 || i >= json_len(doc, node) { Option[Int].None() } else {")
    strs_push(l, "        Option[Int].Some(value: ints_get(doc.kids, vec_get(doc.nodes, node).first + 2 * i + 1))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The node of the value an object holds for `key` — the last, if it holds it more than once —")
    strs_push(l, "/// or `None`.")
    strs_push(l, "pub fn json_get(doc: JsonDoc, node: Int, key: Str) -> Option[Int] ! {} {")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < json_len(doc, node) {")
    strs_push(l, "        let hit = match json_key_at(doc, node, i) {")
    strs_push(l, "            Option.Some(value: k) => k == key,")
    strs_push(l, "            Option.None() => false,")
    strs_push(l, "        };")
    strs_push(l, "        if hit { found = i; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { json_value_at(doc, node, found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A number node's value, or `None`.")
    strs_push(l, "pub fn json_int(doc: JsonDoc, node: Int) -> Option[Int] ! {} {")
    strs_push(l, "    if json_kind(doc, node) == \"number\" && vec_get(doc.nodes, node).kind == k_num() { Option[Int].Some(value: vec_get(doc.nodes, node).num) } else { Option[Int].None() }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A float (Gate 2): `x` as a number node.")
    strs_push(l, "pub fn json_add_float(doc: JsonDoc, x: Float64) -> Int ! {} {")
    strs_push(l, "    add(doc, JsonNode(kind: k_float(), num: wrap_convert[Int](float64_to_bits(x)), text: \"\", first: 0, count: 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A number node's value as a `Float64` (Gate 2) — an integer node's converted, to the nearest —")
    strs_push(l, "/// or `None`.")
    strs_push(l, "pub fn json_float(doc: JsonDoc, node: Int) -> Option[Float64] ! {} {")
    strs_push(l, "    if json_kind(doc, node) != \"number\" { Option[Float64].None() } else {")
    strs_push(l, "        let n = vec_get(doc.nodes, node);")
    strs_push(l, "        if n.kind == k_float() { Option[Float64].Some(value: float64_from_bits(wrap_convert[UInt64](n.num))) } else { Option[Float64].Some(value: Float64(n.num)) }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A string node's value, or `None`.")
    strs_push(l, "pub fn json_str(doc: JsonDoc, node: Int) -> Option[Str] ! {} {")
    strs_push(l, "    if json_kind(doc, node) == \"string\" { Option[Str].Some(value: vec_get(doc.nodes, node).text) } else { Option[Str].None() }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A boolean node's value, or `None`.")
    strs_push(l, "pub fn json_bool(doc: JsonDoc, node: Int) -> Option[Bool] ! {} {")
    strs_push(l, "    if json_kind(doc, node) == \"bool\" { Option[Bool].Some(value: vec_get(doc.nodes, node).kind == k_true()) } else { Option[Bool].None() }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- encoding ---------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "fn hex_digit(d: Int) -> Str ! {} {")
    strs_push(l, "    str_slice(\"0123456789abcdef\", d, d + 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` as a JSON string literal, quotes included: `\"` and `\\` escaped, and every control byte")
    strs_push(l, "/// as `\\n`, `\\r`, `\\t` or `\\u00XX`.")
    strs_push(l, "pub fn json_quote(s: Str) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, \"\\\"\");")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let esc = if b == 34 { \"\\\\\\\"\" } else { if b == 92 { \"\\\\\\\\\" } else { if b == 10 { \"\\\\n\" } else {")
    strs_push(l, "            if b == 13 { \"\\\\r\" } else { if b == 9 { \"\\\\t\" } else {")
    strs_push(l, "                if b < 32 { str_concat(str_concat(\"\\\\u00\", hex_digit(b / 16)), hex_digit(b % 16)) } else { \"\" } } } } } };")
    strs_push(l, "        if str_len(esc) > 0 {")
    strs_push(l, "            strs_push(parts, str_slice(s, start, i));")
    strs_push(l, "            strs_push(parts, esc);")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    strs_push(parts, str_slice(s, start, str_len(s)));")
    strs_push(l, "    strs_push(parts, \"\\\"\");")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The node `node` of `doc` as compact JSON text: no spaces, members in the order they were")
    strs_push(l, "/// built or parsed.")
    strs_push(l, "pub fn json_encode_node(doc: JsonDoc, node: Int) -> Str ! {} {")
    strs_push(l, "    let kind = json_kind(doc, node);")
    strs_push(l, "    if kind == \"null\" || kind == \"\" { \"null\" } else {")
    strs_push(l, "        if kind == \"bool\" { if vec_get(doc.nodes, node).kind == k_true() { \"true\" } else { \"false\" } } else {")
    strs_push(l, "            if kind == \"number\" { number_text(vec_get(doc.nodes, node)) } else {")
    strs_push(l, "                if kind == \"string\" { json_quote(vec_get(doc.nodes, node).text) } else {")
    strs_push(l, "                    let parts = strs_new();")
    strs_push(l, "                    let n = json_len(doc, node);")
    strs_push(l, "                    let mut i = 0;")
    strs_push(l, "                    while i < n {")
    strs_push(l, "                        if kind == \"array\" {")
    strs_push(l, "                            let e = match json_at(doc, node, i) { Option.Some(value: e) => e, Option.None() => 0 - 1 };")
    strs_push(l, "                            strs_push(parts, json_encode_node(doc, e));")
    strs_push(l, "                        } else {")
    strs_push(l, "                            let k = match json_key_at(doc, node, i) { Option.Some(value: k) => k, Option.None() => \"\" };")
    strs_push(l, "                            let v = match json_value_at(doc, node, i) { Option.Some(value: v) => v, Option.None() => 0 - 1 };")
    strs_push(l, "                            strs_push(parts, str_concat(str_concat(json_quote(k), \":\"), json_encode_node(doc, v)));")
    strs_push(l, "                        }")
    strs_push(l, "                        i = i + 1;")
    strs_push(l, "                    }")
    strs_push(l, "                    if kind == \"array\" { str_concat(str_concat(\"[\", str_join(parts, \",\")), \"]\") } else {")
    strs_push(l, "                        str_concat(str_concat(\"{\", str_join(parts, \",\")), \"}\")")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `doc`'s root as compact JSON text.")
    strs_push(l, "pub fn json_encode(doc: JsonDoc) -> Str ! {} {")
    strs_push(l, "    json_encode_node(doc, doc.root)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A number's text: an integer's digits, or a float's shortest text that reads back to it, with a")
    strs_push(l, "// `.0` where that would read as an integer; JSON has no infinity or NaN, so those are `null`.")
    strs_push(l, "fn number_text(n: JsonNode) -> Str ! {} {")
    strs_push(l, "    if n.kind == k_num() { int_to_str(n.num) } else {")
    strs_push(l, "        let x = float64_from_bits(wrap_convert[UInt64](n.num));")
    strs_push(l, "        if !float_is_finite(x) { \"null\" } else {")
    strs_push(l, "            let t = num_to_str(x);")
    strs_push(l, "            let mut plain = true;")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            while i < str_len(t) {")
    strs_push(l, "                let b = str_byte(t, i);")
    strs_push(l, "                if b == 46 || b == 101 || b == 69 { plain = false; }")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "            if plain { str_concat(t, \".0\") } else { t }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn indent(depth: Int) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < depth { out = str_concat(out, \"  \"); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn pretty_node(doc: JsonDoc, node: Int, depth: Int) -> Str ! {} {")
    strs_push(l, "    let kind = json_kind(doc, node);")
    strs_push(l, "    if kind != \"array\" && kind != \"object\" { json_encode_node(doc, node) } else {")
    strs_push(l, "        let n = json_len(doc, node);")
    strs_push(l, "        if n == 0 { if kind == \"array\" { \"[]\" } else { \"{}\" } } else {")
    strs_push(l, "            let parts = strs_new();")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            while i < n {")
    strs_push(l, "                if kind == \"array\" {")
    strs_push(l, "                    let e = match json_at(doc, node, i) { Option.Some(value: e) => e, Option.None() => 0 - 1 };")
    strs_push(l, "                    strs_push(parts, str_concat(indent(depth + 1), pretty_node(doc, e, depth + 1)));")
    strs_push(l, "                } else {")
    strs_push(l, "                    let k = match json_key_at(doc, node, i) { Option.Some(value: k) => k, Option.None() => \"\" };")
    strs_push(l, "                    let v = match json_value_at(doc, node, i) { Option.Some(value: v) => v, Option.None() => 0 - 1 };")
    strs_push(l, "                    strs_push(parts, str_concat(str_concat(indent(depth + 1), str_concat(json_quote(k), \": \")), pretty_node(doc, v, depth + 1)));")
    strs_push(l, "                }")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "            let open = if kind == \"array\" { \"[\\n\" } else { \"{\\n\" };")
    strs_push(l, "            let close = if kind == \"array\" { \"]\" } else { \"}\" };")
    strs_push(l, "            str_concat(str_concat(open, str_join(parts, \",\\n\")), str_concat(str_concat(\"\\n\", indent(depth)), close))")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `doc`'s root as JSON text indented two spaces a level, a member's key followed by `: ` (Gate 2).")
    strs_push(l, "pub fn json_encode_pretty(doc: JsonDoc) -> Str ! {} {")
    strs_push(l, "    pretty_node(doc, doc.root, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- parsing ----------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "// The parser's state: the text, where it is, and the first error, if any. Shared through the")
    strs_push(l, "// handles, so every function sees one position.")
    strs_push(l, "struct Parser {")
    strs_push(l, "    text: Str,")
    strs_push(l, "    pos: Ints,")
    strs_push(l, "    error: Strs,")
    strs_push(l, "    floats: Bool,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn at(p: Parser) -> Int ! {} { ints_get(p.pos, 0) }")
    strs_push(l, "fn advance(p: Parser, n: Int) -> Int ! {} { ints_set(p.pos, 0, at(p) + n) }")
    strs_push(l, "fn failed(p: Parser) -> Bool ! {} { strs_len(p.error) > 0 }")
    strs_push(l, "")
    strs_push(l, "fn fail(p: Parser, what: Str) -> Int ! {} {")
    strs_push(l, "    if !failed(p) {")
    strs_push(l, "        strs_push(p.error, str_concat(str_concat(what, \" at byte \"), int_to_str(at(p))));")
    strs_push(l, "    }")
    strs_push(l, "    0 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn peek(p: Parser) -> Int ! {} {")
    strs_push(l, "    if at(p) < str_len(p.text) { str_byte(p.text, at(p)) } else { 0 - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn skip_space(p: Parser) -> Int ! {} {")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b == 32 || b == 9 || b == 10 || b == 13 { let n = advance(p, 1); } else { more = false; }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn expect_word(p: Parser, word: Str) -> Bool ! {} {")
    strs_push(l, "    let n = str_len(word);")
    strs_push(l, "    if at(p) + n <= str_len(p.text) && str_slice(p.text, at(p), at(p) + n) == word {")
    strs_push(l, "        let moved = advance(p, n);")
    strs_push(l, "        true")
    strs_push(l, "    } else {")
    strs_push(l, "        let f = fail(p, str_concat(\"expected \", word));")
    strs_push(l, "        false")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn hex_value(b: Int) -> Int ! {} {")
    strs_push(l, "    if b >= 48 && b <= 57 { b - 48 } else { if b >= 97 && b <= 102 { b - 87 } else { if b >= 65 && b <= 70 { b - 55 } else { 0 - 1 } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The UTF-8 bytes of the code point `c`.")
    strs_push(l, "fn utf8(c: Int) -> Str ! {} {")
    strs_push(l, "    if c < 128 { str_from_byte(c) } else {")
    strs_push(l, "        if c < 2048 { str_concat(str_from_byte(192 + c / 64), str_from_byte(128 + c % 64)) } else {")
    strs_push(l, "            str_concat(str_concat(str_from_byte(224 + c / 4096), str_from_byte(128 + (c / 64) % 64)), str_from_byte(128 + c % 64))")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_string(p: Parser) -> Str ! {} {")
    strs_push(l, "    let open = advance(p, 1);")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut start = at(p);")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b < 0 { let f = fail(p, \"unterminated string\"); done = true; } else {")
    strs_push(l, "            if b == 34 {")
    strs_push(l, "                strs_push(parts, str_slice(p.text, start, at(p)));")
    strs_push(l, "                let close = advance(p, 1);")
    strs_push(l, "                done = true;")
    strs_push(l, "            } else {")
    strs_push(l, "                if b == 92 {")
    strs_push(l, "                    strs_push(parts, str_slice(p.text, start, at(p)));")
    strs_push(l, "                    let e = if at(p) + 1 < str_len(p.text) { str_byte(p.text, at(p) + 1) } else { 0 - 1 };")
    strs_push(l, "                    let simple = if e == 34 { \"\\\"\" } else { if e == 92 { \"\\\\\" } else { if e == 47 { \"/\" } else {")
    strs_push(l, "                        if e == 98 { str_from_byte(8) } else { if e == 102 { str_from_byte(12) } else {")
    strs_push(l, "                            if e == 110 { str_from_byte(10) } else { if e == 114 { str_from_byte(13) } else {")
    strs_push(l, "                                if e == 116 { str_from_byte(9) } else { \"\" } } } } } } } };")
    strs_push(l, "                    if str_len(simple) > 0 {")
    strs_push(l, "                        strs_push(parts, simple);")
    strs_push(l, "                        let moved = advance(p, 2);")
    strs_push(l, "                    } else {")
    strs_push(l, "                        if e == 117 && at(p) + 6 <= str_len(p.text) {")
    strs_push(l, "                            let mut code = 0;")
    strs_push(l, "                            let mut k = 0;")
    strs_push(l, "                            while k < 4 {")
    strs_push(l, "                                let h = hex_value(str_byte(p.text, at(p) + 2 + k));")
    strs_push(l, "                                if h < 0 { code = 0 - 1; k = 4; } else { code = code * 16 + h; k = k + 1; }")
    strs_push(l, "                            }")
    strs_push(l, "                            if code < 0 { let f = fail(p, \"bad \\\\u escape\"); done = true; } else {")
    strs_push(l, "                                strs_push(parts, utf8(code));")
    strs_push(l, "                                let moved = advance(p, 6);")
    strs_push(l, "                            }")
    strs_push(l, "                        } else {")
    strs_push(l, "                            let f = fail(p, \"bad escape\"); done = true;")
    strs_push(l, "                        }")
    strs_push(l, "                    }")
    strs_push(l, "                    start = at(p);")
    strs_push(l, "                } else {")
    strs_push(l, "                    if b < 32 { let f = fail(p, \"control byte in a string\"); done = true; } else { let moved = advance(p, 1); }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_number(p: Parser) -> Int ! {} {")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    if peek(p) == 45 { let m = advance(p, 1); }")
    strs_push(l, "    let digits = at(p);")
    strs_push(l, "    while peek(p) >= 48 && peek(p) <= 57 { let m = advance(p, 1); }")
    strs_push(l, "    if at(p) == digits { fail(p, \"expected a digit\") } else {")
    strs_push(l, "        if peek(p) == 46 || peek(p) == 101 || peek(p) == 69 {")
    strs_push(l, "            fail(p, \"a number with a fraction or exponent is not supported\")")
    strs_push(l, "        } else {")
    strs_push(l, "            let text = str_slice(p.text, start, at(p));")
    strs_push(l, "            let body = if str_byte(text, 0) == 45 { str_slice(text, 1, str_len(text)) } else { text };")
    strs_push(l, "            if str_len(body) > 1 && str_byte(body, 0) == 48 { fail(p, \"a number with a leading zero\") } else {")
    strs_push(l, "                // Parsed as a negative accumulator, whose range is one larger, so `Int`'s minimum parses.")
    strs_push(l, "                let mut acc = 0;")
    strs_push(l, "                let mut i = 0;")
    strs_push(l, "                let mut ok = true;")
    strs_push(l, "                let limit = 0 - 922337203685477580;")
    strs_push(l, "                while ok && i < str_len(body) {")
    strs_push(l, "                    let d = str_byte(body, i) - 48;")
    strs_push(l, "                    if acc < limit || (acc == limit && d > 8) { ok = false; } else { acc = acc * 10 - d; i = i + 1; }")
    strs_push(l, "                }")
    strs_push(l, "                if !ok { fail(p, \"a number outside Int's range\") } else {")
    strs_push(l, "                    if str_byte(text, 0) == 45 { acc } else {")
    strs_push(l, "                        if acc == limit * 10 - 8 { fail(p, \"a number outside Int's range\") } else { 0 - acc }")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A number with or without a fraction and an exponent (Gate 2): RFC 8259's grammar, checked here;")
    strs_push(l, "// an integer that `Int` holds is an integer node, anything else a `Float64` node.")
    strs_push(l, "fn parse_any_number(p: Parser, doc: JsonDoc) -> Int ! {} {")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    if peek(p) == 45 { let m = advance(p, 1); }")
    strs_push(l, "    let digits = at(p);")
    strs_push(l, "    while peek(p) >= 48 && peek(p) <= 57 { let m = advance(p, 1); }")
    strs_push(l, "    if at(p) == digits { return fail(p, \"expected a digit\"); }")
    strs_push(l, "    if at(p) - digits > 1 && str_byte(p.text, digits) == 48 { return fail(p, \"a number with a leading zero\"); }")
    strs_push(l, "    let mut whole = true;")
    strs_push(l, "    if peek(p) == 46 {")
    strs_push(l, "        whole = false;")
    strs_push(l, "        let m = advance(p, 1);")
    strs_push(l, "        let f = at(p);")
    strs_push(l, "        while peek(p) >= 48 && peek(p) <= 57 { let m2 = advance(p, 1); }")
    strs_push(l, "        if at(p) == f { return fail(p, \"expected a digit after the point\"); }")
    strs_push(l, "    }")
    strs_push(l, "    if peek(p) == 101 || peek(p) == 69 {")
    strs_push(l, "        whole = false;")
    strs_push(l, "        let m = advance(p, 1);")
    strs_push(l, "        if peek(p) == 43 || peek(p) == 45 { let m2 = advance(p, 1); }")
    strs_push(l, "        let e = at(p);")
    strs_push(l, "        while peek(p) >= 48 && peek(p) <= 57 { let m3 = advance(p, 1); }")
    strs_push(l, "        if at(p) == e { return fail(p, \"expected a digit in the exponent\"); }")
    strs_push(l, "    }")
    strs_push(l, "    let text = str_slice(p.text, start, at(p));")
    strs_push(l, "    if whole {")
    strs_push(l, "        // An integer `Int` holds stays one; a longer one is a float, as JSON means it.")
    strs_push(l, "        let q = Parser(text: text, pos: ints_new(), error: strs_new(), floats: false);")
    strs_push(l, "        ints_push(q.pos, 0);")
    strs_push(l, "        let n = parse_number(q);")
    strs_push(l, "        if !failed(q) { return json_add_int(doc, n); }")
    strs_push(l, "    }")
    strs_push(l, "    json_add_float(doc, float_parse_raw(text))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_value(p: Parser, doc: JsonDoc, depth: Int) -> Int ! {} {")
    strs_push(l, "    let s = skip_space(p);")
    strs_push(l, "    if depth > 256 { fail(p, \"nesting deeper than 256\") } else {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b == 110 { if expect_word(p, \"null\") { json_add_null(doc) } else { 0 - 1 } } else {")
    strs_push(l, "        if b == 116 { if expect_word(p, \"true\") { json_add_bool(doc, true) } else { 0 - 1 } } else {")
    strs_push(l, "        if b == 102 { if expect_word(p, \"false\") { json_add_bool(doc, false) } else { 0 - 1 } } else {")
    strs_push(l, "        if b == 34 { let s2 = parse_string(p); if failed(p) { 0 - 1 } else { json_add_str(doc, s2) } } else {")
    strs_push(l, "        if b == 45 || (b >= 48 && b <= 57) { if p.floats { parse_any_number(p, doc) } else { let n = parse_number(p); if failed(p) { 0 - 1 } else { json_add_int(doc, n) } } } else {")
    strs_push(l, "        if b == 91 { parse_array(p, doc, depth) } else {")
    strs_push(l, "        if b == 123 { parse_object(p, doc, depth) } else {")
    strs_push(l, "        if b < 0 { fail(p, \"unexpected end\") } else { fail(p, \"unexpected byte\") } } } } } } } }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_array(p: Parser, doc: JsonDoc, depth: Int) -> Int ! {} {")
    strs_push(l, "    let open = advance(p, 1);")
    strs_push(l, "    let items = ints_new();")
    strs_push(l, "    let s = skip_space(p);")
    strs_push(l, "    if peek(p) == 93 { let c = advance(p, 1); } else {")
    strs_push(l, "        let mut more = true;")
    strs_push(l, "        while more && !failed(p) {")
    strs_push(l, "            let v = parse_value(p, doc, depth + 1);")
    strs_push(l, "            if !failed(p) {")
    strs_push(l, "                ints_push(items, v);")
    strs_push(l, "                let s3 = skip_space(p);")
    strs_push(l, "                let b = peek(p);")
    strs_push(l, "                if b == 44 { let c = advance(p, 1); } else { if b == 93 { let c = advance(p, 1); more = false; } else { let f = fail(p, \"expected , or ]\"); } }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if failed(p) { 0 - 1 } else { json_add_array(doc, items) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_object(p: Parser, doc: JsonDoc, depth: Int) -> Int ! {} {")
    strs_push(l, "    let open = advance(p, 1);")
    strs_push(l, "    let keys = strs_new();")
    strs_push(l, "    let values = ints_new();")
    strs_push(l, "    let s = skip_space(p);")
    strs_push(l, "    if peek(p) == 125 { let c = advance(p, 1); } else {")
    strs_push(l, "        let mut more = true;")
    strs_push(l, "        while more && !failed(p) {")
    strs_push(l, "            let s2 = skip_space(p);")
    strs_push(l, "            if peek(p) != 34 { let f = fail(p, \"expected a key\"); } else {")
    strs_push(l, "                let k = parse_string(p);")
    strs_push(l, "                let s3 = skip_space(p);")
    strs_push(l, "                if !failed(p) && peek(p) != 58 { let f = fail(p, \"expected :\"); }")
    strs_push(l, "                if !failed(p) {")
    strs_push(l, "                    let c = advance(p, 1);")
    strs_push(l, "                    let v = parse_value(p, doc, depth + 1);")
    strs_push(l, "                    if !failed(p) {")
    strs_push(l, "                        strs_push(keys, k);")
    strs_push(l, "                        ints_push(values, v);")
    strs_push(l, "                        let s4 = skip_space(p);")
    strs_push(l, "                        let b = peek(p);")
    strs_push(l, "                        if b == 44 { let c2 = advance(p, 1); } else { if b == 125 { let c2 = advance(p, 1); more = false; } else { let f = fail(p, \"expected , or }\"); } }")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if failed(p) { 0 - 1 } else { json_add_object(doc, keys, values) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The document `text` spells, or an `Err` naming what was wrong and the byte offset where.")
    strs_push(l, "/// Whitespace is allowed around values; anything after the one top-level value is an error.")
    strs_push(l, "pub fn json_parse(text: Str) -> Result[JsonDoc, Str] ! {} {")
    strs_push(l, "    parse_document(text, false)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// As `json_parse`, reading a number with a fraction or an exponent — or an integer `Int` cannot")
    strs_push(l, "/// hold — as a `Float64` node (Gate 2).")
    strs_push(l, "pub fn json_parse_floats(text: Str) -> Result[JsonDoc, Str] ! {} {")
    strs_push(l, "    parse_document(text, true)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn parse_document(text: Str, floats: Bool) -> Result[JsonDoc, Str] ! {} {")
    strs_push(l, "    let pos = ints_new();")
    strs_push(l, "    ints_push(pos, 0);")
    strs_push(l, "    let p = Parser(text: text, pos: pos, error: strs_new(), floats: floats);")
    strs_push(l, "    let doc = json_new();")
    strs_push(l, "    let root = parse_value(p, doc, 0);")
    strs_push(l, "    let s = skip_space(p);")
    strs_push(l, "    if !failed(p) && at(p) < str_len(text) { let f = fail(p, \"text after the value\"); }")
    strs_push(l, "    if failed(p) { Result[JsonDoc, Str].Err(error: strs_get(p.error, 0)) } else {")
    strs_push(l, "        Result[JsonDoc, Str].Ok(value: json_with_root(doc, root))")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_linalg() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/linalg`: small fixed vectors and matrices over `Float64` (Gate 3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/linalg\";`. The vector maths a control loop needs — three components, a")
    strs_push(l, "// 3×3 matrix, their products — as values: nothing allocates, so it runs on a board without a heap")
    strs_push(l, "// and under `no-heap`. Every operation is the arithmetic operators and `float_sqrt`, each correctly")
    strs_push(l, "// rounded, so a result is the same on every host and under `no-float-nondeterminism`.")
    strs_push(l, "// `docs/internal/systems-domains.md` Parts E–J.")
    strs_push(l, "")
    strs_push(l, "/// A vector of three components.")
    strs_push(l, "pub struct Vec3 {")
    strs_push(l, "    x: Float64,")
    strs_push(l, "    y: Float64,")
    strs_push(l, "    z: Float64,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A 3×3 matrix, by rows.")
    strs_push(l, "pub struct Mat3 {")
    strs_push(l, "    r0: Vec3,")
    strs_push(l, "    r1: Vec3,")
    strs_push(l, "    r2: Vec3,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The vector `(x, y, z)`.")
    strs_push(l, "pub fn vec3(x: Float64, y: Float64, z: Float64) -> Vec3 ! {} {")
    strs_push(l, "    Vec3(x: x, y: y, z: z)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `a + b`.")
    strs_push(l, "pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 ! {} {")
    strs_push(l, "    Vec3(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `a - b`.")
    strs_push(l, "pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 ! {} {")
    strs_push(l, "    Vec3(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `a` times the number `k`.")
    strs_push(l, "pub fn vec3_scale(a: Vec3, k: Float64) -> Vec3 ! {} {")
    strs_push(l, "    Vec3(x: a.x * k, y: a.y * k, z: a.z * k)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The dot product of `a` and `b`.")
    strs_push(l, "pub fn vec3_dot(a: Vec3, b: Vec3) -> Float64 ! {} {")
    strs_push(l, "    a.x * b.x + a.y * b.y + a.z * b.z")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The length of `a`.")
    strs_push(l, "pub fn vec3_norm(a: Vec3) -> Float64 ! {} {")
    strs_push(l, "    float_sqrt(vec3_dot(a, a))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `a`, made no longer than `limit` by scaling it down where it is longer: how an actuator's")
    strs_push(l, "/// command is bounded.")
    strs_push(l, "pub fn vec3_clamp(a: Vec3, limit: Float64) -> Vec3 ! {} {")
    strs_push(l, "    let n = vec3_norm(a);")
    strs_push(l, "    if n > limit { vec3_scale(a, limit / n) } else { a }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The matrix whose rows are `r0`, `r1` and `r2`.")
    strs_push(l, "pub fn mat3(r0: Vec3, r1: Vec3, r2: Vec3) -> Mat3 ! {} {")
    strs_push(l, "    Mat3(r0: r0, r1: r1, r2: r2)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The identity matrix.")
    strs_push(l, "pub fn mat3_identity() -> Mat3 ! {} {")
    strs_push(l, "    mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `m` applied to `v`.")
    strs_push(l, "pub fn mat3_apply(m: Mat3, v: Vec3) -> Vec3 ! {} {")
    strs_push(l, "    vec3(vec3_dot(m.r0, v), vec3_dot(m.r1, v), vec3_dot(m.r2, v))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The transpose of `m`.")
    strs_push(l, "pub fn mat3_transpose(m: Mat3) -> Mat3 ! {} {")
    strs_push(l, "    mat3(")
    strs_push(l, "        vec3(m.r0.x, m.r1.x, m.r2.x),")
    strs_push(l, "        vec3(m.r0.y, m.r1.y, m.r2.y),")
    strs_push(l, "        vec3(m.r0.z, m.r1.z, m.r2.z),")
    strs_push(l, "    )")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The product `a · b`.")
    strs_push(l, "pub fn mat3_mul(a: Mat3, b: Mat3) -> Mat3 ! {} {")
    strs_push(l, "    let t = mat3_transpose(b);")
    strs_push(l, "    mat3(mat3_apply(t, a.r0), mat3_apply(t, a.r1), mat3_apply(t, a.r2))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_log() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/log`: structured, levelled records, one JSON object a line on standard error (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/log\";`. A record is a level, a message and fields — `log_str`,")
    strs_push(l, "// `log_int`, `log_bool` make one each — written as one line of JSON to standard error, so any")
    strs_push(l, "// collector can read it; writing needs only an `OutCap`. A span measures a piece of work: begun and")
    strs_push(l, "// ended under a `TimeCap`, it writes its name and the nanoseconds between. Nothing here reads a")
    strs_push(l, "// clock or a task unless asked, so a program's log is the same in every run. Records below a")
    strs_push(l, "// logger's level are dropped. `docs/internal/general-purpose.md` §20.")
    strs_push(l, "")
    strs_push(l, "use \"@std/json\";")
    strs_push(l, "use \"@std/time\";")
    strs_push(l, "")
    strs_push(l, "/// The levels, least to most severe.")
    strs_push(l, "pub enum LogLevel {")
    strs_push(l, "    Debug,")
    strs_push(l, "    Info,")
    strs_push(l, "    Warn,")
    strs_push(l, "    Error,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Where records go and which are kept: those at `min` or above, each carrying `fields`.")
    strs_push(l, "pub struct Logger {")
    strs_push(l, "    min: Int,")
    strs_push(l, "    fields: Strs,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A piece of work being measured.")
    strs_push(l, "pub struct LogSpan {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    start: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn rank(l: LogLevel) -> Int ! {} {")
    strs_push(l, "    match l {")
    strs_push(l, "        LogLevel.Debug() => 0,")
    strs_push(l, "        LogLevel.Info() => 1,")
    strs_push(l, "        LogLevel.Warn() => 2,")
    strs_push(l, "        LogLevel.Error() => 3,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A level's name, as records write it.")
    strs_push(l, "pub fn log_level_name(l: LogLevel) -> Str ! {} {")
    strs_push(l, "    match l {")
    strs_push(l, "        LogLevel.Debug() => \"debug\",")
    strs_push(l, "        LogLevel.Info() => \"info\",")
    strs_push(l, "        LogLevel.Warn() => \"warn\",")
    strs_push(l, "        LogLevel.Error() => \"error\",")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A logger keeping records at `min` or above, with no fields of its own.")
    strs_push(l, "pub fn log_new(min: LogLevel) -> Logger ! {} {")
    strs_push(l, "    Logger(min: rank(min), fields: strs_new())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `l`, every record of which also carries `fields`.")
    strs_push(l, "pub fn log_with(l: Logger, fields: Strs) -> Logger ! {} {")
    strs_push(l, "    let all = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(l.fields) { strs_push(all, strs_get(l.fields, i)); i = i + 1; }")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while j < strs_len(fields) { strs_push(all, strs_get(fields, j)); j = j + 1; }")
    strs_push(l, "    Logger(min: l.min, fields: all)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A field whose value is text.")
    strs_push(l, "pub fn log_str(key: Str, value: Str) -> Str ! {} {")
    strs_push(l, "    str_concat(str_concat(json_quote(key), \":\"), json_quote(value))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A field whose value is a number.")
    strs_push(l, "pub fn log_int(key: Str, value: Int) -> Str ! {} {")
    strs_push(l, "    str_concat(str_concat(json_quote(key), \":\"), int_to_str(value))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A field whose value is true or false.")
    strs_push(l, "pub fn log_bool(key: Str, value: Bool) -> Str ! {} {")
    strs_push(l, "    str_concat(str_concat(json_quote(key), \":\"), if value { \"true\" } else { \"false\" })")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The request a record belongs to, as the field `request_id` (v1 track C, C4): the one name every")
    strs_push(l, "/// record of a request carries, so a collector can gather them.")
    strs_push(l, "pub fn log_request_id(id: Str) -> Str ! {} {")
    strs_push(l, "    log_str(\"request_id\", id)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A W3C Trace Context's identifiers under OpenTelemetry's names, `trace_id` and `span_id`")
    strs_push(l, "/// (v1 track C, C4), as two fields; each is written as given.")
    strs_push(l, "pub fn log_trace(trace_id: Str, span_id: Str) -> Strs ! {} {")
    strs_push(l, "    let f = strs_new();")
    strs_push(l, "    strs_push(f, log_str(\"trace_id\", trace_id));")
    strs_push(l, "    strs_push(f, log_str(\"span_id\", span_id));")
    strs_push(l, "    f")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// When, as the field `time`: the wall-clock reading `w` as RFC 3339 text in UTC (v1 track C, C4).")
    strs_push(l, "/// Reading the clock stays the program's, under its `TimeCap`.")
    strs_push(l, "pub fn log_time(w: WallTime) -> Str ! {} {")
    strs_push(l, "    log_str(\"time\", time_format_rfc3339(time_utc(w)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// No fields.")
    strs_push(l, "pub fn log_fields() -> Strs ! {} {")
    strs_push(l, "    strs_new()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The record's line, without its newline: level, message, the logger's fields, then these.")
    strs_push(l, "pub fn log_line(l: Logger, level: LogLevel, message: Str, fields: Strs) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, log_str(\"level\", log_level_name(level)));")
    strs_push(l, "    strs_push(parts, log_str(\"msg\", message));")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(l.fields) { strs_push(parts, strs_get(l.fields, i)); i = i + 1; }")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while j < strs_len(fields) { strs_push(parts, strs_get(fields, j)); j = j + 1; }")
    strs_push(l, "    str_concat(str_concat(\"{\", str_join(parts, \",\")), \"}\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Write a record at `level`, if `l` keeps that level: the bytes written, `0` when dropped.")
    strs_push(l, "pub fn log_at(out: OutCap, l: Logger, level: LogLevel, message: Str, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    if rank(level) < l.min { 0 } else { eprint(str_concat(log_line(l, level, message, fields), \"\\n\")) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A debug record.")
    strs_push(l, "pub fn log_debug(out: OutCap, l: Logger, message: Str, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    log_at(out, l, LogLevel.Debug(), message, fields)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An info record.")
    strs_push(l, "pub fn log_info(out: OutCap, l: Logger, message: Str, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    log_at(out, l, LogLevel.Info(), message, fields)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A warning.")
    strs_push(l, "pub fn log_warn(out: OutCap, l: Logger, message: Str, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    log_at(out, l, LogLevel.Warn(), message, fields)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An error record.")
    strs_push(l, "pub fn log_error(out: OutCap, l: Logger, message: Str, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    log_at(out, l, LogLevel.Error(), message, fields)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Begin measuring `name`.")
    strs_push(l, "pub fn log_span_begin(t: TimeCap, name: Str) -> LogSpan ! {} {")
    strs_push(l, "    LogSpan(name: name, start: time_now_ns())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// End `s`: an info record with its name and the nanoseconds since it began, and `fields`.")
    strs_push(l, "pub fn log_span_end(out: OutCap, t: TimeCap, l: Logger, s: LogSpan, fields: Strs) -> Int ! { io } {")
    strs_push(l, "    let all = strs_new();")
    strs_push(l, "    strs_push(all, log_str(\"span\", s.name));")
    strs_push(l, "    strs_push(all, log_int(\"ns\", time_now_ns() - s.start));")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(fields) { strs_push(all, strs_get(fields, i)); i = i + 1; }")
    strs_push(l, "    log_at(out, l, LogLevel.Info(), \"span\", all)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_map() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/map`: a map from `Str` keys to values, ordered by key.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/map\";`. A `StrMap[T]` holds its entries sorted by key, byte by byte,")
    strs_push(l, "// in a `Vec` it shares like any handle: copies of a map are the same map. A key is found by binary")
    strs_push(l, "// search; an insertion or removal moves the entries after it. Iteration is in key order.")
    strs_push(l, "")
    strs_push(l, "/// One key and its value.")
    strs_push(l, "pub struct Entry[T] {")
    strs_push(l, "    key: Str,")
    strs_push(l, "    value: T,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A map from `Str` keys to `T` values, in key order.")
    strs_push(l, "pub struct StrMap[T] {")
    strs_push(l, "    entries: Vec[Entry[T]],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty map.")
    strs_push(l, "pub fn map_new[T]() -> StrMap[T] ! {} {")
    strs_push(l, "    StrMap[T](entries: vec_new[Entry[T]]())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many keys `m` holds.")
    strs_push(l, "pub fn map_len[T](m: StrMap[T]) -> Int ! {} {")
    strs_push(l, "    vec_len(m.entries)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `-1`, `0` or `1` as `a` sorts before, with or after `b`, byte by byte.")
    strs_push(l, "fn key_cmp(a: Str, b: Str) -> Int ! {} {")
    strs_push(l, "    let n = str_len(a);")
    strs_push(l, "    let k = str_len(b);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut r = 2;")
    strs_push(l, "    while r == 2 {")
    strs_push(l, "        if i == n { r = if i == k { 0 } else { 0 - 1 }; } else {")
    strs_push(l, "            if i == k { r = 1; } else {")
    strs_push(l, "                let x = str_byte(a, i);")
    strs_push(l, "                let y = str_byte(b, i);")
    strs_push(l, "                if x < y { r = 0 - 1; } else { if x > y { r = 1; } else { i = i + 1; } }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    r")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Where `key` is in `m`'s entries: its index when present, and `-(where it would go) - 1` when not.")
    strs_push(l, "fn map_find[T](m: StrMap[T], key: Str) -> Int ! {} {")
    strs_push(l, "    let mut lo = 0;")
    strs_push(l, "    let mut hi = vec_len(m.entries);")
    strs_push(l, "    let mut at = 0 - 1;")
    strs_push(l, "    while at < 0 && lo < hi {")
    strs_push(l, "        let mid = lo + (hi - lo) / 2;")
    strs_push(l, "        let c = key_cmp(vec_get(m.entries, mid).key, key);")
    strs_push(l, "        if c == 0 { at = mid; } else { if c < 0 { lo = mid + 1; } else { hi = mid; } }")
    strs_push(l, "    }")
    strs_push(l, "    if at >= 0 { at } else { 0 - lo - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, or `None`.")
    strs_push(l, "pub fn map_get[T](m: StrMap[T], key: Str) -> Option[T] ! {} {")
    strs_push(l, "    let at = map_find(m, key);")
    strs_push(l, "    if at < 0 { Option[T].None() } else { Option[T].Some(value: vec_get(m.entries, at).value) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `m` holds `key`.")
    strs_push(l, "pub fn map_has[T](m: StrMap[T], key: Str) -> Bool ! {} {")
    strs_push(l, "    map_find(m, key) >= 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give `key` the value `value` in `m`, replacing any it had; whether one was replaced.")
    strs_push(l, "pub fn map_set[T](m: StrMap[T], key: Str, value: T) -> Bool ! {} {")
    strs_push(l, "    let at = map_find(m, key);")
    strs_push(l, "    if at >= 0 {")
    strs_push(l, "        vec_set(m.entries, at, Entry[T](key: key, value: value));")
    strs_push(l, "        true")
    strs_push(l, "    } else {")
    strs_push(l, "        let place = 0 - at - 1;")
    strs_push(l, "        vec_push(m.entries, Entry[T](key: key, value: value));")
    strs_push(l, "        let mut i = vec_len(m.entries) - 1;")
    strs_push(l, "        while i > place {")
    strs_push(l, "            vec_set(m.entries, i, vec_get(m.entries, i - 1));")
    strs_push(l, "            i = i - 1;")
    strs_push(l, "        }")
    strs_push(l, "        vec_set(m.entries, place, Entry[T](key: key, value: value));")
    strs_push(l, "        false")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take `key` out of `m`, with the value it had, or `None` when it had none.")
    strs_push(l, "pub fn map_remove[T](m: StrMap[T], key: Str) -> Option[T] ! {} {")
    strs_push(l, "    let at = map_find(m, key);")
    strs_push(l, "    if at < 0 {")
    strs_push(l, "        Option[T].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let gone = vec_get(m.entries, at).value;")
    strs_push(l, "        let mut i = at;")
    strs_push(l, "        while i + 1 < vec_len(m.entries) {")
    strs_push(l, "            vec_set(m.entries, i, vec_get(m.entries, i + 1));")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        let last = vec_pop(m.entries);")
    strs_push(l, "        Option[T].Some(value: gone)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every key of `m`, in order.")
    strs_push(l, "pub fn map_keys[T](m: StrMap[T]) -> Strs ! {} {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(m.entries) { strs_push(out, vec_get(m.entries, i).key); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value of `m`, in its keys' order.")
    strs_push(l, "pub fn map_values[T](m: StrMap[T]) -> Vec[T] ! {} {")
    strs_push(l, "    let out = vec_new[T]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(m.entries) { vec_push(out, vec_get(m.entries, i).value); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_metrics() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/metrics`: counters, gauges and histograms, and the Prometheus text exposition (v1 track C,")
    strs_push(l, "// C4).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/metrics\";`. `docs/user/spec.md`, *Metrics*, states the rules; the design")
    strs_push(l, "// record is `openspec/changes/v1-every-domain/design.md`, section C. A metric is a set of atomic")
    strs_push(l, "// cells, so a `Counter`, `Gauge` or `Histogram` may cross into a task and every copy counts into")
    strs_push(l, "// the same cells; a registry (`Metrics`) may cross too, and `metrics_render` writes what it holds")
    strs_push(l, "// as text format 0.0.4, which every Prometheus-compatible collector reads. Values are integers: a")
    strs_push(l, "// unit belongs in the name (`request_duration_milliseconds`). Nothing here performs an effect.")
    strs_push(l, "")
    strs_push(l, "/// One bucket of a histogram: its upper bound and the observations at most it and above the")
    strs_push(l, "/// previous bound.")
    strs_push(l, "pub struct Bucket {")
    strs_push(l, "    le: Int,")
    strs_push(l, "    count: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A value that only goes up.")
    strs_push(l, "pub struct Counter {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    help: Str,")
    strs_push(l, "    labels: Str,")
    strs_push(l, "    why: Str,")
    strs_push(l, "    value: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A value that goes up and down.")
    strs_push(l, "pub struct Gauge {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    help: Str,")
    strs_push(l, "    labels: Str,")
    strs_push(l, "    why: Str,")
    strs_push(l, "    value: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Observations counted into at most sixteen buckets by upper bound, with their count and sum.")
    strs_push(l, "pub struct Histogram {")
    strs_push(l, "    name: Str,")
    strs_push(l, "    help: Str,")
    strs_push(l, "    labels: Str,")
    strs_push(l, "    why: Str,")
    strs_push(l, "    bounds: Int,")
    strs_push(l, "    b0: Bucket,")
    strs_push(l, "    b1: Bucket,")
    strs_push(l, "    b2: Bucket,")
    strs_push(l, "    b3: Bucket,")
    strs_push(l, "    b4: Bucket,")
    strs_push(l, "    b5: Bucket,")
    strs_push(l, "    b6: Bucket,")
    strs_push(l, "    b7: Bucket,")
    strs_push(l, "    b8: Bucket,")
    strs_push(l, "    b9: Bucket,")
    strs_push(l, "    b10: Bucket,")
    strs_push(l, "    b11: Bucket,")
    strs_push(l, "    b12: Bucket,")
    strs_push(l, "    b13: Bucket,")
    strs_push(l, "    b14: Bucket,")
    strs_push(l, "    b15: Bucket,")
    strs_push(l, "    sum: Atomic,")
    strs_push(l, "    count: Atomic,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What a registry holds.")
    strs_push(l, "pub enum Metric {")
    strs_push(l, "    OfCounter(c: Counter),")
    strs_push(l, "    OfGauge(g: Gauge),")
    strs_push(l, "    OfHistogram(h: Histogram),")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A registry: the metrics `metrics_render` writes, in the order their names were first")
    strs_push(l, "/// registered. `lock` lets one registration or rendering at a time look at `items`.")
    strs_push(l, "pub struct Metrics {")
    strs_push(l, "    items: Chan[Metric],")
    strs_push(l, "    count: Atomic,")
    strs_push(l, "    lock: Chan,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Names and labels")
    strs_push(l, "")
    strs_push(l, "fn name_ok(s: Str, colons: Bool) -> Bool ! {} {")
    strs_push(l, "    if str_len(s) == 0 { return false; }")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || (colons && b == 58);")
    strs_push(l, "        if !letter && !(i > 0 && b >= 48 && b <= 57) { return false; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    true")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn escaped(s: Str, quote: Bool) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut from = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let with = if b == 92 { \"\\\\\\\\\" } else { if b == 10 { \"\\\\n\" } else { if quote && b == 34 { \"\\\\\\\"\" } else { \"\" } } };")
    strs_push(l, "        if str_len(with) > 0 {")
    strs_push(l, "            strs_push(parts, str_slice(s, from, i));")
    strs_push(l, "            strs_push(parts, with);")
    strs_push(l, "            from = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    strs_push(parts, str_slice(s, from, str_len(s)));")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The labels `pairs` (key, value, key, value, …) as the exposition writes them inside braces, and")
    strs_push(l, "// what is wrong with them, `\"\"` when nothing is.")
    strs_push(l, "struct Labels {")
    strs_push(l, "    text: Str,")
    strs_push(l, "    why: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn labels_of(pairs: Strs) -> Labels ! {} {")
    strs_push(l, "    if strs_len(pairs) % 2 != 0 { return Labels(text: \"\", why: \"a label without a value\"); }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(pairs) {")
    strs_push(l, "        let k = strs_get(pairs, i);")
    strs_push(l, "        if !name_ok(k, false) || (str_len(k) >= 2 && str_slice(k, 0, 2) == \"__\") || k == \"le\" {")
    strs_push(l, "            return Labels(text: \"\", why: str_concat(\"a label name that is not one: \", k));")
    strs_push(l, "        }")
    strs_push(l, "        let mut j = 0;")
    strs_push(l, "        while j < i {")
    strs_push(l, "            if strs_get(pairs, j) == k { return Labels(text: \"\", why: str_concat(\"a label given twice: \", k)); }")
    strs_push(l, "            j = j + 2;")
    strs_push(l, "        }")
    strs_push(l, "        strs_push(parts, str_concat(str_concat(str_concat(k, \"=\\\"\"), escaped(strs_get(pairs, i + 1), true)), \"\\\"\"));")
    strs_push(l, "        i = i + 2;")
    strs_push(l, "    }")
    strs_push(l, "    Labels(text: str_join(parts, \",\"), why: \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn checked(name: Str, l: Labels) -> Str ! {} {")
    strs_push(l, "    if !name_ok(name, true) { return str_concat(\"a metric name that is not one: \", name); }")
    strs_push(l, "    l.why")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Counters and gauges")
    strs_push(l, "")
    strs_push(l, "/// A counter at zero, without labels.")
    strs_push(l, "pub fn metrics_counter(name: Str, help: Str) -> Counter ! {} {")
    strs_push(l, "    metrics_counter_labelled(name, help, strs_new())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A counter at zero with `labels`, given as key, value, key, value, ….")
    strs_push(l, "pub fn metrics_counter_labelled(name: Str, help: Str, labels: Strs) -> Counter ! {} {")
    strs_push(l, "    let l = labels_of(labels);")
    strs_push(l, "    Counter(name: name, help: help, labels: l.text, why: checked(name, l), value: atomic_new(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add one.")
    strs_push(l, "pub fn metrics_inc(c: Counter) -> Int ! {} {")
    strs_push(l, "    atomic_add(c.value, 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add `n`; a counter never goes down, so a negative `n` changes nothing and answers `false`.")
    strs_push(l, "pub fn metrics_add(c: Counter, n: Int) -> Bool ! {} {")
    strs_push(l, "    if n < 0 { return false; }")
    strs_push(l, "    atomic_add(c.value, n);")
    strs_push(l, "    true")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The counter's value.")
    strs_push(l, "pub fn metrics_counter_value(c: Counter) -> Int ! {} {")
    strs_push(l, "    atomic_load(c.value)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A gauge at zero, without labels.")
    strs_push(l, "pub fn metrics_gauge(name: Str, help: Str) -> Gauge ! {} {")
    strs_push(l, "    metrics_gauge_labelled(name, help, strs_new())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A gauge at zero with `labels`, given as key, value, key, value, ….")
    strs_push(l, "pub fn metrics_gauge_labelled(name: Str, help: Str, labels: Strs) -> Gauge ! {} {")
    strs_push(l, "    let l = labels_of(labels);")
    strs_push(l, "    Gauge(name: name, help: help, labels: l.text, why: checked(name, l), value: atomic_new(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Set the gauge to `v`.")
    strs_push(l, "pub fn metrics_gauge_set(g: Gauge, v: Int) -> Int ! {} {")
    strs_push(l, "    atomic_store(g.value, v)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add `d` (negative: take it away).")
    strs_push(l, "pub fn metrics_gauge_add(g: Gauge, d: Int) -> Int ! {} {")
    strs_push(l, "    atomic_add(g.value, d);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The gauge's value.")
    strs_push(l, "pub fn metrics_gauge_value(g: Gauge) -> Int ! {} {")
    strs_push(l, "    atomic_load(g.value)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Histograms")
    strs_push(l, "")
    strs_push(l, "fn bucket_new(bounds: Ints, i: Int) -> Bucket ! {} {")
    strs_push(l, "    Bucket(le: if i < ints_len(bounds) { ints_get(bounds, i) } else { 0 }, count: atomic_new(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A histogram with no observations, without labels; `bounds` are the buckets' upper bounds,")
    strs_push(l, "/// increasing, at most sixteen (the `+Inf` bucket is always there besides).")
    strs_push(l, "pub fn metrics_histogram(name: Str, help: Str, bounds: Ints) -> Histogram ! {} {")
    strs_push(l, "    metrics_histogram_labelled(name, help, bounds, strs_new())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A histogram with `labels`, given as key, value, key, value, ….")
    strs_push(l, "pub fn metrics_histogram_labelled(name: Str, help: Str, bounds: Ints, labels: Strs) -> Histogram ! {} {")
    strs_push(l, "    let l = labels_of(labels);")
    strs_push(l, "    let mut why = checked(name, l);")
    strs_push(l, "    if str_len(why) == 0 && ints_len(bounds) > 16 { why = \"more than sixteen bucket bounds\"; }")
    strs_push(l, "    let mut i = 1;")
    strs_push(l, "    while str_len(why) == 0 && i < ints_len(bounds) {")
    strs_push(l, "        if ints_get(bounds, i) <= ints_get(bounds, i - 1) { why = \"bucket bounds that do not increase\"; }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let n = if ints_len(bounds) > 16 { 16 } else { ints_len(bounds) };")
    strs_push(l, "    Histogram(name: name, help: help, labels: l.text, why: why, bounds: n,")
    strs_push(l, "        b0: bucket_new(bounds, 0), b1: bucket_new(bounds, 1), b2: bucket_new(bounds, 2), b3: bucket_new(bounds, 3),")
    strs_push(l, "        b4: bucket_new(bounds, 4), b5: bucket_new(bounds, 5), b6: bucket_new(bounds, 6), b7: bucket_new(bounds, 7),")
    strs_push(l, "        b8: bucket_new(bounds, 8), b9: bucket_new(bounds, 9), b10: bucket_new(bounds, 10), b11: bucket_new(bounds, 11),")
    strs_push(l, "        b12: bucket_new(bounds, 12), b13: bucket_new(bounds, 13), b14: bucket_new(bounds, 14), b15: bucket_new(bounds, 15),")
    strs_push(l, "        sum: atomic_new(0), count: atomic_new(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn bucket_at(h: Histogram, i: Int) -> Bucket ! {} {")
    strs_push(l, "    if i < 8 {")
    strs_push(l, "        if i < 4 { if i == 0 { h.b0 } else { if i == 1 { h.b1 } else { if i == 2 { h.b2 } else { h.b3 } } } }")
    strs_push(l, "        else { if i == 4 { h.b4 } else { if i == 5 { h.b5 } else { if i == 6 { h.b6 } else { h.b7 } } } }")
    strs_push(l, "    } else {")
    strs_push(l, "        if i < 12 { if i == 8 { h.b8 } else { if i == 9 { h.b9 } else { if i == 10 { h.b10 } else { h.b11 } } } }")
    strs_push(l, "        else { if i == 12 { h.b12 } else { if i == 13 { h.b13 } else { if i == 14 { h.b14 } else { h.b15 } } } }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Count `v` into the first bucket whose bound is at least it (or only `+Inf`'s), and into the")
    strs_push(l, "/// sum and count.")
    strs_push(l, "pub fn metrics_observe(h: Histogram, v: Int) -> Int ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut placed = false;")
    strs_push(l, "    while i < h.bounds && !placed {")
    strs_push(l, "        let b = bucket_at(h, i);")
    strs_push(l, "        if v <= b.le {")
    strs_push(l, "            atomic_add(b.count, 1);")
    strs_push(l, "            placed = true;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    atomic_add(h.sum, v);")
    strs_push(l, "    atomic_add(h.count, 1);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many observations there have been.")
    strs_push(l, "pub fn metrics_histogram_count(h: Histogram) -> Int ! {} {")
    strs_push(l, "    atomic_load(h.count)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The sum of the observations.")
    strs_push(l, "pub fn metrics_histogram_sum(h: Histogram) -> Int ! {} {")
    strs_push(l, "    atomic_load(h.sum)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The registry and the exposition")
    strs_push(l, "")
    strs_push(l, "/// An empty registry, holding at most 1024 metrics.")
    strs_push(l, "pub fn metrics_registry() -> Metrics ! {} {")
    strs_push(l, "    Metrics(items: chan_new_of[Metric](1024), count: atomic_new(0), lock: chan_new(1))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn name_of(m: Metric) -> Str ! {} {")
    strs_push(l, "    match m { Metric.OfCounter(c: c) => c.name, Metric.OfGauge(g: g) => g.name, Metric.OfHistogram(h: h) => h.name, }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn labels_text(m: Metric) -> Str ! {} {")
    strs_push(l, "    match m { Metric.OfCounter(c: c) => c.labels, Metric.OfGauge(g: g) => g.labels, Metric.OfHistogram(h: h) => h.labels, }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn kind_of(m: Metric) -> Str ! {} {")
    strs_push(l, "    match m { Metric.OfCounter(c: c) => \"counter\", Metric.OfGauge(g: g) => \"gauge\", Metric.OfHistogram(h: h) => \"histogram\", }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn help_of(m: Metric) -> Str ! {} {")
    strs_push(l, "    match m { Metric.OfCounter(c: c) => c.help, Metric.OfGauge(g: g) => g.help, Metric.OfHistogram(h: h) => h.help, }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Every metric of `reg`, in order; the lock is held. They are taken out and put back in turn.")
    strs_push(l, "fn all_of(reg: Metrics) -> Vec[Metric] ! {} {")
    strs_push(l, "    let n = atomic_load(reg.count);")
    strs_push(l, "    let got = vec_new[Metric]();")
    strs_push(l, "    let one = vec_new[Metric]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        if chan_recv_of(reg.items, one) {")
    strs_push(l, "            let m = vec_pop(one);")
    strs_push(l, "            vec_push(got, m);")
    strs_push(l, "            chan_send_of(reg.items, m);")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    got")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn unlock(reg: Metrics) -> Int ! {} {")
    strs_push(l, "    let got = ints_new();")
    strs_push(l, "    chan_recv(reg.lock, got);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn register(reg: Metrics, m: Metric, why: Str) -> Result[Int, Str] ! {} {")
    strs_push(l, "    if str_len(why) > 0 { return Result[Int, Str].Err(error: why); }")
    strs_push(l, "    chan_send(reg.lock, 1);")
    strs_push(l, "    let all = all_of(reg);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(all) {")
    strs_push(l, "        let o = vec_get(all, i);")
    strs_push(l, "        if name_of(o) == name_of(m) {")
    strs_push(l, "            if kind_of(o) != kind_of(m) {")
    strs_push(l, "                unlock(reg);")
    strs_push(l, "                return Result[Int, Str].Err(error: str_concat(str_concat(name_of(m), \" is already a \"), kind_of(o)));")
    strs_push(l, "            }")
    strs_push(l, "            if labels_text(o) == labels_text(m) {")
    strs_push(l, "                unlock(reg);")
    strs_push(l, "                return Result[Int, Str].Err(error: str_concat(name_of(m), \" is already registered with these labels\"));")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if vec_len(all) >= 1024 {")
    strs_push(l, "        unlock(reg);")
    strs_push(l, "        return Result[Int, Str].Err(error: \"a registry holds at most 1024 metrics\");")
    strs_push(l, "    }")
    strs_push(l, "    chan_send_of(reg.items, m);")
    strs_push(l, "    atomic_add(reg.count, 1);")
    strs_push(l, "    unlock(reg);")
    strs_push(l, "    Result[Int, Str].Ok(value: vec_len(all))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add `c` to `reg`: an `Err` for a name or labels that are not valid, a name already registered")
    strs_push(l, "/// as another kind, or the same name with the same labels.")
    strs_push(l, "pub fn metrics_register_counter(reg: Metrics, c: Counter) -> Result[Int, Str] ! {} {")
    strs_push(l, "    register(reg, Metric.OfCounter(c: c), c.why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add `g` to `reg`, as `metrics_register_counter` adds a counter.")
    strs_push(l, "pub fn metrics_register_gauge(reg: Metrics, g: Gauge) -> Result[Int, Str] ! {} {")
    strs_push(l, "    register(reg, Metric.OfGauge(g: g), g.why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Add `h` to `reg`, as `metrics_register_counter` adds a counter; bounds that do not increase,")
    strs_push(l, "/// or more than sixteen, are an `Err` too.")
    strs_push(l, "pub fn metrics_register_histogram(reg: Metrics, h: Histogram) -> Result[Int, Str] ! {} {")
    strs_push(l, "    register(reg, Metric.OfHistogram(h: h), h.why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn sample(out: Strs, name: Str, labels: Str, extra: Str, value: Int) -> Int ! {} {")
    strs_push(l, "    let both = if str_len(labels) > 0 && str_len(extra) > 0 { str_concat(str_concat(labels, \",\"), extra) } else { str_concat(labels, extra) };")
    strs_push(l, "    let braces = if str_len(both) > 0 { str_concat(str_concat(\"{\", both), \"}\") } else { \"\" };")
    strs_push(l, "    strs_push(out, str_concat(str_concat(str_concat(name, braces), \" \"), str_concat(int_to_str(value), \"\\n\")));")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn samples(out: Strs, m: Metric) -> Int ! {} {")
    strs_push(l, "    match m {")
    strs_push(l, "        Metric.OfCounter(c: c) => { sample(out, c.name, c.labels, \"\", atomic_load(c.value)); },")
    strs_push(l, "        Metric.OfGauge(g: g) => { sample(out, g.name, g.labels, \"\", atomic_load(g.value)); },")
    strs_push(l, "        Metric.OfHistogram(h: h) => {")
    strs_push(l, "            // The count first, so that no bucket shows more than `_count` while observations land.")
    strs_push(l, "            let count = atomic_load(h.count);")
    strs_push(l, "            let sum = atomic_load(h.sum);")
    strs_push(l, "            let mut running = 0;")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            while i < h.bounds {")
    strs_push(l, "                let b = bucket_at(h, i);")
    strs_push(l, "                running = running + atomic_load(b.count);")
    strs_push(l, "                sample(out, str_concat(h.name, \"_bucket\"), h.labels, str_concat(str_concat(\"le=\\\"\", int_to_str(b.le)), \"\\\"\"), if running > count { count } else { running });")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "            sample(out, str_concat(h.name, \"_bucket\"), h.labels, \"le=\\\"+Inf\\\"\", count);")
    strs_push(l, "            sample(out, str_concat(h.name, \"_sum\"), h.labels, \"\", sum);")
    strs_push(l, "            sample(out, str_concat(h.name, \"_count\"), h.labels, \"\", count);")
    strs_push(l, "        },")
    strs_push(l, "    };")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `reg` holds as Prometheus text format 0.0.4: each name once with its `# HELP` (when it")
    strs_push(l, "/// has help) and `# TYPE`, in the order names were first registered, then its samples in registration order.")
    strs_push(l, "pub fn metrics_render(reg: Metrics) -> Str ! {} {")
    strs_push(l, "    chan_send(reg.lock, 1);")
    strs_push(l, "    let all = all_of(reg);")
    strs_push(l, "    unlock(reg);")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(all) {")
    strs_push(l, "        let m = vec_get(all, i);")
    strs_push(l, "        let mut first = true;")
    strs_push(l, "        let mut j = 0;")
    strs_push(l, "        while j < i {")
    strs_push(l, "            if name_of(vec_get(all, j)) == name_of(m) { first = false; }")
    strs_push(l, "            j = j + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if first {")
    strs_push(l, "            if str_len(help_of(m)) > 0 {")
    strs_push(l, "                strs_push(out, str_concat(str_concat(str_concat(\"# HELP \", name_of(m)), \" \"), str_concat(escaped(help_of(m), false), \"\\n\")));")
    strs_push(l, "            }")
    strs_push(l, "            strs_push(out, str_concat(str_concat(str_concat(\"# TYPE \", name_of(m)), \" \"), str_concat(kind_of(m), \"\\n\")));")
    strs_push(l, "            let mut k = i;")
    strs_push(l, "            while k < vec_len(all) {")
    strs_push(l, "                if name_of(vec_get(all, k)) == name_of(m) { samples(out, vec_get(all, k)); }")
    strs_push(l, "                k = k + 1;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(out, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The `content-type` of `metrics_render`'s text.")
    strs_push(l, "pub fn metrics_content_type() -> Str ! {} {")
    strs_push(l, "    \"text/plain; version=0.0.4; charset=utf-8\"")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_net() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/net`: TCP and UDP sockets, with every failure a value (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/net\";` beside `use \"@std/ioerror\";`. Whatever names an address —")
    strs_push(l, "// listening, connecting, binding, sending to one, resolving a name — takes the `NetCap` that")
    strs_push(l, "// allows it; whatever uses a socket takes only the socket. An address is `HOST:PORT` with a literal")
    strs_push(l, "// IPv4 host or a bracketed IPv6 one (`[::1]:8080`). A wait does not hold a worker: a task waiting")
    strs_push(l, "// on a socket parks, and the runtime's reactor wakes it. `docs/internal/general-purpose.md` §9–§10 is the")
    strs_push(l, "// design record; `docs/user/spec.md`, *Networking*, the built-ins beneath.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "")
    strs_push(l, "/// A socket listening for connections.")
    strs_push(l, "pub struct TcpListener {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A connected TCP socket.")
    strs_push(l, "pub struct TcpStream {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A UDP socket.")
    strs_push(l, "pub struct UdpSocket {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A datagram received: how many bytes were kept, and who sent it.")
    strs_push(l, "pub struct Datagram {")
    strs_push(l, "    size: Int,")
    strs_push(l, "    from: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn status_of(h: OsHandle) -> Int ! {} {")
    strs_push(l, "    os_status(h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A listener on `addr`; port `0` asks the system for one, which `tcp_listener_addr` reports.")
    strs_push(l, "pub fn tcp_listen(net: NetCap, addr: Str) -> Result[TcpListener, IoError] ! { io } {")
    strs_push(l, "    let h = os_tcp_listen(addr);")
    strs_push(l, "    let s = status_of(h);")
    strs_push(l, "    if s < 0 { Result[TcpListener, IoError].Err(error: io_context(io_error_from(s), addr)) } else { Result[TcpListener, IoError].Ok(value: TcpListener(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next connection; waits at most the listener's deadline.")
    strs_push(l, "pub fn tcp_accept(l: TcpListener) -> Result[TcpStream, IoError] ! { io } {")
    strs_push(l, "    let h = os_tcp_accept(l.handle);")
    strs_push(l, "    let s = status_of(h);")
    strs_push(l, "    if s < 0 { Result[TcpStream, IoError].Err(error: io_error_from(s)) } else { Result[TcpStream, IoError].Ok(value: TcpStream(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A connection to `addr`, giving up after `timeout_ms` milliseconds (`0`: the system's own).")
    strs_push(l, "pub fn tcp_connect(net: NetCap, addr: Str, timeout_ms: Int) -> Result[TcpStream, IoError] ! { io } {")
    strs_push(l, "    let h = os_tcp_connect(addr, timeout_ms);")
    strs_push(l, "    let s = status_of(h);")
    strs_push(l, "    if s < 0 { Result[TcpStream, IoError].Err(error: io_context(io_error_from(s), addr)) } else { Result[TcpStream, IoError].Ok(value: TcpStream(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What has arrived, at most `bytes_len(buf)`: how many, `0` once the peer has shut its side.")
    strs_push(l, "pub fn tcp_read(s: TcpStream, buf: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_read(s.handle, buf))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Exactly `bytes_len(buf)` bytes; `UnexpectedEof` if the peer shuts its side first.")
    strs_push(l, "pub fn tcp_read_exact(s: TcpStream, buf: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(buf) {")
    strs_push(l, "        let n = os_read(s.handle, bytes_slice(buf, at, bytes_len(buf)));")
    strs_push(l, "        if n < 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_from(n));")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_new(IoErrorKind.UnexpectedEof(), \"the peer shut its side\"));")
    strs_push(l, "        }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every byte of `data`, however many writes it takes.")
    strs_push(l, "pub fn tcp_write(s: TcpStream, data: Bytes) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(data) {")
    strs_push(l, "        let n = os_write(s.handle, bytes_slice(data, at, bytes_len(data)));")
    strs_push(l, "        if n < 0 {")
    strs_push(l, "            return Result[Int, IoError].Err(error: io_error_from(n));")
    strs_push(l, "        }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, IoError].Ok(value: at)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `text`'s bytes, as `tcp_write`.")
    strs_push(l, "pub fn tcp_write_str(s: TcpStream, text: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    tcp_write(s, bytes_from_str(text))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bound every later wait on `s` to `ms` milliseconds (`0`: no bound).")
    strs_push(l, "pub fn tcp_set_timeout(s: TcpStream, ms: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_set_timeout(s.handle, ms))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bound every later accept on `l` to `ms` milliseconds (`0`: no bound).")
    strs_push(l, "pub fn tcp_listener_set_timeout(l: TcpListener, ms: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_set_timeout(l.handle, ms))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Shut reading (`0`), writing (`1`) or both (`2`).")
    strs_push(l, "pub fn tcp_shutdown(s: TcpStream, how: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_shutdown(s.handle, how))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `s`; a task waiting on it wakes with `Closed`.")
    strs_push(l, "pub fn tcp_close(s: TcpStream) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_close(s.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `l`.")
    strs_push(l, "pub fn tcp_listener_close(l: TcpListener) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_close(l.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s`'s own address.")
    strs_push(l, "pub fn tcp_local_addr(s: TcpStream) -> Str ! { io } {")
    strs_push(l, "    os_local_addr(s.handle)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The address `s` is connected to.")
    strs_push(l, "pub fn tcp_peer_addr(s: TcpStream) -> Str ! { io } {")
    strs_push(l, "    os_peer_addr(s.handle)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The address `l` listens on.")
    strs_push(l, "pub fn tcp_listener_addr(l: TcpListener) -> Str ! { io } {")
    strs_push(l, "    os_local_addr(l.handle)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A UDP socket bound to `addr`.")
    strs_push(l, "pub fn udp_bind(net: NetCap, addr: Str) -> Result[UdpSocket, IoError] ! { io } {")
    strs_push(l, "    let h = os_udp_bind(addr);")
    strs_push(l, "    let s = status_of(h);")
    strs_push(l, "    if s < 0 { Result[UdpSocket, IoError].Err(error: io_context(io_error_from(s), addr)) } else { Result[UdpSocket, IoError].Ok(value: UdpSocket(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Send `data` to `addr` as one datagram: how many bytes went.")
    strs_push(l, "pub fn udp_send_to(net: NetCap, u: UdpSocket, data: Bytes, addr: Str) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_udp_send_to(u.handle, data, addr))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next datagram into `buf` (cut to its length), and its sender.")
    strs_push(l, "pub fn udp_recv_from(u: UdpSocket, buf: Bytes) -> Result[Datagram, IoError] ! { io } {")
    strs_push(l, "    let from = bytes_new(80);")
    strs_push(l, "    let n = os_udp_recv_from(u.handle, buf, from);")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        return Result[Datagram, IoError].Err(error: io_error_from(n));")
    strs_push(l, "    }")
    strs_push(l, "    let mut end = 0;")
    strs_push(l, "    while end < 80 && bytes_get(from, end) != UInt8(0) {")
    strs_push(l, "        end = end + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Datagram, IoError].Ok(value: Datagram(size: n, from: bytes_to_str(bytes_slice(from, 0, end))))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Bound every later wait on `u` to `ms` milliseconds (`0`: no bound).")
    strs_push(l, "pub fn udp_set_timeout(u: UdpSocket, ms: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_set_timeout(u.handle, ms))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `u`'s own address.")
    strs_push(l, "pub fn udp_local_addr(u: UdpSocket) -> Str ! { io } {")
    strs_push(l, "    os_local_addr(u.handle)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `u`.")
    strs_push(l, "pub fn udp_close(u: UdpSocket) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_close(u.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The addresses the system's resolver gives `name`, each with `port`, in its order.")
    strs_push(l, "pub fn net_resolve(net: NetCap, name: Str, port: Int) -> Result[Strs, IoError] ! { io } {")
    strs_push(l, "    let out = bytes_new(4096);")
    strs_push(l, "    let n = os_resolve(name, port, out);")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        return Result[Strs, IoError].Err(error: io_context(io_error_from(n), name));")
    strs_push(l, "    }")
    strs_push(l, "    let all = strs_new();")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i <= n {")
    strs_push(l, "        if i == n || bytes_get(out, i) == UInt8(10) {")
    strs_push(l, "            if i > start {")
    strs_push(l, "                strs_push(all, bytes_to_str(bytes_slice(out, start, i)));")
    strs_push(l, "            }")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Strs, IoError].Ok(value: all)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_num() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/num`: integer arithmetic beyond the operators.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/num\";`. Arithmetic that can overflow is checked like every operator:")
    strs_push(l, "// an overflow is `N0400`, never a wrapped value. `num_pow` says so before it would.")
    strs_push(l, "")
    strs_push(l, "/// The absolute value of `n`. `Int`'s minimum has none, so it overflows (`N0400`).")
    strs_push(l, "pub fn num_abs(n: Int) -> Int ! {} {")
    strs_push(l, "    if n < 0 { 0 - n } else { n }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `-1`, `0` or `1` as `n` is negative, zero or positive.")
    strs_push(l, "pub fn num_sign(n: Int) -> Int ! {} {")
    strs_push(l, "    if n < 0 { 0 - 1 } else { if n > 0 { 1 } else { 0 } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The smaller of `a` and `b`.")
    strs_push(l, "pub fn num_min(a: Int, b: Int) -> Int ! {} {")
    strs_push(l, "    if a < b { a } else { b }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The larger of `a` and `b`.")
    strs_push(l, "pub fn num_max(a: Int, b: Int) -> Int ! {} {")
    strs_push(l, "    if a > b { a } else { b }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `n` limited to `lo..=hi`; `lo` when `hi < lo`.")
    strs_push(l, "pub fn num_clamp(n: Int, lo: Int, hi: Int) -> Int ! {} {")
    strs_push(l, "    if n < lo { lo } else { if n > hi { if hi < lo { lo } else { hi } } else { n } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `base` to the power `exp`, or `None` when `exp` is negative or the result's magnitude exceeds")
    strs_push(l, "/// `Int`'s maximum — so `num_pow(-2, 63)`, which is `Int`'s minimum, is `None` too.")
    strs_push(l, "pub fn num_pow(base: Int, exp: Int) -> Option[Int] ! {} {")
    strs_push(l, "    if exp < 0 {")
    strs_push(l, "        Option[Int].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut acc = 1;")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        let mut ok = true;")
    strs_push(l, "        let limit = 9223372036854775807;")
    strs_push(l, "        while ok && i < exp {")
    strs_push(l, "            if base == 0 { acc = 0; i = exp; } else {")
    strs_push(l, "                // Checked before multiplying: `acc * base` fits when `|acc| <= limit / |base|`.")
    strs_push(l, "                let a = if acc < 0 { 0 - (acc + 1) } else { acc };")
    strs_push(l, "                let b = if base < 0 { 0 - (base + 1) } else { base };")
    strs_push(l, "                if b > 0 { if a > limit / (b + 1) { ok = false; } }")
    strs_push(l, "                if ok { acc = acc * base; i = i + 1; }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if ok { Option[Int].Some(value: acc) } else { Option[Int].None() }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The greatest common divisor of `a` and `b`, non-negative; `num_gcd(0, 0)` is `0`.")
    strs_push(l, "pub fn num_gcd(a: Int, b: Int) -> Int ! {} {")
    strs_push(l, "    let mut x = if a < 0 { 0 - a } else { a };")
    strs_push(l, "    let mut y = if b < 0 { 0 - b } else { b };")
    strs_push(l, "    while y != 0 { let r = x % y; x = y; y = r; }")
    strs_push(l, "    x")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_option() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/option`: the helpers every use of `Option` would otherwise write for itself.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/option\";`. `Option` itself is the prelude's. Nazm has no function")
    strs_push(l, "// values, so there is no `map`: a `match` is how an `Option` is taken apart.")
    strs_push(l, "")
    strs_push(l, "/// Whether `o` holds a value.")
    strs_push(l, "pub fn option_is_some[T](o: Option[T]) -> Bool ! {} {")
    strs_push(l, "    match o {")
    strs_push(l, "        Option.Some(value: v) => true,")
    strs_push(l, "        Option.None() => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `o` is empty.")
    strs_push(l, "pub fn option_is_none[T](o: Option[T]) -> Bool ! {} {")
    strs_push(l, "    match o {")
    strs_push(l, "        Option.Some(value: v) => false,")
    strs_push(l, "        Option.None() => true,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `o` holds, or `fallback`.")
    strs_push(l, "pub fn option_unwrap_or[T](o: Option[T], fallback: T) -> T ! {} {")
    strs_push(l, "    match o {")
    strs_push(l, "        Option.Some(value: v) => v,")
    strs_push(l, "        Option.None() => fallback,")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_ordmap() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/ordmap`: a map from `Ord` keys to values, in key order (R1e, S3).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/ordmap\";`. `Ord` is an ordinary trait, as `@std/hash`'s `Hash` is: the")
    strs_push(l, "// library implements it for every integer type, `Bool` and `Str` (byte by byte, a prefix first),")
    strs_push(l, "// and a program implements it for its own key types. An `OrdMap[K, V]` is an AVL tree whose nodes")
    strs_push(l, "// live in parallel vectors it shares like any handle: copies of a map are the same map. Every")
    strs_push(l, "// subtree's heights differ by at most one, so insertion, lookup and removal take `O(log n)`")
    strs_push(l, "// comparisons; a removed node's place is taken by the last one, so the vectors hold exactly the")
    strs_push(l, "// entries and nothing removed stays alive. Iteration is in ascending key order.")
    strs_push(l, "")
    strs_push(l, "/// A total order: `compare` is negative, zero or positive as `self` sorts before, with or after")
    strs_push(l, "/// `other`, and must be consistent — antisymmetric and transitive — for a map to find its keys.")
    strs_push(l, "pub trait Ord {")
    strs_push(l, "    fn compare(self: Self, other: Self) -> Int ! {};")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `-1`, `0` or `1` as `a` is less than, equal to or greater than `b`.")
    strs_push(l, "fn sign_of(less: Bool, greater: Bool) -> Int ! {} {")
    strs_push(l, "    if less { 0 - 1 } else { if greater { 1 } else { 0 } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Int {")
    strs_push(l, "    fn compare(self: Int, other: Int) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Int8 {")
    strs_push(l, "    fn compare(self: Int8, other: Int8) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Int16 {")
    strs_push(l, "    fn compare(self: Int16, other: Int16) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Int32 {")
    strs_push(l, "    fn compare(self: Int32, other: Int32) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Int128 {")
    strs_push(l, "    fn compare(self: Int128, other: Int128) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for UInt8 {")
    strs_push(l, "    fn compare(self: UInt8, other: UInt8) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for UInt16 {")
    strs_push(l, "    fn compare(self: UInt16, other: UInt16) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for UInt32 {")
    strs_push(l, "    fn compare(self: UInt32, other: UInt32) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for UInt64 {")
    strs_push(l, "    fn compare(self: UInt64, other: UInt64) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for UInt128 {")
    strs_push(l, "    fn compare(self: UInt128, other: UInt128) -> Int ! {} { sign_of(self < other, self > other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Bool {")
    strs_push(l, "    fn compare(self: Bool, other: Bool) -> Int ! {} { sign_of(!self && other, self && !other) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Ord for Str {")
    strs_push(l, "    fn compare(self: Str, other: Str) -> Int ! {} {")
    strs_push(l, "        let n = str_len(self);")
    strs_push(l, "        let k = str_len(other);")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        let mut r = 2;")
    strs_push(l, "        while r == 2 {")
    strs_push(l, "            if i == n { r = if i == k { 0 } else { 0 - 1 }; } else {")
    strs_push(l, "                if i == k { r = 1; } else {")
    strs_push(l, "                    let x = str_byte(self, i);")
    strs_push(l, "                    let y = str_byte(other, i);")
    strs_push(l, "                    if x < y { r = 0 - 1; } else { if x > y { r = 1; } else { i = i + 1; } }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        r")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One key and its value.")
    strs_push(l, "pub struct OrdEntry[K, V] {")
    strs_push(l, "    key: K,")
    strs_push(l, "    value: V,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A map from `K` to `V`, in key order. Node `i` is `keys[i]`, `values[i]`, its children")
    strs_push(l, "/// `left[i]` and `right[i]` (`-1` for none) and its subtree's `height[i]`; `meta` holds the root")
    strs_push(l, "/// (`-1` when empty) and whether the last insertion replaced a value.")
    strs_push(l, "pub struct OrdMap[K, V] {")
    strs_push(l, "    keys: Vec[K],")
    strs_push(l, "    values: Vec[V],")
    strs_push(l, "    left: Ints,")
    strs_push(l, "    right: Ints,")
    strs_push(l, "    height: Ints,")
    strs_push(l, "    meta: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An empty map.")
    strs_push(l, "pub fn ordmap_new[K: Ord, V]() -> OrdMap[K, V] ! {} {")
    strs_push(l, "    let meta = ints_new();")
    strs_push(l, "    ints_push(meta, 0 - 1);")
    strs_push(l, "    ints_push(meta, 0);")
    strs_push(l, "    OrdMap[K, V](keys: vec_new[K](), values: vec_new[V](), left: ints_new(), right: ints_new(), height: ints_new(), meta: meta)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many keys `m` holds.")
    strs_push(l, "pub fn ordmap_len[K: Ord, V](m: OrdMap[K, V]) -> Int ! {} {")
    strs_push(l, "    vec_len(m.keys)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn root[K: Ord, V](m: OrdMap[K, V]) -> Int ! {} {")
    strs_push(l, "    ints_get(m.meta, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn h[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    if n < 0 { 0 } else { ints_get(m.height, n) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Set `n`'s height from its children's.")
    strs_push(l, "fn fix[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    let a = h(m, ints_get(m.left, n));")
    strs_push(l, "    let b = h(m, ints_get(m.right, n));")
    strs_push(l, "    ints_set(m.height, n, if a > b { a + 1 } else { b + 1 });")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `n`'s left child raised above it; the subtree's new root.")
    strs_push(l, "fn raise_left[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    let l = ints_get(m.left, n);")
    strs_push(l, "    ints_set(m.left, n, ints_get(m.right, l));")
    strs_push(l, "    ints_set(m.right, l, n);")
    strs_push(l, "    fix(m, n);")
    strs_push(l, "    fix(m, l)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `n`'s right child raised above it; the subtree's new root.")
    strs_push(l, "fn raise_right[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    let r = ints_get(m.right, n);")
    strs_push(l, "    ints_set(m.right, n, ints_get(m.left, r));")
    strs_push(l, "    ints_set(m.left, r, n);")
    strs_push(l, "    fix(m, n);")
    strs_push(l, "    fix(m, r)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The subtree at `n`, its children balanced, made balanced again: its new root.")
    strs_push(l, "fn balance[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    fix(m, n);")
    strs_push(l, "    let l = ints_get(m.left, n);")
    strs_push(l, "    let r = ints_get(m.right, n);")
    strs_push(l, "    let d = h(m, l) - h(m, r);")
    strs_push(l, "    if d > 1 {")
    strs_push(l, "        if h(m, ints_get(m.left, l)) < h(m, ints_get(m.right, l)) {")
    strs_push(l, "            ints_set(m.left, n, raise_right(m, l));")
    strs_push(l, "        }")
    strs_push(l, "        raise_left(m, n)")
    strs_push(l, "    } else {")
    strs_push(l, "        if d < 0 - 1 {")
    strs_push(l, "            if h(m, ints_get(m.right, r)) < h(m, ints_get(m.left, r)) {")
    strs_push(l, "                ints_set(m.right, n, raise_left(m, r));")
    strs_push(l, "            }")
    strs_push(l, "            raise_right(m, n)")
    strs_push(l, "        } else {")
    strs_push(l, "            n")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// A new node holding `key` and `value`, with no children.")
    strs_push(l, "fn node[K: Ord, V](m: OrdMap[K, V], key: K, value: V) -> Int ! {} {")
    strs_push(l, "    vec_push(m.keys, key);")
    strs_push(l, "    vec_push(m.values, value);")
    strs_push(l, "    ints_push(m.left, 0 - 1);")
    strs_push(l, "    ints_push(m.right, 0 - 1);")
    strs_push(l, "    ints_push(m.height, 1);")
    strs_push(l, "    vec_len(m.keys) - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `key` given `value` in the subtree at `n`: the subtree's new root.")
    strs_push(l, "fn insert_at[K: Ord, V](m: OrdMap[K, V], n: Int, key: K, value: V) -> Int ! {} {")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        node(m, key, value)")
    strs_push(l, "    } else {")
    strs_push(l, "        let c = key.compare(vec_get(m.keys, n));")
    strs_push(l, "        if c < 0 {")
    strs_push(l, "            ints_set(m.left, n, insert_at(m, ints_get(m.left, n), key, value));")
    strs_push(l, "            balance(m, n)")
    strs_push(l, "        } else {")
    strs_push(l, "            if c > 0 {")
    strs_push(l, "                ints_set(m.right, n, insert_at(m, ints_get(m.right, n), key, value));")
    strs_push(l, "                balance(m, n)")
    strs_push(l, "            } else {")
    strs_push(l, "                vec_set(m.values, n, value);")
    strs_push(l, "                ints_set(m.meta, 1, 1);")
    strs_push(l, "                n")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The node holding `key`, or `-1`.")
    strs_push(l, "fn find[K: Ord, V](m: OrdMap[K, V], key: K) -> Int ! {} {")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    while n >= 0 && found < 0 {")
    strs_push(l, "        let c = key.compare(vec_get(m.keys, n));")
    strs_push(l, "        if c < 0 { n = ints_get(m.left, n); } else { if c > 0 { n = ints_get(m.right, n); } else { found = n; } }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, or `None`.")
    strs_push(l, "pub fn ordmap_get[K: Ord, V](m: OrdMap[K, V], key: K) -> Option[V] ! {} {")
    strs_push(l, "    let at = find(m, key);")
    strs_push(l, "    if at < 0 { Option[V].None() } else { Option[V].Some(value: vec_get(m.values, at)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, which it must hold: `m[key]` (R1, 5b.7). Where it holds none")
    strs_push(l, "/// this traps, as an index out of range does.")
    strs_push(l, "pub fn ordmap_at[K: Ord, V](m: OrdMap[K, V], key: K) -> V ! {} {")
    strs_push(l, "    vec_get(m.values, find(m, key))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value `m` holds for `key`, or `fallback`: what `m[key] += n` reads (R1, 5b.7).")
    strs_push(l, "pub fn ordmap_at_or[K: Ord, V](m: OrdMap[K, V], key: K, fallback: V) -> V ! {} {")
    strs_push(l, "    let at = find(m, key);")
    strs_push(l, "    if at < 0 { fallback } else { vec_get(m.values, at) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `m` holds `key`.")
    strs_push(l, "pub fn ordmap_has[K: Ord, V](m: OrdMap[K, V], key: K) -> Bool ! {} {")
    strs_push(l, "    find(m, key) >= 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give `key` the value `value` in `m`, replacing any it had; whether one was replaced.")
    strs_push(l, "pub fn ordmap_set[K: Ord, V](m: OrdMap[K, V], key: K, value: V) -> Bool ! {} {")
    strs_push(l, "    ints_set(m.meta, 1, 0);")
    strs_push(l, "    ints_set(m.meta, 0, insert_at(m, root(m), key, value));")
    strs_push(l, "    ints_get(m.meta, 1) == 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The subtree at `n` without its least node, which is left detached: the subtree's new root.")
    strs_push(l, "fn remove_min[K: Ord, V](m: OrdMap[K, V], n: Int) -> Int ! {} {")
    strs_push(l, "    let l = ints_get(m.left, n);")
    strs_push(l, "    if l < 0 {")
    strs_push(l, "        ints_get(m.right, n)")
    strs_push(l, "    } else {")
    strs_push(l, "        ints_set(m.left, n, remove_min(m, l));")
    strs_push(l, "        balance(m, n)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The subtree at `n` without `key`'s node, which is left detached (`meta[1]` is its index, or")
    strs_push(l, "// `-1` when `key` was not there): the subtree's new root.")
    strs_push(l, "fn remove_at[K: Ord, V](m: OrdMap[K, V], n: Int, key: K) -> Int ! {} {")
    strs_push(l, "    if n < 0 {")
    strs_push(l, "        n")
    strs_push(l, "    } else {")
    strs_push(l, "        let c = key.compare(vec_get(m.keys, n));")
    strs_push(l, "        if c < 0 {")
    strs_push(l, "            ints_set(m.left, n, remove_at(m, ints_get(m.left, n), key));")
    strs_push(l, "            balance(m, n)")
    strs_push(l, "        } else {")
    strs_push(l, "            if c > 0 {")
    strs_push(l, "                ints_set(m.right, n, remove_at(m, ints_get(m.right, n), key));")
    strs_push(l, "                balance(m, n)")
    strs_push(l, "            } else {")
    strs_push(l, "                ints_set(m.meta, 1, n);")
    strs_push(l, "                let l = ints_get(m.left, n);")
    strs_push(l, "                let r = ints_get(m.right, n);")
    strs_push(l, "                if l < 0 { r } else {")
    strs_push(l, "                    if r < 0 { l } else {")
    strs_push(l, "                        // The least node of the right subtree takes `n`'s place.")
    strs_push(l, "                        let mut s = r;")
    strs_push(l, "                        while ints_get(m.left, s) >= 0 { s = ints_get(m.left, s); }")
    strs_push(l, "                        ints_set(m.right, s, remove_min(m, r));")
    strs_push(l, "                        ints_set(m.left, s, l);")
    strs_push(l, "                        balance(m, s)")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The detached node `x` removed from the vectors: the last node moves into its place, and the")
    strs_push(l, "// link that reached the last node reaches it there.")
    strs_push(l, "fn compact[K: Ord, V](m: OrdMap[K, V], x: Int) -> Int ! {} {")
    strs_push(l, "    let last = vec_len(m.keys) - 1;")
    strs_push(l, "    if x != last {")
    strs_push(l, "        let key = vec_get(m.keys, last);")
    strs_push(l, "        let mut parent = 0 - 1;")
    strs_push(l, "        let mut n = root(m);")
    strs_push(l, "        while n != last {")
    strs_push(l, "            parent = n;")
    strs_push(l, "            n = if key.compare(vec_get(m.keys, n)) < 0 { ints_get(m.left, n) } else { ints_get(m.right, n) };")
    strs_push(l, "        }")
    strs_push(l, "        if parent < 0 { ints_set(m.meta, 0, x); } else {")
    strs_push(l, "            if ints_get(m.left, parent) == last { ints_set(m.left, parent, x); } else { ints_set(m.right, parent, x); }")
    strs_push(l, "        }")
    strs_push(l, "        vec_set(m.keys, x, key);")
    strs_push(l, "        vec_set(m.values, x, vec_get(m.values, last));")
    strs_push(l, "        ints_set(m.left, x, ints_get(m.left, last));")
    strs_push(l, "        ints_set(m.right, x, ints_get(m.right, last));")
    strs_push(l, "        ints_set(m.height, x, ints_get(m.height, last));")
    strs_push(l, "    }")
    strs_push(l, "    let k = vec_pop(m.keys);")
    strs_push(l, "    let v = vec_pop(m.values);")
    strs_push(l, "    let a = ints_pop(m.left);")
    strs_push(l, "    let b = ints_pop(m.right);")
    strs_push(l, "    let c = ints_pop(m.height);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Take `key` out of `m`, with the value it had, or `None` when it had none.")
    strs_push(l, "pub fn ordmap_remove[K: Ord, V](m: OrdMap[K, V], key: K) -> Option[V] ! {} {")
    strs_push(l, "    let at = find(m, key);")
    strs_push(l, "    if at < 0 {")
    strs_push(l, "        Option[V].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let gone = vec_get(m.values, at);")
    strs_push(l, "        ints_set(m.meta, 0, remove_at(m, root(m), key));")
    strs_push(l, "        compact(m, at);")
    strs_push(l, "        Option[V].Some(value: gone)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The least key of `m`, or `None` when it is empty.")
    strs_push(l, "pub fn ordmap_first[K: Ord, V](m: OrdMap[K, V]) -> Option[K] ! {} {")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    if n < 0 { Option[K].None() } else {")
    strs_push(l, "        while ints_get(m.left, n) >= 0 { n = ints_get(m.left, n); }")
    strs_push(l, "        Option[K].Some(value: vec_get(m.keys, n))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The greatest key of `m`, or `None` when it is empty.")
    strs_push(l, "pub fn ordmap_last[K: Ord, V](m: OrdMap[K, V]) -> Option[K] ! {} {")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    if n < 0 { Option[K].None() } else {")
    strs_push(l, "        while ints_get(m.right, n) >= 0 { n = ints_get(m.right, n); }")
    strs_push(l, "        Option[K].Some(value: vec_get(m.keys, n))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The greatest key of `m` that is not after `key`, or `None`.")
    strs_push(l, "pub fn ordmap_floor[K: Ord, V](m: OrdMap[K, V], key: K) -> Option[K] ! {} {")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    let mut best = 0 - 1;")
    strs_push(l, "    while n >= 0 {")
    strs_push(l, "        let c = key.compare(vec_get(m.keys, n));")
    strs_push(l, "        if c < 0 { n = ints_get(m.left, n); } else {")
    strs_push(l, "            best = n;")
    strs_push(l, "            n = if c > 0 { ints_get(m.right, n) } else { 0 - 1 };")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if best < 0 { Option[K].None() } else { Option[K].Some(value: vec_get(m.keys, best)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The least key of `m` that is not before `key`, or `None`.")
    strs_push(l, "pub fn ordmap_ceiling[K: Ord, V](m: OrdMap[K, V], key: K) -> Option[K] ! {} {")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    let mut best = 0 - 1;")
    strs_push(l, "    while n >= 0 {")
    strs_push(l, "        let c = key.compare(vec_get(m.keys, n));")
    strs_push(l, "        if c > 0 { n = ints_get(m.right, n); } else {")
    strs_push(l, "            best = n;")
    strs_push(l, "            n = if c < 0 { ints_get(m.left, n) } else { 0 - 1 };")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if best < 0 { Option[K].None() } else { Option[K].Some(value: vec_get(m.keys, best)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Every node of `m` with a key in `lo..hi` — every node, when `bounded` is false — in key order.")
    strs_push(l, "fn walk[K: Ord, V](m: OrdMap[K, V], bounded: Bool, lo: K, hi: K) -> Ints ! {} {")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    let stack = ints_new();")
    strs_push(l, "    let mut n = root(m);")
    strs_push(l, "    while n >= 0 || ints_len(stack) > 0 {")
    strs_push(l, "        if n >= 0 {")
    strs_push(l, "            // A subtree wholly before `lo` is passed over, its right side still visited.")
    strs_push(l, "            if bounded && vec_get(m.keys, n).compare(lo) < 0 {")
    strs_push(l, "                n = ints_get(m.right, n);")
    strs_push(l, "            } else {")
    strs_push(l, "                ints_push(stack, n);")
    strs_push(l, "                n = ints_get(m.left, n);")
    strs_push(l, "            }")
    strs_push(l, "        } else {")
    strs_push(l, "            let top = ints_pop(stack);")
    strs_push(l, "            if bounded && vec_get(m.keys, top).compare(hi) >= 0 {")
    strs_push(l, "                // Everything left on the stack and to the right is at or after `hi`.")
    strs_push(l, "                while ints_len(stack) > 0 { let x = ints_pop(stack); }")
    strs_push(l, "                n = 0 - 1;")
    strs_push(l, "            } else {")
    strs_push(l, "                ints_push(out, top);")
    strs_push(l, "                n = ints_get(m.right, top);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn all_nodes[K: Ord, V](m: OrdMap[K, V]) -> Ints ! {} {")
    strs_push(l, "    if vec_len(m.keys) == 0 { ints_new() } else {")
    strs_push(l, "        let k = vec_get(m.keys, 0);")
    strs_push(l, "        walk(m, false, k, k)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every key of `m`, in ascending order.")
    strs_push(l, "pub fn ordmap_keys[K: Ord, V](m: OrdMap[K, V]) -> Vec[K] ! {} {")
    strs_push(l, "    let nodes = all_nodes(m);")
    strs_push(l, "    let out = vec_new[K]();")
    strs_push(l, "    for i in 0..ints_len(nodes) { vec_push(out, vec_get(m.keys, ints_get(nodes, i))); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every value of `m`, in its keys' order.")
    strs_push(l, "pub fn ordmap_values[K: Ord, V](m: OrdMap[K, V]) -> Vec[V] ! {} {")
    strs_push(l, "    let nodes = all_nodes(m);")
    strs_push(l, "    let out = vec_new[V]();")
    strs_push(l, "    for i in 0..ints_len(nodes) { vec_push(out, vec_get(m.values, ints_get(nodes, i))); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn entries_of[K: Ord, V](m: OrdMap[K, V], nodes: Ints) -> Vec[OrdEntry[K, V]] ! {} {")
    strs_push(l, "    let out = vec_new[OrdEntry[K, V]]();")
    strs_push(l, "    for i in 0..ints_len(nodes) {")
    strs_push(l, "        let n = ints_get(nodes, i);")
    strs_push(l, "        vec_push(out, OrdEntry[K, V](key: vec_get(m.keys, n), value: vec_get(m.values, n)));")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every entry of `m`, in ascending key order.")
    strs_push(l, "pub fn ordmap_entries[K: Ord, V](m: OrdMap[K, V]) -> Vec[OrdEntry[K, V]] ! {} {")
    strs_push(l, "    entries_of(m, all_nodes(m))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The entries of `m` whose keys are at or after `lo` and before `hi`, in ascending key order:")
    strs_push(l, "/// `O(log n)` comparisons and one step an entry returned.")
    strs_push(l, "pub fn ordmap_range[K: Ord, V](m: OrdMap[K, V], lo: K, hi: K) -> Vec[OrdEntry[K, V]] ! {} {")
    strs_push(l, "    entries_of(m, walk(m, true, lo, hi))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_path() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/path`: paths as text, separated by `/`.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/path\";`. Every function is pure: none reads the file system, so none")
    strs_push(l, "// knows whether a path exists or where a link points. `..` is resolved lexically.")
    strs_push(l, "")
    strs_push(l, "/// `rest` after `base` with one `/` between; `rest` itself when it is absolute or `base` is `\"\"`.")
    strs_push(l, "pub fn path_join(base: Str, rest: Str) -> Str ! {} {")
    strs_push(l, "    if str_len(base) == 0 { rest } else {")
    strs_push(l, "        if str_len(rest) > 0 && str_byte(rest, 0) == 47 { rest } else {")
    strs_push(l, "            if str_byte(base, str_len(base) - 1) == 47 { str_concat(base, rest) } else { str_concat(str_concat(base, \"/\"), rest) }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The index of the last `/` in `p`, or -1.")
    strs_push(l, "fn last_slash(p: Str) -> Int ! {} {")
    strs_push(l, "    let mut i = str_len(p);")
    strs_push(l, "    let mut at = 0 - 1;")
    strs_push(l, "    while at < 0 && i > 0 { i = i - 1; if str_byte(p, i) == 47 { at = i; } }")
    strs_push(l, "    at")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The last component of `p`: what follows its last `/`, or `p` when it has none.")
    strs_push(l, "pub fn path_base(p: Str) -> Str ! {} {")
    strs_push(l, "    let at = last_slash(p);")
    strs_push(l, "    if at < 0 { p } else { str_slice(p, at + 1, str_len(p)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Everything before `p`'s last component: `.` when it has no `/`, `/` for a top-level path.")
    strs_push(l, "pub fn path_dir(p: Str) -> Str ! {} {")
    strs_push(l, "    let at = last_slash(p);")
    strs_push(l, "    if at < 0 { \".\" } else { if at == 0 { \"/\" } else { str_slice(p, 0, at) } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The last component's extension, without its `.`: `\"\"` when it has none, or when its only `.`")
    strs_push(l, "/// begins it, as in `.profile`.")
    strs_push(l, "pub fn path_ext(p: Str) -> Str ! {} {")
    strs_push(l, "    let b = path_base(p);")
    strs_push(l, "    let mut i = str_len(b);")
    strs_push(l, "    let mut at = 0 - 1;")
    strs_push(l, "    while at < 0 && i > 1 { i = i - 1; if str_byte(b, i) == 46 { at = i; } }")
    strs_push(l, "    if at < 0 { \"\" } else { str_slice(b, at + 1, str_len(b)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The last component without its extension.")
    strs_push(l, "pub fn path_stem(p: Str) -> Str ! {} {")
    strs_push(l, "    let b = path_base(p);")
    strs_push(l, "    let e = path_ext(p);")
    strs_push(l, "    if str_len(e) == 0 { b } else { str_slice(b, 0, str_len(b) - str_len(e) - 1) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `p` with empty and `.` components removed and each `..` taking the component before it away,")
    strs_push(l, "/// lexically. An absolute path stays absolute, and `..` above its root stays at the root; a")
    strs_push(l, "/// relative path keeps the `..`s it cannot resolve. `\"\"` and `.` normalise to `.`.")
    strs_push(l, "pub fn path_normalize(p: Str) -> Str ! {} {")
    strs_push(l, "    let absolute = str_len(p) > 0 && str_byte(p, 0) == 47;")
    strs_push(l, "    let kept = strs_new();")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let n = str_len(p);")
    strs_push(l, "    while i <= n {")
    strs_push(l, "        if i == n || str_byte(p, i) == 47 {")
    strs_push(l, "            let part = str_slice(p, start, i);")
    strs_push(l, "            if str_len(part) == 0 || part == \".\" {")
    strs_push(l, "                let skip = 0;")
    strs_push(l, "            } else {")
    strs_push(l, "                if part == \"..\" {")
    strs_push(l, "                    let k = strs_len(kept);")
    strs_push(l, "                    if k > 0 && strs_get(kept, k - 1) != \"..\" { let gone = strs_pop(kept); } else {")
    strs_push(l, "                        if !absolute { strs_push(kept, \"..\"); }")
    strs_push(l, "                    }")
    strs_push(l, "                } else {")
    strs_push(l, "                    strs_push(kept, part);")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let body = str_join(kept, \"/\");")
    strs_push(l, "    if absolute { str_concat(\"/\", body) } else { if str_len(body) == 0 { \".\" } else { body } }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_process() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/process`: the process's arguments as one sequence, and (Gate 2) other programs.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/process\";`. `exit_with` is a built-in and is not wrapped: a second")
    strs_push(l, "// name for it would be a second way to say one thing. Running another program is every authority")
    strs_push(l, "// that program has, so it takes a `ProcessCap`; a child already started is its own handle's, and")
    strs_push(l, "// its pipes are `@std/file` `File`s. `docs/internal/general-purpose.md` §12.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "use \"@std/file\";")
    strs_push(l, "")
    strs_push(l, "/// Every argument the process was started with, in order, without the program's own name.")
    strs_push(l, "pub fn process_args(io: IoCap) -> Strs ! { io } {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < args_count() { strs_push(out, arg(i)); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A program started by `process_spawn`.")
    strs_push(l, "pub struct Child {")
    strs_push(l, "    handle: OsHandle,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What `process_run` collected: the exit status (the code, or 256 and the signal that ended")
    strs_push(l, "/// the program), and everything it wrote to its output and its errors.")
    strs_push(l, "pub struct ProcessOutput {")
    strs_push(l, "    status: Int,")
    strs_push(l, "    stdout: Str,")
    strs_push(l, "    stderr: Str,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Start `program`, found on `PATH` as a shell would find it, with `args`; its standard input,")
    strs_push(l, "/// output and errors are pipes.")
    strs_push(l, "pub fn process_spawn(p: ProcessCap, program: Str, args: Strs) -> Result[Child, IoError] ! { io } {")
    strs_push(l, "    let h = os_spawn(program, args);")
    strs_push(l, "    let s = os_status(h);")
    strs_push(l, "    if s < 0 { Result[Child, IoError].Err(error: io_context(io_error_from(s), program)) } else { Result[Child, IoError].Ok(value: Child(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The pipe to `c`'s standard input.")
    strs_push(l, "pub fn process_stdin(c: Child) -> File ! { io } {")
    strs_push(l, "    File(handle: os_child_pipe(c.handle, 0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The pipe from `c`'s standard output.")
    strs_push(l, "pub fn process_stdout(c: Child) -> File ! { io } {")
    strs_push(l, "    File(handle: os_child_pipe(c.handle, 1))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The pipe from `c`'s standard error.")
    strs_push(l, "pub fn process_stderr(c: Child) -> File ! { io } {")
    strs_push(l, "    File(handle: os_child_pipe(c.handle, 2))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Wait for `c` to end: its exit code, or 256 and the signal that ended it. The wait holds the")
    strs_push(l, "/// task's worker until the program ends.")
    strs_push(l, "pub fn process_wait(c: Child) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_wait(c.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// End `c` now (`SIGKILL`); nothing for a child already waited for.")
    strs_push(l, "pub fn process_kill(c: Child) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_kill(c.handle))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn feed(input: OsHandle, text: Str) -> Int ! { io } {")
    strs_push(l, "    file_write(File(handle: input), bytes_from_str(text));")
    strs_push(l, "    os_close(input);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn collect(from: OsHandle, into: Chan[Str]) -> Int ! { io } {")
    strs_push(l, "    let all = match file_read_rest(File(handle: from)) {")
    strs_push(l, "        Result.Ok(value: b) => bytes_to_str(b),")
    strs_push(l, "        Result.Err(error: e) => \"\",")
    strs_push(l, "    };")
    strs_push(l, "    chan_send_of(into, all);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Run `program` with `args`, `input` on its standard input, to its end: its status, output and")
    strs_push(l, "/// errors. The input and the errors move in tasks of their own, so a program writing a great deal")
    strs_push(l, "/// to both streams never waits on a pipe nobody reads.")
    strs_push(l, "pub fn process_run(p: ProcessCap, sp: SpawnCap, program: Str, args: Strs, input: Bytes) -> Result[ProcessOutput, IoError] ! { io, spawn } {")
    strs_push(l, "    let c = process_spawn(p, program, args)?;")
    strs_push(l, "    let errors = chan_new_of[Str](1);")
    strs_push(l, "    let text = bytes_to_str(input);")
    strs_push(l, "    let out = os_child_pipe(c.handle, 1);")
    strs_push(l, "    let err = os_child_pipe(c.handle, 2);")
    strs_push(l, "    let inp = os_child_pipe(c.handle, 0);")
    strs_push(l, "    let mut stdout = \"\";")
    strs_push(l, "    let got = vec_new[Str]();")
    strs_push(l, "    scope {")
    strs_push(l, "        spawn feed(inp, text);")
    strs_push(l, "        spawn collect(err, errors);")
    strs_push(l, "        stdout = match file_read_rest(File(handle: out)) {")
    strs_push(l, "            Result.Ok(value: b) => bytes_to_str(b),")
    strs_push(l, "            Result.Err(error: e) => \"\",")
    strs_push(l, "        };")
    strs_push(l, "        chan_recv_of(errors, got);")
    strs_push(l, "    }")
    strs_push(l, "    os_close(out);")
    strs_push(l, "    os_close(err);")
    strs_push(l, "    let status = process_wait(c)?;")
    strs_push(l, "    os_close(c.handle);")
    strs_push(l, "    let stderr = if vec_len(got) > 0 { vec_get(got, 0) } else { \"\" };")
    strs_push(l, "    Result[ProcessOutput, IoError].Ok(value: ProcessOutput(status: status, stdout: stdout, stderr: stderr))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// R1d (`docs/user/spec.md`, *The platform, further*): a child in a directory with an environment of its")
    strs_push(l, "// own, a new process group and a null standard input, ids, bounded waits, a signal to a group, and a")
    strs_push(l, "// child's peak memory.")
    strs_push(l, "")
    strs_push(l, "/// This process's id.")
    strs_push(l, "pub fn process_id(io: IoCap) -> Int ! { io } {")
    strs_push(l, "    os_pid()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn started(h: OsHandle, program: Str) -> Result[Child, IoError] ! {} {")
    strs_push(l, "    let s = os_status(h);")
    strs_push(l, "    if s < 0 { Result[Child, IoError].Err(error: io_context(io_error_from(s), program)) } else { Result[Child, IoError].Ok(value: Child(handle: h)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Start `program` with `args` in the directory `dir` (`\"\"`: this process's), its environment")
    strs_push(l, "/// exactly `env` — `NAME=value` entries, no name twice — handed over ordered by name. The program")
    strs_push(l, "/// is found on this process's `PATH`, not `env`'s; one named with a `/` is taken relative to `dir`.")
    strs_push(l, "pub fn process_spawn_in(p: ProcessCap, program: Str, args: Strs, dir: Str, env: Strs) -> Result[Child, IoError] ! { io } {")
    strs_push(l, "    started(os_spawn_in(program, args, dir, env), program)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `process_spawn_in`, the child leading a new process group (whose id is its process id) when")
    strs_push(l, "/// `new_group` is set, and reading an empty standard input when `null_stdin` is — its input pipe")
    strs_push(l, "/// then answers `Closed`.")
    strs_push(l, "pub fn process_spawn_with(p: ProcessCap, program: Str, args: Strs, dir: Str, env: Strs, new_group: Bool, null_stdin: Bool) -> Result[Child, IoError] ! { io } {")
    strs_push(l, "    let group = if new_group { 1 } else { 0 };")
    strs_push(l, "    let input = if null_stdin { 2 } else { 0 };")
    strs_push(l, "    started(os_spawn_with(program, args, dir, env, group + input), program)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `c`'s process id, the same before and after it is waited for.")
    strs_push(l, "pub fn process_child_id(c: Child) -> Int ! { io } {")
    strs_push(l, "    os_child_pid(c.handle)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn ended(s: Int, running: IoErrorKind) -> Result[Option[Int], IoError] ! {} {")
    strs_push(l, "    if s >= 0 {")
    strs_push(l, "        return Result[Option[Int], IoError].Ok(value: Option[Int].Some(value: s));")
    strs_push(l, "    }")
    strs_push(l, "    if io_kind_of(s) == running {")
    strs_push(l, "        return Result[Option[Int], IoError].Ok(value: Option[Int].None());")
    strs_push(l, "    }")
    strs_push(l, "    Result[Option[Int], IoError].Err(error: io_error_from(s))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `c`'s status if it has ended, `None` at once if it has not.")
    strs_push(l, "pub fn process_try_wait(c: Child) -> Result[Option[Int], IoError] ! { io } {")
    strs_push(l, "    ended(os_try_wait(c.handle), IoErrorKind.WouldBlock())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `c`'s status if it ends before `time_now_ms()` reads `deadline` — a reading of `@std/time`'s")
    strs_push(l, "/// `time_deadline` — and `None` then, the child left running.")
    strs_push(l, "pub fn process_wait_until(c: Child, deadline: Int) -> Result[Option[Int], IoError] ! { io } {")
    strs_push(l, "    ended(os_wait_until(c.handle, deadline), IoErrorKind.TimedOut())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Signal `signal` (the platform's number; 9 ends, 15 asks to end, 0 only asks whether any is")
    strs_push(l, "/// there) to every process of group `group`.")
    strs_push(l, "pub fn process_kill_group(p: ProcessCap, group: Int, signal: Int) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_kill_group(group, signal))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The peak resident memory, in bytes, of `c` once it has been waited for. The interpreter cannot")
    strs_push(l, "/// ask the system without C, and answers an error of kind `Other` there.")
    strs_push(l, "pub fn process_peak_memory(c: Child) -> Result[Int, IoError] ! { io } {")
    strs_push(l, "    io_result(os_child_rusage(c.handle))")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_random() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/random`: a seeded generator, and the system's entropy (Gate 2).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/random\";`. Two things that must never be confused. An `Rng` is a")
    strs_push(l, "// **seeded** generator — xoshiro256**, its state filled from the seed by SplitMix64 — pure and")
    strs_push(l, "// reproducible: one seed, one sequence, in every implementation and run, needing no authority.")
    strs_push(l, "// **Entropy** is the operating system's, behind a `RandomCap`: `random_bytes` and `random_seed`,")
    strs_push(l, "// for keys and for seeding a generator that should not be predicted. Reproducibility is the default")
    strs_push(l, "// and unpredictability is asked for by name. `docs/internal/general-purpose.md` §21.")
    strs_push(l, "")
    strs_push(l, "/// A seeded generator: its four words of state, shared like any handle.")
    strs_push(l, "pub struct Rng {")
    strs_push(l, "    state: Vec[UInt64],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn splitmix(x: UInt64) -> UInt64 ! {} {")
    strs_push(l, "    let a = wrapping_mul(x ^ (x >> 30), UInt64(0xBF58476D1CE4E5B9));")
    strs_push(l, "    let b = wrapping_mul(a ^ (a >> 27), UInt64(0x94D049BB133111EB));")
    strs_push(l, "    b ^ (b >> 31)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A generator seeded with `seed`: the same seed gives the same sequence everywhere.")
    strs_push(l, "pub fn random_new(seed: UInt64) -> Rng ! {} {")
    strs_push(l, "    let state = vec_new[UInt64]();")
    strs_push(l, "    let mut s = seed;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 4 {")
    strs_push(l, "        s = wrapping_add(s, UInt64(0x9E3779B97F4A7C15));")
    strs_push(l, "        vec_push(state, splitmix(s));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Rng(state: state)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The next 64 bits.")
    strs_push(l, "pub fn random_u64(r: Rng) -> UInt64 ! {} {")
    strs_push(l, "    let s0 = vec_get(r.state, 0);")
    strs_push(l, "    let s1 = vec_get(r.state, 1);")
    strs_push(l, "    let s2 = vec_get(r.state, 2);")
    strs_push(l, "    let s3 = vec_get(r.state, 3);")
    strs_push(l, "    let result = wrapping_mul(rotate_left(wrapping_mul(s1, UInt64(5)), 7), UInt64(9));")
    strs_push(l, "    let t = s1 << 17;")
    strs_push(l, "    let n2 = s2 ^ s0;")
    strs_push(l, "    let n3 = s3 ^ s1;")
    strs_push(l, "    let n1 = s1 ^ n2;")
    strs_push(l, "    let n0 = s0 ^ n3;")
    strs_push(l, "    vec_set(r.state, 0, n0);")
    strs_push(l, "    vec_set(r.state, 1, n1);")
    strs_push(l, "    vec_set(r.state, 2, n2 ^ t);")
    strs_push(l, "    vec_set(r.state, 3, rotate_left(n3, 45));")
    strs_push(l, "    result")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A whole number in `lo..hi`, every one equally likely (rejection, no modulo bias); `lo` when")
    strs_push(l, "/// the range is empty.")
    strs_push(l, "pub fn random_int(r: Rng, lo: Int, hi: Int) -> Int ! {} {")
    strs_push(l, "    if hi <= lo {")
    strs_push(l, "        return lo;")
    strs_push(l, "    }")
    strs_push(l, "    let span = wrap_convert[UInt64](hi - lo);")
    strs_push(l, "    let zone = UInt64(18446744073709551615) - (UInt64(18446744073709551615) % span + UInt64(1)) % span;")
    strs_push(l, "    let mut x = random_u64(r);")
    strs_push(l, "    while x > zone {")
    strs_push(l, "        x = random_u64(r);")
    strs_push(l, "    }")
    strs_push(l, "    lo + wrap_convert[Int](x % span)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A float in `[0, 1)`: the top 53 bits, scaled.")
    strs_push(l, "pub fn random_float(r: Rng) -> Float64 ! {} {")
    strs_push(l, "    Float64(random_u64(r) >> 11) / 9007199254740992.0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `xs` shuffled in place, every order equally likely (Fisher–Yates).")
    strs_push(l, "pub fn random_shuffle[T](r: Rng, xs: Vec[T]) -> Int ! {} {")
    strs_push(l, "    let mut i = vec_len(xs) - 1;")
    strs_push(l, "    while i > 0 {")
    strs_push(l, "        let j = random_int(r, 0, i + 1);")
    strs_push(l, "        let a = vec_get(xs, i);")
    strs_push(l, "        vec_set(xs, i, vec_get(xs, j));")
    strs_push(l, "        vec_set(xs, j, a);")
    strs_push(l, "        i = i - 1;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `buf` filled from the operating system's entropy: its length, or the error.")
    strs_push(l, "pub fn random_bytes(rc: RandomCap, buf: Bytes) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let n = os_random_bytes(buf);")
    strs_push(l, "    if n < 0 { Result[Int, Str].Err(error: os_error_text(n)) } else { Result[Int, Str].Ok(value: n) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// 64 bits of the operating system's entropy, for a seed nobody can predict.")
    strs_push(l, "pub fn random_seed(rc: RandomCap) -> UInt64 ! {} {")
    strs_push(l, "    let b = bytes_new(8);")
    strs_push(l, "    let n = os_random_bytes(b);")
    strs_push(l, "    bytes_read_le[UInt64](b, 0)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_regex() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/regex`: regular expressions, matched in time linear in the text (R1e, S5).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/regex\";`. A pattern is compiled once, by `regex_compile`, into a")
    strs_push(l, "// Thompson NFA, and every search runs it as a Pike VM: all the automaton's states advance together")
    strs_push(l, "// one scalar value at a time, each state held by at most one thread, so a search reads each byte of")
    strs_push(l, "// the text once and does at most work proportional to the pattern's size there — O(m·n) for a")
    strs_push(l, "// pattern of m instructions and a text of n bytes, never exponential. Nothing backtracks, so a")
    strs_push(l, "// backreference, a lookbehind or a lookahead longer than one scalar value — which cannot be matched")
    strs_push(l, "// so — is refused when the pattern is compiled.")
    strs_push(l, "//")
    strs_push(l, "// Matching is leftmost-first, as in Perl and in Rust's `regex` crate: the match starting earliest")
    strs_push(l, "// in the text, and among those the one the pattern prefers — an alternation's earlier branch, a")
    strs_push(l, "// greedy repetition's longer run, a lazy one's shorter. Offsets are bytes; the text is read as")
    strs_push(l, "// UTF-8, `.` and a class matching one whole scalar value (a byte that does not begin a valid")
    strs_push(l, "// sequence is read as U+FFFD, one byte at a time).")
    strs_push(l, "//")
    strs_push(l, "// The syntax is Rust's `regex`, less what an automaton cannot do and what a pre-tokeniser does not")
    strs_push(l, "// need:")
    strs_push(l, "//")
    strs_push(l, "//   literals; `\\` before any ASCII character that is not a letter or a digit; `\\n \\t \\r \\f \\v`,")
    strs_push(l, "//     `\\xHH`, `\\x{H...}`, `\\uHHHH`, `\\u{H...}`, `\\UHHHHHHHH`")
    strs_push(l, "//   `.` (any scalar value but `\\n`; any at all under `s`)")
    strs_push(l, "//   `[...]`, `[^...]`, ranges `a-z`, and the escapes below inside them; `-` first or last, and `]`")
    strs_push(l, "//     first, are literal")
    strs_push(l, "//   `\\d \\D` (`\\p{Nd}`), `\\s \\S` (Unicode `White_Space`), `\\w \\W` (`\\p{L}`, `\\p{M}`, `\\p{Nd}`,")
    strs_push(l, "//     `\\p{Nl}`, `\\p{Pc}`, U+200C, U+200D and the circled letters: Unicode's `\\w` but for the")
    strs_push(l, "//     few other `Other_Alphabetic` scalar values)")
    strs_push(l, "//   `\\p{..}`, `\\P{..}`, `\\pX`: the general categories `L` (`Letter`), `Lu`, `Ll`, `Lt`, `Lm`, `Lo`,")
    strs_push(l, "//     `M` (`Mark`), `Mn`, `Mc`, `Me`, `N` (`Number`), `Nd`, `Nl`, `No`, `Pc` — Unicode 16.0")
    strs_push(l, "//   `^ $` (the text's ends; a line's under `m`), `\\A \\z`, `\\b \\B` (a `\\w` boundary)")
    strs_push(l, "//   `|`, `(...)`, `(?:...)`, `(?<name>...)` and `(?P<name>...)` (numbered like any group; the name")
    strs_push(l, "//     is not kept), `(?flags)` and `(?flags:...)` with `i` (ASCII letters only), `m`, `s` and `-`")
    strs_push(l, "//   `* + ? {n} {n,} {n,m}`, each greedy, or lazy with a `?` after it")
    strs_push(l, "//   `(?=C)` and `(?!C)` where `C` is one literal, `.`, escape or class: whether the next scalar")
    strs_push(l, "//     value is (is not) in it — `(?!C)` at the end of the text holds. Enough for `\\s+(?!\\S)`")
    strs_push(l, "//")
    strs_push(l, "// Not supported, each refused by name: backreferences, lookbehind, longer lookaheads, nested")
    strs_push(l, "// classes and class set operations (`&&`), POSIX classes, other Unicode properties and scripts,")
    strs_push(l, "// the `x` and `U` flags. A pattern is at most 100,000 instructions once its counted repetitions")
    strs_push(l, "// are written out.")
    strs_push(l, "")
    strs_push(l, "/// Where a match, or a capture group, was found: byte offsets into the text, `start` inclusive and")
    strs_push(l, "/// `end` exclusive.")
    strs_push(l, "pub struct Match {")
    strs_push(l, "    start: Int,")
    strs_push(l, "    end: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A compiled pattern: its text, its program, the character classes the program reads, and how")
    strs_push(l, "/// many capture groups it has.")
    strs_push(l, "pub struct Regex {")
    strs_push(l, "    pattern: Str,")
    strs_push(l, "    prog: Ints,")
    strs_push(l, "    sets: Ints,")
    strs_push(l, "    groups: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- sets of scalar values ----------------------------------------------------------------------")
    strs_push(l, "//")
    strs_push(l, "// A set is an `Ints` of ranges, `lo, hi` pairs, ascending, neither overlapping nor adjacent.")
    strs_push(l, "")
    strs_push(l, "fn max_scalar() -> Int ! {} { 1114111 }")
    strs_push(l, "")
    strs_push(l, "fn set_range(lo: Int, hi: Int) -> Ints ! {} {")
    strs_push(l, "    let s = ints_new();")
    strs_push(l, "    ints_push(s, lo);")
    strs_push(l, "    ints_push(s, hi);")
    strs_push(l, "    s")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `lo..=hi` added at the end of `out`, merged with the last range where they touch.")
    strs_push(l, "fn put(out: Ints, lo: Int, hi: Int) -> Int ! {} {")
    strs_push(l, "    let n = ints_len(out);")
    strs_push(l, "    if n > 0 && lo <= ints_get(out, n - 1) + 1 {")
    strs_push(l, "        if hi > ints_get(out, n - 1) { ints_set(out, n - 1, hi); }")
    strs_push(l, "    } else {")
    strs_push(l, "        ints_push(out, lo);")
    strs_push(l, "        ints_push(out, hi);")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn set_union(a: Ints, b: Ints) -> Ints ! {} {")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut j = 0;")
    strs_push(l, "    while i < ints_len(a) || j < ints_len(b) {")
    strs_push(l, "        if j >= ints_len(b) || (i < ints_len(a) && ints_get(a, i) <= ints_get(b, j)) {")
    strs_push(l, "            put(out, ints_get(a, i), ints_get(a, i + 1));")
    strs_push(l, "            i = i + 2;")
    strs_push(l, "        } else {")
    strs_push(l, "            put(out, ints_get(b, j), ints_get(b, j + 1));")
    strs_push(l, "            j = j + 2;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every scalar value not in `a`.")
    strs_push(l, "fn set_negate(a: Ints) -> Ints ! {} {")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    let mut next = 0;")
    strs_push(l, "    for k in 0..ints_len(a) / 2 {")
    strs_push(l, "        let lo = ints_get(a, 2 * k);")
    strs_push(l, "        if lo > next { put(out, next, lo - 1); }")
    strs_push(l, "        next = ints_get(a, 2 * k + 1) + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if next <= max_scalar() { put(out, next, max_scalar()); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `a` with the other case of each ASCII letter in it.")
    strs_push(l, "fn set_fold(a: Ints) -> Ints ! {} {")
    strs_push(l, "    let extra = ints_new();")
    strs_push(l, "    for k in 0..ints_len(a) / 2 {")
    strs_push(l, "        let lo = ints_get(a, 2 * k);")
    strs_push(l, "        let hi = ints_get(a, 2 * k + 1);")
    strs_push(l, "        // Upper-case letters, then lower-case ones, each mapped to the other case.")
    strs_push(l, "        let ulo = if lo > 65 { lo } else { 65 };")
    strs_push(l, "        let uhi = if hi < 90 { hi } else { 90 };")
    strs_push(l, "        if ulo <= uhi { put(extra, ulo + 32, uhi + 32); }")
    strs_push(l, "        let llo = if lo > 97 { lo } else { 97 };")
    strs_push(l, "        let lhi = if hi < 122 { hi } else { 122 };")
    strs_push(l, "        if llo <= lhi { put(extra, llo - 32, lhi - 32); }")
    strs_push(l, "    }")
    strs_push(l, "    // `extra` is ascending except where both cases occur: union it a range at a time.")
    strs_push(l, "    let mut out = a;")
    strs_push(l, "    for k in 0..ints_len(extra) / 2 {")
    strs_push(l, "        out = set_union(out, set_range(ints_get(extra, 2 * k), ints_get(extra, 2 * k + 1)));")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `c` is in the set of `count` ranges stored from range `start` of `sets`.")
    strs_push(l, "fn in_set(sets: Ints, start: Int, count: Int, c: Int) -> Bool ! {} {")
    strs_push(l, "    let mut lo = 0;")
    strs_push(l, "    let mut hi = count;")
    strs_push(l, "    let mut found = false;")
    strs_push(l, "    while lo < hi && !found {")
    strs_push(l, "        let mid = (lo + hi) / 2;")
    strs_push(l, "        if c < ints_get(sets, 2 * (start + mid)) {")
    strs_push(l, "            hi = mid;")
    strs_push(l, "        } else {")
    strs_push(l, "            if c > ints_get(sets, 2 * (start + mid) + 1) { lo = mid + 1; } else { found = true; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- Unicode ------------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// A range table as the constants below spell one: each range is the gap from the end of the one")
    strs_push(l, "/// before it and its width less one, each number in base 32 — its leading digits `a`-`z`, `!`,")
    strs_push(l, "/// `#`, `$`, `%`, `&`, `*`, its last digit `0`-`9`, `A`-`V`.")
    strs_push(l, "fn table(t: Str) -> Ints ! {} {")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    let mut prev = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut first = true;")
    strs_push(l, "    let mut lo = 0;")
    strs_push(l, "    while i < str_len(t) {")
    strs_push(l, "        let mut v = 0;")
    strs_push(l, "        let mut more = true;")
    strs_push(l, "        while more {")
    strs_push(l, "            let b = str_byte(t, i);")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "            if b >= 97 && b <= 122 { v = v * 32 + b - 97; } else {")
    strs_push(l, "            if b == 33 { v = v * 32 + 26; } else {")
    strs_push(l, "            if b == 35 { v = v * 32 + 27; } else {")
    strs_push(l, "            if b == 36 { v = v * 32 + 28; } else {")
    strs_push(l, "            if b == 37 { v = v * 32 + 29; } else {")
    strs_push(l, "            if b == 38 { v = v * 32 + 30; } else {")
    strs_push(l, "            if b == 42 { v = v * 32 + 31; } else {")
    strs_push(l, "                let d = if b <= 57 { b - 48 } else { b - 55 };")
    strs_push(l, "                v = v * 32 + d;")
    strs_push(l, "                more = false;")
    strs_push(l, "            } } } } } } }")
    strs_push(l, "        }")
    strs_push(l, "        if first {")
    strs_push(l, "            lo = prev + v;")
    strs_push(l, "            first = false;")
    strs_push(l, "        } else {")
    strs_push(l, "            ints_push(out, lo);")
    strs_push(l, "            ints_push(out, lo + v);")
    strs_push(l, "            prev = lo + v + 1;")
    strs_push(l, "            first = true;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Unicode's `White_Space`.")
    strs_push(l, "fn white_space() -> Ints ! {} {")
    strs_push(l, "    let s = ints_new();")
    strs_push(l, "    put(s, 9, 13);")
    strs_push(l, "    put(s, 32, 32);")
    strs_push(l, "    put(s, 133, 133);")
    strs_push(l, "    put(s, 160, 160);")
    strs_push(l, "    put(s, 5760, 5760);")
    strs_push(l, "    put(s, 8192, 8202);")
    strs_push(l, "    put(s, 8232, 8233);")
    strs_push(l, "    put(s, 8239, 8239);")
    strs_push(l, "    put(s, 8287, 8287);")
    strs_push(l, "    put(s, 12288, 12288);")
    strs_push(l, "    s")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn letters() -> Ints ! {} {")
    strs_push(l, "    set_union(set_union(set_union(table(U_LU), table(U_LL)), set_union(table(U_LT), table(U_LM))), table(U_LO))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn marks() -> Ints ! {} { set_union(set_union(table(U_MN), table(U_MC)), table(U_ME)) }")
    strs_push(l, "")
    strs_push(l, "fn numbers() -> Ints ! {} { set_union(set_union(table(U_ND), table(U_NL)), table(U_NO)) }")
    strs_push(l, "")
    strs_push(l, "/// `\\w`: letters, marks, decimal digits, letter numbers, connector punctuation, the joiners and the")
    strs_push(l, "/// circled letters.")
    strs_push(l, "fn word() -> Ints ! {} {")
    strs_push(l, "    let mut s = set_union(set_union(letters(), marks()), set_union(table(U_ND), table(U_NL)));")
    strs_push(l, "    s = set_union(s, table(U_PC));")
    strs_push(l, "    s = set_union(s, set_range(8204, 8205));")
    strs_push(l, "    s = set_union(s, set_range(9398, 9449));")
    strs_push(l, "    s = set_union(s, set_range(127280, 127305));")
    strs_push(l, "    s = set_union(s, set_range(127312, 127337));")
    strs_push(l, "    set_union(s, set_range(127344, 127369))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The general category, or group of them, a `\\p{...}` names.")
    strs_push(l, "fn category(name: Str) -> Option[Ints] ! {} {")
    strs_push(l, "    if name == \"L\" || name == \"Letter\" { return Option[Ints].Some(value: letters()); }")
    strs_push(l, "    if name == \"Lu\" { return Option[Ints].Some(value: table(U_LU)); }")
    strs_push(l, "    if name == \"Ll\" { return Option[Ints].Some(value: table(U_LL)); }")
    strs_push(l, "    if name == \"Lt\" { return Option[Ints].Some(value: table(U_LT)); }")
    strs_push(l, "    if name == \"Lm\" { return Option[Ints].Some(value: table(U_LM)); }")
    strs_push(l, "    if name == \"Lo\" { return Option[Ints].Some(value: table(U_LO)); }")
    strs_push(l, "    if name == \"M\" || name == \"Mark\" { return Option[Ints].Some(value: marks()); }")
    strs_push(l, "    if name == \"Mn\" { return Option[Ints].Some(value: table(U_MN)); }")
    strs_push(l, "    if name == \"Mc\" { return Option[Ints].Some(value: table(U_MC)); }")
    strs_push(l, "    if name == \"Me\" { return Option[Ints].Some(value: table(U_ME)); }")
    strs_push(l, "    if name == \"N\" || name == \"Number\" { return Option[Ints].Some(value: numbers()); }")
    strs_push(l, "    if name == \"Nd\" { return Option[Ints].Some(value: table(U_ND)); }")
    strs_push(l, "    if name == \"Nl\" { return Option[Ints].Some(value: table(U_NL)); }")
    strs_push(l, "    if name == \"No\" { return Option[Ints].Some(value: table(U_NO)); }")
    strs_push(l, "    if name == \"Pc\" { return Option[Ints].Some(value: table(U_PC)); }")
    strs_push(l, "    Option[Ints].None()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- UTF-8 --------------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// The length of the scalar value at byte `i`: 1 for a byte that does not begin a valid sequence.")
    strs_push(l, "fn width(text: Str, i: Int) -> Int ! {} {")
    strs_push(l, "    let b = str_byte(text, i);")
    strs_push(l, "    let need = if b < 192 { 1 } else { if b < 224 { 2 } else { if b < 240 { 3 } else { if b < 248 { 4 } else { 1 } } } };")
    strs_push(l, "    let mut ok = i + need <= str_len(text);")
    strs_push(l, "    let mut k = 1;")
    strs_push(l, "    while ok && k < need {")
    strs_push(l, "        let c = str_byte(text, i + k);")
    strs_push(l, "        if c < 128 || c > 191 { ok = false; }")
    strs_push(l, "        k = k + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if ok { need } else { 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The scalar value at byte `i`; U+FFFD for a byte that does not begin a valid sequence.")
    strs_push(l, "fn scalar(text: Str, i: Int) -> Int ! {} {")
    strs_push(l, "    let b = str_byte(text, i);")
    strs_push(l, "    let w = width(text, i);")
    strs_push(l, "    if w == 1 {")
    strs_push(l, "        if b < 128 { b } else { 65533 }")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut c = if w == 2 { b - 192 } else { if w == 3 { b - 224 } else { b - 240 } };")
    strs_push(l, "        for k in 1..w {")
    strs_push(l, "            c = c * 64 + str_byte(text, i + k) - 128;")
    strs_push(l, "        }")
    strs_push(l, "        c")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The scalar value ending just before byte `i`, which is more than 0.")
    strs_push(l, "fn scalar_before(text: Str, i: Int) -> Int ! {} {")
    strs_push(l, "    let mut j = i - 1;")
    strs_push(l, "    while j > 0 && i - j < 4 && str_byte(text, j) >= 128 && str_byte(text, j) < 192 {")
    strs_push(l, "        j = j - 1;")
    strs_push(l, "    }")
    strs_push(l, "    if j + width(text, j) == i { scalar(text, j) } else { scalar(text, i - 1) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- the parser ---------------------------------------------------------------------------------")
    strs_push(l, "//")
    strs_push(l, "// The pattern is parsed into a tree held in an arena of parallel `Ints`, one entry per node, and")
    strs_push(l, "// the tree is compiled into the program.")
    strs_push(l, "")
    strs_push(l, "// Node kinds.")
    strs_push(l, "// A set: `a` its first range in `sets`, `b` how many.")
    strs_push(l, "fn n_set() -> Int ! {} { 0 }")
    strs_push(l, "fn n_empty() -> Int ! {} { 1 }")
    strs_push(l, "// An assertion: `a` its kind, `b` and `c` a set as for `n_set`.")
    strs_push(l, "fn n_assert() -> Int ! {} { 2 }")
    strs_push(l, "// A concatenation or an alternation: `a` its first child in `kids`, `b` how many.")
    strs_push(l, "fn n_cat() -> Int ! {} { 3 }")
    strs_push(l, "fn n_alt() -> Int ! {} { 4 }")
    strs_push(l, "// A repetition: `a` its child, `b` the least, `c` the most (-1 for no bound), `d` 1 if greedy.")
    strs_push(l, "fn n_rep() -> Int ! {} { 5 }")
    strs_push(l, "// A capture group: `a` its child, `b` its number.")
    strs_push(l, "fn n_group() -> Int ! {} { 6 }")
    strs_push(l, "")
    strs_push(l, "// Assertion kinds.")
    strs_push(l, "fn a_text_start() -> Int ! {} { 0 }")
    strs_push(l, "fn a_text_end() -> Int ! {} { 1 }")
    strs_push(l, "fn a_line_start() -> Int ! {} { 2 }")
    strs_push(l, "fn a_line_end() -> Int ! {} { 3 }")
    strs_push(l, "fn a_word() -> Int ! {} { 4 }")
    strs_push(l, "fn a_not_word() -> Int ! {} { 5 }")
    strs_push(l, "fn a_ahead() -> Int ! {} { 6 }")
    strs_push(l, "fn a_not_ahead() -> Int ! {} { 7 }")
    strs_push(l, "")
    strs_push(l, "// Flags, as bits.")
    strs_push(l, "fn f_fold() -> Int ! {} { 1 }")
    strs_push(l, "fn f_lines() -> Int ! {} { 2 }")
    strs_push(l, "fn f_dot_all() -> Int ! {} { 4 }")
    strs_push(l, "")
    strs_push(l, "/// The most instructions a program may have.")
    strs_push(l, "fn max_size() -> Int ! {} { 100000 }")
    strs_push(l, "")
    strs_push(l, "/// The parser: the pattern, the position (one cell), the first error, the tree's arena, the sets")
    strs_push(l, "/// and the number of groups so far (one cell).")
    strs_push(l, "struct Px {")
    strs_push(l, "    pat: Str,")
    strs_push(l, "    pos: Ints,")
    strs_push(l, "    err: Strs,")
    strs_push(l, "    kind: Ints,")
    strs_push(l, "    a: Ints,")
    strs_push(l, "    b: Ints,")
    strs_push(l, "    c: Ints,")
    strs_push(l, "    d: Ints,")
    strs_push(l, "    size: Ints,")
    strs_push(l, "    kids: Ints,")
    strs_push(l, "    sets: Ints,")
    strs_push(l, "    groups: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn at(p: Px) -> Int ! {} { ints_get(p.pos, 0) }")
    strs_push(l, "")
    strs_push(l, "fn advance(p: Px, n: Int) -> Int ! {} {")
    strs_push(l, "    ints_set(p.pos, 0, at(p) + n);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn byte_at(p: Px, i: Int) -> Int ! {} {")
    strs_push(l, "    if i < str_len(p.pat) { str_byte(p.pat, i) } else { 0 - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn peek(p: Px) -> Int ! {} { byte_at(p, at(p)) }")
    strs_push(l, "")
    strs_push(l, "fn failed(p: Px) -> Bool ! {} { strs_len(p.err) > 0 }")
    strs_push(l, "")
    strs_push(l, "/// The first failure is kept: what was wrong, and the byte offset where.")
    strs_push(l, "fn fail_at(p: Px, offset: Int, what: Str) -> Int ! {} {")
    strs_push(l, "    if !failed(p) { strs_push(p.err, f\"{what} at byte {offset}\"); }")
    strs_push(l, "    0 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn fail(p: Px, what: Str) -> Int ! {} { fail_at(p, at(p), what) }")
    strs_push(l, "")
    strs_push(l, "fn add(p: Px, kind: Int, a: Int, b: Int, c: Int, d: Int, size: Int) -> Int ! {} {")
    strs_push(l, "    ints_push(p.kind, kind);")
    strs_push(l, "    ints_push(p.a, a);")
    strs_push(l, "    ints_push(p.b, b);")
    strs_push(l, "    ints_push(p.c, c);")
    strs_push(l, "    ints_push(p.d, d);")
    strs_push(l, "    ints_push(p.size, size);")
    strs_push(l, "    ints_len(p.kind) - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A node matching one scalar value of `set`.")
    strs_push(l, "fn add_set(p: Px, set: Ints) -> Int ! {} {")
    strs_push(l, "    let start = ints_len(p.sets) / 2;")
    strs_push(l, "    for i in 0..ints_len(set) { ints_push(p.sets, ints_get(set, i)); }")
    strs_push(l, "    add(p, n_set(), start, ints_len(set) / 2, 0, 0, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn add_assert(p: Px, kind: Int, set: Ints) -> Int ! {} {")
    strs_push(l, "    let start = ints_len(p.sets) / 2;")
    strs_push(l, "    for i in 0..ints_len(set) { ints_push(p.sets, ints_get(set, i)); }")
    strs_push(l, "    add(p, n_assert(), kind, start, ints_len(set) / 2, 0, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `set`, with both cases of each ASCII letter when the flags say so.")
    strs_push(l, "fn folded(set: Ints, flags: Int) -> Ints ! {} {")
    strs_push(l, "    if flags & f_fold() != 0 { set_fold(set) } else { set }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The scalar value at the position, which is past it.")
    strs_push(l, "fn literal_scalar(p: Px) -> Int ! {} {")
    strs_push(l, "    let c = scalar(p.pat, at(p));")
    strs_push(l, "    advance(p, width(p.pat, at(p)));")
    strs_push(l, "    c")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn hex_digit(b: Int) -> Int ! {} {")
    strs_push(l, "    if b >= 48 && b <= 57 { b - 48 } else { if b >= 97 && b <= 102 { b - 87 } else {")
    strs_push(l, "        if b >= 65 && b <= 70 { b - 55 } else { 0 - 1 } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `digits` hex digits, or with `digits` 0 `{H...}`, from the position; the scalar value they")
    strs_push(l, "/// name.")
    strs_push(l, "fn hex_escape(p: Px, start: Int, digits: Int) -> Int ! {} {")
    strs_push(l, "    let mut v = 0;")
    strs_push(l, "    if digits == 0 {")
    strs_push(l, "        if peek(p) != 123 { return fail_at(p, start, \"an escape needs `{` and hex digits\"); }")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        let mut n = 0;")
    strs_push(l, "        while hex_digit(peek(p)) >= 0 && n < 8 {")
    strs_push(l, "            v = v * 16 + hex_digit(peek(p));")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "            n = n + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 || peek(p) != 125 { return fail_at(p, start, \"an escape needs hex digits and `}`\"); }")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "    } else {")
    strs_push(l, "        for k in 0..digits {")
    strs_push(l, "            let d = hex_digit(peek(p));")
    strs_push(l, "            if d < 0 { return fail_at(p, start, f\"an escape needs {digits} hex digits\"); }")
    strs_push(l, "            v = v * 16 + d;")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if v > max_scalar() || (v >= 55296 && v <= 57343) {")
    strs_push(l, "        return fail_at(p, start, \"an escape that is not a Unicode scalar value\");")
    strs_push(l, "    }")
    strs_push(l, "    v")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the letter after a `\\` names a class.")
    strs_push(l, "fn class_escape(e: Int) -> Bool ! {} {")
    strs_push(l, "    e == 100 || e == 68 || e == 119 || e == 87 || e == 115 || e == 83 || e == 112 || e == 80")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The class a `\\d`, `\\w`, `\\s`, `\\p{..}` or a negation of one names; the position is at its")
    strs_push(l, "/// letter, `start` at its `\\`, and is left past it. Folded before it is negated.")
    strs_push(l, "fn escape_class(p: Px, start: Int, flags: Int) -> Ints ! {} {")
    strs_push(l, "    let e = peek(p);")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    let negated = e == 68 || e == 87 || e == 83 || e == 80;")
    strs_push(l, "    let mut set = ints_new();")
    strs_push(l, "    if e == 100 || e == 68 { set = table(U_ND); }")
    strs_push(l, "    if e == 119 || e == 87 { set = word(); }")
    strs_push(l, "    if e == 115 || e == 83 { set = white_space(); }")
    strs_push(l, "    if e == 112 || e == 80 {")
    strs_push(l, "        let mut name = \"\";")
    strs_push(l, "        if peek(p) == 123 {")
    strs_push(l, "            let from = at(p) + 1;")
    strs_push(l, "            while peek(p) >= 0 && peek(p) != 125 { advance(p, 1); }")
    strs_push(l, "            if peek(p) < 0 { fail_at(p, start, \"an unclosed `\\\\p{`\"); return set; }")
    strs_push(l, "            name = str_slice(p.pat, from, at(p));")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "        } else {")
    strs_push(l, "            if peek(p) < 0 { fail_at(p, start, \"a `\\\\p` needs a class name\"); return set; }")
    strs_push(l, "            name = str_slice(p.pat, at(p), at(p) + width(p.pat, at(p)));")
    strs_push(l, "            advance(p, width(p.pat, at(p)));")
    strs_push(l, "        }")
    strs_push(l, "        match category(name) {")
    strs_push(l, "            Option.Some(value: s) => { set = s; },")
    strs_push(l, "            Option.None() => { fail_at(p, start, f\"an unknown Unicode class `{name}`\"); },")
    strs_push(l, "        };")
    strs_push(l, "    }")
    strs_push(l, "    set = folded(set, flags);")
    strs_push(l, "    if negated { set_negate(set) } else { set }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The scalar value an escape that is not a class stands for; the position is at the character")
    strs_push(l, "/// after the `\\`, `start` at the `\\`, and is left past it.")
    strs_push(l, "fn escape_scalar(p: Px, start: Int) -> Int ! {} {")
    strs_push(l, "    let e = peek(p);")
    strs_push(l, "    if e < 0 { return fail_at(p, start, \"a `\\\\` at the end of the pattern\"); }")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    if e == 110 { return 10; }")
    strs_push(l, "    if e == 116 { return 9; }")
    strs_push(l, "    if e == 114 { return 13; }")
    strs_push(l, "    if e == 102 { return 12; }")
    strs_push(l, "    if e == 118 { return 11; }")
    strs_push(l, "    if e == 120 {")
    strs_push(l, "        return if peek(p) == 123 { hex_escape(p, start, 0) } else { hex_escape(p, start, 2) };")
    strs_push(l, "    }")
    strs_push(l, "    if e == 117 {")
    strs_push(l, "        return if peek(p) == 123 { hex_escape(p, start, 0) } else { hex_escape(p, start, 4) };")
    strs_push(l, "    }")
    strs_push(l, "    if e == 85 { return hex_escape(p, start, 8); }")
    strs_push(l, "    if e >= 48 && e <= 57 { return fail_at(p, start, \"backreferences are not supported\"); }")
    strs_push(l, "    let letter = (e >= 65 && e <= 90) || (e >= 97 && e <= 122);")
    strs_push(l, "    if e < 128 && !letter { return e; }")
    strs_push(l, "    let shown = str_slice(p.pat, at(p) - 1, at(p) - 1 + width(p.pat, at(p) - 1));")
    strs_push(l, "    fail_at(p, start, f\"an unknown escape `\\\\{shown}`\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One endpoint of a range in a class: a literal or an escape that is one scalar value.")
    strs_push(l, "fn class_scalar(p: Px) -> Int ! {} {")
    strs_push(l, "    if peek(p) == 92 {")
    strs_push(l, "        let start = at(p);")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        if class_escape(peek(p)) { return fail_at(p, start, \"a class cannot end a range\"); }")
    strs_push(l, "        if peek(p) == 98 { return fail_at(p, start, \"`\\\\b` inside a class\"); }")
    strs_push(l, "        escape_scalar(p, start)")
    strs_push(l, "    } else {")
    strs_push(l, "        literal_scalar(p)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `[...]`; the position is at its `[`.")
    strs_push(l, "fn class(p: Px, flags: Int) -> Ints ! {} {")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    let negated = peek(p) == 94;")
    strs_push(l, "    if negated { advance(p, 1); }")
    strs_push(l, "    let mut set = ints_new();")
    strs_push(l, "    let mut first = true;")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done && !failed(p) {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b < 0 {")
    strs_push(l, "            fail_at(p, start, \"an unclosed class\");")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == 93 && !first {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                done = true;")
    strs_push(l, "            } else {")
    strs_push(l, "                if b == 91 {")
    strs_push(l, "                    if byte_at(p, at(p) + 1) == 58 { fail(p, \"POSIX classes are not supported\"); } else {")
    strs_push(l, "                        fail(p, \"a `[` inside a class must be escaped\");")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "                if b == 38 && byte_at(p, at(p) + 1) == 38 { fail(p, \"class set operations are not supported\"); }")
    strs_push(l, "                if b == 92 && class_escape(byte_at(p, at(p) + 1)) {")
    strs_push(l, "                    let from = at(p);")
    strs_push(l, "                    advance(p, 1);")
    strs_push(l, "                    set = set_union(set, escape_class(p, from, flags));")
    strs_push(l, "                    if peek(p) == 45 && byte_at(p, at(p) + 1) != 93 && byte_at(p, at(p) + 1) >= 0 {")
    strs_push(l, "                        fail(p, \"a class cannot begin a range\");")
    strs_push(l, "                    }")
    strs_push(l, "                } else {")
    strs_push(l, "                    let from = at(p);")
    strs_push(l, "                    let lo = class_scalar(p);")
    strs_push(l, "                    let mut hi = lo;")
    strs_push(l, "                    if peek(p) == 45 && byte_at(p, at(p) + 1) != 93 && byte_at(p, at(p) + 1) >= 0 {")
    strs_push(l, "                        advance(p, 1);")
    strs_push(l, "                        hi = class_scalar(p);")
    strs_push(l, "                        if !failed(p) && hi < lo { fail_at(p, from, \"a range whose end is before its start\"); }")
    strs_push(l, "                    }")
    strs_push(l, "                    if !failed(p) { set = set_union(set, folded(set_range(lo, hi), flags)); }")
    strs_push(l, "                }")
    strs_push(l, "                first = false;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if negated { set_negate(set) } else { set }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `.`: every scalar value, or every one but `\\n`.")
    strs_push(l, "fn dot(flags: Int) -> Ints ! {} {")
    strs_push(l, "    if flags & f_dot_all() != 0 { set_range(0, max_scalar()) } else { set_negate(set_range(10, 10)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A lookahead's one character or class, after `(?=` or `(?!`.")
    strs_push(l, "fn lookahead_set(p: Px, start: Int, flags: Int) -> Ints ! {} {")
    strs_push(l, "    let b = peek(p);")
    strs_push(l, "    let mut set = ints_new();")
    strs_push(l, "    if b == 91 { set = class(p, flags); } else {")
    strs_push(l, "        if b == 46 { advance(p, 1); set = dot(flags); } else {")
    strs_push(l, "            if b == 92 {")
    strs_push(l, "                let from = at(p);")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                if class_escape(peek(p)) { set = escape_class(p, from, flags); } else {")
    strs_push(l, "                    let c = escape_scalar(p, from);")
    strs_push(l, "                    set = folded(set_range(c, c), flags);")
    strs_push(l, "                }")
    strs_push(l, "            } else {")
    strs_push(l, "                if b < 0 || b == 40 || b == 41 || b == 124 || b == 42 || b == 43 || b == 63 || b == 123")
    strs_push(l, "                    || b == 94 || b == 36 {")
    strs_push(l, "                    fail_at(p, start, \"a lookahead holds one character or class\");")
    strs_push(l, "                } else {")
    strs_push(l, "                    let c = literal_scalar(p);")
    strs_push(l, "                    set = folded(set_range(c, c), flags);")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if !failed(p) && peek(p) != 41 { fail_at(p, start, \"a lookahead holds one character or class\"); }")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    set")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A group, after its `(`, which is at `start`; -2 for flags alone, `(?i)`, which set `cell`.")
    strs_push(l, "fn group(p: Px, start: Int, cell: Ints) -> Int ! {} {")
    strs_push(l, "    let flags = ints_get(cell, 0);")
    strs_push(l, "    let mut capture = true;")
    strs_push(l, "    let mut inner = flags;")
    strs_push(l, "    if peek(p) == 63 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b == 61 || b == 33 {")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "            let set = lookahead_set(p, start, flags);")
    strs_push(l, "            return if failed(p) { 0 - 1 } else { add_assert(p, if b == 61 { a_ahead() } else { a_not_ahead() }, set) };")
    strs_push(l, "        }")
    strs_push(l, "        if b == 60 && (byte_at(p, at(p) + 1) == 61 || byte_at(p, at(p) + 1) == 33) {")
    strs_push(l, "            return fail_at(p, start, \"lookbehind is not supported\");")
    strs_push(l, "        }")
    strs_push(l, "        if b == 60 || (b == 80 && byte_at(p, at(p) + 1) == 60) {")
    strs_push(l, "            advance(p, if b == 60 { 1 } else { 2 });")
    strs_push(l, "            let from = at(p);")
    strs_push(l, "            while peek(p) == 95 || (peek(p) >= 48 && peek(p) <= 57) || (peek(p) >= 65 && peek(p) <= 90)")
    strs_push(l, "                || (peek(p) >= 97 && peek(p) <= 122) {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "            }")
    strs_push(l, "            if at(p) == from || peek(p) != 62 { return fail_at(p, start, \"a group name is letters, digits and `_`, then `>`\"); }")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "        } else {")
    strs_push(l, "            capture = false;")
    strs_push(l, "            let mut on = true;")
    strs_push(l, "            let mut more = true;")
    strs_push(l, "            while more {")
    strs_push(l, "                let f = peek(p);")
    strs_push(l, "                if f == 105 || f == 109 || f == 115 {")
    strs_push(l, "                    let bit = if f == 105 { f_fold() } else { if f == 109 { f_lines() } else { f_dot_all() } };")
    strs_push(l, "                    inner = if on { inner | bit } else { inner & (7 - bit) };")
    strs_push(l, "                    advance(p, 1);")
    strs_push(l, "                } else {")
    strs_push(l, "                    if f == 45 && on {")
    strs_push(l, "                        on = false;")
    strs_push(l, "                        advance(p, 1);")
    strs_push(l, "                    } else {")
    strs_push(l, "                        more = false;")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            if peek(p) == 41 {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                ints_set(cell, 0, inner);")
    strs_push(l, "                return 0 - 2;")
    strs_push(l, "            }")
    strs_push(l, "            if peek(p) != 58 { return fail(p, \"an unknown group flag\"); }")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    let index = ints_get(p.groups, 0) + 1;")
    strs_push(l, "    if capture { ints_set(p.groups, 0, index); }")
    strs_push(l, "    let body_cell = ints_new();")
    strs_push(l, "    ints_push(body_cell, inner);")
    strs_push(l, "    let body = alternation(p, body_cell);")
    strs_push(l, "    if failed(p) { return 0 - 1; }")
    strs_push(l, "    if peek(p) != 41 { return fail_at(p, start, \"an unclosed group\"); }")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    if capture { add(p, n_group(), body, index, 0, 0, ints_get(p.size, body) + 2) } else { body }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// One atom; -2 for one that is only flags.")
    strs_push(l, "fn atom(p: Px, cell: Ints) -> Int ! {} {")
    strs_push(l, "    let flags = ints_get(cell, 0);")
    strs_push(l, "    let b = peek(p);")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    if b == 40 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        return group(p, start, cell);")
    strs_push(l, "    }")
    strs_push(l, "    if b == 91 { return add_set(p, class(p, flags)); }")
    strs_push(l, "    if b == 46 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        return add_set(p, dot(flags));")
    strs_push(l, "    }")
    strs_push(l, "    if b == 94 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        return add_assert(p, if flags & f_lines() != 0 { a_line_start() } else { a_text_start() }, ints_new());")
    strs_push(l, "    }")
    strs_push(l, "    if b == 36 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        return add_assert(p, if flags & f_lines() != 0 { a_line_end() } else { a_text_end() }, ints_new());")
    strs_push(l, "    }")
    strs_push(l, "    if b == 42 || b == 43 || b == 63 || b == 123 {")
    strs_push(l, "        return fail(p, \"a repetition with nothing to repeat\");")
    strs_push(l, "    }")
    strs_push(l, "    if b == 92 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        let e = peek(p);")
    strs_push(l, "        if e == 98 { advance(p, 1); return add_assert(p, a_word(), word()); }")
    strs_push(l, "        if e == 66 { advance(p, 1); return add_assert(p, a_not_word(), word()); }")
    strs_push(l, "        if e == 65 { advance(p, 1); return add_assert(p, a_text_start(), ints_new()); }")
    strs_push(l, "        if e == 122 { advance(p, 1); return add_assert(p, a_text_end(), ints_new()); }")
    strs_push(l, "        if class_escape(e) { return add_set(p, escape_class(p, start, flags)); }")
    strs_push(l, "        let c = escape_scalar(p, start);")
    strs_push(l, "        return if failed(p) { 0 - 1 } else { add_set(p, folded(set_range(c, c), flags)) };")
    strs_push(l, "    }")
    strs_push(l, "    let c = literal_scalar(p);")
    strs_push(l, "    add_set(p, folded(set_range(c, c), flags))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A count in `{...}`, at most six digits; -1 where there is none.")
    strs_push(l, "fn count(p: Px) -> Int ! {} {")
    strs_push(l, "    let from = at(p);")
    strs_push(l, "    let mut v = 0;")
    strs_push(l, "    while peek(p) >= 48 && peek(p) <= 57 && at(p) - from < 6 {")
    strs_push(l, "        v = v * 10 + peek(p) - 48;")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "    }")
    strs_push(l, "    if at(p) == from { 0 - 1 } else { v }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `node` and any repetition after it.")
    strs_push(l, "fn repeated(p: Px, node: Int) -> Int ! {} {")
    strs_push(l, "    let b = peek(p);")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    let mut min = 0;")
    strs_push(l, "    let mut max = 0 - 1;")
    strs_push(l, "    if b == 42 { advance(p, 1); } else {")
    strs_push(l, "    if b == 43 { advance(p, 1); min = 1; } else {")
    strs_push(l, "    if b == 63 { advance(p, 1); max = 1; } else {")
    strs_push(l, "    if b == 123 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        min = count(p);")
    strs_push(l, "        if min < 0 { return fail_at(p, start, \"a counted repetition needs a count\"); }")
    strs_push(l, "        if peek(p) == 44 {")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "            max = if peek(p) == 125 { 0 - 1 } else { count(p) };")
    strs_push(l, "            if peek(p) != 125 { return fail_at(p, start, \"an unclosed counted repetition\"); }")
    strs_push(l, "        } else {")
    strs_push(l, "            max = min;")
    strs_push(l, "        }")
    strs_push(l, "        if peek(p) != 125 { return fail_at(p, start, \"an unclosed counted repetition\"); }")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        if max >= 0 && max < min { return fail_at(p, start, \"a counted repetition whose most is below its least\"); }")
    strs_push(l, "    } else {")
    strs_push(l, "        return node;")
    strs_push(l, "    } } } }")
    strs_push(l, "    let mut greedy = 1;")
    strs_push(l, "    if peek(p) == 63 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        greedy = 0;")
    strs_push(l, "    }")
    strs_push(l, "    let after = peek(p);")
    strs_push(l, "    if after == 42 || after == 43 || after == 63 || after == 123 {")
    strs_push(l, "        return fail(p, \"a repetition of a repetition\");")
    strs_push(l, "    }")
    strs_push(l, "    let s = ints_get(p.size, node);")
    strs_push(l, "    let size = if max < 0 { s * min + s + 2 } else { s * max + max - min };")
    strs_push(l, "    if size > max_size() { return fail_at(p, start, \"a repetition too large once written out\"); }")
    strs_push(l, "    add(p, n_rep(), node, min, max, greedy, size)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A concatenation: atoms, each perhaps repeated, to a `|`, a `)` or the end.")
    strs_push(l, "fn concatenation(p: Px, cell: Ints) -> Int ! {} {")
    strs_push(l, "    let items = ints_new();")
    strs_push(l, "    let mut size = 0;")
    strs_push(l, "    while !failed(p) && peek(p) >= 0 && peek(p) != 124 && peek(p) != 41 {")
    strs_push(l, "        let a = atom(p, cell);")
    strs_push(l, "        if a >= 0 && !failed(p) {")
    strs_push(l, "            let r = repeated(p, a);")
    strs_push(l, "            if !failed(p) {")
    strs_push(l, "                ints_push(items, r);")
    strs_push(l, "                size = size + ints_get(p.size, r);")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if size > max_size() { return fail(p, \"a pattern too large once its repetitions are written out\"); }")
    strs_push(l, "    if ints_len(items) == 0 { return add(p, n_empty(), 0, 0, 0, 0, 0); }")
    strs_push(l, "    if ints_len(items) == 1 { return ints_get(items, 0); }")
    strs_push(l, "    let start = ints_len(p.kids);")
    strs_push(l, "    for i in 0..ints_len(items) { ints_push(p.kids, ints_get(items, i)); }")
    strs_push(l, "    add(p, n_cat(), start, ints_len(items), 0, 0, size)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An alternation: concatenations between `|`s.")
    strs_push(l, "fn alternation(p: Px, cell: Ints) -> Int ! {} {")
    strs_push(l, "    let branches = ints_new();")
    strs_push(l, "    ints_push(branches, concatenation(p, cell));")
    strs_push(l, "    while !failed(p) && peek(p) == 124 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        ints_push(branches, concatenation(p, cell));")
    strs_push(l, "    }")
    strs_push(l, "    if failed(p) { return 0 - 1; }")
    strs_push(l, "    if ints_len(branches) == 1 { return ints_get(branches, 0); }")
    strs_push(l, "    let start = ints_len(p.kids);")
    strs_push(l, "    let mut size = 0;")
    strs_push(l, "    for i in 0..ints_len(branches) {")
    strs_push(l, "        ints_push(p.kids, ints_get(branches, i));")
    strs_push(l, "        size = size + ints_get(p.size, ints_get(branches, i)) + 2;")
    strs_push(l, "    }")
    strs_push(l, "    if size > max_size() { return fail(p, \"a pattern too large once its repetitions are written out\"); }")
    strs_push(l, "    add(p, n_alt(), start, ints_len(branches), 0, 0, size)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- the program --------------------------------------------------------------------------------")
    strs_push(l, "//")
    strs_push(l, "// Four `Int`s an instruction: its operation and three operands.")
    strs_push(l, "")
    strs_push(l, "// Match one scalar value of the set `x`, `y` ranges.")
    strs_push(l, "fn op_set() -> Int ! {} { 0 }")
    strs_push(l, "// Continue at `x`, and, less preferred, at `y`.")
    strs_push(l, "fn op_split() -> Int ! {} { 1 }")
    strs_push(l, "// Continue at `x`.")
    strs_push(l, "fn op_jump() -> Int ! {} { 2 }")
    strs_push(l, "// Record the position in slot `x`.")
    strs_push(l, "fn op_save() -> Int ! {} { 3 }")
    strs_push(l, "// Continue if assertion `x` holds, `y` and `z` its set.")
    strs_push(l, "fn op_assert() -> Int ! {} { 4 }")
    strs_push(l, "fn op_match() -> Int ! {} { 5 }")
    strs_push(l, "")
    strs_push(l, "fn emit(prog: Ints, op: Int, x: Int, y: Int, z: Int) -> Int ! {} {")
    strs_push(l, "    ints_push(prog, op);")
    strs_push(l, "    ints_push(prog, x);")
    strs_push(l, "    ints_push(prog, y);")
    strs_push(l, "    ints_push(prog, z);")
    strs_push(l, "    ints_len(prog) / 4 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn pc(prog: Ints) -> Int ! {} { ints_len(prog) / 4 }")
    strs_push(l, "")
    strs_push(l, "/// The split at `at`, its preferred branch the next instruction or, lazy, `out`.")
    strs_push(l, "fn patch_split(prog: Ints, at: Int, out: Int, greedy: Bool) -> Int ! {} {")
    strs_push(l, "    ints_set(prog, 4 * at + 1, if greedy { at + 1 } else { out });")
    strs_push(l, "    ints_set(prog, 4 * at + 2, if greedy { out } else { at + 1 });")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn compile(p: Px, prog: Ints, n: Int) -> Int ! {} {")
    strs_push(l, "    let kind = ints_get(p.kind, n);")
    strs_push(l, "    let a = ints_get(p.a, n);")
    strs_push(l, "    let b = ints_get(p.b, n);")
    strs_push(l, "    if kind == n_set() { emit(prog, op_set(), a, b, 0); }")
    strs_push(l, "    if kind == n_assert() { emit(prog, op_assert(), a, b, ints_get(p.c, n)); }")
    strs_push(l, "    if kind == n_cat() {")
    strs_push(l, "        for i in 0..b { compile(p, prog, ints_get(p.kids, a + i)); }")
    strs_push(l, "    }")
    strs_push(l, "    if kind == n_alt() {")
    strs_push(l, "        let jumps = ints_new();")
    strs_push(l, "        for i in 0..b {")
    strs_push(l, "            if i < b - 1 {")
    strs_push(l, "                let s = emit(prog, op_split(), 0, 0, 0);")
    strs_push(l, "                compile(p, prog, ints_get(p.kids, a + i));")
    strs_push(l, "                ints_push(jumps, emit(prog, op_jump(), 0, 0, 0));")
    strs_push(l, "                patch_split(prog, s, pc(prog), true);")
    strs_push(l, "            } else {")
    strs_push(l, "                compile(p, prog, ints_get(p.kids, a + i));")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        for j in 0..ints_len(jumps) { ints_set(prog, 4 * ints_get(jumps, j) + 1, pc(prog)); }")
    strs_push(l, "    }")
    strs_push(l, "    if kind == n_group() {")
    strs_push(l, "        emit(prog, op_save(), 2 * b, 0, 0);")
    strs_push(l, "        compile(p, prog, a);")
    strs_push(l, "        emit(prog, op_save(), 2 * b + 1, 0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if kind == n_rep() {")
    strs_push(l, "        let max = ints_get(p.c, n);")
    strs_push(l, "        let greedy = ints_get(p.d, n) == 1;")
    strs_push(l, "        for i in 0..b { compile(p, prog, a); }")
    strs_push(l, "        if max < 0 {")
    strs_push(l, "            let s = emit(prog, op_split(), 0, 0, 0);")
    strs_push(l, "            compile(p, prog, a);")
    strs_push(l, "            emit(prog, op_jump(), s, 0, 0);")
    strs_push(l, "            patch_split(prog, s, pc(prog), greedy);")
    strs_push(l, "        } else {")
    strs_push(l, "            let splits = ints_new();")
    strs_push(l, "            for i in b..max {")
    strs_push(l, "                ints_push(splits, emit(prog, op_split(), 0, 0, 0));")
    strs_push(l, "                compile(p, prog, a);")
    strs_push(l, "            }")
    strs_push(l, "            for i in 0..ints_len(splits) { patch_split(prog, ints_get(splits, i), pc(prog), greedy); }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `pattern` compiled, or an `Err` naming what was wrong and the byte offset where.")
    strs_push(l, "pub fn regex_compile(pattern: Str) -> Result[Regex, Str] ! {} {")
    strs_push(l, "    let p = Px(pat: pattern, pos: ints_new(), err: strs_new(), kind: ints_new(), a: ints_new(), b: ints_new(),")
    strs_push(l, "        c: ints_new(), d: ints_new(), size: ints_new(), kids: ints_new(), sets: ints_new(), groups: ints_new());")
    strs_push(l, "    ints_push(p.pos, 0);")
    strs_push(l, "    ints_push(p.groups, 0);")
    strs_push(l, "    let cell = ints_new();")
    strs_push(l, "    ints_push(cell, 0);")
    strs_push(l, "    let root = alternation(p, cell);")
    strs_push(l, "    if !failed(p) && peek(p) == 41 { fail(p, \"an unmatched `)`\"); }")
    strs_push(l, "    if failed(p) {")
    strs_push(l, "        Result[Regex, Str].Err(error: strs_get(p.err, 0))")
    strs_push(l, "    } else {")
    strs_push(l, "        let prog = ints_new();")
    strs_push(l, "        emit(prog, op_save(), 0, 0, 0);")
    strs_push(l, "        compile(p, prog, root);")
    strs_push(l, "        emit(prog, op_save(), 1, 0, 0);")
    strs_push(l, "        emit(prog, op_match(), 0, 0, 0);")
    strs_push(l, "        Result[Regex, Str].Ok(value: Regex(pattern: pattern, prog: prog, sets: p.sets, groups: ints_get(p.groups, 0)))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many capture groups `r` has, not counting the whole match.")
    strs_push(l, "pub fn regex_groups(r: Regex) -> Int ! {} {")
    strs_push(l, "    r.groups")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- the Pike VM --------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// A search's state: the stamp each instruction was last reached under, the work stack, and the")
    strs_push(l, "/// capture slots of the thread being followed.")
    strs_push(l, "struct Vm {")
    strs_push(l, "    re: Regex,")
    strs_push(l, "    text: Str,")
    strs_push(l, "    slots: Int,")
    strs_push(l, "    mark: Ints,")
    strs_push(l, "    stack: Ints,")
    strs_push(l, "    scratch: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn holds(vm: Vm, kind: Int, start: Int, count: Int, pos: Int) -> Bool ! {} {")
    strs_push(l, "    let n = str_len(vm.text);")
    strs_push(l, "    if kind == a_text_start() { return pos == 0; }")
    strs_push(l, "    if kind == a_text_end() { return pos == n; }")
    strs_push(l, "    if kind == a_line_start() { return pos == 0 || str_byte(vm.text, pos - 1) == 10; }")
    strs_push(l, "    if kind == a_line_end() { return pos == n || str_byte(vm.text, pos) == 10; }")
    strs_push(l, "    if kind == a_word() || kind == a_not_word() {")
    strs_push(l, "        let before = pos > 0 && in_set(vm.re.sets, start, count, scalar_before(vm.text, pos));")
    strs_push(l, "        let after = pos < n && in_set(vm.re.sets, start, count, scalar(vm.text, pos));")
    strs_push(l, "        return (before != after) == (kind == a_word());")
    strs_push(l, "    }")
    strs_push(l, "    let next = pos < n && in_set(vm.re.sets, start, count, scalar(vm.text, pos));")
    strs_push(l, "    if kind == a_ahead() { next } else { !next }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn push3(s: Ints, k: Int, a: Int, b: Int) -> Int ! {} {")
    strs_push(l, "    ints_push(s, k);")
    strs_push(l, "    ints_push(s, a);")
    strs_push(l, "    ints_push(s, b);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A thread at `pc0`, at byte `pos`, with the scratch slots, followed through every jump, split,")
    strs_push(l, "/// save and assertion — preferred branches first — to the sets and the match it reaches, which")
    strs_push(l, "/// join the list in that order. An instruction already reached under `stamp` is not followed")
    strs_push(l, "/// again: a higher-priority thread holds it.")
    strs_push(l, "fn follow(vm: Vm, list: Ints, caps: Ints, pc0: Int, pos: Int, stamp: Int) -> Int ! {} {")
    strs_push(l, "    let prog = vm.re.prog;")
    strs_push(l, "    push3(vm.stack, 0, pc0, 0);")
    strs_push(l, "    while ints_len(vm.stack) > 0 {")
    strs_push(l, "        let v = ints_pop(vm.stack);")
    strs_push(l, "        let at = ints_pop(vm.stack);")
    strs_push(l, "        let k = ints_pop(vm.stack);")
    strs_push(l, "        if k == 1 {")
    strs_push(l, "            ints_set(vm.scratch, at, v);")
    strs_push(l, "        } else {")
    strs_push(l, "            if ints_get(vm.mark, at) != stamp {")
    strs_push(l, "                ints_set(vm.mark, at, stamp);")
    strs_push(l, "                let op = ints_get(prog, 4 * at);")
    strs_push(l, "                let x = ints_get(prog, 4 * at + 1);")
    strs_push(l, "                if op == op_jump() { push3(vm.stack, 0, x, 0); } else {")
    strs_push(l, "                if op == op_split() {")
    strs_push(l, "                    push3(vm.stack, 0, ints_get(prog, 4 * at + 2), 0);")
    strs_push(l, "                    push3(vm.stack, 0, x, 0);")
    strs_push(l, "                } else {")
    strs_push(l, "                if op == op_save() {")
    strs_push(l, "                    push3(vm.stack, 1, x, ints_get(vm.scratch, x));")
    strs_push(l, "                    ints_set(vm.scratch, x, pos);")
    strs_push(l, "                    push3(vm.stack, 0, at + 1, 0);")
    strs_push(l, "                } else {")
    strs_push(l, "                if op == op_assert() {")
    strs_push(l, "                    if holds(vm, x, ints_get(prog, 4 * at + 2), ints_get(prog, 4 * at + 3), pos) {")
    strs_push(l, "                        push3(vm.stack, 0, at + 1, 0);")
    strs_push(l, "                    }")
    strs_push(l, "                } else {")
    strs_push(l, "                    ints_push(list, at);")
    strs_push(l, "                    for s in 0..vm.slots { ints_push(caps, ints_get(vm.scratch, s)); }")
    strs_push(l, "                } } } }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn clear(xs: Ints) -> Int ! {} {")
    strs_push(l, "    while ints_len(xs) > 0 { ints_pop(xs); }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The capture slots of the leftmost-first match at or after `from`, or none; with `quick`, of")
    strs_push(l, "/// the first match found, whichever it is.")
    strs_push(l, "fn run(r: Regex, text: Str, from: Int, quick: Bool) -> Ints ! {} {")
    strs_push(l, "    let best = ints_new();")
    strs_push(l, "    let n = str_len(text);")
    strs_push(l, "    if from < 0 || from > n { return best; }")
    strs_push(l, "    let slots = 2 * (r.groups + 1);")
    strs_push(l, "    let vm = Vm(re: r, text: text, slots: slots, mark: ints_new(), stack: ints_new(), scratch: ints_new());")
    strs_push(l, "    for i in 0..ints_len(r.prog) / 4 { ints_push(vm.mark, 0); }")
    strs_push(l, "    for i in 0..slots { ints_push(vm.scratch, 0 - 1); }")
    strs_push(l, "    let mut list = ints_new();")
    strs_push(l, "    let mut caps = ints_new();")
    strs_push(l, "    let mut next = ints_new();")
    strs_push(l, "    let mut next_caps = ints_new();")
    strs_push(l, "    let mut matched = false;")
    strs_push(l, "    let mut stamp = 1;")
    strs_push(l, "    let mut pos = from;")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done {")
    strs_push(l, "        if !matched {")
    strs_push(l, "            // A new thread, starting here, less preferred than every one already running.")
    strs_push(l, "            for s in 0..slots { ints_set(vm.scratch, s, 0 - 1); }")
    strs_push(l, "            follow(vm, list, caps, 0, pos, stamp);")
    strs_push(l, "        }")
    strs_push(l, "        if matched && ints_len(list) == 0 {")
    strs_push(l, "            done = true;")
    strs_push(l, "        } else {")
    strs_push(l, "            let c = if pos < n { scalar(text, pos) } else { 0 - 1 };")
    strs_push(l, "            let w = if pos < n { width(text, pos) } else { 0 };")
    strs_push(l, "            stamp = stamp + 1;")
    strs_push(l, "            let mut i = 0;")
    strs_push(l, "            let mut cut = false;")
    strs_push(l, "            while i < ints_len(list) && !cut {")
    strs_push(l, "                let at = ints_get(list, i);")
    strs_push(l, "                if ints_get(r.prog, 4 * at) == op_match() {")
    strs_push(l, "                    // Every thread after this one is less preferred than this match.")
    strs_push(l, "                    matched = true;")
    strs_push(l, "                    clear(best);")
    strs_push(l, "                    for s in 0..slots { ints_push(best, ints_get(caps, i * slots + s)); }")
    strs_push(l, "                    cut = true;")
    strs_push(l, "                    if quick { done = true; }")
    strs_push(l, "                } else {")
    strs_push(l, "                    if c >= 0 && in_set(r.sets, ints_get(r.prog, 4 * at + 1), ints_get(r.prog, 4 * at + 2), c) {")
    strs_push(l, "                        for s in 0..slots { ints_set(vm.scratch, s, ints_get(caps, i * slots + s)); }")
    strs_push(l, "                        follow(vm, next, next_caps, at + 1, pos + w, stamp);")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "            clear(list);")
    strs_push(l, "            clear(caps);")
    strs_push(l, "            let t = list;")
    strs_push(l, "            list = next;")
    strs_push(l, "            next = t;")
    strs_push(l, "            let tc = caps;")
    strs_push(l, "            caps = next_caps;")
    strs_push(l, "            next_caps = tc;")
    strs_push(l, "            if pos >= n { done = true; } else { pos = pos + w; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    best")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `r` matches anywhere in `text`.")
    strs_push(l, "pub fn regex_is_match(r: Regex, text: Str) -> Bool ! {} {")
    strs_push(l, "    ints_len(run(r, text, 0, true)) > 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The leftmost-first match of `r` in `text` starting at or after byte `from`; `None` where there")
    strs_push(l, "/// is none, or `from` is outside `0..=str_len(text)`.")
    strs_push(l, "pub fn regex_find(r: Regex, text: Str, from: Int) -> Option[Match] ! {} {")
    strs_push(l, "    let best = run(r, text, from, false);")
    strs_push(l, "    if ints_len(best) == 0 { Option[Match].None() } else {")
    strs_push(l, "        Option[Match].Some(value: Match(start: ints_get(best, 0), end: ints_get(best, 1)))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every match of `r` in `text`, left to right, none overlapping. After a match the search goes on")
    strs_push(l, "/// from its end — one scalar value later after an empty match — and an empty match right where the")
    strs_push(l, "/// one before it ended is skipped, as in Rust's `regex`.")
    strs_push(l, "pub fn regex_find_all(r: Regex, text: Str) -> Vec[Match] ! {} {")
    strs_push(l, "    let out = vec_new[Match]();")
    strs_push(l, "    let n = str_len(text);")
    strs_push(l, "    let mut pos = 0;")
    strs_push(l, "    let mut last = 0 - 1;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        match regex_find(r, text, pos) {")
    strs_push(l, "            Option.Some(value: m) => {")
    strs_push(l, "                let empty = m.start == m.end;")
    strs_push(l, "                if !(empty && m.end == last) {")
    strs_push(l, "                    vec_push(out, m);")
    strs_push(l, "                    last = m.end;")
    strs_push(l, "                }")
    strs_push(l, "                if empty {")
    strs_push(l, "                    if m.end >= n { more = false; } else { pos = m.end + width(text, m.end); }")
    strs_push(l, "                } else {")
    strs_push(l, "                    pos = m.end;")
    strs_push(l, "                }")
    strs_push(l, "            },")
    strs_push(l, "            Option.None() => { more = false; },")
    strs_push(l, "        };")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The leftmost-first match at or after `from`, as `regex_find` finds it, with its capture groups:")
    strs_push(l, "/// item 0 the whole match, item `k` group `k` — `None` for a group that took no part. `None` where")
    strs_push(l, "/// there is no match.")
    strs_push(l, "pub fn regex_captures(r: Regex, text: Str, from: Int) -> Option[Vec[Option[Match]]] ! {} {")
    strs_push(l, "    let best = run(r, text, from, false);")
    strs_push(l, "    if ints_len(best) == 0 { return Option[Vec[Option[Match]]].None(); }")
    strs_push(l, "    let out = vec_new[Option[Match]]();")
    strs_push(l, "    for k in 0..r.groups + 1 {")
    strs_push(l, "        let s = ints_get(best, 2 * k);")
    strs_push(l, "        let e = ints_get(best, 2 * k + 1);")
    strs_push(l, "        if s < 0 || e < 0 {")
    strs_push(l, "            vec_push(out, Option[Match].None());")
    strs_push(l, "        } else {")
    strs_push(l, "            vec_push(out, Option[Match].Some(value: Match(start: s, end: e)));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    Option[Vec[Option[Match]]].Some(value: out)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- Unicode 16.0 general categories, as `table` reads them --------------------------------------")
    strs_push(l, "")
    strs_push(l, "// General_Category=Lu: 651 ranges.")
    strs_push(l, "const U_LU: Str = \"!&\";")
    strs_push(l, "// General_Category=Ll: 662 ranges.")
    strs_push(l, "const U_LL: Str = \"!&iJ010101010101010101010101010101010101010101010J010101010101010101010101010e701010101010121010101010101010101010101010101010101010101010101010101010101017101020101010104010201210101010101010101010505010101010101010401020301010101010Q030zLbA587cFt!06C4bb9PbgDb7e8b3eRA1E1611by3bIdTLczQVvm0VzmQPQ61HQPQ310161AQPQPQPQPQPQPQPQPQRSO15QO15QO15QO15QO1510bzK91J65cpNb1\";")
    strs_push(l, "// General_Category=Lt: 10 ranges.")
    strs_push(l, "const U_LT: Str = \"o502020b60hmL78787C0F0bF0\";")
    strs_push(l, "// General_Category=Lm: 75 ranges.")
    strs_push(l, "const U_LM: Str = \"vGH4BE47010e5050oU0h60f41iD140V09030f00f70bgK0dV0rL0bwQ0dB0t30oG5fEbUD0b2b4vH0D0GCc&V1hH0fV0oL0bB450d11cT2#yM0bh25iE0dI0S1dP8cG0N0d9231oL0M0e90dC0L1d7390va60bD1b*051b918bmJ0b00xoG3pS2b81r6Cc0110qaC31611mbHbTg96%D0bcV0\";")
    strs_push(l, "// General_Category=Lo: 528 ranges.")
    strs_push(l, "const U_LO: Str = \"*NbNOM9616161616161616r70bL04cL801cP405bA1cTHVbGFq0gnVc0uqK1bdMc3b78iB4FA1c20bHc5f90d703612131MTbJEbHbU53011BRAMPS7bEbD428A41b8N217KF15303bH1031242010O13A70E525259616eHb2Tk%$Ph6g3csCd0FbbFH5Pd$Q5s6gvPTbx2rO7UHcEHTIbFbJK5InJb7mLcA50fFf*N8bgLb99ixNj2F0T220E38mBci4dA5C3879itG0pLbCb10k1TIbBp4Qh5T20pF613111E1g4bjR31Q1110201913101060401010121110201010101011102316131310191G52141Gek4bjwVb0ebP6gT2fu1EhjGFtDcn2qTbp2e!A5ecV\";")
    strs_push(l, "// General_Category=Mn: 357 ranges.")
    strs_push(l, "const U_MN: Str = \"y0dFiJ4i9bC10111110c8AbGKG0d56252113b30UQcRAbQ890O3181214bB2bR8bAN1VbN010474036A1T0bQ04380K1Q021bP041412230U130B1bP0441140K1M510bQ020138071B1U0bT0C0bI030bN012521371B1T0bQ0206051K1S1bP14380K1T0c807210cQ026C7d2028B6c91R01010bND14115A1b390d63151121P142G3D02160F0vV2%I2T1U1U1c0116802A90bD210dL1b20dM2419062gR120bQ0161010276920bGD1FbH3bG0141050b88C1b032112bO0113012bQ721eO21C16406031g6bVwGC403Bc*U2eD0d0VrA3dB1%oK049b01cG1iG03040P150eN1QHD0b67PAbE2bG02321b70c352121C080bF0bJ012215110bA180hE02040tzG0x1FGF&%RbM4bH80E0M41EbkG61G261114d40f06lN0bT3pS3hU1x06dD6yf%LhF\";")
    strs_push(l, "// General_Category=Mc: 190 ranges.")
    strs_push(l, "const U_MC: Str = \"ci30bN0228311bI1bQ26121A0bB0bQ2c20bQ28011bL1bQ0106121A0d61113212A0b92bT3bT1bQ014211191S0E1bQ25212A0bA1cB267I1kA1bV0fB1406021P1A226L12520A2btO0U0e107711kQ3224115h01bQ010901185eH0bG0501411bT0U04120bS0221031bG781fB0L0ezM1%*J120cO1bIFeE1bF0bG14122dE121O0bD010dD02150hD1111110zaJ010dV0bD241dJ0O1bR0bG291D0cT23110fA2V1bQ113212290A1cK27020131110d528130dA2601320hD26320dH28110dD01160d701140i5290hN511402010eE28340cK0T1bU0mN0E0dA07020gL44110kU1C0bG18110qp82dr4bMd81ylJ165\";")
    strs_push(l, "// General_Category=Me: 5 ranges.")
    strs_push(l, "const U_ME: Str = \"be81frK0bqU312bbmB2\";")
    strs_push(l, "// General_Category=Nd: 71 ranges.")
    strs_push(l, "const U_ND: Str = \"bG9br69e69g69mS9dM9dM9dM9dM9dM9dM9dM9dM9dM9d09dM9c69iM9c69b!69b69jC9e09f6969fM9cM9e6969bco69v69b69g69M9cM9mM9uyM9bm69ce6969yS9e09bS9eG9iM9kM9dM9lM9d696JcC9n69d69uM9cM9hM9c69n69qoM9cj69cM9e69qM9x#M9cwKbHck09n69pM9hN9!L9euM9\";")
    strs_push(l, "// General_Category=Nl: 12 ranges.")
    strs_push(l, "const U_NL: Str = \"fxE2ctFb223dtU0P8E2%vB9wsGbKoC080e64ibAdE\";")
    strs_push(l, "// General_Category=No: 72 ranges.")
    strs_push(l, "const U_NO: Str = \"fI15022cjL5lO5dO2e56gP6H8nH9bbLJbdJ9p00buL03569g6Fb90wMbRcELtMTbl90beK3eA9U71Eb09b7E%lG5wgHbCc13H1kLQb43bjK7P6b78cB4M5f012F2bDc08bK1U2cB4d87O7b96kA5l0UeU9bA3dG6e6JlRJbk51nE8#7I!JKs$66yUMzb9JCJdCOfkE8%1bQ1213cCbC1E&2C\";")
    strs_push(l, "// General_Category=Pc: 6 ranges.")
    strs_push(l, "const U_PC: Str = \"cV0h&V1J0bxoU1O2hF0\";")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_result() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/result`: the helpers every use of `Result` would otherwise write for itself.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/result\";`. `Result` and `?` are the prelude's and the language's;")
    strs_push(l, "// nothing here turns an `Err` into a failure, and nothing throws an error away unless its")
    strs_push(l, "// name says it does.")
    strs_push(l, "")
    strs_push(l, "/// Whether `r` is an `Ok`.")
    strs_push(l, "pub fn result_is_ok[T, E](r: Result[T, E]) -> Bool ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => true,")
    strs_push(l, "        Result.Err(error: e) => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `r` is an `Err`.")
    strs_push(l, "pub fn result_is_err[T, E](r: Result[T, E]) -> Bool ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => false,")
    strs_push(l, "        Result.Err(error: e) => true,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value of an `Ok`, or `fallback` — discarding the error, as the name says.")
    strs_push(l, "pub fn result_unwrap_or[T, E](r: Result[T, E], fallback: T) -> T ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => v,")
    strs_push(l, "        Result.Err(error: e) => fallback,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value of an `Ok` as an `Option`, discarding the error.")
    strs_push(l, "pub fn result_ok[T, E](r: Result[T, E]) -> Option[T] ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => Option[T].Some(value: v),")
    strs_push(l, "        Result.Err(error: e) => Option[T].None(),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The error of an `Err` as an `Option`.")
    strs_push(l, "pub fn result_err[T, E](r: Result[T, E]) -> Option[E] ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => Option[E].None(),")
    strs_push(l, "        Result.Err(error: e) => Option[E].Some(value: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_seq() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/seq`: searching and summarising the built-in sequences.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/seq\";`. The sequences themselves — `Ints`, `Strs` and `Vec[T]` — and")
    strs_push(l, "// their `_new`, `_len`, `_get`, `_set`, `_push` and `_pop` are built-ins; these are written over")
    strs_push(l, "// them. None fails: an empty sequence has no maximum, so that is `None`, not a trap.")
    strs_push(l, "")
    strs_push(l, "/// The first index at which `xs` holds `x`, or `None`.")
    strs_push(l, "pub fn ints_index_of(xs: Ints, x: Int) -> Option[Int] ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    // -1 while searching, -2 once every element has been looked at, the index once found.")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    while found == 0 - 1 {")
    strs_push(l, "        if i == ints_len(xs) { found = 0 - 2; } else { if ints_get(xs, i) == x { found = i; } else { i = i + 1; } }")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { Option[Int].Some(value: found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `xs` holds `x`.")
    strs_push(l, "pub fn ints_contains(xs: Ints, x: Int) -> Bool ! {} {")
    strs_push(l, "    match ints_index_of(xs, x) {")
    strs_push(l, "        Option.Some(value: i) => true,")
    strs_push(l, "        Option.None() => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The sum of `xs`, checked like every addition: an overflow is `N0400`.")
    strs_push(l, "pub fn ints_sum(xs: Ints) -> Int ! {} {")
    strs_push(l, "    let mut total = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < ints_len(xs) { total = total + ints_get(xs, i); i = i + 1; }")
    strs_push(l, "    total")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The largest element of `xs`, or `None` when it is empty.")
    strs_push(l, "pub fn ints_max(xs: Ints) -> Option[Int] ! {} {")
    strs_push(l, "    if ints_len(xs) == 0 {")
    strs_push(l, "        Option[Int].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut best = ints_get(xs, 0);")
    strs_push(l, "        let mut i = 1;")
    strs_push(l, "        while i < ints_len(xs) {")
    strs_push(l, "            if ints_get(xs, i) > best { best = ints_get(xs, i); }")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        Option[Int].Some(value: best)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The smallest element of `xs`, or `None` when it is empty.")
    strs_push(l, "pub fn ints_min(xs: Ints) -> Option[Int] ! {} {")
    strs_push(l, "    if ints_len(xs) == 0 {")
    strs_push(l, "        Option[Int].None()")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut best = ints_get(xs, 0);")
    strs_push(l, "        let mut i = 1;")
    strs_push(l, "        while i < ints_len(xs) {")
    strs_push(l, "            if ints_get(xs, i) < best { best = ints_get(xs, i); }")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        Option[Int].Some(value: best)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The first index at which `xs` holds `x`, or `None`.")
    strs_push(l, "pub fn strs_index_of(xs: Strs, x: Str) -> Option[Int] ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    // -1 while searching, -2 once every element has been looked at, the index once found.")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    while found == 0 - 1 {")
    strs_push(l, "        if i == strs_len(xs) { found = 0 - 2; } else { if strs_get(xs, i) == x { found = i; } else { i = i + 1; } }")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { Option[Int].Some(value: found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `xs` holds `x`.")
    strs_push(l, "pub fn strs_contains(xs: Strs, x: Str) -> Bool ! {} {")
    strs_push(l, "    match strs_index_of(xs, x) {")
    strs_push(l, "        Option.Some(value: i) => true,")
    strs_push(l, "        Option.None() => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The first index at which `xs` holds a value equal to `x`, or `None`.")
    strs_push(l, "pub fn vec_index_of[T: Equality](xs: Vec[T], x: T) -> Option[Int] ! {} {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    // -1 while searching, -2 once every element has been looked at, the index once found.")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    while found == 0 - 1 {")
    strs_push(l, "        if i == vec_len(xs) { found = 0 - 2; } else { if vec_get(xs, i) == x { found = i; } else { i = i + 1; } }")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { Option[Int].Some(value: found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Higher-order (N50). Each takes a function value, so `f` may be a named function or a")
    strs_push(l, "// closure, and each is polymorphic in its effects (N51): it does what `f` does, which is")
    strs_push(l, "// `E`, and nothing else — so a caller is held to what the function it passes does.")
    strs_push(l, "")
    strs_push(l, "/// `f` applied to each element of `xs`, in order, as a new `Vec`. `xs` is unchanged.")
    strs_push(l, "pub fn vec_map[T, U, effects E](xs: Vec[T], f: fn(T) -> U ! { E }) -> Vec[U] ! { E } {")
    strs_push(l, "    let out = vec_new[U]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(xs) { vec_push(out, f(vec_get(xs, i))); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The elements of `xs` for which `keep` holds, in order, as a new `Vec`.")
    strs_push(l, "pub fn vec_filter[T, effects E](xs: Vec[T], keep: fn(T) -> Bool ! { E }) -> Vec[T] ! { E } {")
    strs_push(l, "    let out = vec_new[T]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(xs) {")
    strs_push(l, "        let x = vec_get(xs, i);")
    strs_push(l, "        if keep(x) { vec_push(out, x); }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `f(… f(f(init, xs[0]), xs[1]) …, xs[n - 1])`: `init` when `xs` is empty.")
    strs_push(l, "pub fn vec_fold[T, A, effects E](xs: Vec[T], init: A, f: fn(A, T) -> A ! { E }) -> A ! { E } {")
    strs_push(l, "    let mut acc = init;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(xs) { acc = f(acc, vec_get(xs, i)); i = i + 1; }")
    strs_push(l, "    acc")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new vector holding `xs` in reverse order.")
    strs_push(l, "pub fn vec_reverse[T](xs: Vec[T]) -> Vec[T] ! {} {")
    strs_push(l, "    let out = vec_new[T]();")
    strs_push(l, "    let mut i = vec_len(xs);")
    strs_push(l, "    while i > 0 { i = i - 1; vec_push(out, vec_get(xs, i)); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new vector holding the elements of `xs` from index `from` up to, not including, `to`; both")
    strs_push(l, "/// are clamped to `0..len`, and an empty range is an empty vector.")
    strs_push(l, "pub fn vec_slice[T](xs: Vec[T], from: Int, to: Int) -> Vec[T] ! {} {")
    strs_push(l, "    let n = vec_len(xs);")
    strs_push(l, "    let a = if from < 0 { 0 } else { if from > n { n } else { from } };")
    strs_push(l, "    let b = if to < a { a } else { if to > n { n } else { to } };")
    strs_push(l, "    let out = vec_new[T]();")
    strs_push(l, "    let mut i = a;")
    strs_push(l, "    while i < b { vec_push(out, vec_get(xs, i)); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new vector holding `a`'s elements, then `b`'s.")
    strs_push(l, "pub fn vec_concat[T](a: Vec[T], b: Vec[T]) -> Vec[T] ! {} {")
    strs_push(l, "    let out = vec_new[T]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(a) { vec_push(out, vec_get(a, i)); i = i + 1; }")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < vec_len(b) { vec_push(out, vec_get(b, i)); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `test` holds for some element, asking in order and stopping at the first that does.")
    strs_push(l, "pub fn vec_any[T, effects E](xs: Vec[T], test: fn(T) -> Bool ! { E }) -> Bool ! { E } {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut found = false;")
    strs_push(l, "    while !found && i < vec_len(xs) { found = test(vec_get(xs, i)); i = i + 1; }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `test` holds for every element, asking in order and stopping at the first that does")
    strs_push(l, "/// not. Every element of an empty vector passes.")
    strs_push(l, "pub fn vec_all[T, effects E](xs: Vec[T], test: fn(T) -> Bool ! { E }) -> Bool ! { E } {")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut ok = true;")
    strs_push(l, "    while ok && i < vec_len(xs) { ok = test(vec_get(xs, i)); i = i + 1; }")
    strs_push(l, "    ok")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_sha256() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/sha256`: SHA-256, as FIPS 180-4 defines it (R1e, S1).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/sha256\";`. `sha256(data)` is the 32-byte digest of a whole buffer;")
    strs_push(l, "// `sha256_new`, `sha256_update` and `sha256_finish` give the same digest of data that arrives in")
    strs_push(l, "// pieces, whatever the pieces. A hasher is a handle, shared like a `Vec`: an update through one")
    strs_push(l, "// copy is seen through every copy. `sha256_finish` pads a copy of what is buffered, so it leaves")
    strs_push(l, "// the hasher as it was — more may be added and finished again. Pure Nazm over 32-bit wrapping")
    strs_push(l, "// arithmetic and rotations; held to FIPS 180-4's examples (`crates/nazm-cli/tests/hash_vectors.rs`).")
    strs_push(l, "")
    strs_push(l, "/// An incremental SHA-256 hasher.")
    strs_push(l, "pub struct Sha256 {")
    strs_push(l, "    // The eight state words, big-endian.")
    strs_push(l, "    state: Bytes,")
    strs_push(l, "    // The block being filled.")
    strs_push(l, "    block: Bytes,")
    strs_push(l, "    // How many bytes `block` holds, then how many the hasher has been given in all.")
    strs_push(l, "    counts: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "const K: [UInt32; 64] = [")
    strs_push(l, "    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,")
    strs_push(l, "    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,")
    strs_push(l, "    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,")
    strs_push(l, "    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,")
    strs_push(l, "    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,")
    strs_push(l, "    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,")
    strs_push(l, "    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,")
    strs_push(l, "    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,")
    strs_push(l, "];")
    strs_push(l, "")
    strs_push(l, "const H0: [UInt32; 8] = [")
    strs_push(l, "    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,")
    strs_push(l, "];")
    strs_push(l, "")
    strs_push(l, "/// A new hasher, given nothing yet.")
    strs_push(l, "pub fn sha256_new() -> Sha256 ! {} {")
    strs_push(l, "    let state = bytes_new(32);")
    strs_push(l, "    let h = H0;")
    strs_push(l, "    for i in 0..8 {")
    strs_push(l, "        bytes_write_be(state, 4 * i, h[i]);")
    strs_push(l, "    }")
    strs_push(l, "    let counts = ints_new();")
    strs_push(l, "    ints_push(counts, 0);")
    strs_push(l, "    ints_push(counts, 0);")
    strs_push(l, "    Sha256(state: state, block: bytes_new(64), counts: counts)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// One 64-byte block, `block[at..at + 64]`, into `state`.")
    strs_push(l, "fn compress(state: Bytes, block: Bytes, at: Int) -> Int ! {} {")
    strs_push(l, "    let k = K;")
    strs_push(l, "    let mut w = [UInt32(0); 64];")
    strs_push(l, "    for t in 0..16 {")
    strs_push(l, "        w[t] = bytes_read_be[UInt32](block, at + 4 * t);")
    strs_push(l, "    }")
    strs_push(l, "    for t in 16..64 {")
    strs_push(l, "        let x = w[t - 15];")
    strs_push(l, "        let y = w[t - 2];")
    strs_push(l, "        let s0 = rotate_right(x, 7) ^ rotate_right(x, 18) ^ (x >> 3);")
    strs_push(l, "        let s1 = rotate_right(y, 17) ^ rotate_right(y, 19) ^ (y >> 10);")
    strs_push(l, "        w[t] = wrapping_add(wrapping_add(w[t - 16], s0), wrapping_add(w[t - 7], s1));")
    strs_push(l, "    }")
    strs_push(l, "    let mut a = bytes_read_be[UInt32](state, 0);")
    strs_push(l, "    let mut b = bytes_read_be[UInt32](state, 4);")
    strs_push(l, "    let mut c = bytes_read_be[UInt32](state, 8);")
    strs_push(l, "    let mut d = bytes_read_be[UInt32](state, 12);")
    strs_push(l, "    let mut e = bytes_read_be[UInt32](state, 16);")
    strs_push(l, "    let mut f = bytes_read_be[UInt32](state, 20);")
    strs_push(l, "    let mut g = bytes_read_be[UInt32](state, 24);")
    strs_push(l, "    let mut h = bytes_read_be[UInt32](state, 28);")
    strs_push(l, "    for t in 0..64 {")
    strs_push(l, "        let big1 = rotate_right(e, 6) ^ rotate_right(e, 11) ^ rotate_right(e, 25);")
    strs_push(l, "        let ch = (e & f) ^ (~e & g);")
    strs_push(l, "        let t1 = wrapping_add(wrapping_add(wrapping_add(h, big1), wrapping_add(ch, k[t])), w[t]);")
    strs_push(l, "        let big0 = rotate_right(a, 2) ^ rotate_right(a, 13) ^ rotate_right(a, 22);")
    strs_push(l, "        let maj = (a & b) ^ (a & c) ^ (b & c);")
    strs_push(l, "        let t2 = wrapping_add(big0, maj);")
    strs_push(l, "        h = g;")
    strs_push(l, "        g = f;")
    strs_push(l, "        f = e;")
    strs_push(l, "        e = wrapping_add(d, t1);")
    strs_push(l, "        d = c;")
    strs_push(l, "        c = b;")
    strs_push(l, "        b = a;")
    strs_push(l, "        a = wrapping_add(t1, t2);")
    strs_push(l, "    }")
    strs_push(l, "    add_word(state, 0, a);")
    strs_push(l, "    add_word(state, 4, b);")
    strs_push(l, "    add_word(state, 8, c);")
    strs_push(l, "    add_word(state, 12, d);")
    strs_push(l, "    add_word(state, 16, e);")
    strs_push(l, "    add_word(state, 20, f);")
    strs_push(l, "    add_word(state, 24, g);")
    strs_push(l, "    add_word(state, 28, h);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn add_word(state: Bytes, at: Int, v: UInt32) -> Int ! {} {")
    strs_push(l, "    bytes_write_be(state, at, wrapping_add(bytes_read_be[UInt32](state, at), v))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Give the hasher `data`, after whatever it was given before: `0`.")
    strs_push(l, "pub fn sha256_update(h: Sha256, data: Bytes) -> Int ! {} {")
    strs_push(l, "    let n = bytes_len(data);")
    strs_push(l, "    let mut held = ints_get(h.counts, 0);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    // Fill a partly filled block first.")
    strs_push(l, "    if held > 0 {")
    strs_push(l, "        let take = if n < 64 - held { n } else { 64 - held };")
    strs_push(l, "        bytes_copy(bytes_slice(h.block, held, held + take), bytes_slice(data, 0, take));")
    strs_push(l, "        held = held + take;")
    strs_push(l, "        at = take;")
    strs_push(l, "        if held == 64 {")
    strs_push(l, "            compress(h.state, h.block, 0);")
    strs_push(l, "            held = 0;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    // Whole blocks straight from `data`.")
    strs_push(l, "    while n - at >= 64 {")
    strs_push(l, "        compress(h.state, data, at);")
    strs_push(l, "        at = at + 64;")
    strs_push(l, "    }")
    strs_push(l, "    // What is left waits for more.")
    strs_push(l, "    if at < n {")
    strs_push(l, "        bytes_copy(bytes_slice(h.block, held, held + n - at), bytes_slice(data, at, n));")
    strs_push(l, "        held = held + n - at;")
    strs_push(l, "    }")
    strs_push(l, "    ints_set(h.counts, 0, held);")
    strs_push(l, "    ints_set(h.counts, 1, ints_get(h.counts, 1) + n);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The digest of everything the hasher has been given: 32 bytes. The hasher is unchanged.")
    strs_push(l, "pub fn sha256_finish(h: Sha256) -> Bytes ! {} {")
    strs_push(l, "    let state = bytes_new(32);")
    strs_push(l, "    bytes_copy(state, h.state);")
    strs_push(l, "    let held = ints_get(h.counts, 0);")
    strs_push(l, "    let bits = wrap_convert[UInt64](ints_get(h.counts, 1)) << 3;")
    strs_push(l, "    // The held bytes, a one bit, zeros, and the length in bits as a big-endian 64-bit number:")
    strs_push(l, "    // one block, or two when fewer than nine bytes are free.")
    strs_push(l, "    let blocks = if held < 56 { 1 } else { 2 };")
    strs_push(l, "    let tail = bytes_new(64 * blocks);")
    strs_push(l, "    bytes_copy(tail, bytes_slice(h.block, 0, held));")
    strs_push(l, "    bytes_set(tail, held, UInt8(0x80));")
    strs_push(l, "    bytes_write_be(tail, 64 * blocks - 8, bits);")
    strs_push(l, "    for i in 0..blocks {")
    strs_push(l, "        compress(state, tail, 64 * i);")
    strs_push(l, "    }")
    strs_push(l, "    state")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The SHA-256 digest of `data`: 32 bytes.")
    strs_push(l, "pub fn sha256(data: Bytes) -> Bytes ! {} {")
    strs_push(l, "    let h = sha256_new();")
    strs_push(l, "    sha256_update(h, data);")
    strs_push(l, "    sha256_finish(h)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The SHA-256 digest of `data` as 64 lower-case hexadecimal digits.")
    strs_push(l, "pub fn sha256_hex(data: Bytes) -> Str ! {} {")
    strs_push(l, "    let digest = sha256(data);")
    strs_push(l, "    let digits = \"0123456789abcdef\";")
    strs_push(l, "    let out = bytes_new(64);")
    strs_push(l, "    for i in 0..32 {")
    strs_push(l, "        let b = Int(bytes_get(digest, i));")
    strs_push(l, "        bytes_set(out, 2 * i, UInt8(str_byte(digits, b >> 4)));")
    strs_push(l, "        bytes_set(out, 2 * i + 1, UInt8(str_byte(digits, b & 15)));")
    strs_push(l, "    }")
    strs_push(l, "    bytes_to_str(out)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_show() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/show`: a value as text, by a trait (N78).")
    strs_push(l, "//")
    strs_push(l, "// Ordinary source, imported with `use \"@std/show\";`. `Show` is the capability generic code asks")
    strs_push(l, "// for when it renders a value: `show_all[T: Show]` renders every element of a `Vec[T]` without")
    strs_push(l, "// being handed a rendering function, which is the program `docs/internal/architecture.md` §7.79 names as")
    strs_push(l, "// the need. Every impl here is for a built-in type, so this module is where they must be (the")
    strs_push(l, "// orphan rule); a record or an enum implements `Show` in its own module.")
    strs_push(l, "")
    strs_push(l, "/// A value written as text.")
    strs_push(l, "pub trait Show {")
    strs_push(l, "    fn show(self: Self) -> Str;")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Show for Int {")
    strs_push(l, "    fn show(self: Int) -> Str {")
    strs_push(l, "        int_to_str(self)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Show for Bool {")
    strs_push(l, "    fn show(self: Bool) -> Str {")
    strs_push(l, "        if self { \"true\" } else { \"false\" }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "impl Show for Str {")
    strs_push(l, "    fn show(self: Str) -> Str {")
    strs_push(l, "        self")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every element of `v`, shown, with `sep` between each two.")
    strs_push(l, "pub fn show_all[T: Show](v: Vec[T], sep: Str) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(v) {")
    strs_push(l, "        if i > 0 {")
    strs_push(l, "            out = str_concat(out, sep);")
    strs_push(l, "        }")
    strs_push(l, "        out = str_concat(out, vec_get(v, i).show());")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_sort() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/sort`: sorting the built-in sequences.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/sort\";`. Its own module rather than `@std/seq`'s because a sort")
    strs_push(l, "// allocates in a loop and calls its ordering through a function value: a restriction profile")
    strs_push(l, "// that refuses either (`embedded`) refuses every function of a module it imports, and a")
    strs_push(l, "// program that only searches and sums a sequence should not be refused for a sort it never")
    strs_push(l, "// calls.")
    strs_push(l, "")
    strs_push(l, "use \"@std/hash\";")
    strs_push(l, "use \"@std/hashmap\";")
    strs_push(l, "")
    strs_push(l, "/// A new vector holding `xs` sorted by `less`, which says whether its first argument sorts before")
    strs_push(l, "/// its second. Stable: elements `less` holds neither way keep their order. A bottom-up merge")
    strs_push(l, "/// sort — at most `n log n` calls of `less` — doing exactly what `less` does, so it is")
    strs_push(l, "/// polymorphic in its effects. `xs` is unchanged.")
    strs_push(l, "pub fn vec_sort_by[T, effects E](xs: Vec[T], less: fn(T, T) -> Bool ! { E }) -> Vec[T] ! { E } {")
    strs_push(l, "    let n = vec_len(xs);")
    strs_push(l, "    let mut src = vec_new[T]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n { vec_push(src, vec_get(xs, i)); i = i + 1; }")
    strs_push(l, "    let mut width = 1;")
    strs_push(l, "    while width < n {")
    strs_push(l, "        let dst = vec_new[T]();")
    strs_push(l, "        let mut lo = 0;")
    strs_push(l, "        while lo < n {")
    strs_push(l, "            let mid = if lo + width < n { lo + width } else { n };")
    strs_push(l, "            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };")
    strs_push(l, "            let mut a = lo;")
    strs_push(l, "            let mut b = mid;")
    strs_push(l, "            while a < mid || b < hi {")
    strs_push(l, "                // The left run's element goes first unless the right one sorts strictly before it.")
    strs_push(l, "                let left = if a < mid { if b < hi { !less(vec_get(src, b), vec_get(src, a)) } else { true } } else { false };")
    strs_push(l, "                if left { vec_push(dst, vec_get(src, a)); a = a + 1; } else { vec_push(dst, vec_get(src, b)); b = b + 1; }")
    strs_push(l, "            }")
    strs_push(l, "            lo = hi;")
    strs_push(l, "        }")
    strs_push(l, "        src = dst;")
    strs_push(l, "        width = width * 2;")
    strs_push(l, "    }")
    strs_push(l, "    src")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The entries of `m` as `(key, value)` pairs ordered by `less`, which says whether its first")
    strs_push(l, "/// argument sorts before its second (R1.5, D10): `counts.sort_by(|a, b| a.1 > b.1)` is a count's")
    strs_push(l, "/// entries, most first. Stable over the map's table order, and as `vec_sort_by` in its calls of")
    strs_push(l, "/// `less` and its effects. `m` is unchanged.")
    strs_push(l, "pub fn hashmap_sort_by[K: Hash, V, effects E](m: HashMap[K, V], less: fn((K, V), (K, V)) -> Bool ! { E }) -> Vec[(K, V)] ! { E } {")
    strs_push(l, "    let keys = hashmap_keys(m);")
    strs_push(l, "    let values = hashmap_values(m);")
    strs_push(l, "    let entries = vec_new[(K, V)]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < vec_len(keys) { vec_push(entries, (vec_get(keys, i), vec_get(values, i))); i = i + 1; }")
    strs_push(l, "    vec_sort_by(entries, less)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new sequence holding `xs` in ascending order.")
    strs_push(l, "pub fn ints_sort(xs: Ints) -> Ints ! {} {")
    strs_push(l, "    let v = vec_new[Int]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < ints_len(xs) { vec_push(v, ints_get(xs, i)); i = i + 1; }")
    strs_push(l, "    let sorted = vec_sort_by(v, fn(a: Int, b: Int) -> Bool { a < b });")
    strs_push(l, "    let out = ints_new();")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < vec_len(sorted) { ints_push(out, vec_get(sorted, i)); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A new sequence holding `xs` in ascending byte order, a prefix first.")
    strs_push(l, "pub fn strs_sort(xs: Strs) -> Strs ! {} {")
    strs_push(l, "    let v = vec_new[Str]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(xs) { vec_push(v, strs_get(xs, i)); i = i + 1; }")
    strs_push(l, "    let sorted = vec_sort_by(v, fn(a: Str, b: Str) -> Bool { str_before(a, b) });")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < vec_len(sorted) { strs_push(out, vec_get(sorted, i)); i = i + 1; }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Sort `xs` itself by `less`, as `vec_sort_by` orders it, and return `0`: every handle to `xs`")
    strs_push(l, "/// sees the new order. Stable — elements `less` holds neither way keep their order — and at most")
    strs_push(l, "/// `O(n log n)` calls of `less`: runs of sixteen by insertion, then merged bottom-up between `xs`")
    strs_push(l, "/// and one scratch vector of its length. Polymorphic in `less`'s effects, as `vec_sort_by` is.")
    strs_push(l, "pub fn vec_sort_in_place_by[T, effects E](xs: Vec[T], less: fn(T, T) -> Bool ! { E }) -> Int ! { E } {")
    strs_push(l, "    let n = vec_len(xs);")
    strs_push(l, "    // Insertion sort within each run: an element moves left only past ones it sorts strictly before.")
    strs_push(l, "    let mut lo = 0;")
    strs_push(l, "    while lo < n {")
    strs_push(l, "        let hi = if lo + 16 < n { lo + 16 } else { n };")
    strs_push(l, "        let mut i = lo + 1;")
    strs_push(l, "        while i < hi {")
    strs_push(l, "            let x = vec_get(xs, i);")
    strs_push(l, "            let mut j = i;")
    strs_push(l, "            while j > lo && less(x, vec_get(xs, j - 1)) {")
    strs_push(l, "                vec_set(xs, j, vec_get(xs, j - 1));")
    strs_push(l, "                j = j - 1;")
    strs_push(l, "            }")
    strs_push(l, "            vec_set(xs, j, x);")
    strs_push(l, "            i = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        lo = hi;")
    strs_push(l, "    }")
    strs_push(l, "    if n > 16 {")
    strs_push(l, "        let scratch = vec_new[T]();")
    strs_push(l, "        let mut k = 0;")
    strs_push(l, "        while k < n { vec_push(scratch, vec_get(xs, k)); k = k + 1; }")
    strs_push(l, "        let mut src = xs;")
    strs_push(l, "        let mut dst = scratch;")
    strs_push(l, "        let mut in_xs = true;")
    strs_push(l, "        let mut width = 16;")
    strs_push(l, "        while width < n {")
    strs_push(l, "            let mut at = 0;")
    strs_push(l, "            while at < n {")
    strs_push(l, "                let mid = if at + width < n { at + width } else { n };")
    strs_push(l, "                let hi = if at + 2 * width < n { at + 2 * width } else { n };")
    strs_push(l, "                let mut a = at;")
    strs_push(l, "                let mut b = mid;")
    strs_push(l, "                let mut o = at;")
    strs_push(l, "                while o < hi {")
    strs_push(l, "                    // The left run's element goes first unless the right one sorts strictly before it.")
    strs_push(l, "                    let from_a = if a < mid { if b < hi { !less(vec_get(src, b), vec_get(src, a)) } else { true } } else { false };")
    strs_push(l, "                    if from_a { vec_set(dst, o, vec_get(src, a)); a = a + 1; } else { vec_set(dst, o, vec_get(src, b)); b = b + 1; }")
    strs_push(l, "                    o = o + 1;")
    strs_push(l, "                }")
    strs_push(l, "                at = hi;")
    strs_push(l, "            }")
    strs_push(l, "            let t = src;")
    strs_push(l, "            src = dst;")
    strs_push(l, "            dst = t;")
    strs_push(l, "            in_xs = !in_xs;")
    strs_push(l, "            width = width * 2;")
    strs_push(l, "        }")
    strs_push(l, "        if !in_xs {")
    strs_push(l, "            k = 0;")
    strs_push(l, "            while k < n { vec_set(xs, k, vec_get(scratch, k)); k = k + 1; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Sort `xs` itself into ascending order, and return `0`.")
    strs_push(l, "pub fn ints_sort_in_place(xs: Ints) -> Int ! {} {")
    strs_push(l, "    let v = vec_new[Int]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < ints_len(xs) { vec_push(v, ints_get(xs, i)); i = i + 1; }")
    strs_push(l, "    vec_sort_in_place_by(v, fn(a: Int, b: Int) -> Bool { a < b });")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < ints_len(xs) { ints_set(xs, i, vec_get(v, i)); i = i + 1; }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Sort `xs` itself into ascending byte order, a prefix first, and return `0`.")
    strs_push(l, "pub fn strs_sort_in_place(xs: Strs) -> Int ! {} {")
    strs_push(l, "    let v = vec_new[Str]();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(xs) { vec_push(v, strs_get(xs, i)); i = i + 1; }")
    strs_push(l, "    vec_sort_in_place_by(v, fn(a: Str, b: Str) -> Bool { str_before(a, b) });")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < strs_len(xs) { strs_set(xs, i, vec_get(v, i)); i = i + 1; }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Whether `a` sorts strictly before `b`, byte by byte, a prefix first.")
    strs_push(l, "fn str_before(a: Str, b: Str) -> Bool ! {} {")
    strs_push(l, "    let n = str_len(a);")
    strs_push(l, "    let m = str_len(b);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut r = 0;")
    strs_push(l, "    while r == 0 {")
    strs_push(l, "        if i == n { r = if i == m { 2 } else { 1 }; } else {")
    strs_push(l, "            if i == m { r = 2; } else {")
    strs_push(l, "                let x = str_byte(a, i);")
    strs_push(l, "                let y = str_byte(b, i);")
    strs_push(l, "                if x < y { r = 1; } else { if x > y { r = 2; } else { i = i + 1; } }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    r == 1")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_test() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/test`: expectations for tests, each a `Result` naming what differed.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/test\";`. A test written with these returns its first failure as a")
    strs_push(l, "// value with `?`, and says what was expected and what was found; nothing here traps or prints.")
    strs_push(l, "")
    strs_push(l, "use \"@std/random\";")
    strs_push(l, "")
    strs_push(l, "/// `Ok(actual)` when `actual` is `expected`, or an `Err` naming `what` and both values.")
    strs_push(l, "pub fn test_int(what: Str, actual: Int, expected: Int) -> Result[Int, Str] ! {} {")
    strs_push(l, "    if actual == expected { Result[Int, Str].Ok(value: actual) } else {")
    strs_push(l, "        let parts = strs_new();")
    strs_push(l, "        strs_push(parts, what); strs_push(parts, \": expected \"); strs_push(parts, int_to_str(expected));")
    strs_push(l, "        strs_push(parts, \", found \"); strs_push(parts, int_to_str(actual));")
    strs_push(l, "        Result[Int, Str].Err(error: str_join(parts, \"\"))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `Ok(actual)` when `actual` is `expected`, or an `Err` naming `what` and both values.")
    strs_push(l, "pub fn test_str(what: Str, actual: Str, expected: Str) -> Result[Str, Str] ! {} {")
    strs_push(l, "    if actual == expected { Result[Str, Str].Ok(value: actual) } else {")
    strs_push(l, "        let parts = strs_new();")
    strs_push(l, "        strs_push(parts, what); strs_push(parts, \": expected \\\"\"); strs_push(parts, expected);")
    strs_push(l, "        strs_push(parts, \"\\\", found \\\"\"); strs_push(parts, actual); strs_push(parts, \"\\\"\");")
    strs_push(l, "        Result[Str, Str].Err(error: str_join(parts, \"\"))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `Ok(true)` when `cond` holds, or an `Err` naming `what`.")
    strs_push(l, "pub fn test_true(what: Str, cond: Bool) -> Result[Bool, Str] ! {} {")
    strs_push(l, "    if cond { Result[Bool, Str].Ok(value: true) } else { Result[Bool, Str].Err(error: str_concat(what, \": expected true\")) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Gate 2 (§18): what a `@test` function returns is a `Result[Int, Str]`, so each assertion")
    strs_push(l, "// below answers one, written with `?` — the first failure ends the test and names itself.")
    strs_push(l, "")
    strs_push(l, "/// `Ok(0)` when `cond` holds, or an `Err` naming `what`.")
    strs_push(l, "pub fn assert_true(what: Str, cond: Bool) -> Result[Int, Str] ! {} {")
    strs_push(l, "    if cond { Result[Int, Str].Ok(value: 0) } else { Result[Int, Str].Err(error: str_concat(what, \": expected true\")) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `Ok(actual)` when `actual` is `expected`, or an `Err` naming `what` and both values.")
    strs_push(l, "pub fn assert_eq_int(what: Str, actual: Int, expected: Int) -> Result[Int, Str] ! {} {")
    strs_push(l, "    test_int(what, actual, expected)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `Ok(0)` when `actual` is `expected`, or an `Err` naming `what` and both values.")
    strs_push(l, "pub fn assert_eq_str(what: Str, actual: Str, expected: Str) -> Result[Int, Str] ! {} {")
    strs_push(l, "    match test_str(what, actual, expected) {")
    strs_push(l, "        Result.Ok(value: v) => Result[Int, Str].Ok(value: 0),")
    strs_push(l, "        Result.Err(error: e) => Result[Int, Str].Err(error: e),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value inside `o`, or an `Err` naming `what` when there is none.")
    strs_push(l, "pub fn assert_some[T](what: Str, o: Option[T]) -> Result[T, Str] ! {} {")
    strs_push(l, "    match o {")
    strs_push(l, "        Option.Some(value: v) => Result[T, Str].Ok(value: v),")
    strs_push(l, "        Option.None() => Result[T, Str].Err(error: str_concat(what, \": expected a value, found none\")),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value inside `r`, or an `Err` naming `what` and `r`'s own error.")
    strs_push(l, "pub fn assert_ok[T](what: Str, r: Result[T, Str]) -> Result[T, Str] ! {} {")
    strs_push(l, "    match r {")
    strs_push(l, "        Result.Ok(value: v) => Result[T, Str].Ok(value: v),")
    strs_push(l, "        Result.Err(error: e) => Result[T, Str].Err(error: str_concat(str_concat(what, \": \"), e)),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `check` on `cases` cases, every one drawing from one generator seeded with `seed`: `Ok(cases)`,")
    strs_push(l, "/// or the first `Err`, naming its case. The same seed checks the same cases in every")
    strs_push(l, "/// implementation and run, so a failure found is a failure kept.")
    strs_push(l, "pub fn property[effects E](seed: UInt64, cases: Int, check: fn(Rng) -> Result[Int, Str] ! { E }) -> Result[Int, Str] ! { E } {")
    strs_push(l, "    let r = random_new(seed);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < cases {")
    strs_push(l, "        match check(r) {")
    strs_push(l, "            Result.Ok(value: v) => 0,")
    strs_push(l, "            Result.Err(error: e) => {")
    strs_push(l, "                return Result[Int, Str].Err(error: str_concat(str_concat(str_concat(\"case \", int_to_str(i)), \": \"), e));")
    strs_push(l, "            },")
    strs_push(l, "        };")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Int, Str].Ok(value: cases)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_text() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/text`: operations on byte strings, written in Nazm over the string built-ins.")
    strs_push(l, "//")
    strs_push(l, "// Ordinary source, checked like any module; imported with `use \"@std/text\";`. Every function")
    strs_push(l, "// is pure (`! {}`) and total: none can fail except by allocating, and a malformed input is an")
    strs_push(l, "// `Err` or a `None`, never a trap. `docs/user/spec.md`, *The standard library*, owns the rules.")
    strs_push(l, "")
    strs_push(l, "/// Whether `s` begins with `prefix`. Every string begins with `\"\"`.")
    strs_push(l, "pub fn text_starts_with(s: Str, prefix: Str) -> Bool ! {} {")
    strs_push(l, "    let n = str_len(prefix);")
    strs_push(l, "    if n > str_len(s) { false } else { str_slice(s, 0, n) == prefix }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `s` ends with `suffix`. Every string ends with `\"\"`.")
    strs_push(l, "pub fn text_ends_with(s: Str, suffix: Str) -> Bool ! {} {")
    strs_push(l, "    let n = str_len(suffix);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    if n > m { false } else { str_slice(s, m - n, m) == suffix }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The byte offset of the first occurrence of `needle` in `s`, or `None`. `\"\"` occurs at 0.")
    strs_push(l, "pub fn text_find(s: Str, needle: Str) -> Option[Int] ! {} {")
    strs_push(l, "    let n = str_len(needle);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    // -1 while searching, -2 once every position has been tried, the offset once found.")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    while found == 0 - 1 {")
    strs_push(l, "        if i + n > m {")
    strs_push(l, "            found = 0 - 2;")
    strs_push(l, "        } else {")
    strs_push(l, "            if str_slice(s, i, i + n) == needle { found = i; } else { i = i + 1; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if found < 0 { Option[Int].None() } else { Option[Int].Some(value: found) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `needle` occurs in `s`.")
    strs_push(l, "pub fn text_contains(s: Str, needle: Str) -> Bool ! {} {")
    strs_push(l, "    match text_find(s, needle) {")
    strs_push(l, "        Option.Some(value: at) => true,")
    strs_push(l, "        Option.None() => false,")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` repeated `n` times; `\"\"` when `n` is zero or negative.")
    strs_push(l, "pub fn text_repeat(s: Str, n: Int) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n { strs_push(parts, s); i = i + 1; }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Where the piece of `s` that starts at `from` ends: at the next `sep` at or after `from`, or at")
    strs_push(l, "/// the end of `s` — as `text_split` finds it. With `text_split_next`, what `for w in s.split(sep)`")
    strs_push(l, "/// reads its pieces through, so the loop builds no list (R1.5, 3.3).")
    strs_push(l, "pub fn text_split_end(s: Str, sep: Str, from: Int) -> Int ! {} {")
    strs_push(l, "    let n = str_len(sep);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    if n == 0 {")
    strs_push(l, "        m")
    strs_push(l, "    } else {")
    strs_push(l, "        let first = str_byte(sep, 0);")
    strs_push(l, "        let mut i = from;")
    strs_push(l, "        if n == 1 {")
    strs_push(l, "            // One byte: the tightest loop, whose only check each step is `i < m`.")
    strs_push(l, "            while i < m && str_byte(s, i) != first { i = i + 1; }")
    strs_push(l, "            i")
    strs_push(l, "        } else {")
    strs_push(l, "            // Compared byte by byte where the first byte matches, not as a slice: the function")
    strs_push(l, "            // then calls nothing, so the one-byte loop above runs without a frame to save.")
    strs_push(l, "            let mut found = m;")
    strs_push(l, "            while i + n <= m && found == m {")
    strs_push(l, "                if str_byte(s, i) == first {")
    strs_push(l, "                    let mut j = 1;")
    strs_push(l, "                    while j < n && str_byte(s, i + j) == str_byte(sep, j) { j = j + 1; }")
    strs_push(l, "                    if j == n { found = i; } else { i = i + 1; }")
    strs_push(l, "                } else {")
    strs_push(l, "                    i = i + 1;")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "            found")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Where the piece after one ending at `end` begins: past the separator there, or one past the")
    strs_push(l, "/// end of `s` when that piece was the last (R1.5, 3.3).")
    strs_push(l, "pub fn text_split_next(s: Str, sep: Str, end: Int) -> Int ! {} {")
    strs_push(l, "    let n = str_len(sep);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    if n > 0 && end < m { end + n } else { m + 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The pieces of `s` between occurrences of `sep`, in order. `sep` must not be `\"\"`; if it is,")
    strs_push(l, "/// the whole of `s` is the one piece. `text_split(\"a,,b\", \",\")` is `a`, ``, `b`.")
    strs_push(l, "pub fn text_split(s: Str, sep: Str) -> Strs ! {} {")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let n = str_len(sep);")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    if n == 0 {")
    strs_push(l, "        strs_push(out, s);")
    strs_push(l, "    } else {")
    strs_push(l, "        // A position is compared as a slice only where its first byte is the separator's, so")
    strs_push(l, "        // nothing is made for the rest (R1, 5b.9).")
    strs_push(l, "        let first = str_byte(sep, 0);")
    strs_push(l, "        let mut start = 0;")
    strs_push(l, "        let mut i = 0;")
    strs_push(l, "        while i + n <= m {")
    strs_push(l, "            if str_byte(s, i) == first && (n == 1 || str_slice(s, i, i + n) == sep) {")
    strs_push(l, "                strs_push(out, str_slice(s, start, i));")
    strs_push(l, "                i = i + n;")
    strs_push(l, "                start = i;")
    strs_push(l, "            } else {")
    strs_push(l, "                i = i + 1;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        strs_push(out, str_slice(s, start, m));")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the byte `b` is ASCII whitespace: space, tab, newline, carriage return, form feed")
    strs_push(l, "/// or vertical tab.")
    strs_push(l, "pub fn text_is_space(b: Int) -> Bool ! {} {")
    strs_push(l, "    // Space is 32; tab, newline, vertical tab, form feed and carriage return are 9 to 13.")
    strs_push(l, "    if b == 32 { true } else { if b < 9 { false } else { b <= 13 } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` without its leading and trailing ASCII whitespace.")
    strs_push(l, "pub fn text_trim(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut a = 0;")
    strs_push(l, "    let mut b = str_len(s);")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        if a == b { more = false; } else { if text_is_space(str_byte(s, a)) { a = a + 1; } else { more = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        if b == a { more = false; } else { if text_is_space(str_byte(s, b - 1)) { b = b - 1; } else { more = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    str_slice(s, a, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The decimal integer `s` spells: an optional `-` or `+`, then one or more ASCII digits, and")
    strs_push(l, "/// nothing else. A value outside `Int`'s range is an `Err`, not an overflow.")
    strs_push(l, "pub fn text_parse_int(s: Str) -> Result[Int, Str] ! {} {")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut negative = false;")
    strs_push(l, "    if m > 0 {")
    strs_push(l, "        if str_byte(s, 0) == 45 { negative = true; i = 1; } else { if str_byte(s, 0) == 43 { i = 1; } }")
    strs_push(l, "    }")
    strs_push(l, "    if i == m {")
    strs_push(l, "        Result[Int, Str].Err(error: \"no digits\")")
    strs_push(l, "    } else {")
    strs_push(l, "        // Accumulated as a negative number, whose range is one larger, so `Int`'s minimum")
    strs_push(l, "        // parses; every step is checked against the limit before it is taken.")
    strs_push(l, "        let limit = 0 - 922337203685477580;")
    strs_push(l, "        let mut acc = 0;")
    strs_push(l, "        let mut bad = \"\";")
    strs_push(l, "        while i < m {")
    strs_push(l, "            let d = str_byte(s, i) - 48;")
    strs_push(l, "            if d < 0 {")
    strs_push(l, "                bad = \"not a digit\";")
    strs_push(l, "                i = m;")
    strs_push(l, "            } else {")
    strs_push(l, "                if d > 9 {")
    strs_push(l, "                    bad = \"not a digit\";")
    strs_push(l, "                    i = m;")
    strs_push(l, "                } else {")
    strs_push(l, "                    let over = if acc < limit { true } else { if acc == limit { d > 8 } else { false } };")
    strs_push(l, "                    if over { bad = \"out of range\"; i = m; } else { acc = acc * 10 - d; i = i + 1; }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        if str_len(bad) > 0 {")
    strs_push(l, "            Result[Int, Str].Err(error: bad)")
    strs_push(l, "        } else {")
    strs_push(l, "            if negative {")
    strs_push(l, "                Result[Int, Str].Ok(value: acc)")
    strs_push(l, "            } else {")
    strs_push(l, "                if acc == limit * 10 - 8 { Result[Int, Str].Err(error: \"out of range\") } else { Result[Int, Str].Ok(value: 0 - acc) }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` without its leading ASCII whitespace.")
    strs_push(l, "pub fn text_trim_start(s: Str) -> Str ! {} {")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    let mut a = 0;")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        if a == m { more = false; } else { if text_is_space(str_byte(s, a)) { a = a + 1; } else { more = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    str_slice(s, a, m)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` without its trailing ASCII whitespace.")
    strs_push(l, "pub fn text_trim_end(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut b = str_len(s);")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more {")
    strs_push(l, "        if b == 0 { more = false; } else { if text_is_space(str_byte(s, b - 1)) { b = b - 1; } else { more = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    str_slice(s, 0, b)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the byte `b` is an ASCII digit, `0` to `9`.")
    strs_push(l, "pub fn text_is_digit(b: Int) -> Bool ! {} {")
    strs_push(l, "    if b < 48 { false } else { b <= 57 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the byte `b` is an ASCII letter.")
    strs_push(l, "pub fn text_is_alpha(b: Int) -> Bool ! {} {")
    strs_push(l, "    if b < 65 { false } else { if b <= 90 { true } else { if b < 97 { false } else { b <= 122 } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with every ASCII lower-case letter made upper-case; every other byte unchanged.")
    strs_push(l, "pub fn text_to_upper(s: Str) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let up = if b < 97 { b } else { if b > 122 { b } else { b - 32 } };")
    strs_push(l, "        strs_push(parts, str_from_byte(up));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with every ASCII upper-case letter made lower-case; every other byte unchanged.")
    strs_push(l, "pub fn text_to_lower(s: Str) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let down = if b < 65 { b } else { if b > 90 { b } else { b + 32 } };")
    strs_push(l, "        strs_push(parts, str_from_byte(down));")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with every occurrence of `from` replaced by `to`, left to right, without overlap. `from`")
    strs_push(l, "/// must not be `\"\"`; if it is, `s` is returned unchanged.")
    strs_push(l, "pub fn text_replace(s: Str, from: Str, to: Str) -> Str ! {} {")
    strs_push(l, "    if str_len(from) == 0 { s } else { str_join(text_split(s, from), to) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// How many times `needle` occurs in `s`, without overlap. `\"\"` occurs no times.")
    strs_push(l, "pub fn text_count(s: Str, needle: Str) -> Int ! {} {")
    strs_push(l, "    if str_len(needle) == 0 { 0 } else { strs_len(text_split(s, needle)) - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with `fill`'s first byte added in front until it is `width` bytes long; unchanged when it")
    strs_push(l, "/// is already as long, or `fill` is `\"\"`.")
    strs_push(l, "pub fn text_pad_left(s: Str, width: Int, fill: Str) -> Str ! {} {")
    strs_push(l, "    let short = width - str_len(s);")
    strs_push(l, "    if short <= 0 { s } else { if str_len(fill) == 0 { s } else { str_concat(text_repeat(str_slice(fill, 0, 1), short), s) } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` with `fill`'s first byte added after it until it is `width` bytes long; unchanged when it")
    strs_push(l, "/// is already as long, or `fill` is `\"\"`.")
    strs_push(l, "pub fn text_pad_right(s: Str, width: Int, fill: Str) -> Str ! {} {")
    strs_push(l, "    let short = width - str_len(s);")
    strs_push(l, "    if short <= 0 { s } else { if str_len(fill) == 0 { s } else { str_concat(s, text_repeat(str_slice(fill, 0, 1), short)) } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The lines of `s`: split at each `\\n`, a `\\r` before it removed, and no empty last line for a")
    strs_push(l, "/// final newline. `\"\"` has no lines.")
    strs_push(l, "pub fn text_lines(s: Str) -> Strs ! {} {")
    strs_push(l, "    // One pass over the bytes (R1, 5b.9): each line a slice of `s`, its `\\r` left off.")
    strs_push(l, "    let out = strs_new();")
    strs_push(l, "    let m = str_len(s);")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < m {")
    strs_push(l, "        if str_byte(s, i) == 10 {")
    strs_push(l, "            strs_push(out, line_of(s, start, i));")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    if start < m {")
    strs_push(l, "        strs_push(out, line_of(s, start, m));")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` from `start` to `end`, without one `\\r` before `end`.")
    strs_push(l, "fn line_of(s: Str, start: Int, end: Int) -> Str ! {} {")
    strs_push(l, "    if end > start && str_byte(s, end - 1) == 13 {")
    strs_push(l, "        str_slice(s, start, end - 1)")
    strs_push(l, "    } else {")
    strs_push(l, "        str_slice(s, start, end)")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `-1`, `0` or `1` as `a` sorts before, with or after `b`, byte by byte; a prefix sorts first.")
    strs_push(l, "pub fn text_compare(a: Str, b: Str) -> Int ! {} {")
    strs_push(l, "    let n = str_len(a);")
    strs_push(l, "    let m = str_len(b);")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    let mut r = 0;")
    strs_push(l, "    while r == 0 {")
    strs_push(l, "        if i == n {")
    strs_push(l, "            r = if i == m { 2 } else { 0 - 1 };")
    strs_push(l, "        } else {")
    strs_push(l, "            if i == m {")
    strs_push(l, "                r = 1;")
    strs_push(l, "            } else {")
    strs_push(l, "                let x = str_byte(a, i);")
    strs_push(l, "                let y = str_byte(b, i);")
    strs_push(l, "                if x < y { r = 0 - 1; } else { if x > y { r = 1; } else { i = i + 1; } }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if r == 2 { 0 } else { r }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_time() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/time`: a monotonic clock, in milliseconds, under a `TimeCap`.")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/time\";`. Reading a clock makes a program's behaviour depend on when it")
    strs_push(l, "// runs, so every function here takes the `TimeCap` that allows it, and `critical`'s")
    strs_push(l, "// `no-ambient-time` refuses them all. None performs an effect.")
    strs_push(l, "")
    strs_push(l, "/// The clock now, in milliseconds since an unspecified start.")
    strs_push(l, "pub fn time_ms(t: TimeCap) -> Int ! {} {")
    strs_push(l, "    time_now_ms()")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The milliseconds since `start`, a reading of `time_ms`.")
    strs_push(l, "pub fn time_since(t: TimeCap, start: Int) -> Int ! {} {")
    strs_push(l, "    time_now_ms() - start")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The reading `ms` milliseconds from now, for `time_passed`.")
    strs_push(l, "pub fn time_deadline(t: TimeCap, ms: Int) -> Int ! {} {")
    strs_push(l, "    time_now_ms() + ms")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the clock has reached `deadline`, a reading of `time_deadline`.")
    strs_push(l, "pub fn time_passed(t: TimeCap, deadline: Int) -> Bool ! {} {")
    strs_push(l, "    time_now_ms() >= deadline")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Gate 2 (`docs/internal/general-purpose.md` §11): nanoseconds, typed. A `Duration` is a span, an `Instant`")
    strs_push(l, "// a reading of the monotonic clock — comparable only with another reading in the same run — and a")
    strs_push(l, "// `WallTime` the wall clock, which may jump.")
    strs_push(l, "")
    strs_push(l, "/// A span of time, in nanoseconds.")
    strs_push(l, "pub struct Duration {")
    strs_push(l, "    nanos: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A reading of the monotonic clock, in nanoseconds since an unspecified start.")
    strs_push(l, "pub struct Instant {")
    strs_push(l, "    nanos: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A reading of the wall clock, in nanoseconds since the Unix epoch.")
    strs_push(l, "pub struct WallTime {")
    strs_push(l, "    unix_nanos: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `ms` milliseconds.")
    strs_push(l, "pub fn time_duration_ms(ms: Int) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: ms * 1000000)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `ns` nanoseconds.")
    strs_push(l, "pub fn time_duration_ns(ns: Int) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: ns)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `d` in whole milliseconds, rounded toward zero.")
    strs_push(l, "pub fn time_duration_to_ms(d: Duration) -> Int ! {} {")
    strs_push(l, "    d.nanos / 1000000")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The two spans, one after the other.")
    strs_push(l, "pub fn time_duration_add(a: Duration, b: Duration) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: a.nanos + b.nanos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The monotonic clock now.")
    strs_push(l, "pub fn time_now(t: TimeCap) -> Instant ! {} {")
    strs_push(l, "    Instant(nanos: time_now_ns())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The span from `since`, a reading of `time_now`, to now.")
    strs_push(l, "pub fn time_elapsed(t: TimeCap, since: Instant) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: time_now_ns() - since.nanos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The reading `d` from now: a deadline.")
    strs_push(l, "pub fn time_after(t: TimeCap, d: Duration) -> Instant ! {} {")
    strs_push(l, "    Instant(nanos: time_now_ns() + d.nanos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether the clock has reached `at`.")
    strs_push(l, "pub fn time_reached(t: TimeCap, at: Instant) -> Bool ! {} {")
    strs_push(l, "    time_now_ns() >= at.nanos")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The span from `a` to `b`, two readings of the monotonic clock.")
    strs_push(l, "pub fn time_between(a: Instant, b: Instant) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: b.nanos - a.nanos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The wall clock now.")
    strs_push(l, "pub fn time_wall(t: TimeCap) -> WallTime ! {} {")
    strs_push(l, "    WallTime(unix_nanos: time_wall_ns())")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Wait `d`: on the task pool the task parks and its worker runs others.")
    strs_push(l, "pub fn time_sleep(t: TimeCap, d: Duration) -> Int ! {} {")
    strs_push(l, "    time_sleep_ms(d.nanos / 1000000)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// v1 track C, C4 (`docs/user/spec.md`, *Calendar time*): the proleptic Gregorian calendar, UTC and")
    strs_push(l, "// fixed offsets, RFC 3339 text and HTTP's date, and durations as text. All of it is pure")
    strs_push(l, "// arithmetic on values: only `time_wall` reads a clock. There is no time-zone database and no")
    strs_push(l, "// leap second; a `DateTime` is a date, a time of day and the offset from UTC it was written at.")
    strs_push(l, "")
    strs_push(l, "/// A day of the proleptic Gregorian calendar.")
    strs_push(l, "pub struct Date {")
    strs_push(l, "    year: Int,")
    strs_push(l, "    month: Int,")
    strs_push(l, "    day: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A date and a time of day at `offset_minutes` east of UTC (`0`: UTC itself).")
    strs_push(l, "pub struct DateTime {")
    strs_push(l, "    year: Int,")
    strs_push(l, "    month: Int,")
    strs_push(l, "    day: Int,")
    strs_push(l, "    hour: Int,")
    strs_push(l, "    minute: Int,")
    strs_push(l, "    second: Int,")
    strs_push(l, "    nanos: Int,")
    strs_push(l, "    offset_minutes: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// `a / b` rounded toward negative infinity, `b` above zero.")
    strs_push(l, "fn floor_div(a: Int, b: Int) -> Int ! {} {")
    strs_push(l, "    let q = a / b;")
    strs_push(l, "    if a % b != 0 && a < 0 { q - 1 } else { q }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `year` has a 29 February.")
    strs_push(l, "pub fn time_is_leap_year(year: Int) -> Bool ! {} {")
    strs_push(l, "    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The days in `month` (1–12) of `year`; `0` for a month that is none.")
    strs_push(l, "pub fn time_days_in_month(year: Int, month: Int) -> Int ! {} {")
    strs_push(l, "    if month < 1 || month > 12 { return 0; }")
    strs_push(l, "    if month == 2 { return if time_is_leap_year(year) { 29 } else { 28 }; }")
    strs_push(l, "    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The date, if it is one: a year from 0 to 9999, a month from 1 to 12, a day in that month.")
    strs_push(l, "pub fn time_date(year: Int, month: Int, day: Int) -> Option[Date] ! {} {")
    strs_push(l, "    if year < 0 || year > 9999 || day < 1 || day > time_days_in_month(year, month) { return Option[Date].None(); }")
    strs_push(l, "    Option[Date].Some(value: Date(year: year, month: month, day: day))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The days from 1970-01-01 to `d` (negative before it).")
    strs_push(l, "pub fn time_date_to_days(d: Date) -> Int ! {} {")
    strs_push(l, "    let y = if d.month <= 2 { d.year - 1 } else { d.year };")
    strs_push(l, "    let era = floor_div(y, 400);")
    strs_push(l, "    let yoe = y - era * 400;")
    strs_push(l, "    let mp = if d.month > 2 { d.month - 3 } else { d.month + 9 };")
    strs_push(l, "    let doy = (153 * mp + 2) / 5 + d.day - 1;")
    strs_push(l, "    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;")
    strs_push(l, "    era * 146097 + doe - 719468")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The date `days` after 1970-01-01 (before it, for a negative count).")
    strs_push(l, "pub fn time_date_from_days(days: Int) -> Date ! {} {")
    strs_push(l, "    let z = days + 719468;")
    strs_push(l, "    let era = floor_div(z, 146097);")
    strs_push(l, "    let doe = z - era * 146097;")
    strs_push(l, "    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;")
    strs_push(l, "    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);")
    strs_push(l, "    let mp = (5 * doy + 2) / 153;")
    strs_push(l, "    let day = doy - (153 * mp + 2) / 5 + 1;")
    strs_push(l, "    let month = if mp < 10 { mp + 3 } else { mp - 9 };")
    strs_push(l, "    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };")
    strs_push(l, "    Date(year: year, month: month, day: day)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The day of the week of `d`, ISO 8601's: 1 Monday to 7 Sunday.")
    strs_push(l, "pub fn time_weekday(d: Date) -> Int ! {} {")
    strs_push(l, "    let w = time_date_to_days(d) % 7;")
    strs_push(l, "    (w + 10) % 7 + 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The date `n` days after `d` (before it, for a negative `n`).")
    strs_push(l, "pub fn time_date_add_days(d: Date, n: Int) -> Date ! {} {")
    strs_push(l, "    time_date_from_days(time_date_to_days(d) + n)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The date and time, if each part is in range: `time_date`'s date, an hour to 23, a minute and")
    strs_push(l, "/// a second to 59, nanoseconds to 999 999 999, an offset within ±23:59.")
    strs_push(l, "pub fn time_datetime(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int, nanos: Int, offset_minutes: Int) -> Option[DateTime] ! {} {")
    strs_push(l, "    let ok = match time_date(year, month, day) { Option.Some(value: d) => true, Option.None() => false, };")
    strs_push(l, "    if !ok || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 || nanos < 0 || nanos > 999999999 || offset_minutes < 0 - 1439 || offset_minutes > 1439 {")
    strs_push(l, "        return Option[DateTime].None();")
    strs_push(l, "    }")
    strs_push(l, "    Option[DateTime].Some(value: DateTime(year: year, month: month, day: day, hour: hour, minute: minute, second: second, nanos: nanos, offset_minutes: offset_minutes))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The date `dt` was written at, at its own offset.")
    strs_push(l, "pub fn time_datetime_date(dt: DateTime) -> Date ! {} {")
    strs_push(l, "    Date(year: dt.year, month: dt.month, day: dt.day)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The whole seconds from 1970-01-01T00:00:00Z to `dt`; its `nanos` are the fraction after them.")
    strs_push(l, "pub fn time_unix_seconds(dt: DateTime) -> Int ! {} {")
    strs_push(l, "    let days = time_date_to_days(Date(year: dt.year, month: dt.month, day: dt.day));")
    strs_push(l, "    days * 86400 + dt.hour * 3600 + dt.minute * 60 + dt.second - dt.offset_minutes * 60")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `secs` whole seconds after 1970-01-01T00:00:00Z and `nanos` more, in UTC.")
    strs_push(l, "pub fn time_from_unix(secs: Int, nanos: Int) -> DateTime ! {} {")
    strs_push(l, "    let days = floor_div(secs, 86400);")
    strs_push(l, "    let rest = secs - days * 86400;")
    strs_push(l, "    let d = time_date_from_days(days);")
    strs_push(l, "    DateTime(year: d.year, month: d.month, day: d.day, hour: rest / 3600, minute: rest % 3600 / 60, second: rest % 60, nanos: nanos, offset_minutes: 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The wall-clock reading `w` as a date and time in UTC.")
    strs_push(l, "pub fn time_utc(w: WallTime) -> DateTime ! {} {")
    strs_push(l, "    let secs = floor_div(w.unix_nanos, 1000000000);")
    strs_push(l, "    time_from_unix(secs, w.unix_nanos - secs * 1000000000)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The same instant as `dt`, in UTC.")
    strs_push(l, "pub fn time_to_utc(dt: DateTime) -> DateTime ! {} {")
    strs_push(l, "    time_from_unix(time_unix_seconds(dt), dt.nanos)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The instant `dt` as a wall-clock reading; `None` outside what one holds (about 1677 to 2262).")
    strs_push(l, "pub fn time_to_wall(dt: DateTime) -> Option[WallTime] ! {} {")
    strs_push(l, "    let secs = time_unix_seconds(dt);")
    strs_push(l, "    if secs > 9223372035 || secs < 0 - 9223372036 { return Option[WallTime].None(); }")
    strs_push(l, "    Option[WallTime].Some(value: WallTime(unix_nanos: secs * 1000000000 + dt.nanos))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn digits(n: Int, width: Int) -> Str ! {} {")
    strs_push(l, "    let mut out = int_to_str(n);")
    strs_push(l, "    while str_len(out) < width { out = str_concat(\"0\", out); }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `dt` as RFC 3339 text: `2026-10-16T09:30:00Z`, a fraction only when there are nanoseconds")
    strs_push(l, "/// (without trailing zeros), and the offset as `Z` or `+hh:mm`.")
    strs_push(l, "pub fn time_format_rfc3339(dt: DateTime) -> Str ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, digits(dt.year, 4));")
    strs_push(l, "    strs_push(parts, \"-\");")
    strs_push(l, "    strs_push(parts, digits(dt.month, 2));")
    strs_push(l, "    strs_push(parts, \"-\");")
    strs_push(l, "    strs_push(parts, digits(dt.day, 2));")
    strs_push(l, "    strs_push(parts, \"T\");")
    strs_push(l, "    strs_push(parts, digits(dt.hour, 2));")
    strs_push(l, "    strs_push(parts, \":\");")
    strs_push(l, "    strs_push(parts, digits(dt.minute, 2));")
    strs_push(l, "    strs_push(parts, \":\");")
    strs_push(l, "    strs_push(parts, digits(dt.second, 2));")
    strs_push(l, "    if dt.nanos > 0 {")
    strs_push(l, "        let mut f = digits(dt.nanos, 9);")
    strs_push(l, "        while str_byte(f, str_len(f) - 1) == 48 { f = str_slice(f, 0, str_len(f) - 1); }")
    strs_push(l, "        strs_push(parts, \".\");")
    strs_push(l, "        strs_push(parts, f);")
    strs_push(l, "    }")
    strs_push(l, "    if dt.offset_minutes == 0 {")
    strs_push(l, "        strs_push(parts, \"Z\");")
    strs_push(l, "    } else {")
    strs_push(l, "        let m = if dt.offset_minutes < 0 { 0 - dt.offset_minutes } else { dt.offset_minutes };")
    strs_push(l, "        strs_push(parts, if dt.offset_minutes < 0 { \"-\" } else { \"+\" });")
    strs_push(l, "        strs_push(parts, digits(m / 60, 2));")
    strs_push(l, "        strs_push(parts, \":\");")
    strs_push(l, "        strs_push(parts, digits(m % 60, 2));")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The number in the `n` bytes of `s` from `at`, all of them decimal digits; -1 when it is not.")
    strs_push(l, "fn fixed_digits(s: Str, at: Int, n: Int) -> Int ! {} {")
    strs_push(l, "    if at + n > str_len(s) { return 0 - 1; }")
    strs_push(l, "    let mut v = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < n {")
    strs_push(l, "        let b = str_byte(s, at + i);")
    strs_push(l, "        if b < 48 || b > 57 { return 0 - 1; }")
    strs_push(l, "        v = v * 10 + (b - 48);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    v")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_byte(s: Str, at: Int, b: Int) -> Bool ! {} {")
    strs_push(l, "    at < str_len(s) && str_byte(s, at) == b")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn bad_time(why: Str) -> Result[DateTime, Str] ! {} {")
    strs_push(l, "    Result[DateTime, Str].Err(error: why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// RFC 3339's `date-time` (§5.6): `YYYY-MM-DDTHH:MM:SS`, an optional fraction of one to nine")
    strs_push(l, "/// digits, then `Z` or `±hh:mm`; `t` and `z` may be lower-case. A date that is not one, a field out")
    strs_push(l, "/// of range and a leap second (`:60`, which Unix time has no place for) are an `Err` saying which.")
    strs_push(l, "pub fn time_parse_rfc3339(s: Str) -> Result[DateTime, Str] ! {} {")
    strs_push(l, "    let year = fixed_digits(s, 0, 4);")
    strs_push(l, "    let month = fixed_digits(s, 5, 2);")
    strs_push(l, "    let day = fixed_digits(s, 8, 2);")
    strs_push(l, "    if year < 0 || !is_byte(s, 4, 45) || month < 0 || !is_byte(s, 7, 45) || day < 0 { return bad_time(\"not a full-date, YYYY-MM-DD\"); }")
    strs_push(l, "    if !is_byte(s, 10, 84) && !is_byte(s, 10, 116) { return bad_time(\"no T between the date and the time\"); }")
    strs_push(l, "    let hour = fixed_digits(s, 11, 2);")
    strs_push(l, "    let minute = fixed_digits(s, 14, 2);")
    strs_push(l, "    let second = fixed_digits(s, 17, 2);")
    strs_push(l, "    if hour < 0 || !is_byte(s, 13, 58) || minute < 0 || !is_byte(s, 16, 58) || second < 0 { return bad_time(\"not a partial-time, HH:MM:SS\"); }")
    strs_push(l, "    let mut at = 19;")
    strs_push(l, "    let mut nanos = 0;")
    strs_push(l, "    if is_byte(s, at, 46) {")
    strs_push(l, "        at = at + 1;")
    strs_push(l, "        let mut n = 0;")
    strs_push(l, "        while at < str_len(s) && str_byte(s, at) >= 48 && str_byte(s, at) <= 57 {")
    strs_push(l, "            if n == 9 { return bad_time(\"more than nine fractional digits\"); }")
    strs_push(l, "            nanos = nanos * 10 + (str_byte(s, at) - 48);")
    strs_push(l, "            n = n + 1;")
    strs_push(l, "            at = at + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if n == 0 { return bad_time(\"a fraction without digits\"); }")
    strs_push(l, "        while n < 9 { nanos = nanos * 10; n = n + 1; }")
    strs_push(l, "    }")
    strs_push(l, "    let mut offset = 0;")
    strs_push(l, "    if is_byte(s, at, 90) || is_byte(s, at, 122) {")
    strs_push(l, "        at = at + 1;")
    strs_push(l, "    } else {")
    strs_push(l, "        if !is_byte(s, at, 43) && !is_byte(s, at, 45) { return bad_time(\"no offset, Z or +hh:mm\"); }")
    strs_push(l, "        let oh = fixed_digits(s, at + 1, 2);")
    strs_push(l, "        let om = fixed_digits(s, at + 4, 2);")
    strs_push(l, "        if oh < 0 || !is_byte(s, at + 3, 58) || om < 0 { return bad_time(\"an offset that is not +hh:mm\"); }")
    strs_push(l, "        if oh > 23 || om > 59 { return bad_time(\"an offset out of range\"); }")
    strs_push(l, "        offset = if str_byte(s, at) == 45 { 0 - (oh * 60 + om) } else { oh * 60 + om };")
    strs_push(l, "        at = at + 6;")
    strs_push(l, "    }")
    strs_push(l, "    if at != str_len(s) { return bad_time(\"text after the date-time\"); }")
    strs_push(l, "    if second == 60 { return bad_time(\"a leap second\"); }")
    strs_push(l, "    match time_datetime(year, month, day, hour, minute, second, nanos, offset) {")
    strs_push(l, "        Option.Some(value: dt) => Result[DateTime, Str].Ok(value: dt),")
    strs_push(l, "        Option.None() => bad_time(\"a date or time out of range\"),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn name_of(names: Str, i: Int) -> Str ! {} {")
    strs_push(l, "    str_slice(names, i * 3, i * 3 + 3)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `dt` as HTTP's date (RFC 9110 §5.6.7, IMF-fixdate), in GMT: `Fri, 16 Oct 2026 09:30:00 GMT`.")
    strs_push(l, "pub fn time_format_http(dt: DateTime) -> Str ! {} {")
    strs_push(l, "    let u = time_to_utc(dt);")
    strs_push(l, "    let d = Date(year: u.year, month: u.month, day: u.day);")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, name_of(\"MonTueWedThuFriSatSun\", time_weekday(d) - 1));")
    strs_push(l, "    strs_push(parts, \", \");")
    strs_push(l, "    strs_push(parts, digits(u.day, 2));")
    strs_push(l, "    strs_push(parts, \" \");")
    strs_push(l, "    strs_push(parts, name_of(\"JanFebMarAprMayJunJulAugSepOctNovDec\", u.month - 1));")
    strs_push(l, "    strs_push(parts, \" \");")
    strs_push(l, "    strs_push(parts, digits(u.year, 4));")
    strs_push(l, "    strs_push(parts, \" \");")
    strs_push(l, "    strs_push(parts, digits(u.hour, 2));")
    strs_push(l, "    strs_push(parts, \":\");")
    strs_push(l, "    strs_push(parts, digits(u.minute, 2));")
    strs_push(l, "    strs_push(parts, \":\");")
    strs_push(l, "    strs_push(parts, digits(u.second, 2));")
    strs_push(l, "    strs_push(parts, \" GMT\");")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `s` seconds.")
    strs_push(l, "pub fn time_duration_secs(s: Int) -> Duration ! {} {")
    strs_push(l, "    Duration(nanos: s * 1000000000)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn unit_nanos(u: Str) -> Int ! {} {")
    strs_push(l, "    if u == \"ns\" { return 1; }")
    strs_push(l, "    if u == \"us\" { return 1000; }")
    strs_push(l, "    if u == \"ms\" { return 1000000; }")
    strs_push(l, "    if u == \"s\" { return 1000000000; }")
    strs_push(l, "    if u == \"m\" { return 60000000000; }")
    strs_push(l, "    if u == \"h\" { return 3600000000000; }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn bad_duration(why: Str) -> Result[Duration, Str] ! {} {")
    strs_push(l, "    Result[Duration, Str].Err(error: why)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A duration written as whole numbers with units: `250ms`, `1h30m`, `-2s`, `0`. The units are")
    strs_push(l, "/// `h`, `m`, `s`, `ms`, `us` and `ns`; anything else, a number without a unit (but a lone `0`),")
    strs_push(l, "/// and a total past what a `Duration` holds are an `Err`.")
    strs_push(l, "pub fn time_duration_parse(s: Str) -> Result[Duration, Str] ! {} {")
    strs_push(l, "    let n = str_len(s);")
    strs_push(l, "    if s == \"0\" { return Result[Duration, Str].Ok(value: Duration(nanos: 0)); }")
    strs_push(l, "    let neg = n > 0 && str_byte(s, 0) == 45;")
    strs_push(l, "    let mut at = if neg { 1 } else { 0 };")
    strs_push(l, "    if at >= n { return bad_duration(\"an empty duration\"); }")
    strs_push(l, "    let mut total = 0;")
    strs_push(l, "    while at < n {")
    strs_push(l, "        let mut v = 0;")
    strs_push(l, "        let start = at;")
    strs_push(l, "        while at < n && str_byte(s, at) >= 48 && str_byte(s, at) <= 57 {")
    strs_push(l, "            if v > 922337203685477579 { return bad_duration(\"a duration too long to hold\"); }")
    strs_push(l, "            v = v * 10 + (str_byte(s, at) - 48);")
    strs_push(l, "            at = at + 1;")
    strs_push(l, "        }")
    strs_push(l, "        if at == start { return bad_duration(\"a unit without a number\"); }")
    strs_push(l, "        let ustart = at;")
    strs_push(l, "        while at < n && (str_byte(s, at) < 48 || str_byte(s, at) > 57) { at = at + 1; }")
    strs_push(l, "        let unit = unit_nanos(str_slice(s, ustart, at));")
    strs_push(l, "        if unit == 0 { return bad_duration(if at == ustart { \"a number without a unit\" } else { \"a unit that is not h, m, s, ms, us or ns\" }); }")
    strs_push(l, "        if v > (9223372036854775807 - total) / unit { return bad_duration(\"a duration too long to hold\"); }")
    strs_push(l, "        total = total + v * unit;")
    strs_push(l, "    }")
    strs_push(l, "    Result[Duration, Str].Ok(value: Duration(nanos: if neg { 0 - total } else { total }))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `d` as `time_duration_parse` reads it, each unit from hours down to nanoseconds that is not")
    strs_push(l, "/// zero: `1h30m`, `1s500ms`, `-2s`; `0s` for none.")
    strs_push(l, "pub fn time_duration_show(d: Duration) -> Str ! {} {")
    strs_push(l, "    if d.nanos == 0 { return \"0s\"; }")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    if d.nanos < 0 { strs_push(parts, \"-\"); }")
    strs_push(l, "    let units = strs_new();")
    strs_push(l, "    strs_push(units, \"h\");")
    strs_push(l, "    strs_push(units, \"m\");")
    strs_push(l, "    strs_push(units, \"s\");")
    strs_push(l, "    strs_push(units, \"ms\");")
    strs_push(l, "    strs_push(units, \"us\");")
    strs_push(l, "    strs_push(units, \"ns\");")
    strs_push(l, "    // Each unit's share, taken from the signed remainder so the most negative span has one too.")
    strs_push(l, "    let mut rest = d.nanos;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < 6 {")
    strs_push(l, "        let u = strs_get(units, i);")
    strs_push(l, "        let q = rest / unit_nanos(u);")
    strs_push(l, "        rest = rest - q * unit_nanos(u);")
    strs_push(l, "        if q != 0 {")
    strs_push(l, "            strs_push(parts, int_to_str(if q < 0 { 0 - q } else { q }));")
    strs_push(l, "            strs_push(parts, u);")
    strs_push(l, "        }")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    str_join(parts, \"\")")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_tls() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/tls`: TLS over a TCP socket, client and server, verification always on (v1 track C, C1).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/tls\";` beside `use \"@std/ioerror\";` and `use \"@std/net\";`. The engine is")
    strs_push(l, "// a runtime part (`docs/user/spec.md`, *TLS*): it works on buffers, and this module moves the bytes")
    strs_push(l, "// through the socket with the parking `os_read` and `os_write`, so a wait for the peer parks the")
    strs_push(l, "// task and never holds a worker. A client always verifies the server's chain and name — against")
    strs_push(l, "// the platform's trust store, or only the anchors it names — and nothing here turns that off. TLS")
    strs_push(l, "// 1.2 at least; the engine's own cipher suites. The design record is `openspec/changes/")
    strs_push(l, "// v1-every-domain/design.md`, section C.3.")
    strs_push(l, "")
    strs_push(l, "use \"@std/ioerror\";")
    strs_push(l, "use \"@std/net\";")
    strs_push(l, "")
    strs_push(l, "/// A configuration a session is made from: a client's trust and ALPN names, or a server's")
    strs_push(l, "/// certificate chain, key and ALPN names. An id the runtime holds; it may cross into a task.")
    strs_push(l, "pub struct TlsConfig {")
    strs_push(l, "    id: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A TLS session over a connected socket.")
    strs_push(l, "pub struct TlsStream {")
    strs_push(l, "    stream: TcpStream,")
    strs_push(l, "    session: Int,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// What failed: the socket; the peer's certificate — not trusted, out of its dates, or for another")
    strs_push(l, "/// name; the protocol (an alert, a malformed record, no version or cipher in common); a")
    strs_push(l, "/// certificate or key that could not be read; the peer's connection ended without TLS's close;")
    strs_push(l, "/// or a session already closed.")
    strs_push(l, "pub enum TlsError {")
    strs_push(l, "    Io(error: IoError),")
    strs_push(l, "    Untrusted(why: Str),")
    strs_push(l, "    Expired(why: Str),")
    strs_push(l, "    WrongHost(why: Str),")
    strs_push(l, "    Protocol(why: Str),")
    strs_push(l, "    BadKey(why: Str),")
    strs_push(l, "    Truncated,")
    strs_push(l, "    Closed,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// The runtime's statuses (`docs/user/spec.md`, *TLS*), and this module's own for a truncated stream.")
    strs_push(l, "fn want() -> Int ! {} { 0 - 65600 }")
    strs_push(l, "fn truncated() -> Int ! {} { 0 - 65606 }")
    strs_push(l, "")
    strs_push(l, "/// The error `status` is, with `why` the engine's sentence.")
    strs_push(l, "pub fn tls_error_from(status: Int, why: Str) -> TlsError ! {} {")
    strs_push(l, "    if status == 0 - 65601 { return TlsError.Untrusted(why: why); }")
    strs_push(l, "    if status == 0 - 65602 { return TlsError.Expired(why: why); }")
    strs_push(l, "    if status == 0 - 65603 { return TlsError.WrongHost(why: why); }")
    strs_push(l, "    if status == 0 - 65604 { return TlsError.Protocol(why: why); }")
    strs_push(l, "    if status == 0 - 65605 { return TlsError.BadKey(why: if str_len(why) == 0 { \"a certificate or key that is not PEM, or a key that is not the certificate's\" } else { why }); }")
    strs_push(l, "    if status == 0 - 65606 { return TlsError.Truncated(); }")
    strs_push(l, "    if status == 0 - 65536 { return TlsError.Closed(); }")
    strs_push(l, "    TlsError.Io(error: io_error_from(status))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `e` as a sentence.")
    strs_push(l, "pub fn tls_error_show(e: TlsError) -> Str ! {} {")
    strs_push(l, "    match e {")
    strs_push(l, "        TlsError.Io(error: x) => io_error_show(x),")
    strs_push(l, "        TlsError.Untrusted(why: w) => str_concat(\"the peer's certificate is not trusted: \", w),")
    strs_push(l, "        TlsError.Expired(why: w) => str_concat(\"the peer's certificate is outside its dates: \", w),")
    strs_push(l, "        TlsError.WrongHost(why: w) => str_concat(\"the peer's certificate is for another name: \", w),")
    strs_push(l, "        TlsError.Protocol(why: w) => str_concat(\"the TLS protocol failed: \", w),")
    strs_push(l, "        TlsError.BadKey(why: w) => str_concat(\"the certificate or key was refused: \", w),")
    strs_push(l, "        TlsError.Truncated() => \"the peer's connection ended without closing TLS\",")
    strs_push(l, "        TlsError.Closed() => \"the TLS session is closed\",")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ALPN's wire form of `names`: each a length byte and its bytes. Empty for no names; `None` for a")
    strs_push(l, "// name that is empty or longer than 255 bytes.")
    strs_push(l, "fn alpn_wire(names: Strs) -> Option[Bytes] ! {} {")
    strs_push(l, "    let mut n = 0;")
    strs_push(l, "    let mut i = 0;")
    strs_push(l, "    while i < strs_len(names) {")
    strs_push(l, "        let l = str_len(strs_get(names, i));")
    strs_push(l, "        if l < 1 || l > 255 { return Option[Bytes].None(); }")
    strs_push(l, "        n = n + 1 + l;")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    let out = bytes_new(n);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    i = 0;")
    strs_push(l, "    while i < strs_len(names) {")
    strs_push(l, "        let s = strs_get(names, i);")
    strs_push(l, "        bytes_set(out, at, UInt8(str_len(s)));")
    strs_push(l, "        let mut j = 0;")
    strs_push(l, "        while j < str_len(s) {")
    strs_push(l, "            bytes_set(out, at + 1 + j, UInt8(str_byte(s, j)));")
    strs_push(l, "            j = j + 1;")
    strs_push(l, "        }")
    strs_push(l, "        at = at + 1 + str_len(s);")
    strs_push(l, "        i = i + 1;")
    strs_push(l, "    }")
    strs_push(l, "    Option[Bytes].Some(value: out)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn configured(id: Int) -> Result[TlsConfig, TlsError] ! {} {")
    strs_push(l, "    if id < 0 { Result[TlsConfig, TlsError].Err(error: tls_error_from(id, \"\")) } else { Result[TlsConfig, TlsError].Ok(value: TlsConfig(id: id)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn no_names() -> Result[TlsConfig, TlsError] ! {} {")
    strs_push(l, "    Result[TlsConfig, TlsError].Err(error: TlsError.Io(error: io_error_new(IoErrorKind.InvalidInput(), \"an ALPN name that is empty or longer than 255 bytes\")))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A client's configuration trusting only the certificates in `ca_pem` (PEM; empty: the")
    strs_push(l, "/// platform's trust store) and offering the ALPN names `alpn`, in order of preference.")
    strs_push(l, "pub fn tls_client(ca_pem: Bytes, alpn: Strs) -> Result[TlsConfig, TlsError] ! { io } {")
    strs_push(l, "    match alpn_wire(alpn) {")
    strs_push(l, "        Option.Some(value: w) => configured(os_tls_client_config(ca_pem, w)),")
    strs_push(l, "        Option.None() => no_names(),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A client's configuration trusting the platform's store, offering no ALPN names.")
    strs_push(l, "pub fn tls_client_system() -> Result[TlsConfig, TlsError] ! { io } {")
    strs_push(l, "    configured(os_tls_client_config(bytes_new(0), bytes_new(0)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A server's configuration: its certificate chain `cert_pem` (the leaf first, PEM) and its key")
    strs_push(l, "/// `key_pem` (PEM, unencrypted), choosing among the client's ALPN names by the order of `alpn`.")
    strs_push(l, "pub fn tls_server(cert_pem: Bytes, key_pem: Bytes, alpn: Strs) -> Result[TlsConfig, TlsError] ! { io } {")
    strs_push(l, "    match alpn_wire(alpn) {")
    strs_push(l, "        Option.Some(value: w) => configured(os_tls_server_config(cert_pem, key_pem, w)),")
    strs_push(l, "        Option.None() => no_names(),")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn read_all(io: IoCap, path: Str) -> Result[Bytes, TlsError] ! { io } {")
    strs_push(l, "    let h = os_open_read(path);")
    strs_push(l, "    let s = os_status(h);")
    strs_push(l, "    if s < 0 { return Result[Bytes, TlsError].Err(error: TlsError.Io(error: io_context(io_error_from(s), path))); }")
    strs_push(l, "    let chunks = strs_new();")
    strs_push(l, "    let buf = bytes_new(16384);")
    strs_push(l, "    let mut n = os_read(h, buf);")
    strs_push(l, "    while n > 0 {")
    strs_push(l, "        strs_push(chunks, bytes_to_str(bytes_slice(buf, 0, n)));")
    strs_push(l, "        n = os_read(h, buf);")
    strs_push(l, "    }")
    strs_push(l, "    os_close(h);")
    strs_push(l, "    if n < 0 { return Result[Bytes, TlsError].Err(error: TlsError.Io(error: io_context(io_error_from(n), path))); }")
    strs_push(l, "    Result[Bytes, TlsError].Ok(value: bytes_from_str(str_join(chunks, \"\")))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `tls_server` from the PEM files at `cert_file` and `key_file`.")
    strs_push(l, "pub fn tls_server_from_files(io: IoCap, cert_file: Str, key_file: Str, alpn: Strs) -> Result[TlsConfig, TlsError] ! { io } {")
    strs_push(l, "    let cert = match read_all(io, cert_file) {")
    strs_push(l, "        Result.Ok(value: b) => b,")
    strs_push(l, "        Result.Err(error: e) => { return Result[TlsConfig, TlsError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    let key = match read_all(io, key_file) {")
    strs_push(l, "        Result.Ok(value: b) => b,")
    strs_push(l, "        Result.Err(error: e) => { return Result[TlsConfig, TlsError].Err(error: e); },")
    strs_push(l, "    };")
    strs_push(l, "    tls_server(cert, key, alpn)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close `c`. Sessions made from it keep what they took and stay open.")
    strs_push(l, "pub fn tls_config_close(c: TlsConfig) -> Int ! { io } {")
    strs_push(l, "    os_tls_close(c.id, bytes_new(0))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// The wire: a session's bytes through a socket handle. `@std/http` reads and writes through these.")
    strs_push(l, "")
    strs_push(l, "// Every byte of `data` through `h`: 0, or a status.")
    strs_push(l, "fn write_all(h: OsHandle, data: Bytes) -> Int ! { io } {")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(data) {")
    strs_push(l, "        let n = os_write(h, bytes_slice(data, at, bytes_len(data)));")
    strs_push(l, "        if n < 0 { return n; }")
    strs_push(l, "        at = at + n;")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// Everything session `s` wants sent, through `h`: 0, or a status.")
    strs_push(l, "fn flush(h: OsHandle, s: Int, net: Bytes) -> Int ! { io } {")
    strs_push(l, "    let mut n = os_tls_pull(s, net);")
    strs_push(l, "    while n > 0 {")
    strs_push(l, "        let w = write_all(h, bytes_slice(net, 0, n));")
    strs_push(l, "        if w < 0 { return w; }")
    strs_push(l, "        n = os_tls_pull(s, net);")
    strs_push(l, "    }")
    strs_push(l, "    n")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// What arrives through `h`, into session `s`: 0, or a status — `truncated()` when the peer's")
    strs_push(l, "// connection has ended.")
    strs_push(l, "fn receive(h: OsHandle, s: Int, net: Bytes) -> Int ! { io } {")
    strs_push(l, "    let m = os_read(h, net);")
    strs_push(l, "    if m < 0 { return m; }")
    strs_push(l, "    if m == 0 { return truncated(); }")
    strs_push(l, "    let p = os_tls_push(s, bytes_slice(net, 0, m));")
    strs_push(l, "    if p < 0 { p } else { 0 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Session `s`'s handshake over socket `h`, to its end: 0, or a status (`tls_wire_error` says")
    strs_push(l, "/// what it means). Each wait is the socket's deadline.")
    strs_push(l, "pub fn tls_wire_handshake(h: OsHandle, s: Int) -> Int ! { io } {")
    strs_push(l, "    let net = bytes_new(17408);")
    strs_push(l, "    while true {")
    strs_push(l, "        let r = os_tls_handshake(s);")
    strs_push(l, "        let f = flush(h, s, net);")
    strs_push(l, "        if r == 1 { return if f < 0 { f } else { 0 }; }")
    strs_push(l, "        if r != want() { return r; }")
    strs_push(l, "        if f < 0 { return f; }")
    strs_push(l, "        let got = receive(h, s, net);")
    strs_push(l, "        if got < 0 { return got; }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Plaintext from session `s` over socket `h` into `buf`: its count, `0` once the peer has closed")
    strs_push(l, "/// TLS, or a status.")
    strs_push(l, "pub fn tls_wire_read(h: OsHandle, s: Int, buf: Bytes) -> Int ! { io } {")
    strs_push(l, "    let net = bytes_new(17408);")
    strs_push(l, "    while true {")
    strs_push(l, "        let n = os_tls_read(s, buf);")
    strs_push(l, "        // A read may leave something to send: a key update, an alert.")
    strs_push(l, "        let f = flush(h, s, net);")
    strs_push(l, "        if n != want() { return n; }")
    strs_push(l, "        if f < 0 { return f; }")
    strs_push(l, "        let got = receive(h, s, net);")
    strs_push(l, "        if got < 0 { return got; }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// All of `data` through session `s` over socket `h`: 0, or a status.")
    strs_push(l, "pub fn tls_wire_write(h: OsHandle, s: Int, data: Bytes) -> Int ! { io } {")
    strs_push(l, "    let net = bytes_new(17408);")
    strs_push(l, "    let mut at = 0;")
    strs_push(l, "    while at < bytes_len(data) {")
    strs_push(l, "        let n = os_tls_write(s, bytes_slice(data, at, bytes_len(data)));")
    strs_push(l, "        if n == want() {")
    strs_push(l, "            let got = receive(h, s, net);")
    strs_push(l, "            if got < 0 { return got; }")
    strs_push(l, "        } else {")
    strs_push(l, "            if n < 0 { return n; }")
    strs_push(l, "            at = at + n;")
    strs_push(l, "            let f = flush(h, s, net);")
    strs_push(l, "            if f < 0 { return f; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// End session `s`: its close sent through `h` (best effort), and the session freed.")
    strs_push(l, "pub fn tls_wire_close(h: OsHandle, s: Int) -> Int ! { io } {")
    strs_push(l, "    let out = bytes_new(1024);")
    strs_push(l, "    let n = os_tls_close(s, out);")
    strs_push(l, "    if n > 0 { write_all(h, bytes_slice(out, 0, n)); }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The error a wire status is for session `s`, with the engine's own sentence.")
    strs_push(l, "pub fn tls_wire_error(s: Int, status: Int) -> TlsError ! { io } {")
    strs_push(l, "    tls_error_from(status, tls_fact(s, 3))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn tls_fact(s: Int, what: Int) -> Str ! { io } {")
    strs_push(l, "    let buf = bytes_new(256);")
    strs_push(l, "    let n = os_tls_info(s, what, buf);")
    strs_push(l, "    if n <= 0 { \"\" } else { bytes_to_str(bytes_slice(buf, 0, n)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// ---------------------------------------------------------------------------------------------")
    strs_push(l, "// Streams")
    strs_push(l, "")
    strs_push(l, "fn opened(c: TlsConfig, sock: TcpStream, session: Int) -> Result[TlsStream, TlsError] ! { io } {")
    strs_push(l, "    if session < 0 { return Result[TlsStream, TlsError].Err(error: tls_error_from(session, \"\")); }")
    strs_push(l, "    let r = tls_wire_handshake(sock.handle, session);")
    strs_push(l, "    if r < 0 {")
    strs_push(l, "        let e = tls_wire_error(session, r);")
    strs_push(l, "        os_tls_close(session, bytes_new(0));")
    strs_push(l, "        return Result[TlsStream, TlsError].Err(error: e);")
    strs_push(l, "    }")
    strs_push(l, "    Result[TlsStream, TlsError].Ok(value: TlsStream(stream: sock, session: session))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A client session over `sock` with configuration `c`, verifying that the server is `host` (a")
    strs_push(l, "/// name, or an IP address written without brackets); the handshake is done when it answers. The")
    strs_push(l, "/// socket stays the caller's: `tls_close` closes both.")
    strs_push(l, "pub fn tls_connect(c: TlsConfig, sock: TcpStream, host: Str) -> Result[TlsStream, TlsError] ! { io } {")
    strs_push(l, "    opened(c, sock, os_tls_connect(c.id, host))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A server session over an accepted `sock` with configuration `c`, its handshake done.")
    strs_push(l, "pub fn tls_accept(c: TlsConfig, sock: TcpStream) -> Result[TlsStream, TlsError] ! { io } {")
    strs_push(l, "    opened(c, sock, os_tls_accept(c.id))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Plaintext into `buf`: how many bytes, `0` once the peer has closed TLS.")
    strs_push(l, "pub fn tls_read(t: TlsStream, buf: Bytes) -> Result[Int, TlsError] ! { io } {")
    strs_push(l, "    let n = tls_wire_read(t.stream.handle, t.session, buf);")
    strs_push(l, "    if n < 0 { Result[Int, TlsError].Err(error: tls_wire_error(t.session, n)) } else { Result[Int, TlsError].Ok(value: n) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every byte of `data`.")
    strs_push(l, "pub fn tls_write(t: TlsStream, data: Bytes) -> Result[Int, TlsError] ! { io } {")
    strs_push(l, "    let n = tls_wire_write(t.stream.handle, t.session, data);")
    strs_push(l, "    if n < 0 { Result[Int, TlsError].Err(error: tls_wire_error(t.session, n)) } else { Result[Int, TlsError].Ok(value: bytes_len(data)) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `text`'s bytes, as `tls_write`.")
    strs_push(l, "pub fn tls_write_str(t: TlsStream, text: Str) -> Result[Int, TlsError] ! { io } {")
    strs_push(l, "    tls_write(t, bytes_from_str(text))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Close TLS (the peer is told) and the socket under it.")
    strs_push(l, "pub fn tls_close(t: TlsStream) -> Int ! { io } {")
    strs_push(l, "    tls_wire_close(t.stream.handle, t.session);")
    strs_push(l, "    tcp_close(t.stream);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The ALPN name the two sides agreed on; empty for none.")
    strs_push(l, "pub fn tls_alpn(t: TlsStream) -> Str ! { io } {")
    strs_push(l, "    tls_fact(t.session, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The protocol's version, as the engine names it (`TLSv1.3`).")
    strs_push(l, "pub fn tls_version(t: TlsStream) -> Str ! { io } {")
    strs_push(l, "    tls_fact(t.session, 1)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The subject of the peer's certificate (`/CN=example.org`); empty when it sent none.")
    strs_push(l, "pub fn tls_peer(t: TlsStream) -> Str ! { io } {")
    strs_push(l, "    tls_fact(t.session, 2)")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}

fn sd_m_toml() -> Str {
    let l = strs_new()
    strs_push(l, "// `@std/toml`: TOML 1.0 text, parsed into a tree of values and encoded back (R1c, S1).")
    strs_push(l, "//")
    strs_push(l, "// Imported with `use \"@std/toml\";`. A document is a `Toml.Table`: its keys in the order they were")
    strs_push(l, "// first defined, and its values, each a `Toml` — a recursive enum, through `Chain` (*Immutable")
    strs_push(l, "// indirection*). Every rule of TOML 1.0 is checked: a key or table defined twice, a table defined")
    strs_push(l, "// by a header after dotted keys made it, an inline table extended, an integer past `Int`, a date")
    strs_push(l, "// that is not one. Parsing never traps: malformed text is an `Err` naming the line and column")
    strs_push(l, "// where it went wrong, `line:column: what`. Encoding writes a table's plain values first, then")
    strs_push(l, "// each sub-table under its header and each array of tables as `[[...]]`, as TOML requires: the")
    strs_push(l, "// text parses back to the same values, each table's keys reordered so, and encoding that again")
    strs_push(l, "// gives the same text.")
    strs_push(l, "")
    strs_push(l, "/// A TOML value. A date-time is its RFC 3339 text, with `T` and `Z` written upper-case; which of")
    strs_push(l, "/// TOML's four kinds it is, is which variant holds it.")
    strs_push(l, "pub enum Toml {")
    strs_push(l, "    Str(value: Str),")
    strs_push(l, "    Int(value: Int),")
    strs_push(l, "    Float(value: Float64),")
    strs_push(l, "    Bool(value: Bool),")
    strs_push(l, "    /// `1979-05-27T07:32:00Z`, `1979-05-27T00:32:00.999-07:00`.")
    strs_push(l, "    OffsetDatetime(value: Str),")
    strs_push(l, "    /// `1979-05-27T07:32:00`.")
    strs_push(l, "    LocalDatetime(value: Str),")
    strs_push(l, "    /// `1979-05-27`.")
    strs_push(l, "    LocalDate(value: Str),")
    strs_push(l, "    /// `07:32:00.999`.")
    strs_push(l, "    LocalTime(value: Str),")
    strs_push(l, "    Array(items: Chain[Toml]),")
    strs_push(l, "    Table(keys: Chain[Str], values: Chain[Toml]),")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value of `key` in table `t`, or `None` when `t` is not a table or has no such key.")
    strs_push(l, "pub fn toml_get(t: Toml, key: Str) -> Option[Toml] ! {} {")
    strs_push(l, "    let mut found = Option[Toml].None();")
    strs_push(l, "    if let Toml.Table(keys: keys, values: values) = t {")
    strs_push(l, "        for i in 0..chain_len(keys) {")
    strs_push(l, "            if chain_get(keys, i) == key {")
    strs_push(l, "                found = Option[Toml].Some(value: chain_get(values, i));")
    strs_push(l, "                break;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Whether `t` is a table (R1c, L2c: what a derived type's record is read from).")
    strs_push(l, "pub fn toml_is_table(t: Toml) -> Bool ! {} {")
    strs_push(l, "    if let Toml.Table(keys: k, values: v) = t { true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- the parse arena ---------------------------------------------------------------------------")
    strs_push(l, "//")
    strs_push(l, "// A document is built in an arena, where a table can still be extended by a later header or")
    strs_push(l, "// dotted key, and turned into the immutable tree once it is complete.")
    strs_push(l, "")
    strs_push(l, "// Kinds, by number.")
    strs_push(l, "fn k_str() -> Int ! {} { 0 }")
    strs_push(l, "fn k_int() -> Int ! {} { 1 }")
    strs_push(l, "fn k_float() -> Int ! {} { 2 }")
    strs_push(l, "fn k_bool() -> Int ! {} { 3 }")
    strs_push(l, "fn k_odt() -> Int ! {} { 4 }")
    strs_push(l, "fn k_ldt() -> Int ! {} { 5 }")
    strs_push(l, "fn k_ld() -> Int ! {} { 6 }")
    strs_push(l, "fn k_lt() -> Int ! {} { 7 }")
    strs_push(l, "fn k_array() -> Int ! {} { 8 }")
    strs_push(l, "fn k_table() -> Int ! {} { 9 }")
    strs_push(l, "")
    strs_push(l, "// How a table or an array came to be, as bits of its flags.")
    strs_push(l, "// Defined by its own `[header]`.")
    strs_push(l, "fn f_explicit() -> Int ! {} { 1 }")
    strs_push(l, "// Made as a header's prefix: `[a.b]` makes `a`.")
    strs_push(l, "fn f_implicit() -> Int ! {} { 2 }")
    strs_push(l, "// Made by a dotted key: `a.b = 1` makes `a`.")
    strs_push(l, "fn f_dotted() -> Int ! {} { 4 }")
    strs_push(l, "// An inline table or an array value, which nothing may extend.")
    strs_push(l, "fn f_frozen() -> Int ! {} { 8 }")
    strs_push(l, "// An array of tables, `[[a]]`.")
    strs_push(l, "fn f_aot() -> Int ! {} { 16 }")
    strs_push(l, "")
    strs_push(l, "/// One value in the arena. A table's keys are in `keys` and its values, by node, in `kids`; an")
    strs_push(l, "/// array's items are in `kids`. `flags` is one cell, so that a copy read out of the arena still")
    strs_push(l, "/// changes the node.")
    strs_push(l, "struct Node {")
    strs_push(l, "    kind: Int,")
    strs_push(l, "    text: Str,")
    strs_push(l, "    num: Int,")
    strs_push(l, "    real: Float64,")
    strs_push(l, "    keys: Strs,")
    strs_push(l, "    kids: Ints,")
    strs_push(l, "    flags: Ints,")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The parser: the text, the position (one cell), the first error, and the arena.")
    strs_push(l, "struct P {")
    strs_push(l, "    text: Str,")
    strs_push(l, "    pos: Ints,")
    strs_push(l, "    err: Strs,")
    strs_push(l, "    nodes: Vec[Node],")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn add(p: P, kind: Int, text: Str, num: Int, real: Float64, flags: Int) -> Int ! {} {")
    strs_push(l, "    let f = ints_new();")
    strs_push(l, "    ints_push(f, flags);")
    strs_push(l, "    vec_push(p.nodes, Node(kind: kind, text: text, num: num, real: real, keys: strs_new(), kids: ints_new(), flags: f));")
    strs_push(l, "    vec_len(p.nodes) - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn node(p: P, id: Int) -> Node ! {} { vec_get(p.nodes, id) }")
    strs_push(l, "")
    strs_push(l, "fn flags(p: P, id: Int) -> Int ! {} { ints_get(node(p, id).flags, 0) }")
    strs_push(l, "")
    strs_push(l, "fn has(p: P, id: Int, flag: Int) -> Bool ! {} { flags(p, id) & flag != 0 }")
    strs_push(l, "")
    strs_push(l, "fn mark(p: P, id: Int, flag: Int) -> Int ! {} {")
    strs_push(l, "    let n = node(p, id);")
    strs_push(l, "    ints_set(n.flags, 0, ints_get(n.flags, 0) | flag);")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The child of table `t` named `key`, or -1.")
    strs_push(l, "fn child(p: P, t: Int, key: Str) -> Int ! {} {")
    strs_push(l, "    let n = node(p, t);")
    strs_push(l, "    let mut found = 0 - 1;")
    strs_push(l, "    for i in 0..strs_len(n.keys) {")
    strs_push(l, "        if strs_get(n.keys, i) == key {")
    strs_push(l, "            found = ints_get(n.kids, i);")
    strs_push(l, "            break;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    found")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn attach(p: P, t: Int, key: Str, kid: Int) -> Int ! {} {")
    strs_push(l, "    let n = node(p, t);")
    strs_push(l, "    strs_push(n.keys, key);")
    strs_push(l, "    ints_push(n.kids, kid);")
    strs_push(l, "    kid")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Every table under `id`, and `id`, frozen: an inline table is complete when it closes.")
    strs_push(l, "fn freeze(p: P, id: Int) -> Int ! {} {")
    strs_push(l, "    mark(p, id, f_frozen());")
    strs_push(l, "    let n = node(p, id);")
    strs_push(l, "    if n.kind == k_table() || n.kind == k_array() {")
    strs_push(l, "        for i in 0..ints_len(n.kids) {")
    strs_push(l, "            freeze(p, ints_get(n.kids, i));")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The arena's node `id` as a value.")
    strs_push(l, "fn tree(p: P, id: Int) -> Toml ! {} {")
    strs_push(l, "    let n = node(p, id);")
    strs_push(l, "    if n.kind == k_table() {")
    strs_push(l, "        let values = vec_new[Toml]();")
    strs_push(l, "        for i in 0..ints_len(n.kids) {")
    strs_push(l, "            vec_push(values, tree(p, ints_get(n.kids, i)));")
    strs_push(l, "        }")
    strs_push(l, "        let keys = vec_new[Str]();")
    strs_push(l, "        for i in 0..strs_len(n.keys) {")
    strs_push(l, "            vec_push(keys, strs_get(n.keys, i));")
    strs_push(l, "        }")
    strs_push(l, "        Toml.Table(keys: chain_from_vec(keys), values: chain_from_vec(values))")
    strs_push(l, "    } else {")
    strs_push(l, "        if n.kind == k_array() {")
    strs_push(l, "            let items = vec_new[Toml]();")
    strs_push(l, "            for i in 0..ints_len(n.kids) {")
    strs_push(l, "                vec_push(items, tree(p, ints_get(n.kids, i)));")
    strs_push(l, "            }")
    strs_push(l, "            Toml.Array(items: chain_from_vec(items))")
    strs_push(l, "        } else {")
    strs_push(l, "            if n.kind == k_str() { Toml.Str(value: n.text) } else {")
    strs_push(l, "            if n.kind == k_int() { Toml.Int(value: n.num) } else {")
    strs_push(l, "            if n.kind == k_float() { Toml.Float(value: n.real) } else {")
    strs_push(l, "            if n.kind == k_bool() { Toml.Bool(value: n.num != 0) } else {")
    strs_push(l, "            if n.kind == k_odt() { Toml.OffsetDatetime(value: n.text) } else {")
    strs_push(l, "            if n.kind == k_ldt() { Toml.LocalDatetime(value: n.text) } else {")
    strs_push(l, "            if n.kind == k_ld() { Toml.LocalDate(value: n.text) } else {")
    strs_push(l, "                Toml.LocalTime(value: n.text)")
    strs_push(l, "            } } } } } } }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- reading text ------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "fn at(p: P) -> Int ! {} { ints_get(p.pos, 0) }")
    strs_push(l, "")
    strs_push(l, "fn advance(p: P, n: Int) -> Int ! {} {")
    strs_push(l, "    ints_set(p.pos, 0, at(p) + n);")
    strs_push(l, "    at(p)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn byte_at(p: P, i: Int) -> Int ! {} {")
    strs_push(l, "    if i < str_len(p.text) { str_byte(p.text, i) } else { 0 - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn peek(p: P) -> Int ! {} { byte_at(p, at(p)) }")
    strs_push(l, "")
    strs_push(l, "fn failed(p: P) -> Bool ! {} { strs_len(p.err) > 0 }")
    strs_push(l, "")
    strs_push(l, "/// The first failure is kept, with where it happened: `line:column: what`, both from 1.")
    strs_push(l, "fn fail(p: P, what: Str) -> Int ! {} {")
    strs_push(l, "    if !failed(p) {")
    strs_push(l, "        let mut line = 1;")
    strs_push(l, "        let mut column = 1;")
    strs_push(l, "        let stop = if at(p) < str_len(p.text) { at(p) } else { str_len(p.text) };")
    strs_push(l, "        for i in 0..stop {")
    strs_push(l, "            if str_byte(p.text, i) == 10 {")
    strs_push(l, "                line = line + 1;")
    strs_push(l, "                column = 1;")
    strs_push(l, "            } else {")
    strs_push(l, "                column = column + 1;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "        strs_push(p.err, f\"{line}:{column}: {what}\");")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_digit(b: Int) -> Bool ! {} { b >= 48 && b <= 57 }")
    strs_push(l, "")
    strs_push(l, "fn is_hex(b: Int) -> Bool ! {} { is_digit(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70) }")
    strs_push(l, "")
    strs_push(l, "fn hex_value(b: Int) -> Int ! {} {")
    strs_push(l, "    if is_digit(b) { b - 48 } else { if b >= 97 { b - 87 } else { b - 55 } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_bare(b: Int) -> Bool ! {} {")
    strs_push(l, "    is_digit(b) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95 || b == 45")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Spaces and tabs.")
    strs_push(l, "fn spaces(p: P) -> Int ! {} {")
    strs_push(l, "    while peek(p) == 32 || peek(p) == 9 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A comment, to the end of its line: tab and every byte but the other controls.")
    strs_push(l, "fn comment(p: P) -> Int ! {} {")
    strs_push(l, "    if peek(p) == 35 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        let mut more = true;")
    strs_push(l, "        while more && !failed(p) {")
    strs_push(l, "            let b = peek(p);")
    strs_push(l, "            if b < 0 || b == 10 || (b == 13 && byte_at(p, at(p) + 1) == 10) {")
    strs_push(l, "                more = false;")
    strs_push(l, "            } else {")
    strs_push(l, "                if (b < 32 && b != 9) || b == 127 {")
    strs_push(l, "                    fail(p, \"a control character in a comment\");")
    strs_push(l, "                } else {")
    strs_push(l, "                    advance(p, 1);")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A newline, `\\n` or `\\r\\n`, if one is next; whether it was.")
    strs_push(l, "fn newline(p: P) -> Bool ! {} {")
    strs_push(l, "    if peek(p) == 10 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        true")
    strs_push(l, "    } else {")
    strs_push(l, "        if peek(p) == 13 && byte_at(p, at(p) + 1) == 10 {")
    strs_push(l, "            advance(p, 2);")
    strs_push(l, "            true")
    strs_push(l, "        } else {")
    strs_push(l, "            false")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Spaces, then a comment, then the end of the line or of the text.")
    strs_push(l, "fn end_of_line(p: P) -> Int ! {} {")
    strs_push(l, "    spaces(p);")
    strs_push(l, "    comment(p);")
    strs_push(l, "    if !failed(p) && peek(p) >= 0 && !newline(p) {")
    strs_push(l, "        fail(p, \"expected the end of the line\");")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// Inside an array: spaces, newlines and comments, any number.")
    strs_push(l, "fn array_space(p: P) -> Int ! {} {")
    strs_push(l, "    let mut more = true;")
    strs_push(l, "    while more && !failed(p) {")
    strs_push(l, "        spaces(p);")
    strs_push(l, "        comment(p);")
    strs_push(l, "        if !newline(p) { more = false; }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- strings -----------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "// The UTF-8 bytes of the scalar value `c`.")
    strs_push(l, "fn utf8(c: Int) -> Str ! {} {")
    strs_push(l, "    if c < 128 { str_from_byte(c) } else {")
    strs_push(l, "        if c < 2048 { str_concat(str_from_byte(192 + c / 64), str_from_byte(128 + c % 64)) } else {")
    strs_push(l, "            if c < 65536 {")
    strs_push(l, "                str_concat(str_concat(str_from_byte(224 + c / 4096), str_from_byte(128 + (c / 64) % 64)), str_from_byte(128 + c % 64))")
    strs_push(l, "            } else {")
    strs_push(l, "                str_concat(str_concat(str_concat(str_from_byte(240 + c / 262144), str_from_byte(128 + (c / 4096) % 64)),")
    strs_push(l, "                    str_from_byte(128 + (c / 64) % 64)), str_from_byte(128 + c % 64))")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A byte a string may not hold as itself: a control character other than tab.")
    strs_push(l, "fn forbidden(b: Int) -> Bool ! {} { (b < 32 && b != 9) || b == 127 }")
    strs_push(l, "")
    strs_push(l, "/// An escape after a `\\` in a basic string, its text; the position is past it. A failure where")
    strs_push(l, "/// it is not one.")
    strs_push(l, "fn escape(p: P) -> Str ! {} {")
    strs_push(l, "    let e = byte_at(p, at(p) + 1);")
    strs_push(l, "    if e == 98 { advance(p, 2); str_from_byte(8) } else {")
    strs_push(l, "    if e == 116 { advance(p, 2); str_from_byte(9) } else {")
    strs_push(l, "    if e == 110 { advance(p, 2); str_from_byte(10) } else {")
    strs_push(l, "    if e == 102 { advance(p, 2); str_from_byte(12) } else {")
    strs_push(l, "    if e == 114 { advance(p, 2); str_from_byte(13) } else {")
    strs_push(l, "    if e == 34 { advance(p, 2); \"\\\"\" } else {")
    strs_push(l, "    if e == 92 { advance(p, 2); \"\\\\\" } else {")
    strs_push(l, "    if e == 117 || e == 85 {")
    strs_push(l, "        let width = if e == 117 { 4 } else { 8 };")
    strs_push(l, "        let mut code = 0;")
    strs_push(l, "        let mut ok = true;")
    strs_push(l, "        for k in 0..width {")
    strs_push(l, "            let h = byte_at(p, at(p) + 2 + k);")
    strs_push(l, "            if is_hex(h) { code = code * 16 + hex_value(h); } else { ok = false; }")
    strs_push(l, "        }")
    strs_push(l, "        if !ok || code > 1114111 || (code >= 55296 && code <= 57343) {")
    strs_push(l, "            fail(p, \"an escape that is not a Unicode scalar value\");")
    strs_push(l, "            \"\"")
    strs_push(l, "        } else {")
    strs_push(l, "            advance(p, 2 + width);")
    strs_push(l, "            utf8(code)")
    strs_push(l, "        }")
    strs_push(l, "    } else {")
    strs_push(l, "        fail(p, \"an escape TOML does not have\");")
    strs_push(l, "        \"\"")
    strs_push(l, "    } } } } } } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A basic string, `\"...\"`, after its opening quote.")
    strs_push(l, "fn basic(p: P) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done && !failed(p) {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b < 0 || b == 10 || b == 13 {")
    strs_push(l, "            fail(p, \"a string that does not end on its line\");")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == 34 {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                done = true;")
    strs_push(l, "            } else {")
    strs_push(l, "                if b == 92 {")
    strs_push(l, "                    out = str_concat(out, escape(p));")
    strs_push(l, "                } else {")
    strs_push(l, "                    if forbidden(b) { fail(p, \"a control character in a string\"); } else {")
    strs_push(l, "                        out = str_concat(out, str_slice(p.text, at(p), at(p) + 1));")
    strs_push(l, "                        advance(p, 1);")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A literal string, `'...'`, after its opening quote.")
    strs_push(l, "fn literal(p: P) -> Str ! {} {")
    strs_push(l, "    let start = at(p);")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done && !failed(p) {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b < 0 || b == 10 || b == 13 {")
    strs_push(l, "            fail(p, \"a string that does not end on its line\");")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == 39 { done = true; } else {")
    strs_push(l, "                if forbidden(b) { fail(p, \"a control character in a string\"); } else { advance(p, 1); }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    let s = str_slice(p.text, start, at(p));")
    strs_push(l, "    if !failed(p) { advance(p, 1); }")
    strs_push(l, "    s")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A multi-line string, after its three opening quotes `q`: a newline right after them is not")
    strs_push(l, "/// part of it, and in a basic one a `\\` ending a line removes it and the whitespace after. Up to")
    strs_push(l, "/// two quotes may end it before the closing three.")
    strs_push(l, "fn multiline(p: P, q: Int) -> Str ! {} {")
    strs_push(l, "    newline(p);")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done && !failed(p) {")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b < 0 {")
    strs_push(l, "            fail(p, \"a multi-line string that does not end\");")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == q && byte_at(p, at(p) + 1) == q && byte_at(p, at(p) + 2) == q {")
    strs_push(l, "                // Up to two more quotes belong to the string.")
    strs_push(l, "                let mut extra = 0;")
    strs_push(l, "                while extra < 2 && byte_at(p, at(p) + 3 + extra) == q { extra = extra + 1; }")
    strs_push(l, "                out = str_concat(out, str_slice(p.text, at(p), at(p) + extra));")
    strs_push(l, "                advance(p, 3 + extra);")
    strs_push(l, "                done = true;")
    strs_push(l, "            } else {")
    strs_push(l, "                if q == 34 && b == 92 {")
    strs_push(l, "                    // A line-ending backslash: whitespace to the newline, then every space and")
    strs_push(l, "                    // newline after it.")
    strs_push(l, "                    let mut j = at(p) + 1;")
    strs_push(l, "                    while byte_at(p, j) == 32 || byte_at(p, j) == 9 { j = j + 1; }")
    strs_push(l, "                    if byte_at(p, j) == 10 || (byte_at(p, j) == 13 && byte_at(p, j + 1) == 10) {")
    strs_push(l, "                        advance(p, j - at(p));")
    strs_push(l, "                        let mut more = true;")
    strs_push(l, "                        while more {")
    strs_push(l, "                            if peek(p) == 32 || peek(p) == 9 { advance(p, 1); } else {")
    strs_push(l, "                                if !newline(p) { more = false; }")
    strs_push(l, "                            }")
    strs_push(l, "                        }")
    strs_push(l, "                    } else {")
    strs_push(l, "                        out = str_concat(out, escape(p));")
    strs_push(l, "                    }")
    strs_push(l, "                } else {")
    strs_push(l, "                    if b == 13 && byte_at(p, at(p) + 1) == 10 {")
    strs_push(l, "                        out = str_concat(out, \"\\n\");")
    strs_push(l, "                        advance(p, 2);")
    strs_push(l, "                    } else {")
    strs_push(l, "                        if b == 10 || !forbidden(b) {")
    strs_push(l, "                            out = str_concat(out, str_slice(p.text, at(p), at(p) + 1));")
    strs_push(l, "                            advance(p, 1);")
    strs_push(l, "                        } else {")
    strs_push(l, "                            fail(p, \"a control character in a string\");")
    strs_push(l, "                        }")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A string value of any of the four forms; the position is at its first quote.")
    strs_push(l, "fn string(p: P) -> Str ! {} {")
    strs_push(l, "    let q = peek(p);")
    strs_push(l, "    if byte_at(p, at(p) + 1) == q && byte_at(p, at(p) + 2) == q {")
    strs_push(l, "        advance(p, 3);")
    strs_push(l, "        multiline(p, q)")
    strs_push(l, "    } else {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        if q == 34 { basic(p) } else { literal(p) }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- keys --------------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// One key: bare, or a basic or literal string on one line.")
    strs_push(l, "fn simple_key(p: P) -> Str ! {} {")
    strs_push(l, "    let b = peek(p);")
    strs_push(l, "    if b == 34 || b == 39 {")
    strs_push(l, "        if byte_at(p, at(p) + 1) == b && byte_at(p, at(p) + 2) == b {")
    strs_push(l, "            fail(p, \"a multi-line string as a key\");")
    strs_push(l, "            \"\"")
    strs_push(l, "        } else {")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "            if b == 34 { basic(p) } else { literal(p) }")
    strs_push(l, "        }")
    strs_push(l, "    } else {")
    strs_push(l, "        let start = at(p);")
    strs_push(l, "        while is_bare(peek(p)) { advance(p, 1); }")
    strs_push(l, "        if at(p) == start { fail(p, \"expected a key\"); }")
    strs_push(l, "        str_slice(p.text, start, at(p))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A dotted key, `a.b.\"c\"`, with spaces around its dots.")
    strs_push(l, "fn key(p: P) -> Strs ! {} {")
    strs_push(l, "    let parts = strs_new();")
    strs_push(l, "    strs_push(parts, simple_key(p));")
    strs_push(l, "    spaces(p);")
    strs_push(l, "    while peek(p) == 46 && !failed(p) {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "        spaces(p);")
    strs_push(l, "        strs_push(parts, simple_key(p));")
    strs_push(l, "        spaces(p);")
    strs_push(l, "    }")
    strs_push(l, "    parts")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- numbers and dates -------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// Digits of base `base` with single underscores between them, from `i`; their end, or -1.")
    strs_push(l, "fn digits_end(p: P, i: Int, base: Int) -> Int ! {} {")
    strs_push(l, "    let mut j = i;")
    strs_push(l, "    let mut ok = digit(base, byte_at(p, j));")
    strs_push(l, "    while ok && digit(base, byte_at(p, j)) {")
    strs_push(l, "        j = j + 1;")
    strs_push(l, "        if byte_at(p, j) == 95 {")
    strs_push(l, "            if digit(base, byte_at(p, j + 1)) { j = j + 1; } else { ok = false; }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if ok { j } else { 0 - 1 }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn digit(base: Int, b: Int) -> Bool ! {} {")
    strs_push(l, "    if base == 16 { is_hex(b) } else { if base == 8 { b >= 48 && b <= 55 } else {")
    strs_push(l, "        if base == 2 { b == 48 || b == 49 } else { is_digit(b) } } }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The value of the digits from `i` to `j`, skipping underscores, in `base`; `None` past `Int`.")
    strs_push(l, "fn digits_value(p: P, i: Int, j: Int, base: Int, negative: Bool) -> Option[Int] ! {} {")
    strs_push(l, "    let mut v = Option[Int].Some(value: 0);")
    strs_push(l, "    for k in i..j {")
    strs_push(l, "        let b = byte_at(p, k);")
    strs_push(l, "        if b != 95 {")
    strs_push(l, "            v = match v {")
    strs_push(l, "                Option.Some(value: x) => match checked_mul(x, base) {")
    strs_push(l, "                    Option.Some(value: y) => if negative { checked_sub(y, hex_value(b)) } else { checked_add(y, hex_value(b)) },")
    strs_push(l, "                    Option.None() => Option[Int].None(),")
    strs_push(l, "                },")
    strs_push(l, "                Option.None() => Option[Int].None(),")
    strs_push(l, "            };")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    v")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn two(p: P, i: Int) -> Int ! {} {")
    strs_push(l, "    if is_digit(byte_at(p, i)) && is_digit(byte_at(p, i + 1)) {")
    strs_push(l, "        (byte_at(p, i) - 48) * 10 + byte_at(p, i + 1) - 48")
    strs_push(l, "    } else {")
    strs_push(l, "        0 - 1")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `HH:MM:SS` and an optional fraction from `i`; its end, or -1.")
    strs_push(l, "fn time_end(p: P, i: Int) -> Int ! {} {")
    strs_push(l, "    let h = two(p, i);")
    strs_push(l, "    let m = two(p, i + 3);")
    strs_push(l, "    let s = two(p, i + 6);")
    strs_push(l, "    if h < 0 || h > 23 || byte_at(p, i + 2) != 58 || m < 0 || m > 59 || byte_at(p, i + 5) != 58 || s < 0 || s > 60 {")
    strs_push(l, "        0 - 1")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut j = i + 8;")
    strs_push(l, "        if byte_at(p, j) == 46 {")
    strs_push(l, "            j = j + 1;")
    strs_push(l, "            let start = j;")
    strs_push(l, "            while is_digit(byte_at(p, j)) { j = j + 1; }")
    strs_push(l, "            if j == start { j = 0 - 1; }")
    strs_push(l, "        }")
    strs_push(l, "        j")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `YYYY-MM-DD` from `i`, a real day of a real month; whether it is one.")
    strs_push(l, "fn date_ok(p: P, i: Int) -> Bool ! {} {")
    strs_push(l, "    let mut year = 0;")
    strs_push(l, "    let mut ok = true;")
    strs_push(l, "    for k in 0..4 {")
    strs_push(l, "        let b = byte_at(p, i + k);")
    strs_push(l, "        if is_digit(b) { year = year * 10 + b - 48; } else { ok = false; }")
    strs_push(l, "    }")
    strs_push(l, "    let month = two(p, i + 5);")
    strs_push(l, "    let day = two(p, i + 8);")
    strs_push(l, "    if !ok || byte_at(p, i + 4) != 45 || byte_at(p, i + 7) != 45 || month < 1 || month > 12 || day < 1 {")
    strs_push(l, "        false")
    strs_push(l, "    } else {")
    strs_push(l, "        let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;")
    strs_push(l, "        let days = if month == 2 { if leap { 29 } else { 28 } } else {")
    strs_push(l, "            if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 } };")
    strs_push(l, "        day <= days")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A date, a time or a date-time at the position, as a node; -1 where the text is not one.")
    strs_push(l, "fn datetime(p: P) -> Int ! {} {")
    strs_push(l, "    let i = at(p);")
    strs_push(l, "    if byte_at(p, i + 2) == 58 {")
    strs_push(l, "        let j = time_end(p, i);")
    strs_push(l, "        if j < 0 { return 0 - 1; }")
    strs_push(l, "        let text = str_slice(p.text, i, j);")
    strs_push(l, "        advance(p, j - i);")
    strs_push(l, "        return add(p, k_lt(), text, 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if !date_ok(p, i) { return 0 - 1; }")
    strs_push(l, "    let sep = byte_at(p, i + 10);")
    strs_push(l, "    let has_time = (sep == 84 || sep == 116 || sep == 32) && time_end(p, i + 11) > 0;")
    strs_push(l, "    if !has_time {")
    strs_push(l, "        let text = str_slice(p.text, i, i + 10);")
    strs_push(l, "        advance(p, 10);")
    strs_push(l, "        return add(p, k_ld(), text, 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    let j = time_end(p, i + 11);")
    strs_push(l, "    let mut text = f\"{str_slice(p.text, i, i + 10)}T{str_slice(p.text, i + 11, j)}\";")
    strs_push(l, "    let o = byte_at(p, j);")
    strs_push(l, "    if o == 90 || o == 122 {")
    strs_push(l, "        advance(p, j + 1 - i);")
    strs_push(l, "        return add(p, k_odt(), f\"{text}Z\", 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if o == 43 || o == 45 {")
    strs_push(l, "        let oh = two(p, j + 1);")
    strs_push(l, "        let om = two(p, j + 4);")
    strs_push(l, "        if oh < 0 || oh > 23 || byte_at(p, j + 3) != 58 || om < 0 || om > 59 {")
    strs_push(l, "            return 0 - 1;")
    strs_push(l, "        }")
    strs_push(l, "        text = f\"{text}{str_slice(p.text, j, j + 6)}\";")
    strs_push(l, "        advance(p, j + 6 - i);")
    strs_push(l, "        return add(p, k_odt(), text, 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    advance(p, j - i);")
    strs_push(l, "    add(p, k_ldt(), text, 0, 0.0, 0)")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A decimal integer's digits from `i` as TOML writes them: no leading zero but `0` itself.")
    strs_push(l, "fn decimal_end(p: P, i: Int) -> Int ! {} {")
    strs_push(l, "    let j = digits_end(p, i, 10);")
    strs_push(l, "    if j > i + 1 && byte_at(p, i) == 48 { 0 - 1 } else { j }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An integer or a float at the position, as a node; a failure where it is neither.")
    strs_push(l, "fn number(p: P) -> Int ! {} {")
    strs_push(l, "    let i = at(p);")
    strs_push(l, "    let sign = peek(p);")
    strs_push(l, "    let signed = sign == 43 || sign == 45;")
    strs_push(l, "    let s = if signed { i + 1 } else { i };")
    strs_push(l, "    // `inf` and `nan`.")
    strs_push(l, "    let word = if s + 3 <= str_len(p.text) { str_slice(p.text, s, s + 3) } else { \"\" };")
    strs_push(l, "    if word == \"inf\" || word == \"nan\" {")
    strs_push(l, "        advance(p, s + 3 - i);")
    strs_push(l, "        let x = float_parse_raw(str_slice(p.text, i, s + 3));")
    strs_push(l, "        return add(p, k_float(), \"\", 0, x, 0);")
    strs_push(l, "    }")
    strs_push(l, "    // A prefixed integer: no sign.")
    strs_push(l, "    let x = byte_at(p, s + 1);")
    strs_push(l, "    if !signed && byte_at(p, s) == 48 && (x == 120 || x == 111 || x == 98) {")
    strs_push(l, "        let base = if x == 120 { 16 } else { if x == 111 { 8 } else { 2 } };")
    strs_push(l, "        let j = digits_end(p, s + 2, base);")
    strs_push(l, "        if j < 0 { fail(p, \"a malformed integer\"); return 0 - 1; }")
    strs_push(l, "        advance(p, j - i);")
    strs_push(l, "        return match digits_value(p, s + 2, j, base, false) {")
    strs_push(l, "            Option.Some(value: v) => add(p, k_int(), \"\", v, 0.0, 0),")
    strs_push(l, "            Option.None() => { fail(p, \"an integer past `Int`\"); 0 - 1 }")
    strs_push(l, "        };")
    strs_push(l, "    }")
    strs_push(l, "    let j = decimal_end(p, s);")
    strs_push(l, "    if j < 0 { fail(p, \"a malformed number\"); return 0 - 1; }")
    strs_push(l, "    let mut k = j;")
    strs_push(l, "    let mut float = false;")
    strs_push(l, "    if byte_at(p, k) == 46 {")
    strs_push(l, "        let f = digits_end(p, k + 1, 10);")
    strs_push(l, "        if f < 0 { fail(p, \"a fraction needs a digit on each side of its `.`\"); return 0 - 1; }")
    strs_push(l, "        k = f;")
    strs_push(l, "        float = true;")
    strs_push(l, "    }")
    strs_push(l, "    if byte_at(p, k) == 101 || byte_at(p, k) == 69 {")
    strs_push(l, "        let mut e = k + 1;")
    strs_push(l, "        if byte_at(p, e) == 43 || byte_at(p, e) == 45 { e = e + 1; }")
    strs_push(l, "        let f = digits_end(p, e, 10);")
    strs_push(l, "        if f < 0 { fail(p, \"an exponent needs digits\"); return 0 - 1; }")
    strs_push(l, "        k = f;")
    strs_push(l, "        float = true;")
    strs_push(l, "    }")
    strs_push(l, "    advance(p, k - i);")
    strs_push(l, "    if float {")
    strs_push(l, "        let text = text_without_underscores(str_slice(p.text, i, k));")
    strs_push(l, "        add(p, k_float(), \"\", 0, float_parse_raw(text), 0)")
    strs_push(l, "    } else {")
    strs_push(l, "        match digits_value(p, s, j, 10, sign == 45) {")
    strs_push(l, "            Option.Some(value: v) => add(p, k_int(), \"\", v, 0.0, 0),")
    strs_push(l, "            Option.None() => { fail(p, \"an integer past `Int`\"); 0 - 1 }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn text_without_underscores(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\";")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    for i in 0..str_len(s) {")
    strs_push(l, "        if str_byte(s, i) == 95 {")
    strs_push(l, "            out = str_concat(out, str_slice(s, start, i));")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    str_concat(out, str_slice(s, start, str_len(s)))")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- values ------------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// A value at the position, as a node; -1 after a failure.")
    strs_push(l, "fn value(p: P) -> Int ! {} {")
    strs_push(l, "    let b = peek(p);")
    strs_push(l, "    if b == 34 || b == 39 {")
    strs_push(l, "        let s = string(p);")
    strs_push(l, "        return add(p, k_str(), s, 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if b == 116 && at(p) + 4 <= str_len(p.text) && str_slice(p.text, at(p), at(p) + 4) == \"true\" {")
    strs_push(l, "        advance(p, 4);")
    strs_push(l, "        return add(p, k_bool(), \"\", 1, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if b == 102 && at(p) + 5 <= str_len(p.text) && str_slice(p.text, at(p), at(p) + 5) == \"false\" {")
    strs_push(l, "        advance(p, 5);")
    strs_push(l, "        return add(p, k_bool(), \"\", 0, 0.0, 0);")
    strs_push(l, "    }")
    strs_push(l, "    if b == 91 { return array(p); }")
    strs_push(l, "    if b == 123 { return inline_table(p); }")
    strs_push(l, "    // A date is four digits and a `-`; a time, two digits and a `:`.")
    strs_push(l, "    let i = at(p);")
    strs_push(l, "    let date = is_digit(b) && is_digit(byte_at(p, i + 1)) && is_digit(byte_at(p, i + 2))")
    strs_push(l, "        && is_digit(byte_at(p, i + 3)) && byte_at(p, i + 4) == 45;")
    strs_push(l, "    let time = is_digit(b) && is_digit(byte_at(p, i + 1)) && byte_at(p, i + 2) == 58;")
    strs_push(l, "    if date || time {")
    strs_push(l, "        let d = datetime(p);")
    strs_push(l, "        if d < 0 { fail(p, \"a malformed date or time\"); }")
    strs_push(l, "        return d;")
    strs_push(l, "    }")
    strs_push(l, "    if is_digit(b) || b == 43 || b == 45 || b == 105 || b == 110 {")
    strs_push(l, "        return number(p);")
    strs_push(l, "    }")
    strs_push(l, "    fail(p, \"expected a value\");")
    strs_push(l, "    0 - 1")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn array(p: P) -> Int ! {} {")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    let a = add(p, k_array(), \"\", 0, 0.0, f_frozen());")
    strs_push(l, "    let items = node(p, a).kids;")
    strs_push(l, "    array_space(p);")
    strs_push(l, "    let mut done = false;")
    strs_push(l, "    while !done && !failed(p) {")
    strs_push(l, "        if peek(p) == 93 {")
    strs_push(l, "            advance(p, 1);")
    strs_push(l, "            done = true;")
    strs_push(l, "        } else {")
    strs_push(l, "            let v = value(p);")
    strs_push(l, "            if !failed(p) { ints_push(items, v); }")
    strs_push(l, "            array_space(p);")
    strs_push(l, "            if peek(p) == 44 {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                array_space(p);")
    strs_push(l, "            } else {")
    strs_push(l, "                if peek(p) == 93 { advance(p, 1); done = true; } else {")
    strs_push(l, "                    if !failed(p) { fail(p, \"expected `,` or `]` in an array\"); }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    a")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn inline_table(p: P) -> Int ! {} {")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    let t = add(p, k_table(), \"\", 0, 0.0, 0);")
    strs_push(l, "    spaces(p);")
    strs_push(l, "    if peek(p) == 125 {")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "    } else {")
    strs_push(l, "        let mut done = false;")
    strs_push(l, "        while !done && !failed(p) {")
    strs_push(l, "            key_value(p, t);")
    strs_push(l, "            spaces(p);")
    strs_push(l, "            if peek(p) == 44 {")
    strs_push(l, "                advance(p, 1);")
    strs_push(l, "                spaces(p);")
    strs_push(l, "                if peek(p) == 125 { fail(p, \"a trailing `,` in an inline table\"); }")
    strs_push(l, "            } else {")
    strs_push(l, "                if peek(p) == 125 { advance(p, 1); done = true; } else {")
    strs_push(l, "                    if !failed(p) { fail(p, \"expected `,` or `}` in an inline table\"); }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    freeze(p, t);")
    strs_push(l, "    t")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `key = value` into table `t`: a dotted key's prefix is tables, made or extended here.")
    strs_push(l, "fn key_value(p: P, t: Int) -> Int ! {} {")
    strs_push(l, "    let parts = key(p);")
    strs_push(l, "    if failed(p) { return 0; }")
    strs_push(l, "    if peek(p) != 61 { fail(p, \"expected `=` after a key\"); return 0; }")
    strs_push(l, "    advance(p, 1);")
    strs_push(l, "    spaces(p);")
    strs_push(l, "    let mut table = t;")
    strs_push(l, "    let last = strs_len(parts) - 1;")
    strs_push(l, "    for i in 0..last {")
    strs_push(l, "        let name = strs_get(parts, i);")
    strs_push(l, "        let c = child(p, table, name);")
    strs_push(l, "        if c < 0 {")
    strs_push(l, "            table = attach(p, table, name, add(p, k_table(), \"\", 0, 0.0, f_dotted()));")
    strs_push(l, "        } else {")
    strs_push(l, "            if node(p, c).kind != k_table() || !has(p, c, f_dotted()) || has(p, c, f_frozen()) {")
    strs_push(l, "                fail(p, f\"`{name}` is already defined, and a dotted key cannot extend it\");")
    strs_push(l, "                return 0;")
    strs_push(l, "            }")
    strs_push(l, "            table = c;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    let name = strs_get(parts, last);")
    strs_push(l, "    if child(p, table, name) >= 0 {")
    strs_push(l, "        fail(p, f\"`{name}` is defined twice\");")
    strs_push(l, "        return 0;")
    strs_push(l, "    }")
    strs_push(l, "    let v = value(p);")
    strs_push(l, "    if !failed(p) { attach(p, table, name, v); }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `[a.b]` or, with `aot`, `[[a.b]]`: the table the lines after it fill.")
    strs_push(l, "fn header(p: P, aot: Bool) -> Int ! {} {")
    strs_push(l, "    advance(p, if aot { 2 } else { 1 });")
    strs_push(l, "    spaces(p);")
    strs_push(l, "    let parts = key(p);")
    strs_push(l, "    if failed(p) { return 0; }")
    strs_push(l, "    if aot {")
    strs_push(l, "        if peek(p) != 93 || byte_at(p, at(p) + 1) != 93 { fail(p, \"expected `]]`\"); return 0; }")
    strs_push(l, "        advance(p, 2);")
    strs_push(l, "    } else {")
    strs_push(l, "        if peek(p) != 93 { fail(p, \"expected `]`\"); return 0; }")
    strs_push(l, "        advance(p, 1);")
    strs_push(l, "    }")
    strs_push(l, "    let mut table = 0;")
    strs_push(l, "    let last = strs_len(parts) - 1;")
    strs_push(l, "    for i in 0..last {")
    strs_push(l, "        let name = strs_get(parts, i);")
    strs_push(l, "        let c = child(p, table, name);")
    strs_push(l, "        if c < 0 {")
    strs_push(l, "            table = attach(p, table, name, add(p, k_table(), \"\", 0, 0.0, f_implicit()));")
    strs_push(l, "        } else {")
    strs_push(l, "            if has(p, c, f_aot()) {")
    strs_push(l, "                let kids = node(p, c).kids;")
    strs_push(l, "                table = ints_get(kids, ints_len(kids) - 1);")
    strs_push(l, "            } else {")
    strs_push(l, "                if node(p, c).kind != k_table() || has(p, c, f_frozen()) {")
    strs_push(l, "                    fail(p, f\"`{name}` is already defined as a value\");")
    strs_push(l, "                    return 0;")
    strs_push(l, "                }")
    strs_push(l, "                table = c;")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    let name = strs_get(parts, last);")
    strs_push(l, "    let c = child(p, table, name);")
    strs_push(l, "    if aot {")
    strs_push(l, "        let a = if c < 0 { attach(p, table, name, add(p, k_array(), \"\", 0, 0.0, f_aot())) } else {")
    strs_push(l, "            if !has(p, c, f_aot()) {")
    strs_push(l, "                fail(p, f\"`{name}` is already defined, and not as an array of tables\");")
    strs_push(l, "                return 0;")
    strs_push(l, "            }")
    strs_push(l, "            c")
    strs_push(l, "        };")
    strs_push(l, "        let fresh = add(p, k_table(), \"\", 0, 0.0, f_explicit());")
    strs_push(l, "        ints_push(node(p, a).kids, fresh);")
    strs_push(l, "        fresh")
    strs_push(l, "    } else {")
    strs_push(l, "        if c < 0 {")
    strs_push(l, "            attach(p, table, name, add(p, k_table(), \"\", 0, 0.0, f_explicit()))")
    strs_push(l, "        } else {")
    strs_push(l, "            if node(p, c).kind != k_table() || flags(p, c) != f_implicit() {")
    strs_push(l, "                fail(p, f\"the table `{name}` is defined twice\");")
    strs_push(l, "                return 0;")
    strs_push(l, "            }")
    strs_push(l, "            mark(p, c, f_explicit());")
    strs_push(l, "            c")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// The document `text` spells, a `Toml.Table`, or an `Err` naming the line, the column and what")
    strs_push(l, "/// was wrong there.")
    strs_push(l, "pub fn toml_parse(text: Str) -> Result[Toml, Str] ! {} {")
    strs_push(l, "    let p = P(text: text, pos: ints_new(), err: strs_new(), nodes: vec_new[Node]());")
    strs_push(l, "    ints_push(p.pos, 0);")
    strs_push(l, "    add(p, k_table(), \"\", 0, 0.0, f_explicit());")
    strs_push(l, "    if !utf8_valid(text) { fail(p, \"the text is not UTF-8\"); }")
    strs_push(l, "    let mut current = 0;")
    strs_push(l, "    while !failed(p) && peek(p) >= 0 {")
    strs_push(l, "        spaces(p);")
    strs_push(l, "        let b = peek(p);")
    strs_push(l, "        if b == 35 || b == 10 || b == 13 || b < 0 {")
    strs_push(l, "            end_of_line(p);")
    strs_push(l, "        } else {")
    strs_push(l, "            if b == 91 {")
    strs_push(l, "                current = header(p, byte_at(p, at(p) + 1) == 91);")
    strs_push(l, "                if !failed(p) { end_of_line(p); }")
    strs_push(l, "            } else {")
    strs_push(l, "                key_value(p, current);")
    strs_push(l, "                if !failed(p) { end_of_line(p); }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    if failed(p) {")
    strs_push(l, "        Result[Toml, Str].Err(error: strs_get(p.err, 0))")
    strs_push(l, "    } else {")
    strs_push(l, "        Result[Toml, Str].Ok(value: tree(p, 0))")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "// --- encoding ----------------------------------------------------------------------------------")
    strs_push(l, "")
    strs_push(l, "/// A key as TOML writes it: bare where it can be, otherwise quoted.")
    strs_push(l, "fn encode_key(k: Str) -> Str ! {} {")
    strs_push(l, "    let mut bare = str_len(k) > 0;")
    strs_push(l, "    for i in 0..str_len(k) {")
    strs_push(l, "        if !is_bare(str_byte(k, i)) { bare = false; }")
    strs_push(l, "    }")
    strs_push(l, "    if bare { k } else { encode_str(k) }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A basic string, every control character escaped.")
    strs_push(l, "fn encode_str(s: Str) -> Str ! {} {")
    strs_push(l, "    let mut out = \"\\\"\";")
    strs_push(l, "    let mut start = 0;")
    strs_push(l, "    for i in 0..str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        let e = if b == 34 { \"\\\\\\\"\" } else { if b == 92 { \"\\\\\\\\\" } else { if b == 10 { \"\\\\n\" } else {")
    strs_push(l, "            if b == 9 { \"\\\\t\" } else { if b == 13 { \"\\\\r\" } else { if forbidden(b) {")
    strs_push(l, "                let h = \"0123456789ABCDEF\";")
    strs_push(l, "                f\"\\\\u00{str_slice(h, b / 16, b / 16 + 1)}{str_slice(h, b % 16, b % 16 + 1)}\"")
    strs_push(l, "            } else { \"\" } } } } } };")
    strs_push(l, "        if str_len(e) > 0 {")
    strs_push(l, "            out = str_concat(out, str_slice(s, start, i));")
    strs_push(l, "            out = str_concat(out, e);")
    strs_push(l, "            start = i + 1;")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    out = str_concat(out, str_slice(s, start, str_len(s)));")
    strs_push(l, "    str_concat(out, \"\\\"\")")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn encode_float(x: Float64) -> Str ! {} {")
    strs_push(l, "    if float_is_nan(x) { return \"nan\"; }")
    strs_push(l, "    if float_is_infinite(x) { return if x > 0.0 { \"inf\" } else { \"-inf\" }; }")
    strs_push(l, "    let s = num_to_str(x);")
    strs_push(l, "    let mut plain = true;")
    strs_push(l, "    for i in 0..str_len(s) {")
    strs_push(l, "        let b = str_byte(s, i);")
    strs_push(l, "        if b == 46 || b == 101 { plain = false; }")
    strs_push(l, "    }")
    strs_push(l, "    if plain { str_concat(s, \".0\") } else { s }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A value written inline: a table as `{ ... }`.")
    strs_push(l, "fn encode_inline(v: Toml) -> Str ! {} {")
    strs_push(l, "    match v {")
    strs_push(l, "        Toml.Str(value: s) => encode_str(s),")
    strs_push(l, "        Toml.Int(value: n) => int_to_str(n),")
    strs_push(l, "        Toml.Float(value: x) => encode_float(x),")
    strs_push(l, "        Toml.Bool(value: b) => if b { \"true\" } else { \"false\" },")
    strs_push(l, "        Toml.OffsetDatetime(value: s) => s,")
    strs_push(l, "        Toml.LocalDatetime(value: s) => s,")
    strs_push(l, "        Toml.LocalDate(value: s) => s,")
    strs_push(l, "        Toml.LocalTime(value: s) => s,")
    strs_push(l, "        Toml.Array(items: items) => {")
    strs_push(l, "            let parts = strs_new();")
    strs_push(l, "            for i in 0..chain_len(items) { strs_push(parts, encode_inline(chain_get(items, i))); }")
    strs_push(l, "            f\"[{str_join(parts, \", \")}]\"")
    strs_push(l, "        },")
    strs_push(l, "        Toml.Table(keys: keys, values: values) => {")
    strs_push(l, "            if chain_len(keys) == 0 { return \"{}\"; }")
    strs_push(l, "            let parts = strs_new();")
    strs_push(l, "            for i in 0..chain_len(keys) {")
    strs_push(l, "                strs_push(parts, f\"{encode_key(chain_get(keys, i))} = {encode_inline(chain_get(values, i))}\");")
    strs_push(l, "            }")
    strs_push(l, "            f\"{{ {str_join(parts, \", \")} }}\"")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "fn is_table(v: Toml) -> Bool ! {} {")
    strs_push(l, "    if let Toml.Table(keys: k, values: x) = v { true } else { false }")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// An array written as `[[...]]` sections: one of tables only, not empty.")
    strs_push(l, "fn is_aot(v: Toml) -> Bool ! {} {")
    strs_push(l, "    let mut all = false;")
    strs_push(l, "    if let Toml.Array(items: items) = v {")
    strs_push(l, "        all = chain_len(items) > 0;")
    strs_push(l, "        for i in 0..chain_len(items) { if !is_table(chain_get(items, i)) { all = false; } }")
    strs_push(l, "    }")
    strs_push(l, "    all")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// A table's lines under the header path `path`: its plain values, then its sub-tables, then")
    strs_push(l, "/// its arrays of tables.")
    strs_push(l, "fn encode_table(out: Strs, path: Str, keys: Chain[Str], values: Chain[Toml]) -> Int ! {} {")
    strs_push(l, "    for i in 0..chain_len(keys) {")
    strs_push(l, "        let v = chain_get(values, i);")
    strs_push(l, "        if !is_table(v) && !is_aot(v) {")
    strs_push(l, "            strs_push(out, f\"{encode_key(chain_get(keys, i))} = {encode_inline(v)}\\n\");")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    for i in 0..chain_len(keys) {")
    strs_push(l, "        let v = chain_get(values, i);")
    strs_push(l, "        let name = encode_key(chain_get(keys, i));")
    strs_push(l, "        let full = if str_len(path) == 0 { name } else { f\"{path}.{name}\" };")
    strs_push(l, "        if let Toml.Table(keys: k, values: x) = v {")
    strs_push(l, "            strs_push(out, f\"\\n[{full}]\\n\");")
    strs_push(l, "            encode_table(out, full, k, x);")
    strs_push(l, "        }")
    strs_push(l, "        if let Toml.Array(items: items) = v {")
    strs_push(l, "            if is_aot(v) {")
    strs_push(l, "                for j in 0..chain_len(items) {")
    strs_push(l, "                    if let Toml.Table(keys: k, values: x) = chain_get(items, j) {")
    strs_push(l, "                        strs_push(out, f\"\\n[[{full}]]\\n\");")
    strs_push(l, "                        encode_table(out, full, k, x);")
    strs_push(l, "                    }")
    strs_push(l, "                }")
    strs_push(l, "            }")
    strs_push(l, "        }")
    strs_push(l, "    }")
    strs_push(l, "    0")
    strs_push(l, "}")
    strs_push(l, "")
    strs_push(l, "/// `t` as TOML text: a table's, each line ending in a newline; any other value, inline.")
    strs_push(l, "pub fn toml_encode(t: Toml) -> Str ! {} {")
    strs_push(l, "    if let Toml.Table(keys: keys, values: values) = t {")
    strs_push(l, "        let out = strs_new();")
    strs_push(l, "        encode_table(out, \"\", keys, values);")
    strs_push(l, "        let text = str_join(out, \"\");")
    strs_push(l, "        // No blank line before the first header of a document without plain values.")
    strs_push(l, "        if str_len(text) > 0 && str_byte(text, 0) == 10 { str_slice(text, 1, str_len(text)) } else { text }")
    strs_push(l, "    } else {")
    strs_push(l, "        encode_inline(t)")
    strs_push(l, "    }")
    strs_push(l, "}")
    str_join(l, str_from_byte(10)) + str_from_byte(10)
}
