// Core IR from the checked program (R2, slice 5; `openspec/changes/r2-front-end/design.md` D25): a
// port of `nazm-core/src/lower.rs`, function by function, printed as `nazm.core-ir/3` prints each
// function (`nazm-cir/src/print.rs`), its digests computed from what is printed (`digest.nz`).
//
// It knows where it stops. A function using anything this lowering does not carry yet is not
// printed: `cr_function` says what it stopped at instead, and the comparison (`run.sh core`)
// counts it apart, so every function it does print is compared whole. Carried today: functions
// with a body — generic ones, impls' methods and closures (their captures, and the bindings they
// share kept in cells) included — and no effect parameters, contracts or
// attributes but `@deprecated`; `let` of a name, assignment to a binding, `while`, `return`,
// `break`, `continue`, an expression as a statement, `if`, blocks and `match` of plain arms;
// literals of `Int`, `Bool` and `Str`, bindings, `-`, `!`, `&&`, `||`, the arithmetic operators and
// comparisons of `Int`, `Bool` and `Str`, field reads, records and variants built (by name or by
// position), and calls of the compilation's functions and of the built-ins, generic ones with the
// type arguments the checker settled. The document's other parts are `cr_parts`'.

use "syntax.nz";
use "diag.nz";
use "sema.nz";
use "facts.nz";
use "digest.nz";

// One function's lowering (`Lower`).
struct Lo {
    f: Facts,
    c: Ck,
    t: Tree,
    // The function, its module and that module's base offset.
    st: Ints,
    stop: Strs,
    // Its locals: the binding each is (-1 for a temporary), name, type, origin and where.
    lb: Ints,
    lname: Strs,
    lty: Ints,
    lorig: Strs,
    lat: Strs,
    // For a local a closure shares (R1b, L10), kept in a cell: the type the cell holds; else -1.
    lshr: Ints,
    // Its constants, by value: each one's key, type and printed value.
    ckey: Strs,
    cty: Strs,
    cval: Strs,
    // A static `Atomic`'s cell's durable key, beside its constant ("" for any other constant).
    cstatic: Strs,
    // The loops whose bodies enclose the point being lowered, innermost last.
    targets: Ints,
    // For each open region, the locals bound directly in it: a run of `owned` from `ofirst`.
    ofirst: Ints,
    owned: Ints,
    // What the last expression or block lowered gave: its type (-1 where it never completes) and
    // whether it ends by transferring (blocks and statements).
    last: Ints,
    // Every module's identity, for the durable names.
    idents: Strs,
}

fn co_nl() -> Str { str_from_byte(10) }

fn co_s_fn() -> Int { 0 }
fn co_s_module() -> Int { 1 }
fn co_s_base() -> Int { 2 }
fn co_s_loops() -> Int { 3 }

fn co_g(lo: Lo, slot: Int) -> Int { ints_get(lo.st, slot) }
fn co_sv(lo: Lo, slot: Int, v: Int) -> Int {
    ints_set(lo.st, slot, v);
    0
}

fn co_halt(lo: Lo, why: Str) -> Int {
    if strs_len(lo.stop) == 0 { strs_push(lo.stop, why); }
    0
}
fn co_halted(lo: Lo) -> Bool { strs_len(lo.stop) > 0 }

// The type and ending of what was lowered last.
fn co_set_last(lo: Lo, ty: Int, transfers: Bool) -> Int {
    ints_set(lo.last, 0, ty);
    if transfers { ints_set(lo.last, 1, 1); } else { ints_set(lo.last, 1, 0); }
    0
}
fn co_last_ty(lo: Lo) -> Int { ints_get(lo.last, 0) }
fn co_last_transfers(lo: Lo) -> Bool { ints_get(lo.last, 1) == 1 }

// --- the document's functions ----------------------------------------------------------------

// Every function of the compilation, in the checker's order, one line each: its identity, a tab,
// and either its `nazm.core-ir/3` object without `digest` (compact, its members in the printed
// order) or `-` and what the lowering stopped at.
// The comparison's whole output (`run.sh core`): `cr_functions`, `cr_parts`, and — where every
// function and every part was carried — `%%document` on a line of its own and the document
// `nazm core-ir` prints, byte for byte (`print.rs`, indented), from the same values.
pub fn cr_core(f: Facts) -> Str {
    let functions = cr_functions(f);
    let parts = cr_parts(f);
    let lines = strs_new();
    let fl = co_lines(functions);
    let pl = co_lines(parts);
    let mut whole = true;
    let objects = strs_new();
    let mut i = 0;
    while i < strs_len(fl) {
        let line = strs_get(fl, i);
        let value = str_slice(line, co_tab(line) + 1, str_len(line));
        if co_stopped_value(value) { whole = false; }
        strs_push(objects, value);
        i = i + 1;
    }
    let members = strs_new();
    strs_push(members, co_field_first("schema", json_str("nazm.core-ir/3")));
    i = 0;
    while i < strs_len(pl) {
        let line = strs_get(pl, i);
        let tab = co_tab(line);
        let name = str_slice(line, 1, tab);
        let value = str_slice(line, tab + 1, str_len(line));
        if co_stopped_value(value) { whole = false; }
        strs_push(members, co_field(name, value));
        if name == "entry" { strs_push(members, co_field("functions", co_list(objects))); }
        i = i + 1;
    }
    strs_push(lines, functions);
    strs_push(lines, parts);
    if whole {
        let doc = cdg_pretty(co_object(members));
        if doc != "" {
            strs_push(lines, str_concat("%%document", co_nl()));
            strs_push(lines, doc);
        }
    }
    str_join(lines, "")
}

// Where a line's tab is; whether a value is a stop (`- REASON`).
fn co_tab(line: Str) -> Int {
    let mut i = 0;
    while i < str_len(line) && str_byte(line, i) != 9 { i = i + 1; }
    i
}
fn co_stopped_value(v: Str) -> Bool { str_len(v) >= 2 && str_byte(v, 0) == 45 && str_byte(v, 1) == 32 }

// `s`'s lines, without their line breaks.
fn co_lines(s: Str) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 10 {
            strs_push(out, str_slice(s, from, i));
            from = i + 1;
        }
        i = i + 1;
    }
    if from < str_len(s) { strs_push(out, str_slice(s, from, str_len(s))); }
    out
}

pub fn cr_functions(f: Facts) -> Str {
    let c = fx_checker(f);
    let out = strs_new();
    let mut i = 0;
    while i < ck_fn_count(c) {
        strs_push(out, fx_fn_identity(f, i));
        strs_push(out, str_from_byte(9));
        strs_push(out, cr_function(f, i));
        strs_push(out, co_nl());
        i = i + 1;
    }
    str_join(out, "")
}

// The document's other parts (task 5.1c), one line each — `%NAME`, a tab, and its value as
// `print.rs` writes it compactly, or `- ` and why it is not carried: the entry, the modules, the
// type table, the statics, the impl table and `derived_hash`.
pub fn cr_parts(f: Facts) -> Str {
    let c = fx_checker(f);
    let idents = strs_new();
    let mut m = 0;
    while m < fx_modules(f) {
        strs_push(idents, fx_module_identity(f, m));
        m = m + 1;
    }
    let out = strs_new();
    // The entry: the root module's `main` (`Resolution::entry`).
    let mut entry = "null";
    let mut i = 0;
    while i < ck_fn_count(c) {
        if ck_fn_module(c, i) == 0 && ck_fn_name(c, i) == "main" && ck_fn_closure(c, i) == false && ck_fn_method(c, i) == false { entry = json_str(fx_fn_identity(f, i)); }
        i = i + 1;
    }
    co_part(out, "entry", entry);
    // Every module in load order: its name, whether it is the root or the prelude, its imports.
    let modules = strs_new();
    m = 0;
    while m < fx_modules(f) {
        let o = strs_new();
        strs_push(o, co_field_first("name", json_str(strs_get(idents, m))));
        strs_push(o, co_field("root", co_json_bool(m == 0)));
        strs_push(o, co_field("prelude", co_json_bool(m == fx_modules(f) - 1)));
        let imports = strs_new();
        let mut k = 0;
        while k < ck_module_deps(c, m) {
            strs_push(imports, json_str(strs_get(idents, ck_module_dep(c, m, k))));
            k = k + 1;
        }
        strs_push(o, co_field("imports", co_list(imports)));
        strs_push(modules, co_object(o));
        m = m + 1;
    }
    co_part(out, "modules", co_list(modules));
    co_part(out, "types", ck_types_json(c, idents));
    co_part(out, "statics", co_statics(f, idents));
    co_part(out, "impls", co_impls(f, idents));
    // The trait a record, enum or tuple derives, with its two methods.
    let h = ck_derived_hash(c);
    let mut derived = "null";
    if h >= 0 && ck_trait_has_method(c, h, "hash") && ck_trait_has_method(c, h, "same") {
        let key = fx_trait_identity(f, h);
        let o = strs_new();
        strs_push(o, co_field_first("trait", json_str(key)));
        strs_push(o, co_field("hash", json_str(str_concat(key, ".hash"))));
        strs_push(o, co_field("same", json_str(str_concat(key, ".same"))));
        derived = co_object(o);
    }
    co_part(out, "derived_hash", derived);
    str_join(out, "")
}

// Every static (`StaticDef`), module by module in the checker's order and each module's in
// declaration order: a read-only value, or an `Atomic`'s cell and what it starts as.
fn co_statics(f: Facts, idents: Strs) -> Str {
    let c = fx_checker(f);
    let t = fx_tree(f);
    let rows = strs_new();
    let mut m = 0;
    while m < fx_modules(f) {
        let list = ck_module_statics(c, m);
        let ident = strs_get(idents, m);
        let mut i = 0;
        while i + 3 < strs_len(list) {
            let name = strs_get(list, i);
            let value = strs_get(list, i + 3);
            if value == "-" { return "- a static whose value is not computed"; }
            let decl = co_static_decl(t, fx_module_program(f, m), name);
            let ns = sx_field(t, decl, "name_span");
            let o = strs_new();
            strs_push(o, co_field_first("def", json_str(str_concat(str_concat(ident, "::static "), name))));
            strs_push(o, co_field("module", json_str(ident)));
            strs_push(o, co_field("name", json_str(name)));
            strs_push(o, co_field("type", json_str(strs_get(list, i + 2))));
            strs_push(o, co_field("cell", co_json_bool(strs_get(list, i + 1) == "cell")));
            strs_push(o, co_field("value", value));
            strs_push(o, co_field("section", co_json_or_null(co_section(t, decl))));
            let range = str_concat(str_concat(int_to_str(sx_s(t, ns)), ".."), int_to_str(sx_e(t, ns)));
            strs_push(o, co_field("at", json_str(str_concat(str_concat(ident, ":"), range))));
            strs_push(rows, co_object(o));
            i = i + 4;
        }
        m = m + 1;
    }
    co_list(rows)
}

// A module's first static of this name.
fn co_static_decl(t: Tree, program: Int, name: Str) -> Int {
    let consts = sx_items(t, sx_field(t, program, "consts"));
    let mut k = 0;
    while k < ints_len(consts) {
        let d = ints_get(consts, k);
        if sx_text(t, sx_field(t, d, "is_static")) == "true" && sx_name(t, d, "name") == name { return d; }
        k = k + 1;
    }
    0 - 1
}

// The one string argument of a declaration's `@section`, or "" (`section_of`).
fn co_section(t: Tree, decl: Int) -> Str { co_string_attr(t, decl, "section") }

// A declaration's first attribute of this name, or -1.
fn co_attr(t: Tree, decl: Int, name: Str) -> Int {
    let attrs = sx_items(t, sx_field(t, decl, "attrs"));
    let mut k = 0;
    while k < ints_len(attrs) {
        if sx_name(t, ints_get(attrs, k), "name") == name { return ints_get(attrs, k); }
        k = k + 1;
    }
    0 - 1
}

// The one string argument of a declaration's attribute `name`, or "" (`string_attr`).
fn co_string_attr(t: Tree, decl: Int, name: Str) -> Str {
    let a = co_attr(t, decl, name);
    if a < 0 || sx_is_some(t, sx_field(t, a, "args")) == false { return ""; }
    let args = sx_items(t, sx_unwrap(t, sx_field(t, a, "args")));
    if ints_len(args) == 1 && sx_text(t, ints_get(args, 0)) == "Str" { return sx_text(t, sx_field(t, ints_get(args, 0), "value")); }
    ""
}

// A function's `@task(priority = "N", period = "P")` (`task_of`): its priority and period where
// both are written and in range, or `null`.
fn co_task(t: Tree, decl: Int) -> Str {
    let a = co_attr(t, decl, "task");
    if a < 0 || sx_is_some(t, sx_field(t, a, "args")) == false { return "null"; }
    let args = sx_items(t, sx_unwrap(t, sx_field(t, a, "args")));
    let mut priority = "";
    let mut period = "";
    let mut k = 0;
    while k < ints_len(args) {
        let x = ints_get(args, k);
        if sx_text(t, x) == "Pair" {
            let key = sx_name(t, x, "key");
            let value = sx_name(t, x, "value");
            if key == "priority" {
                priority = "";
                if co_digits(value) && str_len(value) <= 3 && int_from_digits(value) <= 255 { priority = int_to_str(int_from_digits(value)); }
            } else {
                if key == "period" {
                    period = "";
                    if co_digits(value) && str_len(value) <= 18 && int_from_digits(value) >= 1 { period = int_to_str(int_from_digits(value)); }
                } else {
                    return "null";
                }
            }
        }
        k = k + 1;
    }
    if priority == "" || period == "" { return "null"; }
    let o = strs_new();
    strs_push(o, co_field_first("priority", priority));
    strs_push(o, co_field("period", period));
    co_object(o)
}

fn co_digits(s: Str) -> Bool {
    if str_len(s) == 0 { return false; }
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) < 48 || str_byte(s, i) > 57 { return false; }
        i = i + 1;
    }
    true
}

fn int_from_digits(s: Str) -> Int {
    let mut v = 0;
    let mut i = 0;
    while i < str_len(s) {
        v = v * 10 + str_byte(s, i) - 48;
        i = i + 1;
    }
    v
}

// The impl table (`ImplRow`): each impl the coherence table answers with, every method of its
// trait by the function a call runs — the impl's own, with no type argument, or the default
// body, with the impl's type — in the order the impls were filed.
fn co_impls(f: Facts, idents: Strs) -> Str {
    let c = fx_checker(f);
    let rows = strs_new();
    let mut i = 0;
    while i < ck_impl_count(c) {
        let tr = ck_impl_trait(c, i);
        if ck_impl_answers(c, i) {
            let key = fx_trait_identity(f, tr);
            let self_ty = json_str(ck_durable(c, ck_impl_type(c, i), idents));
            let methods = strs_new();
            let mut whole = true;
            let mut k = 0;
            while k < ck_trait_method_count(c, tr) {
                let mut fun = ck_impl_fn(c, i, k);
                let mut args = "[]";
                let mut default = false;
                if fun < 0 {
                    fun = ck_trait_method_default(c, tr, k);
                    args = str_concat(str_concat("[", self_ty), "]");
                    default = true;
                }
                if fun < 0 { whole = false; }
                if fun >= 0 {
                    let o = strs_new();
                    strs_push(o, co_field_first("method", json_str(str_concat(str_concat(key, "."), ck_trait_method_name(c, tr, k)))));
                    strs_push(o, co_field("function", json_str(fx_fn_identity(f, fun))));
                    strs_push(o, co_field("type_args", args));
                    strs_push(o, co_field("default", co_json_bool(default)));
                    strs_push(methods, co_object(o));
                }
                k = k + 1;
            }
            if whole {
                let o = strs_new();
                strs_push(o, co_field_first("trait", json_str(key)));
                strs_push(o, co_field("self", self_ty));
                strs_push(o, co_field("methods", co_list(methods)));
                strs_push(rows, co_object(o));
            }
        }
        i = i + 1;
    }
    co_list(rows)
}

fn co_part(out: Strs, name: Str, value: Str) -> Int {
    strs_push(out, str_concat(str_concat(str_concat("%", name), str_from_byte(9)), value));
    strs_push(out, co_nl());
    0
}

// Function `i`'s object, or `-` and why it is not carried.
pub fn cr_function(f: Facts, i: Int) -> Str {
    let c = fx_checker(f);
    let idents = strs_new();
    let mut m = 0;
    while m < fx_modules(f) {
        strs_push(idents, fx_module_identity(f, m));
        m = m + 1;
    }
    let lo = Lo(f: f, c: c, t: fx_tree(f), st: ints_new(), stop: strs_new(), lb: ints_new(), lname: strs_new(), lty: ints_new(), lorig: strs_new(),
            lat: strs_new(), lshr: ints_new(), ckey: strs_new(), cty: strs_new(), cval: strs_new(), cstatic: strs_new(), targets: ints_new(), ofirst: ints_new(), owned: ints_new(),
            last: ints_new(), idents: idents);
    ints_push(lo.st, i);
    ints_push(lo.st, ck_fn_module(c, i));
    ints_push(lo.st, fx_module_base(f, ck_fn_module(c, i)));
    ints_push(lo.st, 0);
    ints_push(lo.last, 0 - 1);
    ints_push(lo.last, 0);
    let text = co_function(lo, i);
    if co_halted(lo) { return str_concat("- ", strs_get(lo.stop, 0)); }
    text
}

fn co_function(lo: Lo, i: Int) -> Str {
    let c = lo.c;
    let t = lo.t;
    let closure = ck_fn_closure(c, i);
    if closure == false {
        if ck_fn_is_foreign(c, i) { return co_stopped(lo, "a foreign function"); }
        if ck_fn_effect_param(c, i) { return co_stopped(lo, "an effect parameter"); }
    }
    let node = ck_fn_node(c, i);
    let mut body_node = 0 - 1;
    if closure {
        body_node = sx_field(t, node, "body");
    } else {
        if sx_is_some(t, sx_field(t, node, "body")) == false { return co_stopped(lo, "a function without a body"); }
        if ints_len(sx_items(t, sx_field(t, node, "contracts"))) > 0 { return co_stopped(lo, "a contract"); }
        body_node = sx_unwrap(t, sx_field(t, node, "body"));
    }
    if ck_fn_required(c, i) < 0 { return co_stopped(lo, "a function whose effects were not settled"); }
    // A closure's body is handed the closure first (N50): what its captures are read from.
    let seed = ints_new();
    if closure {
        let cty = ck_closure_ty(c, i);
        if cty < 0 { return co_stopped(lo, "a closure the checker gave no type"); }
        co_local(lo, 0 - 2, "env", cty, 0 - 1, "param", co_tree_span(lo, sx_field(t, node, "span")));
    }
    // Its locals are its bindings, parameters first, in the order the checker made them; a
    // closure's copy of each binding it captures where the checker made it, among them (`bind`).
    let mut b = 0;
    let mut n = 0;
    let mut k = 0;
    let caps = ck_capture_count(c);
    while b <= ck_binding_count(c) {
        while k < caps && ck_capture_at(c, k) <= b {
            if ck_capture_closure(c, k) == i {
                let r = ck_capture_binding(c, k);
                ints_push(seed, co_local(lo, r, ck_binding_name(c, r), ck_binding_ty(c, r), co_shared_elem(lo, r), "let", "synthetic"));
                n = n + 1;
            }
            k = k + 1;
        }
        if b < ck_binding_count(c) && ck_binding_fn(c, b) == i {
            if ck_binding_start(c, b) < 0 { co_halt(lo, "a binding declared nowhere"); }
            let mut origin = "let";
            if n < ck_fn_param_count(c, i) { origin = "param"; } else { if ck_binding_mutable(c, b) { origin = "let mut"; } }
            co_local(lo, b, ck_binding_name(c, b), ck_binding_ty(c, b), co_shared_elem(lo, b), origin, co_span_text(lo, ck_binding_start(c, b), ck_binding_end(c, b)));
            n = n + 1;
        }
        b = b + 1;
    }
    let body = co_value_block_in(lo, body_node, seed);
    if co_halted(lo) { return ""; }
    let f = lo.f;
    let declared = ck_fn_declared(c, i);
    let required = ck_fn_required(c, i);
    let mut published = required;
    if declared >= 0 { published = declared; }
    let out = strs_new();
    strs_push(out, co_field_first("def", json_str(fx_fn_identity(f, i))));
    strs_push(out, co_field("module", json_str(fx_module_identity(f, co_g(lo, co_s_module())))));
    strs_push(out, co_field("name", json_str(ck_fn_name(c, i))));
    // A closure in a generic function is generic over that function's parameters (L10), and
    // is handed itself first.
    let mut owner = i;
    while ck_fn_closure(c, owner) { owner = ck_fn_enclosing(c, owner); }
    let mut params = ck_fn_param_count(c, i);
    if closure { params = params + 1; }
    strs_push(out, co_field("type_params", int_to_str(ck_fn_type_params(c, owner))));
    strs_push(out, co_field("params", int_to_str(params)));
    strs_push(out, co_field("ret", json_str(co_durable(lo, ck_fn_ret_ty(c, i)))));
    let effects = strs_new();
    if declared < 0 { strs_push(effects, co_field_first("declared", "null")); } else { strs_push(effects, co_field_first("declared", co_effect_list(declared))); }
    strs_push(effects, co_field("required", co_effect_list(required)));
    strs_push(effects, co_field("published", co_effect_list(published)));
    strs_push(effects, co_field("pure", co_json_bool(published == 0)));
    strs_push(out, co_field("effects", co_object(effects)));
    strs_push(out, co_field("authority", co_authority(lo, i)));
    strs_push(out, co_field("locals", co_locals(lo)));
    strs_push(out, co_field("consts", co_consts(lo)));
    strs_push(out, co_field("loops", int_to_str(co_g(lo, co_s_loops()))));
    strs_push(out, co_field("pub", co_json_bool(ck_fn_public(c, i))));
    strs_push(out, co_field("closure", co_json_bool(closure)));
    let captured = strs_new();
    let mut s = 0;
    while s < ints_len(seed) {
        strs_push(captured, int_to_str(ints_get(seed, s)));
        s = s + 1;
    }
    strs_push(out, co_field("captures", co_list(captured)));
    let attributes = strs_new();
    if closure {
        strs_push(attributes, co_field_first("export", "null"));
        strs_push(attributes, co_field("section", "null"));
        strs_push(attributes, co_field("interrupt", "null"));
        strs_push(attributes, co_field("task", "null"));
        strs_push(attributes, co_field("on_failure", "false"));
    } else {
        strs_push(attributes, co_field_first("export", co_json_or_null(ck_fn_export(c, i))));
        strs_push(attributes, co_field("section", co_json_or_null(co_section(t, node))));
        strs_push(attributes, co_field("interrupt", co_json_or_null(co_string_attr(t, node, "interrupt"))));
        strs_push(attributes, co_field("task", co_task(t, node)));
        strs_push(attributes, co_field("on_failure", co_json_bool(co_attr(t, node, "on_failure") >= 0)));
    }
    strs_push(out, co_field("attributes", co_object(attributes)));
    strs_push(out, co_field("at", json_str(co_tree_span(lo, sx_field(t, node, "span")))));
    strs_push(out, co_field("body", body));
    // Its digests, from what is printed (`digest.nz`), after `authority`.
    let digest = cdg_digest(co_object(out));
    if digest == "" { return co_stopped(lo, "what its digest needs, not printed"); }
    let whole = strs_new();
    let mut m = 0;
    while m < strs_len(out) {
        strs_push(whole, strs_get(out, m));
        if m == 7 { strs_push(whole, co_field("digest", digest)); }
        m = m + 1;
    }
    co_object(whole)
}

// A local: the binding it is (-1 for a temporary, -2 for a closure's own), its name, type, the
// type its cell holds where a closure shares it (-1), origin and where; its id.
fn co_local(lo: Lo, b: Int, name: Str, ty: Int, shared: Int, origin: Str, at: Str) -> Int {
    ints_push(lo.lb, b);
    strs_push(lo.lname, name);
    ints_push(lo.lshr, shared);
    if shared >= 0 { ints_push(lo.lty, ck_cell_of(lo.c, shared)); } else { ints_push(lo.lty, ty); }
    strs_push(lo.lorig, origin);
    strs_push(lo.lat, at);
    strs_len(lo.lname) - 1
}

// The type binding `b` holds if a closure shares it, and so a cell (R1b, L10); else -1.
fn co_shared_elem(lo: Lo, b: Int) -> Int {
    if ck_binding_shared(lo.c, b) { return ck_binding_ty(lo.c, b); }
    0 - 1
}

fn co_stopped(lo: Lo, why: Str) -> Str {
    co_halt(lo, why);
    ""
}

// The capabilities it is handed, each kind once, in `CapabilityKind::ALL`'s order.
fn co_authority(lo: Lo, i: Int) -> Str {
    let c = lo.c;
    let orders = ints_new();
    let names = strs_new();
    let mut k = 0;
    while k < ck_fn_param_count(c, i) {
        let pt = ck_fn_param_ty(c, i, k);
        if ck_is_cap(c, pt) {
            let o = ck_cap_order(c, pt);
            let mut at = 0;
            while at < ints_len(orders) && ints_get(orders, at) < o { at = at + 1; }
            let present = at < ints_len(orders) && ints_get(orders, at) == o;
            if present == false {
                ints_push(orders, 0);
                strs_push(names, "");
                let mut j = ints_len(orders) - 1;
                while j > at {
                    ints_set(orders, j, ints_get(orders, j - 1));
                    strs_set(names, j, strs_get(names, j - 1));
                    j = j - 1;
                }
                ints_set(orders, at, o);
                strs_set(names, at, json_str(co_durable(lo, pt)));
            }
        }
        k = k + 1;
    }
    co_list(names)
}

fn co_locals(lo: Lo) -> Str {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(lo.lname) {
        let o = strs_new();
        strs_push(o, co_field_first("id", int_to_str(i)));
        strs_push(o, co_field("name", json_str(strs_get(lo.lname, i))));
        strs_push(o, co_field("type", json_str(co_durable(lo, ints_get(lo.lty, i)))));
        strs_push(o, co_field("origin", json_str(strs_get(lo.lorig, i))));
        strs_push(o, co_field("at", json_str(strs_get(lo.lat, i))));
        strs_push(out, co_object(o));
        i = i + 1;
    }
    co_list(out)
}

fn co_consts(lo: Lo) -> Str {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(lo.ckey) {
        let o = strs_new();
        strs_push(o, co_field_first("id", int_to_str(i)));
        strs_push(o, co_field("type", json_str(strs_get(lo.cty, i))));
        strs_push(o, co_field("value", strs_get(lo.cval, i)));
        if strs_get(lo.cstatic, i) != "" { strs_push(o, co_field("static", json_str(strs_get(lo.cstatic, i)))); }
        strs_push(out, co_object(o));
        i = i + 1;
    }
    co_list(out)
}

// --- identities ----------------------------------------------------------------------------------

fn co_durable(lo: Lo, t: Int) -> Str {
    if t < 0 { return "never"; }
    let d = ck_durable(lo.c, t, lo.idents);
    if d == "?" { co_halt(lo, "a type Core IR does not name yet"); }
    d
}

// A span of the function's module as `Names::span` writes it: the module and the byte range.
fn co_span_text(lo: Lo, s: Int, e: Int) -> Str {
    let base = co_g(lo, co_s_base());
    str_concat(str_concat(fx_module_identity(lo.f, co_g(lo, co_s_module())), ":"), str_concat(str_concat(int_to_str(s - base), ".."), int_to_str(e - base)))
}

fn co_tree_span(lo: Lo, span: Int) -> Str {
    let base = co_g(lo, co_s_base());
    co_span_text(lo, sx_s(lo.t, span) + base, sx_e(lo.t, span) + base)
}

fn co_abs_s(lo: Lo, span: Int) -> Int { sx_s(lo.t, span) + co_g(lo, co_s_base()) }
fn co_abs_e(lo: Lo, span: Int) -> Int { sx_e(lo.t, span) + co_g(lo, co_s_base()) }

// The local the name written at `span` is, or -1 having stopped.
fn co_local_at(lo: Lo, span: Int) -> Int {
    let b = ck_binding_at(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
    if b < 0 {
        co_halt(lo, "a name that is no binding");
        return 0;
    }
    let l = co_index_of(lo.lb, b);
    if l < 0 {
        co_halt(lo, "a binding of another function");
        return 0;
    }
    l
}

fn co_index_of(xs: Ints, v: Int) -> Int {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == v { return i; }
        i = i + 1;
    }
    0 - 1
}

// The constant of this type and value, made once (`constant`).
fn co_constant(lo: Lo, ty: Str, value: Str) -> Int {
    let key = str_concat(str_concat(ty, ":"), value);
    let mut i = 0;
    while i < strs_len(lo.ckey) {
        if strs_get(lo.ckey, i) == key { return i; }
        i = i + 1;
    }
    strs_push(lo.ckey, key);
    strs_push(lo.cty, ty);
    strs_push(lo.cval, value);
    strs_push(lo.cstatic, "");
    strs_len(lo.ckey) - 1
}

// A static `Atomic`'s cell (`Const::Cell`), made once: `static NAME`, and its durable key.
fn co_cell_constant(lo: Lo, name: Str, key: Str) -> Int {
    let k = str_concat(str_concat("Atomic:", key), "");
    let mut i = 0;
    while i < strs_len(lo.ckey) {
        if strs_get(lo.ckey, i) == k { return i; }
        i = i + 1;
    }
    strs_push(lo.ckey, k);
    strs_push(lo.cty, "Atomic");
    strs_push(lo.cval, json_str(str_concat("static ", name)));
    strs_push(lo.cstatic, key);
    strs_len(lo.ckey) - 1
}

fn co_open_region(lo: Lo) -> Int {
    ints_push(lo.ofirst, ints_len(lo.owned));
    0
}

// The locals bound directly in the region closed, printed.
fn co_close_region(lo: Lo) -> Str {
    let first = ints_pop(lo.ofirst);
    let out = strs_new();
    let mut i = first;
    while i < ints_len(lo.owned) {
        strs_push(out, int_to_str(ints_get(lo.owned, i)));
        i = i + 1;
    }
    while ints_len(lo.owned) > first { ints_pop(lo.owned); }
    co_list(out)
}

fn co_bind(lo: Lo, l: Int) -> Int {
    if ints_len(lo.ofirst) > 0 { ints_push(lo.owned, l); }
    0
}

// --- regions ---------------------------------------------------------------------------------------

// A region whose value is wanted (`value_block`): its statements, then its tail unless they
// transfer.
fn co_value_block(lo: Lo, b: Int) -> Str { co_value_block_in(lo, b, ints_new()) }

// A region that owns the locals in `seed` before any it binds itself (an arm's bindings).
fn co_open_seeded(lo: Lo, seed: Ints) -> Int {
    co_open_region(lo);
    let mut i = 0;
    while i < ints_len(seed) {
        ints_push(lo.owned, ints_get(seed, i));
        i = i + 1;
    }
    0
}

fn co_value_block_in(lo: Lo, b: Int, seed: Ints) -> Str { co_value_block_pre(lo, b, seed, strs_new()) }

fn co_value_block_pre(lo: Lo, b: Int, seed: Ints, prefix: Strs) -> Str {
    let t = lo.t;
    co_open_seeded(lo, seed);
    let stmts = strs_new();
    co_push_all(stmts, prefix);
    let transfers = co_statements(lo, sx_items(t, sx_field(t, b, "statements")), stmts);
    let mut tail = "null";
    let mut ty = 0 - 1;
    if transfers == false {
        if sx_is_some(t, sx_field(t, b, "tail")) {
            tail = co_expr(lo, sx_unwrap(t, sx_field(t, b, "tail")));
            ty = co_last_ty(lo);
        } else {
            co_halt(lo, "a block whose value is wanted with no final expression");
        }
    }
    let owns = co_close_region(lo);
    co_set_last(lo, ty, transfers);
    co_block_json(lo, transfers, owns, stmts, tail, sx_field(t, b, "span"))
}

// A region whose value is not wanted (`statement_block`): its tail, if written, a statement.
fn co_statement_block(lo: Lo, b: Int) -> Str { co_statement_block_in(lo, b, ints_new()) }

fn co_statement_block_in(lo: Lo, b: Int, seed: Ints) -> Str { co_statement_block_pre(lo, b, seed, strs_new()) }

// A statement block whose lowered statements follow `prefix` (a `for` loop's step, which never
// transfers).
fn co_statement_block_pre(lo: Lo, b: Int, seed: Ints, prefix: Strs) -> Str {
    let t = lo.t;
    co_open_seeded(lo, seed);
    let stmts = strs_new();
    let mut p = 0;
    while p < strs_len(prefix) {
        strs_push(stmts, strs_get(prefix, p));
        p = p + 1;
    }
    let mut transfers = co_statements(lo, sx_items(t, sx_field(t, b, "statements")), stmts);
    if transfers == false && sx_is_some(t, sx_field(t, b, "tail")) {
        strs_push(stmts, co_effect(lo, sx_unwrap(t, sx_field(t, b, "tail"))));
        transfers = co_last_transfers(lo);
    }
    let owns = co_close_region(lo);
    co_set_last(lo, 0 - 1, transfers);
    co_block_json(lo, transfers, owns, stmts, "null", sx_field(t, b, "span"))
}

fn co_block_json(lo: Lo, transfers: Bool, owns: Str, stmts: Strs, tail: Str, span: Int) -> Str {
    let o = strs_new();
    strs_push(o, co_field_first("ends", co_ends(transfers)));
    strs_push(o, co_field("owns", owns));
    strs_push(o, co_field("stmts", co_list(stmts)));
    strs_push(o, co_field("tail", tail));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, span))));
    co_object(o)
}

fn co_ends(transfers: Bool) -> Str {
    if transfers { return json_str("transfers"); }
    json_str("falls-through")
}

// The statements, each lowered until one transfers; whether one did.
fn co_statements(lo: Lo, list: Ints, out: Strs) -> Bool {
    let mut i = 0;
    while i < ints_len(list) {
        strs_push(out, co_stmt(lo, ints_get(list, i)));
        if co_last_transfers(lo) { return true; }
        i = i + 1;
    }
    false
}

// --- statements --------------------------------------------------------------------------------

fn co_stmt(lo: Lo, s: Int) -> Str {
    let t = lo.t;
    let k = sx_text(t, s);
    if k == "Break" || k == "Continue" {
        if ints_len(lo.targets) == 0 { return co_stopped_stmt(lo, "a `break` outside a loop body"); }
        let o = strs_new();
        if k == "Break" { strs_push(o, co_op_first("break")); } else { strs_push(o, co_op_first("continue")); }
        strs_push(o, co_field("loop", int_to_str(ints_get(lo.targets, ints_len(lo.targets) - 1))));
        strs_push(o, co_field("ends", co_ends(true)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, s, "span")))));
        co_set_last(lo, 0 - 1, true);
        return co_object(o);
    }
    if sx_kind(t, s) != tk_tuple() { return co_stopped_stmt(lo, str_concat("the statement ", k)); }
    let n = sx_kid(t, s, 0);
    if k == "Expr" { return co_effect(lo, n); }
    if k == "Let" {
        if co_some_field(lo, n, "pattern") { return co_stopped_stmt(lo, "a `let` of a pattern"); }
        let mut value = co_expr(lo, sx_field(t, n, "value"));
        let local = co_local_at(lo, sx_field(t, n, "name_span"));
        // Shared with a closure (R1b, L10): a cell made holding the value.
        if co_halted(lo) == false && ints_get(lo.lshr, local) >= 0 { value = co_made_cell(lo, local, value, sx_field(t, n, "span")); }
        co_bind(lo, local);
        let o = strs_new();
        strs_push(o, co_op_first("let"));
        strs_push(o, co_field("local", int_to_str(local)));
        strs_push(o, co_field("value", value));
        strs_push(o, co_field("ends", co_ends(false)));
        co_set_last(lo, 0 - 1, false);
        return co_object(o);
    }
    if k == "Assign" {
        let place = sx_field(t, n, "place");
        if ints_len(sx_items(t, sx_field(t, place, "path"))) > 0 { return co_stopped_stmt(lo, "an assignment to a field or an element"); }
        let mut value = co_expr(lo, sx_field(t, n, "value"));
        let local = co_local_at(lo, sx_field(t, place, "name_span"));
        // `x = v` on a shared binding (R1b, L10): the cell's one value replaced.
        if co_halted(lo) == false && ints_get(lo.lshr, local) >= 0 {
            let set = co_through_cell(lo, local, value, sx_field(t, n, "span"));
            let o = strs_new();
            strs_push(o, co_op_first("eval"));
            strs_push(o, co_field("value", set));
            strs_push(o, co_field("ends", co_ends(false)));
            co_set_last(lo, 0 - 1, false);
            return co_object(o);
        }
        // `s = str_concat(s, t)`, `s = s + t`, `s += t` (R1b, D2): an append (`appends_to`).
        if co_appends(lo, local, sx_field(t, n, "value"), value) {
            value = str_concat(co_append_head(), str_slice(value, str_len(co_concat_head()), str_len(value)));
        }
        let o = strs_new();
        strs_push(o, co_op_first("assign"));
        strs_push(o, co_field("local", int_to_str(local)));
        strs_push(o, co_field("path", "[]"));
        strs_push(o, co_field("value", value));
        strs_push(o, co_field("ends", co_ends(false)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
        co_set_last(lo, 0 - 1, false);
        return co_object(o);
    }
    if k == "While" {
        // Numbered where the `while` is; its condition is outside its own target.
        let id = co_g(lo, co_s_loops());
        co_sv(lo, co_s_loops(), id + 1);
        let cond = co_expr(lo, sx_field(t, n, "cond"));
        ints_push(lo.targets, id);
        let body = co_statement_block(lo, sx_field(t, n, "body"));
        ints_pop(lo.targets);
        let o = strs_new();
        strs_push(o, co_op_first("loop"));
        strs_push(o, co_field("loop", int_to_str(id)));
        strs_push(o, co_field("cond", cond));
        strs_push(o, co_field("body", body));
        strs_push(o, co_field("ends", co_ends(false)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
        co_set_last(lo, 0 - 1, false);
        return co_object(o);
    }
    if k == "For" {
        // Numbered where the `for` is, as a `while` is; its hidden locals are its own region's.
        let id = co_g(lo, co_s_loops());
        co_sv(lo, co_s_loops(), id + 1);
        co_open_region(lo);
        let stmts = co_for(lo, n, id);
        let owns = co_close_region(lo);
        if co_halted(lo) { return co_stopped_stmt(lo, "a `for` loop"); }
        let o = strs_new();
        strs_push(o, co_op_first("block"));
        strs_push(o, co_field("body", co_block_json(lo, false, owns, stmts, "null", sx_field(t, n, "span"))));
        strs_push(o, co_field("ends", co_ends(false)));
        co_set_last(lo, 0 - 1, false);
        return co_object(o);
    }
    if k == "Spawn" {
        let args = strs_new();
        let list = sx_items(t, sx_field(t, n, "args"));
        let mut i = 0;
        while i < ints_len(list) {
            strs_push(args, co_expr(lo, ints_get(list, i)));
            i = i + 1;
        }
        let cs = sx_field(t, n, "callee_span");
        let site = ck_site_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs));
        if site < 0 || ck_site_fn(lo.c, site) < 0 { return co_stopped_stmt(lo, "a task whose function the checker did not resolve"); }
        if co_halted(lo) { return co_stopped_stmt(lo, "a task"); }
        let o = strs_new();
        strs_push(o, co_op_first("spawn"));
        strs_push(o, co_field("callee", json_str(fx_fn_identity(lo.f, ck_site_fn(lo.c, site)))));
        strs_push(o, co_field("args", co_list(args)));
        strs_push(o, co_field("ends", co_ends(false)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
        co_set_last(lo, 0 - 1, false);
        return co_object(o);
    }
    if k == "Scope" {
        let body = co_statement_block(lo, sx_field(t, n, "body"));
        let transfers = co_last_transfers(lo);
        let o = strs_new();
        strs_push(o, co_op_first("scope"));
        strs_push(o, co_field("body", body));
        strs_push(o, co_field("ends", co_ends(transfers)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
        co_set_last(lo, 0 - 1, transfers);
        return co_object(o);
    }
    if k == "Return" {
        let value = co_expr(lo, sx_field(t, n, "value"));
        let o = strs_new();
        strs_push(o, co_op_first("return"));
        strs_push(o, co_field("value", value));
        strs_push(o, co_field("ends", co_ends(true)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
        co_set_last(lo, 0 - 1, true);
        return co_object(o);
    }
    co_stopped_stmt(lo, str_concat("the statement ", k))
}

// A `for` loop as the `while` loop it means (`for_loop`): `let seq = e; let mut i = 0;
// while i < len(seq) { let x = get(seq, i); i = i + 1; body }`, or `let mut i = a; let end = b;
// while i < end { let x = i; i = i + 1; body }` — every hidden part at the loop's name.
fn co_for(lo: Lo, n: Int, id: Int) -> Strs {
    let t = lo.t;
    let c = lo.c;
    let at = sx_field(t, n, "name_span");
    let tint = ck_t_int();
    let stmts = strs_new();
    let index = co_temp(lo, "i", tint, at);
    let iter = sx_field(t, n, "iter");
    let mut bound = "";
    let mut seq = 0 - 1;
    let mut get = "";
    let mut elem = 0 - 1;
    let mut targs = "[]";
    if sx_kind(t, iter) != tk_tuple() && sx_text(t, iter) == "Range" {
        let start = co_expr(lo, sx_field(t, iter, "start"));
        let end = co_expr(lo, sx_field(t, iter, "end"));
        strs_push(stmts, co_let(index, start));
        co_bind(lo, index);
        let last = co_temp(lo, "end", tint, at);
        strs_push(stmts, co_let(last, end));
        co_bind(lo, last);
        bound = co_read(lo, last, at);
    } else {
        let e = sx_kid(t, iter, 0);
        if co_split_call(lo, e) { return co_split_loop(lo, n, id, index, e, stmts); }
        let value = co_expr(lo, e);
        let sty = co_last_ty(lo);
        if co_halted(lo) { return stmts; }
        let kind = ck_seq_kind(c, sty);
        let mut len = "";
        if kind == "bytes" {
            len = "bytes_len";
            get = "bytes_get";
            elem = ck_t_named(c, "UInt8");
        }
        if kind == "ints" || kind == "strs" {
            len = str_concat(kind, "_len");
            get = str_concat(kind, "_get");
            elem = tint;
            if kind == "strs" { elem = ck_t_str(); }
        }
        if kind == "vec" || kind == "chain" {
            len = str_concat(kind, "_len");
            get = str_concat(kind, "_get");
            elem = ck_type_arg(c, sty, 0);
            targs = co_list_one(json_str(co_durable(lo, elem)));
        }
        if len == "" {
            co_halt(lo, "a `for` over a type the checker refuses");
            return stmts;
        }
        seq = co_temp(lo, "seq", sty, at);
        strs_push(stmts, co_let(seq, value));
        co_bind(lo, seq);
        let zero = co_constant(lo, "Int", "0");
        strs_push(stmts, co_let(index, co_node(lo, "const", co_field_first("const", int_to_str(zero)), tint, at)));
        co_bind(lo, index);
        bound = co_builtin(lo, len, targs, co_read(lo, seq, at), tint, at);
    }
    let cond = co_less(lo, co_read(lo, index, at), bound, at);
    let name = co_local_at(lo, at);
    let one = co_constant(lo, "Int", "1");
    let mut element = co_read(lo, index, at);
    if seq >= 0 {
        let args = strs_new();
        strs_push(args, co_read(lo, seq, at));
        strs_push(args, co_read(lo, index, at));
        element = co_builtin(lo, get, targs, str_join(args, ","), elem, at);
    }
    let step = strs_new();
    strs_push(step, co_let(name, element));
    strs_push(step, co_assign(lo, index, co_add(lo, co_read(lo, index, at), co_node(lo, "const", co_field_first("const", int_to_str(one)), tint, at), at), at));
    strs_push(stmts, co_loop(lo, id, cond, n, name, step));
    stmts
}

// The loop of a `for`: its body lowered after its step, the loop's name owned first.
fn co_loop(lo: Lo, id: Int, cond: Str, n: Int, name: Int, step: Strs) -> Str {
    let t = lo.t;
    ints_push(lo.targets, id);
    let seed = ints_new();
    ints_push(seed, name);
    let body = co_statement_block_pre(lo, sx_field(t, n, "body"), seed, step);
    ints_pop(lo.targets);
    let o = strs_new();
    strs_push(o, co_op_first("loop"));
    strs_push(o, co_field("loop", int_to_str(id)));
    strs_push(o, co_field("cond", cond));
    strs_push(o, co_field("body", body));
    strs_push(o, co_field("ends", co_ends(false)));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, n, "span")))));
    co_object(o)
}

// Whether `e` calls `@std/text`'s `text_split`, and the module has the two functions a `for`
// reads a split through (`split_each`).
fn co_split_call(lo: Lo, e: Int) -> Bool {
    let t = lo.t;
    if sx_kind(t, e) == tk_tuple() || sx_text(t, e) != "Call" { return false; }
    let cs = sx_field(t, e, "callee_span");
    let site = ck_site_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs));
    if site < 0 { return false; }
    let callee = ck_site_fn(lo.c, site);
    if callee < 0 { return false; }
    callee == co_text_fn(lo, "text_split") && co_text_fn(lo, "text_split_end") >= 0 && co_text_fn(lo, "text_split_next") >= 0
}

// `@std/text`'s function of this name, or -1.
fn co_text_fn(lo: Lo, name: Str) -> Int {
    let c = lo.c;
    let mut i = 0;
    while i < ck_fn_count(c) {
        if ck_fn_name(c, i) == name && ck_fn_closure(c, i) == false && ck_fn_method(c, i) == false {
            if strs_get(lo.idents, ck_fn_module(c, i)) == "@std/text" { return i; }
        }
        i = i + 1;
    }
    0 - 1
}

// `for x in text_split(s, sep)` (`split_loop`): `let s = …; let sep = …; let mut i = 0;
// let mut end = 0; while i < str_len(s) + 1 { end = text_split_end(s, sep, i);
// let x = str_slice(s, i, end); i = text_split_next(s, sep, end); body }`.
fn co_split_loop(lo: Lo, n: Int, id: Int, index: Int, e: Int, stmts: Strs) -> Strs {
    let t = lo.t;
    let at = sx_field(t, n, "name_span");
    let tint = ck_t_int();
    let tstr = ck_t_str();
    let list = sx_items(t, sx_field(t, e, "args"));
    if ints_len(list) != 2 {
        co_halt(lo, "a `text_split` call without two arguments");
        return stmts;
    }
    let sv = co_expr(lo, ints_get(list, 0));
    let sepv = co_expr(lo, ints_get(list, 1));
    if co_halted(lo) { return stmts; }
    let s = co_temp(lo, "seq", tstr, at);
    strs_push(stmts, co_let(s, sv));
    co_bind(lo, s);
    let sep = co_temp(lo, "seq", tstr, at);
    strs_push(stmts, co_let(sep, sepv));
    co_bind(lo, sep);
    let zero = co_constant(lo, "Int", "0");
    strs_push(stmts, co_let(index, co_node(lo, "const", co_field_first("const", int_to_str(zero)), tint, at)));
    co_bind(lo, index);
    let end = co_temp(lo, "end", tint, at);
    strs_push(stmts, co_let(end, co_node(lo, "const", co_field_first("const", int_to_str(zero)), tint, at)));
    co_bind(lo, end);
    let one = co_constant(lo, "Int", "1");
    let len = co_builtin(lo, "str_len", "[]", co_read(lo, s, at), tint, at);
    let cond = co_less(lo, co_read(lo, index, at), co_add(lo, len, co_node(lo, "const", co_field_first("const", int_to_str(one)), tint, at), at), at);
    let name = co_local_at(lo, at);
    let step = strs_new();
    strs_push(step, co_assign(lo, end, co_split_call_of(lo, "text_split_end", s, sep, co_read(lo, index, at), at), at));
    let slice = strs_new();
    strs_push(slice, co_read(lo, s, at));
    strs_push(slice, co_read(lo, index, at));
    strs_push(slice, co_read(lo, end, at));
    strs_push(step, co_let(name, co_builtin(lo, "str_slice", "[]", str_join(slice, ","), tstr, at)));
    strs_push(step, co_assign(lo, index, co_split_call_of(lo, "text_split_next", s, sep, co_read(lo, end, at), at), at));
    strs_push(stmts, co_loop(lo, id, cond, n, name, step));
    stmts
}

fn co_split_call_of(lo: Lo, name: Str, s: Int, sep: Int, last: Str, at: Int) -> Str {
    let args = strs_new();
    strs_push(args, co_read(lo, s, at));
    strs_push(args, co_read(lo, sep, at));
    strs_push(args, last);
    let fields = strs_new();
    strs_push(fields, co_field_first("callee", json_str(fx_fn_identity(lo.f, co_text_fn(lo, name)))));
    strs_push(fields, co_field("type_args", "[]"));
    strs_push(fields, co_field("args", co_list(args)));
    co_node(lo, "call", str_join(fields, ""), ck_t_int(), at)
}

// A local made by the lowering (`temp`): its name, type and where.
fn co_temp(lo: Lo, name: Str, ty: Int, span: Int) -> Int {
    ints_push(lo.lb, 0 - 1);
    ints_push(lo.lshr, 0 - 1);
    strs_push(lo.lname, name);
    ints_push(lo.lty, ty);
    strs_push(lo.lorig, str_concat("temp ", name));
    strs_push(lo.lat, co_tree_span(lo, span));
    strs_len(lo.lname) - 1
}

// Local `l`, read at `span`.
fn co_read(lo: Lo, l: Int, span: Int) -> Str { co_node(lo, "local", co_field_first("local", int_to_str(l)), ints_get(lo.lty, l), span) }

fn co_let(l: Int, value: Str) -> Str {
    let o = strs_new();
    strs_push(o, co_op_first("let"));
    strs_push(o, co_field("local", int_to_str(l)));
    strs_push(o, co_field("value", value));
    strs_push(o, co_field("ends", co_ends(false)));
    co_object(o)
}

fn co_assign(lo: Lo, l: Int, value: Str, span: Int) -> Str {
    let o = strs_new();
    strs_push(o, co_op_first("assign"));
    strs_push(o, co_field("local", int_to_str(l)));
    strs_push(o, co_field("path", "[]"));
    strs_push(o, co_field("value", value));
    strs_push(o, co_field("ends", co_ends(false)));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, span))));
    co_object(o)
}

// A built-in's call, its arguments already printed and joined.
fn co_builtin(lo: Lo, name: Str, targs: Str, args: Str, ty: Int, span: Int) -> Str {
    let fields = strs_new();
    strs_push(fields, co_field_first("builtin", json_str(name)));
    strs_push(fields, co_field("type_args", targs));
    strs_push(fields, co_field("args", str_concat(str_concat("[", args), "]")));
    co_node(lo, "builtin", str_join(fields, ""), ty, span)
}

// `lhs < rhs` of `Int`s, and `lhs + rhs`.
fn co_less(lo: Lo, lhs: Str, rhs: Str, span: Int) -> Str {
    let fields = strs_new();
    strs_push(fields, co_field_first("operand", json_str("Int")));
    strs_push(fields, co_field("law", json_str("int")));
    strs_push(fields, co_field("lhs", lhs));
    strs_push(fields, co_field("rhs", rhs));
    co_node(lo, "<", str_join(fields, ""), ck_t_bool(), span)
}
fn co_add(lo: Lo, lhs: Str, rhs: Str, span: Int) -> Str {
    let fields = strs_new();
    strs_push(fields, co_field_first("lhs", lhs));
    strs_push(fields, co_field("rhs", rhs));
    co_node(lo, "+", str_join(fields, ""), ck_t_int(), span)
}

fn co_list_one(item: Str) -> Str { str_concat(str_concat("[", item), "]") }

fn co_stopped_stmt(lo: Lo, why: Str) -> Str {
    co_halt(lo, why);
    co_set_last(lo, 0 - 1, false);
    ""
}

fn co_some_field(lo: Lo, n: Int, name: Str) -> Bool {
    let f = sx_field(lo.t, n, name);
    if f < 0 { return false; }
    sx_is_some(lo.t, f)
}

// Whether `value`, lowered as `lowered`, is `str_concat(x, t)` — a call or `x + t` on strings —
// with `x` the name of local `local` (`appends_to`).
fn co_appends(lo: Lo, local: Int, value: Int, lowered: Str) -> Bool {
    let t = lo.t;
    let head = co_concat_head();
    if str_len(lowered) < str_len(head) || str_slice(lowered, 0, str_len(head)) != head { return false; }
    let k = sx_text(t, value);
    let mut first = 0 - 1;
    if k == "Binary" { first = sx_field(t, value, "lhs"); }
    if k == "Call" {
        let args = sx_items(t, sx_field(t, value, "args"));
        if ints_len(args) > 0 { first = ints_get(args, 0); }
    }
    if first < 0 || sx_kind(t, first) == tk_tuple() || sx_text(t, first) != "Var" { return false; }
    let span = sx_field(t, first, "span");
    let b = ck_binding_at(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
    if b < 0 { return false; }
    co_index_of(lo.lb, b) == local
}

fn co_concat_head() -> Str { "{\"op\":\"builtin\",\"builtin\":\"str_concat\"" }
fn co_append_head() -> Str { "{\"op\":\"builtin\",\"builtin\":\"str_append\"" }

// An expression where no value is wanted (`effect`).
fn co_effect(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let k = sx_text(t, e);
    if k == "If" {
        let cond = co_expr(lo, sx_field(t, e, "cond"));
        let then = co_statement_block(lo, sx_field(t, e, "then_block"));
        let then_transfers = co_last_transfers(lo);
        let mut otherwise = "null";
        let mut transfers = false;
        if sx_is_some(t, sx_field(t, e, "else_block")) {
            otherwise = co_statement_block(lo, sx_unwrap(t, sx_field(t, e, "else_block")));
            transfers = then_transfers && co_last_transfers(lo);
        }
        let o = strs_new();
        strs_push(o, co_op_first("if"));
        strs_push(o, co_field("cond", cond));
        strs_push(o, co_field("then", then));
        strs_push(o, co_field("else", otherwise));
        strs_push(o, co_field("ends", co_ends(transfers)));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, e, "span")))));
        co_set_last(lo, 0 - 1, transfers);
        return co_object(o);
    }
    if k == "Match" { return co_match(lo, e, false); }
    if sx_kind(t, e) == tk_tuple() && k == "Block" {
        let body = co_statement_block(lo, sx_kid(t, e, 0));
        let transfers = co_last_transfers(lo);
        let o = strs_new();
        strs_push(o, co_op_first("block"));
        strs_push(o, co_field("body", body));
        strs_push(o, co_field("ends", co_ends(transfers)));
        co_set_last(lo, 0 - 1, transfers);
        return co_object(o);
    }
    let value = co_expr(lo, e);
    // `exit_with` ends the process: the statement transfers.
    let exits = sx_text(t, e) == "Call" && co_ends_process(lo, e);
    let o = strs_new();
    strs_push(o, co_op_first("eval"));
    strs_push(o, co_field("value", value));
    strs_push(o, co_field("ends", co_ends(exits)));
    co_set_last(lo, 0 - 1, exits);
    co_object(o)
}

fn co_ends_process(lo: Lo, e: Int) -> Bool {
    let cs = sx_field(lo.t, e, "callee_span");
    let site = ck_site_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs));
    if site < 0 { return false; }
    if ck_site_builtin(lo.c, site) < 0 { return false; }
    ck_builtin_name(lo.c, ck_site_builtin(lo.c, site)) == "exit_with"
}

// --- values --------------------------------------------------------------------------------------

fn co_expr(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let k = sx_text(t, e);
    // `Point(1, 2)`, `Circle(2)` (R1.5, D4): a call the checker read as a construction.
    if k == "Call" && sx_kind(t, e) != tk_tuple() {
        let cs = sx_field(t, e, "callee_span");
        if ck_site_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) < 0 {
            if ck_construction_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) >= 0 || ck_variant_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) >= 0 {
                return co_construction(lo, cs, cs, sx_items(t, sx_field(t, e, "args")), true);
            }
        }
    }
    // `Dot` (R1.5, D4): a name the checker read as a variant with no payload.
    if k == "Var" && sx_kind(t, e) != tk_tuple() {
        let vs = sx_field(t, e, "span");
        if ck_binding_at(lo.c, co_abs_s(lo, vs), co_abs_e(lo, vs)) < 0 && ck_variant_at(lo.c, co_abs_s(lo, vs), co_abs_e(lo, vs)) >= 0 {
            return co_variant(lo, vs, vs, ints_new(), false);
        }
    }
    if k == "Construct" && sx_kind(t, e) != tk_tuple() {
        let ts = sx_field(t, e, "ty_span");
        if ck_construction_at(lo.c, co_abs_s(lo, ts), co_abs_e(lo, ts)) < 0 && ck_variant_at(lo.c, co_abs_s(lo, ts), co_abs_e(lo, ts)) >= 0 {
            return co_variant(lo, ts, ts, sx_items(t, sx_field(t, e, "fields")), false);
        }
        return co_construction(lo, ts, ts, sx_items(t, sx_field(t, e, "fields")), false);
    }
    if k == "Variant" && sx_kind(t, e) != tk_tuple() {
        let vs = sx_field(t, e, "variant_span");
        let fields = sx_items(t, sx_field(t, e, "fields"));
        // `x.m` with no arguments, parsed as a variant: the method call the checker read it as.
        if ints_len(fields) == 0 && ck_site_at(lo.c, co_abs_s(lo, vs), co_abs_e(lo, vs)) >= 0 {
            return co_method(lo, vs, sx_field(t, e, "span"), 0 - 1, sx_text(t, sx_field(t, e, "ty")), sx_field(t, e, "ty_span"), ints_new());
        }
        return co_variant(lo, sx_field(t, e, "ty_span"), vs, fields, false);
    }
    if k == "Tuple" && sx_kind(t, e) != tk_tuple() { return co_tuple(lo, e); }
    if sx_kind(t, e) == tk_tuple() {
        if k == "Block" {
            let b = sx_kid(t, e, 0);
            let body = co_value_block(lo, b);
            let ty = co_last_ty(lo);
            return co_node(lo, "block", co_field_first("body", body), ty, sx_field(t, b, "span"));
        }
        return co_stopped(lo, str_concat("the expression ", k));
    }
    let span = sx_field(t, e, "span");
    if k == "Int" || k == "WideInt" { return co_integer(lo, sx_text(t, sx_field(t, e, "value")), span); }
    if k == "Bool" {
        let id = co_constant(lo, "Bool", sx_text(t, sx_field(t, e, "value")));
        return co_node(lo, "const", co_field_first("const", int_to_str(id)), ck_t_bool(), span);
    }
    if k == "Str" {
        let lt = ck_literal_ty(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
        if lt != ck_t_str() { return co_stopped(lo, "a string literal of a type other than `Str`"); }
        let v = sx_text(t, sx_field(t, e, "value"));
        let id = co_constant(lo, "Str", co_str_value(v));
        return co_node(lo, "const", co_field_first("const", int_to_str(id)), ck_t_str(), span);
    }
    if k == "Var" { return co_var(lo, sx_text(t, sx_field(t, e, "name")), span); }
    if k == "Closure" { return co_closure(lo, e); }
    if k == "Neg" {
        // A literal negated, of a type the checker gave it (`integer`): the negative constant,
        // at the literal.
        let x = sx_field(t, e, "operand");
        if sx_kind(t, x) != tk_tuple() && (sx_text(t, x) == "Int" || sx_text(t, x) == "WideInt") {
            let xs = sx_field(t, x, "span");
            if ck_type_class(lo.c, ck_literal_ty(lo.c, co_abs_s(lo, xs), co_abs_e(lo, xs))) == "integer" {
                return co_integer(lo, co_negated(sx_text(t, sx_field(t, x, "value"))), xs);
            }
        }
        let operand = co_expr(lo, sx_field(t, e, "operand"));
        let mut ty = co_last_ty(lo);
        if ty < 0 { ty = ck_t_int(); }
        return co_node(lo, "neg", co_field_first("operand", operand), ty, sx_field(t, e, "op_span"));
    }
    if k == "Not" {
        let operand = co_expr(lo, sx_field(t, e, "operand"));
        let at = sx_field(t, e, "op_span");
        let no = co_boolean(lo, "false", at);
        let yes = co_boolean(lo, "true", at);
        return co_conditional(lo, operand, no, yes, ck_t_bool(), at);
    }
    if k == "Binary" { return co_binary(lo, e); }
    // A record's field, read (`ExprKind::Field`), at its name.
    if k == "Field" {
        let ns = sx_field(t, e, "name_span");
        let index = ck_field_index(lo.c, co_abs_s(lo, ns), co_abs_e(lo, ns));
        if index < 0 { return co_stopped(lo, "a field read the checker did not record"); }
        let base = co_expr(lo, sx_field(t, e, "base"));
        let fields = strs_new();
        strs_push(fields, co_field_first("field", int_to_str(index)));
        strs_push(fields, co_field("name", json_str(ck_field_name(lo.c, co_abs_s(lo, ns), co_abs_e(lo, ns)))));
        strs_push(fields, co_field("base", base));
        return co_node(lo, "field", str_join(fields, ""), ck_field_ty(lo.c, co_abs_s(lo, ns), co_abs_e(lo, ns)), ns);
    }
    if k == "Call" { return co_call(lo, e); }
    if k == "Index" { return co_index(lo, e); }
    if k == "MethodCall" {
        return co_method(lo, sx_field(t, e, "method_span"), sx_field(t, e, "span"), sx_field(t, e, "receiver"), "", 0 - 1, sx_items(t, sx_field(t, e, "args")));
    }
    if k == "Propagate" { return co_propagate(lo, e); }
    if k == "Interp" { return co_interp(lo, e); }
    if k == "Match" { return co_match(lo, e, true); }
    if k == "If" {
        if sx_is_some(t, sx_field(t, e, "else_block")) == false { return co_stopped(lo, "an `if` with no `else` where a value is wanted"); }
        let cond = co_expr(lo, sx_field(t, e, "cond"));
        let then = co_value_block(lo, sx_field(t, e, "then_block"));
        let then_ty = co_last_ty(lo);
        let otherwise = co_value_block(lo, sx_unwrap(t, sx_field(t, e, "else_block")));
        let mut ty = then_ty;
        if ty < 0 { ty = co_last_ty(lo); }
        let fields = strs_new();
        strs_push(fields, co_field_first("cond", cond));
        strs_push(fields, co_field("then", then));
        strs_push(fields, co_field("else", otherwise));
        return co_node(lo, "if", str_join(fields, ""), ty, span);
    }
    co_stopped(lo, str_concat("the expression ", k))
}

// A construction at `ts` (the checker recorded it at `ts`): a record's, or a variant's where the
// checker read it as one; `items` its fields as written, or its arguments where `positional`.
fn co_construction(lo: Lo, ts: Int, vs: Int, items: Ints, positional: Bool) -> Str {
    let c = lo.c;
    let rt = ck_construction_at(c, co_abs_s(lo, ts), co_abs_e(lo, ts));
    if rt < 0 {
        if ck_variant_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs)) >= 0 { return co_variant(lo, ts, vs, items, positional); }
        return co_stopped(lo, "a construction the checker did not resolve");
    }
    if ck_is_record_type(c, rt) == false { return co_stopped(lo, "a construction of no record"); }
    let fields = co_inits(lo, items, positional, rt, 0 - 1);
    if co_halted(lo) { return ""; }
    let members = strs_new();
    strs_push(members, co_field_first("arity", int_to_str(ck_record_arity(c, rt))));
    strs_push(members, co_field("fields", fields));
    co_node(lo, "record", str_join(members, ""), rt, ts)
}

// `Enum.Variant(…)`, at `ts`, its variant named at `vs` (`ExprKind::Variant`).
fn co_variant(lo: Lo, ts: Int, vs: Int, items: Ints, positional: Bool) -> Str {
    let c = lo.c;
    let et = ck_variant_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
    if et < 0 { return co_stopped(lo, "a variant the checker did not resolve"); }
    let v = ck_variant_index_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
    let fields = co_inits(lo, items, positional, et, v);
    if co_halted(lo) { return ""; }
    let members = strs_new();
    strs_push(members, co_field_first("variant", int_to_str(v)));
    strs_push(members, co_field("name", json_str(ck_variant_name(c, et, v))));
    strs_push(members, co_field("arity", int_to_str(ck_variant_arity(c, et, v))));
    strs_push(members, co_field("fields", fields));
    co_node(lo, "variant", str_join(members, ""), et, ts)
}

// The fields given, in the order written: each one's place in the declaration, its name and its
// value. A record's where `v` is -1, else variant `v`'s payload.
fn co_inits(lo: Lo, items: Ints, positional: Bool, ty: Int, v: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let out = strs_new();
    let mut i = 0;
    while i < ints_len(items) {
        let item = ints_get(items, i);
        let mut value = item;
        let mut s = 0;
        let mut e = 0;
        if positional {
            s = co_abs_s(lo, expr_span(t, item));
            e = s;
        } else {
            value = sx_field(t, item, "value");
            s = co_abs_s(lo, sx_field(t, item, "name_span"));
            e = co_abs_e(lo, sx_field(t, item, "name_span"));
        }
        let f = ck_init_at(c, s, e);
        if f < 0 {
            co_halt(lo, "a field the checker did not resolve");
            return "";
        }
        let mut name = "";
        if v < 0 { name = ck_record_field_name(c, ty, f); } else { name = ck_payload_name(c, ty, v, f); }
        let x = co_expr(lo, value);
        let o = strs_new();
        strs_push(o, co_field_first("field", int_to_str(f)));
        strs_push(o, co_field("name", json_str(name)));
        strs_push(o, co_field("value", x));
        strs_push(out, co_object(o));
        i = i + 1;
    }
    co_list(out)
}

// --- match ---------------------------------------------------------------------------------------

// Whether every arm is plain (`plain_arm`): a variant pattern whose fields bind or discard, and
// no guard.
fn co_plain_arms(lo: Lo, arms: Ints) -> Bool {
    let t = lo.t;
    let mut i = 0;
    while i < ints_len(arms) {
        let arm = ints_get(arms, i);
        if co_some_field(lo, arm, "guard") { return false; }
        let p = sx_field(t, arm, "pattern");
        if sx_kind(t, p) != tk_tuple() || sx_text(t, p) != "Variant" { return false; }
        let fields = sx_items(t, sx_field(t, sx_kid(t, p, 0), "fields"));
        let mut k = 0;
        while k < ints_len(fields) {
            let fp = sx_text(t, sx_field(t, ints_get(fields, k), "pattern"));
            if fp != "Bind" && fp != "Wildcard" { return false; }
            k = k + 1;
        }
        i = i + 1;
    }
    true
}

// A `match` of plain arms (`matching`), as a value or as a statement.
fn co_match(lo: Lo, e: Int, value: Bool) -> Str {
    let t = lo.t;
    let c = lo.c;
    let arms = sx_items(t, sx_field(t, e, "arms"));
    if co_plain_arms(lo, arms) == false { return co_general(lo, e, value); }
    let scrutinee = co_expr(lo, sx_field(t, e, "scrutinee"));
    let sty = co_last_ty(lo);
    let mut enumeration = 0 - 1;
    if ck_is_enum_type(c, sty) { enumeration = sty; }
    let lowered = strs_new();
    let mut ty = 0 - 1;
    let mut all_transfer = ints_len(arms) > 0;
    let mut i = 0;
    while i < ints_len(arms) && co_halted(lo) == false {
        let arm = ints_get(arms, i);
        let vp = sx_kid(t, sx_field(t, arm, "pattern"), 0);
        let vs = sx_field(t, vp, "variant_span");
        let et = ck_variant_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
        if et < 0 { return co_stopped(lo, "an arm whose variant the checker did not resolve"); }
        let vi = ck_variant_index_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
        if enumeration < 0 { enumeration = et; }
        let bindings = strs_new();
        let seed = ints_new();
        let fields = sx_items(t, sx_field(t, vp, "fields"));
        let mut k = 0;
        while k < ints_len(fields) {
            let f = ints_get(fields, k);
            let pat = sx_field(t, f, "pattern");
            if sx_text(t, pat) == "Bind" {
                let ns = sx_field(t, f, "name_span");
                let fi = ck_init_at(c, co_abs_s(lo, ns), co_abs_e(lo, ns));
                if fi < 0 { return co_stopped(lo, "a pattern field the checker did not resolve"); }
                let l = co_local_at(lo, sx_field(t, pat, "span"));
                if co_halted(lo) { return ""; }
                ints_push(seed, l);
                let o = strs_new();
                strs_push(o, co_field_first("field", int_to_str(fi)));
                strs_push(o, co_field("name", json_str(ck_payload_name(c, et, vi, fi))));
                strs_push(o, co_field("local", int_to_str(l)));
                strs_push(bindings, co_object(o));
            }
            k = k + 1;
        }
        let body = co_arm_region(lo, sx_field(t, arm, "body"), seed, value);
        if co_last_ty(lo) >= 0 { ty = co_last_ty(lo); }
        if co_last_transfers(lo) == false { all_transfer = false; }
        let o = strs_new();
        strs_push(o, co_field_first("variant", int_to_str(vi)));
        strs_push(o, co_field("name", json_str(ck_variant_name(c, et, vi))));
        strs_push(o, co_field("bindings", co_list(bindings)));
        strs_push(o, co_field("body", body));
        strs_push(o, co_field("at", json_str(co_tree_span(lo, sx_field(t, arm, "span")))));
        strs_push(lowered, co_object(o));
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    if enumeration < 0 { return co_stopped(lo, "a `match` on something that is not an enum"); }
    let members = strs_new();
    strs_push(members, co_field_first("origin", json_str("written")));
    strs_push(members, co_field("enum", json_str(co_durable(lo, enumeration))));
    strs_push(members, co_field("scrutinee", scrutinee));
    strs_push(members, co_field("arms", co_list(lowered)));
    let span = sx_field(t, e, "span");
    if value { return co_node(lo, "match", str_join(members, ""), ty, span); }
    let transfers = sty < 0 || all_transfer;
    let o = strs_new();
    strs_push(o, co_op_first("match"));
    strs_push(o, str_concat(",", str_join(members, "")));
    strs_push(o, co_field("ends", co_ends(transfers)));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, span))));
    co_set_last(lo, 0 - 1, transfers);
    co_object(o)
}

// An interpolation (`interpolation`): each piece's text joined left to right by `str_concat` —
// an integer's digits by `str_concat_num` straight after the text before them — at the whole.
fn co_interp(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let at = sx_field(t, e, "span");
    let parts = sx_items(t, sx_field(t, e, "parts"));
    let mut acc = "";
    let mut i = 0;
    while i < ints_len(parts) && co_halted(lo) == false {
        let p = ints_get(parts, i);
        // What the piece is: its text, and — for an integer's digits unpadded — its type and value.
        let piece = strs_new();
        if sx_kind(t, p) == tk_tuple() && sx_text(t, p) == "Text" {
            strs_push(piece, co_str_const(lo, sx_text(t, sx_kid(t, p, 0)), at));
        } else {
            co_hole(lo, p, piece);
        }
        if co_halted(lo) { return ""; }
        if acc == "" {
            acc = strs_get(piece, 0);
        } else {
            let args = strs_new();
            strs_push(args, acc);
            if strs_len(piece) == 3 {
                strs_push(args, strs_get(piece, 2));
                acc = co_builtin(lo, "str_concat_num", co_list_one(json_str(strs_get(piece, 1))), str_join(args, ","), ck_t_str(), at);
            } else {
                strs_push(args, strs_get(piece, 0));
                acc = co_builtin(lo, "str_concat", "[]", str_join(args, ","), ck_t_str(), at);
            }
        }
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    if acc == "" { return co_str_const(lo, "", at); }
    co_set_last(lo, ck_t_str(), false);
    acc
}

// A `Str` constant at `span`.
fn co_str_const(lo: Lo, v: Str, span: Int) -> Str {
    let id = co_constant(lo, "Str", co_str_value(v));
    co_node(lo, "const", co_field_first("const", int_to_str(id)), ck_t_str(), span)
}

// One hole's text (`hole_text`) into `piece`: the text, then — where it is an integer's digits
// of at most 64 bits, unpadded — the integer's type and the value.
fn co_hole(lo: Lo, p: Int, piece: Strs) -> Int {
    let t = lo.t;
    let c = lo.c;
    let at = sx_field(t, p, "span");
    if ck_site_at(c, co_abs_s(lo, at), co_abs_e(lo, at)) >= 0 {
        co_halt(lo, "a hole's `show()`");
        return 0;
    }
    let v = co_expr(lo, sx_field(t, p, "expr"));
    let ty = co_last_ty(lo);
    if co_halted(lo) { return 0; }
    let class = ck_type_class(c, ty);
    let spec = sx_field(t, p, "spec");
    let mut text = "";
    let mut numeric = false;
    if class == "str" { text = v; }
    if class == "bool" {
        let yes = co_str_const(lo, "true", at);
        let no = co_str_const(lo, "false", at);
        text = co_conditional(lo, v, yes, no, ck_t_str(), at);
    }
    if class == "float" && sx_is_some(t, sx_field(t, spec, "precision")) {
        co_halt(lo, "a float's hole with a precision");
        return 0;
    }
    let name = co_durable(lo, ty);
    if class == "int" || class == "integer" || class == "float" {
        text = co_builtin(lo, "num_to_str", co_list_one(json_str(name)), v, ck_t_str(), at);
        numeric = true;
    }
    if text == "" {
        co_halt(lo, "a hole the checker gave no text");
        return 0;
    }
    let width = sx_field(t, spec, "width");
    if sx_is_some(t, width) == false {
        strs_push(piece, text);
        if class == "int" || (class == "integer" && name != "Int128" && name != "UInt128") {
            strs_push(piece, name);
            strs_push(piece, v);
        }
        return 0;
    }
    let mut start = numeric;
    let align = sx_field(t, spec, "align");
    if sx_is_some(t, align) { start = sx_text(t, sx_unwrap(t, align)) == "Right"; }
    let wid = co_constant(lo, "Int", sx_text(t, sx_unwrap(t, width)));
    let wexpr = co_node(lo, "const", co_field_first("const", int_to_str(wid)), ck_t_int(), at);
    let fill = co_str_const(lo, " ", at);
    let args = strs_new();
    strs_push(args, text);
    strs_push(args, wexpr);
    strs_push(args, fill);
    let mut op = "str_pad_end";
    if start { op = "str_pad_start"; }
    strs_push(piece, co_builtin(lo, op, "[]", str_join(args, ","), ck_t_str(), at));
    0
}

// `operand?` (`propagate`): a `match` of origin `propagate` on the operand's `Result` or `Option`
// — its success's payload the value, its failure returned in the function's own type — every
// part at the `?`.
fn co_propagate(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let at = sx_field(t, e, "op_span");
    let scrutinee = co_expr(lo, sx_field(t, e, "operand"));
    let ot = co_last_ty(lo);
    if co_halted(lo) { return ""; }
    let into = ck_fn_ret_ty(c, co_g(lo, co_s_fn()));
    if ck_is_enum_type(c, ot) == false || ck_is_enum_type(c, into) == false { return co_stopped(lo, "a `?` the checker did not resolve"); }
    let mut ok_name = "Ok";
    let mut err_name = "Err";
    if ck_variant_named(c, ot, "Ok") < 0 {
        ok_name = "Some";
        err_name = "None";
    }
    let okv = ck_variant_named(c, ot, ok_name);
    let errv = ck_variant_named(c, ot, err_name);
    let into_err = ck_variant_named(c, into, err_name);
    if okv < 0 || errv < 0 || into_err < 0 { return co_stopped(lo, "a `?` the checker did not resolve"); }
    let ok_ty = ck_type_arg(c, ot, 0);
    let ok = co_temp(lo, "ok", ok_ty, at);
    let mut err = 0 - 1;
    if ck_variant_arity(c, ot, errv) > 0 { err = co_temp(lo, "err", ck_type_arg(c, ot, 1), at); }
    let fields = strs_new();
    if err >= 0 && ck_variant_arity(c, into, into_err) > 0 {
        let o = strs_new();
        strs_push(o, co_field_first("field", "0"));
        strs_push(o, co_field("name", json_str(ck_payload_name(c, into, into_err, 0))));
        strs_push(o, co_field("value", co_read(lo, err, at)));
        strs_push(fields, co_object(o));
    }
    let members = strs_new();
    strs_push(members, co_field_first("variant", int_to_str(into_err)));
    strs_push(members, co_field("name", json_str(ck_variant_name(c, into, into_err))));
    strs_push(members, co_field("arity", int_to_str(ck_variant_arity(c, into, into_err))));
    strs_push(members, co_field("fields", co_list(fields)));
    let rebuilt = co_node(lo, "variant", str_join(members, ""), into, at);
    let leave = strs_new();
    strs_push(leave, co_op_first("return"));
    strs_push(leave, co_field("value", rebuilt));
    strs_push(leave, co_field("ends", co_ends(true)));
    strs_push(leave, co_field("at", json_str(co_tree_span(lo, at))));
    let arms = strs_new();
    let ok_stmts = strs_new();
    strs_push(arms, co_propagate_arm(lo, ot, okv, ok, ok_stmts, co_read(lo, ok, at), false, at));
    let err_stmts = strs_new();
    strs_push(err_stmts, co_object(leave));
    strs_push(arms, co_propagate_arm(lo, ot, errv, err, err_stmts, "null", true, at));
    let m = strs_new();
    strs_push(m, co_field_first("origin", json_str("propagate")));
    strs_push(m, co_field("enum", json_str(co_durable(lo, ot))));
    strs_push(m, co_field("scrutinee", scrutinee));
    strs_push(m, co_field("arms", co_list(arms)));
    co_node(lo, "match", str_join(m, ""), ok_ty, at)
}

fn co_propagate_arm(lo: Lo, et: Int, v: Int, local: Int, stmts: Strs, tail: Str, transfers: Bool, at: Int) -> Str {
    let c = lo.c;
    let bindings = strs_new();
    let owns = strs_new();
    if local >= 0 {
        let b = strs_new();
        strs_push(b, co_field_first("field", "0"));
        strs_push(b, co_field("name", json_str(ck_payload_name(c, et, v, 0))));
        strs_push(b, co_field("local", int_to_str(local)));
        strs_push(bindings, co_object(b));
        strs_push(owns, int_to_str(local));
    }
    let o = strs_new();
    strs_push(o, co_field_first("variant", int_to_str(v)));
    strs_push(o, co_field("name", json_str(ck_variant_name(c, et, v))));
    strs_push(o, co_field("bindings", co_list(bindings)));
    strs_push(o, co_field("body", co_block_json(lo, transfers, co_list(owns), stmts, tail, at)));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, at))));
    co_object(o)
}

// --- a general `match` (`matching_general`) -------------------------------------------------------

// `{ let scrutinee = e; let arm = <the first arm whose pattern matches>; <arm `arm`> }`, as a
// value (a block expression) or as a statement (a block statement), at the `match`.
fn co_general(lo: Lo, e: Int, value: Bool) -> Str {
    let t = lo.t;
    let at = sx_field(t, e, "span");
    let arms = sx_items(t, sx_field(t, e, "arms"));
    let sval = co_expr(lo, sx_field(t, e, "scrutinee"));
    let sty = co_last_ty(lo);
    if co_halted(lo) { return co_general_stop(lo, value); }
    if sty < 0 {
        co_halt(lo, "a `match` scrutinee the checker gave no type");
        return co_general_stop(lo, value);
    }
    if ints_len(arms) == 0 {
        co_halt(lo, "a `match` with no arms");
        return co_general_stop(lo, value);
    }
    co_open_region(lo);
    let stmts = strs_new();
    let st = co_temp(lo, "scrutinee", sty, at);
    co_bind(lo, st);
    strs_push(stmts, co_let(st, sval));
    let k = co_temp(lo, "arm", ck_t_int(), at);
    co_bind(lo, k);
    let n = ints_len(arms);
    let mut choose = co_int_const(lo, n - 1, at);
    let mut i = n - 2;
    while i >= 0 && co_halted(lo) == false {
        let arm = ints_get(arms, i);
        let mut test = co_test(lo, sx_field(t, arm, "pattern"), co_read(lo, st, at), sty);
        if co_some_field(lo, arm, "guard") { test = co_guarded(lo, test, arm, st, sty, at); }
        let here = co_int_const(lo, i, at);
        choose = co_conditional(lo, test, here, choose, ck_t_int(), at);
        i = i - 1;
    }
    strs_push(stmts, co_let(k, choose));
    // Each arm, chosen by `arm`: its bindings, then its body.
    let regions = strs_new();
    let rtys = ints_new();
    let rends = ints_new();
    i = 0;
    while i < n && co_halted(lo) == false {
        let arm = ints_get(arms, i);
        let pre = strs_new();
        let seed = co_arm_bindings(lo, arm, st, sty, at, pre);
        strs_push(regions, co_arm_region_pre(lo, sx_field(t, arm, "body"), seed, value, pre));
        ints_push(rtys, co_last_ty(lo));
        if co_last_transfers(lo) { ints_push(rends, 1); } else { ints_push(rends, 0); }
        i = i + 1;
    }
    if co_halted(lo) {
        co_close_region(lo);
        return co_general_stop(lo, value);
    }
    let mut chosen = strs_get(regions, n - 1);
    let mut cty = ints_get(rtys, n - 1);
    let mut cends = ints_get(rends, n - 1) == 1;
    i = n - 2;
    while i >= 0 {
        let here = co_int_const(lo, i, at);
        let fields = strs_new();
        strs_push(fields, co_field_first("operand", json_str("Int")));
        strs_push(fields, co_field("law", json_str("int")));
        strs_push(fields, co_field("lhs", co_read(lo, k, at)));
        strs_push(fields, co_field("rhs", here));
        let cond = co_node(lo, "==", str_join(fields, ""), ck_t_bool(), at);
        let region = strs_get(regions, i);
        if value {
            let mut ty = ints_get(rtys, i);
            if ty < 0 { ty = cty; }
            let ifs = strs_new();
            strs_push(ifs, co_field_first("cond", cond));
            strs_push(ifs, co_field("then", region));
            strs_push(ifs, co_field("else", chosen));
            let tail = co_node(lo, "if", str_join(ifs, ""), ty, at);
            chosen = co_block_json(lo, false, "[]", strs_new(), tail, at);
            cty = ty;
            cends = false;
        } else {
            let both = ints_get(rends, i) == 1 && cends;
            let o = strs_new();
            strs_push(o, co_op_first("if"));
            strs_push(o, co_field("cond", cond));
            strs_push(o, co_field("then", region));
            strs_push(o, co_field("else", chosen));
            strs_push(o, co_field("ends", co_ends(both)));
            strs_push(o, co_field("at", json_str(co_tree_span(lo, at))));
            let one = strs_new();
            strs_push(one, co_object(o));
            chosen = co_block_json(lo, both, "[]", one, "null", at);
            cends = both;
        }
        i = i - 1;
    }
    let mut tail = "null";
    let mut transfers = false;
    if value {
        tail = co_node(lo, "block", co_field_first("body", chosen), cty, at);
        transfers = cty < 0;
    } else {
        let o = strs_new();
        strs_push(o, co_op_first("block"));
        strs_push(o, co_field("body", chosen));
        strs_push(o, co_field("ends", co_ends(cends)));
        strs_push(stmts, co_object(o));
        transfers = cends;
    }
    let owns = co_close_region(lo);
    let block = co_block_json(lo, transfers, owns, stmts, tail, at);
    if value {
        // A block expression of the type its tail has.
        let mut ty = cty;
        if transfers { ty = 0 - 1; }
        return co_node(lo, "block", co_field_first("body", block), ty, at);
    }
    let o = strs_new();
    strs_push(o, co_op_first("block"));
    strs_push(o, co_field("body", block));
    strs_push(o, co_field("ends", co_ends(transfers)));
    co_set_last(lo, 0 - 1, transfers);
    co_object(o)
}

fn co_general_stop(lo: Lo, value: Bool) -> Str {
    if value { return ""; }
    co_set_last(lo, 0 - 1, false);
    ""
}

fn co_int_const(lo: Lo, n: Int, at: Int) -> Str {
    let id = co_constant(lo, "Int", int_to_str(n));
    co_node(lo, "const", co_field_first("const", int_to_str(id)), ck_t_int(), at)
}

fn co_push_all(out: Strs, xs: Strs) -> Int {
    let mut i = 0;
    while i < strs_len(xs) {
        strs_push(out, strs_get(xs, i));
        i = i + 1;
    }
    0
}

// The names a pattern binds, in the order written (`Pattern::bindings`): each one's span.
fn co_pattern_binds(lo: Lo, p: Int, out: Ints) -> Int {
    let t = lo.t;
    if sx_kind(t, p) == tk_tuple() {
        if sx_text(t, p) == "Variant" {
            let fields = sx_items(t, sx_field(t, sx_kid(t, p, 0), "fields"));
            let mut i = 0;
            while i < ints_len(fields) {
                co_pattern_binds(lo, sx_field(t, ints_get(fields, i), "pattern"), out);
                i = i + 1;
            }
        }
        return 0;
    }
    let k = sx_text(t, p);
    if k == "Bind" { ints_push(out, sx_field(t, p, "span")); }
    if k == "Tuple" {
        let elems = sx_items(t, sx_field(t, p, "elems"));
        let mut i = 0;
        while i < ints_len(elems) {
            co_pattern_binds(lo, ints_get(elems, i), out);
            i = i + 1;
        }
    }
    if k == "Or" {
        let alts = sx_items(t, sx_field(t, p, "alts"));
        if ints_len(alts) > 0 { co_pattern_binds(lo, ints_get(alts, 0), out); }
    }
    0
}

// Whether pattern `p` binds the name written at `bound` (by name, as `bindings` compares).
fn co_binds_name(lo: Lo, p: Int, name: Str) -> Bool {
    let spans = ints_new();
    co_pattern_binds(lo, p, spans);
    let mut i = 0;
    while i < ints_len(spans) {
        if co_span_name(lo, ints_get(spans, i)) == name { return true; }
        i = i + 1;
    }
    false
}

fn co_span_name(lo: Lo, span: Int) -> Str {
    let b = ck_binding_at(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
    if b < 0 { return ""; }
    ck_binding_name(lo.c, b)
}

// An arm's names, each bound out of the scrutinee (`arm_bindings`): the `let`s into `lets`, and
// the locals, returned.
fn co_arm_bindings(lo: Lo, arm: Int, st: Int, sty: Int, at: Int, lets: Strs) -> Ints {
    let t = lo.t;
    let p = sx_field(t, arm, "pattern");
    let spans = ints_new();
    co_pattern_binds(lo, p, spans);
    let seed = ints_new();
    let mut i = 0;
    while i < ints_len(spans) && co_halted(lo) == false {
        let bound = ints_get(spans, i);
        let local = co_local_at(lo, bound);
        let name = co_span_name(lo, bound);
        let x = co_extract(lo, p, co_read(lo, st, at), sty, name, ints_new());
        if x == "" {
            co_halt(lo, "a binding its pattern does not bind");
            return seed;
        }
        strs_push(lets, co_let(local, x));
        ints_push(seed, local);
        i = i + 1;
    }
    seed
}
// Whether `v` (of type `vt`) matches pattern `p` (`pattern_test`): a `Bool` of plain matches and
// comparisons, at the pattern.
fn co_test(lo: Lo, p: Int, v: Str, vt: Int) -> Str {
    let t = lo.t;
    let at = pattern_span(t, p);
    if sx_kind(t, p) == tk_tuple() {
        if sx_text(t, p) == "Literal" {
            let lit = co_expr(lo, sx_kid(t, p, 0));
            let law = co_eq_law(lo, vt);
            if law == "" { return co_stopped(lo, "a literal pattern against a type with no equality"); }
            let fields = strs_new();
            strs_push(fields, co_field_first("operand", json_str(co_durable(lo, vt))));
            strs_push(fields, co_field("law", json_str(law)));
            strs_push(fields, co_field("lhs", v));
            strs_push(fields, co_field("rhs", lit));
            return co_node(lo, "==", str_join(fields, ""), ck_t_bool(), at);
        }
        return co_variant_test(lo, sx_kid(t, p, 0), v, vt, at);
    }
    let k = sx_text(t, p);
    if k == "Wildcard" || k == "Bind" { return co_boolean(lo, "true", at); }
    if k == "Tuple" {
        let elems = sx_items(t, sx_field(t, p, "elems"));
        let mut acc = "";
        let mut i = ints_len(elems) - 1;
        while i >= 0 {
            let element = co_tuple_elem(lo, v, vt, i, at);
            let test = co_test(lo, ints_get(elems, i), element, ck_type_arg(lo.c, vt, i));
            if acc == "" { acc = test; } else { acc = co_conditional(lo, test, acc, co_boolean(lo, "false", at), ck_t_bool(), at); }
            i = i - 1;
        }
        if acc == "" { return co_boolean(lo, "true", at); }
        return acc;
    }
    if k == "Or" {
        let alts = sx_items(t, sx_field(t, p, "alts"));
        let tests = strs_new();
        let mut i = 0;
        while i < ints_len(alts) {
            strs_push(tests, co_test(lo, ints_get(alts, i), v, vt));
            i = i + 1;
        }
        if strs_len(tests) == 0 { return co_stopped(lo, "an or-pattern with no alternatives"); }
        let mut acc = strs_pop(tests);
        while strs_len(tests) > 0 {
            let test = strs_pop(tests);
            acc = co_conditional(lo, test, co_boolean(lo, "true", at), acc, ck_t_bool(), at);
        }
        return acc;
    }
    co_stopped(lo, str_concat("the pattern ", k))
}

// The law `==` follows for a type (`Law::of`), or "".
fn co_eq_law(lo: Lo, ty: Int) -> Str {
    let class = ck_type_class(lo.c, ty);
    if class == "int" { return "int"; }
    if class == "integer" || class == "float" { return "num"; }
    if class == "bool" { return "bool"; }
    if class == "str" || class == "text" { return "bytes"; }
    if class == "record" || class == "enum" || class == "array" || class == "box" || class == "chain" { return "structural"; }
    if class == "param" { return "parametric"; }
    ""
}

// A variant pattern's test: a `match` on `v` whose chosen variant's arm tests each field whose
// pattern tests something (read into a `temp payload`), and whose other arms are `false`.
fn co_variant_test(lo: Lo, vp: Int, v: Str, vt: Int, at: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    if ck_is_enum_type(c, vt) == false { return co_stopped(lo, "a variant pattern against a value that is not an enum"); }
    let vs = sx_field(t, vp, "variant_span");
    if ck_variant_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs)) < 0 { return co_stopped(lo, "a variant pattern the checker did not resolve"); }
    let chosen = ck_variant_index_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
    let n = ck_variant_count(c, vt);
    let fields = sx_items(t, sx_field(t, vp, "fields"));
    let arms = strs_new();
    let mut w = 0;
    while w < n && co_halted(lo) == false {
        co_open_region(lo);
        let bindings = strs_new();
        let owns = strs_new();
        let mut test = "";
        if w == chosen {
            let parts = strs_new();
            let mut i = 0;
            while i < ints_len(fields) {
                let f = ints_get(fields, i);
                let fp = sx_field(t, f, "pattern");
                let plain = sx_kind(t, fp) != tk_tuple() && (sx_text(t, fp) == "Wildcard" || sx_text(t, fp) == "Bind");
                if plain == false {
                    let ns = sx_field(t, f, "name_span");
                    let fi = ck_init_at(c, co_abs_s(lo, ns), co_abs_e(lo, ns));
                    if fi < 0 { return co_stopped(lo, "a pattern field the checker did not resolve"); }
                    let fty = ck_payload_ty(c, vt, chosen, fi);
                    let local = co_temp(lo, "payload", fty, ns);
                    strs_push(bindings, co_binding(lo, vt, chosen, fi, local));
                    strs_push(owns, int_to_str(local));
                    strs_push(parts, co_test(lo, fp, co_read(lo, local, ns), fty));
                }
                i = i + 1;
            }
            while strs_len(parts) > 0 {
                let part = strs_pop(parts);
                if test == "" { test = part; } else { test = co_conditional(lo, part, test, co_boolean(lo, "false", at), ck_t_bool(), at); }
            }
        }
        co_close_region(lo);
        if test == "" {
            if w == chosen { test = co_boolean(lo, "true", at); } else { test = co_boolean(lo, "false", at); }
        }
        strs_push(arms, co_arm_json(lo, vt, w, bindings, co_block_json(lo, false, co_list(owns), strs_new(), test, at), at));
        w = w + 1;
    }
    if co_halted(lo) { return ""; }
    co_match_node(lo, vt, v, arms, ck_t_bool(), at)
}

fn co_binding(lo: Lo, et: Int, v: Int, field: Int, local: Int) -> Str {
    let o = strs_new();
    strs_push(o, co_field_first("field", int_to_str(field)));
    strs_push(o, co_field("name", json_str(ck_payload_name(lo.c, et, v, field))));
    strs_push(o, co_field("local", int_to_str(local)));
    co_object(o)
}

fn co_arm_json(lo: Lo, et: Int, v: Int, bindings: Strs, body: Str, at: Int) -> Str {
    let o = strs_new();
    strs_push(o, co_field_first("variant", int_to_str(v)));
    strs_push(o, co_field("name", json_str(ck_variant_name(lo.c, et, v))));
    strs_push(o, co_field("bindings", co_list(bindings)));
    strs_push(o, co_field("body", body));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, at))));
    co_object(o)
}

fn co_match_node(lo: Lo, et: Int, scrutinee: Str, arms: Strs, ty: Int, at: Int) -> Str {
    let m = strs_new();
    strs_push(m, co_field_first("origin", json_str("written")));
    strs_push(m, co_field("enum", json_str(co_durable(lo, et))));
    strs_push(m, co_field("scrutinee", scrutinee));
    strs_push(m, co_field("arms", co_list(arms)));
    co_node(lo, "match", str_join(m, ""), ty, at)
}

// Element `i` of the tuple `v` (`tuple_element`): a read of its record's field.
fn co_tuple_elem(lo: Lo, v: Str, vt: Int, i: Int, at: Int) -> Str {
    if ck_is_tuple(lo.c, vt) == false { return co_stopped(lo, "a tuple pattern against a value that is not a tuple"); }
    let fields = strs_new();
    strs_push(fields, co_field_first("field", int_to_str(i)));
    strs_push(fields, co_field("name", json_str(int_to_str(i))));
    strs_push(fields, co_field("base", v));
    co_node(lo, "field", str_join(fields, ""), ck_type_arg(lo.c, vt, i), at)
}

// The value `name` takes when `v` (of type `vt`) matches `p` (`extract`), or "" where `p` does
// not bind it; its type into `tyout`.
fn co_extract(lo: Lo, p: Int, v: Str, vt: Int, name: Str, tyout: Ints) -> Str {
    let t = lo.t;
    let c = lo.c;
    let at = pattern_span(t, p);
    if sx_kind(t, p) != tk_tuple() {
        let k = sx_text(t, p);
        if k == "Bind" {
            if sx_name(t, p, "name") != name { return ""; }
            ints_push(tyout, vt);
            return v;
        }
        if k == "Tuple" {
            let elems = sx_items(t, sx_field(t, p, "elems"));
            let mut i = 0;
            while i < ints_len(elems) {
                if co_binds_name(lo, ints_get(elems, i), name) {
                    let element = co_tuple_elem(lo, v, vt, i, at);
                    return co_extract(lo, ints_get(elems, i), element, ck_type_arg(c, vt, i), name, tyout);
                }
                i = i + 1;
            }
            return "";
        }
        if k == "Or" {
            let alts = sx_items(t, sx_field(t, p, "alts"));
            let which = ints_new();
            let xs = strs_new();
            let tys = ints_new();
            let mut i = 0;
            while i < ints_len(alts) {
                let x = co_extract(lo, ints_get(alts, i), v, vt, name, tys);
                if x != "" {
                    ints_push(which, ints_get(alts, i));
                    strs_push(xs, x);
                }
                i = i + 1;
            }
            if strs_len(xs) == 0 { return ""; }
            let mut acc = strs_pop(xs);
            ints_pop(which);
            let ty = ints_get(tys, ints_len(tys) - 1);
            while strs_len(xs) > 0 {
                let x = strs_pop(xs);
                let alt = ints_pop(which);
                let test = co_test(lo, alt, v, vt);
                acc = co_conditional(lo, test, x, acc, ty, at);
            }
            ints_push(tyout, ty);
            return acc;
        }
        return "";
    }
    if sx_text(t, p) != "Variant" { return ""; }
    let vp = sx_kid(t, p, 0);
    let fields = sx_items(t, sx_field(t, vp, "fields"));
    let mut f = 0 - 1;
    let mut i = 0;
    while i < ints_len(fields) && f < 0 {
        if co_binds_name(lo, sx_field(t, ints_get(fields, i), "pattern"), name) { f = ints_get(fields, i); }
        i = i + 1;
    }
    if f < 0 { return ""; }
    if ck_is_enum_type(c, vt) == false { return co_stopped(lo, "a variant pattern against a value that is not an enum"); }
    let vs = sx_field(t, vp, "variant_span");
    let chosen = ck_variant_index_at(c, co_abs_s(lo, vs), co_abs_e(lo, vs));
    let n = ck_variant_count(c, vt);
    let arms = strs_new();
    let mut ty = 0 - 1;
    let mut w = 0;
    while w < n && co_halted(lo) == false {
        if w == chosen {
            let ns = sx_field(t, f, "name_span");
            let fi = ck_init_at(c, co_abs_s(lo, ns), co_abs_e(lo, ns));
            if fi < 0 { return co_stopped(lo, "a pattern field the checker did not resolve"); }
            let fty = ck_payload_ty(c, vt, chosen, fi);
            let local = co_temp(lo, "payload", fty, ns);
            let inner = ints_new();
            let x = co_extract(lo, sx_field(t, f, "pattern"), co_read(lo, local, ns), fty, name, inner);
            if x == "" { return co_stopped(lo, "a binding its field's pattern lost"); }
            ty = ints_get(inner, 0);
            let bindings = strs_new();
            strs_push(bindings, co_binding(lo, vt, chosen, fi, local));
            let owns = co_list_one(int_to_str(local));
            strs_push(arms, co_arm_json(lo, vt, w, bindings, co_block_json(lo, false, owns, strs_new(), x, at), at));
        } else {
            let code = co_int_const(lo, 70, at);
            let exit = co_builtin(lo, "exit_with", "[]", code, ck_t_int(), at);
            let o = strs_new();
            strs_push(o, co_op_first("eval"));
            strs_push(o, co_field("value", exit));
            strs_push(o, co_field("ends", co_ends(true)));
            let stmts = strs_new();
            strs_push(stmts, co_object(o));
            strs_push(arms, co_arm_json(lo, vt, w, strs_new(), co_block_json(lo, true, "[]", stmts, "null", at), at));
        }
        w = w + 1;
    }
    if co_halted(lo) { return ""; }
    ints_push(tyout, ty);
    co_match_node(lo, vt, v, arms, ty, at)
}

// A guarded arm's test (`guarded`): `if <its pattern matches> { <its names bound>; guard } else
// { false }`.
fn co_guarded(lo: Lo, test: Str, arm: Int, st: Int, sty: Int, at: Int) -> Str {
    let t = lo.t;
    let pre = strs_new();
    let seed = co_arm_bindings(lo, arm, st, sty, at, pre);
    if co_halted(lo) { return ""; }
    let then = co_expr_region_pre(lo, sx_unwrap(t, sx_field(t, arm, "guard")), seed, true, pre);
    let no = co_boolean(lo, "false", at);
    let fields = strs_new();
    strs_push(fields, co_field_first("cond", test));
    strs_push(fields, co_field("then", then));
    strs_push(fields, co_field("else", co_branch(lo, no, at)));
    co_node(lo, "if", str_join(fields, ""), ck_t_bool(), at)
}

// An arm's body: a block, as a value or a statement, or one expression in a region of its own
// (`expr_region`), its bindings owned first.
fn co_arm_region(lo: Lo, b: Int, seed: Ints, value: Bool) -> Str { co_arm_region_pre(lo, b, seed, value, strs_new()) }

// The same, `prefix` (an arm's bindings) before its statements.
fn co_arm_region_pre(lo: Lo, b: Int, seed: Ints, value: Bool, prefix: Strs) -> Str {
    let t = lo.t;
    if sx_kind(t, b) == tk_tuple() && sx_text(t, b) == "Block" {
        if value { return co_value_block_pre(lo, sx_kid(t, b, 0), seed, prefix); }
        return co_statement_block_pre(lo, sx_kid(t, b, 0), seed, prefix);
    }
    co_expr_region_pre(lo, b, seed, value, prefix)
}

// A region holding one expression (`expr_region`), `prefix` before it, at the expression.
fn co_expr_region_pre(lo: Lo, b: Int, seed: Ints, value: Bool, prefix: Strs) -> Str {
    let t = lo.t;
    co_open_seeded(lo, seed);
    let stmts = strs_new();
    co_push_all(stmts, prefix);
    let mut tail = "null";
    let mut ty = 0 - 1;
    let mut transfers = false;
    if value {
        tail = co_expr(lo, b);
        ty = co_last_ty(lo);
    } else {
        strs_push(stmts, co_effect(lo, b));
        transfers = co_last_transfers(lo);
    }
    let owns = co_close_region(lo);
    co_set_last(lo, ty, transfers);
    co_block_json(lo, transfers, owns, stmts, tail, expr_span(t, b))
}

// An expression's object: its operation, its own members, its type and where it is.
fn co_node(lo: Lo, op: Str, members: Str, ty: Int, span: Int) -> Str {
    if co_halted(lo) { return ""; }
    let o = strs_new();
    strs_push(o, co_op_first(op));
    if members != "" { strs_push(o, str_concat(",", members)); }
    strs_push(o, co_field("type", json_str(co_durable(lo, ty))));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, span))));
    co_set_last(lo, ty, false);
    co_object(o)
}

// The constant `value` (`true` or `false`) as a `Bool` expression at `span`.
fn co_boolean(lo: Lo, value: Str, span: Int) -> Str {
    let id = co_constant(lo, "Bool", value);
    co_node(lo, "const", co_field_first("const", int_to_str(id)), ck_t_bool(), span)
}

// `if cond { then } else { otherwise }`, each branch a block of its expression alone, at `span`
// (`conditional`): what a logical operator is.
fn co_conditional(lo: Lo, cond: Str, then: Str, otherwise: Str, ty: Int, span: Int) -> Str {
    let fields = strs_new();
    strs_push(fields, co_field_first("cond", cond));
    strs_push(fields, co_field("then", co_branch(lo, then, span)));
    strs_push(fields, co_field("else", co_branch(lo, otherwise, span)));
    co_node(lo, "if", str_join(fields, ""), ty, span)
}

// A block holding only `e`, at `e`'s own span — which every caller passes as `span`.
fn co_branch(lo: Lo, e: Str, span: Int) -> Str {
    let o = strs_new();
    strs_push(o, co_field_first("ends", co_ends(false)));
    strs_push(o, co_field("owns", "[]"));
    strs_push(o, co_field("stmts", "[]"));
    strs_push(o, co_field("tail", e));
    strs_push(o, co_field("at", json_str(co_tree_span(lo, span))));
    co_object(o)
}

fn co_binary(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let op = sx_text(t, sx_field(t, e, "op"));
    let at = sx_field(t, e, "op_span");
    if op == "And" || op == "Or" {
        let lhs = co_expr(lo, sx_field(t, e, "lhs"));
        let rhs = co_expr(lo, sx_field(t, e, "rhs"));
        if op == "And" { return co_conditional_spans(lo, lhs, rhs, co_boolean(lo, "false", at), sx_field(t, e, "rhs"), at, at); }
        return co_conditional_spans(lo, lhs, co_boolean(lo, "true", at), rhs, at, sx_field(t, e, "rhs"), at);
    }
    let lhs = co_expr(lo, sx_field(t, e, "lhs"));
    let lt = co_last_ty(lo);
    let rhs = co_expr(lo, sx_field(t, e, "rhs"));
    let rt = co_last_ty(lo);
    let mut operand = lt;
    if operand < 0 { operand = rt; }
    if operand < 0 { operand = ck_t_int(); }
    let class = ck_type_class(lo.c, operand);
    // `s + t` on strings (R1, 5b.6): the `str_concat` the checker read it as, at the whole.
    if op == "Add" && class == "str" {
        let args = strs_new();
        strs_push(args, lhs);
        strs_push(args, rhs);
        return co_builtin(lo, "str_concat", "[]", str_join(args, ","), ck_t_str(), sx_field(t, e, "span"));
    }
    let mut arith = co_arithmetic(op);
    if arith == "" { arith = co_bitwise(op); }
    if arith != "" {
        let fields = strs_new();
        strs_push(fields, co_field_first("lhs", lhs));
        strs_push(fields, co_field("rhs", rhs));
        return co_node(lo, arith, str_join(fields, ""), operand, at);
    }
    let cmp = co_comparison(op);
    if cmp == "" { return co_stopped(lo, str_concat("the operator ", op)); }
    let ordering = op == "Lt" || op == "LtEq" || op == "Gt" || op == "GtEq";
    let mut law = "";
    if class == "int" { law = "int"; }
    if class == "integer" || class == "float" { law = "num"; }
    if class == "bool" { law = "bool"; }
    if class == "str" { law = "bytes"; }
    if class == "record" || class == "enum" { law = "structural"; }
    if ordering == false {
        if class == "array" || class == "box" || class == "chain" { law = "structural"; }
        if class == "text" { law = "bytes"; }
        if class == "param" { law = "parametric"; }
    }
    if law == "" { return co_stopped(lo, "a comparison of a type with no such law"); }
    let fields = strs_new();
    strs_push(fields, co_field_first("operand", json_str(co_durable(lo, operand))));
    strs_push(fields, co_field("law", json_str(law)));
    strs_push(fields, co_field("lhs", lhs));
    strs_push(fields, co_field("rhs", rhs));
    co_node(lo, cmp, str_join(fields, ""), ck_t_bool(), at)
}

// A logical operator's `if`: each branch a block of its expression alone, at that expression's
// span — the right operand's own, or the operator's for a constant made there.
fn co_conditional_spans(lo: Lo, cond: Str, then: Str, otherwise: Str, then_span: Int, else_span: Int, at: Int) -> Str {
    let fields = strs_new();
    strs_push(fields, co_field_first("cond", cond));
    strs_push(fields, co_field("then", co_branch(lo, then, co_expr_at(lo, then_span))));
    strs_push(fields, co_field("else", co_branch(lo, otherwise, co_expr_at(lo, else_span))));
    co_node(lo, "if", str_join(fields, ""), ck_t_bool(), at)
}

// Where an expression's lowering puts it (`Expr::at`): a binary or unary operator's at its operator,
// a call's, a literal's and a name's at its span. A span node passes through.
fn co_expr_at(lo: Lo, n: Int) -> Int {
    let t = lo.t;
    if sx_kind(t, n) == tk_span() { return n; }
    let k = sx_text(t, n);
    if k == "Binary" || k == "Neg" || k == "Not" { return sx_field(t, n, "op_span"); }
    if sx_kind(t, n) == tk_tuple() && k == "Block" { return sx_field(t, sx_kid(t, n, 0), "span"); }
    // A field read is at its name; a construction at its type's name, a call read as one at
    // its callee.
    if k == "Field" { return sx_field(t, n, "name_span"); }
    if k == "Construct" || k == "Variant" { return sx_field(t, n, "ty_span"); }
    if k == "Call" {
        let cs = sx_field(t, n, "callee_span");
        if ck_site_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) < 0 {
            if ck_construction_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) >= 0 || ck_variant_at(lo.c, co_abs_s(lo, cs), co_abs_e(lo, cs)) >= 0 { return cs; }
        }
    }
    sx_field(t, n, "span")
}

fn co_arithmetic(op: Str) -> Str {
    if op == "Add" { return "+"; }
    if op == "Sub" { return "-"; }
    if op == "Mul" { return "*"; }
    if op == "Div" { return "/"; }
    if op == "Rem" { return "%"; }
    ""
}

fn co_bitwise(op: Str) -> Str {
    if op == "BitAnd" { return "&"; }
    if op == "BitOr" { return "|"; }
    if op == "BitXor" { return "^"; }
    if op == "Shl" { return "<<"; }
    if op == "Shr" { return ">>"; }
    ""
}

// An integer literal's constant (`integer`), in the type the checker gave it: an `Int` by its
// value, another integer type's by its decimal text; a float's is not carried yet.
fn co_integer(lo: Lo, digits: Str, span: Int) -> Str {
    let lt = ck_literal_ty(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
    let class = ck_type_class(lo.c, lt);
    if class == "int" {
        let id = co_constant(lo, "Int", digits);
        return co_node(lo, "const", co_field_first("const", int_to_str(id)), lt, span);
    }
    if class != "integer" { return co_stopped(lo, "a literal of a type other than an integer's"); }
    let name = co_durable(lo, lt);
    let id = co_constant(lo, name, json_str(digits));
    co_node(lo, "const", co_field_first("const", int_to_str(id)), lt, span)
}

// `-` and the digits, or `0` for zero.
fn co_negated(digits: Str) -> Str {
    let mut i = 0;
    while i < str_len(digits) {
        if str_byte(digits, i) != 48 { return str_concat("-", digits); }
        i = i + 1;
    }
    "0"
}

fn co_comparison(op: Str) -> Str {
    if op == "Eq" { return "=="; }
    if op == "NotEq" { return "!="; }
    if op == "Lt" { return "<"; }
    if op == "LtEq" { return "<="; }
    if op == "Gt" { return ">"; }
    if op == "GtEq" { return ">="; }
    ""
}

// A call of one of the compilation's functions or of a built-in, as the checker resolved it.
fn co_call(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let cs = sx_field(t, e, "callee_span");
    let cv = ck_conv_at(c, co_abs_s(lo, cs), co_abs_e(lo, cs));
    if cv >= 0 { return co_conversion(lo, e, cv); }
    co_call_parts(lo, cs, strs_new(), sx_items(t, sx_field(t, e, "args")), sx_field(t, e, "span"))
}

// A call whose callee is written at `cs` (`call`): its arguments `pre`, already lowered, then
// `list`; the whole at `span`.
fn co_call_parts(lo: Lo, cs: Int, pre: Strs, list: Ints, span: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let site = ck_site_at(c, co_abs_s(lo, cs), co_abs_e(lo, cs));
    if site < 0 { return co_stopped(lo, "a call the checker did not record as a call"); }
    // Its arguments first, as `call` lowers them.
    let args = strs_new();
    co_push_all(args, pre);
    let mut i = 0;
    while i < ints_len(list) {
        strs_push(args, co_expr(lo, ints_get(list, i)));
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    let callee = ck_site_fn(c, site);
    let b = ck_site_builtin(c, site);
    if callee >= 0 {
        if ck_fn_is_foreign(c, callee) { return co_stopped(lo, "a foreign call"); }
        if ck_fn_effect_param(c, callee) { return co_stopped(lo, "a call of an effect-polymorphic function"); }
        let mut ret = ck_fn_ret_ty(c, callee);
        let mut targs = "[]";
        // A generic call: the type arguments the checker settled, and the result it formed.
        if ck_fn_type_params(c, callee) > 0 {
            ret = ck_site_ret(c, site);
            targs = co_site_type_args(lo, site);
            if ret < 0 { return co_stopped(lo, "a generic call whose result the checker did not form"); }
        }
        let fields = strs_new();
        strs_push(fields, co_field_first("callee", json_str(fx_fn_identity(lo.f, callee))));
        strs_push(fields, co_field("type_args", targs));
        strs_push(fields, co_field("args", co_list_of(args)));
        return co_node(lo, "call", str_join(fields, ""), ret, span);
    }
    if b >= 0 {
        let name = ck_builtin_name(c, b);
        if co_special_builtin(name) { return co_stopped(lo, str_concat("the built-in ", name)); }
        let mut ret = ck_builtin_ret(c, b);
        let mut targs = "[]";
        if ck_builtin_generic(c, b) {
            ret = ck_site_ret(c, site);
            targs = co_site_type_args(lo, site);
            if ret < 0 { return co_stopped(lo, "a generic call whose result the checker did not form"); }
        }
        let fields = strs_new();
        strs_push(fields, co_field_first("builtin", json_str(name)));
        strs_push(fields, co_field("type_args", targs));
        strs_push(fields, co_field("args", co_list_of(args)));
        return co_node(lo, "builtin", str_join(fields, ""), ret, span);
    }
    co_stopped(lo, "a call through a value")
}

// A constant's use (`const_value`): its value as a literal of its type, at the name; a static
// `Atomic`'s, its cell.
fn co_const_use(lo: Lo, u: Int, name: Str, span: Int) -> Str {
    let c = lo.c;
    if ck_const_agg(c, u) { return co_stopped(lo, "a constant of a record, enum, tuple or array type"); }
    let ty = ck_const_ty(c, u);
    if ck_const_cell(c, u) {
        let key = str_concat(str_concat(fx_module_identity(lo.f, co_g(lo, co_s_module())), "::static "), name);
        let id = co_cell_constant(lo, name, key);
        return co_node(lo, "const", co_field_first("const", int_to_str(id)), ty, span);
    }
    let class = ck_type_class(c, ty);
    let mut id = 0 - 1;
    if class == "int" { id = co_constant(lo, "Int", int_to_str(ck_const_int(c, u))); }
    if class == "bool" {
        if ck_const_int(c, u) == 1 { id = co_constant(lo, "Bool", "true"); } else { id = co_constant(lo, "Bool", "false"); }
    }
    if class == "str" {
        let v = ck_const_text(c, u);
        id = co_constant(lo, "Str", co_str_value(v));
    }
    if class == "integer" { id = co_constant(lo, co_durable(lo, ty), json_str(ck_const_text(c, u))); }
    if id < 0 { return co_stopped(lo, "a constant of a type not carried yet"); }
    co_node(lo, "const", co_field_first("const", int_to_str(id)), ty, span)
}

// A numeric conversion (`conversion`): `convert` in its mode; `try_convert[T](x)` as
// `{ let c = x; if fits(c) { Some(T(c)) } else { None } }`; at the call.
fn co_conversion(lo: Lo, e: Int, cv: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let at = sx_field(t, e, "span");
    let to = ck_conv_to(c, cv);
    let mode = ck_conv_mode(c, cv);
    let args = sx_items(t, sx_field(t, e, "args"));
    if ints_len(args) == 0 { return co_stopped(lo, "a conversion with no argument"); }
    if ck_type_class(c, to) == "text" { return co_stopped(lo, "a conversion to `Text`"); }
    let operand = co_expr(lo, ints_get(args, 0));
    let from = co_last_ty(lo);
    if co_halted(lo) { return ""; }
    if mode != "try" {
        let fields = strs_new();
        strs_push(fields, co_field_first("mode", json_str(mode)));
        strs_push(fields, co_field("operand", operand));
        return co_node(lo, "convert", str_join(fields, ""), to, at);
    }
    if from < 0 { return operand; }
    let result = ck_conv_result(c, cv);
    let none = ck_variant_named(c, result, "None");
    let some = ck_variant_named(c, result, "Some");
    if none < 0 || some < 0 { return co_stopped(lo, "an `Option` without `None` and `Some`"); }
    let local = co_temp(lo, "convert", from, at);
    let tf = strs_new();
    strs_push(tf, co_field_first("to", json_str(co_durable(lo, to))));
    strs_push(tf, co_field("operand", co_read(lo, local, at)));
    let test = co_node(lo, "fits", str_join(tf, ""), ck_t_bool(), at);
    let cf = strs_new();
    strs_push(cf, co_field_first("mode", json_str("exact")));
    strs_push(cf, co_field("operand", co_read(lo, local, at)));
    let converted = co_node(lo, "convert", str_join(cf, ""), to, at);
    let init = strs_new();
    strs_push(init, co_field_first("field", "0"));
    strs_push(init, co_field("name", json_str(ck_payload_name(c, result, some, 0))));
    strs_push(init, co_field("value", converted));
    let inits = strs_new();
    strs_push(inits, co_object(init));
    let somev = co_variant_value(lo, result, some, inits, at);
    let nonev = co_variant_value(lo, result, none, strs_new(), at);
    let choice = co_conditional(lo, test, somev, nonev, result, at);
    let stmts = strs_new();
    strs_push(stmts, co_let(local, operand));
    let block = co_block_json(lo, false, co_list_one(int_to_str(local)), stmts, choice, at);
    co_node(lo, "block", co_field_first("body", block), result, at)
}

// A variant of enum type `et` built of the printed fields `inits`, at `at`.
fn co_variant_value(lo: Lo, et: Int, v: Int, inits: Strs, at: Int) -> Str {
    let members = strs_new();
    strs_push(members, co_field_first("variant", int_to_str(v)));
    strs_push(members, co_field("name", json_str(ck_variant_name(lo.c, et, v))));
    strs_push(members, co_field("arity", int_to_str(strs_len(inits))));
    strs_push(members, co_field("fields", co_list(inits)));
    co_node(lo, "variant", str_join(members, ""), et, at)
}

// A name read (`Var`): a constant's value (Gate 2) or a static `Atomic`'s cell, else its binding.
fn co_var(lo: Lo, name: Str, span: Int) -> Str {
    if ck_binding_at(lo.c, co_abs_s(lo, span), co_abs_e(lo, span)) < 0 {
        let u = ck_const_at(lo.c, co_abs_s(lo, span), co_abs_e(lo, span));
        if u >= 0 { return co_const_use(lo, u, name, span); }
    }
    let l = co_local_at(lo, span);
    if co_halted(lo) { return ""; }
    // A shared binding is read out of its cell (R1b, L10).
    if ints_get(lo.lshr, l) >= 0 { return co_through_cell(lo, l, "", span); }
    co_node(lo, "local", co_field_first("local", int_to_str(l)), ints_get(lo.lty, l), span)
}

// `vec_get(cell, 0)`, or `vec_set(cell, 0, value)` where `value` is given, on shared local `l`
// (`through_cell`).
fn co_through_cell(lo: Lo, l: Int, value: Str, span: Int) -> Str {
    let elem = ints_get(lo.lshr, l);
    let zero = co_int_const(lo, 0, span);
    let read = co_read(lo, l, span);
    let targs = co_list_one(json_str(co_durable(lo, elem)));
    let args = strs_new();
    strs_push(args, read);
    strs_push(args, zero);
    if value == "" { return co_builtin(lo, "vec_get", targs, str_join(args, ","), elem, span); }
    strs_push(args, value);
    co_builtin(lo, "vec_set", targs, str_join(args, ","), ck_t_int(), span)
}

// `{ let made = vec_new(); vec_push(made, value); made }` at `span` (`made_holding`): the cell
// shared local `l` is, made holding `value`.
fn co_made_cell(lo: Lo, l: Int, value: Str, span: Int) -> Str {
    let cell = ints_get(lo.lty, l);
    let elem = ints_get(lo.lshr, l);
    let made = co_temp(lo, "made", cell, span);
    let targs = co_list_one(json_str(co_durable(lo, elem)));
    let stmts = strs_new();
    strs_push(stmts, co_let(made, co_builtin(lo, "vec_new", targs, "", cell, span)));
    let fill = strs_new();
    strs_push(fill, co_read(lo, made, span));
    strs_push(fill, value);
    let o = strs_new();
    strs_push(o, co_op_first("eval"));
    strs_push(o, co_field("value", co_builtin(lo, "vec_push", targs, str_join(fill, ","), ck_t_int(), span)));
    strs_push(o, co_field("ends", co_ends(false)));
    strs_push(stmts, co_object(o));
    let tail = co_read(lo, made, span);
    let body = co_block_json(lo, false, co_list_one(int_to_str(made)), stmts, tail, span);
    co_node(lo, "block", co_field_first("body", body), cell, span)
}

// A closure made (N50): its function, and the locals it captures, in the order it captured them.
fn co_closure(lo: Lo, e: Int) -> Str {
    let c = lo.c;
    let span = sx_field(lo.t, e, "span");
    let id = ck_closure_at(c, co_abs_s(lo, span), co_abs_e(lo, span));
    if id < 0 { return co_stopped(lo, "a closure the checker did not declare"); }
    let caps = strs_new();
    let mut k = 0;
    while k < ck_capture_count(c) {
        if ck_capture_closure(c, k) == id {
            let l = co_index_of(lo.lb, ck_capture_binding(c, k));
            if l < 0 { return co_stopped(lo, "a capture of a binding this function does not have"); }
            strs_push(caps, int_to_str(l));
        }
        k = k + 1;
    }
    let fields = strs_new();
    strs_push(fields, co_field_first("function", json_str(fx_fn_identity(lo.f, id))));
    strs_push(fields, co_field("captures", co_list(caps)));
    co_node(lo, "closure", str_join(fields, ""), ck_closure_ty(c, id), span)
}

// `x.m(args)` (`method_call`), the method named at `ms`, the whole at `span`; the receiver the
// node `recv`, or (where that is -1) the name `rname` at `rspan`. By name (R1, 5b.15), the
// ordinary call the checker read it as, the receiver first; else the impl's method, or the
// trait's default body at the receiver's type. A receiver that names no value (`Show.show(x)`)
// is no argument.
fn co_method(lo: Lo, ms: Int, span: Int, recv: Int, rname: Str, rspan: Int, rest: Ints) -> Str {
    let t = lo.t;
    let c = lo.c;
    let site = ck_site_at(c, co_abs_s(lo, ms), co_abs_e(lo, ms));
    if site < 0 { return co_stopped(lo, "a method call the checker did not record"); }
    let mut name_span = rspan;
    if recv >= 0 && sx_kind(t, recv) != tk_tuple() && sx_text(t, recv) == "Var" { name_span = sx_field(t, recv, "span"); }
    let mut ufcs = false;
    if name_span >= 0 { ufcs = ck_binding_at(c, co_abs_s(lo, name_span), co_abs_e(lo, name_span)) < 0; }
    let pre = strs_new();
    let mut rty = 0 - 1;
    if ufcs == false {
        if recv >= 0 { strs_push(pre, co_expr(lo, recv)); } else { strs_push(pre, co_var(lo, rname, rspan)); }
        rty = co_last_ty(lo);
    }
    let target = ck_site_fn(c, site);
    if ck_site_builtin(c, site) >= 0 || (target >= 0 && ck_fn_method(c, target) == false) { return co_call_parts(lo, ms, pre, rest, span); }
    let args = strs_new();
    co_push_all(args, pre);
    if target < 0 { return co_trait_call(lo, site, args, rest, span); }
    let mut i = 0;
    while i < ints_len(rest) {
        strs_push(args, co_expr(lo, ints_get(rest, i)));
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    let mut targs = "[]";
    if co_contains(ck_fn_name(c, target), "/default/") {
        if ufcs || rty < 0 { return co_stopped(lo, "a default method called by its trait's name"); }
        targs = co_list_one(json_str(co_durable(lo, rty)));
    }
    let ret = ck_fn_ret_ty(c, target);
    if co_contains(co_durable(lo, ret), "$") { return co_stopped(lo, "a method whose result names a type parameter"); }
    let fields = strs_new();
    strs_push(fields, co_field_first("callee", json_str(fx_fn_identity(lo.f, target))));
    strs_push(fields, co_field("type_args", targs));
    strs_push(fields, co_field("args", co_list(args)));
    co_node(lo, "call", str_join(fields, ""), ret, span)
}

// A call through a trait's bound, or of a derived method (`CallTrait`): the trait's method, the
// receiver's type as the calling body sees it, the arguments (`pre` lowered, then `rest`), and
// the method's result at that type.
fn co_trait_call(lo: Lo, site: Int, pre: Strs, rest: Ints, span: Int) -> Str {
    let c = lo.c;
    let tm = ck_site_trait_method(c, site);
    let ft = ck_site_indirect(c, site);
    if tm < 0 || ft < 0 { return co_stopped(lo, "a call through a value"); }
    let args = strs_new();
    co_push_all(args, pre);
    let mut i = 0;
    while i < ints_len(rest) {
        strs_push(args, co_expr(lo, ints_get(rest, i)));
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    let tr = ck_method_trait(c, tm);
    let key = str_concat(str_concat(fx_trait_identity(lo.f, tr), "."), ck_trait_method_name(c, tr, tm - ck_trait_method_first(c, tr)));
    let fields = strs_new();
    strs_push(fields, co_field_first("method", json_str(key)));
    strs_push(fields, co_field("self", json_str(co_durable(lo, ck_type_arg(c, ft, 0)))));
    strs_push(fields, co_field("args", co_list(args)));
    co_node(lo, "call_trait", str_join(fields, ""), ck_type_arg(c, ft, ck_type_arg_count(c, ft) - 1), span)
}

fn co_contains(s: Str, part: Str) -> Bool {
    let mut i = 0;
    while i + str_len(part) <= str_len(s) {
        if str_slice(s, i, i + str_len(part)) == part { return true; }
        i = i + 1;
    }
    false
}

// `base[index]`: on a sequence (R1, 5b.15), the call the checker read it as, at the brackets
// (`element_call`); on an array (Gate 2), `index`, of the array's element type.
fn co_index(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let c = lo.c;
    let bs = sx_field(t, e, "bracket_span");
    if ck_site_at(c, co_abs_s(lo, bs), co_abs_e(lo, bs)) >= 0 {
        let list = ints_new();
        ints_push(list, sx_field(t, e, "base"));
        ints_push(list, sx_field(t, e, "index"));
        return co_call_parts(lo, bs, strs_new(), list, bs);
    }
    let base = co_expr(lo, sx_field(t, e, "base"));
    let bt = co_last_ty(lo);
    let index = co_expr(lo, sx_field(t, e, "index"));
    if co_halted(lo) { return ""; }
    let mut elem = 0 - 1;
    if ck_type_class(c, bt) == "array" { elem = ck_array_elem(c, bt); }
    let fields = strs_new();
    strs_push(fields, co_field_first("base", base));
    strs_push(fields, co_field("index", index));
    co_node(lo, "index", str_join(fields, ""), elem, bs)
}

// `(a, b, …)` (L5): the tuple record of its elements' types, built in order.
fn co_tuple(lo: Lo, e: Int) -> Str {
    let t = lo.t;
    let items = sx_items(t, sx_field(t, e, "elems"));
    let values = strs_new();
    let tys = ints_new();
    let mut i = 0;
    while i < ints_len(items) {
        strs_push(values, co_expr(lo, ints_get(items, i)));
        ints_push(tys, co_last_ty(lo));
        if co_last_ty(lo) < 0 { co_halt(lo, "a tuple of an element that never completes"); }
        i = i + 1;
    }
    if co_halted(lo) { return ""; }
    let rt = ck_tuple_of(lo.c, tys);
    let fields = strs_new();
    i = 0;
    while i < strs_len(values) {
        let o = strs_new();
        strs_push(o, co_field_first("field", int_to_str(i)));
        strs_push(o, co_field("name", json_str(int_to_str(i))));
        strs_push(o, co_field("value", strs_get(values, i)));
        strs_push(fields, co_object(o));
        i = i + 1;
    }
    let members = strs_new();
    strs_push(members, co_field_first("arity", int_to_str(strs_len(values))));
    strs_push(members, co_field("fields", co_list(fields)));
    co_node(lo, "record", str_join(members, ""), rt, sx_field(t, e, "span"))
}

// A generic call's settled type arguments, by their durable names.
fn co_site_type_args(lo: Lo, site: Int) -> Str {
    let out = strs_new();
    let mut k = 0;
    while k < ck_site_type_arg_count(lo.c, site) {
        strs_push(out, json_str(co_durable(lo, ck_site_type_arg(lo.c, site, k))));
        k = k + 1;
    }
    co_list(out)
}

// The built-ins `call` lowers as something else: made of operations a program cannot name, or
// conversions.
fn co_special_builtin(name: Str) -> Bool {
    if name == "box_new" || name == "cell_new" || name == "cell_get" || name == "cell_set" { return true; }
    if name == "checked_add" || name == "checked_sub" || name == "checked_mul" || name == "list_from_vec" || name == "chain_from_vec" { return true; }
    if str_len(name) > 0 && str_byte(name, 0) >= 65 && str_byte(name, 0) <= 90 { return true; }
    false
}

// A `Str` constant's printed value (`text`, then `quote`): its text where it is UTF-8 holding no
// `\x`, else `\xNN` for every byte.
fn co_str_value(v: Str) -> Str {
    if co_utf8(v) && co_contains(v, str_concat(str_from_byte(92), "x")) == false { return cdg_quote(v); }
    let digits = "0123456789abcdef";
    let out = strs_new();
    let mut i = 0;
    while i < str_len(v) {
        let b = str_byte(v, i);
        strs_push(out, str_concat(str_concat(str_from_byte(92), "x"), str_concat(str_slice(digits, b / 16, b / 16 + 1), str_slice(digits, b % 16, b % 16 + 1))));
        i = i + 1;
    }
    cdg_quote(str_join(out, ""))
}

// Whether `s` is UTF-8 as Rust's `str::from_utf8` holds it (`load.nz`'s `valid_utf8`).
fn co_utf8(s: Str) -> Bool {
    let n = str_len(s);
    let mut i = 0;
    while i < n {
        let b = str_byte(s, i);
        let mut more = 0;
        let mut lo = 128;
        let mut hi = 191;
        if b >= 128 {
            if b >= 194 && b <= 223 {
                more = 1;
            } else {
                if b >= 224 && b <= 239 {
                    more = 2;
                    if b == 224 { lo = 160; }
                    if b == 237 { hi = 159; }
                } else {
                    if b >= 240 && b <= 244 {
                        more = 3;
                        if b == 240 { lo = 144; }
                        if b == 244 { hi = 143; }
                    } else {
                        return false;
                    }
                }
            }
        }
        let mut k = 1;
        while k <= more {
            if i + k >= n { return false; }
            let x = str_byte(s, i + k);
            let mut low = 128;
            let mut high = 191;
            if k == 1 {
                low = lo;
                high = hi;
            }
            if x < low || x > high { return false; }
            k = k + 1;
        }
        i = i + 1 + more;
    }
    true
}

// --- JSON, as `print.rs` writes it compactly -----------------------------------------------------

fn co_field_first(name: Str, value: Str) -> Str { str_concat(str_concat(json_str(name), ":"), value) }
fn co_field(name: Str, value: Str) -> Str { str_concat(",", co_field_first(name, value)) }
fn co_op_first(op: Str) -> Str { co_field_first("op", json_str(op)) }
fn co_object(parts: Strs) -> Str { str_concat(str_concat("{", str_join(parts, "")), "}") }
fn co_list(items: Strs) -> Str { str_concat(str_concat("[", str_join(items, ",")), "]") }
fn co_list_of(items: Strs) -> Str { co_list(items) }

fn co_json_bool(b: Bool) -> Str { if b { "true" } else { "false" } }

fn co_json_or_null(s: Str) -> Str {
    if s == "" { return "null"; }
    json_str(s)
}

fn co_effect_list(mask: Int) -> Str {
    let names = ck_effect_names(mask);
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(names) {
        strs_push(out, json_str(strs_get(names, i)));
        i = i + 1;
    }
    co_list(out)
}
