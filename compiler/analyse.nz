// Name resolution and type checking for Nazm, written in Nazm — the library.
//
// `compiler/check.nz` is the command-line driver over this file, split for the reason
// every other pair here is: every top-level function is visible to every importer, so a
// library carrying a `main` collides with its importer's.
//
// Third component of the self-hosted compiler. It reads the node arena
// `compiler/parse.nz` produces and reports undefined variables (`N0200`) and undefined
// functions (`N0201`) with the spans the reference checker gives them.
//
// # Traversing a post-order arena without recursion
//
// The arena is post-order with arity, which is a stack machine's natural input: one
// left-to-right pass with an operand stack recovers every node's children, because a
// node's children are exactly the `arity` subtrees immediately before it. That pass
// builds a child index, and a second pass walks the tree in *pre-order* from an explicit
// work stack — which is what scoping needs, since a scope opens before the statements
// inside it are seen.
//
// Neither pass recurses. See `docs/bootstrap.md` §1, *traversal is iterative,
// always*.
//
// Usage: check FILE
// Output: one diagnostic per line, `CODE|start|end|message`, to standard output. Exits 1
// if there were any, 0 if not.

use "lex.nz";
use "parse.nz";
use "module.nz";

// --- the child index -----------------------------------------------------------------
//
// `kid_first[k]` is where node `k`'s children begin in `kids`, and `nar[k]` says how
// many there are, in source order.

// `parent[k]`, `childno[k]` and `substart[k]`: who a node belongs to, which child it is,
// and where its subtree begins in the post-order array.
//
// Emission needs all three. A post-order scan reaches a node *after* its children, which
// is right for an expression and wrong for control flow — an `if`'s branch has to be
// inside a basic block that opens after the condition, and a loop's condition has to be
// inside a block that opens before it. Knowing each node's parent and position lets the
// scan emit the branch and the label at the boundary between two children, and knowing
// where a subtree begins lets it open a loop's header before the condition is reached.
pub fn build_relations(nk: Ints, nar: Ints, kids: Ints, kid_first: Ints,
        parent: Ints, childno: Ints, substart: Ints) -> Int {
    let mut k = 0;
    while k < ints_len(nk) {
        ints_push(parent, 0 - 1);
        ints_push(childno, 0 - 1);
        ints_push(substart, k);
        k = k + 1;
    }
    k = 0;
    while k < ints_len(nk) {
        let arity = ints_get(nar, k);
        let first = ints_get(kid_first, k);
        let mut j = 0;
        while j < arity {
            let child = ints_get(kids, first + j);
            ints_set(parent, child, k);
            ints_set(childno, child, j);
            j = j + 1;
        }
        if arity > 0 {
            // A subtree is contiguous and ends at its root, so it begins where its
            // leftmost child's subtree begins.
            ints_set(substart, k, ints_get(substart, ints_get(kids, first)));
        }
        k = k + 1;
    }
    ints_len(parent)
}

pub fn build_children(nk: Ints, nar: Ints, kids: Ints, kid_first: Ints) -> Int {
    let stack = ints_new();
    let mut k = 0;
    while k < ints_len(nk) {
        let arity = ints_get(nar, k);
        // The `arity` most recent roots are this node's children. Popped in reverse and
        // written back in order, so `kids` reads left to right like the source does.
        let taken = ints_new();
        let mut t = 0;
        while t < arity {
            ints_push(taken, ints_pop(stack));
            t = t + 1;
        }
        ints_push(kid_first, ints_len(kids));
        let mut j = arity - 1;
        while j >= 0 {
            ints_push(kids, ints_get(taken, j));
            j = j - 1;
        }
        ints_push(stack, k);
        k = k + 1;
    }
    ints_len(stack)
}

// --- scopes ---------------------------------------------------------------------------
//
// A flat stack of names with a stack of marks. Entering a scope pushes a mark; leaving
// truncates back to it. Innermost-first lookup is a backwards scan, which is what the
// reference checker's `Scopes::lookup` does with a vector of maps.

fn scope_enter(marks: Ints, names: Strs) -> Int {
    ints_push(marks, strs_len(names));
    ints_len(marks)
}

fn scope_leave(marks: Ints, names: Strs) -> Int {
    let mark = ints_pop(marks);
    while strs_len(names) > mark {
        strs_pop(names);
    }
    mark
}

fn scope_has(names: Strs, want: Str) -> Bool {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return true; }
        i = i - 1;
    }
    false
}

fn has_function(fnames: Strs, want: Str) -> Bool {
    let mut i = 0;
    while i < strs_len(fnames) {
        if strs_get(fnames, i) == want { return true; }
        i = i + 1;
    }
    false
}

// `name:type` and `name:mut` texts carry two fields; this takes the part before the `:`.
pub fn before_colon(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 58 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// One diagnostic: its code, where it points, and what it says.
//
// **The compiler's first `Vec` of records**, N11. Until then a diagnostic was four parallel
// arrays — a code, a start, an end and a message — threaded through every stage as four
// parameters, pushed together here and popped together in one other place, and nothing
// but care kept the four the same length. One element is one diagnostic now: the
// relationship the arrays held by convention is the type's, and a stage that pushed a code
// without a message would not compile.
pub struct Diag {
    code: Str,
    start: Int,
    end: Int,
    message: Str,
}

pub fn report(diags: Vec[Diag],
        code: Str, from: Int, to: Int, message: Str) -> Int {
    vec_push(diags, Diag(code: code, start: from, end: to, message: message))
}

// --- types ---------------------------------------------------------------------------
//
// Small integers, because the language has no enum. `0` is *unknown*: it is what an
// expression whose type could not be determined gets, and it compares equal to nothing,
// so one mistake produces one diagnostic instead of a cascade — the same recovery rule
// the reference checker follows by continuing with the expected type.

fn t_unknown() -> Int { 0 }
pub fn t_int() -> Int { 1 }
pub fn t_bool() -> Int { 2 }
pub fn t_str() -> Int { 3 }
pub fn t_ints() -> Int { 4 }
pub fn t_strs() -> Int { 5 }
pub fn t_chan() -> Int { 6 }
// The capabilities (N102), one type each, in the reference's own order (`CapabilityKind::ALL`):
// a value of one is authority, made only by the runtime for `main`'s parameters and passed
// on from there. Natively an `Int` the program never reads.
pub fn t_iocap() -> Int { 7 }
pub fn t_spawncap() -> Int { 8 }
pub fn t_foreigncap() -> Int { 9 }
pub fn t_vouchcap() -> Int { 10 }
pub fn t_timecap() -> Int { 11 }
pub fn t_mmiocap() -> Int { 12 }
pub fn t_outcap() -> Int { 13 }
pub fn is_cap(t: Int) -> Bool {
    if t < t_iocap() { return false; }
    t <= t_outcap()
}

// A user-defined record is `t_record_base() + its index in the record table`. Encoded in
// the same `Int` as a built-in rather than in a second column, so every place that already
// carries a type — a binding, a signature, a node's recorded type — carries a record with
// no change. The base is far above the built-ins so the two can never be confused.
pub fn t_record_base() -> Int { 100 }
pub fn t_record(i: Int) -> Int { t_record_base() + i }
pub fn is_record(t: Int) -> Bool {
    if t < t_record_base() { return false; }
    // A `Vec` and a type parameter are entries of the same table and are not records:
    // see *generics* below.
    t < 1000000
}
pub fn record_of(t: Int) -> Int { t - t_record_base() }

// --- an enum is a record whose fields are its variants ----------------------------------
//
// N10 adds no second table. An enum occupies an entry of the record table whose "fields"
// are its **variants**, each named and each typed as another entry — the variant, whose
// own fields are its payload. `rkind` is what says which of the three an entry is:
//
//     0  a record      its fields are its fields
//     1  an enum       its fields are its variants
//     2  a variant     its fields are its payload, and no module owns its name
//
// That is not a trick to save a table. Every derivation N9 wrote over records is already
// the derivation N10 needs over enums: *needs cleanup* is some field of some variant,
// which is the same walk; a containment cycle through a variant is the same cycle; and
// the task-safety path comes out as `work.Values.items` — the variant named on the way —
// because a variant genuinely is a step in the path. What a record and an enum **do**
// differ in is how a value of one is built and eliminated, and that is written out at each
// of those two places rather than hidden here.
// An item's auxiliary word, read back: `compiler/parse.nz`, `item_aux`.
pub fn is_public(naux: Ints, k: Int) -> Int { ints_get(naux, k) % 2 }
pub fn name_offset(naux: Ints, k: Int) -> Int { ints_get(naux, k) / 2 }

pub fn rk_record() -> Int { 0 }
pub fn rk_enum() -> Int { 1 }
pub fn rk_variant() -> Int { 2 }

pub fn is_enum_entry(rkind: Ints, r: Int) -> Bool {
    if r < 0 { return false; }
    if r >= ints_len(rkind) { return false; }
    ints_get(rkind, r) == rk_enum()
}

pub fn is_enum(t: Int, rkind: Ints) -> Bool {
    if is_record(t) == false { return false; }
    is_enum_entry(rkind, record_of(t))
}

pub fn type_of_name(name: Str) -> Int {
    if name == "Int" { return t_int(); }
    if name == "Bool" { return t_bool(); }
    if name == "Str" { return t_str(); }
    if name == "Ints" { return t_ints(); }
    if name == "Strs" { return t_strs(); }
    if name == "Chan" { return t_chan(); }
    if name == "IoCap" { return t_iocap(); }
    if name == "SpawnCap" { return t_spawncap(); }
    if name == "ForeignCap" { return t_foreigncap(); }
    if name == "VouchCap" { return t_vouchcap(); }
    if name == "TimeCap" { return t_timecap(); }
    if name == "MmioCap" { return t_mmiocap(); }
    if name == "OutCap" { return t_outcap(); }
    t_unknown()
}

// A type name, against the built-ins and then the records `owner` may write.
//
// Built-ins first and unshadowable, which is why they are matched before the table is
// consulted rather than being put in it.
pub fn type_in(name: Str, owner: Int, rnames: Strs, rowner: Ints,
        tmod: Ints, tname: Strs, trec: Ints) -> Int {
    let built = type_of_name(name);
    if built != t_unknown() { return built; }
    match record_owned(rnames, rowner, owner, name) {
        Option.Some(value: own) => t_record(own),
        Option.None() => {
            let brought = record_imported(tmod, tname, trec, owner, name);
            if brought >= 0 { return t_record(brought); }
            t_unknown()
        },
    }
}

// The record `owner` declares under `name` — public or private, since a module sees all
// of its own — or `None` when it declares none.
//
// An `Option` since N12.1, and not for style. It used to answer `-1` for "none", and
// `definition_of` answers `-1` for any type that is not a record — so every comparison of
// the one with the other needed an `if found >= 0` in front of it, or a missing `Result`
// would have been equal to the definition of `Int`. The guards were all there; now there
// is nothing to guard, because "none" is not a number either answer could be.
pub fn record_owned(rnames: Strs, rowner: Ints, owner: Int, name: Str) -> Option[Int] {
    let mut i = 0;
    while i < strs_len(rnames) {
        if ints_get(rowner, i) == owner {
            if strs_get(rnames, i) == name { return Option[Int].Some(value: i); }
        }
        i = i + 1;
    }
    Option[Int].None()
}

// Whether `t` applies the core prelude's `Result` — `core_result`, the entry the prelude
// module declares under that name, or `None` when there is no prelude and nothing is one.
pub fn applies_core_result(tb: Table, core_result: Option[Int], t: Int) -> Bool {
    match core_result {
        Option.None() => false,
        Option.Some(value: decl) => definition_of(tb, t) == decl,
    }
}

// The record an import brings into `owner` under `name`, or -1.
pub fn record_imported(tmod: Ints, tname: Strs, trec: Ints, owner: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_len(tmod) {
        if ints_get(tmod, i) == owner {
            if strs_get(tname, i) == name { return ints_get(trec, i); }
        }
        i = i + 1;
    }
    0 - 1
}

fn type_name(t: Int) -> Str {
    if t == t_int() { return "Int"; }
    if t == t_bool() { return "Bool"; }
    if t == t_str() { return "Str"; }
    if t == t_ints() { return "Ints"; }
    if t == t_strs() { return "Strs"; }
    if t == t_chan() { return "Chan"; }
    if t == t_iocap() { return "IoCap"; }
    if t == t_spawncap() { return "SpawnCap"; }
    if t == t_foreigncap() { return "ForeignCap"; }
    if t == t_vouchcap() { return "VouchCap"; }
    if t == t_timecap() { return "TimeCap"; }
    if t == t_mmiocap() { return "MmioCap"; }
    if t == t_outcap() { return "OutCap"; }
    "?"
}

// A type as a reader sees it. A record spells its declared name, which is not its
// identity — two modules may each declare `Thing` — and is right for a message.
pub fn show_type(t: Int, rnames: Strs) -> Str {
    // Every entry carries the name a reader would write: `Point`, `Pair[Int, Str]`,
    // `Vec[T]`, `T`.
    if t >= t_record_base() {
        if entry_of(t) < strs_len(rnames) { return strs_get(rnames, entry_of(t)); }
        return "?";
    }
    type_name(t)
}

// --- generics: applied types, `Vec`, and type parameters, N11 ------------------------------
//
// **Every type is still one `Int`**, and every user-defined one is still an entry of the
// record table. What N11 adds is three more things an entry can be, and one rule about
// where each one's code lives:
//
//     t_record(r)   100 + r         a record, an enum or a variant — as since N9 and N10
//     t_vec(r)      1_000_000 + r   `Vec[T]`, whose element is the entry's one argument
//     t_param(r)    2_000_000 + r   a type parameter, which only its declaration can name
//
// An **applied** record or enum — `Pair[Int, Str]` — is an entry of its own whose fields are
// its definition's with the parameters substituted, done once, when it is interned. Every
// consumer this compiler has — copy and cleanup derivation, layout, task safety,
// construction, projection, the emitter's helpers — reads *fields*, and each was written
// and tested against entries with concrete fields. So none of them learns that generics
// exist: `crates/nazm-sema/src/generic.rs` makes the same decision for the same reason.
//
// Interning is what keeps `==` on a type code the language's type equality: one definition
// applied to one argument list is one entry, found again by `apply` rather than made twice.
//
// The ranges are far apart so that no code in one can be mistaken for another, and so
// that every place that asks `is_record` keeps meaning what it meant — a `Vec` is not a
// record, and neither is a parameter.

pub fn rk_vec() -> Int { 3 }
pub fn rk_param() -> Int { 4 }

pub fn t_vec(r: Int) -> Int { 1000000 + r }
pub fn t_param(r: Int) -> Int { 2000000 + r }
pub fn is_vec(t: Int) -> Bool {
    if t < 1000000 { return false; }
    t < 2000000
}
pub fn is_param(t: Int) -> Bool {
    if t < 2000000 { return false; }
    t < 3000000
}
// A function type (N102): an entry whose arguments are its parameters then its result, and
// whose effects are in `req` — interned, so two function types are one exactly when their
// parameters, result and effects are equal.
pub fn rk_fn() -> Int { 5 }
pub fn t_fn(r: Int) -> Int { 3000000 + r }
pub fn is_fn(t: Int) -> Bool { t >= 3000000 }

// The table entry a user type's code names, or -1 for a built-in or `unknown`.
pub fn entry_of(t: Int) -> Int {
    if t >= 3000000 { return t - 3000000; }
    if t >= 2000000 { return t - 2000000; }
    if t >= 1000000 { return t - 1000000; }
    if t >= 100 { return t - 100; }
    0 - 1
}

// The type code of entry `r`, by what the entry is.
pub fn code_of(tb: Table, r: Int) -> Int {
    let k = ints_get(tb.kind, r);
    if k == rk_vec() { return t_vec(r); }
    if k == rk_param() { return t_param(r); }
    if k == rk_fn() { return t_fn(r); }
    t_record(r)
}

// The function type with these parameters, result and effects: the one entry for them.
pub fn fn_of(tb: Table, params: Ints, ret: Int, eff: Int) -> Int {
    let n = ints_len(params);
    let mut r = 0;
    while r < strs_len(tb.names) {
        if ints_get(tb.kind, r) == rk_fn() {
            if ints_get(tb.acount, r) == n + 1 {
                if ints_get(tb.req, r) == eff {
                    let base = ints_get(tb.afirst, r);
                    let mut same = ints_get(tb.args, base + n) == ret;
                    let mut i = 0;
                    while i < n {
                        if ints_get(tb.args, base + i) != ints_get(params, i) { same = false; }
                        i = i + 1;
                    }
                    if same { return t_fn(r); }
                }
            }
        }
        r = r + 1;
    }
    let mut shown = "fn(";
    let mut i = 0;
    while i < n {
        if i > 0 { shown = str_concat(shown, ", "); }
        shown = str_concat(shown, show_type(ints_get(params, i), tb.names));
        i = i + 1;
    }
    shown = str_concat(str_concat(shown, ") -> "), show_type(ret, tb.names));
    if eff > 0 { shown = str_concat(str_concat(shown, " ! "), fx_text(eff)); }
    let e = new_entry(tb, shown, 0 - 1, 1, 0, 0 - 1, rk_fn(), 0 - 1);
    ints_set(tb.afirst, e, ints_len(tb.args));
    i = 0;
    while i < n { ints_push(tb.args, ints_get(params, i)); i = i + 1; }
    ints_push(tb.args, ret);
    ints_set(tb.acount, e, n + 1);
    ints_set(tb.req, e, eff);
    t_fn(e)
}

pub fn fn_arity(tb: Table, t: Int) -> Int { ints_get(tb.acount, entry_of(t)) - 1 }
pub fn fn_param(tb: Table, t: Int, i: Int) -> Int {
    ints_get(tb.args, ints_get(tb.afirst, entry_of(t)) + i)
}
pub fn fn_result(tb: Table, t: Int) -> Int {
    ints_get(tb.args, ints_get(tb.afirst, entry_of(t)) + fn_arity(tb, t))
}
pub fn fn_effect_bits(tb: Table, t: Int) -> Int { ints_get(tb.req, entry_of(t)) }

// Whether a value of type `a` may be passed or returned where `b` is expected (N79's effect
// subsumption): the same type, or two function types with equal parameters and results whose
// effects in `a` are within `b`'s. Inside another type nothing is converted.
pub fn accepts(tb: Table, a: Int, b: Int) -> Bool {
    if agrees(a, b) { return true; }
    if is_fn(a) == false { return false; }
    if is_fn(b) == false { return false; }
    if fn_arity(tb, a) != fn_arity(tb, b) { return false; }
    let mut i = 0;
    while i <= fn_arity(tb, a) {
        if fn_param(tb, a, i) != fn_param(tb, b, i) { return false; }
        i = i + 1;
    }
    let ea = fn_effect_bits(tb, a);
    let eb = fn_effect_bits(tb, b);
    let mut bit = 1;
    while bit <= 4 {
        if fx_has(ea, bit) {
            if fx_has(eb, bit) == false { return false; }
        }
        bit = bit * 2;
    }
    true
}

// The record table, as one value.
//
// The same arrays every stage since N9 has threaded one by one — `rnames`, `rowner` and the
// rest — plus what N11 needs, gathered into a record so that the machinery below takes one
// argument where it would otherwise take eighteen. A record of handles: copying it copies
// the handles, so every holder sees one table, which is exactly the sharing the separate
// arrays had.
//
// * `tpl[r]` — for an applied record or enum, the definition it applies; for a variant of
//   an applied enum, the definition's variant; `-1` for everything else.
// * `afirst[r]`/`acount[r]` — into `args`. For an application its type arguments; for a
//   `Vec` its element; for a **generic definition** its own parameters, as `t_param`
//   codes, which is where the definition's arity is read from.
// * `depth[r]` — how deeply the type nests: a built-in and a parameter are 1, `Vec[Int]`
//   is 2. Computed once, when the entry is made, from arguments that already exist.
// * `state` — `[deferred, settling, created]`, and `pending` the applications interned and
//   not yet given their fields.
pub struct Table {
    names: Strs,
    owner: Ints,
    vis: Ints,
    at: Ints,
    node: Ints,
    kind: Ints,
    first: Ints,
    count: Ints,
    fname: Strs,
    ftype: Ints,
    fat: Ints,
    tpl: Ints,
    afirst: Ints,
    acount: Ints,
    args: Ints,
    depth: Ints,
    state: Ints,
    pending: Ints,
    // `req[r]` — for a type parameter, `1` when its declaration requires equality
    // (`T: Equality`, N14), `0` otherwise and for every other entry.
    req: Ints,
    // Traits (N102): name, module, `pub`, node, and their methods' signatures — trait, name,
    // node, parameter types from `sfirst` in `sparams`, result, declared effects (`-1` none).
    // `Self` is one type parameter entry, `selfp`, shared by every trait.
    trn: Strs,
    tro: Ints,
    trp: Ints,
    trnode: Ints,
    strait: Ints,
    sname: Strs,
    snode: Ints,
    sfirst: Ints,
    scount: Ints,
    sparams: Ints,
    sret: Ints,
    seff: Ints,
    selfp: Ints,
    // Impls: trait, type, module, node, and for each of the trait's methods in order the
    // definition implementing it, from `ifirst` in `imeth` (`-1` when it does not).
    itrait: Ints,
    itype: Ints,
    imod: Ints,
    inode: Ints,
    ifirst: Ints,
    imeth: Ints,
    // A definition's effect set where its text does not say: an impl method that writes none
    // has its trait's. `-2` where the text decides.
    fdecl: Ints,
    // What each module offers of traits (N103): its own `pub` ones and those it re-exports.
    toffer: Offers,
    // Which module re-exports from which (N103): an impl in a module a direct import
    // re-exports from is usable as that import's own are.
    rsm: Ints,
    rsf: Ints,
}

// The bound reported to a program: a written type, or one a generic call produces, may
// nest this deep and no deeper — the reference's `MAX_TYPE_DEPTH`.
pub fn max_type_depth() -> Int { 32 }
// The last line, not the rule: an instance nested deeper than this is interned and never
// completed, and completion stops after this many. The ownership-cycle check reports
// first; these exist so that a refused definition cannot keep the checker busy.
fn hard_nesting() -> Int { 256 }
fn instance_budget() -> Int { 100000 }

pub fn new_table(names: Strs, owner: Ints, vis: Ints, at: Ints, node: Ints, kind: Ints,
        first: Ints, count: Ints, fname: Strs, ftype: Ints, fat: Ints) -> Table {
    let state = ints_new();
    ints_push(state, 0);
    ints_push(state, 0);
    ints_push(state, 0);
    Table(names: names, owner: owner, vis: vis, at: at, node: node, kind: kind,
            first: first, count: count, fname: fname, ftype: ftype, fat: fat,
            tpl: ints_new(), afirst: ints_new(), acount: ints_new(), args: ints_new(),
            depth: ints_new(), state: state, pending: ints_new(), req: ints_new(),
            trn: strs_new(), tro: ints_new(), trp: ints_new(), trnode: ints_new(),
            strait: ints_new(), sname: strs_new(), snode: ints_new(), sfirst: ints_new(),
            scount: ints_new(), sparams: ints_new(), sret: ints_new(), seff: ints_new(),
            selfp: ints_new(), itrait: ints_new(), itype: ints_new(), imod: ints_new(),
            inode: ints_new(), ifirst: ints_new(), imeth: ints_new(), fdecl: ints_new(),
            toffer: new_offers(), rsm: ints_new(), rsf: ints_new())
}

// One more entry, with no fields and no arguments yet. Every per-entry array grows here and
// nowhere else, so they cannot fall out of step.
pub fn new_entry(tb: Table, name: Str, owner: Int, vis: Int, at: Int, node: Int, kind: Int,
        tpl: Int) -> Int {
    strs_push(tb.names, name);
    ints_push(tb.owner, owner);
    ints_push(tb.vis, vis);
    ints_push(tb.at, at);
    ints_push(tb.node, node);
    ints_push(tb.kind, kind);
    ints_push(tb.first, strs_len(tb.fname));
    ints_push(tb.count, 0);
    ints_push(tb.tpl, tpl);
    ints_push(tb.afirst, ints_len(tb.args));
    ints_push(tb.acount, 0);
    ints_push(tb.depth, 1);
    ints_push(tb.req, 0);
    strs_len(tb.names) - 1
}

// How deeply a type nests.
pub fn depth_of(tb: Table, t: Int) -> Int {
    let r = entry_of(t);
    if r < 0 { return 1; }
    if r >= ints_len(tb.depth) { return 1; }
    ints_get(tb.depth, r)
}

// How many type parameters a declaration has: 0 unless it is a generic definition as
// written — an application has arguments, not parameters.
pub fn generic_count(tb: Table, r: Int) -> Int {
    if r < 0 { return 0; }
    if ints_get(tb.tpl, r) >= 0 { return 0; }
    let k = ints_get(tb.kind, r);
    if k == rk_vec() { return 0; }
    if k == rk_param() { return 0; }
    if k == rk_variant() { return 0; }
    ints_get(tb.acount, r)
}

// Whether entry `r` is a declaration as written: a record or an enum that applies nothing.
pub fn is_declaration(tb: Table, r: Int) -> Bool {
    if ints_get(tb.tpl, r) >= 0 { return false; }
    let k = ints_get(tb.kind, r);
    if k == rk_record() { return true; }
    k == rk_enum()
}

// The definition a type applies, or the type's own entry when it applies nothing. -1 for a
// built-in, a `Vec` or a parameter.
pub fn definition_of(tb: Table, t: Int) -> Int {
    if is_record(t) == false { return 0 - 1; }
    let r = record_of(t);
    if ints_get(tb.tpl, r) >= 0 { return ints_get(tb.tpl, r); }
    r
}

// The arguments of an application or the element of a `Vec`, as a fresh list; empty for
// anything else. A declaration's own parameters are **not** its arguments.
pub fn type_args(tb: Table, t: Int) -> Ints {
    let out = ints_new();
    let r = entry_of(t);
    if r < 0 { return out; }
    let mut applies = false;
    if ints_get(tb.kind, r) == rk_vec() { applies = true; }
    if ints_get(tb.kind, r) == rk_fn() { applies = true; }
    if ints_get(tb.tpl, r) >= 0 {
        if ints_get(tb.kind, r) != rk_variant() { applies = true; }
    }
    if applies == false { return out; }
    let mut i = 0;
    while i < ints_get(tb.acount, r) {
        ints_push(out, ints_get(tb.args, ints_get(tb.afirst, r) + i));
        i = i + 1;
    }
    out
}

// The entry of `Vec[elem]`, interned.
pub fn vec_of(tb: Table, elem: Int) -> Int {
    let mut r = 0;
    while r < ints_len(tb.kind) {
        if ints_get(tb.kind, r) == rk_vec() {
            if ints_get(tb.args, ints_get(tb.afirst, r)) == elem { return t_vec(r); }
        }
        r = r + 1;
    }
    let e = new_entry(tb, str_concat(str_concat("Vec[", shown(tb, elem)), "]"),
            0 - 1, 1, 0, 0 - 1, rk_vec(), 0 - 1);
    ints_push(tb.args, elem);
    ints_set(tb.acount, e, 1);
    ints_set(tb.depth, e, depth_of(tb, elem) + 1);
    t_vec(e)
}

// A type as a reader sees it, with its arguments: `Pair[Int, Str]`, `Vec[T]`.
pub fn shown(tb: Table, t: Int) -> Str {
    if t >= 100 {
        let r = entry_of(t);
        if r < strs_len(tb.names) { return strs_get(tb.names, r); }
        return "?";
    }
    type_name(t)
}

// `decl[args]`, interned: the entry that already exists for exactly these arguments, or a
// new one whose fields are filled in when the worklist is drained.
//
// A new application of an **enum** brings its variant entries with it, straight after its
// own, because that is where an enum's variants are found: `rk_variant` entries following
// the enum, in declaration order. They are allocated here, together, so nothing interned
// later can land between them.
pub fn apply(tb: Table, decl: Int, args: Ints) -> Int {
    let n = ints_len(args);
    let mut r = 0;
    while r < ints_len(tb.tpl) {
        if ints_get(tb.tpl, r) == decl {
            if ints_get(tb.kind, r) != rk_variant() {
                if ints_get(tb.acount, r) == n {
                    let mut same = true;
                    let mut i = 0;
                    while i < n {
                        if ints_get(tb.args, ints_get(tb.afirst, r) + i) != ints_get(args, i) {
                            same = false;
                        }
                        i = i + 1;
                    }
                    if same { return t_record(r); }
                }
            }
        }
        r = r + 1;
    }
    let mut name = str_concat(strs_get(tb.names, decl), "[");
    let mut deepest = 0;
    let mut i = 0;
    while i < n {
        if i > 0 { name = str_concat(name, ", "); }
        name = str_concat(name, shown(tb, ints_get(args, i)));
        if depth_of(tb, ints_get(args, i)) > deepest { deepest = depth_of(tb, ints_get(args, i)); }
        i = i + 1;
    }
    name = str_concat(name, "]");
    let e = new_entry(tb, name, ints_get(tb.owner, decl), ints_get(tb.vis, decl),
            ints_get(tb.at, decl), ints_get(tb.node, decl), ints_get(tb.kind, decl), decl);
    let mut a = 0;
    while a < n { ints_push(tb.args, ints_get(args, a)); a = a + 1; }
    ints_set(tb.acount, e, n);
    ints_set(tb.depth, e, deepest + 1);
    if ints_get(tb.kind, decl) == rk_enum() {
        let mut v = decl + 1;
        while v < ints_len(tb.kind) {
            if ints_get(tb.kind, v) != rk_variant() { break; }
            let ve = new_entry(tb, str_concat(str_concat(name, "."),
                    after_dot(strs_get(tb.names, v))),
                    0 - 1, ints_get(tb.vis, decl), ints_get(tb.at, v), ints_get(tb.node, v),
                    rk_variant(), v);
            ints_set(tb.afirst, ve, ints_get(tb.afirst, e));
            ints_set(tb.acount, ve, n);
            ints_set(tb.depth, ve, deepest + 1);
            v = v + 1;
        }
    }
    // Only enqueued. Completion substitutes, and substituting applies, so an `apply` that
    // completed would be a call cycle — which this compiler cannot have, since it compiles
    // itself natively. The stages that hand a type on call `settle_now` instead.
    ints_push(tb.pending, e);
    ints_set(tb.state, 2, ints_get(tb.state, 2) + 1);
    t_record(e)
}

// Complete what is pending, unless completion is being held — the call every stage makes
// before a type it produced is read.
pub fn settle_now(tb: Table) -> Int {
    if ints_get(tb.state, 0) == 1 { return 0; }
    settle(tb)
}

// Hold completion until `settle`: while field types are still being resolved, a
// definition an application names may not have any fields yet.
pub fn defer(tb: Table) -> Int {
    ints_set(tb.state, 0, 1);
    0
}

// Give every pending application its fields, and every application completing them
// creates. A worklist, so completion never recurses into completion.
pub fn settle(tb: Table) -> Int {
    ints_set(tb.state, 0, 0);
    if ints_get(tb.state, 1) == 1 { return 0; }
    ints_set(tb.state, 1, 1);
    while ints_len(tb.pending) > 0 {
        complete(tb, ints_pop(tb.pending));
    }
    ints_set(tb.state, 1, 0);
    0
}

// The parameters of a generic definition and the arguments of one application of it, as
// the two lists `substitute` reads.
fn params_of(tb: Table, decl: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_get(tb.acount, decl) {
        ints_push(out, ints_get(tb.args, ints_get(tb.afirst, decl) + i));
        i = i + 1;
    }
    out
}

// Copy the field list of `from` onto `to`, substituted. The slots are reserved first and
// filled after, because substituting may intern more applications — which only push
// entries, never fields, so the reserved run stays contiguous.
fn copy_fields(tb: Table, from: Int, to: Int, params: Ints, args: Ints) -> Int {
    ints_set(tb.first, to, strs_len(tb.fname));
    ints_set(tb.count, to, ints_get(tb.count, from));
    let base = strs_len(tb.fname);
    let mut i = 0;
    while i < ints_get(tb.count, from) {
        strs_push(tb.fname, strs_get(tb.fname, ints_get(tb.first, from) + i));
        ints_push(tb.ftype, 0);
        ints_push(tb.fat, ints_get(tb.fat, ints_get(tb.first, from) + i));
        i = i + 1;
    }
    i = 0;
    while i < ints_get(tb.count, from) {
        let t = ints_get(tb.ftype, ints_get(tb.first, from) + i);
        ints_set(tb.ftype, base + i, substitute(tb, t, params, args));
        i = i + 1;
    }
    0
}

fn complete(tb: Table, e: Int) -> Int {
    if ints_get(tb.state, 2) > instance_budget() { return 0; }
    if ints_get(tb.depth, e) > hard_nesting() { return 0; }
    let decl = ints_get(tb.tpl, e);
    let params = params_of(tb, decl);
    let args = type_args(tb, t_record(e));
    if ints_get(tb.kind, e) == rk_enum() {
        // The enum's fields are its variants, each typed as **this** application's variant
        // entry — at the same distance from the enum as the definition's is from its own.
        ints_set(tb.first, e, strs_len(tb.fname));
        ints_set(tb.count, e, ints_get(tb.count, decl));
        let mut i = 0;
        while i < ints_get(tb.count, decl) {
            let at = ints_get(tb.first, decl) + i;
            strs_push(tb.fname, strs_get(tb.fname, at));
            ints_push(tb.ftype, t_record(e + (record_of(ints_get(tb.ftype, at)) - decl)));
            ints_push(tb.fat, ints_get(tb.fat, at));
            i = i + 1;
        }
        let mut v = e + 1;
        while v < ints_len(tb.kind) {
            if ints_get(tb.kind, v) != rk_variant() { break; }
            if ints_get(tb.tpl, v) < 0 { break; }
            copy_fields(tb, ints_get(tb.tpl, v), v, params, args);
            v = v + 1;
        }
        return 0;
    }
    copy_fields(tb, decl, e, params, args)
}

// `t` with every parameter in `params` replaced by the matching argument.
//
// Parameters of any other owner are left alone: substituting a callee's parameters in its
// signature must not touch the caller's own `T`, which may be one of the arguments.
//
// Post-order over the type's tree with an explicit stack, because an application's
// substituted arguments are needed before it can be re-applied — and this compiler has no
// recursion to do that with. `from`/`to` remember what each part became.
pub fn substitute(tb: Table, t: Int, params: Ints, args: Ints) -> Int {
    if t < 100 { return t; }
    let from = ints_new();
    let to = ints_new();
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let x = ints_get(work, ints_len(work) - 1);
        if index_of(from, x) >= 0 {
            ints_pop(work);
            continue;
        }
        if x < 100 {
            ints_push(from, x);
            ints_push(to, x);
            ints_pop(work);
            continue;
        }
        if is_param(x) {
            let at = index_of(params, x);
            ints_push(from, x);
            if at >= 0 {
                if at < ints_len(args) { ints_push(to, ints_get(args, at)); } else { ints_push(to, x); }
            } else {
                ints_push(to, x);
            }
            ints_pop(work);
            continue;
        }
        let parts = type_args(tb, x);
        let mut waiting = false;
        let mut i = 0;
        while i < ints_len(parts) {
            if index_of(from, ints_get(parts, i)) < 0 {
                ints_push(work, ints_get(parts, i));
                waiting = true;
            }
            i = i + 1;
        }
        if waiting { continue; }
        let made = ints_new();
        let mut changed = false;
        i = 0;
        while i < ints_len(parts) {
            let now = ints_get(to, index_of(from, ints_get(parts, i)));
            if now != ints_get(parts, i) { changed = true; }
            ints_push(made, now);
            i = i + 1;
        }
        let mut result = x;
        if changed {
            if is_fn(x) {
                let ps = ints_new();
                let mut q = 0;
                while q < ints_len(made) - 1 { ints_push(ps, ints_get(made, q)); q = q + 1; }
                result = fn_of(tb, ps, ints_get(made, ints_len(made) - 1), fn_effect_bits(tb, x));
            } else {
                if is_vec(x) {
                    result = vec_of(tb, ints_get(made, 0));
                } else {
                    result = apply(tb, ints_get(tb.tpl, record_of(x)), made);
                }
            }
        }
        ints_push(from, x);
        ints_push(to, result);
        ints_pop(work);
    }
    ints_get(to, index_of(from, t))
}

pub fn index_of(xs: Ints, want: Int) -> Int {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == want { return i; }
        i = i + 1;
    }
    0 - 1
}

// Whether `t` mentions any parameter in `params`, anywhere. A walk, not a fold: the first
// one found answers.
pub fn mentions(tb: Table, t: Int, params: Ints) -> Bool {
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let x = ints_pop(work);
        if is_param(x) {
            if index_of(params, x) >= 0 { return true; }
        } else {
            let parts = type_args(tb, x);
            let mut i = 0;
            while i < ints_len(parts) { ints_push(work, ints_get(parts, i)); i = i + 1; }
        }
    }
    false
}

// Whether `t` mentions any parameter at all — whether it is concrete.
pub fn is_concrete(tb: Table, t: Int) -> Bool {
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let x = ints_pop(work);
        if is_param(x) { return false; }
        let parts = type_args(tb, x);
        let mut i = 0;
        while i < ints_len(parts) { ints_push(work, ints_get(parts, i)); i = i + 1; }
    }
    true
}

// --- written types ---------------------------------------------------------------------
//
// A type's text, as `compiler/parse.nz` writes it, flattened into prefix order: one item
// per name, with where it is written and how many arguments it was given — `-1` for a name
// written with no brackets at all, which is a different thing from `[]`.
//
// A top-level type with no arguments carries no offsets (`Int`), and its items say `-1`:
// the caller knows where it is written from the node it belongs to.
pub fn type_items(tt: Str, inames: Strs, istart: Ints, iend: Ints, iargs: Ints) -> Int {
    let n = str_len(tt);
    let open = ints_new();
    let mut i = 0;
    let mut want_name = true;
    while i < n {
        if want_name {
            let from = i;
            while i < n {
                let b = str_byte(tt, i);
                if b == 64 { break; }
                if b == 91 { break; }
                if b == 44 { break; }
                if b == 93 { break; }
                i = i + 1;
            }
            let name = str_slice(tt, from, i);
            let mut start = 0 - 1;
            if i < n {
                if str_byte(tt, i) == 64 {
                    i = i + 1;
                    start = 0;
                    while i < n {
                        let d = str_byte(tt, i);
                        if d < 48 { break; }
                        if d > 57 { break; }
                        start = start * 10 + (d - 48);
                        i = i + 1;
                    }
                }
            }
            strs_push(inames, name);
            ints_push(istart, start);
            if start >= 0 { ints_push(iend, start + str_len(name)); } else { ints_push(iend, 0 - 1); }
            ints_push(iargs, 0 - 1);
            if ints_len(open) > 0 {
                let top = ints_get(open, ints_len(open) - 1);
                ints_set(iargs, top, ints_get(iargs, top) + 1);
            }
            want_name = false;
            if i < n {
                if str_byte(tt, i) == 91 {
                    ints_push(open, strs_len(inames) - 1);
                    ints_set(iargs, strs_len(inames) - 1, 0);
                    i = i + 1;
                    want_name = true;
                    if i < n {
                        if str_byte(tt, i) == 93 { want_name = false; }
                    }
                }
            }
            continue;
        }
        let b = str_byte(tt, i);
        if b == 44 {
            i = i + 1;
            want_name = true;
            continue;
        }
        if b == 93 {
            i = i + 1;
            let mut end = 0;
            if i < n {
                if str_byte(tt, i) == 64 {
                    i = i + 1;
                    while i < n {
                        let d = str_byte(tt, i);
                        if d < 48 { break; }
                        if d > 57 { break; }
                        end = end * 10 + (d - 48);
                        i = i + 1;
                    }
                }
            }
            let top = ints_pop(open);
            ints_set(iend, top, end);
            continue;
        }
        i = i + 1;
    }
    strs_len(inames)
}

// The type parameter `name` means in a scope, or -1: a scope is the declaration's own
// parameters, as `t_param` codes.
fn in_scope(tb: Table, tscope: Ints, name: Str) -> Int {
    let mut i = 0;
    while i < ints_len(tscope) {
        if strs_get(tb.names, entry_of(ints_get(tscope, i))) == name {
            return ints_get(tscope, i);
        }
        i = i + 1;
    }
    0 - 1
}

// A written type, resolved: its names, its arguments, and the applications they make.
//
// The reference's `resolve_written`, rule for rule. A type parameter in `scope` shadows
// every other name; `Vec` is the one generic built-in; a built-in and a parameter take no
// arguments (`N0351`); a generic definition is written with them (`N0352`) and with exactly
// as many as it declares (`N0353`); and the whole may nest `max_type_depth` deep (`N0338`).
// `from`/`to` is where a top-level type with no offsets of its own is written.
pub fn resolve_written(tb: Table, tt: Str, owner: Int, tscope: Ints, from: Int, to: Int,
        tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Int {
    let inames = strs_new();
    let istart = ints_new();
    let iend = ints_new();
    let iargs = ints_new();
    type_items(tt, inames, istart, iend, iargs);
    let vals = ints_new();
    let mut i = strs_len(inames) - 1;
    while i >= 0 {
        let name = strs_get(inames, i);
        let mut at = ints_get(istart, i);
        let mut end = ints_get(iend, i);
        if at < 0 {
            // A top-level type with no offsets of its own ends where the node it belongs to
            // ends — a parameter's or a field's — so its name is the last thing written.
            at = to - str_len(name);
            end = to;
        }
        let name_end = at + str_len(name);
        let written = ints_get(iargs, i);
        let args = ints_new();
        let mut a = 0;
        while a < written { ints_push(args, ints_pop(vals)); a = a + 1; }
        let mut result = t_unknown();
        let mut done = false;
        let p = in_scope(tb, tscope, name);
        if p >= 0 {
            if written >= 0 {
                report(diags, "N0351", at, end,
                        str_concat(str_concat("`", name),
                        "` is a type parameter, so it takes no type arguments"));
            }
            result = p;
            done = true;
        }
        // A function type (N102): `fn%BITS`, its parameters and then its result.
        if done == false {
            if str_len(name) > 3 {
                if str_slice(name, 0, 3) == "fn%" {
                    let ps = ints_new();
                    let mut q = 0;
                    while q < ints_len(args) - 1 { ints_push(ps, ints_get(args, q)); q = q + 1; }
                    result = fn_of(tb, ps, ints_get(args, ints_len(args) - 1),
                            fx_number(str_slice(name, 3, str_len(name))));
                    done = true;
                }
            }
        }
        if done == false {
            if name == "Vec" {
                if written < 0 {
                    report(diags, "N0352", at, name_end,
                            "`Vec` is written with its element type");
                } else {
                    if written != 1 {
                        report(diags, "N0353", at, end,
                                str_concat(str_concat("`Vec` takes 1 type argument, but ",
                                int_to_str(written)), " were given"));
                    }
                    let mut elem = t_int();
                    if written > 0 { elem = ints_get(args, 0); }
                    result = vec_of(tb, elem);
                }
                done = true;
            }
        }
        if done == false {
            let built = type_of_name(name);
            if built != t_unknown() {
                if written >= 0 {
                    report(diags, "N0351", at, end,
                            str_concat(str_concat("`", name),
                            "` is a built-in type, so it takes no type arguments"));
                }
                result = built;
                done = true;
            }
        }
        if done == false {
            let t = type_in(name, owner, tb.names, tb.owner, tmod, tname, trec);
            if t == t_unknown() {
                if trait_named(tb, name) >= 0 {
                    // A trait as a type (N102): no trait objects, no dynamic dispatch.
                    report(diags, "N0607", at, name_end,
                            str_concat(str_concat("`", name), "` is a trait, not a type"));
                } else {
                    report(diags, "N0305", at, name_end,
                            str_concat(str_concat("`", name), "` is not a type"));
                }
            } else {
                let decl = record_of(t);
                let arity = generic_count(tb, decl);
                if written < 0 {
                    if arity == 0 {
                        result = t;
                    } else {
                        report(diags, "N0352", at, name_end,
                                str_concat(str_concat(str_concat(str_concat("`", name),
                                "` is generic, so it is written with its "),
                                int_to_str(arity)), " type arguments"));
                    }
                } else {
                    if arity == 0 {
                        report(diags, "N0351", at, end,
                                str_concat(str_concat("`", name),
                                "` is not generic, so it takes no type arguments"));
                        result = t;
                    } else {
                        if written != arity {
                            report(diags, "N0353", at, end,
                                    str_concat(str_concat(str_concat(str_concat(str_concat(
                                    "`", name), "` takes "), int_to_str(arity)),
                                    " type arguments, but "),
                                    str_concat(int_to_str(written), " were given")));
                            while ints_len(args) > arity { ints_pop(args); }
                            while ints_len(args) < arity { ints_push(args, t_int()); }
                        }
                        result = apply(tb, decl, args);
                    }
                }
            }
        }
        ints_push(vals, result);
        i = i - 1;
    }
    let t = ints_pop(vals);
    if depth_of(tb, t) > max_type_depth() {
        let mut whole_from = ints_get(istart, 0);
        let mut whole_to = ints_get(iend, 0);
        if whole_from < 0 {
            whole_from = to - str_len(strs_get(inames, 0));
            whole_to = to;
        }
        report(diags, "N0338", whole_from, whole_to,
                "types may nest 32 deep");
        return t_unknown();
    }
    settle_now(tb);
    t
}

// Declared type parameters, from `[A@7,B@10]`: one `rk_param` entry each, in order, and the
// two refusals a parameter list can earn — a built-in type's name or `Vec` (`N0331`), and a
// name used twice (`N0350`). Returns the parameters as `t_param` codes.
// The requirement written on item `n` of a parameter list — `Equality@8` from
// `[T@5=Equality@8,U@20]` — or `""`. N14; the parser writes it after the parameter's own
// position, where every other reader of the list stops.
fn requirement_of(text: Str, n: Int) -> Str {
    let mut item = 0;
    let mut i = 1;
    let mut from = 1;
    while i <= str_len(text) {
        let mut edge = false;
        if i == str_len(text) { edge = true; } else {
            let b = str_byte(text, i);
            if b == 44 { edge = true; }
            if b == 93 { edge = true; }
        }
        if edge {
            if item == n {
                let mut j = from;
                while j < i {
                    if str_byte(text, j) == 61 { return str_slice(text, j + 1, i); }
                    j = j + 1;
                }
                return "";
            }
            item = item + 1;
            from = i + 1;
        }
        i = i + 1;
    }
    ""
}

// `Equality` from `Equality@8`.
fn requirement_name(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 64 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// `8` from `Equality@8`.
fn requirement_start(s: Str) -> Int {
    let mut i = 0;
    let mut n = 0;
    let mut seen = false;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if seen {
            if b >= 48 {
                if b <= 57 { n = n * 10 + (b - 48); }
            }
        }
        if b == 64 { seen = true; }
        i = i + 1;
    }
    n
}

// A declaration's type parameters, as entries. `allow` is whether a requirement may be
// written on them: a function's may, a record's or an enum's may not (`N0101`), as the
// reference has it.
pub fn declare_params(tb: Table, text: Str, allow: Bool, diags: Vec[Diag]) -> Ints {
    let out = ints_new();
    if str_len(text) == 0 { return out; }
    let inames = strs_new();
    let istart = ints_new();
    let iend = ints_new();
    let iargs = ints_new();
    // `[A@7,B@10]` is the argument list of a nameless item, which is exactly the shape
    // `type_items` reads.
    type_items(str_concat("_", text), inames, istart, iend, iargs);
    let mut i = 1;
    while i < strs_len(inames) {
        let name = strs_get(inames, i);
        let at = ints_get(istart, i);
        if type_of_name(name) != t_unknown() {
            report(diags, "N0331", at, at + str_len(name),
                    str_concat(str_concat("`", name),
                    "` is a built-in type and cannot be a type parameter"));
        } else {
            if name == "Vec" {
                report(diags, "N0331", at, at + str_len(name),
                        "`Vec` is a built-in type and cannot be a type parameter");
            } else {
                let mut j = 1;
                let mut twice = false;
                while j < i {
                    if strs_get(inames, j) == name { twice = true; }
                    j = j + 1;
                }
                if twice {
                    report(diags, "N0350", at, at + str_len(name),
                            str_concat(str_concat("`", name),
                            "` is declared twice in this parameter list"));
                }
            }
        }
        let p = new_entry(tb, name, 0 - 1, 0, at, 0 - 1, rk_param(), 0 - 1);
        let written = requirement_of(text, i - 1);
        if written != "" {
            let cap = requirement_name(written);
            let cap_at = requirement_start(written);
            if allow == false {
                report(diags, "N0101", cap_at, cap_at + str_len(cap),
                        "a requirement on a record's or an enum's type parameter is not supported yet");
            } else {
                if cap == "Equality" {
                    ints_set(tb.req, p, 1);
                } else {
                    // A trait (N102): `[T: Show]` lets the body call its methods on a `T`.
                    let tr = trait_named(tb, cap);
                    if tr >= 0 {
                        ints_set(tb.req, p, tr + 2);
                    } else {
                        report(diags, "N0365", cap_at, cap_at + str_len(cap),
                                str_concat(str_concat("`", cap),
                                "` is not a capability a type parameter can require"));
                    }
                }
            }
        }
        ints_push(out, t_param(p));
        i = i + 1;
    }
    out
}

// A declaration's text without its parameter list: `Pair` from `Pair[A@7,B@10]`.
pub fn before_bracket(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 91 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// The parameter list itself, brackets included, or `""`.
pub fn from_bracket(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 91 { return str_slice(s, i, str_len(s)); }
        i = i + 1;
    }
    ""
}

// A function's name, from its node's text `name[T@3]:ret`.
pub fn fn_name(text: Str) -> Str { before_bracket(before_colon(text)) }

// Written type arguments, from the text after a name in an expression —
// `[Int@9,Vec@13[Str@17]@20]` — resolved in `scope`, one type per argument, in order.
//
// Split at the commas outside any inner bracket; each piece is a complete written type with
// its own offsets, which is exactly what `resolve_written` reads.
pub fn resolve_type_args(tb: Table, text: Str, owner: Int, tscope: Ints,
        tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Ints {
    let out = ints_new();
    let n = str_len(text);
    if n < 2 { return out; }
    let mut depth = 0;
    let mut from = 1;
    let mut i = 1;
    while i < n - 1 {
        let b = str_byte(text, i);
        if b == 91 { depth = depth + 1; }
        if b == 93 { depth = depth - 1; }
        if b == 44 {
            if depth == 0 {
                ints_push(out, resolve_written(tb, str_slice(text, from, i), owner, tscope, 0, 0,
                        tmod, tname, trec, diags));
                from = i + 1;
            }
        }
        i = i + 1;
    }
    if n - 1 > from {
        ints_push(out, resolve_written(tb, str_slice(text, from, n - 1), owner, tscope, 0, 0,
                tmod, tname, trec, diags));
    }
    out
}

// A definition named in an expression — a construction's or a variant's head — applied to
// the type arguments written after it: the reference's `applied`. A non-generic one takes
// none (`N0351`), a generic one is built with them written — a construction infers nothing
// (`N0352`) — and with exactly as many as it declares (`N0353`). `from`/`to` is the name.
//
// `t_unknown` where the arguments were needed and missing: the caller checks what it can
// without a type rather than against one invented here.
pub fn apply_written(tb: Table, def: Int, text: Str, from: Int, to: Int, owner: Int,
        tscope: Ints, tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Int {
    let decl = record_of(def);
    let arity = generic_count(tb, decl);
    let name = strs_get(tb.names, decl);
    if str_len(text) == 0 {
        if arity == 0 { return def; }
        report(diags, "N0352", from, to,
                str_concat(str_concat(str_concat(str_concat("`", name),
                "` is generic, so it is built with its "), int_to_str(arity)),
                " type arguments written"));
        return t_unknown();
    }
    let args = resolve_type_args(tb, text, owner, tscope, tmod, tname, trec,
            diags);
    if arity == 0 {
        report(diags, "N0351", from, to,
                str_concat(str_concat("`", name),
                "` is not generic, so it takes no type arguments"));
        return def;
    }
    if ints_len(args) != arity {
        report(diags, "N0353", from, to,
                str_concat(str_concat(str_concat(str_concat(str_concat("`", name),
                "` takes "), int_to_str(arity)), " type arguments, but "),
                str_concat(int_to_str(ints_len(args)), " were given")));
        while ints_len(args) > arity { ints_pop(args); }
        while ints_len(args) < arity { ints_push(args, t_int()); }
    }
    let t = apply(tb, decl, args);
    settle_now(tb);
    t
}

// --- the ownership graph, N11 --------------------------------------------------------------
//
// `crates/nazm-sema/src/udt.rs`'s rule, over **definitions**, transcribed. A field reaches
// a definition **inline** when a value of it is stored in place and **counted** when it is
// reached through a `Vec`'s handle. An all-inline cycle is an impossible layout (`N0336`);
// any cycle with a counted edge is an ownership cycle a count could never break (`N0359`).
//
// What a generic definition does with each of its parameters — stores it inline, behind a
// handle, both or not at all — is found first, to a fixed point, so that `Tag[T] { n: Int }`
// applied to anything owns nothing of it and `Box[T] { v: T }` applied to a type owns it
// inline.

fn inline_reach() -> Int { 1 }
fn counted_reach() -> Int { 2 }

// How a use through `outer` composes with a use of kind `inner`: inline only when both are,
// counted as soon as either is.
fn compose(outer: Int, inner: Int) -> Int {
    let mut out = 0;
    if outer % 2 == 1 {
        if inner % 2 == 1 { out = out + 1; }
    }
    let mut counted = false;
    if outer >= 2 {
        if inner > 0 { counted = true; }
    }
    if inner >= 2 {
        if outer > 0 { counted = true; }
    }
    if counted { out = out + 2; }
    out
}

fn has_bit(v: Int, bit: Int) -> Bool {
    if bit == 1 { return v % 2 == 1; }
    v >= 2
}

// The field types a definition holds: a record's fields, or every variant's payload.
fn contained(tb: Table, d: Int) -> Ints {
    let out = ints_new();
    if ints_get(tb.kind, d) == rk_enum() {
        let mut v = d + 1;
        while v < ints_len(tb.kind) {
            if ints_get(tb.kind, v) != rk_variant() { break; }
            let mut i = 0;
            while i < ints_get(tb.count, v) {
                ints_push(out, ints_get(tb.ftype, ints_get(tb.first, v) + i));
                i = i + 1;
            }
            v = v + 1;
        }
        return out;
    }
    let mut i = 0;
    while i < ints_get(tb.count, d) {
        ints_push(out, ints_get(tb.ftype, ints_get(tb.first, d) + i));
        i = i + 1;
    }
    out
}

// How every entry reaches a value of parameter `p`, given how each generic definition uses
// its parameters. One pass in entry order is enough: an application's arguments and a
// `Vec`'s element are always interned before it, so they are answered first.
fn reaches(tb: Table, p: Int, uses: Ints) -> Ints {
    let val = ints_new();
    let mut r = 0;
    while r < ints_len(tb.kind) {
        let k = ints_get(tb.kind, r);
        let mut v = 0;
        if k == rk_param() {
            if t_param(r) == p { v = inline_reach(); }
        }
        if k == rk_vec() {
            if reach_of(val, ints_get(tb.args, ints_get(tb.afirst, r))) > 0 { v = counted_reach(); }
        }
        if ints_get(tb.tpl, r) >= 0 {
            if k != rk_variant() {
                let decl = ints_get(tb.tpl, r);
                let mut i = 0;
                while i < ints_get(tb.acount, r) {
                    let inner = reach_of(val, ints_get(tb.args, ints_get(tb.afirst, r) + i));
                    if inner > 0 {
                        let used = ints_get(uses, entry_of(ints_get(tb.args,
                                ints_get(tb.afirst, decl) + i)));
                        v = merge(v, compose(used, inner));
                    }
                    i = i + 1;
                }
            }
        }
        ints_push(val, v);
        r = r + 1;
    }
    val
}

fn reach_of(val: Ints, t: Int) -> Int {
    let r = entry_of(t);
    if r < 0 { return 0; }
    if r >= ints_len(val) { return 0; }
    ints_get(val, r)
}

// The union of two reach sets.
fn merge(a: Int, b: Int) -> Int {
    let mut out = 0;
    if has_bit(a, 1) { out = 1; }
    if has_bit(b, 1) { out = 1; }
    if has_bit(a, 2) { out = out + 2; } else {
        if has_bit(b, 2) { out = out + 2; }
    }
    out
}

// How each generic definition uses each of its parameters, by parameter entry, to a fixed
// point. Monotone — each round only adds kinds — so it settles.
fn parameter_uses(tb: Table) -> Ints {
    let uses = ints_new();
    let mut r = 0;
    while r < ints_len(tb.kind) { ints_push(uses, 0); r = r + 1; }
    let mut changed = true;
    while changed {
        changed = false;
        let mut d = 0;
        while d < ints_len(tb.kind) {
            if is_declaration(tb, d) {
                let mut i = 0;
                while i < generic_count(tb, d) {
                    let p = ints_get(tb.args, ints_get(tb.afirst, d) + i);
                    let val = reaches(tb, p, uses);
                    let held = contained(tb, d);
                    let mut used = 0;
                    let mut f = 0;
                    while f < ints_len(held) {
                        used = merge(used, reach_of(val, ints_get(held, f)));
                        f = f + 1;
                    }
                    let was = ints_get(uses, entry_of(p));
                    if merge(was, used) != was {
                        ints_set(uses, entry_of(p), merge(was, used));
                        changed = true;
                    }
                    i = i + 1;
                }
            }
            d = d + 1;
        }
    }
    uses
}

// Every edge of the ownership graph: from a definition, through one of its fields, to a
// definition a value of it may own, and how. `efield` is the field's index in the table's
// flat field arrays, so a message can name it.
fn ownership_edges(tb: Table, uses: Ints, efrom: Ints, eto: Ints, ereach: Ints,
        efield: Ints) -> Int {
    let mut d = 0;
    while d < ints_len(tb.kind) {
        if is_declaration(tb, d) {
            // The fields, each with its place in the flat arrays.
            let fields = ints_new();
            if ints_get(tb.kind, d) == rk_enum() {
                let mut v = d + 1;
                while v < ints_len(tb.kind) {
                    if ints_get(tb.kind, v) != rk_variant() { break; }
                    let mut i = 0;
                    while i < ints_get(tb.count, v) {
                        ints_push(fields, ints_get(tb.first, v) + i);
                        i = i + 1;
                    }
                    v = v + 1;
                }
            } else {
                let mut i = 0;
                while i < ints_get(tb.count, d) {
                    ints_push(fields, ints_get(tb.first, d) + i);
                    i = i + 1;
                }
            }
            let mut f = 0;
            while f < ints_len(fields) {
                let at = ints_get(fields, f);
                let work = ints_new();
                let wreach = ints_new();
                ints_push(work, ints_get(tb.ftype, at));
                ints_push(wreach, inline_reach());
                while ints_len(work) > 0 {
                    let t = ints_pop(work);
                    let reach = ints_pop(wreach);
                    if is_vec(t) {
                        ints_push(work, ints_get(tb.args, ints_get(tb.afirst, entry_of(t))));
                        ints_push(wreach, counted_reach());
                    }
                    if is_record(t) {
                        let to = definition_of(tb, t);
                        if ints_get(tb.kind, to) != rk_variant() {
                            ints_push(efrom, d);
                            ints_push(eto, to);
                            ints_push(ereach, reach);
                            ints_push(efield, at);
                            let parts = type_args(tb, t);
                            let mut k = 0;
                            while k < ints_len(parts) {
                                let used = ints_get(uses, entry_of(ints_get(tb.args,
                                        ints_get(tb.afirst, to) + k)));
                                let through = compose(used, reach);
                                if has_bit(through, 1) {
                                    ints_push(work, ints_get(parts, k));
                                    ints_push(wreach, inline_reach());
                                }
                                if has_bit(through, 2) {
                                    ints_push(work, ints_get(parts, k));
                                    ints_push(wreach, counted_reach());
                                }
                                k = k + 1;
                            }
                        }
                    }
                }
                f = f + 1;
            }
        }
        d = d + 1;
    }
    ints_len(efrom)
}

// Stage 0c: refuse the definitions that cannot be laid out, and the ones whose values
// could own themselves through a `Vec`.
//
// Two passes, as the reference makes them. The first follows inline edges only and finds
// the impossible layouts; the second follows every edge, stays out of what the first
// reported, and finds the cycles through a counted handle. One cycle is reported once.
pub fn check_ownership(tb: Table, diags: Vec[Diag]) -> Int {
    let uses = parameter_uses(tb);
    let efrom = ints_new();
    let eto = ints_new();
    let ereach = ints_new();
    let efield = ints_new();
    ownership_edges(tb, uses, efrom, eto, ereach, efield);
    let reported = ints_new();
    let mut found = 0;
    let mut pass = 1;
    while pass <= 2 {
        let mut start = 0;
        while start < ints_len(tb.kind) {
            let mut eligible = is_declaration(tb, start);
            if contains(reported, start) { eligible = false; }
            if eligible {
                if find_cycle(tb, start, pass, reported, efrom, eto, ereach, efield,
                        diags) {
                    found = found + 1;
                }
            }
            start = start + 1;
        }
        pass = pass + 1;
    }
    found
}

// A cycle reachable from `start` over the edges `pass` allows — inline ones only, or all —
// avoiding what is already reported. Reported, and its definitions added to `reported`,
// when there is one.
fn find_cycle(tb: Table, start: Int, pass: Int, reported: Ints,
        efrom: Ints, eto: Ints, ereach: Ints, efield: Ints,
        diags: Vec[Diag]) -> Bool {
    // One frame per node on the path: the node, the next edge to try, and the edge that
    // entered it (-1 for the start).
    let snode = ints_new();
    let snext = ints_new();
    let sedge = ints_new();
    let done = ints_new();
    ints_push(snode, start);
    ints_push(snext, 0);
    ints_push(sedge, 0 - 1);
    while ints_len(snode) > 0 {
        let top = ints_len(snode) - 1;
        let node = ints_get(snode, top);
        let mut e = ints_get(snext, top);
        let mut edge = 0 - 1;
        while e < ints_len(efrom) {
            if ints_get(efrom, e) == node {
                edge = e;
                e = ints_len(efrom);
            } else {
                e = e + 1;
            }
        }
        if edge < 0 {
            ints_push(done, node);
            ints_pop(snode);
            ints_pop(snext);
            ints_pop(sedge);
            continue;
        }
        ints_set(snext, top, edge + 1);
        let to = ints_get(eto, edge);
        let reach = ints_get(ereach, edge);
        let mut allowed = true;
        if pass == 1 {
            if has_bit(reach, 1) == false { allowed = false; }
            if reach != inline_reach() { allowed = false; }
        }
        if contains(reported, to) { allowed = false; }
        if contains(done, to) { allowed = false; }
        if allowed {
            let back = index_of(snode, to);
            if back >= 0 {
                // The suffix of the path from where it re-enters, closed by this edge.
                let mut counted = false;
                if reach != inline_reach() { counted = true; }
                let mut names = "";
                let mut path = "";
                let mut j = back;
                while j < ints_len(snode) {
                    let n = ints_get(snode, j);
                    ints_push(reported, n);
                    if j > back {
                        if ints_get(ereach, ints_get(sedge, j)) != inline_reach() { counted = true; }
                        path = str_concat(str_concat(path, hop_name(tb, ints_get(efield,
                                ints_get(sedge, j)), ints_get(efrom, ints_get(sedge, j)))), " → ");
                    }
                    names = str_concat(str_concat(names, strs_get(tb.names, n)), " → ");
                    j = j + 1;
                }
                path = str_concat(str_concat(path, hop_name(tb, ints_get(efield, edge), node)),
                        " → ");
                let first = strs_get(tb.names, to);
                let at = ints_get(tb.at, to);
                if counted {
                    report(diags, "N0359", at, at + str_len(first),
                            str_concat(str_concat(str_concat(str_concat("`", first),
                            "` can own itself through a `Vec`: "), path), first));
                } else {
                    report(diags, "N0336", at, at + str_len(first),
                            str_concat(str_concat("`", first), "` contains itself"));
                }
                return true;
            }
            ints_push(snode, to);
            ints_push(snext, 0);
            ints_push(sedge, edge);
        }
    }
    false
}

// One hop of an ownership path as a reader would find it: `Node.children`, or
// `Tree.Branch.kids` for a payload field.
fn hop_name(tb: Table, field: Int, from: Int) -> Str {
    let fname = strs_get(tb.fname, field);
    // A payload field belongs to one of the enum's variants, whose entry names it.
    let mut v = from + 1;
    while v < ints_len(tb.kind) {
        if ints_get(tb.kind, v) != rk_variant() { break; }
        let first = ints_get(tb.first, v);
        if field >= first {
            if field < first + ints_get(tb.count, v) {
                return str_concat(str_concat(strs_get(tb.names, v), "."), fname);
            }
        }
        v = v + 1;
    }
    str_concat(str_concat(strs_get(tb.names, from), "."), fname)
}

// --- the record table -----------------------------------------------------------------
//
// `rnames[r]`, `rowner[r]`, `rpub[r]` and `rat[r]` are a record's name, module,
// visibility and where its name is written. `rfirst[r]` and `rcount[r]` index the flat
// field arrays `rfname` and `rftype`.
//
// Field **declaration order** is what is stored, because that is what a reader wrote and
// what a diagnostic shows. The layout order — canonical, by field name — is the emitter's
// and is computed there, which is the layout boundary.

// The field of record `r` called `name`, as an index into that record's own fields, or -1.
pub fn field_index(rfirst: Ints, rcount: Ints, rfname: Strs, r: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_get(rcount, r) {
        if strs_get(rfname, ints_get(rfirst, r) + i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

pub fn field_type(rfirst: Ints, rftype: Ints, r: Int, at: Int) -> Int {
    ints_get(rftype, ints_get(rfirst, r) + at)
}

// Whether a value of this type owns storage that has to be released.
//
// A record does exactly when some field does, recursively — which is the composition N9
// is a test of. Iterative, with an explicit worklist, because the depth is a property of
// the program rather than of this compiler.
pub fn needs_cleanup(t: Int, rfirst: Ints, rcount: Ints, rftype: Ints) -> Bool {
    if t == t_int() { return false; }
    if t == t_bool() { return false; }
    if t == t_unknown() { return false; }
    // A capability is authority, not storage (N102).
    if is_cap(t) { return false; }
    if is_record(t) == false { return true; }
    let work = ints_new();
    let seen = ints_new();
    ints_push(work, record_of(t));
    while ints_len(work) > 0 {
        let r = ints_pop(work);
        if contains(seen, r) == false {
            ints_push(seen, r);
            let mut i = 0;
            while i < ints_get(rcount, r) {
                let ft = ints_get(rftype, ints_get(rfirst, r) + i);
                if is_record(ft) {
                    ints_push(work, record_of(ft));
                } else {
                    if ft != t_int() {
                        if ft != t_bool() {
                            if ft != t_unknown() {
                                if is_cap(ft) == false { return true; }
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
    }
    false
}

pub fn contains(xs: Ints, want: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == want { return true; }
        i = i + 1;
    }
    false
}

// The field path that makes this type illegal to pass to a task, or `""` when there is
// none. A record may cross exactly when every field may, recursively.
//
// Depth-first over declaration order, so the path reported is the first one a reader
// would find. Iterative: the stack is the path.
pub fn task_unsafe_path(t: Int, rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints) -> Str {
    if is_record(t) == false {
        if t == t_ints() { return "."; }
        if t == t_strs() { return "."; }
        // Every `Vec` is a handle to shared mutable storage, whatever it holds, and a type
        // parameter is a type about which nothing is known — so neither may cross.
        if is_vec(t) { return "."; }
        if is_param(t) { return "."; }
        // A function value may not be passed to a task (N50, N102).
        if is_fn(t) { return "."; }
        return "";
    }
    let at = ints_new();
    let which = ints_new();
    let path = strs_new();
    ints_push(at, record_of(t));
    ints_push(which, 0);
    while ints_len(at) > 0 {
        let r = ints_get(at, ints_len(at) - 1);
        let i = ints_get(which, ints_len(which) - 1);
        if i >= ints_get(rcount, r) {
            ints_pop(at);
            ints_pop(which);
            if strs_len(path) > 0 { strs_pop(path); }
        } else {
            ints_set(which, ints_len(which) - 1, i + 1);
            let ft = ints_get(rftype, ints_get(rfirst, r) + i);
            let fname = strs_get(rfname, ints_get(rfirst, r) + i);
            if is_record(ft) {
                strs_push(path, fname);
                ints_push(at, record_of(ft));
                ints_push(which, 0);
            } else {
                if ft == t_ints() { return joined(path, fname); }
                if ft == t_strs() { return joined(path, fname); }
                if is_vec(ft) { return joined(path, fname); }
                if is_param(ft) { return joined(path, fname); }
                if is_fn(ft) { return joined(path, fname); }
            }
        }
    }
    ""
}

// Whether a type that contains nothing has no built-in equality: a sequence, a `Vec`, a
// `Chan` or a type parameter. N13. `Int`, `Bool` and `Str` have their own, and `unknown`
// was reported already.
fn has_no_equality(t: Int, req: Ints) -> Bool {
    if t == t_ints() { return true; }
    if t == t_strs() { return true; }
    if t == t_chan() { return true; }
    if is_vec(t) { return true; }
    // Neither a function value nor a capability has equality (N50, N37).
    if is_fn(t) { return true; }
    if is_cap(t) { return true; }
    // A type parameter has equality exactly when its declaration requires it (N14).
    if is_param(t) {
        if entry_of(t) < ints_len(req) {
            if ints_get(req, entry_of(t)) == 1 { return false; }
        }
        return true;
    }
    false
}

// The field path to the first component that gives this type no built-in equality, `"."`
// when the type itself has none, or `""` when it has equality. N13.
//
// The reference's `UserTypes::equality`, over the same table. A record has `==` exactly when
// every field does and an enum exactly when every payload field of every variant does —
// which is one walk here, because an enum's fields are its variants and a variant's are its
// payload, exactly as for `task_unsafe_path`. An applied entry's fields are already
// substituted, so `Box[Int]` compares and `Box[T]` does not; `Option` and `Result` are
// entries like any other and nothing here names them.
//
// Depth-first over declaration order, so the path reported is the first a reader would
// find. An entry already visited is not walked again, so the walk ends even in a program
// whose containment cycle is being refused in the same run.
pub fn equality_blocker(t: Int, rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints,
        req: Ints) -> Str {
    if is_record(t) == false {
        if has_no_equality(t, req) { return "."; }
        return "";
    }
    let at = ints_new();
    let which = ints_new();
    let path = strs_new();
    let seen = ints_new();
    ints_push(at, record_of(t));
    ints_push(which, 0);
    ints_push(seen, record_of(t));
    while ints_len(at) > 0 {
        let r = ints_get(at, ints_len(at) - 1);
        let i = ints_get(which, ints_len(which) - 1);
        if i >= ints_get(rcount, r) {
            ints_pop(at);
            ints_pop(which);
            if strs_len(path) > 0 { strs_pop(path); }
        } else {
            ints_set(which, ints_len(which) - 1, i + 1);
            let ft = ints_get(rftype, ints_get(rfirst, r) + i);
            let fname = strs_get(rfname, ints_get(rfirst, r) + i);
            if is_record(ft) {
                if contains(seen, record_of(ft)) == false {
                    ints_push(seen, record_of(ft));
                    strs_push(path, fname);
                    ints_push(at, record_of(ft));
                    ints_push(which, 0);
                }
            } else {
                if has_no_equality(ft, req) { return joined(path, fname); }
            }
        }
    }
    ""
}

fn joined(path: Strs, last: Str) -> Str {
    let mut out = "";
    let mut i = 0;
    while i < strs_len(path) {
        out = str_concat(out, strs_get(path, i));
        out = str_concat(out, ".");
        i = i + 1;
    }
    str_concat(out, last)
}

// Two types are compatible when they agree, or when either is unknown — an expression
// already reported once must not be reported again by everything that contains it.
fn agrees(a: Int, b: Int) -> Bool {
    if a == t_unknown() { return true; }
    if b == t_unknown() { return true; }
    // An `IoCap` is accepted where an `OutCap` is expected (N79): the standard streams'
    // attenuation, implied by the whole. One way only.
    if a == t_iocap() {
        if b == t_outcap() { return true; }
    }
    a == b
}

// How a node finishes, in one array beside its type — the reference's `Completion`.
//
// `Value` falls off the end with a value, whose type is the node's `ntype`. `Unit` falls
// off the end with **no** value: a statement, an `if` with no `else`, a block with no
// tail. `Diverges` never falls off the end: every path returns, breaks or continues.
// Three states, never inferred from one another and never from the type: until N10.2 the
// type code `unknown` meant a statement, an error already reported **and** a construct that
// produces no value, so `let x = if c { 1 };` reached the emitter and was allocated as
// `alloca void`. `unknown` means only "already reported" now.
//
// **An enum since N13**, and for the reason `Owning` in `compiler/emit.nz` became one in
// N10: this was `0`, `1` and `2` in an `Ints`, so any other integer could be stored in a
// node's completion and read back as a state the checker does not have, and "no arm yet" in
// a `match`'s fold was a fourth value, `-1`, that only a comparison against a number kept
// apart from the three. Now a completion is one of three variants and nothing else, the
// fold's "not yet" is an `Option`, and every test of one compares two `Completion`s with
// the derived `==` rather than two integers.
enum Completion {
    Value,
    Unit,
    Diverges,
}

// The type a value position with **no expectation of its own** sees: the reference's
// `value_type(e, None)`, which answers `Int` for a value that never arrives and for one
// that does not exist. Where a position does expect a type the reference answers with
// that one, which is what `agrees` already does with `unknown`.
fn as_value(t: Int, ncomp: Vec[Completion], node: Int) -> Int {
    if vec_get(ncomp, node) != Completion.Value() {
        if t == t_unknown() { return t_int(); }
    }
    t
}

// `N0300`, once, where a value is required and the node produces none. The one place the
// rule is decided: every value position asks this and nothing else, so a `Unit` operand is
// refused before any operator, field or parameter looks at its type. A node that diverges
// is not refused — it never produces the contradictory value — and one that failed is not
// refused twice.
fn needs_value(ncomp: Vec[Completion], node: Int, nst: Ints, nen: Ints,
        diags: Vec[Diag]) -> Int {
    if vec_get(ncomp, node) == Completion.Unit() {
        report(diags, "N0300", ints_get(nst, node), ints_get(nen, node),
                "this produces no value");
        return 1;
    }
    0
}

// Which children of a node must produce a value: `-1` for all of them, a child's number
// for that one alone, `-2` for none. Written once, beside `needs_value`, because the answer
// is a property of the node kind and the reference answers it in one place too — its
// `value_type` calls.
fn value_child(kind: Int) -> Int {
    if kind == n_bin() { return 0 - 1; }
    if kind == n_neg() { return 0 - 1; }
    if kind == n_not() { return 0 - 1; }
    if kind == n_call() { return 0 - 1; }
    if kind == n_spawn() { return 0 - 1; }
    if kind == n_construct() { return 0 - 1; }
    if kind == n_makevariant() { return 0 - 1; }
    if kind == n_fieldread() { return 0 - 1; }
    if kind == n_propagate() { return 0 - 1; }
    if kind == n_let() { return 0; }
    if kind == n_assign() { return 0; }
    if kind == n_return() { return 0; }
    if kind == n_if() { return 0; }
    if kind == n_while() { return 0; }
    0 - 2
}

// A function's return type as written, without the effect set the parser carries after it
// (N102): `Int@9` from `main:Int@9!io@20`.
pub fn fn_ret(text: Str) -> Str {
    let r = after_colon(text);
    let mut i = 0;
    while i < str_len(r) {
        if str_byte(r, i) == 33 { return str_slice(r, 0, i); }
        i = i + 1;
    }
    r
}

// The declared effect set, `!` and each name with its offset, or "" for a function that
// declares none.
pub fn fn_effects(text: Str) -> Str {
    let r = after_colon(text);
    let mut i = 0;
    while i < str_len(r) {
        if str_byte(r, i) == 33 { return str_slice(r, i, str_len(r)); }
        i = i + 1;
    }
    ""
}

pub fn after_colon(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 58 { return str_slice(s, i + 1, str_len(s)); }
        i = i + 1;
    }
    ""
}

// --- the walk ---------------------------------------------------------------------
//
// One pass that is both pre-order and post-order. Visiting a node pushes, in this order,
// a *leave* marker, a *finish* marker, and its children reversed — so the stack pops the
// children first, then the finish, then the leave. Scoping needs the pre-order half
// (a scope opens before its statements) and typing needs the post-order half (a node's
// type is a function of its children's), and one stack gives both without recursion.
//
//   >= 0           visit node k
//   -(3k + 2)      finish node k: its children are done and their types are on `ts`
//   -(3k + 3)      leave the scope node k opened

fn mark_finish(k: Int) -> Int { 0 - (3 * k + 2) }
fn mark_leave(k: Int) -> Int { 0 - (3 * k + 3) }
// A `match`, between its scrutinee and its arms. The scrutinee's type is what every arm's
// pattern is checked against, and it is not known until the scrutinee has finished — so
// there is a mark where an `if` needs none.
fn mark_scrutinee(k: Int) -> Int { 0 - (3 * k + 1) }

fn lookup_type(names: Strs, ntypes: Ints, want: Str) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return ints_get(ntypes, i); }
        i = i - 1;
    }
    t_unknown()
}

fn lookup_mut(names: Strs, nmut: Ints, want: Str) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return ints_get(nmut, i); }
        i = i - 1;
    }
    0
}

fn bind(names: Strs, ntypes: Ints, nmut: Ints, nslotof: Ints,
        name: Str, ty: Int, mutable: Int, slot: Int) -> Int {
    strs_push(names, name);
    ints_push(ntypes, ty);
    ints_push(nmut, mutable);
    ints_push(nslotof, slot);
    strs_len(names)
}

// The storage slot a name resolves to, or -1.
//
// Emission is a plain post-order scan and has no scopes, so **analysis annotates and
// emission consumes**: every `var`, `assign` and `let` node is given the slot it means
// here, where the scopes are, and the emitter reads it off the node. That is the same
// division `nazm-lir` keeps between `lower` and `emit`, and it is why the emitter needs
// no symbol table of its own.
fn lookup_slot(names: Strs, nslotof: Ints, want: Str) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == want { return ints_get(nslotof, i); }
        i = i - 1;
    }
    0 - 1
}

fn scope_close(marks: Ints, names: Strs, ntypes: Ints, nmut: Ints, nslotof: Ints) -> Int {
    let mark = ints_pop(marks);
    while strs_len(names) > mark {
        strs_pop(names);
        ints_pop(ntypes);
        ints_pop(nmut);
        ints_pop(nslotof);
    }
    mark
}

// --- built-in signatures ---------------------------------------------------------
//
// Transcribed from `crates/nazm-core/src/intrinsic.rs`, which is the single source of
// truth for the front end. A test requires every built-in there to be present here, so
// the two cannot drift silently.

fn builtin_index(bnames: Strs, want: Str) -> Int {
    let mut i = 0;
    while i < strs_len(bnames) {
        if strs_get(bnames, i) == want { return i; }
        i = i + 1;
    }
    0 - 1
}

fn add_builtin(bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
        name: Str, ret: Int, p1: Int, p2: Int, p3: Int) -> Int {
    strs_push(bnames, name);
    ints_push(bret, ret);
    ints_push(bfirst, ints_len(bparams));
    let mut n = 0;
    if p1 != t_unknown() { ints_push(bparams, p1); n = n + 1; }
    if p2 != t_unknown() { ints_push(bparams, p2); n = n + 1; }
    if p3 != t_unknown() { ints_push(bparams, p3); n = n + 1; }
    ints_push(bcount, n);
    strs_len(bnames)
}

pub fn builtins(bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints) -> Int {
    let n = t_unknown();
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_len", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_byte", t_int(), t_str(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_slice", t_str(), t_str(), t_int(), t_int());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_concat", t_str(), t_str(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_from_byte", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "int_to_str", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_new", t_ints(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_len", t_int(), t_ints(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_get", t_int(), t_ints(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_set", t_int(), t_ints(), t_int(), t_int());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_push", t_int(), t_ints(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "ints_pop", t_int(), t_ints(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_new", t_strs(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_len", t_int(), t_strs(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_get", t_str(), t_strs(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_set", t_int(), t_strs(), t_int(), t_str());
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_push", t_int(), t_strs(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "strs_pop", t_str(), t_strs(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_join", t_str(), t_strs(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "chan_new", t_chan(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "chan_send", t_bool(), t_chan(), t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "chan_recv", t_bool(), t_chan(), t_ints(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "chan_close", t_int(), t_chan(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "args_count", t_int(), n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "arg", t_str(), t_int(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "read_file", t_str(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "write_file", t_int(), t_str(), t_str(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "file_exists", t_bool(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "print", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "eprint", t_int(), t_str(), n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "exit_with", t_int(), t_int(), n, n);
    // N52: declassification. Its `VouchCap` is the Rust checker's to require.
    add_builtin(bnames, bret, bfirst, bcount, bparams, "str_vouch", t_str(), t_str(), n, n);
    // `Vec[T]`, N11: the generic built-ins. Their `T` and `Vec[T]` are entries of the type
    // table, which does not exist yet, so they are written as two placeholders here and
    // made real by `generic_builtins` once it does.
    let t = shape_t();
    let vt = shape_vec_t();
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_new", vt, n, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_len", t_int(), vt, n, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_get", t, vt, t_int(), n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_set", t_int(), vt, t_int(), t);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_push", t_int(), vt, t, n);
    add_builtin(bnames, bret, bfirst, bcount, bparams, "vec_pop", t, vt, n, n)
}

// The two placeholders a generic built-in's signature is written with: its `T`, and
// `Vec[T]`. Negative, so no real type code is either.
fn shape_t() -> Int { 0 - 10 }
fn shape_vec_t() -> Int { 0 - 11 }

// Give the generic built-ins their parameter. One `T` for all of them: a built-in's
// signature mentions only its own parameter, and substitution replaces only the callee's,
// so sharing the entry cannot confuse two of them. `bgen[i]` is the parameter's entry, or
// -1 for a built-in that is not generic.
pub fn generic_builtins(tb: Table, bnames: Strs, bret: Ints, bparams: Ints, bgen: Ints) -> Int {
    let pe = new_entry(tb, "T", 0 - 1, 0, 0, 0 - 1, rk_param(), 0 - 1);
    let t = t_param(pe);
    let vt = vec_of(tb, t);
    let mut i = 0;
    while i < strs_len(bnames) {
        let mut generic = false;
        if ints_get(bret, i) == shape_t() { ints_set(bret, i, t); generic = true; }
        if ints_get(bret, i) == shape_vec_t() { ints_set(bret, i, vt); generic = true; }
        if str_len(strs_get(bnames, i)) > 4 {
            if str_slice(strs_get(bnames, i), 0, 4) == "vec_" { generic = true; }
        }
        if generic { ints_push(bgen, pe); } else { ints_push(bgen, 0 - 1); }
        i = i + 1;
    }
    let mut j = 0;
    while j < ints_len(bparams) {
        if ints_get(bparams, j) == shape_t() { ints_set(bparams, j, t); }
        if ints_get(bparams, j) == shape_vec_t() { ints_set(bparams, j, vt); }
        j = j + 1;
    }
    0
}

// --- user signatures ------------------------------------------------------------------
//
// Collected before any body, so a forward reference resolves — the same two-pass shape
// `nazm-lir::lower` uses, for the same reason.

/// Every top-level function, with **which module owns it** and whether it is exported.
///
/// `fowner[i]` is the module that wrote definition `i`, read from where the declaration
/// sits in the buffer; `fpub[i]` is 1 when `pub` was written, which the parser recorded on
/// the function node's auxiliary column. Both are needed before a single name can be
/// resolved, because since N2 a name does not mean something — it means something *to
/// somebody*.
///
/// Two refusals belong here, where a declaration is read, rather than at a use:
///
/// * a name defined twice **in one module** is `N0203`, and the first definition is kept
///   so that one mistake stays one error. In two modules it is two definitions;
/// * a definition taking a built-in's name is `N0203`, whatever its visibility. Built-ins
///   are not a module's definitions and no visibility rule makes one legal.
// Stage 0a: declare every record's **name**, for the whole compilation.
//
// Names before field types, because a field's type may name a record declared later in
// the file or in another module. Declaration order is not a dependency, and that is only
// true if every name exists before any type is resolved — the same declare-then-check
// shape the function stage uses, one stage earlier.
// `Ty(a,b)` carries the record's name and the field names in the order written. The
// name and the list are read back out here rather than kept in a second column, because
// the node's text is already the thing both parsers agreed on in the differential dump.
// The root of a place: everything before the first `.`.
pub fn before_dot(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 46 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// The field path of a place: everything after the first `.`.
pub fn after_dot(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 46 { return str_slice(s, i + 1, str_len(s)); }
        i = i + 1;
    }
    ""
}

pub fn path_length(s: Str) -> Int {
    let mut n = 0;
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 46 { n = n + 1; }
        i = i + 1;
    }
    n
}

// Step `n` of a place's field path, counting from zero after the root.
pub fn path_step(s: Str, n: Int) -> Str {
    let mut seen = 0 - 1;
    let mut from = 0;
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 46 {
            if seen == n { return str_slice(s, from, i); }
            seen = seen + 1;
            from = i + 1;
        }
        i = i + 1;
    }
    if seen == n { return str_slice(s, from, str_len(s)); }
    ""
}

pub fn before_paren(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 40 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// The `n`th field name in `Ty(a,b,c)`.
pub fn field_name_at(s: Str, n: Int) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 40 { i = i + 1; break; }
        i = i + 1;
    }
    let mut seen = 0;
    let mut from = i;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 44 {
            if seen == n { return str_slice(s, from, i); }
            seen = seen + 1;
            from = i + 1;
        }
        if b == 41 {
            if seen == n { return str_slice(s, from, i); }
            return "";
        }
        i = i + 1;
    }
    ""
}

// Read a field out of a record, or say why that cannot be done.
//
// Lookup starts from the **resolved type of the expression it is read from** and goes
// nowhere else: there is no global field namespace, so a name that is a field of some
// other record is not a field of this one.
pub fn project(base: Int, name: Str, from: Int, to: Int,
        rnames: Strs, rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints,
        nrec: Ints, k: Int, diags: Vec[Diag]) -> Int {
    if base == t_unknown() { return t_unknown(); }
    if is_record(base) == false {
        let head = str_concat(str_concat("`", show_type(base, rnames)),
                "` is not a record, so `.");
        report(diags, "N0335", to - str_len(name), to,
                str_concat(str_concat(head, name), "` has nothing to read"));
        return t_unknown();
    }
    let r = record_of(base);
    let at = field_index(rfirst, rcount, rfname, r, name);
    if at < 0 {
        let head = str_concat(str_concat("`", strs_get(rnames, r)), "` has no field `");
        report(diags, "N0333", to - str_len(name), to,
                str_concat(str_concat(head, name), "`"));
        return t_unknown();
    }
    // `k < 0` means the caller is walking a place's path rather than a projection node,
    // and has nowhere to record the answer — the emitter walks the same path from the
    // node's text. Guarded rather than assumed: `ints_set` at -1 is `N0405`.
    if k >= 0 { ints_set(nrec, k, at); }
    field_type(rfirst, rftype, r, at)
}

pub fn collect_records(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        mstart: Ints, tb: Table, kids: Ints, kid_first: Ints,
        diags: Vec[Diag]) -> Int {
    let rnames = tb.names;
    let rowner = tb.owner;
    let mut k = 0;
    while k < ints_len(nk) {
        let this = ints_get(nk, k);
        let mut declares = 0;
        if this == n_record() { declares = 1; }
        if this == n_enum() { declares = 1; }
        if declares == 1 {
            // `Name[A@7,B@10]`: the name, then any parameter list.
            let name = before_bracket(strs_get(ntx, k));
            let owner = module_at(mstart, ints_get(nst, k));
            let at = ints_get(nst, k);
            let mut refused = 0;
            if type_of_name(name) != t_unknown() {
                report(diags, "N0331", at, ints_get(nen, k),
                        str_concat(str_concat("`", name),
                        "` is a built-in type and cannot be redefined"));
                refused = 1;
            }
            if refused == 0 {
                if name == "Vec" {
                    report(diags, "N0331", at, ints_get(nen, k),
                            "`Vec` is a built-in type and cannot be redefined");
                    refused = 1;
                }
            }
            if refused == 0 {
                match record_owned(rnames, rowner, owner, name) {
                    Option.None() => { },
                    Option.Some(value: _) => {
                        report(diags, "N0330", at, ints_get(nen, k),
                                str_concat(str_concat("`", name),
                                "` is declared more than once in this module"));
                        refused = 1;
                    },
                };
            }
            if refused == 0 {
                let mut kind = rk_record();
                if this == n_enum() { kind = rk_enum(); }
                // Where the name is written: what a diagnostic about the declaration points
                // at, as the reference's `name_span` is.
                let r = new_entry(tb, name, owner, is_public(naux, k), name_offset(naux, k),
                        k, kind, 0 - 1);
                if this == n_enum() {
                    // One entry per variant, straight after the enum's own. A variant is
                    // owned by no module — `rowner` is -1 — so no type name resolves to
                    // one, which is what keeps a variant from being written as a type.
                    let arity = ints_get(nar, k);
                    let first = ints_get(kid_first, k);
                    let mut v = 0;
                    while v < arity {
                        let child = ints_get(kids, first + v);
                        new_entry(tb, str_concat(str_concat(name, "."), strs_get(ntx, child)),
                                0 - 1, is_public(naux, k), ints_get(nst, child), child,
                                rk_variant(), 0 - 1);
                        v = v + 1;
                    }
                }
                // The parameters, as entries of their own after the variants — so the
                // variants stay contiguous — and as the definition's `args`, which is
                // where its arity is read from.
                let params = declare_params(tb, from_bracket(strs_get(ntx, k)), false,
                        diags);
                ints_set(tb.afirst, r, ints_len(tb.args));
                let mut p = 0;
                while p < ints_len(params) {
                    ints_push(tb.args, ints_get(params, p));
                    p = p + 1;
                }
                ints_set(tb.acount, r, ints_len(params));
            }
        }
        k = k + 1;
    }
    strs_len(rnames)
}

// What each module's imports bring into its **type** namespace, and the two ways that can
// go wrong — the same rule, the same codes and the same reasoning as the function
// namespace's, because it is the same rule.
pub fn check_type_imports(mfirst: Ints, mcount: Ints, mto: Ints, mat: Ints, modules: Int, core: Int,
        rnames: Strs, rowner: Ints, rpub: Ints, rat: Ints,
        tmod: Ints, tname: Strs, trec: Ints, types: Offers,
        diags: Vec[Diag]) -> Int {
    // `core` is the core prelude's module, as `core_module` resolved it from its key, and
    // every other module imports it with no `use` written. A collision with one of its names
    // is therefore reported at the **declaration** that took the name, under its own code —
    // there is no import line to point at, and the rule is that the name is reserved.
    let mut m = 0;
    while m < modules {
        let first = ints_get(mfirst, m);
        let mut e = 0;
        while e < ints_get(mcount, m) {
            let target = ints_get(mto, first + e);
            let at = ints_get(mat, first + e);
            // What the module it names offers (N103): its own `pub` types and those it
            // re-exports, each under the name an importer writes.
            let mut oi = 0;
            while oi < ints_len(types.om) {
                let mut is_offer = 0;
                if ints_get(types.om, oi) == target { is_offer = 1; }
                if is_offer == 1 {
                    let name = strs_get(types.on, oi);
                    let r = ints_get(types.ox, oi);
                    let mut taken = 1;
                    match record_owned(rnames, rowner, m, name) {
                        Option.None() => { },
                        Option.Some(value: own) => {
                            if target == core {
                                let named = ints_get(rat, own);
                                report(diags, "N0363", named, named + str_len(name),
                                        str_concat(str_concat("`", name),
                                        "` is a core prelude type"));
                            } else {
                                report(diags, "N0208", at, at + 1,
                                        str_concat(str_concat("this import brings in the type `", name),
                                        "`, which this module declares"));
                            }
                            taken = 0;
                        },
                    };
                    if taken == 1 {
                        if target == core {
                            // Only reachable when another import exports a prelude name,
                            // which that module was already refused for declaring. The
                            // prelude's meaning stands, and nothing more is said.
                            let mut q = 0;
                            while q < ints_len(tmod) {
                                if ints_get(tmod, q) == m {
                                    if strs_get(tname, q) == name {
                                        ints_set(trec, q, r);
                                        taken = 0;
                                    }
                                }
                                q = q + 1;
                            }
                        }
                    }
                    if taken == 1 {
                        if record_imported(tmod, tname, trec, m, name) >= 0 {
                            report(diags, "N0207", at, at + 1,
                                    str_concat(str_concat("the type `", name),
                                    "` is exported by two imported modules"));
                            taken = 0;
                        }
                    }
                    if taken == 1 {
                        ints_push(tmod, m);
                        strs_push(tname, name);
                        ints_push(trec, r);
                    }
                }
                oi = oi + 1;
            }
            e = e + 1;
        }
        m = m + 1;
    }
    ints_len(tmod)
}

// Stage 0b: resolve every record's field types, and refuse a record with none.
pub fn resolve_record_fields(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs,
        kids: Ints, kid_first: Ints, tb: Table,
        tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Int {
    let rnames = tb.names;
    let rowner = tb.owner;
    let rat = tb.at;
    let rnode = tb.node;
    let rkind = tb.kind;
    let rfirst = tb.first;
    let rcount = tb.count;
    let rfname = tb.fname;
    let rftype = tb.ftype;
    let rfat = tb.fat;
    // Completion waits until every declaration has its fields: an application written in
    // a field may name a definition declared later, or in another module, that has none
    // yet. `settle` below gives every application interned here its fields at once.
    defer(tb);
    // The declarations are the entries that exist now. Applications interned while their
    // fields are resolved are appended past them and completed by substitution instead.
    let declared = strs_len(rnames);
    let mut r = 0;
    while r < declared {
        let mut resolvable = true;
        if ints_get(rkind, r) == rk_vec() { resolvable = false; }
        if ints_get(rkind, r) == rk_param() { resolvable = false; }
        if resolvable == false {
            r = r + 1;
            continue;
        }
        let k = ints_get(rnode, r);
        let mut owner = ints_get(rowner, r);
        ints_set(rfirst, r, strs_len(rfname));
        let arity = ints_get(nar, k);
        let first = ints_get(kid_first, k);
        let mut kept = 0;

        // An enum's fields are its **variants**: each named as it was written, and typed
        // as the entry that carries its payload. Those entries were allocated straight
        // after the enum's own, in declaration order, so their indices are known without
        // a second pass.
        if ints_get(rkind, r) == rk_enum() {
            let mut v = 0;
            while v < arity {
                let child = ints_get(kids, first + v);
                let vname = strs_get(ntx, child);
                let mut duplicate = 0;
                let mut d = 0;
                while d < kept {
                    if strs_get(rfname, ints_get(rfirst, r) + d) == vname {
                        report(diags, "N0340", ints_get(nst, child),
                                ints_get(nen, child),
                                str_concat(str_concat(str_concat(str_concat("`",
                                strs_get(rnames, r)), "` has two variants called `"),
                                vname), "`"));
                        duplicate = 1;
                    }
                    d = d + 1;
                }
                if duplicate == 0 {
                    strs_push(rfname, vname);
                    ints_push(rftype, t_record(r + 1 + v));
                    ints_push(rfat, ints_get(nst, child));
                    kept = kept + 1;
                }
                v = v + 1;
            }
            ints_set(rcount, r, kept);
            if kept == 0 {
                report(diags, "N0339", ints_get(rat, r),
                        ints_get(rat, r) + str_len(strs_get(rnames, r)),
                        str_concat(str_concat("`", strs_get(rnames, r)),
                        "` has no variants, which is not supported yet"));
            }
            r = r + 1;
            continue;
        }
        // A variant's payload is resolved in the module that declares its enum, which
        // `rowner` does not carry — a variant is owned by no module as a type — and in the
        // scope of the enum's parameters.
        let mut decl = r;
        if ints_get(rkind, r) == rk_variant() {
            owner = module_at_of(rowner, rkind, r);
            decl = enum_of_variant(rkind, r);
        }
        let tscope = params_of(tb, decl);
        let mut i = 0;
        while i < arity {
            let child = ints_get(kids, first + i);
            let text = strs_get(ntx, child);
            let fname = before_colon(text);
            let tn = after_colon(text);
            let at = ints_get(nst, child);
            // `rcount` for this record is not pushed yet, so a duplicate is found by
            // scanning what has been kept so far rather than by `field_index`.
            let mut refused = 0;
            let mut d = 0;
            while d < kept {
                if strs_get(rfname, ints_get(rfirst, r) + d) == fname {
                    report(diags, "N0332", at, ints_get(nen, child),
                            str_concat(str_concat(str_concat(str_concat("`",
                            strs_get(rnames, r)), "` has two fields called `"), fname), "`"));
                    refused = 1;
                }
                d = d + 1;
            }
            if refused == 0 {
                let ft = resolve_written(tb, tn, owner, tscope, at, ints_get(nen, child),
                        tmod, tname, trec, diags);
                strs_push(rfname, fname);
                ints_push(rftype, ft);
                ints_push(rfat, at);
                kept = kept + 1;
            }
            i = i + 1;
        }
        ints_set(rcount, r, kept);
        // A record with no fields is refused for a reason about the grammar; a **variant**
        // with none is ordinary, and is written with no parentheses at all.
        if kept == 0 {
            if ints_get(rkind, r) == rk_record() {
                report(diags, "N0101", ints_get(rat, r),
                        ints_get(rat, r) + str_len(strs_get(rnames, r)),
                        str_concat(str_concat("`", strs_get(rnames, r)),
                        "` has no fields, which is not supported yet"));
            }
        }
        r = r + 1;
    }
    settle(tb);
    strs_len(rfname)
}

// The enum a variant entry belongs to: the nearest entry before it that is not a variant.
pub fn enum_of_variant(rkind: Ints, r: Int) -> Int {
    let mut i = r;
    while i >= 0 {
        if ints_get(rkind, i) != rk_variant() { return i; }
        i = i - 1;
    }
    0 - 1
}

// Every field of a construction, against the declaration it names.
//
// One function for a record and for a variant, because it is one law: every field exactly
// once, by name, with no unknown field, no duplicate and the declared type. `r` is the
// entry that owns the field list — the record itself, or the variant whose payload it is.
// The values are already on the type stack, the last `arity` of them, in written order.
fn check_fields(text: Str, arity: Int, r: Int, ts: Ints, kids: Ints, first: Int,
        nst: Ints, nen: Ints, rnames: Strs,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints, from: Int, to: Int,
        diags: Vec[Diag]) -> Int {
    let given = ints_new();
    let mut g = 0;
    while g < ints_get(rcount, r) { ints_push(given, 0); g = g + 1; }
    let mut a = 0;
    while a < arity {
        let fname = field_name_at(text, a);
        let got = ints_get(ts, ints_len(ts) - arity + a);
        let c = ints_get(kids, first + a);
        let at = field_index(rfirst, rcount, rfname, r, fname);
        if at < 0 {
            report(diags, "N0333",
                    ints_get(nst, c), ints_get(nen, c),
                    str_concat(str_concat(str_concat(str_concat("`",
                    strs_get(rnames, r)), "` has no field `"), fname), "`"));
        } else {
            if ints_get(given, at) == 1 {
                report(diags, "N0332",
                        ints_get(nst, c), ints_get(nen, c),
                        str_concat(str_concat("`", fname), "` is given a value twice"));
            }
            ints_set(given, at, 1);
            let want = field_type(rfirst, rftype, r, at);
            if agrees(got, want) == false {
                let head = str_concat(str_concat("`", fname), "` is `");
                report(diags, "N0300",
                        ints_get(nst, c), ints_get(nen, c),
                        str_concat(str_concat(str_concat(str_concat(head,
                        show_type(want, rnames)), "`, but this is `"),
                        show_type(got, rnames)), "`"));
            }
        }
        a = a + 1;
    }
    let mut missing = "";
    let mut m = 0;
    while m < ints_get(rcount, r) {
        if ints_get(given, m) == 0 {
            if missing != "" { missing = str_concat(missing, ", "); }
            missing = str_concat(str_concat(missing, "`"),
                    str_concat(strs_get(rfname, ints_get(rfirst, r) + m), "`"));
        }
        m = m + 1;
    }
    if missing != "" {
        let head = str_concat(str_concat("this `", strs_get(rnames, r)),
                "` does not give a value for ");
        report(diags, "N0334", from, to, str_concat(head, missing));
    }
    0
}

// Whether `want` is one of the comma-delimited names in `list`.
fn listed(list: Str, want: Str) -> Bool {
    let mut i = 0;
    let mut item = "";
    while i < str_len(list) {
        let b = str_byte(list, i);
        if b == 44 {
            if item == want { return true; }
            item = "";
        } else {
            item = str_concat(item, str_slice(list, i, i + 1));
        }
        i = i + 1;
    }
    item == want
}

// The word a diagnostic uses for a declaration of this kind.
fn entry_kind(rkind: Ints, r: Int) -> Str {
    if ints_get(rkind, r) == rk_enum() { return "enum"; }
    "record"
}

// The module that declares the enum a variant belongs to.
//
// A variant's own `rowner` is -1, because no module owns its name as a type. Its enum is
// the nearest entry before it that is not a variant, which is where they were allocated.
fn module_at_of(rowner: Ints, rkind: Ints, r: Int) -> Int {
    let mut i = r;
    while i >= 0 {
        if ints_get(rkind, i) != rk_variant() { return ints_get(rowner, i); }
        i = i - 1;
    }
    0 - 1
}

// A public item that names a private record would publish a type the importer cannot
// resolve, so it is refused. Checked at each public item on its **direct** references:
// an intermediate record must itself be public to appear in a public signature, and its
// own declaration is checked the same way, so the recursion is distributed and one
// mistake still produces one diagnostic.
//
// A **variant** entry is transparent here. It has no module and no `pub` of its own —
// `docs/spec.md` gives an enum no per-variant visibility — so the question is about the
// types its payload names, and those are asked about instead.
pub fn check_private_types(t: Int, at: Int, to: Int, kind: Str, who: Str, tb: Table,
        diags: Vec[Diag]) -> Int {
    let unused = who;
    if t < t_record_base() { return 0; }
    if entry_of(t) >= strs_len(tb.names) { return 0; }
    // A worklist rather than a call: a variant is transparent, and so are a `Vec` and an
    // application — what they expose is their element and their arguments, which are
    // asked about in turn. `seen` because an application may mention itself.
    let work = ints_new();
    let seen = ints_new();
    ints_push(work, entry_of(t));
    let mut found = 0;
    while ints_len(work) > 0 {
        let e = ints_pop(work);
        if contains(seen, e) { continue; }
        ints_push(seen, e);
        let k = ints_get(tb.kind, e);
        if k == rk_param() { continue; }
        if k == rk_vec() {
            push_entry(work, ints_get(tb.args, ints_get(tb.afirst, e)));
            continue;
        }
        if k == rk_variant() {
            let mut i = 0;
            while i < ints_get(tb.count, e) {
                push_entry(work, ints_get(tb.ftype, ints_get(tb.first, e) + i));
                i = i + 1;
            }
            continue;
        }
        if ints_get(tb.vis, e) == 0 {
            let head = str_concat(str_concat("this public ", kind), " exposes `");
            report(diags, "N0337", at, to,
                    str_concat(str_concat(head, strs_get(tb.names, definition_of(tb, t_record(e)))),
                    "`, which is private to this module"));
            found = found + 1;
        }
        let parts = type_args(tb, t_record(e));
        let mut a = 0;
        while a < ints_len(parts) { push_entry(work, ints_get(parts, a)); a = a + 1; }
    }
    found
}

// Push the entry of a user type onto a worklist; a built-in has none.
fn push_entry(work: Ints, t: Int) -> Int {
    if t >= t_record_base() { ints_push(work, entry_of(t)); }
    0
}

pub fn collect_signatures(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        kids: Ints, kid_first: Ints, mstart: Ints,
        fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fowner: Ints, fpub: Ints, fgen: Ints, fgc: Ints, bnames: Strs, tb: Table,
        nrec: Ints, ntfirst: Ints, ntargs: Ints,
        tmod: Ints, tname: Strs, trec: Ints, fnode: Ints,
        diags: Vec[Diag]) -> Int {
    let rkind = tb.kind;
    // The declared types of every `fn` and `param` node are written onto the node, here,
    // where they are resolved — the emitter and the body checks read them off it. So the
    // per-node arrays exist before any function is checked.
    while ints_len(nrec) < ints_len(nk) { ints_push(nrec, 0 - 1); }
    while ints_len(ntfirst) < ints_len(nk) { ints_push(ntfirst, 0 - 1); }
    // An exported record's own fields, first: the same refusal as a public signature's,
    // at the place the private name is written. **Declarations only**: an application of
    // a public definition is exactly as public as the definition and its arguments, and
    // its arguments are asked about where they are written.
    let mut r = 0;
    while r < strs_len(tb.names) {
        let mut exported = false;
        if is_declaration(tb, r) {
            if ints_get(tb.vis, r) == 1 { exported = true; }
        }
        if exported {
            let mut i = 0;
            while i < ints_get(tb.count, r) {
                let at = ints_get(tb.fat, ints_get(tb.first, r) + i);
                check_private_types(ints_get(tb.ftype, ints_get(tb.first, r) + i), at, at + 1,
                        entry_kind(rkind, r), strs_get(tb.names, r), tb,
                        diags);
                i = i + 1;
            }
        }
        r = r + 1;
    }
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_fn() {
            let text = strs_get(ntx, k);
            let name = fn_name(text);
            let owner = module_at(mstart, ints_get(nst, k));

            let mut refused = 0;
            if builtin_index(bnames, name) >= 0 {
                report(diags, "N0203",
                        ints_get(nst, k), ints_get(nst, k) + str_len(name),
                        str_concat(str_concat("`", name),
                        "` is a built-in and cannot be redefined"));
                refused = 1;
            }
            if refused == 0 {
                if owned_index(fnames, fowner, owner, name) >= 0 {
                    if str_byte(name, 0) == 35 {
                        let at = name_offset(naux, k);
                        report(diags, "N0203", at, at + str_len(shown_name(name)),
                                str_concat(str_concat("`", shown_name(name)),
                                "` is defined more than once in this impl"));
                    } else {
                        report(diags, "N0203",
                                ints_get(nst, k), ints_get(nst, k) + str_len(name),
                                str_concat(str_concat("`", name),
                                "` is defined more than once in this module"));
                    }
                    refused = 1;
                }
            }

            // A refused definition is still checked — its body may hold other mistakes —
            // so its types are resolved too, but **silently**: what is wrong with them
            // belongs to the definition that was kept, or has been said already.
            let mut sink = diags;
            if refused == 1 { sink = vec_new[Diag](); }
            // The parameters first: the signature's types may name them.
            let tscope = declare_params(tb, from_bracket(before_colon(text)), true, sink);
            // An impl's method may write `Self` for the impl's type (N102): resolved as the
            // shared `Self` parameter, then substituted below.
            let is_method = str_byte(name, 0) == 35;
            let mut self_ty = 0;
            if is_method {
                self_ty = method_self_type(nk, nar, ntx, kids, kid_first, k, owner, tb,
                        tmod, tname, trec);
            }
            // The scope a method's types are resolved in: its parameters and `Self` — which is
            // not one of its parameters, so it is not generic.
            let rscope = ints_new();
            let mut rs = 0;
            while rs < ints_len(tscope) { ints_push(rscope, ints_get(tscope, rs)); rs = rs + 1; }
            if is_method { ints_push(rscope, t_param(ints_get(tb.selfp, 0))); }
            // `main` cannot be generic: there is no caller to choose its type arguments.
            if refused == 0 {
                if owner == 0 {
                    if name == "main" {
                        if ints_len(tscope) > 0 {
                            report(diags, "N0356",
                                    name_offset(naux, k), name_offset(naux, k) + str_len(name),
                                    "`main` cannot be generic");
                        }
                    }
                }
            }
            // The node's own parameters, as `[count, p1, …]` in the node-type list, so the
            // body is checked in their scope and the emitter can substitute them.
            ints_set(ntfirst, k, ints_len(ntargs));
            ints_push(ntargs, ints_len(tscope));
            let mut sp = 0;
            while sp < ints_len(tscope) { ints_push(ntargs, ints_get(tscope, sp)); sp = sp + 1; }

            let mut rt = resolve_written(tb, fn_ret(text), owner, rscope, ints_get(nst, k),
                    ints_get(nen, k), tmod, tname, trec, sink);
            let selfs = ints_new();
            ints_push(selfs, t_param(ints_get(tb.selfp, 0)));
            let sa = ints_new();
            ints_push(sa, self_ty);
            if is_method { rt = substitute(tb, rt, selfs, sa); }
            ints_set(nrec, k, rt);
            let arity = ints_get(nar, k);
            let first = ints_get(kid_first, k);
            // The leading children are the parameters; then any contract clauses and the body.
            let ptypes = ints_new();
            let mut p = 0;
            while p < fn_param_count(nk, kids, first, arity) {
                let child = ints_get(kids, first + p);
                let mut pt = resolve_written(tb, after_colon(strs_get(ntx, child)), owner, rscope,
                        ints_get(nst, child), ints_get(nen, child), tmod, tname, trec,
                        sink);
                if is_method { pt = substitute(tb, pt, selfs, sa); }
                ints_set(nrec, child, pt);
                ints_push(ptypes, pt);
                p = p + 1;
            }

            if refused == 0 {
                strs_push(fnames, name);
                ints_push(fnode, k);
                ints_push(fret, rt);
                ints_push(ffirst, ints_len(fparams));
                ints_push(fowner, owner);
                ints_push(fpub, is_public(naux, k));
                if ints_len(tscope) > 0 {
                    ints_push(fgen, entry_of(ints_get(tscope, 0)));
                } else {
                    ints_push(fgen, 0 - 1);
                }
                ints_push(fgc, ints_len(tscope));
                if is_public(naux, k) == 1 {
                    check_private_types(rt, ints_get(nst, k), ints_get(nst, k) + str_len(name),
                            "function", name, tb, diags);
                }
                p = 0;
                while p < ints_len(ptypes) {
                    let child = ints_get(kids, first + p);
                    if is_public(naux, k) == 1 {
                        check_private_types(ints_get(ptypes, p), ints_get(nst, child),
                                ints_get(nen, child), "function", name, tb,
                                diags);
                    }
                    ints_push(fparams, ints_get(ptypes, p));
                    p = p + 1;
                }
                ints_push(fcount, ints_len(ptypes));
            }
        }
        k = k + 1;
    }
    strs_len(fnames)
}

/// The definition `owner` makes under `name` — public or private, since a module sees all
/// of its own. `-1` when it makes none.
pub fn owned_index(fnames: Strs, fowner: Ints, owner: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(fnames) {
        if ints_get(fowner, i) == owner {
            if strs_get(fnames, i) == name { return i; }
        }
        i = i + 1;
    }
    0 - 1
}

/// What each module's imports bring into it, and the two ways that can go wrong.
///
/// Built once, before any body is checked, because both refusals are about the **import**
/// rather than about a use of the name: a program that imports two modules exporting
/// `parse` is refused whether or not it ever writes `parse`. With no qualified path to
/// write, deferring the error would only move the dead end further from its cause.
///
/// Fills a flat table of `(module, name, definition)` triples:
///
/// * `N0208` — the importing module defines that name itself. Nothing ranks the two;
/// * `N0207` — an earlier import of this module already brought that name in.
///
/// Both point at the `use` that created the situation.
pub fn check_imports(mfirst: Ints, mcount: Ints, mto: Ints, mat: Ints, modules: Int,
        fnames: Strs, fowner: Ints, fpub: Ints,
        vmod: Ints, vname: Strs, vfn: Ints, fns: Offers,
        diags: Vec[Diag]) -> Int {
    let mut m = 0;
    while m < modules {
        let first = ints_get(mfirst, m);
        let mut e = 0;
        while e < ints_get(mcount, m) {
            let target = ints_get(mto, first + e);
            let at = ints_get(mat, first + e);
            // What the module it names offers (N103): its own `pub` functions and those it
            // re-exports.
            let mut oi = 0;
            while oi < ints_len(fns.om) {
                let mut is_offer = 0;
                if ints_get(fns.om, oi) == target { is_offer = 1; }
                if is_offer == 1 {
                    let name = strs_get(fns.on, oi);
                    let f = ints_get(fns.ox, oi);
                    let mut taken = 1;
                    if owned_index(fnames, fowner, m, name) >= 0 {
                        report(diags, "N0208", at, at + 1,
                                str_concat(str_concat("this import brings in `", name),
                                "`, which this module defines"));
                        taken = 0;
                    }
                    if taken == 1 {
                        if visible_import(vmod, vname, vfn, m, name) >= 0 {
                            report(diags, "N0207", at, at + 1,
                                    str_concat(str_concat("`", name),
                                    "` is exported by two imported modules"));
                            taken = 0;
                        }
                    }
                    if taken == 1 {
                        ints_push(vmod, m);
                        strs_push(vname, name);
                        ints_push(vfn, f);
                    }
                }
                oi = oi + 1;
            }
            e = e + 1;
        }
        m = m + 1;
    }
    ints_len(vmod)
}

/// The definition an import brought into `here` under `name`, or `-1`.
fn visible_import(vmod: Ints, vname: Strs, vfn: Ints, here: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_len(vmod) {
        if ints_get(vmod, i) == here {
            if strs_get(vname, i) == name { return ints_get(vfn, i); }
        }
        i = i + 1;
    }
    0 - 1
}

/// What `name` means **to module `here`**: its own definitions, then what its direct
/// imports brought in. `-1` when it means nothing here.
///
/// Built-ins are not in this: they belong to no module and are resolved before it, in
/// `check_call`, exactly as `docs/spec.md` describes.
fn resolve_fn(fnames: Strs, fowner: Ints, vmod: Ints, vname: Strs, vfn: Ints,
        here: Int, name: Str) -> Int {
    let own = owned_index(fnames, fowner, here, name);
    if own >= 0 { return own; }
    visible_import(vmod, vname, vfn, here, name)
}

/// Whether a module `here` directly imports defines `name` and keeps it to itself.
///
/// For one diagnostic and nothing else: "not defined" is true from the caller's position
/// and useless when the definition is sitting in the file they just imported. Resolution
/// must not consult this — a lookup that ignored visibility would be the global namespace
/// this milestone removed.
fn private_in_an_import(fnames: Strs, fowner: Ints, fpub: Ints,
        mfirst: Ints, mcount: Ints, mto: Ints, here: Int, name: Str) -> Bool {
    let mut i = 0;
    while i < strs_len(fnames) {
        if strs_get(fnames, i) == name {
            if ints_get(fpub, i) == 0 {
                if imports_directly(mfirst, mcount, mto, here, ints_get(fowner, i)) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    false
}

// --- checking -------------------------------------------------------------------------

// Which nodes sit inside a `scope`, so a `spawn` can be told whether anything will join
// it.
//
// A post-order arena makes every subtree contiguous: node `k`'s runs from the start of its
// first child's subtree up to `k`. Every child has a lower index than its parent, so one
// left-to-right pass computes every subtree start and a second marks each `scope`'s span.
// The checking walk is post-order and reaches a `scope` *after* its body, which is too
// late to tell a `spawn` inside it anything — hence a pass of its own.
fn scope_flags(nk: Ints, nar: Ints, kids: Ints, kid_first: Ints, flags: Ints) -> Int {
    let sub = ints_new();
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nar, k) == 0 {
            ints_push(sub, k);
        } else {
            ints_push(sub, ints_get(sub, ints_get(kids, ints_get(kid_first, k))));
        }
        ints_push(flags, 0);
        k = k + 1;
    }
    k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_scope() {
            let mut j = ints_get(sub, k);
            while j < k {
                ints_set(flags, j, 1);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    ints_len(flags)
}

pub fn check_all(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints, nslot: Ints,
        ntype: Ints, ncallee: Ints, nrec: Ints,
        kids: Ints, kid_first: Ints, root: Int,
        mstart: Ints, mfirst: Ints, mcount: Ints, mto: Ints, core: Int,
        fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fowner: Ints, fpub: Ints, vmod: Ints, vname: Strs, vfn: Ints,
        bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
        tb: Table, fgen: Ints, fgc: Ints, bgen: Ints, ntfirst: Ints, ntargs: Ints,
        tmod: Ints, tname: Strs, trec: Ints, fnode: Ints,
        diags: Vec[Diag]) -> Int {
    let rnames = tb.names;
    let rowner = tb.owner;
    let rkind = tb.kind;
    // The `Result` a `?` accepts: the entry the core prelude module declares under that
    // name — a definition in a module identified by its key, never a name alone and never
    // a position. `None` when the compilation has no prelude, and then nothing is one.
    let core_result = record_owned(rnames, rowner, core, "Result");
    let rfirst = tb.first;
    let rcount = tb.count;
    let rfname = tb.fname;
    let rftype = tb.ftype;
    // The type parameters of the function being checked, as `t_param` codes. A type written
    // in its body — a type argument — is resolved in their scope.
    let tscope = ints_new();
    let work = ints_new();
    let marks = ints_new();
    let names = strs_new();
    let ntypes = ints_new();
    let nmut = ints_new();
    let nslotof = ints_new();
    let ts = ints_new(); // the type stack: one entry per finished child
    // How each node finishes — a `Completion` — the one answer every consumer reads. N10.1
    // kept a single bit here, *never completes*, and left "produces no value" folded into
    // the type's `unknown`; N10.2 made it the reference's three, and N13 an enum of them.
    let ncomp = vec_new[Completion]();
    while vec_len(ncomp) < ints_len(nk) { vec_push(ncomp, Completion.Value()); }
    // The declared result of the function being checked, for `return` and for the body.
    // One slot: functions do not nest.
    let cur_ret = ints_new();
    // The slot `result` lives in, in the `ensures` clauses of the function being checked
    // (N102): one per function, allocated by its first clause.
    let cur_rslot = ints_new();
    ints_push(cur_rslot, 0 - 1);
    ints_push(cur_ret, t_unknown());
    // One entry per `match` now open, innermost last: the enum its scrutinee named, and
    // the variants its arms have covered so far as a comma-delimited list. A stack
    // because a `match` may appear inside an arm of another.
    let menum = ints_new();
    let mcov = strs_new();
    // Per open `match`, how many diagnostics existed once its scrutinee was refused as not
    // an enum, or `-1`. The reference checks no arm of such a `match` — it returns after
    // `N0342` — so what the arms would say is discarded at the `match`, and a payload name
    // bound by an arm that could never run is not reported as undefined.
    let mdiag = ints_new();
    let inscope = ints_new();
    scope_flags(nk, nar, kids, kid_first, inscope);
    // One entry per node, so the emitter can index it directly. `-1` is "no slot".
    while ints_len(nslot) < ints_len(nk) { ints_push(nslot, 0 - 1); }
    // The type each node produces, recorded for the emitter: `t_unknown` means the node
    // produces no value, which is what tells emission whether a node leaves anything on
    // its value stack. Computing it twice, in two languages, is how the two would come
    // to disagree.
    while ints_len(ntype) < ints_len(nk) { ints_push(ntype, t_unknown()); }
    // What each call resolved to, for emission to read. `-1` is "not a call", `-2` is a
    // built-in, anything else is a definition's index. Recording it is the whole of
    // "resolve once, consume downstream": a name is looked up here and nowhere later.
    while ints_len(ncallee) < ints_len(nk) { ints_push(ncallee, 0 - 1); }
    // What each record node is about: for a construction, which record it builds; for a
    // projection, which of that record's fields — by **declaration** index, which is what
    // a field's identity is spelled as in one session. Emission reads it off the node and
    // looks up nothing, which is the same division every other annotation here keeps.
    while ints_len(nrec) < ints_len(nk) { ints_push(nrec, 0 - 1); }
    // A declared type is on the node that declares it — every `fn` and `param` — written
    // there by `collect_signatures`, where it was resolved. Which name means which record
    // depends on the module, and since N11 on the declaration's own parameters, so the
    // answer is reached once and read off the node by everything after.
    while ints_len(ntfirst) < ints_len(nk) { ints_push(ntfirst, 0 - 1); }
    // Slots are numbered per function, and the count is recorded on the `fn` node so
    // the emitter knows how many `alloca`s its entry block needs.
    let counter = ints_new();
    ints_push(counter, 0);
    // The closures open around the node being checked (N102), innermost last: each one's
    // node, where its bindings begin in `names`, and what it set aside of the function around
    // it — the slot counter, the declared result and `result`'s slot. And every capture made:
    // the closure, the name, the slot it is copied from and the closure's own slot for it.
    let cl_node = ints_new();
    // The capability kinds already reported as not held (N104), one entry per function or
    // closure open, innermost last: each kind is reported once per body, at its first site.
    let auth = ints_new();
    ints_push(auth, 0);
    let cl_base = ints_new();
    let cl_counter = ints_new();
    let cl_ret = ints_new();
    let cl_rslot = ints_new();
    let cap_clo = ints_new();
    let cap_name = strs_new();
    let cap_outer = ints_new();
    let cap_inner = ints_new();
    let cap_type = ints_new();
    ints_push(work, root);

    while ints_len(work) > 0 {
        let entry = ints_pop(work);

        if entry < 0 {
            let v = 0 - entry;
            if v % 3 == 0 {
                scope_close(marks, names, ntypes, nmut, nslotof);
                continue;
            }
            if v % 3 == 1 {
                // The scrutinee has finished and its type is on top of the stack. It stays
                // there — the `match` node pops it with the arms — and is remembered here
                // because each arm needs it and none can reach it by then.
                let mk = (v - 1) / 3;
                let scrutinee = ints_get(kids, ints_get(kid_first, mk));
                needs_value(ncomp, scrutinee, nst, nen, diags);
                let st = as_value(ints_get(ts, ints_len(ts) - 1), ncomp, scrutinee);
                ints_set(ts, ints_len(ts) - 1, st);
                ints_push(menum, st);
                strs_push(mcov, "");
                let mut silenced = 0 - 1;
                if is_enum(st, rkind) == false {
                    if st != t_unknown() {
                        let c = ints_get(kids, ints_get(kid_first, mk));
                        report(diags, "N0342",
                                ints_get(nst, c), ints_get(nen, c),
                                str_concat(str_concat("`match` needs an enum, but this is `",
                                show_type(st, rnames)), "`"));
                        silenced = vec_len(diags);
                    }
                }
                ints_push(mdiag, silenced);
                continue;
            }
            // --- finish: the children's types are the top of `ts` ---------------------
            let k = (v - 2) / 3;
            // Whatever this node ends up pushing is its type; recorded once, at the end,
            // by reading the stack back.
            let _unused = ints_len(ts);
            let kind = ints_get(nk, k);
            let arity = ints_get(nar, k);
            let first = ints_get(kid_first, k);
            let text = strs_get(ntx, k);
            let from = ints_get(nst, k);
            let to = ints_get(nen, k);

            // A statement completes with nothing unless it leaves; the ones that can leave
            // say so in their own rules below.
            if kind == n_let() { vec_set(ncomp, k, Completion.Unit()); }
            if kind == n_assign() { vec_set(ncomp, k, Completion.Unit()); }
            if kind == n_while() { vec_set(ncomp, k, Completion.Unit()); }
            if kind == n_scope() { vec_set(ncomp, k, Completion.Unit()); }
            if kind == n_spawn() { vec_set(ncomp, k, Completion.Unit()); }

            // Where a value is required and a child produces none: `N0300`, here and only
            // here, before the node's own rule looks at the child's type.
            let wants = value_child(kind);
            if wants == 0 - 1 {
                let mut vc = 0;
                while vc < arity {
                    needs_value(ncomp, ints_get(kids, first + vc), nst, nen,
                            diags);
                    vc = vc + 1;
                }
            }
            if wants >= 0 {
                if wants < arity {
                    needs_value(ncomp, ints_get(kids, first + wants), nst, nen,
                            diags);
                }
            }

            if kind == n_bin() {
                let r = as_value(ints_pop(ts), ncomp, ints_get(kids, first + 1));
                let l = as_value(ints_pop(ts), ncomp, ints_get(kids, first));
                // The operator's own span, from the auxiliary column: the reference
                // points `N0304` at the operator, and the node's span covers both
                // operands instead.
                let op_at = ints_get(naux, k);
                ints_push(ts, check_binary(text, l, r, op_at, op_at + str_len(text), rnames,
                        rfirst, rcount, rfname, rftype, tb.req, diags));
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_not() {
                let t = ints_pop(ts);
                if agrees(t, t_bool()) == false {
                    report(diags, "N0304", from, from + 1,
                            str_concat(str_concat("`!` applies to `Bool`, but this is `",
                            show_type(t, rnames)), "`"));
                }
                ints_push(ts, t_bool());
                ints_set(ntype, k, t_bool());
                continue;
            }
            if kind == n_neg() {
                let t = ints_pop(ts);
                if agrees(t, t_int()) == false {
                    // The `-` itself: a negation's span runs to its operand's end, and
                    // the reference reports at the operator.
                    report(diags, "N0304", from, from + 1,
                            str_concat(str_concat("`-` applies to `Int`, but this is `",
                            type_name(t)), "`"));
                }
                ints_push(ts, t_int());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_construct() {
                // `Ty(a,b)` — the type, then the field names in the order written — or
                // `Ty[A, B](a,b)`, a generic record built with its arguments written.
                let tn = before_bracket(before_paren(text));
                let owner = module_at(mstart, from);
                let mut t = type_in(tn, owner, rnames, rowner, tmod, tname, trec);
                // A type parameter is not a record, whatever it will be.
                if in_scope(tb, tscope, tn) >= 0 { t = t_unknown(); }
                let mut r = 0 - 1;
                if is_enum(t, rkind) {
                    // An enum is not built this way; its fields are its variants, and the
                    // check below names the one that was not written.
                    r = record_of(t);
                }
                if is_record(t) {
                    if is_enum(t, rkind) == false {
                        r = record_of(apply_written(tb, t, from_bracket(before_paren(text)),
                                from, from + str_len(tn), owner, tscope, tmod, tname, trec,
                                diags));
                        if r < 0 {
                            let mut drop0 = 0;
                            while drop0 < arity { ints_pop(ts); drop0 = drop0 + 1; }
                            ints_push(ts, t_unknown());
                            ints_set(ntype, k, t_unknown());
                            continue;
                        }
                        t = t_record(r);
                    }
                }
                if r < 0 {
                    if in_scope(tb, tscope, tn) >= 0 {
                        report(diags, "N0333", from, from + str_len(tn),
                                str_concat(str_concat("`", tn),
                                "` is a type parameter, so it has no fields to name"));
                    }
                    if in_scope(tb, tscope, tn) < 0 {
                        if type_of_name(tn) == t_unknown() {
                            report(diags, "N0305", from, from + str_len(tn),
                                    str_concat(str_concat("`", tn), "` is not a type"));
                        } else {
                            report(diags, "N0333", from, from + str_len(tn),
                                    str_concat(str_concat("`", tn),
                                    "` is not a record, so it has no fields to name"));
                        }
                    }
                    let mut drop = 0;
                    while drop < arity { ints_pop(ts); drop = drop + 1; }
                    ints_push(ts, t_unknown());
                    ints_set(ntype, k, t_unknown());
                    continue;
                }
                ints_set(nrec, k, r);
                check_fields(text, arity, r, ts, kids, first, nst, nen, rnames,
                        rfirst, rcount, rfname, rftype, from, to,
                        diags);
                // A construction that owns something is assembled in a hidden slot, so
                // that an initialiser failing after an earlier one produced a heap string
                // releases it: a value held only in a register is not reachable from the
                // frame's cleanup. A record whose fields own nothing gets no slot and
                // pays for none of this. `docs/spec.md`, *partial construction*.
                if needs_cleanup(t, rfirst, rcount, rftype) {
                    let slot = ints_get(counter, 0);
                    ints_set(counter, 0, slot + 1);
                    ints_set(nslot, k, slot);
                }
                let mut drop2 = 0;
                while drop2 < arity { ints_pop(ts); drop2 = drop2 + 1; }
                ints_push(ts, t);
                ints_set(ntype, k, t);
                continue;
            }
            // `operand?`, N12. The operand must be an application of the core prelude's
            // `Result` — by **definition**, the entry the prelude module declares, never a
            // name or a shape — and so must the function's declared result, with the very
            // same error type. The node is the operand's success type; the error path is
            // an ordinary `return`, so the node completes exactly as its operand does.
            // Every refusal points at the `?`, the node's last byte.
            if kind == n_propagate() {
                let operand = ints_get(kids, first);
                let ot = ints_pop(ts);
                if vec_get(ncomp, operand) != Completion.Value() {
                    // No value to take apart. Refused above if it has none at all; one that
                    // never arrives transfers, and so does this.
                    if vec_get(ncomp, operand) == Completion.Diverges() {
                        vec_set(ncomp, k, Completion.Diverges());
                    }
                    ints_push(ts, t_unknown());
                    ints_set(ntype, k, t_unknown());
                    continue;
                }
                let q = to - 1;
                let is_result = applies_core_result(tb, core_result, ot);
                if is_result == false {
                    if ot != t_unknown() {
                        report(diags, "N0360", q, q + 1,
                                str_concat(str_concat("`?` needs a `Result`, but this is `",
                                show_type(ot, rnames)), "`"));
                    }
                    ints_push(ts, t_unknown());
                    ints_set(ntype, k, t_unknown());
                    continue;
                }
                let parts = type_args(tb, ot);
                let ok = ints_get(parts, 0);
                let fr = ints_get(cur_ret, 0);
                let returns_result = applies_core_result(tb, core_result, fr);
                if returns_result == false {
                    report(diags, "N0361", q, q + 1,
                            str_concat(str_concat(
                            "`?` can only be used in a function that returns a `Result`, and this one returns `",
                            show_type(fr, rnames)), "`"));
                    ints_push(ts, ok);
                    ints_set(ntype, k, ok);
                    continue;
                }
                let into_err = ints_get(type_args(tb, fr), 1);
                if ints_get(parts, 1) != into_err {
                    report(diags, "N0362", q, q + 1,
                            str_concat(str_concat(str_concat(str_concat(
                            "this `?` propagates a `", show_type(ints_get(parts, 1), rnames)),
                            "`, but the function's error type is `"),
                            show_type(into_err, rnames)), "`"));
                    ints_push(ts, ok);
                    ints_set(ntype, k, ok);
                    continue;
                }
                // For emission: which variant is the success — the operand's own `Ok`
                // entry, as an arm records the variant it matched — and a hidden slot the
                // frame releases, holding the operand while it is taken apart.
                let e = record_of(ot);
                let at = field_index(rfirst, rcount, rfname, e, "Ok");
                ints_set(nrec, k, record_of(field_type(rfirst, rftype, e, at)));
                let slot = ints_get(counter, 0);
                ints_set(counter, 0, slot + 1);
                ints_set(nslot, k, slot);
                ints_push(ts, ok);
                ints_set(ntype, k, ok);
                continue;
            }
            if kind == n_fieldread() {
                let base = as_value(ints_pop(ts), ncomp, ints_get(kids, first));
                if is_enum(base, rkind) {
                    report(diags, "N0335", from, to,
                            str_concat(str_concat(str_concat(str_concat("`",
                            show_type(base, rnames)), "` is not a record, so `."), text),
                            "` has nothing to read"));
                    ints_push(ts, t_unknown());
                    ints_set(ntype, k, t_unknown());
                    continue;
                }
                let t = project(base, text, from, to, rnames, rfirst, rcount, rfname, rftype,
                        nrec, k, diags);
                ints_push(ts, t);
                ints_set(ntype, k, t);
                continue;
            }
            // `E.V(…)` — the same law a record construction follows, applied to the fields
            // of one variant. The variant is an entry of the record table, so the check is
            // the construction check with a different entry and a different result type.
            if kind == n_makevariant() {
                let qualified = before_paren(text);
                let en = before_bracket(before_dot(qualified));
                let vn = after_dot(qualified);
                let owner = module_at(mstart, from);
                let mut et = type_in(en, owner, rnames, rowner, tmod, tname, trec);
                if in_scope(tb, tscope, en) >= 0 { et = t_unknown(); }
                let mut v = 0 - 1;
                // Whether the enum was named correctly and its arguments were not — which
                // has been reported already, where the arguments are written.
                let mut said = false;
                if is_enum(et, rkind) {
                    // `E[A].V(…)`: the enum applied to its written arguments, and the
                    // variant looked up in **that** application, whose payload types are
                    // the definition's with the arguments substituted.
                    et = apply_written(tb, et, from_bracket(before_dot(qualified)), from,
                            from + str_len(en), owner, tscope, tmod, tname, trec,
                            diags);
                    if et == t_unknown() { said = true; }
                }
                if said == false {
                    if is_enum(et, rkind) {
                        let at = field_index(rfirst, rcount, rfname, record_of(et), vn);
                        if at < 0 {
                            report(diags, "N0341", from, to,
                                    str_concat(str_concat(str_concat(str_concat("`", en),
                                    "` has no variant `"), vn), "`"));
                        } else {
                            v = record_of(field_type(rfirst, rftype, record_of(et), at));
                        }
                    } else {
                        if et == t_unknown() {
                            if in_scope(tb, tscope, en) >= 0 {
                                report(diags, "N0341", from,
                                        from + str_len(en), str_concat(str_concat("`", en),
                                        "` is a type parameter, so it has no variants"));
                            } else {
                                report(diags, "N0305", from,
                                        from + str_len(en),
                                        str_concat(str_concat("`", en), "` is not a type"));
                            }
                        } else {
                            report(diags, "N0341", from, from + str_len(en),
                                    str_concat(str_concat("`", en),
                                    "` is not an enum, so it has no variants"));
                        }
                    }
                }
                if v < 0 {
                    let mut drop = 0;
                    while drop < arity { ints_pop(ts); drop = drop + 1; }
                    ints_push(ts, t_unknown());
                    ints_set(ntype, k, t_unknown());
                    continue;
                }
                ints_set(nrec, k, v);
                check_fields(text, arity, v, ts, kids, first, nst, nen, rnames,
                        rfirst, rcount, rfname, rftype, from, to,
                        diags);
                if needs_cleanup(et, rfirst, rcount, rftype) {
                    let slot = ints_get(counter, 0);
                    ints_set(counter, 0, slot + 1);
                    ints_set(nslot, k, slot);
                }
                let mut gone = 0;
                while gone < arity { ints_pop(ts); gone = gone + 1; }
                ints_push(ts, et);
                ints_set(ntype, k, et);
                continue;
            }
            if kind == n_arm() {
                // The body's type is the arm's. The bindings were made when this node was
                // visited and go out of scope with the mark pushed there.
                let t = ints_pop(ts);
                ints_push(ts, t);
                ints_set(ntype, k, t);
                vec_set(ncomp, k, vec_get(ncomp, ints_get(kids, first + arity - 1)));
                continue;
            }
            if kind == n_match() {
                let silenced = ints_pop(mdiag);
                if silenced >= 0 {
                    while vec_len(diags) > silenced { vec_pop(diags); }
                }
                // Children: the scrutinee, then one arm each. Every arm must agree, and
                // an arm that transfers control constrains nothing — the same rule an
                // `if`'s branches follow.
                let mut result = t_unknown();
                // The arms' completions folded as the reference folds them: an arm that
                // leaves defers to the others, and one arm with no value makes the whole
                // `match` produce none — reported by whatever wanted the value, not here.
                // `None` is "no arm yet"; a `match` with none is refused elsewhere.
                let mut fold = Option[Completion].None();
                let mut a = 1;
                while a < arity {
                    let arm_c = vec_get(ncomp, ints_get(kids, first + a));
                    match fold {
                        Option.None() => { fold = Option[Completion].Some(value: arm_c); },
                        Option.Some(value: so_far) => {
                            if so_far == Completion.Diverges() {
                                fold = Option[Completion].Some(value: arm_c);
                            } else {
                                if arm_c == Completion.Unit() {
                                    fold = Option[Completion].Some(value: Completion.Unit());
                                }
                            }
                        },
                    };
                    let armt = ints_get(ts, ints_len(ts) - arity + a);
                    if armt != t_unknown() {
                        if result == t_unknown() {
                            result = armt;
                        } else {
                            if agrees(armt, result) == false {
                                // At the arm's body, as the reference reports it.
                                let arm = ints_get(kids, first + a);
                                let c = ints_get(kids,
                                        ints_get(kid_first, arm) + ints_get(nar, arm) - 1);
                                report(diags, "N0302",
                                        ints_get(nst, c), ints_get(nen, c),
                                        str_concat(str_concat(str_concat(str_concat(
                                        "this arm is `", show_type(armt, rnames)),
                                        "`, but an earlier one is `"),
                                        show_type(result, rnames)), "`"));
                            }
                        }
                    }
                    a = a + 1;
                }
                let et = ints_get(menum, ints_len(menum) - 1);
                let covered = strs_get(mcov, strs_len(mcov) - 1);
                ints_pop(menum);
                strs_pop(mcov);
                if is_enum(et, rkind) {
                    // Exhaustiveness: every variant, exactly once. Not reported when an
                    // arm named a variant this enum does not have — the checker does not
                    // know which one was meant, and saying so twice is one mistake
                    // reported twice.
                    if covered != "!" {
                        let r = record_of(et);
                        let mut missing = "";
                        let mut m = 0;
                        while m < ints_get(rcount, r) {
                            let vname = strs_get(rfname, ints_get(rfirst, r) + m);
                            if listed(covered, vname) == false {
                                if missing != "" { missing = str_concat(missing, ", "); }
                                missing = str_concat(str_concat(missing, "`"),
                                        str_concat(vname, "`"));
                            }
                            m = m + 1;
                        }
                        if missing != "" {
                            report(diags, "N0343", from, to,
                                    str_concat("this `match` does not cover ", missing));
                        }
                    }
                }
                let mut left = 0;
                while left < arity { ints_pop(ts); left = left + 1; }
                // A `match` with no value has no type, whatever its value arms said.
                match fold {
                    Option.None() => { },
                    Option.Some(value: folded) => {
                        vec_set(ncomp, k, folded);
                        if folded != Completion.Value() { result = t_unknown(); }
                    },
                };
                ints_push(ts, result);
                ints_set(ntype, k, result);
                continue;
            }
            if kind == n_method() {
                let c0 = ints_get(kids, first);
                let ufcs = ints_get(nk, c0) == n_traitref();
                let mut skip = 0;
                if ufcs { skip = 1; }
                let cnt = arity - skip;
                let rev = ints_new();
                let mut q = 0;
                while q < cnt { ints_push(rev, ints_pop(ts)); q = q + 1; }
                let got = ints_new();
                let argn = ints_new();
                q = cnt - 1;
                while q >= 0 { ints_push(got, ints_get(rev, q)); q = q - 1; }
                q = 0;
                while q < cnt { ints_push(argn, ints_get(kids, first + skip + q)); q = q + 1; }
                let mut fixed = 0 - 1;
                if ufcs { fixed = ints_get(ncallee, c0); }
                let here = module_at(mstart, from);
                let mat = ints_get(naux, k);
                let out = ints_new();
                ints_push(out, 0);
                ints_push(out, 0);
                let mut ret = t_unknown();
                let mut recv = t_unknown();
                if cnt > 0 { recv = ints_get(got, 0); }
                if cnt == 0 {
                    report(diags, "N0303", from, to,
                            str_concat(str_concat("`", text), "` was given the wrong number of arguments"));
                } else {
                    let sg = resolve_method(tb, here, recv, text, fixed, mat, mat + str_len(text),
                            mfirst, mcount, mto, out, diags);
                    if sg >= 0 {
                        ret = check_method_args(tb, sg, recv, text, got, argn, nst, nen, from, to, diags);
                        if ints_get(out, 0) == 1 {
                            ints_set(ncallee, k, 0 - 10 - sg);
                        } else {
                            let g = ints_get(out, 1);
                            if g >= 0 {
                                ints_set(nk, k, n_call());
                                strs_set(ntx, k, strs_get(fnames, g));
                                ints_set(ncallee, k, g);
                            }
                        }
                    }
                }
                // The trait's name is no argument: the call's children start after it.
                if ufcs {
                    ints_set(kid_first, k, first + 1);
                    ints_set(nar, k, arity - 1);
                }
                ints_push(ts, ret);
                ints_set(ntype, k, ret);
                continue;
            }
            // A call through a binding of function type (N102): such a binding hides a
            // function of the same name for calls in its scope.
            let callee_name = before_bracket(text);
            let mut indirect = false;
            if kind == n_call() {
                if scope_has(names, callee_name) { indirect = true; }
            }
            if indirect {
                let ft = lookup_type(names, ntypes, callee_name);
                let slot = closure_binding(names, ntypes, nmut, nslotof, cl_node, cl_base,
                        cl_counter, counter, cap_clo, cap_name, cap_outer, cap_inner, cap_type, callee_name,
                        from, from + str_len(callee_name), diags, tb);
                let got = ints_new();
                let mut q = 0;
                while q < arity { ints_push(got, ints_pop(ts)); q = q + 1; }
                let mut ret = t_unknown();
                if is_fn(ft) {
                    if fn_arity(tb, ft) != arity {
                        let mut plural = "s";
                        if fn_arity(tb, ft) == 1 { plural = ""; }
                        report(diags, "N0303", from, to,
                                str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("`",
                                callee_name), "` takes "), int_to_str(fn_arity(tb, ft))),
                                str_concat(" argument", plural)), ", but "),
                                str_concat(int_to_str(arity), " were given")));
                    } else {
                        q = 0;
                        while q < arity {
                            let actual = ints_get(got, arity - 1 - q);
                            let want = fn_param(tb, ft, q);
                            if accepts(tb, actual, want) == false {
                                let arg = ints_get(kids, first + q);
                                report(diags, "N0300", ints_get(nst, arg), ints_get(nen, arg),
                                        str_concat(str_concat(str_concat(str_concat(str_concat(
                                        "argument ", int_to_str(q + 1)), str_concat(" of `", callee_name)),
                                        "` is `"), str_concat(show_type(want, rnames), "`, but this is `")),
                                        str_concat(show_type(actual, rnames), "`")));
                            }
                            q = q + 1;
                        }
                    }
                    ret = fn_result(tb, ft);
                    ints_set(ncallee, k, 0 - 3);
                    ints_set(nslot, k, slot);
                    ints_set(nrec, k, ft);
                } else {
                    if ft != t_unknown() {
                        report(diags, "N0201", from, from + str_len(callee_name),
                                str_concat(str_concat("`", callee_name), "` is not a function"));
                    }
                }
                ints_push(ts, ret);
                ints_set(ntype, k, ret);
                continue;
            }
            if kind == n_call() {
                ints_push(ts, check_call(text, arity, ts, from, to,
                        kids, first, nst, nen, ncallee, k, module_at(mstart, from),
                        fnames, fret, ffirst, fcount, fparams,
                        fowner, fpub, vmod, vname, vfn, mfirst, mcount, mto,
                        bnames, bret, bfirst, bcount, bparams,
                        tb, fgen, fgc, bgen, tscope, ncomp, ntfirst, ntargs, tmod, tname, trec,
                        diags));
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                // A built-in that needs authority needs it held here (N104).
                if ints_get(ncallee, k) == 0 - 2 {
                    let bname = before_bracket(text);
                    check_held(ntypes, auth_kind_of_builtin(bname),
                            str_concat(str_concat("the built-in `", bname), "`"),
                            from, from + str_len(bname), auth, diags);
                }
                continue;
            }
            if kind == n_if() {
                // Children: condition, then-block, and optionally else-block. The `if`'s
                // type is the branches'; a block's type is its tail's, or unknown.
                let mut else_t = t_unknown();
                if arity == 3 { else_t = ints_pop(ts); }
                let then_t = ints_pop(ts);
                let cond_t = ints_pop(ts);
                if agrees(cond_t, t_bool()) == false {
                    // The condition's own span, which is the first child's.
                    let c = ints_get(kids, first);
                    report(diags, "N0301",
                            ints_get(nst, c), ints_get(nen, c),
                            str_concat(str_concat("an `if` condition must be `Bool`, but this is `",
                            type_name(cond_t)), "`"));
                }
                if arity == 3 {
                    // The reference's join, in the reference's order. A branch that leaves
                    // defers to the other one, whatever the other one is — so a `Unit`
                    // with a `Diverges` is `Unit`, and both leaving is the `if` leaving.
                    // Two values must agree (`N0302` at the else branch's value); a value
                    // and nothing is `N0302` at the whole `if`. Either way the `if` then
                    // carries the value it has, so what contains it is not refused twice.
                    let then_b = ints_get(kids, first + 1);
                    let else_b = ints_get(kids, first + 2);
                    let tc = vec_get(ncomp, then_b);
                    let ec = vec_get(ncomp, else_b);
                    let mut t = t_unknown();
                    let mut c = Completion.Unit();
                    if tc == Completion.Diverges() {
                        c = ec;
                        t = else_t;
                    } else {
                        if ec == Completion.Diverges() {
                            c = tc;
                            t = then_t;
                        } else {
                            if tc == Completion.Value() {
                                c = Completion.Value();
                                t = then_t;
                                if ec == Completion.Value() {
                                    if agrees(then_t, else_t) == false {
                                        let tail = ints_get(kids,
                                                ints_get(kid_first, else_b) + ints_get(nar, else_b) - 1);
                                        report(diags, "N0302",
                                                ints_get(nst, tail), ints_get(nen, tail),
                                                str_concat(str_concat(str_concat(str_concat(
                                                "this branch is `", show_type(else_t, rnames)),
                                                "`, but the other is `"),
                                                show_type(then_t, rnames)), "`"));
                                    }
                                    if t == t_unknown() { t = else_t; }
                                } else {
                                    report(diags, "N0302", from, to,
                                            str_concat(str_concat("one branch produces `",
                                            show_type(then_t, rnames)),
                                            "` and the other produces nothing"));
                                }
                            } else {
                                if ec == Completion.Value() {
                                    c = Completion.Value();
                                    t = else_t;
                                    report(diags, "N0302", from, to,
                                            str_concat(str_concat("one branch produces `",
                                            show_type(else_t, rnames)),
                                            "` and the other produces nothing"));
                                }
                            }
                        }
                    }
                    vec_set(ncomp, k, c);
                    ints_push(ts, t);
                } else {
                    // No `else`: the condition may be false, so the `if` always completes,
                    // and with nothing — whatever its branch does.
                    vec_set(ncomp, k, Completion.Unit());
                    ints_push(ts, t_unknown());
                }
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            // **Every node leaves exactly one entry on `ts`.** A statement's is
            // `unknown` — it has no type — but it is *there*, so a parent can always pop
            // `arity` entries without knowing which children were statements. Anything
            // else makes the pop count depend on the shape of the children, which is how
            // a type stack underflows.
            // A block written as an expression is its block: the same completion and the
            // same type, `check_expr(Block) => check_block` in the reference. Its one
            // child already left the one entry on `ts` this node owes.
            if kind == n_blockexpr() {
                vec_set(ncomp, k, vec_get(ncomp, ints_get(kids, first)));
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_block() {
                let mut t = t_unknown();
                // What follows a child that leaves can never run, and the reference refuses
                // it rather than compiling it away: `N0313`, once, then the child after it
                // is checked afresh — `diverged_at = None`, exactly. Until N10.1 this
                // compiler said nothing, compiled `continue; i = i + 10;` and ran it.
                //
                // The statements first, then the tail if there is one — the reference's
                // loop, including which completion the block ends with: a block whose last
                // statement leaves is `Diverges` (and a tail after it is refused too); one
                // with a tail is the tail's; one with neither is `Unit`.
                let has_tail = text == "tail";
                let mut stmts = arity;
                if has_tail { stmts = arity - 1; }
                let mut left = 0;
                let mut d = 0;
                while d < stmts {
                    let child = ints_get(kids, first + d);
                    if left == 1 {
                        report(diags, "N0313",
                                ints_get(nst, child), ints_get(nen, child), "this can never run");
                        left = 0;
                    }
                    if vec_get(ncomp, child) == Completion.Diverges() { left = 1; }
                    d = d + 1;
                }
                if left == 1 {
                    if has_tail {
                        let tail = ints_get(kids, first + arity - 1);
                        report(diags, "N0313",
                                ints_get(nst, tail), ints_get(nen, tail), "this can never run");
                    }
                    vec_set(ncomp, k, Completion.Diverges());
                } else {
                    if has_tail {
                        vec_set(ncomp, k, vec_get(ncomp, ints_get(kids, first + arity - 1)));
                    } else {
                        vec_set(ncomp, k, Completion.Unit());
                    }
                }
                d = 0;
                while d < arity {
                    let popped = ints_pop(ts);
                    // The tail is the last child, so it is the first one popped.
                    if d == 0 {
                        if text == "tail" { t = popped; }
                    }
                    d = d + 1;
                }
                if vec_get(ncomp, k) != Completion.Value() { t = t_unknown(); }
                ints_push(ts, t);
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_let() {
                // A value that never arrives still gives the binding a type — `as_value` —
                // and the value is given it too, because that is where the emitter reads a
                // slot's type from. Without it the emitter allocated `alloca void`. Nothing
                // else is read off a node that is never reached.
                let t = as_value(ints_pop(ts), ncomp, ints_get(kids, first));
                ints_set(ntype, ints_get(kids, first), t);
                let slot = ints_get(counter, 0);
                ints_set(counter, 0, slot + 1);
                ints_set(nslot, k, slot);
                bind(names, ntypes, nmut, nslotof, before_colon(text),
                        t, str_to_int_flag(after_colon(text)), slot);
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_assign() {
                let t = ints_pop(ts);
                // The place is a root binding and a path of fields: `a.b.c`. Mutability
                // is checked at the **root**, at any depth, because a record is a value
                // and replacing part of what a binding holds is changing the binding.
                let root = before_dot(text);
                let want_root = lookup_type(names, ntypes, root);
                if lookup_mut(names, nmut, root) == 0 {
                    let mut said = str_concat(str_concat("`", root), "` is not mutable");
                    if root != text {
                        said = str_concat(said, str_concat(str_concat(
                                ", so its `", after_dot(text)), "` cannot be replaced"));
                    }
                    report(diags, "N0310", from, from + str_len(root),
                            said);
                }
                ints_set(nslot, k, lookup_slot(names, nslotof, root));
                ints_set(nrec, k, want_root);
                // Walk the path to the type actually being written.
                let mut want = want_root;
                let mut step = 0;
                while step < path_length(text) {
                    want = project(want, path_step(text, step), from, from,
                            rnames, rfirst, rcount, rfname, rftype, nrec, 0 - 1,
                            diags);
                    step = step + 1;
                }
                if agrees(t, want) == false {
                    let value = ints_get(kids, first);
                    let head = str_concat(str_concat("`", text), "` is `");
                    report(diags, "N0300",
                            ints_get(nst, value), ints_get(nen, value),
                            str_concat(str_concat(str_concat(str_concat(head,
                            show_type(want, rnames)), "`, but this is `"),
                            show_type(t, rnames)), "`"));
                }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_scope() {
                ints_pop(ts); // the body block; a `scope` produces nothing
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_spawn() {
                // Starting a task needs a `SpawnCap` held here (N104), reported at the callee.
                let sname = before_bracket(text);
                check_held(ntypes, t_spawncap(), "starting a task", ints_get(naux, k),
                        ints_get(naux, k) + str_len(sname), auth, diags);
                if ints_get(inscope, k) == 0 {
                    report(diags, "N0320", from, to,
                            "`spawn` outside a `scope`: nothing would join this task");
                }
                // `Ints` and `Strs` are handles to shared mutable storage with no
                // synchronisation of any kind, so letting one cross into a task would be
                // a data race the language had invited. `Int`, `Bool` and `Str` are
                // values and `Chan` is the primitive designed to be shared.
                // A record is answered by its **fields**, recursively, and the
                // diagnostic names the field path that decided it — wrapping a sequence
                // in a record does not launder it past this rule.
                let mut a = 0;
                while a < arity {
                    let at = ints_get(ts, ints_len(ts) - arity + a);
                    let why = task_unsafe_path(at, rfirst, rcount, rfname, rftype);
                    if why != "" {
                        let c = ints_get(kids, first + a);
                        let head = str_concat(str_concat("a `", show_type(at, rnames)), "`");
                        let mut said = str_concat(head, " may not cross into a task");
                        if why != "." {
                            said = str_concat(str_concat(str_concat(head,
                                    " may not cross into a task: its `"), why), "` is a sequence");
                        }
                        report(diags, "N0321",
                                ints_get(nst, c), ints_get(nen, c), said);
                    }
                    a = a + 1;
                }
                // A task runs one function with one signature. A generic one would need
                // its type arguments settled at the `spawn`, which N11 does not do — refused
                // at the callee, as the reference refuses it, and nothing else is asked.
                let callee_at = ints_get(naux, k);
                let spawned = resolve_fn(fnames, fowner, vmod, vname, vfn,
                        module_at(mstart, from), before_bracket(text));
                let mut generic_task = false;
                if spawned >= 0 {
                    if ints_get(fgc, spawned) > 0 { generic_task = true; }
                }
                if generic_task {
                    report(diags, "N0101", callee_at,
                            callee_at + str_len(before_bracket(text)),
                            str_concat(str_concat("`spawn ", before_bracket(text)),
                            "` runs a generic function, which is not supported yet"));
                    let mut gone = 0;
                    while gone < arity { ints_pop(ts); gone = gone + 1; }
                } else {
                    // The callee is resolved exactly as a call's is — same arity and argument
                    // rules, one definition. A task's result is discarded, which the
                    // specification states outright: results travel through channels.
                    check_call(text, arity, ts, from, to,
                            kids, first, nst, nen, ncallee, k, module_at(mstart, from),
                            fnames, fret, ffirst, fcount, fparams,
                            fowner, fpub, vmod, vname, vfn, mfirst, mcount, mto,
                            bnames, bret, bfirst, bcount, bparams,
                            tb, fgen, fgc, bgen, tscope, ncomp, ntfirst, ntargs, tmod, tname, trec,
                            diags);
                }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_while() {
                ints_pop(ts); // the body block
                let cond_t = ints_pop(ts);
                if agrees(cond_t, t_bool()) == false {
                    let c = ints_get(kids, first);
                    report(diags, "N0301",
                            ints_get(nst, c), ints_get(nen, c),
                            str_concat(str_concat("a `while` condition must be `Bool`, but this is `",
                            type_name(cond_t)), "`"));
                }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_return() {
                vec_set(ncomp, k, Completion.Diverges());
                // `check_return`: the value must be what the function returns, reported at
                // the value. One that does not exist was refused above, and one that never
                // arrives is whatever the signature says.
                let rv = ints_get(kids, first);
                let got = ints_get(ts, ints_len(ts) - 1);
                if vec_get(ncomp, rv) == Completion.Value() {
                    if agrees(got, ints_get(cur_ret, 0)) == false {
                        report(diags, "N0300",
                                ints_get(nst, rv), ints_get(nen, rv),
                                str_concat(str_concat(str_concat(str_concat("this returns `",
                                show_type(got, rnames)), "`, but the function returns `"),
                                show_type(ints_get(cur_ret, 0), rnames)), "`"));
                    }
                }
                ints_pop(ts);
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_exprstmt() {
                // `Stmt::Expr(e) => check_expr(e).diverges()`: the only statement whose
                // divergence is its expression's. A `let` of a diverging value does not
                // diverge — the reference says `false` — and neither does a `while`.
                if vec_get(ncomp, ints_get(kids, first)) == Completion.Diverges() {
                    vec_set(ncomp, k, Completion.Diverges());
                } else {
                    vec_set(ncomp, k, Completion.Unit());
                }
                ints_pop(ts);
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            if kind == n_closure() {
                // The body against the closure's declared result, as a function's is.
                let body = ints_get(kids, first + arity - 1);
                let declared = ints_get(cur_ret, 0);
                let bc = vec_get(ncomp, body);
                if bc == Completion.Value() {
                    let bt = ints_get(ts, ints_len(ts) - 1);
                    if agrees(bt, declared) == false {
                        let tail = ints_get(kids, ints_get(kid_first, body) + ints_get(nar, body) - 1);
                        report(diags, "N0300", ints_get(nst, tail), ints_get(nen, tail),
                                str_concat(str_concat(str_concat(str_concat("this closure returns `",
                                show_type(bt, rnames)), "`, but its type says `"),
                                show_type(declared, rnames)), "`"));
                    }
                }
                if bc == Completion.Unit() {
                    report(diags, "N0300", ints_get(nst, body), ints_get(nen, body),
                            str_concat(str_concat("this closure must produce a `",
                            show_type(declared, rnames)), "`, but its body does not"));
                }
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                let ps = ints_new();
                let mut q = 0;
                while q < arity - 1 {
                    ints_push(ps, ints_get(nrec, ints_get(kids, first + q)));
                    q = q + 1;
                }
                let mut eff = fx_declared(fn_effects(text), diags);
                if eff < 0 { eff = 0; }
                let ct = fn_of(tb, ps, declared, eff);
                ints_set(nslot, k, ints_get(counter, 0));
                // Its result, for the emitter, as a function's is on its node.
                ints_set(nrec, k, declared);
                // Its captures, on the node: `[count, outer slot, own slot, type, …]`.
                ints_set(ntfirst, k, ints_len(ntargs));
                let mut ncap = 0;
                q = 0;
                while q < ints_len(cap_clo) {
                    if ints_get(cap_clo, q) == k { ncap = ncap + 1; }
                    q = q + 1;
                }
                ints_push(ntargs, ncap);
                q = 0;
                while q < ints_len(cap_clo) {
                    if ints_get(cap_clo, q) == k {
                        ints_push(ntargs, ints_get(cap_outer, q));
                        ints_push(ntargs, ints_get(cap_inner, q));
                        ints_push(ntargs, ints_get(cap_type, q));
                    }
                    q = q + 1;
                }
                // Back to the function around it.
                ints_set(counter, 0, ints_pop(cl_counter));
                ints_set(cur_ret, 0, ints_pop(cl_ret));
                ints_set(cur_rslot, 0, ints_pop(cl_rslot));
                ints_pop(cl_node);
                ints_pop(auth);
                ints_pop(cl_base);
                ints_push(ts, ct);
                ints_set(ntype, k, ct);
                continue;
            }
            if kind == n_contract() {
                // Each clause a `Bool` (N102). What it may contain is asked once every call
                // in it is resolved: see `check_contract_shapes`.
                let cond = ints_get(kids, first);
                let ct = ints_get(ts, ints_len(ts) - 1);
                if vec_get(ncomp, cond) == Completion.Value() {
                    if agrees(ct, t_bool()) == false {
                        report(diags, "N0300", ints_get(nst, cond), ints_get(nen, cond),
                                str_concat(str_concat("a contract clause is a `Bool`, but this is `",
                                show_type(ct, rnames)), "`"));
                    }
                }
                ints_pop(ts);
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                vec_set(ncomp, k, Completion.Unit());
                continue;
            }
            if kind == n_fn() {
                // The body against the signature, as the reference checks it: a body that
                // returned on every path needs nothing; one with a value must have the
                // declared type, reported at its tail; one with none is refused whole.
                let body = fn_body_of(nk, kids, first, arity);
                let declared = ints_get(nrec, k);
                let bc = vec_get(ncomp, body);
                if bc == Completion.Value() {
                    // The body's entry on the type stack: one per child, in child order,
                    // and `ensures` clauses come after the body.
                    let mut bi = 0;
                    while ints_get(kids, first + bi) != body { bi = bi + 1; }
                    let bt = ints_get(ts, ints_len(ts) - arity + bi);
                    if agrees(bt, declared) == false {
                        let tail = ints_get(kids, ints_get(kid_first, body) + ints_get(nar, body) - 1);
                        report(diags, "N0300",
                                ints_get(nst, tail), ints_get(nen, tail),
                                str_concat(str_concat(str_concat(str_concat(str_concat("`",
                                before_colon(text)), "` returns `"), show_type(bt, rnames)),
                                "`, but its signature says `"), str_concat(show_type(declared, rnames), "`")));
                    }
                }
                if bc == Completion.Unit() {
                    report(diags, "N0300",
                            ints_get(nst, body), ints_get(nen, body),
                            str_concat(str_concat(str_concat("`", before_colon(text)),
                            "` must produce a `"), str_concat(show_type(declared, rnames),
                            "`, but this body does not")));
                }
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                // How many slots this function's entry block must allocate.
                ints_set(nslot, k, ints_get(counter, 0));
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            // A record declaration and its fields are checked in their own stages, before
            // any body. They still take part in the type stack, because the program node
            // pops one entry per child and a record is a child like a function.
            if kind == n_structfield() {
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                continue;
            }
            if kind == n_payload() {
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                continue;
            }
            if kind == n_variant() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                continue;
            }
            if kind == n_enum() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                continue;
            }
            if kind == n_record() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, t_unknown());
                continue;
            }
            if kind == n_program() {
                let mut d = 0;
                while d < arity { ints_pop(ts); d = d + 1; }
                ints_push(ts, t_unknown());
                ints_set(ntype, k, ints_get(ts, ints_len(ts) - 1));
                continue;
            }
            // `param` and every leaf pushed its own type when it was visited.
            continue;
        }

        // --- visit ------------------------------------------------------------------
        let kind = ints_get(nk, entry);
        let arity = ints_get(nar, entry);
        let first = ints_get(kid_first, entry);
        let text = strs_get(ntx, entry);

        // Leaves are typed here rather than at a finish, because they have no children
        // to wait for — so `ntype` is recorded here too. Missing these was a real
        // defect: the emitter reads `ntype` to decide whether a node left a value on
        // its stack, and a `var` recorded as `unknown` made a discarded expression
        // statement pop nothing.
        if kind == n_int() {
            ints_set(ntype, entry, t_int());
            ints_push(ts, t_int());
            continue;
        }
        // A foreign function's body is C (N102): nothing here falls off its end, so the
        // signature is the contract and there is no body to hold to it.
        if kind == n_foreign() {
            vec_set(ncomp, entry, Completion.Diverges());
            ints_set(ntype, entry, t_unknown());
            ints_push(ts, t_unknown());
            continue;
        }
        if kind == n_bool() {
            ints_set(ntype, entry, t_bool());
            ints_push(ts, t_bool());
            continue;
        }
        if kind == n_str() {
            ints_set(ntype, entry, t_str());
            ints_push(ts, t_str());
            continue;
        }
        if kind == n_break() {
            vec_set(ncomp, entry, Completion.Diverges());
            ints_push(ts, t_unknown());
            continue;
        }
        if kind == n_continue() {
            vec_set(ncomp, entry, Completion.Diverges());
            ints_push(ts, t_unknown());
            continue;
        }

        // A method call (N102). `Trait.m(x)` names a trait where the receiver would stand:
        // when the name is no value in scope and a trait in scope, it is the trait, and the
        // receiver is the first argument.
        if kind == n_method() {
            let c0 = ints_get(kids, first);
            if ints_get(nk, c0) == n_var() {
                let nm = strs_get(ntx, c0);
                if scope_has(names, nm) == false {
                    let tr = trait_visible(tb, module_at(mstart, ints_get(nst, entry)), nm,
                            mfirst, mcount, mto);
                    if tr >= 0 {
                        ints_set(nk, c0, n_traitref());
                        ints_set(ncallee, c0, tr);
                    }
                }
            }
            if ints_get(nk, c0) == n_traitref() {
                ints_push(work, mark_finish(entry));
                let mut j = arity - 1;
                while j >= 1 {
                    ints_push(work, ints_get(kids, first + j));
                    j = j - 1;
                }
                continue;
            }
        }
        // `name.m()` is a variant until `name` is a value (N102, the reference's rule): then
        // it is a method call on that value, with no argument node — the receiver is read
        // from its binding's slot, recorded on the call.
        if kind == n_makevariant() {
            if arity == 0 {
                let dot = index_of_byte(text, 46);
                let ename = str_slice(text, 0, dot);
                if scope_has(names, ename) {
                    let m = str_slice(text, dot + 1, str_len(text) - 2);
                    let here = module_at(mstart, ints_get(nst, entry));
                    let recv = lookup_type(names, ntypes, ename);
                    let mat = ints_get(nst, entry) + dot + 1;
                    let out = ints_new();
                    ints_push(out, 0);
                    ints_push(out, 0);
                    let sg = resolve_method(tb, here, recv, m, 0 - 1, mat, mat + str_len(m),
                            mfirst, mcount, mto, out, diags);
                    let mut ret = t_unknown();
                    if sg >= 0 {
                        let got = ints_new();
                        ints_push(got, recv);
                        ret = check_method_args(tb, sg, recv, m, got, ints_new(), nst, nen,
                                ints_get(nst, entry), ints_get(nen, entry), diags);
                        if ints_get(out, 0) == 1 {
                            ints_set(nk, entry, n_method());
                            ints_set(ncallee, entry, 0 - 10 - sg);
                        } else {
                            let g = ints_get(out, 1);
                            if g >= 0 {
                                ints_set(nk, entry, n_call());
                                strs_set(ntx, entry, strs_get(fnames, g));
                                ints_set(ncallee, entry, g);
                            }
                        }
                    }
                    ints_set(nslot, entry, lookup_slot(names, nslotof, ename));
                    ints_set(nrec, entry, recv);
                    ints_set(ntype, entry, ret);
                    ints_push(ts, ret);
                    continue;
                }
            }
        }
        if kind == n_var() {
            if scope_has(names, text) == false {
                // A function named where a value is (N102): a function value — non-generic,
                // not foreign, not a built-in — of its signature's type.
                let here = module_at(mstart, ints_get(nst, entry));
                let g = visible_function(text, here, fnames, fowner, vmod, vname, vfn);
                let vat = ints_get(nst, entry);
                let vto = ints_get(nen, entry);
                if builtin_index(bnames, text) >= 0 {
                    report(diags, "N0387", vat, vto,
                            str_concat(str_concat("`", text), "` is a built-in, and cannot be used as a value"));
                    ints_push(ts, t_unknown());
                } else {
                    if g < 0 {
                        report(diags, "N0200", vat, vto,
                                str_concat(str_concat("`", text), "` is not defined"));
                        ints_push(ts, t_unknown());
                    } else {
                        let mut refused = false;
                        if ints_get(fgc, g) > 0 {
                            report(diags, "N0387", vat, vto,
                                    str_concat(str_concat("`", text), "` is generic, and cannot be used as a value"));
                            refused = true;
                        }
                        if refused == false {
                            if is_foreign_def(nk, nar, kids, kid_first, fnode, g) {
                                report(diags, "N0387", vat, vto,
                                        str_concat(str_concat("`", text), "` is a foreign function, and cannot be used as a value"));
                                refused = true;
                            }
                        }
                        if refused == false {
                            if ints_len(tscope) > 0 {
                                report(diags, "N0387", vat, vto,
                                        "a function value inside a generic function is not supported yet");
                                refused = true;
                            }
                        }
                        if refused {
                            ints_push(ts, t_unknown());
                        } else {
                            let ps = ints_new();
                            let mut q = 0;
                            while q < ints_get(fcount, g) {
                                ints_push(ps, ints_get(fparams, ints_get(ffirst, g) + q));
                                q = q + 1;
                            }
                            let ft = fn_of(tb, ps, ints_get(fret, g),
                                    value_effects(tb, ntx, fnode, fowner, fparams, ffirst, fcount, g, here));
                            ints_set(nk, entry, n_fnvalue());
                            ints_set(ncallee, entry, g);
                            ints_set(ntype, entry, ft);
                            ints_push(ts, ft);
                        }
                    }
                }
            } else {
                ints_set(nslot, entry, closure_binding(names, ntypes, nmut, nslotof, cl_node, cl_base,
                        cl_counter, counter, cap_clo, cap_name, cap_outer, cap_inner, cap_type, text,
                        ints_get(nst, entry), ints_get(nen, entry), diags, tb));
                let t = lookup_type(names, ntypes, text);
                ints_set(ntype, entry, t);
                ints_push(ts, t);
            }
            continue;
        }

        if kind == n_param() {
            let slot = ints_get(counter, 0);
            ints_set(counter, 0, slot + 1);
            ints_set(nslot, entry, slot);
            bind(names, ntypes, nmut, nslotof, before_colon(text),
                    ints_get(nrec, entry), 0, slot);
            ints_push(ts, t_unknown());
            continue;
        }

        if kind == n_match() {
            // A slot of its own for the value being matched. The `match` owns it, so a
            // failure anywhere inside an arm gives it back by the ordinary frame path,
            // and each arm reads its payload out of it.
            let mslot = ints_get(counter, 0);
            ints_set(counter, 0, mslot + 1);
            ints_set(nslot, entry, mslot);
            // The scrutinee, then a mark, then the arms: an arm's pattern is checked
            // against a type that does not exist until the scrutinee has been.
            ints_push(work, mark_finish(entry));
            let mut a = arity - 1;
            while a >= 1 {
                ints_push(work, ints_get(kids, first + a));
                a = a - 1;
            }
            ints_push(work, mark_scrutinee(entry));
            if arity >= 1 { ints_push(work, ints_get(kids, first)); }
            continue;
        }

        if kind == n_arm() {
            // `E.V(field: binding, …)`. The variant is resolved here and the bindings are
            // made here, because the body is a child and must see them.
            let et = ints_get(menum, ints_len(menum) - 1);
            let qualified = before_paren(text);
            let en = before_dot(qualified);
            let vn = after_dot(qualified);
            let owner = module_at(mstart, ints_get(nst, entry));
            let named = type_in(en, owner, rnames, rowner, tmod, tname, trec);
            let mut v = 0 - 1;
            if is_enum(et, rkind) {
                // A pattern names the **definition** — `Maybe.Some`, never `Maybe[Int].Some`
                // — so it is compared with the definition the scrutinee applies.
                if named != t_record(definition_of(tb, et)) {
                    report(diags, "N0345", ints_get(nst, entry),
                            ints_get(nst, entry) + str_len(en),
                            str_concat(str_concat(str_concat(str_concat(
                            "this pattern is a `", show_type(named, rnames)),
                            "`, but the value is a `"), show_type(et, rnames)), "`"));
                    strs_set(mcov, strs_len(mcov) - 1, "!");
                } else {
                    let r = record_of(et);
                    let at = field_index(rfirst, rcount, rfname, r, vn);
                    if at < 0 {
                        report(diags, "N0341", ints_get(nst, entry),
                                ints_get(nen, entry),
                                str_concat(str_concat(str_concat(str_concat("`", en),
                                "` has no variant `"), vn), "`"));
                        strs_set(mcov, strs_len(mcov) - 1, "!");
                    } else {
                        let seen = strs_get(mcov, strs_len(mcov) - 1);
                        if seen != "!" {
                            if listed(seen, vn) {
                                report(diags, "N0344",
                                        ints_get(nst, entry), ints_get(nen, entry),
                                        str_concat(str_concat(str_concat(str_concat("`",
                                        en), "."), vn), "` already has an arm"));
                            } else {
                                if seen == "" {
                                    strs_set(mcov, strs_len(mcov) - 1, vn);
                                } else {
                                    strs_set(mcov, strs_len(mcov) - 1,
                                            str_concat(str_concat(seen, ","), vn));
                                }
                            }
                        }
                        v = record_of(field_type(rfirst, rftype, r, at));
                    }
                }
            }
            ints_set(nrec, entry, v);
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
            if v >= 0 {
                // One slot per payload field, in declaration order, whether or not the
                // pattern names it. A discard leaves its slot untouched, which costs an
                // `alloca` and nothing else — and it means the emitter needs one number
                // rather than a list.
                let base = ints_get(counter, 0);
                ints_set(counter, 0, base + ints_get(rcount, v));
                ints_set(nslot, entry, base);
                let bound = ints_new();
                let mut b = 0;
                while b < ints_get(rcount, v) { ints_push(bound, 0); b = b + 1; }
                let mut n = 0;
                while true {
                    let item = field_name_at(text, n);
                    if item == "" { break; }
                    let fname = before_colon(item);
                    let binding = after_colon(item);
                    let at = field_index(rfirst, rcount, rfname, v, fname);
                    if at < 0 {
                        report(diags, "N0333", ints_get(nst, entry),
                                ints_get(nen, entry),
                                str_concat(str_concat(str_concat(str_concat("`",
                                strs_get(rnames, v)), "` has no payload field `"),
                                fname), "`"));
                    } else {
                        if ints_get(bound, at) == 1 {
                            report(diags, "N0332", ints_get(nst, entry),
                                    ints_get(nen, entry),
                                    str_concat(str_concat("this pattern names `", fname),
                                    "` twice"));
                        }
                        ints_set(bound, at, 1);
                        if binding != "_" {
                            if scope_has(names, binding) {
                                let mut shadow = 0;
                                let mut q = strs_len(names) - 1;
                                while q >= ints_get(marks, ints_len(marks) - 1) {
                                    if strs_get(names, q) == binding { shadow = 1; }
                                    q = q - 1;
                                }
                                if shadow == 1 {
                                    report(diags, "N0202",
                                            ints_get(nst, entry), ints_get(nen, entry),
                                            str_concat(str_concat("`", binding),
                                            "` is bound twice by this pattern"));
                                }
                            }
                            bind(names, ntypes, nmut, nslotof, binding,
                                    field_type(rfirst, rftype, v, at), 0, base + at);
                        }
                    }
                    n = n + 1;
                }
                let mut missing = "";
                let mut m = 0;
                while m < ints_get(rcount, v) {
                    if ints_get(bound, m) == 0 {
                        if missing != "" { missing = str_concat(missing, ", "); }
                        missing = str_concat(str_concat(missing, "`"),
                                str_concat(strs_get(rfname, ints_get(rfirst, v) + m), "`"));
                    }
                    m = m + 1;
                }
                if missing != "" {
                    report(diags, "N0334", ints_get(nst, entry),
                            ints_get(nen, entry),
                            str_concat(str_concat(str_concat("this pattern does not name ",
                            missing), " of `"), str_concat(strs_get(rnames, v), "`")));
                }
            }
            ints_push(work, mark_finish(entry));
            if arity >= 1 { ints_push(work, ints_get(kids, first)); }
            continue;
        }

        if kind == n_fn() {
            // The function's own type parameters are the scope its body's types are
            // written in, and nothing else's are.
            while ints_len(tscope) > 0 { ints_pop(tscope); }
            let own = ints_get(ntfirst, entry);
            if own >= 0 {
                let mut sp = 0;
                while sp < ints_get(ntargs, own) {
                    ints_push(tscope, ints_get(ntargs, own + 1 + sp));
                    sp = sp + 1;
                }
            }
            // Slots are per function: a caller's local and a callee's cannot share one.
            ints_set(counter, 0, 0);
            ints_set(cur_ret, 0, ints_get(nrec, entry));
            ints_set(cur_rslot, 0, 0 - 1);
            while ints_len(auth) > 1 { ints_pop(auth); }
            ints_set(auth, 0, 0);
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
        }
        // A closure (N102): a function of its own, inside this one. Its slots are its own,
        // numbered from zero; its result is its own; the bindings around it are reached by
        // capture, which `closure_binding` makes on first use.
        if kind == n_closure() {
            if ints_len(tscope) > 0 {
                report(diags, "N0387", ints_get(nst, entry), ints_get(nst, entry) + 2,
                        "a closure inside a generic function is not supported yet");
            }
            ints_push(cl_node, entry);
            ints_push(auth, 0);
            ints_push(cl_base, strs_len(names));
            ints_push(cl_counter, ints_get(counter, 0));
            ints_push(cl_ret, ints_get(cur_ret, 0));
            ints_push(cl_rslot, ints_get(cur_rslot, 0));
            ints_set(counter, 0, 0);
            ints_set(cur_rslot, 0, 0 - 1);
            let owner = module_at(mstart, ints_get(nst, entry));
            let mut p = 0;
            while p < arity - 1 {
                let pc = ints_get(kids, first + p);
                ints_set(nrec, pc, resolve_written(tb, after_colon(strs_get(ntx, pc)), owner,
                        tscope, ints_get(nst, pc), ints_get(nen, pc), tmod, tname, trec, diags));
                p = p + 1;
            }
            ints_set(cur_ret, 0, resolve_written(tb, fn_ret(text), owner, tscope,
                    ints_get(nst, entry), ints_get(nen, entry), tmod, tname, trec, diags));
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
        }
        // An `ensures` clause sees `result`, the value being returned, in a slot of the
        // function's own (N102, the reference's `check_contracts`).
        if kind == n_contract() {
            if text == "ensures" {
                let mut rs = ints_get(cur_rslot, 0);
                if rs < 0 {
                    rs = ints_get(counter, 0);
                    ints_set(counter, 0, rs + 1);
                    ints_set(cur_rslot, 0, rs);
                }
                ints_set(nslot, entry, rs);
                ints_push(marks, strs_len(names));
                bind(names, ntypes, nmut, nslotof, "result", ints_get(cur_ret, 0), 0, rs);
                ints_push(work, mark_leave(entry));
            }
        }
        if kind == n_block() {
            ints_push(marks, strs_len(names));
            ints_push(work, mark_leave(entry));
        }

        ints_push(work, mark_finish(entry));
        let mut j = arity - 1;
        while j >= 0 {
            ints_push(work, ints_get(kids, first + j));
            j = j - 1;
        }
    }
    vec_len(diags)
}

fn str_to_int_flag(s: Str) -> Int {
    if s == "1" { return 1; }
    0
}

fn is_comparison(op: Str) -> Bool {
    if op == "==" { return true; }
    if op == "!=" { return true; }
    if op == "<" { return true; }
    if op == "<=" { return true; }
    if op == ">" { return true; }
    if op == ">=" { return true; }
    false
}

fn is_ordering(op: Str) -> Bool {
    if op == "<" { return true; }
    if op == "<=" { return true; }
    if op == ">" { return true; }
    if op == ">=" { return true; }
    false
}

fn check_binary(op: Str, l: Int, r: Int, from: Int, to: Int, rnames: Strs,
        rfirst: Ints, rcount: Ints, rfname: Strs, rftype: Ints, req: Ints,
        diags: Vec[Diag]) -> Int {
    let mut ok = true;
    let mut why = "";
    // `&&` and `||` (N102): `Bool` on both sides, the right evaluated only when the left
    // does not decide.
    let mut logical = op == "&&";
    if op == "||" { logical = true; }
    if logical {
        if agrees(l, t_bool()) == false { ok = false; }
        if agrees(r, t_bool()) == false { ok = false; }
        if ok == false {
            report(diags, "N0304", from, to,
                    str_concat(str_concat(str_concat(str_concat(str_concat("`", op),
                    "` cannot combine `"), show_type(l, rnames)), "` with `"),
                    str_concat(show_type(r, rnames), "`")));
        }
        return t_bool();
    }
    if is_comparison(op) {
        if is_ordering(op) {
            // Ordering is `Int` only: comparing strings needs a collation decision the
            // language has not made, and ordering booleans is almost always a mistake.
            if agrees(l, t_int()) == false { ok = false; }
            if agrees(r, t_int()) == false { ok = false; }
        } else {
            // Equality needs one type — two records of one shape are two types — and that
            // type must have equality, which is derived (N13): not on a sequence, a `Vec`
            // or a `Chan`, where it would have to mean identity or contents; not on an
            // unconstrained `T`, which supports only what every type supports; and on a
            // record or an enum exactly when everything it contains has it.
            if agrees(l, r) == false { ok = false; }
            why = equality_blocker(l, rfirst, rcount, rfname, rftype, req);
            if why != "" { ok = false; }
        }
        if ok == false {
            let mut message = str_concat(str_concat(str_concat("`", op), "` cannot compare `"),
                    str_concat(show_type(l, rnames), "`"));
            if why != "" {
                if why != "." {
                    message = str_concat(message,
                            str_concat(str_concat(": its `", why), "` has no equality"));
                }
            }
            report(diags, "N0304", from, to, message);
            return t_bool();
        }
        return t_bool();
    }
    // Arithmetic is `Int` only. No string concatenation with `+`, and `+` on two `Bool`s
    // is a mistake rather than something to define.
    if agrees(l, t_int()) == false { ok = false; }
    if agrees(r, t_int()) == false { ok = false; }
    if ok == false {
        report(diags, "N0304", from, to,
                str_concat(str_concat(str_concat("`", op), "` does not apply to `"),
                str_concat(show_type(l, rnames), "`")));
    }
    t_int()
}

/// The program's entry point: `main` in the **root** module, which is module 0.
///
/// Another module's `main` is one of its definitions and nothing more — it is private
/// unless exported, it is not a second entry point, and it does not satisfy this. A file
/// that is also runnable on its own is an ordinary thing to write, and before N2 it was
/// not expressible.
///
/// `main` need not be `pub`: being the entry point is not the same as being importable.
pub fn entry_point(fnames: Strs, fowner: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fnode: Ints, nar: Ints, kids: Ints, kid_first: Ints, nst: Ints, nen: Ints,
        diags: Vec[Diag]) -> Int {
    let at = owned_index(fnames, fowner, 0, "main");
    if at < 0 {
        report(diags, "N0204", 0, 0,
                "this program has no `main` function");
        return at;
    }
    // `main`'s parameters are the root of authority (N37, N102): the runtime hands it one of
    // each capability it declares, and it can supply nothing else.
    let mut p = 0;
    while p < ints_get(fcount, at) {
        if is_cap(ints_get(fparams, ints_get(ffirst, at) + p)) == false {
            let node = ints_get(fnode, at);
            let param = ints_get(kids, ints_get(kid_first, node) + p);
            report(diags, "N0371", ints_get(nst, param), ints_get(nen, param),
                    "a parameter of `main` must be a capability");
        }
        p = p + 1;
    }
    at
}

/// Check one call, and **record what it resolved to** on the call node.
///
/// `here` is the module doing the calling, and it is what makes the lookup an answer
/// rather than a guess: built-ins first, then this module's own definitions, then the
/// exports its direct imports brought in. Nothing else is in reach, which is where
/// non-transitivity is enforced — a name only reachable through a dependency's import was
/// never put into `vname` for this module.
///
/// The resolution is written to `ncallee[k]`: `-2` for a built-in, otherwise the
/// definition's index. Emission reads that and never looks a name up again, which is what
/// keeps two modules' private `helper` from becoming one symbol.
fn check_call(text: Str, argc: Int, ts: Ints, from: Int, to: Int,
        kids: Ints, first: Int, nst: Ints, nen: Ints, ncallee: Ints, node: Int, here: Int,
        fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fowner: Ints, fpub: Ints, vmod: Ints, vname: Strs, vfn: Ints,
        mfirst: Ints, mcount: Ints, mto: Ints,
        bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
        tb: Table, fgen: Ints, fgc: Ints, bgen: Ints, tscope: Ints, ncomp: Vec[Completion],
        ntfirst: Ints, ntargs: Ints, tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Int {
    // `name[T@9]`: the callee, then any type arguments written after it.
    let name = before_bracket(text);
    let written = from_bracket(text);
    let rnames = tb.names;
    // The arguments' types are the top `argc` entries, oldest first. Taken off here and
    // compared in order.
    let got = ints_new();
    let mut i = 0;
    while i < argc { ints_push(got, ints_pop(ts)); i = i + 1; }

    let mut want_first = 0 - 1;
    let mut want_count = 0;
    let mut ret = t_unknown();
    let mut params = fparams;
    let mut found = false;
    // The callee's own type parameters, as `t_param` codes: empty for one that is not
    // generic.
    let generics = ints_new();

    let bi = builtin_index(bnames, name);
    if bi >= 0 {
        want_first = ints_get(bfirst, bi);
        want_count = ints_get(bcount, bi);
        ret = ints_get(bret, bi);
        params = bparams;
        found = true;
        ints_set(ncallee, node, 0 - 2);
        if ints_get(bgen, bi) >= 0 { ints_push(generics, t_param(ints_get(bgen, bi))); }
    } else {
        let fi = resolve_fn(fnames, fowner, vmod, vname, vfn, here, name);
        if fi >= 0 {
            want_first = ints_get(ffirst, fi);
            want_count = ints_get(fcount, fi);
            ret = ints_get(fret, fi);
            found = true;
            ints_set(ncallee, node, fi);
            let mut g = 0;
            while g < ints_get(fgc, fi) {
                ints_push(generics, t_param(ints_get(fgen, fi) + g));
                g = g + 1;
            }
        }
    }

    if found == false {
        // Defined, and private where it lives. Said as that rather than as "not defined",
        // which is true from here and useless to a reader looking at the file they just
        // imported.
        if private_in_an_import(fnames, fowner, fpub, mfirst, mcount, mto, here, name) {
            report(diags, "N0206", from, from + str_len(name),
                    str_concat(str_concat("`", name),
                    "` is private to the module that defines it"));
            return t_unknown();
        }
        report(diags, "N0201", from, from + str_len(name),
                str_concat(str_concat("`", name), "` is not a function"));
        return t_unknown();
    }

    if want_count != argc {
        report(diags, "N0303", from, to,
                str_concat(str_concat("`", name), "` was given the wrong number of arguments"));
        return ret;
    }

    if ints_len(generics) > 0 {
        return check_generic_call(name, written, argc, got, from, to, kids, first, nst, nen,
                node, want_first, params, ret, generics, tb, tscope, ncomp, ntfirst, ntargs,
                here, tmod, tname, trec, mfirst, mcount, mto,
                diags);
    }
    if str_len(written) > 0 {
        report(diags, "N0351", from, from + str_len(name),
                str_concat(str_concat("`", name),
                "` is not generic, so it takes no type arguments"));
    }

    let mut a = 0;
    while a < argc {
        // `got` holds them innermost-last, so argument `a` is at `argc - 1 - a`.
        let actual = ints_get(got, argc - 1 - a);
        let expected = ints_get(params, want_first + a);
        if agrees(actual, expected) == false {
            // The argument's own span: the reference points at the value, not the call.
            let node = ints_get(kids, first + a);
            report(diags, "N0300",
                    ints_get(nst, node), ints_get(nen, node),
                    str_concat(str_concat(str_concat("argument ", int_to_str(a + 1)),
                    str_concat(" of `", name)),
                    "` has the wrong type"));
        }
        a = a + 1;
    }
    ret
}

// A call to a generic function, or to a generic built-in: the reference's
// `check_generic_call`, in the same order and with the same answers.
//
// The type arguments are the written ones when there are exactly as many as the callee
// declares; otherwise each parameter is **inferred from the arguments**, by matching each
// declared parameter type against the argument's type — never from what the result is
// used for. An argument whose declared type is already fully known is simply checked
// against it. What each parameter settles to is recorded on the node, `[count, a1, …]`
// in the node-type list, for the emitter to instantiate.
//
// `solved[i]` is 1 once parameter `i` is known, with its type in `sval[i]` and in
// `sfrom[i]` the argument that settled it — `-1` for the written type arguments.
fn check_generic_call(name: Str, written: Str, argc: Int, got: Ints, from: Int, to: Int,
        kids: Ints, first: Int, nst: Ints, nen: Ints, node: Int, want_first: Int,
        params: Ints, ret: Int, generics: Ints, tb: Table, tscope: Ints, ncomp: Vec[Completion],
        ntfirst: Ints, ntargs: Ints, here: Int, tmod: Ints, tname: Strs, trec: Ints,
        mfirst: Ints, mcount: Ints, mto: Ints,
        diags: Vec[Diag]) -> Int {
    let n = ints_len(generics);
    let solved = ints_new();
    let sval = ints_new();
    let sfrom = ints_new();
    // Parameters an argument already failed on. One mistake is one error: an argument of
    // the wrong shape is reported as a mismatch, and the parameters its declared type
    // mentions are not reported again as impossible to infer.
    let excused = ints_new();
    let mut g = 0;
    while g < n {
        ints_push(solved, 0);
        ints_push(sval, t_int());
        ints_push(sfrom, 0);
        ints_push(excused, 0);
        g = g + 1;
    }
    let mut explicit = false;
    if str_len(written) > 0 {
        let resolved = resolve_type_args(tb, written, here, tscope, tmod, tname, trec,
                diags);
        if ints_len(resolved) == n {
            let mut w = 0;
            while w < n {
                ints_set(solved, w, 1);
                ints_set(sval, w, ints_get(resolved, w));
                ints_set(sfrom, w, 0 - 1);
                w = w + 1;
            }
            explicit = true;
        } else {
            report(diags, "N0353", from, from + str_len(name),
                    str_concat(str_concat(str_concat(str_concat(str_concat("`", name),
                    "` takes "), int_to_str(n)), " type arguments, but "),
                    str_concat(int_to_str(ints_len(resolved)), " were given")));
        }
    }

    let mut a = 0;
    while a < argc {
        let actual = ints_get(got, argc - 1 - a);
        let formal = ints_get(params, want_first + a);
        let arg = ints_get(kids, first + a);
        let mut known = explicit;
        if mentions(tb, formal, generics) == false { known = true; }
        if known {
            // Checked against its declared type, as a monomorphic call's argument is, when
            // that type is fully known. A parameter settled by an earlier **argument** is
            // not "known": the two are unified, so that `same(1, "x")` is a conflict
            // between them rather than the second read against the first.
            let want = substitute(tb, formal, generics, partial(solved, sval, generics));
            if agrees(actual, want) == false {
                report(diags, "N0300", ints_get(nst, arg), ints_get(nen, arg),
                        str_concat(str_concat(str_concat(str_concat(str_concat(
                        "argument ", int_to_str(a + 1)), str_concat(" of `", name)), "` is `"),
                        str_concat(show_type(want, tb.names), "`, but this is `")),
                        str_concat(show_type(actual, tb.names), "`")));
            }
        } else {
            let c = vec_get(ncomp, arg);
            if c == Completion.Unit() {
                // No value — refused already where it is written. Its parameters are
                // excused, so the one mistake is not reported twice.
                excuse(tb, formal, generics, excused);
            }
            if c == Completion.Value() {
                let conflict = ints_new();
                let outcome = unify(tb, formal, actual, generics, solved, sval, sfrom, a, conflict);
                if outcome == 2 {
                    let p = ints_get(conflict, 0);
                    let earlier = ints_get(conflict, 1);
                    let mut source = str_concat("argument ", int_to_str(ints_get(conflict, 2) + 1));
                    if ints_get(conflict, 2) < 0 { source = "the written type arguments"; }
                    report(diags, "N0355", ints_get(nst, arg), ints_get(nen, arg),
                            str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(
                            "`", strs_get(tb.names, entry_of(ints_get(generics, p)))), "` is `"),
                            show_type(earlier, tb.names)), "` from "), source),
                            str_concat(str_concat(", but argument ", int_to_str(a + 1)),
                            " makes it something else")));
                }
                if outcome == 1 {
                    excuse(tb, formal, generics, excused);
                    let want = substitute(tb, formal, generics, partial(solved, sval, generics));
                    report(diags, "N0300", ints_get(nst, arg), ints_get(nen, arg),
                            str_concat(str_concat(str_concat(str_concat(str_concat(
                            "argument ", int_to_str(a + 1)), str_concat(" of `", name)), "` is `"),
                            str_concat(show_type(want, tb.names), "`, but this is `")),
                            str_concat(show_type(actual, tb.names), "`")));
                }
            }
            // An argument that never produces a value says nothing about a type.
        }
        a = a + 1;
    }

    let mut missing = "";
    g = 0;
    while g < n {
        if ints_get(solved, g) == 0 {
            if ints_get(excused, g) == 0 {
                if missing != "" { missing = str_concat(missing, ", "); }
                missing = str_concat(str_concat(missing, "`"),
                        str_concat(strs_get(tb.names, entry_of(ints_get(generics, g))), "`"));
            }
        }
        g = g + 1;
    }
    if missing != "" {
        report(diags, "N0354", from, from + str_len(name),
                str_concat(str_concat(str_concat("nothing in this call to `", name), "` says what "),
                str_concat(missing, " is")));
    }

    // What each parameter's declaration requires, of the argument it was given (N14), by
    // the one derivation `==` uses: a concrete argument by what it contains, a caller's own
    // parameter by its declaration. Reported where the reference reports it — at the
    // callee for a written argument, at the argument an inferred one came from.
    g = 0;
    while g < n {
        if ints_get(solved, g) == 1 {
            // A trait bound (N102): the argument for the parameter has an impl of the trait in
            // this module's scope, or is a parameter bounded by it.
            let rq = ints_get(tb.req, entry_of(ints_get(generics, g)));
            if rq >= 2 {
                let arg_t = ints_get(sval, g);
                let tr = rq - 2;
                let mut has = bound_trait(tb, arg_t) == tr;
                if has == false {
                    if impl_for(tb, tr, arg_t, here, mfirst, mcount, mto) >= 0 { has = true; }
                }
                if arg_t == t_unknown() { has = true; }
                if has == false {
                    let mut at_from = from;
                    let mut at_to = from + str_len(name);
                    if ints_get(sfrom, g) >= 0 {
                        let src = ints_get(kids, first + ints_get(sfrom, g));
                        at_from = ints_get(nst, src);
                        at_to = ints_get(nen, src);
                    }
                    let pn = strs_get(tb.names, entry_of(ints_get(generics, g)));
                    report(diags, "N0364", at_from, at_to,
                            str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(
                            "`", name), "` requires `"), pn), str_concat(": ", strs_get(tb.trn, tr))),
                            str_concat(str_concat(str_concat("`, and `", pn), "` is `"),
                            show_type(arg_t, tb.names))),
                            str_concat(str_concat("` here, which has no impl of `", strs_get(tb.trn, tr)),
                            "` in this module's scope")));
                }
            }
            if ints_get(tb.req, entry_of(ints_get(generics, g))) == 1 {
                let arg_t = ints_get(sval, g);
                let why = equality_blocker(arg_t, tb.first, tb.count, tb.fname, tb.ftype, tb.req);
                if why != "" {
                    let mut at_from = from;
                    let mut at_to = from + str_len(name);
                    if ints_get(sfrom, g) >= 0 {
                        let src = ints_get(kids, first + ints_get(sfrom, g));
                        at_from = ints_get(nst, src);
                        at_to = ints_get(nen, src);
                    }
                    report(diags, "N0364", at_from, at_to,
                            str_concat(str_concat(str_concat("`", name), "` requires `"),
                            str_concat(str_concat(strs_get(tb.names, entry_of(ints_get(generics, g))),
                            ": Equality`, and `"), str_concat(show_type(arg_t, tb.names),
                            "` does not have it"))));
                }
            }
        }
        g = g + 1;
    }

    // What the call settled, on the node: an unsettled parameter is `Int`, as the
    // reference's is, and the program is refused anyway.
    ints_set(ntfirst, node, ints_len(ntargs));
    ints_push(ntargs, n);
    g = 0;
    while g < n {
        ints_push(ntargs, ints_get(sval, g));
        g = g + 1;
    }
    let settled = ints_new();
    g = 0;
    while g < n { ints_push(settled, ints_get(sval, g)); g = g + 1; }
    let result = substitute(tb, ret, generics, settled);
    settle_now(tb);
    if depth_of(tb, result) > max_type_depth() {
        report(diags, "N0338", from, to,
                "this call produces a type nested more than 32 deep");
        return t_unknown();
    }
    result
}

// The arguments settled so far, with each unsettled parameter left as itself — so that
// substituting them into a declared type says what is known and nothing more.
fn partial(solved: Ints, sval: Ints, generics: Ints) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_len(generics) {
        if ints_get(solved, i) == 1 {
            ints_push(out, ints_get(sval, i));
        } else {
            ints_push(out, ints_get(generics, i));
        }
        i = i + 1;
    }
    out
}

// Mark every parameter in `generics` that `formal` mentions as already accounted for.
fn excuse(tb: Table, formal: Int, generics: Ints, excused: Ints) -> Int {
    let work = ints_new();
    ints_push(work, formal);
    while ints_len(work) > 0 {
        let t = ints_pop(work);
        let at = index_of(generics, t);
        if at >= 0 { ints_set(excused, at, 1); }
        let parts = type_args(tb, t);
        let mut i = 0;
        while i < ints_len(parts) { ints_push(work, ints_get(parts, i)); i = i + 1; }
    }
    0
}

// Match a declared parameter type against an argument's type, settling the callee's
// parameters it mentions. Structural through applications and `Vec`; nothing else is.
//
// `0` when it matches, `1` for a mismatch of shape, `2` for a conflict — a parameter
// already settled to something else — with `[parameter, earlier type, where from]` in
// `conflict`. A worklist of pairs, taken left to right as the reference's recursion takes
// them, so the first conflict found is the first one written.
fn unify(tb: Table, formal: Int, actual: Int, generics: Ints, solved: Ints, sval: Ints,
        sfrom: Ints, arg: Int, conflict: Ints) -> Int {
    let wf = ints_new();
    let wa = ints_new();
    ints_push(wf, formal);
    ints_push(wa, actual);
    while ints_len(wf) > 0 {
        let f = ints_pop(wf);
        let x = ints_pop(wa);
        // What has already been reported agrees with everything.
        if x == t_unknown() { continue; }
        if mentions(tb, f, generics) == false {
            if f != x { return 1; }
            continue;
        }
        let p = index_of(generics, f);
        if p >= 0 {
            if ints_get(solved, p) == 0 {
                ints_set(solved, p, 1);
                ints_set(sval, p, x);
                ints_set(sfrom, p, arg);
            } else {
                if ints_get(sval, p) != x {
                    if ints_get(sval, p) != t_unknown() {
                        ints_push(conflict, p);
                        ints_push(conflict, ints_get(sval, p));
                        ints_push(conflict, ints_get(sfrom, p));
                        return 2;
                    }
                }
            }
            continue;
        }
        if is_vec(f) {
            if is_vec(x) == false { return 1; }
            ints_push(wf, ints_get(type_args(tb, f), 0));
            ints_push(wa, ints_get(type_args(tb, x), 0));
            continue;
        }
        if is_record(f) {
            if is_record(x) == false { return 1; }
            if definition_of(tb, f) != definition_of(tb, x) { return 1; }
            let fa = type_args(tb, f);
            let xa = type_args(tb, x);
            if ints_len(fa) != ints_len(xa) { return 1; }
            // Pushed in reverse, so the first argument is matched first.
            let mut i = ints_len(fa) - 1;
            while i >= 0 {
                ints_push(wf, ints_get(fa, i));
                ints_push(wa, ints_get(xa, i));
                i = i - 1;
            }
            continue;
        }
        return 1;
    }
    0
}

// --- the front end as one stage, N12 --------------------------------------------------

/// What the front end established about a program that checked: its tree, what every node
/// was resolved to, the type table and the function table — everything emission reads,
/// and nothing it would have to decide again.
pub struct Checked {
    nk: Ints,
    nar: Ints,
    nst: Ints,
    nen: Ints,
    ntx: Strs,
    naux: Ints,
    kids: Ints,
    kid_first: Ints,
    nslot: Ints,
    ntype: Ints,
    ncallee: Ints,
    nrec: Ints,
    ntfirst: Ints,
    ntargs: Ints,
    tb: Table,
    fnames: Strs,
    fret: Ints,
    fowner: Ints,
    fgc: Ints,
    entry: Int,
}

/// Lex, parse and check a loaded program: its tables, or every diagnostic it earned.
///
/// **A stage boundary, and the only one that fails this way.** Inside, every pass still
/// collects into one `Vec[Diag]` and keeps going, so a program with three mistakes reports
/// three — recovery is the checker's job and a first error must not end it. What does end
/// is the stage: a program with any diagnostic has no checked tables to hand on, so the
/// answer is the one or the other, and the type says so. Until N12 each driver ran these
/// passes itself, threaded the sink through them, and then asked `vec_len(diags) > 0`.
pub fn check_program(src: Str, mpath: Strs, mstart: Ints, mfirst: Ints, mcount: Ints,
        mto: Ints, mat: Ints, io: IoCap) -> Result[Checked, Vec[Diag]] {
    let kinds = ints_new();
    let starts = ints_new();
    let ends = ints_new();
    let texts = strs_new();
    lex(src, kinds, starts, ends, texts, io);

    let nk = ints_new();
    let nar = ints_new();
    let nst = ints_new();
    let nen = ints_new();
    let ntx = strs_new();
    let naux = ints_new();
    parse_program(kinds, starts, ends, texts, nk, nar, nst, nen, ntx, naux, io);

    let kids = ints_new();
    let kid_first = ints_new();
    build_children(nk, nar, kids, kid_first);

    // The built-ins share the ordinary function namespace, exactly as `docs/spec.md`
    // says, so a call to one is not an undefined function — and a definition may not take
    // one of their names, which is why they are collected first.
    let bnames = strs_new();
    let bret = ints_new();
    let bfirst = ints_new();
    let bcount = ints_new();
    let bparams = ints_new();
    builtins(bnames, bret, bfirst, bcount, bparams);

    let diags = vec_new[Diag]();

    // Records, in three stages before any signature. Names first, for the whole
    // compilation, because a field's type may name a record declared later or in another
    // module; then the field types; then the layouts those fields describe. `docs/spec.md`
    // orders them and says why declaration order is not a dependency.
    let rnames = strs_new();
    let rowner = ints_new();
    let rpub = ints_new();
    let rat = ints_new();
    let rnode = ints_new();
    // What each entry is: a record, an enum, one of an enum's variants, a `Vec` or a type
    // parameter. See `analyse.nz`, *an enum is a record whose fields are its variants*,
    // and *generics*.
    let rkind = ints_new();
    let rfirst = ints_new();
    let rcount = ints_new();
    let rfname = strs_new();
    let rftype = ints_new();
    let rfat = ints_new();
    let tb = new_table(rnames, rowner, rpub, rat, rnode, rkind, rfirst, rcount,
            rfname, rftype, rfat);
    // The core prelude's module, found by its key — once, here, for every consumer below.
    let core = core_module(mpath);
    let tmod = ints_new();
    let tname = strs_new();
    let trec = ints_new();
    collect_records(nk, nar, nst, nen, ntx, naux, mstart, tb, kids, kid_first,
            diags);
    // Each module's types and traits, and what its imports and re-exports bring in (N103).
    let linked = link_types(kinds, starts, texts, nk, nar, nst, nen, ntx, naux, kids, kid_first,
            mpath, mstart, mfirst, mcount, mto, mat, core, tb, tmod, tname, trec, diags);
    // The generic built-ins' `T` and `Vec[T]`, now that there is a table to hold them.
    let bgen = ints_new();
    generic_builtins(tb, bnames, bret, bparams, bgen);

    // Signatures before any body, so a forward reference resolves — the same two-pass
    // shape `nazm-lir::lower` uses, and for the same reason. The declared types go on the
    // `fn` and `param` nodes as they are resolved, so those arrays exist first.
    let nslot = ints_new();
    let ntype = ints_new();
    let ncallee = ints_new();
    let nrec = ints_new();
    // The types a node carries beyond its own: a function's type parameters, and what a
    // generic call settled its callee's to — `[count, t1, …]` in `ntargs`, from
    // `ntfirst[node]`.
    let ntfirst = ints_new();
    let ntargs = ints_new();
    let fnames = strs_new();
    let fret = ints_new();
    let ffirst = ints_new();
    let fcount = ints_new();
    let fparams = ints_new();
    let fowner = ints_new();
    let fpub = ints_new();
    let fgen = ints_new();
    let fgc = ints_new();
    // Each definition's `fn` node, by definition index.
    let fnode = ints_new();
    collect_signatures(nk, nar, nst, nen, ntx, naux, kids, kid_first, mstart,
            fnames, fret, ffirst, fcount, fparams, fowner, fpub, fgen, fgc, bnames, tb,
            nrec, ntfirst, ntargs, tmod, tname, trec, fnode,
            diags);

    // What each module's imports bring in, and the collisions that creates. Nothing here
    // for a one-module program, and it still runs: the pass is not conditional on there
    // being more than one module.
    let vmod = ints_new();
    let vname = strs_new();
    let vfn = ints_new();
    let entry = link_functions(linked, nk, nar, nst, nen, ntx, naux, kids, kid_first, mpath,
            mstart, mfirst, mcount, mto, mat, fnames, fret, ffirst, fcount, fparams, fowner,
            fpub, fnode, vmod, vname, vfn, tb, tmod, tname, trec, diags);
    // Every body, then what the bodies require of effects and contracts (N102).
    check_bodies(nk, nar, nst, nen, ntx, naux, nslot, ntype, ncallee, nrec, kids, kid_first,
            mstart, mfirst, mcount, mto, core, fnames, fret, ffirst, fcount, fparams, fowner,
            fpub, vmod, vname, vfn, bnames, bret, bfirst, bcount, bparams, tb, fgen, fgc, bgen,
            ntfirst, ntargs, tmod, tname, trec, fnode, diags);

    if vec_len(diags) > 0 {
        return Result[Checked, Vec[Diag]].Err(error: diags);
    }
    Result[Checked, Vec[Diag]].Ok(value: Checked(nk: nk, nar: nar, nst: nst, nen: nen,
            ntx: ntx, naux: naux, kids: kids, kid_first: kid_first, nslot: nslot,
            ntype: ntype, ncallee: ncallee, nrec: nrec, ntfirst: ntfirst, ntargs: ntargs,
            tb: tb, fnames: fnames, fret: fret, fowner: fowner, fgc: fgc, entry: entry))
}

// --- effect sets, N102 ---------------------------------------------------------------
//
//
// The reference's `nazm-core/src/effects.rs`, for what this compiler parses: each function's
// declared set (`! { io, spawn, foreign }`) is checked for names (`N0367`) and repeats
// (`N0368`), and a declared set must contain every effect its body requires (`N0366`).
// What a body requires is found the reference's way, in rounds: first each body's own
// effects — a built-in that reaches the outside world, a `spawn`, a foreign function, a call
// to a declared function (its set), a call to another module's undeclared function (every
// effect the bridge covers) — then, round by round, what this module's undeclared functions
// it calls require, each round reading only the previous one's sets so the order functions
// are visited in cannot change a result.
//
// The first reason for each effect is the one a diagnostic points at: a body's own effects
// before anything it inherits, in the order the calls are written.
//
// An effect set is three bits: `io` 1, `spawn` 2, `foreign` 4 — `Effect::ALL`'s order.

pub fn fx_io() -> Int { 1 }
pub fn fx_spawn() -> Int { 2 }
pub fn fx_foreign() -> Int { 4 }

pub fn fx_bit(name: Str) -> Int {
    if name == "io" { return fx_io(); }
    if name == "spawn" { return fx_spawn(); }
    if name == "foreign" { return fx_foreign(); }
    0
}

pub fn fx_name(bit: Int) -> Str {
    if bit == fx_io() { return "io"; }
    if bit == fx_spawn() { return "spawn"; }
    "foreign"
}

pub fn fx_has(set: Int, bit: Int) -> Bool { (set / bit) % 2 == 1 }

pub fn fx_with(set: Int, bit: Int) -> Int {
    if fx_has(set, bit) { return set; }
    set + bit
}

// A set as source writes it: `{}` or `{ io, spawn }`.
pub fn fx_text(set: Int) -> Str {
    if set == 0 { return "{}"; }
    let mut out = "{ ";
    let mut bit = 1;
    let mut first = true;
    while bit <= 4 {
        if fx_has(set, bit) {
            if first == false { out = str_concat(out, ", "); }
            out = str_concat(out, fx_name(bit));
            first = false;
        }
        bit = bit * 2;
    }
    str_concat(out, " }")
}

// The effect a built-in exercises, by its name: `io` for what reaches the process's
// arguments, files, streams or exit; none for the rest. (`c_errno`, whose effect is `foreign`,
// is a built-in this compiler does not carry.)
pub fn fx_of_builtin(name: Str) -> Int {
    if name == "args_count" { return fx_io(); }
    if name == "arg" { return fx_io(); }
    if name == "read_file" { return fx_io(); }
    if name == "write_file" { return fx_io(); }
    if name == "file_exists" { return fx_io(); }
    if name == "print" { return fx_io(); }
    if name == "eprint" { return fx_io(); }
    if name == "exit_with" { return fx_io(); }
    0
}

// The capability a built-in needs held (N104): an `OutCap` for the standard streams, which
// an `IoCap` implies; an `IoCap` for the rest of the outside world; none for the others.
pub fn auth_kind_of_builtin(name: Str) -> Int {
    if name == "print" { return t_outcap(); }
    if name == "eprint" { return t_outcap(); }
    if fx_of_builtin(name) == fx_io() { return t_iocap(); }
    0
}

fn auth_bit(kind: Int) -> Int {
    if kind == t_iocap() { return 1; }
    if kind == t_outcap() { return 2; }
    4
}

fn cap_name(kind: Int) -> Str {
    if kind == t_iocap() { return "IoCap"; }
    if kind == t_outcap() { return "OutCap"; }
    "SpawnCap"
}

// Whether a binding in scope holds `kind`: one of its type, or an `IoCap` for an `OutCap`.
// Lexical, as the reference's: a closure holds what it can capture.
fn holds_kind(ntypes: Ints, kind: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(ntypes) {
        let t = ints_get(ntypes, i);
        if t == kind { return true; }
        if kind == t_outcap() {
            if t == t_iocap() { return true; }
        }
        i = i + 1;
    }
    false
}

// `N0369` for a site that needs `kind` and holds none, once per kind per body (N104): every
// function holds what it exercises; nothing is inherited from a caller.
fn check_held(ntypes: Ints, kind: Int, what: Str, at: Int, to: Int, auth: Ints,
        diags: Vec[Diag]) -> Int {
    if kind == 0 { return 0; }
    let bit = auth_bit(kind);
    let top = ints_len(auth) - 1;
    let done = ints_get(auth, top);
    if (done / bit) % 2 == 1 { return 0; }
    if holds_kind(ntypes, kind) { return 0; }
    ints_set(auth, top, done + bit);
    report(diags, "N0369", at, to,
            str_concat(str_concat(str_concat(what, " requires `"), cap_name(kind)),
            str_concat("` authority, and this function holds none here", "")));
    0
}

// The declared set of a function's text, checked: `-1` when it declares none, or when a name
// in it is not an effect — a set that could not be read declares nothing anyone can know.
pub fn fx_declared(written: Str, report_into: Vec[Diag]) -> Int {
    if written == "" { return 0 - 1; }
    let mut set = 0;
    let mut known = true;
    let mut i = 1;
    let n = str_len(written);
    while i < n {
        let mut j = i;
        while j < n {
            if str_byte(written, j) == 44 { break; }
            j = j + 1;
        }
        let item = str_slice(written, i, j);
        let mut at = 0;
        let mut name = item;
        let mut c = 0;
        while c < str_len(item) {
            if str_byte(item, c) == 64 {
                name = str_slice(item, 0, c);
                at = fx_number(str_slice(item, c + 1, str_len(item)));
            }
            c = c + 1;
        }
        let bit = fx_bit(name);
        if bit == 0 {
            known = false;
            report(report_into, "N0367", at, at + str_len(name),
                    str_concat(str_concat("`", name), "` is not an effect"));
        } else {
            if fx_has(set, bit) {
                report(report_into, "N0368", at, at + str_len(name),
                        str_concat(str_concat("`", name), "` is written twice in this effect set"));
            } else {
                set = set + bit;
            }
        }
        i = j + 1;
    }
    if known { return set; }
    0 - 1
}

// Whether a value of `t` can carry a `ForeignCap`: it is one, or a field of a record or a
// variant it holds is, transitively — the only way a function could reach C.
fn fx_carries_foreign(t: Int, tb: Table) -> Bool {
    let work = ints_new();
    ints_push(work, t);
    let mut steps = 0;
    while ints_len(work) > 0 {
        let x = ints_pop(work);
        steps = steps + 1;
        if steps > 4096 { return true; }
        if x == t_foreigncap() { return true; }
        if is_record(x) {
            let r = record_of(x);
            if r < strs_len(tb.names) {
                let mut f = 0;
                while f < ints_get(tb.count, r) {
                    ints_push(work, ints_get(tb.ftype, ints_get(tb.first, r) + f));
                    f = f + 1;
                }
            }
        }
    }
    false
}

// Check every function's declared effect set against what its body requires.
pub fn check_effects(nk: Ints, nar: Ints, nst: Ints, ntx: Strs, naux: Ints, ncallee: Ints, nrec: Ints,
        kids: Ints, kid_first: Ints, mstart: Ints,
        fnames: Strs, fnode: Ints, fowner: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fforeign: Ints, tb: Table, diags: Vec[Diag]) -> Int {
    let nf = strs_len(fnames);
    // Each definition's declared set, or `-1`.
    let declared = ints_new();
    let mut f = 0;
    while f < nf {
        let node = ints_get(fnode, f);
        let mut d = fx_declared(fn_effects(strs_get(ntx, node)), diags);
        // An impl method that writes no set has its trait's (N102).
        if f < ints_len(tb.fdecl) {
            if ints_get(tb.fdecl, f) != 0 - 2 { d = ints_get(tb.fdecl, f); }
        }
        // A foreign function's body is C: its contract is `foreign`, whatever is written.
        if ints_get(fforeign, f) == 1 { d = fx_foreign(); }
        ints_push(declared, d);
        f = f + 1;
    }
    // Which definition each node belongs to: a function's subtree is contiguous and ends at
    // its `fn` node, so one pass from each `fn` node back over its subtree says.
    let parent = ints_new();
    let childno = ints_new();
    let substart = ints_new();
    build_relations(nk, nar, kids, kid_first, parent, childno, substart);
    let owner = ints_new();
    let mut k = 0;
    while k < ints_len(nk) { ints_push(owner, 0 - 1); k = k + 1; }
    f = 0;
    while f < nf {
        let node = ints_get(fnode, f);
        let mut j = ints_get(substart, node);
        while j <= node { ints_set(owner, j, f); j = j + 1; }
        f = f + 1;
    }
    // A closure's body is the closure's, not its function's (N102): making one exercises
    // nothing. Each node inside one belongs to the innermost closure around it, outermost
    // first so an inner one's claim stands.
    let cowner = ints_new();
    k = 0;
    while k < ints_len(nk) { ints_push(cowner, 0 - 1); k = k + 1; }
    k = ints_len(nk) - 1;
    while k >= 0 {
        if ints_get(nk, k) == n_closure() {
            let mut j = ints_get(substart, k);
            while j < k {
                ints_set(cowner, j, k);
                ints_set(owner, j, 0 - 1);
                j = j + 1;
            }
        }
        k = k - 1;
    }
    // Round zero: each body's own effects, the first reason for each — as three parallel
    // per-definition arrays of three slots, the offset and end of the reason for each bit.
    let sets = ints_new();
    let why_at = ints_new();
    let why_to = ints_new();
    let why_text = strs_new();
    f = 0;
    while f < nf {
        ints_push(sets, 0);
        let mut b = 0;
        while b < 3 {
            ints_push(why_at, 0);
            ints_push(why_to, 0);
            strs_push(why_text, "");
            b = b + 1;
        }
        f = f + 1;
    }
    // The calls to this module's undeclared functions: caller, callee and where.
    let efrom = ints_new();
    let eto = ints_new();
    let eat = ints_new();
    let eend = ints_new();
    k = 0;
    while k < ints_len(nk) {
        let kind = ints_get(nk, k);
        let mut is_call = false;
        if kind == n_call() { is_call = true; }
        if kind == n_spawn() { is_call = true; }
        let me = ints_get(owner, k);
        // A call through a bound exercises what the trait's signature declares (N102).
        if kind == n_method() {
            if me >= 0 {
                let code = ints_get(ncallee, k);
                if code <= 0 - 10 {
                    let sg = 0 - 10 - code;
                    let se = ints_get(tb.seff, sg);
                    if se > 0 {
                        let at = ints_get(naux, k);
                        fx_reasons(sets, why_at, why_to, why_text, me, se, at,
                                at + str_len(strs_get(ntx, k)),
                                str_concat(str_concat("calls `", strs_get(ntx, k)),
                                "`, whose declared set includes `"));
                    }
                }
            }
        }
        if is_call {
            if me >= 0 {
                let name = shown_name(before_bracket(strs_get(ntx, k)));
                // Where the callee is written: a call starts there; a `spawn` keeps it in its
                // auxiliary column, its own span starting at the keyword.
                let mut at = ints_get(nst, k);
                if kind == n_spawn() { at = ints_get(naux, k); }
                let to = at + str_len(name);
                if kind == n_spawn() {
                    fx_reason(sets, why_at, why_to, why_text, me, fx_spawn(), at, to,
                            "`spawn` starts a task, which requires `spawn`");
                }
                let g = ints_get(ncallee, k);
                // A call through a function value performs its type's effects (N50).
                if g == 0 - 3 {
                    let te = fn_effect_bits(tb, ints_get(nrec, k));
                    if te > 0 {
                        fx_reasons(sets, why_at, why_to, why_text, me, te, at, to,
                                str_concat(str_concat("calls a function value of type `",
                                show_type(ints_get(nrec, k), tb.names)), "`, whose type includes `"));
                    }
                }
                if g == 0 - 2 {
                    let e = fx_of_builtin(name);
                    if e != 0 {
                        fx_reason(sets, why_at, why_to, why_text, me, e, at, to,
                                str_concat(str_concat(str_concat("the built-in `", name),
                                "` requires `"), str_concat(fx_name(e), "`")));
                    }
                }
                if g >= 0 {
                    let local = ints_get(fowner, g) == ints_get(fowner, me);
                    let theirs = ints_get(declared, g);
                    if theirs >= 0 {
                        fx_reasons(sets, why_at, why_to, why_text, me, theirs, at, to,
                                str_concat(str_concat("calls `", name), "`, whose declared set includes `"));
                    } else {
                        if local {
                            ints_push(efrom, me);
                            ints_push(eto, g);
                            ints_push(eat, at);
                            ints_push(eend, to);
                        } else {
                            // Another module's undeclared function: every effect the bridge
                            // covers, and `foreign` if it can be handed the authority for it.
                            let mut assumed = fx_io() + fx_spawn();
                            let mut p = 0;
                            while p < ints_get(fcount, g) {
                                if fx_carries_foreign(ints_get(fparams, ints_get(ffirst, g) + p), tb) {
                                    assumed = fx_with(assumed, fx_foreign());
                                }
                                p = p + 1;
                            }
                            fx_reasons(sets, why_at, why_to, why_text, me, assumed, at, to,
                                    str_concat(str_concat("calls `", name),
                                    "`, which is in another module and declares no effect set, so `"));
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    // Then rounds, each reading the previous round's sets only.
    let mut changed = true;
    while changed {
        changed = false;
        let before = ints_new();
        f = 0;
        while f < nf { ints_push(before, ints_get(sets, f)); f = f + 1; }
        let mut e = 0;
        while e < ints_len(efrom) {
            let me = ints_get(efrom, e);
            let g = ints_get(eto, e);
            let theirs = ints_get(before, g);
            let mut bit = 1;
            while bit <= 4 {
                if fx_has(theirs, bit) {
                    if fx_has(ints_get(sets, me), bit) == false {
                        fx_reason(sets, why_at, why_to, why_text, me, bit,
                                ints_get(eat, e), ints_get(eend, e),
                                str_concat(str_concat(str_concat("calls `", strs_get(fnames, g)),
                                "`, which requires `"), str_concat(fx_name(bit), "`")));
                        changed = true;
                    }
                }
                bit = bit * 2;
            }
            e = e + 1;
        }
    }
    // Every closure's body against its declared set, `! {}` unwritten (N102).
    check_closure_effects(nk, nst, ntx, naux, ncallee, nrec, cowner, owner, sets, declared,
            fowner, ffirst, fcount, fparams, fnames, tb, diags);
    // Every declared set against what its body requires.
    f = 0;
    while f < nf {
        let d = ints_get(declared, f);
        let mut checked = d >= 0;
        if ints_get(fforeign, f) == 1 { checked = false; }
        if checked {
            let set = ints_get(sets, f);
            let mut missing = 0;
            let mut bit = 1;
            let mut first = 0;
            while bit <= 4 {
                if fx_has(set, bit) {
                    if fx_has(d, bit) == false {
                        missing = missing + bit;
                        if first == 0 { first = bit; }
                    }
                }
                bit = bit * 2;
            }
            if missing != 0 {
                let mut listed = "";
                bit = 1;
                while bit <= 4 {
                    if fx_has(missing, bit) {
                        if listed != "" { listed = str_concat(listed, " and "); }
                        listed = str_concat(listed, str_concat(str_concat("`", fx_name(bit)), "`"));
                    }
                    bit = bit * 2;
                }
                let slot = f * 3 + fx_slot(first);
                report(diags, "N0366", ints_get(why_at, slot), ints_get(why_to, slot),
                        str_concat(str_concat(str_concat(str_concat("`", shown_name(strs_get(fnames, f))),
                        "` declares `! "), str_concat(fx_text(d), "`, but its body requires ")),
                        str_concat(listed, str_concat(": ", strs_get(why_text, slot)))));
            }
        }
        f = f + 1;
    }
    nf
}

fn fx_slot(bit: Int) -> Int {
    if bit == fx_io() { return 0; }
    if bit == fx_spawn() { return 1; }
    2
}

// Add one effect to a definition's set with its reason, if the set lacks it.
fn fx_reason(sets: Ints, why_at: Ints, why_to: Ints, why_text: Strs, me: Int, bit: Int,
        at: Int, to: Int, text: Str) -> Int {
    if fx_has(ints_get(sets, me), bit) { return 0; }
    ints_set(sets, me, ints_get(sets, me) + bit);
    let slot = me * 3 + fx_slot(bit);
    ints_set(why_at, slot, at);
    ints_set(why_to, slot, to);
    strs_set(why_text, slot, text);
    1
}

// Every effect of `set`, each with the same reason, its effect named at the end.
fn fx_reasons(sets: Ints, why_at: Ints, why_to: Ints, why_text: Strs, me: Int, set: Int,
        at: Int, to: Int, lead: Str) -> Int {
    let mut bit = 1;
    while bit <= 4 {
        if fx_has(set, bit) {
            fx_reason(sets, why_at, why_to, why_text, me, bit, at, to,
                    str_concat(lead, str_concat(fx_name(bit), "`")));
        }
        bit = bit * 2;
    }
    0
}

// The decimal offset the parser wrote after a name.
fn fx_number(s: Str) -> Int {
    let mut n = 0;
    let mut i = 0;
    while i < str_len(s) {
        n = n * 10 + (str_byte(s, i) - 48);
        i = i + 1;
    }
    n
}

// --- a function's children, N102 ------------------------------------------------------
//
// Its parameters, its `requires` clauses, its body, then its `ensures` clauses: the order
// they are evaluated in. These two say where the parameters end and which child is the body,
// so nothing else has to count.
pub fn fn_param_count(nk: Ints, kids: Ints, first: Int, arity: Int) -> Int {
    let mut p = 0;
    while p < arity {
        if ints_get(nk, ints_get(kids, first + p)) != n_param() { return p; }
        p = p + 1;
    }
    p
}

pub fn fn_body_of(nk: Ints, kids: Ints, first: Int, arity: Int) -> Int {
    let mut c = 0;
    while c < arity {
        let child = ints_get(kids, first + c);
        let ck = ints_get(nk, child);
        if ck != n_param() {
            if ck != n_contract() { return child; }
        }
        c = c + 1;
    }
    ints_get(kids, first + arity - 1)
}

// What a contract clause may contain (N102, the reference's `impure_clause`): literals,
// names, operators, field reads and calls of pure functions — ones declaring `! {}` that are
// not foreign, and the built-ins that only read. The first thing that is not, left to right,
// is `N0614`.
fn pure_builtin(name: Str) -> Bool {
    if name == "str_len" { return true; }
    if name == "str_byte" { return true; }
    if name == "ints_len" { return true; }
    if name == "ints_get" { return true; }
    if name == "strs_len" { return true; }
    if name == "vec_len" { return true; }
    if name == "vec_get" { return true; }
    false
}

pub fn check_contract_shapes(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        ncallee: Ints, kids: Ints, kid_first: Ints, fnode: Ints, fforeign: Ints, tb: Table,
        diags: Vec[Diag]) -> Int {
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_contract() {
            let work = ints_new();
            ints_push(work, ints_get(kids, ints_get(kid_first, k)));
            let mut found = false;
            while ints_len(work) > 0 {
                let e = ints_pop(work);
                let ek = ints_get(nk, e);
                let mut what = "";
                let mut at = ints_get(nst, e);
                let mut to = ints_get(nen, e);
                let mut descend = true;
                if ek == n_call() {
                    let name = before_bracket(strs_get(ntx, e));
                    let g = ints_get(ncallee, e);
                    let mut pure = false;
                    if g == 0 - 2 { pure = pure_builtin(name); }
                    if g >= 0 {
                        if ints_get(fforeign, g) == 0 {
                            let mut d = fx_declared(fn_effects(strs_get(ntx, ints_get(fnode, g))), vec_new[Diag]());
                            if g < ints_len(tb.fdecl) {
                                if ints_get(tb.fdecl, g) != 0 - 2 { d = ints_get(tb.fdecl, g); }
                            }
                            if d == 0 { pure = true; }
                        }
                    }
                    if pure == false {
                        what = "call a function that is not pure";
                        to = at + str_len(name);
                    }
                }
                if ek == n_method() {
                    let code = ints_get(ncallee, e);
                    let mut pure = false;
                    if code <= 0 - 10 {
                        if ints_get(tb.seff, 0 - 10 - code) == 0 { pure = true; }
                    }
                    if pure == false {
                        what = "call a function that is not pure";
                        at = ints_get(naux, e);
                        to = at + str_len(strs_get(ntx, e));
                    }
                }
                if ek == n_construct() { what = "build a value"; }
                if ek == n_makevariant() { what = "build a value"; }
                if ek == n_if() { what = "branch; write the condition with `&&` and `||`"; }
                if ek == n_match() { what = "branch; write the condition with `&&` and `||`"; }
                if ek == n_blockexpr() { what = "contain a block"; }
                if ek == n_propagate() { what = "propagate a failure"; }
                if what != "" {
                    if found == false {
                        report(diags, "N0614", at, to,
                                str_concat("a contract clause cannot ", what));
                    }
                    found = true;
                    descend = false;
                }
                if descend {
                    let mut c = ints_get(nar, e) - 1;
                    while c >= 0 {
                        ints_push(work, ints_get(kids, ints_get(kid_first, e) + c));
                        c = c - 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    0
}

// --- traits and impls, N102 -------------------------------------------------------------
//
// The reference's N78 (`docs/spec.md`, *Traits and methods*): a trait is a list of
// signatures whose first parameter is `self: Self`; an impl gives one type every method, each
// with the trait's signature, `Self` replaced and effects included; a method call is resolved
// here to exactly one definition — on a concrete type to the impl's, through a bound to the
// impl of the type the generic function is instantiated at, which the emitter settles per
// instance. A trait is never a type, and a method is in no function namespace.

// The text before `@`: `Area` from `Area@10`.
fn word_of(s: Str) -> Str {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 64 { return str_slice(s, 0, i); }
        i = i + 1;
    }
    s
}

// The offset after `@`: `10` from `Area@10`.
fn offset_of(s: Str) -> Int {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == 64 { return fx_number(str_slice(s, i + 1, str_len(s))); }
        i = i + 1;
    }
    0
}

// A method's own name, from its definition's: `area` from `#Area.Sq.area`.
pub fn shown_name(name: Str) -> Str {
    if str_len(name) == 0 { return name; }
    if str_byte(name, 0) != 35 { return name; }
    let mut i = str_len(name) - 1;
    while i > 0 {
        if str_byte(name, i) == 46 { return str_slice(name, i + 1, str_len(name)); }
        i = i - 1;
    }
    name
}

// A trait of any module by name, for a requirement and for "this is a trait, not a type".
pub fn trait_named(tb: Table, name: Str) -> Int {
    let mut t = 0;
    while t < strs_len(tb.trn) {
        if strs_get(tb.trn, t) == name { return t; }
        t = t + 1;
    }
    0 - 1
}

// The trait `name` as module `here` sees it: its own, or one a module it imports directly
// exports.
fn trait_visible(tb: Table, here: Int, name: Str, mfirst: Ints, mcount: Ints, mto: Ints) -> Int {
    let mut t = 0;
    while t < strs_len(tb.trn) {
        if strs_get(tb.trn, t) == name {
            if ints_get(tb.tro, t) == here { return t; }
        }
        t = t + 1;
    }
    // What a module it imports offers: its own `pub` traits and those it re-exports (N103).
    let mut e = 0;
    while e < ints_get(mcount, here) {
        let x = offered(tb.toffer, ints_get(mto, ints_get(mfirst, here) + e), name);
        if x >= 0 { return x; }
        e = e + 1;
    }
    0 - 1
}

fn trait_in_scope(tb: Table, here: Int, t: Int, mfirst: Ints, mcount: Ints, mto: Ints) -> Bool {
    if ints_get(tb.tro, t) == here { return true; }
    let mut i = 0;
    while i < ints_len(tb.toffer.om) {
        if ints_get(tb.toffer.ox, i) == t {
            if imports_directly(mfirst, mcount, mto, here, ints_get(tb.toffer.om, i)) { return true; }
        }
        i = i + 1;
    }
    false
}

// The signature of trait `t` named `m`, or `-1`.
fn sig_of(tb: Table, t: Int, m: Str) -> Int {
    let mut s = 0;
    while s < ints_len(tb.strait) {
        if ints_get(tb.strait, s) == t {
            if strs_get(tb.sname, s) == m { return s; }
        }
        s = s + 1;
    }
    0 - 1
}

// The impl of trait `t` for type `ty` that module `here` can use — in it, or in a module it
// imports directly — or `-1`.
pub fn impl_for(tb: Table, t: Int, ty: Int, here: Int, mfirst: Ints, mcount: Ints, mto: Ints) -> Int {
    let mut i = 0;
    while i < ints_len(tb.itrait) {
        if ints_get(tb.itrait, i) == t {
            if ints_get(tb.itype, i) == ty {
                let m = ints_get(tb.imod, i);
                if m == here { return i; }
                if here < 0 { return i; }
                if impl_usable(tb, here, m, mfirst, mcount, mto) { return i; }
            }
        }
        i = i + 1;
    }
    0 - 1
}

// Whether module `here` may use an impl declared in `m` (N78, N103): `m` is a module it
// imports directly, or one those re-export from, however far.
fn impl_usable(tb: Table, here: Int, m: Int, mfirst: Ints, mcount: Ints, mto: Ints) -> Bool {
    let work = ints_new();
    let seen = ints_new();
    let mut e = 0;
    while e < ints_get(mcount, here) {
        ints_push(work, ints_get(mto, ints_get(mfirst, here) + e));
        e = e + 1;
    }
    while ints_len(work) > 0 {
        let x = ints_pop(work);
        if x == m { return true; }
        if contains(seen, x) == false {
            ints_push(seen, x);
            let mut i = 0;
            while i < ints_len(tb.rsm) {
                if ints_get(tb.rsm, i) == x { ints_push(work, ints_get(tb.rsf, i)); }
                i = i + 1;
            }
        }
    }
    false
}

// The definition implementing signature `s` for type `ty`, from any module: what an instance
// calls through a bound (the checker has already required the impl where the call is).
pub fn method_for(tb: Table, s: Int, ty: Int) -> Int {
    let t = ints_get(tb.strait, s);
    let i = impl_for(tb, t, ty, 0 - 1, ints_new(), ints_new(), ints_new());
    if i < 0 { return 0 - 1; }
    // The signature's position among its trait's.
    let mut pos = 0;
    let mut x = 0;
    while x < s {
        if ints_get(tb.strait, x) == t { pos = pos + 1; }
        x = x + 1;
    }
    ints_get(tb.imeth, ints_get(tb.ifirst, i) + pos)
}

// Every trait and its signatures, before any function's: a bound names a trait.
pub fn collect_traits(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        kids: Ints, kid_first: Ints, mstart: Ints, tb: Table,
        tmod: Ints, tname: Strs, trec: Ints, diags: Vec[Diag]) -> Int {
    let sp = new_entry(tb, "Self", 0 - 1, 0, 0, 0 - 1, rk_param(), 0 - 1);
    ints_push(tb.selfp, sp);
    let tscope = ints_new();
    ints_push(tscope, t_param(sp));
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_trait() {
            let t = strs_len(tb.trn);
            let owner = module_at(mstart, ints_get(nst, k));
            strs_push(tb.trn, strs_get(ntx, k));
            ints_push(tb.tro, owner);
            ints_push(tb.trp, is_public(naux, k));
            ints_push(tb.trnode, k);
            let mut c = 0;
            while c < ints_get(nar, k) {
                let sig = ints_get(kids, ints_get(kid_first, k) + c);
                let stext = strs_get(ntx, sig);
                let sname = before_colon(stext);
                ints_push(tb.strait, t);
                strs_push(tb.sname, sname);
                ints_push(tb.snode, sig);
                ints_push(tb.sfirst, ints_len(tb.sparams));
                ints_push(tb.scount, ints_get(nar, sig));
                let mut p = 0;
                while p < ints_get(nar, sig) {
                    let pc = ints_get(kids, ints_get(kid_first, sig) + p);
                    let ptext = strs_get(ntx, pc);
                    if p == 0 {
                        let mut good = before_colon(ptext) == "self";
                        if word_of(after_colon(ptext)) != "Self" { good = false; }
                        if good == false {
                            report(diags, "N0609", ints_get(nst, pc), ints_get(nen, pc),
                                    str_concat(str_concat("`", sname),
                                    "`'s first parameter must be `self: Self`"));
                        }
                    }
                    ints_push(tb.sparams, resolve_written(tb, after_colon(ptext), owner, tscope,
                            ints_get(nst, pc), ints_get(nen, pc), tmod, tname, trec, diags));
                    p = p + 1;
                }
                if ints_get(nar, sig) == 0 {
                    let at = name_offset(naux, sig);
                    report(diags, "N0609", at, at + str_len(sname),
                            str_concat(str_concat("`", sname),
                            "`'s first parameter must be `self: Self`"));
                }
                ints_push(tb.sret, resolve_written(tb, fn_ret(stext), owner, tscope,
                        ints_get(nst, sig), ints_get(nen, sig), tmod, tname, trec, diags));
                ints_push(tb.seff, fx_declared(fn_effects(stext), diags));
                c = c + 1;
            }
        }
        k = k + 1;
    }
    strs_len(tb.trn)
}

// A signature as a message writes it: `fn area(self: Sq) -> Int`.
fn sig_text(tb: Table, s: Int, ty: Int) -> Str {
    let params = ints_new();
    ints_push(params, t_param(ints_get(tb.selfp, 0)));
    let args = ints_new();
    ints_push(args, ty);
    let node = ints_get(tb.snode, s);
    let mut out = str_concat(str_concat("fn ", strs_get(tb.sname, s)), "(");
    let mut p = 0;
    while p < ints_get(tb.scount, s) {
        if p > 0 { out = str_concat(out, ", "); }
        let pt = substitute(tb, ints_get(tb.sparams, ints_get(tb.sfirst, s) + p), params, args);
        let pname = if p == 0 { "self" } else { str_concat("p", int_to_str(p)) };
        out = str_concat(str_concat(str_concat(out, pname), ": "), show_type(pt, tb.names));
        p = p + 1;
    }
    let rt = substitute(tb, ints_get(tb.sret, s), params, args);
    if node < 0 { return out; }
    str_concat(str_concat(out, ") -> "), show_type(rt, tb.names))
}

// Every impl, after every signature: its trait in scope, its type one that may have one,
// one impl per trait and type, in the trait's module or the type's, and every method the
// trait's, with the trait's signature.
pub fn check_impls(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        kids: Ints, kid_first: Ints, mstart: Ints, mfirst: Ints, mcount: Ints, mto: Ints,
        fnames: Strs, fnode: Ints, ffirst: Ints, fcount: Ints, fparams: Ints, fret: Ints,
        tb: Table, tmod: Ints, tname: Strs, trec: Ints, diags: Vec[Diag]) -> Int {
    while ints_len(tb.fdecl) < strs_len(fnames) { ints_push(tb.fdecl, 0 - 2); }
    let mut k = 0;
    while k < ints_len(nk) {
        if ints_get(nk, k) == n_impl() {
            let here = module_at(mstart, ints_get(nst, k));
            let text = strs_get(ntx, k);
            let tword = before_colon(text);
            let yword = after_colon(text);
            let tn = word_of(tword);
            let tat = offset_of(tword);
            let yn = word_of(yword);
            let yat = offset_of(yword);
            let start = ints_get(nst, k);
            let t = trait_visible(tb, here, tn, mfirst, mcount, mto);
            let mut ok = true;
            if t < 0 {
                report(diags, "N0305", tat, tat + str_len(tn),
                        str_concat(str_concat("no trait named `", tn), "` is in scope"));
                ok = false;
            }
            let ty = type_in(yn, here, tb.names, tb.owner, tmod, tname, trec);
            if ok {
                if ty == t_unknown() {
                    report(diags, "N0305", yat, yat + str_len(yn),
                            str_concat(str_concat("`", yn), "` is not a type"));
                    ok = false;
                }
            }
            if ok {
                let mut allowed = false;
                if ty == t_int() { allowed = true; }
                if ty == t_bool() { allowed = true; }
                if ty == t_str() { allowed = true; }
                if is_record(ty) {
                    if generic_count(tb, record_of(ty)) == 0 { allowed = true; }
                }
                if allowed == false {
                    report(diags, "N0604", yat, yat + str_len(yn),
                            str_concat(str_concat("`", yn),
                            "` cannot have an impl: it is a built-in type other than `Int`, `Bool` or `Str`"));
                    ok = false;
                }
            }
            if ok {
                // Coherence: one impl per trait and type in a compilation, in the trait's
                // module or the type's — and for a built-in type, the trait's.
                if impl_for(tb, t, ty, 0 - 1, mfirst, mcount, mto) >= 0 {
                    report(diags, "N0600", start, start + 4,
                            str_concat(str_concat(str_concat(str_concat("`", yn),
                            "` already implements `"), tn), "`"));
                    ok = false;
                }
            }
            if ok {
                let mut home = ints_get(tb.tro, t) == here;
                if is_record(ty) {
                    if ints_get(tb.owner, record_of(ty)) == here { home = true; }
                }
                if home == false {
                    report(diags, "N0601", start, start + 4,
                            str_concat(str_concat(str_concat(str_concat("an impl of `", tn),
                            "` for `"), yn), "` belongs in the module that declares the trait or the type"));
                    ok = false;
                }
            }
            if ok {
                let first = ints_len(tb.imeth);
                ints_push(tb.itrait, t);
                ints_push(tb.itype, ty);
                ints_push(tb.imod, here);
                ints_push(tb.inode, k);
                ints_push(tb.ifirst, first);
                let mut s = 0;
                while s < ints_len(tb.strait) {
                    if ints_get(tb.strait, s) == t { ints_push(tb.imeth, 0 - 1); }
                    s = s + 1;
                }
                let sp = ints_new();
                ints_push(sp, t_param(ints_get(tb.selfp, 0)));
                let sa = ints_new();
                ints_push(sa, ty);
                let mut c = 0;
                while c < ints_get(nar, k) {
                    let mnode = ints_get(kids, ints_get(kid_first, k) + c);
                    let mtext = strs_get(ntx, mnode);
                    let m = shown_name(fn_name(mtext));
                    let mat = name_offset(naux, mnode);
                    let s = sig_of(tb, t, m);
                    if s < 0 {
                        report(diags, "N0603", mat, mat + str_len(m),
                                str_concat(str_concat(str_concat(str_concat("`", m),
                                "` is not a method of `"), tn), "`"));
                    } else {
                        // The definition this node is.
                        let mut g = 0 - 1;
                        let mut d = 0;
                        while d < ints_len(fnode) {
                            if ints_get(fnode, d) == mnode { g = d; }
                            d = d + 1;
                        }
                        let mut same = g >= 0;
                        if same {
                            if ints_get(fcount, g) != ints_get(tb.scount, s) { same = false; }
                        }
                        if same {
                            let mut p = 0;
                            while p < ints_get(fcount, g) {
                                let want = substitute(tb, ints_get(tb.sparams, ints_get(tb.sfirst, s) + p), sp, sa);
                                if ints_get(fparams, ints_get(ffirst, g) + p) != want { same = false; }
                                p = p + 1;
                            }
                            if substitute(tb, ints_get(tb.sret, s), sp, sa) != ints_get(fret, g) { same = false; }
                            // The first parameter is named `self`.
                            let p0 = ints_get(kids, ints_get(kid_first, mnode));
                            if ints_get(nk, p0) == n_param() {
                                if before_colon(strs_get(ntx, p0)) != "self" { same = false; }
                            }
                        }
                        // Effects: a method that writes none has its trait's.
                        let written = fx_declared(fn_effects(mtext), vec_new[Diag]());
                        let mut eff = written;
                        if fn_effects(mtext) == "" { eff = ints_get(tb.seff, s); }
                        if eff != ints_get(tb.seff, s) { same = false; }
                        if same {
                            ints_set(tb.imeth, first + sig_position(tb, s), g);
                            if fn_effects(mtext) == "" { ints_set(tb.fdecl, g, ints_get(tb.seff, s)); }
                        } else {
                            report(diags, "N0603", mat, mat + str_len(m),
                                    str_concat(str_concat(str_concat(str_concat("`", m), "` must be `"),
                                    sig_text(tb, s, ty)), str_concat(str_concat(str_concat(
                                    "` with the trait's effects, as `", tn), "` declares it with `Self` = `"),
                                    str_concat(yn, "`"))));
                        }
                    }
                    c = c + 1;
                }
                // What the trait declares and the impl does not define.
                let mut s2 = 0;
                let mut pos = 0;
                while s2 < ints_len(tb.strait) {
                    if ints_get(tb.strait, s2) == t {
                        if ints_get(tb.imeth, first + pos) < 0 {
                            report(diags, "N0602", start, start + 4,
                                    str_concat(str_concat(str_concat(str_concat(str_concat(
                                    "this impl of `", tn), "` for `"), yn), "` does not define `"),
                                    str_concat(strs_get(tb.sname, s2), "`")));
                        }
                        pos = pos + 1;
                    }
                    s2 = s2 + 1;
                }
            }
        }
        k = k + 1;
    }
    0
}

// A signature's position among its trait's.
fn sig_position(tb: Table, s: Int) -> Int {
    let t = ints_get(tb.strait, s);
    let mut pos = 0;
    let mut x = 0;
    while x < s {
        if ints_get(tb.strait, x) == t { pos = pos + 1; }
        x = x + 1;
    }
    pos
}

// What a bound gives a type parameter: its trait, or `-1`.
pub fn bound_trait(tb: Table, t: Int) -> Int {
    if is_param(t) == false { return 0 - 1; }
    let r = ints_get(tb.req, entry_of(t));
    if r >= 2 { return r - 2; }
    0 - 1
}

// The type an impl's method's `Self` is: its impl's, found as the impl node the method is a
// child of; `0` for a function no impl holds.
fn method_self_type(nk: Ints, nar: Ints, ntx: Strs, kids: Ints, kid_first: Ints, k: Int,
        owner: Int, tb: Table, tmod: Ints, tname: Strs, trec: Ints) -> Int {
    let mut i = k + 1;
    while i < ints_len(nk) {
        if ints_get(nk, i) == n_impl() {
            let mut c = 0;
            while c < ints_get(nar, i) {
                if ints_get(kids, ints_get(kid_first, i) + c) == k {
                    return type_in(word_of(after_colon(strs_get(ntx, i))), owner, tb.names,
                            tb.owner, tmod, tname, trec);
                }
                c = c + 1;
            }
            return 0;
        }
        i = i + 1;
    }
    0
}

// Resolve method `m` on a receiver of type `recv` in module `here` (N102): the signature, with
// `out[0]` 1 for a call through a bound and `out[1]` the definition a concrete call calls. `fixed`
// is the trait a `Trait.m(x)` names, or `-1`. `-1` when nothing resolves, reported.
fn resolve_method(tb: Table, here: Int, recv: Int, m: Str, fixed: Int, at: Int, to: Int,
        mfirst: Ints, mcount: Ints, mto: Ints, out: Ints, diags: Vec[Diag]) -> Int {
    ints_set(out, 0, 0);
    ints_set(out, 1, 0 - 1);
    if recv == t_unknown() { return 0 - 1; }
    let shown = show_type(recv, tb.names);
    if is_param(recv) {
        let bt = bound_trait(tb, recv);
        let mut t = bt;
        if fixed >= 0 {
            if fixed != bt { t = 0 - 1; }
        }
        let mut s = 0 - 1;
        if t >= 0 { s = sig_of(tb, t, m); }
        if s < 0 {
            report(diags, "N0605", at, to,
                    str_concat(str_concat(str_concat(str_concat("`", shown), "` has no method `"), m), "`"));
            return 0 - 1;
        }
        ints_set(out, 0, 1);
        return s;
    }
    if fixed >= 0 {
        let s = sig_of(tb, fixed, m);
        let i = impl_for(tb, fixed, recv, here, mfirst, mcount, mto);
        if s < 0 {
            report(diags, "N0605", at, to,
                    str_concat(str_concat(str_concat(str_concat("`", strs_get(tb.trn, fixed)),
                    "` has no method `"), m), "`"));
            return 0 - 1;
        }
        if i < 0 {
            report(diags, "N0605", at, to,
                    str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("`", shown),
                    "` has no impl of `"), strs_get(tb.trn, fixed)), "` giving it `"), m), "`"));
            return 0 - 1;
        }
        ints_set(out, 1, ints_get(tb.imeth, ints_get(tb.ifirst, i) + sig_position(tb, s)));
        return s;
    }
    // The traits in scope that declare `m` and have an impl for the receiver's type here.
    let found = ints_new();
    let mut t = 0;
    while t < strs_len(tb.trn) {
        if trait_in_scope(tb, here, t, mfirst, mcount, mto) {
            if sig_of(tb, t, m) >= 0 {
                if impl_for(tb, t, recv, here, mfirst, mcount, mto) >= 0 { ints_push(found, t); }
            }
        }
        t = t + 1;
    }
    if ints_len(found) == 0 {
        report(diags, "N0605", at, to,
                str_concat(str_concat(str_concat(str_concat("no trait in scope gives `", shown),
                "` a method `"), m), "`"));
        return 0 - 1;
    }
    if ints_len(found) > 1 {
        let mut listed = "";
        let mut f = 0;
        while f < ints_len(found) {
            if f > 0 {
                if f == ints_len(found) - 1 { listed = str_concat(listed, " and "); } else { listed = str_concat(listed, ", "); }
            }
            listed = str_concat(str_concat(str_concat(listed, "`"), strs_get(tb.trn, ints_get(found, f))), "`");
            f = f + 1;
        }
        report(diags, "N0606", at, to,
                str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("`", m), "` on `"),
                shown), "` is a method of "), listed), ""));
        return 0 - 1;
    }
    let tt = ints_get(found, 0);
    let s = sig_of(tb, tt, m);
    let i = impl_for(tb, tt, recv, here, mfirst, mcount, mto);
    ints_set(out, 1, ints_get(tb.imeth, ints_get(tb.ifirst, i) + sig_position(tb, s)));
    s
}

// A method call's arguments against its signature, `Self` the receiver's type, and its
// result. `got` holds the receiver's type then each argument's; `argn` the argument nodes.
fn check_method_args(tb: Table, s: Int, recv: Int, m: Str, got: Ints, argn: Ints,
        nst: Ints, nen: Ints, at: Int, to: Int, diags: Vec[Diag]) -> Int {
    let sp = ints_new();
    ints_push(sp, t_param(ints_get(tb.selfp, 0)));
    let sa = ints_new();
    ints_push(sa, recv);
    let ret = substitute(tb, ints_get(tb.sret, s), sp, sa);
    if ints_len(got) != ints_get(tb.scount, s) {
        report(diags, "N0303", at, to,
                str_concat(str_concat("`", m), "` was given the wrong number of arguments"));
        return ret;
    }
    let mut a = 1;
    while a < ints_len(got) {
        let want = substitute(tb, ints_get(tb.sparams, ints_get(tb.sfirst, s) + a), sp, sa);
        let actual = ints_get(got, a);
        if agrees(actual, want) == false {
            let arg = ints_get(argn, a);
            report(diags, "N0300", ints_get(nst, arg), ints_get(nen, arg),
                    str_concat(str_concat(str_concat(str_concat(str_concat(
                    "argument ", int_to_str(a)), str_concat(" of `", m)), "` is `"),
                    str_concat(show_type(want, tb.names), "`, but this is `")),
                    str_concat(show_type(actual, tb.names), "`")));
        }
        a = a + 1;
    }
    ret
}

// Where byte `b` first is in `s`, or its length.
fn index_of_byte(s: Str, b: Int) -> Int {
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == b { return i; }
        i = i + 1;
    }
    str_len(s)
}

// The slot a binding is read from where it is named (N102): its own, outside any closure; in
// a closure, the closure's copy — made now if this is the first use, through every closure
// between the binding and here, each copying from the one around it. A `let mut` binding is
// never copied (`N0386`): a copy of a variable would be a second variable.
fn closure_binding(names: Strs, ntypes: Ints, nmut: Ints, nslotof: Ints, cl_node: Ints,
        cl_base: Ints, cl_counter: Ints, counter: Ints, cap_clo: Ints, cap_name: Strs, cap_outer: Ints,
        cap_inner: Ints, cap_type: Ints, name: Str, at: Int, to: Int, diags: Vec[Diag], tb: Table) -> Int {
    let mut i = strs_len(names) - 1;
    while i >= 0 {
        if strs_get(names, i) == name { break; }
        i = i - 1;
    }
    if i < 0 { return 0 - 1; }
    let mut slot = ints_get(nslotof, i);
    let depth = ints_len(cl_node);
    if depth == 0 { return slot; }
    if i >= ints_get(cl_base, depth - 1) { return slot; }
    if ints_get(nmut, i) == 1 {
        report(diags, "N0386", at, to,
                str_concat(str_concat("a closure cannot capture `", name), "`, a `let mut` binding"));
        return slot;
    }
    // The outermost closure the binding is outside of.
    let mut level = depth - 1;
    while level > 0 {
        if i < ints_get(cl_base, level - 1) { level = level - 1; } else { break; }
    }
    let outermost = level;
    while level < depth {
        let c = ints_get(cl_node, level);
        let mut found = 0 - 1;
        let mut q = 0;
        while q < ints_len(cap_clo) {
            if ints_get(cap_clo, q) == c {
                if strs_get(cap_name, q) == name { found = ints_get(cap_inner, q); }
            }
            q = q + 1;
        }
        if found < 0 {
            // Gate 1-C1: a closure owns what it captures, so capturing a value that can hold a
            // function value behind a handle is the one way it could come to own itself
            // (`N0616`). Decided by the type, at the first capture.
            if level == outermost {
                if holds_functions(tb, ints_get(ntypes, i)) {
                    report(diags, "N0616", at, to,
                            str_concat(str_concat("a closure cannot capture `", name),
                            "`: its type can hold function values"));
                }
            }
            // The closure's own slots are numbered by its counter, which for any but the
            // innermost is the one set aside when the next closure opened.
            let mut inner = 0;
            if level == depth - 1 {
                inner = ints_get(counter, 0);
                ints_set(counter, 0, inner + 1);
            } else {
                inner = ints_get(cl_counter, level + 1);
                ints_set(cl_counter, level + 1, inner + 1);
            }
            ints_push(cap_clo, c);
            strs_push(cap_name, name);
            ints_push(cap_outer, slot);
            ints_push(cap_inner, inner);
            ints_push(cap_type, ints_get(ntypes, i));
            found = inner;
        }
        slot = found;
        level = level + 1;
    }
    slot
}

// Whether a value of type `t` can hold a function value behind a `Vec`'s handle (Gate 1-C1):
// `crates/nazm-sema/src/udt.rs`'s `function_holder`, transcribed. A `Vec` element that is a
// function type, or reaches one through record and enum fields or further `Vec`s, anywhere in
// `t`. Each (type, behind a handle) pair is visited once, so a cycle being refused cannot loop.
fn holds_functions(tb: Table, t: Int) -> Bool {
    let work = ints_new();
    let under = ints_new();
    let seen = ints_new();
    ints_push(work, t);
    ints_push(under, 0);
    while ints_len(work) > 0 {
        let ty = ints_pop(work);
        let u = ints_pop(under);
        let key = ty * 2 + u;
        let mut known = false;
        let mut q = 0;
        while q < ints_len(seen) {
            if ints_get(seen, q) == key { known = true; }
            q = q + 1;
        }
        if known == false {
            ints_push(seen, key);
            if is_fn(ty) {
                if u == 1 { return true; }
            } else {
                if is_vec(ty) {
                    ints_push(work, ints_get(tb.args, ints_get(tb.afirst, entry_of(ty))));
                    ints_push(under, 1);
                } else {
                    if is_record(ty) {
                        let held = contained(tb, record_of(ty));
                        let mut f = 0;
                        while f < ints_len(held) {
                            ints_push(work, ints_get(held, f));
                            ints_push(under, u);
                            f = f + 1;
                        }
                    }
                }
            }
        }
    }
    false
}

// The function `name` names in module `here`: its own definition, or one an import brought.
fn visible_function(name: Str, here: Int, fnames: Strs, fowner: Ints, vmod: Ints, vname: Strs,
        vfn: Ints) -> Int {
    let own = owned_index(fnames, fowner, here, name);
    if own >= 0 { return own; }
    let mut i = 0;
    while i < ints_len(vmod) {
        if ints_get(vmod, i) == here {
            if strs_get(vname, i) == name { return ints_get(vfn, i); }
        }
        i = i + 1;
    }
    0 - 1
}

fn is_foreign_def(nk: Ints, nar: Ints, kids: Ints, kid_first: Ints, fnode: Ints, g: Int) -> Bool {
    let node = ints_get(fnode, g);
    let body = fn_body_of(nk, kids, ints_get(kid_first, node), ints_get(nar, node));
    ints_get(nk, body) == n_foreign()
}

// The effects a named function's value type carries (N50): its declared set, or for an
// undeclared function of this module none — its body is held to that — and of another module
// every effect the bridge covers.
fn value_effects(tb: Table, ntx: Strs, fnode: Ints, fowner: Ints, fparams: Ints, ffirst: Ints,
        fcount: Ints, g: Int, here: Int) -> Int {
    let mut d = fx_declared(fn_effects(strs_get(ntx, ints_get(fnode, g))), vec_new[Diag]());
    if g < ints_len(tb.fdecl) {
        if ints_get(tb.fdecl, g) != 0 - 2 { d = ints_get(tb.fdecl, g); }
    }
    if d >= 0 { return d; }
    if ints_get(fowner, g) == here { return 0; }
    let mut assumed = fx_io() + fx_spawn();
    let mut p = 0;
    while p < ints_get(fcount, g) {
        if fx_carries_foreign(ints_get(fparams, ints_get(ffirst, g) + p), tb) {
            assumed = fx_with(assumed, fx_foreign());
        }
        p = p + 1;
    }
    assumed
}

// What each closure's body requires, as a declared function's is found — its own calls, a
// local undeclared callee's settled set — against its declared set (N102).
fn check_closure_effects(nk: Ints, nst: Ints, ntx: Strs, naux: Ints, ncallee: Ints, nrec: Ints,
        cowner: Ints, owner: Ints, sets: Ints, declared: Ints, fowner: Ints, ffirst: Ints,
        fcount: Ints, fparams: Ints, fnames: Strs, tb: Table, diags: Vec[Diag]) -> Int {
    let mut c = 0;
    while c < ints_len(nk) {
        if ints_get(nk, c) == n_closure() {
            let mut want = fx_declared(fn_effects(strs_get(ntx, c)), vec_new[Diag]());
            if want < 0 { want = 0; }
            // The function the closure is written in, for its name and its module.
            let mut f = 0 - 1;
            let mut up = c + 1;
            while up < ints_len(nk) {
                if ints_get(owner, up) >= 0 { f = ints_get(owner, up); up = ints_len(nk); }
                up = up + 1;
            }
            let mut have = 0;
            let mut first_at = 0;
            let mut first_to = 0;
            let mut missing = 0;
            let mut k = 0;
            while k < c {
                if ints_get(cowner, k) == c {
                    let kind = ints_get(nk, k);
                    let mut e = 0;
                    let mut at = ints_get(nst, k);
                    let name = before_bracket(strs_get(ntx, k));
                    if kind == n_spawn() {
                        e = fx_spawn();
                        at = ints_get(naux, k);
                    }
                    if kind == n_call() {
                        let g = ints_get(ncallee, k);
                        if g == 0 - 2 { e = fx_of_builtin(name); }
                        if g == 0 - 3 { e = fn_effect_bits(tb, ints_get(nrec, k)); }
                        if g >= 0 {
                            let d = ints_get(declared, g);
                            if d >= 0 {
                                e = d;
                            } else {
                                if f >= 0 {
                                    if ints_get(fowner, g) == ints_get(fowner, f) {
                                        e = ints_get(sets, g);
                                    } else {
                                        e = fx_io() + fx_spawn();
                                    }
                                }
                            }
                        }
                    }
                    if kind == n_spawn() {
                        let g = ints_get(ncallee, k);
                        if g >= 0 {
                            let d = ints_get(declared, g);
                            if d >= 0 { e = fx_with(e, 0); }
                        }
                    }
                    let mut bit = 1;
                    while bit <= 4 {
                        if fx_has(e, bit) {
                            if fx_has(have, bit) == false {
                                have = have + bit;
                                if fx_has(want, bit) == false {
                                    if missing == 0 {
                                        first_at = at;
                                        first_to = at + str_len(name);
                                    }
                                    missing = fx_with(missing, bit);
                                }
                            }
                        }
                        bit = bit * 2;
                    }
                }
                k = k + 1;
            }
            if missing != 0 {
                let mut listed = "";
                let mut bit = 1;
                while bit <= 4 {
                    if fx_has(missing, bit) {
                        if listed != "" { listed = str_concat(listed, " and "); }
                        listed = str_concat(listed, str_concat(str_concat("`", fx_name(bit)), "`"));
                    }
                    bit = bit * 2;
                }
                let mut where_ = "a function";
                if f >= 0 { where_ = shown_name(strs_get(fnames, f)); }
                report(diags, "N0366", first_at, first_to,
                        str_concat(str_concat(str_concat(str_concat(str_concat("this closure in `",
                        where_), "` declares `! "), fx_text(want)), "`, but its body requires "), listed));
            }
        }
        c = c + 1;
    }
    0
}

// --- re-exports, N103 ------------------------------------------------------------------
//
// `pub use "PATH";` offers every name the module it names offers; `pub use "PATH" { a, b as c
// };` the names chosen, `c` the name `b` is offered under. A re-export is the **same**
// definition under this module's name — the index it is offered by is the defining module's —
// so nothing downstream learns that re-exports exist: an import reads what a module offers,
// and a module offers its own `pub` definitions and what it re-exports.
//
// Read from the tokens, where the parser accepted it and the loader made the edge: the edge is
// the one whose quoted path is at the same offset.

pub struct Reexports {
    // One entry per `pub use`: the module writing it, the module named, where `pub` is, and
    // whether it re-exports everything; its chosen names from `ifirst`, `icount` of them.
    emod: Ints,
    eto: Ints,
    eat: Ints,
    eall: Ints,
    ifirst: Ints,
    icount: Ints,
    // Each chosen name, where it is written, and the name it is offered under with where that
    // is written (the same, without `as`).
    iname: Strs,
    iat: Ints,
    ialias: Strs,
    // Each `pub use` in the order it can be applied — every re-export it reads from before
    // it — and `1` for one in a cycle of re-exports, which has no such order.
    order: Ints,
    cyclic: Ints,
}

// What modules offer of one kind: the module, the name an importer writes, and the index —
// a definition, a table entry or a trait — that name means.
pub struct Offers {
    om: Ints,
    on: Strs,
    ox: Ints,
}

pub fn new_offers() -> Offers { Offers(om: ints_new(), on: strs_new(), ox: ints_new()) }

pub fn offer(o: Offers, m: Int, name: Str, x: Int) -> Int {
    ints_push(o.om, m);
    strs_push(o.on, name);
    ints_push(o.ox, x);
    ints_len(o.om)
}

// What `m` offers under `name`, or `-1`.
pub fn offered(o: Offers, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_len(o.om) {
        if ints_get(o.om, i) == m {
            if strs_get(o.on, i) == name { return ints_get(o.ox, i); }
        }
        i = i + 1;
    }
    0 - 1
}

pub fn collect_reexports(kinds: Ints, starts: Ints, texts: Strs, mstart: Ints, mfirst: Ints,
        mcount: Ints, mto: Ints, mat: Ints, modules: Int) -> Reexports {
    let rx = Reexports(emod: ints_new(), eto: ints_new(), eat: ints_new(), eall: ints_new(),
            ifirst: ints_new(), icount: ints_new(), iname: strs_new(), iat: ints_new(),
            ialias: strs_new(), order: ints_new(), cyclic: ints_new());
    let mut i = 0;
    while i + 2 < ints_len(kinds) {
        let mut at_pub_use = false;
        if ints_get(kinds, i) == k_pub() {
            if ints_get(kinds, i + 1) == k_use() {
                if ints_get(kinds, i + 2) == k_str() { at_pub_use = true; }
            }
        }
        if at_pub_use {
            let pub_at = ints_get(starts, i);
            let path_at = ints_get(starts, i + 2);
            let m = module_at(mstart, pub_at);
            // The edge whose quoted path this is.
            let mut target = 0 - 1;
            let mut e = 0;
            while e < ints_get(mcount, m) {
                if ints_get(mat, ints_get(mfirst, m) + e) == path_at {
                    target = ints_get(mto, ints_get(mfirst, m) + e);
                }
                e = e + 1;
            }
            let mut j = i + 3;
            let mut all = 1;
            ints_push(rx.ifirst, strs_len(rx.iname));
            if ints_get(kinds, j) == k_lbrace() {
                all = 0;
                j = j + 1;
                while ints_get(kinds, j) == k_ident() {
                    let name = strs_get(texts, j);
                    let nat = ints_get(starts, j);
                    let mut alias = name;
                    j = j + 1;
                    if ints_get(kinds, j) == k_ident() {
                        if strs_get(texts, j) == "as" {
                            alias = strs_get(texts, j + 1);
                            j = j + 2;
                        }
                    }
                    strs_push(rx.iname, name);
                    ints_push(rx.iat, nat);
                    strs_push(rx.ialias, alias);
                    if ints_get(kinds, j) == k_comma() { j = j + 1; }
                }
            }
            ints_push(rx.icount, strs_len(rx.iname) - ints_get(rx.ifirst, ints_len(rx.ifirst) - 1));
            if target >= 0 {
                ints_push(rx.emod, m);
                ints_push(rx.eto, target);
                ints_push(rx.eat, pub_at);
                ints_push(rx.eall, all);
            } else {
                // A self-import makes no edge, and re-exports nothing.
                ints_pop(rx.ifirst);
                ints_pop(rx.icount);
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    // An order: a `pub use` is applied once every `pub use` of the module it names has been.
    let n = ints_len(rx.emod);
    let placed = ints_new();
    let mut k = 0;
    while k < n { ints_push(placed, 0); ints_push(rx.cyclic, 0); k = k + 1; }
    let mut moved = true;
    while moved {
        moved = false;
        k = 0;
        while k < n {
            if ints_get(placed, k) == 0 {
                let mut ready = true;
                let mut q = 0;
                while q < n {
                    if ints_get(placed, q) == 0 {
                        if ints_get(rx.emod, q) == ints_get(rx.eto, k) { ready = false; }
                    }
                    q = q + 1;
                }
                if ready {
                    ints_set(placed, k, 1);
                    ints_push(rx.order, k);
                    moved = true;
                }
            }
            k = k + 1;
        }
    }
    k = 0;
    while k < n {
        if ints_get(placed, k) == 0 { ints_set(rx.cyclic, k, 1); }
        k = k + 1;
    }
    rx
}

// Apply the re-exports to one kind's offers: each `pub use`, in order, offering what the
// module it names offers — every name, or the chosen ones under the names given. Collisions
// and names offered by nothing are reported by `check_reexports`, which sees every kind.
pub fn apply_reexports(rx: Reexports, o: Offers) -> Int {
    let mut w = 0;
    while w < ints_len(rx.order) {
        let e = ints_get(rx.order, w);
        let m = ints_get(rx.emod, e);
        let t = ints_get(rx.eto, e);
        if ints_get(rx.eall, e) == 1 {
            let mut i = 0;
            let n = ints_len(o.om);
            while i < n {
                if ints_get(o.om, i) == t {
                    let name = strs_get(o.on, i);
                    if offered(o, m, name) < 0 { offer(o, m, name, ints_get(o.ox, i)); }
                }
                i = i + 1;
            }
        } else {
            let mut c = 0;
            while c < ints_get(rx.icount, e) {
                let it = ints_get(rx.ifirst, e) + c;
                let x = offered(o, t, strs_get(rx.iname, it));
                if x >= 0 {
                    if offered(o, m, strs_get(rx.ialias, it)) < 0 {
                        offer(o, m, strs_get(rx.ialias, it), x);
                    }
                }
                c = c + 1;
            }
        }
        w = w + 1;
    }
    0
}

// The refusals, once every kind is known: a cycle of re-exports (`N0213`, at `pub`), a chosen
// name the module named offers in no kind (`N0211`), and a name offered twice (`N0212`).
pub fn check_reexports(rx: Reexports, fns: Offers, types: Offers, traits: Offers,
        own_fns: Offers, own_types: Offers, own_traits: Offers, diags: Vec[Diag]) -> Int {
    let mut e = 0;
    while e < ints_len(rx.emod) {
        let m = ints_get(rx.emod, e);
        let t = ints_get(rx.eto, e);
        let at = ints_get(rx.eat, e);
        if ints_get(rx.cyclic, e) == 1 {
            report(diags, "N0213", at, at + 3, "this re-export is part of a cycle of re-exports");
        } else {
            if ints_get(rx.eall, e) == 0 {
                let mut c = 0;
                while c < ints_get(rx.icount, e) {
                    let it = ints_get(rx.ifirst, e) + c;
                    let name = strs_get(rx.iname, it);
                    let nat = ints_get(rx.iat, it);
                    let mut found = false;
                    if offered(fns, t, name) >= 0 { found = true; }
                    if offered(types, t, name) >= 0 { found = true; }
                    if offered(traits, t, name) >= 0 { found = true; }
                    if found == false {
                        report(diags, "N0211", nat, nat + str_len(name),
                                str_concat(str_concat("`", name),
                                "` is not exported by the module this re-exports from"));
                    } else {
                        let alias = strs_get(rx.ialias, it);
                        let mut clash = false;
                        if offered(own_fns, m, alias) >= 0 {
                            if offered(fns, t, name) >= 0 { clash = true; }
                        }
                        if offered(own_types, m, alias) >= 0 { clash = true; }
                        if offered(own_traits, m, alias) >= 0 { clash = true; }
                        if clash {
                            report(diags, "N0212", nat, nat + str_len(name),
                                    str_concat(str_concat("`", alias), "` is already offered by this module"));
                        }
                        if alias != name {
                            if offered(traits, t, name) >= 0 {
                                report(diags, "N0211", nat, nat + str_len(name),
                                        str_concat(str_concat("`", name),
                                        "` is a trait, which is re-exported under its own name"));
                            }
                        }
                    }
                    c = c + 1;
                }
            } else {
                // Everything: each name it brings that this module already offers itself.
                let mut i = 0;
                while i < ints_len(fns.om) {
                    if ints_get(fns.om, i) == t {
                        if offered(own_fns, m, strs_get(fns.on, i)) >= 0 {
                            report(diags, "N0212", at, at + 3,
                                    str_concat(str_concat("`", strs_get(fns.on, i)), "` is already offered by this module"));
                        }
                    }
                    i = i + 1;
                }
            }
        }
        e = e + 1;
    }
    0
}

// --- the stages of `check_program`, N102 and N103 ----------------------------------------
//
// Grouped so the entry point reads as its stages: types and traits linked across modules,
// then functions, then bodies. Each is the code `check_program` ran in that place.

pub struct Linked {
    rx: Reexports,
    types: Offers,
    own_types: Offers,
    own_traits: Offers,
}

// Stage 0: what each module offers of types and traits, its own and re-exported (N103), what
// each module's imports bring in, every record's fields and ownership, every trait.
pub fn link_types(kinds: Ints, starts: Ints, texts: Strs, nk: Ints, nar: Ints, nst: Ints,
        nen: Ints, ntx: Strs, naux: Ints, kids: Ints, kid_first: Ints, mpath: Strs,
        mstart: Ints, mfirst: Ints, mcount: Ints, mto: Ints, mat: Ints, core: Int, tb: Table,
        tmod: Ints, tname: Strs, trec: Ints, diags: Vec[Diag]) -> Linked {
    // The `pub use`s (N103), from the tokens and the module graph.
    let rx = collect_reexports(kinds, starts, texts, mstart, mfirst, mcount, mto, mat,
            strs_len(mpath));
    // What each module offers of types: its own `pub` records and enums, then re-exports.
    let own_types = new_offers();
    let types = new_offers();
    let mut ot = 0;
    while ot < strs_len(tb.names) {
        if is_declaration(tb, ot) {
            if ints_get(tb.vis, ot) == 1 {
                let k = ints_get(tb.kind, ot);
                let mut nameable = k == rk_record();
                if k == rk_enum() { nameable = true; }
                if nameable {
                    offer(own_types, ints_get(tb.owner, ot), strs_get(tb.names, ot), ot);
                    offer(types, ints_get(tb.owner, ot), strs_get(tb.names, ot), ot);
                }
            }
        }
        ot = ot + 1;
    }
    apply_reexports(rx, types);
    check_type_imports(mfirst, mcount, mto, mat, strs_len(mpath), core,
            tb.names, tb.owner, tb.vis, tb.at, tmod, tname, trec, types, diags);
    resolve_record_fields(nk, nar, nst, nen, ntx, kids, kid_first, tb,
            tmod, tname, trec, diags);
    check_ownership(tb, diags);
    // Traits before any signature: a bound names one (N102).
    collect_traits(nk, nar, nst, nen, ntx, naux, kids, kid_first, mstart, tb,
            tmod, tname, trec, diags);
    // And of traits.
    let own_traits = new_offers();
    let mut tt = 0;
    while tt < strs_len(tb.trn) {
        if ints_get(tb.trp, tt) == 1 {
            offer(own_traits, ints_get(tb.tro, tt), strs_get(tb.trn, tt), tt);
            offer(tb.toffer, ints_get(tb.tro, tt), strs_get(tb.trn, tt), tt);
        }
        tt = tt + 1;
    }
    apply_reexports(rx, tb.toffer);
    let mut rs = 0;
    while rs < ints_len(rx.emod) {
        ints_push(tb.rsm, ints_get(rx.emod, rs));
        ints_push(tb.rsf, ints_get(rx.eto, rs));
        rs = rs + 1;
    }
    Linked(rx: rx, types: types, own_types: own_types, own_traits: own_traits)
}

// Stage 1, after every signature: what each module's imports bring in of functions, the
// re-exports' refusals, the entry point, and every impl against its trait. Returns `main`.
pub fn link_functions(linked: Linked, nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs,
        naux: Ints, kids: Ints, kid_first: Ints, mpath: Strs, mstart: Ints, mfirst: Ints,
        mcount: Ints, mto: Ints, mat: Ints, fnames: Strs, fret: Ints, ffirst: Ints,
        fcount: Ints, fparams: Ints, fowner: Ints, fpub: Ints, fnode: Ints, vmod: Ints,
        vname: Strs, vfn: Ints, tb: Table, tmod: Ints, tname: Strs, trec: Ints,
        diags: Vec[Diag]) -> Int {
    let rx = linked.rx;
    let types = linked.types;
    let own_types = linked.own_types;
    let own_traits = linked.own_traits;
    // And of functions, an impl's methods being no module's names.
    let own_fns = new_offers();
    let fns = new_offers();
    let mut of = 0;
    while of < strs_len(fnames) {
        if ints_get(fpub, of) == 1 {
            if str_byte(strs_get(fnames, of), 0) != 35 {
                offer(own_fns, ints_get(fowner, of), strs_get(fnames, of), of);
                offer(fns, ints_get(fowner, of), strs_get(fnames, of), of);
            }
        }
        of = of + 1;
    }
    apply_reexports(rx, fns);
    check_reexports(rx, fns, types, tb.toffer, own_fns, own_types, own_traits, diags);
    check_imports(mfirst, mcount, mto, mat, strs_len(mpath), fnames, fowner, fpub,
            vmod, vname, vfn, fns, diags);

    let entry = entry_point(fnames, fowner, ffirst, fcount, fparams, fnode, nar, kids,
            kid_first, nst, nen, diags);
    // Every impl against its trait, once every definition has a signature (N102).
    check_impls(nk, nar, nst, nen, ntx, naux, kids, kid_first, mstart, mfirst, mcount, mto,
            fnames, fnode, ffirst, fcount, fparams, fret, tb, tmod, tname, trec, diags);

    entry
}

// Stage 2: every body, then what the bodies require of effects and contracts (N102).
pub fn check_bodies(nk: Ints, nar: Ints, nst: Ints, nen: Ints, ntx: Strs, naux: Ints,
        nslot: Ints, ntype: Ints, ncallee: Ints, nrec: Ints, kids: Ints, kid_first: Ints,
        mstart: Ints, mfirst: Ints, mcount: Ints, mto: Ints, core: Int,
        fnames: Strs, fret: Ints, ffirst: Ints, fcount: Ints, fparams: Ints,
        fowner: Ints, fpub: Ints, vmod: Ints, vname: Strs, vfn: Ints,
        bnames: Strs, bret: Ints, bfirst: Ints, bcount: Ints, bparams: Ints,
        tb: Table, fgen: Ints, fgc: Ints, bgen: Ints, ntfirst: Ints, ntargs: Ints,
        tmod: Ints, tname: Strs, trec: Ints, fnode: Ints, diags: Vec[Diag]) -> Int {
    check_all(nk, nar, nst, nen, ntx, naux, nslot, ntype, ncallee, nrec,
            kids, kid_first, ints_len(nk) - 1,
            mstart, mfirst, mcount, mto, core,
            fnames, fret, ffirst, fcount, fparams,
            fowner, fpub, vmod, vname, vfn,
            bnames, bret, bfirst, bcount, bparams,
            tb, fgen, fgc, bgen, ntfirst, ntargs,
            tmod, tname, trec, fnode,
            diags);

    // Declared effect sets against what each body requires (N102). A foreign function's
    // contract is `foreign`.
    let fforeign = ints_new();
    let mut ff = 0;
    while ff < strs_len(fnames) {
        let node = ints_get(fnode, ff);
        let body = fn_body_of(nk, kids, ints_get(kid_first, node), ints_get(nar, node));
        if ints_get(nk, body) == n_foreign() { ints_push(fforeign, 1); } else { ints_push(fforeign, 0); }
        ff = ff + 1;
    }
    check_contract_shapes(nk, nar, nst, nen, ntx, naux, ncallee, kids, kid_first, fnode, fforeign,
            tb, diags);
    check_effects(nk, nar, nst, ntx, naux, ncallee, nrec, kids, kid_first, mstart,
            fnames, fnode, fowner, ffirst, fcount, fparams, fforeign, tb, diags);

    0
}
