use "@std/text"
use "@std/hash"
use "@std/hashmap"
use "@std/show"

struct P { x: Int }

// A trait's method of the name wins over a function by name.
trait Size { fn len(self: Self) -> Int; }
impl Size for P { fn len(self: P) -> Int { 100 + self.x } }
fn p_len(p: P) -> Int { 0 }

fn main(out: OutCap) -> Int ! {io} {
    let v = vec_new[Int]()
    v.push(10)
    v.push(20)
    v[1] = v[0] + 5
    v[0] += 1
    println(f"{v[0]} {v[1]} {v.len()} {v.get(1)}")
    let s = vec_new[Str]()
    s.push("a")
    s[0] = f"{s[0]}b"
    println(s[0])
    let words = "x y z".split(" ")
    println(f"{strs_len(words)} {words[2]} {"hello".len()} {42.to_str().len()}")
    let b = bytes_new(2)
    b[1] = UInt8(7)
    println(b[1])
    let m = hashmap_new[Str, Int]()
    m.set("k", 5)
    match m.get("k") {
        Some(x) => println(x),
        None => println("none"),
    }
    println(P(x: 3).len())
    0
}
