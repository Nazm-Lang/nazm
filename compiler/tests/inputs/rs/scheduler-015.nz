fn echo(a: Chan, b: Chan, n: Int) -> Int { let buf = ints_new(); let mut i = 0; while i < n { chan_recv(a, buf); chan_send(b, ints_get(buf, i)); i = i + 1; } 0 }
fn main(t: SpawnCap) -> Int { let a = chan_new(1); let b = chan_new(1); let buf = ints_new(); let n = 100000;
scope { spawn echo(a, b, n); let mut i = 0; while i < n { chan_send(a, i); chan_recv(b, buf); i = i + 1; } } ints_len(buf) }
