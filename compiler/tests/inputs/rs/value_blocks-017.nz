fn main() -> Int {
    let o = Option[Ints].Some(value: ints_new());
    let v = match o {
        Option.None() => {
            0
        },
        Option.Some(value: zs) => {
            let held = str_concat("held", int_to_str(1));
            let xs = ints_new();
            ints_push(xs, 5);
            ints_get(xs, 0) / ints_len(zs)
        },
    };
    v
}
