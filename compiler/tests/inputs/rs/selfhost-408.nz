fn churn() -> Int { let mut noise = vec_new[Str](); let mut k = 0; while k < 64 { vec_push(noise, str_concat("noise-", int_to_str(k))); k = k + 1; } noise = vec_new[Str](); vec_len(noise) }
fn same[T: Equality](a: T, b: T) -> Bool { a == b }
fn wrap[T: Equality](a: T, b: T) -> Bool { same(a, b) }
fn bit(b: Bool, n: Int) -> Int { if b { n } else { 0 } }
fn text(n: Int) -> Str { str_concat("t-", int_to_str(n)) }
struct Box[T] { value: T, }
struct Item { name: Str, n: Int, }
enum Shape { Plain, Named(label: Str), }
fn box_same[T: Equality](a: Box[T], b: Box[T]) -> Bool { a == b }
