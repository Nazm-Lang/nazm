fn worker(c: Chan) -> Int ! {}
{ chan_send(c, 7); 0 }
fn say(io: IoCap, n: Int) -> Int ! { io }
{ print(int_to_str(n)) }
fn sum(n: Int) -> Int ! {}
{ let mut t = 0; let mut i = 1; while i <= n { t = t + i; i = i + 1; } t }
fn run(io: IoCap, tasks: SpawnCap) -> Int ! { spawn, io }
{ let c = chan_new(1); let buf = ints_new(); scope { spawn worker(c); chan_recv(c, buf); } say(io, ints_pop(buf) + sum(3)) }
fn main(io: IoCap, tasks: SpawnCap) -> Int ! { io, spawn }
{ run(io, tasks); 0 }
