trait Area { fn area(self: Self, scale: Int) -> Int; fn named(self: Self) -> Bool; }
struct Sq { s: Int, }
impl Area for Sq {
fn area(self: Sq, scale: Int) -> Int { self.s * self.s * scale }
fn named(self: Sq) -> Bool { self.s > 1 }
}
fn total[T: Area](a: T, b: T) -> Int { a.area(1) + b.area(2) }
fn main() -> Int { let q = Sq(s: 3); if q.named() { total(q, Sq(s: 2)) } else { 0 } }
