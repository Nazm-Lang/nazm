enum E {
    Absent,
    Value(a: Str, b: Int),
}
fn main() -> Int {
    let mut i = 0;
    let mut total = 0;
    while i < 3 {
        i = i + 1;
        let v = E.Value(a: int_to_str(i), b: if i == 1 { continue; } else { i });
        total = total + match v { E.Absent() => 0, E.Value(a: s, b: n) => n, };
    }
    total
}
