    while i < 5 {
        let b = bytes_new(8);
        let v = view(b);
        bytes_set(v, 0, 7);
        keep = v;
        let t = Text("añb");
        let u = text_slice(text_concat(t, scalar_text(66)), 1, 3);
        i = i + 1;
    }
    let a = bytes_new(8);
