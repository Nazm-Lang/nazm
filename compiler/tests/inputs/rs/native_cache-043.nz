pub enum State {
    Ready,
    Done(code: Int),
}
enum Hidden {
    A(n: Str),
    B,
}
enum Another {
    Only,
}
fn secret() -> Int { match Hidden.B() { Hidden.A(n: s) => str_len(s), Hidden.B() => 0, } + match Another.Only() { Another.Only() => 0, } }
pub fn start(n: Int) -> State { State.Done(code: n + secret()) }
