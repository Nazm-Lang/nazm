
fn make(k: Int) -> fn(Int) -> Str {
    let xs = ints_new();
    ints_push(xs, k);
    let tag = str_concat("tag-", int_to_str(k));
    fn(i: Int) -> Str { str_concat(tag, int_to_str(ints_get(xs, i))) }
}
fn main(out: OutCap) -> Int {
    let g = make(5);
    let ys = ints_new();
    ints_push(ys, 99);
    let other = str_concat("xxxx-", int_to_str(7));
    let zs = ints_new();
    ints_push(zs, 98);
    print(g(0));
    print(other);
    ints_len(ys) + ints_len(zs) - 2
}
