extern "C" fn labs(x: Int) -> Int = "labs";
extern "C" fn exported(x: Int) -> Int = "nz_exported" { x }
pub struct Pair[A, B] { a: A, b: B, }
struct Coded { @codec(rename = "id") id: Int, }
enum Tree[T] { Leaf, Node(left: Int, @codec(skip) right: Int), }
pub trait Show {
    fn show(self: Self) -> Str;
    fn twice(self: Self) -> Str ! {} { str_concat(self.show(), self.show()) }
}
impl Show for Int { fn show(self: Int) -> Str { int_to_str(self) } }
impl[T: Show] Show for Option[T] {
    fn show(self: Option[T]) -> Str { "opt" }
}
impl Point { fn area(self: Point) -> Int { self.x * self.y } }
impl[T] Pair[T, T] { fn first(self: Pair[T, T]) -> T { self.a } }
fn generic[T: Equality, effects E](f: fn(T) -> T ! {E}, x: T) -> T ! {E} { f(x) }
fn contract(x: Int) -> Int requires x > 0 ensures result > 0 { x }
fn nothing(x: Int) {
    print(x);
    if x > 0 { return }
    return;
}
