use std.json;
use std.;
enum Shape { Circle(r: Int), Square(side: Int), Dot, }
struct Point { x: Int, y: Int, }
fn add(a: Int, b: Int): Int = a + b
fn twice(x: Int) = x * 2;
fn area(s: Shape): Int {
    match s {
        Circle(r) => r * r,
        Square(side: q) => q,
        Dot => 0,
        Shape.Circle(5) => 1,
    }
}
