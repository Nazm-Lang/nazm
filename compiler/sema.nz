// The checker, written against `syntax.nz`'s tree (R2, slices 3-4; `openspec/changes/r2-front-end/`
// design D13): a port of `nazm-core/src/check` and `nazm-sema`, stage by stage as `check_reusing`
// runs them, each diagnostic as the reference words and places it.
//
// It knows where it stops. Whatever it meets that it does not carry yet — a construct, a type, a
// built-in, a stage — it records as the reason it stopped (`ck_stopped`), and the driver then
// reports none of its diagnostics for that compilation: a partial checker must never say what the
// reference would not, so every difference among the compilations it does carry is a defect.
//
// Carried today: a compilation's modules — the root, what it imports, the standard modules and the
// core prelude — each checked against its direct imports' interfaces: `pub` visibility, plain
// imports and imports under a name (`alias::f`, `alias::T`), their collisions (N0207, N0208,
// N0209), private and unimported names (N0206, N0201, N0305), unknown qualified names (N0210)
// and another module's undeclared effects; records and enums, generic ones included, and
// `Vec`s and applications of any type; functions with type parameters (and `Equality`
// requirements) but no effect parameters, contracts or attributes; `let`, assignment to a binding
// or its fields, `while`, `return`, `break`, `continue`; literals, names, `-`, `!`, the binary
// operators but shifts, calls of the module's functions and of the built-ins (generic ones by
// inference, `Chan[T]`, `Box`, `Cell` and `Chain` aside), construction of records and of variants
// (a generic enum's arguments inferred, `Some`/`None`/`Ok`/`Err` among them), field reads, `if`
// and blocks; `match` and what desugars to it (`if let`, `while let`, `let … else`, a `let` of a
// pattern) with its patterns, exhaustiveness and reachability, and N0632's warning; `?` on the
// prelude's `Result` and `Option`; interpolation and what `print(x)` is written as; effects and
// authority; the rules about `main`.

use "syntax.nz";
use "diag.nz";
use "builtins.nz";

// --- the checker's state -------------------------------------------------------------------

pub struct Ck {
    t: Tree,
    d: Diags,
    // Why it stopped; empty while it carries everything it has met.
    stop: Strs,
    // Scalars, by the slots below.
    st: Ints,
    // Modules, in the compilation's order: each one's program node and the offset of its text.
    mprog: Ints,
    mbase: Ints,
    // Types, interned: a tag, three words, a name, and a run of arguments.
    tytag: Ints,
    tya: Ints,
    tyb: Ints,
    tyc: Ints,
    tyname: Strs,
    tyargf: Ints,
    tyargc: Ints,
    tyargs: Ints,
    tykey: Strs,
    // Records: name, module, name span (absolute), type parameters, fields (a run of the pool).
    rname: Strs,
    rmod: Ints,
    rns: Ints,
    rne: Ints,
    rnp: Ints,
    rff: Ints,
    rfc: Ints,
    // Enums: the same, with a run of variants.
    ename: Strs,
    emod: Ints,
    ens: Ints,
    ene: Ints,
    enp: Ints,
    evf: Ints,
    evc: Ints,
    // Variants, pooled: name, name span, fields (a run of the pool).
    vname: Strs,
    vns: Ints,
    vne: Ints,
    vff: Ints,
    vfc: Ints,
    // Fields, pooled: name, type, name span, type span.
    fname: Strs,
    fty: Ints,
    fns: Ints,
    fne: Ints,
    fts: Ints,
    fte: Ints,
    // Whether each record and enum is `pub`.
    rpub: Ints,
    epub: Ints,
    // Functions: name, module, name span, tree node, parameter types (a run of `ptys`), result,
    // whether it returns nothing.
    fnname: Strs,
    fnmod: Ints,
    fnns: Ints,
    fnne: Ints,
    fnnode: Ints,
    fnpf: Ints,
    fnpc: Ints,
    fnret: Ints,
    fnnores: Ints,
    // Each function's declared effect set, as a mask (`io` 1, `spawn` 2, `foreign` 4), or -1 for
    // none written (or one with a word that is no effect); where it is written, or -1.
    fneff: Ints,
    fnws: Ints,
    fnwe: Ints,
    // Call sites, in the order the bodies are checked: the calling function, the callee's span,
    // the built-in (or -1) or the module's function (or -1) it reached, and the authority the
    // bindings in scope there held, as a mask over `CapabilityKind::ALL`.
    sfn: Ints,
    sstart: Ints,
    send: Ints,
    sbuiltin: Ints,
    suser: Ints,
    sheld: Ints,
    ptys: Ints,
    // The built-ins (`builtins.nz`): name, parameter types (a run of `ptys`), result, whether
    // each is carried, whether a module's function of its name hides it, effect, authority.
    bname: Strs,
    bpf: Ints,
    bpc: Ints,
    bret: Ints,
    bok: Ints,
    bprelude: Ints,
    beff: Strs,
    bcaps: Strs,
    // Whether an argument of it is the restricted sink, a path written to (N38).
    bpath: Ints,
    // The type names the module being checked may write, and what each names.
    tnames: Strs,
    ttys: Ints,
    // Scopes: bindings, innermost last, and where each frame begins.
    sname: Strs,
    sty: Ints,
    smut: Ints,
    sds: Ints,
    sde: Ints,
    frames: Ints,
    // Each function's type parameters, a run of the pool below: names, and whether each
    // requires `Equality` (N14).
    fntpf: Ints,
    fntpc: Ints,
    tpname: Strs,
    tpeq: Ints,
    // Each built-in's type parameter count, its numeric class, and its shapes as the table
    // spells them (a generic one's types are made per call, `T` being its own parameter).
    bgen: Ints,
    bclass: Strs,
    bshapes: Strs,
    bretshape: Strs,
    // The type parameters in scope for the types written in the body being checked.
    tsn: Strs,
    tst: Ints,
    // Patterns as exhaustiveness sees them (`usefulness::Pat`), pooled: kind, value, literal key,
    // enum, and a run of arguments; and the cells of the pattern matrices' rows.
    pkind: Ints,
    pval: Ints,
    pkey: Strs,
    pty: Ints,
    paf: Ints,
    pac: Ints,
    pargs: Ints,
    cells: Ints,
    // Warnings, published only where there is no error (`check_map_with_warnings`).
    w: Diags,
    // Whether each module is a standard one (or the prelude), whose functions hold no output
    // authority they are not given (R1.5, D8).
    mstd: Ints,
    // Each module's imports as the graph holds them (`Dependency`), a run of the pool below: the
    // module named, where the first `use` of it names it (absolute), whether a plain `use` named
    // it, and the names it is imported under (a run of the alias pool, with their spans). The
    // core prelude is every other module's last.
    dfirst: Ints,
    dcount: Ints,
    don: Ints,
    dats: Ints,
    date: Ints,
    dplain: Ints,
    daf: Ints,
    dac: Ints,
    aname: Strs,
    aats: Ints,
    aate: Ints,
    // Whether each function is exported (`pub`).
    fnpub: Ints,
    // The module being checked's environment beyond its own functions and the built-ins
    // (`environment`): each name a plain import brought in and the function it is; and each
    // alias it may write before `::`, and the module it names.
    envname: Strs,
    envfn: Ints,
    alname: Strs,
    almod: Ints,
    // Every alias the module's types may be written under (`Types::aliases`).
    taliases: Strs,
}

// The module graph as the loader resolved it, handed to `ck_check`: per module, whether it is a
// standard one, and the module each of its `use` items names (by load order; -1 for none).
pub struct Graph {
    standard: Ints,
    first: Ints,
    count: Ints,
    target: Ints,
}

pub fn ck_graph() -> Graph { Graph(standard: ints_new(), first: ints_new(), count: ints_new(), target: ints_new()) }

pub fn ck_graph_module(g: Graph, standard: Bool) -> Int {
    if standard { ints_push(g.standard, 1); } else { ints_push(g.standard, 0); }
    ints_push(g.first, ints_len(g.target));
    ints_push(g.count, 0);
    0
}

pub fn ck_graph_import(g: Graph, target: Int) -> Int {
    ints_push(g.target, target);
    let last = ints_len(g.count) - 1;
    ints_set(g.count, last, ints_get(g.count, last) + 1);
    0
}

fn s_ret() -> Int { 0 }
fn s_rs() -> Int { 1 }
fn s_re() -> Int { 2 }
fn s_loop() -> Int { 3 }
fn s_discard() -> Int { 4 }
fn s_unwanted() -> Int { 5 }
fn s_module() -> Int { 6 }
// The function whose body is being checked, or -1.
fn s_fn() -> Int { 7 }
// The core prelude's module.
fn s_prelude() -> Int { 8 }
fn s_slots() -> Int { 9 }

fn prelude(c: Ck) -> Int { gs(c, s_prelude()) }

fn gs(c: Ck, slot: Int) -> Int { ints_get(c.st, slot) }
fn ss(c: Ck, slot: Int, v: Int) -> Int { ints_set(c.st, slot, v); 0 }

// Stop: the compilation uses something this checker does not carry yet. The first reason is kept.
fn stop(c: Ck, why: Str) -> Int {
    if strs_len(c.stop) == 0 { strs_push(c.stop, why); }
    0
}

pub fn ck_stopped(c: Ck) -> Str {
    if strs_len(c.stop) == 0 { return ""; }
    strs_get(c.stop, 0)
}

// The errors; where there are none, the warnings (`check_map_with_warnings`).
pub fn ck_diags(c: Ck) -> Diags {
    if dg_len(c.d) == 0 { return c.w; }
    c.d
}

fn cat3(a: Str, b: Str, x: Str) -> Str { str_concat(str_concat(a, b), x) }
fn cat4(a: Str, b: Str, x: Str, y: Str) -> Str { str_concat(cat3(a, b, x), y) }
fn cat5(a: Str, b: Str, x: Str, y: Str, z: Str) -> Str { str_concat(cat4(a, b, x, y), z) }
fn tick(s: Str) -> Str { cat3("`", s, "`") }
fn plural(n: Int) -> Str { if n == 1 { return ""; } "s" }

fn starts_upper(s: Str) -> Bool {
    if str_len(s) == 0 { return false; }
    let b = str_byte(s, 0);
    b >= 65 && b <= 90
}

fn str_has(s: Str, part: Str) -> Bool {
    let n = str_len(part);
    let mut i = 0;
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == part { return true; }
        i = i + 1;
    }
    false
}

fn strs_find(xs: Strs, s: Str) -> Int {
    let mut i = 0;
    while i < strs_len(xs) {
        if strs_get(xs, i) == s { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- the tree, as the checker reads it ------------------------------------------------------

fn fld(c: Ck, n: Int, name: Str) -> Int { sx_field(c.t, n, name) }
fn fname_of(c: Ck, n: Int, name: Str) -> Str { sx_name(c.t, n, name) }
fn kids(c: Ck, n: Int, name: Str) -> Ints { sx_items(c.t, sx_field(c.t, n, name)) }
fn some(c: Ck, n: Int, name: Str) -> Bool { sx_is_some(c.t, sx_field(c.t, n, name)) }
fn unwrap(c: Ck, n: Int, name: Str) -> Int { sx_unwrap(c.t, sx_field(c.t, n, name)) }
fn flag(c: Ck, n: Int, name: Str) -> Bool { sx_text(c.t, sx_field(c.t, n, name)) == "true" }

// A span's ends, at their offsets in the whole compilation: the module being worked on's base.
fn base(c: Ck) -> Int { ints_get(c.mbase, gs(c, s_module())) }
fn sps(c: Ck, span: Int) -> Int { sx_s(c.t, span) + base(c) }
fn spe(c: Ck, span: Int) -> Int { sx_e(c.t, span) + base(c) }

// An expression's span, and a statement's.
fn espan(c: Ck, e: Int) -> Int { expr_span(c.t, e) }
fn stmt_span(c: Ck, s: Int) -> Int {
    if sx_kind(c.t, s) == tk_tuple() {
        if sx_text(c.t, s) == "Expr" { return expr_span(c.t, sx_kid(c.t, s, 0)); }
        return sx_field(c.t, sx_kid(c.t, s, 0), "span");
    }
    sx_field(c.t, s, "span")
}

// What kind of node an expression or a statement is: its variant's name.
fn kind_of(c: Ck, n: Int) -> Str { sx_text(c.t, n) }

// Report an error at a tree span of the module being worked on.
fn err(c: Ck, code: Str, span: Int, message: Str, help: Str) -> Int {
    dg_error(c.d, code, sps(c, span), spe(c, span), message, "", help)
}
fn sec(c: Ck, span: Int, message: Str) -> Int { dg_secondary(c.d, sps(c, span), spe(c, span), message) }
fn sec_at(c: Ck, s: Int, e: Int, message: Str) -> Int { dg_secondary(c.d, s, e, message) }

// --- types ------------------------------------------------------------------------------------

fn tag_builtin() -> Int { 1 }
fn tag_vec() -> Int { 2 }
fn tag_record() -> Int { 3 }
fn tag_enum() -> Int { 4 }
fn tag_param() -> Int { 5 }

fn t_int() -> Int { 0 }
fn t_bool() -> Int { 1 }
fn t_str() -> Int { 2 }
fn t_ints() -> Int { 3 }
fn t_strs() -> Int { 4 }

// The owners a type parameter may have.
fn own_record() -> Int { 1 }
fn own_enum() -> Int { 2 }
fn own_fn() -> Int { 3 }
fn own_builtin() -> Int { 4 }

fn intern(c: Ck, tag: Int, a: Int, b: Int, x: Int, name: Str, args: Ints) -> Int {
    let parts = strs_new();
    strs_push(parts, int_to_str(tag));
    strs_push(parts, int_to_str(a));
    strs_push(parts, int_to_str(b));
    strs_push(parts, int_to_str(x));
    strs_push(parts, name);
    let mut i = 0;
    while i < ints_len(args) {
        strs_push(parts, int_to_str(ints_get(args, i)));
        i = i + 1;
    }
    let key = str_join(parts, ":");
    let found = strs_find(c.tykey, key);
    if found >= 0 { return found; }
    strs_push(c.tykey, key);
    ints_push(c.tytag, tag);
    ints_push(c.tya, a);
    ints_push(c.tyb, b);
    ints_push(c.tyc, x);
    strs_push(c.tyname, name);
    ints_push(c.tyargf, ints_len(c.tyargs));
    ints_push(c.tyargc, ints_len(args));
    i = 0;
    while i < ints_len(args) {
        ints_push(c.tyargs, ints_get(args, i));
        i = i + 1;
    }
    strs_len(c.tykey) - 1
}

fn builtin_ty(c: Ck, name: Str) -> Int { intern(c, tag_builtin(), 0, 0, 0, name, ints_new()) }
fn vec_of(c: Ck, elem: Int) -> Int {
    let a = ints_new();
    ints_push(a, elem);
    intern(c, tag_vec(), 0, 0, 0, "", a)
}
fn record_ty(c: Ck, r: Int, args: Ints) -> Int { intern(c, tag_record(), r, 0, 0, "", args) }
fn enum_ty(c: Ck, e: Int, args: Ints) -> Int { intern(c, tag_enum(), e, 0, 0, "", args) }
fn param_ty(c: Ck, owner: Int, id: Int, index: Int, name: Str) -> Int { intern(c, tag_param(), owner, id, index, name, ints_new()) }

fn tag(c: Ck, t: Int) -> Int { ints_get(c.tytag, t) }
fn ta(c: Ck, t: Int) -> Int { ints_get(c.tya, t) }
fn targc(c: Ck, t: Int) -> Int { ints_get(c.tyargc, t) }
fn targ(c: Ck, t: Int, i: Int) -> Int { ints_get(c.tyargs, ints_get(c.tyargf, t) + i) }
fn targs(c: Ck, t: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        ints_push(out, targ(c, t, i));
        i = i + 1;
    }
    out
}
fn is_record(c: Ck, t: Int) -> Bool { tag(c, t) == tag_record() }
fn is_enum(c: Ck, t: Int) -> Bool { tag(c, t) == tag_enum() }
fn bname_of(c: Ck, t: Int) -> Str {
    if tag(c, t) == tag_builtin() { return strs_get(c.tyname, t); }
    ""
}

// The built-in types, by name (`Type::from_name`), in `Type::ALL`'s order.
fn builtin_names() -> Strs {
    let s = strs_new();
    strs_push(s, "Int");
    strs_push(s, "Bool");
    strs_push(s, "Str");
    strs_push(s, "Ints");
    strs_push(s, "Strs");
    strs_push(s, "Chan");
    strs_push(s, "IoCap");
    strs_push(s, "SpawnCap");
    strs_push(s, "ForeignCap");
    strs_push(s, "VouchCap");
    strs_push(s, "TimeCap");
    strs_push(s, "MmioCap");
    strs_push(s, "OutCap");
    strs_push(s, "NetCap");
    strs_push(s, "RandomCap");
    strs_push(s, "ProcessCap");
    strs_push(s, "Int8");
    strs_push(s, "Int16");
    strs_push(s, "Int32");
    strs_push(s, "UInt8");
    strs_push(s, "UInt16");
    strs_push(s, "UInt32");
    strs_push(s, "UInt64");
    strs_push(s, "Float32");
    strs_push(s, "Float64");
    strs_push(s, "Bytes");
    strs_push(s, "Text");
    strs_push(s, "OsHandle");
    strs_push(s, "Atomic");
    strs_push(s, "Int128");
    strs_push(s, "UInt128");
    s
}

fn is_builtin_name(name: Str) -> Bool { strs_find(builtin_names(), name) >= 0 }

fn all_names() -> Str {
    let names = builtin_names();
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(names) {
        strs_push(out, tick(strs_get(names, i)));
        i = i + 1;
    }
    str_join(out, ", ")
}

fn is_cap_name(name: Str) -> Bool {
    let i = strs_find(builtin_names(), name);
    i >= 6 && i <= 15
}

fn is_num_name(name: Str) -> Bool {
    if name == "Int" { return true; }
    let i = strs_find(builtin_names(), name);
    (i >= 16 && i <= 24) || i == 29 || i == 30
}

fn is_float_name(name: Str) -> Bool { name == "Float32" || name == "Float64" }

fn is_cap(c: Ck, t: Int) -> Bool { is_cap_name(bname_of(c, t)) }
fn is_num(c: Ck, t: Int) -> Bool { is_num_name(bname_of(c, t)) }
fn is_integer(c: Ck, t: Int) -> Bool { is_num(c, t) && is_float_name(bname_of(c, t)) == false }

// How a type is written in a message (`UserTypes::show`).
fn show(c: Ck, t: Int) -> Str {
    let g = tag(c, t);
    if g == tag_builtin() { return strs_get(c.tyname, t); }
    if g == tag_param() { return strs_get(c.tyname, t); }
    if g == tag_vec() {
        let e = targ(c, t, 0);
        if e == t_int() { return "Ints"; }
        if e == t_str() { return "Strs"; }
        return cat3("Vec[", show(c, e), "]");
    }
    let mut name = "";
    if g == tag_record() { name = strs_get(c.rname, ta(c, t)); }
    if g == tag_enum() { name = strs_get(c.ename, ta(c, t)); }
    if targc(c, t) == 0 { return name; }
    let parts = strs_new();
    let mut i = 0;
    while i < targc(c, t) {
        strs_push(parts, show(c, targ(c, t, i)));
        i = i + 1;
    }
    cat4(name, "[", str_join(parts, ", "), "]")
}

// A definition's parameters replaced by an application's arguments.
fn subst(c: Ck, t: Int, owner: Int, id: Int, args: Ints) -> Int {
    let g = tag(c, t);
    if g == tag_param() {
        if ta(c, t) == owner && ints_get(c.tyb, t) == id {
            let i = ints_get(c.tyc, t);
            if i < ints_len(args) { return ints_get(args, i); }
        }
        return t;
    }
    if g == tag_builtin() { return t; }
    if targc(c, t) == 0 { return t; }
    let out = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        ints_push(out, subst(c, targ(c, t, i), owner, id, args));
        i = i + 1;
    }
    intern(c, g, ta(c, t), ints_get(c.tyb, t), ints_get(c.tyc, t), strs_get(c.tyname, t), out)
}

// A record type's fields: their names and types, the application's arguments substituted.
fn record_field(c: Ck, t: Int, name: Str) -> Int {
    let r = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.rfc, r) {
        if strs_get(c.fname, ints_get(c.rff, r) + i) == name { return ints_get(c.rff, r) + i; }
        i = i + 1;
    }
    0 - 1
}
fn field_ty_in(c: Ck, t: Int, f: Int) -> Int {
    if targc(c, t) == 0 { return ints_get(c.fty, f); }
    let mut owner = own_record();
    if is_enum(c, t) { owner = own_enum(); }
    subst(c, ints_get(c.fty, f), owner, ta(c, t), targs(c, t))
}

// An enum's variant by name, as an index into the pool; -1 when it has none of it.
fn variant_of(c: Ck, t: Int, name: Str) -> Int {
    let e = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.evc, e) {
        if strs_get(c.vname, ints_get(c.evf, e) + i) == name { return ints_get(c.evf, e) + i; }
        i = i + 1;
    }
    0 - 1
}
fn variant_field(c: Ck, v: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_get(c.vfc, v) {
        if strs_get(c.fname, ints_get(c.vff, v) + i) == name { return ints_get(c.vff, v) + i; }
        i = i + 1;
    }
    0 - 1
}

// Whether `==` (`equality`) or `<` (`ordering`) applies to a type, by the walk every derived
// property shares (`UserTypes::derived`): "" when it does, otherwise the field path to the first
// component that has none, then `|`, then that component's type.
fn derived(c: Ck, t: Int, equality: Bool) -> Str {
    if is_record(c, t) == false && is_enum(c, t) == false {
        if leaf(c, t, equality) { return ""; }
        return str_concat("|", int_to_str(t));
    }
    let seen = ints_new();
    ints_push(seen, t);
    // The stack: each frame a node, the next edge to look at, and how many names it pushed.
    let snode = ints_new();
    let sat = ints_new();
    let spushed = ints_new();
    ints_push(snode, t);
    ints_push(sat, 0);
    ints_push(spushed, 0);
    let path = strs_new();
    while ints_len(snode) > 0 {
        let node = ints_pop(snode);
        let at = ints_pop(sat);
        let pushed = ints_pop(spushed);
        let edges = contained(c, node);
        if at >= ints_len(edges) {
            let mut k = 0;
            while k < pushed {
                strs_pop(path);
                k = k + 1;
            }
        } else {
            ints_push(snode, node);
            ints_push(sat, at + 1);
            ints_push(spushed, pushed);
            let f = ints_get(edges, at);
            let ty = field_ty_in(c, node, f);
            let names = edge_names(c, node, f);
            if is_record(c, ty) || is_enum(c, ty) {
                let mut found = false;
                let mut k = 0;
                while k < ints_len(seen) {
                    if ints_get(seen, k) == ty { found = true; }
                    k = k + 1;
                }
                if found == false {
                    ints_push(seen, ty);
                    let mut k = 0;
                    while k < strs_len(names) {
                        strs_push(path, strs_get(names, k));
                        k = k + 1;
                    }
                    ints_push(snode, ty);
                    ints_push(sat, 0);
                    ints_push(spushed, strs_len(names));
                }
            } else {
                if leaf(c, ty, equality) == false {
                    let mut k = 0;
                    while k < strs_len(names) {
                        strs_push(path, strs_get(names, k));
                        k = k + 1;
                    }
                    return cat3(str_join(path, "."), "|", int_to_str(ty));
                }
            }
        }
    }
    ""
}

fn leaf(c: Ck, t: Int, equality: Bool) -> Bool {
    // A type parameter has equality exactly when its declaration requires it (N14).
    if tag(c, t) == tag_param() { return equality && requires_equality(c, t); }
    let n = bname_of(c, t);
    if n == "Int" || n == "Bool" || n == "Str" { return true; }
    if equality { return n == "Text" || is_num_name(n); }
    is_num_name(n) && is_float_name(n) == false
}

// A node's containment edges, as field indices of the pool, in declaration order.
fn contained(c: Ck, node: Int) -> Ints {
    let out = ints_new();
    if is_record(c, node) {
        let r = ta(c, node);
        let mut i = 0;
        while i < ints_get(c.rfc, r) {
            ints_push(out, ints_get(c.rff, r) + i);
            i = i + 1;
        }
        return out;
    }
    let e = ta(c, node);
    let mut v = 0;
    while v < ints_get(c.evc, e) {
        let vi = ints_get(c.evf, e) + v;
        let mut i = 0;
        while i < ints_get(c.vfc, vi) {
            ints_push(out, ints_get(c.vff, vi) + i);
            i = i + 1;
        }
        v = v + 1;
    }
    out
}

// The path components one edge contributes: the field, after its variant for an enum's payload.
fn edge_names(c: Ck, node: Int, f: Int) -> Strs {
    let out = strs_new();
    if is_enum(c, node) {
        let e = ta(c, node);
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let vi = ints_get(c.evf, e) + v;
            if f >= ints_get(c.vff, vi) && f < ints_get(c.vff, vi) + ints_get(c.vfc, vi) {
                strs_push(out, strs_get(c.vname, vi));
            }
            v = v + 1;
        }
    }
    strs_push(out, strs_get(c.fname, f));
    out
}

fn derived_type(c: Ck, why: Str) -> Int {
    let mut i = 0;
    while i < str_len(why) {
        if str_byte(why, i) == 124 { return parse_int(str_slice(why, i + 1, str_len(why))); }
        i = i + 1;
    }
    0
}
fn derived_path(c: Ck, why: Str) -> Str {
    let mut i = 0;
    while i < str_len(why) {
        if str_byte(why, i) == 124 { return str_slice(why, 0, i); }
        i = i + 1;
    }
    ""
}

fn parse_int(s: Str) -> Int {
    let mut v = 0;
    let mut i = 0;
    while i < str_len(s) {
        v = v * 10 + str_byte(s, i) - 48;
        i = i + 1;
    }
    v
}

// --- the checker ------------------------------------------------------------------------------

fn new_ck(t: Tree) -> Ck {
    let c = Ck(t: t, d: dg_new(), stop: strs_new(), st: ints_new(), mprog: ints_new(), mbase: ints_new(), tytag: ints_new(),
            tya: ints_new(), tyb: ints_new(), tyc: ints_new(), tyname: strs_new(), tyargf: ints_new(), tyargc: ints_new(),
            tyargs: ints_new(), tykey: strs_new(), rname: strs_new(), rmod: ints_new(), rns: ints_new(), rne: ints_new(),
            rnp: ints_new(), rff: ints_new(), rfc: ints_new(), ename: strs_new(), emod: ints_new(), ens: ints_new(),
            ene: ints_new(), enp: ints_new(), evf: ints_new(), evc: ints_new(), vname: strs_new(), vns: ints_new(),
            vne: ints_new(), vff: ints_new(), vfc: ints_new(), fname: strs_new(), fty: ints_new(), fns: ints_new(),
            fne: ints_new(), fts: ints_new(), fte: ints_new(), rpub: ints_new(), epub: ints_new(), fnname: strs_new(), fnmod: ints_new(), fnns: ints_new(), fnne: ints_new(), fnnode: ints_new(),
            fnpf: ints_new(), fnpc: ints_new(), fnret: ints_new(), fnnores: ints_new(), fneff: ints_new(), fnws: ints_new(), fnwe: ints_new(), sfn: ints_new(), sstart: ints_new(),
            send: ints_new(), sbuiltin: ints_new(), suser: ints_new(), sheld: ints_new(), ptys: ints_new(), bname: strs_new(),
            bpf: ints_new(), bpc: ints_new(), bret: ints_new(), bok: ints_new(), bprelude: ints_new(), beff: strs_new(),
            bcaps: strs_new(), bpath: ints_new(), tnames: strs_new(), ttys: ints_new(), sname: strs_new(), sty: ints_new(), smut: ints_new(),
            sds: ints_new(), sde: ints_new(), frames: ints_new(), fntpf: ints_new(), fntpc: ints_new(), tpname: strs_new(),
            tpeq: ints_new(), bgen: ints_new(), bclass: strs_new(), bshapes: strs_new(), bretshape: strs_new(), tsn: strs_new(),
            tst: ints_new(), pkind: ints_new(), pval: ints_new(), pkey: strs_new(), pty: ints_new(), paf: ints_new(), pac: ints_new(),
            pargs: ints_new(), cells: ints_new(), w: dg_new(), mstd: ints_new(), dfirst: ints_new(), dcount: ints_new(), don: ints_new(),
            dats: ints_new(), date: ints_new(), dplain: ints_new(), daf: ints_new(), dac: ints_new(), aname: strs_new(), aats: ints_new(),
            aate: ints_new(), fnpub: ints_new(), envname: strs_new(), envfn: ints_new(), alname: strs_new(), almod: ints_new(),
            taliases: strs_new());
    let mut i = 0;
    while i < s_slots() {
        ints_push(c.st, 0);
        i = i + 1;
    }
    // `Int`, `Bool`, `Str`, then `Ints` and `Strs` — `Vec[Int]` and `Vec[Str]` — at fixed ids.
    builtin_ty(c, "Int");
    builtin_ty(c, "Bool");
    builtin_ty(c, "Str");
    vec_of(c, t_int());
    vec_of(c, t_str());
    load_builtins(c);
    c
}

// The built-in table, its shapes as types; a built-in whose signature names its own parameter or a
// type this checker does not carry is marked so, and a call of it stops the checker.
fn load_builtins(c: Ck) -> Int {
    let rows = bi_rows();
    let mut i = 0;
    while i < strs_len(rows) {
        let cols = split(strs_get(rows, i), 124);
        strs_push(c.bname, strs_get(cols, 0));
        let generic = strs_get(cols, 3) != "0";
        let mut ok = true;
        ints_push(c.bgen, parse_int(strs_get(cols, 3)));
        strs_push(c.bclass, strs_get(cols, 4));
        strs_push(c.bshapes, strs_get(cols, 1));
        strs_push(c.bretshape, strs_get(cols, 2));
        ints_push(c.bpf, ints_len(c.ptys));
        let params = split(strs_get(cols, 1), 44);
        let mut n = 0;
        let mut k = 0;
        while k < strs_len(params) {
            if strs_get(params, k) != "" {
                let mut t = 0;
                if generic {
                    if generic_shape(strs_get(params, k)) == false { ok = false; }
                } else {
                    t = shape_ty(c, strs_get(params, k));
                    if t < 0 { ok = false; }
                }
                ints_push(c.ptys, t);
                n = n + 1;
            }
            k = k + 1;
        }
        ints_push(c.bpc, n);
        let mut r = 0;
        if generic {
            if generic_shape(strs_get(cols, 2)) == false { ok = false; }
        } else {
            r = shape_ty(c, strs_get(cols, 2));
            if r < 0 { ok = false; }
        }
        ints_push(c.bret, r);
        if ok { ints_push(c.bok, 1); } else { ints_push(c.bok, 0); }
        ints_push(c.bprelude, parse_int(strs_get(cols, 5)));
        strs_push(c.beff, strs_get(cols, 6));
        strs_push(c.bcaps, strs_get(cols, 7));
        if str_has(strs_get(cols, 8), ":path") { ints_push(c.bpath, 1); } else { ints_push(c.bpath, 0); }
        i = i + 1;
    }
    0
}

// Whether a generic built-in's shape is one this checker makes: its parameter, a `Vec` or an
// `Option` of it, or a monomorphic type.
fn generic_shape(s: Str) -> Bool {
    if s == "T" || s == "Vec[T]" || s == "Option[T]" { return true; }
    is_builtin_name(s) && s != "Chan"
}

// A generic built-in's shape for the built-in `b`, its `T` being `t`.
fn shape_of(c: Ck, s: Str, t: Int) -> Int {
    if s == "T" { return t; }
    if s == "Vec[T]" { return vec_of(c, t); }
    if s == "Option[T]" {
        let a = ints_new();
        ints_push(a, t);
        return enum_ty(c, declared_enum(c, prelude(c), "Option"), a);
    }
    shape_ty(c, s)
}

fn shape_ty(c: Ck, s: Str) -> Int {
    if s == "Ints" { return t_ints(); }
    if s == "Strs" { return t_strs(); }
    if is_builtin_name(s) { return builtin_ty(c, s); }
    0 - 1
}

fn split(s: Str, sep: Int) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == sep {
            strs_push(out, str_slice(s, from, i));
            from = i + 1;
        }
        i = i + 1;
    }
    strs_push(out, str_slice(s, from, str_len(s)));
    out
}

fn builtin_index(c: Ck, name: Str) -> Int { strs_find(c.bname, name) }

// --- the compilation ------------------------------------------------------------------------

// Check the compilation whose modules' programs are `programs`, at text offsets `bases`, named
// `names`, its import edges `graph` (`load.nz`'s order: the root first, the core prelude last).
// The diagnostics are `ck_diags`, to be published only when `ck_stopped` is "".
//
// Every stage runs over every module in load order, as `check_reusing` runs them: each type's
// name, each module's field types against its imports' interfaces, the layouts, each module's
// declarations, then each module's bodies against its direct imports' interfaces.
pub fn ck_check(t: Tree, programs: Ints, bases: Ints, names: Strs, graph: Graph) -> Ck {
    let c = new_ck(t);
    let count = ints_len(programs);
    let mut i = 0;
    while i < count {
        ints_push(c.mprog, ints_get(programs, i));
        ints_push(c.mbase, ints_get(bases, i));
        ints_push(c.mstd, ints_get(graph.standard, i));
        i = i + 1;
    }
    if strs_get(names, count - 1) != "@core/prelude.nz" {
        stop(c, "a compilation without the core prelude");
        return c;
    }
    ss(c, s_prelude(), count - 1);
    i = 0;
    while i < count {
        refuse_unsupported_items(c, i);
        i = i + 1;
    }
    if strs_len(c.stop) > 0 { return c; }
    build_dependencies(c, graph);
    if strs_len(c.stop) > 0 { return c; }
    // Stage 0a: every user-defined type's name.
    i = 0;
    while i < count {
        declare_types(c, i);
        i = i + 1;
    }
    // Stage 0b: each module's field types; stage 0c, the layouts they describe.
    i = 0;
    while i < count {
        resolve_type_fields(c, i);
        i = i + 1;
    }
    validate_layouts(c);
    // Stage 1: each module's definitions.
    i = 0;
    while i < count {
        declare_functions(c, i);
        i = i + 1;
    }
    // Stage 2: the bodies, module by module, each module's effects once its bodies are.
    i = 0;
    while i < count {
        check_unit(c, i);
        analyse_effects(c, i);
        i = i + 1;
    }
    // The rules about `main`.
    main_rules(c);
    c
}

// Each module's imports as the graph holds them (`ModuleGraph::import_as`): one edge per module
// named, in the order of the first `use` naming it, plain when any `use` of it is, with every
// name it is imported under; a module naming itself adds none. The core prelude is imported by
// every other module, last, at no place.
fn build_dependencies(c: Ck, graph: Graph) -> Int {
    let count = ints_len(c.mprog);
    let mut m = 0;
    while m < count {
        ss(c, s_module(), m);
        let imports = kids(c, ints_get(c.mprog, m), "imports");
        let gf = ints_get(graph.first, m);
        let targets = ints_new();
        if m != prelude(c) {
            if ints_get(graph.count, m) != ints_len(imports) {
                stop(c, "an import the loader did not resolve");
                return 0;
            }
        }
        let mut k = 0;
        while k < ints_len(imports) {
            let imp = ints_get(imports, k);
            let to = ints_get(graph.target, gf + k);
            if to < 0 { stop(c, "an import the loader did not resolve"); }
            if some(c, imp, "reexport") { stop(c, "a re-export"); }
            if to == m && some(c, imp, "alias") { stop(c, "a module imported under a name by itself"); }
            if to != m && index_of(targets, to) < 0 { ints_push(targets, to); }
            k = k + 1;
        }
        ints_push(c.dfirst, ints_len(c.don));
        let mut n = 0;
        while n < ints_len(targets) {
            let to = ints_get(targets, n);
            let mut plain = false;
            let mut first = 0 - 1;
            ints_push(c.daf, strs_len(c.aname));
            k = 0;
            while k < ints_len(imports) {
                let imp = ints_get(imports, k);
                if ints_get(graph.target, gf + k) == to {
                    if first < 0 { first = imp; }
                    if some(c, imp, "alias") {
                        let q = unwrap(c, imp, "alias");
                        strs_push(c.aname, fname_of(c, q, "name"));
                        ints_push(c.aats, sps(c, fld(c, q, "span")));
                        ints_push(c.aate, spe(c, fld(c, q, "span")));
                    } else {
                        plain = true;
                    }
                }
                k = k + 1;
            }
            ints_push(c.dac, strs_len(c.aname) - ints_get(c.daf, ints_len(c.daf) - 1));
            ints_push(c.don, to);
            ints_push(c.dats, sps(c, fld(c, first, "path_span")));
            ints_push(c.date, spe(c, fld(c, first, "path_span")));
            if plain { ints_push(c.dplain, 1); } else { ints_push(c.dplain, 0); }
            n = n + 1;
        }
        if m != prelude(c) {
            ints_push(c.don, prelude(c));
            ints_push(c.dats, 0);
            ints_push(c.date, 0);
            ints_push(c.dplain, 1);
            ints_push(c.daf, strs_len(c.aname));
            ints_push(c.dac, 0);
        }
        ints_push(c.dcount, ints_len(c.don) - ints_get(c.dfirst, m));
        m = m + 1;
    }
    0
}

// Module `m`'s `k`th dependency, as an index into the pool.
fn dep(c: Ck, m: Int, k: Int) -> Int { ints_get(c.dfirst, m) + k }
fn deps(c: Ck, m: Int) -> Int { ints_get(c.dcount, m) }

// Whether module `m` imports module `x` directly (the prelude included).
fn imports_module(c: Ck, m: Int, x: Int) -> Bool {
    let mut k = 0;
    while k < deps(c, m) {
        if ints_get(c.don, dep(c, m, k)) == x { return true; }
        k = k + 1;
    }
    false
}

// What a module may hold that the checker does not carry yet.
fn refuse_unsupported_items(c: Ck, m: Int) -> Int {
    let p = ints_get(c.mprog, m);
    if ints_len(kids(c, p, "traits")) > 0 { stop(c, "a trait"); }
    if ints_len(kids(c, p, "impls")) > 0 { stop(c, "an impl"); }
    if ints_len(kids(c, p, "consts")) > 0 { stop(c, "a constant"); }
    let records = kids(c, p, "records");
    let mut i = 0;
    while i < ints_len(records) {
        let r = ints_get(records, i);
        if ints_len(kids(c, r, "attrs")) > 0 { stop(c, "an attribute"); }
        if some(c, r, "foreign") { stop(c, "a foreign record"); }
        let n = fname_of(c, r, "name");
        if (n == "Option" || n == "Result") && m != prelude(c) { stop(c, "a type named as the prelude's"); }
        let fields = kids(c, r, "fields");
        let mut k = 0;
        while k < ints_len(fields) {
            if ints_len(kids(c, ints_get(fields, k), "attrs")) > 0 { stop(c, "an attribute"); }
            k = k + 1;
        }
        i = i + 1;
    }
    let enums = kids(c, p, "enums");
    i = 0;
    while i < ints_len(enums) {
        let e = ints_get(enums, i);
        if ints_len(kids(c, e, "attrs")) > 0 { stop(c, "an attribute"); }
        let n = fname_of(c, e, "name");
        if (n == "Option" || n == "Result") && m != prelude(c) { stop(c, "a type named as the prelude's"); }
        let variants = kids(c, e, "variants");
        let mut k = 0;
        while k < ints_len(variants) {
            let v = ints_get(variants, k);
            if ints_len(kids(c, v, "attrs")) > 0 { stop(c, "an attribute"); }
            let fields = kids(c, v, "fields");
            let mut j = 0;
            while j < ints_len(fields) {
                if ints_len(kids(c, ints_get(fields, j), "attrs")) > 0 { stop(c, "an attribute"); }
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    let functions = kids(c, p, "functions");
    i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        if ints_len(kids(c, f, "attrs")) > 0 { stop(c, "an attribute"); }
        if ints_len(kids(c, f, "effect_params")) > 0 { stop(c, "an effect parameter"); }
        if ints_len(kids(c, f, "contracts")) > 0 { stop(c, "a contract"); }

        if some(c, f, "foreign") { stop(c, "a foreign function"); }
        if some(c, f, "export") { stop(c, "an export"); }
        if some(c, f, "method_of") { stop(c, "a method"); }
        if flag(c, f, "inferred_result") { stop(c, "a result type taken from the body"); }
        if some(c, f, "body") == false { stop(c, "a function without a body"); }
        i = i + 1;
    }
    0
}

// --- stage 0a: type names (`declare_types`) --------------------------------------------------

fn declare_types(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    let p = ints_get(c.mprog, m);
    let records = kids(c, p, "records");
    let mut i = 0;
    while i < ints_len(records) {
        let r = ints_get(records, i);
        let name = fname_of(c, r, "name");
        let ns = fld(c, r, "name_span");
        if refuse_type_name(c, m, name, ns) == false {
            declared_type_params(c, r);
            requirements(c, r, false, 0);
            strs_push(c.rname, name);
            ints_push(c.rmod, m);
            ints_push(c.rns, sps(c, ns));
            ints_push(c.rne, spe(c, ns));
            ints_push(c.rnp, ints_len(kids(c, r, "type_params")));
            ints_push(c.rff, 0);
            ints_push(c.rfc, 0);
            if some(c, r, "pub_span") { ints_push(c.rpub, 1); } else { ints_push(c.rpub, 0); }
        }
        i = i + 1;
    }
    let enums = kids(c, p, "enums");
    i = 0;
    while i < ints_len(enums) {
        let e = ints_get(enums, i);
        let name = fname_of(c, e, "name");
        let ns = fld(c, e, "name_span");
        if refuse_type_name(c, m, name, ns) == false {
            declared_type_params(c, e);
            requirements(c, e, false, 0);
            strs_push(c.ename, name);
            ints_push(c.emod, m);
            ints_push(c.ens, sps(c, ns));
            ints_push(c.ene, spe(c, ns));
            ints_push(c.enp, ints_len(kids(c, e, "type_params")));
            ints_push(c.evf, 0);
            ints_push(c.evc, 0);
            if some(c, e, "pub_span") { ints_push(c.epub, 1); } else { ints_push(c.epub, 0); }
        }
        i = i + 1;
    }
    0
}

// A declaration's type parameters, checked once (`declared_type_params`): never a built-in
// type's name or `Vec` (N0331), and unique within the list (N0350).
fn declared_type_params(c: Ck, decl: Int) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let name = fname_of(c, p, "name");
        if flag(c, p, "effect") { stop(c, "an effect parameter"); }
        if is_builtin_name(name) || name == "Vec" {
            err(c, "N0331", fld(c, p, "span"), cat3("`", name, "` is a built-in type and cannot be a type parameter"),
                    "a built-in type's name means the same thing everywhere, including inside a generic definition; choose another name, such as `T`");
        } else {
            let mut k = 0;
            let mut first = 0 - 1;
            while k < i {
                if first < 0 && fname_of(c, ints_get(params, k), "name") == name { first = k; }
                k = k + 1;
            }
            if first >= 0 {
                err(c, "N0350", fld(c, p, "span"), cat3("`", name, "` is declared twice in this parameter list"),
                        "a type parameter is one position; two cannot share a name");
                sec(c, fld(c, ints_get(params, first), "span"), "first declared here");
            }
        }
        i = i + 1;
    }
    0
}

// What a declaration's type parameters require (`declared_requirements`): only a function's may
// (N0101 otherwise), and only `Equality` while no trait is in scope (N0365). A function's are
// recorded against its parameters' run.
fn requirements(c: Ck, decl: Int, function: Bool, id: Int) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        if some(c, p, "requires") {
            let req = unwrap(c, p, "requires");
            let rs = fld(c, req, "span");
            if function == false {
                err(c, "N0101", rs, "a requirement on a record's or an enum's type parameter is not supported yet",
                        "require the capability where it is used: a function can say `fn same[T: Equality](a: Box[T], b: Box[T]) -> Bool`");
            } else {
                if fname_of(c, req, "name") != "Equality" {
                    err(c, "N0365", rs, cat3("`", fname_of(c, req, "name"), "` is not a capability a type parameter can require"),
                            "a type parameter requires `Equality` or a trait in scope: `fn same[T: Equality](a: T, b: T) -> Bool`, `fn f[T: Show](x: T) -> Str`");
                } else {
                    ints_set(c.tpeq, ints_get(c.fntpf, id) + i, 1);
                }
            }
        }
        i = i + 1;
    }
    0
}

// The type of a function's `index`th type parameter, named as its declaration names it.
fn fn_param_ty(c: Ck, id: Int, index: Int) -> Int {
    let mut name = cat3("type parameter ", int_to_str(index + 1), "");
    if index < ints_get(c.fntpc, id) { name = strs_get(c.tpname, ints_get(c.fntpf, id) + index); }
    param_ty(c, own_fn(), id, index, name)
}

// Whether a type parameter's declaration requires `Equality` (N14).
fn requires_equality(c: Ck, t: Int) -> Bool {
    if ta(c, t) != own_fn() { return false; }
    let id = ints_get(c.tyb, t);
    let index = ints_get(c.tyc, t);
    if index >= ints_get(c.fntpc, id) { return false; }
    ints_get(c.tpeq, ints_get(c.fntpf, id) + index) == 1
}

fn declared_record(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && strs_get(c.rname, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}
fn declared_enum(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && strs_get(c.ename, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn refuse_type_name(c: Ck, m: Int, name: Str, at: Int) -> Bool {
    if is_builtin_name(name) || name == "Vec" {
        err(c, "N0331", at, cat3("`", name, "` is a built-in type and cannot be redefined"),
                "built-in type names mean the same thing in every module of every program, so none of them may be shadowed; choose another name");
        return true;
    }
    let r = declared_record(c, m, name);
    let e = declared_enum(c, m, name);
    if r >= 0 || e >= 0 {
        err(c, "N0330", at, cat3("`", name, "` is declared more than once in this module"),
                "records and enums share one type namespace, so a `struct` and an `enum` of the same name collide exactly as two of either would");
        if r >= 0 { sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "first declared here"); } else {
            sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "first declared here");
        }
        return true;
    }
    false
}

// The names a module may write a type by (`type_environment`): its own, then each direct
// import's nameable types — under each name it is imported by as `alias::Name`, and plainly where
// a plain `use` named it. With `report`, an import bringing in a type the module declares
// (N0208) or one another import brought in (N0207) is reported; the prelude's names are never
// ambiguous.
fn type_environment(c: Ck, m: Int, report: Bool) -> Int {
    while strs_len(c.tnames) > 0 {
        strs_pop(c.tnames);
        ints_pop(c.ttys);
    }
    while strs_len(c.taliases) > 0 { strs_pop(c.taliases); }
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && strs_find(c.tnames, strs_get(c.rname, i)) < 0 {
            strs_push(c.tnames, strs_get(c.rname, i));
            ints_push(c.ttys, record_ty(c, i, ints_new()));
        }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && strs_find(c.tnames, strs_get(c.ename, i)) < 0 {
            strs_push(c.tnames, strs_get(c.ename, i));
            ints_push(c.ttys, enum_ty(c, i, ints_new()));
        }
        i = i + 1;
    }
    // Which import brought each plain name in, for the second.
    let bnames = strs_new();
    let bstarts = ints_new();
    let bends = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        let on = ints_get(c.don, d);
        let offered = offered_types(c, on);
        let mut a = 0;
        while a < ints_get(c.dac, d) {
            let alias = strs_get(c.aname, ints_get(c.daf, d) + a);
            strs_push(c.taliases, alias);
            let mut j = 0;
            while j < ints_len(offered) {
                let t = ints_get(offered, j);
                set_type_name(c, cat3(alias, "::", type_name(c, t)), t);
                j = j + 1;
            }
            a = a + 1;
        }
        if ints_get(c.dplain, d) == 1 {
            let mut j = 0;
            while j < ints_len(offered) {
                let t = ints_get(offered, j);
                let name = type_name(c, t);
                let own = own_type(c, m, name);
                let first = strs_find(bnames, name);
                if own >= 0 {
                    // The prelude's names are reserved (N0363), which the checker stops at.
                    if on != prelude(c) && report {
                        dg_error(c.d, "N0208", ints_get(c.dats, d), ints_get(c.date, d),
                                cat3("this import brings in the type `", name, "`, which this module declares"), "",
                                "an imported type and a local one are not ranked: rename one of them, or stop exporting the other");
                        sec_at(c, type_start(c, own), type_end(c, own), "declared here");
                        sec_at(c, type_start(c, t), type_end(c, t), "and exported here");
                    }
                } else {
                    if first >= 0 {
                        if on == prelude(c) {
                            set_type_name(c, name, t);
                        } else {
                            if report {
                                dg_error(c.d, "N0207", ints_get(c.dats, d), ints_get(c.date, d),
                                        cat3("the type `", name, "` is exported by two imported modules"), "",
                                        "there is no way to write which one is meant, so the ambiguity is refused where it is created rather than where it is used");
                                sec_at(c, ints_get(bstarts, first), ints_get(bends, first), "also brought in here");
                                sec_at(c, type_start(c, t), type_end(c, t), "exported here");
                            }
                        }
                    } else {
                        strs_push(bnames, name);
                        ints_push(bstarts, ints_get(c.dats, d));
                        ints_push(bends, ints_get(c.date, d));
                        set_type_name(c, name, t);
                    }
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    0
}

// A name in the module's types, replacing what it named before (a map's insert).
fn set_type_name(c: Ck, name: Str, t: Int) -> Int {
    let at = strs_find(c.tnames, name);
    if at >= 0 {
        ints_set(c.ttys, at, t);
        return 0;
    }
    strs_push(c.tnames, name);
    ints_push(c.ttys, t);
    0
}

// The types a module offers by name (`offered_types`): its `pub` records, then its `pub` enums.
fn offered_types(c: Ck, m: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && ints_get(c.rpub, i) == 1 { ints_push(out, record_ty(c, i, ints_new())); }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && ints_get(c.epub, i) == 1 { ints_push(out, enum_ty(c, i, ints_new())); }
        i = i + 1;
    }
    out
}

// A module's own type of this name, or -1.
fn own_type(c: Ck, m: Int, name: Str) -> Int {
    let r = declared_record(c, m, name);
    if r >= 0 { return record_ty(c, r, ints_new()); }
    let e = declared_enum(c, m, name);
    if e >= 0 { return enum_ty(c, e, ints_new()); }
    0 - 1
}

// A record's or an enum's declared name, and where it is written.
fn type_name(c: Ck, t: Int) -> Str {
    if is_record(c, t) { return strs_get(c.rname, ta(c, t)); }
    strs_get(c.ename, ta(c, t))
}
fn type_start(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rns, ta(c, t)); }
    ints_get(c.ens, ta(c, t))
}
fn type_end(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rne, ta(c, t)); }
    ints_get(c.ene, ta(c, t))
}

fn type_named(c: Ck, name: Str) -> Int {
    let i = strs_find(c.tnames, name);
    if i < 0 { return 0 - 1; }
    ints_get(c.ttys, i)
}

// --- written types (`resolve_written`) --------------------------------------------------------

// A type as written, resolved against the module's names and `scope` (type parameters by name),
// every mistake reported to `d` — the checker's own, or one that is thrown away.
// The bound on how deeply a written type may nest is checked once, at the top (N0338).
fn resolve_written(c: Ck, w: Int, pnames: Strs, ptys: Ints, d: Diags) -> Int {
    let t = resolve_written_inner(c, w, pnames, ptys, d);
    if nesting(c, t) > max_depth() {
        let span = fld(c, w, "span");
        dg_error(d, "N0338", sps(c, span), spe(c, span), "types may nest 32 deep", "",
                "each level multiplies the copy and cleanup code generated for every value of the outer type, so the bound is on the emitted program rather than on the compiler. It is stated rather than discovered");
        return t_int();
    }
    t
}

fn max_depth() -> Int { 32 }

// How deeply a type nests through its arguments (`nesting`): 1 for a type with none.
fn nesting(c: Ck, t: Int) -> Int {
    let mut deepest = 1;
    let mut i = 0;
    while i < targc(c, t) {
        let d = nesting(c, targ(c, t, i)) + 1;
        if d > deepest { deepest = d; }
        if deepest > max_depth() + 1 { return deepest; }
        i = i + 1;
    }
    deepest
}

fn resolve_written_inner(c: Ck, w: Int, pnames: Strs, ptys: Ints, d: Diags) -> Int {
    let name = fname_of(c, w, "name");
    let ns = fld(c, w, "name_span");
    let span = fld(c, w, "span");
    let has_args = some(c, w, "args");
    let args = ints_new();
    if has_args {
        let written = sx_items(c.t, unwrap(c, w, "args"));
        let mut i = 0;
        while i < ints_len(written) {
            ints_push(args, resolve_written_inner(c, ints_get(written, i), pnames, ptys, d));
            i = i + 1;
        }
    }
    if some(c, w, "function") || some(c, w, "length") || str_len(name) == 0 || starts_upper(name) == false {
        stop(c, cat3("the type `", name, "`"));
        return t_int();
    }
    // A qualified type names a module's definition (N49): never a type parameter, never `Vec`
    // or a built-in, which belong to no module.
    if some(c, w, "qualifier") {
        let t = resolve_name(c, written_key(c, w, "name"), ns, d);
        return applied_written(c, t, has_args, args, ns, span, d);
    }
    let at = strs_find(pnames, name);
    if at >= 0 {
        if has_args { not_generic(c, d, name, "a type parameter", span); }
        return ints_get(ptys, at);
    }
    if name == "Chan" && has_args {
        stop(c, "`Chan[T]`");
        return t_int();
    }
    if (name == "Box" || name == "Cell" || name == "Chain") && type_named(c, name) < 0 {
        stop(c, cat3("`", name, "`"));
        return t_int();
    }
    // `List[T]` (R1.5, D7) is `Vec[T]`: a prelude name, so a module's own type of the name keeps it.
    if name == "List" && type_named(c, name) < 0 {
        if has_args == false {
            dg_error(d, "N0352", sps(c, ns), spe(c, ns), "`List` is written with its element type", "",
                    "a list of `Int` is `List[Int]`; `List` alone is not a type");
            return t_int();
        }
        if ints_len(args) != 1 { wrong_arity(c, d, "List", 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        return vec_of(c, elem);
    }
    if name == "Vec" {
        if has_args == false {
            dg_error(d, "N0352", sps(c, ns), spe(c, ns), "`Vec` is written with its element type", "",
                    "a vector of `Int` is `Vec[Int]`; `Vec` alone is not a type");
            return t_int();
        }
        if ints_len(args) != 1 { wrong_arity(c, d, "Vec", 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        return vec_of(c, elem);
    }
    let t = resolve_name(c, name, ns, d);
    if is_builtin_name(name) {
        if has_args { not_generic(c, d, name, "a built-in type", span); }
        return t;
    }
    applied_written(c, t, has_args, args, ns, span, d)
}

// A record or an enum as written, applied to the arguments written after it: exactly as many as
// it declares.
fn applied_written(c: Ck, t: Int, has_args: Bool, args: Ints, ns: Int, span: Int, d: Diags) -> Int {
    if is_record(c, t) == false && is_enum(c, t) == false { return t; }
    let mut arity = 0;
    if is_record(c, t) { arity = ints_get(c.rnp, ta(c, t)); } else { arity = ints_get(c.enp, ta(c, t)); }
    if has_args == false {
        if arity == 0 { return t; }
        let shown = show(c, t);
        dg_error(d, "N0352", sps(c, ns), spe(c, ns),
                cat5("`", shown, "` is generic, so it is written with its ", int_to_str(arity), str_concat(" type argument", plural(arity))), "",
                cat5("write `", shown, "[…]` with ", int_to_str(arity), str_concat(" type", plural(arity))));
        let mut ds = 0;
        let mut de = 0;
        if is_record(c, t) { ds = ints_get(c.rns, ta(c, t)); de = ints_get(c.rne, ta(c, t)); } else {
            ds = ints_get(c.ens, ta(c, t));
            de = ints_get(c.ene, ta(c, t));
        }
        dg_secondary(d, ds, de, "declared here");
        return t_int();
    }
    if arity == 0 {
        not_generic(c, d, show(c, t), "not generic", span);
        return t;
    }
    if ints_len(args) != arity {
        wrong_arity(c, d, show(c, t), arity, ints_len(args), span);
        while ints_len(args) > arity { ints_pop(args); }
        while ints_len(args) < arity { ints_push(args, t_int()); }
    }
    if is_record(c, t) { return record_ty(c, ta(c, t), args); }
    enum_ty(c, ta(c, t), args)
}

fn not_generic(c: Ck, d: Diags, name: Str, what: Str, span: Int) -> Int {
    let mut why = cat5("`", name, "` is ", what, ", so it takes no type arguments");
    if what == "not generic" { why = cat3("`", name, "` is not generic, so it takes no type arguments"); }
    dg_error(d, "N0351", sps(c, span), spe(c, span), why, "",
            "only a definition that declares type parameters is applied to type arguments")
}

fn wrong_arity(c: Ck, d: Diags, name: Str, want: Int, got: Int, span: Int) -> Int {
    let mut verb = " were given";
    if got == 1 { verb = " was given"; }
    dg_error(d, "N0353", sps(c, span), spe(c, span),
            cat5(cat3("`", name, "` takes "), int_to_str(want), str_concat(" type argument", plural(want)), ", but ", str_concat(int_to_str(got), verb)), "",
            "a generic definition is applied to exactly as many types as it declares")
}

// A type name against the built-ins and then the module's types (`resolve_name`).
fn resolve_name(c: Ck, name: Str, span: Int, d: Diags) -> Int {
    if name == "Ints" { return t_ints(); }
    if name == "Strs" { return t_strs(); }
    if is_builtin_name(name) { return builtin_ty(c, name); }
    let t = type_named(c, name);
    if t >= 0 { return t; }
    // `Map[K, V]` (R1.5, D5): the standard hash map under a shorter name, where it is in scope.
    if name == "Map" && type_named(c, "HashMap") >= 0 { return type_named(c, "HashMap"); }
    if name == "Map" {
        dg_error(d, "N0305", sps(c, span), spe(c, span), "`Map` is `@std/hashmap`'s `HashMap`", "", "import it: `use \"@std/hashmap\";`");
        return t_int();
    }
    if str_has(name, "::") {
        unknown_qualified(c, d, name, c.taliases, sps(c, span), spe(c, span), "type");
        return t_int();
    }
    dg_error(d, "N0305", sps(c, span), spe(c, span), cat3("`", name, "` is not a type"), "",
            cat3("the built-in types are ", all_names(), ", and `struct` and `enum` declare others"));
    // A type that exists somewhere is more usefully reported as unreachable.
    let r = strs_find(c.rname, name);
    if r >= 0 {
        dg_secondary(d, ints_get(c.rns, r), ints_get(c.rne, r), "a type of this name is declared here");
    } else {
        let e = strs_find(c.ename, name);
        if e >= 0 { dg_secondary(d, ints_get(c.ens, e), ints_get(c.ene, e), "a type of this name is declared here"); }
    }
    t_int()
}

// --- stage 0b: fields (`resolve_type_fields`) --------------------------------------------------

fn resolve_type_fields(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    type_environment(c, m, true);
    let p = ints_get(c.mprog, m);
    let done = strs_new();
    let records = kids(c, p, "records");
    let mut i = 0;
    while i < ints_len(records) {
        let r = ints_get(records, i);
        let name = fname_of(c, r, "name");
        let id = declared_record(c, m, name);
        if id >= 0 && strs_find(done, name) < 0 {
            strs_push(done, name);
            let pn = strs_new();
            let pt = ints_new();
            type_params(c, r, own_record(), id, pn, pt);
            let written = kids(c, r, "fields");
            ints_set(c.rff, id, strs_len(c.fname));
            ints_set(c.rfc, id, resolve_fields(c, name, written, pn, pt));
            if ints_len(written) == 0 {
                err(c, "N0101", fld(c, r, "name_span"), cat3("`", name, "` has no fields, which is not supported yet"),
                        "a record with no fields would be built by writing `Name()`, which is exactly how a call to a function of that name is written — and types and functions are separate namespaces, so neither reading could be preferred. Give it a field, or use `Bool`");
            }
        }
        i = i + 1;
    }
    let enums = kids(c, p, "enums");
    i = 0;
    while i < ints_len(enums) {
        let e = ints_get(enums, i);
        let name = fname_of(c, e, "name");
        let id = declared_enum(c, m, name);
        if id >= 0 && strs_find(done, cat3("enum ", name, "")) < 0 {
            strs_push(done, cat3("enum ", name, ""));
            let variants = kids(c, e, "variants");
            if ints_len(variants) == 0 {
                err(c, "N0339", fld(c, e, "name_span"), cat3("`", name, "` has no variants, which is not supported yet"),
                        "a type with no values decides what a function returning one means and whether a `match` on one is exhaustive, and neither has been settled. Give it a variant");
            }
            let pn = strs_new();
            let pt = ints_new();
            type_params(c, e, own_enum(), id, pn, pt);
            // Variants are pooled in a run, so each one's fields are resolved first, into a
            // run of their own, and the run of variants is written after.
            let vnames = strs_new();
            let vstarts = ints_new();
            let vends = ints_new();
            let vff = ints_new();
            let vfc = ints_new();
            let mut k = 0;
            while k < ints_len(variants) {
                let v = ints_get(variants, k);
                let vn = fname_of(c, v, "name");
                let vs = fld(c, v, "name_span");
                let first = strs_find(vnames, vn);
                if first >= 0 {
                    err(c, "N0340", vs, cat5("`", name, "` has two variants called `", vn, "`"),
                            "a variant is identified by its name, so two cannot share one");
                    sec_at(c, ints_get(vstarts, first), ints_get(vends, first), "first declared here");
                } else {
                    strs_push(vnames, vn);
                    ints_push(vstarts, sps(c, vs));
                    ints_push(vends, spe(c, vs));
                    ints_push(vff, strs_len(c.fname));
                    ints_push(vfc, resolve_fields(c, vn, kids(c, v, "fields"), pn, pt));
                }
                k = k + 1;
            }
            ints_set(c.evf, id, strs_len(c.vname));
            ints_set(c.evc, id, strs_len(vnames));
            k = 0;
            while k < strs_len(vnames) {
                strs_push(c.vname, strs_get(vnames, k));
                ints_push(c.vns, ints_get(vstarts, k));
                ints_push(c.vne, ints_get(vends, k));
                ints_push(c.vff, ints_get(vff, k));
                ints_push(c.vfc, ints_get(vfc, k));
                k = k + 1;
            }
        }
        i = i + 1;
    }
    0
}

// A declaration's type parameters, in scope by name.
fn type_params(c: Ck, decl: Int, owner: Int, id: Int, pn: Strs, pt: Ints) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let n = fname_of(c, ints_get(params, i), "name");
        strs_push(pn, n);
        ints_push(pt, param_ty(c, owner, id, i, n));
        i = i + 1;
    }
    0
}

// Fields as written, each resolved, appended to the pool; how many were kept.
fn resolve_fields(c: Ck, owner: Str, written: Ints, pn: Strs, pt: Ints) -> Int {
    let first = strs_len(c.fname);
    let mut i = 0;
    while i < ints_len(written) {
        let f = ints_get(written, i);
        let name = fname_of(c, f, "name");
        let ns = fld(c, f, "name_span");
        let mut dup = 0 - 1;
        let mut k = first;
        while k < strs_len(c.fname) {
            if strs_get(c.fname, k) == name && dup < 0 { dup = k; }
            k = k + 1;
        }
        if dup >= 0 {
            err(c, "N0332", ns, cat5("`", owner, "` has two fields called `", name, "`"),
                    "a field is identified by its name, so two cannot share one");
            sec_at(c, ints_get(c.fns, dup), ints_get(c.fne, dup), "first declared here");
        } else {
            let ty = resolve_written(c, fld(c, f, "ty"), pn, pt, c.d);
            strs_push(c.fname, name);
            ints_push(c.fty, ty);
            ints_push(c.fns, sps(c, ns));
            ints_push(c.fne, spe(c, ns));
            let ts = fld(c, fld(c, f, "ty"), "span");
            ints_push(c.fts, sps(c, ts));
            ints_push(c.fte, spe(c, ts));
        }
        i = i + 1;
    }
    strs_len(c.fname) - first
}

// --- stage 0c: layouts --------------------------------------------------------------------------

// A record or enum that contains itself, inline or through a `Vec`, is refused by
// `validate_type_layouts`; this checker does not carry that refusal yet, so it stops at any cycle
// through the module's definitions.
fn validate_layouts(c: Ck) -> Int {
    let mut i = 0;
    while i < strs_len(c.rname) {
        if reaches(c, record_ty(c, i, ints_new()), record_ty(c, i, ints_new()), ints_new()) { stop(c, "a type that contains itself"); }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(c.ename) {
        if reaches(c, enum_ty(c, i, ints_new()), enum_ty(c, i, ints_new()), ints_new()) { stop(c, "a type that contains itself"); }
        i = i + 1;
    }
    0
}

// Whether `from`'s definition, through every definition its fields mention anywhere — inline,
// in a `Vec`, or as a type argument — reaches `target`'s definition. Over definitions rather
// than instances, so it ends, and it finds every cycle the reference could refuse (and more).
fn reaches(c: Ck, from: Int, target: Int, seen: Ints) -> Bool {
    // The definitions met, as `tag * 100000 + id`, and a worklist of them.
    let work = ints_new();
    ints_push(work, def_key(c, from));
    while ints_len(work) > 0 {
        let key = ints_pop(work);
        let node = def_of_key(c, key);
        let edges = contained(c, node);
        let mut i = 0;
        while i < ints_len(edges) {
            let mentioned = ints_new();
            mentioned_defs(c, ints_get(c.fty, ints_get(edges, i)), mentioned);
            let mut k = 0;
            while k < ints_len(mentioned) {
                let m = ints_get(mentioned, k);
                if m == def_key(c, target) { return true; }
                if index_of(seen, m) < 0 {
                    ints_push(seen, m);
                    ints_push(work, m);
                }
                k = k + 1;
            }
            i = i + 1;
        }
    }
    false
}

fn def_key(c: Ck, t: Int) -> Int { tag(c, t) * 100000 + ta(c, t) }
fn def_of_key(c: Ck, key: Int) -> Int {
    if key / 100000 == tag_record() { return record_ty(c, key % 100000, ints_new()); }
    enum_ty(c, key % 100000, ints_new())
}

// Every record and enum definition a type mentions, at any depth.
fn mentioned_defs(c: Ck, t: Int, out: Ints) -> Int {
    if is_record(c, t) || is_enum(c, t) { ints_push(out, def_key(c, t)); }
    let mut i = 0;
    while i < targc(c, t) {
        mentioned_defs(c, targ(c, t, i), out);
        i = i + 1;
    }
    0
}

// --- stage 1: functions (`declare_unit`) --------------------------------------------------------

fn declare_functions(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    type_environment(c, m, false);
    let p = ints_get(c.mprog, m);
    let functions = kids(c, p, "functions");
    let mut i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        let name = fname_of(c, f, "name");
        let ns = fld(c, f, "name_span");
        let params = kids(c, f, "params");
        // A generic function's parameter types mention its own parameters, which name it: the
        // id it would be declared under comes first.
        let id = strs_len(c.fnname);
        declared_type_params(c, f);
        let tps = kids(c, f, "type_params");
        let pn = strs_new();
        let pt = ints_new();
        let mut k = 0;
        while k < ints_len(tps) {
            let n = fname_of(c, ints_get(tps, k), "name");
            strs_push(pn, n);
            ints_push(pt, param_ty(c, own_fn(), id, k, n));
            k = k + 1;
        }
        let pf = ints_len(c.ptys);
        k = 0;
        while k < ints_len(params) {
            ints_push(c.ptys, resolve_written(c, fld(c, ints_get(params, k), "ty"), pn, pt, c.d));
            k = k + 1;
        }
        let rt = fld(c, f, "return_type");
        let ret = resolve_written(c, rt, pn, pt, c.d);
        let mut eff = 0 - 1;
        let mut ws = 0 - 1;
        let mut we = 0 - 1;
        if some(c, f, "effects") {
            let decl = unwrap(c, f, "effects");
            eff = declared_effects(c, decl);
            ws = sps(c, fld(c, decl, "span"));
            we = spe(c, fld(c, decl, "span"));
        }
        let b = builtin_index(c, name);
        let mut refused = false;
        if b >= 0 {
            if ints_get(c.bprelude, b) == 0 { refused = true; }
        }
        if name == "try_convert" || name == "wrap_convert" || name == "saturate_convert" || name == "println" || name == "eprintln" { refused = true; }
        if refused {
            err(c, "N0203", ns, cat3("`", name, "` is a built-in and cannot be redefined"),
                    "built-ins share the ordinary function namespace so that a call always means the same thing; choose another name");
        } else {
            let existing = defined_fn(c, m, name);
            if existing >= 0 {
                err(c, "N0203", ns, cat3("`", name, "` is defined more than once in this module"), "");
                sec_at(c, ints_get(c.fnns, existing), ints_get(c.fnne, existing), "first defined here");
            } else {
                strs_push(c.fnname, name);
                ints_push(c.fnmod, m);
                if some(c, f, "pub_span") { ints_push(c.fnpub, 1); } else { ints_push(c.fnpub, 0); }
                ints_push(c.fnns, sps(c, ns));
                ints_push(c.fnne, spe(c, ns));
                ints_push(c.fnnode, f);
                ints_push(c.fnpf, pf);
                ints_push(c.fnpc, ints_len(params));
                ints_push(c.fnret, ret);
                ints_push(c.fneff, eff);
                ints_push(c.fnws, ws);
                ints_push(c.fnwe, we);
                let rts = fld(c, rt, "span");
                if sx_s(c.t, rts) == sx_e(c.t, rts) { ints_push(c.fnnores, 1); } else { ints_push(c.fnnores, 0); }
                ints_push(c.fntpf, strs_len(c.tpname));
                ints_push(c.fntpc, strs_len(pn));
                k = 0;
                while k < strs_len(pn) {
                    strs_push(c.tpname, strs_get(pn, k));
                    ints_push(c.tpeq, 0);
                    k = k + 1;
                }
                requirements(c, f, true, id);
                if some(c, f, "pub_span") {
                    // A public signature naming a private type (`report_private_type`).
                    k = 0;
                    while k < ints_len(params) {
                        let pt = fld(c, fld(c, ints_get(params, k), "ty"), "span");
                        report_private_type(c, ints_get(c.ptys, pf + k), sps(c, pt), spe(c, pt), sps(c, ns), spe(c, ns), "function", name);
                        k = k + 1;
                    }
                    report_private_type(c, ret, sps(c, rts), spe(c, rts), sps(c, ns), spe(c, ns), "function", name);
                }
            }
        }
        i = i + 1;
    }
    report_exported_types(c, m);
    0
}

// The same check for each exported type's own fields, after the functions.
fn report_exported_types(c: Ck, m: Int) -> Int {
    let mut r = 0;
    while r < strs_len(c.rname) {
        if ints_get(c.rmod, r) == m && ints_get(c.rpub, r) == 1 {
            let mut i = 0;
            while i < ints_get(c.rfc, r) {
                let f = ints_get(c.rff, r) + i;
                report_private_type(c, ints_get(c.fty, f), ints_get(c.fts, f), ints_get(c.fte, f), ints_get(c.rns, r), ints_get(c.rne, r), "record",
                        strs_get(c.rname, r));
                i = i + 1;
            }
        }
        r = r + 1;
    }
    let mut e = 0;
    while e < strs_len(c.ename) {
        if ints_get(c.emod, e) == m && ints_get(c.epub, e) == 1 {
            let mut v = 0;
            while v < ints_get(c.evc, e) {
                let vi = ints_get(c.evf, e) + v;
                let mut i = 0;
                while i < ints_get(c.vfc, vi) {
                    let f = ints_get(c.vff, vi) + i;
                    report_private_type(c, ints_get(c.fty, f), ints_get(c.fts, f), ints_get(c.fte, f), ints_get(c.ens, e), ints_get(c.ene, e), "enum",
                            strs_get(c.ename, e));
                    i = i + 1;
                }
                v = v + 1;
            }
        }
        e = e + 1;
    }
    0
}

// `N0337`: a public item whose written type names a private definition, anywhere in it.
fn report_private_type(c: Ck, t: Int, s: Int, e: Int, is: Int, ie: Int, kind: Str, name: Str) -> Int {
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let u = ints_pop(work);
        let mut k = 0;
        while k < targc(c, u) {
            ints_push(work, targ(c, u, k));
            k = k + 1;
        }
        let mut pname = "";
        let mut ds = 0;
        let mut de = 0;
        if is_record(c, u) && ints_get(c.rpub, ta(c, u)) == 0 {
            pname = strs_get(c.rname, ta(c, u));
            ds = ints_get(c.rns, ta(c, u));
            de = ints_get(c.rne, ta(c, u));
        }
        if is_enum(c, u) && ints_get(c.epub, ta(c, u)) == 0 {
            pname = strs_get(c.ename, ta(c, u));
            ds = ints_get(c.ens, ta(c, u));
            de = ints_get(c.ene, ta(c, u));
        }
        if pname != "" {
            dg_error(c.d, "N0337", s, e, cat5("this public ", kind, " exposes `", pname, "`, which is private to this module"), "",
                    "an importer would have to name this type to use the item and cannot. Export the type with `pub`, or stop exporting the item");
            sec_at(c, is, ie, cat3("`", name, "` is public"));
            sec_at(c, ds, de, "declared without `pub` here");
            return 0;
        }
    }
    0
}

fn defined_fn(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.fnname) {
        if ints_get(c.fnmod, i) == m && strs_get(c.fnname, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- the rules about `main` -----------------------------------------------------------------

fn main_rules(c: Ck) -> Int {
    ss(c, s_module(), 0);
    let id = defined_fn(c, 0, "main");
    if id >= 0 {
        let f = ints_get(c.fnnode, id);
        // `main` cannot be generic: there is no caller to choose its type arguments.
        if ints_get(c.fntpc, id) > 0 {
            dg_error(c.d, "N0356", ints_get(c.fnns, id), ints_get(c.fnne, id), "`main` cannot be generic", "",
                    "the process entry is called by nothing that could choose its type arguments. Make `main` concrete and call a generic function from it");
        }
        let params = kids(c, f, "params");
        let mut i = 0;
        while i < ints_get(c.fnpc, id) {
            let t = ints_get(c.ptys, ints_get(c.fnpf, id) + i);
            if is_cap(c, t) == false {
                err(c, "N0371", fld(c, ints_get(params, i), "span"), "a parameter of `main` must be a capability",
                        "the runtime calls `main`, and what it can hand over is authority: `IoCap` and `SpawnCap`. Read the command line with `arg` instead");
            }
            i = i + 1;
        }
        return 0;
    }
    dg_error(c.d, "N0204", 0, 0, "this program has no `main` function", "", "`nazm run` evaluates `fn main() -> Int` in the file you named");
    0
}

// --- stage 2: bodies (`check_unit`) -----------------------------------------------------------

// How an expression or a block completes: a value's type (0 and up), nothing, or never.
fn unit() -> Int { 0 - 1 }
fn diverges() -> Int { 0 - 2 }
fn none() -> Int { 0 - 1 }

fn check_unit(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    environment(c, m);
    type_environment(c, m, false);
    let p = ints_get(c.mprog, m);
    let functions = kids(c, p, "functions");
    let mut i = 0;
    while i < ints_len(functions) {
        check_function(c, ints_get(functions, i));
        i = i + 1;
    }
    0
}

// The names module `m` may call beyond its own functions and the built-ins (`environment`):
// each direct import's exports, as `alias::name` under each name it is imported by — an alias
// that already names something here refused (N0209) — and plainly where a plain `use` named it,
// an export this module also defines (N0208) or another import brought in (N0207) refused.
fn environment(c: Ck, m: Int) -> Int {
    while strs_len(c.envname) > 0 {
        strs_pop(c.envname);
        ints_pop(c.envfn);
    }
    while strs_len(c.alname) > 0 {
        strs_pop(c.alname);
        ints_pop(c.almod);
    }
    // Where each alias is written, and which import brought each plain name in.
    let alstart = ints_new();
    let alend = ints_new();
    let bstarts = ints_new();
    let bends = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        let on = ints_get(c.don, d);
        let mut a = 0;
        while a < ints_get(c.dac, d) {
            let ai = ints_get(c.daf, d) + a;
            let alias = strs_get(c.aname, ai);
            let at_s = ints_get(c.aats, ai);
            let at_e = ints_get(c.aate, ai);
            let mut what = "";
            let mut os = 0;
            let mut oe = 0;
            let first = strs_find(c.alname, alias);
            let own = defined_fn(c, m, alias);
            let brought = strs_find(c.envname, alias);
            if first >= 0 {
                what = "another import already has this name";
                os = ints_get(alstart, first);
                oe = ints_get(alend, first);
            } else {
                if own >= 0 || brought >= 0 {
                    let mut f = own;
                    if f < 0 { f = ints_get(c.envfn, brought); }
                    what = "a function of this module";
                    os = ints_get(c.fnns, f);
                    oe = ints_get(c.fnne, f);
                } else {
                    if declared_record(c, m, alias) >= 0 || declared_enum(c, m, alias) >= 0 {
                        what = "a type of this module";
                        os = at_s;
                        oe = at_e;
                    }
                }
            }
            if what != "" {
                dg_error(c.d, "N0209", at_s, at_e, cat4("`", alias, "` already names ", what), "",
                        "an import's name is written before `::` and must mean only that module here: choose another");
                sec_at(c, os, oe, "the other meaning");
            } else {
                strs_push(c.alname, alias);
                ints_push(c.almod, on);
                ints_push(alstart, at_s);
                ints_push(alend, at_e);
            }
            a = a + 1;
        }
        if ints_get(c.dplain, d) == 1 {
            let mut f = 0;
            while f < strs_len(c.fnname) {
                if ints_get(c.fnmod, f) == on && ints_get(c.fnpub, f) == 1 {
                    let name = strs_get(c.fnname, f);
                    let own = defined_fn(c, m, name);
                    let first = strs_find(c.envname, name);
                    if own >= 0 {
                        dg_error(c.d, "N0208", ints_get(c.dats, d), ints_get(c.date, d), cat3("this import brings in `", name, "`, which this module defines"), "",
                                "an imported name and a local one are not ranked: rename one of them, or stop exporting the other");
                        sec_at(c, ints_get(c.fnns, own), ints_get(c.fnne, own), "defined here");
                        sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "and exported here");
                    } else {
                        if first >= 0 {
                            dg_error(c.d, "N0207", ints_get(c.dats, d), ints_get(c.date, d), cat3("`", name, "` is exported by two imported modules"), "",
                                    "there is no way to write which one is meant, so the ambiguity is refused where it is created rather than where it is used");
                            sec_at(c, ints_get(bstarts, first), ints_get(bends, first), "also brought in here");
                            sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "exported here");
                        } else {
                            strs_push(c.envname, name);
                            ints_push(c.envfn, f);
                            ints_push(bstarts, ints_get(c.dats, d));
                            ints_push(bends, ints_get(c.date, d));
                        }
                    }
                }
                f = f + 1;
            }
        }
        k = k + 1;
    }
    0
}

// A type in the function's signature, resolved again silently: stage 1 reported it.
fn signature_type(c: Ck, w: Int) -> Int { resolve_written(c, w, c.tsn, c.tst, dg_new()) }

fn check_function(c: Ck, f: Int) -> Int {
    let name = fname_of(c, f, "name");
    let id = defined_fn(c, gs(c, s_module()), name);
    ss(c, s_fn(), id);
    // The function's own type parameters are in scope for every type written inside it.
    while strs_len(c.tsn) > 0 {
        strs_pop(c.tsn);
        ints_pop(c.tst);
    }
    let tps = kids(c, f, "type_params");
    let mut k = 0;
    while k < ints_len(tps) {
        if id >= 0 {
            strs_push(c.tsn, fname_of(c, ints_get(tps, k), "name"));
            ints_push(c.tst, fn_param_ty(c, id, k));
        }
        k = k + 1;
    }
    open_scope(c);
    let params = kids(c, f, "params");
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let ty = signature_type(c, fld(c, p, "ty"));
        let pn = fname_of(c, p, "name");
        if defined_here(c, pn) {
            err(c, "N0202", fld(c, p, "span"), cat3("`", pn, "` is listed twice in this parameter list"), "");
        }
        define(c, pn, ty, false, 0 - 1, 0 - 1);
        i = i + 1;
    }
    let rt = fld(c, f, "return_type");
    let declared = signature_type(c, rt);
    let rts = fld(c, rt, "span");
    let body = unwrap(c, f, "body");
    ss(c, s_ret(), declared);
    ss(c, s_rs(), rts);
    ss(c, s_loop(), 0);
    let completion = check_block(c, body, declared);
    if completion >= 0 && assignable(c, completion, declared) == false {
        let shown = show(c, completion);
        let want = show(c, declared);
        let mut at = fld(c, body, "span");
        if some(c, body, "tail") { at = espan(c, unwrap(c, body, "tail")); }
        err(c, "N0300", at, cat5(cat3("`", name, "` returns `"), shown, "`, but its signature says `", want, "`"), "");
        sec(c, rts, cat3("declared `", want, "` here"));
    }
    if completion == unit() {
        let want = show(c, declared);
        err(c, "N0300", fld(c, body, "span"), cat5("`", name, "` must produce a `", want, "`, but this body does not"),
                "a function's value is its final expression — one with no `;` after it — or it returns on every path");
        sec(c, rts, cat3("declared `", want, "` here"));
    }
    close_scope(c);
    0
}

fn assignable(c: Ck, got: Int, want: Int) -> Bool {
    if got == want { return true; }
    bname_of(c, got) == "IoCap" && bname_of(c, want) == "OutCap"
}

// --- scopes -------------------------------------------------------------------------------------

fn open_scope(c: Ck) -> Int {
    ints_push(c.frames, strs_len(c.sname));
    0
}

fn close_scope(c: Ck) -> Int {
    let start = ints_pop(c.frames);
    while strs_len(c.sname) > start {
        strs_pop(c.sname);
        ints_pop(c.sty);
        ints_pop(c.smut);
        ints_pop(c.sds);
        ints_pop(c.sde);
    }
    0
}

// A binding; `ds` and `de` where its name is declared, or -1 for a parameter.
fn define(c: Ck, name: Str, ty: Int, mutable: Bool, ds: Int, de: Int) -> Int {
    strs_push(c.sname, name);
    ints_push(c.sty, ty);
    if mutable { ints_push(c.smut, 1); } else { ints_push(c.smut, 0); }
    ints_push(c.sds, ds);
    ints_push(c.sde, de);
    0
}

fn lookup(c: Ck, name: Str) -> Int {
    let mut i = strs_len(c.sname) - 1;
    while i >= 0 {
        if strs_get(c.sname, i) == name { return i; }
        i = i - 1;
    }
    0 - 1
}

fn defined_here(c: Ck, name: Str) -> Bool {
    let mut i = ints_get(c.frames, ints_len(c.frames) - 1);
    while i < strs_len(c.sname) {
        if strs_get(c.sname, i) == name { return true; }
        i = i + 1;
    }
    false
}

// --- blocks and statements ----------------------------------------------------------------------

fn check_block(c: Ck, b: Int, expected: Int) -> Int {
    open_scope(c);
    let completion = check_block_inner(c, b, expected);
    close_scope(c);
    completion
}

fn check_block_inner(c: Ck, b: Int, expected: Int) -> Int {
    let discard = gs(c, s_discard());
    ss(c, s_discard(), 0);
    let mut diverged = 0 - 1;
    let statements = kids(c, b, "statements");
    let mut i = 0;
    while i < ints_len(statements) {
        let s = ints_get(statements, i);
        if diverged >= 0 {
            err(c, "N0313", stmt_span(c, s), "this can never run", "");
            sec(c, diverged, "control leaves the block here");
            diverged = 0 - 1;
        }
        if check_stmt(c, s) { diverged = stmt_span(c, s); }
        i = i + 1;
    }
    if diverged >= 0 {
        if some(c, b, "tail") {
            let ts = espan(c, unwrap(c, b, "tail"));
            if sx_s(c.t, ts) != sx_e(c.t, ts) { err(c, "N0313", ts, "this can never run", ""); }
        }
        return diverges();
    }
    if some(c, b, "tail") {
        ss(c, s_unwanted(), discard);
        return check_expr(c, unwrap(c, b, "tail"), expected);
    }
    unit()
}

// One statement; whether it diverges.
fn check_stmt(c: Ck, s: Int) -> Bool {
    let k = kind_of(c, s);
    if sx_kind(c.t, s) != tk_tuple() {
        if k == "Break" { check_loop_control(c, "break", fld(c, s, "span")); }
        if k == "Continue" { check_loop_control(c, "continue", fld(c, s, "span")); }
        if k == "Break" || k == "Continue" { return true; }
        stop(c, cat3("the statement `", k, "`"));
        return false;
    }
    let n = sx_kid(c.t, s, 0);
    if k == "Expr" {
        ss(c, s_unwanted(), 1);
        return check_expr(c, n, none()) == diverges();
    }
    if k == "Let" {
        check_let(c, n);
        return false;
    }
    if k == "Assign" {
        check_assign(c, n);
        return false;
    }
    if k == "While" {
        check_while(c, n);
        return false;
    }
    if k == "Return" {
        check_return(c, n);
        return true;
    }
    stop(c, cat3("the statement `", k, "`"));
    false
}

fn check_let(c: Ck, l: Int) -> Int {
    let name = fname_of(c, l, "name");
    let value = fld(c, l, "value");
    let mut ty = 0;
    if some(c, l, "ty") {
        let want = resolve_written(c, unwrap(c, l, "ty"), c.tsn, c.tst, c.d);
        let got = value_type(c, value, want);
        if assignable(c, got, want) == false {
            err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is written `"), show(c, want), "`, but this is `", show(c, got), "`"), "");
        }
        ty = want;
    } else {
        ty = value_type(c, value, none());
    }
    let ns = fld(c, l, "name_span");
    if defined_here(c, name) {
        err(c, "N0202", ns, cat3("`", name, "` is already defined in this scope"),
                "Nazm allows shadowing in a nested scope but not in the same one, so a later mention of a name is never ambiguous");
    }
    define(c, name, ty, flag(c, l, "mutable"), sps(c, ns), spe(c, ns));
    0
}

fn check_assign(c: Ck, a: Int) -> Int {
    let place = fld(c, a, "place");
    let name = fname_of(c, place, "name");
    let ns = fld(c, place, "name_span");
    let value = fld(c, a, "value");
    let b = lookup(c, name);
    if b < 0 {
        err(c, "N0200", ns, cat3("`", name, "` is not defined"), "assignment changes an existing binding; `let` introduces one");
        check_expr(c, value, none());
        return 0;
    }
    let path = kids(c, place, "path");
    let shown = strs_new();
    let mut i = 0;
    while i < ints_len(path) {
        let step = ints_get(path, i);
        if sx_kind(c.t, step) != tk_tuple() {
            stop(c, "an index in an assignment");
            return 0;
        }
        strs_push(shown, fname_of(c, sx_kid(c.t, step, 0), "name"));
        i = i + 1;
    }
    if ints_get(c.smut, b) == 0 {
        let mut written = cat3("`", name, "` is not mutable");
        if ints_len(path) > 0 { written = cat5("`", name, "` is not mutable, so its `", str_join(shown, "."), "` cannot be replaced"); }
        if ints_get(c.sds, b) >= 0 {
            err(c, "N0310", ns, written, "bindings are immutable unless written `let mut`");
            sec_at(c, ints_get(c.sds, b), ints_get(c.sde, b), "declared here");
            dg_fix(c.d, ints_get(c.sds, b), ints_get(c.sde, b), str_concat("mut ", name), "make the binding mutable", "automatic",
                    "`mut` is the only thing making this assignment illegal, and adding it to a declaration changes nothing else about the program");
        } else {
            err(c, "N0310", ns, written,
                    "this is a parameter, and parameters are never mutable. Bind a local from it instead: `let mut n = n;`");
        }
    }
    let mut target = ints_get(c.sty, b);
    let mut ds = ints_get(c.sds, b);
    let mut de = ints_get(c.sde, b);
    i = 0;
    while i < ints_len(path) {
        let step = sx_kid(c.t, ints_get(path, i), 0);
        let t = check_projection(c, target, fname_of(c, step, "name"), fld(c, step, "name_span"));
        if t < 0 {
            check_expr(c, value, none());
            return 0;
        }
        let f = record_field(c, target, fname_of(c, step, "name"));
        ds = ints_get(c.fns, f);
        de = ints_get(c.fne, f);
        target = t;
        i = i + 1;
    }
    let vt = value_type(c, value, target);
    if vt != target {
        let mut written = name;
        if ints_len(path) > 0 { written = cat3(name, ".", str_join(shown, ".")); }
        let want = show(c, target);
        err(c, "N0300", espan(c, value), cat5(cat3("`", written, "` is `"), want, "`, but this is `", show(c, vt), "`"), "");
        if ds >= 0 { sec_at(c, ds, de, cat3("declared `", want, "` here")); }
    }
    0
}

fn check_while(c: Ck, w: Int) -> Int {
    let cond = fld(c, w, "cond");
    let ct = value_type(c, cond, t_bool());
    if ct != t_bool() {
        err(c, "N0301", espan(c, cond), cat3("a `while` condition must be `Bool`, but this is `", show(c, ct), "`"),
                "Nazm has no truthiness: use a comparison such as `i < n`");
    }
    ss(c, s_loop(), gs(c, s_loop()) + 1);
    ss(c, s_discard(), 1);
    check_block(c, fld(c, w, "body"), none());
    ss(c, s_loop(), gs(c, s_loop()) - 1);
    0
}

fn check_return(c: Ck, r: Int) -> Int {
    let declared = gs(c, s_ret());
    let value = fld(c, r, "value");
    let actual = value_type(c, value, declared);
    if assignable(c, actual, declared) == false {
        err(c, "N0300", espan(c, value), cat5("this returns `", show(c, actual), "`, but the function returns `", show(c, declared), "`"),
                "`return` leaves the function, so its value must match the signature");
    }
    0
}

fn check_loop_control(c: Ck, word: Str, span: Int) -> Int {
    if gs(c, s_loop()) == 0 {
        err(c, "N0312", span, cat3("`", word, "` is only valid inside a loop"), cat3("there is no enclosing `while` for this `", word, "` to affect"));
    }
    0
}

// The type of an expression used where a value is required.
fn value_type(c: Ck, e: Int, expected: Int) -> Int {
    let k = check_expr(c, e, expected);
    if k >= 0 { return k; }
    if k == unit() {
        err(c, "N0300", espan(c, e), "this produces no value",
                "an `if` used as a value needs an `else`, and a block used as one needs a final expression with no `;` after it");
    }
    or_int(expected)
}

fn or_int(expected: Int) -> Int {
    if expected >= 0 { return expected; }
    t_int()
}

// --- expressions --------------------------------------------------------------------------------

fn check_expr(c: Ck, e: Int, expected: Int) -> Int {
    let unwanted = gs(c, s_unwanted()) != 0;
    ss(c, s_unwanted(), 0);
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() {
        if k == "Block" { return check_block(c, sx_kid(c.t, e, 0), expected); }
        stop(c, cat3("the expression `", k, "`"));
        return or_int(expected);
    }
    if k == "Int" {
        if expected >= 0 && is_num(c, expected) && expected != t_int() { stop(c, "a literal of a numeric type"); }
        return t_int();
    }
    if k == "Bool" { return t_bool(); }
    if k == "Str" {
        if expected >= 0 && bname_of(c, expected) == "Text" { stop(c, "a `Text` literal"); }
        return t_str();
    }
    if k == "Var" { return check_var(c, e, expected); }
    if k == "Neg" { return check_negation(c, e, expected); }
    if k == "Not" {
        let t = value_type(c, fld(c, e, "operand"), t_bool());
        if t != t_bool() { err(c, "N0304", fld(c, e, "op_span"), cat3("`!` applies to `Bool`, but this is `", show(c, t), "`"), ""); }
        return t_bool();
    }
    if k == "Binary" { return check_binary(c, e, expected); }
    if k == "Call" { return check_call(c, e, expected, unwanted); }
    if k == "Construct" {
        let t = check_construction(c, written_key(c, e, "ty"), fld(c, e, "ty_span"), type_args_of(c, e), written_inits(c, kids(c, e, "fields")),
                fld(c, e, "span"), expected);
        if t < 0 { return t_int(); }
        return t;
    }
    if k == "Variant" {
        let inits = written_inits(c, kids(c, e, "fields"));
        if some(c, e, "qualifier") == false && ints_len(inits.vals) == 0 && some(c, e, "type_args") == false && lookup(c, fname_of(c, e, "ty")) >= 0 {
            stop(c, "a method call");
            return or_int(expected);
        }
        let t = check_variant(c, written_key(c, e, "ty"), fld(c, e, "ty_span"), type_args_of(c, e), fname_of(c, e, "variant"), fld(c, e, "variant_span"),
                inits, fld(c, e, "span"), expected);
        if t < 0 { return or_int(expected); }
        return t;
    }
    if k == "Field" {
        let bt = value_type(c, fld(c, e, "base"), none());
        let t = check_projection(c, bt, fname_of(c, e, "name"), fld(c, e, "name_span"));
        if t < 0 { return t_int(); }
        return t;
    }
    if k == "If" { return check_if(c, e, expected, unwanted); }
    if k == "Match" { return check_match(c, e, expected); }
    if k == "Propagate" { return check_propagate(c, e, expected); }
    if k == "Interp" {
        // `f"…"` (L4), and what `print(x)` is written as: a `Str`, each hole a value
        // interpolation writes.
        let parts = kids(c, e, "parts");
        let mut i = 0;
        while i < ints_len(parts) {
            let part = ints_get(parts, i);
            if sx_kind(c.t, part) != tk_tuple() { check_hole(c, fld(c, part, "expr"), fld(c, part, "spec"), fld(c, part, "span")); }
            i = i + 1;
        }
        return t_str();
    }
    stop(c, cat3("the expression `", k, "`"));
    or_int(expected)
}

// A name written with an optional qualifier, as the key it is looked up by (`written_key`):
// `alias::name`.
fn written_key(c: Ck, n: Int, field: Str) -> Str {
    let name = fname_of(c, n, field);
    if some(c, n, "qualifier") { return cat3(fname_of(c, unwrap(c, n, "qualifier"), "name"), "::", name); }
    name
}

// One hole of an interpolation (`check_hole`): a precision only on a float; a `Str`, a number or
// a `Bool` written as it is, and anything else by its `Show` — which needs a trait, and no
// compilation the checker carries has one, so it is refused (N0300).
fn check_hole(c: Ck, expr: Int, spec: Int, at: Int) -> Int {
    let ty = value_type(c, expr, none());
    let float = is_float_name(bname_of(c, ty));
    if some(c, spec, "precision") && float == false {
        err(c, "N0006", at, cat3("a precision is a float's, and this is `", show(c, ty), "`"),
                "write the hole without `.precision`, or convert the value to a float");
    }
    if ty == t_str() || ty == t_int() || ty == t_bool() || is_num(c, ty) { return 0; }
    let shown = show(c, ty);
    err(c, "N0300", espan(c, expr), cat3("a value printed or interpolated is a `Str`, a number, a `Bool` or a `Show`, and this is `", shown, "`"),
            cat3("implement `Show` (`@std/show`) for `", shown, "`, or write the value's text yourself"))
}

fn check_var(c: Ck, e: Int, expected: Int) -> Int {
    let name = fname_of(c, e, "name");
    let span = fld(c, e, "span");
    let b = lookup(c, name);
    if b >= 0 { return ints_get(c.sty, b); }
    if env_has(c, name) {
        stop(c, "a function as a value");
        return or_int(expected);
    }
    if starts_upper(name) && ints_len(variant_owners(c, name)) > 0 {
        let t = check_construction(c, name, span, 0 - 1, no_inits(), span, expected);
        if t < 0 { return or_int(expected); }
        return t;
    }
    err(c, "N0200", span, cat3("`", name, "` is not defined"), "");
    or_int(expected)
}

fn check_negation(c: Ck, e: Int, expected: Int) -> Int {
    let operand = fld(c, e, "operand");
    if kind_of(c, operand) == "WideInt" {
        stop(c, "a wide integer");
        return t_int();
    }
    let mut hint = t_int();
    if expected >= 0 && is_num(c, expected) { hint = expected; }
    let t = value_type(c, operand, hint);
    if is_num(c, t) == false {
        err(c, "N0304", fld(c, e, "op_span"), cat3("`-` applies to a number, but this is `", show(c, t), "`"), "");
        return t_int();
    }
    t
}

fn is_number_literal(c: Ck, e: Int) -> Bool {
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() { return false; }
    if k == "Int" || k == "WideInt" || k == "Float" { return true; }
    if k == "Neg" { return is_number_literal(c, fld(c, e, "operand")); }
    false
}

fn is_comparison(op: Str) -> Bool { op == "Eq" || op == "NotEq" || op == "Lt" || op == "LtEq" || op == "Gt" || op == "GtEq" }
fn is_logical(op: Str) -> Bool { op == "And" || op == "Or" }
fn is_equality(op: Str) -> Bool { op == "Eq" || op == "NotEq" }
fn is_order(op: Str) -> Bool { op == "Lt" || op == "LtEq" || op == "Gt" || op == "GtEq" }

fn symbol(op: Str) -> Str {
    if op == "Add" { return "+"; }
    if op == "Sub" { return "-"; }
    if op == "Mul" { return "*"; }
    if op == "Div" { return "/"; }
    if op == "Rem" { return "%"; }
    if op == "Eq" { return "=="; }
    if op == "NotEq" { return "!="; }
    if op == "Lt" { return "<"; }
    if op == "LtEq" { return "<="; }
    if op == "Gt" { return ">"; }
    if op == "GtEq" { return ">="; }
    if op == "And" { return "&&"; }
    if op == "Or" { return "||"; }
    if op == "BitAnd" { return "&"; }
    if op == "BitOr" { return "|"; }
    if op == "BitXor" { return "^"; }
    if op == "Shl" { return "<<"; }
    ">>"
}

fn check_binary(c: Ck, e: Int, expected: Int) -> Int {
    let op = sx_text(c.t, fld(c, e, "op"));
    let lhs = fld(c, e, "lhs");
    let rhs = fld(c, e, "rhs");
    let op_span = fld(c, e, "op_span");
    if op == "Shl" || op == "Shr" {
        stop(c, "a shift");
        return t_int();
    }
    let before = dg_len(c.d);
    let mut hint = none();
    if is_comparison(op) == false && is_logical(op) == false {
        if expected >= 0 && is_num(c, expected) { hint = expected; }
    }
    let lit_first = is_number_literal(c, lhs) && is_number_literal(c, rhs) == false;
    let str_first = kind_of(c, lhs) == "Str" && kind_of(c, rhs) != "Str";
    let mut lt = 0;
    let mut rt = 0;
    if lit_first || str_first {
        rt = value_type(c, rhs, hint);
        let mut h = hint;
        if takes_literal(c, rt) { h = rt; }
        lt = value_type(c, lhs, h);
    } else {
        lt = value_type(c, lhs, hint);
        let mut h = hint;
        if takes_literal(c, lt) { h = lt; }
        rt = value_type(c, rhs, h);
    }
    // `s + t` on two `Str`s (R1, 5b.6): `str_concat(s, t)`, a `Str`.
    if op == "Add" && lt == t_str() && rt == t_str() && dg_len(c.d) == before { return t_str(); }
    let mut ok = false;
    if op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" { ok = lt == rt && is_num(c, lt); }
    if is_order(op) { ok = lt == rt && ordering(c, lt) == ""; }
    if op == "BitAnd" || op == "BitOr" || op == "BitXor" { ok = lt == rt && is_integer(c, lt); }
    if is_equality(op) { ok = lt == rt && derived(c, lt, true) == ""; }
    if is_logical(op) { ok = lt == t_bool() && rt == t_bool(); }
    if ok {
        if is_comparison(op) || is_logical(op) { return t_bool(); }
        return lt;
    }
    let mut verb = "combine";
    if is_comparison(op) { verb = "compare"; }
    let slt = show(c, lt);
    let srt = show(c, rt);
    let mut blocked = "";
    if lt == rt {
        if is_equality(op) { blocked = derived(c, lt, true); }
        if is_order(op) { blocked = ordering(c, lt); }
    }
    let mut property = "order";
    if is_equality(op) { property = "equality"; }
    let mut detail = "";
    if blocked != "" && derived_path(c, blocked) != "" {
        detail = cat5(cat3("`", symbol(op), "` does not apply to `"), slt, "`: its `", derived_path(c, blocked),
                cat4("` is a `", show(c, derived_type(c, blocked)), "`, which has no ", property));
    } else {
        if lt == rt { detail = cat5("`", symbol(op), "` does not apply to `", slt, "`"); } else {
            detail = cat5(cat3("`", symbol(op), "` cannot "), verb, " `", slt, cat3("` with `", srt, "`"));
        }
    }
    // A type parameter without a requirement is the one blocker the author can lift where they
    // stand, by declaring it (N14).
    let mut help = "";
    if blocked != "" && is_equality(op) && tag(c, derived_type(c, blocked)) == tag_param() {
        let p = show(c, derived_type(c, blocked));
        help = cat5("`", p, "` is not known to have equality, because its declaration does not require it; a definition that compares one declares `",
                p, ": Equality`");
    }
    err(c, "N0304", op_span, detail, help);
    sec(c, espan(c, lhs), cat3("this is `", slt, "`"));
    sec(c, espan(c, rhs), cat3("this is `", srt, "`"));
    if expected >= 0 { return expected; }
    if is_comparison(op) || is_logical(op) { return t_bool(); }
    if is_num(c, lt) { return lt; }
    t_int()
}

fn takes_literal(c: Ck, t: Int) -> Bool { is_num(c, t) || bname_of(c, t) == "Text" }

fn ordering(c: Ck, t: Int) -> Str {
    if is_float_name(bname_of(c, t)) { return ""; }
    derived(c, t, false)
}

fn check_if(c: Ck, e: Int, expected: Int, unwanted: Bool) -> Int {
    let cond = fld(c, e, "cond");
    let ct = value_type(c, cond, t_bool());
    if ct != t_bool() {
        err(c, "N0301", espan(c, cond), cat3("an `if` condition must be `Bool`, but this is `", show(c, ct), "`"),
                "Nazm has no truthiness: use a comparison such as `x != 0`");
    }
    let then_block = fld(c, e, "then_block");
    if unwanted { ss(c, s_discard(), 1); } else { ss(c, s_discard(), 0); }
    let a = check_block(c, then_block, expected);
    if some(c, e, "else_block") == false { return unit(); }
    let else_block = unwrap(c, e, "else_block");
    if unwanted { ss(c, s_discard(), 1); } else { ss(c, s_discard(), 0); }
    let mut want = expected;
    if want < 0 && a >= 0 { want = a; }
    if unwanted { want = none(); }
    let b = check_block(c, else_block, want);
    if a == diverges() { return b; }
    if b == diverges() { return a; }
    if a >= 0 && b >= 0 && a == b { return a; }
    if unwanted && (a >= 0 || b >= 0) { return unit(); }
    if a >= 0 && b >= 0 {
        let sa = show(c, a);
        let sb = show(c, b);
        let mut at = fld(c, else_block, "span");
        if some(c, else_block, "tail") { at = espan(c, unwrap(c, else_block, "tail")); }
        let mut other = fld(c, then_block, "span");
        if some(c, then_block, "tail") { other = espan(c, unwrap(c, then_block, "tail")); }
        err(c, "N0302", at, cat5("this branch is `", sb, "`, but the other is `", sa, "`"), "both branches of an `if` must have the same type");
        sec(c, other, cat3("this one is `", sa, "`"));
        return a;
    }
    if a >= 0 || b >= 0 {
        let mut v = a;
        if b >= 0 { v = b; }
        err(c, "N0302", fld(c, e, "span"), cat3("one branch produces `", show(c, v), "` and the other produces nothing"),
                "both branches of an `if` must agree, or neither may produce a value");
        return v;
    }
    unit()
}

// --- calls ----------------------------------------------------------------------------------------

// What a name calls: a function of this module (0 and up), a built-in (-2 and down), or nothing.
fn callee_of(c: Ck, name: Str) -> Int {
    let f = defined_fn(c, gs(c, s_module()), name);
    if f >= 0 { return f; }
    let imported = strs_find(c.envname, name);
    if imported >= 0 { return ints_get(c.envfn, imported); }
    let b = builtin_index(c, name);
    if b >= 0 { return 0 - 2 - b; }
    0 - 1
}

fn env_has(c: Ck, name: Str) -> Bool { callee_of(c, name) != 0 - 1 }

// What `alias::name` calls: an export of the module imported under `alias`, or -1.
fn qualified_callee(c: Ck, alias: Str, name: Str) -> Int {
    let a = strs_find(c.alname, alias);
    if a < 0 { return 0 - 1; }
    let m = ints_get(c.almod, a);
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if ints_get(c.fnmod, f) == m && ints_get(c.fnpub, f) == 1 && strs_get(c.fnname, f) == name { return f; }
        f = f + 1;
    }
    0 - 1
}

// `NAME::item` that resolves to nothing (N0210): `NAME` is no alias, or its module exports no
// `item`.
fn unknown_qualified(c: Ck, d: Diags, key: Str, aliases: Strs, s: Int, e: Int, what: Str) -> Int {
    let mut i = 0;
    while i + 1 < str_len(key) && str_slice(key, i, i + 2) != "::" { i = i + 1; }
    let alias = str_slice(key, 0, i);
    let item = str_slice(key, i + 2, str_len(key));
    if strs_find(aliases, alias) >= 0 {
        return dg_error(d, "N0210", s, e, cat5("the module imported as `", alias, "` exports no ", what, cat3(" `", item, "`")), "",
                cat3("`", alias, "::` names what that module marks `pub`; check the name, or export it there"));
    }
    dg_error(d, "N0210", s, e, cat3("`", alias, "` is not the name of an imported module"), "",
            cat3("import one under that name: `use \"path.nz\" as ", alias, ";`"))
}

fn sorted(xs: Strs) -> Strs {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(xs) {
        let x = strs_get(xs, i);
        let mut at = 0;
        while at < strs_len(out) && str_less(strs_get(out, at), x) { at = at + 1; }
        insert_str(out, at, x);
        i = i + 1;
    }
    out
}

// Why this module cannot call `name` when something in the compilation has it (`why_invisible`),
// reported; false when nothing does. A private function of a module this one imports is N0206;
// an exported one of a module it does not import, N0201 with where it is.
fn why_invisible(c: Ck, name: Str, at: Int) -> Bool {
    let m = gs(c, s_module());
    let mut elsewhere = 0 - 1;
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if strs_get(c.fnname, f) == name {
            let owner = ints_get(c.fnmod, f);
            if imports_module(c, m, owner) && ints_get(c.fnpub, f) == 0 {
                err(c, "N0206", at, cat3("`", name, "` is private to the module that defines it"),
                        cat3("write `pub fn ", name, "` there to export it, if it is meant to be part of that module's interface"));
                sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "defined privately here");
                return true;
            }
            if imports_module(c, m, owner) == false && owner != m && ints_get(c.fnpub, f) == 1 { elsewhere = f; }
        }
        f = f + 1;
    }
    if elsewhere < 0 { return false; }
    err(c, "N0201", at, cat3("`", name, "` is not defined in this module"),
            "imports are not transitive: add a `use` for the module that exports it");
    sec_at(c, ints_get(c.fnns, elsewhere), ints_get(c.fnne, elsewhere), "exported here, by a module this one does not import");
    true
}

fn is_conversion(name: Str) -> Bool {
    name == "try_convert" || name == "wrap_convert" || name == "saturate_convert" || name == "Text" || is_num_name(name)
}

fn check_call(c: Ck, e: Int, expected: Int, unwanted: Bool) -> Int {
    // `m::f` is looked up as one key (N49); everything below names it as written.
    let qualified = some(c, e, "qualifier");
    let mut callee = fname_of(c, e, "callee");
    let mut target = 0 - 1;
    if qualified {
        let alias = fname_of(c, unwrap(c, e, "qualifier"), "name");
        target = qualified_callee(c, alias, callee);
        callee = cat3(alias, "::", callee);
    } else {
        target = callee_of(c, callee);
    }
    let cs = fld(c, e, "callee_span");
    let span = fld(c, e, "span");
    let args = kids(c, e, "args");
    let has_targs = some(c, e, "type_args");
    let mut targs = 0 - 1;
    if has_targs { targs = unwrap(c, e, "type_args"); }
    if target == 0 - 1 && is_conversion(callee) {
        stop(c, "a numeric conversion");
        return or_int(expected);
    }
    if qualified == false && ints_len(args) > 0 && starts_upper(callee) && target == 0 - 1 {
        if is_record(c, quiet_type(c, callee, cs)) || ints_len(variant_owners(c, callee)) > 0 {
            let t = check_construction(c, callee, cs, targs, positional_inits(c, args), span, expected);
            if t < 0 { return or_int(expected); }
            return t;
        }
    }
    if target >= 0 {
        if ints_get(c.fnnores, target) == 1 && unwanted == false {
            err(c, "N0300", span, cat3("`", callee, "` returns nothing, so this call has no value to use"),
                    cat3("call it as a statement of its own, or give `", callee, "` a result type"));
        }
    }
    if target == 0 - 1 {
        if callee == "list_from_vec" || callee == "list_empty" || callee == "list_len" || callee == "list_get" {
            stop(c, "a renamed built-in");
            return or_int(expected);
        }
        if qualified {
            unknown_qualified(c, c.d, callee, sorted(c.alname), sps(c, cs), spe(c, cs), "function");
        } else {
            if why_invisible(c, callee, cs) == false {
                if is_cap_name(callee) {
                    stop(c, "a capability constructed");
                    return or_int(expected);
                }
                err(c, "N0201", cs, cat3("`", callee, "` is not a function"), "");
            }
        }
        let mut i = 0;
        while i < ints_len(args) {
            check_expr(c, ints_get(args, i), none());
            i = i + 1;
        }
        return or_int(expected);
    }
    // The callee's signature: its parameters' types, its result, where it is declared (a
    // built-in at no place, 0..0), and whose type parameters they mention.
    let formals = ints_new();
    let mut ret = 0;
    let mut ds = 0;
    let mut de = 0;
    let mut generics = 0;
    let mut owner = own_fn();
    let mut oid = target;
    if target >= 0 {
        let pf = ints_get(c.fnpf, target);
        let mut k = 0;
        while k < ints_get(c.fnpc, target) {
            ints_push(formals, ints_get(c.ptys, pf + k));
            k = k + 1;
        }
        ret = ints_get(c.fnret, target);
        ds = ints_get(c.fnns, target);
        de = ints_get(c.fnne, target);
        generics = ints_get(c.fntpc, target);
    } else {
        let bi = 0 - 2 - target;
        if ints_get(c.bok, bi) == 0 {
            stop(c, cat3("the built-in `", callee, "`"));
            return or_int(expected);
        }
        // Provenance (N38) is not carried yet: a call that writes to a path stops the checker.
        if ints_get(c.bpath, bi) == 1 {
            stop(c, cat3("the built-in `", callee, "`, whose path is a restricted sink"));
            return or_int(expected);
        }
        generics = ints_get(c.bgen, bi);
        owner = own_builtin();
        oid = bi;
        if generics > 0 {
            let tp = param_ty(c, own_builtin(), bi, 0, "T");
            let shapes = split(strs_get(c.bshapes, bi), 44);
            let mut k = 0;
            while k < strs_len(shapes) {
                if strs_get(shapes, k) != "" { ints_push(formals, shape_of(c, strs_get(shapes, k), tp)); }
                k = k + 1;
            }
            ret = shape_of(c, strs_get(c.bretshape, bi), tp);
        } else {
            let pf = ints_get(c.bpf, bi);
            let mut k = 0;
            while k < ints_get(c.bpc, bi) {
                ints_push(formals, ints_get(c.ptys, pf + k));
                k = k + 1;
            }
            ret = ints_get(c.bret, bi);
        }
    }
    let pc = ints_len(formals);
    if ints_len(args) != pc {
        let mut verb = " were given";
        if ints_len(args) == 1 { verb = " was given"; }
        err(c, "N0303", span, cat5(cat3("`", callee, "` takes "), int_to_str(pc), str_concat(" argument", plural(pc)), ", but ",
                str_concat(int_to_str(ints_len(args)), verb)), "");
        sec_at(c, ds, de, "defined here");
    }
    if generics > 0 {
        let call = Call(name: callee, at: cs, span: span, args: args, formals: formals, ret: ret, owner: owner, oid: oid, n: generics,
                ds: ds, de: de, target: target);
        return check_generic_call(c, call, targs, expected);
    }
    if has_targs { not_generic(c, c.d, callee, "not generic", cs); }
    record_site(c, cs, target);
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        let mut want = none();
        if i < pc { want = ints_get(formals, i); }
        let got = value_type(c, a, want);
        if want >= 0 && assignable(c, got, want) == false {
            err(c, "N0300", espan(c, a),
                    cat5(cat3("argument ", int_to_str(i + 1), " of `"), callee, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "");
        }
        i = i + 1;
    }
    ret
}

// --- generic calls (`check_generic_call`) -------------------------------------------------------

// A call of a generic callee: its name, the callee's span, the call's, its arguments, the
// declared parameter and result types, whose type parameters they mention (`owner`, `oid`), how
// many there are, where it is declared, and what the call reaches (as `record_site` takes it).
pub struct Call {
    name: Str,
    at: Int,
    span: Int,
    args: Ints,
    formals: Ints,
    ret: Int,
    owner: Int,
    oid: Int,
    n: Int,
    ds: Int,
    de: Int,
    target: Int,
}

// The type arguments settled so far (-1 for none yet) and where each came from: an argument's
// index, or -2 for the written ones; and the last conflict unification met: the parameter, the
// type it was settled to, and where that came from.
pub struct Solved {
    ty: Ints,
    from: Ints,
    conflict: Ints,
}

fn written_from() -> Int { 0 - 2 }

// A callee's `i`th type parameter, as its declaration names it.
fn owner_param(c: Ck, call: Call, i: Int) -> Int {
    if call.owner == own_builtin() { return param_ty(c, own_builtin(), call.oid, 0, "T"); }
    fn_param_ty(c, call.oid, i)
}

// The arguments settled so far, each unsettled parameter left as itself (`settled_args`).
fn partial_args(c: Ck, call: Call, g: Solved) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < call.n {
        if ints_get(g.ty, i) >= 0 { ints_push(out, ints_get(g.ty, i)); } else { ints_push(out, owner_param(c, call, i)); }
        i = i + 1;
    }
    out
}

fn all_solved(g: Solved) -> Bool {
    let mut i = 0;
    while i < ints_len(g.ty) {
        if ints_get(g.ty, i) < 0 { return false; }
        i = i + 1;
    }
    true
}

// Whether a type mentions a type parameter of `owner`'s `oid`.
fn mentions(c: Ck, t: Int, owner: Int, oid: Int) -> Bool {
    if tag(c, t) == tag_param() { return ta(c, t) == owner && ints_get(c.tyb, t) == oid; }
    let mut i = 0;
    while i < targc(c, t) {
        if mentions(c, targ(c, t, i), owner, oid) { return true; }
        i = i + 1;
    }
    false
}

// Mark every parameter `formal` mentions as already accounted for (`excuse`).
fn excuse(c: Ck, call: Call, formal: Int, excused: Ints) -> Int {
    if tag(c, formal) == tag_param() {
        if ta(c, formal) == call.owner && ints_get(c.tyb, formal) == call.oid {
            let i = ints_get(c.tyc, formal);
            if i < ints_len(excused) { ints_set(excused, i, 1); }
        }
    }
    let mut k = 0;
    while k < targc(c, formal) {
        excuse(c, call, targ(c, formal, k), excused);
        k = k + 1;
    }
    0
}

// What `actual` says the parameter `index` is, by matching it against `formal` (`inferred_from`).
fn inferred_from(c: Ck, call: Call, formal: Int, actual: Int, index: Int) -> Int {
    let g = tag(c, formal);
    if g == tag_param() {
        if ta(c, formal) == call.owner && ints_get(c.tyb, formal) == call.oid && ints_get(c.tyc, formal) == index { return actual; }
        return 0 - 1;
    }
    if g == tag_vec() || g == tag_record() || g == tag_enum() {
        let mut k = 0;
        while k < targc(c, formal) && k < targc(c, actual) {
            let r = inferred_from(c, call, targ(c, formal, k), targ(c, actual, k), index);
            if r >= 0 { return r; }
            k = k + 1;
        }
    }
    0 - 1
}

// Match a declared parameter type against an argument's type, settling the callee's parameters
// it mentions (`unify`): 0 when it matches, 1 for a parameter already settled to another type
// (the conflict is left in `g.conflict`), 2 when the shapes differ.
fn unify(c: Ck, call: Call, formal: Int, actual: Int, g: Solved, arg: Int) -> Int {
    if mentions(c, formal, call.owner, call.oid) == false {
        if formal == actual { return 0; }
        return 2;
    }
    let tg = tag(c, formal);
    if tg == tag_param() {
        let i = ints_get(c.tyc, formal);
        if i >= ints_len(g.ty) { return 2; }
        let s = ints_get(g.ty, i);
        if s < 0 {
            ints_set(g.ty, i, actual);
            ints_set(g.from, i, arg);
            return 0;
        }
        if s == actual { return 0; }
        ints_set(g.conflict, 0, i);
        ints_set(g.conflict, 1, s);
        ints_set(g.conflict, 2, ints_get(g.from, i));
        return 1;
    }
    if tg == tag_vec() {
        if tag(c, actual) != tag_vec() { return 2; }
        return unify(c, call, targ(c, formal, 0), targ(c, actual, 0), g, arg);
    }
    if tg == tag_record() || tg == tag_enum() {
        if tag(c, actual) != tg || ta(c, actual) != ta(c, formal) { return 2; }
        if targc(c, formal) != targc(c, actual) { return 2; }
        let mut k = 0;
        while k < targc(c, formal) {
            let r = unify(c, call, targ(c, formal, k), targ(c, actual, k), g, arg);
            if r != 0 { return r; }
            k = k + 1;
        }
        return 0;
    }
    2
}

// A call to a generic callee: settle its type arguments — written, or inferred from the
// arguments left to right, and only then from the type the result is wanted as — check its
// arguments against them, and return what it produces.
fn check_generic_call(c: Ck, call: Call, targs: Int, expected: Int) -> Int {
    let name = call.name;
    let g = Solved(ty: ints_new(), from: ints_new(), conflict: ints_new());
    let excused = ints_new();
    let mut i = 0;
    while i < call.n {
        ints_push(g.ty, 0 - 1);
        ints_push(g.from, 0 - 1);
        ints_push(excused, 0);
        i = i + 1;
    }
    ints_push(g.conflict, 0);
    ints_push(g.conflict, 0);
    ints_push(g.conflict, 0);
    let mut explicit = false;
    if targs >= 0 {
        let written = sx_items(c.t, targs);
        let resolved = ints_new();
        i = 0;
        while i < ints_len(written) {
            ints_push(resolved, resolve_written(c, ints_get(written, i), c.tsn, c.tst, c.d));
            i = i + 1;
        }
        if ints_len(resolved) == call.n {
            i = 0;
            while i < call.n {
                ints_set(g.ty, i, ints_get(resolved, i));
                ints_set(g.from, i, written_from());
                i = i + 1;
            }
            explicit = true;
        } else {
            wrong_arity(c, c.d, name, call.n, ints_len(resolved), call.at);
        }
    }
    i = 0;
    while i < ints_len(call.args) {
        let a = ints_get(call.args, i);
        if i >= ints_len(call.formals) {
            check_expr(c, a, none());
        } else {
            let formal = ints_get(call.formals, i);
            if explicit || mentions(c, formal, call.owner, call.oid) == false {
                // Fully known: checked as a monomorphic call's argument is.
                let want = subst(c, formal, call.owner, call.oid, partial_args(c, call, g));
                let got = value_type(c, a, want);
                if assignable(c, got, want) == false { argument_mismatch(c, name, i, want, got, a); }
            } else {
                // What is already known is the expectation, for recovery only.
                let mut hint = none();
                if all_solved(g) { hint = subst(c, formal, call.owner, call.oid, partial_args(c, call, g)); }
                let got = check_expr(c, a, hint);
                if got >= 0 {
                    let r = unify(c, call, formal, got, g, i);
                    if r == 1 {
                        let p = ints_get(g.conflict, 0);
                        let pname = show(c, owner_param(c, call, p));
                        let from = ints_get(g.conflict, 2);
                        let mut source = "the written type arguments";
                        if from != written_from() { source = str_concat("argument ", int_to_str(from + 1)); }
                        let mut implied = inferred_from(c, call, formal, got, p);
                        if implied < 0 { implied = got; }
                        err(c, "N0355", espan(c, a),
                                cat5(cat5("`", pname, "` is `", show(c, ints_get(g.conflict, 1)), "` from "), source, ", but argument ",
                                int_to_str(i + 1), cat3(" makes it `", show(c, implied), "`")),
                                cat5("every use of `", pname, "` in `", name, "`'s signature is one type. Inference does not choose the first and convert the rest"));
                    }
                    if r == 2 {
                        excuse(c, call, formal, excused);
                        let want = subst(c, formal, call.owner, call.oid, partial_args(c, call, g));
                        argument_mismatch(c, name, i, want, got, a);
                    }
                }
                if got == unit() {
                    excuse(c, call, formal, excused);
                    err(c, "N0300", espan(c, a), "this produces no value",
                            "an `if` used as a value needs an `else`, and a block used as one needs a final expression with no `;` after it");
                }
            }
        }
        i = i + 1;
    }
    // A parameter the arguments leave unsettled is settled by the type the result is wanted as.
    if expected >= 0 && all_solved(g) == false { unify(c, call, call.ret, expected, g, ints_len(call.args)); }
    let missing = strs_new();
    i = 0;
    while i < call.n {
        if ints_get(g.ty, i) < 0 && ints_get(excused, i) == 0 { strs_push(missing, show(c, owner_param(c, call, i))); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        let mut verb = "are";
        if strs_len(missing) == 1 { verb = "is"; }
        err(c, "N0354", call.at, cat5("nothing in this call to `", name, "` says what ", quoted(missing), str_concat(" ", verb)),
                cat3("a type argument is inferred from the arguments, then from the type the result is wanted as. Write it — `", name,
                "[…](…)` — or give the result a type: `let x: T = …`"));
        sec_at(c, call.ds, call.de, "declared here");
    }
    // What each parameter's declaration requires, of the argument it was given (N14).
    i = 0;
    while i < call.n {
        let t = ints_get(g.ty, i);
        if t >= 0 && call.owner == own_fn() {
            if requires_equality(c, owner_param(c, call, i)) { require_equality(c, call, i, t, ints_get(g.from, i)); }
        }
        i = i + 1;
    }
    let settled = ints_new();
    i = 0;
    while i < call.n {
        if ints_get(g.ty, i) >= 0 { ints_push(settled, ints_get(g.ty, i)); } else { ints_push(settled, t_int()); }
        i = i + 1;
    }
    // A generic numeric built-in's `T` is in its class.
    if call.owner == own_builtin() {
        let class = strs_get(c.bclass, call.oid);
        let t = ints_get(settled, 0);
        let mut admits = true;
        let mut describe = "";
        if class == "integer" {
            admits = is_integer(c, t);
            describe = "an integer type";
        }
        if class == "float" {
            admits = is_float_name(bname_of(c, t));
            describe = "`Float32` or `Float64`";
        }
        if class == "numeric" {
            admits = is_num(c, t);
            describe = "a numeric type";
        }
        if admits == false { err(c, "N0300", call.at, cat5("`", name, "` applies to ", describe, cat3(", and this is `", show(c, t), "`")), ""); }
    }
    record_site(c, call.at, call.target);
    let ret = subst(c, call.ret, call.owner, call.oid, settled);
    if nesting(c, ret) > max_depth() {
        err(c, "N0338", call.span, "this call produces a type nested more than 32 deep",
                "types may nest 32 deep, and the result of a generic call is a type too");
        return t_int();
    }
    ret
}

fn argument_mismatch(c: Ck, name: Str, i: Int, want: Int, got: Int, a: Int) -> Int {
    err(c, "N0300", espan(c, a), cat5(cat3("argument ", int_to_str(i + 1), " of `"), name, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "")
}

// `N0364`: a parameter that requires `Equality` given a type without it.
fn require_equality(c: Ck, call: Call, i: Int, t: Int, from: Int) -> Int {
    let why = derived(c, t, true);
    if why == "" { return 0; }
    let p = show(c, owner_param(c, call, i));
    let shown = show(c, t);
    let mut place_s = sps(c, call.at);
    let mut place_e = spe(c, call.at);
    if from >= 0 && from < ints_len(call.args) {
        let a = espan(c, ints_get(call.args, from));
        place_s = sps(c, a);
        place_e = spe(c, a);
    }
    let head = cat5("`", call.name, "` requires `", p, ": Equality`, and ");
    let mut message = "";
    let mut help = "equality is derived from what a type contains; a sequence, a `Vec` or a `Chan` anywhere inside a type gives it none";
    if tag(c, t) == tag_param() {
        message = cat4(head, "this `", shown, "` is a type parameter whose declaration does not require it");
        help = cat3("a generic definition may pass on only what it requires itself: declare `", shown, ": Equality`");
    } else {
        if derived_path(c, why) == "" {
            message = cat5(head, cat3("`", p, "` is `"), shown, "` here: `", cat3(shown, "` has no equality", ""));
        } else {
            message = cat5(head, cat3("`", p, "` is `"), shown, "` here: its `",
                    cat5(derived_path(c, why), "` is a `", show(c, derived_type(c, why)), "`, which has no equality", ""));
        }
    }
    dg_error(c.d, "N0364", place_s, place_e, message, "", help);
    sec_at(c, call.ds, call.de, "declared here");
    0
}

// --- construction -------------------------------------------------------------------------------

// Field initialisers: each one's name, name span (absolute) and value.
pub struct Inits {
    names: Strs,
    ns: Ints,
    ne: Ints,
    vals: Ints,
}

fn no_inits() -> Inits { Inits(names: strs_new(), ns: ints_new(), ne: ints_new(), vals: ints_new()) }

fn written_inits(c: Ck, fields: Ints) -> Inits {
    let out = no_inits();
    let mut i = 0;
    while i < ints_len(fields) {
        let f = ints_get(fields, i);
        strs_push(out.names, fname_of(c, f, "name"));
        ints_push(out.ns, sps(c, fld(c, f, "name_span")));
        ints_push(out.ne, spe(c, fld(c, f, "name_span")));
        ints_push(out.vals, fld(c, f, "value"));
        i = i + 1;
    }
    out
}

// A call's arguments as fields given by position (R1.5, D4): no name, at a span of no width where
// the value begins.
fn positional_inits(c: Ck, args: Ints) -> Inits {
    let out = no_inits();
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        strs_push(out.names, "");
        ints_push(out.ns, sps(c, espan(c, a)));
        ints_push(out.ne, sps(c, espan(c, a)));
        ints_push(out.vals, a);
        i = i + 1;
    }
    out
}

fn check_values(c: Ck, inits: Inits) -> Int {
    let mut i = 0;
    while i < ints_len(inits.vals) {
        check_expr(c, ints_get(inits.vals, i), none());
        i = i + 1;
    }
    0
}

// The type `name` means here, asked without reporting anything.
fn quiet_type(c: Ck, name: Str, span: Int) -> Int {
    if strs_find(c.tsn, name) >= 0 { return param_named(c, name); }
    resolve_name(c, name, span, dg_new())
}

// A type parameter named where an expression or a pattern names a type: the reference refuses it
// in words this checker does not carry yet.
fn param_named(c: Ck, name: Str) -> Int {
    stop(c, "a type parameter named in an expression");
    ints_get(c.tst, strs_find(c.tsn, name))
}

// The enums in scope with a variant named `variant`, in the order of the names they are written by.
fn variant_owners(c: Ck, variant: Str) -> Ints {
    let names = strs_new();
    let out = ints_new();
    let mut i = 0;
    while i < strs_len(c.tnames) {
        let t = ints_get(c.ttys, i);
        // Not under an import's name, nor twice for one enum.
        if is_enum(c, t) && str_has(strs_get(c.tnames, i), "::") == false && index_of(out, t) < 0 {
            if variant_of(c, t, variant) >= 0 {
                let n = strs_get(c.tnames, i);
                let mut at = 0;
                while at < strs_len(names) && str_less(strs_get(names, at), n) { at = at + 1; }
                insert_str(names, at, n);
                insert_int(out, at, t);
            }
        }
        i = i + 1;
    }
    out
}

fn owner_names(c: Ck, owners: Ints) -> Strs {
    let out = strs_new();
    let mut i = 0;
    while i < ints_len(owners) {
        strs_push(out, strs_get(c.ename, ta(c, ints_get(owners, i))));
        i = i + 1;
    }
    out
}

fn str_less(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i); }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

fn insert_str(xs: Strs, at: Int, s: Str) -> Int {
    strs_push(xs, s);
    let mut i = strs_len(xs) - 1;
    while i > at {
        strs_set(xs, i, strs_get(xs, i - 1));
        i = i - 1;
    }
    strs_set(xs, at, s);
    0
}

fn insert_int(xs: Ints, at: Int, v: Int) -> Int {
    ints_push(xs, v);
    let mut i = ints_len(xs) - 1;
    while i > at {
        ints_set(xs, i, ints_get(xs, i - 1));
        i = i - 1;
    }
    ints_set(xs, at, v);
    0
}

fn quoted(names: Strs) -> Str {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(names) {
        strs_push(out, tick(strs_get(names, i)));
        i = i + 1;
    }
    str_join(out, ", ")
}

// Positional fields named in declaration order (`positional_named`): 1 when the initialisers may
// be checked (renamed in place where they were positional), 0 when a refusal was reported.
fn positional_named(c: Ck, inits: Inits, declared: Strs, has_declared: Bool, what: Str, span: Int) -> Int {
    let mut positional = false;
    let mut named = false;
    let mut i = 0;
    while i < strs_len(inits.names) {
        if strs_get(inits.names, i) == "" { positional = true; } else { named = true; }
        i = i + 1;
    }
    if positional == false || has_declared == false { return 1; }
    if named {
        err(c, "N0334", span, cat3("`", what, "`'s fields are given both by position and by name"),
                "give every field by position, in the order declared, or every one by name");
        return 0;
    }
    if strs_len(inits.names) != strs_len(declared) {
        let mut verb = " are given by position";
        if strs_len(inits.names) == 1 { verb = " is given by position"; }
        err(c, "N0334", span, cat5(cat3("`", what, "` has "), int_to_str(strs_len(declared)), str_concat(" field", plural(strs_len(declared))),
                ", and ", str_concat(int_to_str(strs_len(inits.names)), verb)), "");
        return 0;
    }
    i = 0;
    while i < strs_len(declared) {
        strs_set(inits.names, i, strs_get(declared, i));
        i = i + 1;
    }
    1
}

fn record_field_names(c: Ck, t: Int) -> Strs {
    let out = strs_new();
    let r = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.rfc, r) {
        strs_push(out, strs_get(c.fname, ints_get(c.rff, r) + i));
        i = i + 1;
    }
    out
}

// A record's construction; the record, or -1 when its type did not resolve. `targs` is the list of
// type arguments written, or -1.
fn check_construction(c: Ck, ty: Str, ty_span: Int, targs: Int, inits: Inits, span: Int, expected: Int) -> Int {
    let quiet = quiet_type(c, ty, ty_span);
    if is_record(c, quiet) == false && targs < 0 {
        let owners = variant_owners(c, ty);
        if ints_len(owners) == 1 {
            return check_variant(c, strs_get(owner_names(c, owners), 0), ty_span, 0 - 1, ty, ty_span, inits, span, expected);
        }
        if ints_len(owners) > 1 {
            let names = owner_names(c, owners);
            let a = strs_get(names, 0);
            let b = strs_get(names, 1);
            err(c, "N0636", ty_span, cat5(cat3("`", ty, "` is a variant of both `"), a, "` and `", b, "`"),
                    cat5(cat3("write which: `", a, "."), ty, cat3("(…)` or `", b, "."), ty, "(…)`"));
            check_values(c, inits);
            return 0 - 1;
        }
    }
    let mut declared = strs_new();
    if is_record(c, quiet) { declared = record_field_names(c, quiet); }
    if positional_named(c, inits, declared, is_record(c, quiet), ty, span) == 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let def = resolve_type(c, ty, ty_span);
    if is_record(c, def) == false {
        if is_enum(c, def) {
            let name = show(c, def);
            let mut help = "";
            if ints_get(c.evc, ta(c, def)) > 0 { help = cat5("write `", name, ".", strs_get(c.vname, ints_get(c.evf, ta(c, def))), "(…)`"); }
            err(c, "N0341", ty_span, cat3("`", name, "` is an enum, so a value of it names one of its variants"), help);
        } else {
            if is_cap_name(ty) {
                stop(c, "a capability constructed");
                return 0 - 1;
            }
            if is_builtin_name(ty) {
                err(c, "N0333", ty_span, cat3("`", show(c, def), "` is not a record, so it has no fields to name"),
                        "this form builds a record. A built-in type is built by its own operations");
            }
        }
        check_values(c, inits);
        return 0 - 1;
    }
    let t = applied(c, def, targs, ty_span);
    if t < 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let r = ta(c, t);
    let given = strs_new();
    let gstart = ints_new();
    let gend = ints_new();
    let mut i = 0;
    while i < strs_len(inits.names) {
        let name = strs_get(inits.names, i);
        let value = ints_get(inits.vals, i);
        let f = record_field(c, t, name);
        if f < 0 {
            dg_error(c.d, "N0333", ints_get(inits.ns, i), ints_get(inits.ne, i), cat5("`", show(c, t), "` has no field `", name, "`"), "", "");
            sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
            check_expr(c, value, none());
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                dg_error(c.d, "N0332", ints_get(inits.ns, i), ints_get(inits.ne, i), cat3("`", name, "` is given a value twice"), "",
                        "every field is given exactly one value; there is no update form");
                sec_at(c, ints_get(gstart, first), ints_get(gend, first), "first given here");
                check_expr(c, value, none());
            } else {
                strs_push(given, name);
                ints_push(gstart, ints_get(inits.ns, i));
                ints_push(gend, ints_get(inits.ne, i));
                let want = field_ty_in(c, t, f);
                let got = value_type(c, value, want);
                if got != want {
                    let sw = show(c, want);
                    err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is `"), sw, "`, but this is `", show(c, got), "`"), "");
                    sec_at(c, ints_get(c.fns, f), ints_get(c.fne, f), cat3("declared `", sw, "` here"));
                }
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < ints_get(c.rfc, r) {
        let n = strs_get(c.fname, ints_get(c.rff, r) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", span, cat4("this `", show(c, t), "` does not give a value for ", quoted(missing)),
                "every field is given a value when a record is built. There are no default values and no partial records");
        sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
    }
    t
}

// A definition applied to the type arguments written after its name (`applied`); -1, reported,
// when a generic one has none written.
fn applied(c: Ck, def: Int, targs: Int, at: Int) -> Int {
    let args = ints_new();
    if targs >= 0 {
        let written = sx_items(c.t, targs);
        let mut i = 0;
        while i < ints_len(written) {
            ints_push(args, resolve_written(c, ints_get(written, i), c.tsn, c.tst, c.d));
            i = i + 1;
        }
    }
    let mut arity = 0;
    if is_record(c, def) { arity = ints_get(c.rnp, ta(c, def)); }
    if is_enum(c, def) { arity = ints_get(c.enp, ta(c, def)); }
    let shown = show(c, def);
    if targs < 0 {
        if arity == 0 { return def; }
        err(c, "N0352", at, cat5("`", shown, "` is generic, so it is built with its ", int_to_str(arity), cat3(" type argument", plural(arity), " written")),
                cat3("write them after the name: `", shown, "[…]`, or use it where its type is known, or give it a payload that says (R1, 5b.14)"));
        return 0 - 1;
    }
    if arity == 0 {
        not_generic(c, c.d, shown, "not generic", at);
        return def;
    }
    if ints_len(args) != arity {
        wrong_arity(c, c.d, shown, arity, ints_len(args), at);
        while ints_len(args) > arity { ints_pop(args); }
        while ints_len(args) < arity { ints_push(args, t_int()); }
    }
    if is_record(c, def) { return record_ty(c, ta(c, def), args); }
    enum_ty(c, ta(c, def), args)
}

// The type arguments written after an expression's name: their list, or -1.
fn type_args_of(c: Ck, e: Int) -> Int {
    if some(c, e, "type_args") { return unwrap(c, e, "type_args"); }
    0 - 1
}

// A type name written in an expression, reported when it is no type.
fn resolve_type(c: Ck, name: Str, span: Int) -> Int {
    if strs_find(c.tsn, name) >= 0 { return param_named(c, name); }
    resolve_name(c, name, span, c.d)
}

// A generic enum's arguments where none are written (R1, 5b.14; `inferred_enum`): the type the
// construction is wanted as, when it is this enum; otherwise each payload field declared as one of
// its parameters says that parameter is its value's type. -1 where that leaves one undecided. A
// payload value checked here is recorded in `pre` and not checked again.
fn inferred_enum(c: Ck, def: Int, variant: Str, inits: Inits, expected: Int, pre: Ints) -> Int {
    let e = ta(c, def);
    let n = ints_get(c.enp, e);
    if n == 0 { return 0 - 1; }
    if expected >= 0 && is_enum(c, expected) && ta(c, expected) == e { return expected; }
    let v = variant_of(c, def, variant);
    if v < 0 { return 0 - 1; }
    let args = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(args, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < strs_len(inits.names) {
        let f = variant_field(c, v, strs_get(inits.names, i));
        if f >= 0 {
            let declared = ints_get(c.fty, f);
            if tag(c, declared) == tag_param() && ta(c, declared) == own_enum() && ints_get(c.tyb, declared) == e {
                let t = value_type(c, ints_get(inits.vals, i), none());
                ints_set(pre, i, t);
                let index = ints_get(c.tyc, declared);
                if index < n {
                    if ints_get(args, index) < 0 { ints_set(args, index, t); }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        if ints_get(args, i) < 0 { return 0 - 1; }
        i = i + 1;
    }
    enum_ty(c, e, args)
}

// The values not already checked while inferring.
fn check_rest(c: Ck, inits: Inits, pre: Ints) -> Int {
    let mut i = 0;
    while i < ints_len(inits.vals) {
        if ints_get(pre, i) < 0 { check_expr(c, ints_get(inits.vals, i), none()); }
        i = i + 1;
    }
    0
}

// `Enum.Variant(…)`; the enum, or -1 when its type did not resolve.
fn check_variant(c: Ck, ty: Str, ty_span: Int, targs: Int, variant: Str, variant_span: Int, inits: Inits, span: Int, expected: Int) -> Int {
    let quiet = quiet_type(c, ty, ty_span);
    let declared = strs_new();
    let mut has_declared = false;
    if is_enum(c, quiet) {
        let v = variant_of(c, quiet, variant);
        if v >= 0 {
            has_declared = true;
            let mut i = 0;
            while i < ints_get(c.vfc, v) {
                strs_push(declared, strs_get(c.fname, ints_get(c.vff, v) + i));
                i = i + 1;
            }
        }
    }
    if positional_named(c, inits, declared, has_declared, variant, span) == 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let pre = ints_new();
    let mut i = 0;
    while i < ints_len(inits.vals) {
        ints_push(pre, 0 - 1);
        i = i + 1;
    }
    let def = resolve_type(c, ty, ty_span);
    if is_enum(c, def) == false {
        if is_record(c, def) {
            err(c, "N0341", ty_span, cat3("`", show(c, def), "` is a record, so it has no variants"),
                    "a record is built by naming its fields: `Point(x: 1, y: 2)`");
        } else {
            if is_builtin_name(ty) {
                err(c, "N0341", ty_span, cat3("`", show(c, def), "` is a built-in type, so it has no variants"), "only an `enum` has variants");
            }
        }
        check_values(c, inits);
        return 0 - 1;
    }
    let mut t = 0 - 1;
    if targs < 0 { t = inferred_enum(c, def, variant, inits, expected, pre); }
    if t < 0 { t = applied(c, def, targs, ty_span); }
    if t < 0 {
        check_rest(c, inits, pre);
        return 0 - 1;
    }
    let e = ta(c, t);
    let v = variant_of(c, t, variant);
    if v < 0 {
        let known = strs_new();
        i = 0;
        while i < ints_get(c.evc, e) {
            strs_push(known, strs_get(c.vname, ints_get(c.evf, e) + i));
            i = i + 1;
        }
        let mut help = "";
        if strs_len(known) > 0 { help = str_concat("its variants are ", quoted(known)); }
        err(c, "N0341", variant_span, cat5("`", show(c, t), "` has no variant `", variant, "`"), help);
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        check_rest(c, inits, pre);
        return t;
    }
    let path = cat3(show(c, t), ".", variant);
    let given = strs_new();
    let gstart = ints_new();
    let gend = ints_new();
    i = 0;
    while i < strs_len(inits.names) {
        let name = strs_get(inits.names, i);
        let value = ints_get(inits.vals, i);
        let done = ints_get(pre, i);
        let f = variant_field(c, v, name);
        if f < 0 {
            dg_error(c.d, "N0333", ints_get(inits.ns, i), ints_get(inits.ne, i), cat5("`", path, "` has no payload field `", name, "`"), "", "");
            sec_at(c, ints_get(c.vns, v), ints_get(c.vne, v), "declared here");
            if done < 0 { check_expr(c, value, none()); }
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                dg_error(c.d, "N0332", ints_get(inits.ns, i), ints_get(inits.ne, i), cat3("`", name, "` is given a value twice"), "",
                        "every payload field is given exactly one value");
                sec_at(c, ints_get(gstart, first), ints_get(gend, first), "first given here");
                if done < 0 { check_expr(c, value, none()); }
            } else {
                strs_push(given, name);
                ints_push(gstart, ints_get(inits.ns, i));
                ints_push(gend, ints_get(inits.ne, i));
                let want = field_ty_in(c, t, f);
                let mut got = done;
                if done < 0 { got = value_type(c, value, want); }
                if got != want {
                    let sw = show(c, want);
                    err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is `"), sw, "`, but this is `", show(c, got), "`"), "");
                    sec_at(c, ints_get(c.fns, f), ints_get(c.fne, f), cat3("declared `", sw, "` here"));
                }
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < ints_get(c.vfc, v) {
        let n = strs_get(c.fname, ints_get(c.vff, v) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", span, cat4("this `", path, "` does not give a value for ", quoted(missing)),
                "every payload field is given a value when a variant is built. There are no default values");
        sec_at(c, ints_get(c.vns, v), ints_get(c.vne, v), "declared here");
    }
    t
}

// `base.name`: the field's type, or -1 when it has none.
fn check_projection(c: Ck, base: Int, name: Str, name_span: Int) -> Int {
    if is_record(c, base) == false {
        let mut help = "`.` reads a declared field out of a record value";
        if is_enum(c, base) {
            help = "which fields an enum value has depends on its active variant, so a payload is read by `match` and not by `.`";
        }
        err(c, "N0335", name_span, cat5("`", show(c, base), "` is not a record, so `.", name, "` has nothing to read"), help);
        return 0 - 1;
    }
    let f = record_field(c, base, name);
    if f < 0 {
        let r = ta(c, base);
        err(c, "N0333", name_span, cat5("`", show(c, base), "` has no field `", name, "`"),
                "a field is looked for on the type of the value it is read from, and nowhere else");
        sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
        return 0 - 1;
    }
    field_ty_in(c, base, f)
}

// --- matching (`check_match`, `nazm-core/src/check/pattern.rs`) ---------------------------------

// What a pattern matches, for exhaustiveness and reachability (`usefulness::Pat`), in the
// checker's pattern pool: its kind, a value (a `Bool`'s, or a variant's index), a literal's key,
// a variant's enum (the scrutinee's instance), and a run of arguments.
fn pk_wild() -> Int { 0 }
fn pk_bool() -> Int { 1 }
fn pk_lit() -> Int { 2 }
fn pk_ctor() -> Int { 3 }
fn pk_or() -> Int { 4 }

fn pat_new(c: Ck, kind: Int, value: Int, key: Str, ty: Int, args: Ints) -> Int {
    ints_push(c.pkind, kind);
    ints_push(c.pval, value);
    strs_push(c.pkey, key);
    ints_push(c.pty, ty);
    ints_push(c.paf, ints_len(c.pargs));
    ints_push(c.pac, ints_len(args));
    let mut i = 0;
    while i < ints_len(args) {
        ints_push(c.pargs, ints_get(args, i));
        i = i + 1;
    }
    ints_len(c.pkind) - 1
}

fn wild(c: Ck) -> Int { pat_new(c, pk_wild(), 0, "", 0, ints_new()) }
fn pkind(c: Ck, p: Int) -> Int { ints_get(c.pkind, p) }
fn pargs_of(c: Ck, p: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_get(c.pac, p) {
        ints_push(out, ints_get(c.pargs, ints_get(c.paf, p) + i));
        i = i + 1;
    }
    out
}

// Whether a pattern has a head constructor, and whether two heads are the same one.
fn has_head(c: Ck, p: Int) -> Bool { pkind(c, p) == pk_bool() || pkind(c, p) == pk_lit() || pkind(c, p) == pk_ctor() }
fn same_head(c: Ck, p: Int, h: Int) -> Bool {
    if pkind(c, p) != pkind(c, h) { return false; }
    if pkind(c, p) == pk_lit() { return strs_get(c.pkey, p) == strs_get(c.pkey, h); }
    ints_get(c.pval, p) == ints_get(c.pval, h)
}

// A matrix of patterns: its rows, each a run of the checker's cell pool.
pub struct Mat {
    rs: Ints,
    rl: Ints,
}

fn mat_new() -> Mat { Mat(rs: ints_new(), rl: ints_new()) }
fn mat_rows(m: Mat) -> Int { ints_len(m.rs) }
fn mat_push(c: Ck, m: Mat, row: Ints) -> Int {
    ints_push(m.rs, ints_len(c.cells));
    ints_push(m.rl, ints_len(row));
    let mut i = 0;
    while i < ints_len(row) {
        ints_push(c.cells, ints_get(row, i));
        i = i + 1;
    }
    0
}
fn mat_row(c: Ck, m: Mat, r: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_get(m.rl, r) {
        ints_push(out, ints_get(c.cells, ints_get(m.rs, r) + i));
        i = i + 1;
    }
    out
}
fn mat_first(c: Ck, m: Mat, r: Int) -> Int {
    if ints_get(m.rl, r) == 0 { return 0 - 1; }
    ints_get(c.cells, ints_get(m.rs, r))
}

fn tail_of(xs: Ints, from: Int) -> Ints {
    let out = ints_new();
    let mut i = from;
    while i < ints_len(xs) {
        ints_push(out, ints_get(xs, i));
        i = i + 1;
    }
    out
}
fn joined(a: Ints, b: Ints) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_len(a) {
        ints_push(out, ints_get(a, i));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(b) {
        ints_push(out, ints_get(b, i));
        i = i + 1;
    }
    out
}
fn wilds(c: Ck, n: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(out, wild(c));
        i = i + 1;
    }
    out
}

// Rows with every or-pattern at their head spread into one row per alternative (`spread`).
fn spread(c: Ck, m: Mat) -> Mat {
    let out = mat_new();
    let work = mat_new();
    let mut r = mat_rows(m) - 1;
    while r >= 0 {
        mat_push(c, work, mat_row(c, m, r));
        r = r - 1;
    }
    while mat_rows(work) > 0 {
        let last = mat_rows(work) - 1;
        let row = mat_row(c, work, last);
        ints_pop(work.rs);
        ints_pop(work.rl);
        if ints_len(row) > 0 && pkind(c, ints_get(row, 0)) == pk_or() {
            let alts = pargs_of(c, ints_get(row, 0));
            let rest = tail_of(row, 1);
            let mut k = ints_len(alts) - 1;
            while k >= 0 {
                let one_alt = ints_new();
                ints_push(one_alt, ints_get(alts, k));
                mat_push(c, work, joined(one_alt, rest));
                k = k - 1;
            }
        } else {
            mat_push(c, out, row);
        }
    }
    out
}

// The rows whose head matches `head`, its arguments (`arity` wildcards for a `_`) in front of the
// rest (`specialise`).
fn specialise(c: Ck, m: Mat, head: Int, arity: Int) -> Mat {
    let rows = spread(c, m);
    let out = mat_new();
    let mut r = 0;
    while r < mat_rows(rows) {
        let row = mat_row(c, rows, r);
        if ints_len(row) > 0 {
            let first = ints_get(row, 0);
            let rest = tail_of(row, 1);
            if pkind(c, first) == pk_wild() {
                mat_push(c, out, joined(wilds(c, arity), rest));
            } else {
                if has_head(c, first) && same_head(c, first, head) {
                    if pkind(c, first) == pk_ctor() { mat_push(c, out, joined(pargs_of(c, first), rest)); } else { mat_push(c, out, rest); }
                }
            }
        }
        r = r + 1;
    }
    out
}

// The rows whose head is `_`, without it (`default`).
fn default_rows(c: Ck, m: Mat) -> Mat {
    let rows = spread(c, m);
    let out = mat_new();
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first >= 0 {
            if pkind(c, first) == pk_wild() { mat_push(c, out, tail_of(mat_row(c, rows, r), 1)); }
        }
        r = r + 1;
    }
    out
}

// A finite type's constructors, as head patterns: every variant of an enum (its fields' types a
// run of `ctys`), or `true` and `false`. None (an empty list) for any other type.
pub struct Ctors {
    heads: Ints,
    tf: Ints,
    tc: Ints,
    tys: Ints,
}

fn ctors_of(c: Ck, t: Int) -> Ctors {
    let out = Ctors(heads: ints_new(), tf: ints_new(), tc: ints_new(), tys: ints_new());
    if is_enum(c, t) {
        let e = ta(c, t);
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let vi = ints_get(c.evf, e) + v;
            ints_push(out.heads, pat_new(c, pk_ctor(), v, "", t, ints_new()));
            ints_push(out.tf, ints_len(out.tys));
            ints_push(out.tc, ints_get(c.vfc, vi));
            let mut k = 0;
            while k < ints_get(c.vfc, vi) {
                ints_push(out.tys, field_ty_in(c, t, ints_get(c.vff, vi) + k));
                k = k + 1;
            }
            v = v + 1;
        }
    }
    if t == t_bool() {
        ints_push(out.heads, pat_new(c, pk_bool(), 1, "", 0, ints_new()));
        ints_push(out.tf, 0);
        ints_push(out.tc, 0);
        ints_push(out.heads, pat_new(c, pk_bool(), 0, "", 0, ints_new()));
        ints_push(out.tf, 0);
        ints_push(out.tc, 0);
    }
    out
}

fn finite(c: Ck, t: Int) -> Bool { is_enum(c, t) || t == t_bool() }

fn ctor_fields(k: Ctors, i: Int) -> Ints {
    let out = ints_new();
    let mut j = 0;
    while j < ints_get(k.tc, i) {
        ints_push(out, ints_get(k.tys, ints_get(k.tf, i) + j));
        j = j + 1;
    }
    out
}

// Whether some row's head is `h`.
fn present(c: Ck, rows: Mat, h: Int) -> Bool {
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first >= 0 {
            if has_head(c, first) && same_head(c, first, h) { return true; }
        }
        r = r + 1;
    }
    false
}

fn complete(c: Ck, rows: Mat, k: Ctors) -> Bool {
    let mut i = 0;
    while i < ints_len(k.heads) {
        if present(c, rows, ints_get(k.heads, i)) == false { return false; }
        i = i + 1;
    }
    true
}

fn max_pattern_depth() -> Int { 256 }

// Whether `row` matches some value no row of `m` matches (`useful`).
fn useful(c: Ck, m: Mat, row: Ints, tys: Ints, depth: Int) -> Bool {
    if ints_len(row) == 0 || ints_len(tys) == 0 { return mat_rows(m) == 0; }
    if depth > max_pattern_depth() { return false; }
    let first = ints_get(row, 0);
    let rest = tail_of(row, 1);
    let ty = ints_get(tys, 0);
    let rest_tys = tail_of(tys, 1);
    if pkind(c, first) == pk_or() {
        let alts = pargs_of(c, first);
        let mut i = 0;
        while i < ints_len(alts) {
            let r = ints_new();
            ints_push(r, ints_get(alts, i));
            if useful(c, m, joined(r, rest), tys, depth + 1) { return true; }
            i = i + 1;
        }
        return false;
    }
    if pkind(c, first) == pk_wild() {
        let rows = spread(c, m);
        let k = ctors_of(c, ty);
        if finite(c, ty) && complete(c, rows, k) {
            let mut i = 0;
            while i < ints_len(k.heads) {
                let fields = ctor_fields(k, i);
                let r = joined(wilds(c, ints_len(fields)), rest);
                let t = joined(fields, rest_tys);
                if useful(c, specialise(c, rows, ints_get(k.heads, i), ints_len(fields)), r, t, depth + 1) { return true; }
                i = i + 1;
            }
            return false;
        }
        return useful(c, default_rows(c, rows), rest, rest_tys, depth + 1);
    }
    let args = pargs_of(c, first);
    let mut fields = ints_new();
    if pkind(c, first) == pk_ctor() {
        let k = ctors_of(c, ty);
        let v = ints_get(c.pval, first);
        if v < ints_len(k.heads) { fields = ctor_fields(k, v); }
        if ints_len(fields) != ints_len(args) || v >= ints_len(k.heads) {
            fields = ints_new();
            let mut i = 0;
            while i < ints_len(args) {
                ints_push(fields, t_int());
                i = i + 1;
            }
        }
    }
    useful(c, specialise(c, m, first, ints_len(args)), joined(args, rest), joined(fields, rest_tys), depth + 1)
}

// "No witness": every value is matched.
fn no_witness() -> Str { "?none" }

// A row of values, one per column of `tys`, that no row of `m` matches, each as it is shown;
// `no_witness()` alone when every value is matched (`witness`).
fn witness(c: Ck, m: Mat, tys: Ints, depth: Int) -> Strs {
    let none_found = strs_new();
    strs_push(none_found, no_witness());
    if ints_len(tys) == 0 {
        if mat_rows(m) == 0 { return strs_new(); }
        return none_found;
    }
    if depth > max_pattern_depth() { return none_found; }
    let ty = ints_get(tys, 0);
    let rest_tys = tail_of(tys, 1);
    let rows = spread(c, m);
    let k = ctors_of(c, ty);
    if finite(c, ty) && complete(c, rows, k) {
        let mut i = 0;
        while i < ints_len(k.heads) {
            let fields = ctor_fields(k, i);
            let sub = specialise(c, rows, ints_get(k.heads, i), ints_len(fields));
            let w = witness(c, sub, joined(fields, rest_tys), depth + 1);
            if is_witness(w) {
                let n = imin(ints_len(fields), strs_len(w));
                let args = strs_new();
                let mut j = 0;
                while j < n {
                    strs_push(args, strs_get(w, j));
                    j = j + 1;
                }
                let out = strs_new();
                strs_push(out, build_witness(c, ints_get(k.heads, i), args, ty));
                while j < strs_len(w) {
                    strs_push(out, strs_get(w, j));
                    j = j + 1;
                }
                return out;
            }
            i = i + 1;
        }
        return none_found;
    }
    let w = witness(c, default_rows(c, rows), rest_tys, depth + 1);
    if is_witness(w) == false { return none_found; }
    let mut first = "_";
    if finite(c, ty) {
        let mut i = 0;
        let mut found = false;
        while i < ints_len(k.heads) && found == false {
            if present(c, rows, ints_get(k.heads, i)) == false {
                let anys = strs_new();
                let mut j = 0;
                while j < ints_get(k.tc, i) {
                    strs_push(anys, "_");
                    j = j + 1;
                }
                first = build_witness(c, ints_get(k.heads, i), anys, ty);
                found = true;
            }
            i = i + 1;
        }
    }
    let out = strs_new();
    strs_push(out, first);
    let mut j = 0;
    while j < strs_len(w) {
        strs_push(out, strs_get(w, j));
        j = j + 1;
    }
    out
}

fn is_witness(w: Strs) -> Bool {
    if strs_len(w) == 0 { return true; }
    strs_get(w, 0) != no_witness()
}

fn imin(a: Int, b: Int) -> Int {
    if a < b { return a; }
    b
}

// A constructor applied to its arguments' witnesses, as `Witness::show` writes it.
fn build_witness(c: Ck, head: Int, args: Strs, ty: Int) -> Str {
    if pkind(c, head) == pk_bool() {
        if ints_get(c.pval, head) == 1 { return "true"; }
        return "false";
    }
    let vi = ints_get(c.evf, ta(c, ty)) + ints_get(c.pval, head);
    let parts = strs_new();
    let mut i = 0;
    while i < ints_get(c.vfc, vi) && i < strs_len(args) {
        strs_push(parts, cat3(strs_get(c.fname, ints_get(c.vff, vi) + i), ": ", strs_get(args, i)));
        i = i + 1;
    }
    cat5(show(c, ty), ".", strs_get(c.vname, vi), "(", str_concat(str_join(parts, ", "), ")"))
}

// What one pattern binds: each name, where (absolute), and its type.
pub struct Binds {
    names: Strs,
    starts: Ints,
    ends: Ints,
    tys: Ints,
}

fn no_binds() -> Binds { Binds(names: strs_new(), starts: ints_new(), ends: ints_new(), tys: ints_new()) }

fn pattern_kind(c: Ck, p: Int) -> Str { sx_text(c.t, p) }

// Whether a pattern names a variant anywhere at its top: what needs an enum scrutinee.
fn has_variant_pattern(c: Ck, p: Int) -> Bool {
    let k = pattern_kind(c, p);
    if k == "Variant" { return true; }
    if k == "Or" {
        let alts = kids(c, p, "alts");
        let mut i = 0;
        while i < ints_len(alts) {
            if has_variant_pattern(c, ints_get(alts, i)) { return true; }
            i = i + 1;
        }
    }
    false
}

// `match scrutinee { … }` — written, or what `if let`, `let … else`, `while let` and a `let` of a
// pattern mean (`check_match`).
fn check_match(c: Ck, m: Int, expected: Int) -> Int {
    let scrutinee = fld(c, m, "scrutinee");
    let arms = kids(c, m, "arms");
    let source = sx_text(c.t, fld(c, m, "source"));
    let span = fld(c, m, "span");
    let sty = value_type(c, scrutinee, none());
    let errors_before = dg_len(c.d);
    let mut wants_enum = ints_len(arms) == 0;
    let mut i = 0;
    while i < ints_len(arms) {
        if has_variant_pattern(c, fld(c, ints_get(arms, i), "pattern")) { wants_enum = true; }
        i = i + 1;
    }
    if wants_enum && is_enum(c, sty) == false {
        err(c, "N0342", espan(c, scrutinee), cat3("`match` needs an enum, but this is `", show(c, sty), "`"),
                "a variant pattern selects one variant of an enum. A `Bool`, an integer or a string is matched by literals, and any value by `_` or a name");
        return or_int(expected);
    }
    let mut unresolved = false;
    let rows = mat_new();
    let row_arms = ints_new();
    let mut result = 0 - 3;
    let mut first_value = 0 - 1;
    let mut first_span = 0;
    i = 0;
    while i < ints_len(arms) {
        let arm = ints_get(arms, i);
        let pattern = fld(c, arm, "pattern");
        let body = fld(c, arm, "body");
        open_scope(c);
        let binds = no_binds();
        let before = dg_len(c.d);
        let pat = check_pattern(c, pattern, sty, scrutinee, binds);
        if dg_len(c.d) > before {
            // The pattern is the mistake: its arm's body would only repeat it.
            unresolved = true;
            close_scope(c);
        } else {
            let mut k = 0;
            while k < strs_len(binds.names) {
                let name = strs_get(binds.names, k);
                if defined_here(c, name) {
                    dg_error(c.d, "N0202", ints_get(binds.starts, k), ints_get(binds.ends, k), cat3("`", name, "` is bound twice by this pattern"), "",
                            "each part of a pattern binds a name of its own, or is `_`");
                } else {
                    define(c, name, ints_get(binds.tys, k), false, ints_get(binds.starts, k), ints_get(binds.ends, k));
                }
                k = k + 1;
            }
            let guarded = some(c, arm, "guard");
            if guarded {
                let g = unwrap(c, arm, "guard");
                let gt = value_type(c, g, t_bool());
                if gt != t_bool() {
                    err(c, "N0301", espan(c, g), cat3("a `match` arm's guard must be `Bool`, but this is `", show(c, gt), "`"),
                            "Nazm has no truthiness: use a comparison such as `x != 0`");
                }
            }
            if unresolved == false {
                let one_pat = ints_new();
                ints_push(one_pat, pat);
                let one_ty = ints_new();
                ints_push(one_ty, sty);
                if useful(c, rows, one_pat, one_ty, 0) == false { unreachable_arm(c, arms, i, rows, row_arms, pat); }
            }
            if guarded == false {
                let one_pat = ints_new();
                ints_push(one_pat, pat);
                mat_push(c, rows, one_pat);
                ints_push(row_arms, i);
            }
            let mut want = expected;
            if want < 0 { want = first_value; }
            let completion = check_expr(c, body, want);
            close_scope(c);
            if source == "LetElse" && i == 1 && completion != diverges() {
                err(c, "N0630", fld(c, arm, "span"), "a `let … else`'s `else` must leave, and this one can finish",
                        "end it with `return`, `break` or `continue`: the names the pattern binds do not exist when it does not match");
            } else {
                if completion >= 0 {
                    if first_value < 0 {
                        first_value = completion;
                        first_span = espan(c, body);
                    } else {
                        if first_value != completion {
                            let swant = show(c, first_value);
                            err(c, "N0302", espan(c, body), cat5("this arm is `", show(c, completion), "`, but an earlier one is `", swant, "`"),
                                    "every arm of a `match` must have the same type");
                            sec(c, first_span, cat3("this one is `", swant, "`"));
                        }
                    }
                }
                if result == 0 - 3 {
                    result = completion;
                } else {
                    if result == diverges() {
                        result = completion;
                    } else {
                        if completion != diverges() {
                            if result == unit() || completion == unit() { result = unit(); }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if unresolved == false { report_uncovered(c, sty, rows, span, source); }
    if unresolved == false && source == "Written" && dg_len(c.d) == errors_before { warn_covering(c, sty, arms); }
    if result != 0 - 3 { return result; }
    if unresolved { return diverges(); }
    or_int(expected)
}

// `N0344`: an arm whose every value an earlier arm matches.
fn unreachable_arm(c: Ck, arms: Ints, index: Int, rows: Mat, row_arms: Ints, pat: Int) -> Int {
    let arm = ints_get(arms, index);
    let pattern = fld(c, arm, "pattern");
    if plain(c, pat) && pattern_kind(c, pattern) == "Variant" {
        let v = sx_kid(c.t, pattern, 0);
        let mut r = 0;
        while r < mat_rows(rows) {
            let first = mat_first(c, rows, r);
            if first >= 0 {
                if plain(c, first) && ints_get(c.pty, first) == ints_get(c.pty, pat) && ints_get(c.pval, first) == ints_get(c.pval, pat) {
                    let other = fld(c, ints_get(arms, ints_get(row_arms, r)), "pattern");
                    if pattern_kind(c, other) == "Variant" {
                        let ty = ints_get(c.pty, pat);
                        let vi = ints_get(c.evf, ta(c, ty)) + ints_get(c.pval, pat);
                        err(c, "N0344", fld(c, v, "variant_span"), cat5("`", show(c, ty), ".", strs_get(c.vname, vi), "` already has an arm"),
                                "the discriminant selects exactly one arm, so a second one for the same variant can never run");
                        sec(c, fld(c, sx_kid(c.t, other, 0), "variant_span"), "first covered here");
                        return 0;
                    }
                    r = mat_rows(rows);
                }
            }
            r = r + 1;
        }
    }
    err(c, "N0344", pattern_span(c.t, pattern), "this arm can never run: the arms above match every value it does",
            "arms are tried in order, and the first that matches runs")
}

// One variant's pattern with every payload discarded.
fn plain(c: Ck, p: Int) -> Bool {
    if pkind(c, p) != pk_ctor() { return false; }
    let args = pargs_of(c, p);
    let mut i = 0;
    while i < ints_len(args) {
        if pkind(c, ints_get(args, i)) != pk_wild() { return false; }
        i = i + 1;
    }
    true
}

// `N0343`: a `match` some value of `sty` escapes.
fn report_uncovered(c: Ck, sty: Int, rows: Mat, span: Int, source: Str) -> Int {
    let one_ty = ints_new();
    ints_push(one_ty, sty);
    let w = witness(c, rows, one_ty, 0);
    if is_witness(w) == false { return 0; }
    let mut shown = "_";
    if strs_len(w) > 0 { shown = strs_get(w, 0); }
    if source == "Let" {
        return err(c, "N0343", span, cat3("this `let` pattern does not match `", shown, "`"),
                "a pattern that can fail needs an `else`: `let P = e else { return …; };`");
    }
    let mut all_plain = true;
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first < 0 { all_plain = false; } else {
            if plain(c, first) == false { all_plain = false; }
        }
        r = r + 1;
    }
    if is_enum(c, sty) && all_plain {
        let e = ta(c, sty);
        let missing = strs_new();
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let mut covered = false;
            r = 0;
            while r < mat_rows(rows) {
                if ints_get(c.pval, mat_first(c, rows, r)) == v { covered = true; }
                r = r + 1;
            }
            if covered == false { strs_push(missing, strs_get(c.vname, ints_get(c.evf, e) + v)); }
            v = v + 1;
        }
        err(c, "N0343", span, str_concat("this `match` does not cover ", quoted(missing)),
                cat3("an enum is closed, so every variant of `", show(c, sty), "` gets an arm — or a `_` covers the rest, which gives up being told when a variant is added"));
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        return 0;
    }
    let mut help = "an integer or a string has more values than any list of literals: end with `_` or a name to cover the rest";
    if is_enum(c, sty) || sty == t_bool() { help = "add an arm for it, or end with `_` or a name to cover the rest"; }
    err(c, "N0343", span, cat3("this `match` does not cover `", shown, "`"), help)
}

// `N0632`, a warning: a `match` on an enum whose `_`, or bare name, covers variants no arm names.
fn warn_covering(c: Ck, sty: Int, arms: Ints) -> Int {
    if is_enum(c, sty) == false { return 0; }
    let seen = strs_new();
    let mut i = 0;
    while i < ints_len(arms) {
        named_variants(c, fld(c, ints_get(arms, i), "pattern"), seen);
        i = i + 1;
    }
    let mut catch_all = 0 - 1;
    i = 0;
    while i < ints_len(arms) && catch_all < 0 {
        let arm = ints_get(arms, i);
        let k = pattern_kind(c, fld(c, arm, "pattern"));
        if some(c, arm, "guard") == false && (k == "Wildcard" || k == "Bind") { catch_all = fld(c, arm, "pattern"); }
        i = i + 1;
    }
    if catch_all < 0 { return 0; }
    let shown = show(c, sty);
    let mut base = shown;
    let mut j = 0;
    while j < str_len(shown) {
        if str_byte(shown, j) == 91 {
            base = str_slice(shown, 0, j);
            j = str_len(shown);
        }
        j = j + 1;
    }
    let e = ta(c, sty);
    let covered = strs_new();
    let mut v = 0;
    while v < ints_get(c.evc, e) {
        let n = strs_get(c.vname, ints_get(c.evf, e) + v);
        if strs_find(seen, n) < 0 { strs_push(covered, cat5("`", base, ".", n, "`")); }
        v = v + 1;
    }
    if strs_len(covered) == 0 { return 0; }
    let mut which = "this name";
    if pattern_kind(c, catch_all) == "Wildcard" { which = "`_`"; }
    let at = fld(c, catch_all, "span");
    dg_push(c.w, "N0632", "warning", sps(c, at), spe(c, at),
            cat5(which, " covers ", str_join(covered, ", "), ", which no arm names: a variant added to `", cat3(base, "` later is covered too, without a word", "")), "",
            cat3("name them, so that adding a variant to `", base, "` is reported at this `match`"))
}

fn named_variants(c: Ck, p: Int, out: Strs) -> Int {
    let k = pattern_kind(c, p);
    if k == "Variant" { strs_push(out, fname_of(c, sx_kid(c.t, p, 0), "variant")); }
    if k == "Or" {
        let alts = kids(c, p, "alts");
        let mut i = 0;
        while i < ints_len(alts) {
            named_variants(c, ints_get(alts, i), out);
            i = i + 1;
        }
    }
    0
}

// One pattern against a value of type `ty`: what it binds into `binds`, and what it matches.
fn check_pattern(c: Ck, p: Int, ty: Int, scrutinee: Int, binds: Binds) -> Int {
    let k = pattern_kind(c, p);
    if k == "Wildcard" { return wild(c); }
    if k == "Bind" {
        let at = fld(c, p, "span");
        strs_push(binds.names, fname_of(c, p, "name"));
        ints_push(binds.starts, sps(c, at));
        ints_push(binds.ends, spe(c, at));
        ints_push(binds.tys, ty);
        return wild(c);
    }
    if k == "Literal" { return check_literal_pattern(c, sx_kid(c.t, p, 0), ty); }
    if k == "Variant" { return check_variant_pattern(c, sx_kid(c.t, p, 0), ty, scrutinee, binds); }
    if k == "Tuple" {
        // No tuple type is carried, so the value is never one.
        err(c, "N0300", fld(c, p, "span"), cat5("this pattern is a tuple of ", int_to_str(ints_len(kids(c, p, "elems"))), ", but the value is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    // `p | q | …`: each alternative binds the same names, with the same types.
    let alts = kids(c, p, "alts");
    let out = ints_new();
    let mut first = no_binds();
    let mut have_first = false;
    let mut i = 0;
    while i < ints_len(alts) {
        let alt = ints_get(alts, i);
        let own = no_binds();
        ints_push(out, check_pattern(c, alt, ty, scrutinee, own));
        if have_first == false {
            first = own;
            have_first = true;
        } else {
            if same_bindings(c, first, own) == false {
                err(c, "N0629", pattern_span(c.t, alt), "this alternative binds other names, or other types, than the first",
                        "the arm's body sees the same names whichever alternative matched, so each binds them all, with one type each");
                sec(c, fld(c, p, "span"), "in this or-pattern");
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(first.names) {
        strs_push(binds.names, strs_get(first.names, i));
        ints_push(binds.starts, ints_get(first.starts, i));
        ints_push(binds.ends, ints_get(first.ends, i));
        ints_push(binds.tys, ints_get(first.tys, i));
        i = i + 1;
    }
    pat_new(c, pk_or(), 0, "", 0, out)
}

// Whether two alternatives bind the same names with the same types, each list sorted by name.
fn same_bindings(c: Ck, a: Binds, b: Binds) -> Bool {
    if strs_len(a.names) != strs_len(b.names) { return false; }
    let sa = sorted_bindings(a);
    let sb = sorted_bindings(b);
    let mut i = 0;
    while i < strs_len(sa) {
        if strs_get(sa, i) != strs_get(sb, i) { return false; }
        i = i + 1;
    }
    true
}

// A binding list as `name|type` strings, stably sorted by name.
fn sorted_bindings(b: Binds) -> Strs {
    let names = strs_new();
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(b.names) {
        let n = strs_get(b.names, i);
        let mut at = 0;
        while at < strs_len(names) && (str_less(strs_get(names, at), n) || strs_get(names, at) == n) { at = at + 1; }
        insert_str(names, at, n);
        insert_str(out, at, cat3(n, "|", int_to_str(ints_get(b.tys, i))));
        i = i + 1;
    }
    out
}

// A literal pattern: an integer (perhaps negated), a string, `true` or `false`, of the scrutinee's
// type.
fn check_literal_pattern(c: Ck, e: Int, ty: Int) -> Int {
    let k = kind_of(c, e);
    let mut key = "";
    let mut has_key = false;
    if sx_kind(c.t, e) != tk_tuple() {
        if k == "Int" {
            key = str_concat("i", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
        if k == "WideInt" {
            stop(c, "a wide integer");
            return wild(c);
        }
        if k == "Neg" {
            let o = fld(c, e, "operand");
            if sx_kind(c.t, o) != tk_tuple() && kind_of(c, o) == "Int" {
                key = str_concat("i-", sx_text(c.t, fld(c, o, "value")));
                has_key = true;
            }
            if sx_kind(c.t, o) != tk_tuple() && kind_of(c, o) == "WideInt" {
                stop(c, "a wide integer");
                return wild(c);
            }
        }
        if k == "Str" {
            key = str_concat("s", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
        if k == "Bool" {
            key = str_concat("b", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
    }
    let literal_type = is_integer(c, ty) || ty == t_bool() || ty == t_str() || bname_of(c, ty) == "Text";
    if has_key == false || literal_type == false {
        let mut message = cat3("a `", show(c, ty), "` has no literal pattern");
        if literal_type { message = "a literal pattern is an integer, a string, `true` or `false`"; }
        err(c, "N0300", espan(c, e), message,
                "a `Bool`, an integer or a string is matched by literals; a float's equality is not what a literal reads as, so it has none");
        return wild(c);
    }
    let t = value_type(c, e, ty);
    if t != ty {
        err(c, "N0300", espan(c, e), cat5("this pattern is a `", show(c, t), "`, but the value is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    if k == "Bool" {
        if sx_text(c.t, fld(c, e, "value")) == "true" { return pat_new(c, pk_bool(), 1, "", 0, ints_new()); }
        return pat_new(c, pk_bool(), 0, "", 0, ints_new());
    }
    pat_new(c, pk_lit(), 0, key, 0, ints_new())
}

// `Enum.Variant(field: pattern, …)` against a value of type `ty`.
fn check_variant_pattern(c: Ck, v: Int, ty: Int, scrutinee: Int, binds: Binds) -> Int {
    if is_enum(c, ty) == false {
        err(c, "N0342", fld(c, v, "ty_span"), cat3("a variant pattern needs an enum, but this is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    let tname = written_key(c, v, "ty");
    let mut named = ta(c, ty);
    if tname != "" {
        let def = resolve_type(c, tname, fld(c, v, "ty_span"));
        if is_enum(c, def) == false {
            enum_refused(c, tname, def, fld(c, v, "ty_span"));
            return wild(c);
        }
        named = ta(c, def);
    }
    // The enum a pattern names is a definition: the value supplies its arguments.
    if named != ta(c, ty) {
        let want = show(c, ty);
        err(c, "N0345", fld(c, v, "ty_span"), cat5("this pattern is a `", show(c, enum_ty(c, named, ints_new())), "`, but the value is a `", want, "`"),
                "a variant belongs to its enum, so a pattern names the value's own enum. There is no structural matching between two enums that happen to have a variant of the same name");
        sec(c, espan(c, scrutinee), cat3("this is a `", want, "`"));
        return wild(c);
    }
    let variant = fname_of(c, v, "variant");
    let vi = variant_of(c, ty, variant);
    let e = ta(c, ty);
    if vi < 0 {
        let known = strs_new();
        let mut i = 0;
        while i < ints_get(c.evc, e) {
            strs_push(known, strs_get(c.vname, ints_get(c.evf, e) + i));
            i = i + 1;
        }
        let mut help = "";
        if strs_len(known) > 0 { help = str_concat("its variants are ", quoted(known)); }
        err(c, "N0341", fld(c, v, "variant_span"), cat5("`", show(c, ty), "` has no variant `", variant, "`"), help);
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        return wild(c);
    }
    let at = vi - ints_get(c.evf, e);
    let path = cat3(show(c, ty), ".", variant);
    let arity = ints_get(c.vfc, vi);
    let args = wilds(c, arity);
    let fields = kids(c, v, "fields");
    // Payload patterns by position (R1.5, D4): named in declaration order.
    let names = strs_new();
    let mut positional = false;
    let mut by_name = false;
    let mut i = 0;
    while i < ints_len(fields) {
        let n = fname_of(c, ints_get(fields, i), "name");
        strs_push(names, n);
        if n == "" { positional = true; } else { by_name = true; }
        i = i + 1;
    }
    if positional {
        if by_name || ints_len(fields) != arity {
            err(c, "N0334", fld(c, v, "span"), cat5(cat3("`", path, "` has "), int_to_str(arity), str_concat(" payload field", plural(arity)),
                    ": a pattern gives every one by position, in the order declared, or every one by name", ""), "");
            return wild(c);
        }
        i = 0;
        while i < arity {
            strs_set(names, i, strs_get(c.fname, ints_get(c.vff, vi) + i));
            i = i + 1;
        }
    }
    let given = strs_new();
    let gs_ = ints_new();
    i = 0;
    while i < ints_len(fields) {
        let f = ints_get(fields, i);
        let name = strs_get(names, i);
        let ns = fld(c, f, "name_span");
        let fi = variant_field(c, vi, name);
        if fi < 0 {
            err(c, "N0333", ns, cat5("`", path, "` has no payload field `", name, "`"), "");
            sec_at(c, ints_get(c.vns, vi), ints_get(c.vne, vi), "declared here");
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                err(c, "N0332", ns, cat3("this pattern names `", name, "` twice"), "");
                sec(c, ints_get(gs_, first), "first named here");
            } else {
                strs_push(given, name);
                ints_push(gs_, ns);
                let sub = check_pattern(c, fld(c, f, "pattern"), field_ty_in(c, ty, fi), scrutinee, binds);
                ints_set(args, fi - ints_get(c.vff, vi), sub);
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < arity {
        let n = strs_get(c.fname, ints_get(c.vff, vi) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", fld(c, v, "variant_span"), cat5("this pattern does not name ", quoted(missing), " of `", path, "`"),
                "a pattern names every payload field, matching it or discarding it with `_`. There is no rest pattern, so adding a payload field breaks the patterns that did not know about it rather than ignoring it");
    }
    pat_new(c, pk_ctor(), at, "", ty, args)
}

// --- `?` (`check_propagate`) ---------------------------------------------------------------------

// Whether a type is an application of the core prelude's enum of this name — by definition, so a
// module's own enum of the same shape is not one.
fn prelude_enum(c: Ck, t: Int, name: Str) -> Bool { is_enum(c, t) && ta(c, t) == declared_enum(c, prelude(c), name) && targc(c, t) > 0 }

// `operand?`: a `Result[T, E]`'s `T` in a function returning a `Result[U, E]`, or an
// `Option[T]`'s `T` in one returning an `Option` (R1, 5b.17); its completion is the operand's.
fn check_propagate(c: Ck, e: Int, expected: Int) -> Int {
    let operand = fld(c, e, "operand");
    let at = fld(c, e, "op_span");
    let ot = check_expr(c, operand, none());
    if ot == diverges() { return diverges(); }
    if ot == unit() {
        err(c, "N0300", espan(c, operand), "this produces no value", "`?` takes apart a `Result`, and this is not a value at all");
        return or_int(expected);
    }
    let declared = gs(c, s_ret());
    let shown_ret = show(c, declared);
    let rspan = gs(c, s_rs());
    if prelude_enum(c, ot, "Option") {
        if prelude_enum(c, declared, "Option") == false {
            err(c, "N0361", at,
                    cat3("`?` on an `Option` can only be used in a function that returns an `Option`, and this one returns `", shown_ret, "`"),
                    "`?` leaves the function with `None`. Here, `match` on the value instead");
            sec(c, rspan, cat3("declared `", shown_ret, "` here"));
        }
        return targ(c, ot, 0);
    }
    let shown = show(c, ot);
    if prelude_enum(c, ot, "Result") == false || targc(c, ot) != 2 {
        err(c, "N0360", at, cat3("`?` needs a `Result`, but this is `", shown, "`"),
                "`?` propagates the core prelude's `Result` and `Option` and nothing else — not an enum with the same variants. Take the value apart with `match` instead");
        sec(c, espan(c, operand), cat3("this is `", shown, "`"));
        return or_int(expected);
    }
    let ok = targ(c, ot, 0);
    let error = targ(c, ot, 1);
    if prelude_enum(c, declared, "Result") == false || targc(c, declared) != 2 {
        err(c, "N0361", at, cat3("`?` can only be used in a function that returns a `Result`, and this one returns `", shown_ret, "`"),
                "`?` leaves the function with the error, so the function has to return a `Result` with the same error type. Here, `match` on the value and decide what the error means instead");
        sec(c, rspan, cat3("declared `", shown_ret, "` here"));
        return ok;
    }
    let into_err = targ(c, declared, 1);
    if error != into_err {
        let have = show(c, error);
        let want = show(c, into_err);
        err(c, "N0362", at, cat5("this `?` propagates a `", have, "`, but the function's error type is `", want, "`"),
                "there is no conversion between error types: `?` returns the error value as it is. Match on the value and build the error this function returns");
        sec(c, espan(c, operand), cat3("its error type is `", have, "`"));
        sec(c, rspan, cat3("the function returns `", want, "` errors"));
    }
    ok
}

// Why a name before a variant's `.` is no enum (`resolve_enum`), its unknown name already reported.
fn enum_refused(c: Ck, name: Str, t: Int, span: Int) -> Int {
    if is_record(c, t) {
        return err(c, "N0341", span, cat3("`", show(c, t), "` is a record, so it has no variants"),
                "a record is built by naming its fields: `Point(x: 1, y: 2)`");
    }
    if is_builtin_name(name) {
        return err(c, "N0341", span, cat3("`", show(c, t), "` is a built-in type, so it has no variants"), "only an `enum` has variants");
    }
    0
}

// --- effects and authority (`nazm-core/src/effects.rs`) -----------------------------------------

fn pow2(n: Int) -> Int {
    let mut v = 1;
    let mut i = 0;
    while i < n {
        v = v * 2;
        i = i + 1;
    }
    v
}
fn has_bit(mask: Int, bit: Int) -> Bool { (mask / pow2(bit)) % 2 == 1 }
fn with_bit(mask: Int, bit: Int) -> Int {
    if has_bit(mask, bit) { return mask; }
    mask + pow2(bit)
}

fn effect_names() -> Strs {
    let s = strs_new();
    strs_push(s, "io");
    strs_push(s, "spawn");
    strs_push(s, "foreign");
    s
}

// A capability kind's bit: its place in `CapabilityKind::ALL`, which the built-in type names
// list from `IoCap` on.
fn cap_bit(name: Str) -> Int { strs_find(builtin_names(), name) - 6 }
fn cap_name(bit: Int) -> Str { strs_get(builtin_names(), bit + 6) }
fn cap_article(bit: Int) -> Str {
    let n = cap_name(bit);
    if n == "IoCap" || n == "MmioCap" || n == "OutCap" { return "an"; }
    "a"
}

// The set a declaration writes (`effects::declared`), every unknown and duplicate name reported;
// -1 when a name is no effect.
fn declared_effects(c: Ck, decl: Int) -> Int {
    let names = kids(c, decl, "names");
    let mut set = 0;
    let mut known = true;
    let mut i = 0;
    while i < ints_len(names) {
        let pair = ints_get(names, i);
        let name = sx_text(c.t, sx_kid(c.t, pair, 0));
        let span = sx_kid(c.t, pair, 1);
        let e = strs_find(effect_names(), name);
        if e < 0 {
            known = false;
            err(c, "N0367", span, cat3("`", name, "` is not an effect"),
                    "the effects are `io` and `spawn` and `foreign`. There are no user-defined effects");
        } else {
            if has_bit(set, e) {
                err(c, "N0368", span, cat3("`", name, "` is written twice in this effect set"), "");
                if i > 0 {
                    let before = sx_kid(c.t, ints_get(names, i - 1), 1);
                    dg_fix(c.d, spe(c, before), spe(c, span), "", cat3("remove the second `", name, "`"), "automatic",
                            "a set holds an effect once, so the second one means nothing");
                }
            } else {
                set = with_bit(set, e);
            }
        }
        i = i + 1;
    }
    if known { return set; }
    0 - 1
}

// The authority the bindings in scope hold: each capability-typed binding no later one hides.
fn held_caps(c: Ck) -> Int {
    let mut held = 0;
    let mut i = 0;
    while i < strs_len(c.sname) {
        let t = ints_get(c.sty, i);
        if is_cap(c, t) {
            let mut hidden = false;
            let mut k = i + 1;
            while k < strs_len(c.sname) {
                if strs_get(c.sname, k) == strs_get(c.sname, i) { hidden = true; }
                k = k + 1;
            }
            if hidden == false { held = with_bit(held, cap_bit(bname_of(c, t))); }
        }
        i = i + 1;
    }
    held
}

// A resolved call, filed under the function whose body holds it (`record_site`).
fn record_site(c: Ck, at: Int, target: Int) -> Int {
    let f = gs(c, s_fn());
    if f < 0 { return 0; }
    ints_push(c.sfn, f);
    ints_push(c.sstart, sps(c, at));
    ints_push(c.send, spe(c, at));
    if target >= 0 {
        ints_push(c.sbuiltin, 0 - 1);
        ints_push(c.suser, target);
    } else {
        ints_push(c.sbuiltin, 0 - 2 - target);
        ints_push(c.suser, 0 - 1);
    }
    ints_push(c.sheld, held_caps(c));
    0
}

fn builtin_effect(c: Ck, b: Int) -> Int { strs_find(effect_names(), strs_get(c.beff, b)) }

fn builtin_caps(c: Ck, b: Int) -> Int {
    let names = split(strs_get(c.bcaps, b), 44);
    let mut set = 0;
    let mut i = 0;
    while i < strs_len(names) {
        if strs_get(names, i) != "" { set = with_bit(set, cap_bit(strs_get(names, i))); }
        i = i + 1;
    }
    set
}

// Why each function requires each effect: the first reason met. Each reason: the function, the
// effect, where, its source (1 a built-in, 2 a declared callee, 3 an inferred one) and which.
pub struct Reasons {
    fnid: Ints,
    effect: Ints,
    start: Ints,
    end: Ints,
    source: Ints,
    which: Ints,
}

fn reason_of(rs: Reasons, f: Int, effect: Int) -> Int {
    let mut i = 0;
    while i < ints_len(rs.fnid) {
        if ints_get(rs.fnid, i) == f && ints_get(rs.effect, i) == effect { return i; }
        i = i + 1;
    }
    0 - 1
}

fn describe(c: Ck, rs: Reasons, r: Int) -> Str {
    let e = tick(strs_get(effect_names(), ints_get(rs.effect, r)));
    let src = ints_get(rs.source, r);
    let w = ints_get(rs.which, r);
    if src == 1 { return cat4("the built-in `", strs_get(c.bname, w), "` requires ", e); }
    if src == 2 { return cat4("calls `", strs_get(c.fnname, w), "`, whose declared set includes ", e); }
    if src == 4 { return cat3("calls `", strs_get(c.fnname, w), "`, which is in another module and declares no effect set, so every effect is assumed of it"); }
    cat4("calls `", strs_get(c.fnname, w), "`, which requires ", e)
}

fn set_text(set: Int) -> Str {
    if set == 0 { return "{}"; }
    let names = strs_new();
    let mut e = 0;
    while e < 3 {
        if has_bit(set, e) { strs_push(names, strs_get(effect_names(), e)); }
        e = e + 1;
    }
    cat3("{ ", str_join(names, ", "), " }")
}

// Settle the effects of the module's functions and check each declared set and each body's
// authority (`effects::analyse`), for a module of the program itself (R1.5, D8: its functions
// hold `main`'s output authority).
fn analyse_effects(c: Ck, m: Int) -> Int {
    let nodes = ints_new();
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if ints_get(c.fnmod, f) == m { ints_push(nodes, f); }
        f = f + 1;
    }
    // Round zero, each body's own effects; then rounds over the edges until nothing changes.
    let sets = ints_new();
    let rs = Reasons(fnid: ints_new(), effect: ints_new(), start: ints_new(), end: ints_new(), source: ints_new(), which: ints_new());
    let mut n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        let mut set = 0;
        let mut s = 0;
        while s < ints_len(c.sfn) {
            if ints_get(c.sfn, s) == me {
                let b = ints_get(c.sbuiltin, s);
                let g = ints_get(c.suser, s);
                if b >= 0 {
                    let e = builtin_effect(c, b);
                    if e >= 0 && has_bit(set, e) == false {
                        set = with_bit(set, e);
                        add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), 1, b);
                    }
                }
                // A callee's declared set is its contract; another module's undeclared one is
                // assumed to do everything the bridge covers, and `foreign` if it can be handed
                // the authority for it.
                let mut contract = 0 - 1;
                let mut source = 2;
                if g >= 0 {
                    contract = ints_get(c.fneff, g);
                    if contract < 0 && ints_get(c.fnmod, g) != m {
                        contract = 3;
                        if receives_foreign(c, g) { contract = 7; }
                        source = 4;
                    }
                }
                if contract >= 0 {
                    let mut e = 0;
                    while e < 3 {
                        if has_bit(contract, e) && has_bit(set, e) == false {
                            set = with_bit(set, e);
                            add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), source, g);
                        }
                        e = e + 1;
                    }
                }
            }
            s = s + 1;
        }
        ints_push(sets, set);
        n = n + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let before = ints_new();
        n = 0;
        while n < ints_len(sets) {
            ints_push(before, ints_get(sets, n));
            n = n + 1;
        }
        n = 0;
        while n < ints_len(nodes) {
            let me = ints_get(nodes, n);
            let mut s = 0;
            while s < ints_len(c.sfn) {
                let g = ints_get(c.suser, s);
                if ints_get(c.sfn, s) == me && g >= 0 {
                    if ints_get(c.fneff, g) < 0 && ints_get(c.fnmod, g) == m {
                        let theirs = ints_get(before, index_of(nodes, g));
                        let mut e = 0;
                        while e < 3 {
                            if has_bit(theirs, e) && has_bit(ints_get(sets, n), e) == false {
                                ints_set(sets, n, with_bit(ints_get(sets, n), e));
                                add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), 3, g);
                                changed = true;
                            }
                            e = e + 1;
                        }
                    }
                }
                s = s + 1;
            }
            n = n + 1;
        }
    }
    // Authority first, then effects, function by function.
    n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        check_authority(c, me, ints_get(c.mstd, m) == 0);
        let declared = ints_get(c.fneff, me);
        if declared >= 0 {
            let missing = without(ints_get(sets, n), declared);
            if missing != 0 { undeclared(c, rs, me, declared, missing); }
        }
        n = n + 1;
    }
    0
}

// Whether one of a function's parameters can carry a `ForeignCap` (`carries`): the only way a
// function of another module could reach C.
fn receives_foreign(c: Ck, g: Int) -> Bool {
    let mut k = 0;
    while k < ints_get(c.fnpc, g) {
        if carries_foreign(c, ints_get(c.ptys, ints_get(c.fnpf, g) + k), 0) { return true; }
        k = k + 1;
    }
    false
}

fn carries_foreign(c: Ck, t: Int, depth: Int) -> Bool {
    if depth > max_depth() * 4 { return true; }
    if bname_of(c, t) == "ForeignCap" { return true; }
    if tag(c, t) == tag_vec() { return carries_foreign(c, targ(c, t, 0), depth + 1); }
    if is_record(c, t) || is_enum(c, t) {
        let edges = contained(c, t);
        let mut i = 0;
        while i < ints_len(edges) {
            if carries_foreign(c, field_ty_in(c, t, ints_get(edges, i)), depth + 1) { return true; }
            i = i + 1;
        }
    }
    false
}

fn add_reason(rs: Reasons, f: Int, effect: Int, s: Int, e: Int, source: Int, which: Int) -> Int {
    ints_push(rs.fnid, f);
    ints_push(rs.effect, effect);
    ints_push(rs.start, s);
    ints_push(rs.end, e);
    ints_push(rs.source, source);
    ints_push(rs.which, which);
    0
}

fn index_of(xs: Ints, v: Int) -> Int {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == v { return i; }
        i = i + 1;
    }
    0 - 1
}

fn without(a: Int, b: Int) -> Int {
    let mut out = 0;
    let mut i = 0;
    while i < 10 {
        if has_bit(a, i) && has_bit(b, i) == false { out = with_bit(out, i); }
        i = i + 1;
    }
    out
}

// Every kind the body exercises without holding it, once each, at the first call that needs it
// (`authority` and `missing_authority`).
fn check_authority(c: Ck, me: Int, program: Bool) -> Int {
    let who = tick(strs_get(c.fnname, me));
    let mut reported = 0;
    let mut s = 0;
    while s < ints_len(c.sfn) {
        let b = ints_get(c.sbuiltin, s);
        if ints_get(c.sfn, s) == me && b >= 0 {
            // A module of the program holds `main`'s output authority (R1.5, D8); an `IoCap`
            // gives an `OutCap`.
            let mut held = ints_get(c.sheld, s);
            if program || has_bit(held, cap_bit("IoCap")) { held = with_bit(held, cap_bit("OutCap")); }
            let need = without(without(builtin_caps(c, b), held), reported);
            let mut k = 0;
            while k < 10 {
                if has_bit(need, k) {
                    reported = with_bit(reported, k);
                    let kind = cap_name(k);
                    let bn = strs_get(c.bname, b);
                    dg_error(c.d, "N0369", ints_get(c.sstart, s), ints_get(c.send, s),
                            cat5(cat3("the built-in `", bn, "` requires `"), kind, "` authority, and ", who, cat3(" holds no `", kind, "` here")),
                            cat5("`", bn, "` is authorised by ", cap_article(k), cat3(" `", kind, "`")),
                            cat5(cat3("authority is a value: give ", who, " "), cap_article(k), " `", kind,
                            "` parameter and have each caller pass one. The only source of one is `main`'s parameters"));
                    if ints_get(c.fnws, me) >= 0 {
                        sec_at(c, ints_get(c.fnws, me), ints_get(c.fnwe, me), "an effect set says what a function does, not what allows it");
                    }
                }
                k = k + 1;
            }
        }
        s = s + 1;
    }
    0
}

// `N0366`: a declared set the body exceeds, with the chain of reasons to where it ends.
fn undeclared(c: Ck, rs: Reasons, me: Int, declared: Int, missing: Int) -> Int {
    let who = tick(strs_get(c.fnname, me));
    let listed = strs_new();
    let mut first = 0 - 1;
    let mut e = 0;
    while e < 3 {
        if has_bit(missing, e) {
            strs_push(listed, tick(strs_get(effect_names(), e)));
            if first < 0 { first = e; }
        }
        e = e + 1;
    }
    let list = str_join(listed, " and ");
    let shown = set_text(declared);
    let r = reason_of(rs, me, first);
    dg_error(c.d, "N0366", ints_get(rs.start, r), ints_get(rs.end, r), cat5(who, " declares `! ", shown, "`, but its body requires ", list),
            describe(c, rs, r),
            "a declared effect set is a contract: the body may require no effect outside it. Declare the effect, or stop calling what requires it");
    let mut hop = r;
    let mut seen = 0;
    while ints_get(rs.source, hop) == 3 && seen <= 64 {
        seen = seen + 1;
        let g = ints_get(rs.which, hop);
        let next = reason_of(rs, g, first);
        if next < 0 { seen = 100; } else {
            sec_at(c, ints_get(rs.start, next), ints_get(rs.end, next), cat4("in `", strs_get(c.fnname, g), "`: ", describe(c, rs, next)));
            hop = next;
        }
    }
    let wider = set_text(declared + missing);
    sec_at(c, ints_get(c.fnws, me), ints_get(c.fnwe, me), cat3("declared `! ", shown, "` here"));
    dg_fix(c.d, ints_get(c.fnws, me), ints_get(c.fnwe, me), str_concat("! ", wider), cat3("declare `! ", wider, "`"), "needs_review",
            cat5(who, " is meant to exercise ", list, ". Widening a contract can break a caller whose own declared set lacks ", list));
    0
}
