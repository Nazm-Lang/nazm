// The checker, written against `syntax.nz`'s tree (R2, slices 3-4; `openspec/changes/r2-front-end/`
// design D13): a port of `nazm-core/src/check` and `nazm-sema`, stage by stage as `check_reusing`
// runs them, each diagnostic as the reference words and places it.
//
// It knows where it stops. Whatever it meets that it does not carry yet — a construct, a type, a
// built-in, a stage — it records as the reason it stopped (`ck_stopped`), and the driver then
// reports none of its diagnostics for that compilation: a partial checker must never say what the
// reference would not, so every difference among the compilations it does carry is a defect.
//
// Carried today: a compilation's modules — the root, what it imports, the standard modules and the
// core prelude — each checked against its direct imports' interfaces: `pub` visibility, plain
// imports and imports under a name (`alias::f`, `alias::T`), their collisions (N0207, N0208,
// N0209), private and unimported names (N0206, N0201, N0305), unknown qualified names (N0210)
// and another module's undeclared effects; re-exports (`pub use`, N103); records and enums, generic ones included, and
// `Vec`s, tuples (the generic record of their arity), arrays and applications of any type; functions
// with type parameters (and `Equality` requirements), effect parameters (N51) and contracts (N87),
// and result types taken from an expression body (R1.5, D2);
// attributes but `@derive`, configured before the checker runs (`configure.nz`); `let`,
// assignment to a binding or its fields, `while`, `for`, `return`, `break`, `continue`, `defer`;
// literals,
// names, `-`, `!`, the binary operators but shifts, calls of the module's functions and of the built-ins (generic ones by
// inference, `Box`, `Cell` and `Chain` among them), construction of records and of variants
// (a generic enum's arguments inferred, `Some`/`None`/`Ok`/`Err` among them), field reads, `if`
// and blocks; `match` and what desugars to it (`if let`, `while let`, `let … else`, a `let` of a
// pattern) with its patterns, exhaustiveness and reachability, and N0632's warning; `?` on the
// prelude's `Result` and `Option`; interpolation and what `print(x)` is written as; constants of
// numbers, `Bool` and `Str` and tables of records, enums, tuples and arrays (L8), imported ones
// included, and statics (Gate 3); function types, named
// functions as values, calls through values and closures with their captures (N50); traits,
// impls, bounds, method calls, default methods and `Show` in interpolation (N78); effects
// and authority; provenance and its one rule, `N0372` (N38, N80); the C boundary — foreign
// functions, exports and `extern "C" struct`s (N42, N55, N85); the rules about `main`.

use "syntax.nz";
use "diag.nz";
use "builtins.nz";

// --- the checker's state -------------------------------------------------------------------

pub struct Ck {
    t: Tree,
    d: Diags,
    // Why it stopped; empty while it carries everything it has met.
    stop: Strs,
    // The functions defined again in their module (`N0203`): the reference leaves the one it kept with no solved provenance.
    fndups: Ints,
    // Scalars, by the slots below.
    st: Ints,
    // Modules, in the compilation's order: each one's program node and the offset of its text.
    mprog: Ints,
    mbase: Ints,
    // Types, interned: a tag, three words, a name, and a run of arguments.
    tytag: Ints,
    tya: Ints,
    tyb: Ints,
    tyc: Ints,
    tyname: Strs,
    tyargf: Ints,
    tyargc: Ints,
    tyargs: Ints,
    tykey: Strs,
    // Records: name, module, name span (absolute), type parameters, fields (a run of the pool).
    rname: Strs,
    rmod: Ints,
    rns: Ints,
    rne: Ints,
    rnp: Ints,
    rff: Ints,
    rfc: Ints,
    // Enums: the same, with a run of variants.
    ename: Strs,
    emod: Ints,
    ens: Ints,
    ene: Ints,
    enp: Ints,
    evf: Ints,
    evc: Ints,
    // Variants, pooled: name, name span, fields (a run of the pool).
    vname: Strs,
    vns: Ints,
    vne: Ints,
    vff: Ints,
    vfc: Ints,
    // Fields, pooled: name, type, name span, type span.
    fname: Strs,
    fty: Ints,
    fns: Ints,
    fne: Ints,
    fts: Ints,
    fte: Ints,
    // Whether each record and enum is `pub`.
    rpub: Ints,
    epub: Ints,
    // Functions: name, module, name span, tree node, parameter types (a run of `ptys`), result,
    // whether it returns nothing.
    fnname: Strs,
    fnmod: Ints,
    fnns: Ints,
    fnne: Ints,
    fnnode: Ints,
    fnpf: Ints,
    fnpc: Ints,
    fnret: Ints,
    fnnores: Ints,
    // Each function's declared effect set, as a mask (`io` 1, `spawn` 2, `foreign` 4), or -1 for
    // none written (or one with a word that is no effect); where it is written, or -1.
    fneff: Ints,
    fnws: Ints,
    fnwe: Ints,
    // Call sites, in the order the bodies are checked: the calling function, the callee's span,
    // the built-in (or -1) or the module's function (or -1) it reached, and the authority the
    // bindings in scope there held, as a mask over `CapabilityKind::ALL`.
    sfn: Ints,
    sstart: Ints,
    send: Ints,
    sbuiltin: Ints,
    suser: Ints,
    sheld: Ints,
    ptys: Ints,
    // The built-ins (`builtins.nz`): name, parameter types (a run of `ptys`), result, whether
    // each is carried, whether a module's function of its name hides it, effect, authority.
    bname: Strs,
    bpf: Ints,
    bpc: Ints,
    bret: Ints,
    bok: Ints,
    bprelude: Ints,
    beff: Strs,
    bcaps: Strs,
    // Whether an argument of it is the restricted sink, a path written to (N38); where its result
    // comes from (`Origin::of_intrinsic`) and how it touches a container (`Origin::container`), as
    // the table spells them.
    bpath: Ints,
    bflow: Strs,
    bcont: Strs,
    bsk: Strs,
    // The type names the module being checked may write, and what each names.
    tnames: Strs,
    ttys: Ints,
    // Scopes: bindings, innermost last, and where each frame begins.
    sname: Strs,
    sty: Ints,
    smut: Ints,
    sds: Ints,
    sde: Ints,
    frames: Ints,
    // Per frame: whether it continues the frame outside it as far as shadowing goes (`joined`):
    // a pattern `let`'s arm and the rest of its block.
    fjoin: Ints,
    // Expressions a desugaring checked already, about to check again as the arguments of the
    // call it is read as (`Checker::checked`): each one's span and type, taken by the first
    // check that meets its span.
    cks: Ints,
    cke: Ints,
    ckt: Ints,
    // Each function's type parameters, a run of the pool below: names, and whether each
    // requires `Equality` (N14).
    fntpf: Ints,
    fntpc: Ints,
    tpname: Strs,
    tpeq: Ints,
    // Each built-in's type parameter count, its numeric class, and its shapes as the table
    // spells them (a generic one's types are made per call, `T` being its own parameter).
    bgen: Ints,
    bclass: Strs,
    bshapes: Strs,
    bretshape: Strs,
    // The type parameters in scope for the types written in the body being checked.
    tsn: Strs,
    tst: Ints,
    // Patterns as exhaustiveness sees them (`usefulness::Pat`), pooled: kind, value, literal key,
    // enum, and a run of arguments; and the cells of the pattern matrices' rows.
    pkind: Ints,
    pval: Ints,
    pkey: Strs,
    pty: Ints,
    paf: Ints,
    pac: Ints,
    pargs: Ints,
    cells: Ints,
    // Warnings, published only where there is no error (`check_map_with_warnings`).
    w: Diags,
    // Whether each module is a standard one (or the prelude), whose functions hold no output
    // authority they are not given (R1.5, D8).
    mstd: Ints,
    // Each module's imports as the graph holds them (`Dependency`), a run of the pool below: the
    // module named, where the first `use` of it names it (absolute), whether a plain `use` named
    // it, and the names it is imported under (a run of the alias pool, with their spans). The
    // core prelude is every other module's last.
    dfirst: Ints,
    dcount: Ints,
    don: Ints,
    dats: Ints,
    date: Ints,
    dplain: Ints,
    // Whether the prelude gave the module this one (R1.5, D9): no `use` names it, and a name it
    // brings in yields, silently, to the module's own and to a written import's.
    dimplicit: Ints,
    daf: Ints,
    dac: Ints,
    aname: Strs,
    aats: Ints,
    aate: Ints,
    // Whether each function is exported (`pub`).
    fnpub: Ints,
    // The module being checked's environment beyond its own functions and the built-ins
    // (`environment`): each name a plain import brought in and the function it is; and each
    // alias it may write before `::`, and the module it names.
    envname: Strs,
    envfn: Ints,
    alname: Strs,
    almod: Ints,
    // Every alias the module's types may be written under (`Types::aliases`).
    taliases: Strs,
    // The constants the module being checked may name, and each one's kind (`k_int` and on).
    kname: Strs,
    kkind: Ints,
    // Each constant's value beside its kind: an `Int`'s or a `Bool`'s as `kint`, any other
    // number's or a `Str`'s as `kstr` (a float's is "").
    kint: Ints,
    kstr: Strs,
    // What each module exports of its constants (L8), once its stage 1b has run (`mexp`): the
    // module, the name, the kind and the value.
    mexp: Ints,
    xmod: Ints,
    xname: Strs,
    xkind: Ints,
    xint: Ints,
    xstr: Strs,
    // Per function, the function a closure is written in, or -1 for a declared function (N50).
    fnclos: Ints,
    // The closures being checked, innermost last: each one's id and how many bindings were in
    // scope where it is written (its boundary); and the bindings each has captured, by frame.
    cfid: Ints,
    cfbound: Ints,
    capf: Ints,
    capb: Ints,
    // Per call site, the function type a call through a value reached, or -1.
    sind: Ints,
    // Whether each call site is a `spawn`'s.
    sspawn: Ints,
    // Each named function used as a value (N50): the function, where, the effects its type was
    // given, and the module.
    vfn: Ints,
    vstart: Ints,
    vend: Ints,
    vassumed: Ints,
    // and the type the value was given.
    vty: Ints,
    // Traits (N78): name, module, name span (absolute), whether `pub`, and their methods (a run
    // of the method pool): name, name span, parameters after `self` (a run of `ptys`), result,
    // effect mask.
    trname: Strs,
    trmod: Ints,
    trns: Ints,
    trne: Ints,
    trpub: Ints,
    trmf: Ints,
    trmc: Ints,
    tmname: Strs,
    tmns: Ints,
    tmne: Ints,
    tmpf: Ints,
    tmpc: Ints,
    tmret: Ints,
    tmeff: Ints,
    // Whether each trait method has a default body (R1b, L11): the function `Trait/default/m`.
    tmdef: Ints,
    // Impls filed: trait, type, module, the `impl` keyword's span, and each trait method's
    // function (a run of `imfn`, -1 where none); and the table's answer for a trait and type.
    imtrait: Ints,
    imty: Ints,
    immod: Ints,
    imis: Ints,
    imie: Ints,
    imff: Ints,
    imfn: Ints,
    // What each parameter of an impl of a generic type requires (R1b, L11b), a run of `imreq`:
    // -1 nothing, -2 `Equality`, else a trait. Empty for an impl of a type that is not generic.
    imrf: Ints,
    imrc: Ints,
    imreq: Ints,
    // The impl headers of the module being declared: the `impl` keyword's span, the trait and the
    // type, -1 where either did not resolve.
    hds: Ints,
    hde: Ints,
    htr: Ints,
    hty: Ints,
    // Per function, whether it is an impl's method.
    fnmeth: Ints,
    // Per type parameter (beside `tpname`), the trait it is bound by, or -1.
    tpbound: Ints,
    // The traits the module being checked may name (`trait_scope`), -1 for an ambiguous name.
    tsname: Strs,
    tsid: Ints,
    // What provenance reads of the bodies (N38, N80; the reference's `Resolution`). Each binding:
    // the function it is declared in, its type and name, and whether a closure shares it (R1b,
    // L10); beside the scopes, each binding's id; each function's first parameter's binding;
    // each closure's captures, in the order it made them.
    bfn: Ints,
    bty: Ints,
    bnm: Strs,
    bshr: Ints,
    sbid: Ints,
    fnpb: Ints,
    capcl: Ints,
    capbd: Ints,
    // Where among the bindings each capture's copy is made (`bind` in the closure, as the
    // reference makes it): how many bindings there were then.
    capat: Ints,
    // Per function, its bindings and its captures, in order (a run of `fbl`, of `fcl`): made
    // once, when Core IR first asks (`index_bindings`).
    fbf: Ints,
    fbc: Ints,
    fbl: Ints,
    fcf: Ints,
    fcc: Ints,
    fcl: Ints,
    // Each closure checked and the type it was given (`ClosureInfo::ty`).
    clid: Ints,
    clty: Ints,
    // By the span each is written at: the binding a name is (`var`), the closure an expression
    // makes (`closure_at`), the sequence a `for` reads (`for_seq`), whether a construction is a
    // record's (`construction`), and the call site a call is (`callee`).
    mvar: Smap,
    mclo: Smap,
    // Each function with an `ensures` clause, and the binding its `result` is.
    crfn: Ints,
    crb: Ints,
    // The zero a compound update of a map's absent entry starts from (`map_fallback`), by the
    // brackets' span: the literal made for it.
    mzero: Smap,
    // The record or enum each type name written resolved to, by the name's span (for `lsp`'s
    // definition).
    mtyn: Smap,
    // What each type name written is, by the name's span (`record_written_type`, for the semantic tokens): 1 a built-in type, 2 a type parameter, 3 a type parameter declared.
    mwty: Smap,
    // The type a list or array literal, or a `[v; n]`, was made as, by its span.
    marr: Smap,
    mfor: Smap,
    mcons: Smap,
    msite: Smap,
    // Per call site: the trait method a call through a bound is (or -1), and the first type
    // argument a generic call was settled with (or -1).
    stm: Ints,
    starg: Ints,
    // The names a later alternative of an or-pattern binds, and where (`aliases`).
    pan: Strs,
    pas: Ints,
    pae: Ints,
    // Each function's effect parameter's name, by the function that declares it (N51), for
    // messages: the last one recorded for an id is its name (`name_effect_param`).
    epown: Ints,
    epnm: Strs,
    // Per call site, the set a call of an effect-polymorphic callee bound its parameter to (N51).
    sbind: Ints,
    // Every array type written, once, with where it was first (Gate 2, `arrays_written`); the
    // ones before `s_arrays` are held to the rules already.
    awty: Ints,
    aws: Ints,
    awe: Ints,
    // How C sees each record (N85, `CRepr`): 0 not at all, 1 an opaque handle, 2 a C layout.
    rrepr: Ints,
    // Whether each function is a foreign declaration (N42) and whether it is an export (N55).
    fnfor: Ints,
    fnexp: Ints,
    // What each module offers beyond its own `pub` definitions: its re-exports (N103).
    rx: Rx,
    // Per function, what its body requires once its module's effects are settled
    // (`inferred_effects`), as a mask like `fneff`'s; -1 for none recorded.
    fnreq: Ints,
    // Why each function requires each effect (`effect_reasons`), the first reason met, of every module's functions in
    // the order they were recorded: what `analyse_effects` settled, kept for the tools (R8 slice 9).
    fnrs: Reasons,
    // What Core IR reads of the bindings and literals (slice 5): each binding's declaration
    // (absolute; a parameter's name) and whether it is `let mut`; each literal's type, by span.
    bds: Ints,
    bde: Ints,
    bmut: Ints,
    mlit: Smap,
    // Each field read, by its name's span: the field (in the pool) and the type it read.
    mfld: Smap,
    mfldty: Smap,
    // The instances made and not yet completed (`Generics::pending`), last made last.
    ipend: Ints,
    // The reference's record and enum tables (`RecordId`, `EnumId` order): each a definition,
    // written `-1 - index`, or an instance, by its type.
    rlog: Ints,
    elog: Ints,
    // What Core IR reads of constructions (`Resolution::variant`, `payload`, `field`): each
    // variant built, by its name's span — its enum (the instance) and its index; and each field or
    // payload field given, by its name's span (of no width, where its value begins, for one given
    // by position), its index in the declaration. A record's construction is `mcons`'s, its type.
    mvty: Smap,
    mvix: Smap,
    minit: Smap,
    // The pool field each of those names, by the same span (`mfini`): what a reader of the references needs.
    mfini: Smap,
    // The own constant each name written at a span is, by its declaration's name's start (`mcref`).
    mcref: Smap,
    // The trait each name written at a span is (`record_mention`), by the span.
    mtrm: Smap,
    // The reference index, built when first asked for (`ck_ref_count`).
    rix: Rix,
    // What Core IR reads of a name that is a constant (`const_use`, `static_cell`): its value, by
    // the name's span — an index into `uk`, `ui`, `us` (its kind and value, as `kint` and `kstr`
    // hold them) — and of a conversion (`NumericFact::Convert`), by the callee's span: an index
    // into `cvto`, `cvmode`, `cvres` (the type converted to, how, and what the call produces).
    mconst: Smap,
    // The mentions of refused captures (N0386), by span: the group of the closure and binding they belong to (`rzb`, `rzf`).
    mrefu: Smap,
    rzb: Ints,
    rzf: Ints,
    uk: Ints,
    ui: Ints,
    us: Strs,
    mconv: Smap,
    cvto: Ints,
    cvmode: Strs,
    cvres: Ints,
    // Per call site, a generic call's settled type arguments (a run of `sargs`) and the result
    // type the checker formed for it (`type_args`, `checked_call`'s instance); -1 for none.
    sargf: Ints,
    // Per call site: what a generic call settled each type parameter to, for signature help: where its run is in `sip` (or -1 for a call that is not generic), then the
    // settled arguments (-1 for one nothing settled), then whether the call is polymorphic in its effects.
    sipf: Ints,
    sip: Ints,
    sargc: Ints,
    sargs: Ints,
    sret: Ints,
}

// A map from a span — its two absolute ends — to an `Int`, as the reference's `HashMap<Span, _>`:
// a chain per bucket of starts, the last value put for a span the one it holds. The buckets are
// as many as the entries, not as the compilation's bytes: one slot per byte, in each of the two
// dozen maps, was most of the checker's memory over a large program (R8 slice 7, the self-build's
// heap). `top` is one past the greatest start put.
pub struct Smap {
    hd: Ints,
    ks: Ints,
    ke: Ints,
    kv: Ints,
    nx: Ints,
    top: Ints,
}

fn sm_new() -> Smap {
    let m = Smap(hd: ints_new(), ks: ints_new(), ke: ints_new(), kv: ints_new(), nx: ints_new(), top: ints_new());
    ints_push(m.top, 0);
    m
}

// The buckets made `n`, every entry chained again, the earlier put further down its chain.
fn sm_rehash(m: Smap, n: Int) -> Int {
    while ints_len(m.hd) > 0 { ints_pop(m.hd); }
    while ints_len(m.hd) < n { ints_push(m.hd, 0 - 1); }
    let mut i = 0;
    while i < ints_len(m.ks) {
        let b = ints_get(m.ks, i) % n;
        ints_set(m.nx, i, ints_get(m.hd, b));
        ints_set(m.hd, b, i);
        i = i + 1;
    }
    0
}

fn sm_put(m: Smap, s: Int, e: Int, v: Int) -> Int {
    if s < 0 { return 0; }
    if ints_len(m.hd) == 0 { sm_rehash(m, 64); }
    let b = s % ints_len(m.hd);
    let mut i = ints_get(m.hd, b);
    while i >= 0 {
        if ints_get(m.ks, i) == s && ints_get(m.ke, i) == e {
            ints_set(m.kv, i, v);
            return 0;
        }
        i = ints_get(m.nx, i);
    }
    ints_push(m.ks, s);
    ints_push(m.ke, e);
    ints_push(m.kv, v);
    ints_push(m.nx, ints_get(m.hd, b));
    ints_set(m.hd, b, ints_len(m.ks) - 1);
    if s + 1 > ints_get(m.top, 0) { ints_set(m.top, 0, s + 1); }
    if ints_len(m.ks) > 2 * ints_len(m.hd) { sm_rehash(m, 4 * ints_len(m.hd)); }
    0
}

fn sm_get(m: Smap, s: Int, e: Int) -> Int {
    if s < 0 || s >= ints_get(m.top, 0) { return 0 - 1; }
    let mut i = ints_get(m.hd, s % ints_len(m.hd));
    while i >= 0 {
        if ints_get(m.ks, i) == s && ints_get(m.ke, i) == e { return ints_get(m.kv, i); }
        i = ints_get(m.nx, i);
    }
    0 - 1
}

// One past the greatest start put: every start is below it.
fn sm_top(m: Smap) -> Int { ints_get(m.top, 0) }

// Empty a map that is used again, touching only what was put.
fn sm_clear(m: Smap) -> Int {
    while ints_len(m.ks) > 0 {
        let s = ints_pop(m.ks);
        ints_pop(m.ke);
        ints_pop(m.kv);
        ints_pop(m.nx);
        ints_set(m.hd, s % ints_len(m.hd), 0 - 1);
    }
    ints_set(m.top, 0, 0);
    0
}

// The module graph as the loader resolved it, handed to `ck_check`: per module, whether it is a
// standard one, and the module each of its `use` items names (by load order; -1 for none).
pub struct Graph {
    standard: Ints,
    first: Ints,
    count: Ints,
    target: Ints,
    // Whether a module had a syntax error (its tree is the parser's recovery).
    syntax: Ints,
    // The standard modules the prelude gives each module (R1.5, D9), by load order.
    ifirst: Ints,
    icount: Ints,
    itarget: Ints,
}

pub fn ck_graph() -> Graph {
    let g = Graph(standard: ints_new(), first: ints_new(), count: ints_new(), target: ints_new(), syntax: ints_new(), ifirst: ints_new(),
            icount: ints_new(), itarget: ints_new());
    ints_push(g.syntax, 0);
    g
}

// The compilation had a syntax error: what the checker says of the trees the parser recovered is
// published after the parser's diagnostics, without the missing `main` — a function that failed to
// parse was never registered — and without warnings, which are published only where there is
// no error (`analyse`, `check_map_with_warnings`).
pub fn ck_graph_syntax_error(g: Graph) -> Int {
    ints_set(g.syntax, 0, 1);
    0
}

// The compilation's attributes were refused (`attributes::configure`), and its trees parsed: as
// after a syntax error, the missing `main` and the warnings are not reported, but a function
// without a body is not one whose body failed to parse.
pub fn ck_graph_attribute_error(g: Graph) -> Int {
    ints_set(g.syntax, 0, 2);
    0
}

pub fn ck_graph_module(g: Graph, standard: Bool) -> Int {
    if standard { ints_push(g.standard, 1); } else { ints_push(g.standard, 0); }
    ints_push(g.first, ints_len(g.target));
    ints_push(g.count, 0);
    ints_push(g.ifirst, ints_len(g.itarget));
    ints_push(g.icount, 0);
    0
}

// A standard module the prelude gives the module added last (R1.5, D9: `import_implicit`).
pub fn ck_graph_implicit(g: Graph, target: Int) -> Int {
    ints_push(g.itarget, target);
    let last = ints_len(g.icount) - 1;
    ints_set(g.icount, last, ints_get(g.icount, last) + 1);
    0
}

pub fn ck_graph_import(g: Graph, target: Int) -> Int {
    ints_push(g.target, target);
    let last = ints_len(g.count) - 1;
    ints_set(g.count, last, ints_get(g.count, last) + 1);
    0
}

fn s_ret() -> Int { 0 }
fn s_rs() -> Int { 1 }
fn s_re() -> Int { 2 }
fn s_loop() -> Int { 3 }
fn s_discard() -> Int { 4 }
fn s_unwanted() -> Int { 5 }
fn s_module() -> Int { 6 }
// The function whose body is being checked, or -1.
fn s_fn() -> Int { 7 }
// The core prelude's module.
fn s_prelude() -> Int { 8 }
// Whether the compilation had a syntax error.
fn s_syntax() -> Int { 9 }
// How many closures the function being checked has written so far (`closure_count`).
fn s_closures() -> Int { 10 }
// Whether the binding the last `lookup_var` reached is seen through a closure as one that is
// neither mutable nor declared anywhere it could be made so (a captured copy).
fn s_captured() -> Int { 11 }
// `@std/hash`'s `Hash`, when the compilation has it (L6), or -1.
fn s_hash() -> Int { 12 }
// How many `scope`s enclose the statement being checked, within its function (`scope_depth`).
fn s_scope() -> Int { 13 }
// Whether a built-in whose result is a file's contents or not followed (a restricted origin,
// N38) is called anywhere in the compilation, and whether a restricted sink is.
fn s_source() -> Int { 14 }
fn s_sink() -> Int { 15 }
// Where the run of fields `resolve_fields` wrote last begins.
fn s_fields() -> Int { 16 }
// The effect parameter in scope for the types written (N51): its function's id plus one, or 0.
fn s_eparam() -> Int { 17 }
// How many of the array types written are held to the rules already (Gate 2).
fn s_arrays() -> Int { 18 }
// Where the `defer` body being checked begins (R1b, L12): the loop depth there plus one, or 0
// outside one.
fn s_defer() -> Int { 19 }
// Instances (`nazm_sema::generic`): whether completing them waits for `settle` (while field types
// are resolved), whether a settling is under way, and how many have been made.
fn s_deferred() -> Int { 20 }
fn s_settling() -> Int { 21 }
fn s_created() -> Int { 22 }
// Whether the next block checked is the rest of a block after a pattern `let` (`join_block`).
fn s_join() -> Int { 23 }
// Whether a type name is being resolved quietly (`quiet_type`): which definition it is is not recorded as a mention.
fn s_quiet() -> Int { 24 }
// Whether the binding the last `lookup_var` reached was a capture the checker refused (N0386): the reference attributes its mentions to a slot of the
// closure that nothing declares.
fn s_refused() -> Int { 25 }
fn s_slots() -> Int { 26 }

fn prelude(c: Ck) -> Int { gs(c, s_prelude()) }

fn gs(c: Ck, slot: Int) -> Int { ints_get(c.st, slot) }
fn ss(c: Ck, slot: Int, v: Int) -> Int { ints_set(c.st, slot, v); 0 }

// Stop: the compilation uses something this checker does not carry yet. The first reason is kept.
fn stop(c: Ck, why: Str) -> Int {
    if strs_len(c.stop) == 0 { strs_push(c.stop, why); }
    0
}

pub fn ck_stopped(c: Ck) -> Str {
    if strs_len(c.stop) == 0 { return ""; }
    strs_get(c.stop, 0)
}

// The errors; where there are none, the warnings (`check_map_with_warnings`).
pub fn ck_diags(c: Ck) -> Diags {
    if dg_len(c.d) == 0 && gs(c, s_syntax()) == 0 { return c.w; }
    c.d
}

fn cat3(a: Str, b: Str, x: Str) -> Str { str_concat(str_concat(a, b), x) }
fn cat4(a: Str, b: Str, x: Str, y: Str) -> Str { str_concat(cat3(a, b, x), y) }
fn cat5(a: Str, b: Str, x: Str, y: Str, z: Str) -> Str { str_concat(cat4(a, b, x, y), z) }
fn tick(s: Str) -> Str { cat3("`", s, "`") }
fn plural(n: Int) -> Str { if n == 1 { return ""; } "s" }

fn starts_upper(s: Str) -> Bool {
    if str_len(s) == 0 { return false; }
    let b = str_byte(s, 0);
    b >= 65 && b <= 90
}

fn str_has(s: Str, part: Str) -> Bool {
    let n = str_len(part);
    let mut i = 0;
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == part { return true; }
        i = i + 1;
    }
    false
}

fn strs_find(xs: Strs, s: Str) -> Int {
    let mut i = 0;
    while i < strs_len(xs) {
        if strs_get(xs, i) == s { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- the tree, as the checker reads it ------------------------------------------------------

fn fld(c: Ck, n: Int, name: Str) -> Int { sx_field(c.t, n, name) }
fn fname_of(c: Ck, n: Int, name: Str) -> Str { sx_name(c.t, n, name) }
fn kids(c: Ck, n: Int, name: Str) -> Ints { sx_items(c.t, sx_field(c.t, n, name)) }
fn some(c: Ck, n: Int, name: Str) -> Bool { sx_is_some(c.t, sx_field(c.t, n, name)) }
fn unwrap(c: Ck, n: Int, name: Str) -> Int { sx_unwrap(c.t, sx_field(c.t, n, name)) }
fn flag(c: Ck, n: Int, name: Str) -> Bool { sx_text(c.t, sx_field(c.t, n, name)) == "true" }

// A span's ends, at their offsets in the whole compilation: the module being worked on's base.
fn base(c: Ck) -> Int { ints_get(c.mbase, gs(c, s_module())) }
fn sps(c: Ck, span: Int) -> Int { sx_s(c.t, span) + base(c) }
fn spe(c: Ck, span: Int) -> Int { sx_e(c.t, span) + base(c) }

// An expression's span, and a statement's.
fn espan(c: Ck, e: Int) -> Int { expr_span(c.t, e) }
fn stmt_span(c: Ck, s: Int) -> Int {
    if sx_kind(c.t, s) == tk_tuple() {
        if sx_text(c.t, s) == "Expr" { return expr_span(c.t, sx_kid(c.t, s, 0)); }
        return sx_field(c.t, sx_kid(c.t, s, 0), "span");
    }
    sx_field(c.t, s, "span")
}

// What kind of node an expression or a statement is: its variant's name.
fn kind_of(c: Ck, n: Int) -> Str { sx_text(c.t, n) }

// Report an error at a tree span of the module being worked on.
fn err(c: Ck, code: Str, span: Int, message: Str, help: Str) -> Int {
    dg_error(c.d, code, sps(c, span), spe(c, span), message, "", help)
}
fn sec(c: Ck, span: Int, message: Str) -> Int { dg_secondary(c.d, sps(c, span), spe(c, span), message) }
fn sec_at(c: Ck, s: Int, e: Int, message: Str) -> Int { dg_secondary(c.d, s, e, message) }

// --- types ------------------------------------------------------------------------------------

fn tag_builtin() -> Int { 1 }
fn tag_vec() -> Int { 2 }
fn tag_record() -> Int { 3 }
fn tag_enum() -> Int { 4 }
fn tag_param() -> Int { 5 }
// A function type (N50): its effects as the first word — the effect parameter bit 3 (N51) — whose
// effect parameter they name as the second (its function's id plus one, 0 for none), its
// parameters and then its result as its arguments.
fn tag_fn() -> Int { 6 }
// `Chan[T]` (N53): a generic channel, its element as its one argument.
fn tag_chan() -> Int { 7 }
// `[T; n]` (Gate 2): a fixed array, its length the first word and its element the second — not
// an argument: the reference's `type_args` of an array is empty, so nothing that walks a type's
// arguments (nesting, substitution, inference) looks inside one.
fn tag_array() -> Int { 8 }
// `Box[T]` and `Chain[T]` (R1a), immutable indirections, and `Cell[T]` (R1b), a mutable one: each
// its element as its one argument.
fn tag_box() -> Int { 9 }
fn tag_cell() -> Int { 10 }
fn tag_chain() -> Int { 11 }

fn t_int() -> Int { 0 }
fn t_bool() -> Int { 1 }
fn t_str() -> Int { 2 }
fn t_ints() -> Int { 3 }
fn t_strs() -> Int { 4 }

// The owners a type parameter may have.
fn own_record() -> Int { 1 }
fn own_enum() -> Int { 2 }
fn own_fn() -> Int { 3 }
fn own_builtin() -> Int { 4 }
// A trait's `Self` (N78), its parameter 0.
fn own_trait() -> Int { 5 }

fn intern(c: Ck, tag: Int, a: Int, b: Int, x: Int, name: Str, args: Ints) -> Int {
    let parts = strs_new();
    strs_push(parts, int_to_str(tag));
    strs_push(parts, int_to_str(a));
    strs_push(parts, int_to_str(b));
    strs_push(parts, int_to_str(x));
    strs_push(parts, name);
    let mut i = 0;
    while i < ints_len(args) {
        strs_push(parts, int_to_str(ints_get(args, i)));
        i = i + 1;
    }
    let key = str_join(parts, ":");
    let found = strs_find(c.tykey, key);
    if found >= 0 { return found; }
    let made = strs_len(c.tykey);
    strs_push(c.tykey, key);
    ints_push(c.tytag, tag);
    ints_push(c.tya, a);
    ints_push(c.tyb, b);
    ints_push(c.tyc, x);
    strs_push(c.tyname, name);
    ints_push(c.tyargf, ints_len(c.tyargs));
    ints_push(c.tyargc, ints_len(args));
    i = 0;
    while i < ints_len(args) {
        ints_push(c.tyargs, ints_get(args, i));
        i = i + 1;
    }
    // A record's or an enum's application is an instance, completed as the reference completes
    // one (`apply_record`, `apply_enum`): its fields substituted, which may make more.
    if (tag == tag_record() || tag == tag_enum()) && ints_len(args) > 0 {
        if tag == tag_record() { ints_push(c.rlog, made); } else { ints_push(c.elog, made); }
        enqueue_instance(c, made);
    }
    made
}

// --- instances (`nazm_sema::generic`) ---------------------------------------------------------
//
// The reference gives an instance its fields when it is made — its definition's, substituted —
// which interns the types they name, so the type table (Core IR's `types`) lists them in that
// order. This checker reads an instance's fields through its definition instead; it completes
// each one only for what completing interns, in the reference's order: at once, or, while field
// types are being resolved, at `settle`, the last made first.

fn enqueue_instance(c: Ck, t: Int) -> Int {
    ss(c, s_created(), gs(c, s_created()) + 1);
    ints_push(c.ipend, t);
    if gs(c, s_deferred()) == 0 && gs(c, s_settling()) == 0 { settle_instances(c); }
    0
}

fn defer_instances(c: Ck) -> Int {
    ss(c, s_deferred(), 1);
    0
}

fn settle_instances(c: Ck) -> Int {
    ss(c, s_deferred(), 0);
    if gs(c, s_settling()) == 1 { return 0; }
    ss(c, s_settling(), 1);
    while ints_len(c.ipend) > 0 { complete_instance(c, ints_pop(c.ipend)); }
    ss(c, s_settling(), 0);
    0
}

// The definition's fields (or its variants' payload fields), substituted (`complete_instance`).
fn complete_instance(c: Ck, t: Int) -> Int {
    if gs(c, s_created()) > 100000 { return 0; }
    if type_nesting(c, t) > 256 { return 0; }
    let args = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        ints_push(args, targ(c, t, i));
        i = i + 1;
    }
    let d = ta(c, t);
    if tag(c, t) == tag_record() {
        if d < 0 || d >= ints_len(c.rff) { return 0; }
        i = 0;
        while i < ints_get(c.rfc, d) {
            inst_subst(c, ints_get(c.fty, ints_get(c.rff, d) + i), own_record(), d, args);
            i = i + 1;
        }
        return 0;
    }
    if d < 0 || d >= ints_len(c.evf) { return 0; }
    let mut v = 0;
    while v < ints_get(c.evc, d) {
        let vi = ints_get(c.evf, d) + v;
        i = 0;
        while i < ints_get(c.vfc, vi) {
            inst_subst(c, ints_get(c.fty, ints_get(c.vff, vi) + i), own_enum(), d, args);
            i = i + 1;
        }
        v = v + 1;
    }
    0
}

// How deeply a type term nests (`nesting`): `Int` is 1, `Vec[Int]` 2.
fn type_nesting(c: Ck, t: Int) -> Int {
    let work = ints_new();
    let depth = ints_new();
    ints_push(work, t);
    ints_push(depth, 1);
    let mut deepest = 0;
    while ints_len(work) > 0 {
        let u = ints_pop(work);
        let d = ints_pop(depth);
        if d > deepest { deepest = d; }
        if d > 256 { return d; }
        if tag(c, u) != tag_array() {
            let mut i = 0;
            while i < targc(c, u) {
                ints_push(work, targ(c, u, i));
                ints_push(depth, d + 1);
                i = i + 1;
            }
        }
    }
    deepest
}

// Whether `t` mentions a type parameter of `owner` `oid` (`mentions`); an array is not looked into.
fn inst_mentions(c: Ck, t: Int, owner: Int, oid: Int) -> Bool {
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let u = ints_pop(work);
        let g = tag(c, u);
        if g == tag_param() {
            if ta(c, u) == owner && ints_get(c.tyb, u) == oid { return true; }
        } else {
            if g != tag_array() {
                let mut i = 0;
                while i < targc(c, u) {
                    ints_push(work, targ(c, u, i));
                    i = i + 1;
                }
            }
        }
    }
    false
}

// `t` with every parameter of `owner` `oid` replaced by its argument (`substitute`), interning
// what it builds; an array is left as it is.
fn inst_subst(c: Ck, t: Int, owner: Int, oid: Int, args: Ints) -> Int {
    let g = tag(c, t);
    if g == tag_param() {
        if ta(c, t) == owner && ints_get(c.tyb, t) == oid {
            if ints_get(c.tyc, t) < ints_len(args) { return ints_get(args, ints_get(c.tyc, t)); }
            return t_int();
        }
        return t;
    }
    if is_holder_tag(g) || g == tag_chan() {
        if inst_mentions(c, targ(c, t, 0), owner, oid) == false { return t; }
        let elem = inst_subst(c, targ(c, t, 0), owner, oid, args);
        if g == tag_chan() { return chan_of(c, elem); }
        return holder_of(c, g, elem);
    }
    if g == tag_fn() {
        if inst_mentions(c, t, owner, oid) == false { return t; }
        let params = ints_new();
        let mut i = 0;
        while i < fn_arity(c, t) {
            ints_push(params, inst_subst(c, targ(c, t, i), owner, oid, args));
            i = i + 1;
        }
        let ret = inst_subst(c, fn_ret(c, t), owner, oid, args);
        return fn_ty(c, params, ret, ta(c, t), fn_row(c, t));
    }
    if (g == tag_record() || g == tag_enum()) && targc(c, t) > 0 {
        let mut any = false;
        let mut i = 0;
        while i < targc(c, t) {
            if inst_mentions(c, targ(c, t, i), owner, oid) { any = true; }
            i = i + 1;
        }
        if any == false { return t; }
        let out = ints_new();
        i = 0;
        while i < targc(c, t) {
            ints_push(out, inst_subst(c, targ(c, t, i), owner, oid, args));
            i = i + 1;
        }
        if g == tag_record() { return record_ty(c, ta(c, t), out); }
        return enum_ty(c, ta(c, t), out);
    }
    t
}

fn builtin_ty(c: Ck, name: Str) -> Int { intern(c, tag_builtin(), 0, 0, 0, name, ints_new()) }
fn vec_of(c: Ck, elem: Int) -> Int {
    let a = ints_new();
    ints_push(a, elem);
    intern(c, tag_vec(), 0, 0, 0, "", a)
}
fn chan_of(c: Ck, elem: Int) -> Int {
    let a = ints_new();
    ints_push(a, elem);
    intern(c, tag_chan(), 0, 0, 0, "", a)
}
fn record_ty(c: Ck, r: Int, args: Ints) -> Int { intern(c, tag_record(), r, 0, 0, "", args) }
fn holder_of(c: Ck, g: Int, elem: Int) -> Int {
    let a = ints_new();
    ints_push(a, elem);
    intern(c, g, 0, 0, 0, "", a)
}
// Whether a type holds one element behind a handle, as a `Vec` does: `Vec`, `Box`, `Cell`, `Chain`.
fn is_holder_tag(g: Int) -> Bool { g == tag_vec() || g == tag_box() || g == tag_cell() || g == tag_chain() }
fn array_of(c: Ck, elem: Int, n: Int) -> Int { intern(c, tag_array(), n, elem, 0, "", ints_new()) }
fn is_array(c: Ck, t: Int) -> Bool { t >= 0 && tag(c, t) == tag_array() }
fn array_elem(c: Ck, t: Int) -> Int { ints_get(c.tyb, t) }

// `t` with every enclosing array removed (`strip_array`): an array is inline, so for what a type
// contains — equality, crossing into a task, holding a function, containing itself — it answers
// as its element does.
fn strip_array(c: Ck, t: Int) -> Int {
    let mut u = t;
    let mut i = 0;
    while i < 32 && is_array(c, u) {
        u = array_elem(c, u);
        i = i + 1;
    }
    u
}

// `(elems…)` (R1a, L5): a tuple — an application of the generic record of its arity, made the
// first time it is asked for (`tuple_of`): no name a program can write, `(,)`, no module, fields
// `0`, `1`, … and one type parameter per element, so the checker takes a tuple as the record it is.
fn tuple_ty(c: Ck, elems: Ints) -> Int {
    let n = ints_len(elems);
    let mut r = 0 - 1;
    let mut i = 0;
    while i < strs_len(c.rname) && r < 0 {
        if strs_get(c.rname, i) == "(,)" && ints_get(c.rnp, i) == n { r = i; }
        i = i + 1;
    }
    if r < 0 {
        r = strs_len(c.rname);
        ints_push(c.rlog, 0 - 1 - r);
        strs_push(c.rname, "(,)");
        ints_push(c.rmod, 0 - 1);
        ints_push(c.rns, 0);
        ints_push(c.rne, 0);
        ints_push(c.rnp, n);
        ints_push(c.rff, strs_len(c.fname));
        ints_push(c.rfc, n);
        ints_push(c.rpub, 1);
        ints_push(c.rrepr, 0);
        i = 0;
        while i < n {
            strs_push(c.fname, int_to_str(i));
            ints_push(c.fty, param_ty(c, own_record(), r, i, str_concat("T", int_to_str(i))));
            ints_push(c.fns, 0);
            ints_push(c.fne, 0);
            ints_push(c.fts, 0);
            ints_push(c.fte, 0);
            i = i + 1;
        }
    }
    record_ty(c, r, elems)
}

fn is_tuple(c: Ck, t: Int) -> Bool { t >= 0 && is_record(c, t) && strs_get(c.rname, ta(c, t)) == "(,)" }
fn enum_ty(c: Ck, e: Int, args: Ints) -> Int { intern(c, tag_enum(), e, 0, 0, "", args) }
fn param_ty(c: Ck, owner: Int, id: Int, index: Int, name: Str) -> Int { intern(c, tag_param(), owner, id, index, name, ints_new()) }
// A signature whose effects name no effect parameter has no `row`, whatever it was given (N51,
// `fn_of`), so one type is one id.
fn fn_ty(c: Ck, params: Ints, ret: Int, effects: Int, row: Int) -> Int {
    let args = ints_new();
    let mut i = 0;
    while i < ints_len(params) {
        ints_push(args, ints_get(params, i));
        i = i + 1;
    }
    ints_push(args, ret);
    let mut r = 0;
    if has_bit(effects, 3) && row >= 0 { r = row + 1; }
    intern(c, tag_fn(), effects, r, 0, "", args)
}
// Whose effect parameter a function type's effects name, or -1.
fn fn_row(c: Ck, t: Int) -> Int { ints_get(c.tyb, t) - 1 }

// Whether a function type in `t` names `owner`'s effect parameter (`names_effect_param`, N51):
// `t` itself, or one in its parameters and result, function types only.
fn names_effect_param(c: Ck, t: Int, owner: Int) -> Bool {
    if t < 0 || is_fn(c, t) == false { return false; }
    if fn_row(c, t) == owner { return true; }
    let mut i = 0;
    while i < targc(c, t) {
        if names_effect_param(c, targ(c, t, i), owner) { return true; }
        i = i + 1;
    }
    false
}

// `t` with `owner`'s effect parameter, wherever a function type in it names it, bound to
// `binding` (`bind_effects`, N51); a binding that itself names an effect parameter names
// `caller`'s.
fn bind_effects(c: Ck, t: Int, owner: Int, binding: Int, caller: Int) -> Int {
    if t < 0 || is_fn(c, t) == false { return t; }
    let params = ints_new();
    let mut i = 0;
    while i < fn_arity(c, t) {
        ints_push(params, bind_effects(c, targ(c, t, i), owner, binding, caller));
        i = i + 1;
    }
    let ret = bind_effects(c, fn_ret(c, t), owner, binding, caller);
    if fn_row(c, t) == owner {
        let mut row = 0 - 1;
        if has_bit(binding, 3) { row = caller; }
        return fn_ty(c, params, ret, bound_effects(ta(c, t), binding), row);
    }
    fn_ty(c, params, ret, ta(c, t), fn_row(c, t))
}
fn is_fn(c: Ck, t: Int) -> Bool { t >= 0 && tag(c, t) == tag_fn() }
fn fn_arity(c: Ck, t: Int) -> Int { targc(c, t) - 1 }
fn fn_ret(c: Ck, t: Int) -> Int { targ(c, t, targc(c, t) - 1) }
fn fn_params(c: Ck, t: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < fn_arity(c, t) {
        ints_push(out, targ(c, t, i));
        i = i + 1;
    }
    out
}

fn tag(c: Ck, t: Int) -> Int { ints_get(c.tytag, t) }
fn ta(c: Ck, t: Int) -> Int { ints_get(c.tya, t) }
fn targc(c: Ck, t: Int) -> Int { ints_get(c.tyargc, t) }
fn targ(c: Ck, t: Int, i: Int) -> Int { ints_get(c.tyargs, ints_get(c.tyargf, t) + i) }
fn targs(c: Ck, t: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        ints_push(out, targ(c, t, i));
        i = i + 1;
    }
    out
}
fn is_record(c: Ck, t: Int) -> Bool { tag(c, t) == tag_record() }
fn is_enum(c: Ck, t: Int) -> Bool { tag(c, t) == tag_enum() }
fn bname_of(c: Ck, t: Int) -> Str {
    if tag(c, t) == tag_builtin() { return strs_get(c.tyname, t); }
    ""
}

// The built-in types, by name (`Type::from_name`), in `Type::ALL`'s order.
fn builtin_names() -> Strs {
    let s = strs_new();
    strs_push(s, "Int");
    strs_push(s, "Bool");
    strs_push(s, "Str");
    strs_push(s, "Ints");
    strs_push(s, "Strs");
    strs_push(s, "Chan");
    strs_push(s, "IoCap");
    strs_push(s, "SpawnCap");
    strs_push(s, "ForeignCap");
    strs_push(s, "VouchCap");
    strs_push(s, "TimeCap");
    strs_push(s, "MmioCap");
    strs_push(s, "OutCap");
    strs_push(s, "NetCap");
    strs_push(s, "RandomCap");
    strs_push(s, "ProcessCap");
    strs_push(s, "Int8");
    strs_push(s, "Int16");
    strs_push(s, "Int32");
    strs_push(s, "UInt8");
    strs_push(s, "UInt16");
    strs_push(s, "UInt32");
    strs_push(s, "UInt64");
    strs_push(s, "Float32");
    strs_push(s, "Float64");
    strs_push(s, "Bytes");
    strs_push(s, "Text");
    strs_push(s, "OsHandle");
    strs_push(s, "Atomic");
    strs_push(s, "Int128");
    strs_push(s, "UInt128");
    strs_push(s, "Select");
    s
}

fn is_builtin_name(name: Str) -> Bool { strs_find(builtin_names(), name) >= 0 }

fn all_names() -> Str {
    let names = builtin_names();
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(names) {
        strs_push(out, tick(strs_get(names, i)));
        i = i + 1;
    }
    str_join(out, ", ")
}

fn is_cap_name(name: Str) -> Bool {
    let i = strs_find(builtin_names(), name);
    i >= 6 && i <= 15
}

fn is_num_name(name: Str) -> Bool {
    if name == "Int" { return true; }
    let i = strs_find(builtin_names(), name);
    (i >= 16 && i <= 24) || i == 29 || i == 30
}

fn is_float_name(name: Str) -> Bool { name == "Float32" || name == "Float64" }

fn is_cap(c: Ck, t: Int) -> Bool { is_cap_name(bname_of(c, t)) }
fn is_num(c: Ck, t: Int) -> Bool { is_num_name(bname_of(c, t)) }
fn is_integer(c: Ck, t: Int) -> Bool { is_num(c, t) && is_float_name(bname_of(c, t)) == false }

// How a type is written in a message (`UserTypes::show`).
fn show(c: Ck, t: Int) -> Str {
    let g = tag(c, t);
    if g == tag_builtin() { return strs_get(c.tyname, t); }
    if g == tag_fn() {
        let parts = strs_new();
        let mut i = 0;
        while i < fn_arity(c, t) {
            strs_push(parts, show(c, targ(c, t, i)));
            i = i + 1;
        }
        let mut effects = "";
        if ta(c, t) != 0 { effects = cat3(" ! ", set_text_p(ta(c, t), effect_param_name(c, fn_row(c, t))), ""); }
        return cat5("fn(", str_join(parts, ", "), ") -> ", show(c, fn_ret(c, t)), effects);
    }
    if g == tag_param() { return strs_get(c.tyname, t); }
    if g == tag_vec() {
        let e = targ(c, t, 0);
        if e == t_int() { return "Ints"; }
        if e == t_str() { return "Strs"; }
        return cat3("Vec[", show(c, e), "]");
    }
    if g == tag_chan() { return cat3("Chan[", show(c, targ(c, t, 0)), "]"); }
    if g == tag_box() { return cat3("Box[", show(c, targ(c, t, 0)), "]"); }
    if g == tag_cell() { return cat3("Cell[", show(c, targ(c, t, 0)), "]"); }
    if g == tag_chain() { return cat3("Chain[", show(c, targ(c, t, 0)), "]"); }
    if g == tag_array() { return cat5("[", show(c, array_elem(c, t)), "; ", int_to_str(ta(c, t)), "]"); }
    let mut name = "";
    if g == tag_record() { name = strs_get(c.rname, ta(c, t)); }
    // A tuple (L5) spells its elements.
    if g == tag_record() && name == "(,)" {
        let parts = strs_new();
        let mut i = 0;
        while i < targc(c, t) {
            strs_push(parts, show(c, targ(c, t, i)));
            i = i + 1;
        }
        return cat3("(", str_join(parts, ", "), ")");
    }
    if g == tag_enum() { name = strs_get(c.ename, ta(c, t)); }
    if targc(c, t) == 0 { return name; }
    let parts = strs_new();
    let mut i = 0;
    while i < targc(c, t) {
        strs_push(parts, show(c, targ(c, t, i)));
        i = i + 1;
    }
    cat4(name, "[", str_join(parts, ", "), "]")
}

// A definition's parameters replaced by an application's arguments.
fn subst(c: Ck, t: Int, owner: Int, id: Int, args: Ints) -> Int {
    let g = tag(c, t);
    if g == tag_param() {
        if ta(c, t) == owner && ints_get(c.tyb, t) == id {
            let i = ints_get(c.tyc, t);
            if i < ints_len(args) { return ints_get(args, i); }
        }
        return t;
    }
    if g == tag_builtin() { return t; }
    if targc(c, t) == 0 { return t; }
    let out = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        ints_push(out, subst(c, targ(c, t, i), owner, id, args));
        i = i + 1;
    }
    intern(c, g, ta(c, t), ints_get(c.tyb, t), ints_get(c.tyc, t), strs_get(c.tyname, t), out)
}

// `subst`, answered from the types that existed when the table held `wm` of them (`Types::substituted`): -1 where the answer would need a type nobody had made.
fn subst_found(c: Ck, t: Int, owner: Int, id: Int, args: Ints, wm: Int) -> Int {
    let g = tag(c, t);
    if g == tag_param() {
        if ta(c, t) == owner && ints_get(c.tyb, t) == id {
            let i = ints_get(c.tyc, t);
            if i < ints_len(args) { return ints_get(args, i); }
            return 0 - 1;
        }
        return t;
    }
    if g == tag_builtin() { return t; }
    if targc(c, t) == 0 { return t; }
    if mentions(c, t, owner, id) == false { return t; }
    let out = ints_new();
    let mut i = 0;
    while i < targc(c, t) {
        let r = subst_found(c, targ(c, t, i), owner, id, args, wm);
        if r < 0 { return 0 - 1; }
        ints_push(out, r);
        i = i + 1;
    }
    // A box, cell, chain or vector is found by its element's vector (`find_vec`): that is what the reference interns, the holder being the vector's.
    if g == tag_box() || g == tag_cell() || g == tag_chain() || g == tag_vec() {
        let va = ints_new();
        ints_push(va, ints_get(out, 0));
        let vk = strs_new();
        strs_push(vk, int_to_str(tag_vec()));
        strs_push(vk, "0");
        strs_push(vk, "0");
        strs_push(vk, "0");
        strs_push(vk, "");
        strs_push(vk, int_to_str(ints_get(out, 0)));
        let mut vf = strs_find(c.tykey, str_join(vk, ":"));
        // The reference makes a holder's vector with it: a box, cell or chain of the element that existed counts the vector as existing.
        if vf < 0 || vf >= wm {
            vf = 0 - 1;
            let gs3 = ints_new();
            ints_push(gs3, tag_box());
            ints_push(gs3, tag_cell());
            ints_push(gs3, tag_chain());
            let mut h = 0;
            while h < 3 {
                let hk = strs_new();
                strs_push(hk, int_to_str(ints_get(gs3, h)));
                strs_push(hk, "0");
                strs_push(hk, "0");
                strs_push(hk, "0");
                strs_push(hk, "");
                strs_push(hk, int_to_str(ints_get(out, 0)));
                let hf = strs_find(c.tykey, str_join(hk, ":"));
                if hf >= 0 && hf < wm { vf = hf; }
                h = h + 1;
            }
            if vf < 0 { return 0 - 1; }
        }
        if g == tag_vec() { return vec_of(c, ints_get(out, 0)); }
        return holder_of(c, g, ints_get(out, 0));
    }
    let parts = strs_new();
    strs_push(parts, int_to_str(g));
    strs_push(parts, int_to_str(ta(c, t)));
    strs_push(parts, int_to_str(ints_get(c.tyb, t)));
    strs_push(parts, int_to_str(ints_get(c.tyc, t)));
    strs_push(parts, strs_get(c.tyname, t));
    i = 0;
    while i < ints_len(out) {
        strs_push(parts, int_to_str(ints_get(out, i)));
        i = i + 1;
    }
    let found = strs_find(c.tykey, str_join(parts, ":"));
    if found < 0 || found >= wm { return 0 - 1; }
    found
}

// A record type's fields: their names and types, the application's arguments substituted.
fn record_field(c: Ck, t: Int, name: Str) -> Int {
    let r = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.rfc, r) {
        if strs_get(c.fname, ints_get(c.rff, r) + i) == name { return ints_get(c.rff, r) + i; }
        i = i + 1;
    }
    0 - 1
}
fn field_ty_in(c: Ck, t: Int, f: Int) -> Int {
    if targc(c, t) == 0 { return ints_get(c.fty, f); }
    let mut owner = own_record();
    if is_enum(c, t) { owner = own_enum(); }
    subst(c, ints_get(c.fty, f), owner, ta(c, t), targs(c, t))
}

// An enum's variant by name, as an index into the pool; -1 when it has none of it.
fn variant_of(c: Ck, t: Int, name: Str) -> Int {
    let e = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.evc, e) {
        if strs_get(c.vname, ints_get(c.evf, e) + i) == name { return ints_get(c.evf, e) + i; }
        i = i + 1;
    }
    0 - 1
}
fn variant_field(c: Ck, v: Int, name: Str) -> Int {
    let mut i = 0;
    while i < ints_get(c.vfc, v) {
        if strs_get(c.fname, ints_get(c.vff, v) + i) == name { return ints_get(c.vff, v) + i; }
        i = i + 1;
    }
    0 - 1
}

// Whether `==` (`equality`) or `<` (`ordering`) applies to a type, by the walk every derived
// property shares (`UserTypes::derived`): "" when it does, otherwise the field path to the first
// component that has none, then `|`, then that component's type.
fn derived(c: Ck, t: Int, equality: Bool) -> Str { derived_by(c, t, equality, 0 - 1, false) }

// The same walk, refusing at a record or enum inside `t` with an impl of `stop_trait` (-1 for
// none): exactly for that type with `exact`, else by `applying` (`UserTypes::hashing`).
fn derived_by(c: Ck, t: Int, equality: Bool, stop_trait: Int, exact: Bool) -> Str {
    let mut mode = 0;
    if equality { mode = 1; }
    derived_walk(c, t, mode, stop_trait, exact)
}

// Whether a value of `t` may be passed to a task (`UserTypes::task_safety`, N53): "" or the path
// to the first component that may not cross, as `derived` writes it.
fn task_safety(c: Ck, t: Int) -> Str { derived_walk(c, t, 2, 0 - 1, false) }

// The walk, for ordering (`mode` 0), equality (1) or crossing into a task (2).
fn derived_walk(c: Ck, top: Int, mode: Int, stop_trait: Int, exact: Bool) -> Str {
    // A `Box` or `Chain` compares by what it holds (L6): equality looks through them.
    let t = open_derived(c, top, mode == 1);
    if is_record(c, t) == false && is_enum(c, t) == false {
        if leaf_mode(c, t, mode) { return ""; }
        return str_concat("|", int_to_str(t));
    }
    // A C handle has no equality, no order and never crosses into a task (N85).
    if is_opaque(c, t) { return str_concat("|", int_to_str(t)); }
    let seen = ints_new();
    ints_push(seen, t);
    // The stack: each frame a node, the next edge to look at, and how many names it pushed.
    let snode = ints_new();
    let sat = ints_new();
    let spushed = ints_new();
    ints_push(snode, t);
    ints_push(sat, 0);
    ints_push(spushed, 0);
    let path = strs_new();
    while ints_len(snode) > 0 {
        let node = ints_pop(snode);
        let at = ints_pop(sat);
        let pushed = ints_pop(spushed);
        let edges = contained(c, node);
        if at >= ints_len(edges) {
            let mut k = 0;
            while k < pushed {
                strs_pop(path);
                k = k + 1;
            }
        } else {
            ints_push(snode, node);
            ints_push(sat, at + 1);
            ints_push(spushed, pushed);
            let f = ints_get(edges, at);
            // An array field contains its elements inline (`contained`).
            let ty = open_derived(c, field_ty_in(c, node, f), mode == 1);
            let names = edge_names(c, node, f);
            let mut refused = false;
            if stop_trait >= 0 && (is_record(c, ty) || is_enum(c, ty)) {
                if exact { refused = impl_of(c, stop_trait, ty) >= 0; } else { refused = applying(c, stop_trait, ty) >= 0; }
            }
            if is_opaque(c, ty) { refused = true; }
            if refused {
                let mut k = 0;
                while k < strs_len(names) {
                    strs_push(path, strs_get(names, k));
                    k = k + 1;
                }
                return cat3(str_join(path, "."), "|", int_to_str(ty));
            }
            if is_record(c, ty) || is_enum(c, ty) {
                let mut found = false;
                let mut k = 0;
                while k < ints_len(seen) {
                    if ints_get(seen, k) == ty { found = true; }
                    k = k + 1;
                }
                if found == false {
                    ints_push(seen, ty);
                    let mut k = 0;
                    while k < strs_len(names) {
                        strs_push(path, strs_get(names, k));
                        k = k + 1;
                    }
                    ints_push(snode, ty);
                    ints_push(sat, 0);
                    ints_push(spushed, strs_len(names));
                }
            } else {
                if leaf_mode(c, ty, mode) == false {
                    let mut k = 0;
                    while k < strs_len(names) {
                        strs_push(path, strs_get(names, k));
                        k = k + 1;
                    }
                    return cat3(str_join(path, "."), "|", int_to_str(ty));
                }
            }
        }
    }
    ""
}

// A component as the derived walk sees it (`derived`'s `open`): its arrays removed, and, `through`,
// the `Box`es and `Chain`s around it too.
fn open_derived(c: Ck, t: Int, through: Bool) -> Int {
    let mut u = strip_array(c, t);
    if through {
        let mut i = 0;
        while i < 64 && (tag(c, u) == tag_box() || tag(c, u) == tag_chain()) {
            u = strip_array(c, targ(c, u, 0));
            i = i + 1;
        }
    }
    u
}

fn leaf_mode(c: Ck, t: Int, mode: Int) -> Bool {
    if mode == 2 { return crosses(c, t); }
    leaf(c, t, mode == 1)
}

// Whether a type that is not a record or an enum may cross into a task (`may_cross_into_a_task`):
// not a sequence, a type parameter or a function value, nor a `Select`, which holds sequences.
fn crosses(c: Ck, t: Int) -> Bool {
    let g = tag(c, t);
    if is_holder_tag(g) || g == tag_param() || g == tag_fn() { return false; }
    let n = bname_of(c, t);
    n != "Ints" && n != "Strs" && n != "Bytes" && n != "Select"
}

fn leaf(c: Ck, t: Int, equality: Bool) -> Bool {
    // A type parameter has equality exactly when its declaration requires it (N14).
    if tag(c, t) == tag_param() { return equality && requires_equality(c, t); }
    let n = bname_of(c, t);
    if n == "Int" || n == "Bool" || n == "Str" { return true; }
    if equality { return n == "Text" || is_num_name(n); }
    is_num_name(n) && is_float_name(n) == false
}

// A node's containment edges, as field indices of the pool, in declaration order.
fn contained(c: Ck, node: Int) -> Ints {
    let out = ints_new();
    if is_record(c, node) {
        let r = ta(c, node);
        let mut i = 0;
        while i < ints_get(c.rfc, r) {
            ints_push(out, ints_get(c.rff, r) + i);
            i = i + 1;
        }
        return out;
    }
    let e = ta(c, node);
    let mut v = 0;
    while v < ints_get(c.evc, e) {
        let vi = ints_get(c.evf, e) + v;
        let mut i = 0;
        while i < ints_get(c.vfc, vi) {
            ints_push(out, ints_get(c.vff, vi) + i);
            i = i + 1;
        }
        v = v + 1;
    }
    out
}

// The path components one edge contributes: the field, after its variant for an enum's payload.
fn edge_names(c: Ck, node: Int, f: Int) -> Strs {
    let out = strs_new();
    if is_enum(c, node) {
        let e = ta(c, node);
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let vi = ints_get(c.evf, e) + v;
            if f >= ints_get(c.vff, vi) && f < ints_get(c.vff, vi) + ints_get(c.vfc, vi) {
                strs_push(out, strs_get(c.vname, vi));
            }
            v = v + 1;
        }
    }
    strs_push(out, strs_get(c.fname, f));
    out
}

fn derived_type(c: Ck, why: Str) -> Int {
    let mut i = 0;
    while i < str_len(why) {
        if str_byte(why, i) == 124 { return parse_int(str_slice(why, i + 1, str_len(why))); }
        i = i + 1;
    }
    0
}
fn derived_path(c: Ck, why: Str) -> Str {
    let mut i = 0;
    while i < str_len(why) {
        if str_byte(why, i) == 124 { return str_slice(why, 0, i); }
        i = i + 1;
    }
    ""
}

fn parse_int(s: Str) -> Int {
    let mut v = 0;
    let mut i = 0;
    while i < str_len(s) {
        // The digit first, so `Int`'s largest value is read without passing it.
        v = v * 10 + (str_byte(s, i) - 48);
        i = i + 1;
    }
    v
}

// --- the checker ------------------------------------------------------------------------------

fn new_ck(t: Tree) -> Ck {
    let c = Ck(t: t, d: dg_new(), stop: strs_new(), fndups: ints_new(), st: ints_new(), mprog: ints_new(), mbase: ints_new(), tytag: ints_new(),
            tya: ints_new(), tyb: ints_new(), tyc: ints_new(), tyname: strs_new(), tyargf: ints_new(), tyargc: ints_new(),
            tyargs: ints_new(), tykey: strs_new(), rname: strs_new(), rmod: ints_new(), rns: ints_new(), rne: ints_new(),
            rnp: ints_new(), rff: ints_new(), rfc: ints_new(), ename: strs_new(), emod: ints_new(), ens: ints_new(),
            ene: ints_new(), enp: ints_new(), evf: ints_new(), evc: ints_new(), vname: strs_new(), vns: ints_new(),
            vne: ints_new(), vff: ints_new(), vfc: ints_new(), fname: strs_new(), fty: ints_new(), fns: ints_new(),
            fne: ints_new(), fts: ints_new(), fte: ints_new(), rpub: ints_new(), epub: ints_new(), fnname: strs_new(), fnmod: ints_new(), fnns: ints_new(), fnne: ints_new(), fnnode: ints_new(),
            fnpf: ints_new(), fnpc: ints_new(), fnret: ints_new(), fnnores: ints_new(), fneff: ints_new(), fnws: ints_new(), fnwe: ints_new(), sfn: ints_new(), sstart: ints_new(),
            send: ints_new(), sbuiltin: ints_new(), suser: ints_new(), sheld: ints_new(), ptys: ints_new(), bname: strs_new(),
            bpf: ints_new(), bpc: ints_new(), bret: ints_new(), bok: ints_new(), bprelude: ints_new(), beff: strs_new(),
            bcaps: strs_new(), bpath: ints_new(), bflow: strs_new(), bcont: strs_new(), bsk: strs_new(), tnames: strs_new(), ttys: ints_new(), sname: strs_new(), sty: ints_new(), smut: ints_new(),
            sds: ints_new(), sde: ints_new(), frames: ints_new(), fjoin: ints_new(), cks: ints_new(), cke: ints_new(), ckt: ints_new(), fntpf: ints_new(), fntpc: ints_new(), tpname: strs_new(),
            tpeq: ints_new(), bgen: ints_new(), bclass: strs_new(), bshapes: strs_new(), bretshape: strs_new(), tsn: strs_new(),
            tst: ints_new(), pkind: ints_new(), pval: ints_new(), pkey: strs_new(), pty: ints_new(), paf: ints_new(), pac: ints_new(),
            pargs: ints_new(), cells: ints_new(), w: dg_new(), mstd: ints_new(), dfirst: ints_new(), dcount: ints_new(), don: ints_new(),
            dats: ints_new(), date: ints_new(), dplain: ints_new(), dimplicit: ints_new(), daf: ints_new(), dac: ints_new(), aname: strs_new(), aats: ints_new(),
            aate: ints_new(), fnpub: ints_new(), envname: strs_new(), envfn: ints_new(), alname: strs_new(), almod: ints_new(),
            taliases: strs_new(), kname: strs_new(), kkind: ints_new(), kint: ints_new(), kstr: strs_new(), mexp: ints_new(), xmod: ints_new(), xname: strs_new(),
            xkind: ints_new(), xint: ints_new(), xstr: strs_new(), fnclos: ints_new(), cfid: ints_new(), cfbound: ints_new(),
            capf: ints_new(), capb: ints_new(), sind: ints_new(), sspawn: ints_new(), vfn: ints_new(), vstart: ints_new(), vend: ints_new(), vassumed: ints_new(), vty: ints_new(),
            trname: strs_new(), trmod: ints_new(), trns: ints_new(), trne: ints_new(), trpub: ints_new(), trmf: ints_new(), trmc: ints_new(),
            tmname: strs_new(), tmns: ints_new(), tmne: ints_new(), tmpf: ints_new(), tmpc: ints_new(), tmret: ints_new(), tmeff: ints_new(), tmdef: ints_new(),
            imtrait: ints_new(), imty: ints_new(), immod: ints_new(), imis: ints_new(), imie: ints_new(), imff: ints_new(), imfn: ints_new(), imrf: ints_new(), imrc: ints_new(), imreq: ints_new(),
            hds: ints_new(), hde: ints_new(), htr: ints_new(), hty: ints_new(), fnmeth: ints_new(), tpbound: ints_new(),
            tsname: strs_new(), tsid: ints_new(), bfn: ints_new(), bty: ints_new(), bnm: strs_new(), bshr: ints_new(), sbid: ints_new(),
            fnpb: ints_new(), capcl: ints_new(), capbd: ints_new(), capat: ints_new(), fbf: ints_new(), fbc: ints_new(), fbl: ints_new(), fcf: ints_new(), fcc: ints_new(), fcl: ints_new(), clid: ints_new(), clty: ints_new(), mvar: sm_new(), mclo: sm_new(), crfn: ints_new(), crb: ints_new(), mzero: sm_new(), mtyn: sm_new(), mwty: sm_new(), marr: sm_new(), mfor: sm_new(), mcons: sm_new(), msite: sm_new(),
            stm: ints_new(), starg: ints_new(), pan: strs_new(), pas: ints_new(), pae: ints_new(), epown: ints_new(), epnm: strs_new(),
            sbind: ints_new(), awty: ints_new(), aws: ints_new(), awe: ints_new(), rrepr: ints_new(), fnfor: ints_new(), fnexp: ints_new(), rx: rx_new(), fnreq: ints_new(), fnrs: Reasons(fnid: ints_new(), effect: ints_new(), start: ints_new(), end: ints_new(), source: ints_new(), which: ints_new()), bds: ints_new(), bde: ints_new(),
            bmut: ints_new(), mlit: sm_new(), mfld: sm_new(), mfldty: sm_new(), ipend: ints_new(), rlog: ints_new(), elog: ints_new(), mvty: sm_new(), mvix: sm_new(),
            minit: sm_new(), mfini: sm_new(), mcref: sm_new(), mtrm: sm_new(), rix: rix_new(), mconst: sm_new(), mrefu: sm_new(), rzb: ints_new(), rzf: ints_new(), uk: ints_new(), ui: ints_new(), us: strs_new(), mconv: sm_new(), cvto: ints_new(),
            cvmode: strs_new(), cvres: ints_new(), sargf: ints_new(), sipf: ints_new(), sip: ints_new(), sargc: ints_new(), sargs: ints_new(), sret: ints_new());
    let mut i = 0;
    while i < s_slots() {
        ints_push(c.st, 0);
        i = i + 1;
    }
    // `Int`, `Bool`, `Str`, then `Ints` and `Strs` — `Vec[Int]` and `Vec[Str]` — at fixed ids.
    builtin_ty(c, "Int");
    builtin_ty(c, "Bool");
    builtin_ty(c, "Str");
    vec_of(c, t_int());
    vec_of(c, t_str());
    load_builtins(c);
    c
}

// The built-in table, its shapes as types; a built-in whose signature names its own parameter or a
// type this checker does not carry is marked so, and a call of it stops the checker.
fn load_builtins(c: Ck) -> Int {
    let rows = bi_rows();
    let mut i = 0;
    while i < strs_len(rows) {
        let cols = split(strs_get(rows, i), 124);
        strs_push(c.bname, strs_get(cols, 0));
        let generic = strs_get(cols, 3) != "0";
        let mut ok = true;
        ints_push(c.bgen, parse_int(strs_get(cols, 3)));
        strs_push(c.bclass, strs_get(cols, 4));
        strs_push(c.bshapes, strs_get(cols, 1));
        strs_push(c.bretshape, strs_get(cols, 2));
        ints_push(c.bpf, ints_len(c.ptys));
        let params = split(strs_get(cols, 1), 44);
        let mut n = 0;
        let mut k = 0;
        while k < strs_len(params) {
            if strs_get(params, k) != "" {
                let mut t = 0;
                if generic {
                    if generic_shape(strs_get(params, k)) == false { ok = false; }
                } else {
                    t = shape_ty(c, strs_get(params, k));
                    if t < 0 { ok = false; }
                }
                ints_push(c.ptys, t);
                n = n + 1;
            }
            k = k + 1;
        }
        ints_push(c.bpc, n);
        let mut r = 0;
        if generic {
            if generic_shape(strs_get(cols, 2)) == false { ok = false; }
        } else {
            r = shape_ty(c, strs_get(cols, 2));
            if r < 0 { ok = false; }
        }
        ints_push(c.bret, r);
        if ok { ints_push(c.bok, 1); } else { ints_push(c.bok, 0); }
        ints_push(c.bprelude, parse_int(strs_get(cols, 5)));
        strs_push(c.beff, strs_get(cols, 6));
        strs_push(c.bcaps, strs_get(cols, 7));
        if str_has(strs_get(cols, 8), ":path") { ints_push(c.bpath, 1); } else { ints_push(c.bpath, 0); }
        strs_push(c.bflow, strs_get(cols, 9));
        strs_push(c.bcont, strs_get(cols, 10));
        strs_push(c.bsk, strs_get(cols, 8));
        i = i + 1;
    }
    0
}

// Whether a generic built-in's shape is one this checker makes: its parameter, a `Vec` or an
// `Option` of it, a `Chan` of it or a `Vec` of those (N53), or a monomorphic type.
fn generic_shape(s: Str) -> Bool {
    if s == "T" || s == "Vec[T]" || s == "Option[T]" || s == "Chan[T]" || s == "Vec[Chan[T]]" { return true; }
    if s == "Box[T]" || s == "Cell[T]" || s == "Chain[T]" { return true; }
    is_builtin_name(s) && s != "Chan"
}

// A generic built-in's shape for the built-in `b`, its `T` being `t`.
fn shape_of(c: Ck, s: Str, t: Int) -> Int {
    if s == "T" { return t; }
    if s == "Vec[T]" { return vec_of(c, t); }
    if s == "Chan[T]" { return chan_of(c, t); }
    if s == "Vec[Chan[T]]" { return vec_of(c, chan_of(c, t)); }
    if s == "Box[T]" { return holder_of(c, tag_box(), t); }
    if s == "Cell[T]" { return holder_of(c, tag_cell(), t); }
    if s == "Chain[T]" { return holder_of(c, tag_chain(), t); }
    if s == "Option[T]" {
        let a = ints_new();
        ints_push(a, t);
        return enum_ty(c, declared_enum(c, prelude(c), "Option"), a);
    }
    shape_ty(c, s)
}

fn shape_ty(c: Ck, s: Str) -> Int {
    if s == "Ints" { return t_ints(); }
    if s == "Strs" { return t_strs(); }
    if is_builtin_name(s) { return builtin_ty(c, s); }
    0 - 1
}

fn split(s: Str, sep: Int) -> Strs {
    let out = strs_new();
    let mut from = 0;
    let mut i = 0;
    while i < str_len(s) {
        if str_byte(s, i) == sep {
            strs_push(out, str_slice(s, from, i));
            from = i + 1;
        }
        i = i + 1;
    }
    strs_push(out, str_slice(s, from, str_len(s)));
    out
}

fn builtin_index(c: Ck, name: Str) -> Int { strs_find(c.bname, name) }

// --- the compilation ------------------------------------------------------------------------

// Check the compilation whose modules' programs are `programs`, at text offsets `bases`, named
// `names`, its import edges `graph` (`load.nz`'s order: the root first, the core prelude last).
// The diagnostics are `ck_diags`, to be published only when `ck_stopped` is "".
//
// Every stage runs over every module in load order, as `check_reusing` runs them: each type's
// name, each module's field types against its imports' interfaces, the layouts, each module's
// declarations, then each module's bodies against its direct imports' interfaces.
pub fn ck_check(t: Tree, programs: Ints, bases: Ints, names: Strs, graph: Graph) -> Ck {
    let c = new_ck(t);
    let count = ints_len(programs);
    let mut i = 0;
    while i < count {
        ints_push(c.mprog, ints_get(programs, i));
        ints_push(c.mbase, ints_get(bases, i));
        ints_push(c.mstd, ints_get(graph.standard, i));
        ints_push(c.mexp, 0);
        i = i + 1;
    }
    if strs_get(names, count - 1) != "@core/prelude.nz" {
        stop(c, "a compilation without the core prelude");
        return c;
    }
    ss(c, s_prelude(), count - 1);
    ss(c, s_syntax(), ints_get(graph.syntax, 0));
    i = 0;
    while i < count {
        refuse_unsupported_items(c, i);
        i = i + 1;
    }
    if strs_len(c.stop) > 0 { return c; }
    build_dependencies(c, graph);
    if strs_len(c.stop) > 0 { return c; }
    // Stage 0a: every user-defined type's name. Instances met while field types are still being
    // resolved are completed once every definition has its fields.
    defer_instances(c);
    i = 0;
    while i < count {
        declare_types(c, i);
        i = i + 1;
    }
    // What `pub use` re-exports of types and traits (N103), before anything resolves a type name
    // an importer writes; its refusals wait for the functions.
    apply_reexports(c, false);
    if strs_len(c.stop) > 0 { return c; }
    // Stage 0b: each module's field types; stage 0c, the layouts they describe.
    i = 0;
    while i < count {
        resolve_type_fields(c, i);
        i = i + 1;
    }
    settle_instances(c);
    validate_layouts(c);
    // Every trait's method signatures, before any module declares an impl of one.
    i = 0;
    while i < count {
        declare_trait_methods(c, i);
        i = i + 1;
    }
    // The trait a record, enum or tuple derives (L6): `@std/hash`'s `Hash`, if it is here.
    ss(c, s_hash(), 0 - 1);
    i = 0;
    while i < strs_len(c.trname) {
        if strs_get(c.trname, i) == "Hash" && strs_get(names, ints_get(c.trmod, i)) == "@std/hash.nz" && gs(c, s_hash()) < 0 { ss(c, s_hash(), i); }
        i = i + 1;
    }
    // Stage 1: each module's definitions; stage 1b, each module's constants in dependency order.
    i = 0;
    while i < count {
        declare_functions(c, i);
        i = i + 1;
    }
    // And everything `pub use` re-exports, now that every module offers its own (N103).
    apply_reexports(c, true);
    declare_all_consts(c);
    // The arrays the signatures wrote (Gate 2).
    validate_new_arrays(c);
    // Stage 2: the bodies, module by module, each module's effects once its bodies are.
    i = 0;
    while i < count {
        check_unit(c, i);
        analyse_effects(c, i);
        i = i + 1;
    }
    // Provenance (N38), solved over every module's bodies; then the rules about `main`.
    restricted_flow(c);
    main_rules(c);
    c
}

// What a call of the built-in `bi` means for provenance (N38): whether it brings in a restricted
// origin — a file's contents, or what the checker does not follow — and whether it is a
// restricted sink.
fn note_flow(c: Ck, bi: Int) -> Int {
    let flow = strs_get(c.bflow, bi);
    if flow == "source:file" || flow == "source:unknown" { ss(c, s_source(), 1); }
    if ints_get(c.bpath, bi) == 1 { ss(c, s_sink(), 1); }
    0
}

// Each module's imports as the graph holds them (`ModuleGraph::import_as`): one edge per module
// named, in the order of the first `use` naming it, plain when any `use` of it is, with every
// name it is imported under; a module naming itself adds none. The core prelude is imported by
// every other module, last, at no place.
fn build_dependencies(c: Ck, graph: Graph) -> Int {
    let count = ints_len(c.mprog);
    let mut m = 0;
    while m < count {
        ss(c, s_module(), m);
        let imports = kids(c, ints_get(c.mprog, m), "imports");
        let gf = ints_get(graph.first, m);
        let targets = ints_new();
        if m != prelude(c) {
            if ints_get(graph.count, m) != ints_len(imports) {
                stop(c, "an import the loader did not resolve");
                return 0;
            }
        }
        let mut k = 0;
        while k < ints_len(imports) {
            let imp = ints_get(imports, k);
            let to = ints_get(graph.target, gf + k);
            // An import the loader did not resolve is no edge (`load_packaged` drops it, its diagnostic already made).
            if to == m && some(c, imp, "alias") { stop(c, "a module imported under a name by itself"); }
            if to >= 0 && to != m && index_of(targets, to) < 0 { ints_push(targets, to); }
            k = k + 1;
        }
        ints_push(c.dfirst, ints_len(c.don));
        let mut n = 0;
        while n < ints_len(targets) {
            let to = ints_get(targets, n);
            let mut plain = false;
            let mut first = 0 - 1;
            ints_push(c.daf, strs_len(c.aname));
            k = 0;
            while k < ints_len(imports) {
                let imp = ints_get(imports, k);
                if ints_get(graph.target, gf + k) == to {
                    if first < 0 { first = imp; }
                    if some(c, imp, "alias") {
                        let q = unwrap(c, imp, "alias");
                        strs_push(c.aname, fname_of(c, q, "name"));
                        ints_push(c.aats, sps(c, fld(c, q, "span")));
                        ints_push(c.aate, spe(c, fld(c, q, "span")));
                    } else {
                        plain = true;
                    }
                }
                k = k + 1;
            }
            ints_push(c.dac, strs_len(c.aname) - ints_get(c.daf, ints_len(c.daf) - 1));
            ints_push(c.don, to);
            ints_push(c.dats, sps(c, fld(c, first, "path_span")));
            ints_push(c.date, spe(c, fld(c, first, "path_span")));
            if plain { ints_push(c.dplain, 1); } else { ints_push(c.dplain, 0); }
            ints_push(c.dimplicit, 0);
            rx_spec(c, imports, gf, graph, to);
            n = n + 1;
        }
        // The prelude's standard modules (R1.5, D9): plain, after the written ones, and only
        // where no `use` names the module.
        k = 0;
        while k < ints_get(graph.icount, m) {
            let to = ints_get(graph.itarget, ints_get(graph.ifirst, m) + k);
            if to < 0 { stop(c, "an import the loader did not resolve"); }
            if to >= 0 && to != m && index_of(targets, to) < 0 {
                ints_push(targets, to);
                ints_push(c.don, to);
                ints_push(c.dats, 0);
                ints_push(c.date, 0);
                ints_push(c.dplain, 1);
                ints_push(c.dimplicit, 1);
                ints_push(c.daf, strs_len(c.aname));
                ints_push(c.dac, 0);
                rx_none(c);
            }
            k = k + 1;
        }
        if m != prelude(c) {
            ints_push(c.don, prelude(c));
            ints_push(c.dats, 0);
            ints_push(c.date, 0);
            ints_push(c.dplain, 1);
            ints_push(c.dimplicit, 0);
            ints_push(c.daf, strs_len(c.aname));
            ints_push(c.dac, 0);
            rx_none(c);
        }
        ints_push(c.dcount, ints_len(c.don) - ints_get(c.dfirst, m));
        m = m + 1;
    }
    0
}

// Module `m`'s `k`th dependency, as an index into the pool.
fn dep(c: Ck, m: Int, k: Int) -> Int { ints_get(c.dfirst, m) + k }
fn deps(c: Ck, m: Int) -> Int { ints_get(c.dcount, m) }

// Whether module `m` imports module `x` directly (the prelude included).
fn imports_module(c: Ck, m: Int, x: Int) -> Bool {
    let mut k = 0;
    while k < deps(c, m) {
        if ints_get(c.don, dep(c, m, k)) == x { return true; }
        k = k + 1;
    }
    false
}

// --- re-exports (N103; `check/reexport.rs`) ------------------------------------------------------
//
// A module offers its own `pub` definitions and what it re-exports: `pub use "m.nz";` every name
// `m` offers, `pub use "m.nz" { a, b as c };` the names chosen, `c` the name `b` is offered under.
// A re-export is the same definition — its id is the defining module's — so nothing downstream
// learns that re-exports exist: an import reads what a module offers (`offered_fns`,
// `offered_types`, `offers_trait`), and an impl is usable where a module this one imports
// re-exports from its module (`impl_usable`).

pub struct Rx {
    // Per dependency, beside `don`: 0 no re-export, 1 the names chosen, 2 every name; the `pub`'s
    // span (absolute); the names chosen, a run of the pool below.
    dk: Ints,
    das: Ints,
    dae: Ints,
    dif: Ints,
    dic: Ints,
    // The names chosen: the name, its span, and the name it is offered under ("" for its own).
    iname: Strs,
    is: Ints,
    ie: Ints,
    ialias: Strs,
    // Functions re-exported: the module offering it, the name it is offered under, the function.
    fm: Ints,
    fname: Strs,
    ff: Ints,
    // Types re-exported, in the order each was first offered: the module, the type, and whether
    // it is offered under its own name (`nameable`).
    tm: Ints,
    tt: Ints,
    tn: Ints,
    // Types re-exported under another name: the module, the name, the type.
    nm: Ints,
    nname: Strs,
    nt: Ints,
    // Traits re-exported (`reexported_by`), and the modules each module re-exports from
    // (`reexport_sources`), each pair once.
    rm: Ints,
    rt: Ints,
    sm: Ints,
    sf: Ints,
    // What each chosen name resolves to, for tools (`nazm doc`): the module re-exporting, the
    // name's span (absolute), the kind (1 a function, 2 a record or an enum, 3 a trait), and the
    // function, the type or the trait.
    xm: Ints,
    xs: Ints,
    xe: Ints,
    xk: Ints,
    xid: Ints,
}

fn rx_new() -> Rx {
    Rx(dk: ints_new(), das: ints_new(), dae: ints_new(), dif: ints_new(), dic: ints_new(), iname: strs_new(), is: ints_new(), ie: ints_new(),
            ialias: strs_new(), fm: ints_new(), fname: strs_new(), ff: ints_new(), tm: ints_new(), tt: ints_new(), tn: ints_new(), nm: ints_new(),
            nname: strs_new(), nt: ints_new(), rm: ints_new(), rt: ints_new(), sm: ints_new(), sf: ints_new(), xm: ints_new(), xs: ints_new(),
            xe: ints_new(), xk: ints_new(), xid: ints_new())
}

// A dependency with no re-export.
fn rx_none(c: Ck) -> Int {
    ints_push(c.rx.dk, 0);
    ints_push(c.rx.das, 0);
    ints_push(c.rx.dae, 0);
    ints_push(c.rx.dif, strs_len(c.rx.iname));
    ints_push(c.rx.dic, 0);
    0
}

// The re-export of the dependency on `to` just added, as `ModuleGraph::reexport` merges every
// `pub use` of it in source order: the first `pub` is where it is; every name once any of them
// chooses none, else the names of each, in order.
fn rx_spec(c: Ck, imports: Ints, gf: Int, graph: Graph, to: Int) -> Int {
    let mut kind = 0;
    let mut s = 0;
    let mut e = 0;
    let first = strs_len(c.rx.iname);
    let mut k = 0;
    while k < ints_len(imports) {
        let imp = ints_get(imports, k);
        if ints_get(graph.target, gf + k) == to && some(c, imp, "reexport") {
            let r = unwrap(c, imp, "reexport");
            if kind == 0 {
                s = sps(c, fld(c, r, "pub_span"));
                e = spe(c, fld(c, r, "pub_span"));
                kind = 1;
            }
            if some(c, r, "names") == false {
                kind = 2;
            } else {
                if kind == 1 {
                    let items = sx_items(c.t, unwrap(c, r, "names"));
                    let mut i = 0;
                    while i < ints_len(items) {
                        let it = ints_get(items, i);
                        strs_push(c.rx.iname, fname_of(c, it, "name"));
                        ints_push(c.rx.is, sps(c, fld(c, it, "span")));
                        ints_push(c.rx.ie, spe(c, fld(c, it, "span")));
                        if some(c, it, "alias") {
                            strs_push(c.rx.ialias, sx_text(c.t, sx_kid(c.t, unwrap(c, it, "alias"), 0)));
                        } else {
                            strs_push(c.rx.ialias, "");
                        }
                        i = i + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    ints_push(c.rx.dk, kind);
    ints_push(c.rx.das, s);
    ints_push(c.rx.dae, e);
    ints_push(c.rx.dif, first);
    ints_push(c.rx.dic, strs_len(c.rx.iname) - first);
    0
}

// The functions a module offers (`UnitInterface::exports`), into `fns` and `names`: its own `pub`
// ones, then those it re-exports, each under the name it is offered by.
fn offered_fns(c: Ck, m: Int, fns: Ints, names: Strs) -> Int {
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if ints_get(c.fnmod, f) == m && ints_get(c.fnpub, f) == 1 {
            ints_push(fns, f);
            strs_push(names, strs_get(c.fnname, f));
        }
        f = f + 1;
    }
    let mut i = 0;
    while i < ints_len(c.rx.fm) {
        if ints_get(c.rx.fm, i) == m {
            ints_push(fns, ints_get(c.rx.ff, i));
            strs_push(names, strs_get(c.rx.fname, i));
        }
        i = i + 1;
    }
    0
}

// The records (`records`) or the enums a module re-exports under their own names, in the order
// each was first offered.
fn rx_offered_kind(c: Ck, m: Int, records: Bool, tys: Ints, names: Strs) -> Int {
    let mut i = 0;
    while i < ints_len(c.rx.tm) {
        let t = ints_get(c.rx.tt, i);
        if ints_get(c.rx.tm, i) == m && ints_get(c.rx.tn, i) == 1 && is_record(c, t) == records { offer_type(c, tys, names, t, ""); }
        i = i + 1;
    }
    0
}

// Whether module `m` offers the trait `t`: its own `pub` one, or one it re-exports.
fn offers_trait(c: Ck, m: Int, t: Int) -> Bool {
    if ints_get(c.trmod, t) == m && ints_get(c.trpub, t) == 1 { return true; }
    rx_pair(c.rx.rm, c.rx.rt, m, t)
}

fn rx_pair(xs: Ints, ys: Ints, x: Int, y: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == x && ints_get(ys, i) == y { return true; }
        i = i + 1;
    }
    false
}

// Whether an impl in module `at` is usable in module `m` (`impl_scope`): `m` itself, a module it
// imports directly, or one those re-export from, however far.
fn impl_usable(c: Ck, m: Int, at: Int) -> Bool {
    if at == m { return true; }
    let seen = ints_new();
    ints_push(seen, m);
    let work = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        ints_push(work, ints_get(c.don, dep(c, m, k)));
        k = k + 1;
    }
    while ints_len(work) > 0 {
        let x = ints_pop(work);
        if index_of(seen, x) < 0 {
            if x == at { return true; }
            ints_push(seen, x);
            let mut i = 0;
            while i < ints_len(c.rx.sm) {
                if ints_get(c.rx.sm, i) == x { ints_push(work, ints_get(c.rx.sf, i)); }
                i = i + 1;
            }
        }
    }
    false
}

// Apply every `pub use` (`apply_reexports`): a module re-exporting from one that re-exports is
// applied after it, sweep by sweep in load order. Without `full`, types and traits only, silently,
// for the type names importers resolve; with it, the functions too and every refusal — each
// module's types offered again from nothing, as the reference's second pass starts from fresh
// interfaces — and then each re-export left in a cycle (N0213).
fn apply_reexports(c: Ck, full: Bool) -> Int {
    let count = ints_len(c.mprog);
    if full {
        while ints_len(c.rx.tm) > 0 {
            ints_pop(c.rx.tm);
            ints_pop(c.rx.tt);
            ints_pop(c.rx.tn);
        }
        while ints_len(c.rx.nm) > 0 {
            ints_pop(c.rx.nm);
            strs_pop(c.rx.nname);
            ints_pop(c.rx.nt);
        }
    }
    let done = ints_new();
    let mut m = 0;
    while m < count {
        let mut none = 1;
        let mut k = 0;
        while k < deps(c, m) {
            if ints_get(c.rx.dk, dep(c, m, k)) > 0 { none = 0; }
            k = k + 1;
        }
        ints_push(done, none);
        m = m + 1;
    }
    let mut progressed = true;
    while progressed {
        progressed = false;
        m = 0;
        while m < count {
            if ints_get(done, m) == 0 {
                let mut ready = true;
                let mut k = 0;
                while k < deps(c, m) {
                    let d = dep(c, m, k);
                    if ints_get(c.rx.dk, d) > 0 && ints_get(done, ints_get(c.don, d)) == 0 { ready = false; }
                    k = k + 1;
                }
                if ready {
                    k = 0;
                    while k < deps(c, m) {
                        let d = dep(c, m, k);
                        if ints_get(c.rx.dk, d) > 0 { reexport_one(c, m, d, full); }
                        k = k + 1;
                    }
                    ints_set(done, m, 1);
                    progressed = true;
                }
            }
            m = m + 1;
        }
    }
    m = 0;
    while m < count {
        if full && ints_get(done, m) == 0 {
            let mut k = 0;
            while k < deps(c, m) {
                let d = dep(c, m, k);
                if ints_get(c.rx.dk, d) > 0 {
                    dg_error(c.d, "N0213", ints_get(c.rx.das, d), ints_get(c.rx.dae, d), "this re-export is part of a cycle of re-exports", "",
                            "a re-export offers what another module offers, so a cycle of them offers nothing in particular: re-export from the module that defines the name");
                }
                k = k + 1;
            }
        }
        rx_order_known(c, m);
        m = m + 1;
    }
    0
}

// Where a module offers two re-exported records (or two enums) under their own names and has
// public items of its own, the reference orders them by what its public surface mentions first
// (`RecordExport`'s closure), which this checker does not compute: it stops rather than risk an
// order — of collisions reported, or of a whole-module re-export's names — the reference would
// not give.
fn rx_order_known(c: Ck, m: Int) -> Int {
    let mut records = 0;
    let mut enums = 0;
    let mut i = 0;
    while i < ints_len(c.rx.tm) {
        if ints_get(c.rx.tm, i) == m {
            if is_record(c, ints_get(c.rx.tt, i)) { records = records + 1; } else { enums = enums + 1; }
        }
        i = i + 1;
    }
    if records < 2 && enums < 2 { return 0; }
    let p = ints_get(c.mprog, m);
    let mut own = false;
    let lists = strs_new();
    strs_push(lists, "functions");
    strs_push(lists, "records");
    strs_push(lists, "enums");
    strs_push(lists, "consts");
    strs_push(lists, "traits");
    i = 0;
    while i < strs_len(lists) {
        let xs = kids(c, p, strs_get(lists, i));
        let mut k = 0;
        while k < ints_len(xs) {
            if some(c, ints_get(xs, k), "pub_span") { own = true; }
            k = k + 1;
        }
        i = i + 1;
    }
    if own { stop(c, "a module re-exporting two types of a kind beside public items of its own"); }
    0
}

// One dependency's `pub use` (`reexport_one`): what module `from` offers, added to what `m` offers.
fn reexport_one(c: Ck, m: Int, d: Int, full: Bool) -> Int {
    let from = ints_get(c.don, d);
    if rx_pair(c.rx.sm, c.rx.sf, m, from) == false {
        ints_push(c.rx.sm, m);
        ints_push(c.rx.sf, from);
    }
    // What `from` offers, by the name an importer writes.
    let tys = ints_new();
    let tnames = strs_new();
    offered_types(c, from, tys, tnames);
    let trs = ints_new();
    let mut t = 0;
    while t < strs_len(c.trname) {
        if ints_get(c.trmod, t) == from && ints_get(c.trpub, t) == 1 { ints_push(trs, t); }
        t = t + 1;
    }
    let mut i = 0;
    while i < ints_len(c.rx.rm) {
        if ints_get(c.rx.rm, i) == from { ints_push(trs, ints_get(c.rx.rt, i)); }
        i = i + 1;
    }
    let fns = ints_new();
    let fnames = strs_new();
    if full { offered_fns(c, from, fns, fnames); }
    // The names chosen, or every one, each with the name it is offered under.
    let names = strs_new();
    let offered = strs_new();
    let starts = ints_new();
    let ends = ints_new();
    let listed = ints_get(c.rx.dk, d) == 1;
    if listed {
        i = 0;
        while i < ints_get(c.rx.dic, d) {
            let it = ints_get(c.rx.dif, d) + i;
            strs_push(names, strs_get(c.rx.iname, it));
            if strs_get(c.rx.ialias, it) == "" { strs_push(offered, strs_get(c.rx.iname, it)); } else { strs_push(offered, strs_get(c.rx.ialias, it)); }
            ints_push(starts, ints_get(c.rx.is, it));
            ints_push(ends, ints_get(c.rx.ie, it));
            i = i + 1;
        }
    } else {
        let every = strs_new();
        i = 0;
        while i < strs_len(fnames) {
            strs_push(every, strs_get(fnames, i));
            i = i + 1;
        }
        i = 0;
        while i < strs_len(tnames) {
            strs_push(every, strs_get(tnames, i));
            i = i + 1;
        }
        i = 0;
        while i < ints_len(trs) {
            strs_push(every, strs_get(c.trname, ints_get(trs, i)));
            i = i + 1;
        }
        i = 0;
        while i < strs_len(every) {
            strs_push(names, strs_get(every, i));
            strs_push(offered, strs_get(every, i));
            ints_push(starts, ints_get(c.rx.das, d));
            ints_push(ends, ints_get(c.rx.dae, d));
            i = i + 1;
        }
    }
    i = 0;
    while i < strs_len(names) {
        reexport_name(c, m, d, full, listed, strs_get(names, i), strs_get(offered, i), ints_get(starts, i), ints_get(ends, i), fns, fnames, tys, tnames, trs);
        i = i + 1;
    }
    0
}

// One name of a re-export, as `reexport_one`'s loop takes it.
fn reexport_name(c: Ck, m: Int, d: Int, full: Bool, listed: Bool, name: Str, offered: Str, s: Int, e: Int, fns: Ints, fnames: Strs, tys: Ints,
        tnames: Strs, trs: Ints) -> Int {
    let renamed = name != offered;
    let fi = strs_find(fnames, name);
    let ti = strs_find(tnames, name);
    let mut tr = 0 - 1;
    let mut i = 0;
    while i < ints_len(trs) && tr < 0 {
        if strs_get(c.trname, ints_get(trs, i)) == name { tr = ints_get(trs, i); }
        i = i + 1;
    }
    // A name this module already offers, its own or another re-export's.
    let mine = ints_new();
    let mine_names = strs_new();
    offered_fns(c, m, mine, mine_names);
    let taken_fn = strs_find(mine_names, offered) >= 0;
    let mine_tys = ints_new();
    let mine_tnames = strs_new();
    offered_types(c, m, mine_tys, mine_tnames);
    let mut taken_ty = strs_find(mine_tnames, offered) >= 0;
    i = 0;
    while i < strs_len(c.trname) {
        if strs_get(c.trname, i) == offered {
            if ints_get(c.trmod, i) == m || rx_pair(c.rx.rm, c.rx.rt, m, i) { taken_ty = true; }
        }
        i = i + 1;
    }
    if fi < 0 && ti < 0 && tr < 0 {
        if full {
            dg_error(c.d, "N0211", s, e, cat3("`", name, "` is not exported by the module this re-exports from"), "",
                    "a module re-exports only what the module it names exports");
        }
        return 0;
    }
    if fi >= 0 && full {
        if taken_fn { return rx_taken(c, offered, s, e); }
        ints_push(c.rx.fm, m);
        strs_push(c.rx.fname, offered);
        ints_push(c.rx.ff, ints_get(fns, fi));
        if listed { rx_resolved(c, m, s, e, 1, ints_get(fns, fi)); }
    }
    if ti >= 0 {
        let ty = ints_get(tys, ti);
        if taken_ty && full && fi < 0 { return rx_taken(c, offered, s, e); }
        if taken_ty == false {
            rx_add_type(c, m, ty, renamed, offered);
            if listed && full { rx_resolved(c, m, s, e, 2, ty); }
        }
    }
    if tr >= 0 {
        if renamed {
            if full {
                dg_error(c.d, "N0211", s, e, cat3("`", name, "` is a trait, which is re-exported under its own name"), "",
                        "a trait's name is how an importer's bounds and calls find it: drop `as`");
            }
            return 0;
        }
        // Recorded at the type stage already: the full stage only reports.
        let again = rx_pair(c.rx.rm, c.rx.rt, m, tr);
        if taken_ty && again == false && full && fi < 0 && ti < 0 { return rx_taken(c, offered, s, e); }
        if again == false {
            ints_push(c.rx.rm, m);
            ints_push(c.rx.rt, tr);
        }
        if listed && full { rx_resolved(c, m, s, e, 3, tr); }
    }
    0
}

// A type offered by `m` (`add_reexported_type`): under its own name, or — `renamed` — another; a
// type offered already keeps its place.
fn rx_add_type(c: Ck, m: Int, ty: Int, renamed: Bool, name: Str) -> Int {
    let mut at = 0 - 1;
    let mut i = 0;
    while i < ints_len(c.rx.tm) {
        if ints_get(c.rx.tm, i) == m && ints_get(c.rx.tt, i) == ty { at = i; }
        i = i + 1;
    }
    if at < 0 {
        ints_push(c.rx.tm, m);
        ints_push(c.rx.tt, ty);
        ints_push(c.rx.tn, 0);
        at = ints_len(c.rx.tm) - 1;
    }
    if renamed {
        ints_push(c.rx.nm, m);
        strs_push(c.rx.nname, name);
        ints_push(c.rx.nt, ty);
    } else {
        ints_set(c.rx.tn, at, 1);
    }
    0
}

fn rx_resolved(c: Ck, m: Int, s: Int, e: Int, kind: Int, id: Int) -> Int {
    ints_push(c.rx.xm, m);
    ints_push(c.rx.xs, s);
    ints_push(c.rx.xe, e);
    ints_push(c.rx.xk, kind);
    ints_push(c.rx.xid, id);
    0
}

// `N0212`: a name this module offers twice.
fn rx_taken(c: Ck, name: Str, s: Int, e: Int) -> Int {
    dg_error(c.d, "N0212", s, e, cat3("`", name, "` is already offered by this module"), "",
            "a module offers each name once: re-export it under another name with `as`, or rename the definition")
}

// What a module may hold that the checker does not carry yet.
fn refuse_unsupported_items(c: Ck, m: Int) -> Int {
    let p = ints_get(c.mprog, m);
    // A derived encoding is carried since R2 D27: the loader expands it (`derive.nz`).
    let functions = kids(c, p, "functions");
    let mut i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        if ints_len(kids(c, f, "effect_params")) > 0 && some(c, f, "method_of") { stop(c, "an effect parameter of a method"); }
        // A function without a body is a foreign one, or one whose body did not parse.
        if some(c, f, "body") == false && some(c, f, "foreign") == false && gs(c, s_syntax()) != 1 { stop(c, "a function without a body"); }
        i = i + 1;
    }
    0
}

// --- stage 0a: type names (`declare_types`) --------------------------------------------------

fn declare_types(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    let p = ints_get(c.mprog, m);
    let records = kids(c, p, "records");
    let mut i = 0;
    while i < ints_len(records) {
        let r = ints_get(records, i);
        let name = fname_of(c, r, "name");
        let ns = fld(c, r, "name_span");
        if refuse_type_name(c, m, name, ns) == false {
            declared_type_params(c, r);
            requirements(c, r, false, 0);
            ints_push(c.rlog, 0 - 1 - strs_len(c.rname));
            strs_push(c.rname, name);
            ints_push(c.rmod, m);
            ints_push(c.rns, sps(c, ns));
            ints_push(c.rne, spe(c, ns));
            ints_push(c.rnp, ints_len(kids(c, r, "type_params")));
            ints_push(c.rff, 0);
            ints_push(c.rfc, 0);
            if some(c, r, "pub_span") { ints_push(c.rpub, 1); } else { ints_push(c.rpub, 0); }
            ints_push(c.rrepr, record_repr(c, r));
        }
        i = i + 1;
    }
    let enums = kids(c, p, "enums");
    i = 0;
    while i < ints_len(enums) {
        let e = ints_get(enums, i);
        let name = fname_of(c, e, "name");
        let ns = fld(c, e, "name_span");
        if refuse_type_name(c, m, name, ns) == false {
            declared_type_params(c, e);
            requirements(c, e, false, 0);
            ints_push(c.elog, 0 - 1 - strs_len(c.ename));
            strs_push(c.ename, name);
            ints_push(c.emod, m);
            ints_push(c.ens, sps(c, ns));
            ints_push(c.ene, spe(c, ns));
            ints_push(c.enp, ints_len(kids(c, e, "type_params")));
            ints_push(c.evf, 0);
            ints_push(c.evc, 0);
            if some(c, e, "pub_span") { ints_push(c.epub, 1); } else { ints_push(c.epub, 0); }
        }
        i = i + 1;
    }
    // Traits share the type namespace (N78); their methods are resolved once every type is.
    let traits = kids(c, p, "traits");
    i = 0;
    while i < ints_len(traits) {
        let t = ints_get(traits, i);
        let name = fname_of(c, t, "name");
        let ns = fld(c, t, "name_span");
        if refuse_type_name(c, m, name, ns) == false {
            strs_push(c.trname, name);
            ints_push(c.trmod, m);
            ints_push(c.trns, sps(c, ns));
            ints_push(c.trne, spe(c, ns));
            if some(c, t, "pub_span") { ints_push(c.trpub, 1); } else { ints_push(c.trpub, 0); }
            ints_push(c.trmf, 0);
            ints_push(c.trmc, 0);
        }
        i = i + 1;
    }
    0
}

fn declared_trait(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.trname) {
        if ints_get(c.trmod, i) == m && strs_get(c.trname, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

// A declaration's type parameters, checked once (`declared_type_params`): never a built-in
// type's name or `Vec` (N0331), and unique within the list (N0350).
fn declared_type_params(c: Ck, decl: Int) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let name = fname_of(c, p, "name");
        if flag(c, p, "effect") { stop(c, "an effect parameter"); }
        if is_builtin_name(name) || name == "Vec" {
            err(c, "N0331", fld(c, p, "span"), cat3("`", name, "` is a built-in type and cannot be a type parameter"),
                    "a built-in type's name means the same thing everywhere, including inside a generic definition; choose another name, such as `T`");
        } else {
            let mut k = 0;
            let mut first = 0 - 1;
            while k < i {
                if first < 0 && fname_of(c, ints_get(params, k), "name") == name { first = k; }
                k = k + 1;
            }
            if first >= 0 {
                err(c, "N0350", fld(c, p, "span"), cat3("`", name, "` is declared twice in this parameter list"),
                        "a type parameter is one position; two cannot share a name");
                sec(c, fld(c, ints_get(params, first), "span"), "first declared here");
            }
        }
        i = i + 1;
    }
    0
}

// What a declaration's type parameters require (`declared_requirements`): only a function's may
// (N0101 otherwise), and only `Equality` while no trait is in scope (N0365). A function's are
// recorded against its parameters' run.
fn requirements(c: Ck, decl: Int, function: Bool, id: Int) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        if some(c, p, "requires") {
            let req = unwrap(c, p, "requires");
            let rs = fld(c, req, "span");
            if function == false {
                err(c, "N0101", rs, "a requirement on a record's or an enum's type parameter is not supported yet",
                        "require the capability where it is used: a function can say `fn same[T: Equality](a: Box[T], b: Box[T]) -> Bool`");
            } else {
                let at = strs_find(c.tsname, fname_of(c, req, "name"));
                let mut bound = 0 - 1;
                if at >= 0 && fname_of(c, req, "name") != "Equality" { bound = ints_get(c.tsid, at); }
                if bound >= 0 {
                    // A trait (N78): the parameter's methods are the trait's.
                    sm_put(c.mtrm, sps(c, rs), spe(c, rs), bound);
                    ints_set(c.tpbound, ints_get(c.fntpf, id) + i, bound);
                } else {
                    if fname_of(c, req, "name") != "Equality" {
                        err(c, "N0365", rs, cat3("`", fname_of(c, req, "name"), "` is not a capability a type parameter can require"),
                                "a type parameter requires `Equality` or a trait in scope: `fn same[T: Equality](a: T, b: T) -> Bool`, `fn f[T: Show](x: T) -> Str`");
                    } else {
                        ints_set(c.tpeq, ints_get(c.fntpf, id) + i, 1);
                    }
                }
            }
        }
        i = i + 1;
    }
    0
}

// The type of a function's `index`th type parameter, named as its declaration names it.
fn fn_param_ty(c: Ck, id: Int, index: Int) -> Int {
    let mut name = cat3("type parameter ", int_to_str(index + 1), "");
    if index < ints_get(c.fntpc, id) { name = strs_get(c.tpname, ints_get(c.fntpf, id) + index); }
    param_ty(c, own_fn(), id, index, name)
}

// Whether a type parameter's declaration requires `Equality` (N14).
fn requires_equality(c: Ck, t: Int) -> Bool {
    if ta(c, t) != own_fn() { return false; }
    let id = ints_get(c.tyb, t);
    let index = ints_get(c.tyc, t);
    if index >= ints_get(c.fntpc, id) { return false; }
    ints_get(c.tpeq, ints_get(c.fntpf, id) + index) == 1
}

fn declared_record(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && strs_get(c.rname, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}
fn declared_enum(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && strs_get(c.ename, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn refuse_type_name(c: Ck, m: Int, name: Str, at: Int) -> Bool {
    if is_builtin_name(name) || name == "Vec" {
        err(c, "N0331", at, cat3("`", name, "` is a built-in type and cannot be redefined"),
                "built-in type names mean the same thing in every module of every program, so none of them may be shadowed; choose another name");
        return true;
    }
    let r = declared_record(c, m, name);
    let e = declared_enum(c, m, name);
    let t = declared_trait(c, m, name);
    if r >= 0 || e >= 0 || t >= 0 {
        err(c, "N0330", at, cat3("`", name, "` is declared more than once in this module"),
                "records and enums share one type namespace, so a `struct` and an `enum` of the same name collide exactly as two of either would");
        if r >= 0 { sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "first declared here"); } else {
            if e >= 0 { sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "first declared here"); } else {
                sec_at(c, ints_get(c.trns, t), ints_get(c.trne, t), "first declared here");
            }
        }
        return true;
    }
    false
}

// The names a module may write a type by (`type_environment`): its own, then each direct
// import's nameable types — under each name it is imported by as `alias::Name`, and plainly where
// a plain `use` named it. With `report`, an import bringing in a type the module declares
// (N0208) or one another import brought in (N0207) is reported; the prelude's names are never
// ambiguous.
fn type_environment(c: Ck, m: Int, report: Bool) -> Int {
    while strs_len(c.tnames) > 0 {
        strs_pop(c.tnames);
        ints_pop(c.ttys);
    }
    while strs_len(c.taliases) > 0 { strs_pop(c.taliases); }
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && strs_find(c.tnames, strs_get(c.rname, i)) < 0 {
            strs_push(c.tnames, strs_get(c.rname, i));
            ints_push(c.ttys, record_ty(c, i, ints_new()));
        }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && strs_find(c.tnames, strs_get(c.ename, i)) < 0 {
            strs_push(c.tnames, strs_get(c.ename, i));
            ints_push(c.ttys, enum_ty(c, i, ints_new()));
        }
        i = i + 1;
    }
    // Which import brought each plain name in, for the second.
    let bnames = strs_new();
    let bstarts = ints_new();
    let bends = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        let on = ints_get(c.don, d);
        let offered = ints_new();
        let onames = strs_new();
        offered_types(c, on, offered, onames);
        let mut a = 0;
        while a < ints_get(c.dac, d) {
            let alias = strs_get(c.aname, ints_get(c.daf, d) + a);
            strs_push(c.taliases, alias);
            let mut j = 0;
            while j < ints_len(offered) {
                let t = ints_get(offered, j);
                set_type_name(c, cat3(alias, "::", strs_get(onames, j)), t);
                j = j + 1;
            }
            a = a + 1;
        }
        if ints_get(c.dplain, d) == 1 {
            let mut j = 0;
            while j < ints_len(offered) {
                let t = ints_get(offered, j);
                let name = strs_get(onames, j);
                let own = own_type(c, m, name);
                let first = strs_find(bnames, name);
                if ints_get(c.dimplicit, d) == 1 && (own >= 0 || first >= 0) {
                    // The prelude's standard modules (R1.5, D9) yield, silently.
                } else {
                    if own >= 0 {
                        // The prelude's names are reserved rather than colliding at an import: no
                        // `use` was written, and the rule is about the declaration (N0363).
                        if on == prelude(c) && report {
                            dg_error(c.d, "N0363", type_start(c, own), type_end(c, own), cat3("`", name, "` is a core prelude type"), "",
                                    "every module sees the prelude's `Result` and `Option` without importing them, and there is no way to shadow one. Give this type another name");
                            sec_at(c, type_start(c, t), type_end(c, t), "declared by the core prelude here");
                        }
                        if on != prelude(c) && report {
                            dg_error(c.d, "N0208", ints_get(c.dats, d), ints_get(c.date, d),
                                    cat3("this import brings in the type `", name, "`, which this module declares"), "",
                                    "an imported type and a local one are not ranked: rename one of them, or stop exporting the other");
                            sec_at(c, type_start(c, own), type_end(c, own), "declared here");
                            sec_at(c, type_start(c, t), type_end(c, t), "and exported here");
                        }
                    } else {
                        if first >= 0 {
                            if on == prelude(c) {
                                set_type_name(c, name, t);
                            } else {
                                if report {
                                    dg_error(c.d, "N0207", ints_get(c.dats, d), ints_get(c.date, d),
                                            cat3("the type `", name, "` is exported by two imported modules"), "",
                                            "there is no way to write which one is meant, so the ambiguity is refused where it is created rather than where it is used");
                                    sec_at(c, ints_get(bstarts, first), ints_get(bends, first), "also brought in here");
                                    sec_at(c, type_start(c, t), type_end(c, t), "exported here");
                                }
                            }
                        } else {
                            strs_push(bnames, name);
                            ints_push(bstarts, ints_get(c.dats, d));
                            ints_push(bends, ints_get(c.date, d));
                            set_type_name(c, name, t);
                        }
                    }
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    0
}

// A name in the module's types, replacing what it named before (a map's insert).
fn set_type_name(c: Ck, name: Str, t: Int) -> Int {
    let at = strs_find(c.tnames, name);
    if at >= 0 {
        ints_set(c.ttys, at, t);
        return 0;
    }
    strs_push(c.tnames, name);
    ints_push(c.ttys, t);
    0
}

// The types a module offers by name (`offered_types`), into `tys` and `names`: its nameable
// records — its `pub` ones, then those it re-exports under their own names — then its nameable
// enums the same way, then each type it re-exports under another name (N103).
fn offered_types(c: Ck, m: Int, tys: Ints, names: Strs) -> Int {
    let mut i = 0;
    while i < strs_len(c.rname) {
        if ints_get(c.rmod, i) == m && ints_get(c.rpub, i) == 1 { offer_type(c, tys, names, record_ty(c, i, ints_new()), ""); }
        i = i + 1;
    }
    rx_offered_kind(c, m, true, tys, names);
    i = 0;
    while i < strs_len(c.ename) {
        if ints_get(c.emod, i) == m && ints_get(c.epub, i) == 1 { offer_type(c, tys, names, enum_ty(c, i, ints_new()), ""); }
        i = i + 1;
    }
    rx_offered_kind(c, m, false, tys, names);
    i = 0;
    while i < ints_len(c.rx.nm) {
        if ints_get(c.rx.nm, i) == m { offer_type(c, tys, names, ints_get(c.rx.nt, i), strs_get(c.rx.nname, i)); }
        i = i + 1;
    }
    0
}

fn offer_type(c: Ck, tys: Ints, names: Strs, t: Int, name: Str) -> Int {
    ints_push(tys, t);
    if name == "" { strs_push(names, type_name(c, t)); } else { strs_push(names, name); }
    0
}

// A module's own type of this name, or -1.
fn own_type(c: Ck, m: Int, name: Str) -> Int {
    let r = declared_record(c, m, name);
    if r >= 0 { return record_ty(c, r, ints_new()); }
    let e = declared_enum(c, m, name);
    if e >= 0 { return enum_ty(c, e, ints_new()); }
    0 - 1
}

// A record's or an enum's declared name, and where it is written.
fn type_name(c: Ck, t: Int) -> Str {
    if is_record(c, t) { return strs_get(c.rname, ta(c, t)); }
    strs_get(c.ename, ta(c, t))
}
fn type_start(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rns, ta(c, t)); }
    ints_get(c.ens, ta(c, t))
}
fn type_end(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rne, ta(c, t)); }
    ints_get(c.ene, ta(c, t))
}

fn type_named(c: Ck, name: Str) -> Int {
    let i = strs_find(c.tnames, name);
    if i < 0 { return 0 - 1; }
    ints_get(c.ttys, i)
}

// --- written types (`resolve_written`) --------------------------------------------------------

// A type as written, resolved against the module's names and `scope` (type parameters by name),
// every mistake reported to `d` — the checker's own, or one that is thrown away.
// The bound on how deeply a written type may nest is checked once, at the top (N0338).
fn resolve_written(c: Ck, w: Int, pnames: Strs, ptys: Ints, d: Diags) -> Int {
    let t = resolve_written_inner(c, w, pnames, ptys, d);
    if nesting(c, t) > max_depth() {
        let span = fld(c, w, "span");
        dg_error(d, "N0338", sps(c, span), spe(c, span), "types may nest 32 deep", "",
                "each level multiplies the copy and cleanup code generated for every value of the outer type, so the bound is on the emitted program rather than on the compiler. It is stated rather than discovered");
        return t_int();
    }
    t
}

fn max_depth() -> Int { 32 }

// A written type name's identity, where it was decided (`record_written_type`).
fn note_written(c: Ck, ns: Int, kind: Int) -> Int {
    if gs(c, s_quiet()) == 0 { sm_put(c.mwty, sps(c, ns), spe(c, ns), kind); }
    0
}

// How deeply a type nests through its arguments (`nesting`): 1 for a type with none.
fn nesting(c: Ck, t: Int) -> Int {
    let mut deepest = 1;
    let mut i = 0;
    while i < targc(c, t) {
        let d = nesting(c, targ(c, t, i)) + 1;
        if d > deepest { deepest = d; }
        if deepest > max_depth() + 1 { return deepest; }
        i = i + 1;
    }
    deepest
}

fn resolve_written_inner(c: Ck, w: Int, pnames: Strs, ptys: Ints, d: Diags) -> Int {
    let name = fname_of(c, w, "name");
    let ns = fld(c, w, "name_span");
    let span = fld(c, w, "span");
    let has_args = some(c, w, "args");
    let args = ints_new();
    if has_args {
        let written = sx_items(c.t, unwrap(c, w, "args"));
        let mut i = 0;
        while i < ints_len(written) {
            ints_push(args, resolve_written_inner(c, ints_get(written, i), pnames, ptys, d));
            i = i + 1;
        }
        // An effect parameter is named only in function types (N51): inside a type's arguments
        // it would make two instances of one type that differ only in effects.
        if eparam(c) >= 0 {
            let mut named = false;
            i = 0;
            while i < ints_len(args) {
                if names_effect_param(c, ints_get(args, i), eparam(c)) { named = true; }
                i = i + 1;
            }
            if named {
                dg_error(d, "N0388", sps(c, span), spe(c, span),
                        cat3("the effect parameter `", effect_param_name(c, eparam(c)), "` is named inside this type's arguments"), "",
                        "an effect parameter may be named in a function type that is a parameter's or the result's, or one nested in those: write the function type there");
            }
        }
    }
    // `fn(T…) -> R ! {e}` (N50): its parts resolved as any type is, interned.
    if some(c, w, "function") {
        let ft = unwrap(c, w, "function");
        let written = kids(c, ft, "params");
        let params = ints_new();
        let mut i = 0;
        while i < ints_len(written) {
            ints_push(params, resolve_written_inner(c, ints_get(written, i), pnames, ptys, d));
            i = i + 1;
        }
        let ret = resolve_written_inner(c, fld(c, ft, "ret"), pnames, ptys, d);
        let mut effects = 0;
        if some(c, ft, "effects") {
            let e = declared_effects_to(c, unwrap(c, ft, "effects"), d);
            if e >= 0 { effects = e; }
        }
        return fn_ty(c, params, ret, effects, eparam(c));
    }
    // `(A, B, …)` (L5): a tuple of the elements written.
    if name == "()" && some(c, w, "qualifier") == false && some(c, w, "length") == false { return tuple_ty(c, args); }
    // `[T; N]` (Gate 2): an array of the element written, its length a constant.
    if some(c, w, "length") && name == "[]" {
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        let mut n = array_length(c, unwrap(c, w, "length"), d);
        if n < 0 { n = 1; }
        let t = array_of(c, elem, n);
        if index_of(c.awty, t) < 0 {
            ints_push(c.awty, t);
            ints_push(c.aws, sps(c, span));
            ints_push(c.awe, spe(c, span));
        }
        return t;
    }
    if some(c, w, "length") || str_len(name) == 0 || starts_upper(name) == false {
        stop(c, cat3("the type `", name, "`"));
        return t_int();
    }
    // A qualified type names a module's definition (N49): never a type parameter, never `Vec`
    // or a built-in, which belong to no module.
    if some(c, w, "qualifier") {
        let t = resolve_name(c, written_key(c, w, "name"), ns, d);
        return applied_written(c, t, has_args, args, ns, span, d);
    }
    let at = strs_find(pnames, name);
    if at >= 0 {
        if has_args { not_generic(c, d, name, "a type parameter", span); }
        if tag(c, ints_get(ptys, at)) == tag_param() { note_written(c, ns, 2); }
        return ints_get(ptys, at);
    }
    // `Chan[T]` (N53): a generic channel, for a `T` that may cross into a task; `Chan` alone is
    // the `Int` channel.
    if name == "Chan" && has_args {
        if ints_len(args) != 1 { wrong_arity(c, d, "Chan", 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        channel_element(c, d, elem, span);
        note_written(c, ns, 1);
        return chan_of(c, elem);
    }
    // `Box[T]` and `Chain[T]` (R1a) and `Cell[T]` (R1b): prelude names, so a module's own type of
    // the name keeps it.
    if (name == "Box" || name == "Cell" || name == "Chain") && type_named(c, name) < 0 {
        if has_args == false {
            let mut what = "box";
            if name == "Cell" { what = "cell"; }
            if name == "Chain" { what = "chain"; }
            dg_error(d, "N0352", sps(c, ns), spe(c, ns), cat3("`", name, "` is written with its element type"), "",
                    cat5(cat5("a ", what, " of `Int` is `", name, "[Int]`; `"), name, "` alone is not a type", "", ""));
            return t_int();
        }
        if ints_len(args) != 1 { wrong_arity(c, d, name, 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        note_written(c, ns, 1);
        if name == "Box" { return holder_of(c, tag_box(), elem); }
        if name == "Cell" { return holder_of(c, tag_cell(), elem); }
        return holder_of(c, tag_chain(), elem);
    }
    // `List[T]` (R1.5, D7) is `Vec[T]`: a prelude name, so a module's own type of the name keeps it.
    if name == "List" && type_named(c, name) < 0 {
        if has_args == false {
            dg_error(d, "N0352", sps(c, ns), spe(c, ns), "`List` is written with its element type", "",
                    "a list of `Int` is `List[Int]`; `List` alone is not a type");
            return t_int();
        }
        if ints_len(args) != 1 { wrong_arity(c, d, "List", 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        note_written(c, ns, 1);
        return vec_of(c, elem);
    }
    if name == "Vec" {
        if has_args == false {
            dg_error(d, "N0352", sps(c, ns), spe(c, ns), "`Vec` is written with its element type", "",
                    "a vector of `Int` is `Vec[Int]`; `Vec` alone is not a type");
            return t_int();
        }
        if ints_len(args) != 1 { wrong_arity(c, d, "Vec", 1, ints_len(args), span); }
        let mut elem = t_int();
        if ints_len(args) > 0 { elem = ints_get(args, 0); }
        note_written(c, ns, 1);
        return vec_of(c, elem);
    }
    let t = resolve_name(c, name, ns, d);
    if is_builtin_name(name) {
        if has_args { not_generic(c, d, name, "a built-in type", span); }
        note_written(c, ns, 1);
        return t;
    }
    applied_written(c, t, has_args, args, ns, span, d)
}

// A record or an enum as written, applied to the arguments written after it: exactly as many as
// it declares.
fn applied_written(c: Ck, t: Int, has_args: Bool, args: Ints, ns: Int, span: Int, d: Diags) -> Int {
    if is_record(c, t) == false && is_enum(c, t) == false { return t; }
    let mut arity = 0;
    if is_record(c, t) { arity = ints_get(c.rnp, ta(c, t)); } else { arity = ints_get(c.enp, ta(c, t)); }
    if has_args == false {
        if arity == 0 { return t; }
        let shown = show(c, t);
        dg_error(d, "N0352", sps(c, ns), spe(c, ns),
                cat5("`", shown, "` is generic, so it is written with its ", int_to_str(arity), str_concat(" type argument", plural(arity))), "",
                cat5("write `", shown, "[…]` with ", int_to_str(arity), str_concat(" type", plural(arity))));
        let mut ds = 0;
        let mut de = 0;
        if is_record(c, t) { ds = ints_get(c.rns, ta(c, t)); de = ints_get(c.rne, ta(c, t)); } else {
            ds = ints_get(c.ens, ta(c, t));
            de = ints_get(c.ene, ta(c, t));
        }
        dg_secondary(d, ds, de, "declared here");
        return t_int();
    }
    if arity == 0 {
        not_generic(c, d, show(c, t), "not generic", span);
        return t;
    }
    if ints_len(args) != arity {
        wrong_arity(c, d, show(c, t), arity, ints_len(args), span);
        while ints_len(args) > arity { ints_pop(args); }
        while ints_len(args) < arity { ints_push(args, t_int()); }
    }
    if is_record(c, t) { return record_ty(c, ta(c, t), args); }
    enum_ty(c, ta(c, t), args)
}

fn not_generic(c: Ck, d: Diags, name: Str, what: Str, span: Int) -> Int {
    let mut why = cat5("`", name, "` is ", what, ", so it takes no type arguments");
    if what == "not generic" { why = cat3("`", name, "` is not generic, so it takes no type arguments"); }
    dg_error(d, "N0351", sps(c, span), spe(c, span), why, "",
            "only a definition that declares type parameters is applied to type arguments")
}

// `N0390` for a `Chan[elem]` whose element may not cross into a task: the rule a `spawn` argument
// follows, so a channel carries exactly what a task may be given.
fn channel_element(c: Ck, d: Diags, elem: Int, span: Int) -> Int {
    let why = task_safety(c, elem);
    if why == "" { return 0; }
    let shown = show(c, elem);
    let mut message = cat3("a channel cannot carry `", shown, "`: it may not cross into a task");
    if derived_path(c, why) != "" {
        message = cat5(cat3("a channel cannot carry `", shown, "`: its `"), derived_path(c, why), "` is a `", show(c, derived_type(c, why)),
                "`, which may not cross into a task");
    }
    dg_error(d, "N0390", sps(c, span), spe(c, span), message, "", channel_help())
}

fn channel_help() -> Str {
    "a channel's values reach another task, so they follow the rule a `spawn` argument does: `Int`, `Bool`, `Str`, channels, and records and enums of those"
}

fn wrong_arity(c: Ck, d: Diags, name: Str, want: Int, got: Int, span: Int) -> Int {
    let mut verb = " were given";
    if got == 1 { verb = " was given"; }
    dg_error(d, "N0353", sps(c, span), spe(c, span),
            cat5(cat3("`", name, "` takes "), int_to_str(want), str_concat(" type argument", plural(want)), ", but ", str_concat(int_to_str(got), verb)), "",
            "a generic definition is applied to exactly as many types as it declares")
}

// A type name against the built-ins and then the module's types (`resolve_name`).
fn resolve_name(c: Ck, name: Str, span: Int, d: Diags) -> Int {
    if name == "Ints" { return t_ints(); }
    if name == "Strs" { return t_strs(); }
    if is_builtin_name(name) { return builtin_ty(c, name); }
    let t = type_named(c, name);
    if t >= 0 {
        if (is_record(c, t) || is_enum(c, t)) && gs(c, s_quiet()) == 0 { sm_put(c.mtyn, sps(c, span), spe(c, span), t); }
        return t;
    }
    // `Map[K, V]` (R1.5, D5): the standard hash map under a shorter name, where it is in scope.
    if name == "Map" && type_named(c, "HashMap") >= 0 {
        let hm = type_named(c, "HashMap");
        if (is_record(c, hm) || is_enum(c, hm)) && gs(c, s_quiet()) == 0 { sm_put(c.mtyn, sps(c, span), spe(c, span), hm); }
        return hm;
    }
    if name == "Map" {
        dg_error(d, "N0305", sps(c, span), spe(c, span), "`Map` is `@std/hashmap`'s `HashMap`", "", "import it: `use \"@std/hashmap\";`");
        return t_int();
    }
    if str_has(name, "::") {
        unknown_qualified(c, d, name, c.taliases, sps(c, span), spe(c, span), "type");
        return t_int();
    }
    // A trait where a type is expected (N78): there are no trait objects.
    let tr = strs_find(c.trname, name);
    if tr >= 0 {
        dg_error(d, "N0607", sps(c, span), spe(c, span), cat3("`", name, "` is a trait, not a type"), "",
                cat5("a value has one concrete type; to accept any type with `", name, "`, take a type parameter that requires it: `fn f[T: ", name, "](x: T)`"));
        dg_secondary(d, ints_get(c.trns, tr), ints_get(c.trne, tr), "the trait");
        return t_int();
    }
    dg_error(d, "N0305", sps(c, span), spe(c, span), cat3("`", name, "` is not a type"), "",
            cat3("the built-in types are ", all_names(), ", and `struct` and `enum` declare others"));
    // A type that exists somewhere is more usefully reported as unreachable.
    let r = strs_find(c.rname, name);
    if r >= 0 {
        dg_secondary(d, ints_get(c.rns, r), ints_get(c.rne, r), "a type of this name is declared here");
    } else {
        let e = strs_find(c.ename, name);
        if e >= 0 { dg_secondary(d, ints_get(c.ens, e), ints_get(c.ene, e), "a type of this name is declared here"); }
    }
    t_int()
}

// --- stage 0b: fields (`resolve_type_fields`) --------------------------------------------------

fn resolve_type_fields(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    type_environment(c, m, true);
    let p = ints_get(c.mprog, m);
    let done = strs_new();
    let records = kids(c, p, "records");
    let mut i = 0;
    while i < ints_len(records) {
        let r = ints_get(records, i);
        let name = fname_of(c, r, "name");
        let id = declared_record(c, m, name);
        if id >= 0 && strs_find(done, name) < 0 {
            strs_push(done, name);
            let pn = strs_new();
            let pt = ints_new();
            type_params(c, r, own_record(), id, pn, pt);
            let written = kids(c, r, "fields");
            ints_set(c.rfc, id, resolve_fields(c, name, written, pn, pt));
            ints_set(c.rff, id, gs(c, s_fields()));
            // A record C sees (N85): the C ABI, not generic, and only fields C has a layout for;
            // an opaque handle's one field is a pointer no program can name.
            if some(c, r, "foreign") {
                foreign_struct(c, r, id);
                if flag(c, unwrap(c, r, "foreign"), "opaque") {
                    let ns = fld(c, r, "name_span");
                    ints_set(c.rff, id, strs_len(c.fname));
                    ints_set(c.rfc, id, 1);
                    strs_push(c.fname, "#pointer");
                    ints_push(c.fty, t_int());
                    ints_push(c.fns, sps(c, ns));
                    ints_push(c.fne, spe(c, ns));
                    ints_push(c.fts, sps(c, ns));
                    ints_push(c.fte, spe(c, ns));
                }
            }
            if ints_get(c.rfc, id) == 0 && ints_len(written) == 0 {
                err(c, "N0101", fld(c, r, "name_span"), cat3("`", name, "` has no fields, which is not supported yet"),
                        "a record with no fields would be built by writing `Name()`, which is exactly how a call to a function of that name is written — and types and functions are separate namespaces, so neither reading could be preferred. Give it a field, or use `Bool`");
            }
        }
        i = i + 1;
    }
    let enums = kids(c, p, "enums");
    i = 0;
    while i < ints_len(enums) {
        let e = ints_get(enums, i);
        let name = fname_of(c, e, "name");
        let id = declared_enum(c, m, name);
        if id >= 0 && strs_find(done, cat3("enum ", name, "")) < 0 {
            strs_push(done, cat3("enum ", name, ""));
            let variants = kids(c, e, "variants");
            if ints_len(variants) == 0 {
                err(c, "N0339", fld(c, e, "name_span"), cat3("`", name, "` has no variants, which is not supported yet"),
                        "a type with no values decides what a function returning one means and whether a `match` on one is exhaustive, and neither has been settled. Give it a variant");
            }
            let pn = strs_new();
            let pt = ints_new();
            type_params(c, e, own_enum(), id, pn, pt);
            // Variants are pooled in a run, so each one's fields are resolved first, into a
            // run of their own, and the run of variants is written after.
            let vnames = strs_new();
            let vstarts = ints_new();
            let vends = ints_new();
            let vff = ints_new();
            let vfc = ints_new();
            let mut k = 0;
            while k < ints_len(variants) {
                let v = ints_get(variants, k);
                let vn = fname_of(c, v, "name");
                let vs = fld(c, v, "name_span");
                let first = strs_find(vnames, vn);
                if first >= 0 {
                    err(c, "N0340", vs, cat5("`", name, "` has two variants called `", vn, "`"),
                            "a variant is identified by its name, so two cannot share one");
                    sec_at(c, ints_get(vstarts, first), ints_get(vends, first), "first declared here");
                } else {
                    strs_push(vnames, vn);
                    ints_push(vstarts, sps(c, vs));
                    ints_push(vends, spe(c, vs));
                    ints_push(vfc, resolve_fields(c, vn, kids(c, v, "fields"), pn, pt));
                    ints_push(vff, gs(c, s_fields()));
                }
                k = k + 1;
            }
            ints_set(c.evf, id, strs_len(c.vname));
            ints_set(c.evc, id, strs_len(vnames));
            k = 0;
            while k < strs_len(vnames) {
                strs_push(c.vname, strs_get(vnames, k));
                ints_push(c.vns, ints_get(vstarts, k));
                ints_push(c.vne, ints_get(vends, k));
                ints_push(c.vff, ints_get(vff, k));
                ints_push(c.vfc, ints_get(vfc, k));
                k = k + 1;
            }
        }
        i = i + 1;
    }
    0
}

// A declaration's type parameters, in scope by name.
fn type_params(c: Ck, decl: Int, owner: Int, id: Int, pn: Strs, pt: Ints) -> Int {
    let params = kids(c, decl, "type_params");
    let mut i = 0;
    while i < ints_len(params) {
        let n = fname_of(c, ints_get(params, i), "name");
        strs_push(pn, n);
        ints_push(pt, param_ty(c, owner, id, i, n));
        note_written(c, fld(c, ints_get(params, i), "span"), 3);
        i = i + 1;
    }
    0
}

// Fields as written, each resolved, appended to the pool as one run once all are (resolving one
// may make a tuple's record, whose fields go in the pool too); how many were kept. The run's start
// is `s_fields`.
fn resolve_fields(c: Ck, owner: Str, written: Ints, pn: Strs, pt: Ints) -> Int {
    let names = strs_new();
    let tys = ints_new();
    let nss = ints_new();
    let nse = ints_new();
    let tss = ints_new();
    let tse = ints_new();
    let mut i = 0;
    while i < ints_len(written) {
        let f = ints_get(written, i);
        let name = fname_of(c, f, "name");
        let ns = fld(c, f, "name_span");
        let dup = strs_find(names, name);
        if dup >= 0 {
            err(c, "N0332", ns, cat5("`", owner, "` has two fields called `", name, "`"),
                    "a field is identified by its name, so two cannot share one");
            sec_at(c, ints_get(nss, dup), ints_get(nse, dup), "first declared here");
        } else {
            let ty = resolve_written(c, fld(c, f, "ty"), pn, pt, c.d);
            strs_push(names, name);
            ints_push(tys, ty);
            ints_push(nss, sps(c, ns));
            ints_push(nse, spe(c, ns));
            let ts = fld(c, fld(c, f, "ty"), "span");
            ints_push(tss, sps(c, ts));
            ints_push(tse, spe(c, ts));
        }
        i = i + 1;
    }
    ss(c, s_fields(), strs_len(c.fname));
    i = 0;
    while i < strs_len(names) {
        strs_push(c.fname, strs_get(names, i));
        ints_push(c.fty, ints_get(tys, i));
        ints_push(c.fns, ints_get(nss, i));
        ints_push(c.fne, ints_get(nse, i));
        ints_push(c.fts, ints_get(tss, i));
        ints_push(c.fte, ints_get(tse, i));
        i = i + 1;
    }
    strs_len(names)
}

// --- the C boundary (N42, N55, N85; `check/foreign.rs`, `check/layout.rs`) -------------------

// How C sees a record as declared (`CRepr`): 0 not at all, 1 an opaque handle, 2 a C layout.
fn record_repr(c: Ck, r: Int) -> Int {
    if some(c, r, "foreign") == false { return 0; }
    if flag(c, unwrap(c, r, "foreign"), "opaque") { return 1; }
    2
}

// Whether a type is an opaque C handle; whether it has a layout C shares (`c_layout_type`):
// `Int`, `Bool`, or a record declared `extern "C"`.
fn is_opaque(c: Ck, t: Int) -> Bool {
    if t < 0 { return false; }
    if is_record(c, t) == false { return false; }
    ints_get(c.rrepr, ta(c, t)) == 1
}
fn c_layout_type(c: Ck, t: Int) -> Bool {
    if t == t_int() || t == t_bool() { return true; }
    if t >= 0 && is_record(c, t) { return ints_get(c.rrepr, ta(c, t)) != 0; }
    false
}

// The rules an `extern "C" struct` meets (`foreign_struct`): the C ABI, no type parameters, and
// fields of `Int`, `Bool`, an opaque handle or another C-layout record.
fn foreign_struct(c: Ck, r: Int, id: Int) -> Int {
    let fs = unwrap(c, r, "foreign");
    let abi = fname_of(c, fs, "abi");
    if abi != "C" {
        err(c, "N0380", fld(c, fs, "abi_span"), cat3("`\"", abi, "\"` is not an ABI this compiler lays out"), "the one foreign ABI is `\"C\"`");
    }
    let tps = kids(c, r, "type_params");
    if ints_len(tps) > 0 {
        dg_error(c.d, "N0384", sps(c, fld(c, ints_get(tps, 0), "span")), spe(c, fld(c, ints_get(tps, ints_len(tps) - 1), "span")),
                "a C struct cannot be generic", "", "C has one layout per struct; declare one per type");
    }
    let mut i = 0;
    while i < ints_get(c.rfc, id) {
        let f = ints_get(c.rff, id) + i;
        if c_layout_type(c, ints_get(c.fty, f)) == false {
            dg_error(c.d, "N0381", ints_get(c.fts, f), ints_get(c.fte, f), cat3("a C struct cannot have a field of this type (`", strs_get(c.fname, f), "`)"),
                    "no C layout",
                    "a C struct's fields are `Int` (`int64_t`), `Bool` (`bool`), an opaque handle (a pointer) or another C struct; a `Str`, a sequence, an enum or an ordinary record has no layout C shares");
        }
        i = i + 1;
    }
    0
}

// `N0611`: an opaque handle built or taken apart.
fn opaque_refused(c: Ck, s: Int, e: Int, ty: Str, what: Str) -> Int {
    dg_error(c.d, "N0611", s, e, cat5("`", ty, "` is an opaque C handle, which cannot be ", what, ""), "",
            "a handle declared `extern \"C\" struct Name;` is a C pointer Nazm never reads: only a foreign function returns one, and only C reads what it points to")
}

// The C symbols the native runtime and the platform entry declare themselves
// (`RESERVED_C_SYMBOLS`).
fn reserved_c_symbols() -> Strs {
    let a = cat5("exit,fclose,fopen,fread,free,fseek,ftell,fwrite,getenv,main,malloc,memcmp,memcpy,printf,pthread_cond_broadcast,pthread_cond_destroy,",
            "getrlimit,pthread_attr_init,pthread_attr_setstacksize,pthread_attr_destroy,pthread_cond_init,pthread_cond_wait,pthread_cond_timedwait,clock_gettime,",
            "atoll,getpagesize,posix_memalign,mprotect,memset,strtod,strtof,memmove,atan2,atan2f,cos,cosf,exp,expf,fmax,fmaxf,fmin,fminf,fmod,fmodf,log,log10,log10f,log2,log2f,logf,pow,powf,round,roundf,sin,sinf,tan,tanf,nz_ctx_switch,nz_ctx_prepare,nz_task_main,",
            "nz_errno_location,__error,__errno_location,pthread_create,pthread_join,pthread_mutex_destroy,pthread_mutex_init,pthread_mutex_lock,pthread_mutex_unlock,realloc,snprintf,strlen,write,",
            "read,close,lseek,fsync,rmdir,unlink,rename,dirfd,closedir,open,mkdir,stat,opendir,readdir,strerror_r,__xpg_strerror_r,nz_os_open,nz_os_mkdir,nz_os_stat,nz_os_opendir,nz_os_readdir,nz_os_family,nz_os_error_text,");
    let b = cat5("bind,listen,accept,recvfrom,getsockname,getpeername,shutdown,inet_pton,inet_ntop,fcntl,socket,setsockopt,getsockopt,connect,send,sendto,getaddrinfo,freeaddrinfo,kqueue,kevent,epoll_create1,epoll_ctl,epoll_wait,",
            "nz_tls_config,nz_tls_config_free,nz_tls_session,nz_tls_handshake,nz_tls_push,nz_tls_pull,nz_tls_read,nz_tls_write,nz_tls_close,nz_tls_info,nz_net_fill,nz_net_format,nz_net_prepare,nz_net_open,nz_net_connect,nz_net_error,nz_net_send,nz_net_sendto,nz_net_eagain,nz_net_etimedout,nz_net_resolve,nz_net_poller,nz_net_arm,nz_net_poll,",
            "pipe,posix_spawnp,posix_spawn_file_actions_init,posix_spawn_file_actions_adddup2,posix_spawn_file_actions_destroy,waitpid,kill,signal,environ,_NSGetEnviron,nz_os_environ,getentropy,",
            "nz_os_page_size,nz_os_stack_alloc,nz_os_stack_free,nz_os_stack_size,nz_os_clock,nz_os_close,nz_os_read,nz_os_write,nz_os_lseek,nz_os_fsync,nz_os_unlink,nz_os_rmdir,nz_os_rename,nz_os_dirfd,nz_os_closedir,nz_os_entropy,nz_os_spawn,nz_os_reap,nz_os_terminate,nz_os_key,nz_os_args,",
            "nz_net_read,nz_net_write,nz_net_bind,nz_net_listen,nz_net_accept,nz_net_recvfrom,nz_net_shutdown,nz_net_name,");
    let d = cat4("nz_os_spawn_in,nz_os_child_id,nz_os_pid,nz_os_signal_group,nz_os_nap,nz_os_lstat,nz_os_chmod,nz_os_realpath,nz_os_flock,",
            "posix_spawn_file_actions_addopen,posix_spawn_file_actions_addchdir_np,posix_spawnattr_init,posix_spawnattr_setflags,posix_spawnattr_setpgroup,posix_spawnattr_destroy,",
            "wait4,getpid,nanosleep,lstat,chmod,realpath,flock", "");
    split(cat3(a, b, d), 44)
}

// A string as Rust's `escape_debug` writes it, for the ASCII it can hold.
fn debug_escape(s: Str) -> Str {
    let slash = str_from_byte(92);
    let out = strs_new();
    let mut i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        let mut esc = "";
        if b == 92 { esc = slash; }
        if b == 34 { esc = "\""; }
        if b == 39 { esc = "'"; }
        if b == 10 { esc = "n"; }
        if b == 9 { esc = "t"; }
        if b == 13 { esc = "r"; }
        if b == 0 { esc = "0"; }
        if esc == "" && (b < 32 || b == 127) { esc = cat3("u{", hex_of(b), "}"); }
        if esc == "" { strs_push(out, str_slice(s, i, i + 1)); } else { strs_push(out, str_concat(slash, esc)); }
        i = i + 1;
    }
    str_join(out, "")
}

fn hex_of(n: Int) -> Str {
    let digits = "0123456789abcdef";
    let low = n - n / 16 * 16;
    if n < 16 { return str_slice(digits, n, n + 1); }
    str_concat(hex_of(n / 16), str_slice(digits, low, low + 1))
}

// The ABI and the symbol of a foreign declaration or an export (`c_abi_and_symbol`).
fn c_abi_and_symbol(c: Ck, d: Int) -> Int {
    let abi = fname_of(c, d, "abi");
    if abi != "C" {
        err(c, "N0380", fld(c, d, "abi_span"), cat3("`\"", abi, "\"` is not an ABI this compiler calls"),
                "the one foreign ABI is `\"C\"`: the C calling convention of the target");
    }
    let sym = fname_of(c, d, "symbol");
    let mut ok = str_len(sym) > 0 && str_len(sym) <= 255;
    let mut i = 0;
    while i < str_len(sym) {
        let b = str_byte(sym, i);
        let letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
        let digit = b >= 48 && b <= 57;
        if letter == false && (digit == false || i == 0) { ok = false; }
        i = i + 1;
    }
    if ok == false {
        err(c, "N0382", fld(c, d, "symbol_span"), cat3("`\"", debug_escape(sym), "\"` is not a C symbol"),
                "a foreign symbol is a C identifier: ASCII letters, digits and `_`, not starting with a digit, at most 255 bytes");
    }
    if strs_find(reserved_c_symbols(), sym) >= 0 {
        err(c, "N0383", fld(c, d, "symbol_span"), cat3("`", sym, "` is a symbol the native runtime already declares"),
                "the runtime and the platform entry call these themselves with their own signatures; a foreign declaration of one could disagree with it");
    }
    0
}

// Whether a foreign function may take, and return, a value of a type (`foreign_param`,
// `foreign_result`).
fn foreign_param_ok(c: Ck, t: Int) -> Bool {
    if t == t_int() || t == t_bool() || t == t_str() { return true; }
    if t >= 0 && is_record(c, t) { return ints_get(c.rrepr, ta(c, t)) != 0; }
    if t >= 0 && is_fn(c, t) {
        // A C function pointer (N85): an export's C entry, its parameters and result scalars.
        let ps = fn_params(c, t);
        let mut i = 0;
        while i < ints_len(ps) {
            let p = ints_get(ps, i);
            if p != t_int() && p != t_bool() { return false; }
            i = i + 1;
        }
        let r = fn_ret(c, t);
        return r == t_int() || r == t_bool();
    }
    false
}
fn foreign_result_ok(c: Ck, t: Int) -> Bool {
    if t == t_int() || t == t_bool() || t == t_str() { return true; }
    if t < 0 { return false; }
    if is_record(c, t) { return is_opaque(c, t); }
    if prelude_enum(c, t, "Option") && targc(c, t) == 1 {
        let inner = targ(c, t, 0);
        return inner == t_str() || is_opaque(c, inner);
    }
    false
}

fn foreign_type(c: Ck, span: Int, what: Str) -> Int {
    dg_error(c.d, "N0381", sps(c, span), spe(c, span), cat3("a foreign function cannot ", what, " this type"), "not FFI-safe",
            "an argument is `Int`, `Bool`, a `Str` (borrowed), an opaque handle, an `extern \"C\" struct` (by borrowed pointer) or an export's function type; a result is `Int`, `Bool`, a handle or a `Str` (copied), or an `Option` of either when C may return null. An ordinary record or enum has no C layout, and a capability is never a word C can forge")
}

// The rules a foreign declaration meets (`check_foreign`).
fn check_foreign(c: Ck, f: Int, d: Int, pf: Int, ret: Int) -> Int {
    c_abi_and_symbol(c, d);
    let tps = kids(c, f, "type_params");
    if ints_len(tps) > 0 {
        dg_error(c.d, "N0384", sps(c, fld(c, ints_get(tps, 0), "span")), spe(c, fld(c, ints_get(tps, ints_len(tps) - 1), "span")),
                "a foreign function cannot be generic", "", "a C function has one signature; declare one per type");
    }
    if some(c, f, "effects") {
        err(c, "N0384", fld(c, unwrap(c, f, "effects"), "span"), "a foreign function's effects are not written",
                "calling one is always the effect `foreign`, which needs a `ForeignCap`");
    }
    let params = kids(c, f, "params");
    let mut k = 0;
    while k < ints_len(params) {
        if foreign_param_ok(c, ints_get(c.ptys, pf + k)) == false { foreign_type(c, fld(c, fld(c, ints_get(params, k), "ty"), "span"), "take"); }
        k = k + 1;
    }
    if foreign_result_ok(c, ret) == false { foreign_type(c, fld(c, fld(c, f, "return_type"), "span"), "return"); }
    0
}

// The rules an export meets (`check_export`): the ABI and symbol rules, `pub`, `! {}`, not
// generic, and only `Bool` and numbers of at most 64 bits across.
fn export_scalar(c: Ck, t: Int) -> Bool {
    if t == t_int() || t == t_bool() { return true; }
    if t >= 0 && is_num(c, t) { return kind_bits(k_num(bname_of(c, t))) <= 64; }
    false
}
fn export_shape(c: Ck, s: Int, e: Int, message: Str) -> Int {
    dg_error(c.d, "N0391", s, e, message, "",
            "an export is called by C, which can hand Nazm no capability and has no cleanup Nazm knows of: it is `pub`, declares `! {}`, is not generic, and takes and returns only numbers and `Bool`")
}
fn check_export(c: Ck, f: Int, d: Int, pf: Int, ret: Int) -> Int {
    c_abi_and_symbol(c, d);
    let who = cat3("`", fname_of(c, f, "name"), "` is exported to C, so it ");
    let ns = fld(c, f, "name_span");
    if some(c, f, "pub_span") == false { export_shape(c, sps(c, ns), spe(c, ns), str_concat(who, "is `pub`")); }
    let rts = fld(c, fld(c, f, "return_type"), "span");
    if some(c, f, "effects") {
        let e = unwrap(c, f, "effects");
        if ints_len(kids(c, e, "names")) > 0 { export_shape(c, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), str_concat(who, "performs no effect")); }
    } else {
        export_shape(c, sps(c, rts), spe(c, rts), str_concat(who, "declares `! {}`"));
    }
    let tps = kids(c, f, "type_params");
    if ints_len(tps) > 0 {
        export_shape(c, sps(c, fld(c, ints_get(tps, 0), "span")), spe(c, fld(c, ints_get(tps, ints_len(tps) - 1), "span")), str_concat(who, "cannot be generic"));
    }
    let params = kids(c, f, "params");
    let mut k = 0;
    while k < ints_len(params) {
        if export_scalar(c, ints_get(c.ptys, pf + k)) == false {
            let ts = fld(c, fld(c, ints_get(params, k), "ty"), "span");
            export_shape(c, sps(c, ts), spe(c, ts), str_concat(who, "cannot take this type"));
        }
        k = k + 1;
    }
    if export_scalar(c, ret) == false { export_shape(c, sps(c, rts), spe(c, rts), str_concat(who, "cannot return this type")); }
    0
}

// --- stage 0c: layouts --------------------------------------------------------------------------

// A record or enum that contains itself, inline or through a `Vec`, is refused by
// `validate_type_layouts`; this checker does not carry that refusal yet, so it stops at any cycle
// through the module's definitions.
// --- arrays (Gate 2; `check/layout.rs`, `UserTypes::array_problem`) ----------------------------

// The most an array may hold, in `data_bytes`: 64 KiB (`MAX_ARRAY_BYTES`).
fn max_array_bytes() -> Int { 65536 }

// An array's length, written as an integer literal or an `Int` constant's name (`array_length`):
// the length, or -1 where it is refused (into `d`).
fn array_length(c: Ck, e: Int, d: Diags) -> Int {
    let mut known = false;
    let mut n = 0;
    if sx_kind(c.t, e) != tk_tuple() {
        let k = kind_of(c, e);
        if k == "Int" {
            known = true;
            n = parse_int(sx_text(c.t, fld(c, e, "value")));
        }
        // A static is storage, not a length (Gate 3).
        if k == "Var" {
            let name = fname_of(c, e, "name");
            note_const_ref(c, gs(c, s_module()), name, fld(c, e, "span"));
            if static_named(c, name) < 0 {
                let ev = evaluate_consts(c, gs(c, s_module()), dg_new(), false);
                let at = strs_find(ev.names, name);
                if at >= 0 {
                    if ints_get(ev.kinds, at) == k_int() {
                        known = true;
                        n = ints_get(ev.ints, at);
                    }
                }
            }
        }
    }
    let span = espan(c, e);
    if known == false {
        dg_error(d, "N0622", sps(c, span), spe(c, span), "an array's length is an integer literal or an `Int` constant's name", "",
                "declare one at the top of the module: `const SIZE: Int = 64;`");
        return 0 - 1;
    }
    if n <= 0 || n > 4294967295 {
        dg_error(d, "N0618", sps(c, span), spe(c, span), str_concat("an array has 1 to 4294967295 elements, and this is ", int_to_str(n)), "", "");
        return 0 - 1;
    }
    n
}

// The first component of `t` that is not a value, or -1 (`not_value`): numbers, `Bool`, strings
// where `strings` is set, and records, enums and arrays of them.
fn not_value(c: Ck, t: Int, strings: Bool) -> Int {
    let seen = ints_new();
    let work = ints_new();
    ints_push(work, strip_array(c, t));
    while ints_len(work) > 0 {
        let ty = ints_pop(work);
        if index_of(seen, ty) < 0 {
            ints_push(seen, ty);
            let n = bname_of(c, ty);
            let plain = n == "Int" || n == "Bool" || is_num_name(n) || (strings && (n == "Str" || n == "Text"));
            if plain == false {
                if is_opaque(c, ty) { return ty; }
                if is_record(c, ty) || is_enum(c, ty) {
                    let edges = contained(c, ty);
                    let mut k = 0;
                    while k < ints_len(edges) {
                        ints_push(work, strip_array(c, field_ty_in(c, ty, ints_get(edges, k))));
                        k = k + 1;
                    }
                } else {
                    return ty;
                }
            }
        }
    }
    0 - 1
}

fn sat_mul(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 { return 0; }
    let most = 9223372036854775807;
    if a > most / b { return most; }
    a * b
}

// The bytes a plain value of `t` holds, without padding (`data_bytes`).
fn data_bytes(c: Ck, t: Int, depth: Int) -> Int {
    if depth > max_depth() * 4 { return 0; }
    let n = bname_of(c, t);
    if n == "Int" { return 8; }
    if n == "Bool" { return 1; }
    if n == "Int8" || n == "UInt8" { return 1; }
    if n == "Int16" || n == "UInt16" { return 2; }
    if n == "Int32" || n == "UInt32" || n == "Float32" { return 4; }
    if n == "UInt64" || n == "Float64" { return 8; }
    if n == "Int128" || n == "UInt128" { return 16; }
    if n == "Str" || n == "Text" { return 24; }
    if is_array(c, t) { return sat_mul(data_bytes(c, array_elem(c, t), depth + 1), ta(c, t)); }
    if is_record(c, t) {
        let mut sum = 0;
        let r = ta(c, t);
        let mut i = 0;
        while i < ints_get(c.rfc, r) {
            sum = sum + data_bytes(c, field_ty_in(c, t, ints_get(c.rff, r) + i), depth + 1);
            i = i + 1;
        }
        return sum;
    }
    if is_enum(c, t) {
        let e = ta(c, t);
        let mut most = 0;
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let vi = ints_get(c.evf, e) + v;
            let mut sum = 0;
            let mut i = 0;
            while i < ints_get(c.vfc, vi) {
                sum = sum + data_bytes(c, field_ty_in(c, t, ints_get(c.vff, vi) + i), depth + 1);
                i = i + 1;
            }
            if sum > most { most = sum; }
            v = v + 1;
        }
        return 8 + most;
    }
    8
}

// Why an array type is refused, reported at `s..e` into `d` (`array_refusal`); 1 when it was.
fn array_refusal(c: Ck, t: Int, s: Int, e: Int, d: Diags) -> Int {
    if is_array(c, t) == false { return 0; }
    let elem = array_elem(c, t);
    let len = ta(c, t);
    if len == 0 {
        dg_error(d, "N0618", s, e, "an array has at least one element", "", "");
        return 1;
    }
    let owner = not_value(c, elem, true);
    if owner >= 0 {
        let mut message = cat3("an array holds values, and `", show(c, elem), "` is a handle");
        if owner != elem { message = cat5("an array holds values, and `", show(c, elem), "` holds a `", show(c, owner), "`"); }
        dg_error(d, "N0621", s, e, message, "",
                "an array's elements are numbers, `Bool`s, strings, and records, enums and arrays of them — values, copied with the strings they hold; a collection of handles is a `Vec`");
        return 1;
    }
    let bytes = sat_mul(data_bytes(c, elem, 0), len);
    if bytes > max_array_bytes() {
        if bytes == 9223372036854775807 {
            stop(c, "an array too large to count");
            return 1;
        }
        dg_error(d, "N0618", s, e, cat5("`", show(c, t), "` holds ", int_to_str(bytes), " bytes, and an array holds at most 65536"), "",
                "an array lives inline, on a task's stack; a larger buffer is a `Vec`");
        return 1;
    }
    0
}

// Hold every array type written since the last stage to the rules (`validate_new_arrays`).
fn validate_new_arrays(c: Ck) -> Int {
    let mut i = gs(c, s_arrays());
    while i < ints_len(c.awty) {
        array_refusal(c, ints_get(c.awty, i), ints_get(c.aws, i), ints_get(c.awe, i), c.d);
        i = i + 1;
    }
    ss(c, s_arrays(), ints_len(c.awty));
    0
}

fn validate_layouts(c: Ck) -> Int {
    // Every array written in a field (Gate 2), once every definition it might contain is known.
    validate_new_arrays(c);
    let g = own_graph(c);
    let reported = ints_new();
    let cycles = Cyc(through: ints_new(), tf: ints_new(), tc: ints_new(), hops: ints_new(), hf: ints_new(), hc: ints_new(), inline: ints_new());
    let n = own_nodes(c);
    // The impossible layouts first, over inline edges only; then the cycles through a counted
    // handle, staying out of what the first reported (`ownership_cycles`).
    let mut i = 0;
    while i < n {
        if index_of(reported, i) < 0 {
            if find_cycle(c, g, i, reported, cycles) { add_reported(cycles, reported); }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        if index_of(reported, i) < 0 {
            if find_counted_cycle(c, g, i, reported, cycles) { add_reported(cycles, reported); }
        }
        i = i + 1;
    }
    let mut k = 0;
    while k < ints_len(cycles.tf) {
        report_cycle(c, cycles, k);
        k = k + 1;
    }
    // Depth is only meaningful once there is no cycle to walk forever, and it is asked of
    // declarations.
    i = 0;
    while i < n {
        if index_of(reported, i) < 0 && type_depth(c, own_node_ty(c, i)) < 0 {
            dg_error(c.d, "N0338", own_node_span_s(c, i), own_node_span_e(c, i), "user-defined types may nest 32 deep", "",
                    "each level multiplies the copy and cleanup code generated for every value of the outer type, so the bound is on the emitted program rather than on the compiler. It is stated rather than discovered");
        }
        i = i + 1;
    }
    0
}

// --- the ownership graph of the definitions (`UserTypes::ownership_cycles`) -----------------------
//
// A definition is a node: records in id order, then enums. Each field of each definition gives
// edges to the definitions its type owns, each one inline, counted (through a `Vec`, a `Cell` or a
// channel) or immutable (through a `Box` or a `Chain`); a generic definition owns what its
// parameters are applied to as its fields use them (`parameter_uses`).

fn r_inline() -> Int { 1 }
fn r_counted() -> Int { 2 }
fn r_immutable() -> Int { 4 }

pub struct Og {
    // Each parameter's uses, at `uoff` of its definition.
    uoff: Ints,
    uses: Ints,
    // Edges, by node (`eoff`, `ecnt`): the node reached, its reach, and the field it leaves by.
    eoff: Ints,
    ecnt: Ints,
    eto: Ints,
    ereach: Ints,
    efield: Ints,
}

// The cycles found: each a run of `through` (nodes, the first again at the end) and a run of
// `hops` (the fields), and whether it is inline.
pub struct Cyc {
    through: Ints,
    tf: Ints,
    tc: Ints,
    hops: Ints,
    hf: Ints,
    hc: Ints,
    inline: Ints,
}

fn own_nodes(c: Ck) -> Int { strs_len(c.rname) + strs_len(c.ename) }
fn own_node_ty(c: Ck, n: Int) -> Int {
    if n < strs_len(c.rname) { return record_ty(c, n, ints_new()); }
    enum_ty(c, n - strs_len(c.rname), ints_new())
}
fn own_node_of(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ta(c, t); }
    if is_enum(c, t) { return strs_len(c.rname) + ta(c, t); }
    0 - 1
}
fn own_params(c: Ck, n: Int) -> Int {
    if n < strs_len(c.rname) { return ints_get(c.rnp, n); }
    ints_get(c.enp, n - strs_len(c.rname))
}
fn own_node_span_s(c: Ck, n: Int) -> Int {
    if n < strs_len(c.rname) { return ints_get(c.rns, n); }
    ints_get(c.ens, n - strs_len(c.rname))
}
fn own_node_span_e(c: Ck, n: Int) -> Int {
    if n < strs_len(c.rname) { return ints_get(c.rne, n); }
    ints_get(c.ene, n - strs_len(c.rname))
}

// One path kind followed by another (`then`).
fn r_then(a: Int, b: Int) -> Int {
    if a == r_counted() || b == r_counted() { return r_counted(); }
    if a == r_immutable() || b == r_immutable() { return r_immutable(); }
    r_inline()
}

// How a use through `outer` composes with a use of kind `inner` (`compose`).
fn r_compose(outer: Int, inner: Int) -> Int {
    let mut out = 0;
    let mut i = 0;
    while i < 3 {
        let mut k = 0;
        while k < 3 {
            if has_bit(outer, i) && has_bit(inner, k) { out = eff_union(out, r_then(pow2(i), pow2(k))); }
            k = k + 1;
        }
        i = i + 1;
    }
    out
}

fn own_use(c: Ck, g: Og, n: Int, k: Int) -> Int {
    if n < 0 || k >= own_params(c, n) { return 0; }
    ints_get(g.uses, ints_get(g.uoff, n) + k)
}

// Whether `t` is parameter `index` of node `n`'s definition.
fn is_own_param(c: Ck, t: Int, n: Int, index: Int) -> Bool {
    if tag(c, t) != tag_param() || ints_get(c.tyc, t) != index { return false; }
    if n < strs_len(c.rname) { return ta(c, t) == own_record() && ints_get(c.tyb, t) == n; }
    ta(c, t) == own_enum() && ints_get(c.tyb, t) == n - strs_len(c.rname)
}

// How `t` reaches a value of node `n`'s parameter `index` (`reaches_param`).
fn reaches_param(c: Ck, g: Og, t: Int, n: Int, index: Int) -> Int {
    let tg = tag(c, t);
    if tg == tag_param() {
        if is_own_param(c, t, n, index) { return r_inline(); }
        return 0;
    }
    if tg == tag_vec() || tg == tag_cell() { return r_compose(r_counted(), reaches_param(c, g, targ(c, t, 0), n, index)); }
    if tg == tag_box() || tg == tag_chain() { return r_compose(r_immutable(), reaches_param(c, g, targ(c, t, 0), n, index)); }
    if tg == tag_chan() {
        if reaches_param(c, g, targ(c, t, 0), n, index) != 0 { return r_counted(); }
        return 0;
    }
    if tg == tag_record() || tg == tag_enum() {
        let template = own_node_of(c, t);
        let mut out = 0;
        let mut k = 0;
        while k < targc(c, t) {
            let inner = reaches_param(c, g, targ(c, t, k), n, index);
            if inner != 0 { out = eff_union(out, r_compose(own_use(c, g, template, k), inner)); }
            k = k + 1;
        }
        return out;
    }
    0
}

// A definition's fields, by their indices in the pool (`contained`).
fn own_fields(c: Ck, n: Int) -> Ints { contained(c, own_node_ty(c, n)) }

// Every definition a type owns, and how (`owned_by`), as edges leaving by field `f`.
fn owned_by(c: Ck, g: Og, t: Int, reach: Int, f: Int) -> Int {
    let tg = tag(c, t);
    if tg == tag_vec() || tg == tag_cell() || tg == tag_chan() { return owned_by(c, g, targ(c, t, 0), r_counted(), f); }
    if tg == tag_box() || tg == tag_chain() { return owned_by(c, g, targ(c, t, 0), r_then(reach, r_immutable()), f); }
    if tg == tag_record() || tg == tag_enum() {
        let to = own_node_of(c, t);
        ints_push(g.eto, to);
        ints_push(g.ereach, reach);
        ints_push(g.efield, f);
        let mut k = 0;
        while k < targc(c, t) {
            let through = r_compose(own_use(c, g, to, k), reach);
            let mut b = 0;
            while b < 3 {
                if has_bit(through, b) { owned_by(c, g, targ(c, t, k), pow2(b), f); }
                b = b + 1;
            }
            k = k + 1;
        }
    }
    0
}

fn own_graph(c: Ck) -> Og {
    let g = Og(uoff: ints_new(), uses: ints_new(), eoff: ints_new(), ecnt: ints_new(), eto: ints_new(), ereach: ints_new(), efield: ints_new());
    let n = own_nodes(c);
    let mut i = 0;
    while i < n {
        ints_push(g.uoff, ints_len(g.uses));
        let mut k = 0;
        while k < own_params(c, i) {
            ints_push(g.uses, 0);
            k = k + 1;
        }
        i = i + 1;
    }
    // How each generic definition uses each of its parameters, to a fixed point.
    let mut changed = true;
    while changed {
        changed = false;
        i = 0;
        while i < n {
            let fields = own_fields(c, i);
            let mut k = 0;
            while k < own_params(c, i) {
                let mut used = 0;
                let mut f = 0;
                while f < ints_len(fields) {
                    used = eff_union(used, reaches_param(c, g, strip_array(c, ints_get(c.fty, ints_get(fields, f))), i, k));
                    f = f + 1;
                }
                let at = ints_get(g.uoff, i) + k;
                if eff_union(ints_get(g.uses, at), used) != ints_get(g.uses, at) {
                    ints_set(g.uses, at, eff_union(ints_get(g.uses, at), used));
                    changed = true;
                }
                k = k + 1;
            }
            i = i + 1;
        }
    }
    i = 0;
    while i < n {
        ints_push(g.eoff, ints_len(g.eto));
        let fields = own_fields(c, i);
        let mut f = 0;
        while f < ints_len(fields) {
            let fi = ints_get(fields, f);
            owned_by(c, g, strip_array(c, ints_get(c.fty, fi)), r_inline(), fi);
            f = f + 1;
        }
        ints_push(g.ecnt, ints_len(g.eto) - ints_get(g.eoff, i));
        i = i + 1;
    }
    g
}

fn add_reported(cy: Cyc, reported: Ints) -> Int {
    let last = ints_len(cy.tf) - 1;
    let mut i = 0;
    while i < ints_get(cy.tc, last) {
        ints_push(reported, ints_get(cy.through, ints_get(cy.tf, last) + i));
        i = i + 1;
    }
    0
}

// Close a cycle found: the path's nodes from `from` on, each hop the field its frame was entered
// by, then the closing edge's field and node.
fn close_cycle(g: Og, cy: Cyc, sn: Ints, sin: Ints, from: Int, edge: Int, to: Int, inline: Int) -> Bool {
    ints_push(cy.tf, ints_len(cy.through));
    ints_push(cy.hf, ints_len(cy.hops));
    let mut i = from;
    while i < ints_len(sn) {
        ints_push(cy.through, ints_get(sn, i));
        if i > from { ints_push(cy.hops, ints_get(g.efield, ints_get(sin, i))); }
        i = i + 1;
    }
    ints_push(cy.hops, ints_get(g.efield, edge));
    ints_push(cy.through, to);
    ints_push(cy.tc, ints_len(cy.through) - ints_get(cy.tf, ints_len(cy.tf) - 1));
    ints_push(cy.hc, ints_len(cy.hops) - ints_get(cy.hf, ints_len(cy.hf) - 1));
    ints_push(cy.inline, inline);
    true
}

// A cycle reachable from `start` over inline edges, avoiding `excluded` (`find_cycle`).
fn find_cycle(c: Ck, g: Og, start: Int, excluded: Ints, cy: Cyc) -> Bool {
    let sn = ints_new();
    let sat = ints_new();
    let sin = ints_new();
    let done = ints_new();
    ints_push(sn, start);
    ints_push(sat, 0);
    ints_push(sin, 0 - 1);
    while ints_len(sn) > 0 {
        let top = ints_len(sn) - 1;
        let node = ints_get(sn, top);
        let at = ints_get(sat, top);
        if at >= ints_get(g.ecnt, node) {
            ints_push(done, node);
            ints_pop(sn);
            ints_pop(sat);
            ints_pop(sin);
        } else {
            ints_set(sat, top, at + 1);
            let edge = ints_get(g.eoff, node) + at;
            let to = ints_get(g.eto, edge);
            if ints_get(g.ereach, edge) == r_inline() && index_of(excluded, to) < 0 && index_of(done, to) < 0 {
                let from = index_of(sn, to);
                if from >= 0 { return close_cycle(g, cy, sn, sin, from, edge, to, 1); }
                ints_push(sn, to);
                ints_push(sat, 0);
                ints_push(sin, edge);
            }
        }
    }
    false
}

// A cycle through `start` with a counted edge on it, closed over edges of any kind and avoiding
// `excluded` (`find_counted_cycle`): over (definition, whether the path has a counted edge).
fn find_counted_cycle(c: Ck, g: Og, start: Int, excluded: Ints, cy: Cyc) -> Bool {
    let sn = ints_new();
    let scounted = ints_new();
    let sat = ints_new();
    let sin = ints_new();
    let seen = ints_new();
    ints_push(sn, start);
    ints_push(scounted, 0);
    ints_push(sat, 0);
    ints_push(sin, 0 - 1);
    ints_push(seen, start * 2);
    while ints_len(sn) > 0 {
        let top = ints_len(sn) - 1;
        let node = ints_get(sn, top);
        let at = ints_get(sat, top);
        if at >= ints_get(g.ecnt, node) {
            ints_pop(sn);
            ints_pop(scounted);
            ints_pop(sat);
            ints_pop(sin);
        } else {
            ints_set(sat, top, at + 1);
            let edge = ints_get(g.eoff, node) + at;
            let to = ints_get(g.eto, edge);
            if index_of(excluded, to) < 0 {
                let mut counted = ints_get(scounted, top);
                if ints_get(g.ereach, edge) == r_counted() { counted = 1; }
                if to == start {
                    if counted == 1 { return close_cycle(g, cy, sn, sin, 0, edge, start, 0); }
                } else {
                    if index_of(seen, to * 2 + counted) < 0 {
                        ints_push(seen, to * 2 + counted);
                        ints_push(sn, to);
                        ints_push(scounted, counted);
                        ints_push(sat, 0);
                        ints_push(sin, edge);
                    }
                }
            }
        }
    }
    false
}

// One hop of an ownership path as a reader finds it (`hop_name`): `Node.children`, or
// `Tree.Branch.kids` for a payload field.
fn hop_name(c: Ck, f: Int) -> Str {
    let mut i = 0;
    while i < strs_len(c.rname) {
        let r0 = ints_get(c.rff, i);
        if f >= r0 && f < r0 + ints_get(c.rfc, i) { return cat3(strs_get(c.rname, i), ".", strs_get(c.fname, f)); }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(c.ename) {
        let mut v = 0;
        while v < ints_get(c.evc, i) {
            let vi = ints_get(c.evf, i) + v;
            if f >= ints_get(c.vff, vi) && f < ints_get(c.vff, vi) + ints_get(c.vfc, vi) {
                return cat5(strs_get(c.ename, i), ".", strs_get(c.vname, vi), ".", strs_get(c.fname, f));
            }
            v = v + 1;
        }
        i = i + 1;
    }
    ""
}

fn report_cycle(c: Ck, cy: Cyc, k: Int) -> Int {
    let tf = ints_get(cy.tf, k);
    let tc = ints_get(cy.tc, k);
    let first = ints_get(cy.through, tf);
    let start = show(c, own_node_ty(c, first));
    let names = strs_new();
    let mut i = 0;
    while i < tc {
        strs_push(names, show(c, own_node_ty(c, ints_get(cy.through, tf + i))));
        i = i + 1;
    }
    let s = own_node_span_s(c, first);
    let e = own_node_span_e(c, first);
    if ints_get(cy.inline, k) == 1 {
        let mut message = cat3("`", start, "` contains itself");
        if tc != 2 { message = cat4("`", start, "` contains itself through ", str_join(names, " → ")); }
        dg_error(c.d, "N0336", s, e, message, "",
                "a record holds its fields by value and an enum holds its active payload by value, so this one would have no finite size. This is an impossible layout rather than a safety problem: a later type that holds its contents somewhere else would make the same shape expressible");
    } else {
        let path = strs_new();
        i = 0;
        while i < ints_get(cy.hc, k) {
            strs_push(path, hop_name(c, ints_get(cy.hops, ints_get(cy.hf, k) + i)));
            i = i + 1;
        }
        strs_push(path, start);
        dg_error(c.d, "N0359", s, e, cat4("`", start, "` can own itself through a `Vec`: ", str_join(path, " → ")), "",
                "a `Vec` holds its elements through a reference-counted handle, so this layout is finite — but a value of it could hold a `Vec` containing itself, and no count would ever reach zero. Nazm refuses such an ownership cycle rather than leak it. Store the children somewhere that does not own them: an index into a `Vec` owned outside the type");
    }
    let hc = ints_get(cy.hc, k);
    if hc > 0 {
        let closing = ints_get(cy.hops, ints_get(cy.hf, k) + hc - 1);
        sec_at(c, ints_get(c.fns, closing), ints_get(c.fne, closing), "this field closes the cycle");
    }
    0
}

// How deep a type nests definitions inline (`depth`): -1 past 32.
fn type_depth(c: Ck, t: Int) -> Int {
    if is_record(c, t) == false && is_enum(c, t) == false { return 0; }
    let memo_t = ints_new();
    let memo_d = ints_new();
    let st = ints_new();
    let sx = ints_new();
    ints_push(st, t);
    ints_push(sx, 0);
    while ints_len(st) > 0 {
        let node = ints_pop(st);
        let expanded = ints_pop(sx);
        if index_of(memo_t, node) < 0 {
            let inner = ints_new();
            let edges = contained(c, node);
            let mut i = 0;
            while i < ints_len(edges) {
                let ty = strip_array(c, field_ty_in(c, node, ints_get(edges, i)));
                if is_record(c, ty) || is_enum(c, ty) { ints_push(inner, ty); }
                i = i + 1;
            }
            if expanded == 1 {
                let mut most = 0;
                i = 0;
                while i < ints_len(inner) {
                    let at = index_of(memo_t, ints_get(inner, i));
                    if at >= 0 && ints_get(memo_d, at) > most { most = ints_get(memo_d, at); }
                    i = i + 1;
                }
                if most + 1 > max_depth() { return 0 - 1; }
                ints_push(memo_t, node);
                ints_push(memo_d, most + 1);
            } else {
                ints_push(st, node);
                ints_push(sx, 1);
                i = 0;
                while i < ints_len(inner) {
                    if index_of(memo_t, ints_get(inner, i)) < 0 {
                        ints_push(st, ints_get(inner, i));
                        ints_push(sx, 0);
                    }
                    i = i + 1;
                }
            }
        }
    }
    let at = index_of(memo_t, t);
    if at < 0 { return 0; }
    ints_get(memo_d, at)
}

// --- traits and impls (N78, `check/traits.rs`) -------------------------------------------------

// Every trait's method signatures, `Self` the trait's own parameter (`declare_trait_methods`).
fn declare_trait_methods(c: Ck, m: Int) -> Int {
    let p = ints_get(c.mprog, m);
    let traits = kids(c, p, "traits");
    if ints_len(traits) == 0 { return 0; }
    ss(c, s_module(), m);
    type_environment(c, m, false);
    let mut i = 0;
    while i < ints_len(traits) {
        let t = ints_get(traits, i);
        let id = trait_at(c, m, sps(c, fld(c, t, "name_span")));
        if id >= 0 { trait_methods(c, t, id); }
        i = i + 1;
    }
    0
}

fn trait_at(c: Ck, m: Int, at: Int) -> Int {
    let mut i = 0;
    while i < strs_len(c.trname) {
        if ints_get(c.trmod, i) == m && ints_get(c.trns, i) == at { return i; }
        i = i + 1;
    }
    0 - 1
}

fn trait_methods(c: Ck, t: Int, id: Int) -> Int {
    let me = param_ty(c, own_trait(), id, 0, "Self");
    let pn = strs_new();
    strs_push(pn, "Self");
    let pt = ints_new();
    ints_push(pt, me);
    let tname = strs_get(c.trname, id);
    let first = strs_len(c.tmname);
    ints_set(c.trmf, id, first);
    let ms = kids(c, t, "methods");
    let mut i = 0;
    while i < ints_len(ms) {
        let f = ints_get(ms, i);
        let name = fname_of(c, f, "name");
        let ns = fld(c, f, "name_span");
        let mut dup = 0 - 1;
        let mut k = first;
        while k < strs_len(c.tmname) {
            if strs_get(c.tmname, k) == name && dup < 0 { dup = k; }
            k = k + 1;
        }
        if dup >= 0 {
            err(c, "N0203", ns, cat5("`", name, "` is declared more than once in trait `", tname, "`"), "");
            sec_at(c, ints_get(c.tmns, dup), ints_get(c.tmne, dup), "first declared here");
        } else {
            let params = kids(c, f, "params");
            let resolved = ints_new();
            k = 0;
            while k < ints_len(params) {
                ints_push(resolved, resolve_written(c, fld(c, ints_get(params, k), "ty"), pn, pt, c.d));
                k = k + 1;
            }
            let mut self_ok = false;
            if ints_len(params) > 0 {
                if fname_of(c, ints_get(params, 0), "name") == "self" && ints_get(resolved, 0) == me { self_ok = true; }
            }
            if self_ok == false {
                let mut at = ns;
                if ints_len(params) > 0 { at = fld(c, ints_get(params, 0), "span"); }
                err(c, "N0609", at, cat3("`", name, "`'s first parameter must be `self: Self`"),
                        "a trait method is called on a value of the implementing type, which it receives first: `fn show(self: Self) -> Str;`");
            } else {
                let ret = resolve_written(c, fld(c, f, "return_type"), pn, pt, c.d);
                let mut eff = 0;
                if some(c, f, "effects") {
                    eff = declared_effects(c, unwrap(c, f, "effects"));
                    if eff < 0 { eff = 0; }
                }
                strs_push(c.tmname, name);
                ints_push(c.tmns, sps(c, ns));
                ints_push(c.tmne, spe(c, ns));
                ints_push(c.tmpf, ints_len(c.ptys));
                ints_push(c.tmpc, ints_len(params) - 1);
                k = 1;
                while k < ints_len(params) {
                    ints_push(c.ptys, ints_get(resolved, k));
                    k = k + 1;
                }
                ints_push(c.tmret, ret);
                ints_push(c.tmeff, eff);
                if some(c, f, "body") { ints_push(c.tmdef, 1); } else { ints_push(c.tmdef, 0); }
            }
        }
        i = i + 1;
    }
    ints_set(c.trmc, id, strs_len(c.tmname) - first);
    0
}

// A trait's method by name, as an index into the method pool; -1 when it has none.
fn trait_method(c: Ck, tr: Int, name: Str) -> Int {
    let mut k = 0;
    while k < ints_get(c.trmc, tr) {
        if strs_get(c.tmname, ints_get(c.trmf, tr) + k) == name { return ints_get(c.trmf, tr) + k; }
        k = k + 1;
    }
    0 - 1
}

// The traits module `m` may name (`trait_scope`): each direct import's exported ones, plainly
// where a plain `use` named it (-1 where two give two) and as `alias::Name`; its own win.
fn trait_scope(c: Ck, m: Int) -> Int {
    while strs_len(c.tsname) > 0 {
        strs_pop(c.tsname);
        ints_pop(c.tsid);
    }
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        let on = ints_get(c.don, d);
        let mut t = 0;
        while t < strs_len(c.trname) {
            if offers_trait(c, on, t) {
                let name = strs_get(c.trname, t);
                if ints_get(c.dimplicit, d) == 1 {
                    if strs_find(c.tsname, name) < 0 {
                        strs_push(c.tsname, name);
                        ints_push(c.tsid, t);
                    }
                } else {
                    if ints_get(c.dplain, d) == 1 {
                        let at = strs_find(c.tsname, name);
                        if at < 0 {
                            strs_push(c.tsname, name);
                            ints_push(c.tsid, t);
                        } else {
                            if ints_get(c.tsid, at) != t { ints_set(c.tsid, at, 0 - 1); }
                        }
                    }
                }
                let mut a = 0;
                while a < ints_get(c.dac, d) {
                    scope_trait(c, cat3(strs_get(c.aname, ints_get(c.daf, d) + a), "::", name), t);
                    a = a + 1;
                }
            }
            t = t + 1;
        }
        k = k + 1;
    }
    let mut t = 0;
    while t < strs_len(c.trname) {
        if ints_get(c.trmod, t) == m { scope_trait(c, strs_get(c.trname, t), t); }
        t = t + 1;
    }
    0
}

fn scope_trait(c: Ck, key: Str, t: Int) -> Int {
    let at = strs_find(c.tsname, key);
    if at < 0 {
        strs_push(c.tsname, key);
        ints_push(c.tsid, t);
    } else {
        ints_set(c.tsid, at, t);
    }
    0
}

// Whether the trait `t` is in the module's scope under any name.
fn trait_in_scope(c: Ck, t: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(c.tsid) {
        if ints_get(c.tsid, i) == t { return true; }
        i = i + 1;
    }
    false
}

// The trait a written name refers to (`named_trait`), or -1 having said why none.
fn named_trait(c: Ck, w: Int) -> Int {
    let name = fname_of(c, w, "name");
    let key = written_key(c, w, "name");
    let ns = fld(c, w, "name_span");
    let at = strs_find(c.tsname, key);
    if at >= 0 {
        let t = ints_get(c.tsid, at);
        if t >= 0 { return t; }
        err(c, "N0207", ns, cat3("`", name, "` is a trait in more than one imported module"), "import one of them under a name and write `alias::Trait`");
        return 0 - 1;
    }
    let m = gs(c, s_module());
    if declared_record(c, m, name) >= 0 || declared_enum(c, m, name) >= 0 || is_builtin_name(name) {
        err(c, "N0610", ns, cat3("`", name, "` is a type, not a trait"), "a bound or an impl names a trait: `impl Show for Point`");
        return 0 - 1;
    }
    err(c, "N0305", ns, cat3("no trait named `", name, "` is in scope"), "declare it, or import the module that exports it");
    0 - 1
}

// Why a type may not have an impl (`implementable`), or "" when it may.
fn not_implementable(c: Ck, t: Int) -> Str {
    if t == t_int() || t == t_bool() || t == t_str() || is_num(c, t) { return ""; }
    if is_record(c, t) {
        if ints_get(c.rnp, ta(c, t)) > 0 || targc(c, t) > 0 { return "a generic record"; }
        return "";
    }
    if is_enum(c, t) {
        if ints_get(c.enp, ta(c, t)) > 0 || targc(c, t) > 0 { return "a generic enum"; }
        return "";
    }
    if tag(c, t) == tag_param() { return "a type parameter"; }
    "a built-in type other than a number, `Bool` or `Str`"
}

fn type_module(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rmod, ta(c, t)); }
    if is_enum(c, t) { return ints_get(c.emod, ta(c, t)); }
    0 - 1
}

// Each impl's header (`declare_unit`): its trait and its type, before the functions.
fn impl_headers(c: Ck, m: Int) -> Int {
    while ints_len(c.hds) > 0 {
        ints_pop(c.hds);
        ints_pop(c.hde);
        ints_pop(c.htr);
        ints_pop(c.hty);
    }
    let impls = kids(c, ints_get(c.mprog, m), "impls");
    let mut i = 0;
    while i < ints_len(impls) {
        let im = ints_get(impls, i);
        let tr = named_trait(c, fld(c, im, "trait_name"));
        if tr >= 0 { sm_put(c.mtrm, sps(c, fld(c, fld(c, im, "trait_name"), "name_span")), spe(c, fld(c, fld(c, im, "trait_name"), "name_span")), tr); }
        let w = fld(c, im, "self_ty");
        let before = dg_len(c.d);
        let generic = ints_len(kids(c, im, "type_params")) > 0;
        let mut ty = 0 - 1;
        if generic { ty = generic_impl_type(c, im); } else { ty = resolve_written(c, w, strs_new(), ints_new(), c.d); }
        if dg_len(c.d) != before { ty = 0 - 1; }
        if ty >= 0 && generic == false {
            let why = not_implementable(c, ty);
            if why != "" {
                err(c, "N0604", fld(c, w, "span"), cat4("`", fname_of(c, w, "name"), "` cannot have an impl: it is ", why),
                        "an impl is for a non-generic record or enum, or for `Int`, `Bool` or `Str`");
                ty = 0 - 1;
            }
        }
        let is = fld(c, im, "impl_span");
        ints_push(c.hds, sps(c, is));
        ints_push(c.hde, spe(c, is));
        if tr >= 0 && ty >= 0 {
            ints_push(c.htr, tr);
            ints_push(c.hty, ty);
        } else {
            ints_push(c.htr, 0 - 1);
            ints_push(c.hty, 0 - 1);
        }
        i = i + 1;
    }
    0
}

// An impl of a generic type's header (`generic_impl_type`, L11b): `D[T1, …]`, a generic record or
// enum applied to exactly the impl's parameters, in order. Its definition, or -1 having said why.
fn generic_impl_type(c: Ck, im: Int) -> Int {
    let w = fld(c, im, "self_ty");
    let name = fname_of(c, w, "name");
    let template = type_named(c, written_key(c, w, "name"));
    let mut params = 0;
    if template >= 0 {
        if is_record(c, template) { params = ints_get(c.rnp, ta(c, template)); }
        if is_enum(c, template) { params = ints_get(c.enp, ta(c, template)); }
    }
    let help = "an impl with type parameters is written `impl[T: Show] Show for Pair[T]`, for a generic record or enum";
    if params == 0 {
        err(c, "N0604", fld(c, w, "span"), cat3("`", name, "` is not a generic record or enum"), help);
        return 0 - 1;
    }
    let tps = kids(c, im, "type_params");
    let mut args = ints_new();
    if some(c, w, "args") { args = sx_items(c.t, unwrap(c, w, "args")); }
    let mut exact = params == ints_len(tps) && ints_len(args) == params;
    let wanted = strs_new();
    let mut i = 0;
    while i < ints_len(tps) {
        let pn = fname_of(c, ints_get(tps, i), "name");
        strs_push(wanted, pn);
        if exact {
            let a = ints_get(args, i);
            if some(c, a, "qualifier") || some(c, a, "args") || some(c, a, "function") || fname_of(c, a, "name") != pn { exact = false; }
        }
        i = i + 1;
    }
    if exact == false {
        err(c, "N0604", fld(c, w, "span"), cat5("an impl with type parameters is for `", name, "[", str_join(wanted, ", "),
                "]`: the type applied to exactly its parameters, in order"), help);
        return 0 - 1;
    }
    template
}

// A generic definition applied to the function `id`'s first type parameters: an impl's method's
// `Self` (L11b).
fn applied_to_own(c: Ck, template: Int, id: Int) -> Int {
    let n = targc_of_def(c, template);
    let own = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(own, fn_param_ty(c, id, i));
        i = i + 1;
    }
    if is_record(c, template) { return record_ty(c, ta(c, template), own); }
    enum_ty(c, ta(c, template), own)
}

// How many type parameters a record's or an enum's definition declares.
fn targc_of_def(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ints_get(c.rnp, ta(c, t)); }
    if is_enum(c, t) { return ints_get(c.enp, ta(c, t)); }
    0
}

// The header of the impl whose `impl` keyword is at `at`, or -1.
fn header_at(c: Ck, at: Int) -> Int {
    let mut i = 0;
    while i < ints_len(c.hds) {
        if ints_get(c.hds, i) == at { return i; }
        i = i + 1;
    }
    0 - 1
}

// The function declared for a tree node, or -1.
fn fn_of_node(c: Ck, f: Int) -> Int {
    let mut i = 0;
    while i < ints_len(c.fnnode) {
        if ints_get(c.fnnode, i) == f && ints_get(c.fnclos, i) < 0 { return i; }
        i = i + 1;
    }
    0 - 1
}

// File each impl whose header resolved (`register_impl`).
fn register_impls(c: Ck, m: Int) -> Int {
    let impls = kids(c, ints_get(c.mprog, m), "impls");
    let functions = kids(c, ints_get(c.mprog, m), "functions");
    let mut i = 0;
    while i < ints_len(impls) {
        let tr = ints_get(c.htr, i);
        if tr >= 0 { register_impl(c, m, ints_get(impls, i), tr, ints_get(c.hty, i), functions); }
        i = i + 1;
    }
    0
}

// One impl: the orphan rule, its methods against its trait's, and the coherence table.
fn register_impl(c: Ck, m: Int, im: Int, tr: Int, ty: Int, functions: Ints) -> Int {
    let tname = strs_get(c.trname, tr);
    let shown = show(c, ty);
    let is = fld(c, im, "impl_span");
    if ints_get(c.trmod, tr) != m && type_module(c, ty) != m {
        err(c, "N0601", is, cat5(cat5("an impl of `", tname, "` for `", shown, "` must be in the module declaring `"), tname, "` or the one declaring `", shown, "`"),
                "one impl per trait and type, where everyone who can name both can find it: move it to the trait's module or the type's");
        sec_at(c, ints_get(c.trns, tr), ints_get(c.trne, tr), "the trait is declared here");
        return 0;
    }
    let mf = ints_get(c.trmf, tr);
    let mc = ints_get(c.trmc, tr);
    let methods = ints_new();
    let mut k = 0;
    while k < mc {
        ints_push(methods, 0 - 1);
        k = k + 1;
    }
    let mut i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        if some(c, f, "method_of") {
            if sps(c, fld(c, unwrap(c, f, "method_of"), "impl_span")) == sps(c, is) {
                // By the name it is declared under, as `register_impl` finds it.
                let id = defined_fn(c, m, cat5(tname, "/", shown, "/", fname_of(c, f, "name")));
                let tm = impl_method(c, f, id, tr, ty);
                if tm >= 0 { ints_set(methods, tm - mf, id); }
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    k = 0;
    while k < mc {
        // A method with a default body may be left out.
        if ints_get(methods, k) < 0 && ints_get(c.tmdef, mf + k) == 0 { strs_push(missing, strs_get(c.tmname, mf + k)); }
        k = k + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0602", is, cat5("this impl of `", tname, "` for `", shown, cat3("` does not define ", quoted(missing), "")),
                "an impl defines every method of its trait that has no default body");
        sec_at(c, ints_get(c.trns, tr), ints_get(c.trne, tr), "the trait is declared here");
    }
    let first = impl_of(c, tr, ty);
    ints_push(c.imtrait, tr);
    ints_push(c.imty, ty);
    ints_push(c.immod, m);
    ints_push(c.imis, sps(c, is));
    ints_push(c.imie, spe(c, is));
    ints_push(c.imff, ints_len(c.imfn));
    k = 0;
    while k < mc {
        ints_push(c.imfn, ints_get(methods, k));
        k = k + 1;
    }
    let tps = kids(c, im, "type_params");
    ints_push(c.imrf, ints_len(c.imreq));
    ints_push(c.imrc, ints_len(tps));
    k = 0;
    while k < ints_len(tps) {
        let p = ints_get(tps, k);
        let mut req = 0 - 1;
        if some(c, p, "requires") {
            let rn = fname_of(c, unwrap(c, p, "requires"), "name");
            if rn == "Equality" { req = 0 - 2; } else {
                let at = strs_find(c.tsname, rn);
                if at >= 0 { req = ints_get(c.tsid, at); }
            }
        }
        ints_push(c.imreq, req);
        k = k + 1;
    }
    if first >= 0 {
        err(c, "N0600", is, cat5("`", shown, "` already implements `", tname, "`"),
                "a type implements a trait at most once in a program, so every call means one function");
        sec_at(c, ints_get(c.imis, first), ints_get(c.imie, first), "the first impl");
    }
    0
}

// One method of an impl against its trait's: the trait's method it defines, or -1 having said
// why it defines none.
fn impl_method(c: Ck, f: Int, id: Int, tr: Int, ty: Int) -> Int {
    if id < 0 { return 0 - 1; }
    let tname = strs_get(c.trname, tr);
    let name = fname_of(c, f, "name");
    let ns = fld(c, f, "name_span");
    let tm = trait_method(c, tr, name);
    if tm < 0 {
        err(c, "N0603", ns, cat5("`", name, "` is not a method of `", tname, "`"), "an impl defines its trait's methods and nothing else");
        sec_at(c, ints_get(c.trns, tr), ints_get(c.trne, tr), "the trait is declared here");
        return 0 - 1;
    }
    let n = targc_of_def(c, ty);
    let mut me = ty;
    if n > 0 { me = applied_to_own(c, ty, id); }
    let params = ints_new();
    ints_push(params, me);
    let mut k = 0;
    while k < ints_get(c.tmpc, tm) {
        ints_push(params, subst(c, ints_get(c.ptys, ints_get(c.tmpf, tm) + k), own_trait(), tr, one(me)));
        k = k + 1;
    }
    let ret = subst(c, ints_get(c.tmret, tm), own_trait(), tr, one(me));
    let mut same = ints_get(c.fnpc, id) == ints_len(params) && ints_get(c.fnret, id) == ret;
    if same {
        k = 0;
        while k < ints_len(params) {
            if ints_get(c.ptys, ints_get(c.fnpf, id) + k) != ints_get(params, k) { same = false; }
            k = k + 1;
        }
    }
    let fps = kids(c, f, "params");
    if ints_len(fps) == 0 { same = false; } else {
        if fname_of(c, ints_get(fps, 0), "name") != "self" { same = false; }
    }
    let mut eff = ints_get(c.fneff, id);
    if eff < 0 { eff = 0; }
    if eff != ints_get(c.tmeff, tm) { same = false; }
    if ints_get(c.fntpc, id) != n { same = false; }
    if same { return tm; }
    let wanted = strs_new();
    k = 0;
    while k < ints_len(params) {
        strs_push(wanted, show(c, ints_get(params, k)));
        k = k + 1;
    }
    let message = cat5(cat5("`", name, "` must be `fn ", name, "(self: "), str_join(wanted, ", "), ") -> ", show(c, ret),
            cat5("` with the trait's effects, as `", tname, "` declares it with `Self` = `", show(c, ty), "`"));
    err(c, "N0603", ns, message, "");
    sec_at(c, ints_get(c.tmns, tm), ints_get(c.tmne, tm), "the trait's method");
    0 - 1
}

// The impl of `tr` for exactly `ty` (the table's answer: the first filed), or -1.
fn impl_of(c: Ck, tr: Int, ty: Int) -> Int {
    let mut i = 0;
    while i < ints_len(c.imtrait) {
        if ints_get(c.imtrait, i) == tr && ints_get(c.imty, i) == ty { return i; }
        i = i + 1;
    }
    0 - 1
}

// Whether `ty` satisfies `T: tr` in the module being checked (`satisfies`): a type parameter
// bound by it, or an impl in this module or one it imports directly.
fn satisfies(c: Ck, tr: Int, ty: Int) -> Bool { satisfies_within(c, tr, ty, 0) }

fn satisfies_within(c: Ck, tr: Int, ty: Int, depth: Int) -> Bool {
    if depth > max_depth() { return false; }
    if tag(c, ty) == tag_param() { return param_bound(c, ty) == tr; }
    let im = applying(c, tr, ty);
    if im < 0 { return derives(c, tr, ty); }
    let m = gs(c, s_module());
    if impl_usable(c, m, ints_get(c.immod, im)) == false { return false; }
    // An impl of a generic definition: its parameters' requirements, of `ty`'s arguments.
    let mut i = 0;
    while i < ints_get(c.imrc, im) && i < targc(c, ty) {
        let req = ints_get(c.imreq, ints_get(c.imrf, im) + i);
        let a = targ(c, ty, i);
        if req == 0 - 2 {
            if derived(c, a, true) != "" { return false; }
        }
        if req >= 0 {
            if satisfies_within(c, req, a, depth + 1) == false { return false; }
        }
        i = i + 1;
    }
    true
}

// Whether `ty` satisfies `tr` by derivation rather than an impl (`Traits::derives`, L6): `tr` is
// `@std/hash`'s `Hash`, `ty` a record or enum with no impl of its own, every component an
// integer, `Bool`, `Str`, or a record or enum of them none of which has an impl.
fn derives(c: Ck, tr: Int, ty: Int) -> Bool {
    if tr < 0 || tr != gs(c, s_hash()) { return false; }
    if applying(c, tr, ty) >= 0 { return false; }
    if is_record(c, ty) == false && is_enum(c, ty) == false { return false; }
    derived_by(c, ty, false, tr, false) == ""
}

// The impl of `tr` that applies to `ty` (`applying`): the one for exactly `ty`, or the one for the
// generic definition `ty` is an instance of. -1 for none.
fn applying(c: Ck, tr: Int, ty: Int) -> Int {
    let im = impl_of(c, tr, ty);
    if im >= 0 { return im; }
    if (is_record(c, ty) || is_enum(c, ty)) && targc(c, ty) > 0 {
        if is_record(c, ty) { return impl_of(c, tr, record_ty(c, ta(c, ty), ints_new())); }
        return impl_of(c, tr, enum_ty(c, ta(c, ty), ints_new()));
    }
    0 - 1
}

// The trait a type parameter is bound by, or -1.
fn param_bound(c: Ck, t: Int) -> Int {
    if ta(c, t) != own_fn() { return 0 - 1; }
    let id = ints_get(c.tyb, t);
    let index = ints_get(c.tyc, t);
    if index >= ints_get(c.fntpc, id) { return 0 - 1; }
    ints_get(c.tpbound, ints_get(c.fntpf, id) + index)
}

// --- stage 1: functions (`declare_unit`) --------------------------------------------------------

fn declare_functions(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    type_environment(c, m, false);
    trait_scope(c, m);
    impl_headers(c, m);
    let p = ints_get(c.mprog, m);
    let functions = kids(c, p, "functions");
    let mut i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        // An impl's method is declared under `Trait/Type/m` (N78), where its header resolved.
        let mut hdr = 0 - 1;
        if some(c, f, "method_of") {
            hdr = header_at(c, sps(c, fld(c, unwrap(c, f, "method_of"), "impl_span")));
            if hdr >= 0 {
                if ints_get(c.htr, hdr) >= 0 { declare_function(c, m, f, hdr); }
            }
        } else {
            declare_function(c, m, f, 0 - 1);
        }
        i = i + 1;
    }
    register_impls(c, m);
    report_exported_types(c, m);
    0
}

fn declare_function(c: Ck, m: Int, f: Int, hdr: Int) -> Int {
    let method = hdr >= 0;
    let mut name = fname_of(c, f, "name");
    if method { name = cat5(strs_get(c.trname, ints_get(c.htr, hdr)), "/", show(c, ints_get(c.hty, hdr)), "/", name); }
    let ns = fld(c, f, "name_span");
    let params = kids(c, f, "params");
    // A generic function's parameter types mention its own parameters, which name it: the
    // id it would be declared under comes first.
    let id = strs_len(c.fnname);
    declared_type_params(c, f);
    let tps = kids(c, f, "type_params");
    let pn = strs_new();
    let pt = ints_new();
    let mut k = 0;
    while k < ints_len(tps) {
        let n = fname_of(c, ints_get(tps, k), "name");
        strs_push(pn, n);
        ints_push(pt, param_ty(c, own_fn(), id, k, n));
        k = k + 1;
    }
    if method {
        let mut me = ints_get(c.hty, hdr);
        if targc_of_def(c, me) > 0 {
            let own = ints_new();
            k = 0;
            while k < targc_of_def(c, me) && k < ints_len(pt) {
                ints_push(own, ints_get(pt, k));
                k = k + 1;
            }
            if is_record(c, me) { me = record_ty(c, ta(c, me), own); } else { me = enum_ty(c, ta(c, me), own); }
        }
        strs_push(pn, "Self");
        ints_push(pt, me);
    }
    // The effect parameter it declares (N51, `declared_effect_param`): the first, every further
    // one refused, and one on a function that declares no effect set too.
    let eps = kids(c, f, "effect_params");
    if ints_len(eps) > 0 {
        let first = ints_get(eps, 0);
        let fnm = fname_of(c, f, "name");
        k = 1;
        while k < ints_len(eps) {
            err(c, "N0388", fld(c, ints_get(eps, k), "span"), cat3("`", fnm, "` declares a second effect parameter"),
                    "a function declares at most one: every set it writes may name that one");
            sec(c, fld(c, first, "span"), "the first");
            k = k + 1;
        }
        if some(c, f, "foreign") {
            // Calling C is always the effect `foreign`: the function has no parameter.
            err(c, "N0388", fld(c, first, "span"), "a foreign function cannot have an effect parameter", "calling C is always the effect `foreign`");
        } else {
            if some(c, f, "effects") == false {
                err(c, "N0388", fld(c, first, "span"), cat3("`", fnm, "` has an effect parameter, so it declares its effect set"),
                        cat3("write `! { ", fname_of(c, first, "name"), " }` after the result type: a function with an effect parameter states what it does in terms of it"));
            }
            ints_push(c.epown, id);
            strs_push(c.epnm, fname_of(c, first, "name"));
            ss(c, s_eparam(), id + 1);
        }
    }
    let pf = ints_len(c.ptys);
    k = 0;
    while k < ints_len(params) {
        ints_push(c.ptys, resolve_written(c, fld(c, ints_get(params, k), "ty"), pn, pt, c.d));
        k = k + 1;
    }
    let rt = fld(c, f, "return_type");
    let ret = resolve_written(c, rt, pn, pt, c.d);
    let mut eff = 0 - 1;
    let mut ws = 0 - 1;
    let mut we = 0 - 1;
    if some(c, f, "effects") {
        let decl = unwrap(c, f, "effects");
        eff = declared_effects(c, decl);
        ws = sps(c, fld(c, decl, "span"));
        we = spe(c, fld(c, decl, "span"));
    }
    // An impl's method that writes no effect set has its trait method's.
    if method && eff < 0 {
        let tm = trait_method(c, ints_get(c.htr, hdr), fname_of(c, f, "name"));
        if tm >= 0 { eff = ints_get(c.tmeff, tm); }
    }
    ss(c, s_eparam(), 0);
    let b = builtin_index(c, name);
    let mut refused = false;
    if b >= 0 && method == false {
        if ints_get(c.bprelude, b) == 0 { refused = true; }
    }
    if name == "try_convert" || name == "wrap_convert" || name == "saturate_convert" || name == "println" || name == "eprintln" { refused = true; }
    if refused && method == false {
        err(c, "N0203", ns, cat3("`", name, "` is a built-in and cannot be redefined"),
                "built-ins share the ordinary function namespace so that a call always means the same thing; choose another name");
    } else {
        let existing = defined_fn(c, m, name);
        if existing >= 0 {
            let mut place = "module";
            if method { place = "impl"; }
            err(c, "N0203", ns, cat5("`", fname_of(c, f, "name"), "` is defined more than once in this ", place, ""), "");
            if method == false && flag(c, ints_get(c.fnnode, existing), "inferred_result") { ints_push(c.fndups, existing); }
            sec_at(c, ints_get(c.fnns, existing), ints_get(c.fnne, existing), "first defined here");
        } else {
            // A foreign declaration (N42): its shape, ABI, symbol and types, and its symbol
            // declared again only with the same signature; an export (N55) under its rules.
            // What a foreign one declares is the effect `foreign` and nothing else.
            if some(c, f, "foreign") {
                let d = unwrap(c, f, "foreign");
                check_foreign(c, f, d, pf, ret);
                same_symbol(c, m, d, pf, ints_len(params), ret);
                eff = with_bit(0, 2);
            }
            if some(c, f, "export") { check_export(c, f, unwrap(c, f, "export"), pf, ret); }
            // A result type left to an expression body (R1.5, D2) is the module's own business.
            if flag(c, f, "inferred_result") && (some(c, f, "pub_span") || some(c, f, "method_of")) {
                let mut whose = "`pub`";
                if some(c, f, "method_of") { whose = "method's"; }
                err(c, "N0634", ns, cat5("`", fname_of(c, f, "name"), "` must write its result type: a ", whose, " function's signature is its interface"),
                        "write it after `:`, as `fn f(n: Int): Int = …`");
            }
            strs_push(c.fnname, name);
            ints_push(c.fnmod, m);
            ints_push(c.fnclos, 0 - 1);
            ints_push(c.fnpb, 0 - 1);
            if method { ints_push(c.fnmeth, 1); } else { ints_push(c.fnmeth, 0); }
            if some(c, f, "foreign") { ints_push(c.fnfor, 1); } else { ints_push(c.fnfor, 0); }
            if some(c, f, "export") { ints_push(c.fnexp, 1); } else { ints_push(c.fnexp, 0); }
            let public = some(c, f, "pub_span") && method == false;
            if public { ints_push(c.fnpub, 1); } else { ints_push(c.fnpub, 0); }
            ints_push(c.fnns, sps(c, ns));
            ints_push(c.fnne, spe(c, ns));
            ints_push(c.fnnode, f);
            ints_push(c.fnpf, pf);
            ints_push(c.fnpc, ints_len(params));
            ints_push(c.fnret, ret);
            ints_push(c.fneff, eff);
            ints_push(c.fnws, ws);
            ints_push(c.fnwe, we);
            let rts = fld(c, rt, "span");
            if sx_s(c.t, rts) == sx_e(c.t, rts) && flag(c, f, "inferred_result") == false { ints_push(c.fnnores, 1); } else { ints_push(c.fnnores, 0); }
            ints_push(c.fntpf, strs_len(c.tpname));
            ints_push(c.fntpc, ints_len(tps));
            k = 0;
            while k < ints_len(tps) {
                strs_push(c.tpname, strs_get(pn, k));
                ints_push(c.tpeq, 0);
                ints_push(c.tpbound, 0 - 1);
                note_written(c, fld(c, ints_get(tps, k), "span"), 3);
                k = k + 1;
            }
            requirements(c, f, true, id);
            if public {
                // A public signature naming a private type (`report_private_type`).
                k = 0;
                while k < ints_len(params) {
                    let pt = fld(c, fld(c, ints_get(params, k), "ty"), "span");
                    report_private_type(c, ints_get(c.ptys, pf + k), sps(c, pt), spe(c, pt), sps(c, ns), spe(c, ns), "function", name);
                    k = k + 1;
                }
                report_private_type(c, ret, sps(c, rts), spe(c, rts), sps(c, ns), spe(c, ns), "function", name);
            }
        }
    }
    0
}

// A C symbol declared again in this module must have the signature it was first declared with.
fn same_symbol(c: Ck, m: Int, d: Int, pf: Int, pc: Int, ret: Int) -> Int {
    let sym = fname_of(c, d, "symbol");
    let mut g = 0;
    while g < strs_len(c.fnname) {
        if ints_get(c.fnmod, g) == m && ints_get(c.fnfor, g) == 1 {
            let first = unwrap(c, ints_get(c.fnnode, g), "foreign");
            if fname_of(c, first, "symbol") == sym {
                let mut same = ints_get(c.fnpc, g) == pc && ints_get(c.fnret, g) == ret;
                let mut k = 0;
                while same && k < pc {
                    if ints_get(c.ptys, ints_get(c.fnpf, g) + k) != ints_get(c.ptys, pf + k) { same = false; }
                    k = k + 1;
                }
                if same == false {
                    err(c, "N0383", fld(c, d, "symbol_span"), cat3("the C symbol `", sym, "` is declared again with another signature"),
                            "a C function has one signature; declare it the same way");
                    sec(c, fld(c, first, "symbol_span"), "declared differently here");
                }
                return 0;
            }
        }
        g = g + 1;
    }
    0
}

// The same check for each exported type's own fields, after the functions.
fn report_exported_types(c: Ck, m: Int) -> Int {
    let mut r = 0;
    while r < strs_len(c.rname) {
        if ints_get(c.rmod, r) == m && ints_get(c.rpub, r) == 1 {
            let mut i = 0;
            while i < ints_get(c.rfc, r) {
                let f = ints_get(c.rff, r) + i;
                report_private_type(c, ints_get(c.fty, f), ints_get(c.fts, f), ints_get(c.fte, f), ints_get(c.rns, r), ints_get(c.rne, r), "record",
                        strs_get(c.rname, r));
                i = i + 1;
            }
        }
        r = r + 1;
    }
    let mut e = 0;
    while e < strs_len(c.ename) {
        if ints_get(c.emod, e) == m && ints_get(c.epub, e) == 1 {
            let mut v = 0;
            while v < ints_get(c.evc, e) {
                let vi = ints_get(c.evf, e) + v;
                let mut i = 0;
                while i < ints_get(c.vfc, vi) {
                    let f = ints_get(c.vff, vi) + i;
                    report_private_type(c, ints_get(c.fty, f), ints_get(c.fts, f), ints_get(c.fte, f), ints_get(c.ens, e), ints_get(c.ene, e), "enum",
                            strs_get(c.ename, e));
                    i = i + 1;
                }
                v = v + 1;
            }
        }
        e = e + 1;
    }
    // Its exported constants' types (L8): an importer builds the value where it uses it.
    let consts = kids(c, ints_get(c.mprog, m), "consts");
    let mut k = 0;
    while k < ints_len(consts) {
        let decl = ints_get(consts, k);
        if some(c, decl, "pub_span") && flag(c, decl, "is_static") == false {
            let ts = fld(c, fld(c, decl, "ty"), "span");
            let ns = fld(c, decl, "name_span");
            let t = resolve_written(c, fld(c, decl, "ty"), strs_new(), ints_new(), dg_new());
            report_private_type(c, t, sps(c, ts), spe(c, ts), sps(c, ns), spe(c, ns), "constant", fname_of(c, decl, "name"));
        }
        k = k + 1;
    }
    0
}

// `N0337`: a public item whose written type names a private definition, anywhere in it.
fn report_private_type(c: Ck, t: Int, s: Int, e: Int, is: Int, ie: Int, kind: Str, name: Str) -> Int {
    let work = ints_new();
    ints_push(work, t);
    while ints_len(work) > 0 {
        let u = ints_pop(work);
        let mut k = 0;
        while k < targc(c, u) {
            ints_push(work, targ(c, u, k));
            k = k + 1;
        }
        // An array's element (L8): `[Secret; 2]` exposes `Secret`.
        if is_array(c, u) { ints_push(work, array_elem(c, u)); }
        let mut pname = "";
        let mut ds = 0;
        let mut de = 0;
        if is_record(c, u) && ints_get(c.rpub, ta(c, u)) == 0 {
            pname = strs_get(c.rname, ta(c, u));
            ds = ints_get(c.rns, ta(c, u));
            de = ints_get(c.rne, ta(c, u));
        }
        if is_enum(c, u) && ints_get(c.epub, ta(c, u)) == 0 {
            pname = strs_get(c.ename, ta(c, u));
            ds = ints_get(c.ens, ta(c, u));
            de = ints_get(c.ene, ta(c, u));
        }
        if pname != "" {
            dg_error(c.d, "N0337", s, e, cat5("this public ", kind, " exposes `", pname, "`, which is private to this module"), "",
                    "an importer would have to name this type to use the item and cannot. Export the type with `pub`, or stop exporting the item");
            sec_at(c, is, ie, cat3("`", name, "` is public"));
            sec_at(c, ds, de, "declared without `pub` here");
            return 0;
        }
    }
    0
}

fn defined_fn(c: Ck, m: Int, name: Str) -> Int {
    let mut i = 0;
    while i < strs_len(c.fnname) {
        if ints_get(c.fnmod, i) == m && strs_get(c.fnname, i) == name { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- the rules about `main` -----------------------------------------------------------------

fn main_rules(c: Ck) -> Int {
    ss(c, s_module(), 0);
    let id = defined_fn(c, 0, "main");
    if id >= 0 {
        let f = ints_get(c.fnnode, id);
        // `main` cannot be generic: there is no caller to choose its type arguments.
        if ints_get(c.fntpc, id) > 0 {
            dg_error(c.d, "N0356", ints_get(c.fnns, id), ints_get(c.fnne, id), "`main` cannot be generic", "",
                    "the process entry is called by nothing that could choose its type arguments. Make `main` concrete and call a generic function from it");
        }
        // Nor polymorphic in its effects (N51): nothing calls it to bind the parameter.
        if polymorphic(c, id) {
            dg_error(c.d, "N0388", ints_get(c.fnns, id), ints_get(c.fnne, id), "`main` cannot have an effect parameter", "",
                    "the process entry is called by nothing that could bind it: declare what `main` does, and call an effect-polymorphic function from it");
        }
        let params = kids(c, f, "params");
        let mut i = 0;
        while i < ints_get(c.fnpc, id) {
            let t = ints_get(c.ptys, ints_get(c.fnpf, id) + i);
            if is_cap(c, t) == false {
                err(c, "N0371", fld(c, ints_get(params, i), "span"), "a parameter of `main` must be a capability",
                        "the runtime calls `main`, and what it can hand over is authority: `IoCap` and `SpawnCap`. Read the command line with `arg` instead");
            }
            i = i + 1;
        }
        return 0;
    }
    if gs(c, s_syntax()) >= 1 { return 0; }
    dg_error(c.d, "N0204", 0, 0, "this program has no `main` function", "", "`nazm run` evaluates `fn main() -> Int` in the file you named");
    0
}

// --- stage 2: bodies (`check_unit`) -----------------------------------------------------------

// How an expression or a block completes: a value's type (0 and up), nothing, or never.
fn unit() -> Int { 0 - 1 }
fn diverges() -> Int { 0 - 2 }
fn none() -> Int { 0 - 1 }

fn check_unit(c: Ck, m: Int) -> Int {
    ss(c, s_module(), m);
    // The reference's `environment` makes each built-in's shapes into types here, once, its `T`
    // its own: `checked_add`'s `Option[T]` is an instance of the prelude's `Option`, interned in
    // the type table's order at the first module checked (Core IR's `types`).
    if m != prelude(c) && declared_enum(c, prelude(c), "Option") >= 0 {
        let mut bi = 0;
        while bi < strs_len(c.bname) {
            if strs_get(c.bretshape, bi) == "Option[T]" { shape_of(c, "Option[T]", param_ty(c, own_builtin(), bi, 0, "T")); }
            bi = bi + 1;
        }
    }
    environment(c, m);
    type_environment(c, m, false);
    const_environment(c, m);
    trait_scope(c, m);
    let p = ints_get(c.mprog, m);
    let functions = kids(c, p, "functions");
    // A result type left to an expression body (R1.5, D2) is settled before any caller is
    // checked: those bodies first, each after the inferred functions it calls.
    let inferred = infer_order(c, functions);
    let mut i = 0;
    while i < ints_len(inferred) {
        check_function(c, ints_get(functions, ints_get(inferred, i)));
        ss(c, s_eparam(), 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(functions) {
        if index_of(inferred, i) < 0 {
            check_function(c, ints_get(functions, i));
            ss(c, s_eparam(), 0);
        }
        i = i + 1;
    }
    0
}

// --- result types from the body (R1.5, D2; `check/infer.rs`) -----------------------------------

// The positions in `functions` of those whose result type is inferred, callees before callers
// (`infer::order`); each that reaches itself reported once (`N0634`) and placed where it was met.
fn infer_order(c: Ck, functions: Ints) -> Ints {
    let out = ints_new();
    // The map the reference collects: a name's last inferred function.
    let names = strs_new();
    let at = ints_new();
    let mut i = 0;
    while i < ints_len(functions) {
        let f = ints_get(functions, i);
        if flag(c, f, "inferred_result") && some(c, f, "method_of") == false {
            let k = strs_find(names, fname_of(c, f, "name"));
            if k >= 0 { ints_set(at, k, i); } else {
                strs_push(names, fname_of(c, f, "name"));
                ints_push(at, i);
            }
        }
        i = i + 1;
    }
    if ints_len(at) == 0 { return out; }
    let state = ints_new();
    i = 0;
    while i < ints_len(functions) {
        ints_push(state, 0);
        i = i + 1;
    }
    let starts = ints_new();
    i = 0;
    while i < ints_len(at) {
        insert_sorted(starts, ints_get(at, i));
        i = i + 1;
    }
    let reported = ints_new();
    // The stack: each frame a function, with what it calls still to place at the end of `pool`
    // from `fbase`.
    let sf = ints_new();
    let fbase = ints_new();
    let pool = ints_new();
    i = 0;
    while i < ints_len(starts) {
        let start = ints_get(starts, i);
        if ints_get(state, start) == 0 {
            ints_push(sf, start);
            ints_push(fbase, ints_len(pool));
            infer_calls(c, functions, names, at, start, pool);
            ints_set(state, start, 1);
            while ints_len(sf) > 0 {
                let n = ints_get(sf, ints_len(sf) - 1);
                let b = ints_get(fbase, ints_len(fbase) - 1);
                if ints_len(pool) > b {
                    let next = ints_pop(pool);
                    let st = ints_get(state, next);
                    if st == 1 {
                        let mut on = false;
                        let mut k = 0;
                        while k < ints_len(sf) {
                            if ints_get(sf, k) == next { on = true; }
                            if on && index_of(reported, ints_get(sf, k)) < 0 { ints_push(reported, ints_get(sf, k)); }
                            k = k + 1;
                        }
                    }
                    if st == 0 {
                        ints_set(state, next, 1);
                        ints_push(sf, next);
                        ints_push(fbase, ints_len(pool));
                        infer_calls(c, functions, names, at, next, pool);
                    }
                } else {
                    ints_set(state, n, 2);
                    ints_push(out, n);
                    ints_pop(sf);
                    ints_pop(fbase);
                }
            }
        }
        i = i + 1;
    }
    let sorted = ints_new();
    i = 0;
    while i < ints_len(reported) {
        insert_sorted(sorted, ints_get(reported, i));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(sorted) {
        let f = ints_get(functions, ints_get(sorted, i));
        err(c, "N0634", fld(c, f, "name_span"), cat3("`", fname_of(c, f, "name"), "` reaches itself, so its result type cannot come from its body"),
                "write it after `:`, as `fn f(n: Int): Int = …`");
        i = i + 1;
    }
    out
}

// The inferred functions function `n`'s body calls by name (`called_names`), appended to `pool`.
fn infer_calls(c: Ck, functions: Ints, names: Strs, at: Ints, n: Int, pool: Ints) -> Int {
    let f = ints_get(functions, n);
    if some(c, f, "body") == false { return 0; }
    let called = sx_called_names(c.t, unwrap(c, f, "body"));
    let mut i = 0;
    while i < strs_len(called) {
        let k = strs_find(names, strs_get(called, i));
        if k >= 0 { ints_push(pool, ints_get(at, k)); }
        i = i + 1;
    }
    0
}

// `v` into the ascending `xs`.
fn insert_sorted(xs: Ints, v: Int) -> Int {
    let mut at = ints_len(xs);
    let mut i = ints_len(xs) - 1;
    while i >= 0 {
        if ints_get(xs, i) > v { at = i; }
        i = i - 1;
    }
    insert_int(xs, at, v)
}

// The names module `m` may call beyond its own functions and the built-ins (`environment`):
// each direct import's exports, as `alias::name` under each name it is imported by — an alias
// that already names something here refused (N0209) — and plainly where a plain `use` named it,
// an export this module also defines (N0208) or another import brought in (N0207) refused.
fn environment(c: Ck, m: Int) -> Int {
    while strs_len(c.envname) > 0 {
        strs_pop(c.envname);
        ints_pop(c.envfn);
    }
    while strs_len(c.alname) > 0 {
        strs_pop(c.alname);
        ints_pop(c.almod);
    }
    // Where each alias is written, and which import brought each plain name in.
    let alstart = ints_new();
    let alend = ints_new();
    let bstarts = ints_new();
    let bends = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        let on = ints_get(c.don, d);
        let mut a = 0;
        while a < ints_get(c.dac, d) {
            let ai = ints_get(c.daf, d) + a;
            let alias = strs_get(c.aname, ai);
            let at_s = ints_get(c.aats, ai);
            let at_e = ints_get(c.aate, ai);
            let mut what = "";
            let mut os = 0;
            let mut oe = 0;
            let first = strs_find(c.alname, alias);
            let own = defined_fn(c, m, alias);
            let brought = strs_find(c.envname, alias);
            if first >= 0 {
                what = "another import already has this name";
                os = ints_get(alstart, first);
                oe = ints_get(alend, first);
            } else {
                if own >= 0 || brought >= 0 {
                    let mut f = own;
                    if f < 0 { f = ints_get(c.envfn, brought); }
                    what = "a function of this module";
                    os = ints_get(c.fnns, f);
                    oe = ints_get(c.fnne, f);
                } else {
                    if declared_record(c, m, alias) >= 0 || declared_enum(c, m, alias) >= 0 {
                        what = "a type of this module";
                        os = at_s;
                        oe = at_e;
                    }
                }
            }
            if what != "" {
                dg_error(c.d, "N0209", at_s, at_e, cat4("`", alias, "` already names ", what), "",
                        "an import's name is written before `::` and must mean only that module here: choose another");
                sec_at(c, os, oe, "the other meaning");
            } else {
                strs_push(c.alname, alias);
                ints_push(c.almod, on);
                ints_push(alstart, at_s);
                ints_push(alend, at_e);
            }
            a = a + 1;
        }
        if ints_get(c.dplain, d) == 1 {
            let ofns = ints_new();
            let onames = strs_new();
            offered_fns(c, on, ofns, onames);
            let mut j = 0;
            while j < ints_len(ofns) {
                let f = ints_get(ofns, j);
                let name = strs_get(onames, j);
                let own = defined_fn(c, m, name);
                let first = strs_find(c.envname, name);
                if ints_get(c.dimplicit, d) == 1 && (own >= 0 || first >= 0) {
                    // The prelude's standard modules (R1.5, D9) yield, silently.
                } else {
                    if own >= 0 {
                        dg_error(c.d, "N0208", ints_get(c.dats, d), ints_get(c.date, d), cat3("this import brings in `", name, "`, which this module defines"), "",
                                "an imported name and a local one are not ranked: rename one of them, or stop exporting the other");
                        sec_at(c, ints_get(c.fnns, own), ints_get(c.fnne, own), "defined here");
                        sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "and exported here");
                    } else {
                        if first >= 0 {
                            dg_error(c.d, "N0207", ints_get(c.dats, d), ints_get(c.date, d), cat3("`", name, "` is exported by two imported modules"), "",
                                    "there is no way to write which one is meant, so the ambiguity is refused where it is created rather than where it is used");
                            sec_at(c, ints_get(bstarts, first), ints_get(bends, first), "also brought in here");
                            sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "exported here");
                        } else {
                            strs_push(c.envname, name);
                            ints_push(c.envfn, f);
                            ints_push(bstarts, ints_get(c.dats, d));
                            ints_push(bends, ints_get(c.date, d));
                        }
                    }
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    0
}

// A type in the function's signature, resolved again silently: stage 1 reported it.
fn signature_type(c: Ck, w: Int) -> Int { resolve_written(c, w, c.tsn, c.tst, dg_new()) }

fn check_function(c: Ck, f: Int) -> Int {
    let name = fname_of(c, f, "name");
    let mut id = defined_fn(c, gs(c, s_module()), name);
    // An impl's method is found by where it is (N78): its name is `Trait/Type/m`.
    if some(c, f, "method_of") { id = fn_of_node(c, f); }
    // The method of a plain impl of what is no trait is not checked: the reference drops the impl (one with type parameters it still reads).
    if some(c, f, "method_of") && id < 0 && ints_len(kids(c, f, "type_params")) == 0 {
        let hdr = header_at(c, sps(c, fld(c, unwrap(c, f, "method_of"), "impl_span")));
        if hdr < 0 || ints_get(c.htr, hdr) < 0 {
            // Its signature's types are still read, as the reference reads them; the body is not checked.
            let ps = kids(c, f, "params");
            let mut q = 0;
            while q < ints_len(ps) {
                signature_type(c, fld(c, ints_get(ps, q), "ty"));
                q = q + 1;
            }
            signature_type(c, fld(c, f, "return_type"));
            return 0;
        }
    }
    // A function that redefines a built-in is not declared, and its body is not checked.
    if id < 0 && some(c, f, "method_of") == false {
        let ps = kids(c, f, "params");
        let mut q = 0;
        while q < ints_len(ps) {
            signature_type(c, fld(c, ints_get(ps, q), "ty"));
            q = q + 1;
        }
        signature_type(c, fld(c, f, "return_type"));
        return 0;
    }
    ss(c, s_fn(), id);
    ss(c, s_closures(), 0);
    // Its effect parameter, by name, for every type written inside it (N51).
    ss(c, s_eparam(), 0);
    if id >= 0 && ints_len(kids(c, f, "effect_params")) > 0 { ss(c, s_eparam(), id + 1); }
    // The function's own type parameters are in scope for every type written inside it.
    while strs_len(c.tsn) > 0 {
        strs_pop(c.tsn);
        ints_pop(c.tst);
    }
    let tps = kids(c, f, "type_params");
    let mut k = 0;
    while k < ints_len(tps) {
        if id >= 0 {
            strs_push(c.tsn, fname_of(c, ints_get(tps, k), "name"));
            ints_push(c.tst, fn_param_ty(c, id, k));
        }
        k = k + 1;
    }
    // An impl's method may write its impl's type as `Self`: its first parameter's.
    if some(c, f, "method_of") && id >= 0 {
        if ints_get(c.fnpc, id) > 0 {
            strs_push(c.tsn, "Self");
            ints_push(c.tst, ints_get(c.ptys, ints_get(c.fnpf, id)));
        }
    }
    open_scope(c);
    let params = kids(c, f, "params");
    // Its parameters are its first bindings (provenance reads them by position).
    if id >= 0 {
        if ints_get(c.fnnode, id) == f { ints_set(c.fnpb, id, ints_len(c.bfn)); }
    }
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let ty = signature_type(c, fld(c, p, "ty"));
        let pn = fname_of(c, p, "name");
        if defined_here(c, pn) {
            err(c, "N0202", fld(c, p, "span"), cat3("`", pn, "` is listed twice in this parameter list"), "");
        }
        define(c, pn, ty, false, 0 - 1, 0 - 1);
        declared_at(c, fld(c, p, "name_span"));
        i = i + 1;
    }
    let rt = fld(c, f, "return_type");
    let declared = signature_type(c, rt);
    let rts = fld(c, rt, "span");
    // Contracts (N87, §7.88): `Bool`, over the parameters and, after `ensures`, `result`.
    check_contracts(c, f, declared);
    // A body that failed to parse: anything said about statements never built would be about
    // the parser's guess, not the program.
    if some(c, f, "body") == false {
        close_scope(c);
        return 0;
    }
    let body = unwrap(c, f, "body");
    // An expression body with no result type written (R1.5, D2): its type is the function's
    // result type, settled before any caller is checked; one with no value is `N0634`.
    if flag(c, f, "inferred_result") {
        ss(c, s_ret(), no_return_type());
        ss(c, s_loop(), 0);
        ss(c, s_defer(), 0);
        let got = check_block(c, body, none());
        if got >= 0 {
            if id >= 0 { ints_set(c.fnret, id, got); }
        } else {
            err(c, "N0634", fld(c, body, "span"), cat3("`", name, "`'s body has no value to take its result type from"),
                    "write the body as a block, `fn f() { … }`, for a function that returns nothing");
        }
        close_scope(c);
        return 0;
    }
    ss(c, s_ret(), declared);
    ss(c, s_rs(), rts);
    ss(c, s_loop(), 0);
    ss(c, s_defer(), 0);
    let completion = check_block(c, body, declared);
    if completion >= 0 && assignable(c, completion, declared) == false {
        let shown = show(c, completion);
        let want = show(c, declared);
        let mut at = fld(c, body, "span");
        if some(c, body, "tail") { at = espan(c, unwrap(c, body, "tail")); }
        err(c, "N0300", at, cat5(cat3("`", name, "` returns `"), shown, "`, but its signature says `", want, "`"), "");
        sec(c, rts, cat3("declared `", want, "` here"));
    }
    if completion == unit() {
        let want = show(c, declared);
        err(c, "N0300", fld(c, body, "span"), cat5("`", name, "` must produce a `", want, "`, but this body does not"),
                "a function's value is its final expression — one with no `;` after it — or it returns on every path");
        sec(c, rts, cat3("declared `", want, "` here"));
    }
    close_scope(c);
    0
}

// Whether a value of `got` may be passed or returned where `want` is expected (`assignable`): the
// same type, an `IoCap` where an `OutCap` is, or a function type with the same parameters and
// result whose effects are within the expected one's.
fn assignable(c: Ck, got: Int, want: Int) -> Bool {
    if got == want { return true; }
    if got < 0 || want < 0 { return false; }
    if is_fn(c, got) && is_fn(c, want) {
        if targc(c, got) != targc(c, want) { return false; }
        let mut i = 0;
        while i < targc(c, got) {
            if targ(c, got, i) != targ(c, want, i) { return false; }
            i = i + 1;
        }
        // An effect parameter is matched by binding, never by inclusion (N51).
        if has_bit(ta(c, got), 3) || has_bit(ta(c, want), 3) { return false; }
        return without(ta(c, got), ta(c, want)) == 0;
    }
    bname_of(c, got) == "IoCap" && bname_of(c, want) == "OutCap"
}

// --- scopes -------------------------------------------------------------------------------------

fn open_scope(c: Ck) -> Int {
    ints_push(c.frames, strs_len(c.sname));
    ints_push(c.fjoin, 0);
    0
}

// A scope that continues the one outside it as far as shadowing goes (`open_joined_scope`).
fn open_joined_scope(c: Ck) -> Int {
    ints_push(c.frames, strs_len(c.sname));
    ints_push(c.fjoin, 1);
    0
}

fn close_scope(c: Ck) -> Int {
    let start = ints_pop(c.frames);
    ints_pop(c.fjoin);
    while strs_len(c.sname) > start {
        strs_pop(c.sname);
        ints_pop(c.sty);
        ints_pop(c.smut);
        ints_pop(c.sds);
        ints_pop(c.sde);
        ints_pop(c.sbid);
    }
    0
}

// A binding; `ds` and `de` where its name is declared, or -1 for a parameter.
fn define(c: Ck, name: Str, ty: Int, mutable: Bool, ds: Int, de: Int) -> Int {
    strs_push(c.sname, name);
    ints_push(c.sty, ty);
    if mutable { ints_push(c.smut, 1); } else { ints_push(c.smut, 0); }
    ints_push(c.sds, ds);
    ints_push(c.sde, de);
    // A binding of its own, for provenance: the function it is declared in.
    ints_push(c.sbid, ints_len(c.bfn));
    ints_push(c.bfn, gs(c, s_fn()));
    ints_push(c.bty, ty);
    strs_push(c.bnm, name);
    ints_push(c.bshr, 0);
    ints_push(c.bds, ds);
    ints_push(c.bde, de);
    if mutable { ints_push(c.bmut, 1); } else { ints_push(c.bmut, 0); }
    0
}

// Where the binding the last `define` made is declared, for Core IR: a parameter's name, which
// a diagnostic never points at as a declaration.
fn declared_at(c: Ck, span: Int) -> Int {
    ints_set(c.bds, last_binding(c), sps(c, span));
    ints_set(c.bde, last_binding(c), spe(c, span));
    0
}

// The binding the last `define` made.
fn last_binding(c: Ck) -> Int { ints_len(c.bfn) - 1 }

// The binding scope entry `b` is, recorded as what the name written at `s..e` refers to.
fn note_var(c: Ck, s: Int, e: Int, b: Int) -> Int {
    sm_put(c.mvar, s, e, ints_get(c.sbid, b));
    if gs(c, s_refused()) == 1 {
        // A refused capture: one slot for the closure and binding, however often it is named.
        let bid = ints_get(c.sbid, b);
        let f = gs(c, s_fn());
        let mut g = 0 - 1;
        let mut i = 0;
        while i < ints_len(c.rzb) {
            if ints_get(c.rzb, i) == bid && ints_get(c.rzf, i) == f { g = i; }
            i = i + 1;
        }
        if g < 0 {
            g = ints_len(c.rzb);
            ints_push(c.rzb, bid);
            ints_push(c.rzf, f);
        }
        sm_put(c.mrefu, s, e, g);
    }
    0
}

fn lookup(c: Ck, name: Str) -> Int {
    let mut i = strs_len(c.sname) - 1;
    while i >= 0 {
        if strs_get(c.sname, i) == name { return i; }
        i = i - 1;
    }
    0 - 1
}

// The binding `name` reaches here, captured into every closure between it and here (N50,
// `lookup_var`): a capability may be; a `let mut` binding is shared with the closure (R1b, L10)
// unless its type can hold a function value (N0386); and the first capture of a binding whose
// type can hold function values is refused (N0616). A captured copy that is not shared is
// neither mutable nor declared anywhere (`s_captured`).
fn lookup_var(c: Ck, name: Str, at: Int) -> Int {
    ss(c, s_captured(), 0);
    ss(c, s_refused(), 0);
    let b = lookup(c, name);
    if b < 0 { return b; }
    let mut first = 0 - 1;
    let mut k = 0;
    while k < ints_len(c.cfbound) {
        if first < 0 && b < ints_get(c.cfbound, k) { first = k; }
        k = k + 1;
    }
    if first < 0 { return b; }
    let ty = ints_get(c.sty, b);
    if ints_get(c.smut, b) == 1 && holds_fn(c, ty, 0) {
        err(c, "N0386", at, cat5("a closure cannot capture `", name, "`, a `let mut` binding of `", show(c, ty), "`, which can hold a function value"),
                "a captured `let mut` binding is shared with the closure, so the closure could be stored into it and own itself, which reference counting never reclaims; bind a copy with `let`, or pass the value as an argument");
        ss(c, s_captured(), 1);
        ss(c, s_refused(), 1);
        return b;
    }
    if captured_by(c, first, b) == false {
        let holder = function_holder(c, ty);
        if holder >= 0 {
            let shown = show(c, ty);
            let mut through = "";
            if show(c, holder) != shown { through = cat3(" through `", show(c, holder), "`"); }
            dg_error(c.d, "N0616", sps(c, at), spe(c, at), cat5(cat3("a closure cannot capture `", name, "`: a `"), shown, "` can hold function values", through, ""),
                    "captured here",
                    "a closure owns what it captures, so storing it into this value — or into any value sharing its storage — would make a value that owns itself, which reference counting never reclaims. Nazm refuses the capture rather than leak it, by the captured type alone. Pass the value to the function as an argument instead of capturing it");
        }
    }
    k = first;
    while k < ints_len(c.cfbound) {
        if b < ints_get(c.cfbound, k) && captured_by(c, k, b) == false {
            ints_push(c.capf, k);
            ints_push(c.capb, b);
            ints_push(c.capcl, ints_get(c.cfid, k));
            ints_push(c.capbd, ints_get(c.sbid, b));
            ints_push(c.capat, ints_len(c.bfn));
        }
        k = k + 1;
    }
    // A `let mut` binding a closure captures is shared with it (R1b, L10): one cell.
    if ints_get(c.smut, b) == 1 { ints_set(c.bshr, ints_get(c.sbid, b), 1); }
    if ints_get(c.smut, b) == 0 { ss(c, s_captured(), 1); }
    b
}

fn captured_by(c: Ck, frame: Int, b: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(c.capf) {
        if ints_get(c.capf, i) == frame && ints_get(c.capb, i) == b { return true; }
        i = i + 1;
    }
    false
}

// Whether a value of `t` can reach a function value (`function_holder` of a `Cell` of it).
fn holds_fn(c: Ck, t: Int, depth: Int) -> Bool { function_holder(c, holder_of(c, tag_cell(), t)) >= 0 }

// The mutable container through which a value of `t` can hold a function value
// (`function_holder`), or -1: a function type met inside a `Vec`; records and enums are walked
// through, last field first, as the reference's stack walks them.
fn function_holder(c: Ck, t: Int) -> Int {
    let st = ints_new();
    let sh = ints_new();
    let seen_t = ints_new();
    let seen_h = ints_new();
    ints_push(st, strip_array(c, t));
    ints_push(sh, 0 - 1);
    while ints_len(st) > 0 {
        let ty = ints_pop(st);
        let holder = ints_pop(sh);
        let mut held = 0;
        if holder >= 0 { held = 1; }
        let mut seen = false;
        let mut i = 0;
        while i < ints_len(seen_t) {
            if ints_get(seen_t, i) == ty && ints_get(seen_h, i) == held { seen = true; }
            i = i + 1;
        }
        if seen == false {
            ints_push(seen_t, ty);
            ints_push(seen_h, held);
            if is_fn(c, ty) {
                if holder >= 0 { return holder; }
            }
            // A `Cell` (R1b) is a mutable handle, as a `Vec` is.
            if tag(c, ty) == tag_vec() || tag(c, ty) == tag_chan() || tag(c, ty) == tag_cell() {
                ints_push(st, targ(c, ty, 0));
                if holder >= 0 { ints_push(sh, holder); } else { ints_push(sh, ty); }
            }
            // Immutable (R1a): what a `Box` or `Chain` holds cannot be replaced, so it is no holder.
            if tag(c, ty) == tag_box() || tag(c, ty) == tag_chain() {
                ints_push(st, targ(c, ty, 0));
                ints_push(sh, holder);
            }
            if is_record(c, ty) || is_enum(c, ty) {
                let edges = contained(c, ty);
                let mut k = 0;
                while k < ints_len(edges) {
                    ints_push(st, strip_array(c, field_ty_in(c, ty, ints_get(edges, k))));
                    ints_push(sh, holder);
                    k = k + 1;
                }
            }
        }
    }
    0 - 1
}

// Whether `name` is bound in the innermost scope: its frame and every frame it continues
// (`Scopes::defined_here`).
fn defined_here(c: Ck, name: Str) -> Bool {
    let mut f = ints_len(c.frames) - 1;
    let mut end = strs_len(c.sname);
    while f >= 0 {
        let mut i = ints_get(c.frames, f);
        while i < end {
            if strs_get(c.sname, i) == name { return true; }
            i = i + 1;
        }
        if ints_get(c.fjoin, f) == 0 { return false; }
        end = ints_get(c.frames, f);
        f = f - 1;
    }
    false
}

// Whether `name` is bound in the innermost frame itself (`bound_in_frame`).
fn bound_in_frame(c: Ck, name: Str) -> Bool {
    let mut i = ints_get(c.frames, ints_len(c.frames) - 1);
    while i < strs_len(c.sname) {
        if strs_get(c.sname, i) == name { return true; }
        i = i + 1;
    }
    false
}

// --- blocks and statements ----------------------------------------------------------------------

fn check_block(c: Ck, b: Int, expected: Int) -> Int {
    if gs(c, s_join()) == 1 {
        ss(c, s_join(), 0);
        open_joined_scope(c);
    } else {
        open_scope(c);
    }
    let completion = check_block_inner(c, b, expected);
    close_scope(c);
    completion
}

fn check_block_inner(c: Ck, b: Int, expected: Int) -> Int {
    let discard = gs(c, s_discard());
    ss(c, s_discard(), 0);
    let mut diverged = 0 - 1;
    let statements = kids(c, b, "statements");
    let mut i = 0;
    while i < ints_len(statements) {
        let s = ints_get(statements, i);
        if diverged >= 0 {
            err(c, "N0313", stmt_span(c, s), "this can never run", "");
            sec(c, diverged, "control leaves the block here");
            diverged = 0 - 1;
        }
        if check_stmt(c, s) { diverged = stmt_span(c, s); }
        i = i + 1;
    }
    if diverged >= 0 {
        if some(c, b, "tail") {
            let ts = espan(c, unwrap(c, b, "tail"));
            if sx_s(c.t, ts) != sx_e(c.t, ts) { err(c, "N0313", ts, "this can never run", ""); }
        }
        return diverges();
    }
    if some(c, b, "tail") {
        ss(c, s_unwanted(), discard);
        return check_expr(c, unwrap(c, b, "tail"), expected);
    }
    unit()
}

// One statement; whether it diverges.
fn check_stmt(c: Ck, s: Int) -> Bool {
    let k = kind_of(c, s);
    if sx_kind(c.t, s) != tk_tuple() {
        if k == "Break" { check_loop_control(c, "break", fld(c, s, "span")); }
        if k == "Continue" { check_loop_control(c, "continue", fld(c, s, "span")); }
        if k == "Break" || k == "Continue" { return true; }
        stop(c, cat3("the statement `", k, "`"));
        return false;
    }
    let n = sx_kid(c.t, s, 0);
    if k == "Expr" {
        ss(c, s_unwanted(), 1);
        return check_expr(c, n, none()) == diverges();
    }
    if k == "Let" {
        check_let(c, n);
        return false;
    }
    if k == "Assign" {
        check_assign(c, n);
        return false;
    }
    if k == "While" {
        check_while(c, n);
        return false;
    }
    if k == "For" {
        // A `for` always completes, as the `while` it means does.
        check_for(c, n);
        return false;
    }
    if k == "Return" {
        refuse_leaving_defer(c, "`return`", fld(c, n, "span"));
        check_return(c, n);
        return true;
    }
    // Run at every exit of the enclosing block (R1b, L12): it completes there, and leaves nothing —
    // no value, and no `return`, `?`, `break` or `continue` out. A value its last line produces is
    // discarded, as a loop body's is.
    if k == "Defer" {
        let saved = gs(c, s_defer());
        ss(c, s_defer(), gs(c, s_loop()) + 1);
        ss(c, s_discard(), 1);
        check_block(c, fld(c, n, "body"), none());
        ss(c, s_defer(), saved);
        return false;
    }
    // A scope joins every task it started, so it always completes — and a `break` inside one
    // still leaves the enclosing loop, exactly as a nested block does.
    if k == "Scope" {
        let body = fld(c, n, "body");
        ss(c, s_scope(), gs(c, s_scope()) + 1);
        let completion = check_block(c, body, none());
        ss(c, s_scope(), gs(c, s_scope()) - 1);
        if completion >= 0 && some(c, body, "tail") {
            err(c, "N0300", espan(c, unwrap(c, body, "tail")), cat3("a `scope` has no value, but this produces `", show(c, completion), "`"),
                    "add `;` to discard it, or send it through a channel");
        }
        return false;
    }
    if k == "Spawn" {
        check_spawn(c, n);
        return false;
    }
    stop(c, cat3("the statement `", k, "`"));
    false
}

fn check_let(c: Ck, l: Int) -> Int {
    let name = fname_of(c, l, "name");
    let value = fld(c, l, "value");
    let mut ty = 0;
    if some(c, l, "ty") {
        let want = resolve_written(c, unwrap(c, l, "ty"), c.tsn, c.tst, c.d);
        let got = value_type(c, value, want);
        if assignable(c, got, want) == false {
            err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is written `"), show(c, want), "`, but this is `", show(c, got), "`"), "");
        }
        ty = want;
    } else {
        ty = value_type(c, value, none());
    }
    let ns = fld(c, l, "name_span");
    if defined_here(c, name) {
        err(c, "N0202", ns, cat3("`", name, "` is already defined in this scope"),
                "Nazm allows shadowing in a nested scope but not in the same one, so a later mention of a name is never ambiguous");
    }
    define(c, name, ty, flag(c, l, "mutable"), sps(c, ns), spe(c, ns));
    sm_put(c.mvar, sps(c, ns), spe(c, ns), last_binding(c));
    0
}

fn check_assign(c: Ck, a: Int) -> Int {
    let place = fld(c, a, "place");
    let name = fname_of(c, place, "name");
    let ns = fld(c, place, "name_span");
    let value = fld(c, a, "value");
    let b = lookup_var(c, name, fld(c, place, "span"));
    // Seen through a closure as a copy: neither mutable nor declared where it could be made so.
    let copy = gs(c, s_captured()) == 1;
    // A static is read, never assigned (Gate 3): there are no mutable global variables.
    if b < 0 && static_named(c, name) >= 0 {
        err(c, "N0625", ns, cat3("`", name, "` is a static, and a static is never assigned"),
                "a static is read-only; one shared, changing value is a static `Atomic`, changed by `atomic_store` and the other atomic operations");
        sec(c, first_declared(c, name), "declared here");
        check_expr(c, value, none());
        return 0;
    }
    if b < 0 {
        err(c, "N0200", ns, cat3("`", name, "` is not defined"), "assignment changes an existing binding; `let` introduces one");
        check_expr(c, value, none());
        return 0;
    }
    note_var(c, sps(c, ns), spe(c, ns), b);
    let path = kids(c, place, "path");
    // The path as a message writes it (`shown_path`): fields by name, an index as `[…]`.
    let mut shown = "";
    let mut i = 0;
    while i < ints_len(path) {
        let step = ints_get(path, i);
        if sx_kind(c.t, step) != tk_tuple() {
            shown = str_concat(shown, "[…]");
        } else {
            if shown != "" { shown = str_concat(shown, "."); }
            shown = str_concat(shown, fname_of(c, sx_kid(c.t, step, 0), "name"));
        }
        i = i + 1;
    }
    // `xs[i] = v` on a sequence binding (R1, 5b.15): `vec_set(xs, i, v)` and its kin. A sequence
    // is a handle, so this needs no `mut`, as the call does not.
    if ints_len(path) == 1 && sx_kind(c.t, ints_get(path, 0)) != tk_tuple() {
        let step = ints_get(path, 0);
        let args = ints_new();
        let vf = fs();
        fa(vf, "name", sx_str(c.t, name));
        fa(vf, "span", ns);
        ints_push(args, mk_struct(c.t, "Var", vf));
        ints_push(args, fld(c, step, "index"));
        ints_push(args, value);
        ss(c, s_unwanted(), 1);
        if element_by_name(c, ints_get(c.sty, b), "set", fld(c, step, "span"), args, 0 - 1, none()) != no_element() { return 0; }
        ss(c, s_unwanted(), 0);
    }
    if ints_get(c.smut, b) == 0 || copy {
        let mut written = cat3("`", name, "` is not mutable");
        if ints_len(path) > 0 { written = cat5("`", name, "` is not mutable, so its `", shown, "` cannot be replaced"); }
        if ints_get(c.sds, b) >= 0 && copy == false {
            err(c, "N0310", ns, written, "bindings are immutable unless written `let mut`");
            sec_at(c, ints_get(c.sds, b), ints_get(c.sde, b), "declared here");
            dg_fix(c.d, ints_get(c.sds, b), ints_get(c.sde, b), str_concat("mut ", name), "make the binding mutable", "automatic",
                    "`mut` is the only thing making this assignment illegal, and adding it to a declaration changes nothing else about the program");
        } else {
            err(c, "N0310", ns, written,
                    "this is a parameter, and parameters are never mutable. Bind a local from it instead: `let mut n = n;`");
        }
    }
    let mut target = ints_get(c.sty, b);
    let mut ds = ints_get(c.sds, b);
    let mut de = ints_get(c.sde, b);
    if copy { ds = 0 - 1; }
    i = 0;
    while i < ints_len(path) {
        let raw = ints_get(path, i);
        if sx_kind(c.t, raw) != tk_tuple() {
            // An element of an array (Gate 2).
            if is_array(c, target) == false {
                err(c, "N0624", fld(c, raw, "span"), cat3("`[…]` indexes an array, and this is `", show(c, target), "`"), "");
                check_expr(c, value, none());
                return 0;
            }
            check_index_value(c, fld(c, raw, "index"), ta(c, target));
            target = array_elem(c, target);
        } else {
            let step = sx_kid(c.t, raw, 0);
            let t = check_projection(c, target, fname_of(c, step, "name"), fld(c, step, "name_span"));
            if t < 0 {
                check_expr(c, value, none());
                return 0;
            }
            let f = record_field(c, target, fname_of(c, step, "name"));
            ds = ints_get(c.fns, f);
            de = ints_get(c.fne, f);
            target = t;
        }
        i = i + 1;
    }
    let vt = value_type(c, value, target);
    if vt != target {
        let mut written = name;
        if ints_len(path) > 0 { written = cat3(name, ".", shown); }
        let want = show(c, target);
        err(c, "N0300", espan(c, value), cat5(cat3("`", written, "` is `"), want, "`, but this is `", show(c, vt), "`"), "");
        if ds >= 0 { sec_at(c, ds, de, cat3("declared `", want, "` here")); }
    }
    0
}

// `for x in e { … }` and `for i in a..b { … }` (`check_for`): an `Ints`, a `Strs` or a `Vec[T]`
// iterated, or `Int` bounds; the binding is the element, in the body's own scope.
fn check_for(c: Ck, f: Int) -> Int {
    let iter = fld(c, f, "iter");
    let mut element = t_int();
    if kind_of(c, iter) == "Range" {
        let bounds = ints_new();
        ints_push(bounds, fld(c, iter, "start"));
        ints_push(bounds, fld(c, iter, "end"));
        let mut i = 0;
        while i < 2 {
            let b = ints_get(bounds, i);
            let t = value_type(c, b, t_int());
            if t != t_int() {
                err(c, "N0300", espan(c, b), cat3("a range's bounds are `Int`s, but this is `", show(c, t), "`"), "convert it with `Int(…)`");
            }
            i = i + 1;
        }
    } else {
        let e = sx_kid(c.t, iter, 0);
        let t = value_type(c, e, none());
        // A `Bytes` gives its bytes, each a `UInt8`.
        let bytes = bname_of(c, t) == "Bytes";
        if bytes || tag(c, t) == tag_vec() || tag(c, t) == tag_chain() {
            if bytes { element = builtin_ty(c, "UInt8"); } else { element = targ(c, t, 0); }
            let fsp = fld(c, f, "name_span");
            sm_put(c.mfor, sps(c, fsp), spe(c, fsp), t);
        } else {
            err(c, "N0628", espan(c, e), cat3("a `for` loop cannot iterate `", show(c, t), "`"),
                    "a `for` loop iterates an `Ints`, a `Strs`, a `Vec[T]` or a `Bytes`, or integers written `a..b`");
        }
    }
    ss(c, s_loop(), gs(c, s_loop()) + 1);
    let body = fld(c, f, "body");
    open_scope(c);
    let ns = fld(c, f, "name_span");
    define(c, fname_of(c, f, "name"), element, false, sps(c, ns), spe(c, ns));
    sm_put(c.mvar, sps(c, ns), spe(c, ns), last_binding(c));
    // Its last line's value is discarded, as a `while` body's is (R1, 5b.19).
    ss(c, s_discard(), 1);
    check_block_inner(c, body, none());
    close_scope(c);
    ss(c, s_loop(), gs(c, s_loop()) - 1);
    0
}

fn check_while(c: Ck, w: Int) -> Int {
    let cond = fld(c, w, "cond");
    let ct = value_type(c, cond, t_bool());
    if ct != t_bool() {
        err(c, "N0301", espan(c, cond), cat3("a `while` condition must be `Bool`, but this is `", show(c, ct), "`"),
                "Nazm has no truthiness: use a comparison such as `i < n`");
    }
    ss(c, s_loop(), gs(c, s_loop()) + 1);
    ss(c, s_discard(), 1);
    check_block(c, fld(c, w, "body"), none());
    ss(c, s_loop(), gs(c, s_loop()) - 1);
    0
}

// The return type while an inferred body is checked: none yet.
fn no_return_type() -> Int { 0 - 5 }

fn check_return(c: Ck, r: Int) -> Int {
    let declared = gs(c, s_ret());
    if declared == no_return_type() {
        stop(c, "a `return` in a body whose result type is inferred");
        return 0;
    }
    let value = fld(c, r, "value");
    let actual = value_type(c, value, declared);
    if assignable(c, actual, declared) == false {
        err(c, "N0300", espan(c, value), cat5("this returns `", show(c, actual), "`, but the function returns `", show(c, declared), "`"),
                "`return` leaves the function, so its value must match the signature");
    }
    0
}

// `what` at `at` would leave the `defer` body being checked, if there is one (`N0631`).
fn refuse_leaving_defer(c: Ck, what: Str, at: Int) -> Int {
    if gs(c, s_defer()) == 0 { return 0; }
    err(c, "N0631", at, str_concat(what, " cannot leave a `defer` body"),
            "a `defer` body runs while its block is being left, by its end or by a `return`, `?`, `break` or `continue`; it finishes, and the leaving goes on")
}

fn check_loop_control(c: Ck, word: Str, span: Int) -> Int {
    if gs(c, s_defer()) == gs(c, s_loop()) + 1 {
        refuse_leaving_defer(c, cat3("`", word, "`"), span);
        return 0;
    }
    if gs(c, s_loop()) == 0 {
        err(c, "N0312", span, cat3("`", word, "` is only valid inside a loop"), cat3("there is no enclosing `while` for this `", word, "` to affect"));
    }
    0
}

// The type of an expression used where a value is required.
fn value_type(c: Ck, e: Int, expected: Int) -> Int {
    let k = check_expr(c, e, expected);
    if k >= 0 { return k; }
    if k == unit() {
        if is_empty_block(c, e) {
            err(c, "N0300", espan(c, e), "this produces no value",
                    "`{}` is an empty block here; it is an empty map only where a `Map` is expected, so write the type: `let m: Map[Str, Int] = {}`");
        } else {
            err(c, "N0300", espan(c, e), "this produces no value",
                    "an `if` used as a value needs an `else`, and a block used as one needs a final expression with no `;` after it");
        }
    }
    or_int(expected)
}

// Whether `e` is the block `{}`, with no statement and no final expression (R1.5, D5).
fn is_empty_block(c: Ck, e: Int) -> Bool {
    if sx_kind(c.t, e) != tk_tuple() || kind_of(c, e) != "Block" { return false; }
    let b = sx_kid(c.t, e, 0);
    ints_len(kids(c, b, "statements")) == 0 && some(c, b, "tail") == false
}

// `{}` where a `Map[K, V]` is expected (`empty_map`, R1.5, D5): the empty map, `hashmap_new()`
// checked at the braces' span, which Core IR lowering reads as that call. -1 for any other block,
// or where nothing, or something other than the standard hash map, is expected.
fn empty_map(c: Ck, b: Int, expected: Int) -> Int {
    if expected < 0 { return 0 - 1; }
    if ints_len(kids(c, b, "statements")) != 0 || some(c, b, "tail") { return 0 - 1; }
    if index_of_text(show(c, expected), "HashMap[") != 0 { return 0 - 1; }
    if callee_of(c, "hashmap_new") == 0 - 1 { return 0 - 1; }
    let span = fld(c, b, "span");
    let f = fs();
    fa(f, "qualifier", sx_none(c.t));
    fa(f, "callee", sx_str(c.t, "hashmap_new"));
    fa(f, "callee_span", span);
    fa(f, "type_args", sx_none(c.t));
    fa(f, "args", mk_list(c.t, ints_new()));
    fa(f, "span", span);
    let r = check_again(c, 0 - 1, 0 - 1, mk_struct(c.t, "Call", f), expected);
    if r >= 0 { return r; }
    or_int(expected)
}

fn or_int(expected: Int) -> Int {
    if expected >= 0 { return expected; }
    t_int()
}

// --- expressions --------------------------------------------------------------------------------

fn check_expr(c: Ck, e: Int, expected: Int) -> Int {
    // Checked already by the desugaring whose call this is an argument of (`take_checked`).
    if ints_len(c.cks) > 0 {
        let k = checked_index(c, espan(c, e));
        if k >= 0 {
            let t = ints_get(c.ckt, k);
            ints_remove(c.cks, k);
            ints_remove(c.cke, k);
            ints_remove(c.ckt, k);
            ss(c, s_unwanted(), 0);
            return t;
        }
    }
    let unwanted = gs(c, s_unwanted()) != 0;
    ss(c, s_unwanted(), 0);
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() {
        if k == "Block" {
            let em = empty_map(c, sx_kid(c.t, e, 0), expected);
            if em >= 0 { return em; }
            return check_block(c, sx_kid(c.t, e, 0), expected);
        }
        stop(c, cat3("the expression `", k, "`"));
        return or_int(expected);
    }
    if k == "Int" || k == "WideInt" {
        let lt = integer_literal(c, sx_text(c.t, fld(c, e, "value")), fld(c, e, "span"), expected);
        sm_put(c.mlit, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), lt);
        return lt;
    }
    // `Float32` where one is expected, `Float64` everywhere else (Gate 2).
    if k == "Float" {
        let mut ft = builtin_ty(c, "Float64");
        if expected >= 0 && bname_of(c, expected) == "Float32" { ft = expected; }
        // The literal's type, as the reference records it (`NumericFact::Literal`).
        sm_put(c.mlit, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), ft);
        return ft;
    }
    if k == "Bool" { return t_bool(); }
    // A literal is UTF-8 by construction, so it is a `Text` where one is expected (Gate 2).
    if k == "Str" {
        let ls = fld(c, e, "span");
        if expected >= 0 && bname_of(c, expected) == "Text" {
            sm_put(c.mlit, sps(c, ls), spe(c, ls), expected);
            return expected;
        }
        sm_put(c.mlit, sps(c, ls), spe(c, ls), t_str());
        return t_str();
    }
    if k == "BitNot" { return check_complement(c, e, expected); }
    if k == "Var" { return check_var(c, e, expected); }
    if k == "Neg" { return check_negation(c, e, expected); }
    if k == "Not" {
        let t = value_type(c, fld(c, e, "operand"), t_bool());
        if t != t_bool() { err(c, "N0304", fld(c, e, "op_span"), cat3("`!` applies to `Bool`, but this is `", show(c, t), "`"), ""); }
        return t_bool();
    }
    if k == "Binary" { return check_binary(c, e, expected); }
    if k == "Call" { return check_call(c, e, expected, unwanted); }
    if k == "Construct" {
        let t = check_construction(c, written_key(c, e, "ty"), fld(c, e, "ty_span"), type_args_of(c, e), written_inits(c, kids(c, e, "fields")),
                fld(c, e, "span"), expected);
        if t < 0 { return t_int(); }
        return t;
    }
    if k == "Variant" {
        let inits = written_inits(c, kids(c, e, "fields"));
        // `x.m()` and `Show.m()` (N78): a call when the name before the `.` is a value or a trait.
        if ints_len(inits.vals) == 0 && some(c, e, "type_args") == false && names_a_receiver(c, e) {
            return check_method_call(c, e, 0 - 1, none(), fname_of(c, e, "variant"), fld(c, e, "variant_span"), ints_new(), fld(c, e, "span"), expected);
        }
        let t = check_variant(c, written_key(c, e, "ty"), fld(c, e, "ty_span"), type_args_of(c, e), fname_of(c, e, "variant"), fld(c, e, "variant_span"),
                inits, fld(c, e, "span"), expected);
        if t < 0 { return or_int(expected); }
        return t;
    }
    if k == "Field" {
        let bt = value_type(c, fld(c, e, "base"), none());
        // Only C reads what a handle points to (N85).
        if is_opaque(c, bt) {
            let ns = fld(c, e, "name_span");
            opaque_refused(c, sps(c, ns), spe(c, ns), show(c, bt), "taken apart");
            return t_int();
        }
        let t = check_projection(c, bt, fname_of(c, e, "name"), fld(c, e, "name_span"));
        if t < 0 { return t_int(); }
        return t;
    }
    if k == "MethodCall" {
        return check_method_call(c, e, fld(c, e, "receiver"), none(), fname_of(c, e, "method"), fld(c, e, "method_span"), kids(c, e, "args"),
                fld(c, e, "span"), expected);
    }
    if k == "If" { return check_if(c, e, expected, unwanted); }
    if k == "Match" { return check_match(c, e, expected); }
    if k == "Propagate" { return check_propagate(c, e, expected); }
    if k == "Closure" { return check_closure(c, e, expected); }
    // `(a, b, …)` (L5): a tuple of the elements' types, each checked against the one expected
    // where a tuple of that many is expected.
    if k == "Tuple" {
        let elems = kids(c, e, "elems");
        let wanted = is_tuple(c, expected) && targc(c, expected) == ints_len(elems);
        let tys = ints_new();
        let mut i = 0;
        while i < ints_len(elems) {
            let mut want = none();
            if wanted { want = targ(c, expected, i); }
            ints_push(tys, value_type(c, ints_get(elems, i), want));
            i = i + 1;
        }
        return tuple_ty(c, tys);
    }
    // Arrays (Gate 2), and `xs[i]` on a sequence (R1, 5b.15).
    if k == "Array" { return check_array_literal(c, e, expected); }
    if k == "ArrayRepeat" { return check_array_repeat(c, e, expected); }
    if k == "Index" { return check_index(c, e, expected); }
    if k == "Interp" {
        // `f"…"` (L4), and what `print(x)` is written as: a `Str`, each hole a value
        // interpolation writes.
        let parts = kids(c, e, "parts");
        let mut i = 0;
        while i < ints_len(parts) {
            let part = ints_get(parts, i);
            if sx_kind(c.t, part) != tk_tuple() { check_hole(c, fld(c, part, "expr"), fld(c, part, "spec"), fld(c, part, "span")); }
            i = i + 1;
        }
        return t_str();
    }
    stop(c, cat3("the expression `", k, "`"));
    or_int(expected)
}

// A name written with an optional qualifier, as the key it is looked up by (`written_key`):
// `alias::name`.
fn written_key(c: Ck, n: Int, field: Str) -> Str {
    let name = fname_of(c, n, field);
    if some(c, n, "qualifier") { return cat3(fname_of(c, unwrap(c, n, "qualifier"), "name"), "::", name); }
    name
}

// One hole of an interpolation (`check_hole`): a precision only on a float; a `Str`, a number or
// a `Bool` written as it is, and anything else by its `Show` — which needs a trait, and no
// compilation the checker carries has one, so it is refused (N0300).
fn check_hole(c: Ck, expr: Int, spec: Int, at: Int) -> Int {
    let ty = value_type(c, expr, none());
    let float = is_float_name(bname_of(c, ty));
    if some(c, spec, "precision") && float == false {
        err(c, "N0006", at, cat3("a precision is a float's, and this is `", show(c, ty), "`"),
                "write the hole without `.precision`, or convert the value to a float");
    }
    if ty == t_str() || ty == t_int() || ty == t_bool() || is_num(c, ty) { return 0; }
    // Anything else is written by its `Show`, if it has one in scope.
    if lookup_method(c, ty, "show", at, false) < 0 {
        let shown = show(c, ty);
        err(c, "N0300", espan(c, expr), cat3("a value printed or interpolated is a `Str`, a number, a `Bool` or a `Show`, and this is `", shown, "`"),
                cat3("implement `Show` (`@std/show`) for `", shown, "`, or write the value's text yourself"));
        return 0;
    }
    let ret = check_method_call(c, expr, expr, ty, "show", at, ints_new(), at, none());
    if ret != t_str() { err(c, "N0300", at, cat3("this value's `show` gives `", show(c, ret), "`, not a `Str`"), ""); }
    0
}

fn check_var(c: Ck, e: Int, expected: Int) -> Int { check_var_named(c, fname_of(c, e, "name"), fld(c, e, "span"), expected) }

fn check_var_named(c: Ck, name: Str, span: Int, expected: Int) -> Int {
    let b = lookup_var(c, name, span);
    if b >= 0 {
        note_var(c, sps(c, span), spe(c, span), b);
        return ints_get(c.sty, b);
    }
    // A constant (Gate 2): its type.
    let k = strs_find(c.kname, name);
    if k >= 0 {
        note_const_ref(c, gs(c, s_module()), name, span);
        ints_push(c.uk, ints_get(c.kkind, k));
        ints_push(c.ui, ints_get(c.kint, k));
        strs_push(c.us, strs_get(c.kstr, k));
        sm_put(c.mconst, sps(c, span), spe(c, span), ints_len(c.uk) - 1);
        return kind_type(c, ints_get(c.kkind, k));
    }
    let callee = callee_of(c, name);
    if callee != 0 - 1 { return function_value(c, name, callee, span, expected); }
    if starts_upper(name) && ints_len(variant_owners(c, name)) > 0 {
        let t = check_construction(c, name, span, 0 - 1, no_inits(), span, expected);
        if t < 0 { return or_int(expected); }
        return t;
    }
    err(c, "N0200", span, cat3("`", name, "` is not defined"), "");
    or_int(expected)
}

// A named function written as a value (N50, `function_value`): non-generic and not a built-in.
// Its type is its signature's with its declared effects — or, undeclared, another module's
// assumed ones and this module's none, which effects analysis then holds it to.
fn function_value(c: Ck, name: Str, callee: Int, at: Int, expected: Int) -> Int {
    let mut why = "";
    if callee < 0 { why = "a built-in"; } else {
        if ints_get(c.fnfor, callee) == 1 { why = "a foreign function"; }
        if why == "" && ints_get(c.fntpc, callee) > 0 { why = "generic"; }
        // Its effect parameter is bound at each call, and a value has no call (N51).
        if why == "" && polymorphic(c, callee) { why = "polymorphic in its effects"; }
    }
    if why != "" {
        err(c, "N0387", at, cat5("`", name, "` is ", why, ", and cannot be used as a value"),
                cat5(cat3("call it as `", name, "(...)`, or write a closure that calls it: `fn(x: Int) -> Int { "), name, "(x) }`", "", ""));
        return or_int(expected);
    }
    let mut assumed = ints_get(c.fneff, callee);
    if assumed < 0 {
        assumed = 0;
        if ints_get(c.fnmod, callee) != gs(c, s_module()) {
            assumed = 3;
            if receives_foreign(c, callee) { assumed = 7; }
        }
    }
    let params = ints_new();
    let mut i = 0;
    while i < ints_get(c.fnpc, callee) {
        ints_push(params, ints_get(c.ptys, ints_get(c.fnpf, callee) + i));
        i = i + 1;
    }
    ints_push(c.vfn, callee);
    ints_push(c.vstart, sps(c, at));
    ints_push(c.vend, spe(c, at));
    ints_push(c.vassumed, assumed);
    let ty = fn_ty(c, params, ints_get(c.fnret, callee), assumed, 0 - 1);
    ints_push(c.vty, ty);
    ty
}

// A call through a binding of a function type (`check_indirect_call`).
fn check_indirect_call(c: Ck, name: Str, at: Int, args: Ints, span: Int) -> Int {
    let b = lookup_var(c, name, at);
    note_var(c, sps(c, at), spe(c, at), b);
    let t = ints_get(c.sty, b);
    let n = fn_arity(c, t);
    if ints_len(args) != n {
        let mut verb = " were given";
        if ints_len(args) == 1 { verb = " was given"; }
        err(c, "N0303", span, cat5(cat3("`", name, "` takes "), int_to_str(n), str_concat(" argument", plural(n)), ", but ",
                str_concat(int_to_str(ints_len(args)), verb)), "");
    }
    record_indirect_site(c, at, t);
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        let mut want = none();
        if i < n { want = targ(c, t, i); }
        let got = value_type(c, a, want);
        if want >= 0 && assignable(c, got, want) == false {
            err(c, "N0300", espan(c, a),
                    cat5(cat3("argument ", int_to_str(i + 1), " of `"), name, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "");
        }
        i = i + 1;
    }
    fn_ret(c, t)
}

// Whether a type as written was left out, as a short closure's are (R1.5, D3).
fn unwritten(c: Ck, w: Int) -> Bool {
    let span = fld(c, w, "span");
    fname_of(c, w, "name") == "_" && sx_s(c.t, span) == sx_e(c.t, span) && some(c, w, "args") == false
}

// A closure expression (N50, `check_closure`): a definition of its own, checked as a function
// is, with what its body names from around it captured.
fn check_closure(c: Ck, e: Int, expected: Int) -> Int {
    let enclosing = gs(c, s_fn());
    if enclosing < 0 { return or_int(expected); }
    let mut exp = 0 - 1;
    if is_fn(c, expected) { exp = expected; }
    let params = kids(c, e, "params");
    let ptys = ints_new();
    let mut i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let w = fld(c, p, "ty");
        let mut ty = t_int();
        if unwritten(c, w) {
            if exp >= 0 && i < fn_arity(c, exp) {
                ty = targ(c, exp, i);
            } else {
                let pn = fname_of(c, p, "name");
                err(c, "N0635", fld(c, p, "name_span"), cat3("write `", pn, "`'s type: no function type is expected here to take it from"),
                        cat3("`|", pn, ": Int| …`"));
            }
        } else {
            ty = resolve_written(c, w, c.tsn, c.tst, c.d);
        }
        ints_push(ptys, ty);
        i = i + 1;
    }
    let rt = fld(c, e, "return_type");
    let short = unwritten(c, rt);
    let infer_ret = short && exp < 0;
    let mut ret = t_int();
    if short {
        if exp >= 0 { ret = fn_ret(c, exp); }
    } else {
        ret = resolve_written(c, rt, c.tsn, c.tst, c.d);
    }
    let mut effects = 0;
    let mut ws = 0 - 1;
    let mut we = 0 - 1;
    if some(c, e, "effects") {
        let decl = unwrap(c, e, "effects");
        effects = declared_effects(c, decl);
        if effects < 0 { effects = 0; }
        ws = sps(c, fld(c, decl, "span"));
        we = spe(c, fld(c, decl, "span"));
    } else {
        if short && exp >= 0 { effects = ta(c, exp); }
    }
    let mut base = strs_get(c.fnname, enclosing);
    let hash = index_of_text(base, "#");
    if hash >= 0 { base = str_slice(base, 0, hash); }
    let count = gs(c, s_closures());
    ss(c, s_closures(), count + 1);
    let mut ty = fn_ty(c, ptys, ret, effects, eparam(c));
    let id = strs_len(c.fnname);
    let fs = fld(c, e, "fn_span");
    strs_push(c.fnname, cat3(base, "#", int_to_str(count)));
    ints_push(c.fnmod, gs(c, s_module()));
    ints_push(c.fnclos, enclosing);
    ints_push(c.fnpb, 0 - 1);
    sm_put(c.mclo, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), id);
    ints_push(c.fnmeth, 0);
    ints_push(c.fnfor, 0);
    ints_push(c.fnexp, 0);
    ints_push(c.fnpub, 0);
    ints_push(c.fnns, sps(c, fs));
    ints_push(c.fnne, spe(c, fs));
    ints_push(c.fnnode, e);
    ints_push(c.fnpf, ints_len(c.ptys));
    ints_push(c.fnpc, ints_len(ptys));
    i = 0;
    while i < ints_len(ptys) {
        ints_push(c.ptys, ints_get(ptys, i));
        i = i + 1;
    }
    ints_push(c.fnret, ret);
    ints_push(c.fnnores, 0);
    ints_push(c.fneff, effects);
    ints_push(c.fnws, ws);
    ints_push(c.fnwe, we);
    ints_push(c.fntpf, strs_len(c.tpname));
    ints_push(c.fntpc, 0);
    // The closure's body is a function of its own: its own returns, loops and scopes.
    let saved_fn = gs(c, s_fn());
    let saved_ret = gs(c, s_ret());
    let saved_rs = gs(c, s_rs());
    let saved_loop = gs(c, s_loop());
    // A closure in a `defer` body is a function of its own, which may return (L12).
    let saved_defer = gs(c, s_defer());
    ss(c, s_defer(), 0);
    let saved_scope = gs(c, s_scope());
    ss(c, s_scope(), 0);
    ss(c, s_fn(), id);
    ss(c, s_ret(), ret);
    ss(c, s_rs(), fld(c, rt, "span"));
    ss(c, s_loop(), 0);
    let frame = ints_len(c.cfid);
    ints_push(c.cfid, id);
    ints_push(c.cfbound, strs_len(c.sname));
    open_scope(c);
    ints_set(c.fnpb, id, ints_len(c.bfn));
    i = 0;
    while i < ints_len(params) {
        let p = ints_get(params, i);
        let pn = fname_of(c, p, "name");
        if defined_here(c, pn) {
            err(c, "N0202", fld(c, p, "span"), cat3("`", pn, "` is listed twice in this parameter list"), "");
        }
        define(c, pn, ints_get(ptys, i), false, 0 - 1, 0 - 1);
        declared_at(c, fld(c, p, "name_span"));
        i = i + 1;
    }
    let body = fld(c, e, "body");
    ss(c, s_discard(), 0);
    let mut want = ret;
    if infer_ret { want = none(); }
    let completion = check_block(c, body, want);
    let rts = fld(c, rt, "span");
    if completion >= 0 {
        if infer_ret {
            ty = fn_ty(c, ptys, completion, effects, eparam(c));
            ints_set(c.fnret, id, completion);
        } else {
            if completion != ret {
                let mut at = fld(c, body, "span");
                if some(c, body, "tail") { at = espan(c, unwrap(c, body, "tail")); }
                err(c, "N0300", at, cat5("this closure returns `", show(c, completion), "`, but its type says `", show(c, ret), "`"), "");
                sec(c, rts, cat3("declared `", show(c, ret), "` here"));
            }
        }
    }
    if completion == unit() {
        err(c, "N0300", fld(c, body, "span"), cat3("this closure must produce a `", show(c, ret), "`, but its body does not"), "");
        sec(c, rts, cat3("declared `", show(c, ret), "` here"));
    }
    close_scope(c);
    ints_pop(c.cfid);
    ints_pop(c.cfbound);
    while ints_len(c.capf) > 0 && ints_get(c.capf, ints_len(c.capf) - 1) == frame {
        ints_pop(c.capf);
        ints_pop(c.capb);
    }
    ss(c, s_fn(), saved_fn);
    ss(c, s_ret(), saved_ret);
    ss(c, s_rs(), saved_rs);
    ss(c, s_loop(), saved_loop);
    ss(c, s_defer(), saved_defer);
    ss(c, s_scope(), saved_scope);
    ints_push(c.clid, id);
    ints_push(c.clty, ty);
    ty
}

fn index_of_text(s: Str, part: Str) -> Int {
    let n = str_len(part);
    let mut i = 0;
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == part { return i; }
        i = i + 1;
    }
    0 - 1
}

// --- contracts (N87, §7.88; `check/function.rs`, `check/clauses.rs`) ---------------------------

// A function's contract clauses (`check_contracts`): each a `Bool`; a `requires` over the
// parameters, an `ensures` over them and `result`; each made only of what cannot fail for want of
// authority or memory (N0614).
fn check_contracts(c: Ck, f: Int, declared: Int) -> Int {
    let cs = kids(c, f, "contracts");
    // `result`, the value being returned: one binding of the function's own, made at the first
    // `ensures` and named by every one.
    let mut result = 0 - 1;
    let mut i = 0;
    while i < ints_len(cs) {
        let ct = ints_get(cs, i);
        let ensures = sx_text(c.t, fld(c, ct, "kind")) == "Ensures";
        if ensures {
            open_scope(c);
            if result < 0 {
                let ks = fld(c, ct, "keyword_span");
                define(c, "result", declared, false, sps(c, ks), spe(c, ks));
                result = last_binding(c);
                ints_push(c.crfn, gs(c, s_fn()));
                ints_push(c.crb, result);
            } else {
                strs_push(c.sname, "result");
                ints_push(c.sty, declared);
                ints_push(c.smut, 0);
                ints_push(c.sds, 0 - 1);
                ints_push(c.sde, 0 - 1);
                ints_push(c.sbid, result);
            }
        }
        let e = fld(c, ct, "expr");
        let got = value_type(c, e, t_bool());
        if got != t_bool() {
            err(c, "N0300", espan(c, e), cat3("a contract clause is a `Bool`, but this is `", show(c, got), "`"),
                    "a clause states a condition: compare, or combine with `&&`, `||`, `!`");
        }
        let what = strs_new();
        let at = impure_clause(c, e, what);
        if at >= 0 {
            dg_error(c.d, "N0614", sps(c, at), spe(c, at), str_concat("a contract clause cannot ", strs_get(what, 0)), "not a contract's",
                    "a clause is evaluated every time the function is entered or returns, and must not fail for want of authority or memory: it is literals, names, operators, field reads and calls of functions declaring `! {}`");
        }
        if ensures { close_scope(c); }
        i = i + 1;
    }
    0
}

fn impure(what: Strs, why: Str, span: Int) -> Int {
    strs_push(what, why);
    span
}

// The first part of a clause a contract may not contain (`impure_clause`): its span, with what it
// is pushed to `what`; -1 for none.
fn impure_clause(c: Ck, e: Int, what: Strs) -> Int {
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() {
        if k == "Block" { return impure(what, "contain a block", fld(c, sx_kid(c.t, e, 0), "span")); }
        stop(c, cat3("the expression `", k, "` in a contract"));
        return 0 - 1;
    }
    if k == "Int" || k == "WideInt" || k == "Float" || k == "Bool" || k == "Str" || k == "Var" { return 0 - 1; }
    if k == "Neg" || k == "Not" || k == "BitNot" { return impure_clause(c, fld(c, e, "operand"), what); }
    if k == "Array" || k == "ArrayRepeat" || k == "Tuple" || k == "Interp" || k == "Construct" || k == "Variant" {
        return impure(what, "build a value", fld(c, e, "span"));
    }
    if k == "Index" {
        let b = impure_clause(c, fld(c, e, "base"), what);
        if b >= 0 { return b; }
        return impure_clause(c, fld(c, e, "index"), what);
    }
    if k == "Binary" {
        let l = impure_clause(c, fld(c, e, "lhs"), what);
        if l >= 0 { return l; }
        return impure_clause(c, fld(c, e, "rhs"), what);
    }
    if k == "Field" { return impure_clause(c, fld(c, e, "base"), what); }
    if k == "Call" {
        let name = fname_of(c, e, "callee");
        let mut target = 0 - 1;
        if some(c, e, "qualifier") { target = qualified_callee(c, fname_of(c, unwrap(c, e, "qualifier"), "name"), name); } else { target = callee_of(c, name); }
        let mut pure = false;
        if target >= 0 { pure = ints_get(c.fneff, target) == 0; }
        if target <= 0 - 2 {
            let b = strs_get(c.bname, 0 - 2 - target);
            pure = b == "str_len" || b == "str_byte" || b == "ints_len" || b == "ints_get" || b == "strs_len" || b == "vec_len" || b == "vec_get";
        }
        if pure == false { return impure(what, "call a function that is not pure", fld(c, e, "callee_span")); }
        let args = kids(c, e, "args");
        let mut i = 0;
        while i < ints_len(args) {
            let a = impure_clause(c, ints_get(args, i), what);
            if a >= 0 { return a; }
            i = i + 1;
        }
        return 0 - 1;
    }
    if k == "Closure" { return impure(what, "make a closure", fld(c, e, "span")); }
    if k == "Match" || k == "If" { return impure(what, "branch; write the condition with `&&` and `||`", fld(c, e, "span")); }
    if k == "Propagate" { return impure(what, "propagate a failure", fld(c, e, "op_span")); }
    if k == "MethodCall" { return impure(what, "call a method", fld(c, e, "span")); }
    stop(c, cat3("the expression `", k, "` in a contract"));
    0 - 1
}

// A clause's value over literal arguments (`literal`): kind 1 an `Int`, 2 a `Bool`, 0 none, at
// slot 0, the value at slot 1. `names`/`vals`/`kinds` are the parameters' literals.
fn lit(kind: Int, v: Int) -> Ints {
    let out = ints_new();
    ints_push(out, kind);
    ints_push(out, v);
    out
}

fn lit_int(c: Ck, w: Ints) -> Ints {
    if kind_fits(k_int(), w) == false { return lit(0, 0); }
    lit(1, w_to_int(w))
}

fn literal(c: Ck, e: Int, names: Strs, kinds: Ints, vals: Ints) -> Ints {
    if sx_kind(c.t, e) == tk_tuple() { return lit(0, 0); }
    let k = kind_of(c, e);
    if k == "Int" { return lit_int(c, w_parse(sx_text(c.t, fld(c, e, "value")))); }
    if k == "Bool" {
        if sx_text(c.t, fld(c, e, "value")) == "true" { return lit(2, 1); }
        return lit(2, 0);
    }
    if k == "Var" {
        let at = strs_find(names, fname_of(c, e, "name"));
        if at < 0 { return lit(0, 0); }
        return lit(ints_get(kinds, at), ints_get(vals, at));
    }
    if k == "Neg" {
        let o = literal(c, fld(c, e, "operand"), names, kinds, vals);
        if ints_get(o, 0) != 1 { return lit(0, 0); }
        return lit_int(c, w_negate(w_from_int(ints_get(o, 1))));
    }
    if k == "Not" {
        let o = literal(c, fld(c, e, "operand"), names, kinds, vals);
        if ints_get(o, 0) != 2 { return lit(0, 0); }
        return lit(2, 1 - ints_get(o, 1));
    }
    if k != "Binary" { return lit(0, 0); }
    let op = sx_text(c.t, fld(c, e, "op"));
    let l = literal(c, fld(c, e, "lhs"), names, kinds, vals);
    if ints_get(l, 0) == 0 { return lit(0, 0); }
    if op == "And" && ints_get(l, 0) == 2 && ints_get(l, 1) == 0 { return lit(2, 0); }
    if op == "Or" && ints_get(l, 0) == 2 && ints_get(l, 1) == 1 { return lit(2, 1); }
    let r = literal(c, fld(c, e, "rhs"), names, kinds, vals);
    if ints_get(r, 0) == 0 || ints_get(r, 0) != ints_get(l, 0) { return lit(0, 0); }
    let a = ints_get(l, 1);
    let b = ints_get(r, 1);
    if ints_get(l, 0) == 2 {
        if op == "And" { return lit(2, a * b); }
        if op == "Or" { return lit(2, eff_union(a, b)); }
        if op == "Eq" { if a == b { return lit(2, 1); } return lit(2, 0); }
        if op == "NotEq" { if a != b { return lit(2, 1); } return lit(2, 0); }
        return lit(0, 0);
    }
    let wa = w_from_int(a);
    let wb = w_from_int(b);
    if op == "Add" { return lit_int(c, w_add(wa, wb)); }
    if op == "Sub" { return lit_int(c, w_sub(wa, wb)); }
    if op == "Mul" { return lit_int(c, w_mul(wa, wb)); }
    if op == "Div" || op == "Rem" {
        if b == 0 { return lit(0, 0); }
        if op == "Div" { return lit_int(c, w_quot(wa, wb)); }
        // `checked_rem` refuses `Int`'s least value by -1, whose quotient overflows.
        if kind_fits(k_int(), w_quot(wa, wb)) == false { return lit(0, 0); }
        return lit_int(c, w_rem(wa, wb));
    }
    let mut t = 0 - 1;
    if op == "Eq" { if a == b { t = 1; } else { t = 0; } }
    if op == "NotEq" { if a != b { t = 1; } else { t = 0; } }
    if op == "Lt" { if a < b { t = 1; } else { t = 0; } }
    if op == "LtEq" { if a <= b { t = 1; } else { t = 0; } }
    if op == "Gt" { if a > b { t = 1; } else { t = 0; } }
    if op == "GtEq" { if a >= b { t = 1; } else { t = 0; } }
    if t >= 0 { return lit(2, t); }
    if op == "BitAnd" { return lit(1, w_to_int(w_wrapped(m_bitwise(w_bits(wa, 64), w_bits(wb, 64), 0), 64, true))); }
    if op == "BitOr" { return lit(1, w_to_int(w_wrapped(m_bitwise(w_bits(wa, 64), w_bits(wb, 64), 1), 64, true))); }
    if op == "BitXor" { return lit(1, w_to_int(w_wrapped(m_bitwise(w_bits(wa, 64), w_bits(wb, 64), 2), 64, true))); }
    if op == "Shl" || op == "Shr" {
        if b < 0 || b >= 64 { return lit(0, 0); }
        let p = w_pow2(b);
        if op == "Shl" { return lit(1, w_to_int(w_wrapped(w_mul(w_bits(wa, 64), p), 64, true))); }
        let q = w_quot(wa, p);
        if a < 0 && m_is_zero(w_rem(wa, p)) == false { return lit(1, w_to_int(w_sub(q, w_parse("1")))); }
        return lit(1, w_to_int(q));
    }
    lit(0, 0)
}

// A clause as a reader writes it, for a witness: its shape, not its source text (`describe_clause`).
fn describe_clause(c: Ck, e: Int) -> Str {
    if sx_kind(c.t, e) == tk_tuple() { return "…"; }
    let k = kind_of(c, e);
    if k == "Int" {
        let w = w_parse(sx_text(c.t, fld(c, e, "value")));
        if kind_fits(k_int(), w) { return int_to_str(w_to_int(w)); }
        return "…";
    }
    if k == "Bool" {
        if sx_text(c.t, fld(c, e, "value")) == "true" { return "true"; }
        return "false";
    }
    if k == "Var" { return fname_of(c, e, "name"); }
    if k == "Neg" { return str_concat("-", describe_clause(c, fld(c, e, "operand"))); }
    if k == "Not" { return str_concat("!", describe_clause(c, fld(c, e, "operand"))); }
    if k == "Binary" {
        let op = sx_text(c.t, fld(c, e, "op"));
        let mut o = "";
        if op == "Add" { o = "+"; }
        if op == "Sub" { o = "-"; }
        if op == "Mul" { o = "*"; }
        if op == "Div" { o = "/"; }
        if op == "Rem" { o = "%"; }
        if op == "Eq" { o = "=="; }
        if op == "NotEq" { o = "!="; }
        if op == "Lt" { o = "<"; }
        if op == "LtEq" { o = "<="; }
        if op == "Gt" { o = ">"; }
        if op == "GtEq" { o = ">="; }
        if op == "And" { o = "&&"; }
        if op == "Or" { o = "||"; }
        if op == "BitAnd" { o = "&"; }
        if op == "BitOr" { o = "|"; }
        if op == "BitXor" { o = "^"; }
        if op == "Shl" { o = "<<"; }
        if op == "Shr" { o = ">>"; }
        return cat5(describe_clause(c, fld(c, e, "lhs")), " ", o, " ", describe_clause(c, fld(c, e, "rhs")));
    }
    "…"
}

// A call whose arguments are all literals, of a function of this module stating a precondition
// (`prove_preconditions`): each clause evaluated with them; a false one is `N0615`.
fn prove_preconditions(c: Ck, at: Int, target: Int, args: Ints) -> Int {
    if target < 0 || ints_get(c.fnmod, target) != gs(c, s_module()) || ints_get(c.fnclos, target) >= 0 { return 0; }
    let f = ints_get(c.fnnode, target);
    let clauses = ints_new();
    let cs = kids(c, f, "contracts");
    let mut i = 0;
    while i < ints_len(cs) {
        if sx_text(c.t, fld(c, ints_get(cs, i), "kind")) == "Requires" { ints_push(clauses, fld(c, ints_get(cs, i), "expr")); }
        i = i + 1;
    }
    if ints_len(clauses) == 0 { return 0; }
    let params = kids(c, f, "params");
    if ints_len(args) != ints_len(params) { return 0; }
    let names = strs_new();
    let kinds = ints_new();
    let vals = ints_new();
    i = 0;
    while i < ints_len(args) {
        let v = literal(c, ints_get(args, i), strs_new(), ints_new(), ints_new());
        if ints_get(v, 0) == 0 { return 0; }
        strs_push(names, fname_of(c, ints_get(params, i), "name"));
        ints_push(kinds, ints_get(v, 0));
        ints_push(vals, ints_get(v, 1));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(clauses) {
        let cl = ints_get(clauses, i);
        let v = literal(c, cl, names, kinds, vals);
        if ints_get(v, 0) != 2 { return 0; }
        if ints_get(v, 1) == 0 {
            err(c, "N0615", at, "this call breaks its callee's precondition", "with these literal arguments the call fails every time it runs (`N0410`)");
            sec(c, espan(c, cl), "false for these arguments");
            return 0;
        }
        i = i + 1;
    }
    // Every clause holds: the call's obligation is proved, with each clause as evaluated.
    let held = strs_new();
    i = 0;
    while i < ints_len(clauses) {
        strs_push(held, str_concat(describe_clause(c, ints_get(clauses, i)), " holds"));
        i = i + 1;
    }
    let shown = strs_new();
    i = 0;
    while i < strs_len(names) {
        let mut v = int_to_str(ints_get(vals, i));
        if ints_get(kinds, i) == 2 {
            v = "false";
            if ints_get(vals, i) == 1 { v = "true"; }
        }
        strs_push(shown, cat3(strs_get(names, i), " = ", v));
        i = i + 1;
    }
    ints_push(c.rix.pcs, sps(c, at));
    ints_push(c.rix.pce, spe(c, at));
    strs_push(c.rix.pcw, cat3(str_join(held, ", "), " with ", str_join(shown, ", ")));
    0
}

pub fn ck_proved_call_count(c: Ck) -> Int { ints_len(c.rix.pcs) }
pub fn ck_proved_call_start(c: Ck, i: Int) -> Int { ints_get(c.rix.pcs, i) }
pub fn ck_proved_call_end(c: Ck, i: Int) -> Int { ints_get(c.rix.pce, i) }
pub fn ck_proved_call_witness(c: Ck, i: Int) -> Str { strs_get(c.rix.pcw, i) }

// --- arrays and indexing (Gate 2; `check/operators.rs`) -----------------------------------------

// The element type an expected array type gives, or -1.
fn expected_element(c: Ck, expected: Int) -> Int {
    if is_array(c, expected) { return array_elem(c, expected); }
    0 - 1
}

// `[a, b, c]` (`check_array_literal`): where a sequence is wanted, that sequence (R1, 5b.16);
// where no fixed array is expected, a list — a `Vec` of its first element's type (R1.5, D6); and
// where one is, an array of the element expected.
fn check_array_literal(c: Ck, e: Int, expected: Int) -> Int {
    let t = array_literal(c, e, expected);
    sm_put(c.marr, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), t);
    t
}

fn array_literal(c: Ck, e: Int, expected: Int) -> Int {
    let elems = kids(c, e, "elems");
    let span = fld(c, e, "span");
    if expected >= 0 && tag(c, expected) == tag_vec() {
        let elem = targ(c, expected, 0);
        let mut i = 0;
        while i < ints_len(elems) {
            let x = ints_get(elems, i);
            let t = value_type(c, x, elem);
            if assignable(c, t, elem) == false {
                err(c, "N0300", espan(c, x), cat5(cat3("this `", show(c, expected), "`'s elements are `"), show(c, elem), "`, and this is `", show(c, t), "`"), "");
            }
            i = i + 1;
        }
        return expected;
    }
    let want = expected_element(c, expected);
    if want < 0 {
        if ints_len(elems) == 0 {
            err(c, "N0618", span, "an empty list needs its element type written", "write the type where it is bound: `let v: List[Int] = []`");
            return or_int(expected);
        }
        let elem = value_type(c, ints_get(elems, 0), none());
        let mut i = 1;
        while i < ints_len(elems) {
            let x = ints_get(elems, i);
            let t = value_type(c, x, elem);
            if assignable(c, t, elem) == false {
                err(c, "N0300", espan(c, x), cat5("this list's elements are `", show(c, elem), "`, and this is `", show(c, t), "`"), "");
            }
            i = i + 1;
        }
        return vec_of(c, elem);
    }
    if ints_len(elems) == 0 {
        err(c, "N0618", span, "an array has at least one element", "an empty collection is a `Vec`: `vec_new[Int]()`");
        return or_int(expected);
    }
    let elem = value_type(c, ints_get(elems, 0), want);
    let mut i = 1;
    while i < ints_len(elems) {
        let x = ints_get(elems, i);
        let t = value_type(c, x, elem);
        if t != elem { err(c, "N0300", espan(c, x), cat5("this array's elements are `", show(c, elem), "`, and this is `", show(c, t), "`"), ""); }
        i = i + 1;
    }
    let t = array_of(c, elem, ints_len(elems));
    array_refusal(c, t, sps(c, span), spe(c, span), c.d);
    t
}

// `[value; count]` (`check_array_repeat`): `count` copies, `count` a literal or a constant.
fn check_array_repeat(c: Ck, e: Int, expected: Int) -> Int {
    let span = fld(c, e, "span");
    let elem = value_type(c, fld(c, e, "value"), expected_element(c, expected));
    let n = array_length(c, fld(c, e, "count"), c.d);
    if n < 0 { return array_of(c, elem, 1); }
    let t = array_of(c, elem, n);
    array_refusal(c, t, sps(c, span), spe(c, span), c.d);
    sm_put(c.marr, sps(c, span), spe(c, span), t);
    t
}

// An index's type, which is an `Int`, and a constant one's range against an array of `len`
// elements, -1 for none (`check_index_value`).
fn check_index_value(c: Ck, index: Int, len: Int) -> Int {
    let it = value_type(c, index, t_int());
    if it != t_int() {
        err(c, "N0300", espan(c, index), cat3("an index is an `Int`, and this is `", show(c, it), "`"), "");
        return 0;
    }
    let mut known = false;
    let mut v = 0;
    if sx_kind(c.t, index) != tk_tuple() {
        if kind_of(c, index) == "Int" {
            known = true;
            v = parse_int(sx_text(c.t, fld(c, index, "value")));
        }
        if kind_of(c, index) == "Neg" {
            let o = fld(c, index, "operand");
            if sx_kind(c.t, o) != tk_tuple() && kind_of(c, o) == "Int" {
                known = true;
                v = 0 - parse_int(sx_text(c.t, fld(c, o, "value")));
            }
        }
    }
    if known && len >= 0 {
        if v < 0 || v >= len {
            err(c, "N0624", espan(c, index), cat5("index ", int_to_str(v), " is outside an array of ", int_to_str(len), " elements"), "");
        }
    }
    0
}

// `base[index]` (`check_index`): an element of an array, or of a sequence or a map by name.
fn check_index(c: Ck, e: Int, expected: Int) -> Int {
    let base = fld(c, e, "base");
    let index = fld(c, e, "index");
    let bracket = fld(c, e, "bracket_span");
    let before = dg_len(c.d);
    let bt = value_type(c, base, none());
    let array = is_array(c, bt);
    if array == false && dg_len(c.d) == before {
        let args = ints_new();
        ints_push(args, base);
        ints_push(args, index);
        let t = element_by_name(c, bt, "get", bracket, args, base, expected);
        if t != no_element() { return t; }
    }
    let mut len = 0 - 1;
    if array { len = ta(c, bt); }
    check_index_value(c, index, len);
    if array { return array_elem(c, bt); }
    let mut help = "";
    if bname_of(c, bt) == "Bytes" { help = "a `Bytes`'s byte is read with `bytes_get(b, i)`"; }
    if tag(c, bt) == tag_vec() { help = "a `Vec`'s element is read with `vec_get(xs, i)`"; }
    err(c, "N0624", bracket, cat3("`[…]` indexes an array, and this is `", show(c, bt), "`"), help);
    or_int(expected)
}

// The last expression checked already at `span` and not yet taken, or -1 (`take_checked`).
fn checked_index(c: Ck, span: Int) -> Int {
    let s = sps(c, span);
    let e = spe(c, span);
    let mut k = ints_len(c.cks) - 1;
    while k >= 0 {
        if ints_get(c.cks, k) == s && ints_get(c.cke, k) == e { return k; }
        k = k - 1;
    }
    0 - 1
}

fn ints_remove(xs: Ints, k: Int) -> Int {
    let mut i = k;
    while i + 1 < ints_len(xs) {
        ints_set(xs, i, ints_get(xs, i + 1));
        i = i + 1;
    }
    ints_pop(xs);
    0
}

// `call`, a desugaring's, checked with `pre` — one of its arguments, checked already, of type
// `pt` (-1 for none) — not checked again (`check_again`).
fn check_again(c: Ck, pre: Int, pt: Int, call: Int, expected: Int) -> Int {
    let mark = ints_len(c.cks);
    if pre >= 0 {
        ints_push(c.cks, sps(c, espan(c, pre)));
        ints_push(c.cke, spe(c, espan(c, pre)));
        ints_push(c.ckt, pt);
    }
    let t = check_expr(c, call, expected);
    while ints_len(c.cks) > mark {
        ints_pop(c.cks);
        ints_pop(c.cke);
        ints_pop(c.ckt);
    }
    t
}

// What `element_by_name` answers where no function of the name is in scope.
fn no_element() -> Int { 0 - 3 }

// `xs[i]` and `xs[i] = v` by name (`element_by_name`, R1 5b.15): the call `<prefix>_<op>(args…)`
// keyed by the brackets' span — `vec_`, `bytes_`, or a type's name in lower case, whose read is
// `<prefix>_at`, or `<prefix>_at_or` with the value type's zero where a compound update reads
// it. `no_element()` where no such function is in scope.
fn element_by_name(c: Ck, of: Int, op: Str, bracket: Int, args: Ints, pre: Int, expected: Int) -> Int {
    let mut name = "";
    if tag(c, of) == tag_vec() {
        name = cat3("vec_", op, "");
    } else {
        if bname_of(c, of) == "Bytes" {
            name = cat3("bytes_", op, "");
        } else {
            let shown = show(c, of);
            let cut = index_of_text(shown, "[");
            let mut prefix = shown;
            if cut >= 0 { prefix = str_slice(shown, 0, cut); }
            prefix = str_lower(prefix);
            if str_len(prefix) == 0 { return no_element(); }
            let mut i = 0;
            while i < str_len(prefix) {
                let b = str_byte(prefix, i);
                if (b >= 48 && b <= 57) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90) { i = i + 1; } else { return no_element(); }
            }
            let mut value = 0 - 1;
            if targc(c, of) > 0 { value = targ(c, of, targc(c, of) - 1); }
            let compound = sx_s(c.t, bracket) == sx_e(c.t, bracket);
            if op == "get" {
                let mut zero = 0 - 1;
                if value >= 0 { zero = zero_of(c, value, bracket); }
                if zero >= 0 && compound && callee_of(c, cat3(prefix, "_at_or", "")) != 0 - 1 {
                    ints_push(args, zero);
                    sm_put(c.mzero, sps(c, bracket), spe(c, bracket), zero);
                    name = cat3(prefix, "_at_or", "");
                } else {
                    name = cat3(prefix, "_at", "");
                }
            } else {
                name = cat3(prefix, "_", op);
            }
        }
    }
    if callee_of(c, name) == 0 - 1 { return no_element(); }
    let f = fs();
    fa(f, "qualifier", sx_none(c.t));
    fa(f, "callee", sx_str(c.t, name));
    fa(f, "callee_span", bracket);
    fa(f, "type_args", sx_none(c.t));
    fa(f, "args", mk_list(c.t, args));
    fa(f, "span", bracket);
    let t = check_again(c, pre, of, mk_struct(c.t, "Call", f), expected);
    if t >= 0 { return t; }
    or_int(expected)
}

// The zero a compound update of a map's absent entry starts from (`zero_of`): `0`, `0.0` or `""`
// written at `span`, or -1 for any other type.
fn zero_of(c: Ck, t: Int, span: Int) -> Int {
    let n = bname_of(c, t);
    let f = fs();
    if n == "Str" {
        fa(f, "value", sx_str(c.t, ""));
        fa(f, "span", span);
        return mk_struct(c.t, "Str", f);
    }
    if is_float_name(n) {
        fa(f, "text", sx_str(c.t, "0.0"));
        fa(f, "span", span);
        return mk_struct(c.t, "Float", f);
    }
    if is_num_name(n) {
        fa(f, "value", sx_atom(c.t, "0"));
        fa(f, "span", span);
        return mk_struct(c.t, "Int", f);
    }
    0 - 1
}

fn check_negation(c: Ck, e: Int, expected: Int) -> Int {
    let operand = fld(c, e, "operand");
    // `-128` written where an `Int8` is expected is one literal, judged whole — and past `Int`'s
    // digits, for an `Int128`.
    if sx_kind(c.t, operand) != tk_tuple() && (kind_of(c, operand) == "Int" || kind_of(c, operand) == "WideInt") {
        if expected >= 0 && is_integer(c, expected) && expected != t_int() {
            let ls = fld(c, operand, "span");
            let lt = integer_literal(c, str_concat("-", sx_text(c.t, fld(c, operand, "value"))), ls, expected);
            // The literal's type, as the reference records it of the literal (`NumericFact`).
            sm_put(c.mlit, sps(c, ls), spe(c, ls), lt);
            return lt;
        }
    }
    let mut hint = t_int();
    if expected >= 0 && is_num(c, expected) { hint = expected; }
    let t = value_type(c, operand, hint);
    if is_num(c, t) == false {
        err(c, "N0304", fld(c, e, "op_span"), cat3("`-` applies to a number, but this is `", show(c, t), "`"), "");
        return t_int();
    }
    t
}

// `~operand` (Gate 2).
fn check_complement(c: Ck, e: Int, expected: Int) -> Int {
    let mut hint = t_int();
    if expected >= 0 && is_integer(c, expected) { hint = expected; }
    let t = value_type(c, fld(c, e, "operand"), hint);
    if is_integer(c, t) == false {
        err(c, "N0304", fld(c, e, "op_span"), cat3("`~` applies to an integer, but this is `", show(c, t), "`"), "");
        return t_int();
    }
    t
}

// An integer literal's type (Gate 2): the integer type expected, where one is, and `Int`
// everywhere else — refused, by name, when its value does not fit that type.
fn integer_literal(c: Ck, digits: Str, span: Int, expected: Int) -> Int {
    let mut k = k_int();
    if expected >= 0 && is_integer(c, expected) { k = k_num(bname_of(c, expected)); }
    let w = w_parse(digits);
    if kind_fits(k, w) == false {
        err(c, "N0003", span, cat5("`", w_show(w), "` does not fit in `", kind_name(k), "`"),
                cat4(cat3("`", kind_name(k), "` holds "), kind_lo(k), " to ", kind_hi(k)));
    }
    kind_type(c, k)
}

// A shift by a constant amount outside `0..width` (Gate 2): it would stop the program every time
// it ran, so it is refused where it is written (`N0617`).
fn refuse_constant_shift(c: Ck, lt: Int, amount: Int) -> Int {
    if is_integer(c, lt) == false || sx_kind(c.t, amount) == tk_tuple() { return 0; }
    let mut n = "";
    if kind_of(c, amount) == "Int" { n = sx_text(c.t, fld(c, amount, "value")); }
    if kind_of(c, amount) == "Neg" {
        let o = fld(c, amount, "operand");
        if sx_kind(c.t, o) != tk_tuple() && kind_of(c, o) == "Int" { n = str_concat("-", sx_text(c.t, fld(c, o, "value"))); }
    }
    if n == "" { return 0; }
    let k = k_num(bname_of(c, lt));
    let bits = kind_bits(k);
    let w = w_parse(n);
    if w_neg_of(w) || w_cmp(w, w_from_int(bits)) >= 0 {
        err(c, "N0617", espan(c, amount), cat4(cat3("`", kind_name(k), "` cannot be shifted by "), w_show(w), "", ""),
                cat5(cat3("a shift's amount is 0 to ", int_to_str(bits - 1), " for a `"), kind_name(k),
                "`; a larger or negative one stops the program (`N0412`) rather than being masked", "", ""));
    }
    0
}

fn is_number_literal(c: Ck, e: Int) -> Bool {
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() { return false; }
    if k == "Int" || k == "WideInt" || k == "Float" { return true; }
    if k == "Neg" { return is_number_literal(c, fld(c, e, "operand")); }
    false
}

fn is_comparison(op: Str) -> Bool { op == "Eq" || op == "NotEq" || op == "Lt" || op == "LtEq" || op == "Gt" || op == "GtEq" }
fn is_logical(op: Str) -> Bool { op == "And" || op == "Or" }
fn is_equality(op: Str) -> Bool { op == "Eq" || op == "NotEq" }
fn is_order(op: Str) -> Bool { op == "Lt" || op == "LtEq" || op == "Gt" || op == "GtEq" }

fn symbol(op: Str) -> Str {
    if op == "Add" { return "+"; }
    if op == "Sub" { return "-"; }
    if op == "Mul" { return "*"; }
    if op == "Div" { return "/"; }
    if op == "Rem" { return "%"; }
    if op == "Eq" { return "=="; }
    if op == "NotEq" { return "!="; }
    if op == "Lt" { return "<"; }
    if op == "LtEq" { return "<="; }
    if op == "Gt" { return ">"; }
    if op == "GtEq" { return ">="; }
    if op == "And" { return "&&"; }
    if op == "Or" { return "||"; }
    if op == "BitAnd" { return "&"; }
    if op == "BitOr" { return "|"; }
    if op == "BitXor" { return "^"; }
    if op == "Shl" { return "<<"; }
    ">>"
}

fn check_binary(c: Ck, e: Int, expected: Int) -> Int {
    let op = sx_text(c.t, fld(c, e, "op"));
    let lhs = fld(c, e, "lhs");
    let rhs = fld(c, e, "rhs");
    let op_span = fld(c, e, "op_span");
    let shift = op == "Shl" || op == "Shr";
    let before = dg_len(c.d);
    let mut hint = none();
    if is_comparison(op) == false && is_logical(op) == false {
        if expected >= 0 && is_num(c, expected) { hint = expected; }
    }
    let lit_first = is_number_literal(c, lhs) && is_number_literal(c, rhs) == false;
    let str_first = kind_of(c, lhs) == "Str" && kind_of(c, rhs) != "Str";
    let mut lt = 0;
    let mut rt = 0;
    // A shift's amount is an `Int`, whatever its value's type.
    if shift {
        let mut h = none();
        if hint >= 0 && is_integer(c, hint) { h = hint; }
        lt = value_type(c, lhs, h);
        rt = value_type(c, rhs, t_int());
        refuse_constant_shift(c, lt, rhs);
    }
    if shift == false && (lit_first || str_first) {
        rt = value_type(c, rhs, hint);
        let mut h = hint;
        if takes_literal(c, rt) { h = rt; }
        lt = value_type(c, lhs, h);
    }
    if shift == false && lit_first == false && str_first == false {
        lt = value_type(c, lhs, hint);
        let mut h = hint;
        if takes_literal(c, lt) { h = lt; }
        rt = value_type(c, rhs, h);
    }
    // `s + t` on two `Str`s (R1, 5b.6): `str_concat(s, t)`, a `Str`, its operands checked once.
    if op == "Add" && lt == t_str() && rt == t_str() && dg_len(c.d) == before {
        // A call of it, keyed by the `+`, as the reference records the call it is read as.
        let target = callee_of(c, "str_concat");
        if target != 0 - 1 { record_site(c, op_span, target); }
        return t_str();
    }
    let mut ok = false;
    if op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem" { ok = lt == rt && is_num(c, lt); }
    if is_order(op) { ok = lt == rt && ordering(c, lt) == ""; }
    if op == "BitAnd" || op == "BitOr" || op == "BitXor" { ok = lt == rt && is_integer(c, lt); }
    if shift { ok = is_integer(c, lt) && rt == t_int(); }
    if is_equality(op) { ok = lt == rt && derived(c, lt, true) == ""; }
    if is_logical(op) { ok = lt == t_bool() && rt == t_bool(); }
    if ok {
        if is_comparison(op) || is_logical(op) { return t_bool(); }
        return lt;
    }
    let mut verb = "combine";
    if is_comparison(op) { verb = "compare"; }
    let slt = show(c, lt);
    let srt = show(c, rt);
    let mut blocked = "";
    if lt == rt {
        if is_equality(op) { blocked = derived(c, lt, true); }
        if is_order(op) { blocked = ordering(c, lt); }
    }
    let mut property = "order";
    if is_equality(op) { property = "equality"; }
    let mut detail = "";
    if blocked != "" && derived_path(c, blocked) != "" {
        detail = cat5(cat3("`", symbol(op), "` does not apply to `"), slt, "`: its `", derived_path(c, blocked),
                cat4("` is a `", show(c, derived_type(c, blocked)), "`, which has no ", property));
    } else {
        if lt == rt { detail = cat5("`", symbol(op), "` does not apply to `", slt, "`"); } else {
            detail = cat5(cat3("`", symbol(op), "` cannot "), verb, " `", slt, cat3("` with `", srt, "`"));
        }
    }
    // A type parameter without a requirement is the one blocker the author can lift where they
    // stand, by declaring it (N14).
    let mut help = "";
    if blocked != "" && is_equality(op) && tag(c, derived_type(c, blocked)) == tag_param() {
        let p = show(c, derived_type(c, blocked));
        help = cat5("`", p, "` is not known to have equality, because its declaration does not require it; a definition that compares one declares `",
                p, ": Equality`");
    }
    err(c, "N0304", op_span, detail, help);
    sec(c, espan(c, lhs), cat3("this is `", slt, "`"));
    sec(c, espan(c, rhs), cat3("this is `", srt, "`"));
    if expected >= 0 { return expected; }
    if is_comparison(op) || is_logical(op) { return t_bool(); }
    if is_num(c, lt) { return lt; }
    t_int()
}

fn takes_literal(c: Ck, t: Int) -> Bool { is_num(c, t) || bname_of(c, t) == "Text" }

fn ordering(c: Ck, t: Int) -> Str {
    if is_float_name(bname_of(c, t)) { return ""; }
    derived(c, t, false)
}

fn check_if(c: Ck, e: Int, expected: Int, unwanted: Bool) -> Int {
    let cond = fld(c, e, "cond");
    let ct = value_type(c, cond, t_bool());
    if ct != t_bool() {
        err(c, "N0301", espan(c, cond), cat3("an `if` condition must be `Bool`, but this is `", show(c, ct), "`"),
                "Nazm has no truthiness: use a comparison such as `x != 0`");
    }
    let then_block = fld(c, e, "then_block");
    if unwanted { ss(c, s_discard(), 1); } else { ss(c, s_discard(), 0); }
    let a = check_block(c, then_block, expected);
    if some(c, e, "else_block") == false { return unit(); }
    let else_block = unwrap(c, e, "else_block");
    if unwanted { ss(c, s_discard(), 1); } else { ss(c, s_discard(), 0); }
    let mut want = expected;
    if want < 0 && a >= 0 { want = a; }
    if unwanted { want = none(); }
    let b = check_block(c, else_block, want);
    if a == diverges() { return b; }
    if b == diverges() { return a; }
    if a >= 0 && b >= 0 && a == b { return a; }
    if unwanted && (a >= 0 || b >= 0) { return unit(); }
    if a >= 0 && b >= 0 {
        let sa = show(c, a);
        let sb = show(c, b);
        let mut at = fld(c, else_block, "span");
        if some(c, else_block, "tail") { at = espan(c, unwrap(c, else_block, "tail")); }
        let mut other = fld(c, then_block, "span");
        if some(c, then_block, "tail") { other = espan(c, unwrap(c, then_block, "tail")); }
        err(c, "N0302", at, cat5("this branch is `", sb, "`, but the other is `", sa, "`"), "both branches of an `if` must have the same type");
        sec(c, other, cat3("this one is `", sa, "`"));
        return a;
    }
    if a >= 0 || b >= 0 {
        let mut v = a;
        if b >= 0 { v = b; }
        err(c, "N0302", fld(c, e, "span"), cat3("one branch produces `", show(c, v), "` and the other produces nothing"),
                "both branches of an `if` must agree, or neither may produce a value");
        return v;
    }
    unit()
}

// --- calls ----------------------------------------------------------------------------------------

// What a name calls: a function of this module (0 and up), a built-in (-2 and down), or nothing.
fn callee_of(c: Ck, name: Str) -> Int {
    let f = defined_fn(c, gs(c, s_module()), name);
    if f >= 0 { return f; }
    let imported = strs_find(c.envname, name);
    if imported >= 0 { return ints_get(c.envfn, imported); }
    let b = builtin_index(c, name);
    if b >= 0 { return 0 - 2 - b; }
    0 - 1
}

fn env_has(c: Ck, name: Str) -> Bool { callee_of(c, name) != 0 - 1 }

// What `alias::name` calls: an export of the module imported under `alias`, or -1.
fn qualified_callee(c: Ck, alias: Str, name: Str) -> Int {
    let a = strs_find(c.alname, alias);
    if a < 0 { return 0 - 1; }
    let m = ints_get(c.almod, a);
    let ofns = ints_new();
    let onames = strs_new();
    offered_fns(c, m, ofns, onames);
    let at = strs_find(onames, name);
    if at < 0 { return 0 - 1; }
    ints_get(ofns, at)
}

// `NAME::item` that resolves to nothing (N0210): `NAME` is no alias, or its module exports no
// `item`.
fn unknown_qualified(c: Ck, d: Diags, key: Str, aliases: Strs, s: Int, e: Int, what: Str) -> Int {
    let mut i = 0;
    while i + 1 < str_len(key) && str_slice(key, i, i + 2) != "::" { i = i + 1; }
    let alias = str_slice(key, 0, i);
    let item = str_slice(key, i + 2, str_len(key));
    if strs_find(aliases, alias) >= 0 {
        return dg_error(d, "N0210", s, e, cat5("the module imported as `", alias, "` exports no ", what, cat3(" `", item, "`")), "",
                cat3("`", alias, "::` names what that module marks `pub`; check the name, or export it there"));
    }
    dg_error(d, "N0210", s, e, cat3("`", alias, "` is not the name of an imported module"), "",
            cat3("import one under that name: `use \"path.nz\" as ", alias, ";`"))
}

fn sorted(xs: Strs) -> Strs {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(xs) {
        let x = strs_get(xs, i);
        let mut at = 0;
        while at < strs_len(out) && str_less(strs_get(out, at), x) { at = at + 1; }
        insert_str(out, at, x);
        i = i + 1;
    }
    out
}

// Why this module cannot call `name` when something in the compilation has it (`why_invisible`),
// reported; false when nothing does. A private function of a module this one imports is N0206;
// an exported one of a module it does not import, N0201 with where it is.
fn why_invisible(c: Ck, name: Str, at: Int) -> Bool {
    // R1a's sequence built-ins, renamed with their type by R1.5 (D7): only after resolution
    // failed, so a module's own function of one of these names keeps it.
    let mut renamed = "";
    if name == "list_from_vec" { renamed = "chain_from_vec"; }
    if name == "list_empty" { renamed = "chain_empty"; }
    if name == "list_len" { renamed = "chain_len"; }
    if name == "list_get" { renamed = "chain_get"; }
    if renamed != "" {
        err(c, "N0637", at, cat5("`", name, "` is now `", renamed, "`"),
                cat3("R1a's immutable sequence is `Chain[T]` and its built-ins `chain_`; write `", renamed,
                "`. `List[T]` now names the growable list, `Vec[T]`"));
        return true;
    }
    let m = gs(c, s_module());
    let mut elsewhere = 0 - 1;
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if strs_get(c.fnname, f) == name {
            let owner = ints_get(c.fnmod, f);
            if imports_module(c, m, owner) && ints_get(c.fnpub, f) == 0 {
                err(c, "N0206", at, cat3("`", name, "` is private to the module that defines it"),
                        cat3("write `pub fn ", name, "` there to export it, if it is meant to be part of that module's interface"));
                sec_at(c, ints_get(c.fnns, f), ints_get(c.fnne, f), "defined privately here");
                return true;
            }
            if imports_module(c, m, owner) == false && owner != m && ints_get(c.fnpub, f) == 1 { elsewhere = f; }
        }
        f = f + 1;
    }
    if elsewhere < 0 { return false; }
    err(c, "N0201", at, cat3("`", name, "` is not defined in this module"),
            "imports are not transitive: add a `use` for the module that exports it");
    sec_at(c, ints_get(c.fnns, elsewhere), ints_get(c.fnne, elsewhere), "exported here, by a module this one does not import");
    true
}

// A numeric conversion (Gate 2): `T(x)` exactly, or `try_convert[T](x)`, `wrap_convert[T](x)`,
// `saturate_convert[T](x)`; `Text(s)` and `try_convert[Text](s)`.
// An attempt to build a capability, which nothing but the runtime may (N37).
fn forged(c: Ck, k: Str, at: Int) -> Int {
    err(c, "N0370", at, cat3("`", k, "` is a capability, and a capability cannot be constructed"),
            cat5("authority comes only from `main`: give it ", cap_article(cap_bit(k)), " `", k, "` parameter, which the runtime supplies, and pass that to what needs it"))
}

fn check_conversion(c: Ck, name: Str, at: Int, has_targs: Bool, targs: Int, args: Ints, span: Int) -> Int {
    let exact = name != "try_convert" && name != "wrap_convert" && name != "saturate_convert";
    let mut to = t_int();
    if exact {
        if has_targs { not_generic(c, c.d, name, "a conversion, not generic", at); }
        to = builtin_ty(c, name);
    } else {
        let mut written = ints_new();
        if has_targs { written = sx_items(c.t, targs); }
        if ints_len(written) == 1 {
            let t = resolve_written(c, ints_get(written, 0), c.tsn, c.tst, c.d);
            let text = bname_of(c, t) == "Text" && name == "try_convert";
            if is_num(c, t) == false && text == false {
                err(c, "N0300", at, cat5("`", name, "` converts to a numeric type, and `", show(c, t), "` is not one"), "");
            } else {
                to = t;
            }
        } else {
            err(c, "N0354", at, cat3("`", name, "` needs the type it converts to, written"), cat3("write it as `", name, "[UInt8](x)`"));
        }
    }
    let n = ints_len(args);
    if n != 1 {
        let mut verb = " were given";
        if n == 1 { verb = " was given"; }
        err(c, "N0303", span, cat4("`", name, "` takes 1 argument, but ", str_concat(int_to_str(n), verb)), "");
    }
    // A literal converted exactly is that literal, written at the target type.
    let text_to = bname_of(c, to) == "Text";
    let mut hint = none();
    if exact && text_to == false { hint = to; }
    let mut from = t_int();
    let mut i = 0;
    while i < n {
        let t = value_type(c, ints_get(args, i), hint);
        if i == 0 { from = t; }
        i = i + 1;
    }
    if text_to {
        if from != t_str() && n > 0 {
            err(c, "N0300", espan(c, ints_get(args, 0)), cat5("`", name, "` converts a `Str` to `Text`, and this is `", show(c, from), "`"), "");
        }
    } else {
        if is_num(c, from) == false {
            if n > 0 { err(c, "N0300", espan(c, ints_get(args, 0)), cat5("`", name, "` converts a number, but this is `", show(c, from), "`"), ""); }
        } else {
            if name == "wrap_convert" && (is_integer(c, from) && is_integer(c, to)) == false {
                err(c, "N0300", at, cat5("`wrap_convert` is between integer types, and this converts `", show(c, from), "` to `", show(c, to), "`"),
                        "a float converts by `T(x)`, `try_convert` or `saturate_convert`");
            }
        }
    }
    let mut mode = "exact";
    if name == "try_convert" { mode = "try"; }
    if name == "wrap_convert" { mode = "wrap"; }
    if name == "saturate_convert" { mode = "saturate"; }
    let mut result = to;
    if name == "try_convert" {
        let a = ints_new();
        ints_push(a, to);
        result = enum_ty(c, declared_enum(c, prelude(c), "Option"), a);
    }
    ints_push(c.cvto, to);
    strs_push(c.cvmode, mode);
    ints_push(c.cvres, result);
    sm_put(c.mconv, sps(c, at), spe(c, at), ints_len(c.cvto) - 1);
    result
}

fn is_conversion(name: Str) -> Bool {
    name == "try_convert" || name == "wrap_convert" || name == "saturate_convert" || name == "Text" || is_num_name(name)
}

fn check_call(c: Ck, e: Int, expected: Int, unwanted: Bool) -> Int {
    // `m::f` is looked up as one key (N49); everything below names it as written.
    let qualified = some(c, e, "qualifier");
    let mut callee = fname_of(c, e, "callee");
    // A binding of function type of that name hides a function of it (N50): the call is through
    // the value.
    if qualified == false && some(c, e, "type_args") == false {
        let b = lookup(c, callee);
        if b >= 0 && is_fn(c, ints_get(c.sty, b)) {
            return check_indirect_call(c, callee, fld(c, e, "callee_span"), kids(c, e, "args"), fld(c, e, "span"));
        }
    }
    let mut target = 0 - 1;
    if qualified {
        let alias = fname_of(c, unwrap(c, e, "qualifier"), "name");
        target = qualified_callee(c, alias, callee);
        callee = cat3(alias, "::", callee);
    } else {
        target = callee_of(c, callee);
    }
    let cs = fld(c, e, "callee_span");
    let span = fld(c, e, "span");
    let args = kids(c, e, "args");
    let has_targs = some(c, e, "type_args");
    let mut targs = 0 - 1;
    if has_targs { targs = unwrap(c, e, "type_args"); }
    if target == 0 - 1 && is_conversion(callee) { return check_conversion(c, callee, cs, has_targs, targs, args, span); }
    if qualified == false && ints_len(args) > 0 && starts_upper(callee) && target == 0 - 1 {
        if is_record(c, quiet_type(c, callee, cs)) || ints_len(variant_owners(c, callee)) > 0 {
            let t = check_construction(c, callee, cs, targs, positional_inits(c, args), span, expected);
            if t < 0 { return or_int(expected); }
            return t;
        }
    }
    if target >= 0 {
        if ints_get(c.fnnores, target) == 1 && unwanted == false {
            err(c, "N0300", span, cat3("`", callee, "` returns nothing, so this call has no value to use"),
                    cat3("call it as a statement of its own, or give `", callee, "` a result type"));
        }
    }
    if target == 0 - 1 {
        if qualified {
            unknown_qualified(c, c.d, callee, sorted(c.alname), sps(c, cs), spe(c, cs), "function");
        } else {
            if why_invisible(c, callee, cs) == false {
                // `IoCap()`: the question is where authority comes from (N37).
                if is_cap_name(callee) { forged(c, callee, cs); } else { err(c, "N0201", cs, cat3("`", callee, "` is not a function"), ""); }
            }
        }
        let mut i = 0;
        while i < ints_len(args) {
            check_expr(c, ints_get(args, i), none());
            i = i + 1;
        }
        return or_int(expected);
    }
    // The callee's signature: its parameters' types, its result, where it is declared (a
    // built-in at no place, 0..0), and whose type parameters they mention.
    let formals = ints_new();
    let mut ret = 0;
    let mut ds = 0;
    let mut de = 0;
    let mut generics = 0;
    let mut owner = own_fn();
    let mut oid = target;
    if target >= 0 {
        let pf = ints_get(c.fnpf, target);
        let mut k = 0;
        while k < ints_get(c.fnpc, target) {
            ints_push(formals, ints_get(c.ptys, pf + k));
            k = k + 1;
        }
        ret = ints_get(c.fnret, target);
        ds = ints_get(c.fnns, target);
        de = ints_get(c.fnne, target);
        generics = ints_get(c.fntpc, target);
    } else {
        let bi = 0 - 2 - target;
        if ints_get(c.bok, bi) == 0 {
            stop(c, cat3("the built-in `", callee, "`"));
            return or_int(expected);
        }
        note_flow(c, bi);
        generics = ints_get(c.bgen, bi);
        owner = own_builtin();
        oid = bi;
        if generics > 0 {
            let tp = param_ty(c, own_builtin(), bi, 0, "T");
            let shapes = split(strs_get(c.bshapes, bi), 44);
            let mut k = 0;
            while k < strs_len(shapes) {
                if strs_get(shapes, k) != "" { ints_push(formals, shape_of(c, strs_get(shapes, k), tp)); }
                k = k + 1;
            }
            ret = shape_of(c, strs_get(c.bretshape, bi), tp);
        } else {
            let pf = ints_get(c.bpf, bi);
            let mut k = 0;
            while k < ints_get(c.bpc, bi) {
                ints_push(formals, ints_get(c.ptys, pf + k));
                k = k + 1;
            }
            ret = ints_get(c.bret, bi);
        }
    }
    let pc = ints_len(formals);
    if ints_len(args) != pc {
        let mut verb = " were given";
        if ints_len(args) == 1 { verb = " was given"; }
        err(c, "N0303", span, cat5(cat3("`", callee, "` takes "), int_to_str(pc), str_concat(" argument", plural(pc)), ", but ",
                str_concat(int_to_str(ints_len(args)), verb)), "");
        sec_at(c, ds, de, "defined here");
    }
    // A callee polymorphic in its effects is called as a generic one is: each call binds it (N51).
    let mut poly = false;
    if target >= 0 { poly = polymorphic(c, target); }
    if generics > 0 || poly {
        let call = Call(name: callee, at: cs, span: span, args: args, formals: formals, ret: ret, owner: owner, oid: oid, n: generics,
                ds: ds, de: de, target: target, poly: poly);
        return check_generic_call(c, call, targs, expected);
    }
    if has_targs { not_generic(c, c.d, callee, "not generic", cs); }
    record_site(c, cs, target);
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        let mut want = none();
        if i < pc { want = ints_get(formals, i); }
        let got = value_type(c, a, want);
        if want >= 0 && assignable(c, got, want) == false {
            err(c, "N0300", espan(c, a),
                    cat5(cat3("argument ", int_to_str(i + 1), " of `"), callee, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "");
        }
        i = i + 1;
    }
    if target >= 0 { check_callbacks(c, target, args, formals); }
    prove_preconditions(c, cs, target, args);
    ret
}

// A call of a foreign function passes each callback as an export's name (`check_callbacks`, N85):
// a closure, a function value held in a binding, or a function that is not an export is `N0612`.
fn check_callbacks(c: Ck, target: Int, args: Ints, formals: Ints) -> Int {
    if ints_get(c.fnfor, target) == 0 { return 0; }
    let mut i = 0;
    while i < ints_len(args) && i < ints_len(formals) {
        if is_fn(c, ints_get(formals, i)) {
            let at = espan(c, ints_get(args, i));
            let mut export = false;
            let mut v = 0;
            while v < ints_len(c.vfn) {
                if ints_get(c.vstart, v) == sps(c, at) && ints_get(c.vend, v) == spe(c, at) { export = ints_get(c.fnexp, ints_get(c.vfn, v)) == 1; }
                v = v + 1;
            }
            if export == false {
                dg_error(c.d, "N0612", sps(c, at), spe(c, at), "a callback C calls is the name of an export", "not an export",
                        "write the name of a `pub extern \"C\" fn … ! {} = \"symbol\" { … }`: its C entry needs no environment and lives as long as the process, which a closure or another function value does not");
            }
        }
        i = i + 1;
    }
    0
}

// `spawn f(args);` (`check_spawn`): the call by the ordinary rule, inside a `scope`, with only
// what may cross into a task passed.
fn check_spawn(c: Ck, s: Int) -> Int {
    let callee = fname_of(c, s, "callee");
    let cs = fld(c, s, "callee_span");
    let span = fld(c, s, "span");
    let args = kids(c, s, "args");
    if gs(c, s_scope()) == 0 {
        err(c, "N0320", span, "`spawn` is only valid inside a `scope`",
                "a task outside a scope would be detached work, and nothing would join it; wrap it in `scope { … }`");
    }
    let target = callee_of(c, callee);
    let mut generics = 0;
    if target >= 0 { generics = ints_get(c.fntpc, target); }
    if target < 0 - 1 { generics = ints_get(c.bgen, 0 - 2 - target); }
    if target == 0 - 1 || generics > 0 {
        if target == 0 - 1 {
            if callee == "list_from_vec" || callee == "list_empty" || callee == "list_len" || callee == "list_get" || is_cap_name(callee) {
                stop(c, "a renamed built-in or a capability spawned");
                return 0;
            }
            if why_invisible(c, callee, cs) == false { err(c, "N0201", cs, cat3("`", callee, "` is not a function"), ""); }
        } else {
            err(c, "N0101", cs, cat3("`spawn ", callee, "` runs a generic function, which is not supported yet"),
                    "a task runs a function that is not generic. Spawn a non-generic wrapper that calls the generic one");
            // The callee was resolved, and the call recorded, before the refusal.
            if target >= 0 {
                ints_push(c.rix.eus, sps(c, cs));
                ints_push(c.rix.eue, spe(c, cs));
                ints_push(c.rix.eui, target);
            }
        }
        let mut i = 0;
        while i < ints_len(args) {
            check_expr(c, ints_get(args, i), none());
            i = i + 1;
        }
        return 0;
    }
    let formals = ints_new();
    let mut ds = 0;
    let mut de = 0;
    if target >= 0 {
        let pf = ints_get(c.fnpf, target);
        let mut k = 0;
        while k < ints_get(c.fnpc, target) {
            ints_push(formals, ints_get(c.ptys, pf + k));
            k = k + 1;
        }
        ds = ints_get(c.fnns, target);
        de = ints_get(c.fnne, target);
    } else {
        let bi = 0 - 2 - target;
        if ints_get(c.bok, bi) == 0 {
            stop(c, cat3("the built-in `", callee, "` spawned"));
            return 0;
        }
        note_flow(c, bi);
        let pf = ints_get(c.bpf, bi);
        let mut k = 0;
        while k < ints_get(c.bpc, bi) {
            ints_push(formals, ints_get(c.ptys, pf + k));
            k = k + 1;
        }
    }
    record_site(c, cs, target);
    ints_set(c.sspawn, ints_len(c.sspawn) - 1, 1);
    let pc = ints_len(formals);
    if ints_len(args) != pc {
        let mut verb = " were given";
        if ints_len(args) == 1 { verb = " was given"; }
        err(c, "N0303", span, cat5(cat3("`", callee, "` takes "), int_to_str(pc), str_concat(" argument", plural(pc)), ", but ",
                str_concat(int_to_str(ints_len(args)), verb)), "");
        sec_at(c, ds, de, "defined here");
    }
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        let mut want = none();
        if i < pc { want = ints_get(formals, i); }
        let got = value_type(c, a, want);
        if want >= 0 && assignable(c, got, want) == false {
            err(c, "N0300", espan(c, a),
                    cat5(cat3("argument ", int_to_str(i + 1), " of `"), callee, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "");
        }
        let why = task_safety(c, got);
        if why != "" {
            let shown = show(c, got);
            let mut message = cat3("a `", shown, "` may not be passed to a task");
            if derived_path(c, why) != "" {
                message = cat5(cat3("a `", shown, "` may not be passed to a task: its `"), derived_path(c, why), "` is a `", show(c, derived_type(c, why)), "`");
            }
            err(c, "N0321", espan(c, a), message,
                    "`Ints`, `Strs` and every `Vec[T]` are handles to shared mutable storage with no synchronisation, and a record or enum containing one at any depth inherits that — as does a type parameter, about which nothing is known. For an enum it is every variant that counts, not the one the value currently holds: what a task is given is a value of a type, and the guarantee is about the type. Pass `Int`, `Bool` or `Str` values, a `Chan`, or a record or enum whose every field may cross");
        }
        i = i + 1;
    }
    0
}

// --- method calls (N78, `check_method_call`) -----------------------------------------------------

// Whether `name.m()` written as a variant names a receiver (`names_a_receiver`): a value in scope,
// or — when no enum of that name is visible — a trait.
fn names_a_receiver(c: Ck, e: Int) -> Bool {
    let key = written_key(c, e, "ty");
    if some(c, e, "qualifier") == false && lookup(c, key) >= 0 { return true; }
    let t = type_named(c, key);
    if t >= 0 {
        if is_enum(c, t) { return false; }
    }
    let at = strs_find(c.tsname, key);
    if at < 0 { return false; }
    ints_get(c.tsid, at) >= 0
}

// `recv.m(args)`, or `Trait.m(recv, args)` where the receiver as written is a trait's name. `e`
// holds the qualifier; `recv` is the receiver, or -1 for the name `e` writes as a variant's type;
// `known` is the receiver's type where it was already checked (an interpolation's hole).
fn check_method_call(c: Ck, e: Int, recv: Int, known: Int, method: Str, at: Int, args: Ints, span: Int, expected: Int) -> Int {
    let fallback = or_int(expected);
    // The receiver as a name: `Show.show(x)` when it names a trait and no value.
    let mut rname = "";
    let mut rspan = 0 - 1;
    if recv < 0 {
        rname = fname_of(c, e, "ty");
        rspan = fld(c, e, "ty_span");
    } else {
        if known < 0 && kind_of(c, recv) == "Var" {
            rname = fname_of(c, recv, "name");
            rspan = fld(c, recv, "span");
        }
    }
    let mut ufcs = 0 - 1;
    if rname != "" && (some(c, e, "qualifier") || lookup(c, rname) < 0) {
        let mut key = rname;
        if some(c, e, "qualifier") { key = cat3(fname_of(c, unwrap(c, e, "qualifier"), "name"), "::", rname); }
        let ts = strs_find(c.tsname, key);
        if ts >= 0 { ufcs = ints_get(c.tsid, ts); }
        if ufcs >= 0 { sm_put(c.mtrm, sps(c, rspan), spe(c, rspan), ufcs); }
        if ufcs < 0 && some(c, e, "qualifier") {
            err(c, "N0610", rspan, cat3("`", key, "` is not a trait in scope"), "");
            check_all(c, args);
            return fallback;
        }
    }
    let mut first = 0;
    let mut recv_ty = known;
    let before = dg_len(c.d);
    if ufcs >= 0 {
        if ints_len(args) == 0 {
            err(c, "N0303", span, cat5("`", strs_get(c.trname, ufcs), ".", method, "` needs its receiver as its first argument"), "");
            sec(c, rspan, "the trait");
            return fallback;
        }
        first = 1;
        recv_ty = value_type(c, ints_get(args, 0), none());
    } else {
        if recv_ty < 0 {
            if recv < 0 { recv_ty = check_var_named(c, rname, rspan, none()); } else { recv_ty = value_type(c, recv, none()); }
        }
    }
    let receiver_failed = dg_len(c.d) > before;
    let mut tm = 0 - 1;
    if ufcs >= 0 {
        tm = trait_method(c, ufcs, method);
        if tm < 0 {
            err(c, "N0605", at, cat5("`", strs_get(c.trname, ufcs), "` has no method `", method, "`"), "");
            check_args_from(c, args, first);
            return fallback;
        }
    } else {
        tm = lookup_method(c, recv_ty, method, at, false);
        if tm < 0 {
            // By name (R1, 5b.15): `x.m(…)` is `<type>_m(x, …)` where one is in scope.
            if known < 0 && receiver_failed == false {
                let named = named_method(c, recv, rname, rspan, recv_ty, method, at, args, span, expected);
                if named != no_element() { return named; }
            }
            lookup_method(c, recv_ty, method, at, true);
            check_args_from(c, args, first);
            return fallback;
        }
    }
    let tr = method_trait(c, tm);
    let tname = strs_get(c.trname, tr);
    let called = cat3(tname, ".", method);
    let params = ints_new();
    let mut k = 0;
    while k < ints_get(c.tmpc, tm) {
        ints_push(params, subst(c, ints_get(c.ptys, ints_get(c.tmpf, tm) + k), own_trait(), tr, one(recv_ty)));
        k = k + 1;
    }
    let ret = subst(c, ints_get(c.tmret, tm), own_trait(), tr, one(recv_ty));
    if tag(c, recv_ty) == tag_param() || derives(c, tr, recv_ty) {
        // Through a bound, or a derived `Hash` (L6): the method's signature, called as a value of
        // its type is.
        let all = ints_new();
        ints_push(all, recv_ty);
        k = 0;
        while k < ints_len(params) {
            ints_push(all, ints_get(params, k));
            k = k + 1;
        }
        let sites = ints_len(c.sfn);
        record_indirect_site(c, at, fn_ty(c, all, ret, ints_get(c.tmeff, tm), 0 - 1));
        if ints_len(c.sfn) > sites { ints_set(c.stm, sites, tm); }
    } else {
        let mut target = 0 - 1;
        let mut by_default = false;
        if satisfies(c, tr, recv_ty) {
            let im = applying(c, tr, recv_ty);
            target = ints_get(c.imfn, ints_get(c.imff, im) + tm - ints_get(c.trmf, tr));
            // Where the impl leaves the method to its default, the default (L11a).
            if target < 0 && ints_get(c.tmdef, tm) == 1 {
                target = defined_fn(c, ints_get(c.trmod, tr), cat4(tname, "/default/", method, ""));
                by_default = true;
            }
        }
        if target < 0 {
            err(c, "N0605", at, cat5("`", show(c, recv_ty), "` does not implement `", tname, "` in this module's scope"),
                    "an impl is used where its module is this one or one this module imports");
            check_args_from(c, args, first);
            return ret;
        }
        let sites = ints_len(c.sfn);
        record_site(c, at, target);
        // A default body is called with the receiver's type as its type argument, an impl of a
        // generic type with that type's arguments (L11).
        if ints_len(c.sfn) > sites {
            if by_default {
                ints_push(c.sargs, recv_ty);
                ints_set(c.sargc, sites, 1);
            } else {
                if ints_get(c.fntpc, target) > 0 && targc(c, recv_ty) == ints_get(c.fntpc, target) {
                    let mut a = 0;
                    while a < targc(c, recv_ty) {
                        ints_push(c.sargs, targ(c, recv_ty, a));
                        a = a + 1;
                    }
                    ints_set(c.sargc, sites, targc(c, recv_ty));
                }
            }
        }
    }
    let given = ints_len(args) - first;
    let n = ints_len(params);
    if given != n {
        let mut verb = " were given";
        if given == 1 { verb = " was given"; }
        err(c, "N0303", span, cat5(cat3("`", called, "` takes "), int_to_str(n), str_concat(" argument", plural(n)), " after its receiver, but ",
                str_concat(int_to_str(given), verb)), "");
    }
    k = first;
    while k < ints_len(args) {
        let a = ints_get(args, k);
        let mut want = none();
        if k - first < n { want = ints_get(params, k - first); }
        let got = value_type(c, a, want);
        if want >= 0 && assignable(c, got, want) == false { argument_mismatch(c, called, k - first, want, got, a); }
        k = k + 1;
    }
    ret
}

fn check_all(c: Ck, args: Ints) -> Int { check_args_from(c, args, 0) }

fn check_args_from(c: Ck, args: Ints, first: Int) -> Int {
    let mut k = first;
    while k < ints_len(args) {
        check_expr(c, ints_get(args, k), none());
        k = k + 1;
    }
    0
}

// The trait a method of the pool belongs to.
fn method_trait(c: Ck, tm: Int) -> Int {
    let mut t = 0;
    while t < strs_len(c.trname) {
        if tm >= ints_get(c.trmf, t) && tm < ints_get(c.trmf, t) + ints_get(c.trmc, t) { return t; }
        t = t + 1;
    }
    0 - 1
}

// `x.m(args)` as the function `<prefix>_m(x, args)` (`named_method`, R1 5b.15), where no trait
// gives the receiver's type an `m`: the prefix is the type's name in lower case, and for a `Str`
// also `text`, the first whose function is in scope; checked as that call is, at the method's
// name. `no_element()` where none is in scope. The receiver is `recv`, or the name `rname`.
fn named_method(c: Ck, recv: Int, rname: Str, rspan: Int, t: Int, method: Str, at: Int, rest: Ints, span: Int, expected: Int) -> Int {
    let shown = show(c, t);
    let cut = index_of_text(shown, "[");
    let mut base = shown;
    if cut >= 0 { base = str_slice(shown, 0, cut); }
    base = str_lower(base);
    if str_len(base) == 0 { return no_element(); }
    let mut i = 0;
    while i < str_len(base) {
        let b = str_byte(base, i);
        if (b >= 48 && b <= 57) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90) { i = i + 1; } else { return no_element(); }
    }
    let mut name = cat3(base, "_", method);
    if callee_of(c, name) == 0 - 1 {
        if t != t_str() { return no_element(); }
        name = cat3("text", "_", method);
        if callee_of(c, name) == 0 - 1 { return no_element(); }
    }
    let args = ints_new();
    if recv >= 0 {
        ints_push(args, recv);
    } else {
        let vf = fs();
        fa(vf, "name", sx_str(c.t, rname));
        fa(vf, "span", rspan);
        ints_push(args, mk_struct(c.t, "Var", vf));
    }
    let receiver = ints_get(args, 0);
    i = 0;
    while i < ints_len(rest) {
        ints_push(args, ints_get(rest, i));
        i = i + 1;
    }
    let f = fs();
    fa(f, "qualifier", sx_none(c.t));
    fa(f, "callee", sx_str(c.t, name));
    fa(f, "callee_span", at);
    fa(f, "type_args", sx_none(c.t));
    fa(f, "args", mk_list(c.t, args));
    fa(f, "span", span);
    // The receiver is checked already: the call reads its type.
    let r = check_again(c, receiver, t, mk_struct(c.t, "Call", f), expected);
    if r >= 0 { return r; }
    or_int(expected)
}

fn str_lower(s: Str) -> Str {
    let parts = strs_new();
    let mut i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b >= 65 && b <= 90 { strs_push(parts, str_from_byte(b + 32)); } else { strs_push(parts, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    str_join(parts, "")
}

// The one trait method `method` on a value of `t` (`lookup_method`): through a type parameter's
// bound, or among the traits in scope with an impl for `t` this module may use. -1 where there
// is none, said only with `report`.
fn lookup_method(c: Ck, t: Int, method: Str, at: Int, report: Bool) -> Int {
    let shown = show(c, t);
    if tag(c, t) == tag_param() {
        let b = param_bound(c, t);
        if b >= 0 {
            let tm = trait_method(c, b, method);
            if tm >= 0 { return tm; }
        }
        if report {
            err(c, "N0605", at, cat5("`", shown, "` has no method `", method, "`"),
                    "a type parameter has the methods of the trait it requires: `fn f[T: Show](x: T) -> Str { x.show() }`");
        }
        return 0 - 1;
    }
    let found = ints_new();
    let elsewhere = strs_new();
    let mut tr = 0;
    while tr < strs_len(c.trname) {
        let tm = trait_method(c, tr, method);
        if tm >= 0 {
            if applying(c, tr, t) >= 0 {
                if trait_in_scope(c, tr) && satisfies(c, tr, t) { ints_push(found, tm); } else { strs_push(elsewhere, tick(strs_get(c.trname, tr))); }
            } else {
                // A derived `Hash` (L6) has no impl to find, and no module it belongs to.
                if trait_in_scope(c, tr) && derives(c, tr, t) { ints_push(found, tm); }
            }
        }
        tr = tr + 1;
    }
    if ints_len(found) == 1 { return ints_get(found, 0); }
    if report == false { return 0 - 1; }
    if ints_len(found) == 0 {
        let mut help = "";
        if strs_len(elsewhere) > 0 { help = cat3(str_join(elsewhere, ", "), " would: import the module that declares it", ""); }
        err(c, "N0605", at, cat5("no trait in scope gives `", shown, "` a method `", method, "`"), help);
        return 0 - 1;
    }
    let names = strs_new();
    let mut i = 0;
    while i < ints_len(found) {
        strs_push(names, tick(strs_get(c.trname, method_trait(c, ints_get(found, i)))));
        i = i + 1;
    }
    err(c, "N0606", at, cat5("`", method, "` on `", shown, cat3("` is a method of ", str_join(names, " and "), "")), "name the trait: `Show.show(x)`");
    0 - 1
}

// --- generic calls (`check_generic_call`) -------------------------------------------------------

// A call of a generic callee: its name, the callee's span, the call's, its arguments, the
// declared parameter and result types, whose type parameters they mention (`owner`, `oid`), how
// many there are, where it is declared, and what the call reaches (as `record_site` takes it).
pub struct Call {
    name: Str,
    at: Int,
    span: Int,
    args: Ints,
    formals: Ints,
    ret: Int,
    owner: Int,
    oid: Int,
    n: Int,
    ds: Int,
    de: Int,
    target: Int,
    // Whether the callee declares an effect parameter, which each call binds (N51).
    poly: Bool,
}

// The type arguments settled so far (-1 for none yet) and where each came from: an argument's
// index, or -2 for the written ones; and the last conflict unification met: the parameter, the
// type it was settled to, and where that came from.
pub struct Solved {
    ty: Ints,
    from: Ints,
    conflict: Ints,
    // The callee's effect parameter, once an argument binds it (N51): the set, or -1, and the
    // argument that bound it.
    eff: Ints,
}

// Whether a function type in `t` names the callee's effect parameter (N51).
fn call_names_effect(c: Ck, call: Call, t: Int) -> Bool { call.owner == own_fn() && names_effect_param(c, t, call.oid) }

fn written_from() -> Int { 0 - 2 }

// A callee's `i`th type parameter, as its declaration names it.
fn owner_param(c: Ck, call: Call, i: Int) -> Int {
    if call.owner == own_builtin() { return param_ty(c, own_builtin(), call.oid, 0, "T"); }
    fn_param_ty(c, call.oid, i)
}

// The arguments settled so far, each unsettled parameter left as itself (`settled_args`).
fn partial_args(c: Ck, call: Call, g: Solved) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < call.n {
        if ints_get(g.ty, i) >= 0 { ints_push(out, ints_get(g.ty, i)); } else { ints_push(out, owner_param(c, call, i)); }
        i = i + 1;
    }
    out
}

fn all_solved(g: Solved) -> Bool {
    let mut i = 0;
    while i < ints_len(g.ty) {
        if ints_get(g.ty, i) < 0 { return false; }
        i = i + 1;
    }
    true
}

// Whether a type mentions a type parameter of `owner`'s `oid`.
fn mentions(c: Ck, t: Int, owner: Int, oid: Int) -> Bool {
    if tag(c, t) == tag_param() { return ta(c, t) == owner && ints_get(c.tyb, t) == oid; }
    let mut i = 0;
    while i < targc(c, t) {
        if mentions(c, targ(c, t, i), owner, oid) { return true; }
        i = i + 1;
    }
    false
}

// Mark every parameter `formal` mentions as already accounted for (`excuse`).
fn excuse(c: Ck, call: Call, formal: Int, excused: Ints) -> Int {
    if tag(c, formal) == tag_param() {
        if ta(c, formal) == call.owner && ints_get(c.tyb, formal) == call.oid {
            let i = ints_get(c.tyc, formal);
            if i < ints_len(excused) { ints_set(excused, i, 1); }
        }
    }
    let mut k = 0;
    while k < targc(c, formal) {
        excuse(c, call, targ(c, formal, k), excused);
        k = k + 1;
    }
    0
}

// What `actual` says the parameter `index` is, by matching it against `formal` (`inferred_from`).
fn inferred_from(c: Ck, call: Call, formal: Int, actual: Int, index: Int) -> Int {
    let g = tag(c, formal);
    if g == tag_param() {
        if ta(c, formal) == call.owner && ints_get(c.tyb, formal) == call.oid && ints_get(c.tyc, formal) == index { return actual; }
        return 0 - 1;
    }
    if is_holder_tag(g) || g == tag_chan() || g == tag_record() || g == tag_enum() {
        let mut k = 0;
        while k < targc(c, formal) && k < targc(c, actual) {
            let r = inferred_from(c, call, targ(c, formal, k), targ(c, actual, k), index);
            if r >= 0 { return r; }
            k = k + 1;
        }
    }
    0 - 1
}

// Match a declared parameter type against an argument's type, settling the callee's parameters
// it mentions (`unify`): 0 when it matches, 1 for a parameter already settled to another type
// (the conflict is left in `g.conflict`), 2 when the shapes differ.
fn unify(c: Ck, call: Call, formal: Int, actual: Int, g: Solved, arg: Int) -> Int {
    if mentions(c, formal, call.owner, call.oid) == false && call_names_effect(c, call, formal) == false {
        if formal == actual { return 0; }
        return 2;
    }
    let tg = tag(c, formal);
    if tg == tag_param() {
        let i = ints_get(c.tyc, formal);
        if i >= ints_len(g.ty) { return 2; }
        let s = ints_get(g.ty, i);
        if s < 0 {
            ints_set(g.ty, i, actual);
            ints_set(g.from, i, arg);
            return 0;
        }
        if s == actual { return 0; }
        ints_set(g.conflict, 0, i);
        ints_set(g.conflict, 1, s);
        ints_set(g.conflict, 2, ints_get(g.from, i));
        return 1;
    }
    // A generic channel, as a `Vec` is: through its element (N53).
    // `Box` and `Chain` (R1a) and `Cell` (R1b) as a `Vec` is, each only with its own kind.
    if is_holder_tag(tg) || tg == tag_chan() {
        if tag(c, actual) != tg { return 2; }
        return unify(c, call, targ(c, formal, 0), targ(c, actual, 0), g, arg);
    }
    // Structural through a function type's parameters and result (N50). Its effects are the same
    // set — or, where it names the callee's effect parameter, bind it to what the argument has
    // beyond the named ones (N51): 3 when it was bound to another set already.
    if tg == tag_fn() {
        if tag(c, actual) != tg || targc(c, formal) != targc(c, actual) { return 2; }
        let fe = ta(c, formal);
        let ae = ta(c, actual);
        if call.owner == own_fn() && fn_row(c, formal) == call.oid {
            let named = without(fe, 8);
            // A parameter in the argument's effects can only be the caller's own.
            if without(named, ae) != 0 { return 2; }
            if has_bit(ae, 3) && fn_row(c, actual) != eparam(c) { return 2; }
            let binding = without(ae, named);
            let b = ints_get(g.eff, 0);
            if b < 0 {
                ints_set(g.eff, 0, binding);
                ints_set(g.eff, 1, arg);
            } else {
                if b != binding { return 3; }
            }
        } else {
            if fe != ae || fn_row(c, formal) != fn_row(c, actual) { return 2; }
        }
        let mut k = 0;
        while k < targc(c, formal) {
            let r = unify(c, call, targ(c, formal, k), targ(c, actual, k), g, arg);
            if r != 0 { return r; }
            k = k + 1;
        }
        return 0;
    }
    if tg == tag_record() || tg == tag_enum() {
        if tag(c, actual) != tg || ta(c, actual) != ta(c, formal) { return 2; }
        if targc(c, formal) != targc(c, actual) { return 2; }
        let mut k = 0;
        while k < targc(c, formal) {
            let r = unify(c, call, targ(c, formal, k), targ(c, actual, k), g, arg);
            if r != 0 { return r; }
            k = k + 1;
        }
        return 0;
    }
    2
}

// A call to a generic callee: settle its type arguments — written, or inferred from the
// arguments left to right, and only then from the type the result is wanted as — check its
// arguments against them, and return what it produces.
fn check_generic_call(c: Ck, call: Call, targs: Int, expected: Int) -> Int {
    let name = call.name;
    let g = Solved(ty: ints_new(), from: ints_new(), conflict: ints_new(), eff: ints_new());
    let excused = ints_new();
    let mut i = 0;
    while i < call.n {
        ints_push(g.ty, 0 - 1);
        ints_push(g.from, 0 - 1);
        ints_push(excused, 0);
        i = i + 1;
    }
    ints_push(g.conflict, 0);
    ints_push(g.conflict, 0);
    ints_push(g.conflict, 0);
    ints_push(g.eff, 0 - 1);
    ints_push(g.eff, 0);
    let mut explicit = false;
    if targs >= 0 {
        let written = sx_items(c.t, targs);
        let resolved = ints_new();
        i = 0;
        while i < ints_len(written) {
            ints_push(resolved, resolve_written(c, ints_get(written, i), c.tsn, c.tst, c.d));
            i = i + 1;
        }
        if ints_len(resolved) == call.n {
            i = 0;
            while i < call.n {
                ints_set(g.ty, i, ints_get(resolved, i));
                ints_set(g.from, i, written_from());
                i = i + 1;
            }
            explicit = true;
        } else {
            wrong_arity(c, c.d, name, call.n, ints_len(resolved), call.at);
        }
    }
    i = 0;
    while i < ints_len(call.args) {
        let a = ints_get(call.args, i);
        if i >= ints_len(call.formals) {
            check_expr(c, a, none());
        } else {
            let formal = ints_get(call.formals, i);
            let open = mentions(c, formal, call.owner, call.oid) || (call.poly && call_names_effect(c, call, formal));
            if (explicit && call.poly == false) || open == false {
                // Fully known: checked as a monomorphic call's argument is.
                let want = subst(c, formal, call.owner, call.oid, partial_args(c, call, g));
                let got = value_type(c, a, want);
                if assignable(c, got, want) == false { argument_mismatch(c, name, i, want, got, a); }
            } else {
                // What is already known is the expectation, for recovery only.
                let mut hint = none();
                if all_solved(g) { hint = subst(c, formal, call.owner, call.oid, partial_args(c, call, g)); }
                let got = check_expr(c, a, hint);
                if got >= 0 {
                    let r = unify(c, call, formal, got, g, i);
                    if r == 1 {
                        let p = ints_get(g.conflict, 0);
                        let pname = show(c, owner_param(c, call, p));
                        let from = ints_get(g.conflict, 2);
                        let mut source = "the written type arguments";
                        if from != written_from() { source = str_concat("argument ", int_to_str(from + 1)); }
                        let mut implied = inferred_from(c, call, formal, got, p);
                        if implied < 0 { implied = got; }
                        err(c, "N0355", espan(c, a),
                                cat5(cat5("`", pname, "` is `", show(c, ints_get(g.conflict, 1)), "` from "), source, ", but argument ",
                                int_to_str(i + 1), cat3(" makes it `", show(c, implied), "`")),
                                cat5("every use of `", pname, "` in `", name, "`'s signature is one type. Inference does not choose the first and convert the rest"));
                    }
                    if r == 3 {
                        let pname = effect_param_name(c, call.oid);
                        let earlier = ints_get(g.eff, 0);
                        let mut shown = "none";
                        if earlier != 0 { shown = tick(set_text_p(earlier, effect_param_name(c, eparam(c)))); }
                        err(c, "N0389", espan(c, a),
                                cat5(cat5("`", pname, "` is ", shown, " from argument "), int_to_str(ints_get(g.eff, 1) + 1), ", and argument ",
                                int_to_str(i + 1), " binds it to something else"),
                                cat5("every use of `", pname, "` in `", name, "`'s signature is one set of effects; give the function values the same effects"));
                        sec_at(c, call.ds, call.de, "declared here");
                    }
                    if r == 2 {
                        excuse(c, call, formal, excused);
                        let want = subst(c, formal, call.owner, call.oid, partial_args(c, call, g));
                        argument_mismatch(c, name, i, want, got, a);
                    }
                }
                if got == unit() {
                    excuse(c, call, formal, excused);
                    err(c, "N0300", espan(c, a), "this produces no value",
                            "an `if` used as a value needs an `else`, and a block used as one needs a final expression with no `;` after it");
                }
            }
        }
        i = i + 1;
    }
    // A parameter the arguments leave unsettled is settled by the type the result is wanted as.
    if expected >= 0 && all_solved(g) == false { unify(c, call, call.ret, expected, g, ints_len(call.args)); }
    let missing = strs_new();
    i = 0;
    while i < call.n {
        if ints_get(g.ty, i) < 0 && ints_get(excused, i) == 0 { strs_push(missing, show(c, owner_param(c, call, i))); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        let mut verb = "are";
        if strs_len(missing) == 1 { verb = "is"; }
        err(c, "N0354", call.at, cat5("nothing in this call to `", name, "` says what ", quoted(missing), str_concat(" ", verb)),
                cat3("a type argument is inferred from the arguments, then from the type the result is wanted as. Write it — `", name,
                "[…](…)` — or give the result a type: `let x: T = …`"));
        sec_at(c, call.ds, call.de, "declared here");
    }
    // What each parameter's declaration requires, of the argument it was given (N14).
    i = 0;
    while i < call.n {
        let t = ints_get(g.ty, i);
        if t >= 0 && call.owner == own_fn() {
            let b = param_bound(c, owner_param(c, call, i));
            if b >= 0 {
                if satisfies(c, b, t) == false { require_trait(c, call, i, t, ints_get(g.from, i), b); }
            } else {
                if requires_equality(c, owner_param(c, call, i)) { require_equality(c, call, i, t, ints_get(g.from, i)); }
            }
        }
        i = i + 1;
    }
    let settled = ints_new();
    i = 0;
    while i < call.n {
        if ints_get(g.ty, i) >= 0 { ints_push(settled, ints_get(g.ty, i)); } else { ints_push(settled, t_int()); }
        i = i + 1;
    }
    // A generic numeric built-in's `T` is in its class.
    if call.owner == own_builtin() {
        let class = strs_get(c.bclass, call.oid);
        let t = ints_get(settled, 0);
        let mut admits = true;
        let mut describe = "";
        if class == "integer" {
            admits = is_integer(c, t);
            describe = "an integer type";
        }
        if class == "float" {
            admits = is_float_name(bname_of(c, t));
            describe = "`Float32` or `Float64`";
        }
        if class == "numeric" {
            admits = is_num(c, t);
            describe = "a numeric type";
        }
        if admits == false { err(c, "N0300", call.at, cat5("`", name, "` applies to ", describe, cat3(", and this is `", show(c, t), "`")), ""); }
        // The one generic built-in that makes a `Chan[T]` from a written `T` (N53).
        if strs_get(c.bname, call.oid) == "chan_new_of" { channel_element(c, c.d, t, call.at); }
    }
    let sites = ints_len(c.sfn);
    record_site(c, call.at, call.target);
    if ints_len(c.sfn) > sites && call.n > 0 { ints_set(c.starg, sites, ints_get(settled, 0)); }
    // The types that exist before the call's own result is made: what the instantiation shown by signature help may read.
    let watermark = strs_len(c.tykey);
    let mut ret = subst(c, call.ret, call.owner, call.oid, settled);
    // The effect parameter, as this call bound it (N51): what the call performs, and what a
    // function type in its result says — which is the result the call has.
    if call.poly {
        let mut binding = ints_get(g.eff, 0);
        if binding < 0 { binding = 0; }
        if ints_len(c.sfn) > sites { ints_set(c.sbind, sites, binding); }
        ret = bind_effects(c, ret, call.oid, binding, eparam(c));
    }
    if nesting(c, ret) > max_depth() {
        err(c, "N0338", call.span, "this call produces a type nested more than 32 deep",
                "types may nest 32 deep, and the result of a generic call is a type too");
        return t_int();
    }
    if ints_len(c.sfn) > sites {
        ints_set(c.sargf, sites, ints_len(c.sargs));
        ints_set(c.sargc, sites, call.n);
        i = 0;
        while i < call.n {
            ints_push(c.sargs, ints_get(settled, i));
            i = i + 1;
        }
        ints_set(c.sret, sites, ret);
        ints_set(c.sipf, sites, ints_len(c.sip));
        i = 0;
        while i < call.n {
            ints_push(c.sip, ints_get(g.ty, i));
            i = i + 1;
        }
        if call.poly { ints_push(c.sip, 1); } else { ints_push(c.sip, 0); }
        ints_push(c.sip, watermark);
    }
    ret
}

fn argument_mismatch(c: Ck, name: Str, i: Int, want: Int, got: Int, a: Int) -> Int {
    err(c, "N0300", espan(c, a), cat5(cat3("argument ", int_to_str(i + 1), " of `"), name, "` is `", show(c, want), cat3("`, but this is `", show(c, got), "`")), "")
}

// `N0364`: a parameter bound by a trait given a type without a usable impl of it.
fn require_trait(c: Ck, call: Call, i: Int, t: Int, from: Int, tr: Int) -> Int {
    let p = show(c, owner_param(c, call, i));
    let shown = show(c, t);
    let tname = strs_get(c.trname, tr);
    let mut place_s = sps(c, call.at);
    let mut place_e = spe(c, call.at);
    if from >= 0 && from < ints_len(call.args) {
        let a = espan(c, ints_get(call.args, from));
        place_s = sps(c, a);
        place_e = spe(c, a);
    }
    // Where `Hash` is derived (L6), why this type does not derive it.
    let mut underived = "";
    if tr == gs(c, s_hash()) && tag(c, t) != tag_param() {
        let why = derived_by(c, t, false, tr, true);
        if derived_path(c, why) != "" {
            underived = cat5(", and does not derive one: its `", derived_path(c, why), "` is a `", show(c, derived_type(c, why)), "`");
        }
    }
    let message = cat5(cat5("`", call.name, "` requires `", p, ": "), tname, cat3("`, and `", p, "` is `"), shown,
            cat5("` here, which has no impl of `", tname, "` in this module's scope", underived, ""));
    let mut help = cat5(cat5("implement it, `impl ", tname, " for ", shown, "`, in the module of `"), tname, "` or of `", shown, "`, and import that module here");
    if tag(c, t) == tag_param() { help = cat5("declare `", shown, ": ", tname, "` on this definition"); }
    dg_error(c.d, "N0364", place_s, place_e, message, "", help);
    sec_at(c, call.ds, call.de, "declared here");
    0
}

// `N0364`: a parameter that requires `Equality` given a type without it.
fn require_equality(c: Ck, call: Call, i: Int, t: Int, from: Int) -> Int {
    let why = derived(c, t, true);
    if why == "" { return 0; }
    let p = show(c, owner_param(c, call, i));
    let shown = show(c, t);
    let mut place_s = sps(c, call.at);
    let mut place_e = spe(c, call.at);
    if from >= 0 && from < ints_len(call.args) {
        let a = espan(c, ints_get(call.args, from));
        place_s = sps(c, a);
        place_e = spe(c, a);
    }
    let head = cat5("`", call.name, "` requires `", p, ": Equality`, and ");
    let mut message = "";
    let mut help = "equality is derived from what a type contains; a sequence, a `Vec` or a `Chan` anywhere inside a type gives it none";
    if tag(c, t) == tag_param() {
        message = cat4(head, "this `", shown, "` is a type parameter whose declaration does not require it");
        help = cat3("a generic definition may pass on only what it requires itself: declare `", shown, ": Equality`");
    } else {
        if derived_path(c, why) == "" {
            message = cat5(head, cat3("`", p, "` is `"), shown, "` here: `", cat3(shown, "` has no equality", ""));
        } else {
            message = cat5(head, cat3("`", p, "` is `"), shown, "` here: its `",
                    cat5(derived_path(c, why), "` is a `", show(c, derived_type(c, why)), "`, which has no equality", ""));
        }
    }
    dg_error(c.d, "N0364", place_s, place_e, message, "", help);
    sec_at(c, call.ds, call.de, "declared here");
    0
}

// --- construction -------------------------------------------------------------------------------

// Field initialisers: each one's name, name span (absolute) and value.
pub struct Inits {
    names: Strs,
    ns: Ints,
    ne: Ints,
    vals: Ints,
}

fn no_inits() -> Inits { Inits(names: strs_new(), ns: ints_new(), ne: ints_new(), vals: ints_new()) }

fn written_inits(c: Ck, fields: Ints) -> Inits {
    let out = no_inits();
    let mut i = 0;
    while i < ints_len(fields) {
        let f = ints_get(fields, i);
        strs_push(out.names, fname_of(c, f, "name"));
        ints_push(out.ns, sps(c, fld(c, f, "name_span")));
        ints_push(out.ne, spe(c, fld(c, f, "name_span")));
        ints_push(out.vals, fld(c, f, "value"));
        i = i + 1;
    }
    out
}

// A call's arguments as fields given by position (R1.5, D4): no name, at a span of no width where
// the value begins.
fn positional_inits(c: Ck, args: Ints) -> Inits {
    let out = no_inits();
    let mut i = 0;
    while i < ints_len(args) {
        let a = ints_get(args, i);
        strs_push(out.names, "");
        ints_push(out.ns, sps(c, espan(c, a)));
        ints_push(out.ne, sps(c, espan(c, a)));
        ints_push(out.vals, a);
        i = i + 1;
    }
    out
}

fn check_values(c: Ck, inits: Inits) -> Int {
    let mut i = 0;
    while i < ints_len(inits.vals) {
        check_expr(c, ints_get(inits.vals, i), none());
        i = i + 1;
    }
    0
}

// The type `name` means here, asked without reporting anything.
fn quiet_type(c: Ck, name: Str, span: Int) -> Int {
    if strs_find(c.tsn, name) >= 0 { return param_named(c, name); }
    ss(c, s_quiet(), 1);
    let t = resolve_name(c, name, span, dg_new());
    ss(c, s_quiet(), 0);
    t
}

// A type parameter named where an expression or a pattern names a type: the reference refuses it
// in words this checker does not carry yet.
fn param_named(c: Ck, name: Str) -> Int {
    stop(c, "a type parameter named in an expression");
    ints_get(c.tst, strs_find(c.tsn, name))
}

// The enums in scope with a variant named `variant`, in the order of the names they are written by.
fn variant_owners(c: Ck, variant: Str) -> Ints {
    let names = strs_new();
    let out = ints_new();
    let mut i = 0;
    while i < strs_len(c.tnames) {
        let t = ints_get(c.ttys, i);
        // Not under an import's name, nor twice for one enum.
        if is_enum(c, t) && str_has(strs_get(c.tnames, i), "::") == false && index_of(out, t) < 0 {
            if variant_of(c, t, variant) >= 0 {
                let n = strs_get(c.tnames, i);
                let mut at = 0;
                while at < strs_len(names) && str_less(strs_get(names, at), n) { at = at + 1; }
                insert_str(names, at, n);
                insert_int(out, at, t);
            }
        }
        i = i + 1;
    }
    out
}

// The names the module writes `owners` by (a re-exported enum may be offered under another name,
// N103). An enum written under two plain names is one whose name the reference picks in a hash
// map's order: the checker stops there.
fn owner_names(c: Ck, owners: Ints) -> Strs {
    let out = strs_new();
    let mut i = 0;
    while i < ints_len(owners) {
        let t = ints_get(owners, i);
        let mut name = "";
        let mut k = 0;
        while k < strs_len(c.tnames) {
            let n = strs_get(c.tnames, k);
            if ints_get(c.ttys, k) == t && str_has(n, "::") == false {
                if name != "" { stop(c, "an enum written under two names"); }
                if name == "" { name = n; }
            }
            k = k + 1;
        }
        if name == "" { name = strs_get(c.ename, ta(c, t)); }
        strs_push(out, name);
        i = i + 1;
    }
    out
}

fn str_less(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i); }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

fn insert_str(xs: Strs, at: Int, s: Str) -> Int {
    strs_push(xs, s);
    let mut i = strs_len(xs) - 1;
    while i > at {
        strs_set(xs, i, strs_get(xs, i - 1));
        i = i - 1;
    }
    strs_set(xs, at, s);
    0
}

fn insert_int(xs: Ints, at: Int, v: Int) -> Int {
    ints_push(xs, v);
    let mut i = ints_len(xs) - 1;
    while i > at {
        ints_set(xs, i, ints_get(xs, i - 1));
        i = i - 1;
    }
    ints_set(xs, at, v);
    0
}

fn quoted(names: Strs) -> Str {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(names) {
        strs_push(out, tick(strs_get(names, i)));
        i = i + 1;
    }
    str_join(out, ", ")
}

// Positional fields named in declaration order (`positional_named`): 1 when the initialisers may
// be checked (renamed in place where they were positional), 0 when a refusal was reported.
fn positional_named(c: Ck, inits: Inits, declared: Strs, has_declared: Bool, what: Str, span: Int) -> Int {
    let mut positional = false;
    let mut named = false;
    let mut i = 0;
    while i < strs_len(inits.names) {
        if strs_get(inits.names, i) == "" { positional = true; } else { named = true; }
        i = i + 1;
    }
    if positional == false || has_declared == false { return 1; }
    if named {
        err(c, "N0334", span, cat3("`", what, "`'s fields are given both by position and by name"),
                "give every field by position, in the order declared, or every one by name");
        return 0;
    }
    if strs_len(inits.names) != strs_len(declared) {
        let mut verb = " are given by position";
        if strs_len(inits.names) == 1 { verb = " is given by position"; }
        err(c, "N0334", span, cat5(cat3("`", what, "` has "), int_to_str(strs_len(declared)), str_concat(" field", plural(strs_len(declared))),
                ", and ", str_concat(int_to_str(strs_len(inits.names)), verb)), "");
        return 0;
    }
    i = 0;
    while i < strs_len(declared) {
        strs_set(inits.names, i, strs_get(declared, i));
        i = i + 1;
    }
    1
}

fn record_field_names(c: Ck, t: Int) -> Strs {
    let out = strs_new();
    let r = ta(c, t);
    let mut i = 0;
    while i < ints_get(c.rfc, r) {
        strs_push(out, strs_get(c.fname, ints_get(c.rff, r) + i));
        i = i + 1;
    }
    out
}

// A record's construction; the record, or -1 when its type did not resolve. `targs` is the list of
// type arguments written, or -1.
fn check_construction(c: Ck, ty: Str, ty_span: Int, targs: Int, inits: Inits, span: Int, expected: Int) -> Int {
    let quiet = quiet_type(c, ty, ty_span);
    if is_record(c, quiet) == false && targs < 0 {
        let owners = variant_owners(c, ty);
        if ints_len(owners) == 1 {
            return check_variant(c, strs_get(owner_names(c, owners), 0), ty_span, 0 - 1, ty, ty_span, inits, span, expected);
        }
        if ints_len(owners) > 1 {
            let names = owner_names(c, owners);
            let a = strs_get(names, 0);
            let b = strs_get(names, 1);
            err(c, "N0636", ty_span, cat5(cat3("`", ty, "` is a variant of both `"), a, "` and `", b, "`"),
                    cat5(cat3("write which: `", a, "."), ty, cat3("(…)` or `", b, "."), ty, "(…)`"));
            check_values(c, inits);
            return 0 - 1;
        }
    }
    let mut declared = strs_new();
    if is_record(c, quiet) { declared = record_field_names(c, quiet); }
    if positional_named(c, inits, declared, is_record(c, quiet), ty, span) == 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let def = resolve_type(c, ty, ty_span);
    if is_record(c, def) == false {
        if is_enum(c, def) {
            let name = show(c, def);
            let mut help = "";
            if ints_get(c.evc, ta(c, def)) > 0 { help = cat5("write `", name, ".", strs_get(c.vname, ints_get(c.evf, ta(c, def))), "(…)`"); }
            err(c, "N0341", ty_span, cat3("`", name, "` is an enum, so a value of it names one of its variants"), help);
        } else {
            if is_cap_name(ty) {
                // Authority is not constructible (N37): the only capabilities are `main`'s.
                forged(c, ty, ty_span);
            } else {
                if is_builtin_name(ty) {
                    err(c, "N0333", ty_span, cat3("`", show(c, def), "` is not a record, so it has no fields to name"),
                            "this form builds a record. A built-in type is built by its own operations");
                }
            }
        }
        check_values(c, inits);
        return 0 - 1;
    }
    let t = applied(c, def, targs, ty_span);
    if t < 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let r = ta(c, t);
    sm_put(c.mcons, sps(c, ty_span), spe(c, ty_span), t);
    // Only C makes a handle (N85): it has no field a program could give a value.
    if is_opaque(c, t) {
        let mut k = 0;
        while k < strs_len(inits.names) {
            check_expr(c, ints_get(inits.vals, k), none());
            k = k + 1;
        }
        opaque_refused(c, sps(c, ty_span), spe(c, ty_span), ty, "built");
        return t;
    }
    let given = strs_new();
    let gstart = ints_new();
    let gend = ints_new();
    let mut i = 0;
    while i < strs_len(inits.names) {
        let name = strs_get(inits.names, i);
        let value = ints_get(inits.vals, i);
        let f = record_field(c, t, name);
        if f < 0 {
            dg_error(c.d, "N0333", ints_get(inits.ns, i), ints_get(inits.ne, i), cat5("`", show(c, t), "` has no field `", name, "`"), "", "");
            sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
            check_expr(c, value, none());
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                dg_error(c.d, "N0332", ints_get(inits.ns, i), ints_get(inits.ne, i), cat3("`", name, "` is given a value twice"), "",
                        "every field is given exactly one value; there is no update form");
                sec_at(c, ints_get(gstart, first), ints_get(gend, first), "first given here");
                check_expr(c, value, none());
            } else {
                strs_push(given, name);
                ints_push(gstart, ints_get(inits.ns, i));
                ints_push(gend, ints_get(inits.ne, i));
                sm_put(c.minit, ints_get(inits.ns, i), ints_get(inits.ne, i), f - ints_get(c.rff, r));
                sm_put(c.mfini, ints_get(inits.ns, i), ints_get(inits.ne, i), f);
                let want = field_ty_in(c, t, f);
                let got = value_type(c, value, want);
                if got != want {
                    let sw = show(c, want);
                    err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is `"), sw, "`, but this is `", show(c, got), "`"), "");
                    sec_at(c, ints_get(c.fns, f), ints_get(c.fne, f), cat3("declared `", sw, "` here"));
                }
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < ints_get(c.rfc, r) {
        let n = strs_get(c.fname, ints_get(c.rff, r) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", span, cat4("this `", show(c, t), "` does not give a value for ", quoted(missing)),
                "every field is given a value when a record is built. There are no default values and no partial records");
        sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
    }
    t
}

// A definition applied to the type arguments written after its name (`applied`); -1, reported,
// when a generic one has none written.
fn applied(c: Ck, def: Int, targs: Int, at: Int) -> Int {
    let args = ints_new();
    if targs >= 0 {
        let written = sx_items(c.t, targs);
        let mut i = 0;
        while i < ints_len(written) {
            ints_push(args, resolve_written(c, ints_get(written, i), c.tsn, c.tst, c.d));
            i = i + 1;
        }
    }
    let mut arity = 0;
    if is_record(c, def) { arity = ints_get(c.rnp, ta(c, def)); }
    if is_enum(c, def) { arity = ints_get(c.enp, ta(c, def)); }
    let shown = show(c, def);
    if targs < 0 {
        if arity == 0 { return def; }
        err(c, "N0352", at, cat5("`", shown, "` is generic, so it is built with its ", int_to_str(arity), cat3(" type argument", plural(arity), " written")),
                cat3("write them after the name: `", shown, "[…]`, or use it where its type is known, or give it a payload that says (R1, 5b.14)"));
        return 0 - 1;
    }
    if arity == 0 {
        not_generic(c, c.d, shown, "not generic", at);
        return def;
    }
    if ints_len(args) != arity {
        wrong_arity(c, c.d, shown, arity, ints_len(args), at);
        while ints_len(args) > arity { ints_pop(args); }
        while ints_len(args) < arity { ints_push(args, t_int()); }
    }
    if is_record(c, def) { return record_ty(c, ta(c, def), args); }
    enum_ty(c, ta(c, def), args)
}

// The type arguments written after an expression's name: their list, or -1.
fn type_args_of(c: Ck, e: Int) -> Int {
    if some(c, e, "type_args") { return unwrap(c, e, "type_args"); }
    0 - 1
}

// A type name written in an expression, reported when it is no type.
fn resolve_type(c: Ck, name: Str, span: Int) -> Int {
    if strs_find(c.tsn, name) >= 0 { return param_named(c, name); }
    resolve_name(c, name, span, c.d)
}

// A generic enum's arguments where none are written (R1, 5b.14; `inferred_enum`): the type the
// construction is wanted as, when it is this enum; otherwise each payload field declared as one of
// its parameters says that parameter is its value's type. -1 where that leaves one undecided. A
// payload value checked here is recorded in `pre` and not checked again.
fn inferred_enum(c: Ck, def: Int, variant: Str, inits: Inits, expected: Int, pre: Ints) -> Int {
    let e = ta(c, def);
    let n = ints_get(c.enp, e);
    if n == 0 { return 0 - 1; }
    if expected >= 0 && is_enum(c, expected) && ta(c, expected) == e { return expected; }
    let v = variant_of(c, def, variant);
    if v < 0 { return 0 - 1; }
    let args = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(args, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < strs_len(inits.names) {
        let f = variant_field(c, v, strs_get(inits.names, i));
        if f >= 0 {
            let declared = ints_get(c.fty, f);
            if tag(c, declared) == tag_param() && ta(c, declared) == own_enum() && ints_get(c.tyb, declared) == e {
                let t = value_type(c, ints_get(inits.vals, i), none());
                ints_set(pre, i, t);
                let index = ints_get(c.tyc, declared);
                if index < n {
                    if ints_get(args, index) < 0 { ints_set(args, index, t); }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        if ints_get(args, i) < 0 { return 0 - 1; }
        i = i + 1;
    }
    enum_ty(c, e, args)
}

// The values not already checked while inferring.
fn check_rest(c: Ck, inits: Inits, pre: Ints) -> Int {
    let mut i = 0;
    while i < ints_len(inits.vals) {
        if ints_get(pre, i) < 0 { check_expr(c, ints_get(inits.vals, i), none()); }
        i = i + 1;
    }
    0
}

// `Enum.Variant(…)`; the enum, or -1 when its type did not resolve.
fn check_variant(c: Ck, ty: Str, ty_span: Int, targs: Int, variant: Str, variant_span: Int, inits: Inits, span: Int, expected: Int) -> Int {
    let quiet = quiet_type(c, ty, ty_span);
    let declared = strs_new();
    let mut has_declared = false;
    if is_enum(c, quiet) {
        let v = variant_of(c, quiet, variant);
        if v >= 0 {
            has_declared = true;
            let mut i = 0;
            while i < ints_get(c.vfc, v) {
                strs_push(declared, strs_get(c.fname, ints_get(c.vff, v) + i));
                i = i + 1;
            }
        }
    }
    if positional_named(c, inits, declared, has_declared, variant, span) == 0 {
        check_values(c, inits);
        return 0 - 1;
    }
    let pre = ints_new();
    let mut i = 0;
    while i < ints_len(inits.vals) {
        ints_push(pre, 0 - 1);
        i = i + 1;
    }
    let def = resolve_type(c, ty, ty_span);
    if is_enum(c, def) == false {
        if is_record(c, def) {
            err(c, "N0341", ty_span, cat3("`", show(c, def), "` is a record, so it has no variants"),
                    "a record is built by naming its fields: `Point(x: 1, y: 2)`");
        } else {
            if is_builtin_name(ty) {
                err(c, "N0341", ty_span, cat3("`", show(c, def), "` is a built-in type, so it has no variants"), "only an `enum` has variants");
            }
        }
        check_values(c, inits);
        return 0 - 1;
    }
    let mut t = 0 - 1;
    if targs < 0 { t = inferred_enum(c, def, variant, inits, expected, pre); }
    if t < 0 { t = applied(c, def, targs, ty_span); }
    if t < 0 {
        check_rest(c, inits, pre);
        return 0 - 1;
    }
    let e = ta(c, t);
    let v = variant_of(c, t, variant);
    if v < 0 {
        let known = strs_new();
        i = 0;
        while i < ints_get(c.evc, e) {
            strs_push(known, strs_get(c.vname, ints_get(c.evf, e) + i));
            i = i + 1;
        }
        let mut help = "";
        if strs_len(known) > 0 { help = str_concat("its variants are ", quoted(known)); }
        err(c, "N0341", variant_span, cat5("`", show(c, t), "` has no variant `", variant, "`"), help);
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        check_rest(c, inits, pre);
        return t;
    }
    sm_put(c.mvty, sps(c, variant_span), spe(c, variant_span), t);
    sm_put(c.mvix, sps(c, variant_span), spe(c, variant_span), v - ints_get(c.evf, e));
    let path = cat3(show(c, t), ".", variant);
    let given = strs_new();
    let gstart = ints_new();
    let gend = ints_new();
    i = 0;
    while i < strs_len(inits.names) {
        let name = strs_get(inits.names, i);
        let value = ints_get(inits.vals, i);
        let done = ints_get(pre, i);
        let f = variant_field(c, v, name);
        if f < 0 {
            dg_error(c.d, "N0333", ints_get(inits.ns, i), ints_get(inits.ne, i), cat5("`", path, "` has no payload field `", name, "`"), "", "");
            sec_at(c, ints_get(c.vns, v), ints_get(c.vne, v), "declared here");
            if done < 0 { check_expr(c, value, none()); }
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                dg_error(c.d, "N0332", ints_get(inits.ns, i), ints_get(inits.ne, i), cat3("`", name, "` is given a value twice"), "",
                        "every payload field is given exactly one value");
                sec_at(c, ints_get(gstart, first), ints_get(gend, first), "first given here");
                if done < 0 { check_expr(c, value, none()); }
            } else {
                strs_push(given, name);
                ints_push(gstart, ints_get(inits.ns, i));
                ints_push(gend, ints_get(inits.ne, i));
                sm_put(c.minit, ints_get(inits.ns, i), ints_get(inits.ne, i), f - ints_get(c.vff, v));
                sm_put(c.mfini, ints_get(inits.ns, i), ints_get(inits.ne, i), f);
                let want = field_ty_in(c, t, f);
                let mut got = done;
                if done < 0 { got = value_type(c, value, want); }
                if got != want {
                    let sw = show(c, want);
                    err(c, "N0300", espan(c, value), cat5(cat3("`", name, "` is `"), sw, "`, but this is `", show(c, got), "`"), "");
                    sec_at(c, ints_get(c.fns, f), ints_get(c.fne, f), cat3("declared `", sw, "` here"));
                }
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < ints_get(c.vfc, v) {
        let n = strs_get(c.fname, ints_get(c.vff, v) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", span, cat4("this `", path, "` does not give a value for ", quoted(missing)),
                "every payload field is given a value when a variant is built. There are no default values");
        sec_at(c, ints_get(c.vns, v), ints_get(c.vne, v), "declared here");
    }
    t
}

// `base.name`: the field's type, or -1 when it has none.
fn check_projection(c: Ck, base: Int, name: Str, name_span: Int) -> Int {
    // `x.show` with no call and no field of that name, where a trait in scope has the method
    // (N78): methods are not values.
    let mut is_field = false;
    if is_record(c, base) { is_field = record_field(c, base, name) >= 0; }
    let mut a_method = false;
    let mut i = 0;
    while i < ints_len(c.tsid) {
        if ints_get(c.tsid, i) >= 0 {
            if trait_method(c, ints_get(c.tsid, i), name) >= 0 { a_method = true; }
        }
        i = i + 1;
    }
    if is_field == false && a_method {
        err(c, "N0608", name_span, cat3("`.", name, "` is a method, and a method is called, not taken as a value"),
                cat5("call it, `x.", name, "()`, or make a value of the call with a closure: `fn() -> … { x.", name, "() }`"));
        return 0 - 1;
    }
    if is_record(c, base) == false {
        let mut help = "`.` reads a declared field out of a record value";
        if is_enum(c, base) {
            help = "which fields an enum value has depends on its active variant, so a payload is read by `match` and not by `.`";
        }
        err(c, "N0335", name_span, cat5("`", show(c, base), "` is not a record, so `.", name, "` has nothing to read"), help);
        return 0 - 1;
    }
    let f = record_field(c, base, name);
    if f < 0 {
        let r = ta(c, base);
        err(c, "N0333", name_span, cat5("`", show(c, base), "` has no field `", name, "`"),
                "a field is looked for on the type of the value it is read from, and nowhere else");
        sec_at(c, ints_get(c.rns, r), ints_get(c.rne, r), "declared here");
        return 0 - 1;
    }
    let ft = field_ty_in(c, base, f);
    sm_put(c.mfld, sps(c, name_span), spe(c, name_span), f);
    sm_put(c.mfldty, sps(c, name_span), spe(c, name_span), ft);
    ft
}

// --- matching (`check_match`, `nazm-core/src/check/pattern.rs`) ---------------------------------

// What a pattern matches, for exhaustiveness and reachability (`usefulness::Pat`), in the
// checker's pattern pool: its kind, a value (a `Bool`'s, or a variant's index), a literal's key,
// a variant's enum (the scrutinee's instance), and a run of arguments.
fn pk_wild() -> Int { 0 }
fn pk_bool() -> Int { 1 }
fn pk_lit() -> Int { 2 }
fn pk_ctor() -> Int { 3 }
fn pk_or() -> Int { 4 }
// A tuple (L5), its elements' patterns: the one constructor of a tuple type.
fn pk_tuple() -> Int { 5 }

fn pat_new(c: Ck, kind: Int, value: Int, key: Str, ty: Int, args: Ints) -> Int {
    ints_push(c.pkind, kind);
    ints_push(c.pval, value);
    strs_push(c.pkey, key);
    ints_push(c.pty, ty);
    ints_push(c.paf, ints_len(c.pargs));
    ints_push(c.pac, ints_len(args));
    let mut i = 0;
    while i < ints_len(args) {
        ints_push(c.pargs, ints_get(args, i));
        i = i + 1;
    }
    ints_len(c.pkind) - 1
}

fn wild(c: Ck) -> Int { pat_new(c, pk_wild(), 0, "", 0, ints_new()) }
fn pkind(c: Ck, p: Int) -> Int { ints_get(c.pkind, p) }
fn pargs_of(c: Ck, p: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_get(c.pac, p) {
        ints_push(out, ints_get(c.pargs, ints_get(c.paf, p) + i));
        i = i + 1;
    }
    out
}

// Whether a pattern has a head constructor, and whether two heads are the same one.
fn has_head(c: Ck, p: Int) -> Bool { pkind(c, p) == pk_bool() || pkind(c, p) == pk_lit() || pkind(c, p) == pk_ctor() || pkind(c, p) == pk_tuple() }
fn same_head(c: Ck, p: Int, h: Int) -> Bool {
    if pkind(c, p) != pkind(c, h) { return false; }
    if pkind(c, p) == pk_lit() { return strs_get(c.pkey, p) == strs_get(c.pkey, h); }
    ints_get(c.pval, p) == ints_get(c.pval, h)
}

// A matrix of patterns: its rows, each a run of the checker's cell pool.
pub struct Mat {
    rs: Ints,
    rl: Ints,
}

fn mat_new() -> Mat { Mat(rs: ints_new(), rl: ints_new()) }
fn mat_rows(m: Mat) -> Int { ints_len(m.rs) }
fn mat_push(c: Ck, m: Mat, row: Ints) -> Int {
    ints_push(m.rs, ints_len(c.cells));
    ints_push(m.rl, ints_len(row));
    let mut i = 0;
    while i < ints_len(row) {
        ints_push(c.cells, ints_get(row, i));
        i = i + 1;
    }
    0
}
fn mat_row(c: Ck, m: Mat, r: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_get(m.rl, r) {
        ints_push(out, ints_get(c.cells, ints_get(m.rs, r) + i));
        i = i + 1;
    }
    out
}
fn mat_first(c: Ck, m: Mat, r: Int) -> Int {
    if ints_get(m.rl, r) == 0 { return 0 - 1; }
    ints_get(c.cells, ints_get(m.rs, r))
}

fn tail_of(xs: Ints, from: Int) -> Ints {
    let out = ints_new();
    let mut i = from;
    while i < ints_len(xs) {
        ints_push(out, ints_get(xs, i));
        i = i + 1;
    }
    out
}
fn joined(a: Ints, b: Ints) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_len(a) {
        ints_push(out, ints_get(a, i));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(b) {
        ints_push(out, ints_get(b, i));
        i = i + 1;
    }
    out
}
fn wilds(c: Ck, n: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(out, wild(c));
        i = i + 1;
    }
    out
}

// Rows with every or-pattern at their head spread into one row per alternative (`spread`).
fn spread(c: Ck, m: Mat) -> Mat {
    let out = mat_new();
    let work = mat_new();
    let mut r = mat_rows(m) - 1;
    while r >= 0 {
        mat_push(c, work, mat_row(c, m, r));
        r = r - 1;
    }
    while mat_rows(work) > 0 {
        let last = mat_rows(work) - 1;
        let row = mat_row(c, work, last);
        ints_pop(work.rs);
        ints_pop(work.rl);
        if ints_len(row) > 0 && pkind(c, ints_get(row, 0)) == pk_or() {
            let alts = pargs_of(c, ints_get(row, 0));
            let rest = tail_of(row, 1);
            let mut k = ints_len(alts) - 1;
            while k >= 0 {
                let one_alt = ints_new();
                ints_push(one_alt, ints_get(alts, k));
                mat_push(c, work, joined(one_alt, rest));
                k = k - 1;
            }
        } else {
            mat_push(c, out, row);
        }
    }
    out
}

// The rows whose head matches `head`, its arguments (`arity` wildcards for a `_`) in front of the
// rest (`specialise`).
fn specialise(c: Ck, m: Mat, head: Int, arity: Int) -> Mat {
    let rows = spread(c, m);
    let out = mat_new();
    let mut r = 0;
    while r < mat_rows(rows) {
        let row = mat_row(c, rows, r);
        if ints_len(row) > 0 {
            let first = ints_get(row, 0);
            let rest = tail_of(row, 1);
            if pkind(c, first) == pk_wild() {
                mat_push(c, out, joined(wilds(c, arity), rest));
            } else {
                if has_head(c, first) && same_head(c, first, head) {
                    if pkind(c, first) == pk_ctor() || pkind(c, first) == pk_tuple() {
                        mat_push(c, out, joined(pargs_of(c, first), rest));
                    } else {
                        mat_push(c, out, rest);
                    }
                }
            }
        }
        r = r + 1;
    }
    out
}

// The rows whose head is `_`, without it (`default`).
fn default_rows(c: Ck, m: Mat) -> Mat {
    let rows = spread(c, m);
    let out = mat_new();
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first >= 0 {
            if pkind(c, first) == pk_wild() { mat_push(c, out, tail_of(mat_row(c, rows, r), 1)); }
        }
        r = r + 1;
    }
    out
}

// A finite type's constructors, as head patterns: every variant of an enum (its fields' types a
// run of `ctys`), or `true` and `false`. None (an empty list) for any other type.
pub struct Ctors {
    heads: Ints,
    tf: Ints,
    tc: Ints,
    tys: Ints,
}

fn ctors_of(c: Ck, t: Int) -> Ctors {
    let out = Ctors(heads: ints_new(), tf: ints_new(), tc: ints_new(), tys: ints_new());
    if is_enum(c, t) {
        let e = ta(c, t);
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let vi = ints_get(c.evf, e) + v;
            ints_push(out.heads, pat_new(c, pk_ctor(), v, "", t, ints_new()));
            ints_push(out.tf, ints_len(out.tys));
            ints_push(out.tc, ints_get(c.vfc, vi));
            let mut k = 0;
            while k < ints_get(c.vfc, vi) {
                ints_push(out.tys, field_ty_in(c, t, ints_get(c.vff, vi) + k));
                k = k + 1;
            }
            v = v + 1;
        }
    }
    if is_tuple(c, t) {
        ints_push(out.heads, pat_new(c, pk_tuple(), 0, "", t, ints_new()));
        ints_push(out.tf, ints_len(out.tys));
        ints_push(out.tc, targc(c, t));
        let mut k = 0;
        while k < targc(c, t) {
            ints_push(out.tys, targ(c, t, k));
            k = k + 1;
        }
    }
    if t == t_bool() {
        ints_push(out.heads, pat_new(c, pk_bool(), 1, "", 0, ints_new()));
        ints_push(out.tf, 0);
        ints_push(out.tc, 0);
        ints_push(out.heads, pat_new(c, pk_bool(), 0, "", 0, ints_new()));
        ints_push(out.tf, 0);
        ints_push(out.tc, 0);
    }
    out
}

fn finite(c: Ck, t: Int) -> Bool { is_enum(c, t) || t == t_bool() || is_tuple(c, t) }

fn ctor_fields(k: Ctors, i: Int) -> Ints {
    let out = ints_new();
    let mut j = 0;
    while j < ints_get(k.tc, i) {
        ints_push(out, ints_get(k.tys, ints_get(k.tf, i) + j));
        j = j + 1;
    }
    out
}

// Whether some row's head is `h`.
fn present(c: Ck, rows: Mat, h: Int) -> Bool {
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first >= 0 {
            if has_head(c, first) && same_head(c, first, h) { return true; }
        }
        r = r + 1;
    }
    false
}

fn complete(c: Ck, rows: Mat, k: Ctors) -> Bool {
    let mut i = 0;
    while i < ints_len(k.heads) {
        if present(c, rows, ints_get(k.heads, i)) == false { return false; }
        i = i + 1;
    }
    true
}

fn max_pattern_depth() -> Int { 256 }

// Whether `row` matches some value no row of `m` matches (`useful`).
fn useful(c: Ck, m: Mat, row: Ints, tys: Ints, depth: Int) -> Bool {
    if ints_len(row) == 0 || ints_len(tys) == 0 { return mat_rows(m) == 0; }
    if depth > max_pattern_depth() { return false; }
    let first = ints_get(row, 0);
    let rest = tail_of(row, 1);
    let ty = ints_get(tys, 0);
    let rest_tys = tail_of(tys, 1);
    if pkind(c, first) == pk_or() {
        let alts = pargs_of(c, first);
        let mut i = 0;
        while i < ints_len(alts) {
            let r = ints_new();
            ints_push(r, ints_get(alts, i));
            if useful(c, m, joined(r, rest), tys, depth + 1) { return true; }
            i = i + 1;
        }
        return false;
    }
    if pkind(c, first) == pk_wild() {
        let rows = spread(c, m);
        let k = ctors_of(c, ty);
        if finite(c, ty) && complete(c, rows, k) {
            let mut i = 0;
            while i < ints_len(k.heads) {
                let fields = ctor_fields(k, i);
                let r = joined(wilds(c, ints_len(fields)), rest);
                let t = joined(fields, rest_tys);
                if useful(c, specialise(c, rows, ints_get(k.heads, i), ints_len(fields)), r, t, depth + 1) { return true; }
                i = i + 1;
            }
            return false;
        }
        return useful(c, default_rows(c, rows), rest, rest_tys, depth + 1);
    }
    let args = pargs_of(c, first);
    let mut fields = ints_new();
    if pkind(c, first) == pk_tuple() {
        if is_tuple(c, ty) {
            fields = targs(c, ty);
        } else {
            let mut i = 0;
            while i < ints_len(args) {
                ints_push(fields, t_int());
                i = i + 1;
            }
        }
    }
    if pkind(c, first) == pk_ctor() {
        let k = ctors_of(c, ty);
        let v = ints_get(c.pval, first);
        if v < ints_len(k.heads) { fields = ctor_fields(k, v); }
        if ints_len(fields) != ints_len(args) || v >= ints_len(k.heads) {
            fields = ints_new();
            let mut i = 0;
            while i < ints_len(args) {
                ints_push(fields, t_int());
                i = i + 1;
            }
        }
    }
    useful(c, specialise(c, m, first, ints_len(args)), joined(args, rest), joined(fields, rest_tys), depth + 1)
}

// "No witness": every value is matched.
fn no_witness() -> Str { "?none" }

// A row of values, one per column of `tys`, that no row of `m` matches, each as it is shown;
// `no_witness()` alone when every value is matched (`witness`).
fn witness(c: Ck, m: Mat, tys: Ints, depth: Int) -> Strs {
    let none_found = strs_new();
    strs_push(none_found, no_witness());
    if ints_len(tys) == 0 {
        if mat_rows(m) == 0 { return strs_new(); }
        return none_found;
    }
    if depth > max_pattern_depth() { return none_found; }
    let ty = ints_get(tys, 0);
    let rest_tys = tail_of(tys, 1);
    let rows = spread(c, m);
    let k = ctors_of(c, ty);
    if finite(c, ty) && complete(c, rows, k) {
        let mut i = 0;
        while i < ints_len(k.heads) {
            let fields = ctor_fields(k, i);
            let sub = specialise(c, rows, ints_get(k.heads, i), ints_len(fields));
            let w = witness(c, sub, joined(fields, rest_tys), depth + 1);
            if is_witness(w) {
                let n = imin(ints_len(fields), strs_len(w));
                let args = strs_new();
                let mut j = 0;
                while j < n {
                    strs_push(args, strs_get(w, j));
                    j = j + 1;
                }
                let out = strs_new();
                strs_push(out, build_witness(c, ints_get(k.heads, i), args, ty));
                while j < strs_len(w) {
                    strs_push(out, strs_get(w, j));
                    j = j + 1;
                }
                return out;
            }
            i = i + 1;
        }
        return none_found;
    }
    let w = witness(c, default_rows(c, rows), rest_tys, depth + 1);
    if is_witness(w) == false { return none_found; }
    let mut first = "_";
    if finite(c, ty) {
        let mut i = 0;
        let mut found = false;
        while i < ints_len(k.heads) && found == false {
            if present(c, rows, ints_get(k.heads, i)) == false {
                let anys = strs_new();
                let mut j = 0;
                while j < ints_get(k.tc, i) {
                    strs_push(anys, "_");
                    j = j + 1;
                }
                first = build_witness(c, ints_get(k.heads, i), anys, ty);
                found = true;
            }
            i = i + 1;
        }
    }
    let out = strs_new();
    strs_push(out, first);
    let mut j = 0;
    while j < strs_len(w) {
        strs_push(out, strs_get(w, j));
        j = j + 1;
    }
    out
}

fn is_witness(w: Strs) -> Bool {
    if strs_len(w) == 0 { return true; }
    strs_get(w, 0) != no_witness()
}

fn imin(a: Int, b: Int) -> Int {
    if a < b { return a; }
    b
}

// A constructor applied to its arguments' witnesses, as `Witness::show` writes it.
fn build_witness(c: Ck, head: Int, args: Strs, ty: Int) -> Str {
    if pkind(c, head) == pk_tuple() { return cat3("(", str_join(args, ", "), ")"); }
    if pkind(c, head) == pk_bool() {
        if ints_get(c.pval, head) == 1 { return "true"; }
        return "false";
    }
    let vi = ints_get(c.evf, ta(c, ty)) + ints_get(c.pval, head);
    let parts = strs_new();
    let mut i = 0;
    while i < ints_get(c.vfc, vi) && i < strs_len(args) {
        strs_push(parts, cat3(strs_get(c.fname, ints_get(c.vff, vi) + i), ": ", strs_get(args, i)));
        i = i + 1;
    }
    cat5(show(c, ty), ".", strs_get(c.vname, vi), "(", str_concat(str_join(parts, ", "), ")"))
}

// What one pattern binds: each name, where (absolute), and its type.
pub struct Binds {
    names: Strs,
    starts: Ints,
    ends: Ints,
    tys: Ints,
}

fn no_binds() -> Binds { Binds(names: strs_new(), starts: ints_new(), ends: ints_new(), tys: ints_new()) }

fn pattern_kind(c: Ck, p: Int) -> Str { sx_text(c.t, p) }

// Whether a pattern names a variant anywhere at its top: what needs an enum scrutinee.
fn has_variant_pattern(c: Ck, p: Int) -> Bool {
    let k = pattern_kind(c, p);
    if k == "Variant" { return true; }
    if k == "Or" {
        let alts = kids(c, p, "alts");
        let mut i = 0;
        while i < ints_len(alts) {
            if has_variant_pattern(c, ints_get(alts, i)) { return true; }
            i = i + 1;
        }
    }
    false
}

// `match scrutinee { … }` — written, or what `if let`, `let … else`, `while let` and a `let` of a
// pattern mean (`check_match`).
fn check_match(c: Ck, m: Int, expected: Int) -> Int {
    let scrutinee = fld(c, m, "scrutinee");
    let arms = kids(c, m, "arms");
    let source = sx_text(c.t, fld(c, m, "source"));
    let span = fld(c, m, "span");
    let sty = value_type(c, scrutinee, none());
    let errors_before = dg_len(c.d);
    let mut wants_enum = ints_len(arms) == 0;
    let mut i = 0;
    while i < ints_len(arms) {
        if has_variant_pattern(c, fld(c, ints_get(arms, i), "pattern")) { wants_enum = true; }
        i = i + 1;
    }
    if wants_enum && is_enum(c, sty) == false {
        err(c, "N0342", espan(c, scrutinee), cat3("`match` needs an enum, but this is `", show(c, sty), "`"),
                "a variant pattern selects one variant of an enum. A `Bool`, an integer or a string is matched by literals, and any value by `_` or a name");
        return or_int(expected);
    }
    let mut unresolved = false;
    let rows = mat_new();
    let row_arms = ints_new();
    let mut result = 0 - 3;
    let mut first_value = 0 - 1;
    let mut first_span = 0;
    i = 0;
    while i < ints_len(arms) {
        let arm = ints_get(arms, i);
        let pattern = fld(c, arm, "pattern");
        let body = fld(c, arm, "body");
        // A pattern `let`'s arm, and the rest of the block it holds, are the scope the `let` is
        // written in: a name bound there already is refused as `let x` twice is.
        let joined = i == 0 && (source == "Let" || source == "LetElse");
        if joined { open_joined_scope(c); } else { open_scope(c); }
        let binds = no_binds();
        let before = dg_len(c.d);
        while strs_len(c.pan) > 0 {
            strs_pop(c.pan);
            ints_pop(c.pas);
            ints_pop(c.pae);
        }
        let pat = check_pattern(c, pattern, sty, scrutinee, binds);
        if dg_len(c.d) > before {
            // The pattern is the mistake: its arm's body would only repeat it.
            unresolved = true;
            close_scope(c);
        } else {
            let mut k = 0;
            while k < strs_len(binds.names) {
                let name = strs_get(binds.names, k);
                if bound_in_frame(c, name) {
                    dg_error(c.d, "N0202", ints_get(binds.starts, k), ints_get(binds.ends, k), cat3("`", name, "` is bound twice by this pattern"), "",
                            "each part of a pattern binds a name of its own, or is `_`");
                } else {
                    if defined_here(c, name) {
                        dg_error(c.d, "N0202", ints_get(binds.starts, k), ints_get(binds.ends, k), cat3("`", name, "` is already defined in this scope"), "",
                                "Nazm allows shadowing in a nested scope but not in the same one, so a later mention of a name is never ambiguous");
                    } else {
                        define(c, name, ints_get(binds.tys, k), false, ints_get(binds.starts, k), ints_get(binds.ends, k));
                        sm_put(c.mvar, ints_get(binds.starts, k), ints_get(binds.ends, k), last_binding(c));
                    }
                }
                k = k + 1;
            }
            // An or-pattern's later alternatives bind the same names: the same bindings.
            k = 0;
            ss(c, s_refused(), 0);
            while k < strs_len(c.pan) {
                let b = lookup(c, strs_get(c.pan, k));
                if b >= ints_get(c.frames, ints_len(c.frames) - 1) { note_var(c, ints_get(c.pas, k), ints_get(c.pae, k), b); }
                k = k + 1;
            }
            let guarded = some(c, arm, "guard");
            if guarded {
                let g = unwrap(c, arm, "guard");
                let gt = value_type(c, g, t_bool());
                if gt != t_bool() {
                    err(c, "N0301", espan(c, g), cat3("a `match` arm's guard must be `Bool`, but this is `", show(c, gt), "`"),
                            "Nazm has no truthiness: use a comparison such as `x != 0`");
                }
            }
            if unresolved == false {
                let one_pat = ints_new();
                ints_push(one_pat, pat);
                let one_ty = ints_new();
                ints_push(one_ty, sty);
                if useful(c, rows, one_pat, one_ty, 0) == false { unreachable_arm(c, arms, i, rows, row_arms, pat); }
            }
            if guarded == false {
                let one_pat = ints_new();
                ints_push(one_pat, pat);
                mat_push(c, rows, one_pat);
                ints_push(row_arms, i);
            }
            let mut want = expected;
            if want < 0 { want = first_value; }
            if joined && sx_kind(c.t, body) == tk_tuple() && kind_of(c, body) == "Block" { ss(c, s_join(), 1); }
            let completion = check_expr(c, body, want);
            ss(c, s_join(), 0);
            close_scope(c);
            if source == "LetElse" && i == 1 && completion != diverges() {
                err(c, "N0630", fld(c, arm, "span"), "a `let … else`'s `else` must leave, and this one can finish",
                        "end it with `return`, `break` or `continue`: the names the pattern binds do not exist when it does not match");
            } else {
                if completion >= 0 {
                    if first_value < 0 {
                        first_value = completion;
                        first_span = espan(c, body);
                    } else {
                        if first_value != completion {
                            let swant = show(c, first_value);
                            err(c, "N0302", espan(c, body), cat5("this arm is `", show(c, completion), "`, but an earlier one is `", swant, "`"),
                                    "every arm of a `match` must have the same type");
                            sec(c, first_span, cat3("this one is `", swant, "`"));
                        }
                    }
                }
                if result == 0 - 3 {
                    result = completion;
                } else {
                    if result == diverges() {
                        result = completion;
                    } else {
                        if completion != diverges() {
                            if result == unit() || completion == unit() { result = unit(); }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if unresolved == false { report_uncovered(c, sty, rows, span, source); }
    if unresolved == false && source == "Written" && dg_len(c.d) == errors_before { warn_covering(c, sty, arms); }
    if result != 0 - 3 { return result; }
    if unresolved { return diverges(); }
    or_int(expected)
}

// `N0344`: an arm whose every value an earlier arm matches.
fn unreachable_arm(c: Ck, arms: Ints, index: Int, rows: Mat, row_arms: Ints, pat: Int) -> Int {
    let arm = ints_get(arms, index);
    let pattern = fld(c, arm, "pattern");
    if plain(c, pat) && pattern_kind(c, pattern) == "Variant" {
        let v = sx_kid(c.t, pattern, 0);
        let mut r = 0;
        while r < mat_rows(rows) {
            let first = mat_first(c, rows, r);
            if first >= 0 {
                if plain(c, first) && ints_get(c.pty, first) == ints_get(c.pty, pat) && ints_get(c.pval, first) == ints_get(c.pval, pat) {
                    let other = fld(c, ints_get(arms, ints_get(row_arms, r)), "pattern");
                    if pattern_kind(c, other) == "Variant" {
                        let ty = ints_get(c.pty, pat);
                        let vi = ints_get(c.evf, ta(c, ty)) + ints_get(c.pval, pat);
                        err(c, "N0344", fld(c, v, "variant_span"), cat5("`", show(c, ty), ".", strs_get(c.vname, vi), "` already has an arm"),
                                "the discriminant selects exactly one arm, so a second one for the same variant can never run");
                        sec(c, fld(c, sx_kid(c.t, other, 0), "variant_span"), "first covered here");
                        return 0;
                    }
                    r = mat_rows(rows);
                }
            }
            r = r + 1;
        }
    }
    err(c, "N0344", pattern_span(c.t, pattern), "this arm can never run: the arms above match every value it does",
            "arms are tried in order, and the first that matches runs")
}

// One variant's pattern with every payload discarded.
fn plain(c: Ck, p: Int) -> Bool {
    if pkind(c, p) != pk_ctor() { return false; }
    let args = pargs_of(c, p);
    let mut i = 0;
    while i < ints_len(args) {
        if pkind(c, ints_get(args, i)) != pk_wild() { return false; }
        i = i + 1;
    }
    true
}

// `N0343`: a `match` some value of `sty` escapes.
fn report_uncovered(c: Ck, sty: Int, rows: Mat, span: Int, source: Str) -> Int {
    let one_ty = ints_new();
    ints_push(one_ty, sty);
    let w = witness(c, rows, one_ty, 0);
    if is_witness(w) == false { return 0; }
    let mut shown = "_";
    if strs_len(w) > 0 { shown = strs_get(w, 0); }
    if source == "Let" {
        return err(c, "N0343", span, cat3("this `let` pattern does not match `", shown, "`"),
                "a pattern that can fail needs an `else`: `let P = e else { return …; };`");
    }
    let mut all_plain = true;
    let mut r = 0;
    while r < mat_rows(rows) {
        let first = mat_first(c, rows, r);
        if first < 0 { all_plain = false; } else {
            if plain(c, first) == false { all_plain = false; }
        }
        r = r + 1;
    }
    if is_enum(c, sty) && all_plain {
        let e = ta(c, sty);
        let missing = strs_new();
        let mut v = 0;
        while v < ints_get(c.evc, e) {
            let mut covered = false;
            r = 0;
            while r < mat_rows(rows) {
                if ints_get(c.pval, mat_first(c, rows, r)) == v { covered = true; }
                r = r + 1;
            }
            if covered == false { strs_push(missing, strs_get(c.vname, ints_get(c.evf, e) + v)); }
            v = v + 1;
        }
        err(c, "N0343", span, str_concat("this `match` does not cover ", quoted(missing)),
                cat3("an enum is closed, so every variant of `", show(c, sty), "` gets an arm — or a `_` covers the rest, which gives up being told when a variant is added"));
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        return 0;
    }
    let mut help = "an integer or a string has more values than any list of literals: end with `_` or a name to cover the rest";
    if is_enum(c, sty) || sty == t_bool() { help = "add an arm for it, or end with `_` or a name to cover the rest"; }
    err(c, "N0343", span, cat3("this `match` does not cover `", shown, "`"), help)
}

// `N0632`, a warning: a `match` on an enum whose `_`, or bare name, covers variants no arm names.
fn warn_covering(c: Ck, sty: Int, arms: Ints) -> Int {
    if is_enum(c, sty) == false { return 0; }
    let seen = strs_new();
    let mut i = 0;
    while i < ints_len(arms) {
        named_variants(c, fld(c, ints_get(arms, i), "pattern"), seen);
        i = i + 1;
    }
    let mut catch_all = 0 - 1;
    i = 0;
    while i < ints_len(arms) && catch_all < 0 {
        let arm = ints_get(arms, i);
        let k = pattern_kind(c, fld(c, arm, "pattern"));
        if some(c, arm, "guard") == false && (k == "Wildcard" || k == "Bind") { catch_all = fld(c, arm, "pattern"); }
        i = i + 1;
    }
    if catch_all < 0 { return 0; }
    let shown = show(c, sty);
    let mut base = shown;
    let mut j = 0;
    while j < str_len(shown) {
        if str_byte(shown, j) == 91 {
            base = str_slice(shown, 0, j);
            j = str_len(shown);
        }
        j = j + 1;
    }
    let e = ta(c, sty);
    let covered = strs_new();
    let mut v = 0;
    while v < ints_get(c.evc, e) {
        let n = strs_get(c.vname, ints_get(c.evf, e) + v);
        if strs_find(seen, n) < 0 { strs_push(covered, cat5("`", base, ".", n, "`")); }
        v = v + 1;
    }
    if strs_len(covered) == 0 { return 0; }
    let mut which = "this name";
    if pattern_kind(c, catch_all) == "Wildcard" { which = "`_`"; }
    let at = fld(c, catch_all, "span");
    dg_push(c.w, "N0632", "warning", sps(c, at), spe(c, at),
            cat5(which, " covers ", str_join(covered, ", "), ", which no arm names: a variant added to `", cat3(base, "` later is covered too, without a word", "")), "",
            cat3("name them, so that adding a variant to `", base, "` is reported at this `match`"))
}

fn named_variants(c: Ck, p: Int, out: Strs) -> Int {
    let k = pattern_kind(c, p);
    if k == "Variant" { strs_push(out, fname_of(c, sx_kid(c.t, p, 0), "variant")); }
    if k == "Or" {
        let alts = kids(c, p, "alts");
        let mut i = 0;
        while i < ints_len(alts) {
            named_variants(c, ints_get(alts, i), out);
            i = i + 1;
        }
    }
    0
}

// One pattern against a value of type `ty`: what it binds into `binds`, and what it matches.
fn check_pattern(c: Ck, p: Int, ty: Int, scrutinee: Int, binds: Binds) -> Int {
    let k = pattern_kind(c, p);
    if k == "Wildcard" { return wild(c); }
    if k == "Bind" {
        let at = fld(c, p, "span");
        strs_push(binds.names, fname_of(c, p, "name"));
        ints_push(binds.starts, sps(c, at));
        ints_push(binds.ends, spe(c, at));
        ints_push(binds.tys, ty);
        return wild(c);
    }
    if k == "Literal" { return check_literal_pattern(c, sx_kid(c.t, p, 0), ty); }
    if k == "Variant" { return check_variant_pattern(c, sx_kid(c.t, p, 0), ty, scrutinee, binds); }
    // `(p, q, …)` (L5): a tuple of as many elements, each matching its pattern.
    if k == "Tuple" {
        let elems = kids(c, p, "elems");
        if is_tuple(c, ty) && targc(c, ty) == ints_len(elems) {
            let args = ints_new();
            let mut i = 0;
            while i < ints_len(elems) {
                ints_push(args, check_pattern(c, ints_get(elems, i), targ(c, ty, i), scrutinee, binds));
                i = i + 1;
            }
            return pat_new(c, pk_tuple(), 0, "", ty, args);
        }
        err(c, "N0300", fld(c, p, "span"), cat5("this pattern is a tuple of ", int_to_str(ints_len(elems)), ", but the value is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    // `p | q | …`: each alternative binds the same names, with the same types.
    let alts = kids(c, p, "alts");
    let out = ints_new();
    let mut first = no_binds();
    let mut have_first = false;
    let mut i = 0;
    while i < ints_len(alts) {
        let alt = ints_get(alts, i);
        let own = no_binds();
        ints_push(out, check_pattern(c, alt, ty, scrutinee, own));
        if have_first == false {
            first = own;
            have_first = true;
        } else {
            let mut j = 0;
            while j < strs_len(own.names) {
                strs_push(c.pan, strs_get(own.names, j));
                ints_push(c.pas, ints_get(own.starts, j));
                ints_push(c.pae, ints_get(own.ends, j));
                j = j + 1;
            }
            if same_bindings(c, first, own) == false {
                err(c, "N0629", pattern_span(c.t, alt), "this alternative binds other names, or other types, than the first",
                        "the arm's body sees the same names whichever alternative matched, so each binds them all, with one type each");
                sec(c, fld(c, p, "span"), "in this or-pattern");
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(first.names) {
        strs_push(binds.names, strs_get(first.names, i));
        ints_push(binds.starts, ints_get(first.starts, i));
        ints_push(binds.ends, ints_get(first.ends, i));
        ints_push(binds.tys, ints_get(first.tys, i));
        i = i + 1;
    }
    pat_new(c, pk_or(), 0, "", 0, out)
}

// Whether two alternatives bind the same names with the same types, each list sorted by name.
fn same_bindings(c: Ck, a: Binds, b: Binds) -> Bool {
    if strs_len(a.names) != strs_len(b.names) { return false; }
    let sa = sorted_bindings(a);
    let sb = sorted_bindings(b);
    let mut i = 0;
    while i < strs_len(sa) {
        if strs_get(sa, i) != strs_get(sb, i) { return false; }
        i = i + 1;
    }
    true
}

// A binding list as `name|type` strings, stably sorted by name.
fn sorted_bindings(b: Binds) -> Strs {
    let names = strs_new();
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(b.names) {
        let n = strs_get(b.names, i);
        let mut at = 0;
        while at < strs_len(names) && (str_less(strs_get(names, at), n) || strs_get(names, at) == n) { at = at + 1; }
        insert_str(names, at, n);
        insert_str(out, at, cat3(n, "|", int_to_str(ints_get(b.tys, i))));
        i = i + 1;
    }
    out
}

// A literal pattern: an integer (perhaps negated), a string, `true` or `false`, of the scrutinee's
// type.
fn check_literal_pattern(c: Ck, e: Int, ty: Int) -> Int {
    let k = kind_of(c, e);
    let mut key = "";
    let mut has_key = false;
    if sx_kind(c.t, e) != tk_tuple() {
        if k == "Int" || k == "WideInt" {
            key = str_concat("i", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
        if k == "Neg" {
            let o = fld(c, e, "operand");
            if sx_kind(c.t, o) != tk_tuple() && (kind_of(c, o) == "Int" || kind_of(c, o) == "WideInt") {
                key = str_concat("i-", sx_text(c.t, fld(c, o, "value")));
                has_key = true;
            }
        }
        if k == "Str" {
            key = str_concat("s", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
        if k == "Bool" {
            key = str_concat("b", sx_text(c.t, fld(c, e, "value")));
            has_key = true;
        }
    }
    let literal_type = is_integer(c, ty) || ty == t_bool() || ty == t_str() || bname_of(c, ty) == "Text";
    if has_key == false || literal_type == false {
        let mut message = cat3("a `", show(c, ty), "` has no literal pattern");
        if literal_type { message = "a literal pattern is an integer, a string, `true` or `false`"; }
        err(c, "N0300", espan(c, e), message,
                "a `Bool`, an integer or a string is matched by literals; a float's equality is not what a literal reads as, so it has none");
        return wild(c);
    }
    let t = value_type(c, e, ty);
    if t != ty {
        err(c, "N0300", espan(c, e), cat5("this pattern is a `", show(c, t), "`, but the value is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    if k == "Bool" {
        if sx_text(c.t, fld(c, e, "value")) == "true" { return pat_new(c, pk_bool(), 1, "", 0, ints_new()); }
        return pat_new(c, pk_bool(), 0, "", 0, ints_new());
    }
    pat_new(c, pk_lit(), 0, key, 0, ints_new())
}

// `Enum.Variant(field: pattern, …)` against a value of type `ty`.
fn check_variant_pattern(c: Ck, v: Int, ty: Int, scrutinee: Int, binds: Binds) -> Int {
    if is_enum(c, ty) == false {
        err(c, "N0342", fld(c, v, "ty_span"), cat3("a variant pattern needs an enum, but this is a `", show(c, ty), "`"), "");
        return wild(c);
    }
    let tname = written_key(c, v, "ty");
    let mut named = ta(c, ty);
    if tname != "" {
        let def = resolve_type(c, tname, fld(c, v, "ty_span"));
        if is_enum(c, def) == false {
            enum_refused(c, tname, def, fld(c, v, "ty_span"));
            return wild(c);
        }
        named = ta(c, def);
    }
    // The enum a pattern names is a definition: the value supplies its arguments.
    if named != ta(c, ty) {
        let want = show(c, ty);
        err(c, "N0345", fld(c, v, "ty_span"), cat5("this pattern is a `", show(c, enum_ty(c, named, ints_new())), "`, but the value is a `", want, "`"),
                "a variant belongs to its enum, so a pattern names the value's own enum. There is no structural matching between two enums that happen to have a variant of the same name");
        sec(c, espan(c, scrutinee), cat3("this is a `", want, "`"));
        return wild(c);
    }
    let variant = fname_of(c, v, "variant");
    let vi = variant_of(c, ty, variant);
    let e = ta(c, ty);
    if vi < 0 {
        let known = strs_new();
        let mut i = 0;
        while i < ints_get(c.evc, e) {
            strs_push(known, strs_get(c.vname, ints_get(c.evf, e) + i));
            i = i + 1;
        }
        let mut help = "";
        if strs_len(known) > 0 { help = str_concat("its variants are ", quoted(known)); }
        err(c, "N0341", fld(c, v, "variant_span"), cat5("`", show(c, ty), "` has no variant `", variant, "`"), help);
        sec_at(c, ints_get(c.ens, e), ints_get(c.ene, e), "declared here");
        return wild(c);
    }
    let at = vi - ints_get(c.evf, e);
    // What Core IR reads of the arm (`Resolution::variant`): the scrutinee's enum and the index.
    sm_put(c.mvty, sps(c, fld(c, v, "variant_span")), spe(c, fld(c, v, "variant_span")), ty);
    sm_put(c.mvix, sps(c, fld(c, v, "variant_span")), spe(c, fld(c, v, "variant_span")), at);
    let path = cat3(show(c, ty), ".", variant);
    let arity = ints_get(c.vfc, vi);
    let args = wilds(c, arity);
    let fields = kids(c, v, "fields");
    // Payload patterns by position (R1.5, D4): named in declaration order.
    let names = strs_new();
    let mut positional = false;
    let mut by_name = false;
    let mut i = 0;
    while i < ints_len(fields) {
        let n = fname_of(c, ints_get(fields, i), "name");
        strs_push(names, n);
        if n == "" { positional = true; } else { by_name = true; }
        i = i + 1;
    }
    if positional {
        if by_name || ints_len(fields) != arity {
            err(c, "N0334", fld(c, v, "span"), cat5(cat3("`", path, "` has "), int_to_str(arity), str_concat(" payload field", plural(arity)),
                    ": a pattern gives every one by position, in the order declared, or every one by name", ""), "");
            return wild(c);
        }
        i = 0;
        while i < arity {
            strs_set(names, i, strs_get(c.fname, ints_get(c.vff, vi) + i));
            i = i + 1;
        }
    }
    let given = strs_new();
    let gs_ = ints_new();
    i = 0;
    while i < ints_len(fields) {
        let f = ints_get(fields, i);
        let name = strs_get(names, i);
        let ns = fld(c, f, "name_span");
        let fi = variant_field(c, vi, name);
        if fi < 0 {
            err(c, "N0333", ns, cat5("`", path, "` has no payload field `", name, "`"), "");
            sec_at(c, ints_get(c.vns, vi), ints_get(c.vne, vi), "declared here");
        } else {
            let first = strs_find(given, name);
            if first >= 0 {
                err(c, "N0332", ns, cat3("this pattern names `", name, "` twice"), "");
                sec(c, ints_get(gs_, first), "first named here");
            } else {
                strs_push(given, name);
                ints_push(gs_, ns);
                sm_put(c.minit, sps(c, ns), spe(c, ns), fi - ints_get(c.vff, vi));
                sm_put(c.mfini, sps(c, ns), spe(c, ns), fi);
                let sub = check_pattern(c, fld(c, f, "pattern"), field_ty_in(c, ty, fi), scrutinee, binds);
                ints_set(args, fi - ints_get(c.vff, vi), sub);
            }
        }
        i = i + 1;
    }
    let missing = strs_new();
    i = 0;
    while i < arity {
        let n = strs_get(c.fname, ints_get(c.vff, vi) + i);
        if strs_find(given, n) < 0 { strs_push(missing, n); }
        i = i + 1;
    }
    if strs_len(missing) > 0 {
        err(c, "N0334", fld(c, v, "variant_span"), cat5("this pattern does not name ", quoted(missing), " of `", path, "`"),
                "a pattern names every payload field, matching it or discarding it with `_`. There is no rest pattern, so adding a payload field breaks the patterns that did not know about it rather than ignoring it");
    }
    pat_new(c, pk_ctor(), at, "", ty, args)
}

// --- constants (`constants::evaluate`, Gate 2 and L8) ----------------------------------------------

// A constant's kind: what this checker computes — a number of any type, a `Bool` or a `Str`; a
// constant of a record, an enum, a tuple or an array is checked against its type (`k_agg`). A
// number's kind is 100 plus its type's place among the built-in types; `Int`'s is 0.
fn k_int() -> Int { 0 }
fn k_bool() -> Int { 1 }
fn k_str() -> Int { 2 }
// A static `Atomic` (Gate 3): a cell, named in a body as an `Atomic`, never a value.
fn k_atomic() -> Int { 3 }

fn k_num(name: Str) -> Int {
    if name == "Int" { return k_int(); }
    100 + strs_find(builtin_names(), name)
}

fn k_is_num(k: Int) -> Bool { k == k_int() || k >= 100 }
fn k_is_float(k: Int) -> Bool { k >= 100 && is_float_name(kind_name(k)) }
fn k_is_integer(k: Int) -> Bool { k_is_num(k) && k_is_float(k) == false }

fn kind_type(c: Ck, k: Int) -> Int {
    if k_is_agg(k) { return 0 - 10 - k; }
    if k == k_atomic() { return builtin_ty(c, "Atomic"); }
    if k == k_bool() { return t_bool(); }
    if k == k_str() { return t_str(); }
    if k >= 100 { return builtin_ty(c, kind_name(k)); }
    t_int()
}

fn kind_name(k: Int) -> Str {
    if k_is_agg(k) { return "this type"; }
    if k == k_bool() { return "Bool"; }
    if k == k_str() { return "Str"; }
    if k >= 100 { return strs_get(builtin_names(), k - 100); }
    "Int"
}

// A number type's width and whether it is signed (`NumKind::bits`).
fn kind_bits(k: Int) -> Int {
    let n = kind_name(k);
    if n == "Int8" || n == "UInt8" { return 8; }
    if n == "Int16" || n == "UInt16" { return 16; }
    if n == "Int32" || n == "UInt32" || n == "Float32" { return 32; }
    if n == "Int128" || n == "UInt128" { return 128; }
    64
}
fn kind_signed(k: Int) -> Bool { str_starts(kind_name(k), "U") == false }
fn str_starts(s: Str, p: Str) -> Bool { str_len(s) >= str_len(p) && str_slice(s, 0, str_len(p)) == p }

// An integer type's range (`NumKind::int_range`), as its refusal's help writes it.
fn kind_lo(k: Int) -> Str {
    let n = kind_name(k);
    if n == "Int8" { return "-128"; }
    if n == "Int16" { return "-32768"; }
    if n == "Int32" { return "-2147483648"; }
    if n == "Int" { return "-9223372036854775808"; }
    if n == "Int128" { return "-170141183460469231731687303715884105728"; }
    "0"
}
fn kind_hi(k: Int) -> Str {
    let n = kind_name(k);
    if n == "Int8" { return "127"; }
    if n == "Int16" { return "32767"; }
    if n == "Int32" { return "2147483647"; }
    if n == "Int" { return "9223372036854775807"; }
    if n == "Int128" { return "170141183460469231731687303715884105727"; }
    if n == "UInt8" { return "255"; }
    if n == "UInt16" { return "65535"; }
    if n == "UInt32" { return "4294967295"; }
    if n == "UInt64" { return "18446744073709551615"; }
    "340282366920938463463374607431768211455"
}

fn kind_fits(k: Int, w: Ints) -> Bool { w_cmp(w, w_parse(kind_lo(k))) >= 0 && w_cmp(w, w_parse(kind_hi(k))) <= 0 }

// A declaration's kind as its written type says (`declared`), or -1 for one this checker does not
// compute.
fn const_kind(c: Ck, decl: Int) -> Int {
    let ty = fld(c, decl, "ty");
    if some(c, ty, "args") || some(c, ty, "function") || some(c, ty, "qualifier") || some(c, ty, "length") { return 0 - 1; }
    let name = fname_of(c, ty, "name");
    if is_num_name(name) { return k_num(name); }
    if name == "Bool" { return k_bool(); }
    if name == "Str" { return k_str(); }
    0 - 1
}

// --- wide integers (`numeric::Wide`) -------------------------------------------------------------

// A sign (index 0) and a magnitude of 16 limbs of 16 bits, least first: every integer type's
// value, and the product of any two, exact without passing `Int`'s range.
fn wl() -> Int { 16 }
fn w_base() -> Int { 65536 }

fn w_zero() -> Ints {
    let w = ints_new();
    let mut i = 0;
    while i <= wl() {
        ints_push(w, 0);
        i = i + 1;
    }
    w
}

fn w_copy(a: Ints) -> Ints {
    let w = ints_new();
    let mut i = 0;
    while i <= wl() {
        ints_push(w, ints_get(a, i));
        i = i + 1;
    }
    w
}

fn w_neg_of(a: Ints) -> Bool { ints_get(a, 0) == 1 }

fn m_is_zero(a: Ints) -> Bool {
    let mut i = 1;
    while i <= wl() {
        if ints_get(a, i) != 0 { return false; }
        i = i + 1;
    }
    true
}

// `a`, its sign made `-` only where it is negative and not zero.
fn w_signed(a: Ints, negative: Bool) -> Ints {
    if negative && m_is_zero(a) == false { ints_set(a, 0, 1); } else { ints_set(a, 0, 0); }
    a
}

// `a = a * m + add` on the magnitude; the carry out of the top limb.
fn m_muladd(a: Ints, m: Int, add: Int) -> Int {
    let mut carry = add;
    let mut i = 1;
    while i <= wl() {
        let v = ints_get(a, i) * m + carry;
        ints_set(a, i, v % w_base());
        carry = v / w_base();
        i = i + 1;
    }
    carry
}

// `a = a / d` on the magnitude, for a small `d`; the remainder.
fn m_divsmall(a: Ints, d: Int) -> Int {
    let mut rem = 0;
    let mut i = wl();
    while i >= 1 {
        let v = rem * w_base() + ints_get(a, i);
        ints_set(a, i, v / d);
        rem = v % d;
        i = i - 1;
    }
    rem
}

// A decimal integer, perhaps after a `-`.
fn w_parse(s: Str) -> Ints {
    let w = w_zero();
    let mut i = 0;
    let negative = str_len(s) > 0 && str_byte(s, 0) == 45;
    if negative { i = 1; }
    while i < str_len(s) {
        m_muladd(w, 10, str_byte(s, i) - 48);
        i = i + 1;
    }
    w_signed(w, negative)
}

fn w_from_int(n: Int) -> Ints {
    if n >= 0 { return w_parse(int_to_str(n)); }
    // `-(-(n + 1) + 1)`, so `Int`'s least value is never negated.
    let w = w_parse(int_to_str(0 - (n + 1)));
    m_muladd(w, 1, 1);
    w_signed(w, true)
}

// A value in `Int`'s range, as an `Int`.
fn w_to_int(a: Ints) -> Int {
    let mut v = 0;
    let mut i = 4;
    while i >= 1 {
        if w_neg_of(a) { v = v * w_base() - ints_get(a, i); } else { v = v * w_base() + ints_get(a, i); }
        i = i - 1;
    }
    v
}

fn w_show(a: Ints) -> Str {
    let m = w_copy(a);
    if m_is_zero(m) { return "0"; }
    let digits = strs_new();
    while m_is_zero(m) == false { strs_push(digits, int_to_str(m_divsmall(m, 10))); }
    let out = strs_new();
    if w_neg_of(a) { strs_push(out, "-"); }
    let mut i = strs_len(digits) - 1;
    while i >= 0 {
        strs_push(out, strs_get(digits, i));
        i = i - 1;
    }
    str_join(out, "")
}

fn m_cmp(a: Ints, b: Ints) -> Int {
    let mut i = wl();
    while i >= 1 {
        if ints_get(a, i) < ints_get(b, i) { return 0 - 1; }
        if ints_get(a, i) > ints_get(b, i) { return 1; }
        i = i - 1;
    }
    0
}

fn w_cmp(a: Ints, b: Ints) -> Int {
    if w_neg_of(a) && w_neg_of(b) == false { return 0 - 1; }
    if w_neg_of(a) == false && w_neg_of(b) { return 1; }
    if w_neg_of(a) { return m_cmp(b, a); }
    m_cmp(a, b)
}

fn m_add(a: Ints, b: Ints) -> Ints {
    let w = w_zero();
    let mut carry = 0;
    let mut i = 1;
    while i <= wl() {
        let v = ints_get(a, i) + ints_get(b, i) + carry;
        ints_set(w, i, v % w_base());
        carry = v / w_base();
        i = i + 1;
    }
    w
}

// `a - b` on magnitudes, `a` the larger.
fn m_sub(a: Ints, b: Ints) -> Ints {
    let w = w_zero();
    let mut borrow = 0;
    let mut i = 1;
    while i <= wl() {
        let mut v = ints_get(a, i) - ints_get(b, i) - borrow;
        borrow = 0;
        if v < 0 {
            v = v + w_base();
            borrow = 1;
        }
        ints_set(w, i, v);
        i = i + 1;
    }
    w
}

fn w_add(a: Ints, b: Ints) -> Ints {
    if w_neg_of(a) == w_neg_of(b) { return w_signed(m_add(a, b), w_neg_of(a)); }
    if m_cmp(a, b) >= 0 { return w_signed(m_sub(a, b), w_neg_of(a)); }
    w_signed(m_sub(b, a), w_neg_of(b))
}

fn w_negate(a: Ints) -> Ints { w_signed(w_copy(a), w_neg_of(a) == false) }
fn w_sub(a: Ints, b: Ints) -> Ints { w_add(a, w_negate(b)) }

fn w_mul(a: Ints, b: Ints) -> Ints {
    let w = w_zero();
    let mut i = 1;
    while i <= wl() {
        let x = ints_get(a, i);
        if x != 0 {
            let mut carry = 0;
            let mut j = 1;
            while i + j - 1 <= wl() {
                let v = ints_get(w, i + j - 1) + x * ints_get(b, j) + carry;
                ints_set(w, i + j - 1, v % w_base());
                carry = v / w_base();
                j = j + 1;
            }
        }
        i = i + 1;
    }
    w_signed(w, w_neg_of(a) != w_neg_of(b))
}

fn m_bit(a: Ints, n: Int) -> Int { (ints_get(a, n / 16 + 1) / pow2(n % 16)) % 2 }

// Truncating division of magnitudes, bit by bit: the quotient, or with `rem` the remainder.
fn m_divmod(a: Ints, b: Ints, rem: Bool) -> Ints {
    let q = w_zero();
    let r = w_zero();
    let mut n = wl() * 16 - 1;
    while n >= 0 {
        m_muladd(r, 2, m_bit(a, n));
        if m_cmp(r, b) >= 0 {
            let s = m_sub(r, b);
            let mut i = 1;
            while i <= wl() {
                ints_set(r, i, ints_get(s, i));
                i = i + 1;
            }
            ints_set(q, n / 16 + 1, ints_get(q, n / 16 + 1) + pow2(n % 16));
        }
        n = n - 1;
    }
    if rem { return r; }
    q
}

// `a / b` and `a % b`, truncating (`Wide::quotient`, `Wide::remainder`).
fn w_quot(a: Ints, b: Ints) -> Ints { w_signed(m_divmod(a, b, false), w_neg_of(a) != w_neg_of(b)) }
fn w_rem(a: Ints, b: Ints) -> Ints { w_signed(m_divmod(a, b, true), w_neg_of(a)) }

fn w_pow2(n: Int) -> Ints {
    let w = w_zero();
    ints_set(w, n / 16 + 1, pow2(n % 16));
    w
}

// A value's bits in a type `bits` wide, as a magnitude: two's complement for a negative one.
fn w_bits(a: Ints, bits: Int) -> Ints {
    if w_neg_of(a) { return m_sub(w_pow2(bits), a); }
    w_signed(w_copy(a), false)
}

// The value whose bits are a magnitude's low `bits` (`NumVal::wrapped`).
fn w_wrapped(a: Ints, bits: Int, signed: Bool) -> Ints {
    let m = m_divmod(a, w_pow2(bits), true);
    if signed && m_cmp(m, w_pow2(bits - 1)) >= 0 { return w_signed(m_sub(w_pow2(bits), m), true); }
    m
}

// `&`, `|` or `^` (`op` 0, 1, 2) of two magnitudes, bit by bit.
fn m_bitwise(a: Ints, b: Ints, op: Int) -> Ints {
    let w = w_zero();
    let mut n = 0;
    while n < wl() * 16 {
        let x = m_bit(a, n);
        let y = m_bit(b, n);
        let mut v = 0;
        if op == 0 { v = x * y; }
        if op == 1 && x + y > 0 { v = 1; }
        if op == 2 && x + y == 1 { v = 1; }
        if v == 1 { ints_set(w, n / 16 + 1, ints_get(w, n / 16 + 1) + pow2(n % 16)); }
        n = n + 1;
    }
    w
}

// One module's constants as they are computed: the values done so far (an import's first, then
// the module's own), the names being computed, and a pool of the values met on the way.
pub struct Cev {
    decls: Ints,
    names: Strs,
    kinds: Ints,
    ints: Ints,
    strs: Strs,
    active: Strs,
    vk: Ints,
    vi: Ints,
    vs: Strs,
    d: Diags,
    // The module's static `Atomic`s (Gate 3): cells, not values — and what each starts as (0
    // where that could not be computed, as `cell` records it).
    cells: Strs,
    cellv: Ints,
    // Each constant of a record, enum, tuple or array type whose type resolved (L8), by name.
    aggn: Strs,
    aggt: Ints,
    // The value of the aggregate being computed, as `ev_agg` meets its parts (`ConstValue`):
    // one token each — `R<type>:<n>` a record or tuple of `n` fields, `V<type>:<variant>:<n>` a
    // variant, `A<type>:<n>` an array, `N<kind>:<value>` a number or a `Bool`, `S<hex>` a `Str`,
    // `F` a float — each followed by its parts. Joined by spaces, it is the constant's value
    // (`ev.strs`), which Core IR reads (`ck_const_text`).
    parts: Strs,
}

// A name written at `span` that is a constant of module `m` itself (`record_const_ref`: an
// imported one is no use the reference index records).
fn note_const_ref(c: Ck, m: Int, name: Str, span: Int) -> Int {
    let decls = kids(c, ints_get(c.mprog, m), "consts");
    let mut found = 0 - 1;
    let mut i = 0;
    while i < ints_len(decls) {
        // The first of a name declared twice: the later one is no declaration (`N0203`), and a use is of the first.
        if found < 0 && fname_of(c, ints_get(decls, i), "name") == name { found = ints_get(decls, i); }
        i = i + 1;
    }
    if found >= 0 { sm_put(c.mcref, sps(c, span), spe(c, span), sps(c, fld(c, found, "name_span"))); }
    0
}

// The first declaration of `name`: the one a use of it is of, a later one being a duplicate (`N0203`) the reference index does not hold.
fn const_decl_first(c: Ck, ev: Cev, name: Str) -> Int {
    let mut i = 0;
    while i < ints_len(ev.decls) {
        if fname_of(c, ints_get(ev.decls, i), "name") == name { return ints_get(ev.decls, i); }
        i = i + 1;
    }
    0 - 1
}

// The declaration of `name` a map collected from the module's would hold: its last.
fn const_decl(c: Ck, ev: Cev, name: Str) -> Int {
    let mut found = 0 - 1;
    let mut i = 0;
    while i < ints_len(ev.decls) {
        if fname_of(c, ints_get(ev.decls, i), "name") == name { found = ints_get(ev.decls, i); }
        i = i + 1;
    }
    found
}

fn ev_set(ev: Cev, name: Str, kind: Int, n: Int, s: Str) -> Int {
    let at = strs_find(ev.names, name);
    if at >= 0 {
        ints_set(ev.kinds, at, kind);
        ints_set(ev.ints, at, n);
        strs_set(ev.strs, at, s);
        return at;
    }
    strs_push(ev.names, name);
    ints_push(ev.kinds, kind);
    ints_push(ev.ints, n);
    strs_push(ev.strs, s);
    strs_len(ev.names) - 1
}

fn ev_val(ev: Cev, kind: Int, n: Int, s: Str) -> Int {
    ints_push(ev.vk, kind);
    ints_push(ev.vi, n);
    strs_push(ev.vs, s);
    ints_len(ev.vk) - 1
}

fn ev_bool(ev: Cev, b: Bool) -> Int {
    if b { return ev_val(ev, k_bool(), 1, ""); }
    ev_val(ev, k_bool(), 0, "")
}

// Compute module `m`'s constants (`evaluate`), each refusal into `d`: the constants its imports
// export first — under each name it imports them by, a later import's hiding an earlier's — its
// own names hiding them, then each declaration in order.
fn evaluate_consts(c: Ck, m: Int, d: Diags, aggregates: Bool) -> Cev {
    ss(c, s_module(), m);
    let ev = Cev(decls: kids(c, ints_get(c.mprog, m), "consts"), names: strs_new(), kinds: ints_new(), ints: ints_new(), strs: strs_new(),
            active: strs_new(), vk: ints_new(), vi: ints_new(), vs: strs_new(), d: d, cells: strs_new(), cellv: ints_new(), aggn: strs_new(), aggt: ints_new(), parts: strs_new());
    let mut k = 0;
    while k < deps(c, m) {
        let dp = dep(c, m, k);
        let on = ints_get(c.don, dp);
        if ints_get(c.mexp, on) == 1 {
            let mut x = 0;
            while x < ints_len(c.xmod) {
                if ints_get(c.xmod, x) == on {
                    let name = strs_get(c.xname, x);
                    let mut a = 0;
                    while a < ints_get(c.dac, dp) {
                        ev_set(ev, cat3(strs_get(c.aname, ints_get(c.daf, dp) + a), "::", name), ints_get(c.xkind, x), ints_get(c.xint, x),
                                strs_get(c.xstr, x));
                        a = a + 1;
                    }
                    if ints_get(c.dplain, dp) == 1 && const_decl(c, ev, name) < 0 {
                        ev_set(ev, name, ints_get(c.xkind, x), ints_get(c.xint, x), strs_get(c.xstr, x));
                    }
                }
                x = x + 1;
            }
        }
        k = k + 1;
    }
    let mut i = 0;
    while i < ints_len(ev.decls) {
        let decl = ints_get(ev.decls, i);
        let name = fname_of(c, decl, "name");
        let ns = fld(c, decl, "name_span");
        // The first other declaration of the name; a later declaration than it is a duplicate.
        let mut prior = 0 - 1;
        let mut j = 0;
        while j < ints_len(ev.decls) {
            let other = ints_get(ev.decls, j);
            if prior < 0 && j != i && fname_of(c, other, "name") == name { prior = other; }
            j = j + 1;
        }
        if prior >= 0 && sx_s(c.t, fld(c, prior, "name_span")) < sx_s(c.t, ns) {
            dg_error(d, "N0203", sps(c, ns), spe(c, ns), cat3("`", name, "` is declared twice in this module"), "", "");
            dg_secondary(d, sps(c, fld(c, prior, "name_span")), spe(c, fld(c, prior, "name_span")), "first declared here");
        } else {
            // A constant is exported by its value (L8); a static is storage, its module's.
            if flag(c, decl, "is_static") && some(c, decl, "pub_span") {
                let ps = unwrap(c, decl, "pub_span");
                dg_error(d, "N0101", sps(c, ps), spe(c, ps), cat3("`", name, "` cannot be exported: a static is its own module's"), "",
                        "a static is storage with one address in its module; export a function that reads it, or a constant if its value never changes");
            }
            if static_atomic(c, decl) { ev_cell(c, ev, decl); } else { ev_constant(c, ev, name); }
        }
        i = i + 1;
    }
    // The second phase (L8, `compute_aggregates`): each constant of a record, enum, tuple or array
    // type, its type resolved where the module's types are known — one that does not resolve is
    // one error, not a second about its value — then each computed in declaration order.
    if aggregates {
        type_environment(c, m, false);
        let order = strs_new();
        i = 0;
        while i < ints_len(ev.decls) {
            let decl = ints_get(ev.decls, i);
            if flag(c, decl, "is_static") == false && const_kind(c, decl) < 0 {
                let before = dg_len(d);
                let t = resolve_written(c, fld(c, decl, "ty"), strs_new(), ints_new(), d);
                if dg_len(d) == before {
                    strs_push(ev.aggn, fname_of(c, decl, "name"));
                    ints_push(ev.aggt, t);
                    strs_push(order, fname_of(c, decl, "name"));
                }
            }
            i = i + 1;
        }
        i = 0;
        while i < strs_len(order) {
            ev_constant(c, ev, strs_get(order, i));
            i = i + 1;
        }
    }
    ev
}

// A constant of a record, enum, tuple or array type has the kind -10 minus its type.
fn k_agg(t: Int) -> Int { 0 - 10 - t }
fn k_is_agg(k: Int) -> Bool { k <= 0 - 10 }

// The kind of a value of a number type, `Bool` or `Str`, or -1.
fn scalar_kind(c: Ck, t: Int) -> Int {
    if t == t_int() { return k_int(); }
    if t == t_bool() { return k_bool(); }
    if t == t_str() { return k_str(); }
    if t >= 0 && is_num(c, t) { return k_num(bname_of(c, t)); }
    0 - 1
}

// A constant of a record, enum, tuple or array type (`aggregate`): a value, never a handle; still
// declared at its type when refused, so a use is not a second error.
fn ev_aggregate(c: Ck, ev: Cev, name: Str, decl: Int, t: Int) -> Int {
    let handle = not_value(c, t, true);
    if handle >= 0 {
        let ts = fld(c, fld(c, decl, "ty"), "span");
        dg_error(ev.d, "N0622", sps(c, ts), spe(c, ts), cat5("a constant is a value, and `", show(c, t), "` holds a `", show(c, handle), "`"), "",
                "a constant is a number, a `Bool`, a `Str`, or a record, enum, tuple or array of them — computed when the program is checked, with no storage");
        return 0 - 1;
    }
    strs_push(ev.active, name);
    let mark = strs_len(ev.parts);
    ev_agg(c, ev, fld(c, decl, "value"), t);
    strs_pop(ev.active);
    let value = strs_new();
    let mut i = mark;
    while i < strs_len(ev.parts) {
        strs_push(value, strs_get(ev.parts, i));
        i = i + 1;
    }
    while strs_len(ev.parts) > mark { strs_pop(ev.parts); }
    ev_set(ev, name, k_agg(t), 0, str_join(value, " "))
}

// A scalar value of the pool as a token of an aggregate's value (`parts`).
fn ev_part(ev: Cev, v: Int) -> Int {
    let k = ints_get(ev.vk, v);
    if k == k_int() || k == k_bool() {
        strs_push(ev.parts, cat4("N", int_to_str(k), ":", int_to_str(ints_get(ev.vi, v))));
        return 0;
    }
    if k == k_str() {
        strs_push(ev.parts, str_concat("S", hex_text(strs_get(ev.vs, v))));
        return 0;
    }
    if k_is_float(k) {
        strs_push(ev.parts, cat4("F", int_to_str(k), ":", strs_get(ev.vs, v)));
        return 0;
    }
    strs_push(ev.parts, cat4("N", int_to_str(k), ":", strs_get(ev.vs, v)));
    0
}

fn hex_text(s: Str) -> Str {
    let digits = "0123456789abcdef";
    let out = strs_new();
    let mut i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        strs_push(out, str_slice(digits, b / 16, b / 16 + 1));
        strs_push(out, str_slice(digits, b % 16, b % 16 + 1));
        i = i + 1;
    }
    str_join(out, "")
}

fn ev_mismatch(c: Ck, ev: Cev, span: Int, t: Int) -> Bool {
    dg_error(ev.d, "N0300", sps(c, span), spe(c, span), cat3("a constant of type `", show(c, t), "` is not this"), "", "");
    false
}

// The written name of a record's or enum's type, before its arguments (`base`).
fn base_name(c: Ck, t: Int) -> Str {
    let shown = show(c, t);
    let mut i = 0;
    while i < str_len(shown) {
        if str_byte(shown, i) == 91 { return str_slice(shown, 0, i); }
        i = i + 1;
    }
    shown
}

// `e` as a value of `t` (`agg`): a record, enum, tuple or array built of constant parts, or a
// scalar constant expression; whether it is one.
fn ev_agg(c: Ck, ev: Cev, e: Int, t: Int) -> Bool {
    let sk = scalar_kind(c, t);
    if sk >= 0 {
        let v = ev_value(c, ev, e, sk);
        if v < 0 { return false; }
        if ints_get(ev.vk, v) != sk { return ev_mismatch(c, ev, espan(c, e), t); }
        ev_part(ev, v);
        return true;
    }
    if sx_kind(c.t, e) == tk_tuple() { return ev_mismatch(c, ev, espan(c, e), t); }
    let k = kind_of(c, e);
    if k == "Var" {
        let name = fname_of(c, e, "name");
        let span = fld(c, e, "span");
        let own = const_decl(c, ev, name) >= 0;
        if own { sm_put(c.mcref, sps(c, span), spe(c, span), sps(c, fld(c, const_decl_first(c, ev, name), "name_span"))); }
        // Its own constant, or one an import exports (L8).
        if own == false && strs_find(ev.names, name) < 0 {
            ev_refuse(c, ev, span, cat3("name `", name, "`, which is not a constant"));
            return false;
        }
        let i = ev_constant(c, ev, name);
        if i < 0 { return false; }
        if kind_type(c, ints_get(ev.kinds, i)) != t { return ev_mismatch(c, ev, span, t); }
        strs_push(ev.parts, strs_get(ev.strs, i));
        return true;
    }
    if is_record(c, t) && k == "Tuple" {
        let elems = kids(c, e, "elems");
        if is_tuple(c, t) == false || targc(c, t) != ints_len(elems) { return ev_mismatch(c, ev, fld(c, e, "span"), t); }
        strs_push(ev.parts, cat4("R", int_to_str(t), ":", int_to_str(ints_len(elems))));
        let mut i = 0;
        while i < ints_len(elems) {
            if ev_agg(c, ev, ints_get(elems, i), targ(c, t, i)) == false { return false; }
            i = i + 1;
        }
        return true;
    }
    if is_record(c, t) && k == "Construct" && is_tuple(c, t) == false {
        if fname_of(c, e, "ty") == base_name(c, t) {
            let want = strs_new();
            let wty = ints_new();
            let r = ta(c, t);
            let mut i = 0;
            while i < ints_get(c.rfc, r) {
                strs_push(want, strs_get(c.fname, ints_get(c.rff, r) + i));
                ints_push(wty, field_ty_in(c, t, ints_get(c.rff, r) + i));
                i = i + 1;
            }
            strs_push(ev.parts, cat4("R", int_to_str(t), ":", int_to_str(strs_len(want))));
            return ev_fields(c, ev, want, wty, kids(c, e, "fields"), fld(c, e, "span"));
        }
    }
    if is_enum(c, t) && k == "Variant" {
        if fname_of(c, e, "ty") == base_name(c, t) {
            let en = ta(c, t);
            let vn = fname_of(c, e, "variant");
            let mut vi = 0 - 1;
            let mut v = 0;
            while v < ints_get(c.evc, en) {
                if vi < 0 && strs_get(c.vname, ints_get(c.evf, en) + v) == vn { vi = ints_get(c.evf, en) + v; }
                v = v + 1;
            }
            if vi < 0 { return ev_mismatch(c, ev, fld(c, e, "variant_span"), t); }
            let want = strs_new();
            let wty = ints_new();
            let mut i = 0;
            while i < ints_get(c.vfc, vi) {
                strs_push(want, strs_get(c.fname, ints_get(c.vff, vi) + i));
                ints_push(wty, field_ty_in(c, t, ints_get(c.vff, vi) + i));
                i = i + 1;
            }
            strs_push(ev.parts, cat4(cat3("V", int_to_str(t), ":"), int_to_str(vi - ints_get(c.evf, en)), ":", int_to_str(strs_len(want))));
            return ev_fields(c, ev, want, wty, kids(c, e, "fields"), fld(c, e, "span"));
        }
    }
    if is_array(c, t) && k == "Array" {
        let elems = kids(c, e, "elems");
        if ints_len(elems) != ta(c, t) { return ev_mismatch(c, ev, fld(c, e, "span"), t); }
        strs_push(ev.parts, cat4("A", int_to_str(t), ":", int_to_str(ints_len(elems))));
        let mut i = 0;
        while i < ints_len(elems) {
            if ev_agg(c, ev, ints_get(elems, i), array_elem(c, t)) == false { return false; }
            i = i + 1;
        }
        return true;
    }
    if is_array(c, t) && k == "ArrayRepeat" {
        let n = ev_value(c, ev, fld(c, e, "count"), k_int());
        if n < 0 { return false; }
        let nk = ints_get(ev.vk, n);
        if k_is_integer(nk) == false || w_cmp(ev_wide(ev, n), w_from_int(ta(c, t))) != 0 { return ev_mismatch(c, ev, fld(c, e, "span"), t); }
        // Its element, once for each place.
        strs_push(ev.parts, cat4("A", int_to_str(t), ":", int_to_str(ta(c, t))));
        let mark = strs_len(ev.parts);
        if ev_agg(c, ev, fld(c, e, "value"), array_elem(c, t)) == false { return false; }
        let one = strs_new();
        let mut i = mark;
        while i < strs_len(ev.parts) {
            strs_push(one, strs_get(ev.parts, i));
            i = i + 1;
        }
        let mut k = 1;
        while k < ta(c, t) {
            strs_push(ev.parts, str_join(one, " "));
            k = k + 1;
        }
        return true;
    }
    if k == "Call" {
        ev_refuse(c, ev, fld(c, e, "span"), "call a function");
        return false;
    }
    ev_mismatch(c, ev, espan(c, e), t)
}

// A construction's fields as declared (`fields`): each once, in declaration order — or every one
// by position.
fn ev_fields(c: Ck, ev: Cev, want: Strs, wty: Ints, inits: Ints, at: Int) -> Bool {
    let mut positional = ints_len(inits) > 0;
    let mut i = 0;
    while i < ints_len(inits) {
        if fname_of(c, ints_get(inits, i), "name") != "" { positional = false; }
        i = i + 1;
    }
    if positional {
        if ints_len(inits) != strs_len(want) {
            dg_error(ev.d, "N0300", sps(c, at), spe(c, at),
                    cat5("this constant's construction gives ", int_to_str(ints_len(inits)), " of its ", int_to_str(strs_len(want)), " fields by position"), "", "");
            return false;
        }
        i = 0;
        while i < ints_len(inits) {
            if ev_agg(c, ev, fld(c, ints_get(inits, i), "value"), ints_get(wty, i)) == false { return false; }
            i = i + 1;
        }
        return true;
    }
    i = 0;
    while i < ints_len(inits) {
        let f = ints_get(inits, i);
        if strs_find(want, fname_of(c, f, "name")) < 0 {
            let ns = fld(c, f, "name_span");
            dg_error(ev.d, "N0300", sps(c, ns), spe(c, ns), cat3("there is no field `", fname_of(c, f, "name"), "` here"), "", "");
            return false;
        }
        i = i + 1;
    }
    let mut w = 0;
    while w < strs_len(want) {
        let mut found = 0 - 1;
        i = 0;
        while i < ints_len(inits) {
            if found < 0 && fname_of(c, ints_get(inits, i), "name") == strs_get(want, w) { found = ints_get(inits, i); }
            i = i + 1;
        }
        if found < 0 {
            dg_error(ev.d, "N0300", sps(c, at), spe(c, at), cat3("this constant's construction does not give `", strs_get(want, w), "`"), "", "");
            return false;
        }
        if ev_agg(c, ev, fld(c, found, "value"), ints_get(wty, w)) == false { return false; }
        w = w + 1;
    }
    true
}

// Whether a declaration is a static `Atomic`, its type written plainly (`is_atomic`).
fn static_atomic(c: Ck, decl: Int) -> Bool {
    let ty = fld(c, decl, "ty");
    if flag(c, decl, "is_static") == false { return false; }
    some(c, ty, "args") == false && some(c, ty, "function") == false && some(c, ty, "qualifier") == false && fname_of(c, ty, "name") == "Atomic"
}

// A static `Atomic` (`cell`): its value is `atomic_new(c)` of a constant `Int`, the one call a
// static's value may make. A cell whose start could not be computed is still declared.
fn ev_cell(c: Ck, ev: Cev, decl: Int) -> Int {
    let name = fname_of(c, decl, "name");
    let value = fld(c, decl, "value");
    let mut call = false;
    let mut init = 0;
    if sx_kind(c.t, value) != tk_tuple() && kind_of(c, value) == "Call" {
        call = some(c, value, "qualifier") == false && fname_of(c, value, "callee") == "atomic_new" && ints_len(kids(c, value, "args")) == 1
                && some(c, value, "type_args") == false;
    }
    if call {
        let a = ints_get(kids(c, value, "args"), 0);
        strs_push(ev.active, name);
        let v = ev_value(c, ev, a, k_int());
        strs_pop(ev.active);
        if v >= 0 && ints_get(ev.vk, v) != k_int() { dg_error(ev.d, "N0300", sps(c, espan(c, a)), spe(c, espan(c, a)), "an atomic holds an `Int`", "", ""); }
        if v >= 0 && ints_get(ev.vk, v) == k_int() { init = ints_get(ev.vi, v); }
    } else {
        dg_error(ev.d, "N0622", sps(c, espan(c, value)), spe(c, espan(c, value)), "a static `Atomic` starts as `atomic_new(c)` of a constant `c`", "",
                "`atomic_new` is the one call a static's value may make");
    }
    strs_push(ev.cells, name);
    ints_push(ev.cellv, init);
    0
}

// A constant's value (`constant`): its index among the values done, or -1 where it has none.
fn ev_constant(c: Ck, ev: Cev, name: Str) -> Int {
    let done = strs_find(ev.names, name);
    if done >= 0 { return done; }
    let decl = const_decl(c, ev, name);
    if decl < 0 { return 0 - 1; }
    let ns = fld(c, decl, "name_span");
    if strs_find(ev.active, name) >= 0 {
        dg_error(ev.d, "N0622", sps(c, ns), spe(c, ns), cat3("`", name, "`'s value depends on itself"), "", "");
        return 0 - 1;
    }
    let kind = const_kind(c, decl);
    // A record, enum, tuple or array (L8): the second phase's, where its type resolved.
    if kind < 0 && flag(c, decl, "is_static") == false {
        let a = strs_find(ev.aggn, name);
        if a >= 0 { return ev_aggregate(c, ev, name, decl, ints_get(ev.aggt, a)); }
        if strs_len(ev.active) > 0 {
            dg_error(ev.d, "N0622", sps(c, ns), spe(c, ns), cat3("`", name, "` is not a number, a `Bool` or a `Str`, which this needs"), "", "");
        }
        return 0 - 1;
    }
    // A static is a number or a `Bool` (an `Atomic` is a cell): storage, which a `Str` is not.
    if flag(c, decl, "is_static") && (kind < 0 || kind == k_str()) {
        let ty = fld(c, decl, "ty");
        dg_error(ev.d, "N0622", sps(c, fld(c, ty, "span")), spe(c, fld(c, ty, "span")),
                cat3("a static is a number, a `Bool` or an `Atomic`, and `", fname_of(c, ty, "name"), "` is none"), "",
                "a static is storage with one address; a `Str` is a constant's");
        return 0 - 1;
    }
    let value = fld(c, decl, "value");
    strs_push(ev.active, name);
    let v = ev_value(c, ev, value, kind);
    strs_pop(ev.active);
    // One that could not be computed is still declared, at its type: one mistake, one error.
    if v < 0 {
        ev_set(ev, name, kind, 0, "");
        return 0 - 1;
    }
    if ints_get(ev.vk, v) != kind {
        dg_error(ev.d, "N0300", sps(c, espan(c, value)), spe(c, espan(c, value)),
                cat5(cat3("`", name, "` is declared `"), kind_name(kind), "`, and this is `", kind_name(ints_get(ev.vk, v)), "`"), "", "");
        return 0 - 1;
    }
    ev_set(ev, name, kind, ints_get(ev.vi, v), strs_get(ev.vs, v))
}

fn ev_refuse(c: Ck, ev: Cev, span: Int, why: Str) -> Int {
    dg_error(ev.d, "N0622", sps(c, span), spe(c, span), str_concat("a constant's value cannot ", why), "",
            "a constant is literals, other constants, operators and numeric conversions `T(x)`");
    0 - 1
}

fn ev_fails(c: Ck, ev: Cev, span: Int, what: Str) -> Int {
    dg_error(ev.d, "N0623", sps(c, span), spe(c, span), str_concat("this constant ", what), "", "");
    0 - 1
}

// A number's value in the pool: an `Int`'s as itself, any other integer's as its decimal digits,
// and a float's as nothing — this checker computes no float, and stops where one would decide
// anything (a comparison, a conversion to an integer).
fn ev_num(ev: Cev, kind: Int, w: Ints) -> Int {
    if kind == k_int() { return ev_val(ev, k_int(), w_to_int(w), ""); }
    ev_val(ev, kind, 0, w_show(w))
}

fn ev_wide(ev: Cev, v: Int) -> Ints {
    if ints_get(ev.vk, v) == k_int() { return w_from_int(ints_get(ev.vi, v)); }
    w_parse(strs_get(ev.vs, v))
}

// A number checked against its type's range (`NumVal::checked`): its value, or -1 where it
// overflows.
fn ev_checked(c: Ck, ev: Cev, kind: Int, w: Ints, at: Int) -> Int {
    if kind_fits(kind, w) == false { return ev_fails(c, ev, at, "overflows its type"); }
    ev_num(ev, kind, w)
}

// An integer literal (`integer`): of the integer type expected, `Int` otherwise; refused, by name,
// where its value does not fit.
fn ev_integer(c: Ck, ev: Cev, digits: Str, want: Int, span: Int) -> Int {
    let mut k = k_int();
    if k_is_integer(want) { k = want; }
    let w = w_parse(digits);
    if kind_fits(k, w) == false {
        dg_error(ev.d, "N0003", sps(c, span), spe(c, span), cat5("`", w_show(w), "` does not fit in `", kind_name(k), "`"), "",
                cat4(cat3("`", kind_name(k), "` holds "), kind_lo(k), " to ", kind_hi(k)));
        return 0 - 1;
    }
    ev_num(ev, k, w)
}

// An expression's value (`value`), as a value of `want` where that decides a literal's type: its
// index in the pool, or -1 where it was refused.
fn ev_value(c: Ck, ev: Cev, e: Int, want: Int) -> Int {
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() { return ev_refuse(c, ev, espan(c, e), "be computed from this"); }
    if k == "Int" || k == "WideInt" { return ev_integer(c, ev, sx_text(c.t, fld(c, e, "value")), want, fld(c, e, "span")); }
    // A float literal keeps its text, which Core IR reads its value from; this checker computes
    // no float, so anything made of one but its negation has none ("").
    if k == "Float" {
        let text = sx_text(c.t, fld(c, e, "text"));
        if kind_name(want) == "Float32" { return ev_val(ev, want, 0, text); }
        return ev_val(ev, k_num("Float64"), 0, text);
    }
    if k == "Bool" { return ev_bool(ev, sx_text(c.t, fld(c, e, "value")) == "true"); }
    if k == "Str" { return ev_val(ev, k_str(), 0, sx_text(c.t, fld(c, e, "value"))); }
    if k == "Var" {
        let name = fname_of(c, e, "name");
        // A static atomic's cell changes as the program runs: no constant is made of it.
        let decl = const_decl(c, ev, name);
        let first = const_decl_first(c, ev, name);
        if first >= 0 { sm_put(c.mcref, sps(c, fld(c, e, "span")), spe(c, fld(c, e, "span")), sps(c, fld(c, first, "name_span"))); }
        if decl >= 0 && static_atomic(c, decl) { return ev_refuse(c, ev, fld(c, e, "span"), cat3("read the atomic `", name, "`")); }
        let i = ev_constant(c, ev, name);
        if i >= 0 { return ev_val(ev, ints_get(ev.kinds, i), ints_get(ev.ints, i), strs_get(ev.strs, i)); }
        if const_decl(c, ev, name) >= 0 { return 0 - 1; }
        return ev_refuse(c, ev, fld(c, e, "span"), cat3("name `", name, "`, which is not a constant"));
    }
    if k == "Neg" {
        let o = fld(c, e, "operand");
        // `-128` where an `Int8` is wanted is one literal, judged whole.
        if sx_kind(c.t, o) != tk_tuple() && (kind_of(c, o) == "Int" || kind_of(c, o) == "WideInt") && k_is_integer(want) && want != k_int() {
            return ev_integer(c, ev, str_concat("-", sx_text(c.t, fld(c, o, "value"))), want, fld(c, o, "span"));
        }
        let v = ev_value(c, ev, o, want);
        if v < 0 { return 0 - 1; }
        let vk = ints_get(ev.vk, v);
        if k_is_num(vk) == false { return ev_refuse(c, ev, fld(c, e, "span"), "negate something that is not a number"); }
        if k_is_float(vk) {
            let text = strs_get(ev.vs, v);
            if text == "" { return ev_val(ev, vk, 0, ""); }
            if str_byte(text, 0) == 45 { return ev_val(ev, vk, 0, str_slice(text, 1, str_len(text))); }
            return ev_val(ev, vk, 0, str_concat("-", text));
        }
        return ev_checked(c, ev, vk, w_negate(ev_wide(ev, v)), fld(c, e, "span"));
    }
    if k == "BitNot" {
        let v = ev_value(c, ev, fld(c, e, "operand"), want);
        if v < 0 { return 0 - 1; }
        let vk = ints_get(ev.vk, v);
        if k_is_integer(vk) == false { return ev_refuse(c, ev, fld(c, e, "span"), "complement something that is not an integer"); }
        // `~x` is `-x - 1` for a signed type and `MAX - x` for an unsigned one.
        if kind_signed(vk) { return ev_num(ev, vk, w_sub(w_negate(ev_wide(ev, v)), w_parse("1"))); }
        return ev_num(ev, vk, w_sub(w_parse(kind_hi(vk)), ev_wide(ev, v)));
    }
    if k == "Not" {
        let v = ev_value(c, ev, fld(c, e, "operand"), k_bool());
        if v < 0 { return 0 - 1; }
        if ints_get(ev.vk, v) != k_bool() { return ev_refuse(c, ev, fld(c, e, "span"), "negate something that is not a `Bool`"); }
        return ev_bool(ev, ints_get(ev.vi, v) == 0);
    }
    if k == "Binary" { return ev_binary(c, ev, e, want); }
    if k == "Call" {
        let callee = fname_of(c, e, "callee");
        let args = kids(c, e, "args");
        if some(c, e, "qualifier") == false && some(c, e, "type_args") == false && is_num_name(callee) && ints_len(args) == 1 {
            let to = k_num(callee);
            let span = fld(c, e, "span");
            let v = ev_value(c, ev, ints_get(args, 0), to);
            if v < 0 { return 0 - 1; }
            let vk = ints_get(ev.vk, v);
            if k_is_num(vk) == false { return ev_refuse(c, ev, span, "convert something that is not a number"); }
            if k_is_float(to) { return ev_val(ev, to, 0, ""); }
            if k_is_float(vk) {
                stop(c, "a float converted to an integer in a constant");
                return 0 - 1;
            }
            return ev_checked(c, ev, to, ev_wide(ev, v), span);
        }
    }
    ev_refuse(c, ev, espan(c, e), "be computed from this")
}

fn ev_binary(c: Ck, ev: Cev, e: Int, want: Int) -> Int {
    let op = sx_text(c.t, fld(c, e, "op"));
    let at = fld(c, e, "op_span");
    if is_logical(op) {
        let l = ev_value(c, ev, fld(c, e, "lhs"), k_bool());
        if l < 0 { return 0 - 1; }
        if ints_get(ev.vk, l) != k_bool() { return ev_refuse(c, ev, at, "combine values that are not `Bool`s with this"); }
        let a = ints_get(ev.vi, l) == 1;
        if (op == "And" && a == false) || (op == "Or" && a) { return ev_bool(ev, a); }
        return ev_value(c, ev, fld(c, e, "rhs"), k_bool());
    }
    // A comparison's operands are typed by each other; arithmetic's by what is wanted.
    let mut hint = want;
    if is_comparison(op) { hint = k_int(); }
    let shift = op == "Shl" || op == "Shr";
    let l = ev_value(c, ev, fld(c, e, "lhs"), hint);
    if l < 0 { return 0 - 1; }
    let lk = ints_get(ev.vk, l);
    let mut rhint = lk;
    if shift { rhint = k_int(); }
    let r = ev_value(c, ev, fld(c, e, "rhs"), rhint);
    if r < 0 { return 0 - 1; }
    let rk = ints_get(ev.vk, r);
    if k_is_num(lk) && k_is_num(rk) {
        if shift == false && lk != rk { return ev_refuse(c, ev, at, "combine two numeric types"); }
        let arith = op == "Add" || op == "Sub" || op == "Mul" || op == "Div" || op == "Rem";
        if k_is_float(lk) {
            // Floats never fail; this checker computes none, so one compared stops it.
            if arith { return ev_val(ev, lk, 0, ""); }
            if is_comparison(op) {
                stop(c, "a float compared in a constant");
                return 0 - 1;
            }
            return ev_refuse(c, ev, at, "apply this operator to these values");
        }
        let a = ev_wide(ev, l);
        if shift && k_is_float(rk) {
            stop(c, "a shift by a float in a constant");
            return 0 - 1;
        }
        let b = ev_wide(ev, r);
        if op == "Add" { return ev_checked(c, ev, lk, w_add(a, b), at); }
        if op == "Sub" { return ev_checked(c, ev, lk, w_sub(a, b), at); }
        if op == "Mul" { return ev_checked(c, ev, lk, w_mul(a, b), at); }
        if op == "Div" || op == "Rem" {
            if m_is_zero(b) { return ev_fails(c, ev, at, "divides by zero"); }
            if op == "Div" { return ev_checked(c, ev, lk, w_quot(a, b), at); }
            return ev_checked(c, ev, lk, w_rem(a, b), at);
        }
        let bits = kind_bits(lk);
        let signed = kind_signed(lk);
        if op == "BitAnd" { return ev_num(ev, lk, w_wrapped(m_bitwise(w_bits(a, bits), w_bits(b, bits), 0), bits, signed)); }
        if op == "BitOr" { return ev_num(ev, lk, w_wrapped(m_bitwise(w_bits(a, bits), w_bits(b, bits), 1), bits, signed)); }
        if op == "BitXor" { return ev_num(ev, lk, w_wrapped(m_bitwise(w_bits(a, bits), w_bits(b, bits), 2), bits, signed)); }
        if shift {
            if w_neg_of(b) || w_cmp(b, w_from_int(bits)) >= 0 { return ev_fails(c, ev, at, "shifts out of range"); }
            let p = w_pow2(w_to_int(b));
            if op == "Shl" { return ev_num(ev, lk, w_wrapped(w_mul(w_bits(a, bits), p), bits, signed)); }
            // Arithmetic for a signed type, so the quotient rounds toward negative infinity.
            let q = w_quot(a, p);
            if w_neg_of(a) && m_is_zero(w_rem(a, p)) == false { return ev_num(ev, lk, w_sub(q, w_parse("1"))); }
            return ev_num(ev, lk, q);
        }
        let order = w_cmp(a, b);
        if op == "Eq" { return ev_bool(ev, order == 0); }
        if op == "NotEq" { return ev_bool(ev, order != 0); }
        if op == "Lt" { return ev_bool(ev, order < 0); }
        if op == "LtEq" { return ev_bool(ev, order <= 0); }
        if op == "Gt" { return ev_bool(ev, order > 0); }
        if op == "GtEq" { return ev_bool(ev, order >= 0); }
        return ev_refuse(c, ev, at, "apply this operator to these values");
    }
    if lk == k_bool() && rk == k_bool() {
        if op == "Eq" { return ev_bool(ev, ints_get(ev.vi, l) == ints_get(ev.vi, r)); }
        if op == "NotEq" { return ev_bool(ev, ints_get(ev.vi, l) != ints_get(ev.vi, r)); }
        return ev_refuse(c, ev, at, "apply this operator to `Bool`s");
    }
    if lk == k_str() && rk == k_str() {
        if op == "Eq" { return ev_bool(ev, strs_get(ev.vs, l) == strs_get(ev.vs, r)); }
        if op == "NotEq" { return ev_bool(ev, strs_get(ev.vs, l) != strs_get(ev.vs, r)); }
        return ev_refuse(c, ev, at, "apply this operator to `Str`s");
    }
    ev_refuse(c, ev, at, "combine values of two types")
}

// The modules in an order with each after the modules it imports (`dependency_order`), where the
// imports allow it: a cycle's members in the order first reached.
fn dependency_order(c: Ck) -> Ints {
    let n = ints_len(c.mprog);
    let state = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(state, 0);
        i = i + 1;
    }
    let out = ints_new();
    let mut start = 0;
    while start < n {
        if ints_get(state, start) == 0 {
            let sn = ints_new();
            let snext = ints_new();
            ints_push(sn, start);
            ints_push(snext, 0);
            ints_set(state, start, 1);
            while ints_len(sn) > 0 {
                let m = ints_pop(sn);
                let next = ints_pop(snext);
                if next < deps(c, m) {
                    let d = ints_get(c.don, dep(c, m, next));
                    ints_push(sn, m);
                    ints_push(snext, next + 1);
                    if ints_get(state, d) == 0 {
                        ints_set(state, d, 1);
                        ints_push(sn, d);
                        ints_push(snext, 0);
                    }
                } else {
                    ints_set(state, m, 2);
                    ints_push(out, m);
                }
            }
        }
        start = start + 1;
    }
    out
}

// Stage 1b (`declare_all_consts`): every module's constants in dependency order, each refusal
// reported, and each module then exporting its `pub` ones.
fn declare_all_consts(c: Ck) -> Int {
    let order = dependency_order(c);
    let mut i = 0;
    while i < ints_len(order) {
        let m = ints_get(order, i);
        let ev = evaluate_consts(c, m, c.d, true);
        let mut k = 0;
        while k < ints_len(ev.decls) {
            let decl = ints_get(ev.decls, k);
            let name = fname_of(c, decl, "name");
            let at = strs_find(ev.names, name);
            if some(c, decl, "pub_span") && at >= 0 && flag(c, decl, "is_static") == false {
                ints_push(c.xmod, m);
                strs_push(c.xname, name);
                ints_push(c.xkind, ints_get(ev.kinds, at));
                ints_push(c.xint, ints_get(ev.ints, at));
                strs_push(c.xstr, strs_get(ev.strs, at));
            }
            k = k + 1;
        }
        ints_set(c.mexp, m, 1);
        i = i + 1;
    }
    0
}

// The constants module `m`'s bodies may name, computed again silently: its own and its imports'.
fn const_environment(c: Ck, m: Int) -> Int {
    while strs_len(c.kname) > 0 {
        strs_pop(c.kname);
        ints_pop(c.kkind);
        ints_pop(c.kint);
        strs_pop(c.kstr);
    }
    let ev = evaluate_consts(c, m, dg_new(), true);
    let mut i = 0;
    while i < strs_len(ev.names) {
        strs_push(c.kname, strs_get(ev.names, i));
        ints_push(c.kkind, ints_get(ev.kinds, i));
        ints_push(c.kint, ints_get(ev.ints, i));
        strs_push(c.kstr, strs_get(ev.strs, i));
        i = i + 1;
    }
    // Its static `Atomic`s, after its values: a name is a value's before it is a cell's.
    i = 0;
    while i < strs_len(ev.cells) {
        if strs_find(c.kname, strs_get(ev.cells, i)) < 0 {
            strs_push(c.kname, strs_get(ev.cells, i));
            ints_push(c.kkind, k_atomic());
            ints_push(c.kint, 0);
            strs_push(c.kstr, "");
        }
        i = i + 1;
    }
    0
}

// Module `m`'s statics (Gate 3, `record_module_names`), four lines each: its name, then `cell`
// and what it starts as, or `value`, its type's name and its value as `print.rs` writes it — or
// `-` where this checker did not compute it (a float, a value that failed). In declaration order,
// a name's first declaration only.
pub fn ck_module_statics(c: Ck, m: Int) -> Strs {
    let out = strs_new();
    let consts = kids(c, ints_get(c.mprog, m), "consts");
    let mut any = false;
    let mut i = 0;
    while i < ints_len(consts) {
        if flag(c, ints_get(consts, i), "is_static") { any = true; }
        i = i + 1;
    }
    if any == false { return out; }
    let saved = gs(c, s_module());
    let ev = evaluate_consts(c, m, dg_new(), false);
    ss(c, s_module(), saved);
    let seen = strs_new();
    i = 0;
    while i < ints_len(consts) {
        let decl = ints_get(consts, i);
        let name = fname_of(c, decl, "name");
        if flag(c, decl, "is_static") && strs_find(seen, name) < 0 {
            strs_push(seen, name);
            let cell = strs_find(ev.cells, name);
            let at = strs_find(ev.names, name);
            if cell >= 0 {
                strs_push(out, name);
                strs_push(out, "cell");
                strs_push(out, "Atomic");
                strs_push(out, int_to_str(ints_get(ev.cellv, cell)));
            } else {
                if at >= 0 {
                    let k = ints_get(ev.kinds, at);
                    strs_push(out, name);
                    strs_push(out, "value");
                    strs_push(out, kind_name(k));
                    if k == k_int() {
                        strs_push(out, json_str(int_to_str(ints_get(ev.ints, at))));
                    } else {
                        if k == k_bool() {
                            if ints_get(ev.ints, at) == 1 { strs_push(out, "true"); } else { strs_push(out, "false"); }
                        } else {
                            if k_is_integer(k) { strs_push(out, json_str(strs_get(ev.strs, at))); } else { strs_push(out, "-"); }
                        }
                    }
                } else {
                    strs_push(out, name);
                    strs_push(out, "value");
                    strs_push(out, "");
                    strs_push(out, "-");
                }
            }
        }
        i = i + 1;
    }
    out
}

// The module being checked's static of this name, or -1 (`Constants::statics`).
fn static_named(c: Ck, name: Str) -> Int {
    let consts = kids(c, ints_get(c.mprog, gs(c, s_module())), "consts");
    let mut i = 0;
    while i < ints_len(consts) {
        let decl = ints_get(consts, i);
        if flag(c, decl, "is_static") && fname_of(c, decl, "name") == name { return decl; }
        i = i + 1;
    }
    0 - 1
}

// Where a name is first declared among the module's constants and statics (`Constants::decls`).
fn first_declared(c: Ck, name: Str) -> Int {
    let consts = kids(c, ints_get(c.mprog, gs(c, s_module())), "consts");
    let mut i = 0;
    while i < ints_len(consts) {
        let decl = ints_get(consts, i);
        if fname_of(c, decl, "name") == name { return fld(c, decl, "name_span"); }
        i = i + 1;
    }
    0 - 1
}

// --- `?` (`check_propagate`) ---------------------------------------------------------------------

// Whether a type is an application of the core prelude's enum of this name — by definition, so a
// module's own enum of the same shape is not one.
fn prelude_enum(c: Ck, t: Int, name: Str) -> Bool { is_enum(c, t) && ta(c, t) == declared_enum(c, prelude(c), name) && targc(c, t) > 0 }

// `operand?`: a `Result[T, E]`'s `T` in a function returning a `Result[U, E]`, or an
// `Option[T]`'s `T` in one returning an `Option` (R1, 5b.17); its completion is the operand's.
fn check_propagate(c: Ck, e: Int, expected: Int) -> Int {
    let operand = fld(c, e, "operand");
    let at = fld(c, e, "op_span");
    refuse_leaving_defer(c, "`?`", at);
    let ot = check_expr(c, operand, none());
    if ot == diverges() { return diverges(); }
    if ot == unit() {
        err(c, "N0300", espan(c, operand), "this produces no value", "`?` takes apart a `Result`, and this is not a value at all");
        return or_int(expected);
    }
    let declared = gs(c, s_ret());
    if declared == no_return_type() {
        stop(c, "a `?` in a body whose result type is inferred");
        return or_int(expected);
    }
    let shown_ret = show(c, declared);
    let rspan = gs(c, s_rs());
    if prelude_enum(c, ot, "Option") {
        if prelude_enum(c, declared, "Option") == false {
            err(c, "N0361", at,
                    cat3("`?` on an `Option` can only be used in a function that returns an `Option`, and this one returns `", shown_ret, "`"),
                    "`?` leaves the function with `None`. Here, `match` on the value instead");
            sec(c, rspan, cat3("declared `", shown_ret, "` here"));
        }
        return targ(c, ot, 0);
    }
    let shown = show(c, ot);
    if prelude_enum(c, ot, "Result") == false || targc(c, ot) != 2 {
        err(c, "N0360", at, cat3("`?` needs a `Result`, but this is `", shown, "`"),
                "`?` propagates the core prelude's `Result` and `Option` and nothing else — not an enum with the same variants. Take the value apart with `match` instead");
        sec(c, espan(c, operand), cat3("this is `", shown, "`"));
        return or_int(expected);
    }
    let ok = targ(c, ot, 0);
    let error = targ(c, ot, 1);
    if prelude_enum(c, declared, "Result") == false || targc(c, declared) != 2 {
        err(c, "N0361", at, cat3("`?` can only be used in a function that returns a `Result`, and this one returns `", shown_ret, "`"),
                "`?` leaves the function with the error, so the function has to return a `Result` with the same error type. Here, `match` on the value and decide what the error means instead");
        sec(c, rspan, cat3("declared `", shown_ret, "` here"));
        return ok;
    }
    let into_err = targ(c, declared, 1);
    if error != into_err {
        let have = show(c, error);
        let want = show(c, into_err);
        err(c, "N0362", at, cat5("this `?` propagates a `", have, "`, but the function's error type is `", want, "`"),
                "there is no conversion between error types: `?` returns the error value as it is. Match on the value and build the error this function returns");
        sec(c, espan(c, operand), cat3("its error type is `", have, "`"));
        sec(c, rspan, cat3("the function returns `", want, "` errors"));
    }
    ok
}

// Why a name before a variant's `.` is no enum (`resolve_enum`), its unknown name already reported.
fn enum_refused(c: Ck, name: Str, t: Int, span: Int) -> Int {
    if is_record(c, t) {
        return err(c, "N0341", span, cat3("`", show(c, t), "` is a record, so it has no variants"),
                "a record is built by naming its fields: `Point(x: 1, y: 2)`");
    }
    if is_builtin_name(name) {
        return err(c, "N0341", span, cat3("`", show(c, t), "` is a built-in type, so it has no variants"), "only an `enum` has variants");
    }
    0
}

// --- effects and authority (`nazm-core/src/effects.rs`) -----------------------------------------

fn pow2(n: Int) -> Int {
    let mut v = 1;
    let mut i = 0;
    while i < n {
        v = v * 2;
        i = i + 1;
    }
    v
}
fn has_bit(mask: Int, bit: Int) -> Bool { (mask / pow2(bit)) % 2 == 1 }
fn with_bit(mask: Int, bit: Int) -> Int {
    if has_bit(mask, bit) { return mask; }
    mask + pow2(bit)
}

fn effect_names() -> Strs {
    let s = strs_new();
    strs_push(s, "io");
    strs_push(s, "spawn");
    strs_push(s, "foreign");
    s
}

// A capability kind's bit: its place in `CapabilityKind::ALL`, which the built-in type names
// list from `IoCap` on.
fn cap_bit(name: Str) -> Int { strs_find(builtin_names(), name) - 6 }
fn cap_name(bit: Int) -> Str { strs_get(builtin_names(), bit + 6) }
fn cap_article(bit: Int) -> Str {
    let n = cap_name(bit);
    if n == "IoCap" || n == "MmioCap" || n == "OutCap" { return "an"; }
    "a"
}

// The set a declaration writes (`effects::declared`), every unknown and duplicate name reported;
// -1 when a name is no effect.
fn declared_effects(c: Ck, decl: Int) -> Int { declared_effects_to(c, decl, c.d) }

// The same, its refusals into `d`.
fn declared_effects_to(c: Ck, decl: Int, d: Diags) -> Int {
    let names = kids(c, decl, "names");
    let mut set = 0;
    let mut known = true;
    let mut i = 0;
    while i < ints_len(names) {
        let pair = ints_get(names, i);
        let name = sx_text(c.t, sx_kid(c.t, pair, 0));
        let span = sx_kid(c.t, pair, 1);
        let mut e = strs_find(effect_names(), name);
        // The effect parameter in scope, by the name it declared (N51), shadows nothing.
        if e < 0 && eparam(c) >= 0 {
            if name == effect_param_name(c, eparam(c)) { e = 3; }
        }
        if e < 0 {
            known = false;
            dg_error(d, "N0367", sps(c, span), spe(c, span), cat3("`", name, "` is not an effect"), "",
                    "the effects are `io` and `spawn` and `foreign`. There are no user-defined effects");
        } else {
            if has_bit(set, e) {
                let word = effect_text(e, "*");
                dg_error(d, "N0368", sps(c, span), spe(c, span), cat3("`", word, "` is written twice in this effect set"), "", "");
                if i > 0 {
                    let before = sx_kid(c.t, ints_get(names, i - 1), 1);
                    dg_fix(d, spe(c, before), spe(c, span), "", cat3("remove the second `", word, "`"), "automatic",
                            "a set holds an effect once, so the second one means nothing");
                }
            } else {
                set = with_bit(set, e);
            }
        }
        i = i + 1;
    }
    if known { return set; }
    0 - 1
}

// The authority the bindings in scope hold: each capability-typed binding no later one hides.
fn held_caps(c: Ck) -> Int {
    let mut held = 0;
    let mut i = 0;
    while i < strs_len(c.sname) {
        let t = ints_get(c.sty, i);
        if is_cap(c, t) {
            let mut hidden = false;
            let mut k = i + 1;
            while k < strs_len(c.sname) {
                if strs_get(c.sname, k) == strs_get(c.sname, i) { hidden = true; }
                k = k + 1;
            }
            if hidden == false { held = with_bit(held, cap_bit(bname_of(c, t))); }
        }
        i = i + 1;
    }
    held
}

// A resolved call, filed under the function whose body holds it (`record_site`).
fn record_site(c: Ck, at: Int, target: Int) -> Int {
    // A body of no declared function (the method of an impl the checker refused) still has its calls recorded, as the reference records `calls` by span, but is no
    // function's: its sites hold -1 for their function, which no per-function walk meets.
    let f = gs(c, s_fn());
    sm_put(c.msite, sps(c, at), spe(c, at), ints_len(c.sfn));
    ints_push(c.stm, 0 - 1);
    ints_push(c.starg, 0 - 1);
    ints_push(c.sfn, f);
    ints_push(c.sstart, sps(c, at));
    ints_push(c.send, spe(c, at));
    if target >= 0 {
        ints_push(c.sbuiltin, 0 - 1);
        ints_push(c.suser, target);
    } else {
        ints_push(c.sbuiltin, 0 - 2 - target);
        ints_push(c.suser, 0 - 1);
    }
    ints_push(c.sind, 0 - 1);
    ints_push(c.sspawn, 0);
    ints_push(c.sbind, 0);
    ints_push(c.sheld, held_caps(c));
    ints_push(c.sargf, ints_len(c.sargs));
    ints_push(c.sipf, 0 - 1);
    ints_push(c.sargc, 0);
    ints_push(c.sret, 0 - 1);
    0
}

// A call through a function value (`Callee::Indirect`): what it may do is its type's.
fn record_indirect_site(c: Ck, at: Int, t: Int) -> Int {
    let f = gs(c, s_fn());
    sm_put(c.msite, sps(c, at), spe(c, at), ints_len(c.sfn));
    ints_push(c.stm, 0 - 1);
    ints_push(c.starg, 0 - 1);
    ints_push(c.sfn, f);
    ints_push(c.sstart, sps(c, at));
    ints_push(c.send, spe(c, at));
    ints_push(c.sbuiltin, 0 - 1);
    ints_push(c.suser, 0 - 1);
    ints_push(c.sind, t);
    ints_push(c.sspawn, 0);
    ints_push(c.sbind, 0);
    ints_push(c.sheld, held_caps(c));
    ints_push(c.sargf, ints_len(c.sargs));
    ints_push(c.sipf, 0 - 1);
    ints_push(c.sargc, 0);
    ints_push(c.sret, 0 - 1);
    0
}

// How a function is named in a message about it: `` `f` ``, or `this closure in `f`` (N50).
fn fn_label(c: Ck, f: Int) -> Str {
    let mut name = strs_get(c.fnname, f);
    // An impl's method is named as it is written, not as `Trait/Type/m`.
    if ints_get(c.fnmeth, f) == 1 { return tick(fname_of(c, ints_get(c.fnnode, f), "name")); }
    if ints_get(c.fnclos, f) < 0 { return tick(name); }
    let hash = index_of_text(name, "#");
    if hash >= 0 { name = str_slice(name, 0, hash); }
    cat3("this closure in `", name, "`")
}

fn builtin_effect(c: Ck, b: Int) -> Int { strs_find(effect_names(), strs_get(c.beff, b)) }

fn builtin_caps(c: Ck, b: Int) -> Int {
    let names = split(strs_get(c.bcaps, b), 44);
    let mut set = 0;
    let mut i = 0;
    while i < strs_len(names) {
        if strs_get(names, i) != "" { set = with_bit(set, cap_bit(strs_get(names, i))); }
        i = i + 1;
    }
    set
}

// Why each function requires each effect: the first reason met. Each reason: the function, the
// effect, where, its source (1 a built-in, 2 a declared callee, 3 an inferred one) and which.
pub struct Reasons {
    fnid: Ints,
    effect: Ints,
    start: Ints,
    end: Ints,
    source: Ints,
    which: Ints,
}

fn reason_of(rs: Reasons, f: Int, effect: Int) -> Int {
    let mut i = 0;
    while i < ints_len(rs.fnid) {
        if ints_get(rs.fnid, i) == f && ints_get(rs.effect, i) == effect { return i; }
        i = i + 1;
    }
    0 - 1
}

fn describe(c: Ck, rs: Reasons, r: Int) -> Str {
    let e = tick(effect_text(ints_get(rs.effect, r), "*"));
    let src = ints_get(rs.source, r);
    let w = ints_get(rs.which, r);
    if src == 1 { return cat4("the built-in `", strs_get(c.bname, w), "` requires ", e); }
    if src == 2 { return cat4("calls `", strs_get(c.fnname, w), "`, whose declared set includes ", e); }
    if src == 4 { return cat3("calls `", strs_get(c.fnname, w), "`, which is in another module and declares no effect set, so every effect is assumed of it"); }
    if src == 5 { return cat4("calls a function value of type `", show(c, w), "`, whose type includes ", e); }
    if src == 6 { return "`spawn` starts a task, which requires `spawn`"; }
    cat4("calls `", strs_get(c.fnname, w), "`, which requires ", e)
}

fn set_text(set: Int) -> Str { set_text_p(set, "*") }

// A set as source writes it, `{}` or `{ io, E }`: the effect parameter by `pname` (N51).
fn set_text_p(set: Int, pname: Str) -> Str {
    if set == 0 { return "{}"; }
    let names = strs_new();
    let mut e = 0;
    while e < 4 {
        if has_bit(set, e) { strs_push(names, effect_text(e, pname)); }
        e = e + 1;
    }
    cat3("{ ", str_join(names, ", "), " }")
}

// An effect as source writes it: the effect parameter (bit 3) by its declared name (N51).
fn effect_text(e: Int, pname: Str) -> Str {
    if e == 3 { return pname; }
    strs_get(effect_names(), e)
}

// The effect parameter in scope for the types written (N51), or -1.
fn eparam(c: Ck) -> Int { gs(c, s_eparam()) - 1 }

// An effect parameter's name as written, or `*` where none was recorded (`effect_param_name`).
fn effect_param_name(c: Ck, owner: Int) -> Str {
    if owner < 0 { return "*"; }
    let mut i = ints_len(c.epown) - 1;
    while i >= 0 {
        if ints_get(c.epown, i) == owner { return strs_get(c.epnm, i); }
        i = i - 1;
    }
    "*"
}

// Whether a function's declared set names its effect parameter (`polymorphic`, N51).
fn polymorphic(c: Ck, f: Int) -> Bool { ints_get(c.fneff, f) >= 0 && has_bit(ints_get(c.fneff, f), 3) }

// `set` with the effect parameter replaced by `binding` (`EffectSet::bound`); `set` when it has none.
fn bound_effects(set: Int, binding: Int) -> Int {
    if has_bit(set, 3) == false { return set; }
    eff_union(without(set, 8), binding)
}

fn eff_union(a: Int, b: Int) -> Int { a + without(b, a) }

// Settle the effects of the module's functions and check each declared set and each body's
// authority (`effects::analyse`), for a module of the program itself (R1.5, D8: its functions
// hold `main`'s output authority).
fn analyse_effects(c: Ck, m: Int) -> Int {
    let nodes = ints_new();
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if ints_get(c.fnmod, f) == m { ints_push(nodes, f); }
        f = f + 1;
    }
    // Round zero, each body's own effects; then rounds over the edges until nothing changes.
    let sets = ints_new();
    let rs = c.fnrs;
    let mut n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        let mut set = 0;
        let mut s = 0;
        while s < ints_len(c.sfn) {
            if ints_get(c.sfn, s) == me {
                let b = ints_get(c.sbuiltin, s);
                let g = ints_get(c.suser, s);
                let ind = ints_get(c.sind, s);
                // `spawn` starts a task, which requires `spawn`.
                if ints_get(c.sspawn, s) == 1 && has_bit(set, 1) == false {
                    set = with_bit(set, 1);
                    add_reason(rs, me, 1, ints_get(c.sstart, s), ints_get(c.send, s), 6, 0);
                }
                if b >= 0 {
                    let e = builtin_effect(c, b);
                    if e >= 0 && has_bit(set, e) == false {
                        set = with_bit(set, e);
                        add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), 1, b);
                    }
                }
                // What a function value may do is its type's (N50): a contract.
                if ind >= 0 {
                    let mut e = 0;
                    while e < 4 {
                        if has_bit(ta(c, ind), e) && has_bit(set, e) == false {
                            set = with_bit(set, e);
                            add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), 5, ind);
                        }
                        e = e + 1;
                    }
                }
                // A callee's declared set is its contract; another module's undeclared one is
                // assumed to do everything the bridge covers, and `foreign` if it can be handed
                // the authority for it.
                let mut contract = 0 - 1;
                let mut source = 2;
                if g >= 0 {
                    contract = ints_get(c.fneff, g);
                    if contract < 0 && ints_get(c.fnmod, g) != m {
                        contract = 3;
                        if receives_foreign(c, g) { contract = 7; }
                        source = 4;
                    }
                }
                // A callee's effect parameter, as this call bound it (N51): the empty set where
                // it has none to bind.
                if contract >= 0 && source == 2 { contract = bound_effects(contract, ints_get(c.sbind, s)); }
                if contract >= 0 {
                    let mut e = 0;
                    while e < 4 {
                        if has_bit(contract, e) && has_bit(set, e) == false {
                            set = with_bit(set, e);
                            add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), source, g);
                        }
                        e = e + 1;
                    }
                }
            }
            s = s + 1;
        }
        ints_push(sets, set);
        n = n + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let before = ints_new();
        n = 0;
        while n < ints_len(sets) {
            ints_push(before, ints_get(sets, n));
            n = n + 1;
        }
        n = 0;
        while n < ints_len(nodes) {
            let me = ints_get(nodes, n);
            let mut s = 0;
            while s < ints_len(c.sfn) {
                let g = ints_get(c.suser, s);
                if ints_get(c.sfn, s) == me && g >= 0 {
                    if ints_get(c.fneff, g) < 0 && ints_get(c.fnmod, g) == m {
                        let theirs = ints_get(before, index_of(nodes, g));
                        let mut e = 0;
                        while e < 4 {
                            if has_bit(theirs, e) && has_bit(ints_get(sets, n), e) == false {
                                ints_set(sets, n, with_bit(ints_get(sets, n), e));
                                add_reason(rs, me, e, ints_get(c.sstart, s), ints_get(c.send, s), 3, g);
                                changed = true;
                            }
                            e = e + 1;
                        }
                    }
                }
                s = s + 1;
            }
            n = n + 1;
        }
    }
    // Every function's requirement (`record_effects`): a foreign one's is its contract, `foreign`;
    // one with a body, what the rounds found.
    while ints_len(c.fnreq) < strs_len(c.fnname) { ints_push(c.fnreq, 0 - 1); }
    n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        if ints_get(c.fnfor, me) == 1 {
            ints_set(c.fnreq, me, 4);
        } else {
            // A closure's body is its expression's, always there (N50).
            if ints_get(c.fnclos, me) >= 0 || some(c, ints_get(c.fnnode, me), "body") { ints_set(c.fnreq, me, ints_get(sets, n)); }
        }
        n = n + 1;
    }
    // A named function used as a value promised its type's effects (N50): an undeclared one of
    // this module was taken to require none, and is held to it here.
    let mut v = 0;
    while v < ints_len(c.vfn) {
        let f = ints_get(c.vfn, v);
        let at = index_of(nodes, f);
        if at >= 0 && ints_get(c.fneff, f) < 0 {
            let missing = without(ints_get(sets, at), ints_get(c.vassumed, v));
            if missing != 0 {
                let listed = strs_new();
                let mut first = 0 - 1;
                let mut e = 0;
                while e < 4 {
                    if has_bit(missing, e) {
                        strs_push(listed, tick(effect_text(e, "*")));
                        if first < 0 { first = e; }
                    }
                    e = e + 1;
                }
                dg_error(c.d, "N0366", ints_get(c.vstart, v), ints_get(c.vend, v),
                        cat4(fn_label(c, f), " is used as a value whose type requires no effect, but it requires ", str_join(listed, " and "), ""), "",
                        cat4("a function value's type carries its effects, and an undeclared function's are taken to be none: declare `! ",
                        set_text(missing), "` on ", fn_label(c, f)));
                let r = reason_of(rs, f, first);
                if r >= 0 { sec_at(c, ints_get(rs.start, r), ints_get(rs.end, r), describe(c, rs, r)); }
            }
        }
        v = v + 1;
    }
    // Authority first, then effects, function by function.
    n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        check_authority(c, me, ints_get(c.mstd, m) == 0);
        let declared = ints_get(c.fneff, me);
        if declared >= 0 {
            let missing = without(ints_get(sets, n), declared);
            if missing != 0 { undeclared(c, rs, me, declared, missing); }
        }
        n = n + 1;
    }
    // A foreign call needs a `ForeignCap` held, in every function (N42): the first call in each
    // that does not hold one.
    n = 0;
    while n < ints_len(nodes) {
        let me = ints_get(nodes, n);
        let mut s = 0;
        let mut done = false;
        while s < ints_len(c.sfn) && done == false {
            let g = ints_get(c.suser, s);
            if ints_get(c.sfn, s) == me && g >= 0 {
                if ints_get(c.fnfor, g) == 1 && has_bit(ints_get(c.sheld, s), cap_bit("ForeignCap")) == false {
                    done = true;
                    let who = fn_label(c, me);
                    let callee = tick(strs_get(c.fnname, g));
                    dg_error(c.d, "N0369", ints_get(c.sstart, s), ints_get(c.send, s),
                            cat5("calling ", callee, " requires `ForeignCap` authority, and ", who, " holds no `ForeignCap` here"),
                            str_concat(callee, " is a foreign function: calling C is authorised by a `ForeignCap`, with or without an effect set"),
                            cat3("authority is a value: give ", who, " a `ForeignCap` parameter and have each caller pass one. The only source of one is `main`'s parameters"));
                    if ints_get(c.fnws, me) >= 0 {
                        sec_at(c, ints_get(c.fnws, me), ints_get(c.fnwe, me), "an effect set says what a function does, not what allows it");
                    }
                }
            }
            s = s + 1;
        }
        n = n + 1;
    }
    0
}

// Whether one of a function's parameters can carry a `ForeignCap` (`carries`): the only way a
// function of another module could reach C.
fn receives_foreign(c: Ck, g: Int) -> Bool {
    let mut k = 0;
    while k < ints_get(c.fnpc, g) {
        if carries_foreign(c, ints_get(c.ptys, ints_get(c.fnpf, g) + k), 0) { return true; }
        k = k + 1;
    }
    false
}

fn carries_foreign(c: Ck, t: Int, depth: Int) -> Bool {
    if depth > max_depth() * 4 { return true; }
    if bname_of(c, t) == "ForeignCap" { return true; }
    if is_holder_tag(tag(c, t)) { return carries_foreign(c, targ(c, t, 0), depth + 1); }
    if is_record(c, t) || is_enum(c, t) {
        let edges = contained(c, t);
        let mut i = 0;
        while i < ints_len(edges) {
            if carries_foreign(c, field_ty_in(c, t, ints_get(edges, i)), depth + 1) { return true; }
            i = i + 1;
        }
    }
    false
}

fn add_reason(rs: Reasons, f: Int, effect: Int, s: Int, e: Int, source: Int, which: Int) -> Int {
    ints_push(rs.fnid, f);
    ints_push(rs.effect, effect);
    ints_push(rs.start, s);
    ints_push(rs.end, e);
    ints_push(rs.source, source);
    ints_push(rs.which, which);
    0
}

fn index_of(xs: Ints, v: Int) -> Int {
    let mut i = 0;
    while i < ints_len(xs) {
        if ints_get(xs, i) == v { return i; }
        i = i + 1;
    }
    0 - 1
}

fn without(a: Int, b: Int) -> Int {
    let mut out = 0;
    let mut i = 0;
    while i < 10 {
        if has_bit(a, i) && has_bit(b, i) == false { out = with_bit(out, i); }
        i = i + 1;
    }
    out
}

// Every kind the body exercises without holding it, once each, at the first call that needs it
// (`authority` and `missing_authority`).
fn check_authority(c: Ck, me: Int, program: Bool) -> Int {
    let who = fn_label(c, me);
    let mut reported = 0;
    let mut s = 0;
    while s < ints_len(c.sfn) {
        if ints_get(c.sfn, s) == me {
            // A module of the program holds `main`'s output authority (R1.5, D8); an `IoCap`
            // gives an `OutCap`.
            let mut held = ints_get(c.sheld, s);
            if program || has_bit(held, cap_bit("IoCap")) { held = with_bit(held, cap_bit("OutCap")); }
            // A `spawn` needs the authority to start a task, before what its callee needs.
            if ints_get(c.sspawn, s) == 1 {
                reported = missing_authority(c, me, who, s, without(without(with_bit(0, cap_bit("SpawnCap")), held), reported), reported, 0 - 1);
            }
            let b = ints_get(c.sbuiltin, s);
            if b >= 0 { reported = missing_authority(c, me, who, s, without(without(builtin_caps(c, b), held), reported), reported, b); }
        }
        s = s + 1;
    }
    0
}

// Each kind of `need` reported at site `s`, for the built-in `b` or, with -1, a `spawn`
// (`missing_authority`); what is reported after.
fn missing_authority(c: Ck, me: Int, who: Str, s: Int, need: Int, reported: Int, b: Int) -> Int {
    let mut out = reported;
    let mut k = 0;
    while k < 10 {
        if has_bit(need, k) {
            out = with_bit(out, k);
            let kind = cap_name(k);
            let mut what = "starting a task";
            let mut primary = cat5("`spawn` is authorised by ", cap_article(k), " `", kind, "`");
            if b >= 0 {
                let bn = strs_get(c.bname, b);
                what = cat3("the built-in `", bn, "`");
                primary = cat5("`", bn, "` is authorised by ", cap_article(k), cat3(" `", kind, "`"));
            }
            dg_error(c.d, "N0369", ints_get(c.sstart, s), ints_get(c.send, s),
                    cat5(cat3(what, " requires `", kind), "` authority, and ", who, cat3(" holds no `", kind, "` here"), ""), primary,
                    cat5(cat3("authority is a value: give ", who, " "), cap_article(k), " `", kind,
                    "` parameter and have each caller pass one. The only source of one is `main`'s parameters"));
            if ints_get(c.fnws, me) >= 0 {
                sec_at(c, ints_get(c.fnws, me), ints_get(c.fnwe, me), "an effect set says what a function does, not what allows it");
            }
        }
        k = k + 1;
    }
    out
}

// `N0366`: a declared set the body exceeds, with the chain of reasons to where it ends.
// A function's effect parameter's name, for a message about it (N51): its own; a closure's is
// the one its type names — the enclosing declaration's, where its set names one — or `*`.
fn node_param(c: Ck, f: Int) -> Str {
    if ints_get(c.fnclos, f) < 0 { return effect_param_name(c, f); }
    if has_bit(ints_get(c.fneff, f), 3) == false { return "*"; }
    let mut top = f;
    while ints_get(c.fnclos, top) >= 0 { top = ints_get(c.fnclos, top); }
    effect_param_name(c, top)
}

fn undeclared(c: Ck, rs: Reasons, me: Int, declared: Int, missing: Int) -> Int {
    let who = fn_label(c, me);
    let pname = node_param(c, me);
    let listed = strs_new();
    let mut first = 0 - 1;
    let mut e = 0;
    while e < 4 {
        if has_bit(missing, e) {
            strs_push(listed, tick(effect_text(e, pname)));
            if first < 0 { first = e; }
        }
        e = e + 1;
    }
    let list = str_join(listed, " and ");
    let shown = set_text_p(declared, pname);
    let r = reason_of(rs, me, first);
    dg_error(c.d, "N0366", ints_get(rs.start, r), ints_get(rs.end, r), cat5(who, " declares `! ", shown, "`, but its body requires ", list),
            describe(c, rs, r),
            "a declared effect set is a contract: the body may require no effect outside it. Declare the effect, or stop calling what requires it");
    let mut hop = r;
    let mut seen = 0;
    while ints_get(rs.source, hop) == 3 && seen <= 64 {
        seen = seen + 1;
        let g = ints_get(rs.which, hop);
        let next = reason_of(rs, g, first);
        if next < 0 { seen = 100; } else {
            sec_at(c, ints_get(rs.start, next), ints_get(rs.end, next), cat4("in `", strs_get(c.fnname, g), "`: ", describe(c, rs, next)));
            hop = next;
        }
    }
    let wider = set_text_p(declared + missing, pname);
    // A closure that writes no effect set declares `! {}` (N50).
    if ints_get(c.fnws, me) < 0 {
        sec_at(c, ints_get(c.fnns, me), ints_get(c.fnne, me), "a closure that writes no effect set declares `! {}`");
        return 0;
    }
    sec_at(c, ints_get(c.fnws, me), ints_get(c.fnwe, me), cat3("declared `! ", shown, "` here"));
    dg_fix(c.d, ints_get(c.fnws, me), ints_get(c.fnwe, me), str_concat("! ", wider), cat3("declare `! ", wider, "`"), "needs_review",
            cat5(who, " is meant to exercise ", list, ". Widening a contract can break a caller whose own declared set lacks ", list));
    0
}

// --- provenance (N38, N80; `nazm-core/src/provenance.rs`, `nazm-sema/src/provenance.rs`) ---------
//
// Each body reduced to flows over its parameters, its calls, the containers it reads and writes
// and the function values it makes and calls (`facts`), the whole program's summaries solved
// from them (`solve`), and the language's flow rule checked against them: `N0372`, a restricted
// origin reaching a path a function that declares its effects writes to, with the chain that
// shows how (`Tracer`). A port, rule for rule and in the reference's order, since the chain's
// steps — which span is shown for an origin, which cell, which caller — follow from the order
// the bodies are walked in.

// Origins (`Origin`): 0 the command line, 1 a file's contents, 2 the runtime's root authority,
// 3 what the checker does not follow. A set of them is a mask.
fn o_restricted() -> Int { 10 }

fn o_describe(o: Int) -> Str {
    if o == 0 { return "the command line"; }
    if o == 1 { return "the contents of a file"; }
    if o == 2 { return "the runtime's root authority"; }
    "a device or foreign code the checker does not follow"
}

fn o_enters(o: Int) -> Str {
    if o == 0 { return "the command line is read here"; }
    if o == 1 { return "a file's contents are read here"; }
    if o == 2 { return "the runtime's root authority is handed over here"; }
    "a device register is read here, which the checker does not follow"
}

// Sink classes (`SinkClass`): 0 a path written to, 1 output, 2 what is written, 3 a vouch.
fn sink_class(name: Str) -> Int {
    if name == "path" { return 0; }
    if name == "output" { return 1; }
    if name == "file-data" { return 2; }
    3
}

// Masks of up to 62 bits, without bit operators: union, intersection, membership.
fn bor(a: Int, b: Int) -> Int {
    if a == b || b == 0 { return a; }
    if a == 0 { return b; }
    let mut out = a;
    let mut x = b;
    let mut y = a;
    let mut bit = 1;
    while x > 0 {
        if x % 2 == 1 && y % 2 == 0 { out = out + bit; }
        x = x / 2;
        y = y / 2;
        bit = bit * 2;
    }
    out
}

fn band(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 { return 0; }
    let mut out = 0;
    let mut x = b;
    let mut y = a;
    let mut bit = 1;
    while x > 0 && y > 0 {
        if x % 2 == 1 && y % 2 == 1 { out = out + bit; }
        x = x / 2;
        y = y / 2;
        bit = bit * 2;
    }
    out
}

fn bhas(m: Int, i: Int) -> Bool {
    if m == 0 { return false; }
    (m / pow2(i)) % 2 == 1
}

// The positions a mask holds, in order.
fn bits_of(m: Int) -> Ints {
    let out = ints_new();
    let mut x = m;
    let mut i = 0;
    while x > 0 {
        if x % 2 == 1 { ints_push(out, i); }
        x = x / 2;
        i = i + 1;
    }
    out
}

// The first origin of a set, in id order, or -1.
fn first_origin(m: Int) -> Int {
    let mut o = 0;
    while o < 4 {
        if bhas(m, o) { return o; }
        o = o + 1;
    }
    0 - 1
}

// Add `x` to a sorted set; whether it was not there.
fn set_add(xs: Ints, x: Int) -> Bool {
    let mut i = 0;
    while i < ints_len(xs) && ints_get(xs, i) < x { i = i + 1; }
    if i < ints_len(xs) && ints_get(xs, i) == x { return false; }
    ints_push(xs, x);
    let mut j = ints_len(xs) - 1;
    while j > i {
        ints_set(xs, j, ints_get(xs, j - 1));
        j = j - 1;
    }
    ints_set(xs, i, x);
    true
}

fn ints_same(a: Ints, b: Ints) -> Bool {
    if ints_len(a) != ints_len(b) { return false; }
    let mut i = 0;
    while i < ints_len(a) {
        if ints_get(a, i) != ints_get(b, i) { return false; }
        i = i + 1;
    }
    true
}

fn strs_same(a: Strs, b: Strs) -> Bool {
    if strs_len(a) != strs_len(b) { return false; }
    let mut i = 0;
    while i < strs_len(a) {
        if strs_get(a, i) != strs_get(b, i) { return false; }
        i = i + 1;
    }
    true
}

// What one value carries (`Flow`): in `m`, its origins, the parameters it carries (a mask of
// positions) and, for each origin, where it was first met (start, then end, -1 for none); then the
// calls whose results it carries and the indirect calls', by their indices in the program, and the
// cells it was read out of with where each was first read — each sorted. Its arrays are its own:
// a flow is changed in place, and copied where the reference clones one.
pub struct Fl {
    m: Ints,
    cs: Ints,
    vs: Ints,
    cn: Strs,
    cp: Ints,
}

fn fl_new() -> Fl {
    let m = ints_new();
    ints_push(m, 0);
    ints_push(m, 0);
    let mut i = 0;
    while i < 8 {
        ints_push(m, 0 - 1);
        i = i + 1;
    }
    Fl(m: m, cs: ints_new(), vs: ints_new(), cn: strs_new(), cp: ints_new())
}

fn fl_origin(o: Int, s: Int, e: Int) -> Fl {
    let f = fl_new();
    ints_set(f.m, 0, pow2(o));
    ints_set(f.m, 2 + o, s);
    ints_set(f.m, 6 + o, e);
    f
}

fn fl_param(i: Int) -> Fl {
    let f = fl_new();
    ints_set(f.m, 1, pow2(i));
    f
}

fn fl_call(i: Int) -> Fl {
    let f = fl_new();
    ints_push(f.cs, i);
    f
}

fn fl_via(i: Int) -> Fl {
    let f = fl_new();
    ints_push(f.vs, i);
    f
}

fn fl_cell(name: Str, s: Int, e: Int) -> Fl {
    let f = fl_new();
    strs_push(f.cn, name);
    ints_push(f.cp, s);
    ints_push(f.cp, e);
    f
}

fn fl_origins(f: Fl) -> Int { ints_get(f.m, 0) }
fn fl_params(f: Fl) -> Int { ints_get(f.m, 1) }

fn fl_copy(f: Fl) -> Fl {
    let g = fl_new();
    fl_join(g, f);
    g
}

fn fl_local(f: Fl) -> Bool { ints_get(f.m, 0) == 0 && ints_get(f.m, 1) == 0 && ints_len(f.cs) == 0 && ints_len(f.vs) == 0 && strs_len(f.cn) == 0 }

fn fl_same(a: Fl, b: Fl) -> Bool { ints_same(a.m, b.m) && ints_same(a.cs, b.cs) && ints_same(a.vs, b.vs) && strs_same(a.cn, b.cn) && ints_same(a.cp, b.cp) }

// Join `b` into `a` (`Flow::join`), and say whether anything was added: a first reason already
// held for an origin is kept.
fn fl_join(a: Fl, b: Fl) -> Bool {
    let mut grew = false;
    let mut o = 0;
    while o < 4 {
        if ints_get(b.m, 2 + o) >= 0 && bhas(ints_get(a.m, 0), o) == false {
            ints_set(a.m, 0, ints_get(a.m, 0) + pow2(o));
            ints_set(a.m, 2 + o, ints_get(b.m, 2 + o));
            ints_set(a.m, 6 + o, ints_get(b.m, 6 + o));
            grew = true;
        }
        o = o + 1;
    }
    let origins = bor(ints_get(a.m, 0), ints_get(b.m, 0));
    if origins != ints_get(a.m, 0) {
        ints_set(a.m, 0, origins);
        grew = true;
    }
    let params = bor(ints_get(a.m, 1), ints_get(b.m, 1));
    if params != ints_get(a.m, 1) {
        ints_set(a.m, 1, params);
        grew = true;
    }
    let mut i = 0;
    while i < ints_len(b.cs) {
        if set_add(a.cs, ints_get(b.cs, i)) { grew = true; }
        i = i + 1;
    }
    i = 0;
    while i < ints_len(b.vs) {
        if set_add(a.vs, ints_get(b.vs, i)) { grew = true; }
        i = i + 1;
    }
    i = 0;
    while i < strs_len(b.cn) {
        let name = strs_get(b.cn, i);
        let mut at = 0;
        while at < strs_len(a.cn) && str_less(strs_get(a.cn, at), name) { at = at + 1; }
        if at >= strs_len(a.cn) || strs_get(a.cn, at) != name {
            strs_push(a.cn, name);
            ints_push(a.cp, 0);
            ints_push(a.cp, 0);
            let mut j = strs_len(a.cn) - 1;
            while j > at {
                strs_set(a.cn, j, strs_get(a.cn, j - 1));
                ints_set(a.cp, 2 * j, ints_get(a.cp, 2 * j - 2));
                ints_set(a.cp, 2 * j + 1, ints_get(a.cp, 2 * j - 1));
                j = j - 1;
            }
            strs_set(a.cn, at, name);
            ints_set(a.cp, 2 * at, ints_get(b.cp, 2 * i));
            ints_set(a.cp, 2 * at + 1, ints_get(b.cp, 2 * i + 1));
            grew = true;
        }
        i = i + 1;
    }
    grew
}

// `a` joined with `b`, `a` itself changed.
fn fl_joined(a: Fl, b: Fl) -> Fl {
    fl_join(a, b);
    a
}

// Every body's facts (`ModuleFacts`, `FunctionFacts`), in the order the reference walks them: per
// function its calls, sinks, stores, indirect calls and the function values it makes, each a run
// of the pools below; argument and capture flows in one pool.
pub struct Pf {
    ffn: Ints,
    fres: Vec[Fl],
    fcf: Ints,
    fcc: Ints,
    fsf: Ints,
    fsc: Ints,
    fof: Ints,
    foc: Ints,
    fif: Ints,
    fic: Ints,
    fmf: Ints,
    fmc: Ints,
    // Calls: the callee, where its name is, whether it is a `spawn`'s, and its arguments.
    ccal: Ints,
    cs: Ints,
    ce: Ints,
    csp: Ints,
    caf: Ints,
    cac: Ints,
    args: Vec[Fl],
    // Sinks: where, which class, and the flow into it.
    kss: Ints,
    kse: Ints,
    kcl: Ints,
    kfl: Vec[Fl],
    // Stores into a container's cell: which cell, where, what.
    ocl: Strs,
    oss: Ints,
    ose: Ints,
    ofl: Vec[Fl],
    // Indirect calls: their target, where, and their arguments.
    itg: Strs,
    iss: Ints,
    ise: Ints,
    iaf: Ints,
    iac: Ints,
    // Function values made: the function, its target, where, and what it captures.
    mfn: Ints,
    mtg: Strs,
    mss: Ints,
    mse: Ints,
    mcf: Ints,
    mcc: Ints,
}

fn pf_new() -> Pf {
    Pf(ffn: ints_new(), fres: vec_new[Fl](), fcf: ints_new(), fcc: ints_new(), fsf: ints_new(), fsc: ints_new(), fof: ints_new(), foc: ints_new(),
            fif: ints_new(), fic: ints_new(), fmf: ints_new(), fmc: ints_new(), ccal: ints_new(), cs: ints_new(), ce: ints_new(), csp: ints_new(),
            caf: ints_new(), cac: ints_new(), args: vec_new[Fl](), kss: ints_new(), kse: ints_new(), kcl: ints_new(), kfl: vec_new[Fl](), ocl: strs_new(),
            oss: ints_new(), ose: ints_new(), ofl: vec_new[Fl](), itg: strs_new(), iss: ints_new(), ise: ints_new(), iaf: ints_new(), iac: ints_new(),
            mfn: ints_new(), mtg: strs_new(), mss: ints_new(), mse: ints_new(), mcf: ints_new(), mcc: ints_new())
}

// One body being walked (`Walk`): its function, its bindings' flows and shapes, which it has read,
// the `defer`s pending, the closures it wrote, where its facts begin in the pools, and an arena of
// shaped values (`Shaped`) — a flow, and for a record or variant built here each field's own,
// keyed by variant and field — each immutable once made.
pub struct Wk {
    // The function, its parameter count, whether a binding grew after it was read, and where its
    // calls, sinks, stores, indirect calls and makes begin in the pools.
    st: Ints,
    lb: Ints,
    lf: Vec[Fl],
    // Each binding's shape: 0 nothing built assigned yet, 1 built (its parts a run), 2 whole.
    lk: Ints,
    lpf: Ints,
    lpc: Ints,
    lr: Ints,
    defers: Ints,
    clos: Ints,
    shfl: Vec[Fl],
    shpf: Ints,
    shpc: Ints,
    pkv: Strs,
    pkf: Strs,
    pval: Ints,
    // What the body returns (`result`).
    res: Vec[Fl],
}

fn w_fn(w: Wk) -> Int { ints_get(w.st, 0) }

fn wk_new(f: Int, params: Int, pf: Pf) -> Wk {
    let st = ints_new();
    ints_push(st, f);
    ints_push(st, params);
    ints_push(st, 0);
    ints_push(st, ints_len(pf.ccal));
    ints_push(st, ints_len(pf.kss));
    ints_push(st, strs_len(pf.ocl));
    ints_push(st, strs_len(pf.itg));
    ints_push(st, ints_len(pf.mfn));
    Wk(st: st, lb: ints_new(), lf: vec_new[Fl](), lk: ints_new(), lpf: ints_new(), lpc: ints_new(), lr: ints_new(), defers: ints_new(),
            clos: ints_new(), shfl: vec_new[Fl](), shpf: ints_new(), shpc: ints_new(), pkv: strs_new(), pkf: strs_new(), pval: ints_new(),
            res: one_flow())
}

fn one_flow() -> Vec[Fl] {
    let v = vec_new[Fl]();
    vec_push(v, fl_new());
    v
}

// --- shaped values ---------------------------------------------------------------------------

fn sh_make(w: Wk, f: Fl, pf: Int, pc: Int) -> Int {
    vec_push(w.shfl, f);
    ints_push(w.shpf, pf);
    ints_push(w.shpc, pc);
    ints_len(w.shpf) - 1
}

// A value with no shape: its flow, whole.
fn sh_whole(w: Wk, f: Fl) -> Int { sh_make(w, f, 0 - 1, 0) }
fn sh_none(w: Wk) -> Int { sh_whole(w, fl_new()) }
fn sh_fl(w: Wk, s: Int) -> Fl { vec_get(w.shfl, s) }
fn sh_has_parts(w: Wk, s: Int) -> Bool { ints_get(w.shpf, s) >= 0 }

// A shape's flow, copied: what a caller may change.
fn sh_flow(w: Wk, s: Int) -> Fl { fl_copy(sh_fl(w, s)) }

fn sh_neutral(w: Wk, s: Int) -> Bool { sh_has_parts(w, s) == false && fl_local(sh_fl(w, s)) }

// Whether part key (v, f) sorts before (v2, f2), as a `(String, String)` does.
fn key_less(v: Str, f: Str, v2: Str, f2: Str) -> Bool {
    if v != v2 { return str_less(v, v2); }
    str_less(f, f2)
}

// A run of parts, sorted, from parallel lists.
fn parts_run(w: Wk, vs: Strs, fs: Strs, xs: Ints) -> Int {
    let start = ints_len(w.pval);
    let mut i = 0;
    while i < ints_len(xs) {
        strs_push(w.pkv, strs_get(vs, i));
        strs_push(w.pkf, strs_get(fs, i));
        ints_push(w.pval, ints_get(xs, i));
        i = i + 1;
    }
    start
}

// The part (v, f) of a run, or -1.
fn part_of(w: Wk, pf: Int, pc: Int, v: Str, f: Str) -> Int {
    let mut i = 0;
    while i < pc {
        if strs_get(w.pkv, pf + i) == v && strs_get(w.pkf, pf + i) == f { return ints_get(w.pval, pf + i); }
        i = i + 1;
    }
    0 - 1
}

// Two shaped values the same (`Shaped`'s equality).
fn sh_same(w: Wk, a: Int, b: Int) -> Bool {
    if a == b { return true; }
    if fl_same(sh_fl(w, a), sh_fl(w, b)) == false { return false; }
    if sh_has_parts(w, a) != sh_has_parts(w, b) { return false; }
    if sh_has_parts(w, a) == false { return true; }
    parts_same(w, ints_get(w.shpf, a), ints_get(w.shpc, a), ints_get(w.shpf, b), ints_get(w.shpc, b))
}

fn parts_same(w: Wk, af: Int, ac: Int, bf: Int, bc: Int) -> Bool {
    if ac != bc { return false; }
    let mut i = 0;
    while i < ac {
        if strs_get(w.pkv, af + i) != strs_get(w.pkv, bf + i) || strs_get(w.pkf, af + i) != strs_get(w.pkf, bf + i) { return false; }
        if sh_same(w, ints_get(w.pval, af + i), ints_get(w.pval, bf + i)) == false { return false; }
        i = i + 1;
    }
    true
}

// `a` joined with `b`, as an `if` or a `match` joins its arms (`Shaped::join`).
fn sh_join(w: Wk, a: Int, b: Int) -> Int {
    if sh_neutral(w, b) { return a; }
    if sh_neutral(w, a) { return b; }
    let f = sh_flow(w, a);
    fl_join(f, sh_fl(w, b));
    if sh_has_parts(w, a) && sh_has_parts(w, b) {
        let merged = merge_parts(w, ints_get(w.shpf, a), ints_get(w.shpc, a), ints_get(w.shpf, b), ints_get(w.shpc, b));
        return sh_make(w, f, merged, ints_len(w.pval) - merged);
    }
    sh_whole(w, f)
}

// The runs `a` and `b` merged (`merge_parts`): a new run, the last in the pool.
fn merge_parts(w: Wk, af: Int, ac: Int, bf: Int, bc: Int) -> Int {
    let vs = strs_new();
    let fs = strs_new();
    let xs = ints_new();
    let mut i = 0;
    while i < ac {
        strs_push(vs, strs_get(w.pkv, af + i));
        strs_push(fs, strs_get(w.pkf, af + i));
        ints_push(xs, ints_get(w.pval, af + i));
        i = i + 1;
    }
    i = 0;
    while i < bc {
        let v = strs_get(w.pkv, bf + i);
        let f = strs_get(w.pkf, bf + i);
        let x = ints_get(w.pval, bf + i);
        let mut at = 0;
        while at < ints_len(xs) && key_less(strs_get(vs, at), strs_get(fs, at), v, f) { at = at + 1; }
        if at < ints_len(xs) && strs_get(vs, at) == v && strs_get(fs, at) == f {
            ints_set(xs, at, sh_join(w, ints_get(xs, at), x));
        } else {
            strs_push(vs, "");
            strs_push(fs, "");
            ints_push(xs, 0);
            let mut j = ints_len(xs) - 1;
            while j > at {
                strs_set(vs, j, strs_get(vs, j - 1));
                strs_set(fs, j, strs_get(fs, j - 1));
                ints_set(xs, j, ints_get(xs, j - 1));
                j = j - 1;
            }
            strs_set(vs, at, v);
            strs_set(fs, at, f);
            ints_set(xs, at, x);
        }
        i = i + 1;
    }
    parts_run(w, vs, fs, xs)
}

// A shape cut to `depth` (`Shaped::truncated`): below `SHAPE_DEPTH` (4) a field is whole.
fn sh_truncated(w: Wk, s: Int, depth: Int) -> Int {
    if sh_has_parts(w, s) == false { return s; }
    if depth >= 4 { return sh_whole(w, sh_fl(w, s)); }
    let pf = ints_get(w.shpf, s);
    let pc = ints_get(w.shpc, s);
    let vs = strs_new();
    let fs = strs_new();
    let xs = ints_new();
    let mut i = 0;
    while i < pc {
        strs_push(vs, strs_get(w.pkv, pf + i));
        strs_push(fs, strs_get(w.pkf, pf + i));
        ints_push(xs, sh_truncated(w, ints_get(w.pval, pf + i), depth + 1));
        i = i + 1;
    }
    sh_make(w, sh_fl(w, s), parts_run(w, vs, fs, xs), pc)
}

// --- one body's facts (`walk`) ----------------------------------------------------------------

// Whether a type mentions no type parameter (`Types::is_concrete`).
fn concrete(c: Ck, t: Int) -> Bool {
    if t < 0 { return false; }
    if tag(c, t) == tag_param() { return false; }
    let mut i = 0;
    while i < targc(c, t) {
        if concrete(c, targ(c, t, i)) == false { return false; }
        i = i + 1;
    }
    true
}

// The cell of a vector whose element is shown `elem` (`vec_cell`).
fn vec_cell(elem: Str) -> Str {
    if elem == "Int" { return "Ints"; }
    if elem == "Str" { return "Strs"; }
    cat3("Vec[", elem, "]")
}

// The target a function value of this signature answers to: its type up to effects
// (`value_target`), or the wild one where it mentions a type parameter.
fn value_target(c: Ck, params: Ints, ret: Int) -> Str {
    let shown = strs_new();
    let mut i = 0;
    while i < ints_len(params) {
        if concrete(c, ints_get(params, i)) == false { return "fn *"; }
        strs_push(shown, show(c, ints_get(params, i)));
        i = i + 1;
    }
    if concrete(c, ret) == false { return "fn *"; }
    cat4("fn (", str_join(shown, ", "), ") -> ", show(c, ret))
}

fn fn_type_target(c: Ck, t: Int) -> Str {
    if t >= 0 && is_fn(c, t) { return value_target(c, fn_params(c, t), fn_ret(c, t)); }
    "fn *"
}

// A function's own target: its parameters' types and its result.
fn function_target(c: Ck, f: Int) -> Str {
    let params = ints_new();
    let mut i = 0;
    while i < ints_get(c.fnpc, f) {
        ints_push(params, ints_get(c.ptys, ints_get(c.fnpf, f) + i));
        i = i + 1;
    }
    value_target(c, params, ints_get(c.fnret, f))
}

// The cell a binding a closure shares is kept in (R1b, L10), named as a `Cell`'s is.
fn shared_cell(c: Ck, b: Int) -> Str {
    let t = ints_get(c.bty, b);
    if concrete(c, t) { return cat3("Cell[", show(c, t), "]"); }
    "*"
}

// The call site at a span, or -1.
fn site_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.msite, s, e) }

// The local slot of binding `b` in the body being walked, made on first sight.
fn w_local(w: Wk, bloc: Ints, b: Int) -> Int {
    let l = ints_get(bloc, b);
    if l >= 0 { return l; }
    w_add_local(w, bloc, b, fl_new(), 0)
}

fn w_add_local(w: Wk, bloc: Ints, b: Int, f: Fl, kind: Int) -> Int {
    ints_push(w.lb, b);
    vec_push(w.lf, f);
    ints_push(w.lk, kind);
    ints_push(w.lpf, 0 - 1);
    ints_push(w.lpc, 0);
    ints_push(w.lr, 0);
    ints_set(bloc, b, ints_len(w.lb) - 1);
    ints_len(w.lb) - 1
}

fn w_stale(w: Wk) -> Int {
    ints_set(w.st, 2, 1);
    0
}

// A value written into a container's cell (`store`), joined into the store already at its place.
fn w_store(pf: Pf, w: Wk, cell: Str, s: Int, e: Int, v: Fl) -> Int {
    let mut i = ints_get(w.st, 5);
    while i < strs_len(pf.ocl) {
        if ints_get(pf.oss, i) == s && ints_get(pf.ose, i) == e && strs_get(pf.ocl, i) == cell {
            fl_join(vec_get(pf.ofl, i), v);
            return 0;
        }
        i = i + 1;
    }
    strs_push(pf.ocl, cell);
    ints_push(pf.oss, s);
    ints_push(pf.ose, e);
    vec_push(pf.ofl, fl_copy(v));
    0
}

// A flow into a sink of a class (`sink`).
fn w_sink(pf: Pf, w: Wk, s: Int, e: Int, class: Int, v: Fl) -> Int {
    let mut i = ints_get(w.st, 4);
    while i < ints_len(pf.kss) {
        if ints_get(pf.kss, i) == s && ints_get(pf.kse, i) == e && ints_get(pf.kcl, i) == class {
            fl_join(vec_get(pf.kfl, i), v);
            return 0;
        }
        i = i + 1;
    }
    ints_push(pf.kss, s);
    ints_push(pf.kse, e);
    ints_push(pf.kcl, class);
    vec_push(pf.kfl, fl_copy(v));
    0
}

// A call of a function of the program (`call`): its arguments joined into the call already at its
// place; the flow of its result.
fn w_call(pf: Pf, w: Wk, callee: Int, s: Int, e: Int, args: Vec[Fl], spawned: Bool) -> Fl {
    let mut i = ints_get(w.st, 3);
    while i < ints_len(pf.ccal) {
        if ints_get(pf.cs, i) == s && ints_get(pf.ce, i) == e {
            let mut k = 0;
            while k < vec_len(args) && k < ints_get(pf.cac, i) {
                fl_join(vec_get(pf.args, ints_get(pf.caf, i) + k), vec_get(args, k));
                k = k + 1;
            }
            return fl_call(i);
        }
        i = i + 1;
    }
    ints_push(pf.ccal, callee);
    ints_push(pf.cs, s);
    ints_push(pf.ce, e);
    if spawned { ints_push(pf.csp, 1); } else { ints_push(pf.csp, 0); }
    ints_push(pf.caf, vec_len(pf.args));
    ints_push(pf.cac, vec_len(args));
    let mut k = 0;
    while k < vec_len(args) {
        vec_push(pf.args, vec_get(args, k));
        k = k + 1;
    }
    fl_call(ints_len(pf.ccal) - 1)
}

// A call whose callee is not named, through a value or a bound (`indirect`).
fn w_indirect(pf: Pf, w: Wk, target: Str, s: Int, e: Int, args: Vec[Fl]) -> Fl {
    let mut i = ints_get(w.st, 6);
    while i < strs_len(pf.itg) {
        if ints_get(pf.iss, i) == s && ints_get(pf.ise, i) == e {
            let mut k = 0;
            while k < vec_len(args) && k < ints_get(pf.iac, i) {
                fl_join(vec_get(pf.args, ints_get(pf.iaf, i) + k), vec_get(args, k));
                k = k + 1;
            }
            return fl_via(i);
        }
        i = i + 1;
    }
    strs_push(pf.itg, target);
    ints_push(pf.iss, s);
    ints_push(pf.ise, e);
    ints_push(pf.iaf, vec_len(pf.args));
    ints_push(pf.iac, vec_len(args));
    let mut k = 0;
    while k < vec_len(args) {
        vec_push(pf.args, vec_get(args, k));
        k = k + 1;
    }
    fl_via(strs_len(pf.itg) - 1)
}

fn joined_all(args: Vec[Fl]) -> Fl {
    let f = fl_new();
    let mut i = 0;
    while i < vec_len(args) {
        fl_join(f, vec_get(args, i));
        i = i + 1;
    }
    f
}

// `assign`: a binding is everything ever assigned to it; a shared one's cell is written too.
fn w_assign(c: Ck, pf: Pf, w: Wk, bloc: Ints, s: Int, e: Int, v: Int) -> Int {
    let b = sm_get(c.mvar, s, e);
    if b < 0 { return 0; }
    if ints_get(c.bshr, b) == 1 { w_store(pf, w, shared_cell(c, b), s, e, sh_fl(w, v)); }
    let l = w_local(w, bloc, b);
    let mut grew = fl_join(vec_get(w.lf, l), sh_fl(w, v));
    let kind = ints_get(w.lk, l);
    let mut next = 0 - 1;
    let mut npf = 0 - 1;
    let mut npc = 0;
    if kind != 2 {
        if sh_has_parts(w, v) == false {
            if sh_neutral(w, v) == false { next = 2; }
        } else {
            if kind == 0 {
                next = 1;
                npf = ints_get(w.shpf, v);
                npc = ints_get(w.shpc, v);
            } else {
                let merged = merge_parts(w, ints_get(w.lpf, l), ints_get(w.lpc, l), ints_get(w.shpf, v), ints_get(w.shpc, v));
                let count = ints_len(w.pval) - merged;
                if parts_same(w, ints_get(w.lpf, l), ints_get(w.lpc, l), merged, count) == false {
                    next = 1;
                    npf = merged;
                    npc = count;
                }
            }
        }
    }
    if next >= 0 {
        let mut differs = next != kind;
        if next == 1 && kind == 1 { differs = parts_same(w, ints_get(w.lpf, l), ints_get(w.lpc, l), npf, npc) == false; }
        if differs {
            ints_set(w.lk, l, next);
            ints_set(w.lpf, l, npf);
            ints_set(w.lpc, l, npc);
            grew = true;
        }
    }
    if grew && ints_get(w.lr, l) == 1 { w_stale(w); }
    0
}

// `a.b = v` (`assign_field`): the binding is whole from then on.
fn w_assign_field(c: Ck, pf: Pf, w: Wk, bloc: Ints, s: Int, e: Int, v: Fl) -> Int {
    let b = sm_get(c.mvar, s, e);
    if b < 0 { return 0; }
    if ints_get(c.bshr, b) == 1 { w_store(pf, w, shared_cell(c, b), s, e, v); }
    let l = w_local(w, bloc, b);
    let mut grew = fl_join(vec_get(w.lf, l), v);
    if ints_get(w.lk, l) != 2 {
        ints_set(w.lk, l, 2);
        grew = true;
    }
    if grew && ints_get(w.lr, l) == 1 { w_stale(w); }
    0
}

// A name read (`expr_var`): its binding as it stands, or a named function written as a value.
fn w_var(c: Ck, pf: Pf, w: Wk, bloc: Ints, s: Int, e: Int) -> Int {
    let b = sm_get(c.mvar, s, e);
    if b < 0 {
        let mut i = 0;
        while i < ints_len(c.vfn) {
            if ints_get(c.vstart, i) == s && ints_get(c.vend, i) == e {
                let f = ints_get(c.vfn, i);
                let mut made = false;
                let mut k = ints_get(w.st, 7);
                while k < ints_len(pf.mfn) {
                    if ints_get(pf.mss, k) == s && ints_get(pf.mse, k) == e && ints_get(pf.mfn, k) == f { made = true; }
                    k = k + 1;
                }
                if made == false {
                    ints_push(pf.mfn, f);
                    strs_push(pf.mtg, function_target(c, f));
                    ints_push(pf.mss, s);
                    ints_push(pf.mse, e);
                    ints_push(pf.mcf, vec_len(pf.args));
                    ints_push(pf.mcc, 0);
                }
                return sh_none(w);
            }
            i = i + 1;
        }
        return sh_none(w);
    }
    let l = w_local(w, bloc, b);
    ints_set(w.lr, l, 1);
    if ints_get(c.bshr, b) == 1 { return sh_whole(w, fl_cell(shared_cell(c, b), s, e)); }
    let f = fl_copy(vec_get(w.lf, l));
    if ints_get(w.lk, l) == 1 { return sh_make(w, f, ints_get(w.lpf, l), ints_get(w.lpc, l)); }
    sh_whole(w, f)
}

fn w_expr(c: Ck, pf: Pf, w: Wk, bloc: Ints, e: Int) -> Fl { sh_flow(w, w_shaped(c, pf, w, bloc, e)) }

fn w_block(c: Ck, pf: Pf, w: Wk, bloc: Ints, b: Int) -> Int {
    let mark = ints_len(w.defers);
    let statements = kids(c, b, "statements");
    let mut i = 0;
    while i < ints_len(statements) {
        w_stmt(c, pf, w, bloc, ints_get(statements, i));
        i = i + 1;
    }
    let mut tail = sh_none(w);
    if some(c, b, "tail") { tail = w_shaped(c, pf, w, bloc, unwrap(c, b, "tail")); }
    // What this block deferred runs as it ends, after everything written in it (L12).
    let ran = ints_new();
    while ints_len(w.defers) > mark { ints_push(ran, ints_pop(w.defers)); }
    i = 0;
    while i < ints_len(ran) {
        w_block(c, pf, w, bloc, ints_get(ran, i));
        i = i + 1;
    }
    tail
}

fn w_stmt(c: Ck, pf: Pf, w: Wk, bloc: Ints, s: Int) -> Int {
    if sx_kind(c.t, s) != tk_tuple() { return 0; }
    let k = kind_of(c, s);
    let n = sx_kid(c.t, s, 0);
    if k == "Expr" {
        w_expr(c, pf, w, bloc, n);
        return 0;
    }
    if k == "Let" {
        let v = w_shaped(c, pf, w, bloc, fld(c, n, "value"));
        let ns = fld(c, n, "name_span");
        w_assign(c, pf, w, bloc, sps(c, ns), spe(c, ns), v);
        return 0;
    }
    if k == "Assign" {
        let place = fld(c, n, "place");
        let v = w_shaped(c, pf, w, bloc, fld(c, n, "value"));
        let ns = fld(c, place, "name_span");
        if ints_len(kids(c, place, "path")) == 0 {
            w_assign(c, pf, w, bloc, sps(c, ns), spe(c, ns), v);
        } else {
            w_assign_field(c, pf, w, bloc, sps(c, ns), spe(c, ns), sh_fl(w, v));
        }
        return 0;
    }
    if k == "While" {
        w_expr(c, pf, w, bloc, fld(c, n, "cond"));
        w_block(c, pf, w, bloc, fld(c, n, "body"));
        return 0;
    }
    if k == "For" {
        let iter = fld(c, n, "iter");
        let ns = fld(c, n, "name_span");
        let s0 = sps(c, ns);
        let e0 = spe(c, ns);
        let mut v = 0;
        if kind_of(c, iter) == "Range" {
            v = sh_whole(w, w_expr(c, pf, w, bloc, fld(c, iter, "start")));
            w_expr(c, pf, w, bloc, fld(c, iter, "end"));
        } else {
            let handle = w_expr(c, pf, w, bloc, sx_kid(c.t, iter, 0));
            // The cell its sequence's `*_get` reads (R1a); a `Chain` has none: what it holds rides
            // on the value, as `chain_get` reads it.
            let t = sm_get(c.mfor, s0, e0);
            let mut cell = "*";
            if t >= 0 {
                if tag(c, t) == tag_vec() && concrete(c, targ(c, t, 0)) { cell = vec_cell(show(c, targ(c, t, 0))); }
                if bname_of(c, t) == "Bytes" { cell = "Bytes"; }
            }
            if t >= 0 && tag(c, t) == tag_chain() { v = sh_whole(w, handle); } else { v = sh_whole(w, fl_joined(fl_cell(cell, s0, e0), handle)); }
        }
        w_assign(c, pf, w, bloc, s0, e0, v);
        w_block(c, pf, w, bloc, fld(c, n, "body"));
        return 0;
    }
    if k == "Return" {
        let v = w_expr(c, pf, w, bloc, fld(c, n, "value"));
        fl_join(vec_get(w.res, 0), v);
        return 0;
    }
    if k == "Scope" {
        w_block(c, pf, w, bloc, fld(c, n, "body"));
        return 0;
    }
    if k == "Defer" {
        let body = fld(c, n, "body");
        w_block(c, pf, w, bloc, body);
        ints_push(w.defers, body);
        return 0;
    }
    if k == "Spawn" {
        let args = kids(c, n, "args");
        let flows = vec_new[Fl]();
        let mut i = 0;
        while i < ints_len(args) {
            vec_push(flows, w_expr(c, pf, w, bloc, ints_get(args, i)));
            i = i + 1;
        }
        let cs = fld(c, n, "callee_span");
        let site = site_at(c, sps(c, cs), spe(c, cs));
        if site >= 0 {
            if ints_get(c.suser, site) >= 0 { w_call(pf, w, ints_get(c.suser, site), sps(c, cs), spe(c, cs), flows, true); }
        }
        return 0;
    }
    0
}

// Whether a construction gives its fields by position (R1.5, D4).
fn positional_fields(c: Ck, fields: Ints) -> Bool {
    let mut i = 0;
    while i < ints_len(fields) {
        if fname_of(c, ints_get(fields, i), "name") == "" { return true; }
        i = i + 1;
    }
    false
}

// A record or variant built here, whole (`built_whole`), or each field kept apart (`built`).
fn w_built(c: Ck, pf: Pf, w: Wk, bloc: Ints, variant: Str, fields: Ints, parts: Bool) -> Int {
    let flow = fl_new();
    let vs = strs_new();
    let fs = strs_new();
    let xs = ints_new();
    let mut i = 0;
    while i < ints_len(fields) {
        let f = ints_get(fields, i);
        let v = sh_truncated(w, w_shaped(c, pf, w, bloc, fld(c, f, "value")), 1);
        fl_join(flow, sh_fl(w, v));
        if parts {
            // A later field of the same name replaces an earlier one, as a map's insert does.
            let name = fname_of(c, f, "name");
            let mut at = 0;
            while at < ints_len(xs) && key_less(strs_get(vs, at), strs_get(fs, at), variant, name) { at = at + 1; }
            if at < ints_len(xs) && strs_get(fs, at) == name && strs_get(vs, at) == variant {
                ints_set(xs, at, v);
            } else {
                strs_push(vs, "");
                strs_push(fs, "");
                ints_push(xs, 0);
                let mut j = ints_len(xs) - 1;
                while j > at {
                    strs_set(vs, j, strs_get(vs, j - 1));
                    strs_set(fs, j, strs_get(fs, j - 1));
                    ints_set(xs, j, ints_get(xs, j - 1));
                    j = j - 1;
                }
                strs_set(vs, at, variant);
                strs_set(fs, at, name);
                ints_set(xs, at, v);
            }
        }
        i = i + 1;
    }
    if parts { return sh_make(w, flow, parts_run(w, vs, fs, xs), ints_len(xs)); }
    sh_whole(w, flow)
}

// What each name a pattern binds carries (`bind_pattern`).
fn w_bind(c: Ck, pf: Pf, w: Wk, bloc: Ints, p: Int, v: Int) -> Int {
    let k = kind_of(c, p);
    if sx_kind(c.t, p) == tk_tuple() {
        if k == "Literal" {
            w_expr(c, pf, w, bloc, sx_kid(c.t, p, 0));
            return 0;
        }
        if k == "Variant" {
            let vp = sx_kid(c.t, p, 0);
            let variant = fname_of(c, vp, "variant");
            let fields = kids(c, vp, "fields");
            let mut i = 0;
            while i < ints_len(fields) {
                let f = ints_get(fields, i);
                let name = fname_of(c, f, "name");
                let mut part = 0 - 1;
                if sh_has_parts(w, v) {
                    if name == "" {
                        part = sh_whole(w, sh_flow(w, v));
                    } else {
                        part = part_of(w, ints_get(w.shpf, v), ints_get(w.shpc, v), variant, name);
                        if part < 0 { part = sh_none(w); }
                    }
                } else {
                    part = sh_whole(w, sh_flow(w, v));
                }
                w_bind(c, pf, w, bloc, fld(c, f, "pattern"), part);
                i = i + 1;
            }
        }
        return 0;
    }
    if k == "Bind" {
        let span = fld(c, p, "span");
        w_assign(c, pf, w, bloc, sps(c, span), spe(c, span), v);
        return 0;
    }
    if k == "Or" || k == "Tuple" {
        // A tuple pattern's are its `elems`: it has no `alts` to read.
        let mut field = "alts";
        if k == "Tuple" { field = "elems"; }
        let alts = kids(c, p, field);
        let mut i = 0;
        while i < ints_len(alts) {
            w_bind(c, pf, w, bloc, ints_get(alts, i), v);
            i = i + 1;
        }
    }
    0
}

// A method call's flow (`method`), receiver first: a call of the impl's function, or through a
// bound every impl of that trait method.
fn w_method(c: Ck, pf: Pf, w: Wk, s: Int, e: Int, flows: Vec[Fl]) -> Fl {
    let site = site_at(c, s, e);
    if site < 0 { return joined_all(flows); }
    if ints_get(c.suser, site) >= 0 { return w_call(pf, w, ints_get(c.suser, site), s, e, flows, false); }
    if ints_get(c.sind, site) >= 0 {
        let tm = ints_get(c.stm, site);
        if tm < 0 { return fl_joined(fl_origin(3, s, e), joined_all(flows)); }
        let target = cat5("trait ", strs_get(c.trname, method_trait(c, tm)), ".", strs_get(c.tmname, tm), "");
        return w_indirect(pf, w, target, s, e, flows);
    }
    joined_all(flows)
}

// The cell of a container of the shape `shape` (`cell_of_shape`), the call at `s..e` settling its
// element type; the wild cell where it does not.
fn cell_of_shape(c: Ck, shape: Str, s: Int, e: Int) -> Str {
    if shape == "Ints" || shape == "Strs" || shape == "Chan" || shape == "Bytes" || shape == "Atomic" { return shape; }
    let mut elem = "";
    let site = site_at(c, s, e);
    if site >= 0 {
        let t = ints_get(c.starg, site);
        if t >= 0 && concrete(c, t) { elem = show(c, t); }
    }
    if elem == "" { return "*"; }
    if shape == "Vec[T]" { return vec_cell(elem); }
    if shape == "Cell[T]" { return cat3("Cell[", elem, "]"); }
    if shape == "Chan[T]" || shape == "Vec[Chan[T]]" { return cat3("Chan[", elem, "]"); }
    "*"
}

// The shape of argument `arg` of built-in `b`, as the table spells it.
fn arg_shape(c: Ck, b: Int, arg: Int) -> Str {
    let shapes = split(strs_get(c.bshapes, b), 44);
    if arg < strs_len(shapes) { return strs_get(shapes, arg); }
    ""
}

fn w_cell(c: Ck, b: Int, s: Int, e: Int, arg: Int) -> Str { cell_of_shape(c, arg_shape(c, b, arg), s, e) }

fn flow_at(flows: Vec[Fl], i: Int) -> Fl {
    if i < vec_len(flows) { return fl_copy(vec_get(flows, i)); }
    fl_new()
}

// A call's flow from its arguments' (`call_flows`).
fn w_call_flows(c: Ck, pf: Pf, w: Wk, bloc: Ints, s: Int, e: Int, flows: Vec[Fl]) -> Fl {
    let site = site_at(c, s, e);
    if site < 0 { return joined_all(flows); }
    let b = ints_get(c.sbuiltin, site);
    if b >= 0 {
        let all = joined_all(flows);
        // Every argument that takes data out of the program, by class (N52).
        let table = split(strs_get(c.bsk, b), 44);
        let mut i = 0;
        while i < strs_len(table) {
            let one = strs_get(table, i);
            if one != "" {
                let parts = split(one, 58);
                let arg = parse_int(strs_get(parts, 0));
                if arg < vec_len(flows) { w_sink(pf, w, s, e, sink_class(strs_get(parts, 1)), vec_get(flows, arg)); }
            }
            i = i + 1;
        }
        // What it reads out of, or writes into, a container's cell (N80).
        let cu = split(strs_get(c.bcont, b), 58);
        let how = strs_get(cu, 0);
        let mut contained = 0 - 1;
        let cont = vec_new[Fl]();
        if how == "read" {
            let cell = w_cell(c, b, s, e, parse_int(strs_get(cu, 1)));
            vec_push(cont, fl_joined(fl_cell(cell, s, e), all));
            contained = 0;
        }
        if how == "write" {
            let cell = w_cell(c, b, s, e, parse_int(strs_get(cu, 1)));
            w_store(pf, w, cell, s, e, flow_at(flows, parse_int(strs_get(cu, 2))));
        }
        if how == "make" {
            let cell = cell_of_shape(c, strs_get(c.bretshape, b), s, e);
            w_store(pf, w, cell, s, e, flow_at(flows, parse_int(strs_get(cu, 1))));
        }
        if how == "exchange" {
            let cell = w_cell(c, b, s, e, parse_int(strs_get(cu, 1)));
            w_store(pf, w, cell, s, e, flow_at(flows, parse_int(strs_get(cu, 2))));
            vec_push(cont, fl_joined(fl_cell(cell, s, e), all));
            contained = 0;
        }
        if how == "receive" {
            let source = w_cell(c, b, s, e, parse_int(strs_get(cu, 1)));
            let target = w_cell(c, b, s, e, parse_int(strs_get(cu, 2)));
            let moved = fl_cell(source, s, e);
            w_store(pf, w, target, s, e, moved);
            vec_push(cont, fl_joined(moved, all));
            contained = 0;
        }
        if how == "fill" {
            let flow = strs_get(c.bflow, b);
            if str_starts(flow, "source:") {
                let o = origin_named(str_slice(flow, 7, str_len(flow)));
                let into = split(strs_get(cu, 1), 59);
                let mut k = 0;
                while k < strs_len(into) {
                    let cell = w_cell(c, b, s, e, parse_int(strs_get(into, k)));
                    w_store(pf, w, cell, s, e, fl_origin(o, s, e));
                    k = k + 1;
                }
            }
        }
        if how == "select" {
            let source = w_cell(c, b, s, e, parse_int(strs_get(cu, 1)));
            let target = w_cell(c, b, s, e, parse_int(strs_get(cu, 2)));
            w_store(pf, w, target, s, e, fl_cell(source, s, e));
            vec_push(cont, fl_new());
            contained = 0;
        }
        let flow = strs_get(c.bflow, b);
        if str_starts(flow, "source:") { return fl_joined(fl_origin(origin_named(str_slice(flow, 7, str_len(flow))), s, e), all); }
        if flow == "derive" || flow == "write-path" { return all; }
        if flow == "read" {
            if contained >= 0 { return vec_get(cont, 0); }
            return fl_joined(fl_origin(3, s, e), all);
        }
        return fl_new();
    }
    if ints_get(c.suser, site) >= 0 { return w_call(pf, w, ints_get(c.suser, site), s, e, flows, false); }
    if ints_get(c.sind, site) >= 0 {
        // Through a function value (N80): every function value of a matching type may run, and
        // the value itself carries what it captured.
        let bid = sm_get(c.mvar, s, e);
        let mut target = "fn *";
        if bid >= 0 { target = fn_type_target(c, ints_get(c.bty, bid)); }
        let callee = sh_flow(w, w_var(c, pf, w, bloc, s, e));
        return fl_joined(w_indirect(pf, w, target, s, e, flows), callee);
    }
    joined_all(flows)
}

fn origin_named(name: Str) -> Int {
    if name == "argument" { return 0; }
    if name == "file" { return 1; }
    if name == "authority" { return 2; }
    3
}

fn w_call_expr(c: Ck, pf: Pf, w: Wk, bloc: Ints, span: Int, args: Ints) -> Fl {
    let flows = vec_new[Fl]();
    let mut i = 0;
    while i < ints_len(args) {
        vec_push(flows, w_expr(c, pf, w, bloc, ints_get(args, i)));
        i = i + 1;
    }
    w_call_flows(c, pf, w, bloc, sps(c, span), spe(c, span), flows)
}

// What an expression carries (`shaped`).
fn w_shaped(c: Ck, pf: Pf, w: Wk, bloc: Ints, e: Int) -> Int {
    let k = kind_of(c, e);
    if sx_kind(c.t, e) == tk_tuple() {
        if k == "Block" { return w_block(c, pf, w, bloc, sx_kid(c.t, e, 0)); }
        return sh_none(w);
    }
    if k == "Closure" {
        // A closure is walked as a function of its own; making one moves no data.
        let span = fld(c, e, "span");
        let mut seen = false;
        let mut i = 0;
        while i < ints_len(w.clos) {
            let o = fld(c, ints_get(w.clos, i), "span");
            if sx_s(c.t, o) == sx_s(c.t, span) && sx_e(c.t, o) == sx_e(c.t, span) { seen = true; }
            i = i + 1;
        }
        if seen == false { ints_push(w.clos, e); }
        return sh_none(w);
    }
    if k == "Int" || k == "WideInt" || k == "Float" || k == "Bool" || k == "Str" { return sh_none(w); }
    if k == "Var" {
        let span = fld(c, e, "span");
        return w_var(c, pf, w, bloc, sps(c, span), spe(c, span));
    }
    if k == "Neg" || k == "BitNot" { return sh_whole(w, w_expr(c, pf, w, bloc, fld(c, e, "operand"))); }
    if k == "Array" || k == "Tuple" {
        let elems = kids(c, e, "elems");
        if ints_len(elems) == 0 { return sh_none(w); }
        let flow = fl_new();
        let mut i = 0;
        while i < ints_len(elems) {
            fl_join(flow, w_expr(c, pf, w, bloc, ints_get(elems, i)));
            i = i + 1;
        }
        return sh_whole(w, flow);
    }
    if k == "ArrayRepeat" {
        w_expr(c, pf, w, bloc, fld(c, e, "count"));
        return sh_whole(w, w_expr(c, pf, w, bloc, fld(c, e, "value")));
    }
    if k == "Index" {
        let b = w_expr(c, pf, w, bloc, fld(c, e, "base"));
        let i = w_expr(c, pf, w, bloc, fld(c, e, "index"));
        return sh_whole(w, fl_joined(b, i));
    }
    if k == "Not" {
        w_expr(c, pf, w, bloc, fld(c, e, "operand"));
        return sh_none(w);
    }
    if k == "Binary" {
        let op = sx_text(c.t, fld(c, e, "op"));
        if op == "And" || op == "Or" {
            w_expr(c, pf, w, bloc, fld(c, e, "lhs"));
            return sh_whole(w, w_expr(c, pf, w, bloc, fld(c, e, "rhs")));
        }
        let l = w_expr(c, pf, w, bloc, fld(c, e, "lhs"));
        let r = w_expr(c, pf, w, bloc, fld(c, e, "rhs"));
        return sh_whole(w, fl_joined(l, r));
    }
    if k == "Call" { return sh_whole(w, w_call_expr(c, pf, w, bloc, fld(c, e, "callee_span"), kids(c, e, "args"))); }
    if k == "Variant" {
        let fields = kids(c, e, "fields");
        let vsp = fld(c, e, "variant_span");
        // `x.m()` the checker read as a method call (N78).
        if ints_len(fields) == 0 && site_at(c, sps(c, vsp), spe(c, vsp)) >= 0 {
            let flows = vec_new[Fl]();
            let ts = fld(c, e, "ty_span");
            if sm_get(c.mvar, sps(c, ts), spe(c, ts)) >= 0 { vec_push(flows, sh_flow(w, w_var(c, pf, w, bloc, sps(c, ts), spe(c, ts)))); }
            return sh_whole(w, w_method(c, pf, w, sps(c, vsp), spe(c, vsp), flows));
        }
        if positional_fields(c, fields) { return w_built(c, pf, w, bloc, "", fields, false); }
        return w_built(c, pf, w, bloc, fname_of(c, e, "variant"), fields, true);
    }
    if k == "Interp" {
        let parts = kids(c, e, "parts");
        let mut flow = fl_new();
        let mut any = false;
        let mut i = 0;
        while i < ints_len(parts) {
            let part = ints_get(parts, i);
            if sx_kind(c.t, part) != tk_tuple() {
                let mut f = w_expr(c, pf, w, bloc, fld(c, part, "expr"));
                let hs = fld(c, part, "span");
                if site_at(c, sps(c, hs), spe(c, hs)) >= 0 {
                    let one = vec_new[Fl]();
                    vec_push(one, f);
                    f = w_method(c, pf, w, sps(c, hs), spe(c, hs), one);
                }
                if any { fl_join(flow, f); } else { flow = f; }
                any = true;
            }
            i = i + 1;
        }
        if any { return sh_whole(w, flow); }
        return sh_none(w);
    }
    if k == "MethodCall" {
        let receiver = fld(c, e, "receiver");
        let flows = vec_new[Fl]();
        let mut ufcs = false;
        if sx_kind(c.t, receiver) != tk_tuple() && kind_of(c, receiver) == "Var" {
            let rs = fld(c, receiver, "span");
            ufcs = sm_get(c.mvar, sps(c, rs), spe(c, rs)) < 0;
        }
        if ufcs == false { vec_push(flows, w_expr(c, pf, w, bloc, receiver)); }
        let args = kids(c, e, "args");
        let mut i = 0;
        while i < ints_len(args) {
            vec_push(flows, w_expr(c, pf, w, bloc, ints_get(args, i)));
            i = i + 1;
        }
        let ms = fld(c, e, "method_span");
        return sh_whole(w, w_method(c, pf, w, sps(c, ms), spe(c, ms), flows));
    }
    if k == "Construct" {
        let fields = kids(c, e, "fields");
        let ts = fld(c, e, "ty_span");
        if sm_get(c.mcons, sps(c, ts), spe(c, ts)) < 0 || positional_fields(c, fields) { return w_built(c, pf, w, bloc, "", fields, false); }
        return w_built(c, pf, w, bloc, "", fields, true);
    }
    if k == "Match" {
        let s = w_shaped(c, pf, w, bloc, fld(c, e, "scrutinee"));
        let mut out = sh_none(w);
        let arms = kids(c, e, "arms");
        let mut i = 0;
        while i < ints_len(arms) {
            let arm = ints_get(arms, i);
            w_bind(c, pf, w, bloc, fld(c, arm, "pattern"), s);
            if some(c, arm, "guard") { w_expr(c, pf, w, bloc, unwrap(c, arm, "guard")); }
            let v = w_shaped(c, pf, w, bloc, fld(c, arm, "body"));
            out = sh_join(w, out, v);
            i = i + 1;
        }
        return out;
    }
    if k == "Field" {
        let b = w_shaped(c, pf, w, bloc, fld(c, e, "base"));
        if sh_has_parts(w, b) == false { return sh_whole(w, sh_flow(w, b)); }
        let name = fname_of(c, e, "name");
        let mut out = sh_none(w);
        let pf0 = ints_get(w.shpf, b);
        let mut i = 0;
        while i < ints_get(w.shpc, b) {
            if strs_get(w.pkf, pf0 + i) == name { out = sh_join(w, out, ints_get(w.pval, pf0 + i)); }
            i = i + 1;
        }
        return out;
    }
    if k == "Propagate" {
        let o = w_shaped(c, pf, w, bloc, fld(c, e, "operand"));
        if sh_has_parts(w, o) == false { return sh_whole(w, sh_flow(w, o)); }
        let mut out = sh_none(w);
        let pf0 = ints_get(w.shpf, o);
        let mut i = 0;
        while i < ints_get(w.shpc, o) {
            let v = strs_get(w.pkv, pf0 + i);
            if v != "Err" && v != "None" { out = sh_join(w, out, ints_get(w.pval, pf0 + i)); }
            i = i + 1;
        }
        return out;
    }
    if k == "If" {
        w_expr(c, pf, w, bloc, fld(c, e, "cond"));
        let t = w_block(c, pf, w, bloc, fld(c, e, "then_block"));
        let mut other = sh_none(w);
        if some(c, e, "else_block") { other = w_block(c, pf, w, bloc, unwrap(c, e, "else_block")); }
        return sh_join(w, t, other);
    }
    sh_none(w)
}

// --- every body's facts (`facts`) ---------------------------------------------------------------

// Walk one body to its fixed point (`walk`): again only while a binding grew after it was read.
fn walk_body(c: Ck, pf: Pf, w: Wk, bloc: Ints, body: Int) -> Int {
    let mut pass = 0;
    while pass < 256 {
        ints_set(w.st, 2, 0);
        let mut i = 0;
        while i < ints_len(w.lr) {
            ints_set(w.lr, i, 0);
            i = i + 1;
        }
        let tail = w_block(c, pf, w, bloc, body);
        fl_join(vec_get(w.res, 0), sh_fl(w, tail));
        if ints_get(w.st, 2) == 0 { pass = 256; }
        pass = pass + 1;
    }
    0
}

// The walk's facts filed, the closures it wrote made (`with_makes`) with what each capture holds
// as the body left it and queued on `pending`, and its bindings forgotten.
fn file_facts(c: Ck, pf: Pf, w: Wk, bloc: Ints, pending: Ints) -> Int {
    let i = 0;
    let mut k = 0;
    while k < ints_len(w.clos) {
        let e = ints_get(w.clos, k);
        let span = fld(c, e, "span");
        let cid = sm_get(c.mclo, sps(c, span), spe(c, span));
        if cid >= 0 {
            ints_push(pf.mfn, cid);
            strs_push(pf.mtg, function_target(c, cid));
            ints_push(pf.mss, sps(c, span));
            ints_push(pf.mse, spe(c, span));
            ints_push(pf.mcf, vec_len(pf.args));
            let mut n = 0;
            let mut j = 0;
            while j < ints_len(c.capcl) {
                if ints_get(c.capcl, j) == cid {
                    let l = ints_get(bloc, ints_get(c.capbd, j));
                    if l >= 0 { vec_push(pf.args, fl_copy(vec_get(w.lf, l))); } else { vec_push(pf.args, fl_new()); }
                    n = n + 1;
                }
                j = j + 1;
            }
            ints_push(pf.mcc, n);
            ints_push(pending, e);
        }
        k = k + 1;
    }
    ints_push(pf.ffn, w_fn(w));
    vec_push(pf.fres, vec_get(w.res, 0));
    ints_push(pf.fcf, ints_get(w.st, 3));
    ints_push(pf.fcc, ints_len(pf.ccal) - ints_get(w.st, 3));
    ints_push(pf.fsf, ints_get(w.st, 4));
    ints_push(pf.fsc, ints_len(pf.kss) - ints_get(w.st, 4));
    ints_push(pf.fof, ints_get(w.st, 5));
    ints_push(pf.foc, strs_len(pf.ocl) - ints_get(w.st, 5));
    ints_push(pf.fif, ints_get(w.st, 6));
    ints_push(pf.fic, strs_len(pf.itg) - ints_get(w.st, 6));
    ints_push(pf.fmf, ints_get(w.st, 7));
    ints_push(pf.fmc, ints_len(pf.mfn) - ints_get(w.st, 7));
    k = 0;
    while k < ints_len(w.lb) {
        ints_set(bloc, ints_get(w.lb, k), 0 - 1);
        k = k + 1;
    }
    i
}

// How many captures closure `f` has.
fn captures_of(c: Ck, f: Int) -> Int {
    let mut n = 0;
    let mut j = 0;
    while j < ints_len(c.capcl) {
        if ints_get(c.capcl, j) == f { n = n + 1; }
        j = j + 1;
    }
    n
}

// Every function of every module, in load order and each module's order, then each closure it
// wrote, the last written first (`facts`).
fn all_facts(c: Ck, pf: Pf, bloc: Ints) -> Int {
    let entry = defined_fn(c, 0, "main");
    let mut m = 0;
    while m < ints_len(c.mprog) {
        ss(c, s_module(), m);
        let functions = kids(c, ints_get(c.mprog, m), "functions");
        let mut i = 0;
        while i < ints_len(functions) {
            let f = ints_get(functions, i);
            let mut id = 0 - 1;
            if some(c, f, "method_of") { id = fn_of_node(c, f); } else { id = defined_fn(c, m, fname_of(c, f, "name")); }
            if id >= 0 && some(c, f, "body") {
                if ints_get(c.fnnode, id) == f { walk_function(c, pf, bloc, f, id, id == entry); }
            }
            i = i + 1;
        }
        m = m + 1;
    }
    0
}

fn walk_function(c: Ck, pf: Pf, bloc: Ints, f: Int, id: Int, entry: Bool) -> Int {
    let n = ints_get(c.fnpc, id);
    let w = wk_new(id, n, pf);
    let first = ints_get(c.fnpb, id);
    let params = kids(c, f, "params");
    let mut i = 0;
    while i < n && first >= 0 {
        let mut flow = fl_param(i);
        if entry {
            flow = fl_new();
            if is_cap(c, ints_get(c.ptys, ints_get(c.fnpf, id) + i)) {
                // `main`'s parameters have no caller: what they hold is the runtime's root
                // authority (N37).
                let mut at = fld(c, f, "name_span");
                if i < ints_len(params) { at = fld(c, ints_get(params, i), "name_span"); }
                flow = fl_origin(2, sps(c, at), spe(c, at));
            }
        }
        w_add_local(w, bloc, first + i, flow, 2);
        i = i + 1;
    }
    walk_body(c, pf, w, bloc, unwrap(c, f, "body"));
    let pending = ints_new();
    file_facts(c, pf, w, bloc, pending);
    // Each closure the body wrote is a function of its own, walked after the body that made it.
    let mut guard = 0;
    while ints_len(pending) > 0 && guard <= 4096 {
        guard = guard + 1;
        let e = ints_pop(pending);
        let span = fld(c, e, "span");
        let cid = sm_get(c.mclo, sps(c, span), spe(c, span));
        if cid >= 0 {
            let cn = ints_get(c.fnpc, cid);
            let cw = wk_new(cid, cn, pf);
            let cfirst = ints_get(c.fnpb, cid);
            let mut k = 0;
            while k < cn && cfirst >= 0 {
                w_add_local(cw, bloc, cfirst + k, fl_param(k), 2);
                k = k + 1;
            }
            let mut j = 0;
            let mut x = 0;
            while x < ints_len(c.capcl) {
                if ints_get(c.capcl, x) == cid {
                    w_add_local(cw, bloc, ints_get(c.capbd, x), fl_param(cn + j), 2);
                    j = j + 1;
                }
                x = x + 1;
            }
            walk_body(c, pf, cw, bloc, fld(c, e, "body"));
            file_facts(c, pf, cw, bloc, pending);
        }
    }
    0
}

// --- the whole program (`solve`) ------------------------------------------------------------------

// The program as it is solved: by function, which facts are its, its summary (origins and
// parameters its result always carries), its arity, which parameters reach each class of sink, and
// what each parameter and capture is handed; each cell's origins; which functions each indirect
// target may run; and each call's and indirect call's value, as last settled.
pub struct Ps {
    at: Ints,
    so: Ints,
    sp: Ints,
    ar: Ints,
    reach: Ints,
    rcf: Ints,
    rcc: Ints,
    rcv: Ints,
    cn: Strs,
    co: Ints,
    tn: Strs,
    tf: Ints,
    tc: Ints,
    tv: Ints,
    vco: Ints,
    vcp: Ints,
    vio: Ints,
    vip: Ints,
    // Each indirect call's candidates, a run of `tv` (`resolved`).
    icf: Ints,
    icc: Ints,
}

// A value solved (`Val`): origins, and the enclosing function's parameters it carries.
pub struct Vl {
    o: Int,
    p: Int,
}

fn ps_cell(ps: Ps, name: Str) -> Int {
    let mut o = 0;
    let mut i = 0;
    while i < strs_len(ps.cn) {
        if name == "*" || strs_get(ps.cn, i) == name || strs_get(ps.cn, i) == "*" { o = bor(o, ints_get(ps.co, i)); }
        i = i + 1;
    }
    o
}

fn ps_received(ps: Ps, g: Int, p: Int) -> Int {
    if p < ints_get(ps.rcc, g) { return ints_get(ps.rcv, ints_get(ps.rcf, g) + p); }
    0
}

fn ps_eval(ps: Ps, f: Fl) -> Vl {
    let mut o = fl_origins(f);
    let mut p = fl_params(f);
    let mut i = 0;
    while i < ints_len(f.cs) {
        o = bor(o, ints_get(ps.vco, ints_get(f.cs, i)));
        p = bor(p, ints_get(ps.vcp, ints_get(f.cs, i)));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(f.vs) {
        o = bor(o, ints_get(ps.vio, ints_get(f.vs, i)));
        p = bor(p, ints_get(ps.vip, ints_get(f.vs, i)));
        i = i + 1;
    }
    i = 0;
    while i < strs_len(f.cn) {
        o = bor(o, ps_cell(ps, strs_get(f.cn, i)));
        i = i + 1;
    }
    Vl(o: o, p: p)
}

// What `flow` can carry in function `g`: its value's origins and what its parameters are handed.
fn ps_reaching(ps: Ps, g: Int, f: Fl) -> Int {
    let v = ps_eval(ps, f);
    let mut o = v.o;
    let ps_ = bits_of(v.p);
    let mut i = 0;
    while i < ints_len(ps_) {
        o = bor(o, ps_received(ps, g, ints_get(ps_, i)));
        i = i + 1;
    }
    o
}

// What a call of `g` with the arguments `af..af+ac` returns (`applied`).
fn ps_applied(ps: Ps, pf: Pf, g: Int, af: Int, ac: Int) -> Vl {
    let mut o = ints_get(ps.so, g);
    let mut p = 0;
    let qs = bits_of(ints_get(ps.sp, g));
    let mut i = 0;
    while i < ints_len(qs) {
        let q = ints_get(qs, i);
        if q < ints_get(ps.ar, g) {
            if q < ac {
                let v = ps_eval(ps, vec_get(pf.args, af + q));
                o = bor(o, v.o);
                p = bor(p, v.p);
            }
        } else {
            o = bor(o, ps_received(ps, g, q));
        }
        i = i + 1;
    }
    Vl(o: o, p: p)
}

// Every call's result in fact `k`, against the current summaries (`values`): a small fixed point.
fn ps_values(ps: Ps, pf: Pf, k: Int) -> Int {
    let cf = ints_get(pf.fcf, k);
    let cc = ints_get(pf.fcc, k);
    let xf = ints_get(pf.fif, k);
    let xc = ints_get(pf.fic, k);
    let mut i = 0;
    while i < cc {
        ints_set(ps.vco, cf + i, 0);
        ints_set(ps.vcp, cf + i, 0);
        i = i + 1;
    }
    i = 0;
    while i < xc {
        ints_set(ps.vio, xf + i, 0);
        ints_set(ps.vip, xf + i, 0);
        i = i + 1;
    }
    let mut round = 0;
    while round <= cc + xc {
        let mut changed = false;
        i = 0;
        while i < cc {
            let x = cf + i;
            let v = ps_applied(ps, pf, ints_get(pf.ccal, x), ints_get(pf.caf, x), ints_get(pf.cac, x));
            if v.o != ints_get(ps.vco, x) || v.p != ints_get(ps.vcp, x) {
                ints_set(ps.vco, x, v.o);
                ints_set(ps.vcp, x, v.p);
                changed = true;
            }
            i = i + 1;
        }
        i = 0;
        while i < xc {
            let x = xf + i;
            let mut o = 0;
            let mut p = 0;
            let mut j = 0;
            while j < ints_get(ps.icc, x) {
                let v = ps_applied(ps, pf, ints_get(ps.tv, ints_get(ps.icf, x) + j), ints_get(pf.iaf, x), ints_get(pf.iac, x));
                o = bor(o, v.o);
                p = bor(p, v.p);
                j = j + 1;
            }
            if o != ints_get(ps.vio, x) || p != ints_get(ps.vip, x) {
                ints_set(ps.vio, x, o);
                ints_set(ps.vip, x, p);
                changed = true;
            }
            i = i + 1;
        }
        if changed { round = round + 1; } else { round = cc + xc + 1; }
    }
    0
}

fn ps_reach(ps: Ps, g: Int, class: Int) -> Int { ints_get(ps.reach, 4 * g + class) }

// Summaries to their least fixed point (`settle`), whole passes until none grows.
fn ps_settle(ps: Ps, pf: Pf) -> Int {
    let count = ints_len(pf.ffn);
    let mut changed = true;
    while changed {
        changed = false;
        let mut k = count - 1;
        while k >= 0 {
            ps_values(ps, pf, k);
            let r = ps_eval(ps, vec_get(pf.fres, k));
            let g = ints_get(pf.ffn, k);
            if r.o != ints_get(ps.so, g) || r.p != ints_get(ps.sp, g) {
                ints_set(ps.so, g, r.o);
                ints_set(ps.sp, g, r.p);
                changed = true;
            }
            k = k - 1;
        }
    }
    0
}

// Which parameters reach a sink of each class (`settle_reach`).
fn ps_settle_reach(ps: Ps, pf: Pf) -> Int {
    let count = ints_len(pf.ffn);
    let mut changed = true;
    while changed {
        changed = false;
        let mut k = 0;
        while k < count {
            let g = ints_get(pf.ffn, k);
            let mut i = 0;
            while i < ints_get(pf.fsc, k) {
                let s = ints_get(pf.fsf, k) + i;
                let slot = 4 * g + ints_get(pf.kcl, s);
                let grown = bor(ints_get(ps.reach, slot), ps_eval(ps, vec_get(pf.kfl, s)).p);
                if grown != ints_get(ps.reach, slot) {
                    ints_set(ps.reach, slot, grown);
                    changed = true;
                }
                i = i + 1;
            }
            let mut class = 0;
            while class < 4 {
                let mut add = 0;
                i = 0;
                while i < ints_get(pf.fcc, k) {
                    let x = ints_get(pf.fcf, k) + i;
                    let rs = bits_of(ps_reach(ps, ints_get(pf.ccal, x), class));
                    let mut j = 0;
                    while j < ints_len(rs) {
                        let a = ints_get(rs, j);
                        if a < ints_get(pf.cac, x) { add = bor(add, ps_eval(ps, vec_get(pf.args, ints_get(pf.caf, x) + a)).p); }
                        j = j + 1;
                    }
                    i = i + 1;
                }
                i = 0;
                while i < ints_get(pf.fic, k) {
                    let x = ints_get(pf.fif, k) + i;
                    let mut q = 0;
                    while q < ints_get(ps.icc, x) {
                        let h = ints_get(ps.tv, ints_get(ps.icf, x) + q);
                        let rs = bits_of(ps_reach(ps, h, class));
                        let mut j = 0;
                        while j < ints_len(rs) {
                            let a = ints_get(rs, j);
                            if a < ints_get(ps.ar, h) && a < ints_get(pf.iac, x) { add = bor(add, ps_eval(ps, vec_get(pf.args, ints_get(pf.iaf, x) + a)).p); }
                            j = j + 1;
                        }
                        q = q + 1;
                    }
                    i = i + 1;
                }
                i = 0;
                while i < ints_get(pf.fmc, k) {
                    let x = ints_get(pf.fmf, k) + i;
                    let h = ints_get(pf.mfn, x);
                    let base = ints_get(ps.ar, h);
                    let rs = bits_of(ps_reach(ps, h, class));
                    let mut j = 0;
                    while j < ints_len(rs) {
                        let a = ints_get(rs, j) - base;
                        if a >= 0 && a < ints_get(pf.mcc, x) { add = bor(add, ps_eval(ps, vec_get(pf.args, ints_get(pf.mcf, x) + a)).p); }
                        j = j + 1;
                    }
                    i = i + 1;
                }
                let slot = 4 * g + class;
                let grown = bor(ints_get(ps.reach, slot), add);
                if grown != ints_get(ps.reach, slot) {
                    ints_set(ps.reach, slot, grown);
                    changed = true;
                }
                class = class + 1;
            }
            k = k + 1;
        }
    }
    0
}

// What each parameter and capture is handed (`settle_receives`): every edge evaluated once, then
// grown to a fixed point.
fn ps_settle_receives(ps: Ps, pf: Pf) -> Int {
    let eg = ints_new();
    let ei = ints_new();
    let eo = ints_new();
    let efrom = ints_new();
    let ep = ints_new();
    let count = ints_len(pf.ffn);
    let mut k = 0;
    while k < count {
        let from = ints_get(pf.ffn, k);
        let mut i = 0;
        while i < ints_get(pf.fcc, k) {
            let x = ints_get(pf.fcf, k) + i;
            let mut a = 0;
            while a < ints_get(pf.cac, x) {
                let v = ps_eval(ps, vec_get(pf.args, ints_get(pf.caf, x) + a));
                ints_push(eg, ints_get(pf.ccal, x));
                ints_push(ei, a);
                ints_push(eo, v.o);
                ints_push(efrom, from);
                ints_push(ep, v.p);
                a = a + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < ints_get(pf.fic, k) {
            let x = ints_get(pf.fif, k) + i;
            let mut q = 0;
            while q < ints_get(ps.icc, x) {
                let h = ints_get(ps.tv, ints_get(ps.icf, x) + q);
                let mut a = 0;
                while a < ints_get(pf.iac, x) && a < ints_get(ps.ar, h) {
                    let v = ps_eval(ps, vec_get(pf.args, ints_get(pf.iaf, x) + a));
                    ints_push(eg, h);
                    ints_push(ei, a);
                    ints_push(eo, v.o);
                    ints_push(efrom, from);
                    ints_push(ep, v.p);
                    a = a + 1;
                }
                q = q + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < ints_get(pf.fmc, k) {
            let x = ints_get(pf.fmf, k) + i;
            let h = ints_get(pf.mfn, x);
            let base = ints_get(ps.ar, h);
            let mut a = 0;
            while a < ints_get(pf.mcc, x) {
                let v = ps_eval(ps, vec_get(pf.args, ints_get(pf.mcf, x) + a));
                ints_push(eg, h);
                ints_push(ei, base + a);
                ints_push(eo, v.o);
                ints_push(efrom, from);
                ints_push(ep, v.p);
                a = a + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut e = 0;
        while e < ints_len(eg) {
            let mut o = ints_get(eo, e);
            let qs = bits_of(ints_get(ep, e));
            let mut j = 0;
            while j < ints_len(qs) {
                o = bor(o, ps_received(ps, ints_get(efrom, e), ints_get(qs, j)));
                j = j + 1;
            }
            let g = ints_get(eg, e);
            let i = ints_get(ei, e);
            if i < ints_get(ps.rcc, g) {
                let slot = ints_get(ps.rcf, g) + i;
                let grown = bor(ints_get(ps.rcv, slot), o);
                if grown != ints_get(ps.rcv, slot) {
                    ints_set(ps.rcv, slot, grown);
                    changed = true;
                }
            }
            e = e + 1;
        }
    }
    0
}

// Which functions each target may run: the program's function values by type up to effects and
// each impl's method by its trait method (`targets`), then each indirect call's candidates
// (`resolve_candidates`), sorted.
fn ps_targets(c: Ck, ps: Ps, pf: Pf) -> Int {
    let names = strs_new();
    let fns = ints_new();
    let mut i = 0;
    while i < ints_len(pf.mfn) {
        strs_push(names, strs_get(pf.mtg, i));
        ints_push(fns, ints_get(pf.mfn, i));
        i = i + 1;
    }
    let mut im = 0;
    while im < ints_len(c.imtrait) {
        let tr = ints_get(c.imtrait, im);
        let mut m = 0;
        while m < ints_get(c.trmc, tr) {
            let g = ints_get(c.imfn, ints_get(c.imff, im) + m);
            if g >= 0 {
                strs_push(names, cat4("trait ", strs_get(c.trname, tr), ".", strs_get(c.tmname, ints_get(c.trmf, tr) + m)));
                ints_push(fns, g);
            }
            m = m + 1;
        }
        im = im + 1;
    }
    // Each indirect call's candidates.
    let x = 0;
    i = 0;
    while i < strs_len(pf.itg) {
        let target = strs_get(pf.itg, i);
        let run = ints_new();
        let mut j = 0;
        while j < strs_len(names) {
            let n = strs_get(names, j);
            let mut takes = n == target;
            if target == "fn *" { takes = str_starts(n, "fn "); }
            if str_starts(target, "fn ") && n == "fn *" { takes = true; }
            if takes { set_add(run, ints_get(fns, j)); }
            j = j + 1;
        }
        ints_push(ps.icf, ints_len(ps.tv));
        ints_push(ps.icc, ints_len(run));
        j = 0;
        while j < ints_len(run) {
            ints_push(ps.tv, ints_get(run, j));
            j = j + 1;
        }
        i = i + 1;
    }
    x
}

fn ps_candidates_has(ps: Ps, x: Int, g: Int) -> Bool {
    let mut j = 0;
    while j < ints_get(ps.icc, x) {
        if ints_get(ps.tv, ints_get(ps.icf, x) + j) == g { return true; }
        j = j + 1;
    }
    false
}

// --- witness chains (`Tracer`) --------------------------------------------------------------------

// One chain being built: its steps, nearest the sink first, and where it has been, so a cycle
// through calls or cells ends (`Seen`).
pub struct Tr {
    ss: Ints,
    se: Ints,
    notes: Strs,
    seen: Ints,
}

fn tr_new() -> Tr { Tr(ss: ints_new(), se: ints_new(), notes: strs_new(), seen: ints_new()) }

fn tr_step(t: Tr, s: Int, e: Int, note: Str) -> Int {
    ints_push(t.ss, s);
    ints_push(t.se, e);
    strs_push(t.notes, note);
    0
}

// Mark (a, b, x) seen; whether it was not.
fn tr_insert(t: Tr, a: Int, b: Int, x: Int) -> Bool {
    let mut i = 0;
    while i + 2 < ints_len(t.seen) {
        if ints_get(t.seen, i) == a && ints_get(t.seen, i + 1) == b && ints_get(t.seen, i + 2) == x { return false; }
        i = i + 3;
    }
    ints_push(t.seen, a);
    ints_push(t.seen, b);
    ints_push(t.seen, x);
    true
}

fn fn_named(c: Ck, g: Int) -> Str { tick(strs_get(c.fnname, g)) }

// How a parameter, or a capture past the parameters, is named in a message.
fn pv_param_name(c: Ck, g: Int, i: Int) -> Str {
    let n = ints_get(c.fnpc, g);
    if i < n {
        if ints_get(c.fnpb, g) >= 0 { return tick(strs_get(c.bnm, ints_get(c.fnpb, g) + i)); }
        return str_concat("#", int_to_str(i));
    }
    let mut j = 0;
    let mut x = 0;
    while x < ints_len(c.capcl) {
        if ints_get(c.capcl, x) == g {
            if j == i - n { return tick(strs_get(c.bnm, ints_get(c.capbd, x))); }
            j = j + 1;
        }
        x = x + 1;
    }
    str_concat("#", int_to_str(i))
}

fn cell_words(cell: Str) -> Str {
    if cell == "*" { return "a container in generic code, which may be any container"; }
    cat5("a `", cell, "`, which holds whatever is written into any `", cell, "`")
}

// How parameter `i` of `g` reaches a sink of `class`: one chain to it (`reaching`).
fn tr_reaching(c: Ck, ps: Ps, pf: Pf, t: Tr, g: Int, i: Int, class: Int, depth: Int) -> Int {
    if depth > 32 { return 0; }
    let k = ints_get(ps.at, g);
    if k < 0 { return 0; }
    let mut x = 0;
    while x < ints_get(pf.fsc, k) {
        let s = ints_get(pf.fsf, k) + x;
        if ints_get(pf.kcl, s) == class && bhas(ps_eval(ps, vec_get(pf.kfl, s)).p, i) {
            tr_step(t, ints_get(pf.kss, s), ints_get(pf.kse, s), cat3("in ", fn_named(c, g), ": it is the path written here"));
            return 0;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fcc, k) {
        let cx = ints_get(pf.fcf, k) + x;
        let callee = ints_get(pf.ccal, cx);
        let rs = bits_of(ps_reach(ps, callee, class));
        let mut j = 0;
        while j < ints_len(rs) {
            let a = ints_get(rs, j);
            if a < ints_get(pf.cac, cx) {
                if bhas(ps_eval(ps, vec_get(pf.args, ints_get(pf.caf, cx) + a)).p, i) {
                    tr_step(t, ints_get(pf.cs, cx), ints_get(pf.ce, cx), cat4("in ", fn_named(c, g), ": it is passed to ", fn_named(c, callee)));
                    tr_reaching(c, ps, pf, t, callee, a, class, depth + 1);
                    return 0;
                }
            }
            j = j + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fic, k) {
        let ix = ints_get(pf.fif, k) + x;
        let mut q = 0;
        while q < ints_get(ps.icc, ix) {
            let h = ints_get(ps.tv, ints_get(ps.icf, ix) + q);
            let rs = bits_of(ps_reach(ps, h, class));
            let mut j = 0;
            while j < ints_len(rs) {
                let a = ints_get(rs, j);
                if a < ints_get(pf.iac, ix) {
                    if bhas(ps_eval(ps, vec_get(pf.args, ints_get(pf.iaf, ix) + a)).p, i) {
                        tr_step(t, ints_get(pf.iss, ix), ints_get(pf.ise, ix),
                                cat4("in ", fn_named(c, g), ": it is passed through a value that may be ", fn_named(c, h)));
                        tr_reaching(c, ps, pf, t, h, a, class, depth + 1);
                        return 0;
                    }
                }
                j = j + 1;
            }
            q = q + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fmc, k) {
        let mx = ints_get(pf.fmf, k) + x;
        let h = ints_get(pf.mfn, mx);
        let base = ints_get(ps.ar, h);
        let rs = bits_of(ps_reach(ps, h, class));
        let mut j = 0;
        while j < ints_len(rs) {
            let a = ints_get(rs, j);
            let q = a - base;
            if q >= 0 && q < ints_get(pf.mcc, mx) {
                if bhas(ps_eval(ps, vec_get(pf.args, ints_get(pf.mcf, mx) + q)).p, i) {
                    tr_step(t, ints_get(pf.mss, mx), ints_get(pf.mse, mx), cat3("in ", fn_named(c, g), ": a closure captures it here"));
                    tr_reaching(c, ps, pf, t, h, a, class, depth + 1);
                    return 0;
                }
            }
            j = j + 1;
        }
        x = x + 1;
    }
    0
}

// Where `o` entered `flow`, in fact `k`: one chain, through calls, cells and callers to its source
// (`flow`).
fn tr_flow(c: Ck, ps: Ps, pf: Pf, t: Tr, k: Int, f: Fl, o: Int, depth: Int) -> Int {
    if depth > 32 { return 0; }
    if ints_get(f.m, 2 + o) >= 0 {
        tr_step(t, ints_get(f.m, 2 + o), ints_get(f.m, 6 + o), o_enters(o));
        return 0;
    }
    let me = ints_get(pf.ffn, k);
    let mut x = 0;
    while x < ints_len(f.cs) {
        let cx = ints_get(f.cs, x);
        let callee = ints_get(pf.ccal, cx);
        let s = ints_get(pf.cs, cx);
        let e = ints_get(pf.ce, cx);
        if bhas(ints_get(ps.so, callee), o) {
            if ints_get(c.fnfor, callee) == 1 {
                tr_step(t, s, e, str_concat(fn_named(c, callee), " is a foreign function, and what C returns is not followed"));
            } else {
                tr_step(t, s, e, cat4(fn_named(c, callee), " returns data from ", o_describe(o), ""));
            }
            let j = ints_get(ps.at, callee);
            if j >= 0 {
                if tr_insert(t, j, 0, 0 - 1) { tr_flow(c, ps, pf, t, j, vec_get(pf.fres, j), o, depth + 1); }
            }
            return 0;
        }
        let qs = bits_of(ints_get(ps.sp, callee));
        let mut y = 0;
        while y < ints_len(qs) {
            let q = ints_get(qs, y);
            if q >= ints_get(ps.ar, callee) {
                if bhas(ps_received(ps, callee, q), o) {
                    tr_step(t, s, e, str_concat(fn_named(c, callee), " returns what it captured"));
                    tr_param(c, ps, pf, t, callee, q, o, depth + 1);
                    return 0;
                }
            } else {
                if q < ints_get(pf.cac, cx) {
                    let a = vec_get(pf.args, ints_get(pf.caf, cx) + q);
                    if bhas(ps_reaching(ps, me, a), o) {
                        tr_step(t, s, e, str_concat(fn_named(c, callee), " passes on what it is given"));
                        tr_flow(c, ps, pf, t, k, a, o, depth + 1);
                        return 0;
                    }
                }
            }
            y = y + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_len(f.vs) {
        let ix = ints_get(f.vs, x);
        let s = ints_get(pf.iss, ix);
        let e = ints_get(pf.ise, ix);
        let mut q0 = 0;
        while q0 < ints_get(ps.icc, ix) {
            let g = ints_get(ps.tv, ints_get(ps.icf, ix) + q0);
            if bhas(ints_get(ps.so, g), o) {
                tr_step(t, s, e, cat4("a call through this value may run ", fn_named(c, g), ", which returns data from ", o_describe(o)));
                let j = ints_get(ps.at, g);
                if j >= 0 {
                    if tr_insert(t, j, 0, 0 - 1) { tr_flow(c, ps, pf, t, j, vec_get(pf.fres, j), o, depth + 1); }
                }
                return 0;
            }
            let qs = bits_of(ints_get(ps.sp, g));
            let mut y = 0;
            while y < ints_len(qs) {
                let q = ints_get(qs, y);
                if q >= ints_get(ps.ar, g) {
                    if bhas(ps_received(ps, g, q), o) {
                        tr_step(t, s, e, cat3("a call through this value may run ", fn_named(c, g), ", which returns what it captured"));
                        tr_param(c, ps, pf, t, g, q, o, depth + 1);
                        return 0;
                    }
                } else {
                    if q < ints_get(pf.iac, ix) {
                        let a = vec_get(pf.args, ints_get(pf.iaf, ix) + q);
                        if bhas(ps_reaching(ps, me, a), o) {
                            tr_step(t, s, e, cat3("a call through this value may run ", fn_named(c, g), ", which passes on what it is given"));
                            tr_flow(c, ps, pf, t, k, a, o, depth + 1);
                            return 0;
                        }
                    }
                }
                y = y + 1;
            }
            q0 = q0 + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < strs_len(f.cn) {
        let cell = strs_get(f.cn, x);
        if bhas(ps_cell(ps, cell), o) {
            tr_step(t, ints_get(f.cp, 2 * x), ints_get(f.cp, 2 * x + 1), str_concat("this is read out of ", cell_words(cell)));
            if tr_cell(c, ps, pf, t, cell, o, depth + 1) { return 0; }
        }
        x = x + 1;
    }
    let ps_ = bits_of(ps_eval(ps, f).p);
    x = 0;
    while x < ints_len(ps_) {
        let p = ints_get(ps_, x);
        if bhas(ps_received(ps, me, p), o) {
            tr_param(c, ps, pf, t, me, p, o, depth + 1);
            return 0;
        }
        x = x + 1;
    }
    0
}

// A write into `cell` that carries `o`, and where that came from (`cell`).
fn tr_cell(c: Ck, ps: Ps, pf: Pf, t: Tr, cell: Str, o: Int, depth: Int) -> Bool {
    let mut j = 0;
    while j < ints_len(pf.ffn) {
        let g = ints_get(pf.ffn, j);
        let mut x = 0;
        while x < ints_get(pf.foc, j) {
            let si = ints_get(pf.fof, j) + x;
            let sc = strs_get(pf.ocl, si);
            let matches = cell == "*" || sc == cell || sc == "*";
            if matches && bhas(ps_reaching(ps, g, vec_get(pf.ofl, si)), o) {
                if tr_insert(t, j, 1, x) {
                    let mut into = cat3("a `", sc, "`");
                    if sc == "*" { into = "a container in generic code"; }
                    tr_step(t, ints_get(pf.oss, si), ints_get(pf.ose, si), cat5(cat3("in ", fn_named(c, g), ": data from "), o_describe(o), " is written into ", into, " here"));
                    tr_flow(c, ps, pf, t, j, vec_get(pf.ofl, si), o, depth);
                    return true;
                }
            }
            x = x + 1;
        }
        j = j + 1;
    }
    false
}

// Who hands parameter (or capture) `p` of `g` the origin `o` (`param`).
fn tr_param(c: Ck, ps: Ps, pf: Pf, t: Tr, g: Int, p: Int, o: Int, depth: Int) -> Int {
    if depth > 32 { return 0; }
    if tr_insert(t, g, 2, p) == false { return 0; }
    let pname = pv_param_name(c, g, p);
    let base = ints_get(ps.ar, g);
    let mut j = 0;
    while j < ints_len(pf.ffn) {
        let h = ints_get(pf.ffn, j);
        if p < base {
            let mut x = 0;
            while x < ints_get(pf.fcc, j) {
                let cx = ints_get(pf.fcf, j) + x;
                if ints_get(pf.ccal, cx) == g && p < ints_get(pf.cac, cx) {
                    let a = vec_get(pf.args, ints_get(pf.caf, cx) + p);
                    if bhas(ps_reaching(ps, h, a), o) {
                        tr_step(t, ints_get(pf.cs, cx), ints_get(pf.ce, cx),
                                cat5(fn_named(c, g), " is called here, and its parameter ", pname, " is handed data from ", o_describe(o)));
                        tr_flow(c, ps, pf, t, j, a, o, depth + 1);
                        return 0;
                    }
                }
                x = x + 1;
            }
            x = 0;
            while x < ints_get(pf.fic, j) {
                let ix = ints_get(pf.fif, j) + x;
                if ps_candidates_has(ps, ix, g) && p < ints_get(pf.iac, ix) {
                    let a = vec_get(pf.args, ints_get(pf.iaf, ix) + p);
                    if bhas(ps_reaching(ps, h, a), o) {
                        tr_step(t, ints_get(pf.iss, ix), ints_get(pf.ise, ix),
                                cat5(cat3("a call through a value may run ", fn_named(c, g), " here, and hands its parameter "), pname, " data from ", o_describe(o), ""));
                        tr_flow(c, ps, pf, t, j, a, o, depth + 1);
                        return 0;
                    }
                }
                x = x + 1;
            }
        } else {
            let mut x = 0;
            while x < ints_get(pf.fmc, j) {
                let mx = ints_get(pf.fmf, j) + x;
                if ints_get(pf.mfn, mx) == g && p - base < ints_get(pf.mcc, mx) {
                    let a = vec_get(pf.args, ints_get(pf.mcf, mx) + p - base);
                    if bhas(ps_reaching(ps, h, a), o) {
                        tr_step(t, ints_get(pf.mss, mx), ints_get(pf.mse, mx), cat5("this closure captures ", pname, ", which holds data from ", o_describe(o), ""));
                        tr_flow(c, ps, pf, t, j, a, o, depth + 1);
                        return 0;
                    }
                }
                x = x + 1;
            }
        }
        j = j + 1;
    }
    0
}

fn flow_help() -> Str {
    "in a function that declares its effects, the path a program writes to may come from the command line or be computed in the program, but not from the contents of a file, nor from a device or foreign (C) function the checker does not follow. `str_vouch`, under a `VouchCap`, declassifies a value on purpose"
}

fn tr_publish(c: Ck, t: Tr, s: Int, e: Int, message: Str, primary: Str) -> Int {
    dg_error(c.d, "N0372", s, e, message, primary, flow_help());
    let mut i = 0;
    while i < ints_len(t.ss) {
        dg_secondary(c.d, ints_get(t.ss, i), ints_get(t.se, i), strs_get(t.notes, i));
        i = i + 1;
    }
    0
}

// The path a function writes to comes from `o` (`direct`).
fn tr_direct(c: Ck, ps: Ps, pf: Pf, k: Int, si: Int, o: Int) -> Int {
    let t = tr_new();
    tr_flow(c, ps, pf, t, k, vec_get(pf.kfl, si), o, 0);
    tr_publish(c, t, ints_get(pf.kss, si), ints_get(pf.kse, si), str_concat("the path `write_file` writes to comes from ", o_describe(o)),
            str_concat("this path comes from ", o_describe(o)))
}

// A call of `g` at `s..e` hands `arg`, carrying `o`, to its parameter `i`, which reaches the path;
// `via` 1 through a value, 2 a capture (`through`).
fn tr_through(c: Ck, ps: Ps, pf: Pf, k: Int, g: Int, s: Int, e: Int, i: Int, arg: Fl, o: Int, via: Int) -> Int {
    let callee = fn_named(c, g);
    let param = pv_param_name(c, g, i);
    let mut message = cat5(callee, " writes to a path made from its parameter ", param, ", and this argument comes from ", o_describe(o));
    if via == 1 {
        message = cat5(cat3("a call through this value may run ", callee, ", which writes to a path made from its parameter "), param,
                ", and this argument comes from ", o_describe(o), "");
    }
    if via == 2 { message = cat5("this closure writes to a path made from what it captures, ", param, ", and that comes from ", o_describe(o), ""); }
    let t = tr_new();
    tr_reaching(c, ps, pf, t, g, i, 0, 0);
    tr_flow(c, ps, pf, t, k, arg, o, 0);
    tr_publish(c, t, s, e, message, cat4(callee, "'s parameter ", param, " reaches `write_file`'s path"))
}

// The first restricted origin a flow carries in fact `k`, or -1 (`FlowRule::LANGUAGE`).
fn refused_origin(ps: Ps, f: Fl) -> Int { first_origin(band(ps_eval(ps, f).o, o_restricted())) }

// --- the language's flow rule (`solve`, `FlowRule::LANGUAGE`) -------------------------------------

fn zeros(n: Int) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < n {
        ints_push(out, 0);
        i = i + 1;
    }
    out
}

fn ps_new(c: Ck, pf: Pf) -> Ps {
    let n = strs_len(c.fnname);
    let at = ints_new();
    let rcf = ints_new();
    let rcc = ints_new();
    let mut size = 0;
    let mut g = 0;
    while g < n {
        ints_push(at, 0 - 1);
        ints_push(rcf, size);
        let k = ints_get(c.fnpc, g) + captures_of(c, g);
        ints_push(rcc, k);
        size = size + k;
        g = g + 1;
    }
    let mut k = 0;
    while k < ints_len(pf.ffn) {
        ints_set(at, ints_get(pf.ffn, k), k);
        k = k + 1;
    }
    let ar = ints_new();
    g = 0;
    while g < n {
        ints_push(ar, ints_get(c.fnpc, g));
        g = g + 1;
    }
    Ps(at: at, so: zeros(n), sp: zeros(n), ar: ar, reach: zeros(4 * n), rcf: rcf, rcc: rcc, rcv: zeros(size), cn: strs_new(), co: ints_new(), tn: strs_new(),
            tf: ints_new(), tc: ints_new(), tv: ints_new(), vco: zeros(ints_len(pf.ccal)), vcp: zeros(ints_len(pf.ccal)), vio: zeros(strs_len(pf.itg)),
            vip: zeros(strs_len(pf.itg)), icf: ints_new(), icc: ints_new())
}

fn copy_ints(xs: Ints) -> Ints {
    let out = ints_new();
    let mut i = 0;
    while i < ints_len(xs) {
        ints_push(out, ints_get(xs, i));
        i = i + 1;
    }
    out
}

// Provenance (N38, N80): every body's facts, the whole program solved, and `N0372` where a
// function that declares its effects lets a restricted origin reach a path it writes to or hands
// to what writes to one. Where no restricted origin enters the compilation, nothing writes to a
// path, or no function declares its effects, the rule cannot fire and nothing is solved.
fn restricted_flow(c: Ck) -> Int {
    if strs_len(c.stop) > 0 { return 0; }
    // What a foreign function returns is C's, which may be anything: a restricted origin too.
    let n = strs_len(c.fnname);
    let mut foreign = false;
    let mut g = 0;
    while g < n {
        if ints_get(c.fnfor, g) == 1 { foreign = true; }
        g = g + 1;
    }
    if (gs(c, s_source()) == 0 && foreign == false) || gs(c, s_sink()) == 0 { return 0; }
    let mut explicit = false;
    g = 0;
    while g < n {
        if ints_get(c.fneff, g) >= 0 && ints_get(c.fnfor, g) == 0 { explicit = true; }
        // A position is a bit of a mask: past 60 parameters and captures it does not fit.
        if ints_get(c.fnpc, g) + captures_of(c, g) > 60 {
            stop(c, "a function of more than 60 parameters and captures (provenance)");
            return 0;
        }
        g = g + 1;
    }
    if explicit == false { return 0; }
    let pr = prov_solve(c);
    let ps = pr.ps;
    let pf = pr.pf;
    // The language's policy, in functions that declared an effect set: one diagnostic per site,
    // in module and body order.
    let mut k = 0;
    while k < ints_len(pf.ffn) {
        if ints_get(c.fneff, ints_get(pf.ffn, k)) >= 0 { refuse_flows(c, ps, pf, k); }
        k = k + 1;
    }
    ss(c, s_module(), pr.saved);
    0
}

// Every function's provenance solved (`solve`): the facts of every body, the summaries, what
// reaches a sink and what each parameter and capture is handed, to their fixed point. The module
// it leaves the checker in is the one it was in, `saved`.
pub struct Pr {
    ps: Ps,
    pf: Pf,
    saved: Int,
}

fn prov_solve(c: Ck) -> Pr {
    let n = strs_len(c.fnname);
    let mut g = 0;
    let saved = gs(c, s_module());
    let bloc = ints_new();
    let mut b = 0;
    while b < ints_len(c.bfn) {
        ints_push(bloc, 0 - 1);
        b = b + 1;
    }
    let pf = pf_new();
    all_facts(c, pf, bloc);
    let ps = ps_new(c, pf);
    // A foreign function (N42) has no body to reduce: its result is C's, which may be anything —
    // `Unknown`, the worst origin — and may be derived from any argument.
    g = 0;
    while g < n {
        if ints_get(c.fnfor, g) == 1 {
            ints_set(ps.so, g, pow2(3));
            let mut all = 0;
            let mut i = 0;
            while i < ints_get(c.fnpc, g) {
                all = all + pow2(i);
                i = i + 1;
            }
            ints_set(ps.sp, g, all);
        }
        g = g + 1;
    }
    // An export is called by C, with anything (N55): what its parameters are handed is unknown.
    g = 0;
    while g < n {
        if ints_get(c.fnexp, g) == 1 {
            let mut i = 0;
            while i < ints_get(ps.rcc, g) {
                ints_set(ps.rcv, ints_get(ps.rcf, g) + i, bor(ints_get(ps.rcv, ints_get(ps.rcf, g) + i), pow2(3)));
                i = i + 1;
            }
        }
        g = g + 1;
    }
    ps_targets(c, ps, pf);
    // Around everything, the cells and what parameters and captures are handed: each round solves
    // summaries, values and reaches against them, until nothing grows.
    let mut first = true;
    let mut again = true;
    while again {
        let old_cn = strs_new();
        let mut i = 0;
        while i < strs_len(ps.cn) {
            strs_push(old_cn, strs_get(ps.cn, i));
            i = i + 1;
        }
        let old_co = copy_ints(ps.co);
        let old_rcv = copy_ints(ps.rcv);
        ps_settle(ps, pf);
        if first { ps_settle_reach(ps, pf); }
        ps_settle_receives(ps, pf);
        // What each container holds: every value written into its cell.
        let names = strs_new();
        let origins = ints_new();
        let mut k = 0;
        while k < ints_len(pf.ffn) {
            let fg = ints_get(pf.ffn, k);
            let mut x = 0;
            while x < ints_get(pf.foc, k) {
                let si = ints_get(pf.fof, k) + x;
                let o = ps_reaching(ps, fg, vec_get(pf.ofl, si));
                let at = strs_find(names, strs_get(pf.ocl, si));
                if at >= 0 {
                    ints_set(origins, at, bor(ints_get(origins, at), o));
                } else {
                    strs_push(names, strs_get(pf.ocl, si));
                    ints_push(origins, o);
                }
                x = x + 1;
            }
            k = k + 1;
        }
        let mut grown = false;
        i = 0;
        while i < strs_len(old_cn) {
            let at = strs_find(names, strs_get(old_cn, i));
            if at >= 0 {
                ints_set(origins, at, bor(ints_get(origins, at), ints_get(old_co, i)));
            } else {
                strs_push(names, strs_get(old_cn, i));
                ints_push(origins, ints_get(old_co, i));
            }
            i = i + 1;
        }
        i = 0;
        while i < strs_len(names) {
            let at = strs_find(old_cn, strs_get(names, i));
            if at < 0 {
                grown = true;
            } else {
                if ints_get(old_co, at) != ints_get(origins, i) { grown = true; }
            }
            i = i + 1;
        }
        let captures_grew = ints_same(old_rcv, ps.rcv) == false;
        while strs_len(ps.cn) > 0 {
            strs_pop(ps.cn);
            ints_pop(ps.co);
        }
        i = 0;
        while i < strs_len(names) {
            strs_push(ps.cn, strs_get(names, i));
            ints_push(ps.co, ints_get(origins, i));
            i = i + 1;
        }
        again = grown || captures_grew;
        first = false;
    }
    Pr(ps: ps, pf: pf, saved: saved)
}

// One function's refusals, by where each is.
fn refuse_flows(c: Ck, ps: Ps, pf: Pf, k: Int) -> Int {
    let fs_ = ints_new();
    let fe = ints_new();
    let fkind = ints_new();
    let fa = ints_new();
    let fi = ints_new();
    let fo = ints_new();
    let fflow = vec_new[Fl]();
    let mut x = 0;
    while x < ints_get(pf.fsc, k) {
        let si = ints_get(pf.fsf, k) + x;
        if ints_get(pf.kcl, si) == 0 {
            let o = refused_origin(ps, vec_get(pf.kfl, si));
            if o >= 0 {
                ints_push(fs_, ints_get(pf.kss, si));
                ints_push(fe, ints_get(pf.kse, si));
                ints_push(fkind, 0 - 1);
                ints_push(fa, si);
                ints_push(fi, 0);
                ints_push(fo, o);
                vec_push(fflow, fl_new());
            }
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fcc, k) {
        let cx = ints_get(pf.fcf, k) + x;
        let callee = ints_get(pf.ccal, cx);
        let rs = bits_of(ps_reach(ps, callee, 0));
        let mut j = 0;
        while j < ints_len(rs) {
            let i = ints_get(rs, j);
            if i < ints_get(pf.cac, cx) {
                let a = vec_get(pf.args, ints_get(pf.caf, cx) + i);
                let o = refused_origin(ps, a);
                if o >= 0 {
                    ints_push(fs_, ints_get(pf.cs, cx));
                    ints_push(fe, ints_get(pf.ce, cx));
                    ints_push(fkind, 0);
                    ints_push(fa, callee);
                    ints_push(fi, i);
                    ints_push(fo, o);
                    vec_push(fflow, a);
                    j = ints_len(rs);
                }
            }
            j = j + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fic, k) {
        let ix = ints_get(pf.fif, k) + x;
        let mut done = false;
        let mut q = 0;
        while q < ints_get(ps.icc, ix) && done == false {
            let h = ints_get(ps.tv, ints_get(ps.icf, ix) + q);
            let rs = bits_of(ps_reach(ps, h, 0));
            let mut j = 0;
            while j < ints_len(rs) && done == false {
                let i = ints_get(rs, j);
                if i < ints_get(ps.ar, h) && i < ints_get(pf.iac, ix) {
                    let a = vec_get(pf.args, ints_get(pf.iaf, ix) + i);
                    let o = refused_origin(ps, a);
                    if o >= 0 {
                        ints_push(fs_, ints_get(pf.iss, ix));
                        ints_push(fe, ints_get(pf.ise, ix));
                        ints_push(fkind, 1);
                        ints_push(fa, h);
                        ints_push(fi, i);
                        ints_push(fo, o);
                        vec_push(fflow, a);
                        done = true;
                    }
                }
                j = j + 1;
            }
            q = q + 1;
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_get(pf.fmc, k) {
        let mx = ints_get(pf.fmf, k) + x;
        let h = ints_get(pf.mfn, mx);
        let base = ints_get(ps.ar, h);
        let rs = bits_of(ps_reach(ps, h, 0));
        let mut j = 0;
        while j < ints_len(rs) {
            let i = ints_get(rs, j);
            let q = i - base;
            if q >= 0 && q < ints_get(pf.mcc, mx) {
                let a = vec_get(pf.args, ints_get(pf.mcf, mx) + q);
                let o = refused_origin(ps, a);
                if o >= 0 {
                    ints_push(fs_, ints_get(pf.mss, mx));
                    ints_push(fe, ints_get(pf.mse, mx));
                    ints_push(fkind, 2);
                    ints_push(fa, h);
                    ints_push(fi, i);
                    ints_push(fo, o);
                    vec_push(fflow, a);
                    j = ints_len(rs);
                }
            }
            j = j + 1;
        }
        x = x + 1;
    }
    // Sorted by where each is, stably.
    let order = ints_new();
    let mut i = 0;
    while i < ints_len(fs_) {
        let mut at = ints_len(order);
        while at > 0 && (ints_get(fs_, ints_get(order, at - 1)) > ints_get(fs_, i)
                || (ints_get(fs_, ints_get(order, at - 1)) == ints_get(fs_, i) && ints_get(fe, ints_get(order, at - 1)) > ints_get(fe, i))) {
            at = at - 1;
        }
        ints_push(order, 0);
        let mut j = ints_len(order) - 1;
        while j > at {
            ints_set(order, j, ints_get(order, j - 1));
            j = j - 1;
        }
        ints_set(order, at, i);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(order) {
        let d = ints_get(order, i);
        if ints_get(fkind, d) < 0 {
            tr_direct(c, ps, pf, k, ints_get(fa, d), ints_get(fo, d));
        } else {
            tr_through(c, ps, pf, k, ints_get(fa, d), ints_get(fs_, d), ints_get(fe, d), ints_get(fi, d), vec_get(fflow, d), ints_get(fo, d), ints_get(fkind, d));
        }
        i = i + 1;
    }
    0
}

// --- the checker's facts, for tools (`nazm doc`; R5 design D10) ------------------------------
//
// What a tool reads of a checked compilation, as the reference's `Resolution` holds it. Every
// answer is meaningful only where the checker carried the whole compilation (`ck_stopped` is
// ""); `compiler/facts.nz` is the interface a tool uses, and adds what the loader knows.
// Functions, records, enums and traits are numbered as the checker numbers them, in declaration
// order, module by module in load order; a span is a tree node's, local to its module's text.

pub fn ck_tree(c: Ck) -> Tree { c.t }

pub fn ck_fn_count(c: Ck) -> Int { strs_len(c.fnname) }
// Its name — an impl's method is `Trait/Type/m`, a closure its maker's own.
pub fn ck_fn_name(c: Ck, i: Int) -> Str { strs_get(c.fnname, i) }
pub fn ck_fn_module(c: Ck, i: Int) -> Int { ints_get(c.fnmod, i) }
// Its declaration's node (`Function`; a closure's, the closure expression).
pub fn ck_fn_node(c: Ck, i: Int) -> Int { ints_get(c.fnnode, i) }
pub fn ck_fn_closure(c: Ck, i: Int) -> Bool { ints_get(c.fnclos, i) >= 0 }
pub fn ck_fn_method(c: Ck, i: Int) -> Bool { ints_get(c.fnmeth, i) == 1 }
// Whether it is exported (`Visibility::Exported`): `pub`, and no impl's method.
pub fn ck_fn_public(c: Ck, i: Int) -> Bool { ints_get(c.fnpub, i) == 1 }
pub fn ck_fn_generic(c: Ck, i: Int) -> Bool { ints_get(c.fntpc, i) > 0 }

// Its parameters' types and its result's, each as `Types::show` writes it.
pub fn ck_fn_params(c: Ck, i: Int) -> Strs {
    let out = strs_new();
    let mut k = 0;
    while k < ints_get(c.fnpc, i) {
        strs_push(out, show(c, ints_get(c.ptys, ints_get(c.fnpf, i) + k)));
        k = k + 1;
    }
    out
}
pub fn ck_fn_ret(c: Ck, i: Int) -> Str { show(c, ints_get(c.fnret, i)) }

// The capabilities it takes: each parameter of a capability type, shown, in order.
pub fn ck_fn_capabilities(c: Ck, i: Int) -> Strs {
    let out = strs_new();
    let mut k = 0;
    while k < ints_get(c.fnpc, i) {
        let t = ints_get(c.ptys, ints_get(c.fnpf, i) + k);
        if is_cap(c, t) { strs_push(out, show(c, t)); }
        k = k + 1;
    }
    out
}

// Its declared effect set and what its body requires (`declared_effects`, `inferred_effects`), as
// masks — `io` 1, `spawn` 2, `foreign` 4, the effect parameter 8 — or -1 for none: none written,
// or no body checked. A foreign function declares and requires `foreign`.
pub fn ck_fn_declared(c: Ck, i: Int) -> Int {
    if ints_get(c.fnfor, i) == 1 { return 4; }
    ints_get(c.fneff, i)
}
pub fn ck_fn_required(c: Ck, i: Int) -> Int {
    if i >= ints_len(c.fnreq) { return 0 - 1; }
    ints_get(c.fnreq, i)
}

// What a caller in another module must assume of function `i` (`declared_effects`, else `assumed`): its declared set,
// or, where it declares none, every effect the compatibility bridge covers — `foreign` too where one of its
// parameters can carry a `ForeignCap` — as a mask.
pub fn ck_fn_published(c: Ck, i: Int) -> Int {
    let d = ck_fn_declared(c, i);
    if d >= 0 { return d; }
    if receives_foreign(c, i) { return 7; }
    3
}

// Why function `i` requires each effect it does (`effect_reasons`): the first thing in its body that requires it,
// in effect order. `ck_reasons(c, i)` are the reasons' numbers; each has the effect's id
// (`ck_reason_effect`), where it is (`ck_reason_start`, `ck_reason_end`, over the whole compilation's text), what
// it is (`ck_reason_source`: `builtin`, `spawn`, `inferred`, `declared`, `undeclared` or `indirect`) and, for the
// first of these, the built-in's name (`ck_reason_builtin`), for the next three the callee's number
// (`ck_reason_callee`, -1 for none).
pub fn ck_reasons(c: Ck, i: Int) -> Ints {
    let out = ints_new();
    let rs = c.fnrs;
    let mut r = 0;
    while r < ints_len(rs.fnid) {
        if ints_get(rs.fnid, r) == i {
            // Kept in effect order (the reference lists them so), recorded order within an effect.
            let mut at = ints_len(out);
            while at > 0 && ints_get(rs.effect, ints_get(out, at - 1)) > ints_get(rs.effect, r) { at = at - 1; }
            ints_push(out, 0);
            let mut k = ints_len(out) - 1;
            while k > at {
                ints_set(out, k, ints_get(out, k - 1));
                k = k - 1;
            }
            ints_set(out, at, r);
        }
        r = r + 1;
    }
    out
}
pub fn ck_reason_effect(c: Ck, r: Int) -> Int { ints_get(c.fnrs.effect, r) }
pub fn ck_reason_start(c: Ck, r: Int) -> Int { ints_get(c.fnrs.start, r) }
pub fn ck_reason_end(c: Ck, r: Int) -> Int { ints_get(c.fnrs.end, r) }
pub fn ck_reason_source(c: Ck, r: Int) -> Str {
    let s = ints_get(c.fnrs.source, r);
    if s == 1 { return "builtin"; }
    if s == 2 { return "declared"; }
    if s == 3 { return "inferred"; }
    if s == 4 { return "undeclared"; }
    if s == 5 { return "indirect"; }
    "spawn"
}
pub fn ck_reason_builtin(c: Ck, r: Int) -> Str {
    if ints_get(c.fnrs.source, r) != 1 { return ""; }
    strs_get(c.bname, ints_get(c.fnrs.which, r))
}
// The function type a call through a value has, as `Types::show` writes it, for an `indirect` reason; "" for any other.
pub fn ck_reason_type(c: Ck, r: Int) -> Str {
    if ints_get(c.fnrs.source, r) != 5 { return ""; }
    show(c, ints_get(c.fnrs.which, r))
}
pub fn ck_reason_callee(c: Ck, r: Int) -> Int {
    let s = ints_get(c.fnrs.source, r);
    if s == 2 || s == 3 || s == 4 { return ints_get(c.fnrs.which, r); }
    0 - 1
}

// A mask's effects by name, in id order, as `EffectSet::names` lists them: `io`, `spawn`,
// `foreign`, and the effect parameter as `*`.
pub fn ck_effect_names(mask: Int) -> Strs {
    let out = strs_new();
    let mut e = 0;
    while e < 4 {
        if has_bit(mask, e) { strs_push(out, effect_text(e, "*")); }
        e = e + 1;
    }
    out
}

// The C symbol a foreign declaration names (N42), and the one an export is callable as (N55); ""
// for none.
pub fn ck_fn_foreign(c: Ck, i: Int) -> Str {
    if ints_get(c.fnfor, i) == 0 { return ""; }
    fname_of(c, unwrap(c, ints_get(c.fnnode, i), "foreign"), "symbol")
}
pub fn ck_fn_export(c: Ck, i: Int) -> Str {
    if ints_get(c.fnexp, i) == 0 { return ""; }
    fname_of(c, unwrap(c, ints_get(c.fnnode, i), "export"), "symbol")
}

pub fn ck_record_count(c: Ck) -> Int { strs_len(c.rname) }
pub fn ck_record_name(c: Ck, r: Int) -> Str { strs_get(c.rname, r) }
pub fn ck_record_module(c: Ck, r: Int) -> Int { ints_get(c.rmod, r) }
pub fn ck_record_public(c: Ck, r: Int) -> Bool { ints_get(c.rpub, r) == 1 }
pub fn ck_enum_count(c: Ck) -> Int { strs_len(c.ename) }
pub fn ck_enum_name(c: Ck, e: Int) -> Str { strs_get(c.ename, e) }
pub fn ck_enum_module(c: Ck, e: Int) -> Int { ints_get(c.emod, e) }
pub fn ck_enum_public(c: Ck, e: Int) -> Bool { ints_get(c.epub, e) == 1 }
pub fn ck_trait_count(c: Ck) -> Int { strs_len(c.trname) }
pub fn ck_trait_name(c: Ck, t: Int) -> Str { strs_get(c.trname, t) }
pub fn ck_trait_module(c: Ck, t: Int) -> Int { ints_get(c.trmod, t) }

// A record's and an enum's declaration (`Record`, `Enum`): the one in module `m` named `name`
// that the checker declared, or -1 — a duplicate it refused is not one.
pub fn ck_record_node(c: Ck, r: Int) -> Int { type_node(c, ints_get(c.rmod, r), "records", ints_get(c.rns, r)) }
pub fn ck_enum_node(c: Ck, e: Int) -> Int { type_node(c, ints_get(c.emod, e), "enums", ints_get(c.ens, e)) }

fn type_node(c: Ck, m: Int, list: Str, at: Int) -> Int {
    let decls = kids(c, ints_get(c.mprog, m), list);
    let mut k = 0;
    while k < ints_len(decls) {
        let d = ints_get(decls, k);
        if sx_s(c.t, fld(c, d, "name_span")) + ints_get(c.mbase, m) == at { return d; }
        k = k + 1;
    }
    0 - 1
}

// What the chosen names of every `pub use` resolve to (N103), in the order they were applied:
// the module re-exporting, the name's span (absolute), the kind — 1 a function, 2 a record or an
// enum, 3 a trait — and which: a function, a type (`ck_type_record`, `ck_type_enum`) or a trait.
pub fn ck_reexport_count(c: Ck) -> Int { ints_len(c.rx.xm) }
pub fn ck_reexport_module(c: Ck, i: Int) -> Int { ints_get(c.rx.xm, i) }
pub fn ck_reexport_start(c: Ck, i: Int) -> Int { ints_get(c.rx.xs, i) }
pub fn ck_reexport_end(c: Ck, i: Int) -> Int { ints_get(c.rx.xe, i) }
pub fn ck_reexport_kind(c: Ck, i: Int) -> Int { ints_get(c.rx.xk, i) }
pub fn ck_reexport_target(c: Ck, i: Int) -> Int { ints_get(c.rx.xid, i) }

// A record or enum type's definition: its record, or -1; its enum, or -1.
pub fn ck_type_record(c: Ck, t: Int) -> Int {
    if is_record(c, t) { return ta(c, t); }
    0 - 1
}
pub fn ck_type_enum(c: Ck, t: Int) -> Int {
    if is_enum(c, t) { return ta(c, t); }
    0 - 1
}

// A checker that has checked nothing: what a tool holds where the loader stopped first.
pub fn ck_none(t: Tree) -> Ck {
    let c = new_ck(t);
    stop(c, "nothing, as nothing was loaded");
    c
}

// --- what Core IR reads of the checker (slice 5; design D25) ----------------------------------

pub fn ck_t_int() -> Int { t_int() }
pub fn ck_t_bool() -> Int { t_bool() }
pub fn ck_t_str() -> Int { t_str() }
// The built-in type of this name (`UInt8`, …).
pub fn ck_t_named(c: Ck, name: Str) -> Int { builtin_ty(c, name) }
// What a `for` loop iterates, as the reference's lowering reads it: `bytes`, `vec`, `chain`,
// `ints` or `strs`, or "" for anything else; and a holder's element.
pub fn ck_seq_kind(c: Ck, t: Int) -> Str {
    if t < 0 { return ""; }
    if tag(c, t) == tag_vec() { return "vec"; }
    if tag(c, t) == tag_chain() { return "chain"; }
    if tag(c, t) == tag_builtin() {
        let n = bname_of(c, t);
        if n == "Bytes" { return "bytes"; }
        if n == "Ints" { return "ints"; }
        if n == "Strs" { return "strs"; }
    }
    ""
}
pub fn ck_type_arg(c: Ck, t: Int, i: Int) -> Int { targ(c, t, i) }
pub fn ck_type_arg_count(c: Ck, t: Int) -> Int { targc(c, t) }
// A call site through a trait's method (`stm`, an index into the pool of methods), or -1; the
// trait a method of the pool belongs to, and where that trait's methods start in the pool.
pub fn ck_site_trait_method(c: Ck, site: Int) -> Int { ints_get(c.stm, site) }
pub fn ck_method_trait(c: Ck, tm: Int) -> Int { method_trait(c, tm) }
pub fn ck_trait_method_first(c: Ck, tr: Int) -> Int { ints_get(c.trmf, tr) }
// The constant a name written at `s..e` (absolute) is, or -1: its kind's type, and its value —
// `ck_const_int` for an `Int` or a `Bool` (1 for `true`), `ck_const_text` for any other number
// or a `Str` ("" for a float); an `Atomic`'s is a cell.
pub fn ck_const_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mconst, s, e) }
pub fn ck_const_ty(c: Ck, u: Int) -> Int { kind_type(c, ints_get(c.uk, u)) }
pub fn ck_const_cell(c: Ck, u: Int) -> Bool { ints_get(c.uk, u) == k_atomic() }
pub fn ck_const_agg(c: Ck, u: Int) -> Bool { k_is_agg(ints_get(c.uk, u)) }
pub fn ck_const_int(c: Ck, u: Int) -> Int { ints_get(c.ui, u) }
pub fn ck_const_text(c: Ck, u: Int) -> Str { strs_get(c.us, u) }
// The type of a constant's kind (a number's, `Bool`, `Str`, or an aggregate's).
pub fn ck_kind_type(c: Ck, k: Int) -> Int { kind_type(c, k) }
// The conversion whose callee is written at `s..e` (absolute), or -1: the type converted to, its
// mode (`exact`, `try`, `wrap`, `saturate`) and what the call produces.
pub fn ck_conv_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mconv, s, e) }
pub fn ck_conv_to(c: Ck, k: Int) -> Int { ints_get(c.cvto, k) }
pub fn ck_conv_mode(c: Ck, k: Int) -> Str { strs_get(c.cvmode, k) }
pub fn ck_conv_result(c: Ck, k: Int) -> Int { ints_get(c.cvres, k) }
// Whether a type is a tuple, and the type of payload field `i` of variant `v` of an enum type,
// its arguments substituted.
pub fn ck_is_tuple(c: Ck, t: Int) -> Bool { is_tuple(c, t) }
// The tuple of these element types (which the checker made when it checked it), and an array
// type's element.
pub fn ck_tuple_of(c: Ck, elems: Ints) -> Int { tuple_ty(c, elems) }
pub fn ck_array_elem(c: Ck, t: Int) -> Int { array_elem(c, t) }
// An array type's length.
pub fn ck_array_len(c: Ck, t: Int) -> Int { ints_get(c.tya, t) }
// The type the list or array literal, or `[v; n]`, written at `s..e` (absolute) was made as, or -1.
pub fn ck_array_literal_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.marr, s, e) }
pub fn ck_payload_ty(c: Ck, t: Int, v: Int, i: Int) -> Int { field_ty_in(c, t, ints_get(c.vff, ints_get(c.evf, ta(c, t)) + v) + i) }
// What a type is to the lowering's operators: `int` (`Int`), `integer` (another integer type),
// `float`, `bool`, `str`, `text`, `record`, `enum`, `array`, `box`, `chain`, `param`, or "".
pub fn ck_type_class(c: Ck, t: Int) -> Str {
    if t < 0 { return ""; }
    if t == t_int() { return "int"; }
    if t == t_bool() { return "bool"; }
    if t == t_str() { return "str"; }
    let g = tag(c, t);
    if g == tag_builtin() {
        if is_integer(c, t) { return "integer"; }
        if is_num(c, t) { return "float"; }
        if bname_of(c, t) == "Text" { return "text"; }
        return "";
    }
    if g == tag_record() { return "record"; }
    if g == tag_enum() { return "enum"; }
    if g == tag_array() { return "array"; }
    if g == tag_box() { return "box"; }
    if g == tag_chain() { return "chain"; }
    if g == tag_param() { return "param"; }
    ""
}

// The binding the name written at `s..e` (absolute) is, or -1.
pub fn ck_binding_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mvar, s, e) }
// Whether the mention at `s..e` is of a capture the checker refused (`N0386`): of a slot of the closure that nothing declares.
// --- signature help (`Signature::of_call` and `render`) ---------------------------------------------------

// The declared signature of the checked call at `site`, as `Signature::render` spells it with the call's instantiation: the label, then the start and end (bytes in the
// label) of each parameter. Empty where the site is none the reference describes.
pub fn ck_site_label(c: Ck, site: Int) -> Strs {
    let out = strs_new();
    let f = ints_get(c.suser, site);
    let bi = ints_get(c.sbuiltin, site);
    let ind = ints_get(c.sind, site);
    let mut name = "";
    let mut foreign = "";
    let mut owner = 0 - 1;
    let mut oid = 0 - 1;
    let tpn = strs_new();
    let tpe = ints_new();
    let ptys = ints_new();
    let pnames = strs_new();
    let mut ret = 0;
    let mut eff = 0 - 1;
    if f >= 0 {
        name = strs_get(c.fnname, f);
        foreign = ck_fn_foreign(c, f);
        owner = own_fn();
        oid = f;
        let mut k = 0;
        while k < ints_get(c.fntpc, f) {
            strs_push(tpn, strs_get(c.tpname, ints_get(c.fntpf, f) + k));
            ints_push(tpe, ints_get(c.tpeq, ints_get(c.fntpf, f) + k));
            k = k + 1;
        }
        let params = kids(c, ints_get(c.fnnode, f), "params");
        let implicit = ints_get(c.fnpc, f) - ints_len(params);
        k = 0;
        while k < ints_get(c.fnpc, f) {
            ints_push(ptys, ints_get(c.ptys, ints_get(c.fnpf, f) + k));
            if k < implicit { strs_push(pnames, "out"); } else { strs_push(pnames, fname_of(c, ints_get(params, k - implicit), "name")); }
            k = k + 1;
        }
        ret = ints_get(c.fnret, f);
        eff = ints_get(c.fneff, f);
    } else {
        if bi >= 0 {
            name = strs_get(c.bname, bi);
            owner = own_builtin();
            oid = bi;
            if ints_get(c.bgen, bi) > 0 {
                strs_push(tpn, "T");
                ints_push(tpe, 0);
                let tp = param_ty(c, own_builtin(), bi, 0, "T");
                let shapes = split(strs_get(c.bshapes, bi), 44);
                let mut k = 0;
                while k < strs_len(shapes) {
                    if strs_get(shapes, k) != "" { ints_push(ptys, shape_of(c, strs_get(shapes, k), tp)); strs_push(pnames, ""); }
                    k = k + 1;
                }
                ret = shape_of(c, strs_get(c.bretshape, bi), tp);
            } else {
                let mut k = 0;
                while k < ints_get(c.bpc, bi) {
                    ints_push(ptys, ints_get(c.ptys, ints_get(c.bpf, bi) + k));
                    strs_push(pnames, "");
                    k = k + 1;
                }
                ret = ints_get(c.bret, bi);
            }
            let e = builtin_effect(c, bi);
            if e >= 0 { eff = with_bit(0, e); }
        } else {
            if ind < 0 { return out; }
            name = show(c, ind);
            let mut k = 0;
            while k + 1 < targc(c, ind) {
                ints_push(ptys, targ(c, ind, k));
                strs_push(pnames, "");
                k = k + 1;
            }
            ret = fn_ret(c, ind);
            eff = ta(c, ind);
        }
    }
    // What the call settled, where it is generic.
    let first = ints_get(c.sipf, site);
    let n = strs_len(tpn);
    let mut args = ints_new();
    let mut poly = false;
    if first >= 0 {
        let mut k = 0;
        while k < n {
            let t = ints_get(c.sip, first + k);
            if t >= 0 { ints_push(args, t); } else { ints_push(args, param_ty(c, owner, oid, k, strs_get(tpn, k))); }
            k = k + 1;
        }
        poly = ints_get(c.sip, first + n) == 1;
    }
    let mut text = "fn ";
    if foreign != "" { text = "extern \"C\" fn "; }
    text = str_concat(text, name);
    if n > 0 {
        let shown = strs_new();
        let mut k = 0;
        while k < n {
            let t = if first >= 0 { ints_get(c.sip, first + k) } else { 0 - 1 };
            if t >= 0 { strs_push(shown, show(c, t)); } else {
                if ints_get(tpe, k) == 1 { strs_push(shown, cat3(strs_get(tpn, k), ": ", "Equality")); } else { strs_push(shown, strs_get(tpn, k)); }
            }
            k = k + 1;
        }
        text = cat3(text, "[", str_concat(str_join(shown, ", "), "]"));
    }
    let marks = strs_new();
    text = str_concat(text, "(");
    let mut k = 0;
    while k < ints_len(ptys) {
        if k > 0 { text = str_concat(text, ", "); }
        let st = str_len(text);
        if strs_get(pnames, k) != "" { text = cat3(text, strs_get(pnames, k), ": "); }
        let mut ty = ints_get(ptys, k);
        if first >= 0 && owner >= 0 {
            let r = subst_found(c, ty, owner, oid, args, ints_get(c.sip, first + n + 1));
            if r >= 0 { ty = r; }
        }
        text = str_concat(text, show(c, ty));
        strs_push(marks, int_to_str(st));
        strs_push(marks, int_to_str(str_len(text)));
        k = k + 1;
    }
    text = str_concat(text, ") -> ");
    let mut rt = ret;
    if first >= 0 && owner >= 0 {
        if poly { rt = ints_get(c.sret, site); } else {
            let r = subst_found(c, ret, owner, oid, args, ints_get(c.sip, first + n + 1));
            if r >= 0 { rt = r; }
        }
    }
    text = str_concat(text, show(c, rt));
    if foreign != "" {
        text = cat3(text, " = \"", str_concat(foreign, "\""));
    } else {
        if eff >= 0 {
            let names = ck_effect_names(eff);
            if strs_len(names) == 0 { text = str_concat(text, " ! {}"); } else { text = cat3(text, " ! { ", str_concat(str_join(names, ", "), " }")); }
        }
    }
    strs_push(out, text);
    k = 0;
    while k < strs_len(marks) {
        strs_push(out, strs_get(marks, k));
        k = k + 1;
    }
    out
}

// What the type name written at `s..e` is: 1 a built-in type, 2 a type parameter used, 3 one declared, or 0 (`Resolution::written_type`).
pub fn ck_written_type_at(c: Ck, s: Int, e: Int) -> Int { let k = sm_get(c.mwty, s, e); if k < 0 { return 0; } k }
pub fn ck_refused_capture_at(c: Ck, s: Int, e: Int) -> Bool { sm_get(c.mrefu, s, e) >= 0 }
pub fn ck_binding_count(c: Ck) -> Int { ints_len(c.bfn) }
pub fn ck_binding_fn(c: Ck, b: Int) -> Int { ints_get(c.bfn, b) }
pub fn ck_binding_ty(c: Ck, b: Int) -> Int { ints_get(c.bty, b) }
pub fn ck_binding_name(c: Ck, b: Int) -> Str { strs_get(c.bnm, b) }
pub fn ck_binding_mutable(c: Ck, b: Int) -> Bool { ints_get(c.bmut, b) == 1 }
// Whether a closure shares it (R1b, L10): Core IR keeps it in a cell.
pub fn ck_binding_shared(c: Ck, b: Int) -> Bool { ints_get(c.bshr, b) == 1 }
// The captures every closure made, in the order made (N50): the closure, the binding it
// captured (the one declared, through every closure between) and how many bindings there were
// when its copy was made.
pub fn ck_capture_count(c: Ck) -> Int { ints_len(c.capcl) }
pub fn ck_capture_closure(c: Ck, k: Int) -> Int { ints_get(c.capcl, k) }
pub fn ck_capture_binding(c: Ck, k: Int) -> Int { ints_get(c.capbd, k) }
pub fn ck_capture_at(c: Ck, k: Int) -> Int { ints_get(c.capat, k) }
// Function `i`'s bindings, in the order made, and the captures it made (indices into the
// capture tables), in order: what Core IR reads of a function without walking every binding.
pub fn ck_fn_binding_count(c: Ck, i: Int) -> Int {
    index_bindings(c);
    ints_get(c.fbc, i)
}
pub fn ck_fn_binding(c: Ck, i: Int, k: Int) -> Int { ints_get(c.fbl, ints_get(c.fbf, i) + k) }
pub fn ck_fn_capture_count(c: Ck, i: Int) -> Int {
    index_bindings(c);
    ints_get(c.fcc, i)
}
pub fn ck_fn_capture(c: Ck, i: Int, k: Int) -> Int { ints_get(c.fcl, ints_get(c.fcf, i) + k) }

fn index_bindings(c: Ck) -> Int {
    if ints_len(c.fbf) > 0 { return 0; }
    group_by(c.bfn, strs_len(c.fnname), c.fbf, c.fbc, c.fbl);
    group_by(c.capcl, strs_len(c.fnname), c.fcf, c.fcc, c.fcl);
    0
}

// The indices of `owner` grouped by their value (0 to `n` - 1), each group in index order.
fn group_by(owner: Ints, n: Int, first: Ints, count: Ints, list: Ints) -> Int {
    let mut i = 0;
    while i < n {
        ints_push(count, 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(owner) {
        let o = ints_get(owner, i);
        if o >= 0 && o < n { ints_set(count, o, ints_get(count, o) + 1); }
        i = i + 1;
    }
    let fill = ints_new();
    let mut at = 0;
    i = 0;
    while i < n {
        ints_push(first, at);
        ints_push(fill, at);
        at = at + ints_get(count, i);
        i = i + 1;
    }
    i = 0;
    while i < at {
        ints_push(list, 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(owner) {
        let o = ints_get(owner, i);
        if o >= 0 && o < n {
            ints_set(list, ints_get(fill, o), i);
            ints_set(fill, o, ints_get(fill, o) + 1);
        }
        i = i + 1;
    }
    0
}

// The `Cell` a binding a closure shares is kept in (R1b, L10).
pub fn ck_cell_of(c: Ck, t: Int) -> Int { holder_of(c, tag_cell(), t) }
// The record or enum type the type name written at `s..e` (absolute) resolved to, or -1.
pub fn ck_type_name_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mtyn, s, e) }

// The zero literal a compound update's read of a map at the brackets `s..e` (absolute) passes,
// or -1.
pub fn ck_zero_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mzero, s, e) }

// The named function used as a value at `s..e` (absolute), or -1; and the type it was given.
pub fn ck_fn_value_at(c: Ck, s: Int, e: Int) -> Int {
    let mut v = ints_len(c.vfn) - 1;
    while v >= 0 {
        if ints_get(c.vstart, v) == s && ints_get(c.vend, v) == e { return v; }
        v = v - 1;
    }
    0 - 1
}
pub fn ck_fn_value_fn(c: Ck, v: Int) -> Int { ints_get(c.vfn, v) }
pub fn ck_fn_value_ty(c: Ck, v: Int) -> Int { ints_get(c.vty, v) }
// What a call through a value of function type `t` gives.
pub fn ck_fn_type_ret(c: Ck, t: Int) -> Int { fn_ret(c, t) }

// How a foreign function's parameter of type `t` crosses (`foreign_param`, N85): `scalar`,
// `cstring`, `handle`, `struct`, `callback`, or "" where it cannot.
pub fn ck_cross_in(c: Ck, t: Int) -> Str {
    if t == t_int() || t == t_bool() { return "scalar"; }
    if t == t_str() { return "cstring"; }
    if t >= 0 && is_record(c, t) {
        if ints_get(c.rrepr, ta(c, t)) == 1 { return "handle"; }
        if ints_get(c.rrepr, ta(c, t)) != 0 { return "struct"; }
        return "";
    }
    if t >= 0 && is_fn(c, t) && foreign_param_ok(c, t) { return "callback"; }
    ""
}
// How a foreign result of type `t` crosses back (`foreign_result`): `scalar`, `cstring`,
// `handle`, `cstring?` or `handle?` (an `Option` of either, null being `None`), or "".
pub fn ck_cross_out(c: Ck, t: Int) -> Str {
    if t == t_int() || t == t_bool() { return "scalar"; }
    if t == t_str() { return "cstring"; }
    if t < 0 { return ""; }
    if is_record(c, t) {
        if is_opaque(c, t) { return "handle"; }
        return "";
    }
    if prelude_enum(c, t, "Option") && targc(c, t) == 1 {
        let inner = targ(c, t, 0);
        if inner == t_str() { return "cstring?"; }
        if is_opaque(c, inner) { return "handle?"; }
    }
    ""
}

// The binding `result` is in function `i`'s `ensures` clauses, or -1.
pub fn ck_fn_result_binding(c: Ck, i: Int) -> Int {
    let mut k = 0;
    while k < ints_len(c.crfn) {
        if ints_get(c.crfn, k) == i { return ints_get(c.crb, k); }
        k = k + 1;
    }
    0 - 1
}

// The type closure `i` was given, or -1.
pub fn ck_closure_ty(c: Ck, i: Int) -> Int {
    let mut k = 0;
    while k < ints_len(c.clid) {
        if ints_get(c.clid, k) == i { return ints_get(c.clty, k); }
        k = k + 1;
    }
    0 - 1
}
// The closure the expression written at `s..e` (absolute) makes, or -1.
pub fn ck_closure_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mclo, s, e) }
// The function a closure is written in, or -1 for a declared function.
pub fn ck_fn_enclosing(c: Ck, i: Int) -> Int { ints_get(c.fnclos, i) }
// Where it is declared (absolute), or -1.
pub fn ck_binding_start(c: Ck, b: Int) -> Int { ints_get(c.bds, b) }
pub fn ck_binding_end(c: Ck, b: Int) -> Int { ints_get(c.bde, b) }

// The type the literal at `s..e` (absolute) was checked as, or -1.
pub fn ck_literal_ty(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mlit, s, e) }

// The call site whose callee is written at `s..e` (absolute), or -1; what it reached: one of the
// compilation's functions, a built-in, or a value of function type (each -1 where not).
pub fn ck_site_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.msite, s, e) }
pub fn ck_site_fn(c: Ck, site: Int) -> Int { ints_get(c.suser, site) }
pub fn ck_site_builtin(c: Ck, site: Int) -> Int { ints_get(c.sbuiltin, site) }
pub fn ck_site_indirect(c: Ck, site: Int) -> Int { ints_get(c.sind, site) }

pub fn ck_builtin_name(c: Ck, b: Int) -> Str { strs_get(c.bname, b) }
pub fn ck_builtin_generic(c: Ck, b: Int) -> Bool { ints_get(c.bgen, b) > 0 }
// Its result type, where it is not generic.
pub fn ck_builtin_ret(c: Ck, b: Int) -> Int { ints_get(c.bret, b) }
// A generic call's type arguments as the checker settled them, and the result type it formed;
// -1 for a call that is not generic.
pub fn ck_site_type_arg_count(c: Ck, site: Int) -> Int { ints_get(c.sargc, site) }
pub fn ck_site_type_arg(c: Ck, site: Int, k: Int) -> Int { ints_get(c.sargs, ints_get(c.sargf, site) + k) }
pub fn ck_site_ret(c: Ck, site: Int) -> Int { ints_get(c.sret, site) }

pub fn ck_fn_param_count(c: Ck, i: Int) -> Int { ints_get(c.fnpc, i) }
pub fn ck_fn_param_ty(c: Ck, i: Int, k: Int) -> Int { ints_get(c.ptys, ints_get(c.fnpf, i) + k) }
pub fn ck_fn_ret_ty(c: Ck, i: Int) -> Int { ints_get(c.fnret, i) }
pub fn ck_fn_type_params(c: Ck, i: Int) -> Int { ints_get(c.fntpc, i) }
pub fn ck_fn_type_param_name(c: Ck, i: Int, k: Int) -> Str { strs_get(c.tpname, ints_get(c.fntpf, i) + k) }
pub fn ck_fn_type_param_equality(c: Ck, i: Int, k: Int) -> Bool { ints_get(c.tpeq, ints_get(c.fntpf, i) + k) == 1 }
pub fn ck_fn_effect_param(c: Ck, i: Int) -> Bool { ints_len(kids(c, ints_get(c.fnnode, i), "effect_params")) > 0 }
pub fn ck_fn_is_foreign(c: Ck, i: Int) -> Bool { ints_get(c.fnfor, i) == 1 }

pub fn ck_is_cap(c: Ck, t: Int) -> Bool { is_cap(c, t) }
// A capability's place in `CapabilityKind::ALL`, which is the order an authority set lists them.
pub fn ck_cap_order(c: Ck, t: Int) -> Int { cap_bit(bname_of(c, t)) }
pub fn ck_is_builtin(c: Ck, t: Int, name: Str) -> Bool { t >= 0 && tag(c, t) == tag_builtin() && strs_get(c.tyname, t) == name }

// A type as Core IR names it, spelled (`Names::ty` of `Names::spelled`): a built-in by its name, a
// record or enum by its definition's key — `idents` gives each module's identity — and its
// arguments, a holder by its element, a type parameter by its position (`$0` a function's, `$?0`
// a record's, an enum's or a built-in's, `$Self` a trait's), a function and an array spelled out.
// What a construction at `s..e` (absolute) built: a record's type (`construction`), or -1; a
// variant's enum and its index (`variant`), or -1; the field or payload field given at a name's
// span (`field`, `payload`), or -1.
// Any type as messages show it (`Types::show`), for a reader such as `lsp`'s hover.
pub fn ck_show(c: Ck, t: Int) -> Str {
    if t < 0 { return ""; }
    show(c, t)
}
// Where each declaration's name is written (absolute): a function's, a record's, an enum's, a
// trait's.
pub fn ck_fn_name_start(c: Ck, i: Int) -> Int { ints_get(c.fnns, i) }
pub fn ck_fn_name_end(c: Ck, i: Int) -> Int { ints_get(c.fnne, i) }
pub fn ck_record_name_start(c: Ck, r: Int) -> Int { ints_get(c.rns, r) }
pub fn ck_record_name_end(c: Ck, r: Int) -> Int { ints_get(c.rne, r) }
pub fn ck_enum_name_start(c: Ck, e: Int) -> Int { ints_get(c.ens, e) }
pub fn ck_enum_name_end(c: Ck, e: Int) -> Int { ints_get(c.ene, e) }
pub fn ck_trait_name_start(c: Ck, t: Int) -> Int { ints_get(c.trns, t) }
pub fn ck_trait_name_end(c: Ck, t: Int) -> Int { ints_get(c.trne, t) }
pub fn ck_construction_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mcons, s, e) }
pub fn ck_variant_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mvty, s, e) }
pub fn ck_variant_index_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mvix, s, e) }
pub fn ck_init_at(c: Ck, s: Int, e: Int) -> Int { sm_get(c.minit, s, e) }
// A record type's fields: how many, and each one's name; an enum type's variant `v`: its name,
// how many payload fields, and each one's name.
// Whether C sees record type `t` in the order it was declared (`CRepr` other than `Nazm`).
pub fn ck_record_c_layout(c: Ck, t: Int) -> Bool { record_repr(c, ck_record_node(c, ta(c, t))) != 0 }
pub fn ck_record_arity(c: Ck, t: Int) -> Int { ints_get(c.rfc, ta(c, t)) }
pub fn ck_record_field_name(c: Ck, t: Int, i: Int) -> Str { strs_get(c.fname, ints_get(c.rff, ta(c, t)) + i) }
pub fn ck_variant_name(c: Ck, t: Int, v: Int) -> Str { strs_get(c.vname, ints_get(c.evf, ta(c, t)) + v) }
// How many variants an enum type has, and the index of the one named `name` (-1 for none).
pub fn ck_variant_count(c: Ck, t: Int) -> Int { ints_get(c.evc, ta(c, t)) }
pub fn ck_variant_named(c: Ck, t: Int, name: Str) -> Int {
    let mut v = 0;
    while v < ck_variant_count(c, t) {
        if ck_variant_name(c, t, v) == name { return v; }
        v = v + 1;
    }
    0 - 1
}
pub fn ck_variant_arity(c: Ck, t: Int, v: Int) -> Int { ints_get(c.vfc, ints_get(c.evf, ta(c, t)) + v) }
pub fn ck_payload_name(c: Ck, t: Int, v: Int, i: Int) -> Str { strs_get(c.fname, ints_get(c.vff, ints_get(c.evf, ta(c, t)) + v) + i) }
pub fn ck_is_record_type(c: Ck, t: Int) -> Bool { t >= 0 && tag(c, t) == tag_record() }
pub fn ck_is_enum_type(c: Ck, t: Int) -> Bool { t >= 0 && tag(c, t) == tag_enum() }

// How many impls were filed (N78); the trait a record, enum or tuple derives (`@std/hash`'s
// `Hash`), or -1; and whether trait `t` declares a method `name`.
pub fn ck_impl_count(c: Ck) -> Int { ints_len(c.imtrait) }
// Impl `i`'s trait and type, and whether it is the one the coherence table answers with (the
// first filed for its trait and type).
pub fn ck_impl_trait(c: Ck, i: Int) -> Int { ints_get(c.imtrait, i) }
pub fn ck_impl_type(c: Ck, i: Int) -> Int { ints_get(c.imty, i) }
pub fn ck_impl_answers(c: Ck, i: Int) -> Bool { impl_of(c, ints_get(c.imtrait, i), ints_get(c.imty, i)) == i }
// The function impl `i` defines for its trait's `k`th method, or -1 where it leaves it out.
pub fn ck_impl_fn(c: Ck, i: Int, k: Int) -> Int { ints_get(c.imfn, ints_get(c.imff, i) + k) }
// Trait `t`'s methods: how many, each one's name, and its default body's function (or -1).
pub fn ck_trait_method_count(c: Ck, t: Int) -> Int { ints_get(c.trmc, t) }
pub fn ck_trait_method_name(c: Ck, t: Int, k: Int) -> Str { strs_get(c.tmname, ints_get(c.trmf, t) + k) }
pub fn ck_trait_method_default(c: Ck, t: Int, k: Int) -> Int {
    if ints_get(c.tmdef, ints_get(c.trmf, t) + k) == 0 { return 0 - 1; }
    defined_fn(c, ints_get(c.trmod, t), cat4(strs_get(c.trname, t), "/default/", ck_trait_method_name(c, t, k), ""))
}
pub fn ck_derived_hash(c: Ck) -> Int { gs(c, s_hash()) }
pub fn ck_trait_has_method(c: Ck, t: Int, name: Str) -> Bool {
    let mut k = 0;
    while k < ints_get(c.trmc, t) {
        if strs_get(c.tmname, ints_get(c.trmf, t) + k) == name { return true; }
        k = k + 1;
    }
    false
}

// Module `m`'s imports as the graph holds them, in order (the core prelude last): how many, and
// the module the `k`th names.
pub fn ck_module_deps(c: Ck, m: Int) -> Int { deps(c, m) }
pub fn ck_module_dep(c: Ck, m: Int, k: Int) -> Int { ints_get(c.don, dep(c, m, k)) }

// The type table as `nazm.core-ir/3` prints it (`Printer::records`, `Printer::enums`): every
// record and every enum the reference makes, definitions and instances, in its id order —
// `{"records":[…],"enums":[…]}`, compact.
pub fn ck_types_json(c: Ck, idents: Strs) -> Str {
    let records = strs_new();
    let mut i = 0;
    while i < ints_len(c.rlog) {
        strs_push(records, table_entry(c, ints_get(c.rlog, i), true, i, idents));
        i = i + 1;
    }
    let enums = strs_new();
    i = 0;
    while i < ints_len(c.elog) {
        strs_push(enums, table_entry(c, ints_get(c.elog, i), false, i, idents));
        i = i + 1;
    }
    cat5("{\"records\":[", str_join(records, ","), "],\"enums\":[", str_join(enums, ","), "]}")
}

fn jfield(name: Str, value: Str) -> Str { cat3(json_str(name), ":", value) }
fn jbool(b: Bool) -> Str { if b { "true" } else { "false" } }
fn jlist(items: Strs) -> Str { cat3("[", str_join(items, ","), "]") }
fn jobject(items: Strs) -> Str { cat3("{", str_join(items, ","), "}") }

// One entry of the table: `entry` a definition (`-1 - index`) or an instance's type.
fn table_entry(c: Ck, entry: Int, record: Bool, id: Int, idents: Strs) -> Str {
    let mut d = 0 - 1 - entry;
    let mut t = 0;
    let args = ints_new();
    if entry >= 0 {
        t = entry;
        d = ta(c, t);
        let mut k = 0;
        while k < targc(c, t) {
            ints_push(args, targ(c, t, k));
            k = k + 1;
        }
    } else {
        if record { t = record_ty(c, d, ints_new()); } else { t = enum_ty(c, d, ints_new()); }
    }
    let mut definition = t;
    if entry >= 0 {
        if record { definition = record_ty(c, d, ints_new()); } else { definition = enum_ty(c, d, ints_new()); }
    }
    let mut module = 0;
    let mut public = false;
    if record {
        module = ints_get(c.rmod, d);
        public = ints_get(c.rpub, d) == 1;
    } else {
        module = ints_get(c.emod, d);
        public = ints_get(c.epub, d) == 1;
    }
    if module < 0 { module = 0; }
    let o = strs_new();
    strs_push(o, jfield("id", int_to_str(id)));
    strs_push(o, jfield("type", json_str(ck_durable(c, t, idents))));
    strs_push(o, jfield("display", json_str(show(c, t))));
    strs_push(o, jfield("definition", json_str(ck_durable(c, definition, idents))));
    strs_push(o, jfield("module", json_str(strs_get(idents, module))));
    strs_push(o, jfield("pub", jbool(public)));
    let targs = strs_new();
    let mut k = 0;
    while k < ints_len(args) {
        strs_push(targs, json_str(ck_durable(c, ints_get(args, k), idents)));
        k = k + 1;
    }
    strs_push(o, jfield("type_args", jlist(targs)));
    // An instance nested too deeply was never completed: it has no fields.
    let complete = entry < 0 || type_nesting(c, t) <= 256;
    if record {
        let names = strs_new();
        let fields = strs_new();
        if complete {
            k = 0;
            while k < ints_get(c.rfc, d) {
                let fi = ints_get(c.rff, d) + k;
                strs_push(names, strs_get(c.fname, fi));
                let mut ft = ints_get(c.fty, fi);
                if entry >= 0 { ft = inst_subst(c, ft, own_record(), d, args); }
                let f = strs_new();
                strs_push(f, jfield("name", json_str(strs_get(c.fname, fi))));
                strs_push(f, jfield("type", json_str(ck_durable(c, ft, idents))));
                strs_push(fields, jobject(f));
                k = k + 1;
            }
        }
        strs_push(o, jfield("fields", jlist(fields)));
        // A record C sees keeps its declared order (N85); any other is laid out by field name.
        strs_push(o, jfield("canonical", by_name(names, ints_get(c.rrepr, d) == 0)));
        return jobject(o);
    }
    let vnames = strs_new();
    let variants = strs_new();
    if complete {
        let mut v = 0;
        while v < ints_get(c.evc, d) {
            let vi = ints_get(c.evf, d) + v;
            strs_push(vnames, strs_get(c.vname, vi));
            let names = strs_new();
            let fields = strs_new();
            k = 0;
            while k < ints_get(c.vfc, vi) {
                let fi = ints_get(c.vff, vi) + k;
                strs_push(names, strs_get(c.fname, fi));
                let mut ft = ints_get(c.fty, fi);
                if entry >= 0 { ft = inst_subst(c, ft, own_enum(), d, args); }
                let f = strs_new();
                strs_push(f, jfield("name", json_str(strs_get(c.fname, fi))));
                strs_push(f, jfield("type", json_str(ck_durable(c, ft, idents))));
                strs_push(fields, jobject(f));
                k = k + 1;
            }
            let vo = strs_new();
            strs_push(vo, jfield("name", json_str(strs_get(c.vname, vi))));
            strs_push(vo, jfield("fields", jlist(fields)));
            strs_push(vo, jfield("canonical", by_name(names, true)));
            strs_push(variants, jobject(vo));
            v = v + 1;
        }
    }
    strs_push(o, jfield("variants", jlist(variants)));
    strs_push(o, jfield("canonical", by_name(vnames, true)));
    jobject(o)
}

// The positions of `names`, sorted by name byte by byte where `sorted`, else in order.
fn by_name(names: Strs, sorted: Bool) -> Str {
    let order = ints_new();
    let mut i = 0;
    while i < strs_len(names) {
        let mut at = ints_len(order);
        if sorted {
            while at > 0 && name_before(strs_get(names, i), strs_get(names, ints_get(order, at - 1))) { at = at - 1; }
        }
        ints_push(order, 0);
        let mut k = ints_len(order) - 1;
        while k > at {
            ints_set(order, k, ints_get(order, k - 1));
            k = k - 1;
        }
        ints_set(order, at, i);
        i = i + 1;
    }
    let out = strs_new();
    i = 0;
    while i < ints_len(order) {
        strs_push(out, int_to_str(ints_get(order, i)));
        i = i + 1;
    }
    jlist(out)
}

fn name_before(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i); }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

pub fn ck_durable(c: Ck, t: Int, idents: Strs) -> Str {
    let g = tag(c, t);
    if g == tag_builtin() {
        let n = strs_get(c.tyname, t);
        if n == "Ints" { return "Vec[Int]"; }
        if n == "Strs" { return "Vec[Str]"; }
        return n;
    }
    if g == tag_vec() { return cat3("Vec[", ck_durable(c, targ(c, t, 0), idents), "]"); }
    if g == tag_box() { return cat3("Box[", ck_durable(c, targ(c, t, 0), idents), "]"); }
    if g == tag_cell() { return cat3("Cell[", ck_durable(c, targ(c, t, 0), idents), "]"); }
    if g == tag_chain() { return cat3("Chain[", ck_durable(c, targ(c, t, 0), idents), "]"); }
    if g == tag_chan() { return cat3("Chan[", ck_durable(c, targ(c, t, 0), idents), "]"); }
    if g == tag_array() { return cat5("[", ck_durable(c, array_elem(c, t), idents), "; ", int_to_str(ints_get(c.tya, t)), "]"); }
    if g == tag_param() {
        let owner = ints_get(c.tya, t);
        if owner == own_fn() { return str_concat("$", int_to_str(ints_get(c.tyc, t))); }
        if owner == own_trait() { return "$Self"; }
        return str_concat("$?", int_to_str(ints_get(c.tyc, t)));
    }
    if g == tag_record() || g == tag_enum() {
        let mut head = "";
        if g == tag_record() {
            // A tuple's record is the root module's (`tuple_of`).
            let mut rm = ints_get(c.rmod, ta(c, t));
            if rm < 0 { rm = 0; }
            head = cat4(strs_get(idents, rm), "::record ", strs_get(c.rname, ta(c, t)), "");
        } else {
            head = cat4(strs_get(idents, ints_get(c.emod, ta(c, t))), "::enum ", strs_get(c.ename, ta(c, t)), "");
        }
        if targc(c, t) == 0 { return head; }
        let parts = strs_new();
        let mut i = 0;
        while i < targc(c, t) {
            strs_push(parts, ck_durable(c, targ(c, t, i), idents));
            i = i + 1;
        }
        return cat4(head, "[", str_join(parts, ", "), "]");
    }
    if g == tag_fn() {
        let parts = strs_new();
        let mut i = 0;
        while i < fn_arity(c, t) {
            strs_push(parts, ck_durable(c, targ(c, t, i), idents));
            i = i + 1;
        }
        let names = strs_new();
        let mut e = 0;
        while e < 3 {
            if has_bit(ta(c, t), e) { strs_push(names, effect_text(e, "*")); }
            e = e + 1;
        }
        if has_bit(ta(c, t), 3) { strs_push(names, "$effects"); }
        let mut effects = "";
        if strs_len(names) > 0 { effects = cat3(" ! { ", str_join(names, ", "), " }"); }
        return cat5("fn(", str_join(parts, ", "), ") -> ", ck_durable(c, fn_ret(c, t), idents), effects);
    }
    "?"
}

// The field read whose name is written at `s..e` (absolute): its place in its record, its name and
// the type it read; -1 (and "") where none was read there.
pub fn ck_field_index(c: Ck, s: Int, e: Int) -> Int {
    let f = sm_get(c.mfld, s, e);
    if f < 0 { return 0 - 1; }
    let mut r = 0;
    while r < strs_len(c.rname) {
        if f >= ints_get(c.rff, r) && f < ints_get(c.rff, r) + ints_get(c.rfc, r) { return f - ints_get(c.rff, r); }
        r = r + 1;
    }
    0 - 1
}
pub fn ck_field_name(c: Ck, s: Int, e: Int) -> Str {
    let f = sm_get(c.mfld, s, e);
    if f < 0 { return ""; }
    strs_get(c.fname, f)
}
pub fn ck_field_ty(c: Ck, s: Int, e: Int) -> Int { sm_get(c.mfldty, s, e) }

// --- the published interface (`nazm-iface/src/wire.rs`, `PersistentUnitInterface::published`) ----
//
// What module `m` offers, as the reference persists it for the cache's keys (R2, design D28): its
// dependencies' keys, the records and enums its public surface reaches, its exports, traits,
// impls, re-exported types and constants — each by durable key, in the reference's order — written
// as `serde_json` writes `PersistentUnitInterface`. `keys` holds each module's durable key, ""
// for one with none; the answer is "" where a key it needs is missing (`PublishError`).

// The effects of a mask by name, `*` for the effect parameter (`EffectSet::names`).
fn pi_effects(mask: Int) -> Str {
    let out = strs_new();
    let mut e = 0;
    while e < 4 {
        if has_bit(mask, e) {
            if e == 3 { strs_push(out, json_str("*")); } else { strs_push(out, json_str(strs_get(effect_names(), e))); }
        }
        e = e + 1;
    }
    cat3("[", str_join(out, ","), "]")
}

fn pi_key(keys: Strs, m: Int, kind: Str, name: Str) -> Str {
    if m < 0 || m >= strs_len(keys) || strs_get(keys, m) == "" { return ""; }
    cat5(strs_get(keys, m), "::", kind, " ", name)
}

// A type as the interface writes it (`persist`); "" where it names a module with no key.
fn pi_type(c: Ck, t: Int, keys: Strs) -> Str {
    if t < 0 { return ""; }
    if is_tuple(c, t) {
        let parts = strs_new();
        let mut i = 0;
        while i < targc(c, t) {
            let p = pi_type(c, targ(c, t, i), keys);
            if p == "" { return ""; }
            strs_push(parts, p);
            i = i + 1;
        }
        return cat3("{\"tuple\":[", str_join(parts, ","), "]}");
    }
    let g = tag(c, t);
    if g == tag_param() { return cat3("{\"param\":", int_to_str(ints_get(c.tyc, t)), "}"); }
    if g == tag_vec() || g == tag_chan() || g == tag_box() || g == tag_chain() || g == tag_cell() {
        let inner = pi_type(c, targ(c, t, 0), keys);
        if inner == "" { return ""; }
        let mut word = "vec";
        if g == tag_chan() { word = "chan"; }
        if g == tag_box() { word = "box"; }
        if g == tag_chain() { word = "list"; }
        if g == tag_cell() { word = "cell"; }
        return cat5("{\"", word, "\":", inner, "}");
    }
    if g == tag_array() {
        let inner = pi_type(c, array_elem(c, t), keys);
        if inner == "" { return ""; }
        return cat5("{\"array\":", inner, ",\"len\":", int_to_str(ints_get(c.tya, t)), "}");
    }
    if g == tag_fn() {
        let parts = strs_new();
        let mut i = 0;
        while i < fn_arity(c, t) {
            let p = pi_type(c, targ(c, t, i), keys);
            if p == "" { return ""; }
            strs_push(parts, p);
            i = i + 1;
        }
        let ret = pi_type(c, fn_ret(c, t), keys);
        if ret == "" { return ""; }
        return cat5(cat3("{\"fn\":[", str_join(parts, ","), "],\"ret\":"), ret, ",\"effects\":", pi_effects(ta(c, t)), "}");
    }
    if g == tag_record() || g == tag_enum() {
        let mut def = "";
        if g == tag_record() { def = pi_key(keys, ints_get(c.rmod, ta(c, t)), "record", strs_get(c.rname, ta(c, t))); } else {
            def = pi_key(keys, ints_get(c.emod, ta(c, t)), "enum", strs_get(c.ename, ta(c, t)));
        }
        if def == "" { return ""; }
        let parts = strs_new();
        let mut i = 0;
        while i < targc(c, t) {
            let p = pi_type(c, targ(c, t, i), keys);
            if p == "" { return ""; }
            strs_push(parts, p);
            i = i + 1;
        }
        return cat5("{\"def\":", json_str(def), ",\"args\":[", str_join(parts, ","), "]}");
    }
    json_str(strs_get(c.tyname, t))
}

// Whether `a` sorts before `b`, byte by byte (`str::cmp`).
fn pi_less(a: Str, b: Str) -> Bool {
    let mut i = 0;
    while i < str_len(a) && i < str_len(b) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i); }
        i = i + 1;
    }
    str_len(a) < str_len(b)
}

// `items` sorted by `keys` (stably), and those with a key equal to the one before dropped where
// `dedup`.
fn pi_sorted(keys: Strs, items: Strs, dedup: Bool) -> Strs {
    let order = ints_new();
    let mut i = 0;
    while i < strs_len(keys) {
        let mut at = ints_len(order);
        while at > 0 && pi_less(strs_get(keys, i), strs_get(keys, ints_get(order, at - 1))) { at = at - 1; }
        ints_push(order, 0);
        let mut j = ints_len(order) - 1;
        while j > at {
            ints_set(order, j, ints_get(order, j - 1));
            j = j - 1;
        }
        ints_set(order, at, i);
        i = i + 1;
    }
    let out = strs_new();
    let mut last = "";
    i = 0;
    while i < ints_len(order) {
        let k = strs_get(keys, ints_get(order, i));
        if dedup == false || i == 0 || k != last { strs_push(out, strs_get(items, ints_get(order, i))); }
        last = k;
        i = i + 1;
    }
    out
}

// A run of fields as `PersistentField`s, sorted by name unless `declared` (a C struct's).
fn pi_fields(c: Ck, first: Int, count: Int, declared: Bool, keys: Strs) -> Str {
    let names = strs_new();
    let items = strs_new();
    let mut i = 0;
    while i < count {
        let ty = pi_type(c, ints_get(c.fty, first + i), keys);
        if ty == "" { return "?"; }
        let name = strs_get(c.fname, first + i);
        strs_push(names, name);
        strs_push(items, cat5("{\"name\":", json_str(name), ",\"ty\":", ty, "}"));
        i = i + 1;
    }
    if declared { return cat3("[", str_join(items, ","), "]"); }
    cat3("[", str_join(pi_sorted(names, items, false), ","), "]")
}

// The records and enums a set of root types reaches, closed over their fields (`reachable_types`):
// into `recs` and `ens`, each once.
fn pi_reach(c: Ck, t: Int, recs: Ints, ens: Ints) -> Int {
    if t < 0 { return 0; }
    let g = tag(c, t);
    if g == tag_vec() || g == tag_box() || g == tag_chain() || g == tag_cell() || g == tag_chan() || g == tag_fn() || is_tuple(c, t) {
        let mut i = 0;
        while i < targc(c, t) {
            pi_reach(c, targ(c, t, i), recs, ens);
            i = i + 1;
        }
        return 0;
    }
    // An array reaches nothing: `reachable_types` has no arm for one.
    if g == tag_array() { return 0; }
    if g == tag_record() {
        let r = ta(c, t);
        if index_of(recs, r) < 0 {
            ints_push(recs, r);
            let mut f = 0;
            while f < ints_get(c.rfc, r) {
                pi_reach(c, ints_get(c.fty, ints_get(c.rff, r) + f), recs, ens);
                f = f + 1;
            }
        }
    }
    if g == tag_enum() {
        let e = ta(c, t);
        if index_of(ens, e) < 0 {
            ints_push(ens, e);
            let mut v = 0;
            while v < ints_get(c.evc, e) {
                let vi = ints_get(c.evf, e) + v;
                let mut f = 0;
                while f < ints_get(c.vfc, vi) {
                    pi_reach(c, ints_get(c.fty, ints_get(c.vff, vi) + f), recs, ens);
                    f = f + 1;
                }
                v = v + 1;
            }
        }
    }
    if g == tag_record() || g == tag_enum() {
        let mut i = 0;
        while i < targc(c, t) {
            pi_reach(c, targ(c, t, i), recs, ens);
            i = i + 1;
        }
    }
    0
}

// How many `requires` clauses a function states.
fn pi_requires(c: Ck, f: Int) -> Int {
    let cs = kids(c, ints_get(c.fnnode, f), "contracts");
    let mut n = 0;
    let mut i = 0;
    while i < ints_len(cs) {
        if sx_text(c.t, fld(c, ints_get(cs, i), "kind")) == "Requires" { n = n + 1; }
        i = i + 1;
    }
    n
}

// Function `f` as an export (`PersistentExport`), offered under `name`; a re-export when `re`.
fn pi_export(c: Ck, f: Int, name: Str, re: Bool, keys: Strs) -> Str {
    let def = pi_key(keys, ints_get(c.fnmod, f), "fn", strs_get(c.fnname, f));
    if def == "" { return ""; }
    let o = strs_new();
    strs_push(o, cat3("{\"def\":", json_str(def), ""));
    if re { strs_push(o, ",\"reexport\":true"); }
    strs_push(o, cat3(",\"name\":", json_str(name), ",\"kind\":\"fn\""));
    let n = ints_get(c.fntpc, f);
    strs_push(o, cat3(",\"generics\":", int_to_str(n), ""));
    let eq = strs_new();
    let tr = strs_new();
    let mut k = 0;
    while k < n {
        let b = ints_get(c.tpbound, ints_get(c.fntpf, f) + k);
        if ints_get(c.tpeq, ints_get(c.fntpf, f) + k) == 1 { strs_push(eq, int_to_str(k)); }
        if b >= 0 {
            let key = pi_key(keys, ints_get(c.trmod, b), "trait", strs_get(c.trname, b));
            if key != "" { strs_push(tr, cat5("[", int_to_str(k), ",", json_str(key), "]")); }
        }
        k = k + 1;
    }
    if strs_len(eq) > 0 { strs_push(o, cat3(",\"requires_equality\":[", str_join(eq, ","), "]")); }
    if strs_len(tr) > 0 { strs_push(o, cat3(",\"requires_traits\":[", str_join(tr, ","), "]")); }
    let ps = strs_new();
    k = 0;
    while k < ints_get(c.fnpc, f) {
        let p = pi_type(c, ints_get(c.ptys, ints_get(c.fnpf, f) + k), keys);
        if p == "" { return ""; }
        strs_push(ps, p);
        k = k + 1;
    }
    strs_push(o, cat3(",\"params\":[", str_join(ps, ","), "]"));
    let ret = pi_type(c, ints_get(c.fnret, f), keys);
    if ret == "" { return ""; }
    strs_push(o, str_concat(",\"ret\":", ret));
    let declared = ck_fn_declared(c, f);
    if declared >= 0 { strs_push(o, str_concat(",\"effects\":", pi_effects(declared))); }
    if ints_get(c.fnfor, f) == 1 { strs_push(o, str_concat(",\"foreign\":", json_str(ck_fn_foreign(c, f)))); }
    let req = pi_requires(c, f);
    if req > 0 { strs_push(o, str_concat(",\"requires\":", int_to_str(req))); }
    // Its result type left unwritten (R1, 5b.2): a return type of no width.
    let rs = fld(c, fld(c, ints_get(c.fnnode, f), "return_type"), "span");
    if sx_s(c.t, rs) == sx_e(c.t, rs) { strs_push(o, ",\"no_result\":true"); }
    strs_push(o, "}");
    str_join(o, "")
}

// The modules `m` re-exports from (`pub use`), each once.
fn pi_reexporting(c: Ck, m: Int) -> Ints {
    let out = ints_new();
    let mut k = 0;
    while k < deps(c, m) {
        let d = dep(c, m, k);
        if ints_get(c.rx.dk, d) > 0 && index_of(out, ints_get(c.don, d)) < 0 { ints_push(out, ints_get(c.don, d)); }
        k = k + 1;
    }
    out
}

// The traits and impls module `m`'s interface carries: its own, and every one of a module it
// re-exports from (`add_reexported_traits`), each once.
fn pi_traits_of(c: Ck, m: Int, traits: Ints, impls: Ints, seen: Ints) -> Int {
    if index_of(seen, m) >= 0 { return 0; }
    ints_push(seen, m);
    let mut t = 0;
    while t < strs_len(c.trname) {
        if ints_get(c.trmod, t) == m && ints_get(c.trpub, t) == 1 && index_of(traits, t) < 0 { ints_push(traits, t); }
        t = t + 1;
    }
    let mut i = 0;
    while i < ints_len(c.imtrait) {
        if ints_get(c.immod, i) == m && index_of(impls, i) < 0 { ints_push(impls, i); }
        i = i + 1;
    }
    let from = pi_reexporting(c, m);
    let mut k = 0;
    while k < ints_len(from) {
        pi_traits_of(c, ints_get(from, k), traits, impls, seen);
        k = k + 1;
    }
    0
}

// A constant's value as the interface writes it (`persist_value`), from its kind and value; ""
// where it is not computed here.
fn pi_value(c: Ck, kind: Int, n: Int, s: Str) -> Str {
    if kind == k_int() {
        let mut v = n;
        if v < 0 { return cat3("{\"bits\":\"", pi_u64(v), "\"}"); }
        return cat3("{\"bits\":\"", int_to_str(v), "\"}");
    }
    if kind == k_bool() {
        if n == 1 { return "{\"bool\":true}"; }
        return "{\"bool\":false}";
    }
    if kind == k_str() { return cat3("{\"bytes\":\"", hex_text(s), "\"}"); }
    ""
}

// A negative `Int` as the `u64` its bits are.
fn pi_u64(v: Int) -> Str {
    // 2^64 + v, in decimal: 18446744073709551616 + v for v < 0.
    let w = w_add(w_parse("18446744073709551616"), w_from_int(v));
    w_show(w)
}

// Module `m`'s published interface as JSON, or "" where it cannot be published.
pub fn ck_interface_json(c: Ck, m: Int, keys: Strs) -> Str {
    let module = strs_get(keys, m);
    if module == "" { return ""; }
    // Its dependencies' keys, sorted, once each.
    let dk = strs_new();
    let mut k = 0;
    while k < deps(c, m) {
        let key = strs_get(keys, ints_get(c.don, dep(c, m, k)));
        if key == "" { return ""; }
        strs_push(dk, key);
        k = k + 1;
    }
    let dsorted = pi_sorted(dk, dk, true);
    let dq = strs_new();
    k = 0;
    while k < strs_len(dsorted) {
        strs_push(dq, json_str(strs_get(dsorted, k)));
        k = k + 1;
    }
    // Its exports: own `pub` functions, then what it re-exports.
    let enames = strs_new();
    let eitems = strs_new();
    let roots = ints_new();
    let mut f = 0;
    while f < strs_len(c.fnname) {
        if ints_get(c.fnmod, f) == m && ints_get(c.fnpub, f) == 1 && ints_get(c.fnclos, f) < 0 {
            let e = pi_export(c, f, strs_get(c.fnname, f), false, keys);
            if e == "" { return ""; }
            strs_push(enames, strs_get(c.fnname, f));
            strs_push(eitems, e);
            let p = 0;
            let mut q = p;
            while q < ints_get(c.fnpc, f) {
                ints_push(roots, ints_get(c.ptys, ints_get(c.fnpf, f) + q));
                q = q + 1;
            }
            ints_push(roots, ints_get(c.fnret, f));
        }
        f = f + 1;
    }
    let mut x = 0;
    while x < ints_len(c.rx.fm) {
        if ints_get(c.rx.fm, x) == m {
            let g = ints_get(c.rx.ff, x);
            let e = pi_export(c, g, strs_get(c.rx.fname, x), true, keys);
            if e == "" { return ""; }
            strs_push(enames, strs_get(c.rx.fname, x));
            strs_push(eitems, e);
        }
        x = x + 1;
    }
    // Records and enums: its own `pub` ones, then what the surface reaches.
    let recs = ints_new();
    let ens = ints_new();
    let mut r = 0;
    while r < strs_len(c.rname) {
        if ints_get(c.rmod, r) == m && ints_get(c.rpub, r) == 1 && index_of(recs, r) < 0 {
            ints_push(recs, r);
            let mut q = 0;
            while q < ints_get(c.rfc, r) {
                ints_push(roots, ints_get(c.fty, ints_get(c.rff, r) + q));
                q = q + 1;
            }
        }
        r = r + 1;
    }
    let mut e = 0;
    while e < strs_len(c.ename) {
        if ints_get(c.emod, e) == m && ints_get(c.epub, e) == 1 && index_of(ens, e) < 0 {
            ints_push(ens, e);
            let mut v = 0;
            while v < ints_get(c.evc, e) {
                let vi = ints_get(c.evf, e) + v;
                let mut q = 0;
                while q < ints_get(c.vfc, vi) {
                    ints_push(roots, ints_get(c.fty, ints_get(c.vff, vi) + q));
                    q = q + 1;
                }
                v = v + 1;
            }
        }
        e = e + 1;
    }
    // Re-exported types (N103): each a member, nameable under its own name, or renamed.
    let rt_names = strs_new();
    let rt_items = strs_new();
    x = 0;
    while x < ints_len(c.rx.tm) {
        if ints_get(c.rx.tm, x) == m {
            let t = ints_get(c.rx.tt, x);
            pi_reach(c, t, recs, ens);
            if ints_get(c.rx.tn, x) == 1 {
                let mut name = "";
                let mut key = "";
                if is_record(c, t) {
                    name = strs_get(c.rname, ta(c, t));
                    key = pi_key(keys, ints_get(c.rmod, ta(c, t)), "record", name);
                    if ints_get(c.rmod, ta(c, t)) == m { key = ""; }
                }
                if is_enum(c, t) {
                    name = strs_get(c.ename, ta(c, t));
                    key = pi_key(keys, ints_get(c.emod, ta(c, t)), "enum", name);
                    if ints_get(c.emod, ta(c, t)) == m { key = ""; }
                }
                if key != "" {
                    strs_push(rt_names, cat3(name, str_from_byte(1), key));
                    strs_push(rt_items, cat5("[", json_str(name), ",", json_str(key), "]"));
                }
            }
        }
        x = x + 1;
    }
    x = 0;
    while x < ints_len(c.rx.nm) {
        if ints_get(c.rx.nm, x) == m {
            let t = ints_get(c.rx.nt, x);
            let name = strs_get(c.rx.nname, x);
            let mut key = "";
            if is_record(c, t) { key = pi_key(keys, ints_get(c.rmod, ta(c, t)), "record", strs_get(c.rname, ta(c, t))); }
            if is_enum(c, t) { key = pi_key(keys, ints_get(c.emod, ta(c, t)), "enum", strs_get(c.ename, ta(c, t))); }
            if key != "" {
                strs_push(rt_names, cat3(name, str_from_byte(1), key));
                strs_push(rt_items, cat5("[", json_str(name), ",", json_str(key), "]"));
            }
        }
        x = x + 1;
    }
    // Its exported constants: their types are roots too.
    let cnames = strs_new();
    let citems = strs_new();
    x = 0;
    while x < ints_len(c.xmod) {
        if ints_get(c.xmod, x) == m {
            let kind = ints_get(c.xkind, x);
            let ty = kind_type(c, kind);
            ints_push(roots, ty);
            let tj = pi_type(c, ty, keys);
            let vj = pi_const_value(c, kind, ints_get(c.xint, x), strs_get(c.xstr, x), keys);
            if tj != "" && vj != "" {
                strs_push(cnames, strs_get(c.xname, x));
                strs_push(citems, cat5(cat3("{\"name\":", json_str(strs_get(c.xname, x)), ",\"type\":"), tj, ",\"value\":", vj, "}"));
            }
        }
        x = x + 1;
    }
    let mut i = 0;
    while i < ints_len(roots) {
        pi_reach(c, ints_get(roots, i), recs, ens);
        i = i + 1;
    }
    let rkeys = strs_new();
    let ritems = strs_new();
    i = 0;
    while i < ints_len(recs) {
        let rr = ints_get(recs, i);
        if is_tuple_def(c, rr) == false {
            let def = pi_key(keys, ints_get(c.rmod, rr), "record", strs_get(c.rname, rr));
            if def == "" { return ""; }
            let repr = ints_get(c.rrepr, rr);
            let fields = pi_fields(c, ints_get(c.rff, rr), ints_get(c.rfc, rr), repr != 0, keys);
            if fields == "?" { return ""; }
            let mut cpart = "";
            if repr == 1 { cpart = ",\"c\":\"handle\""; }
            if repr > 1 { cpart = ",\"c\":\"struct\""; }
            strs_push(rkeys, def);
            strs_push(ritems, cat5(cat5("{\"def\":", json_str(def), ",\"name\":", json_str(strs_get(c.rname, rr)), ",\"generics\":"), int_to_str(ints_get(c.rnp, rr)),
                    ",\"fields\":", fields, str_concat(cpart, "}")));
        }
        i = i + 1;
    }
    let enkeys = strs_new();
    let enitems = strs_new();
    i = 0;
    while i < ints_len(ens) {
        let en = ints_get(ens, i);
        let def = pi_key(keys, ints_get(c.emod, en), "enum", strs_get(c.ename, en));
        if def == "" { return ""; }
        let vnames = strs_new();
        let vitems = strs_new();
        let mut v = 0;
        while v < ints_get(c.evc, en) {
            let vi = ints_get(c.evf, en) + v;
            let fields = pi_fields(c, ints_get(c.vff, vi), ints_get(c.vfc, vi), false, keys);
            if fields == "?" { return ""; }
            strs_push(vnames, strs_get(c.vname, vi));
            strs_push(vitems, cat5("{\"name\":", json_str(strs_get(c.vname, vi)), ",\"fields\":", fields, "}"));
            v = v + 1;
        }
        strs_push(enkeys, def);
        strs_push(enitems, cat5(cat5("{\"def\":", json_str(def), ",\"name\":", json_str(strs_get(c.ename, en)), ",\"generics\":"), int_to_str(ints_get(c.enp, en)),
                ",\"variants\":[", str_join(pi_sorted(vnames, vitems, false), ","), "]}"));
        i = i + 1;
    }
    // Traits and impls.
    let traits = ints_new();
    let impls = ints_new();
    pi_traits_of(c, m, traits, impls, ints_new());
    let tkeys = strs_new();
    let titems = strs_new();
    i = 0;
    while i < ints_len(traits) {
        let t = ints_get(traits, i);
        let def = pi_key(keys, ints_get(c.trmod, t), "trait", strs_get(c.trname, t));
        if def == "" { return ""; }
        let ms = strs_new();
        let mut q = 0;
        while q < ints_get(c.trmc, t) {
            let tm = ints_get(c.trmf, t) + q;
            let ps = strs_new();
            let mut p = 0;
            while p < ints_get(c.tmpc, tm) {
                let pj = pi_type(c, ints_get(c.ptys, ints_get(c.tmpf, tm) + p), keys);
                if pj == "" { return ""; }
                strs_push(ps, pj);
                p = p + 1;
            }
            let rj = pi_type(c, ints_get(c.tmret, tm), keys);
            if rj == "" { return ""; }
            strs_push(ms, cat5(cat3("{\"name\":", json_str(strs_get(c.tmname, tm)), ",\"params\":["), str_join(ps, ","), "],\"ret\":", rj,
                    cat3(",\"effects\":", pi_effects(ints_get(c.tmeff, tm)), "}")));
            q = q + 1;
        }
        strs_push(tkeys, def);
        strs_push(titems, cat5("{\"def\":", json_str(def), ",\"name\":", json_str(strs_get(c.trname, t)), cat3(",\"methods\":[", str_join(ms, ","), "]}")));
        i = i + 1;
    }
    let ikeys = strs_new();
    let iitems = strs_new();
    i = 0;
    while i < ints_len(impls) {
        let im = ints_get(impls, i);
        let tr = ints_get(c.imtrait, im);
        let def = pi_key(keys, ints_get(c.trmod, tr), "trait", strs_get(c.trname, tr));
        let self_ty = pi_type(c, ints_get(c.imty, im), keys);
        if def == "" || self_ty == "" { return ""; }
        let shown = show(c, ints_get(c.imty, im));
        let ms = strs_new();
        let mut q = 0;
        while q < ints_get(c.trmc, tr) {
            let key = pi_key(keys, ints_get(c.immod, im), "fn", cat5(strs_get(c.trname, tr), "/", shown, "/", strs_get(c.tmname, ints_get(c.trmf, tr) + q)));
            if key == "" { return ""; }
            strs_push(ms, json_str(key));
            q = q + 1;
        }
        strs_push(ikeys, cat3(def, str_from_byte(1), self_ty));
        strs_push(iitems, cat5("{\"trait\":", json_str(def), ",\"type\":", self_ty, cat3(",\"methods\":[", str_join(ms, ","), "]}")));
        i = i + 1;
    }
    let o = strs_new();
    strs_push(o, cat3("{\"schema\":\"nazm.interface/13\",\"module\":", json_str(module), ""));
    strs_push(o, cat3(",\"dependencies\":[", str_join(dq, ","), "]"));
    strs_push(o, cat3(",\"records\":[", str_join(pi_sorted(rkeys, ritems, true), ","), "]"));
    strs_push(o, cat3(",\"enums\":[", str_join(pi_sorted(enkeys, enitems, true), ","), "]"));
    strs_push(o, cat3(",\"exports\":[", str_join(pi_sorted(enames, eitems, false), ","), "]"));
    if strs_len(titems) > 0 { strs_push(o, cat3(",\"traits\":[", str_join(pi_sorted(tkeys, titems, false), ","), "]")); }
    if strs_len(iitems) > 0 { strs_push(o, cat3(",\"impls\":[", str_join(pi_sorted(ikeys, iitems, false), ","), "]")); }
    if strs_len(rt_items) > 0 { strs_push(o, cat3(",\"reexported_types\":[", str_join(pi_sorted(rt_names, rt_items, true), ","), "]")); }
    if strs_len(citems) > 0 { strs_push(o, cat3(",\"consts\":[", str_join(pi_sorted(cnames, citems, false), ","), "]")); }
    strs_push(o, "}");
    str_join(o, "")
}

fn is_tuple_def(c: Ck, r: Int) -> Bool { strs_get(c.rname, r) == "(,)" }

// An exported constant's value (`persist_value`): a scalar from its kind and value, an aggregate
// from the tokens its value is kept as (`parts`); "" where it was not computed.
fn pi_const_value(c: Ck, kind: Int, n: Int, s: Str, keys: Strs) -> Str {
    if k_is_agg(kind) == false {
        if kind == k_int() || kind == k_bool() || kind == k_str() { return pi_value(c, kind, n, s); }
        if k_is_float(kind) { return ""; }
        // Another integer kind: its value's low 64 bits, or all 128 for a 128-bit kind.
        let w = w_parse(s);
        let name = kind_name(kind);
        if name == "Int128" || name == "UInt128" {
            if w_cmp(w, w_from_int(0)) < 0 { return cat3("{\"bits\":\"", w_show(w_add(w_parse("340282366920938463463374607431768211456"), w)), "\"}"); }
            return cat3("{\"bits\":\"", w_show(w), "\"}");
        }
        if w_cmp(w, w_from_int(0)) < 0 { return cat3("{\"bits\":\"", w_show(w_add(w_parse("18446744073709551616"), w)), "\"}"); }
        return cat3("{\"bits\":\"", w_show(w), "\"}");
    }
    // An aggregate: its value's tokens (`parts`), read back.
    let toks = sx_split(s, 32);
    let pos = ints_new();
    ints_push(pos, 0);
    let v = pi_agg(c, toks, pos);
    if ints_get(pos, 0) != strs_len(toks) { return ""; }
    v
}

// One part of an aggregate constant's value, from token `pos[0]` on, as `persist_value` writes
// it; "" where a part is not computed here (a float's).
fn pi_agg(c: Ck, toks: Strs, pos: Ints) -> Str {
    let p = ints_get(pos, 0);
    if p >= strs_len(toks) { return ""; }
    let tok = strs_get(toks, p);
    ints_set(pos, 0, p + 1);
    let head = str_byte(tok, 0);
    let colon = pi_byte(tok, 58);
    if head == 83 { return cat3("{\"bytes\":\"", str_slice(tok, 1, str_len(tok)), "\"}"); }
    if head == 70 { return ""; }
    if head == 78 {
        let kind = parse_int(str_slice(tok, 1, colon));
        let value = str_slice(tok, colon + 1, str_len(tok));
        if kind == k_bool() {
            if value == "1" { return "{\"bool\":true}"; }
            return "{\"bool\":false}";
        }
        if kind == k_int() {
            let w = w_parse(value);
            if w_cmp(w, w_from_int(0)) < 0 { return cat3("{\"bits\":\"", w_show(w_add(w_parse("18446744073709551616"), w)), "\"}"); }
            return cat3("{\"bits\":\"", value, "\"}");
        }
        return pi_const_value(c, kind, 0, value, strs_new());
    }
    // `R<t>:<n>`, `V<t>:<v>:<n>`, `A<t>:<n>`.
    let rest = str_slice(tok, 1, str_len(tok));
    let parts = sx_split(rest, 58);
    let t = parse_int(strs_get(parts, 0));
    let n = parse_int(strs_get(parts, strs_len(parts) - 1));
    let values = strs_new();
    let mut i = 0;
    while i < n {
        let v = pi_agg(c, toks, pos);
        if v == "" { return ""; }
        strs_push(values, v);
        i = i + 1;
    }
    if head == 65 { return cat3("{\"elems\":[", str_join(values, ","), "]}"); }
    let names = strs_new();
    let items = strs_new();
    let mut variant = "";
    if head == 86 { variant = strs_get(c.vname, ints_get(c.evf, ta(c, t)) + parse_int(strs_get(parts, 1))); }
    i = 0;
    while i < n {
        let mut name = "";
        if head == 86 {
            let vi = ints_get(c.evf, ta(c, t)) + parse_int(strs_get(parts, 1));
            name = strs_get(c.fname, ints_get(c.vff, vi) + i);
        } else {
            name = strs_get(c.fname, ints_get(c.rff, ta(c, t)) + i);
        }
        strs_push(names, name);
        strs_push(items, cat5("[", json_str(name), ",", strs_get(values, i), "]"));
        i = i + 1;
    }
    let fields = cat3("\"fields\":[", str_join(pi_sorted(names, items, false), ","), "]}");
    if head == 86 { return cat5("{\"variant\":", json_str(variant), ",", fields, ""); }
    str_concat("{", fields)
}

fn pi_byte(s: Str, b: Int) -> Int {
    let mut i = 0;
    while i < str_len(s) && str_byte(s, i) != b { i = i + 1; }
    i
}

// --- the reference index (N17; `nazm_sema::references`) ---------------------------------------
//
// Where each entity a program declares is used: resolution read backwards. An entity is a function
// (a closure is none), a local, a record, an enum, a variant, a field, a payload field, a trait,
// a trait's method or a constant; a use is a span the checker recorded an answer for, and the
// declaration is kept apart from the uses. Built when first asked for, from the maps the checker
// keeps by span, in the reference's order of kinds, the first answer for a span being its entity's
// (`ReferenceIndex::of`). Every span is absolute.

pub struct Rix {
    ok: Ints,
    // Each indexed entity, in order of its declaration (then of its first use, for one declared
    // nowhere): its kind (`ck_ref_kind_name`), declaration (-1 for none) and its uses, a run of
    // the pool beside, in order.
    k: Ints,
    ds: Ints,
    de: Ints,
    uf: Ints,
    uc: Ints,
    us: Ints,
    ue: Ints,
    // The call graph, once asked for: per function the call sites of its body (a run of `cgl`,
    // in the order they were recorded); `cgn` is 1 once built.
    cgn: Ints,
    cgf: Ints,
    cgc: Ints,
    cgl: Ints,
    // The provenance summaries, once asked for (`ck_prov_has`): per function whether it has one,
    // the origins its result carries and the parameters it passes on and that reach the path
    // sink, as masks; and what each parameter is handed, a run of `pvv` (an origin mask each).
    pvn: Ints,
    pvh: Ints,
    pvo: Ints,
    pvp: Ints,
    pvr: Ints,
    pvf: Ints,
    pvv: Ints,
    // The solved sinks, once asked for (`ck_sink_count`; R8 slice 11, task 11.1: `explain-flow`): per sink its function, class, place, origins
    // (a mask) and its traces, a run of the trace pools (`skt`, `skn`); a trace is an origin and its steps, a run of the step pools.
    // The calls whose preconditions were proved for literal arguments (`prove_preconditions`; R8 slice 11): where the callee is written
    // (absolute) and the witness, each clause as evaluated.
    pcs: Ints,
    pce: Ints,
    pcw: Strs,
    // Names of functions a call mentioned where it was then refused (`record_call` before the error): the span and the function, which the reference index
    // holds as uses though no call site was recorded.
    eus: Ints,
    eue: Ints,
    eui: Ints,
    skb: Ints,
    skw: Ints,
    skf: Ints,
    skc: Ints,
    sks: Ints,
    ske: Ints,
    sko: Ints,
    skt: Ints,
    skn: Ints,
    tro: Ints,
    trf: Ints,
    trn: Ints,
    tss: Ints,
    tse: Ints,
    tnote: Strs,
    // Each entity's number before the order was made (its place among the checker's functions, bindings, records, …).
    og: Ints,
}

fn rix_new() -> Rix {
    Rix(ok: ints_new(), k: ints_new(), ds: ints_new(), de: ints_new(), uf: ints_new(), uc: ints_new(), us: ints_new(), ue: ints_new(),
            cgn: ints_new(), cgf: ints_new(), cgc: ints_new(), cgl: ints_new(),
            pvn: ints_new(), pvh: ints_new(), pvo: ints_new(), pvp: ints_new(), pvr: ints_new(), pvf: ints_new(), pvv: ints_new(),
            pcs: ints_new(), pce: ints_new(), pcw: strs_new(), eus: ints_new(), eue: ints_new(), eui: ints_new(), skb: ints_new(), skw: ints_new(), skf: ints_new(), skc: ints_new(), sks: ints_new(), ske: ints_new(), sko: ints_new(), skt: ints_new(), skn: ints_new(), tro: ints_new(), trf: ints_new(),
            trn: ints_new(), tss: ints_new(), tse: ints_new(), tnote: strs_new(), og: ints_new())
}

// A declaration: where the entity is declared, unless that is no width or no place; the span is
// the entity's unless another entity has it.
fn ix_declare(at: Smap, ds: Ints, de: Ints, live: Ints, ent: Int, s: Int, e: Int) -> Int {
    if s < 0 || e <= s { return 0; }
    if s == 0 && e == 0 { return 0; }
    if sm_get(at, s, e) < 0 { sm_put(at, s, e, ent); }
    ints_set(ds, ent, s);
    ints_set(de, ent, e);
    ints_set(live, ent, 1);
    0
}

// A use, unless the span is another entity's (`ReferenceIndex::used`).
fn ix_use(at: Smap, live: Ints, ent: Int, s: Int, e: Int) -> Int {
    if s < 0 || e < s { return 0; }
    if s == 0 && e == 0 { return 0; }
    let cur = sm_get(at, s, e);
    if cur >= 0 && cur != ent { return 0; }
    sm_put(at, s, e, ent);
    ints_set(live, ent, 1);
    0
}

// Whether entity `a` goes before `b`: declared ones first, by where, then by kind.
fn ix_less(ds: Ints, de: Ints, kind: Ints, a: Int, b: Int) -> Bool {
    if ints_get(ds, a) < 0 { return false; }
    if ints_get(ds, b) < 0 { return true; }
    if ints_get(ds, a) != ints_get(ds, b) { return ints_get(ds, a) < ints_get(ds, b); }
    if ints_get(de, a) != ints_get(de, b) { return ints_get(de, a) < ints_get(de, b); }
    ints_get(kind, a) < ints_get(kind, b)
}

// The map's entries that begin at `s`, shortest first.
fn ix_chain(m: Smap, s: Int) -> Ints {
    let sorted = ints_new();
    if s < 0 || s >= sm_top(m) { return sorted; }
    let mut j = ints_get(m.hd, s % ints_len(m.hd));
    while j >= 0 {
        if ints_get(m.ks, j) != s {
            j = ints_get(m.nx, j);
            continue;
        }
        let mut p = 0;
        while p < ints_len(sorted) && ints_get(m.ke, ints_get(sorted, p)) < ints_get(m.ke, j) { p = p + 1; }
        ints_push(sorted, 0);
        let mut q = ints_len(sorted) - 1;
        while q > p {
            ints_set(sorted, q, ints_get(sorted, q - 1));
            q = q - 1;
        }
        ints_set(sorted, p, j);
        j = ints_get(m.nx, j);
    }
    sorted
}

fn ix_build(c: Ck) -> Int {
    if ints_len(c.rix.ok) > 0 { return 0; }
    ints_push(c.rix.ok, 1);
    let nfn = strs_len(c.fnname);
    let nb = ints_len(c.bfn);
    let nr = strs_len(c.rname);
    let ne = strs_len(c.ename);
    let nv = strs_len(c.vname);
    let nf = strs_len(c.fname);
    let ntr = strs_len(c.trname);
    let ntm = strs_len(c.tmname);
    let nmod = ints_len(c.mprog);
    let mut nconst = 0;
    let mut m = 0;
    while m < nmod {
        nconst = nconst + ints_len(kids(c, ints_get(c.mprog, m), "consts"));
        m = m + 1;
    }
    let bloc = nfn;
    let brec = bloc + nb;
    let benum = brec + nr;
    let bvar = benum + ne;
    let bfld = bvar + nv;
    let btr = bfld + nf;
    let btm = btr + ntr;
    let bcon = btm + ntm;
    let bref = bcon + nconst;
    let total = bref + ints_len(c.rzb);
    let kind = ints_new();
    let ds = ints_new();
    let de = ints_new();
    let live = ints_new();
    let mut i = 0;
    while i < total {
        let mut k = 6;
        if i < bloc { k = 1; } else {
            if i < brec { k = 2; } else {
                if i < benum { k = 3; } else {
                    if i < bvar { k = 4; } else {
                        if i < bfld { k = 5; } else {
                            if i >= btr { k = 8; }
                            if i >= btm { k = 9; }
                            if i >= bcon { k = 10; }
                            if i >= bref { k = 2; }
                        }
                    }
                }
            }
        }
        ints_push(kind, k);
        ints_push(ds, 0 - 1);
        ints_push(de, 0 - 1);
        ints_push(live, 0);
        i = i + 1;
    }
    // The payload fields are the variants' runs of the field pool.
    i = 0;
    while i < nv {
        let mut k = 0;
        while k < ints_get(c.vfc, i) {
            ints_set(kind, bfld + ints_get(c.vff, i) + k, 7);
            k = k + 1;
        }
        i = i + 1;
    }
    let at = sm_new();
    // The declarations.
    i = 0;
    while i < nfn {
        if ints_get(c.fnclos, i) < 0 { ix_declare(at, ds, de, live, i, ints_get(c.fnns, i), ints_get(c.fnne, i)); }
        i = i + 1;
    }
    // A binding of no function — the body of one the checker did not register (a built-in's name, a method of an impl it refused) — is no entity: the
    // reference index holds the locals of the functions it has.
    i = 0;
    while i < nb {
        if ints_get(c.bfn, i) >= 0 { ix_declare(at, ds, de, live, bloc + i, ints_get(c.bds, i), ints_get(c.bde, i)); }
        i = i + 1;
    }
    i = 0;
    while i < nr {
        ix_declare(at, ds, de, live, brec + i, ints_get(c.rns, i), ints_get(c.rne, i));
        let mut k = 0;
        while k < ints_get(c.rfc, i) {
            let f = ints_get(c.rff, i) + k;
            ix_declare(at, ds, de, live, bfld + f, ints_get(c.fns, f), ints_get(c.fne, f));
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < ne {
        ix_declare(at, ds, de, live, benum + i, ints_get(c.ens, i), ints_get(c.ene, i));
        let mut k = 0;
        while k < ints_get(c.evc, i) {
            let v = ints_get(c.evf, i) + k;
            ix_declare(at, ds, de, live, bvar + v, ints_get(c.vns, v), ints_get(c.vne, v));
            let mut j = 0;
            while j < ints_get(c.vfc, v) {
                let f = ints_get(c.vff, v) + j;
                ix_declare(at, ds, de, live, bfld + f, ints_get(c.fns, f), ints_get(c.fne, f));
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < ntr {
        ix_declare(at, ds, de, live, btr + i, ints_get(c.trns, i), ints_get(c.trne, i));
        let mut k = 0;
        while k < ints_get(c.trmc, i) {
            let m = ints_get(c.trmf, i) + k;
            ix_declare(at, ds, de, live, btm + m, ints_get(c.tmns, m), ints_get(c.tmne, m));
            k = k + 1;
        }
        i = i + 1;
    }
    // Constants, by the start of their names.
    let cst = sm_new();
    let mut n = 0;
    m = 0;
    while m < nmod {
        let decls = kids(c, ints_get(c.mprog, m), "consts");
        let mut k = 0;
        while k < ints_len(decls) {
            let ns = fld(c, ints_get(decls, k), "name_span");
            let at_s = sx_s(c.t, ns) + ints_get(c.mbase, m);
            // A constant declared again is no declaration (`N0203`): the index holds the first.
            let mut duplicate = false;
            let mut j = 0;
            while j < k {
                if fname_of(c, ints_get(decls, j), "name") == fname_of(c, ints_get(decls, k), "name") { duplicate = true; }
                j = j + 1;
            }
            if duplicate == false { ix_declare(at, ds, de, live, bcon + n, at_s, sx_e(c.t, ns) + ints_get(c.mbase, m)); }
            sm_put(cst, at_s, 0, bcon + n);
            n = n + 1;
            k = k + 1;
        }
        m = m + 1;
    }
    // The uses, kind by kind: trait mentions, calls, named functions written as values, variables,
    // constructions, variants, fields, payload fields and type names.
    let trm = c.mtrm;
    i = 0;
    while i < ints_len(trm.ks) {
        ix_use(at, live, btr + ints_get(trm.kv, i), ints_get(trm.ks, i), ints_get(trm.ke, i));
        i = i + 1;
    }
    // The names a `pub use` chooses (N103): a trait is mentioned, a function called, a type named.
    i = 0;
    while i < ints_len(c.rx.xk) {
        if ints_get(c.rx.xk, i) == 3 { ix_use(at, live, btr + ints_get(c.rx.xid, i), ints_get(c.rx.xs, i), ints_get(c.rx.xe, i)); }
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.rx.xk) {
        if ints_get(c.rx.xk, i) == 1 { ix_use(at, live, ints_get(c.rx.xid, i), ints_get(c.rx.xs, i), ints_get(c.rx.xe, i)); }
        i = i + 1;
    }
    let sites = c.msite;
    i = 0;
    while i < ints_len(sites.ks) {
        let site = ints_get(sites.kv, i);
        if ints_get(c.stm, site) >= 0 {
            ix_use(at, live, btm + ints_get(c.stm, site), ints_get(sites.ks, i), ints_get(sites.ke, i));
        } else {
            if ints_get(c.suser, site) >= 0 { ix_use(at, live, ints_get(c.suser, site), ints_get(sites.ks, i), ints_get(sites.ke, i)); }
        }
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.vfn) {
        ix_use(at, live, ints_get(c.vfn, i), ints_get(c.vstart, i), ints_get(c.vend, i));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.rix.eui) {
        ix_use(at, live, ints_get(c.rix.eui, i), ints_get(c.rix.eus, i), ints_get(c.rix.eue, i));
        i = i + 1;
    }
    let vars = c.mvar;
    i = 0;
    while i < ints_len(vars.ks) {
        let rz = sm_get(c.mrefu, ints_get(vars.ks, i), ints_get(vars.ke, i));
        if rz >= 0 {
            // A refused capture is mentioned through a slot of the closure that nothing declares.
            ix_use(at, live, bref + rz, ints_get(vars.ks, i), ints_get(vars.ke, i));
        } else {
            if ints_get(c.bfn, ints_get(vars.kv, i)) >= 0 { ix_use(at, live, bloc + ints_get(vars.kv, i), ints_get(vars.ks, i), ints_get(vars.ke, i)); }
        }
        i = i + 1;
    }
    let cons = c.mcons;
    i = 0;
    while i < ints_len(cons.ks) {
        ix_use(at, live, brec + ta(c, ints_get(cons.kv, i)), ints_get(cons.ks, i), ints_get(cons.ke, i));
        i = i + 1;
    }
    let vts = c.mvty;
    i = 0;
    while i < ints_len(vts.ks) {
        let ix = sm_get(c.mvix, ints_get(vts.ks, i), ints_get(vts.ke, i));
        if ix >= 0 { ix_use(at, live, bvar + ints_get(c.evf, ta(c, ints_get(vts.kv, i))) + ix, ints_get(vts.ks, i), ints_get(vts.ke, i)); }
        i = i + 1;
    }
    let flds = c.mfld;
    i = 0;
    while i < ints_len(flds.ks) {
        ix_use(at, live, bfld + ints_get(flds.kv, i), ints_get(flds.ks, i), ints_get(flds.ke, i));
        i = i + 1;
    }
    let inits = c.mfini;
    i = 0;
    while i < ints_len(inits.ks) {
        ix_use(at, live, bfld + ints_get(inits.kv, i), ints_get(inits.ks, i), ints_get(inits.ke, i));
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.rx.xk) {
        if ints_get(c.rx.xk, i) == 2 {
            let t = ints_get(c.rx.xid, i);
            if tag(c, t) == tag_record() {
                ix_use(at, live, brec + ta(c, t), ints_get(c.rx.xs, i), ints_get(c.rx.xe, i));
            } else {
                ix_use(at, live, benum + ta(c, t), ints_get(c.rx.xs, i), ints_get(c.rx.xe, i));
            }
        }
        i = i + 1;
    }
    let names = c.mtyn;
    i = 0;
    while i < ints_len(names.ks) {
        let t = ints_get(names.kv, i);
        if tag(c, t) == tag_record() {
            ix_use(at, live, brec + ta(c, t), ints_get(names.ks, i), ints_get(names.ke, i));
        } else {
            ix_use(at, live, benum + ta(c, t), ints_get(names.ks, i), ints_get(names.ke, i));
        }
        i = i + 1;
    }
    let crefs = c.mcref;
    i = 0;
    while i < ints_len(crefs.ks) {
        let ent = sm_get(cst, ints_get(crefs.kv, i), 0);
        if ent >= 0 { ix_use(at, live, ent, ints_get(crefs.ks, i), ints_get(crefs.ke, i)); }
        i = i + 1;
    }
    // The entities in order: by declaration, with those declared nowhere (or whose span another
    // entity took) after them, by first use.
    let r = c.rix;
    let order = ints_new();
    let slot = ints_new();
    i = 0;
    while i < total {
        ints_push(slot, 0 - 1);
        i = i + 1;
    }
    let mut s = 0;
    while s < sm_top(at) {
        let chain = ix_chain(at, s);
        let mut a = 0;
        while a < ints_len(chain) {
            let x = ints_get(chain, a);
            let ent = ints_get(at.kv, x);
            if ints_get(slot, ent) < 0 && ints_get(ds, ent) == s && ints_get(de, ent) == ints_get(at.ke, x) {
                ints_set(slot, ent, ints_len(order));
                ints_push(order, ent);
            }
            a = a + 1;
        }
        s = s + 1;
    }
    s = 0;
    while s < sm_top(at) {
        let chain = ix_chain(at, s);
        let mut a = 0;
        while a < ints_len(chain) {
            let ent = ints_get(at.kv, ints_get(chain, a));
            if ints_get(slot, ent) < 0 {
                ints_set(slot, ent, ints_len(order));
                ints_push(order, ent);
            }
            a = a + 1;
        }
        s = s + 1;
    }
    // Declared, and in no span of the map: a declaration another entity's span took, never used.
    i = 0;
    while i < total {
        if ints_get(live, i) == 1 && ints_get(slot, i) < 0 {
            ints_set(slot, i, ints_len(order));
            ints_push(order, i);
        }
        i = i + 1;
    }
    // Entities of one declaration are in the reference's order of kinds (`ReferenceTarget`'s), and
    // the declared before those that are not: an insertion sort, the list being nearly in order.
    i = 1;
    while i < ints_len(order) {
        let x = ints_get(order, i);
        let mut j = i;
        while j > 0 && ix_less(ds, de, kind, x, ints_get(order, j - 1)) {
            ints_set(order, j, ints_get(order, j - 1));
            j = j - 1;
        }
        ints_set(order, j, x);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(order) {
        ints_set(slot, ints_get(order, i), i);
        i = i + 1;
    }
    // The uses of each, in order: a count, then the fill.
    let count = ints_new();
    i = 0;
    while i < ints_len(order) {
        ints_push(count, 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(at.ks) {
        let ent = ints_get(at.kv, i);
        if ints_get(ds, ent) != ints_get(at.ks, i) || ints_get(de, ent) != ints_get(at.ke, i) {
            ints_set(count, ints_get(slot, ent), ints_get(count, ints_get(slot, ent)) + 1);
        }
        i = i + 1;
    }
    let mut off = 0;
    i = 0;
    while i < ints_len(order) {
        ints_push(r.uf, off);
        ints_push(r.uc, 0);
        off = off + ints_get(count, i);
        i = i + 1;
    }
    i = 0;
    while i < off {
        ints_push(r.us, 0);
        ints_push(r.ue, 0);
        i = i + 1;
    }
    s = 0;
    while s < sm_top(at) {
        let chain = ix_chain(at, s);
        let mut a = 0;
        while a < ints_len(chain) {
            let x = ints_get(chain, a);
            let ent = ints_get(at.kv, x);
            if ints_get(ds, ent) != s || ints_get(de, ent) != ints_get(at.ke, x) {
                let o = ints_get(slot, ent);
                let n = ints_get(r.uc, o);
                ints_set(r.us, ints_get(r.uf, o) + n, s);
                ints_set(r.ue, ints_get(r.uf, o) + n, ints_get(at.ke, x));
                ints_set(r.uc, o, n + 1);
            }
            a = a + 1;
        }
        s = s + 1;
    }
    i = 0;
    while i < ints_len(order) {
        let ent = ints_get(order, i);
        ints_push(r.k, ints_get(kind, ent));
        ints_push(r.og, ent);
        ints_push(r.ds, ints_get(ds, ent));
        ints_push(r.de, ints_get(de, ent));
        i = i + 1;
    }
    0
}

// How many entities the index holds; the kind of entity `i`, in the words an editor shows
// (`ReferenceTarget::kind`); where it is declared (absolute, -1 for nowhere); and its uses, in
// order, never the declaration.
pub fn ck_ref_count(c: Ck) -> Int {
    ix_build(c);
    ints_len(c.rix.k)
}
pub fn ck_ref_kind_name(c: Ck, i: Int) -> Str {
    let k = ints_get(c.rix.k, i);
    if k == 1 { return "function"; }
    if k == 2 { return "local"; }
    if k == 3 { return "record"; }
    if k == 4 { return "enum"; }
    if k == 5 { return "variant"; }
    if k == 6 { return "field"; }
    if k == 7 { return "payload field"; }
    if k == 8 { return "trait"; }
    if k == 9 { return "trait method"; }
    "constant"
}
// The owner the checker gives entity `i` where the index has no declaration of it (a tuple's record and fields, which are written nowhere): the record
// of a record or field entity, the enum of an enum, variant or payload field entity, else -1.
pub fn ck_ref_record(c: Ck, i: Int) -> Int {
    ix_build(c);
    let k = ints_get(c.rix.k, i);
    let ent = ints_get(c.rix.og, i);
    let brec = strs_len(c.fnname) + ints_len(c.bfn);
    if k == 3 { return ent - brec; }
    if k != 6 { return 0 - 1; }
    let bfld = brec + strs_len(c.rname) + strs_len(c.ename) + strs_len(c.vname);
    let f = ent - bfld;
    let mut r = 0;
    while r < strs_len(c.rname) {
        if f >= ints_get(c.rff, r) && f < ints_get(c.rff, r) + ints_get(c.rfc, r) { return r; }
        r = r + 1;
    }
    0 - 1
}
// The variant (a global index) entity `i` is or belongs to, else -1.
fn ck_ref_variant(c: Ck, i: Int) -> Int {
    let k = ints_get(c.rix.k, i);
    let ent = ints_get(c.rix.og, i);
    let benum = strs_len(c.fnname) + ints_len(c.bfn) + strs_len(c.rname);
    let bvar = benum + strs_len(c.ename);
    if k == 5 { return ent - bvar; }
    if k != 7 { return 0 - 1; }
    let f = ent - (bvar + strs_len(c.vname));
    let mut v = 0;
    while v < strs_len(c.vname) {
        if f >= ints_get(c.vff, v) && f < ints_get(c.vff, v) + ints_get(c.vfc, v) { return v; }
        v = v + 1;
    }
    0 - 1
}
pub fn ck_ref_enum(c: Ck, i: Int) -> Int {
    ix_build(c);
    let k = ints_get(c.rix.k, i);
    let ent = ints_get(c.rix.og, i);
    let benum = strs_len(c.fnname) + ints_len(c.bfn) + strs_len(c.rname);
    if k == 4 { return ent - benum; }
    let v = ck_ref_variant(c, i);
    if v < 0 { return 0 - 1; }
    let mut e = 0;
    while e < strs_len(c.ename) {
        if v >= ints_get(c.evf, e) && v < ints_get(c.evf, e) + ints_get(c.evc, e) { return e; }
        e = e + 1;
    }
    0 - 1
}
// The written name of a variant entity, or the `Variant.field` of a payload field entity; the name of a field entity.
pub fn ck_ref_member(c: Ck, i: Int) -> Str {
    let k = ints_get(c.rix.k, i);
    let ent = ints_get(c.rix.og, i);
    let bfld = strs_len(c.fnname) + ints_len(c.bfn) + strs_len(c.rname) + strs_len(c.ename) + strs_len(c.vname);
    if k == 6 { return strs_get(c.fname, ent - bfld); }
    let v = ck_ref_variant(c, i);
    if v < 0 { return ""; }
    if k == 5 { return strs_get(c.vname, v); }
    strs_get(c.vname, v) + "." + strs_get(c.fname, ent - bfld)
}
// The binding a local entity `i` is, else -1; the position of binding `b` among its function's bindings (its slot: a function's parameters come first).
pub fn ck_ref_binding(c: Ck, i: Int) -> Int {
    if ints_get(c.rix.k, i) != 2 { return 0 - 1; }
    let b = ints_get(c.rix.og, i) - strs_len(c.fnname);
    if b >= ints_len(c.bfn) { return 0 - 1; }
    b
}
// The function a function entity `i` is, else -1.
pub fn ck_ref_function(c: Ck, i: Int) -> Int {
    if ints_get(c.rix.k, i) != 1 { return 0 - 1; }
    ints_get(c.rix.og, i)
}
// The locals of function `fnid`, in the order the reference allocates their slots: its own bindings and the copies a closure takes of what it captures, merged by when each was
// made (a capture comes after the bindings that existed when its copy was made). An entry is a binding, or `-2 - k` for capture `k`.
pub fn ck_local_table(c: Ck, fnid: Int) -> Ints {
    index_bindings(c);
    let out = ints_new();
    if fnid < 0 || fnid >= strs_len(c.fnname) { return out; }
    let nb = ints_get(c.fbc, fnid);
    let nc = ints_get(c.fcc, fnid);
    let bf = ints_get(c.fbf, fnid);
    let cf = ints_get(c.fcf, fnid);
    let mut i = 0;
    let mut k = 0;
    while i < nb || k < nc {
        if k < nc && (i >= nb || ints_get(c.capat, ints_get(c.fcl, cf + k)) <= ints_get(c.fbl, bf + i)) {
            ints_push(out, 0 - 2 - ints_get(c.fcl, cf + k));
            k = k + 1;
        } else {
            ints_push(out, ints_get(c.fbl, bf + i));
            i = i + 1;
        }
    }
    out
}
// The closure a refused capture's mention (`ck_refused_capture_at`) is in, and the slot the reference names for it: that of the captured binding in the function declaring it, which the
// reference looks up in the closure's own locals (a capture it refused has no copy there).
pub fn ck_refused_fn(c: Ck, s: Int, e: Int) -> Int {
    let g = sm_get(c.mrefu, s, e);
    if g < 0 { return 0 - 1; }
    ints_get(c.rzf, g)
}
pub fn ck_refused_slot(c: Ck, s: Int, e: Int) -> Int {
    let g = sm_get(c.mrefu, s, e);
    if g < 0 { return 0 - 1; }
    let bid = ints_get(c.rzb, g);
    let table = ck_local_table(c, ints_get(c.bfn, bid));
    let mut i = 0;
    while i < ints_len(table) {
        if ints_get(table, i) == bid { return i; }
        i = i + 1;
    }
    0 - 1
}
pub fn ck_binding_slot(c: Ck, b: Int) -> Int {
    let f = ints_get(c.bfn, b);
    let mut n = 0;
    let mut i = 0;
    while i < b {
        if ints_get(c.bfn, i) == f { n = n + 1; }
        i = i + 1;
    }
    n
}
pub fn ck_ref_decl_start(c: Ck, i: Int) -> Int { ints_get(c.rix.ds, i) }
pub fn ck_ref_decl_end(c: Ck, i: Int) -> Int { ints_get(c.rix.de, i) }
pub fn ck_ref_use_count(c: Ck, i: Int) -> Int { ints_get(c.rix.uc, i) }
pub fn ck_ref_use_start(c: Ck, i: Int, k: Int) -> Int { ints_get(c.rix.us, ints_get(c.rix.uf, i) + k) }
pub fn ck_ref_use_end(c: Ck, i: Int, k: Int) -> Int { ints_get(c.rix.ue, ints_get(c.rix.uf, i) + k) }

// --- the call graph (R5 hand-back; `FnDef::call_sites`, `TraitCall`) -------------------------
//
// What each function's body calls: every call the checker recorded in it, in the order it recorded
// them. A site is a call of one of the compilation's functions, of a built-in, through a value of
// function type, or through a trait's method on a type parameter (`stm`: its place in the pool of
// methods, `ck_site_trait_method`), and a `spawn` is one too.

fn cg_build(c: Ck) -> Int {
    if ints_len(c.rix.cgn) > 0 { return 0; }
    ints_push(c.rix.cgn, 1);
    let n = strs_len(c.fnname);
    let r = c.rix;
    let mut i = 0;
    while i < n {
        ints_push(r.cgc, 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.sfn) {
        let g = ints_get(c.sfn, i);
        if g >= 0 { ints_set(r.cgc, g, ints_get(r.cgc, g) + 1); }
        i = i + 1;
    }
    let mut off = 0;
    i = 0;
    while i < n {
        ints_push(r.cgf, off);
        off = off + ints_get(r.cgc, i);
        ints_set(r.cgc, i, 0);
        i = i + 1;
    }
    i = 0;
    while i < off {
        ints_push(r.cgl, 0);
        i = i + 1;
    }
    i = 0;
    while i < ints_len(c.sfn) {
        let g = ints_get(c.sfn, i);
        if g >= 0 {
            ints_set(r.cgl, ints_get(r.cgf, g) + ints_get(r.cgc, g), i);
            ints_set(r.cgc, g, ints_get(r.cgc, g) + 1);
        }
        i = i + 1;
    }
    0
}

// How many calls function `i`'s body makes, and call `k` of them as a site (an index for the
// `ck_site_*` accessors).
pub fn ck_call_count(c: Ck, i: Int) -> Int {
    cg_build(c);
    ints_get(c.rix.cgc, i)
}
pub fn ck_call_site(c: Ck, i: Int, k: Int) -> Int { ints_get(c.rix.cgl, ints_get(c.rix.cgf, i) + k) }
// Where the callee is written (absolute), and whether the call is a `spawn`.
pub fn ck_site_start(c: Ck, site: Int) -> Int { ints_get(c.sstart, site) }
pub fn ck_site_end(c: Ck, site: Int) -> Int { ints_get(c.send, site) }
pub fn ck_site_spawned(c: Ck, site: Int) -> Bool { ints_get(c.sspawn, site) == 1 }

// --- provenance summaries (R5 hand-back; `FnDef::provenance`, N38) ----------------------------
//
// What each function's body makes of where its values come from, solved for the whole program as
// the language's one rule needs (`prov_solve`) — but for every program, not only where the rule
// could fire: the origins its result carries whatever it is given (`argument`, `file`,
// `authority`, `unknown`), the parameters whose provenance its result carries, those whose value
// may reach the path `write_file` writes to, and the origins the program's calls and `spawn`s
// hand each parameter. A function without a checked body has none.

fn pv_build(c: Ck) -> Int {
    if ints_len(c.rix.pvn) > 0 { return 0; }
    ints_push(c.rix.pvn, 1);
    let r = c.rix;
    let n = strs_len(c.fnname);
    let mut wide = false;
    let mut g = 0;
    while g < n {
        ints_push(r.pvh, 0);
        ints_push(r.pvo, 0);
        ints_push(r.pvp, 0);
        ints_push(r.pvr, 0);
        ints_push(r.pvf, 0);
        if ints_get(c.fnpc, g) + captures_of(c, g) > 60 { wide = true; }
        g = g + 1;
    }
    if wide || strs_len(c.stop) > 0 { return 0; }
    let pr = prov_solve(c);
    let ps = pr.ps;
    g = 0;
    while g < n {
        ints_set(r.pvf, g, ints_len(r.pvv));
        if index_of(c.fndups, g) >= 0 {
            // A function defined again: the reference gives the one it kept a solution that holds nothing.
            ints_set(r.pvh, g, 1);
            let mut i = 0;
            while i < ints_get(c.fnpc, g) {
                ints_push(r.pvv, 0);
                i = i + 1;
            }
        } else {
            if ints_get(ps.at, g) >= 0 {
                ints_set(r.pvh, g, 1);
                ints_set(r.pvo, g, ints_get(ps.so, g));
                ints_set(r.pvp, g, ints_get(ps.sp, g));
                ints_set(r.pvr, g, ps_reach(ps, g, 0));
                let mut i = 0;
                while i < ints_get(c.fnpc, g) {
                    ints_push(r.pvv, ints_get(ps.rcv, ints_get(ps.rcf, g) + i));
                    i = i + 1;
                }
            }
        }
        g = g + 1;
    }
    ss(c, s_module(), pr.saved);
    0
}

// What a sink of a class is, in a trace's first step (`sink_words`).
fn sink_words(class: Int) -> Str {
    if class == 0 { return "the path `write_file` writes to"; }
    if class == 1 { return "standard output or error"; }
    if class == 2 { return "what `write_file` writes"; }
    "a vouch"
}

// Every sink of every body as solved, with what reaches it and how (`solve`'s reports): its own flow's origins and what every caller hands the
// parameters it depends on, and for each origin one chain from where it entered to the sink.
fn sk_build(c: Ck, ps: Ps, pf: Pf) -> Int {
    let r = c.rix;
    let mut k = 0;
    while k < ints_len(pf.ffn) {
        let fg = ints_get(pf.ffn, k);
        let mut x = 0;
        while x < ints_get(pf.fsc, k) {
            let si = ints_get(pf.fsf, k) + x;
            let flow = vec_get(pf.kfl, si);
            let class = ints_get(pf.kcl, si);
            let mask = ps_reaching(ps, fg, flow);
            ints_push(r.skf, fg);
            ints_push(r.skc, class);
            ints_push(r.sks, ints_get(pf.kss, si));
            ints_push(r.ske, ints_get(pf.kse, si));
            ints_push(r.sko, mask);
            ints_push(r.skt, ints_len(r.tro));
            let origins = bits_of(mask);
            ints_push(r.skn, ints_len(origins));
            let mut j = 0;
            while j < ints_len(origins) {
                let o = ints_get(origins, j);
                let t = tr_new();
                tr_step(t, ints_get(pf.kss, si), ints_get(pf.kse, si), cat3("it reaches ", sink_words(class), " here"));
                tr_flow(c, ps, pf, t, k, flow, o, 0);
                ints_push(r.tro, o);
                ints_push(r.trf, ints_len(r.tss));
                ints_push(r.trn, ints_len(t.ss));
                let mut q = ints_len(t.ss) - 1;
                while q >= 0 {
                    ints_push(r.tss, ints_get(t.ss, q));
                    ints_push(r.tse, ints_get(t.se, q));
                    strs_push(r.tnote, strs_get(t.notes, q));
                    q = q - 1;
                }
                j = j + 1;
            }
            x = x + 1;
        }
        k = k + 1;
    }
    0
}

// The program solved again for its sinks, when first asked for: the summaries (`pv_build`) are not kept, and a tool that wants only those does
// not pay for the traces.
fn sk_solve(c: Ck) -> Int {
    let n = strs_len(c.fnname);
    let mut g = 0;
    while g < n {
        if ints_get(c.fnpc, g) + captures_of(c, g) > 60 {
            ints_push(c.rix.skw, 1);
            return 0;
        }
        g = g + 1;
    }
    if strs_len(c.stop) > 0 {
        ints_push(c.rix.skw, 1);
        return 0;
    }
    let pr = prov_solve(c);
    sk_build(c, pr.ps, pr.pf);
    ss(c, s_module(), pr.saved);
    0
}

pub fn ck_sink_count(c: Ck) -> Int {
    if ints_len(c.rix.skb) == 0 {
        ints_push(c.rix.skb, 1);
        sk_solve(c);
    }
    ints_len(c.rix.skf)
}
// Whether the program could not be solved for its sinks (a function too wide for a mask, a checker that stopped): none is then published.
pub fn ck_sink_declined(c: Ck) -> Bool { ints_len(c.rix.skw) > 0 }
pub fn ck_sink_function(c: Ck, i: Int) -> Str { strs_get(c.fnname, ints_get(c.rix.skf, i)) }
pub fn ck_sink_class(c: Ck, i: Int) -> Str {
    let k = ints_get(c.rix.skc, i);
    if k == 0 { return "path"; }
    if k == 1 { return "output"; }
    if k == 2 { return "file-data"; }
    "vouch"
}
pub fn ck_sink_start(c: Ck, i: Int) -> Int { ints_get(c.rix.sks, i) }
pub fn ck_sink_end(c: Ck, i: Int) -> Int { ints_get(c.rix.ske, i) }
pub fn ck_sink_origins(c: Ck, i: Int) -> Strs { pv_origin_names(ints_get(c.rix.sko, i)) }
pub fn ck_sink_traces(c: Ck, i: Int) -> Int { ints_get(c.rix.skn, i) }
pub fn ck_sink_trace_origin(c: Ck, i: Int, t: Int) -> Str {
    let o = ints_get(c.rix.tro, ints_get(c.rix.skt, i) + t);
    let names = pv_origin_names(pow2(o));
    strs_get(names, 0)
}
pub fn ck_sink_steps(c: Ck, i: Int, t: Int) -> Int { ints_get(c.rix.trn, ints_get(c.rix.skt, i) + t) }
fn sk_step(c: Ck, i: Int, t: Int, s: Int) -> Int { ints_get(c.rix.trf, ints_get(c.rix.skt, i) + t) + s }
pub fn ck_sink_step_start(c: Ck, i: Int, t: Int, s: Int) -> Int { ints_get(c.rix.tss, sk_step(c, i, t, s)) }
pub fn ck_sink_step_end(c: Ck, i: Int, t: Int, s: Int) -> Int { ints_get(c.rix.tse, sk_step(c, i, t, s)) }
pub fn ck_sink_step_note(c: Ck, i: Int, t: Int, s: Int) -> Str { strs_get(c.rix.tnote, sk_step(c, i, t, s)) }

pub fn ck_prov_has(c: Ck, g: Int) -> Bool {
    pv_build(c);
    ints_get(c.rix.pvh, g) == 1
}

fn pv_origin_names(mask: Int) -> Strs {
    let out = strs_new();
    if has_bit(mask, 0) { strs_push(out, "argument"); }
    if has_bit(mask, 1) { strs_push(out, "file"); }
    if has_bit(mask, 2) { strs_push(out, "authority"); }
    if has_bit(mask, 3) { strs_push(out, "unknown"); }
    out
}

// The origins its result carries, by name in id order.
pub fn ck_prov_origins(c: Ck, g: Int) -> Strs { pv_origin_names(ints_get(c.rix.pvo, g)) }
// The parameters (and captures, after them) whose provenance its result carries, in order.
pub fn ck_prov_passes_on(c: Ck, g: Int) -> Ints { bits_of(ints_get(c.rix.pvp, g)) }
// The parameters whose value may reach the path a `write_file` writes to, in order.
pub fn ck_prov_reaches(c: Ck, g: Int) -> Ints {
    let out = ints_new();
    let bits = bits_of(ints_get(c.rix.pvr, g));
    let mut i = 0;
    while i < ints_len(bits) {
        if ints_get(bits, i) < ints_get(c.fnpc, g) { ints_push(out, ints_get(bits, i)); }
        i = i + 1;
    }
    out
}
// The origins the program's calls hand parameter `i`, by name in id order.
pub fn ck_prov_receives(c: Ck, g: Int, i: Int) -> Strs { pv_origin_names(ints_get(c.rix.pvv, ints_get(c.rix.pvf, g) + i)) }

// --- the types of records' fields (R5 hand-back) ----------------------------------------------
//
// `ck_record_type` is the type of record `r` itself (the definition with no arguments), and
// `ck_enum_type` of enum `e`, or -1 where the checker never made it; they make none, so asking
// changes nothing a later answer (Core IR's table of types) reads. With them a definition's fields
// and payloads are read as `ck_record_field_name`, `ck_record_field_ty`, `ck_variant_name` and
// `ck_payload_ty` read them of a type: a definition's as declared, naming its own parameters.

pub fn ck_record_type(c: Ck, r: Int) -> Int {
    let mut t = 0;
    while t < strs_len(c.tykey) {
        if ints_get(c.tytag, t) == tag_record() && ints_get(c.tya, t) == r && ints_get(c.tyargc, t) == 0 { return t; }
        t = t + 1;
    }
    0 - 1
}
pub fn ck_enum_type(c: Ck, e: Int) -> Int {
    let mut t = 0;
    while t < strs_len(c.tykey) {
        if ints_get(c.tytag, t) == tag_enum() && ints_get(c.tya, t) == e && ints_get(c.tyargc, t) == 0 { return t; }
        t = t + 1;
    }
    0 - 1
}
// A record type's field `i`'s type, as the type has it: a definition's as declared, an
// application's with its arguments for the parameters (`ck_payload_ty`'s counterpart).
pub fn ck_record_field_ty(c: Ck, t: Int, i: Int) -> Int { field_ty_in(c, t, ints_get(c.rff, ta(c, t)) + i) }
