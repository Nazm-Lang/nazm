// Loops and mutation.
//
// `nazm run examples/sum.nz` prints 6074:
//   sum_to(100)            = 5050
//   double_n_times(1, 10)  = 1024

fn sum_to(n: Int) -> Int {
    let mut total = 0;
    let mut i = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    total
}

fn double_n_times(start: Int, times: Int) -> Int {
    let mut value = start;
    let mut left = times;
    while left > 0 {
        value = value * 2;
        left = left - 1;
    }
    value
}

fn main(out: OutCap) -> Int {
    print(str_concat(int_to_str(sum_to(100) + double_n_times(1, 10)), str_from_byte(10)));
    0
}
