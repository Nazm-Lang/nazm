// pagestore: a page-structured store with a write-ahead log (Gate 3 reference workload,
// `docs/systems-domains.md` Part M).
//
//     pagestore DIR SCRIPT [CRASH_AT] [recover]
//
// The store is two files in DIR. `pages` is sixteen fixed 256-byte pages, each its number, how many
// of its fourteen slots hold a key, the slots — a key and a value, eight bytes each, little-endian —
// and a checksum over the rest. `wal` is the redo log: one 288-byte record per change, the changed
// page's whole image after the change, with a sequence number and a checksum. A `put` writes its
// record and syncs the log before it writes the page in place, and answers `ok` only then; a
// checkpoint syncs the pages and empties the log. Opening replays every whole record in order and
// stops at the first that is not — a record torn by a crash was never acknowledged — so a page torn
// by a crash is rewritten from its image. `LOCK` holds the store for one process; `recover` breaks
// the lock a crash left.
//
// CRASH_AT simulates a crash at a write boundary: the CRASH_AT-th write of the run writes half its
// bytes and the process stops, as a power cut would leave it. The tests crash a run at every
// boundary and check what a recovering open finds.
//
// SCRIPT holds one command per line:
//
//     put KEY VALUE   get KEY   dump   checkpoint   reopen   serve READERS ROUNDS
//
// `serve` runs one writer task and READERS reader tasks, each making ROUNDS requests, through
// channels to the store's one owner, this task: concurrent readers, one writer, and the store's
// files touched by one task only.

use "@std/ioerror";
use "@std/file";
use "@std/fs";
use "@std/io";
use "@std/text";

fn page_count() -> Int ! {} { 16 }
fn page_bytes() -> Int ! {} { 256 }
fn slots() -> Int ! {} { 14 }
fn record_bytes() -> Int ! {} { 288 }
fn magic() -> Int ! {} { 5638093645399082316 }

struct Store {
    /// Every page, as on disk once the log is applied.
    pages: Bytes,
    data: File,
    /// One cell each: the log's length, the next record's sequence, the writes this run made.
    wal_len: Ints,
    seq: Ints,
    writes: Ints,
    /// The write that crashes, or 0.
    crash_at: Int,
}

/// FNV-1a over `b`'s bytes `lo..hi`, as an `Int`.
fn checksum(b: Bytes, lo: Int, hi: Int) -> Int ! {} {
    let mut h = UInt64(14695981039346656037);
    let mut i = lo;
    while i < hi {
        h = wrapping_mul(h ^ UInt64(bytes_get(b, i)), UInt64(1099511628211));
        i = i + 1;
    }
    wrap_convert[Int](h)
}

fn page(s: Store, p: Int) -> Bytes ! {} {
    bytes_slice(s.pages, p * page_bytes(), (p + 1) * page_bytes())
}

/// `pg`'s checksum, written into its last eight bytes.
fn seal(pg: Bytes) -> Int ! {} {
    bytes_write_le(pg, page_bytes() - 8, checksum(pg, 0, page_bytes() - 8))
}

fn sealed(pg: Bytes) -> Bool ! {} {
    bytes_read_le[Int](pg, page_bytes() - 8) == checksum(pg, 0, page_bytes() - 8)
}

fn show(e: IoError) -> Str ! {} {
    io_error_show(e)
}

/// One write of `data` at `offset`: the run's next write boundary. At `crash_at` only half of it is
/// written, and the run stops.
fn write_at(s: Store, f: File, offset: Int, data: Bytes) -> Result[Int, Str] ! { io } {
    let n = ints_get(s.writes, 0) + 1;
    ints_set(s.writes, 0, n);
    match file_seek(f, offset) {
        Result.Ok(value: p) => {},
        Result.Err(error: e) => { return Result[Int, Str].Err(error: show(e)); },
    };
    if n == s.crash_at {
        file_write(f, bytes_slice(data, 0, bytes_len(data) / 2));
        file_sync(f);
        return Result[Int, Str].Err(error: str_concat("crashed at write ", int_to_str(n)));
    }
    match file_write(f, data) {
        Result.Ok(value: w) => Result[Int, Str].Ok(value: w),
        Result.Err(error: e) => Result[Int, Str].Err(error: show(e)),
    }
}

fn sync(f: File) -> Result[Int, Str] ! { io } {
    match file_sync(f) {
        Result.Ok(value: w) => Result[Int, Str].Ok(value: w),
        Result.Err(error: e) => Result[Int, Str].Err(error: show(e)),
    }
}

fn path(dir: Str, name: Str) -> Str ! {} {
    str_concat(str_concat(dir, "/"), name)
}

/// The store in `dir`, its log replayed and checkpointed; held by this process until it closes.
fn open(io: IoCap, dir: Str, crash_at: Int, writes: Ints, recover: Bool) -> Result[Store, Str] ! { io } {
    let lock = path(dir, "LOCK");
    if recover && file_exists_at(io, lock) {
        file_remove(io, lock);
    }
    match file_create_new(io, lock) {
        Result.Ok(value: l) => { file_close(l); },
        Result.Err(error: e) => {
            return Result[Store, Str].Err(error: str_concat("the store is held by another process, or a crash left its lock: ", lock));
        },
    };
    let total = page_count() * page_bytes();
    let pages = bytes_new(total);
    let fresh = !file_exists_at(io, path(dir, "pages"));
    if !fresh {
        match file_read_all(io, path(dir, "pages")) {
            Result.Ok(value: b) => {
                bytes_copy(pages, bytes_slice(b, 0, if bytes_len(b) < total { bytes_len(b) } else { total }));
            },
            Result.Err(error: e) => { return Result[Store, Str].Err(error: show(e)); },
        };
    }
    // A new store: every page empty and sealed, the file made whole in one atomic replacement —
    // a crash leaves no file or all of it, and no page the log would have to repair.
    if fresh {
        let mut p = 0;
        while p < page_count() {
            let pg = bytes_slice(pages, p * page_bytes(), (p + 1) * page_bytes());
            bytes_write_le(pg, 0, p);
            seal(pg);
            p = p + 1;
        }
        let n = ints_get(writes, 0) + 1;
        ints_set(writes, 0, n);
        if n == crash_at {
            return Result[Store, Str].Err(error: str_concat("crashed at write ", int_to_str(n)));
        }
        match file_replace_atomic(io, path(dir, "pages"), pages) {
            Result.Ok(value: n) => {},
            Result.Err(error: e) => { return Result[Store, Str].Err(error: show(e)); },
        };
    }
    let data = match file_open_rw(io, path(dir, "pages")) {
        Result.Ok(value: f) => f,
        Result.Err(error: e) => { return Result[Store, Str].Err(error: show(e)); },
    };
    let log = if file_exists_at(io, path(dir, "wal")) {
        match file_read_all(io, path(dir, "wal")) {
            Result.Ok(value: b) => b,
            Result.Err(error: e) => { return Result[Store, Str].Err(error: show(e)); },
        }
    } else {
        bytes_new(0)
    };
    let s = Store(pages: pages, data: data, wal_len: ints_new(), seq: ints_new(), writes: writes, crash_at: crash_at);
    ints_push(s.wal_len, 0);
    ints_push(s.seq, 1);
    // The log, replayed in order: each whole record's image over its page, to the first record
    // that is torn, out of sequence or not one at all.
    let mut at = 0;
    let mut replayed = 0;
    let mut whole = true;
    while whole && at + record_bytes() <= bytes_len(log) {
        let rec = bytes_slice(log, at, at + record_bytes());
        let p = bytes_read_le[Int](rec, 16);
        whole = bytes_read_le[Int](rec, 0) == magic()
            && bytes_read_le[Int](rec, 8) == ints_get(s.seq, 0)
            && bytes_read_le[Int](rec, record_bytes() - 8) == checksum(rec, 0, record_bytes() - 8)
            && p >= 0 && p < page_count();
        if whole {
            let pg = page(s, p);
            bytes_copy(pg, bytes_slice(rec, 24, 24 + page_bytes()));
            write_at(s, s.data, p * page_bytes(), pg)?;
            ints_set(s.seq, 0, ints_get(s.seq, 0) + 1);
            replayed = replayed + 1;
            at = at + record_bytes();
        }
    }
    // Every page whole now: a page torn by a crash had its image in the log.
    let mut p = 0;
    while p < page_count() {
        if !sealed(page(s, p)) {
            return Result[Store, Str].Err(error: str_concat("page is corrupt and the log has no image of it: ", int_to_str(p)));
        }
        p = p + 1;
    }
    checkpoint(io, dir, s)?;
    Result[Store, Str].Ok(value: s)
}

/// The pages synced, then the log emptied: what it held is in the pages. The directory is the
/// command line's, never the store's: a path is not made of what a file held.
fn checkpoint(io: IoCap, dir: Str, s: Store) -> Result[Int, Str] ! { io } {
    sync(s.data)?;
    match file_replace_atomic(io, path(dir, "wal"), bytes_new(0)) {
        Result.Ok(value: n) => {},
        Result.Err(error: e) => { return Result[Int, Str].Err(error: show(e)); },
    };
    ints_set(s.wal_len, 0, 0);
    ints_set(s.seq, 0, 1);
    Result[Int, Str].Ok(value: 0)
}

/// Where `key` lives: its page.
fn page_of(key: Int) -> Int ! {} {
    ((key % page_count()) + page_count()) % page_count()
}

/// The slot of `key` in `pg`, or -1.
fn slot_of(pg: Bytes, key: Int) -> Int ! {} {
    let used = bytes_read_le[Int](pg, 8);
    let mut found = -1;
    let mut i = 0;
    while i < slots() {
        if found < 0 && i < used && bytes_read_le[Int](pg, 16 + i * 16) == key {
            found = i;
        }
        i = i + 1;
    }
    found
}

fn get(s: Store, key: Int) -> Option[Int] ! {} {
    let pg = page(s, page_of(key));
    let i = slot_of(pg, key);
    if i < 0 { Option[Int].None() } else { Option[Int].Some(value: bytes_read_le[Int](pg, 24 + i * 16)) }
}

/// `key` set to `value`: the page's new image logged and synced, then the page written.
fn put(io: IoCap, dir: Str, s: Store, key: Int, value: Int) -> Result[Str, Str] ! { io } {
    let p = page_of(key);
    let image = bytes_new(page_bytes());
    bytes_copy(image, page(s, p));
    let mut i = slot_of(image, key);
    if i < 0 {
        i = bytes_read_le[Int](image, 8);
        if i == slots() {
            return Result[Str, Str].Err(error: str_concat("its page is full: ", int_to_str(key)));
        }
        bytes_write_le(image, 8, i + 1);
        bytes_write_le(image, 16 + i * 16, key);
    }
    bytes_write_le(image, 24 + i * 16, value);
    seal(image);
    let rec = bytes_new(record_bytes());
    bytes_write_le(rec, 0, magic());
    bytes_write_le(rec, 8, ints_get(s.seq, 0));
    bytes_write_le(rec, 16, p);
    bytes_copy(bytes_slice(rec, 24, 24 + page_bytes()), image);
    bytes_write_le(rec, record_bytes() - 8, checksum(rec, 0, record_bytes() - 8));
    // The log opened for this record: a checkpoint replaces the file, and a handle kept across one
    // would write to the file it replaced.
    let wal = match file_append(io, path(dir, "wal")) {
        Result.Ok(value: f) => f,
        Result.Err(error: e) => { return Result[Str, Str].Err(error: show(e)); },
    };
    write_at(s, wal, ints_get(s.wal_len, 0), rec)?;
    sync(wal)?;
    file_close(wal);
    ints_set(s.wal_len, 0, ints_get(s.wal_len, 0) + record_bytes());
    ints_set(s.seq, 0, ints_get(s.seq, 0) + 1);
    bytes_copy(page(s, p), image);
    write_at(s, s.data, p * page_bytes(), image)?;
    Result[Str, Str].Ok(value: "ok")
}

/// Every key and its value, page by page, slot by slot.
fn dump(s: Store) -> Str ! {} {
    let out = strs_new();
    let mut p = 0;
    while p < page_count() {
        let pg = page(s, p);
        let mut i = 0;
        while i < bytes_read_le[Int](pg, 8) {
            strs_push(out, str_concat(str_concat(int_to_str(bytes_read_le[Int](pg, 16 + i * 16)), "="), int_to_str(bytes_read_le[Int](pg, 24 + i * 16))));
            i = i + 1;
        }
        p = p + 1;
    }
    str_join(out, " ")
}

/// The lock released; the store is closed.
fn close(io: IoCap, dir: Str, s: Store) -> Result[Int, Str] ! { io } {
    checkpoint(io, dir, s)?;
    file_close(s.data);
    file_remove(io, path(dir, "LOCK"));
    Result[Int, Str].Ok(value: 0)
}

/// A request to the store's owner: a `get` from a reader, a `put` from the writer, or a client
/// saying it is done.
struct Req {
    client: Int,
    kind: Int,
    key: Int,
    value: Int,
}

fn reader(id: Int, rounds: Int, requests: Chan[Req], answers: Chan[Int]) -> Int ! {} {
    let got = vec_new[Int]();
    let mut seen = 0;
    let mut i = 0;
    while i < rounds {
        chan_send_of(requests, Req(client: id, kind: 0, key: i, value: 0));
        if chan_recv_of(answers, got) {
            if vec_pop(got) >= 0 {
                seen = seen + 1;
            }
        }
        i = i + 1;
    }
    chan_send_of(requests, Req(client: id, kind: 2, key: seen, value: 0));
    0
}

fn writer(rounds: Int, requests: Chan[Req]) -> Int ! {} {
    let mut i = 0;
    while i < rounds {
        chan_send_of(requests, Req(client: -1, kind: 1, key: i, value: i * 10));
        i = i + 1;
    }
    chan_send_of(requests, Req(client: -1, kind: 2, key: 0, value: 0));
    0
}

/// One writer and `readers` readers, through channels to this task, which alone touches the files.
fn serve(io: IoCap, dir: Str, s: Store, readers: Int, rounds: Int, t: SpawnCap) -> Result[Str, Str] ! { io, spawn } {
    let requests = chan_new_of[Req](16);
    let answers = vec_new[Chan[Int]]();
    let mut r = 0;
    while r < readers {
        vec_push(answers, chan_new_of[Int](1));
        r = r + 1;
    }
    let mut puts = 0;
    let mut gets = 0;
    let mut done = 0;
    let mut failed = "";
    scope {
        spawn writer(rounds, requests);
        let mut k = 0;
        while k < readers {
            spawn reader(k, rounds, requests, vec_get(answers, k));
            k = k + 1;
        }
        let got = vec_new[Req]();
        while done < readers + 1 && chan_recv_of(requests, got) {
            let q = vec_pop(got);
            if q.kind == 0 {
                gets = gets + 1;
                chan_send_of(vec_get(answers, q.client), match get(s, q.key) {
                    Option.Some(value: v) => v,
                    Option.None() => -1,
                });
            } else {
                if q.kind == 1 {
                    puts = puts + 1;
                    match put(io, dir, s, q.key, q.value) {
                        Result.Ok(value: a) => {},
                        Result.Err(error: e) => { failed = e; },
                    };
                } else {
                    done = done + 1;
                }
            }
        }
    }
    if str_len(failed) > 0 {
        return Result[Str, Str].Err(error: failed);
    }
    Result[Str, Str].Ok(value: str_concat(str_concat(str_concat("served ", int_to_str(puts)), " puts and "), str_concat(int_to_str(gets), " gets")))
}

fn word(words: Strs, i: Int) -> Int ! {} {
    match text_parse_int(strs_get(words, i)) {
        Result.Ok(value: n) => n,
        Result.Err(error: e) => 0,
    }
}

fn main(io: IoCap, t: SpawnCap) -> Int ! { io, spawn } {
    if args_count() < 2 {
        io_eprintln(io, "usage: pagestore DIR SCRIPT [CRASH_AT] [recover]");
        return exit_with(2);
    }
    let dir = arg(0);
    let crash_at = if args_count() > 2 {
        match text_parse_int(arg(2)) {
            Result.Ok(value: n) => n,
            Result.Err(error: e) => 0,
        }
    } else {
        0
    };
    let recover = args_count() > 3 && arg(3) == "recover";
    let script = match fs_read_lines(io, arg(1)) {
        Result.Ok(value: l) => l,
        Result.Err(error: e) => {
            io_eprintln(io, str_concat("pagestore: ", e));
            return exit_with(1);
        },
    };
    let writes = ints_new();
    ints_push(writes, 0);
    let mut s = match open(io, dir, crash_at, writes, recover) {
        Result.Ok(value: s) => s,
        Result.Err(error: e) => {
            io_eprintln(io, str_concat("pagestore: ", e));
            return exit_with(if text_contains(e, "crashed at write") { 3 } else { 1 });
        },
    };
    let mut i = 0;
    while i < strs_len(script) {
        let line = text_trim(strs_get(script, i));
        let words = text_split(line, " ");
        let n = strs_len(words);
        let answer = if n == 3 && strs_get(words, 0) == "put" {
            put(io, dir, s, word(words, 1), word(words, 2))
        } else {
            if n == 2 && strs_get(words, 0) == "get" {
                Result[Str, Str].Ok(value: match get(s, word(words, 1)) {
                    Option.Some(value: v) => int_to_str(v),
                    Option.None() => "(none)",
                })
            } else {
                if line == "dump" {
                    Result[Str, Str].Ok(value: dump(s))
                } else {
                    if line == "checkpoint" {
                        match checkpoint(io, dir, s) {
                            Result.Ok(value: z) => Result[Str, Str].Ok(value: "checkpointed"),
                            Result.Err(error: e) => Result[Str, Str].Err(error: e),
                        }
                    } else {
                        if line == "reopen" {
                            match close(io, dir, s) {
                                Result.Ok(value: z) => {},
                                Result.Err(error: e) => {
                                    io_eprintln(io, str_concat("pagestore: ", e));
                                    return exit_with(1);
                                },
                            };
                            s = match open(io, dir, crash_at, writes, false) {
                                Result.Ok(value: o) => o,
                                Result.Err(error: e) => {
                                    io_eprintln(io, str_concat("pagestore: ", e));
                                    return exit_with(1);
                                },
                            };
                            Result[Str, Str].Ok(value: "reopened")
                        } else {
                            if n == 3 && strs_get(words, 0) == "serve" {
                                serve(io, dir, s, word(words, 1), word(words, 2), t)
                            } else {
                                Result[Str, Str].Err(error: str_concat("not a command: ", line))
                            }
                        }
                    }
                }
            }
        };
        match answer {
            Result.Ok(value: a) => { io_println(io, str_concat(str_concat(line, " -> "), a)); },
            Result.Err(error: e) => {
                io_eprintln(io, str_concat("pagestore: ", e));
                return exit_with(if text_contains(e, "crashed at write") { 3 } else { 1 });
            },
        };
        i = i + 1;
    }
    match close(io, dir, s) {
        Result.Ok(value: z) => {},
        Result.Err(error: e) => {
            io_eprintln(io, str_concat("pagestore: ", e));
            return exit_with(if text_contains(e, "crashed at write") { 3 } else { 1 });
        },
    };
    io_println(io, str_concat("writes ", int_to_str(ints_get(writes, 0))));
    0
}
