// Starting a task is the `spawn` effect, and a task's own effects are its spawner's too.
// `run` declares both; `worker` declares only what it does. Prints 30.

fn worker(jobs: Chan, results: Chan) -> Int ! {} {
    let buf = ints_new();
    while chan_recv(jobs, buf) {
        chan_send(results, ints_pop(buf) * 3);
    }
    0
}

fn feeder(jobs: Chan) -> Int ! {} {
    let mut i = 0;
    while i < 5 {
        chan_send(jobs, i);
        i = i + 1;
    }
    chan_close(jobs);
    0
}

fn run() -> Int ! { io, spawn } {
    let jobs = chan_new(2);
    let results = chan_new(2);
    let buf = ints_new();
    let mut total = 0;
    scope {
        spawn feeder(jobs);
        spawn worker(jobs, results);
        let mut got = 0;
        while got < 5 {
            chan_recv(results, buf);
            total = total + ints_pop(buf);
            got = got + 1;
        }
    }
    chan_close(results);
    print(int_to_str(total));
    print(str_from_byte(10))
}

fn main() -> Int {
    run();
    0
}
