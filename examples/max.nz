// The positive example: a function call and a conditional.
//
// `nazm run examples/max.nz` prints 25.

fn max(a: Int, b: Int) -> Int {
    if a > b { a } else { b }
}

fn clamp(value: Int, lo: Int, hi: Int) -> Int {
    let lower = max(value, lo);
    if lower > hi { hi } else { lower }
}

fn main(out: OutCap) -> Int {
    let x = 17;
    let y = 25;
    print(str_concat(int_to_str(clamp(max(x, y), 0, 100)), "\n"));
    0
}
