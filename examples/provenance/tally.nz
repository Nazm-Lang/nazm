// Where values come from (N38). `tally` reads a file, so its text is from a file's contents;
// `lines` is pure and computes over it, and the count it returns is from the file too — but
// computing over input is not an effect, so `lines` declares `! {}`. The count is written to
// a path this program chose, which is allowed; writing to a path read out of the file would
// be refused (`N0372`). Run with `nazm run`; it prints the number of lines in this file.

use "store.nz";

fn lines(text: Str) -> Int ! {} {
    let mut n = 0;
    let mut i = 0;
    while i < str_len(text) {
        if str_byte(text, i) == 10 {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

fn main(io: IoCap) -> Int ! { io } {
    let text = read_file("tally.nz");
    let n = lines(text);
    save(io, "tally.out", int_to_str(n));
    print(int_to_str(n));
    print(str_from_byte(10));
    0
}
