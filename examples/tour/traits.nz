// Traits are nominal and static: each method call resolves to one impl at compile time,
// including through a bound on a type parameter.
trait Area {
    fn area(self: Self) -> Int;
}

struct Rect {
    w: Int,
    h: Int,
}

struct Square {
    side: Int,
}

impl Area for Rect {
    fn area(self: Rect) -> Int { self.w * self.h }
}

impl Area for Square {
    fn area(self: Square) -> Int { self.side * self.side }
}

fn doubled[T: Area](shape: T) -> Int {
    shape.area() * 2
}

fn main() {
    let r = Rect(w: 3, h: 4);
    println(r.area() + doubled(Square(side: 5)))
}
