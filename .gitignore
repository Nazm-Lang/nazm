/target
**/*.rs.bk
.DS_Store

# Compiler artifact store. Content-addressed and reproducible by construction,
# so it is a cache, never a source of truth. See docs/internal/architecture.md.
.nazm/

# Benchmark output: run logs, trajectories, and cost records. Large, and the
# holdout results must be published deliberately rather than committed by accident.
/bench-runs/

# Review bundles are local evidence artefacts, regenerated per milestone. Keeping them
# out of history stops the repository growing by a snapshot of itself each time.
/review/m1d/
/review/m1e/
/review/*.tar.gz

# The bootstrap writes here.
/target/bootstrap/

# The benchmark runner writes this per run; the baseline beside it is committed.
/bench/record.json
/target/bench-scratch/

# Agent working state is local and machine-specific (docs/internal/agent-governance.md §6).
/.agent/state.md
/.agent/plans/
