// expect: N0616
// Two containers each meant to hold a closure capturing the other cannot be built: the first
// capture is refused (spec: memory, Cycles).
fn main() -> Int {
    let a = vec_new[fn() -> Int]();
    let b = vec_new[fn() -> Int]();
    let fa = fn() -> Int { vec_len(b) };
    let fb = fn() -> Int { vec_len(a) };
    vec_push(a, fa);
    vec_push(b, fb);
    0
}
