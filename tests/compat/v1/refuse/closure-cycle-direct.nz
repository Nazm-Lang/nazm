// expect: N0616
// A closure owns what it captures; capturing a container that can hold function values is
// refused, so a closure can never come to own itself (spec: memory, Cycles; function-values).
fn main() -> Int {
    let fs = vec_new[fn() -> Int]();
    let f = fn() -> Int { vec_len(fs) };
    vec_push(fs, f);
    vec_len(fs)
}
