// Exactly one variant is active; `match` is an exhaustive expression (spec: enums).
enum Shape {
    Circle(r: Int),
    Rect(w: Int, h: Int),
    Empty,
}

fn area(s: Shape) -> Int {
    match s {
        Shape.Circle(r: r) => 3 * r * r,
        Shape.Rect(w: w, h: h) => w * h,
        Shape.Empty() => 0,
    }
}

fn main() -> Int {
    area(Shape.Circle(r: 2)) + area(Shape.Rect(h: 3, w: 4)) + area(Shape.Empty())
}
