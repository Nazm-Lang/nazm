// Patterns — wildcards, names, literals, alternatives, nesting, `if let`, `let … else` — and
// tuples (spec: patterns, tuples).
fn kind(n: Int) -> Str {
    match n {
        0 => "zero",
        1 | 2 | 3 => "small",
        _ => "large",
    }
}

fn swap(p: (Int, Str)) -> (Str, Int) {
    let (a, b) = p
    (b, a)
}

fn first_even(xs: Ints) -> Int {
    for x in xs {
        if x % 2 == 0 { return x }
    }
    0 - 1
}

fn check(o: Option[Int]) -> Int {
    let Some(v) = o else { return 0 }
    v * 10
}

fn main() {
    println(f"{kind(0)} {kind(2)} {kind(9)}")
    let t = swap((7, "seven"))
    println(f"{t.0} {t.1}")
    println(first_even([1, 3, 8, 10]))
    if let Some(v) = Some(5) { println(v) }
    println(check(Some(4)) + check(None))
}
