// Building a large `Str`.
//
// Through `strs_push` and one `str_join`, which is the shape the compiler's own output
// assembly uses — `str_concat` in a loop is quadratic and exhausted memory before
// `str_join` existed.

fn main() {
    let parts = strs_new();
    let mut i = 0;
    while i < 60000 {
        strs_push(parts, int_to_str(i));
        i = i + 1;
    }
    println(str_len(str_join(parts, ", ")))
}
