use "@std/text"

fn is_prime(n: Int) -> Bool {
    if n < 2 { return false }
    if n % 2 == 0 { return n == 2 }
    let mut d = 3
    while d * d <= n {
        if n % d == 0 { return false }
        d += 2
    }
    true
}

// Blocks of 1,000 numbers below 3,000,000: block b is worker b mod W's.
fn count(w: Int, workers: Int, out: Chan) {
    let mut found = 0
    let mut b = w
    while b < 3000 {
        let mut n = b * 1000
        while n < b * 1000 + 1000 {
            if is_prime(n) { found += 1 }
            n += 1
        }
        b += workers
    }
    chan_send(out, found)
}

fn main(io: IoCap, tasks: SpawnCap) {
    let workers = match text_parse_int(arg(0)) {
        Result.Ok(value: n) => n,
        Result.Err(error: e) => 1,
    }
    let out = chan_new(workers)
    scope {
        let mut w = 0
        while w < workers {
            spawn count(w, workers, out)
            w += 1
        }
    }
    chan_close(out)
    let buf = ints_new()
    let mut total = 0
    while chan_recv(out, buf) { total += ints_pop(buf) }
    println(total)
}
