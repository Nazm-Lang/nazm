// Concurrency 6.1: fan-in — P producers (8 by default) each send 1,000,000 / P integers into one
// channel of capacity 1,024; one consumer (main) sums them and prints the sum.
use "@std/text"

fn produce(from: Int, count: Int, c: Chan) -> Int {
    let mut i = from
    while i < from + count {
        chan_send(c, i)
        i += 1
    }
    0
}

fn feed(producers: Int, each: Int, c: Chan, tasks: SpawnCap) -> Int ! {spawn} {
    scope {
        let mut p = 0
        while p < producers {
            spawn produce(p * each, each, c)
            p += 1
        }
    }
    chan_close(c)
}

fn main(io: IoCap, tasks: SpawnCap) {
    let producers = match text_parse_int(arg(0)) {
        Result.Ok(value: v) => v,
        Result.Err(error: e) => 8,
    }
    let each = 1000000 / producers
    let c = chan_new(1024)
    let buf = ints_new()
    let mut sum = 0
    scope {
        spawn feed(producers, each, c, tasks)
        while chan_recv(c, buf) { sum += ints_pop(buf) }
    }
    println(sum)
}
