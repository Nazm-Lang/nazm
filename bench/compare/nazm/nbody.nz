use "@std/text"

struct Body { x: Float64, y: Float64, z: Float64, vx: Float64, vy: Float64, vz: Float64, mass: Float64 }

fn body(x: Float64, y: Float64, z: Float64, vx: Float64, vy: Float64, vz: Float64, m: Float64, solar: Float64) -> Body {
    let days = 365.24
    Body(x: x, y: y, z: z, vx: vx * days, vy: vy * days, vz: vz * days, mass: m * solar)
}

fn energy(b: [Body; 5]) -> Float64 {
    let mut e = 0.0
    for i in 0..5 {
        let a = b[i]
        e += 0.5 * a.mass * (a.vx * a.vx + a.vy * a.vy + a.vz * a.vz)
        for j in i + 1..5 {
            let c = b[j]
            let dx = a.x - c.x
            let dy = a.y - c.y
            let dz = a.z - c.z
            e -= a.mass * c.mass / float_sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    e
}

fn advance(state: [Body; 5], dt: Float64) -> [Body; 5] {
    let mut b = state
    for i in 0..5 {
        for j in i + 1..5 {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * float_sqrt(d2))
            let mi = b[i].mass
            let mj = b[j].mass
            b[i].vx -= dx * mj * mag
            b[i].vy -= dy * mj * mag
            b[i].vz -= dz * mj * mag
            b[j].vx += dx * mi * mag
            b[j].vy += dy * mi * mag
            b[j].vz += dz * mi * mag
        }
    }
    for k in 0..5 {
        b[k].x += dt * b[k].vx
        b[k].y += dt * b[k].vy
        b[k].z += dt * b[k].vz
    }
    b
}

fn main(io: IoCap) {
    let n = match text_parse_int(arg(0)) {
        Result.Ok(value: v) => v,
        Result.Err(error: e) => 1000,
    }
    let pi = 3.141592653589793
    let solar = 4.0 * pi * pi
    let mut b: [Body; 5] = [
        Body(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar),
        body(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04, solar),
        body(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04, solar),
        body(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05, solar),
        body(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05, solar),
    ]
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for k in 0..5 {
        let a = b[k]
        px += a.vx * a.mass
        py += a.vy * a.mass
        pz += a.vz * a.mass
    }
    b[0].vx = -px / solar
    b[0].vy = -py / solar
    b[0].vz = -pz / solar
    println(f"{energy(b):.9}")
    for step in 0..n {
        b = advance(b, 0.01)
    }
    println(f"{energy(b):.9}")
}
