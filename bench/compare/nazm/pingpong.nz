// Concurrency 6.1: channel ping-pong — N round trips (100,000 by default) between two tasks over
// two channels of capacity 1; prints the sum of the values that came back.
use "@std/text"

fn ponger(ping: Chan, pong: Chan) -> Int {
    let buf = ints_new()
    while chan_recv(ping, buf) {
        chan_send(pong, ints_pop(buf) + 1)
    }
    chan_close(pong)
}

fn pinger(n: Int, ping: Chan, pong: Chan, out: Chan) -> Int {
    let buf = ints_new()
    let mut sum = 0
    let mut i = 0
    while i < n {
        chan_send(ping, i)
        if chan_recv(pong, buf) { sum += ints_pop(buf) }
        i += 1
    }
    chan_close(ping)
    chan_send(out, sum)
    0
}

fn main(io: IoCap, tasks: SpawnCap) {
    let n = match text_parse_int(arg(0)) {
        Result.Ok(value: v) => v,
        Result.Err(error: e) => 100000,
    }
    let ping = chan_new(1)
    let pong = chan_new(1)
    let out = chan_new(1)
    scope {
        spawn ponger(ping, pong)
        spawn pinger(n, ping, pong, out)
    }
    let buf = ints_new()
    if chan_recv(out, buf) { println(ints_pop(buf)) }
}
