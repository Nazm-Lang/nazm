use "@std/file"

fn main(io: IoCap) {
    let counts = hashmap_new[Str, Int]()
    for line in file_lines(io, arg(0)) {
        for w in line.split(" ") {
            if w.len() > 0 { counts[w] += 1 }
        }
    }
    println(counts.len())
    for (w, n) in counts.top(10) { println(f"{w} {n}") }
}
