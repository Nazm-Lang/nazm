use "@std/text"
use "@std/hash"
use "@std/hashmap"
use "@std/sort"

fn main(io: IoCap) {
    let counts = hashmap_new[Str, Int]()
    for line in read_file(arg(0)).lines() {
        for w in line.split(" ") {
            if w.len() > 0 { counts[w] += 1 }
        }
    }
    let words = vec_sort_by(counts.keys(), fn(a: Str, b: Str) -> Bool {
        counts[a] > counts[b] || (counts[a] == counts[b] && a.compare(b) < 0)
    })
    println(counts.len())
    for i in 0..10 {
        println(f"{words[i]} {counts[words[i]]}")
    }
}
