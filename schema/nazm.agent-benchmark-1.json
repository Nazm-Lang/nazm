{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nazm.agent-benchmark-1.json",
  "title": "nazm.agent-benchmark/1",
  "description": "The N35 agent task benchmark (`nazm-agent-bench`): the task suite, one journal record per request, and the aggregate report. A record carries its request's identity (task, arm, trial, provider, requested model, parameters, prompt version and digest, suite version, context digest), the model the provider answered with, the provider's usage raw and normalised, the local o200k_base counts of the context and of the fixed rest, the price entry applied and the cost in integer pico-USD, the latency, and the oracle's fact-by-fact score. A request with no reply after bounded retries is a `runner_error` and is not scored; a reply from another model is `model_drift` and is not compared. The report is deterministic: authoritative records only, the last of each identity, correctness before cost, and a ratio with a zero denominator is null. No credential appears anywhere.",
  "type": "object",
  "required": ["schema"],
  "properties": {
    "schema": { "const": "nazm.agent-benchmark/1" }
  },
  "oneOf": [
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/report" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "arm": { "enum": ["baseline", "n33"] },
    "category": { "enum": ["understand", "edit", "diagnose", "docs", "tests"] },
    "count": { "type": "integer", "minimum": 0 },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "suite", "suite_version", "prompt_version", "prompt_digest", "system", "tasks"],
      "properties": {
        "schema": { "const": "nazm.agent-benchmark/1" },
        "kind": { "const": "suite" },
        "suite": { "$ref": "#/$defs/digest" },
        "suite_version": { "const": "nazm.agent-bench-suite/1" },
        "prompt_version": { "const": "nazm.agent-bench-prompt/1" },
        "prompt_digest": { "$ref": "#/$defs/digest" },
        "system": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "scenario", "required_facts", "wording", "contract", "fields", "contexts"],
            "properties": {
              "id": { "type": "string" },
              "category": { "$ref": "#/$defs/category" },
              "scenario": { "type": "string" },
              "required_facts": { "$ref": "#/$defs/count" },
              "wording": { "type": "string" },
              "contract": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "object", "required": ["name", "truth"] } },
              "contexts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["arm", "bytes", "digest"],
                  "properties": {
                    "arm": { "$ref": "#/$defs/arm" },
                    "bytes": { "$ref": "#/$defs/count" },
                    "digest": { "$ref": "#/$defs/digest" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "uncached_input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/count" },
        "uncached_input_tokens": { "$ref": "#/$defs/count" },
        "cached_input_tokens": { "$ref": "#/$defs/count" },
        "cache_write_input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "description": "pico-USD.",
      "required": ["input", "cached_input", "cache_write_input", "output", "total"],
      "properties": {
        "input": { "$ref": "#/$defs/count" },
        "cached_input": { "$ref": "#/$defs/count" },
        "cache_write_input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "correct", "missing", "wrong", "hallucinated", "extra_citations", "refusal", "invalid", "solved", "failure", "facts", "claims"],
      "properties": {
        "required": { "$ref": "#/$defs/count" },
        "correct": { "$ref": "#/$defs/count" },
        "missing": { "$ref": "#/$defs/count" },
        "wrong": { "$ref": "#/$defs/count" },
        "hallucinated": { "$ref": "#/$defs/count" },
        "extra_citations": { "$ref": "#/$defs/count" },
        "refusal": { "type": "boolean" },
        "invalid": { "type": ["string", "null"] },
        "solved": { "type": "boolean" },
        "failure": { "enum": [null, "invalid_structured_output", "refusal", "hallucinated_fact", "wrong_repository_fact", "missing_required_fact"] },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "fact", "ok"],
            "properties": {
              "field": { "type": "string" },
              "fact": { "type": "string" },
              "ok": { "type": "boolean" }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "value", "kind"],
            "properties": {
              "field": { "type": "string" },
              "value": { "type": "string" },
              "kind": { "enum": ["wrong", "hallucinated", "extra_citation"] }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "benchmark", "suite", "mode", "identity", "task", "category", "arm", "trial", "order", "provider", "model_requested", "model_returned", "prompt_version", "prompt_digest", "context_digest", "context_bytes", "parameters", "status", "attempts", "retries", "retry_reasons", "usage", "raw_usage", "fingerprint", "stop_reason", "local", "counted", "price", "cost", "charged", "latency_ms", "retry_latency_ms", "answer_digest", "answer", "score", "lenient", "failure"],
      "properties": {
        "schema": { "const": "nazm.agent-benchmark/1" },
        "benchmark": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "suite": { "$ref": "#/$defs/digest" },
        "mode": { "enum": ["pilot", "authoritative"] },
        "identity": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "task": { "type": "string" },
        "category": { "$ref": "#/$defs/category" },
        "arm": { "$ref": "#/$defs/arm" },
        "trial": { "type": "integer", "minimum": 1 },
        "order": { "enum": [0, 1] },
        "provider": { "type": "string" },
        "model_requested": { "type": "string" },
        "model_returned": { "type": ["string", "null"] },
        "prompt_version": { "const": "nazm.agent-bench-prompt/1" },
        "prompt_digest": { "$ref": "#/$defs/digest" },
        "context_digest": { "$ref": "#/$defs/digest" },
        "context_bytes": { "$ref": "#/$defs/count" },
        "parameters": { "type": "object", "description": "Every request parameter except the messages, as sent." },
        "status": { "enum": ["answered", "runner_error", "model_drift"] },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 2 },
        "retry_reasons": { "type": "array", "items": { "type": "string" } },
        "usage": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usage" }] },
        "raw_usage": { "type": ["object", "null"], "description": "The provider's own usage object." },
        "fingerprint": { "type": ["string", "null"] },
        "stop_reason": { "type": ["string", "null"] },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_tokens", "fixed_tokens"],
          "properties": {
            "context_tokens": { "$ref": "#/$defs/count" },
            "fixed_tokens": { "$ref": "#/$defs/count" }
          }
        },
        "counted": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["full", "fixed"],
              "properties": {
                "full": { "$ref": "#/$defs/count" },
                "fixed": { "$ref": "#/$defs/count" }
              }
            }
          ]
        },
        "price": { "type": "string", "description": "The price entry applied: provider/model@effective." },
        "cost": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cost" }] },
        "charged": { "$ref": "#/$defs/count" },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "retry_latency_ms": { "$ref": "#/$defs/count" },
        "answer_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "answer": { "type": ["object", "null"] },
        "score": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/score" }] },
        "lenient": { "description": "The same oracle on the reply's last fenced block, when the reply was prose around one: secondary, never the verdict.", "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/score" }] },
        "failure": { "enum": [null, "runner_error", "model_drift", "invalid_structured_output", "refusal", "hallucinated_fact", "wrong_repository_fact", "missing_required_fact"] }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "suites", "suite_version", "prompt_version", "prompt_digest", "providers"],
      "properties": {
        "schema": { "const": "nazm.agent-benchmark/1" },
        "kind": { "const": "report" },
        "suites": { "type": "array", "description": "The suite digests the records were made under: one, for a comparable report.", "items": { "$ref": "#/$defs/digest" } },
        "suite_version": { "const": "nazm.agent-bench-suite/1" },
        "prompt_version": { "const": "nazm.agent-bench-prompt/1" },
        "prompt_digest": { "$ref": "#/$defs/digest" },
        "providers": {
          "type": "array",
          "description": "By provider name.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model_requested", "models_returned", "benchmarks", "parameters", "price", "trials", "tasks", "categories", "all", "crossover", "latency_ms", "retries", "retry_latency_ms"],
            "properties": {
              "provider": { "type": "string" },
              "model_requested": { "type": "string" },
              "models_returned": { "type": "array", "items": { "type": "string" } },
              "benchmarks": { "type": "array", "items": { "type": "string" } },
              "parameters": { "type": "object" },
              "price": { "type": ["object", "null"] },
              "trials": { "$ref": "#/$defs/count" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["task", "category", "scenario", "baseline", "n33", "correctness_preserved", "conclusion", "input_reduction_bp", "total_reduction_bp", "cost_reduction_bp", "local_context_reduction_bp"],
                  "properties": {
                    "category": { "$ref": "#/$defs/category" },
                    "conclusion": { "enum": ["n33_better", "equivalent", "baseline_better", "inconclusive"] },
                    "correctness_preserved": { "type": "boolean" },
                    "input_reduction_bp": { "type": ["integer", "null"] },
                    "total_reduction_bp": { "type": ["integer", "null"] },
                    "cost_reduction_bp": { "type": ["integer", "null"] },
                    "local_context_reduction_bp": { "type": ["integer", "null"] }
                  }
                }
              },
              "categories": { "type": "array", "items": { "type": "object", "required": ["name", "tasks", "correctness_preserved", "conclusions", "baseline", "n33"] } },
              "all": { "type": "object", "required": ["name", "tasks", "correctness_preserved", "conclusions", "baseline", "n33"] },
              "crossover": { "type": "object", "required": ["n33_dearer", "n33_cheaper", "between"] },
              "latency_ms": { "type": "object" },
              "retries": { "$ref": "#/$defs/count" },
              "retry_latency_ms": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    }
  }
}
