{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nazm.provenance-1.json",
  "title": "nazm.provenance/1",
  "description": "What one build read and wrote, from `nazm build --provenance FILE` (N73). Deterministic: no absolute path, time or host name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest_algorithm",
    "sources",
    "packages",
    "target",
    "compiler",
    "semantic_epoch",
    "c_compiler",
    "runtime",
    "backend",
    "linked",
    "profiles",
    "output"
  ],
  "properties": {
    "schema": {
      "const": "nazm.provenance/1"
    },
    "digest_algorithm": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "digest"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "string"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "nazm"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "semantic_epoch": {
      "type": "integer"
    },
    "c_compiler": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "driver",
            "version",
            "report_digest"
          ],
          "properties": {
            "driver": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "report_digest": {
              "type": "string",
              "pattern": "^blake3:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi_revision",
        "digest"
      ],
      "properties": {
        "abi_revision": {
          "type": "integer"
        },
        "archive": {
          "type": "string",
          "description": "The BLAKE3 digest of the runtime artifact linked instead of a generated runtime (`nazm build --runtime`, N82); absent when the runtime was generated."
        },
        "digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "opt_level",
        "layout",
        "debug",
        "stack_watermark",
        "cranelift"
      ],
      "properties": {
        "name": {
          "enum": [
            "llvm",
            "cranelift",
            "nazm"
          ]
        },
        "opt_level": {
          "type": "integer"
        },
        "layout": {
          "type": "string"
        },
        "debug": {
          "type": "boolean"
        },
        "stack_watermark": {
          "type": "boolean"
        },
        "stack_size": {
          "description": "R1b, L14: `nazm build --stack-size`, in bytes; null where none was asked for",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "heap_limit": {
          "description": "R1d, D5: `nazm build --heap-limit`, or the root package's `heap-limit`, in bytes; null where neither gives one",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cranelift": {
          "type": "string"
        },
        "nzcg": {
          "description": "R9, D15: the BLAKE3 digest of Nazm's own code generator, present exactly when `--backend nazm` built the program",
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      }
    },
    "linked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "files"
      ],
      "properties": {
        "kind": {
          "enum": [
            "executable",
            "library",
            "objects"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
