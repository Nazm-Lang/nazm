// nzcg: Nazm's own code generator (R9, `openspec/changes/r9-code-generator/`).
//
//     nzcg [--target TRIPLE] [--one-thread] LIR OUTDIR
//                               (--one-thread: the program has one thread, so its stack limit is
//                               a plain global and the stack check is inlined, as LLVM's is)
//     nzcg --forms LIR         the LIR forms the program uses, one per line (design D12)
//     nzcg --universe           every form LIR admits, one per line
//
// Reads a program's units as `nazm lir --ops` prints them from the file LIR, and writes one
// relocatable object per unit, `OUTDIR/unit-K.o` for the K-th unit, for the target:
// `aarch64-apple-darwin` (the default) and `x86_64-apple-darwin` as Mach-O,
// `aarch64-unknown-linux-gnu` and `x86_64-unknown-linux-gnu` as ELF.
// What it does not carry it refuses by name, on standard error, with exit status 3, and then
// writes nothing (design D9).

use "@std/file"
use "@std/ioerror"
use "@std/hash"
use "@std/hashmap"
use "lir.nz"
use "sel.nz"
use "sel_x64.nz"
use "common.nz"
use "macho.nz"
use "elf.nz"
use "dwarf.nz"
use "forms.nz"

fn main(io: IoCap) {
    if args_count() == 1 && arg(0) == "--universe" {
        let all = strs_new()
        universe(all)
        for s in all { println(s) }
        return
    }
    if args_count() == 2 && arg(0) == "--forms" {
        let p = read_program(read_file(arg(1)))
        for e in p.errors { eprintln(f"nzcg: refused: {e}") }
        if strs_len(p.errors) > 0 { exit_with(3) }
        let all = strs_new()
        for u in p.units { unit_forms(u, all) }
        for s in all { println(s) }
        return
    }
    let mut first = 0
    let mut target = "aarch64-apple-darwin"
    let mut one_thread = false
    let mut flags = true
    while flags && first < args_count() {
        if arg(first) == "--target" && first + 1 < args_count() {
            target = arg(first + 1)
            first += 2
        } else if arg(first) == "--one-thread" {
            one_thread = true
            first += 1
        } else {
            flags = false
        }
    }
    if args_count() != first + 2 {
        eprintln("usage: nzcg [--target TRIPLE] [--one-thread] LIR OUTDIR")
        exit_with(2)
    }
    let x64 = target == "x86_64-apple-darwin" || target == "x86_64-unknown-linux-gnu"
    let apple = target == "x86_64-apple-darwin" || target == "aarch64-apple-darwin"
    if !x64 && !apple && target != "aarch64-unknown-linux-gnu" {
        eprintln(f"nzcg: refused: the target `{target}` (aarch64 and x86_64, apple-darwin and unknown-linux-gnu, are carried)")
        exit_with(3)
    }
    let text = read_file(arg(first))
    let dir = arg(first + 1)
    let p = read_program(text)
    let errors = p.errors
    let objects = vec_new[Bytes]()
    if strs_len(errors) == 0 {
        for u in p.units {
            // A program of one thread keeps its stack limit in a plain global the runtime
            // defines; a unit that checks the stack reads it directly (7.3).
            let mut limit = -1
            if one_thread {
                match hashmap_get(u.index, "nz.stack_check") {
                    Some(k) => {
                        limit = u.syms.len()
                        u.syms.push(Sym(name: "nz.stack_limit", kind: 1, link: L_IMPORT,
                                params: ints_new(), ret: C_NONE, conv: CONV_C))
                        hashmap_set(u.index, "nz.stack_limit", limit)
                    },
                    None => { },
                }
            }
            let c = code_new(u.syms.len(), apple, limit)
            for f in u.funcs {
                if str_len(f.section) > 0 {
                    strs_push(errors, f"`{f.name}` in section `{f.section}` (section placement, a board's, is not carried)")
                } else if x64 {
                    gen_function_x64(c, u, f)
                } else {
                    gen_function(c, u, f)
                }
            }
            for e in c.errors { strs_push(errors, e) }
            if strs_len(errors) == 0 {
                let dbg = build_dwarf(u, c)
                objects.push(if apple { write_object(u, c, x64, dbg, errors) } else { write_elf(u, c, x64, dbg, errors) })
            }
        }
    }
    if strs_len(errors) > 0 {
        for e in errors { eprintln(f"nzcg: refused: {e}") }
        exit_with(3)
    }
    let mut k = 0
    for o in objects {
        let path = f"{dir}/unit-{k}.o"
        match file_create(io, path) {
            Ok(f) => {
                match file_write(f, o) {
                    Ok(n) => { },
                    Err(e) => {
                        eprintln(f"nzcg: cannot write {path}")
                        exit_with(1)
                    },
                }
                match file_close(f) {
                    Ok(n) => { },
                    Err(e) => {
                        eprintln(f"nzcg: cannot close {path}")
                        exit_with(1)
                    },
                }
            },
            Err(e) => {
                eprintln(f"nzcg: cannot create {path}")
                exit_with(1)
            },
        }
        k += 1
    }
}
