// nzcg: Nazm's own code generator (R9, `openspec/changes/r9-code-generator/`).
//
//     nzcg LIR OUTDIR
//
// Reads a program's units as `nazm lir --ops` prints them from the file LIR, and writes one
// relocatable object per unit, `OUTDIR/unit-K.o` for the K-th unit, for `aarch64-apple-darwin`.
// What it does not carry it refuses by name, on standard error, with exit status 3, and then
// writes nothing (design D9).

use "@std/file"
use "@std/ioerror"
use "lir.nz"
use "sel.nz"
use "macho.nz"

fn main(io: IoCap) {
    if args_count() != 2 {
        eprintln("usage: nzcg LIR OUTDIR")
        exit_with(2)
    }
    let text = read_file(arg(0))
    let dir = arg(1)
    let p = read_program(text)
    let errors = p.errors
    let objects = vec_new[Bytes]()
    if strs_len(errors) == 0 {
        for u in p.units {
            let c = code_new(u.syms.len())
            for f in u.funcs {
                if str_len(f.section) > 0 {
                    strs_push(errors, f"`{f.name}` in section `{f.section}` (placement is for the ELF slice)")
                } else {
                    gen_function(c, u, f)
                }
            }
            for e in c.errors { strs_push(errors, e) }
            if strs_len(errors) == 0 {
                objects.push(write_object(u, c, errors))
            }
        }
    }
    if strs_len(errors) > 0 {
        for e in errors { eprintln(f"nzcg: refused: {e}") }
        exit_with(3)
    }
    let mut k = 0
    for o in objects {
        let path = f"{dir}/unit-{k}.o"
        match file_create(io, path) {
            Ok(f) => {
                match file_write(f, o) {
                    Ok(n) => { },
                    Err(e) => {
                        eprintln(f"nzcg: cannot write {path}")
                        exit_with(1)
                    },
                }
                match file_close(f) {
                    Ok(n) => { },
                    Err(e) => {
                        eprintln(f"nzcg: cannot close {path}")
                        exit_with(1)
                    },
                }
            },
            Err(e) => {
                eprintln(f"nzcg: cannot create {path}")
                exit_with(1)
            },
        }
        k += 1
    }
}
