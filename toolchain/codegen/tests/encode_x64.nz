// The x86-64 encoder held to the system assembler (design D8): prints each encoding the
// selection uses, as `x86_64<TAB>BYTES<TAB>ASSEMBLY`, for `tests/encode.sh` to assemble with the
// platform's `cc` and compare. Registers are chosen to reach every field: r8–r15, `rsp` and
// `r12`/`r13` as bases, byte registers that need a REX prefix, xmm registers above 7.

use "@std/bytebuf"
use "../x64.nz"

/// The x86-64 bytes `f` wrote since `from`, in hex.
fn hexbuf(b: ByteBuf, from: Int) -> Str {
    let digits = "0123456789abcdef"
    let mut s = ""
    let mut i = from
    while i < bytebuf_len(b) {
        let byte = match bytebuf_get(b, i) {
            Some(v) => Int(v),
            None => 0,
        }
        s = s + str_slice(digits, byte >> 4, (byte >> 4) + 1) + str_slice(digits, byte & 15, (byte & 15) + 1)
        i += 1
    }
    s
}

fn x(out: Strs, b: ByteBuf, from: Int, asm: Str) {
    strs_push(out, f"x86_64\t{hexbuf(b, from)}\t{asm}")
}

fn x86(out: Strs) {
    let b = bytebuf_new()
    let mut p = 0
    mov(b, RBP, RSP)
    x(out, b, p, "movq %rsp, %rbp")
    p = bytebuf_len(b)
    mov(b, 9, 2)
    x(out, b, p, "movq %rdx, %r9")
    p = bytebuf_len(b)
    mov32(b, 7, 7)
    x(out, b, p, "movl %edi, %edi")
    p = bytebuf_len(b)
    load(b, 8, 0, RSP, 0x108)
    x(out, b, p, "movq 0x108(%rsp), %rax")
    p = bytebuf_len(b)
    load(b, 8, 11, 12, -16)
    x(out, b, p, "movq -16(%r12), %r11")
    p = bytebuf_len(b)
    load(b, 4, 0, 11, 8)
    x(out, b, p, "movl 8(%r11), %eax")
    p = bytebuf_len(b)
    load(b, 2, 0, 13, 2)
    x(out, b, p, "movzwl 2(%r13), %eax")
    p = bytebuf_len(b)
    load(b, 1, 10, RBP, 16)
    x(out, b, p, "movzbl 16(%rbp), %r10d")
    p = bytebuf_len(b)
    store(b, 8, 7, RSP, 0)
    x(out, b, p, "movq %rdi, 0(%rsp)")
    p = bytebuf_len(b)
    store(b, 4, 0, 10, 4)
    x(out, b, p, "movl %eax, 4(%r10)")
    p = bytebuf_len(b)
    store(b, 2, 0, 11, 6)
    x(out, b, p, "movw %ax, 6(%r11)")
    p = bytebuf_len(b)
    store(b, 1, 6, 11, 7)
    x(out, b, p, "movb %sil, 7(%r11)")
    p = bytebuf_len(b)
    store(b, 1, 0, RSP, 9)
    x(out, b, p, "movb %al, 9(%rsp)")
    p = bytebuf_len(b)
    mov_imm(b, 0, 0x12345678)
    x(out, b, p, "movl $0x12345678, %eax")
    p = bytebuf_len(b)
    mov_imm(b, 11, 4096)
    x(out, b, p, "movl $4096, %r11d")
    p = bytebuf_len(b)
    mov_imm(b, 1, -1)
    x(out, b, p, "movq $-1, %rcx")
    p = bytebuf_len(b)
    mov_imm(b, 9, 0x123456789A)
    x(out, b, p, "movabsq $0x123456789a, %r9")
    p = bytebuf_len(b)
    alu(b, ALU_ADD, 0, 1)
    x(out, b, p, "addq %rcx, %rax")
    p = bytebuf_len(b)
    alu(b, ALU_ADC, 2, 11)
    x(out, b, p, "adcq %r11, %rdx")
    p = bytebuf_len(b)
    alu(b, ALU_SBB, 11, 2)
    x(out, b, p, "sbbq %rdx, %r11")
    p = bytebuf_len(b)
    alu(b, ALU_SUB, 0, 1)
    x(out, b, p, "subq %rcx, %rax")
    p = bytebuf_len(b)
    alu(b, ALU_AND, 0, 2)
    x(out, b, p, "andq %rdx, %rax")
    p = bytebuf_len(b)
    alu(b, ALU_OR, 1, 0)
    x(out, b, p, "orq %rax, %rcx")
    p = bytebuf_len(b)
    alu(b, ALU_XOR, 0, 1)
    x(out, b, p, "xorq %rcx, %rax")
    p = bytebuf_len(b)
    alu(b, ALU_CMP, 10, 0)
    x(out, b, p, "cmpq %rax, %r10")
    p = bytebuf_len(b)
    alu(b, ALU_TEST, 10, 10)
    x(out, b, p, "testq %r10, %r10")
    p = bytebuf_len(b)
    imul(b, 0, 1)
    x(out, b, p, "imulq %rcx, %rax")
    p = bytebuf_len(b)
    imul(b, 10, 11)
    x(out, b, p, "imulq %r11, %r10")
    p = bytebuf_len(b)
    f7(b, 3, 0)
    x(out, b, p, "negq %rax")
    p = bytebuf_len(b)
    f7(b, 4, 1)
    x(out, b, p, "mulq %rcx")
    p = bytebuf_len(b)
    f7(b, 6, 1)
    x(out, b, p, "divq %rcx")
    p = bytebuf_len(b)
    f7(b, 7, 1)
    x(out, b, p, "idivq %rcx")
    p = bytebuf_len(b)
    cqo(b)
    x(out, b, p, "cqto")
    p = bytebuf_len(b)
    cmp_imm8(b, 1, -1)
    x(out, b, p, "cmpq $-1, %rcx")
    p = bytebuf_len(b)
    cmp_imm8(b, 11, 127)
    x(out, b, p, "cmpq $127, %r11")
    p = bytebuf_len(b)
    shift_cl(b, 64, 4, 0)
    x(out, b, p, "shlq %cl, %rax")
    p = bytebuf_len(b)
    shift_cl(b, 64, 7, 2)
    x(out, b, p, "sarq %cl, %rdx")
    p = bytebuf_len(b)
    shift_cl(b, 32, 0, 0)
    x(out, b, p, "roll %cl, %eax")
    p = bytebuf_len(b)
    shift_cl(b, 16, 1, 0)
    x(out, b, p, "rorw %cl, %ax")
    p = bytebuf_len(b)
    shift_cl(b, 8, 0, 0)
    x(out, b, p, "rolb %cl, %al")
    p = bytebuf_len(b)
    shift_imm(b, 5, 1, 56)
    x(out, b, p, "shrq $56, %rcx")
    p = bytebuf_len(b)
    shift_imm(b, 7, 10, 63)
    x(out, b, p, "sarq $63, %r10")
    p = bytebuf_len(b)
    rol16_8(b, 0)
    x(out, b, p, "rolw $8, %ax")
    p = bytebuf_len(b)
    setcc(b, CC_O, 2)
    x(out, b, p, "seto %dl; movzbl %dl, %edx")
    p = bytebuf_len(b)
    setcc(b, CC_NE, 7)
    x(out, b, p, "setne %dil; movzbl %dil, %edi")
    p = bytebuf_len(b)
    movzx8(b, 6, 6)
    x(out, b, p, "movzbl %sil, %esi")
    p = bytebuf_len(b)
    movzx16(b, 10, 10)
    x(out, b, p, "movzwl %r10w, %r10d")
    p = bytebuf_len(b)
    movsx8(b, 0, 0)
    x(out, b, p, "movsbq %al, %rax")
    p = bytebuf_len(b)
    movsx16(b, 1, 1)
    x(out, b, p, "movswq %cx, %rcx")
    p = bytebuf_len(b)
    movsxd(b, 10, 10)
    x(out, b, p, "movslq %r10d, %r10")
    p = bytebuf_len(b)
    and1(b, 2)
    x(out, b, p, "andl $1, %edx")
    p = bytebuf_len(b)
    and1(b, 9)
    x(out, b, p, "andl $1, %r9d")
    p = bytebuf_len(b)
    cmov(b, CC_NE, 0, 1)
    x(out, b, p, "cmovneq %rcx, %rax")
    p = bytebuf_len(b)
    cmov(b, CC_E, 2, 11)
    x(out, b, p, "cmoveq %r11, %rdx")
    p = bytebuf_len(b)
    lea(b, 0, RSP, 0x40)
    x(out, b, p, "leaq 0x40(%rsp), %rax")
    p = bytebuf_len(b)
    call_r(b, 11)
    x(out, b, p, "callq *%r11")
    p = bytebuf_len(b)
    ret(b)
    x(out, b, p, "retq")
    p = bytebuf_len(b)
    ud2(b)
    x(out, b, p, "ud2")
    p = bytebuf_len(b)
    push_rbp(b)
    x(out, b, p, "pushq %rbp")
    p = bytebuf_len(b)
    push(b, 3)
    x(out, b, p, "pushq %rbx")
    p = bytebuf_len(b)
    push(b, 15)
    x(out, b, p, "pushq %r15")
    p = bytebuf_len(b)
    load(b, 8, 12, RBP, -16)
    x(out, b, p, "movq -16(%rbp), %r12")
    p = bytebuf_len(b)
    pop_rbp(b)
    x(out, b, p, "popq %rbp")
    p = bytebuf_len(b)
    bsr(b, 0, 0)
    x(out, b, p, "bsrq %rax, %rax")
    p = bytebuf_len(b)
    bsf(b, 0, 9)
    x(out, b, p, "bsfq %r9, %rax")
    p = bytebuf_len(b)
    bswap(b, true, 0)
    x(out, b, p, "bswapq %rax")
    p = bytebuf_len(b)
    bswap(b, false, 10)
    x(out, b, p, "bswapl %r10d")
    p = bytebuf_len(b)
    rr(b, true, 0x0FA5, 0, 2)
    x(out, b, p, "shldq %cl, %rax, %rdx")
    p = bytebuf_len(b)
    rr(b, true, 0x0FAD, 2, 0)
    x(out, b, p, "shrdq %cl, %rdx, %rax")
    p = bytebuf_len(b)
    rr(b, true, 0x81, 5, RSP)
    imm32(b, 4096)
    x(out, b, p, "subq $4096, %rsp")
    p = bytebuf_len(b)
    rr(b, true, 0x83, 0, 11)
    b1(b, 8)
    x(out, b, p, "addq $8, %r11")
    p = bytebuf_len(b)
    rr(b, true, 0xFF, 1, 11)
    x(out, b, p, "decq %r11")
    p = bytebuf_len(b)
    movq_to_x(b, true, 14, 0)
    x(out, b, p, "movq %rax, %xmm14")
    p = bytebuf_len(b)
    movq_from_x(b, true, 0, 15)
    x(out, b, p, "movq %xmm15, %rax")
    p = bytebuf_len(b)
    movq_to_x(b, false, 0, 9)
    x(out, b, p, "movd %r9d, %xmm0")
    p = bytebuf_len(b)
    movq_from_x(b, false, 10, 14)
    x(out, b, p, "movd %xmm14, %r10d")
    p = bytebuf_len(b)
    farith(b, true, 0x58, 14, 15)
    x(out, b, p, "addsd %xmm15, %xmm14")
    p = bytebuf_len(b)
    farith(b, false, 0x5C, 14, 15)
    x(out, b, p, "subss %xmm15, %xmm14")
    p = bytebuf_len(b)
    farith(b, true, 0x59, 0, 1)
    x(out, b, p, "mulsd %xmm1, %xmm0")
    p = bytebuf_len(b)
    farith(b, false, 0x5E, 14, 15)
    x(out, b, p, "divss %xmm15, %xmm14")
    p = bytebuf_len(b)
    farith(b, true, 0x51, 14, 14)
    x(out, b, p, "sqrtsd %xmm14, %xmm14")
    p = bytebuf_len(b)
    ucomis(b, true, 14, 15)
    x(out, b, p, "ucomisd %xmm15, %xmm14")
    p = bytebuf_len(b)
    ucomis(b, false, 15, 14)
    x(out, b, p, "ucomiss %xmm14, %xmm15")
    p = bytebuf_len(b)
    cvtsi2f(b, true, 14, 0)
    x(out, b, p, "cvtsi2sdq %rax, %xmm14")
    p = bytebuf_len(b)
    cvtsi2f(b, false, 14, 1)
    x(out, b, p, "cvtsi2ssq %rcx, %xmm14")
    p = bytebuf_len(b)
    cvttf2si(b, true, 0, 14)
    x(out, b, p, "cvttsd2si %xmm14, %rax")
    p = bytebuf_len(b)
    cvttf2si(b, false, 0, 14)
    x(out, b, p, "cvttss2si %xmm14, %rax")
    p = bytebuf_len(b)
    cvtf2f(b, true, 14, 14)
    x(out, b, p, "cvtss2sd %xmm14, %xmm14")
    p = bytebuf_len(b)
    cvtf2f(b, false, 14, 14)
    x(out, b, p, "cvtsd2ss %xmm14, %xmm14")
    p = bytebuf_len(b)
    round(b, true, 14, 14, 9)
    x(out, b, p, "roundsd $9, %xmm14, %xmm14")
    p = bytebuf_len(b)
    round(b, false, 14, 14, 11)
    x(out, b, p, "roundss $11, %xmm14, %xmm14")
}

fn main(o: OutCap) {
    let lines = strs_new()
    x86(lines)
    for l in lines { println(l) }
}
