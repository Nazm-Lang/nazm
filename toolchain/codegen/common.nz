// What both targets' selection share: a unit's code and its relocations, the classes of a
// function's values, the frame's layout of them, and the narrow-value rules' arithmetic (D5).

use "@std/bytebuf"
use "lir.nz"

// aarch64 relocation kinds (Mach-O's `ARM64_RELOC_*` numbers; the ELF writer maps them).
pub const R_BRANCH26: Int = 2
pub const R_PAGE21: Int = 3
pub const R_PAGEOFF12: Int = 4
pub const R_GOT_PAGE21: Int = 5
pub const R_GOT_PAGEOFF12: Int = 6

/// A unit's code: the bytes, the relocations against its symbols, where each function starts.
pub struct Code {
    buf: ByteBuf,
    rel_at: Ints,
    rel_kind: Ints,
    rel_sym: Ints,
    rel_pcrel: Ints,
    rel_len: Ints,
    sym_at: Ints,
    errors: Strs,
    /// Whether the target is Apple's (its AAPCS64 variant, Mach-O).
    apple: Bool,
    /// Each `loc`: where its code begins, and its file, line and column (D10).
    loc_at: Ints,
    loc_file: Ints,
    loc_line: Ints,
    loc_col: Ints,
    /// Each function symbol's compact unwind encoding, or 0.
    fn_enc: Ints,
    /// The symbol of `nz.stack_limit` when the program has one thread, so `nz.stack_check` is
    /// inlined against it as LLVM inlines it (7.3); -1 to call the runtime.
    limit_sym: Int,
    /// Where a Nazm function's failure unwinds (7.5, the Apple targets): the symbols it needs,
    /// indexed by `UW_*` — `nz.raise` and its stop function, defined in this unit, and the C
    /// personality, `_Unwind_ForcedUnwind` and `abort`, imported. Empty where the failure bit
    /// is returned beside the result (D4, D14).
    uw: Ints,
    /// Each function symbol's LSDA, an offset in `lsda`, or -1 where it has no landing pad.
    fn_lsda: Ints,
    lsda: ByteBuf,
    /// Whether the target is Windows x64 (section 8): its calling convention, PE/COFF.
    win: Bool,
    /// Each function symbol's UNWIND_INFO, an offset in `xdata`, or -1 (8.3, Windows only).
    fn_xdata: Ints,
    xdata: ByteBuf,
}

// The symbols an unwinding unit uses (`Code.uw`).
pub const UW_RAISE: Int = 0
pub const UW_STOP: Int = 1
pub const UW_PERSONALITY: Int = 2
pub const UW_FORCED: Int = 3
pub const UW_ABORT: Int = 4

pub fn code_new(nsyms: Int, apple: Bool, win: Bool, limit_sym: Int, uw: Ints) -> Code {
    let at = ints_new()
    let enc = ints_new()
    let lsda = ints_new()
    let xd = ints_new()
    let mut i = 0
    while i < nsyms {
        ints_push(at, -1)
        ints_push(enc, 0)
        ints_push(lsda, -1)
        ints_push(xd, -1)
        i += 1
    }
    Code(buf: bytebuf_new(), rel_at: ints_new(), rel_kind: ints_new(), rel_sym: ints_new(),
            rel_pcrel: ints_new(), rel_len: ints_new(),
            sym_at: at, errors: strs_new(), apple: apple, loc_at: ints_new(),
            loc_file: ints_new(), loc_line: ints_new(), loc_col: ints_new(), fn_enc: enc,
            limit_sym: limit_sym, uw: uw, fn_lsda: lsda, lsda: bytebuf_new(), win: win,
            fn_xdata: xd, xdata: bytebuf_new())
}

/// Whether a Nazm function's failure unwinds in this unit's code (7.5).
pub fn unwinds(c: Code) -> Bool {
    ints_len(c.uw) > 0
}

/// Whether `x` is a call that may unwind: a Nazm function's, where failures unwind (7.5).
pub fn unwinding_call(c: Code, conv: Int) -> Bool {
    unwinds(c) && conv == CONV_NAZM
}

/// Whether the branch ending block `bi` is on the failure edge of the call that ends it (7.5):
/// the call's `failed` value is only ever the condition of that branch (LIR's validator), so
/// where failures unwind the branch needs no condition — the normal return takes its `else`,
/// the landing pad its `then`.
pub fn failure_branch(u: Unit, f: Func, t: Ins, bi: Int) -> Bool {
    if t.op != T_BRANCH || t.a < 0 || bi >= ints_len(f.block_end) { return false }
    let mut k = f.block_end[bi] - 1
    while k >= f.block_first[bi] && f.insts[k].op == OP_LOC { k -= 1 }
    if k < f.block_first[bi] { return false }
    let x = f.insts[k]
    if x.op != OP_CALL && x.op != OP_CALLI { return false }
    let conv = if x.op == OP_CALLI { x.sig_conv } else { u.syms[x.sym].conv }
    conv == CONV_NAZM && x.dst2 == t.a
}

/// Whether block `b` is a bare failure exit — nothing but positions, then `fail` — so a call
/// whose failure edge it is needs no landing pad: the unwind passes through the frame (7.5).
pub fn bare_fail(f: Func, b: Int) -> Bool {
    if b < 0 || b >= f.terms.len() || f.terms[b].op != T_FAIL { return false }
    let mut k = f.block_first[b]
    while k < f.block_end[b] {
        if f.insts[k].op != OP_LOC { return false }
        k += 1
    }
    true
}

fn put_uleb(b: ByteBuf, v: Int) {
    let mut x = v
    let mut more = true
    while more {
        let byte = x & 0x7F
        x = x >> 7
        if x == 0 {
            bytebuf_push(b, UInt8(byte))
            more = false
        } else {
            bytebuf_push(b, UInt8(byte | 0x80))
        }
    }
}

/// Function `sym`'s LSDA (7.5), as the C personality `__gcc_personality_v0` reads it: no
/// landing-pad base, no type table, then the call sites — each call that has a landing pad,
/// its start, its length and its pad as offsets from the function's start (ULEB128), and no
/// action. A call not listed has no pad: the unwind passes through its frame.
pub fn add_lsda(c: Code, sym: Int, start: Ints, len: Ints, pad: Ints) {
    if ints_len(start) == 0 { return }
    let table = bytebuf_new()
    let mut i = 0
    while i < ints_len(start) {
        put_uleb(table, start[i])
        put_uleb(table, len[i])
        put_uleb(table, pad[i])
        put_uleb(table, 0)
        i += 1
    }
    while bytebuf_len(c.lsda) % 4 != 0 { bytebuf_push(c.lsda, UInt8(0)) }
    ints_set(c.fn_lsda, sym, bytebuf_len(c.lsda))
    bytebuf_push(c.lsda, UInt8(0xFF))
    bytebuf_push(c.lsda, UInt8(0xFF))
    bytebuf_push(c.lsda, UInt8(0x01))
    put_uleb(c.lsda, bytebuf_len(table))
    bytebuf_push_bytes(c.lsda, bytebuf_to_bytes(table))
}

/// Whether `x` is a call of `nz.stack_check` to inline against `nz.stack_limit` (7.3).
pub fn inline_check(u: Unit, c: Code, x: Ins) -> Bool {
    c.limit_sym >= 0 && x.op == OP_CALL && ints_len(x.args) == 0 && x.sym >= 0 &&
        u.syms[x.sym].name == "nz.stack_check"
}

/// How many times each value is read. A `loc`'s operands are positions, a terminator's blocks
/// are blocks; anything else counted that is not a value only counts too many, which forbids a
/// fusion, never permits a wrong one.
pub fn use_counts(f: Func, n: Int) -> Ints {
    let uses = ints_new()
    let mut i = 0
    while i < n {
        ints_push(uses, 0)
        i += 1
    }
    for x in f.insts {
        if x.op != OP_LOC {
            count_use(uses, x.a)
            count_use(uses, x.b)
            count_use(uses, x.c)
            if x.op == OP_CALL || x.op == OP_CALLI {
                for v in x.args { count_use(uses, v) }
            }
        }
    }
    for t in f.terms { count_use(uses, t.a) }
    uses
}

/// A selector's fusion state: [the value that may be fused, the value fused, its condition].
pub fn fuse_new() -> Ints {
    let r = ints_new()
    ints_push(r, -1)
    ints_push(r, -1)
    ints_push(r, 0)
    r
}

fn count_use(uses: Ints, v: Int) {
    if v >= 0 && v < ints_len(uses) { ints_set(uses, v, uses[v] + 1) }
}

/// The condition the `i`-th instruction may hand to its block's branch in the flags rather than
/// a register (7.3): a comparison's result, or a checked operation's overflow bit, when it is the
/// block's last instruction, the branch's condition, and read nowhere else. -1 otherwise.
pub fn fusable(f: Func, uses: Ints, bi: Int, i: Int) -> Int {
    if i != f.block_end[bi] - 1 || bi >= f.terms.len() { return -1 }
    let t = f.terms[bi]
    if t.op != T_BRANCH || t.a < 0 || t.a >= ints_len(uses) || uses[t.a] != 1 { return -1 }
    let x = f.insts[i]
    if (x.op == OP_CMP && x.dst == t.a) || (x.op == OP_OVF && x.dst2 == t.a) { t.a } else { -1 }
}

/// The guard the lowering puts before a signed remainder (7.6). The remainder of the class's
/// minimum by -1 is 0, but x86-64's `idiv` traps on it, so LIR divides by 1 there instead:
///
///     m = const MIN; e1 = cmp eq a, m; n = const -1; e2 = cmp eq b, n; c = and e1, e2
///     o = const 1; s = select c, o, b; r = srem a, s
///
/// True when instructions `i` to `i + 7` of block `bi` are exactly that, on an integer class of
/// at most 64 bits, and no value of the guard is read anywhere else: the selection may then
/// compute `srem a, b` itself, with the remainder by -1 as 0, in a few instructions.
pub fn guarded_rem(f: Func, uses: Ints, bi: Int, i: Int) -> Bool {
    if i + 8 > f.block_end[bi] { return false }
    let m = f.insts[i]
    let e1 = f.insts[i + 1]
    let n = f.insts[i + 2]
    let e2 = f.insts[i + 3]
    let c = f.insts[i + 4]
    let o = f.insts[i + 5]
    let s = f.insts[i + 6]
    let r = f.insts[i + 7]
    let k = m.cls
    if k != C_I8 && k != C_I16 && k != C_I32 && k != C_I64 { return false }
    let bits = width_bits(k)
    // The class's minimum and -1, compared as the class's bits (shifts never trap).
    if m.op != OP_CONST || masked(m.imm, k) != masked(1 << (bits - 1), k) { return false }
    if n.op != OP_CONST || n.cls != k || masked(n.imm, k) != masked(-1, k) { return false }
    if o.op != OP_CONST || o.cls != k || masked(o.imm, k) != 1 { return false }
    if r.op != OP_BIN || r.sub != B_SREM { return false }
    let a = r.a
    let b = s.b
    if e1.op != OP_CMP || e1.sub != K_EQ || e1.a != a || e1.b != m.dst { return false }
    if e2.op != OP_CMP || e2.sub != K_EQ || e2.a != b || e2.b != n.dst { return false }
    if c.op != OP_BIN || c.sub != B_AND || c.a != e1.dst || c.b != e2.dst { return false }
    if s.op != OP_SELECT || s.c != c.dst || s.a != o.dst || r.b != s.dst { return false }
    once(uses, m.dst) && once(uses, e1.dst) && once(uses, n.dst) && once(uses, e2.dst) &&
        once(uses, c.dst) && once(uses, o.dst) && once(uses, s.dst)
}

/// Whether value `v` is read exactly once.
fn once(uses: Ints, v: Int) -> Bool {
    v >= 0 && v < ints_len(uses) && uses[v] == 1
}

pub fn align_up(x: Int, a: Int) -> Int {
    if a <= 1 { x } else { (x + a - 1) / a * a }
}

/// The width of a class in bytes, as it is stored in memory.
pub fn class_size(c: Int) -> Int {
    match c {
        0 => 1,
        1 => 1,
        2 => 2,
        3 => 4,
        5 => 4,
        8 => 16,
        _ => 8,
    }
}

pub fn is_float(c: Int) -> Bool {
    c == C_F32 || c == C_F64
}

pub fn width_bits(c: Int) -> Int {
    match c {
        0 => 1,
        1 => 8,
        2 => 16,
        3 => 32,
        5 => 32,
        _ => 64,
    }
}

/// A constant cut to its class's width, zero-extended (D5).
pub fn masked(v: Int, c: Int) -> Int {
    let bits = width_bits(c)
    if bits >= 64 { v } else { v & ((1 << bits) - 1) }
}

pub fn sym_ret(u: Unit, s: Int) -> Int {
    if s < 0 { C_NONE } else { u.syms[s].ret }
}

/// Every value's class, from what defines it; operations that take their operand's class are
/// settled by iterating until nothing changes, since a block may be printed before the block
/// that defines a value it uses.
pub fn infer(u: Unit, f: Func, n: Int) -> Ints {
    let vc = ints_new()
    let mut i = 0
    while i < n {
        ints_push(vc, -1)
        i += 1
    }
    let own = u.syms[f.sym]
    let mut changed = true
    let mut rounds = 0
    while changed && rounds < 50 {
        changed = false
        rounds += 1
        for x in f.insts {
            let mut d = -1
            let mut d2 = -1
            let op = x.op
            if op == OP_PARAM {
                d = if x.imm < ints_len(own.params) { own.params[x.imm] } else { -1 }
            } else if op == OP_CONST || op == OP_LOAD || op == OP_EXT || op == OP_TRUNC || op == OP_CONV {
                d = x.cls
            } else if op == OP_ADDR || op == OP_SLOT || op == OP_PTRADD || op == OP_INTTOPTR {
                d = C_PTR
            } else if op == OP_PTRTOINT {
                d = C_I64
            } else if op == OP_CMP {
                d = C_BIT
            } else if op == OP_BIN || op == OP_UN {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
            } else if op == OP_SELECT {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
            } else if op == OP_OVF {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
                d2 = C_BIT
            } else if op == OP_GET {
                d = if x.imm >= 0 && x.imm < ints_len(f.vars) { f.vars[x.imm] } else { -1 }
            } else if op == OP_CALL {
                d = sym_ret(u, x.sym)
                d2 = C_BIT
            } else if op == OP_CALLI {
                d = x.sig_ret
                d2 = C_BIT
            }
            if x.dst >= 0 && x.dst < n && d >= 0 && vc[x.dst] != d {
                vc[x.dst] = d
                changed = true
            }
            if x.dst2 >= 0 && x.dst2 < n && d2 >= 0 && vc[x.dst2] != d2 {
                vc[x.dst2] = d2
                changed = true
            }
        }
    }
    vc
}

/// Offsets for things of these classes laid end to end from `start`, 8 bytes each and 16 for an
/// `i128`; the end, last.
pub fn lay_out(classes: Ints, start: Int) -> Ints {
    let out = ints_new()
    let mut off = start
    for c in classes {
        ints_push(out, off)
        off += if c == C_I128 { 16 } else { 8 }
    }
    ints_push(out, off)
    out
}

pub fn read_u32(b: ByteBuf, at: Int) -> Int {
    let mut v = 0
    let mut k = 3
    while k >= 0 {
        let x = match bytebuf_get(b, at + k) {
            Some(y) => Int(y),
            None => 0,
        }
        v = (v << 8) | x
        k -= 1
    }
    v
}

// x86_64 relocation kinds (Mach-O's `X86_64_RELOC_*` numbers).
pub const X_UNSIGNED: Int = 0
pub const X_SIGNED: Int = 1
pub const X_BRANCH: Int = 2
pub const X_GOT_LOAD: Int = 3

/// A `loc` at the current end of the code (D10).
pub fn add_loc(c: Code, x: Ins) {
    ints_push(c.loc_at, bytebuf_len(c.buf))
    ints_push(c.loc_file, x.a)
    ints_push(c.loc_line, x.b)
    ints_push(c.loc_col, x.c)
}

/// A relocation of `kind` against `sym` at `at`, pc-relative or not, 2^`len` bytes wide.
pub fn add_reloc(c: Code, at: Int, kind: Int, sym: Int, pcrel: Int, len: Int) {
    ints_push(c.rel_at, at)
    ints_push(c.rel_kind, kind)
    ints_push(c.rel_sym, sym)
    ints_push(c.rel_pcrel, pcrel)
    ints_push(c.rel_len, len)
}

// ---------------------------------------------------------------------------------------------
// Stage B (design D3): a linear scan over live intervals, into callee-saved registers only, so
// a call never clobbers an allocated value and the selection's scratch and argument registers
// stay its own. Names are a function's values (0..n) and then its variables (n..n + vars).

/// The names an instruction reads.
fn uses_of(x: Ins, n: Int, out: Ints) {
    let op = x.op
    if op == OP_LOC || op == OP_PARAM || op == OP_CONST || op == OP_ADDR || op == OP_SLOT {
        return
    }
    if op == OP_GET {
        ints_push(out, n + x.imm)
        return
    }
    if x.a >= 0 { ints_push(out, x.a) }
    if x.b >= 0 { ints_push(out, x.b) }
    if x.c >= 0 { ints_push(out, x.c) }
    if op == OP_CALL || op == OP_CALLI {
        for v in x.args { ints_push(out, v) }
    }
}

/// The names an instruction writes.
fn defs_of(x: Ins, n: Int, out: Ints) {
    if x.op == OP_SET {
        ints_push(out, n + x.imm)
        return
    }
    if x.op == OP_LOC { return }
    if x.dst >= 0 { ints_push(out, x.dst) }
    if x.dst2 >= 0 { ints_push(out, x.dst2) }
}

fn term_uses(t: Ins, out: Ints) {
    if (t.op == T_BRANCH || t.op == T_SWITCH || t.op == T_RETURN) && t.a >= 0 { ints_push(out, t.a) }
}

fn succs(t: Ins, out: Ints) {
    if t.op == T_JUMP {
        ints_push(out, t.imm)
    } else if t.op == T_BRANCH {
        ints_push(out, t.imm)
        ints_push(out, t.c)
    } else if t.op == T_SWITCH {
        let mut k = 1
        while k < ints_len(t.args) {
            ints_push(out, t.args[k])
            k += 2
        }
        ints_push(out, t.imm)
    }
}

/// Where each key's entries begin once `keys` (each below `n`) is sorted by key, and at `n` how
/// many there are: the offsets of a counting sort.
fn by_key(keys: Ints, n: Int) -> Ints {
    let at = ints_new()
    let mut i = 0
    while i <= n {
        ints_push(at, 0)
        i += 1
    }
    for k in keys { at[k + 1] = at[k + 1] + 1 }
    i = 0
    while i < n {
        at[i + 1] = at[i + 1] + at[i]
        i += 1
    }
    at
}

/// `values` grouped by their `keys`, in their order within each key, at the offsets `by_key` gave.
fn placed(keys: Ints, values: Ints, at: Ints) -> Ints {
    let next = ints_new()
    let out = ints_new()
    for a in at { ints_push(next, a) }
    let mut i = 0
    while i < ints_len(values) {
        ints_push(out, 0)
        i += 1
    }
    i = 0
    while i < ints_len(keys) {
        let k = keys[i]
        out[next[k]] = values[i]
        next[k] = next[k] + 1
        i += 1
    }
    out
}

/// Each name's register, or -1 for its frame slot: an index below `nregs` is one of the target's
/// callee-saved registers, one from `nregs` up to `nregs + ncaller` a caller-saved register no
/// template uses as scratch (4.5), given only to a name no call falls inside the life of — not
/// even as its last use, since a call's arguments are loaded in sequence into registers such a
/// name might hold. A `bit` to `i64`, `ptr` or float value or variable may be allocated (all
/// are held in a general register as bits); an `i128` never is.
///
/// `colors` receives each name's shared frame slot (7.5): a name left without a register shares
/// an 8-byte slot with the others whose lives do not overlap its own — the same intervals the
/// registers are shared by — and -1 is a name that needs its own (an `i128`, a name of no class
/// or one never used) or none (a register). Left empty when nothing is allocated.
pub fn allocate(f: Func, n: Int, vcls: Ints, nregs: Int, ncaller: Int, colors: Ints) -> Ints {
    let nv = ints_len(f.vars)
    let names = n + nv
    let loc = ints_new()
    let mut i = 0
    while i < names {
        ints_push(loc, -1)
        i += 1
    }
    let nb = ints_len(f.block_first)
    if nregs == 0 || names == 0 || nb == 0 || f.terms.len() != nb { return loc }
    // Per block: the names it reads before writing them, and the names it writes, each once (a
    // name's stamp is the block that last recorded it).
    let use_b = ints_new()
    let use_v = ints_new()
    let def_b = ints_new()
    let def_v = ints_new()
    let used = ints_new()
    let defd = ints_new()
    let start = ints_new()
    let end = ints_new()
    i = 0
    while i < names {
        ints_push(used, -1)
        ints_push(defd, -1)
        ints_push(start, -1)
        ints_push(end, -1)
        i += 1
    }
    let tmp = ints_new()
    let mut b = 0
    while b < nb {
        let mut k = f.block_first[b]
        while k < f.block_end[b] {
            let x = f.insts[k]
            clear(tmp)
            uses_of(x, n, tmp)
            for v in tmp {
                if v < names && defd[v] != b && used[v] != b {
                    used[v] = b
                    ints_push(use_b, b)
                    ints_push(use_v, v)
                }
            }
            clear(tmp)
            defs_of(x, n, tmp)
            for v in tmp {
                if v < names && defd[v] != b {
                    defd[v] = b
                    ints_push(def_b, b)
                    ints_push(def_v, v)
                }
            }
            k += 1
        }
        clear(tmp)
        term_uses(f.terms[b], tmp)
        for v in tmp {
            if v < names && defd[v] != b && used[v] != b {
                used[v] = b
                ints_push(use_b, b)
                ints_push(use_v, v)
            }
        }
        b += 1
    }
    // The same by name, and each block's predecessors (counting sorts).
    let use_at = by_key(use_v, names)
    let use_of = placed(use_v, use_b, use_at)
    let def_at = by_key(def_v, names)
    let def_of = placed(def_v, def_b, def_at)
    let edge_from = ints_new()
    let edge_to = ints_new()
    b = 0
    while b < nb {
        clear(tmp)
        succs(f.terms[b], tmp)
        for s in tmp {
            if s >= 0 && s < nb {
                ints_push(edge_to, s)
                ints_push(edge_from, b)
            }
        }
        b += 1
    }
    let pred_at = by_key(edge_to, nb)
    let preds = placed(edge_to, edge_from, pred_at)
    // Positions in block order: each block's start, one per instruction, its terminator.
    let first_at = ints_new()
    let last_at = ints_new()
    let mut pos = 0
    b = 0
    while b < nb {
        ints_push(first_at, pos)
        let last = pos + 1 + f.block_end[b] - f.block_first[b]
        ints_push(last_at, last)
        pos = last + 1
        b += 1
    }
    // Intervals: a name's spans every point it is defined, read, or live at a block's edge.
    pos = 0
    let calls = ints_new()
    b = 0
    while b < nb {
        let mut k = f.block_first[b]
        let mut p = pos + 1
        while k < f.block_end[b] {
            let x = f.insts[k]
            if x.op == OP_CALL || x.op == OP_CALLI { ints_push(calls, p) }
            clear(tmp)
            uses_of(x, n, tmp)
            defs_of(x, n, tmp)
            for v in tmp {
                if v < names {
                    if start[v] < 0 || p < start[v] { start[v] = p }
                    if p > end[v] { end[v] = p }
                }
            }
            p += 1
            k += 1
        }
        let last = p
        clear(tmp)
        term_uses(f.terms[b], tmp)
        for v in tmp {
            if v < names {
                if start[v] < 0 || last < start[v] { start[v] = last }
                if last > end[v] { end[v] = last }
            }
        }
        pos = last + 1
        b += 1
    }
    // Liveness, name by name: live-in where a block reads it first, then backwards — live-out
    // at each predecessor, and live-in there too unless that block writes it. The least fixed
    // point of the dataflow equations, as iterating dense bit sets of every name in every block
    // reached; this costs what is live, not blocks × names a pass (performance leadership 7.3).
    let live_in = ints_new()
    let live_out = ints_new()
    let writes = ints_new()
    b = 0
    while b < nb {
        ints_push(live_in, -1)
        ints_push(live_out, -1)
        ints_push(writes, -1)
        b += 1
    }
    let work = ints_new()
    let mut v = 0
    while v < names {
        let mut j = def_at[v]
        while j < def_at[v + 1] {
            writes[def_of[j]] = v
            j += 1
        }
        j = use_at[v]
        while j < use_at[v + 1] {
            let u = use_of[j]
            if live_in[u] != v {
                live_in[u] = v
                ints_push(work, u)
            }
            j += 1
        }
        while ints_len(work) > 0 {
            let w = ints_pop(work)
            let first = first_at[w]
            if start[v] < 0 || first < start[v] { start[v] = first }
            if first > end[v] { end[v] = first }
            let mut e = pred_at[w]
            while e < pred_at[w + 1] {
                let q = preds[e]
                if live_out[q] != v {
                    live_out[q] = v
                    let last = last_at[q]
                    if start[v] < 0 || last < start[v] { start[v] = last }
                    if last > end[v] { end[v] = last }
                    if writes[q] != v && live_in[q] != v {
                        live_in[q] = v
                        ints_push(work, q)
                    }
                }
                e += 1
            }
        }
        v += 1
    }
    // Names in order of their start (a counting sort over positions).
    let count = ints_new()
    i = 0
    while i <= pos {
        ints_push(count, 0)
        i += 1
    }
    let order = ints_new()
    i = 0
    while i < names {
        let c = if i < n { if i < ints_len(vcls) { vcls[i] } else { -1 } } else { f.vars[i - n] }
        if start[i] >= 0 && c != C_I128 && c >= 0 { count[start[i]] = count[start[i]] + 1 }
        ints_push(order, -1)
        i += 1
    }
    let at = ints_new()
    let mut sum = 0
    i = 0
    while i <= pos {
        ints_push(at, sum)
        sum += count[i]
        i += 1
    }
    let sorted = ints_new()
    i = 0
    while i < sum {
        ints_push(sorted, 0)
        i += 1
    }
    i = 0
    while i < names {
        let c = if i < n { if i < ints_len(vcls) { vcls[i] } else { -1 } } else { f.vars[i - n] }
        if start[i] >= 0 && c != C_I128 && c >= 0 {
            sorted[at[start[i]]] = i
            at[start[i]] = at[start[i]] + 1
        }
        i += 1
    }
    // How many calls fall at or before each position.
    let before = ints_new()
    i = 0
    while i <= pos {
        ints_push(before, 0)
        i += 1
    }
    for p in calls { before[p] = before[p] + 1 }
    i = 1
    while i <= pos {
        before[i] = before[i] + before[i - 1]
        i += 1
    }
    // The scan: free registers, and the active names holding them.
    let total = nregs + ncaller
    let holder = ints_new()
    i = 0
    while i < total {
        ints_push(holder, -1)
        i += 1
    }
    for v in sorted {
        // Expire every active name that ended before this one starts.
        let mut r = 0
        while r < total {
            let h = holder[r]
            if h >= 0 && end[h] < start[v] { holder[r] = -1 }
            r += 1
        }
        let crosses = before[end[v]] -before[start[v]] > 0
        let mut free = -1
        r = nregs
        while r < total && !crosses {
            if holder[r] < 0 && free < 0 { free = r }
            r += 1
        }
        let mut furthest = -1
        r = 0
        while r < nregs {
            if holder[r] < 0 && free < 0 { free = r }
            if holder[r] >= 0 && (furthest < 0 || end[holder[r]] > end[holder[furthest]]) { furthest = r }
            r += 1
        }
        if free >= 0 {
            holder[free] = v
            loc[v] = free
        } else if furthest >= 0 && end[holder[furthest]] > end[v] {
            // The name that lives longest gives up its register, for its whole life.
            loc[holder[furthest]] = -1
            holder[furthest] = v
            loc[v] = furthest
        }
    }
    // The frame slots of the names left in memory, in order of their start: the first slot whose
    // holder's life has ended, or a new one.
    i = 0
    while i < names {
        ints_push(colors, -1)
        i += 1
    }
    let last_end = ints_new()
    for v in sorted {
        if loc[v] < 0 {
            let mut k = 0
            let mut got = -1
            while k < ints_len(last_end) && got < 0 {
                if last_end[k] < start[v] { got = k }
                k += 1
            }
            if got < 0 {
                got = ints_len(last_end)
                ints_push(last_end, end[v])
            } else {
                last_end[got] = end[v]
            }
            colors[v] = got
        }
    }
    loc
}

/// The frame offsets of a function's values (the first `n` names) and variables (the rest),
/// from `start`: a name with a shared slot (`colors`, from `allocate`) at its slot, a name in a
/// register at none, and the rest each in its own, 16 bytes for an `i128`. Returns the values'
/// offsets and their end, then the variables' and their end, as `lay_out` does for each.
pub fn frame_offsets(classes: Ints, vars: Ints, loc: Ints, colors: Ints, start: Int) -> Ints {
    let n = ints_len(classes)
    let names = n + ints_len(vars)
    let mut shared = 0
    for c in colors {
        if c + 1 > shared { shared = c + 1 }
    }
    let mut next = start + 8 * shared
    let out = ints_new()
    let mut v = 0
    while v < names {
        let c = if v < n { classes[v] } else { vars[v - n] }
        let col = if v < ints_len(colors) { colors[v] } else { -1 }
        let reg = v < ints_len(loc) && loc[v] >= 0
        if col >= 0 {
            ints_push(out, start + 8 * col)
        } else if reg && c != C_I128 {
            ints_push(out, start)
        } else {
            ints_push(out, next)
            next += if c == C_I128 { 16 } else { 8 }
        }
        v += 1
    }
    // Values, their end, variables, their end.
    let res = ints_new()
    v = 0
    while v < n {
        ints_push(res, out[v])
        v += 1
    }
    ints_push(res, next)
    while v < names {
        ints_push(res, out[v])
        v += 1
    }
    ints_push(res, next)
    res
}

/// `xs[from..to]`.
pub fn ints_part(xs: Ints, from: Int, to: Int) -> Ints {
    let out = ints_new()
    let mut i = from
    while i < to {
        ints_push(out, xs[i])
        i += 1
    }
    out
}

/// Which registers of `nregs` an allocation uses.
pub fn used_regs(loc: Ints, nregs: Int) -> Ints {
    let used = ints_new()
    let mut r = 0
    while r < nregs {
        let mut any = false
        for l in loc {
            if l == r { any = true }
        }
        if any { ints_push(used, r) }
        r += 1
    }
    used
}

fn clear(xs: Ints) {
    while ints_len(xs) > 0 {
        let x = ints_pop(xs)
    }
}
