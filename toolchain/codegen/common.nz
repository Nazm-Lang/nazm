// What both targets' selection share: a unit's code and its relocations, the classes of a
// function's values, the frame's layout of them, and the narrow-value rules' arithmetic (D5).

use "@std/bytebuf"
use "lir.nz"

// aarch64 relocation kinds (Mach-O's `ARM64_RELOC_*` numbers; the ELF writer maps them).
pub const R_BRANCH26: Int = 2
pub const R_PAGE21: Int = 3
pub const R_PAGEOFF12: Int = 4
pub const R_GOT_PAGE21: Int = 5
pub const R_GOT_PAGEOFF12: Int = 6

/// A unit's code: the bytes, the relocations against its symbols, where each function starts.
pub struct Code {
    buf: ByteBuf,
    rel_at: Ints,
    rel_kind: Ints,
    rel_sym: Ints,
    rel_pcrel: Ints,
    rel_len: Ints,
    sym_at: Ints,
    errors: Strs,
    /// Whether the target is Apple's (its AAPCS64 variant, Mach-O).
    apple: Bool,
}

pub fn code_new(nsyms: Int, apple: Bool) -> Code {
    let at = ints_new()
    let mut i = 0
    while i < nsyms {
        ints_push(at, -1)
        i += 1
    }
    Code(buf: bytebuf_new(), rel_at: ints_new(), rel_kind: ints_new(), rel_sym: ints_new(),
            rel_pcrel: ints_new(), rel_len: ints_new(),
            sym_at: at, errors: strs_new(), apple: apple)
}

pub fn align_up(x: Int, a: Int) -> Int {
    if a <= 1 { x } else { (x + a - 1) / a * a }
}

/// The width of a class in bytes, as it is stored in memory.
pub fn class_size(c: Int) -> Int {
    match c {
        0 => 1,
        1 => 1,
        2 => 2,
        3 => 4,
        5 => 4,
        8 => 16,
        _ => 8,
    }
}

pub fn is_float(c: Int) -> Bool {
    c == C_F32 || c == C_F64
}

pub fn width_bits(c: Int) -> Int {
    match c {
        0 => 1,
        1 => 8,
        2 => 16,
        3 => 32,
        5 => 32,
        _ => 64,
    }
}

/// A constant cut to its class's width, zero-extended (D5).
pub fn masked(v: Int, c: Int) -> Int {
    let bits = width_bits(c)
    if bits >= 64 { v } else { v & ((1 << bits) - 1) }
}

pub fn sym_ret(u: Unit, s: Int) -> Int {
    if s < 0 { C_NONE } else { u.syms[s].ret }
}

/// Every value's class, from what defines it; operations that take their operand's class are
/// settled by iterating until nothing changes, since a block may be printed before the block
/// that defines a value it uses.
pub fn infer(u: Unit, f: Func, n: Int) -> Ints {
    let vc = ints_new()
    let mut i = 0
    while i < n {
        ints_push(vc, -1)
        i += 1
    }
    let own = u.syms[f.sym]
    let mut changed = true
    let mut rounds = 0
    while changed && rounds < 50 {
        changed = false
        rounds += 1
        for x in f.insts {
            let mut d = -1
            let mut d2 = -1
            let op = x.op
            if op == OP_PARAM {
                d = if x.imm < ints_len(own.params) { own.params[x.imm] } else { -1 }
            } else if op == OP_CONST || op == OP_LOAD || op == OP_EXT || op == OP_TRUNC || op == OP_CONV {
                d = x.cls
            } else if op == OP_ADDR || op == OP_SLOT || op == OP_PTRADD || op == OP_INTTOPTR {
                d = C_PTR
            } else if op == OP_PTRTOINT {
                d = C_I64
            } else if op == OP_CMP {
                d = C_BIT
            } else if op == OP_BIN || op == OP_UN {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
            } else if op == OP_SELECT {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
            } else if op == OP_OVF {
                d = if x.a >= 0 && x.a < n { vc[x.a] } else { -1 }
                d2 = C_BIT
            } else if op == OP_GET {
                d = if x.imm >= 0 && x.imm < ints_len(f.vars) { f.vars[x.imm] } else { -1 }
            } else if op == OP_CALL {
                d = sym_ret(u, x.sym)
                d2 = C_BIT
            } else if op == OP_CALLI {
                d = x.sig_ret
                d2 = C_BIT
            }
            if x.dst >= 0 && x.dst < n && d >= 0 && vc[x.dst] != d {
                vc[x.dst] = d
                changed = true
            }
            if x.dst2 >= 0 && x.dst2 < n && d2 >= 0 && vc[x.dst2] != d2 {
                vc[x.dst2] = d2
                changed = true
            }
        }
    }
    vc
}

/// Offsets for things of these classes laid end to end from `start`, 8 bytes each and 16 for an
/// `i128`; the end, last.
pub fn lay_out(classes: Ints, start: Int) -> Ints {
    let out = ints_new()
    let mut off = start
    for c in classes {
        ints_push(out, off)
        off += if c == C_I128 { 16 } else { 8 }
    }
    ints_push(out, off)
    out
}

pub fn read_u32(b: ByteBuf, at: Int) -> Int {
    let mut v = 0
    let mut k = 3
    while k >= 0 {
        let x = match bytebuf_get(b, at + k) {
            Some(y) => Int(y),
            None => 0,
        }
        v = (v << 8) | x
        k -= 1
    }
    v
}

// x86_64 relocation kinds (Mach-O's `X86_64_RELOC_*` numbers).
pub const X_UNSIGNED: Int = 0
pub const X_SIGNED: Int = 1
pub const X_BRANCH: Int = 2
pub const X_GOT_LOAD: Int = 3

/// A relocation of `kind` against `sym` at `at`, pc-relative or not, 2^`len` bytes wide.
pub fn add_reloc(c: Code, at: Int, kind: Int, sym: Int, pcrel: Int, len: Int) {
    ints_push(c.rel_at, at)
    ints_push(c.rel_kind, kind)
    ints_push(c.rel_sym, sym)
    ints_push(c.rel_pcrel, pcrel)
    ints_push(c.rel_len, len)
}

// ---------------------------------------------------------------------------------------------
// Stage B (design D3): a linear scan over live intervals, into callee-saved registers only, so
// a call never clobbers an allocated value and the selection's scratch and argument registers
// stay its own. Names are a function's values (0..n) and then its variables (n..n + vars).

/// The names an instruction reads.
fn uses_of(x: Ins, n: Int, out: Ints) {
    let op = x.op
    if op == OP_LOC || op == OP_PARAM || op == OP_CONST || op == OP_ADDR || op == OP_SLOT {
        return
    }
    if op == OP_GET {
        ints_push(out, n + x.imm)
        return
    }
    if x.a >= 0 { ints_push(out, x.a) }
    if x.b >= 0 { ints_push(out, x.b) }
    if x.c >= 0 { ints_push(out, x.c) }
    if op == OP_CALL || op == OP_CALLI {
        for v in x.args { ints_push(out, v) }
    }
}

/// The names an instruction writes.
fn defs_of(x: Ins, n: Int, out: Ints) {
    if x.op == OP_SET {
        ints_push(out, n + x.imm)
        return
    }
    if x.op == OP_LOC { return }
    if x.dst >= 0 { ints_push(out, x.dst) }
    if x.dst2 >= 0 { ints_push(out, x.dst2) }
}

fn term_uses(t: Ins, out: Ints) {
    if (t.op == T_BRANCH || t.op == T_SWITCH || t.op == T_RETURN) && t.a >= 0 { ints_push(out, t.a) }
}

fn succs(t: Ins, out: Ints) {
    if t.op == T_JUMP {
        ints_push(out, t.imm)
    } else if t.op == T_BRANCH {
        ints_push(out, t.imm)
        ints_push(out, t.c)
    } else if t.op == T_SWITCH {
        let mut k = 1
        while k < ints_len(t.args) {
            ints_push(out, t.args[k])
            k += 2
        }
        ints_push(out, t.imm)
    }
}

fn bit_get(s: Ints, base: Int, i: Int) -> Bool {
    ((s[base + (i >> 5)] >> (i & 31)) & 1) == 1
}

fn bit_set(s: Ints, base: Int, i: Int) {
    let w = base + (i >> 5)
    s[w] = s[w] | (1 << (i & 31))
}

/// Each name's register, as an index into `nregs` callee-saved registers, or -1 for its frame
/// slot. A `bit` to `i64`, `ptr` or float value or variable may be allocated (all are held in
/// a general register as bits); an `i128` never is.
pub fn allocate(f: Func, n: Int, vcls: Ints, nregs: Int) -> Ints {
    let nv = ints_len(f.vars)
    let names = n + nv
    let loc = ints_new()
    let mut i = 0
    while i < names {
        ints_push(loc, -1)
        i += 1
    }
    let nb = ints_len(f.block_first)
    if nregs == 0 || names == 0 || nb == 0 || f.terms.len() != nb { return loc }
    let words = (names + 31) / 32
    // Per block: what it reads before writing, what it writes; then live-in and live-out.
    let use_s = ints_new()
    let def_s = ints_new()
    let live_in = ints_new()
    let live_out = ints_new()
    i = 0
    while i < nb * words {
        ints_push(use_s, 0)
        ints_push(def_s, 0)
        ints_push(live_in, 0)
        ints_push(live_out, 0)
        i += 1
    }
    let tmp = ints_new()
    let mut b = 0
    while b < nb {
        let base = b * words
        let mut k = f.block_first[b]
        while k < f.block_end[b] {
            let x = f.insts[k]
            clear(tmp)
            uses_of(x, n, tmp)
            for v in tmp {
                if v < names && !bit_get(def_s, base, v) { bit_set(use_s, base, v) }
            }
            clear(tmp)
            defs_of(x, n, tmp)
            for v in tmp {
                if v < names { bit_set(def_s, base, v) }
            }
            k += 1
        }
        clear(tmp)
        term_uses(f.terms[b], tmp)
        for v in tmp {
            if v < names && !bit_get(def_s, base, v) { bit_set(use_s, base, v) }
        }
        b += 1
    }
    let mut changed = true
    while changed {
        changed = false
        b = nb - 1
        while b >= 0 {
            let base = b * words
            clear(tmp)
            succs(f.terms[b], tmp)
            let mut w = 0
            while w < words {
                let mut o = 0
                for s in tmp {
                    if s >= 0 && s < nb { o = o | live_in[s * words + w] }
                }
                let inn = use_s[base + w] | (o & ~def_s[base + w])
                if o != live_out[base + w] || inn != live_in[base + w] {
                    live_out[base + w] = o
                    live_in[base + w] = inn
                    changed = true
                }
                w += 1
            }
            b -= 1
        }
    }
    // Intervals over positions in block order: each block's start, one per instruction, its
    // terminator. A name's interval spans every point it is defined, read, or live at a
    // block's edge.
    let start = ints_new()
    let end = ints_new()
    i = 0
    while i < names {
        ints_push(start, -1)
        ints_push(end, -1)
        i += 1
    }
    let mut pos = 0
    b = 0
    while b < nb {
        let base = b * words
        let first = pos
        let mut k = f.block_first[b]
        let mut p = pos + 1
        while k < f.block_end[b] {
            let x = f.insts[k]
            clear(tmp)
            uses_of(x, n, tmp)
            defs_of(x, n, tmp)
            for v in tmp {
                if v < names {
                    if start[v] < 0 || p < start[v] { start[v] = p }
                    if p > end[v] { end[v] = p }
                }
            }
            p += 1
            k += 1
        }
        let last = p
        clear(tmp)
        term_uses(f.terms[b], tmp)
        for v in tmp {
            if v < names {
                if start[v] < 0 || last < start[v] { start[v] = last }
                if last > end[v] { end[v] = last }
            }
        }
        let mut v = 0
        while v < names {
            if bit_get(live_in, base, v) {
                if start[v] < 0 || first < start[v] { start[v] = first }
                if first > end[v] { end[v] = first }
            }
            if bit_get(live_out, base, v) {
                if start[v] < 0 || last < start[v] { start[v] = last }
                if last > end[v] { end[v] = last }
            }
            v += 1
        }
        pos = last + 1
        b += 1
    }
    // Names in order of their start (a counting sort over positions).
    let count = ints_new()
    i = 0
    while i <= pos {
        ints_push(count, 0)
        i += 1
    }
    let order = ints_new()
    i = 0
    while i < names {
        let c = if i < n { if i < ints_len(vcls) { vcls[i] } else { -1 } } else { f.vars[i - n] }
        if start[i] >= 0 && c != C_I128 && c >= 0 { count[start[i]] = count[start[i]] + 1 }
        ints_push(order, -1)
        i += 1
    }
    let at = ints_new()
    let mut sum = 0
    i = 0
    while i <= pos {
        ints_push(at, sum)
        sum += count[i]
        i += 1
    }
    let sorted = ints_new()
    i = 0
    while i < sum {
        ints_push(sorted, 0)
        i += 1
    }
    i = 0
    while i < names {
        let c = if i < n { if i < ints_len(vcls) { vcls[i] } else { -1 } } else { f.vars[i - n] }
        if start[i] >= 0 && c != C_I128 && c >= 0 {
            sorted[at[start[i]]] = i
            at[start[i]] = at[start[i]] + 1
        }
        i += 1
    }
    // The scan: free registers, and the active names holding them.
    let holder = ints_new()
    i = 0
    while i < nregs {
        ints_push(holder, -1)
        i += 1
    }
    for v in sorted {
        // Expire every active name that ended before this one starts.
        let mut r = 0
        while r < nregs {
            let h = holder[r]
            if h >= 0 && end[h] < start[v] { holder[r] = -1 }
            r += 1
        }
        let mut free = -1
        let mut furthest = -1
        r = 0
        while r < nregs {
            if holder[r] < 0 && free < 0 { free = r }
            if holder[r] >= 0 && (furthest < 0 || end[holder[r]] > end[holder[furthest]]) { furthest = r }
            r += 1
        }
        if free >= 0 {
            holder[free] = v
            loc[v] = free
        } else if end[holder[furthest]] > end[v] {
            // The name that lives longest gives up its register, for its whole life.
            loc[holder[furthest]] = -1
            holder[furthest] = v
            loc[v] = furthest
        }
    }
    loc
}

/// Which registers of `nregs` an allocation uses.
pub fn used_regs(loc: Ints, nregs: Int) -> Ints {
    let used = ints_new()
    let mut r = 0
    while r < nregs {
        let mut any = false
        for l in loc {
            if l == r { any = true }
        }
        if any { ints_push(used, r) }
        r += 1
    }
    used
}

fn clear(xs: Ints) {
    while ints_len(xs) > 0 {
        let x = ints_pop(xs)
    }
}
