// Instruction selection for aarch64 (design D3). Every value, variable and parameter has its own
// 8-byte frame slot and every LIR slot its own aligned area; stage B's linear scan (`allocate`
// in `common.nz`) then keeps as many values and variables as fit in the callee-saved x19–x28
// instead. Each instruction loads its operands into scratch registers (x9–x12, d16–d17) from
// wherever they live, computes, and stores its result back, so the selection is the same with
// or without the allocator.
//
// Frame, from `sp` up: outgoing stack arguments, saved parameters, values, variables, slots;
// then the caller's `x29`/`x30` pair, which `x29` points at.
//
// Narrow values are kept zero-extended (D5); the calling convention is AAPCS64 as Apple
// specifies it, with a Nazm function's failure bit in the integer register after its result
// (D4). `x16` and `x17` are address scratch; `x17` also holds an indirect call's target.

use "@std/bytebuf"
use "lir.nz"
use "a64.nz"
use "common.nz"

/// One function being generated.
struct G {
    c: Code,
    u: Unit,
    f: Func,
    vcls: Ints,
    param_offs: Ints,
    voffs: Ints,
    varoffs: Ints,
    slot_off: Ints,
    blk_at: Ints,
    fix_at: Ints,
    fix_kind: Ints,
    fix_blk: Ints,
    /// Stage B: each name's register (an index from x19), or -1; the values' count; the
    /// callee-saved pairs saved (0 for x19/x20 … 4 for x27/x28), pushed below the frame record.
    loc: Ints,
    nvals: Int,
    saved: Ints,
}

/// The callee-saved registers the allocator hands out: x19–x28.
const NREGS: Int = 10

fn areg(i: Int) -> Int {
    19 + i
}

fn w(g: G, x: Int) {
    bytebuf_put_u32_le(g.c.buf, UInt32(x))
}

fn here(g: G) -> Int {
    bytebuf_len(g.c.buf)
}

fn refuse(g: G, what: Str) {
    strs_push(g.c.errors, f"{what}, in `{g.f.name}` of {g.u.source}")
}

fn reloc(g: G, kind: Int, sym: Int) {
    let pcrel = if kind == R_BRANCH26 || kind == R_PAGE21 || kind == R_GOT_PAGE21 { 1 } else { 0 }
    add_reloc(g.c, here(g), kind, sym, pcrel, 2)
}

// ---------------------------------------------------------------------------------------------
// Immediates and frame addressing.

/// `reg = v`, any 64-bit value, in the fewest `movz`/`movn`/`movk`.
fn mov_imm(g: G, reg: Int, v: Int) {
    let mut zeros = 0
    let mut ones = 0
    let mut k = 0
    while k < 4 {
        let h = (v >> (16 * k)) & 0xFFFF
        if h == 0 { zeros += 1 }
        if h == 0xFFFF { ones += 1 }
        k += 1
    }
    if ones > zeros {
        let mut first = true
        k = 0
        while k < 4 {
            let h = (v >> (16 * k)) & 0xFFFF
            if h != 0xFFFF {
                if first {
                    w(g, movn(reg, h ^ 0xFFFF, k))
                    first = false
                } else {
                    w(g, movk(reg, h, k))
                }
            }
            k += 1
        }
        if first { w(g, movn(reg, 0, 0)) }
    } else {
        let mut first = true
        k = 0
        while k < 4 {
            let h = (v >> (16 * k)) & 0xFFFF
            if h != 0 {
                if first {
                    w(g, movz(reg, h, k))
                    first = false
                } else {
                    w(g, movk(reg, h, k))
                }
            }
            k += 1
        }
        if first { w(g, movz(reg, 0, 0)) }
    }
}

/// `reg = base + off`, for a non-negative `off` below 2^24.
fn add_off(g: G, reg: Int, base: Int, off: Int) {
    if off < 4096 {
        w(g, add_imm(reg, base, off))
    } else if off < 16777216 {
        w(g, add_imm_lsl12(reg, base, off >> 12))
        if (off & 0xFFF) != 0 { w(g, add_imm(reg, reg, off & 0xFFF)) }
    } else {
        mov_imm(g, 16, off)
        w(g, add_ext(reg, base, 16))
    }
}

/// A load (zero-extending) or store of `size` bytes between `t` and `[base + off]`, any `off`;
/// `fp` for a floating-point register. Uses x16 and x17 when the offset needs them.
fn mem(g: G, size: Int, load: Bool, fp: Bool, t: Int, base: Int, off: Int) {
    if off >= 0 && off % size == 0 && off / size < 4096 {
        if fp {
            w(g, ldst_fp(size, load, t, base, off))
        } else {
            w(g, ldst_scaled(size, load, t, base, off))
        }
        return
    }
    if !fp && off >= -256 && off < 256 {
        w(g, ldst_unscaled(size, load, t, base, off))
        return
    }
    mov_imm(g, 17, off)
    w(g, add_ext(16, base, 17))
    if fp {
        w(g, ldst_fp(size, load, t, 16, 0))
    } else {
        w(g, ldst_scaled(size, load, t, 16, 0))
    }
}

fn voff(g: G, v: Int) -> Int {
    g.voffs[v]
}

/// `reg` = value `v`'s 8 bytes, from its register or its slot.
fn ld(g: G, reg: Int, v: Int) {
    if v < 0 {
        refuse(g, "an operand that is missing")
        return
    }
    if g.loc[v] >= 0 {
        if reg != areg(g.loc[v]) { w(g, mov(reg, areg(g.loc[v]))) }
    } else {
        mem(g, 8, true, false, reg, SP, voff(g, v))
    }
}

/// Value `v` = `reg`.
fn st(g: G, reg: Int, v: Int) {
    if v < 0 { return }
    if g.loc[v] >= 0 {
        if reg != areg(g.loc[v]) { w(g, mov(areg(g.loc[v]), reg)) }
    } else {
        mem(g, 8, false, false, reg, SP, voff(g, v))
    }
}

/// Variable `k`, from its register or slot, and back.
fn var_ld(g: G, reg: Int, k: Int) {
    let l = g.loc[g.nvals + k]
    if l >= 0 { w(g, mov(reg, areg(l))) } else { mem(g, 8, true, false, reg, SP, g.varoffs[k]) }
}

fn var_st(g: G, reg: Int, k: Int) {
    let l = g.loc[g.nvals + k]
    if l >= 0 { w(g, mov(areg(l), reg)) } else { mem(g, 8, false, false, reg, SP, g.varoffs[k]) }
}

/// An `i128` value's halves into two registers, and back.
fn ld128(g: G, lo: Int, hi: Int, v: Int) {
    ld(g, lo, v)
    mem(g, 8, true, false, hi, SP, voff(g, v) + 8)
}

fn st128(g: G, lo: Int, hi: Int, v: Int) {
    if v < 0 { return }
    st(g, lo, v)
    mem(g, 8, false, false, hi, SP, voff(g, v) + 8)
}

/// Copy a value of class `c` between two frame offsets.
fn copy_val(g: G, from: Int, to: Int, c: Int) {
    mem(g, 8, true, false, 9, SP, from)
    mem(g, 8, false, false, 9, SP, to)
    if c == C_I128 {
        mem(g, 8, true, false, 9, SP, from + 8)
        mem(g, 8, false, false, 9, SP, to + 8)
    }
}

/// A float value into a floating-point register.
fn ld_fp(g: G, reg: Int, v: Int) {
    let c = cls(g, v)
    if g.loc[v] >= 0 {
        w(g, fmov_to_fp(c != C_F32, reg, areg(g.loc[v])))
    } else {
        mem(g, if c == C_F32 { 4 } else { 8 }, true, true, reg, SP, voff(g, v))
    }
}

fn cls(g: G, v: Int) -> Int {
    if v < 0 || v >= ints_len(g.vcls) { C_I64 } else { g.vcls[v] }
}

/// Keep a narrow class zero-extended (D5).
fn norm(g: G, reg: Int, c: Int) {
    if c == C_BIT {
        w(g, and1_w(reg, reg))
    } else if c == C_I8 {
        w(g, uxtb(reg, reg))
    } else if c == C_I16 {
        w(g, uxth(reg, reg))
    } else if c == C_I32 || c == C_F32 {
        w(g, mov_w(reg, reg))
    }
}

/// Sign-extend a narrow class to 64 bits, for an operation that reads it as signed.
fn sext(g: G, reg: Int, c: Int) {
    if c == C_BIT {
        w(g, sbfx1(reg, reg))
    } else if c == C_I8 {
        w(g, sxtb(reg, reg))
    } else if c == C_I16 {
        w(g, sxth(reg, reg))
    } else if c == C_I32 {
        w(g, sxtw(reg, reg))
    }
}

// ---------------------------------------------------------------------------------------------
// Classes of values.

// ---------------------------------------------------------------------------------------------
// The calling convention (D4): where each argument goes.

/// For each argument class: a kind (0 an integer register, 1 a floating-point register, 2 the
/// stack) and its register number or stack offset, as pairs; then the stack bytes used, last.
/// AAPCS64: eight of each register kind; stack arguments at their natural alignment, packed on
/// Apple's platforms and in eight-byte slots elsewhere.
fn assign(classes: Ints, apple: Bool) -> Ints {
    let out = ints_new()
    let mut ngr = 0
    let mut nfr = 0
    let mut stack = 0
    for c in classes {
        if is_float(c) {
            if nfr < 8 {
                ints_push(out, 1)
                ints_push(out, nfr)
                nfr += 1
            } else {
                // Apple packs stack arguments at their natural size; AAPCS64 gives each at
                // least eight bytes.
                let sz = if apple || class_size(c) >= 8 { class_size(c) } else { 8 }
                stack = align_up(stack, sz)
                ints_push(out, 2)
                ints_push(out, stack)
                stack += sz
            }
        } else if c == C_I128 {
            if ngr % 2 == 1 { ngr += 1 }
            if ngr <= 6 {
                ints_push(out, 0)
                ints_push(out, ngr)
                ngr += 2
            } else {
                ngr = 8
                stack = align_up(stack, 16)
                ints_push(out, 2)
                ints_push(out, stack)
                stack += 16
            }
        } else {
            if ngr < 8 {
                ints_push(out, 0)
                ints_push(out, ngr)
                ngr += 1
            } else {
                // Apple packs stack arguments at their natural size; AAPCS64 gives each at
                // least eight bytes.
                let sz = if apple || class_size(c) >= 8 { class_size(c) } else { 8 }
                stack = align_up(stack, sz)
                ints_push(out, 2)
                ints_push(out, stack)
                stack += sz
            }
        }
    }
    ints_push(out, stack)
    out
}

/// The classes a call passes, from its callee's signature.
fn call_params(u: Unit, x: Ins) -> Ints {
    if x.op == OP_CALLI { x.sig_params } else { u.syms[x.sym].params }
}

fn call_ret(u: Unit, x: Ins) -> Int {
    if x.op == OP_CALLI { x.sig_ret } else { u.syms[x.sym].ret }
}

fn call_conv(u: Unit, x: Ins) -> Int {
    if x.op == OP_CALLI { x.sig_conv } else { u.syms[x.sym].conv }
}

// ---------------------------------------------------------------------------------------------
// One function.

/// Generate `f` into `c`.
pub fn gen_function(c: Code, u: Unit, f: Func) {
    // How many values, and how much outgoing stack the calls need.
    let mut n = 0
    let mut out = 0
    for x in f.insts {
        if x.dst + 1 > n { n = x.dst + 1 }
        if x.dst2 + 1 > n { n = x.dst2 + 1 }
        if x.op == OP_CALL || x.op == OP_CALLI {
            let a = assign(call_params(u, x), c.apple)
            let s = a[ints_len(a) - 1]
            if s > out { out = s }
        }
    }
    let own = u.syms[f.sym]
    let vcls = infer(u, f, n)
    let param_offs = lay_out(own.params, align_up(out, 16))
    let voffs = lay_out(vcls, param_offs[ints_len(param_offs) - 1])
    let varoffs = lay_out(f.vars, voffs[ints_len(voffs) - 1])
    let mut off = varoffs[ints_len(varoffs) - 1]
    let slot_off = ints_new()
    let mut k = 0
    while k < ints_len(f.slot_size) {
        let al = f.slot_align[k]
        if al > 16 {
            strs_push(c.errors, f"a slot aligned to {al} bytes, in `{f.name}` of {u.source}")
        }
        off = align_up(off, if al < 1 { 1 } else { al })
        ints_push(slot_off, off)
        off += f.slot_size[k]
        k += 1
    }
    let loc = allocate(f, n, vcls, NREGS)
    let used = used_regs(loc, NREGS)
    let saved = ints_new()
    let mut p = 0
    while p < NREGS / 2 {
        let mut any = false
        for r in used {
            if r / 2 == p { any = true }
        }
        if any { ints_push(saved, p) }
        p += 1
    }
    let size = align_up(off, 16)
    let g = G(c: c, u: u, f: f, vcls: vcls, param_offs: param_offs, voffs: voffs,
            varoffs: varoffs, slot_off: slot_off, blk_at: ints_new(), fix_at: ints_new(),
            fix_kind: ints_new(), fix_blk: ints_new(), loc: loc, nvals: n, saved: saved)
    ints_set(c.sym_at, f.sym, here(g))
    // Compact unwind's frame mode: the frame record, and a bit per saved pair (D10, 5.2).
    let mut enc = 0x04000000
    for q in saved { enc = enc | (1 << q) }
    ints_set(c.fn_enc, f.sym, enc)
    prologue(g, size)
    let nb = ints_len(f.block_first)
    let mut bi = 0
    while bi < nb {
        ints_push(g.blk_at, here(g))
        let first = f.block_first[bi]
        let end = f.block_end[bi]
        let mut i = first
        while i < end {
            inst(g, f.insts[i])
            i += 1
        }
        if bi < f.terms.len() {
            term(g, f.terms[bi], bi)
        } else {
            refuse(g, f"block b{bi} has no terminator")
        }
        bi += 1
    }
    // Branches to blocks, now that every block's place is known.
    let mut j = 0
    while j < ints_len(g.fix_at) {
        let at = g.fix_at[j]
        let tb = g.fix_blk[j]
        if tb < 0 || tb >= ints_len(g.blk_at) {
            refuse(g, f"a branch to block b{tb}, which does not exist")
        } else {
            let delta = g.blk_at[tb] -at
            let word = read_u32(c.buf, at)
            let patched = if g.fix_kind[j] == 0 {
                word | ((delta >> 2) & 0x3FFFFFF)
            } else {
                if delta >= 1048576 || delta < -1048576 {
                    refuse(g, "a conditional branch further than 1 MiB")
                }
                word | (((delta >> 2) & 0x7FFFF) << 5)
            }
            bytebuf_patch_u32_le(c.buf, at, UInt32(patched))
        }
        j += 1
    }
}

/// A branch to block `b`, patched once blocks are placed: `kind` 0 a `b`, 1 a `cbz`/`cbnz`/
/// `b.cond`.
fn branch_to(g: G, kind: Int, word: Int, b: Int) {
    ints_push(g.fix_at, here(g))
    ints_push(g.fix_kind, kind)
    ints_push(g.fix_blk, b)
    w(g, word)
}

fn prologue(g: G, size: Int) {
    w(g, push_frame())
    w(g, mov_sp(29, SP))
    // The callee-saved pairs the allocation uses, x19 at x29-8 and x20 at x29-16, the next pair
    // below: the layout compact unwind's frame mode describes.
    for q in g.saved {
        w(g, stp_pre(areg(2 * q + 1), areg(2 * q), SP, -16))
    }
    if size > 0 {
        if size <= 4096 {
            if size < 4096 {
                w(g, sub_imm(SP, SP, size))
            } else {
                w(g, sub_imm_lsl12(SP, SP, 1))
            }
        } else {
            // Probe each page as the frame grows, as LLVM's frames do (Q1-A1-01): a frame
            // larger than a guard page faults on the guard rather than stepping over it.
            let pages = size / 4096
            mov_imm(g, 16, pages)
            w(g, sub_imm_lsl12(SP, SP, 1))
            w(g, ldst_scaled(8, false, ZR, SP, 0))
            w(g, subs_imm(16, 16, 1))
            w(g, b_cond(NE, -12))
            let rest = size - pages * 4096
            if rest > 0 { w(g, sub_imm(SP, SP, rest)) }
        }
    }
    // Every parameter into its slot, normalised (D5).
    let own = g.u.syms[g.f.sym]
    let a = assign(own.params, g.c.apple)
    let mut i = 0
    while i < ints_len(own.params) {
        let c = own.params[i]
        let kind = a[2 * i]
        let r = a[2 * i + 1]
        let to = g.param_offs[i]
        if c == C_I128 && kind == 0 {
            mem(g, 8, false, false, r, SP, to)
            mem(g, 8, false, false, r + 1, SP, to + 8)
        } else if c == C_I128 {
            mem(g, 8, true, false, 9, 29, 16 + r)
            mem(g, 8, false, false, 9, SP, to)
            mem(g, 8, true, false, 9, 29, 24 + r)
            mem(g, 8, false, false, 9, SP, to + 8)
        } else if kind == 0 {
            norm(g, r, c)
            mem(g, 8, false, false, r, SP, to)
        } else if kind == 1 {
            w(g, fmov_from_fp(c == C_F64, 9, r))
            mem(g, 8, false, false, 9, SP, to)
        } else {
            mem(g, class_size(c), true, false, 9, 29, 16 + r)
            norm(g, 9, c)
            mem(g, 8, false, false, 9, SP, to)
        }
        i += 1
    }
}

fn epilogue(g: G) {
    let mut j = 0
    while j < ints_len(g.saved) {
        let q = g.saved[j]
        w(g, ldp_off(areg(2 * q + 1), areg(2 * q), 29, -16 * (j + 1)))
        j += 1
    }
    w(g, mov_sp(SP, 29))
    w(g, pop_frame())
    w(g, ret())
}

// ---------------------------------------------------------------------------------------------
// Instructions.

fn inst(g: G, x: Ins) {
    let op = x.op
    if op == OP_PARAM {
        if x.imm < 0 || x.imm + 1 >= ints_len(g.param_offs) {
            refuse(g, f"parameter {x.imm}, which does not exist")
            return
        }
        if cls(g, x.dst) == C_I128 {
            copy_val(g, g.param_offs[x.imm], voff(g, x.dst), C_I128)
        } else {
            mem(g, 8, true, false, 9, SP, g.param_offs[x.imm])
            st(g, 9, x.dst)
        }
    } else if op == OP_CONST {
        mov_imm(g, 9, masked(x.imm, x.cls))
        if x.cls == C_I128 {
            mov_imm(g, 10, x.imm_hi)
            st128(g, 9, 10, x.dst)
        } else {
            st(g, 9, x.dst)
        }
    } else if op == OP_ADDR {
        sym_addr(g, 9, x.sym)
        st(g, 9, x.dst)
    } else if op == OP_SLOT {
        if x.imm < 0 || x.imm >= ints_len(g.slot_off) {
            refuse(g, f"slot s{x.imm}, which does not exist")
            return
        }
        add_off(g, 9, SP, g.slot_off[x.imm])
        st(g, 9, x.dst)
    } else if op == OP_LOAD {
        ld(g, 10, x.a)
        if x.cls == C_I128 {
            mem(g, 8, true, false, 9, 10, x.imm)
            mem(g, 8, true, false, 11, 10, x.imm + 8)
            st128(g, 9, 11, x.dst)
        } else {
            mem(g, class_size(x.cls), true, false, 9, 10, x.imm)
            st(g, 9, x.dst)
        }
    } else if op == OP_STORE {
        let c = cls(g, x.b)
        ld(g, 10, x.a)
        if c == C_I128 {
            ld128(g, 9, 11, x.b)
            mem(g, 8, false, false, 9, 10, x.imm)
            mem(g, 8, false, false, 11, 10, x.imm + 8)
        } else {
            ld(g, 9, x.b)
            mem(g, class_size(c), false, false, 9, 10, x.imm)
        }
    } else if op == OP_BIN {
        bin(g, x)
    } else if op == OP_OVF {
        ovf(g, x)
    } else if op == OP_CMP {
        compare(g, x)
    } else if op == OP_SELECT {
        ld(g, 11, x.c)
        w(g, cmp_imm(11, 0))
        if cls(g, x.a) == C_I128 {
            ld128(g, 9, 10, x.a)
            ld128(g, 12, 13, x.b)
            w(g, csel(9, 9, 12, NE))
            w(g, csel(10, 10, 13, NE))
            st128(g, 9, 10, x.dst)
        } else {
            ld(g, 9, x.a)
            ld(g, 10, x.b)
            w(g, csel(9, 9, 10, NE))
            st(g, 9, x.dst)
        }
    } else if op == OP_UN {
        unary(g, x)
    } else if op == OP_CONV {
        convert(g, x)
    } else if op == OP_EXT {
        let from = cls(g, x.a)
        if from == C_I128 {
            copy_val(g, voff(g, x.a), voff(g, x.dst), C_I128)
            return
        }
        ld(g, 9, x.a)
        if x.sub == 1 { sext(g, 9, from) }
        if x.cls == C_I128 {
            // The high half: the sign, or zero.
            if x.sub == 1 { w(g, asr63(10, 9)) } else { w(g, movz(10, 0, 0)) }
            st128(g, 9, 10, x.dst)
        } else {
            norm(g, 9, x.cls)
            st(g, 9, x.dst)
        }
    } else if op == OP_TRUNC {
        if x.cls == C_I128 {
            copy_val(g, voff(g, x.a), voff(g, x.dst), C_I128)
            return
        }
        ld(g, 9, x.a)
        norm(g, 9, x.cls)
        st(g, 9, x.dst)
    } else if op == OP_PTRADD {
        ld(g, 9, x.a)
        ld(g, 10, x.b)
        w(g, add(9, 9, 10))
        st(g, 9, x.dst)
    } else if op == OP_PTRTOINT || op == OP_INTTOPTR {
        ld(g, 9, x.a)
        st(g, 9, x.dst)
    } else if op == OP_GET {
        if x.imm < 0 || x.imm >= ints_len(g.f.vars) {
            refuse(g, f"variable x{x.imm}, which does not exist")
            return
        }
        if g.f.vars[x.imm] == C_I128 {
            copy_val(g, g.varoffs[x.imm], voff(g, x.dst), C_I128)
        } else {
            var_ld(g, 9, x.imm)
            st(g, 9, x.dst)
        }
    } else if op == OP_SET {
        if x.imm < 0 || x.imm >= ints_len(g.f.vars) {
            refuse(g, f"variable x{x.imm}, which does not exist")
            return
        }
        if g.f.vars[x.imm] == C_I128 {
            copy_val(g, voff(g, x.a), g.varoffs[x.imm], C_I128)
        } else {
            ld(g, 9, x.a)
            var_st(g, 9, x.imm)
        }
    } else if op == OP_CALL || op == OP_CALLI {
        call(g, x)
    } else if op == OP_COPY {
        ld(g, 9, x.a)
        ld(g, 10, x.b)
        copy_bytes(g, x.imm, false)
    } else if op == OP_ZERO {
        ld(g, 9, x.a)
        copy_bytes(g, x.imm, true)
    } else if op == OP_LOC {
        add_loc(g.c, x)
    } else {
        refuse(g, f"instruction kind {op}")
    }
}

/// `reg` = a symbol's address: a defined one by `adrp`/`add`, an imported one through the GOT.
fn sym_addr(g: G, reg: Int, s: Int) {
    if g.u.syms[s].link == L_IMPORT {
        reloc(g, R_GOT_PAGE21, s)
        w(g, adrp(reg))
        reloc(g, R_GOT_PAGEOFF12, s)
        w(g, ldr_x(reg, reg, 0))
    } else {
        reloc(g, R_PAGE21, s)
        w(g, adrp(reg))
        reloc(g, R_PAGEOFF12, s)
        w(g, add_imm(reg, reg, 0))
    }
}

/// Copy `size` bytes from `[x10]` to `[x9]`, or zero them; x11 and x12 scratch.
fn copy_bytes(g: G, size: Int, zero: Bool) {
    let mut left = size
    if left >= 64 {
        let n = left / 8
        mov_imm(g, 12, n)
        let top = here(g)
        if zero {
            w(g, str_post(8, ZR, 9, 8))
        } else {
            w(g, ldr_post(8, 11, 10, 8))
            w(g, str_post(8, 11, 9, 8))
        }
        w(g, subs_imm(12, 12, 1))
        w(g, b_cond(NE, top - here(g)))
        left -= n * 8
    }
    for e in 0..4 {
        let sz = 8 >> e
        while left >= sz {
            if zero {
                w(g, str_post(sz, ZR, 9, sz))
            } else {
                w(g, ldr_post(sz, 11, 10, sz))
                w(g, str_post(sz, 11, 9, sz))
            }
            left -= sz
        }
    }
}

fn bin(g: G, x: Ins) {
    let c = cls(g, x.a)
    let s = x.sub
    if c == C_I128 {
        bin128(g, x)
        return
    }
    if s >= B_FADD {
        let dbl = c == C_F64
        ld_fp(g, 16, x.a)
        ld_fp(g, 17, x.b)
        if s == B_FADD {
            w(g, fadd(dbl, 16, 16, 17))
        } else if s == B_FSUB {
            w(g, fsub(dbl, 16, 16, 17))
        } else if s == B_FMUL {
            w(g, fmul(dbl, 16, 16, 17))
        } else {
            w(g, fdiv(dbl, 16, 16, 17))
        }
        w(g, fmov_from_fp(dbl, 9, 16))
        st(g, 9, x.dst)
        return
    }
    ld(g, 9, x.a)
    ld(g, 10, x.b)
    if s == B_ADD {
        w(g, add(9, 9, 10))
    } else if s == B_SUB {
        w(g, sub(9, 9, 10))
    } else if s == B_MUL {
        w(g, mul(9, 9, 10))
    } else if s == B_SDIV || s == B_SREM {
        sext(g, 9, c)
        sext(g, 10, c)
        w(g, sdiv(11, 9, 10))
        if s == B_SDIV { w(g, mov(9, 11)) } else { w(g, msub(9, 11, 10, 9)) }
    } else if s == B_UDIV || s == B_UREM {
        w(g, udiv(11, 9, 10))
        if s == B_UDIV { w(g, mov(9, 11)) } else { w(g, msub(9, 11, 10, 9)) }
    } else if s == B_AND {
        w(g, and(9, 9, 10))
    } else if s == B_OR {
        w(g, orr(9, 9, 10))
    } else if s == B_XOR {
        w(g, eor(9, 9, 10))
    } else if s == B_SHL {
        w(g, lslv(9, 9, 10))
    } else if s == B_LSHR {
        w(g, lsrv(9, 9, 10))
    } else if s == B_ASHR {
        sext(g, 9, c)
        w(g, asrv(9, 9, 10))
    } else if s == B_ROTL || s == B_ROTR {
        let bits = width_bits(c)
        if bits == 64 {
            if s == B_ROTL { w(g, neg(10, 10)) }
            w(g, rorv(9, 9, 10))
        } else if bits == 32 {
            if s == B_ROTL { w(g, neg_w(10, 10)) }
            w(g, rorv_w(9, 9, 10))
        } else {
            // 8 and 16 bits: (x >> n) | (x << (w - n)), the amount modulo the width.
            mov_imm(g, 12, bits - 1)
            w(g, and(10, 10, 12))
            if s == B_ROTL {
                mov_imm(g, 12, bits)
                w(g, sub(10, 12, 10))
                mov_imm(g, 12, bits - 1)
                w(g, and(10, 10, 12))
            }
            mov_imm(g, 12, bits)
            w(g, sub(12, 12, 10))
            w(g, lslv(12, 9, 12))
            w(g, lsrv(9, 9, 10))
            w(g, orr(9, 9, 12))
        }
    } else {
        refuse(g, f"binary operation {s}")
        return
    }
    norm(g, 9, c)
    st(g, 9, x.dst)
}

fn ovf(g: G, x: Ins) {
    let c = cls(g, x.a)
    let s = x.sub
    if c == C_I128 {
        ovf128(g, x)
        return
    }
    ld(g, 9, x.a)
    ld(g, 10, x.b)
    let bits = width_bits(c)
    let signed = s == O_ADD || s == O_SUB || s == O_MUL
    if bits == 64 {
        if s == O_ADD {
            w(g, adds(9, 9, 10))
            w(g, cset(11, VS))
        } else if s == O_SUB {
            w(g, subs(9, 9, 10))
            w(g, cset(11, VS))
        } else if s == O_UADD {
            w(g, adds(9, 9, 10))
            w(g, cset(11, HS))
        } else if s == O_USUB {
            w(g, subs(9, 9, 10))
            w(g, cset(11, LO))
        } else if s == O_MUL {
            w(g, mul(11, 9, 10))
            w(g, smulh(12, 9, 10))
            w(g, cmp_asr(12, 11, 63))
            w(g, mov(9, 11))
            w(g, cset(11, NE))
        } else {
            w(g, mul(11, 9, 10))
            w(g, umulh(12, 9, 10))
            w(g, cmp_imm(12, 0))
            w(g, mov(9, 11))
            w(g, cset(11, NE))
        }
    } else {
        // Narrow: exact at 64 bits, an overflow when the result does not survive the cut.
        if signed {
            sext(g, 9, c)
            sext(g, 10, c)
        }
        if s == O_ADD || s == O_UADD {
            w(g, add(9, 9, 10))
        } else if s == O_SUB || s == O_USUB {
            w(g, sub(9, 9, 10))
        } else {
            w(g, mul(9, 9, 10))
        }
        // x12 = the result cut to the class (and sign-extended, signed): it differs from x9
        // exactly when the result does not fit.
        w(g, mov(12, 9))
        norm(g, 12, c)
        if signed { sext(g, 12, c) }
        w(g, cmp(12, 9))
        w(g, cset(11, NE))
        norm(g, 9, c)
    }
    st(g, 9, x.dst)
    st(g, 11, x.dst2)
}

fn int_cond(k: Int) -> Int {
    match k {
        0 => EQ,
        1 => NE,
        2 => LT,
        3 => LE,
        4 => GT,
        5 => GE,
        6 => LO,
        7 => LS,
        8 => HI,
        _ => HS,
    }
}

fn float_cond(k: Int) -> Int {
    match k {
        10 => EQ,
        11 => NE,
        12 => MI,
        13 => LS,
        14 => GT,
        _ => GE,
    }
}

fn compare(g: G, x: Ins) {
    let c = cls(g, x.a)
    if c == C_I128 {
        compare128(g, x)
        return
    }
    if x.sub >= K_FEQ {
        let dbl = c == C_F64
        ld_fp(g, 16, x.a)
        ld_fp(g, 17, x.b)
        w(g, fcmp(dbl, 16, 17))
        w(g, cset(9, float_cond(x.sub)))
        st(g, 9, x.dst)
        return
    }
    ld(g, 9, x.a)
    ld(g, 10, x.b)
    if x.sub >= K_LT && x.sub <= K_GE {
        sext(g, 9, c)
        sext(g, 10, c)
    }
    w(g, cmp(9, 10))
    w(g, cset(9, int_cond(x.sub)))
    st(g, 9, x.dst)
}

fn unary(g: G, x: Ins) {
    let c = cls(g, x.a)
    let s = x.sub
    if c == C_I128 {
        refuse(g, "an `i128` operation")
        return
    }
    if s <= U_FTRUNC {
        let dbl = c == C_F64
        ld_fp(g, 16, x.a)
        if s == U_FNEG {
            w(g, fneg(dbl, 16, 16))
        } else if s == U_FSQRT {
            w(g, fsqrt(dbl, 16, 16))
        } else if s == U_FABS {
            w(g, fabs(dbl, 16, 16))
        } else if s == U_FFLOOR {
            w(g, frintm(dbl, 16, 16))
        } else if s == U_FCEIL {
            w(g, frintp(dbl, 16, 16))
        } else {
            w(g, frintz(dbl, 16, 16))
        }
        w(g, fmov_from_fp(dbl, 9, 16))
        st(g, 9, x.dst)
        return
    }
    ld(g, 9, x.a)
    let bits = width_bits(c)
    if s == U_POPCNT {
        w(g, fmov_to_fp(true, 16, 9))
        w(g, cnt8b(16, 16))
        w(g, addv8b(16, 16))
        w(g, fmov_from_fp(false, 9, 16))
    } else if s == U_CLZ {
        w(g, clz(9, 9))
        if bits < 64 {
            mov_imm(g, 10, 64 - bits)
            w(g, sub(9, 9, 10))
        }
    } else if s == U_CTZ {
        if bits < 64 {
            // A bit just above the width, so a zero counts to the width.
            mov_imm(g, 10, 1 << bits)
            w(g, orr(9, 9, 10))
        }
        w(g, rbit(9, 9))
        w(g, clz(9, 9))
    } else if s == U_BSWAP {
        if bits == 64 {
            w(g, rev(9, 9))
        } else if bits == 32 {
            w(g, rev_w(9, 9))
        } else if bits == 16 {
            w(g, rev16_w(9, 9))
        }
    } else {
        refuse(g, f"unary operation {s}")
        return
    }
    norm(g, 9, c)
    st(g, 9, x.dst)
}

fn convert(g: G, x: Ins) {
    let from = cls(g, x.a)
    let to = x.cls
    let s = x.sub
    if from == C_I128 || to == C_I128 {
        refuse(g, "an `i128` conversion")
        return
    }
    if s == V_STOF || s == V_UTOF {
        ld(g, 9, x.a)
        if s == V_STOF {
            sext(g, 9, from)
            w(g, scvtf(to == C_F64, 16, 9))
        } else {
            w(g, ucvtf(to == C_F64, 16, 9))
        }
        w(g, fmov_from_fp(to == C_F64, 9, 16))
    } else if s == V_FTOS || s == V_FTOU {
        ld_fp(g, 16, x.a)
        if s == V_FTOS {
            w(g, fcvtzs(from == C_F64, 9, 16))
        } else {
            w(g, fcvtzu(from == C_F64, 9, 16))
        }
        if width_bits(to) < 64 {
            // Saturate at the class's range, as Cranelift's and LLVM's saturating forms do.
            let bits = width_bits(to)
            if s == V_FTOS {
                mov_imm(g, 10, (1 << (bits - 1)) - 1)
                w(g, cmp(9, 10))
                w(g, csel(9, 10, 9, GT))
                mov_imm(g, 10, 0 - (1 << (bits - 1)))
                w(g, cmp(9, 10))
                w(g, csel(9, 10, 9, LT))
            } else {
                mov_imm(g, 10, (1 << bits) - 1)
                w(g, cmp(9, 10))
                w(g, csel(9, 10, 9, HI))
            }
        }
        norm(g, 9, to)
    } else if s == V_FEXT {
        ld_fp(g, 16, x.a)
        w(g, fcvt_s_to_d(16, 16))
        w(g, fmov_from_fp(true, 9, 16))
    } else if s == V_FTRUNC {
        ld_fp(g, 16, x.a)
        w(g, fcvt_d_to_s(16, 16))
        w(g, fmov_from_fp(false, 9, 16))
    } else {
        // The same bits as another class of the same width.
        ld(g, 9, x.a)
        norm(g, 9, to)
    }
    st(g, 9, x.dst)
}

fn call(g: G, x: Ins) {
    let params = call_params(g.u, x)
    let ret = call_ret(g.u, x)
    let conv = call_conv(g.u, x)
    if ints_len(params) != ints_len(x.args) {
        refuse(g, "a call whose arguments do not match its callee")
        return
    }
    let a = assign(params, g.c.apple)
    // Stack arguments first, while x9 is free; then the registers.
    let mut i = 0
    while i < ints_len(params) {
        let c = params[i]
        if a[2 * i] == 2 && c == C_I128 {
            ld128(g, 9, 10, x.args[i])
            mem(g, 8, false, false, 9, SP, a[2 * i + 1])
            mem(g, 8, false, false, 10, SP, a[2 * i + 1] + 8)
        } else if a[2 * i] == 2 {
            ld(g, 9, x.args[i])
            mem(g, class_size(c), false, false, 9, SP, a[2 * i + 1])
        }
        i += 1
    }
    i = 0
    while i < ints_len(params) {
        let c = params[i]
        let kind = a[2 * i]
        if kind == 0 && c == C_I128 {
            ld128(g, a[2 * i + 1], a[2 * i + 1] + 1, x.args[i])
        } else if kind == 0 {
            ld(g, a[2 * i + 1], x.args[i])
        } else if kind == 1 {
            ld_fp(g, a[2 * i + 1], x.args[i])
        }
        i += 1
    }
    if x.op == OP_CALLI {
        ld(g, 17, x.a)
        w(g, blr(17))
    } else {
        reloc(g, R_BRANCH26, x.sym)
        w(g, bl(0))
    }
    // The result, then a Nazm callee's failure bit in the next integer register (D4).
    let mut bit_reg = 0
    if ret >= 0 {
        if is_float(ret) {
            w(g, fmov_from_fp(ret == C_F64, 9, 0))
            st(g, 9, x.dst)
        } else if ret == C_I128 {
            st128(g, 0, 1, x.dst)
            bit_reg = 2
        } else {
            norm(g, 0, ret)
            st(g, 0, x.dst)
            bit_reg = 1
        }
    }
    if conv == CONV_NAZM && x.dst2 >= 0 {
        w(g, and1_w(9, bit_reg))
        st(g, 9, x.dst2)
    }
}

// ---------------------------------------------------------------------------------------------
// Terminators.

fn term(g: G, t: Ins, bi: Int) {
    let op = t.op
    if op == T_JUMP {
        if t.imm != bi + 1 { branch_to(g, 0, b(0), t.imm) }
    } else if op == T_BRANCH {
        ld(g, 9, t.a)
        if t.imm == bi + 1 {
            branch_to(g, 1, cbz(9, 0), t.c)
        } else if t.c == bi + 1 {
            branch_to(g, 1, cbnz(9, 0), t.imm)
        } else {
            branch_to(g, 1, cbnz(9, 0), t.imm)
            branch_to(g, 0, b(0), t.c)
        }
    } else if op == T_SWITCH {
        let c = cls(g, t.a)
        ld(g, 9, t.a)
        let mut k = 0
        while k + 1 < ints_len(t.args) {
            mov_imm(g, 10, masked(t.args[k], c))
            w(g, cmp(9, 10))
            branch_to(g, 1, b_cond(EQ, 0), t.args[k + 1])
            k += 2
        }
        if t.imm != bi + 1 { branch_to(g, 0, b(0), t.imm) }
    } else if op == T_RETURN {
        let own = g.u.syms[g.f.sym]
        let mut bit_reg = 0
        if t.a >= 0 {
            let c = own.ret
            if c == C_I128 {
                ld128(g, 0, 1, t.a)
                bit_reg = 2
            } else if is_float(c) {
                ld_fp(g, 0, t.a)
            } else {
                ld(g, 0, t.a)
                bit_reg = 1
            }
        }
        if own.conv == CONV_NAZM { w(g, movz(bit_reg, 0, 0)) }
        epilogue(g)
    } else if op == T_FAIL {
        // The failure exit: a zero where the result would be, and the bit set.
        let own = g.u.syms[g.f.sym]
        let mut bit_reg = 0
        if own.ret >= 0 {
            if is_float(own.ret) {
                w(g, fmov_to_fp(own.ret == C_F64, 0, ZR))
            } else if own.ret == C_I128 {
                w(g, movz(0, 0, 0))
                w(g, movz(1, 0, 0))
                bit_reg = 2
            } else {
                w(g, movz(0, 0, 0))
                bit_reg = 1
            }
        }
        w(g, movz(bit_reg, 1, 0))
        epilogue(g)
    } else if op == T_UNREACHABLE {
        w(g, brk(1))
    } else {
        refuse(g, f"terminator kind {op}")
    }
}

// ---------------------------------------------------------------------------------------------
// `i128`: a pair of registers, low half first (R1b, L13b). Division, remainder, a signed checked
// product and conversions are runtime calls already; what remains is here.

fn bin128(g: G, x: Ins) {
    let s = x.sub
    ld128(g, 9, 10, x.a)
    ld128(g, 11, 12, x.b)
    if s == B_ADD {
        w(g, adds(9, 9, 11))
        w(g, adc(10, 10, 12))
    } else if s == B_SUB {
        w(g, subs(9, 9, 11))
        w(g, sbc(10, 10, 12))
    } else if s == B_AND {
        w(g, and(9, 9, 11))
        w(g, and(10, 10, 12))
    } else if s == B_OR {
        w(g, orr(9, 9, 11))
        w(g, orr(10, 10, 12))
    } else if s == B_XOR {
        w(g, eor(9, 9, 11))
        w(g, eor(10, 10, 12))
    } else if s == B_MUL {
        // hi = umulh(a0, b0) + a0 * b1 + a1 * b0; lo = a0 * b0.
        w(g, umulh(13, 9, 11))
        w(g, madd(13, 9, 12, 13))
        w(g, madd(13, 10, 11, 13))
        w(g, mul(9, 9, 11))
        w(g, mov(10, 13))
    } else if s == B_SHL || s == B_LSHR || s == B_ASHR {
        // The amount is below 128 (the lowering checked it): n = b0. Both the n < 64 and the
        // n >= 64 results are formed and the right one chosen.
        w(g, lsr_imm(14, 11, 6))
        mov_imm(g, 15, 63)
        w(g, sub(15, 15, 11))
        if s == B_SHL {
            // small: lo << n, (hi << n) | ((lo >> 1) >> (63 - n)); big: 0, lo << (n - 64)
            w(g, lsr_imm(13, 9, 1))
            w(g, lsrv(13, 13, 15))
            w(g, lslv(12, 10, 11))
            w(g, orr(12, 12, 13))
            w(g, lslv(13, 9, 11))
            w(g, cmp_imm(14, 0))
            w(g, csel(10, 13, 12, NE))
            w(g, csel(9, ZR, 13, NE))
        } else {
            // small: (lo >> n) | ((hi << 1) << (63 - n)), hi >> n; big: hi >> (n - 64), sign or 0
            w(g, lsl1(13, 10))
            w(g, lslv(13, 13, 15))
            w(g, lsrv(12, 9, 11))
            w(g, orr(12, 12, 13))
            if s == B_LSHR {
                w(g, lsrv(13, 10, 11))
                w(g, cmp_imm(14, 0))
                w(g, csel(9, 13, 12, NE))
                w(g, csel(10, ZR, 13, NE))
            } else {
                w(g, asrv(13, 10, 11))
                w(g, asr63(15, 10))
                w(g, cmp_imm(14, 0))
                w(g, csel(9, 13, 12, NE))
                w(g, csel(10, 15, 13, NE))
            }
        }
    } else {
        refuse(g, f"`i128` binary operation {s}")
        return
    }
    st128(g, 9, 10, x.dst)
}

fn ovf128(g: G, x: Ins) {
    let s = x.sub
    ld128(g, 9, 10, x.a)
    ld128(g, 11, 12, x.b)
    if s == O_ADD || s == O_UADD {
        w(g, adds(9, 9, 11))
        w(g, adcs(10, 10, 12))
        w(g, cset(13, if s == O_ADD { VS } else { HS }))
    } else if s == O_SUB || s == O_USUB {
        w(g, subs(9, 9, 11))
        w(g, sbcs(10, 10, 12))
        w(g, cset(13, if s == O_SUB { VS } else { LO }))
    } else {
        refuse(g, f"`i128` checked operation {s}")
        return
    }
    st128(g, 9, 10, x.dst)
    st(g, 13, x.dst2)
}

fn compare128(g: G, x: Ins) {
    let k = x.sub
    ld128(g, 9, 10, x.a)
    ld128(g, 11, 12, x.b)
    if k == K_EQ || k == K_NE {
        w(g, eor(9, 9, 11))
        w(g, eor(10, 10, 12))
        w(g, orr(9, 9, 10))
        w(g, cmp_imm(9, 0))
        w(g, cset(9, if k == K_EQ { EQ } else { NE }))
    } else {
        // a - b over both halves sets the flags of a 128-bit comparison; `>` and `<=` are `<`
        // and `>=` with the operands swapped.
        let swap = k == K_GT || k == K_LE || k == K_UGT || k == K_ULE
        if swap {
            w(g, cmp(11, 9))
            w(g, sbcs(ZR, 12, 10))
        } else {
            w(g, cmp(9, 11))
            w(g, sbcs(ZR, 10, 12))
        }
        let cond = match k {
            2 => LT,
            3 => GE,
            4 => LT,
            5 => GE,
            6 => LO,
            7 => HS,
            8 => LO,
            _ => HS,
        }
        w(g, cset(9, cond))
    }
    st(g, 9, x.dst)
}
