// `nazm explain-cost`, `nazm explain-flow` and `nazm profile`, in Nazm (R8 slice 8,
// `openspec/changes/r8-cut-over/design.md`, task 8.1): the command lines, the front end, and then what R2
// and R3 do not yet publish, refused by name (status 6, counted by the comparison, never an agreement).
//
//   explain-cost   `nazm_mir::cost` over MIR (every allocation, retain, block, channel, C call and task
//                  of each function, its count per call), `vectorize::explain`, `--layout soa`'s
//                  eligibility and the scheduler's policy: the pipeline's `cost` and `cost-json` modes
//                  (`toolchain/pipeline/cost.nz`, R8 slice 11) print them from the Core IR document.
//   explain-flow   every sink of the compilation with the origins that reach it and how each got there
//                  (`Resolution::sinks`): R2's provenance facts summarise a function's, not the sinks
//                  nor their traces (a hand-back to R2: `fx_sink_*`).
//   profile        builds the program with the chosen backend and runs it once with its counters on,
//                  printing the wall time: `build`'s LLVM and Cranelift backends are not carried, and a
//                  run's counters and clock are not a thing two builds can print alike (hand-back to
//                  slice 5/6: `profile --backend nazm`, its counters compared by structure).

use "../../compiler/facts.nz"
use "../../compiler/facts-core.nz"
use "cli.nz"
use "front.nz"
use "util.nz"
use "coreir.nz"
use "obligations.nz"
use "@std/json"
use "@std/sort"
use "@std/text"

fn nl() -> Str { str_from_byte(10) }

fn ex_refuse(io: IoCap, why: Str) -> Int {
    eprint("nazm: not carried: " + why + nl())
    exit_with(6)
    0
}

pub fn explain_cost_cli() -> Cli {
    let c = cli_command("explain-cost", "Print where each function allocates, retains, blocks, talks to a channel, calls C or starts a task (N52), read off MIR, each with its "
            + "count per call — `at-most-once` or `unknown`, never a guess. `--json` prints `nazm.cost/2`, which since N106 also says which scheduler a native "
            + "build runs the program's tasks on, and why", "")
    cli_positional(c, "FILE", true, false, true, "", "")
    cli_flag(c, "", "json", "", "")
    c
}

pub fn explain_flow_cli() -> Cli {
    let c = cli_command("explain-flow", "Print every sink — a path written to, standard output, a file's data — and every declassification, with the origins that reach it "
            + "(N52). `--json` prints `nazm.flow/2`", "")
    cli_positional(c, "FILE", true, false, true, "", "")
    cli_flag(c, "", "json", "", "")
    c
}

pub fn profile_cli() -> Cli {
    let c = cli_command("profile", "Build the program and run it once with its memory and scheduler counters on (N58), and print `nazm.profile/2`: its exit status, wall "
            + "time and the counts; with `--sample`, also where its samples fell (N91)", "")
    cli_positional(c, "FILE", true, false, true, "", "")
    let backend = cli_option(c, "", "backend", "BACKEND", false, "llvm", true, "The code generator, as `nazm build --backend`: `llvm`, `cranelift` or `nazm`", "")
    cli_possible(c, backend, "llvm,cranelift,nazm")
    cli_flag(c, "", "sample", "Sample the run with the host's sampler, attributing each sample to a Nazm function and line, the runtime, foreign code or the system (N91)", "")
    let interval = cli_option(c, "", "interval-ms", "MS", false, "1", true, "With `--sample`, the time between samples", "")
    cli_requires(c, interval, 2)
    cli_numeric_size(c, interval)
    c
}

pub fn explain_cost_command(io: IoCap, proc: ProcessCap, sp: SpawnCap, c: Cli) -> Int {
    cli_parse(io, c)
    let file = ci_entry(io, cli_value(c, 0))
    let f = ci_checked(io, file, false, "")
    let raw = fx_core_document_with_sources(f)
    if raw == "" { ex_refuse(io, "a program whose Core IR the front end does not carry") }
    let doc = ci_unprefix_paths(io, raw, file)
    let args = strs_new()
    strs_push(args, if cli_present(c, 1) { "cost-json" } else { "cost" })
    strs_push(args, "@CORE@")
    print(ci_staged(io, proc, sp, "explain-cost", doc, args))
    0
}

// A place as JSON (`place`): `null` for none, else `{"column":..,"line":..,"module":".."}`, the module by its durable name or, where it has
// none, the name it was loaded under; and as `shown` writes it.
fn ex_place(f: Facts, names: Strs, at: Int, end: Int) -> Strs {
    let out = strs_new()
    let m = fx_module_at(f, at)
    if m < 0 {
        strs_push(out, "null")
        strs_push(out, "(compiler-made)")
        return out
    }
    let local = at - fx_module_base(f, m)
    let text = fx_module_text(f, m)
    let line = ob_line(text, local)
    let col = ob_column(text, local)
    let key = fx_module_key(f, m)
    let module = if key != "" { key } else { strs_get(names, m) }
    strs_push(out, "{\"column\":" + int_to_str(col) + ",\"line\":" + int_to_str(line) + ",\"module\":" + json_quote(module) + "}")
    strs_push(out, module + ":" + int_to_str(line) + ":" + int_to_str(col))
    out
}

pub fn explain_flow_command(io: IoCap, c: Cli) -> Int {
    cli_parse(io, c)
    let file = ci_entry(io, cli_value(c, 0))
    let json = cli_present(c, 1)
    // `on_checked_map` checks the root as a program: a module with no `main` is `N0204`.
    let f = ci_checked_as(io, file, false, "", true)
    let names = fe_names(f, fe_prefix(io, file))
    let n = fx_sink_count(f)
    if fx_sink_declined(f) { ex_refuse(io, "a function of more than 60 parameters and captures (provenance)") }
    let keyed = strs_new()
    let blocks = strs_new()
    for i in 0..n {
        let at = ex_place(f, names, fx_sink_start(f, i), fx_sink_end(f, i))
        let class = fx_sink_class(f, i)
        let origins = fx_sink_origins(f, i)
        let quoted = strs_new()
        for o in origins { strs_push(quoted, json_quote(o)) }
        let traces = strs_new()
        let lines = strs_new()
        for t in 0..fx_sink_traces(f, i) {
            let steps = strs_new()
            let origin = fx_sink_trace_origin(f, i, t)
            strs_push(lines, "    " + origin + ":" + nl())
            for k in 0..fx_sink_steps(f, i, t) {
                let sp = ex_place(f, names, fx_sink_step_start(f, i, t, k), fx_sink_step_end(f, i, t, k))
                strs_push(steps, "{\"at\":" + strs_get(sp, 0) + ",\"note\":" + json_quote(fx_sink_step_note(f, i, t, k)) + "}")
                strs_push(lines, "      " + strs_get(sp, 1) + "  " + fx_sink_step_note(f, i, t, k) + nl())
            }
            strs_push(traces, "{\"origin\":" + json_quote(origin) + ",\"steps\":[" + str_join(steps, ",") + "]}")
        }
        let function = fx_sink_function(f, i)
        let key = "{\"at\":" + strs_get(at, 0) + ",\"class\":" + json_quote(class) + ",\"function\":" + json_quote(function) + ",\"origins\":[" + str_join(quoted, ",")
                + "],\"traces\":[" + str_join(traces, ",") + "]}"
        strs_push(keyed, key + str_from_byte(1) + int_to_str(i))
        let what = if class == "vouch" { "vouch, clearing" } else { "receives" }
        let received = if strs_len(origins) == 0 { "nothing restricted (no origin)" } else { str_join(origins, ", ") }
        strs_push(blocks, strs_get(at, 1) + "  " + class + " in `" + function + "`: " + what + " " + received + nl() + str_join(lines, ""))
    }
    let order = strs_new()
    for k in strs_sort(keyed) {
        let mut cut = str_len(k)
        for q in 0..str_len(k) { if str_byte(k, q) == 1 { cut = q } }
        strs_push(order, str_slice(k, cut + 1, str_len(k)))
    }
    if json {
        let items = strs_new()
        for k in strs_sort(keyed) {
            let mut cut = str_len(k)
            for q in 0..str_len(k) { if str_byte(k, q) == 1 { cut = q } }
            strs_push(items, str_slice(k, 0, cut))
        }
        print("{\"schema\":\"nazm.flow/2\",\"sinks\":[" + str_join(items, ",") + "]}" + nl())
        return 0
    }
    if n == 0 { print("(no sink)" + nl()) }
    let out = strs_new()
    for q in 0..strs_len(order) {
        match text_parse_int(strs_get(order, q)) {
            Ok(i) => strs_push(out, strs_get(blocks, i)),
            Err(_) => {},
        }
    }
    print(str_join(out, ""))
    0
}

pub fn profile_command(io: IoCap, c: Cli) -> Int {
    cli_parse(io, c)
    ex_refuse(io, "`profile` (it builds with `--backend " + cli_value(c, 1) + "` and runs the program with its counters on: not carried by `build`, and its wall time is no byte to compare)")
}
