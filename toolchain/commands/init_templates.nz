// Every file of every `nazm init` template, as `crates/nazm-cli/src/init.rs` holds them (R5, design
// D9). Generated by toolchain/commands/tests/gen-templates.sh from crates/nazm-cli/templates; do not
// edit by hand — run.sh fails when this file and the templates differ.

// Each file: its template, its path inside the project and its text, `{{name}}` still in it.
pub struct Templates {
    template: Strs,
    path: Strs,
    text: Strs,
}

// One file, from the lines collected in `lines`, which it empties.
fn tpl(t: Templates, template: Str, path: Str, lines: Strs) -> Int {
    strs_push(t.template, template)
    strs_push(t.path, path)
    strs_push(t.text, str_join(lines, ""))
    while strs_len(lines) > 0 { strs_pop(lines) }
    0
}

pub fn init_templates() -> Templates {
    let t = Templates(template: strs_new(), path: strs_new(), text: strs_new())
    let l = strs_new()
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A command-line program. `nazm run .` runs it; `nazm test tests` replays the tests interpreted and\n")
    strs_push(l, "compiled; `nazm build . -o {{name}}` builds an executable; `nazm check .`, `nazm lock .` and\n")
    strs_push(l, "`nazm inspect .` check it, pin its packages and print its facts; `nazm doc . -o api` documents it.\n")
    tpl(t, "cli", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    strs_push(l, "main = \"main.nz\"\n")
    tpl(t, "cli", "nazm.toml", l)
    strs_push(l, "pub fn greeting(name: Str) -> Str ! {} { str_concat(\"hello, \", str_concat(name, \"\\n\")) }\n")
    tpl(t, "cli", "src/greet.nz", l)
    strs_push(l, "use \"greet.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main(io: IoCap) -> Int ! { io } {\n")
    strs_push(l, "    print(greeting(\"world\"));\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    tpl(t, "cli", "src/main.nz", l)
    strs_push(l, "hello, test\n")
    strs_push(l, "0\n")
    tpl(t, "cli", "tests/greet.expected", l)
    strs_push(l, "use \"../src/greet.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main(io: IoCap) -> Int ! { io } {\n")
    strs_push(l, "    print(greeting(\"test\"));\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    tpl(t, "cli", "tests/greet.nz", l)
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A library package: no `main`. `nazm check .` checks every module; `nazm test tests` replays the\n")
    strs_push(l, "tests; `nazm doc . -o api` documents the public API. Another package depends on it with\n")
    strs_push(l, "`{{name}} = { path = \"../{{name}}\", version = \"0.1.0\" }` and writes `use \"{{name}}:lib.nz\";`.\n")
    strs_push(l, "`nazm publish --registry DIR . --dry-run` shows what publishing would record.\n")
    tpl(t, "library", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    tpl(t, "library", "nazm.toml", l)
    strs_push(l, "// A library package: no `main`. Another package depends on it by path and writes\n")
    strs_push(l, "// `use \"library:lib.nz\";`.\n")
    strs_push(l, "\n")
    strs_push(l, "// The greatest common divisor of two non-negative numbers.\n")
    strs_push(l, "pub fn gcd(a: Int, b: Int) -> Int ! {} {\n")
    strs_push(l, "    let mut x = a;\n")
    strs_push(l, "    let mut y = b;\n")
    strs_push(l, "    while y != 0 {\n")
    strs_push(l, "        let t = x % y;\n")
    strs_push(l, "        x = y;\n")
    strs_push(l, "        y = t;\n")
    strs_push(l, "    }\n")
    strs_push(l, "    x\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "// `n` held to the range `lo..=hi`.\n")
    strs_push(l, "pub fn clamp(n: Int, lo: Int, hi: Int) -> Int ! {} {\n")
    strs_push(l, "    if n < lo { lo } else { if n > hi { hi } else { n } }\n")
    strs_push(l, "}\n")
    tpl(t, "library", "src/lib.nz", l)
    strs_push(l, "1299\n")
    tpl(t, "library", "tests/lib.expected", l)
    strs_push(l, "use \"../src/lib.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} { gcd(84, 36) * 100 + clamp(150, 0, 99) }\n")
    tpl(t, "library", "tests/lib.nz", l)
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A worker pool over channels serving the requests in a file: `nazm run . -- requests.txt`. Nazm has\n")
    strs_push(l, "neither sockets nor a way to read standard input, so a request is a line of a file. `nazm test\n")
    strs_push(l, "tests` checks the request handler; `nazm build . -o {{name}}` builds it.\n")
    tpl(t, "server", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    strs_push(l, "main = \"main.nz\"\n")
    tpl(t, "server", "nazm.toml", l)
    strs_push(l, "1\n")
    strs_push(l, "2\n")
    strs_push(l, "3\n")
    strs_push(l, "4\n")
    tpl(t, "server", "requests.txt", l)
    strs_push(l, "// What the server does with one request: pure, so it is tested without a pool.\n")
    strs_push(l, "pub fn handle(request: Int) -> Int ! {} { request * request }\n")
    strs_push(l, "\n")
    strs_push(l, "// The requests in `text`: one decimal number per line; anything else on a line is skipped.\n")
    strs_push(l, "pub fn requests(text: Str) -> Ints ! {} {\n")
    strs_push(l, "    let out = ints_new();\n")
    strs_push(l, "    let mut i = 0;\n")
    strs_push(l, "    let mut n = 0;\n")
    strs_push(l, "    let mut digits = 0;\n")
    strs_push(l, "    while i < str_len(text) {\n")
    strs_push(l, "        let b = str_byte(text, i);\n")
    strs_push(l, "        if b >= 48 && b <= 57 {\n")
    strs_push(l, "            n = n * 10 + (b - 48);\n")
    strs_push(l, "            digits = digits + 1;\n")
    strs_push(l, "        } else {\n")
    strs_push(l, "            if b == 10 && digits > 0 { ints_push(out, n); }\n")
    strs_push(l, "            if b == 10 { n = 0; digits = 0; }\n")
    strs_push(l, "        }\n")
    strs_push(l, "        i = i + 1;\n")
    strs_push(l, "    }\n")
    strs_push(l, "    if digits > 0 { ints_push(out, n); }\n")
    strs_push(l, "    out\n")
    strs_push(l, "}\n")
    tpl(t, "server", "src/handle.nz", l)
    strs_push(l, "// A worker pool serving the requests in a file: `server requests.txt`. Nazm has no sockets and no\n")
    strs_push(l, "// way to read standard input, so a request arrives as a line of a file.\n")
    strs_push(l, "use \"handle.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn worker(jobs: Chan, results: Chan) -> Int ! {} {\n")
    strs_push(l, "    let buf = ints_new();\n")
    strs_push(l, "    while chan_recv(jobs, buf) {\n")
    strs_push(l, "        chan_send(results, handle(ints_pop(buf)));\n")
    strs_push(l, "    }\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "// A task is given values that may cross — the text, not the parsed list — and parses its own copy.\n")
    strs_push(l, "fn feed(jobs: Chan, text: Str) -> Int ! {} {\n")
    strs_push(l, "    let work = requests(text);\n")
    strs_push(l, "    let mut i = 0;\n")
    strs_push(l, "    while i < ints_len(work) {\n")
    strs_push(l, "        chan_send(jobs, ints_get(work, i));\n")
    strs_push(l, "        i = i + 1;\n")
    strs_push(l, "    }\n")
    strs_push(l, "    chan_close(jobs);\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "fn main(io: IoCap, s: SpawnCap) -> Int ! { io, spawn } {\n")
    strs_push(l, "    if args_count() == 0 {\n")
    strs_push(l, "        eprint(\"usage: server FILE\\n\");\n")
    strs_push(l, "        return exit_with(2);\n")
    strs_push(l, "    }\n")
    strs_push(l, "    let text = read_file(arg(0));\n")
    strs_push(l, "    let count = ints_len(requests(text));\n")
    strs_push(l, "    let jobs = chan_new(4);\n")
    strs_push(l, "    let results = chan_new(4);\n")
    strs_push(l, "    let buf = ints_new();\n")
    strs_push(l, "    let mut total = 0;\n")
    strs_push(l, "    scope {\n")
    strs_push(l, "        spawn feed(jobs, text);\n")
    strs_push(l, "        spawn worker(jobs, results);\n")
    strs_push(l, "        spawn worker(jobs, results);\n")
    strs_push(l, "        let mut got = 0;\n")
    strs_push(l, "        while got < count {\n")
    strs_push(l, "            chan_recv(results, buf);\n")
    strs_push(l, "            total = total + ints_pop(buf);\n")
    strs_push(l, "            got = got + 1;\n")
    strs_push(l, "        }\n")
    strs_push(l, "    }\n")
    strs_push(l, "    chan_close(results);\n")
    strs_push(l, "    print(str_concat(int_to_str(count), \" requests served\\n\"));\n")
    strs_push(l, "    println(total);\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    tpl(t, "server", "src/main.nz", l)
    strs_push(l, "53\n")
    tpl(t, "server", "tests/handle.expected", l)
    strs_push(l, "use \"../src/handle.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} {\n")
    strs_push(l, "    let r = requests(\"3\\n4\\nnot a number\\n5\");\n")
    strs_push(l, "    handle(ints_get(r, 0)) + handle(ints_get(r, 1)) + handle(ints_get(r, 2)) + ints_len(r)\n")
    strs_push(l, "}\n")
    tpl(t, "server", "tests/handle.nz", l)
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A freestanding program for `aarch64-unknown-none` (QEMU's `virt` board): no heap, no C library.\n")
    strs_push(l, "`nazm check .`; `nazm test tests` checks the pure part on this machine; `nazm build --target\n")
    strs_push(l, "aarch64-unknown-none . --objects build` writes the objects, `link.ld` and `link.txt`, and\n")
    strs_push(l, "`bounds.json` (the stack bound). Run under `qemu-system-aarch64 -M virt -cpu cortex-a53\n")
    strs_push(l, "-semihosting`.\n")
    tpl(t, "embedded", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    strs_push(l, "main = \"main.nz\"\n")
    tpl(t, "embedded", "nazm.toml", l)
    strs_push(l, "// What the board is, as numbers: pure, so `nazm test` checks it on this machine.\n")
    strs_push(l, "\n")
    strs_push(l, "// The PL011 UART's data register on QEMU's `virt` machine.\n")
    strs_push(l, "pub fn uart_data() -> Int ! {} { 150994944 }\n")
    strs_push(l, "\n")
    strs_push(l, "// The `i`th byte of the greeting the program writes, or -1 past its end.\n")
    strs_push(l, "pub fn greeting(i: Int) -> Int ! {} {\n")
    strs_push(l, "    if i == 0 { 72 } else { if i == 1 { 105 } else { if i == 2 { 10 } else { -1 } } }\n")
    strs_push(l, "}\n")
    tpl(t, "embedded", "src/board.nz", l)
    strs_push(l, "// A freestanding program for a board with no operating system (`aarch64-unknown-none`, QEMU's\n")
    strs_push(l, "// `virt` machine): no heap, no C library. A register is reached only with an `MmioCap`, and\n")
    strs_push(l, "// `nazm run` refuses to perform one — the program runs on the board.\n")
    strs_push(l, "//\n")
    strs_push(l, "//     nazm build --target aarch64-unknown-none . --objects build\n")
    strs_push(l, "//     then link with build/link.ld as build/link.txt says\n")
    strs_push(l, "use \"board.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main(m: MmioCap) -> Int ! {} {\n")
    strs_push(l, "    let mut i = 0;\n")
    strs_push(l, "    while greeting(i) >= 0 {\n")
    strs_push(l, "        mmio_write32(uart_data(), greeting(i));\n")
    strs_push(l, "        i = i + 1;\n")
    strs_push(l, "    }\n")
    strs_push(l, "    100\n")
    strs_push(l, "}\n")
    tpl(t, "embedded", "src/main.nz", l)
    strs_push(l, "186\n")
    tpl(t, "embedded", "tests/board.expected", l)
    strs_push(l, "use \"../src/board.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} { greeting(0) + greeting(1) + greeting(2) + greeting(3) }\n")
    tpl(t, "embedded", "tests/board.nz", l)
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A WebAssembly module. `nazm run .` runs it here; `nazm test tests` replays the tests; `nazm build\n")
    strs_push(l, "--target wasm32-unknown-unknown . --objects build` writes the objects, `link.txt` (its `wasm-ld`\n")
    strs_push(l, "line) and `host.mjs`, the reference host granting exactly the module's imports.\n")
    tpl(t, "wasm", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    strs_push(l, "main = \"main.nz\"\n")
    tpl(t, "wasm", "nazm.toml", l)
    strs_push(l, "// Pure, so `nazm test` runs it on this machine as well as in the module.\n")
    strs_push(l, "pub fn fib(n: Int) -> Int ! {} { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }\n")
    tpl(t, "wasm", "src/fib.nz", l)
    strs_push(l, "// A WebAssembly module (`wasm32-unknown-unknown`). Its authority is its imports: printing is\n")
    strs_push(l, "// `nz.host_write`, which the generated `build/host.mjs` provides.\n")
    strs_push(l, "//\n")
    strs_push(l, "//     nazm build --target wasm32-unknown-unknown . --objects build\n")
    strs_push(l, "//     then link and run as build/link.txt says\n")
    strs_push(l, "use \"fib.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main(io: IoCap) -> Int ! { io } {\n")
    strs_push(l, "    print(\"hello from wasm\\n\");\n")
    strs_push(l, "    // A module with no operating system formats no integer; it says what it computed in text\n")
    strs_push(l, "    // it already has, and ends with status 0.\n")
    strs_push(l, "    if fib(20) == 6765 {\n")
    strs_push(l, "        print(\"fib(20) is 6765\\n\");\n")
    strs_push(l, "    } else {\n")
    strs_push(l, "        print(\"fib(20) is not 6765\\n\");\n")
    strs_push(l, "    }\n")
    strs_push(l, "    0\n")
    strs_push(l, "}\n")
    tpl(t, "wasm", "src/main.nz", l)
    strs_push(l, "55\n")
    tpl(t, "wasm", "tests/fib.expected", l)
    strs_push(l, "use \"../src/fib.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} { fib(10) }\n")
    tpl(t, "wasm", "tests/fib.nz", l)
    strs_push(l, "# {{name}}\n")
    strs_push(l, "\n")
    strs_push(l, "A contract under the `web3` profile. `nazm check .`; `nazm contract src/main.nz` prints its\n")
    strs_push(l, "entrypoints with what each reads and writes; `nazm contract src/main.nz --txs txs.txt` runs the\n")
    strs_push(l, "transactions deterministically; `--evm DIR` writes EVM bytecode and `--wasm DIR` a WebAssembly\n")
    strs_push(l, "module with its host adapter.\n")
    tpl(t, "contract", "README.md", l)
    strs_push(l, "schema = \"nazm.package/1\"\n")
    strs_push(l, "\n")
    strs_push(l, "[package]\n")
    strs_push(l, "name = \"{{name}}\"\n")
    strs_push(l, "version = \"0.1.0\"\n")
    strs_push(l, "main = \"main.nz\"\n")
    strs_push(l, "profile = \"web3\"\n")
    tpl(t, "contract", "nazm.toml", l)
    strs_push(l, "// A contract (the `web3` profile): ordinary Nazm, deterministic and bounded. The state is a\n")
    strs_push(l, "// record of `Int`s and `Bool`s; each `pub fn` taking it and a `caller` is an entrypoint.\n")
    strs_push(l, "//\n")
    strs_push(l, "//     nazm contract src/main.nz                  its facts: entrypoints, reads, writes\n")
    strs_push(l, "//     nazm contract src/main.nz --txs txs.txt    a deterministic run of those transactions\n")
    strs_push(l, "//     nazm contract src/main.nz --evm out        EVM bytecode (N70)\n")
    strs_push(l, "pub struct State { owner: Int, alice: Int, bob: Int, paused: Bool }\n")
    strs_push(l, "\n")
    strs_push(l, "fn init() -> State ! {} { State(owner: 1, alice: 100, bob: 0, paused: false) }\n")
    strs_push(l, "\n")
    strs_push(l, "// Move `amount` from alice to bob; only the owner may, and not while paused.\n")
    strs_push(l, "pub fn transfer(s: State, caller: Int, amount: Int) -> Result[State, Int] ! {} {\n")
    strs_push(l, "    if caller != s.owner { return Result[State, Int].Err(error: 1); }\n")
    strs_push(l, "    if s.paused { return Result[State, Int].Err(error: 3); }\n")
    strs_push(l, "    if amount < 0 || s.alice < amount { return Result[State, Int].Err(error: 2); }\n")
    strs_push(l, "    Result[State, Int].Ok(value: State(owner: s.owner, alice: s.alice - amount, bob: s.bob + amount, paused: s.paused))\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "pub fn pause(s: State, caller: Int, on: Int) -> Result[State, Int] ! {} {\n")
    strs_push(l, "    if caller != s.owner { return Result[State, Int].Err(error: 1); }\n")
    strs_push(l, "    Result[State, Int].Ok(value: State(owner: s.owner, alice: s.alice, bob: s.bob, paused: on == 1))\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} { 0 }\n")
    tpl(t, "contract", "src/main.nz", l)
    strs_push(l, "2988\n")
    tpl(t, "contract", "tests/transfer.expected", l)
    strs_push(l, "// The entrypoints are ordinary functions: called directly, without a chain.\n")
    strs_push(l, "use \"../src/main.nz\";\n")
    strs_push(l, "\n")
    strs_push(l, "fn after(r: Result[State, Int]) -> Int ! {} {\n")
    strs_push(l, "    match r {\n")
    strs_push(l, "        Result.Ok(value: s) => s.bob,\n")
    strs_push(l, "        Result.Err(error: e) => 0 - e,\n")
    strs_push(l, "    }\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "fn main() -> Int ! {} {\n")
    strs_push(l, "    let s = State(owner: 1, alice: 100, bob: 0, paused: false);\n")
    strs_push(l, "    // The owner moves 30; anyone else is refused with 1; more than alice holds with 2.\n")
    strs_push(l, "    after(transfer(s, 1, 30)) * 100 + after(transfer(s, 2, 30)) * 10 + after(transfer(s, 1, 500))\n")
    strs_push(l, "}\n")
    tpl(t, "contract", "tests/transfer.nz", l)
    strs_push(l, "# CALLER ENTRY ARG…, one transaction per line\n")
    strs_push(l, "1 transfer 30\n")
    strs_push(l, "2 transfer 10\n")
    strs_push(l, "1 pause 1\n")
    strs_push(l, "1 transfer 5\n")
    strs_push(l, "1 pause 0\n")
    strs_push(l, "1 transfer 5\n")
    tpl(t, "contract", "txs.txt", l)
    t
}
