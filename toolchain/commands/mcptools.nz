// What `nazm-mcp` answers to `initialize` and `tools/list`, as the reference writes them (R5, design D25):
// generated by `tests/gen-mcptools.py` from the reference binary, so the table says what it says.

pub fn mt_instructions() -> Str {
    "Read-only tools over this server's root compilation, read from disk at each call. nazm.semantic_context: the compiler's semantic context packet for a definition; follow a link by calling it again at the linked declaration. nazm.semantic_snapshot: the compilation's durable definitions with a digest per recorded section; keep it. nazm.semantic_delta: pass a kept snapshot as baseline to learn what was added, removed or changed since. nazm.semantic_patch: plan a rename or a diagnostic fix as exact edits bound to the current source; it never applies one. nazm.diagnostics: every current diagnostic compactly; nazm.diagnostic_detail: one in full, by its id and the index's state. nazm.command_summary: what `nazm check` concludes, compactly. nazm.docs_index: Nazm's own documentation by section, with each document's authority; nazm.docs_section: one section's exact text, by id and state. nazm.repository_map: the repository's entities, authorities and structure; nazm.task_context: the minimum context for seed ids and an intent, by state. The server keeps nothing between calls."
}

pub fn mt_count() -> Int { 11 }

pub fn mt_name(i: Int) -> Str {
    if i == 0 { return "nazm.semantic_context" }
    if i == 1 { return "nazm.semantic_snapshot" }
    if i == 2 { return "nazm.semantic_delta" }
    if i == 3 { return "nazm.semantic_patch" }
    if i == 4 { return "nazm.diagnostics" }
    if i == 5 { return "nazm.diagnostic_detail" }
    if i == 6 { return "nazm.command_summary" }
    if i == 7 { return "nazm.docs_index" }
    if i == 8 { return "nazm.docs_section" }
    if i == 9 { return "nazm.repository_map" }
    if i == 10 { return "nazm.task_context" }
    ""
}

fn mt_tool_0() -> Str {
    "{\"name\":\"nazm.semantic_context\",\"description\":\"The semantic context packet (nazm.context/3) of the function, record or enum declared or used at a byte offset: its exact source, and compact links — identity, kind, name, place — to what it uses, what uses it, what it calls and what calls it, in the server's root compilation as it is on disk now. Effects, capabilities, tests and semantic changes are reported unsupported.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"byte_offset\":{\"description\":\"The position, as a UTF-8 byte offset into that file.\",\"maximum\":4294967295,\"minimum\":0,\"type\":\"integer\"},\"file\":{\"description\":\"A file of the root's compilation, relative to its source root (as packets name files) or absolute.\",\"type\":\"string\"}},\"required\":[\"file\",\"byte_offset\"],\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"availability\":{\"additionalProperties\":false,\"description\":\"Sections the compiler has no facts for. `unsupported` means not known — never that none exist.\",\"properties\":{\"capabilities\":{\"const\":\"unsupported\"},\"semantic_changes\":{\"const\":\"unsupported\"},\"semantic_delta\":{\"const\":\"unsupported\"},\"tests\":{\"const\":\"unsupported\"}},\"required\":[\"capabilities\",\"tests\",\"semantic_changes\",\"semantic_delta\"],\"type\":\"object\"},\"call\":{\"additionalProperties\":false,\"properties\":{\"calls\":{\"description\":\"Each call's callee name, in the calling function's file.\",\"items\":{\"$ref\":\"#/$defs/span\"},\"type\":\"array\"},\"declaration\":{\"$ref\":\"#/$defs/span\"},\"identity\":{\"$ref\":\"#/$defs/identity\"},\"name\":{\"type\":\"string\"}},\"required\":[\"identity\",\"name\",\"declaration\",\"calls\"],\"type\":\"object\"},\"calls\":{\"additionalProperties\":false,\"properties\":{\"items\":{\"description\":\"Every direct call, grouped by the function at the other end; null when not applicable.\",\"items\":{\"$ref\":\"#/$defs/call\"},\"type\":[\"array\",\"null\"]},\"status\":{\"description\":\"`not_applicable` for a record or an enum, which calls nothing and is called by nothing.\",\"enum\":[\"available\",\"not_applicable\"]}},\"required\":[\"status\",\"items\"],\"type\":\"object\"},\"diagnostic\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"pattern\":\"^N[0-9]{4}$\",\"type\":\"string\"},\"end\":{\"minimum\":0,\"type\":\"integer\"},\"fixes\":{\"description\":\"How many fixes the compiler attached.\",\"minimum\":0,\"type\":\"integer\"},\"severity\":{\"enum\":[\"error\",\"warning\"]},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"code\",\"severity\",\"start\",\"end\",\"fixes\"],\"type\":\"object\"},\"effect_names\":{\"description\":\"A set of effects, each once, in effect-id order: `io`, then `spawn`, then `foreign` (N42).\",\"items\":{\"enum\":[\"io\",\"spawn\",\"foreign\"]},\"type\":\"array\"},\"effects\":{\"additionalProperties\":false,\"properties\":{\"declared\":{\"description\":\"Its written `! { … }`; null where it declares none. `[]` is `! {}`: pure.\",\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/effect_names\"}]},\"published\":{\"$ref\":\"#/$defs/effect_names\",\"description\":\"What a caller in another module must assume: the declared set, or every effect where none is declared.\"},\"reasons\":{\"description\":\"One per required effect, in effect-id order: the first call or `spawn` in the body that requires it.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"at\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/span\"}]},\"builtin\":{\"description\":\"The built-in's name, for `builtin`: compiler-owned, with no source.\",\"type\":[\"string\",\"null\"]},\"callee\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/identity\"}]},\"effect\":{\"enum\":[\"io\",\"spawn\",\"foreign\"]},\"source\":{\"description\":\"A built-in that exercises it; a `spawn`; a function of this module whose inferred set has it; a function whose declared set has it; or a function of another module that declares no set.\",\"enum\":[\"builtin\",\"spawn\",\"inferred\",\"declared\",\"undeclared\"]}},\"required\":[\"effect\",\"at\",\"source\",\"builtin\",\"callee\"],\"type\":\"object\"},\"type\":\"array\"},\"required\":{\"$ref\":\"#/$defs/effect_names\",\"description\":\"What its body requires: the least fixed point over the compilation's resolved calls.\"}},\"required\":[\"declared\",\"required\",\"published\",\"reasons\"],\"type\":\"object\"},\"field\":{\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"type\"],\"type\":\"object\"},\"identity\":{\"additionalProperties\":false,\"properties\":{\"definition\":{\"description\":\"The durable definition key, `module::kind name`. Null only where the declaring module has no durable key (a file reached outside the source root); the entity's place is still given, so null never stands in for a location.\",\"type\":[\"string\",\"null\"]},\"member\":{\"description\":\"A field's, a variant's or (`Variant.field`) a payload field's name within that definition; null for the definition itself.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"definition\",\"member\"],\"type\":\"object\"},\"link\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"$ref\":\"#/$defs/span\",\"description\":\"Where its name is declared, in a file of the compilation. An entity with no such declaration — the core prelude's, a built-in's — is not a link: it may shape checking, and is omitted.\"},\"identity\":{\"$ref\":\"#/$defs/identity\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\",\"field\",\"variant\",\"payload_field\",\"constant\"]},\"name\":{\"type\":\"string\"},\"occurrences\":{\"description\":\"In the target's file.\",\"items\":{\"$ref\":\"#/$defs/occurrence\"},\"type\":\"array\"}},\"required\":[\"identity\",\"kind\",\"name\",\"declaration\",\"occurrences\"],\"type\":\"object\"},\"occurrence\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"start\",\"end\"],\"type\":\"object\"},\"provenance\":{\"additionalProperties\":false,\"properties\":{\"origins\":{\"description\":\"Origins its result carries whatever it is given, each once, in origin-id order. Empty is local.\",\"items\":{\"enum\":[\"argument\",\"file\",\"authority\",\"unknown\"]},\"type\":\"array\"},\"passes_on\":{\"description\":\"The parameters whose provenance its result carries, by name, in parameter order.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"reaches_write_path\":{\"description\":\"The parameters whose value may become the path `write_file` writes to, directly or through what it calls.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"receives\":{\"description\":\"For each parameter, in order, the origins the program's calls and `spawn`s hand it.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"origins\":{\"items\":{\"enum\":[\"argument\",\"file\",\"authority\",\"unknown\"]},\"type\":\"array\"},\"param\":{\"type\":\"string\"}},\"required\":[\"param\",\"origins\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"origins\",\"passes_on\",\"reaches_write_path\",\"receives\"],\"type\":\"object\"},\"span\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"},\"target\":{\"additionalProperties\":false,\"properties\":{\"fields\":{\"description\":\"A record's fields in canonical order; null otherwise.\",\"items\":{\"$ref\":\"#/$defs/field\"},\"type\":[\"array\",\"null\"]},\"identity\":{\"$ref\":\"#/$defs/identity\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]},\"name\":{\"type\":\"string\"},\"signature\":{\"description\":\"A function's signature; null otherwise.\",\"type\":[\"string\",\"null\"]},\"source\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"name_end\":{\"minimum\":0,\"type\":\"integer\"},\"name_start\":{\"minimum\":0,\"type\":\"integer\"},\"start\":{\"minimum\":0,\"type\":\"integer\"},\"text\":{\"description\":\"The declaration exactly as it is in the file, byte for byte.\",\"type\":\"string\"}},\"required\":[\"file\",\"start\",\"end\",\"name_start\",\"name_end\",\"text\"],\"type\":\"object\"},\"variants\":{\"description\":\"An enum's variants and payloads in canonical order; null otherwise.\",\"items\":{\"$ref\":\"#/$defs/variant\"},\"type\":[\"array\",\"null\"]}},\"required\":[\"identity\",\"kind\",\"name\",\"signature\",\"fields\",\"variants\",\"source\"],\"type\":\"object\"},\"variant\":{\"additionalProperties\":false,\"properties\":{\"fields\":{\"items\":{\"$ref\":\"#/$defs/field\"},\"type\":\"array\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"fields\"],\"type\":\"object\"}},\"$id\":\"nazm.context-3.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"One source definition's semantic context, from `nazm context --json` and the `nazm-mcp` tool `semantic_context`: its exact source and compact links to what the compiler knows it is connected to, in the compilation of one root. `status` is `available` with every section, or `unavailable` with a `reason` and no other section. Paths are relative to the compilation's source root; byte offsets are into the named file. Nothing session-local is included, so the same sources and query give the same bytes. `/2` (N36): a function's `effects` are the compiler's, where `/1` reported them unsupported. `/3` (N38): a function's `provenance` summary.\",\"properties\":{\"availability\":{\"$ref\":\"#/$defs/availability\"},\"callees\":{\"$ref\":\"#/$defs/calls\"},\"callers\":{\"$ref\":\"#/$defs/calls\"},\"dependencies\":{\"description\":\"Every entity the declaration uses, other than its own locals, parameters and bindings and the target itself, each once with every occurrence. Ordered by kind, then declaration, then identity.\",\"items\":{\"$ref\":\"#/$defs/link\"},\"type\":\"array\"},\"diagnostics\":{\"description\":\"The compiler's diagnostics whose primary span is inside the declaration.\",\"items\":{\"$ref\":\"#/$defs/diagnostic\"},\"type\":\"array\"},\"effects\":{\"description\":\"A function's effects, from the effect checker (N36); null for a record or an enum, and for a function whose body this compilation did not check.\",\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/effects\"}]},\"provenance\":{\"description\":\"A function's provenance summary, solved over the whole program (N38); null for a record or an enum, and for a function whose body did not parse.\",\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/provenance\"}]},\"reason\":{\"description\":\"Why there is no packet: the file is not one the compilation loaded; the offset is past its end; not on a name; on a name that is not a function, record or enum declared from source; or some file needed syntax recovery or could not be loaded. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"not_in_compilation\",\"out_of_range\",\"not_a_name\",\"not_a_target\",\"incomplete_compilation\"]},\"references\":{\"description\":\"Every use of the target in the compilation, ordered by file then offset. The declaration is not among them: it is `target.source`.\",\"items\":{\"$ref\":\"#/$defs/span\"},\"type\":\"array\"},\"related_types\":{\"description\":\"The records and enums whose names the declaration writes — as a type, a construction's head or a variant's enum — directly, not a transitive closure, with those written occurrences.\",\"items\":{\"$ref\":\"#/$defs/link\"},\"type\":\"array\"},\"root\":{\"description\":\"The compilation's root module.\",\"type\":\"string\"},\"schema\":{\"const\":\"nazm.context/3\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]},\"target\":{\"$ref\":\"#/$defs/target\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.context/3\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_1() -> Str {
    "{\"name\":\"nazm.semantic_snapshot\",\"description\":\"The semantic snapshot (nazm.snapshot/3) of the server's root compilation as it is on disk now: every durable function, record and enum, by identity, with one digest per semantic section the compiler records — source, shape, dependencies, related types, references, callers, callees, diagnostics. Keep it and pass it to nazm.semantic_delta later. Digest equality is not behavioural equivalence; effects, capabilities and tests are unsupported.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"definition\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"additionalProperties\":false,\"description\":\"Where it is declared, for navigation. Not compared: moving a definition is no change.\",\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"},\"digests\":{\"additionalProperties\":false,\"properties\":{\"callees\":{\"description\":\"A function's direct checked callees, by identity and count; null for a record or an enum.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"callers\":{\"description\":\"A function's direct checked callers, by identity and count; null for a record or an enum.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"dependencies\":{\"$ref\":\"#/$defs/digest\",\"description\":\"The source-linked entities it uses, by identity and count.\"},\"diagnostics\":{\"$ref\":\"#/$defs/digest\",\"description\":\"Code, severity, fix count and relative range of each diagnostic whose primary span is inside it; never a message.\"},\"effects\":{\"description\":\"A function's declared effect set, or that it declares none, and the set its body requires (N36), by name in effect-id order; null for a record or an enum.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"provenance\":{\"description\":\"A function's solved provenance summary (N38): the origins its result carries, and the positions of the parameters it passes on and of those that reach a restricted sink; null for a record or an enum.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"references\":{\"$ref\":\"#/$defs/digest\",\"description\":\"Its uses, by the identity of the definition each is in, and count.\"},\"related_types\":{\"$ref\":\"#/$defs/digest\",\"description\":\"The records and enums it writes by name, by identity and count.\"},\"shape\":{\"$ref\":\"#/$defs/digest\",\"description\":\"Kind, visibility, and the signature, or the fields, or the variants and payloads.\"},\"source\":{\"$ref\":\"#/$defs/digest\",\"description\":\"The declaration's exact bytes.\"}},\"required\":[\"source\",\"shape\",\"dependencies\",\"related_types\",\"references\",\"callers\",\"callees\",\"diagnostics\",\"effects\",\"provenance\"],\"type\":\"object\"},\"identity\":{\"description\":\"The durable definition key, `module::kind name`.\",\"type\":\"string\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]}},\"required\":[\"identity\",\"kind\",\"declaration\",\"digests\"],\"type\":\"object\"},\"digest\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"root\":{\"additionalProperties\":false,\"properties\":{\"compiler\":{\"description\":\"The compiler whose canonical data the digests were taken over; a delta refuses a baseline from another.\",\"type\":\"string\"},\"module\":{\"description\":\"The root module's durable key: its path relative to the source root.\",\"type\":\"string\"}},\"required\":[\"module\",\"compiler\"],\"type\":\"object\"}},\"$id\":\"nazm.snapshot-3.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"One root compilation's durable definitions, from `nazm snapshot --json` and the `nazm-mcp` tool `nazm.semantic_snapshot`: every function, record and enum declared from a file of the compilation with a durable definition key, each with one BLAKE3 digest per semantic section the compiler records. `status` is `available` with every section, or `unavailable` with a `reason` and no other section. A digest is evidence that the canonical data it was taken over is equal, never that behaviour is. Paths are relative to the source root; nothing session-local or host-specific is included, so the same sources give the same bytes from any checkout.\",\"properties\":{\"definitions\":{\"description\":\"Ordered by identity; each identity once.\",\"items\":{\"$ref\":\"#/$defs/definition\"},\"type\":\"array\"},\"reason\":{\"description\":\"Why there is no snapshot: some file needed syntax recovery or a module could not be loaded, or the root module has no durable key. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"incomplete_compilation\",\"no_durable_root\"]},\"root\":{\"$ref\":\"#/$defs/root\"},\"schema\":{\"const\":\"nazm.snapshot/3\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]},\"unsupported\":{\"const\":[\"capabilities\",\"tests\",\"semantic_history\",\"behavioural_equivalence\"],\"description\":\"What a snapshot does not record, and so can never report unchanged.\"},\"untracked\":{\"description\":\"Definitions of the compilation with no durable identity — declared in a module outside the source root — left out rather than matched by a path or a name.\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.snapshot/3\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_2() -> Str {
    "{\"name\":\"nazm.semantic_delta\",\"description\":\"What changed (nazm.delta/3) between a baseline nazm.snapshot/3 the client kept and the server's root compilation as it is on disk now: durable definitions added, removed, and changed, with exactly which recorded sections changed. Matched by durable key only — a rename is a removal and an addition. A baseline of another root or compiler, or not exactly nazm.snapshot/3, is refused. The server keeps no previous snapshot.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"baseline\":{\"description\":\"A nazm.snapshot/3 object exactly as nazm.semantic_snapshot returned it. Data, never a path.\",\"type\":\"object\"}},\"required\":[\"baseline\"],\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"change\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"$ref\":\"#/$defs/span\",\"description\":\"Where it is declared now.\"},\"identity\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]},\"sections\":{\"additionalProperties\":false,\"description\":\"Whether each recorded section's digest differs. `callers`, `callees` and `effects` are null for a record or an enum: not applicable.\",\"properties\":{\"callees\":{\"type\":[\"boolean\",\"null\"]},\"callers\":{\"type\":[\"boolean\",\"null\"]},\"dependencies\":{\"type\":\"boolean\"},\"diagnostics\":{\"type\":\"boolean\"},\"effects\":{\"description\":\"Whether a function's declared or required effects differ (N36).\",\"type\":[\"boolean\",\"null\"]},\"provenance\":{\"description\":\"Whether a function's provenance summary differs (N38) — which can happen with no byte of it changing, when a callee's body does.\",\"type\":[\"boolean\",\"null\"]},\"references\":{\"type\":\"boolean\"},\"related_types\":{\"type\":\"boolean\"},\"shape\":{\"type\":\"boolean\"},\"source\":{\"type\":\"boolean\"}},\"required\":[\"source\",\"shape\",\"dependencies\",\"related_types\",\"references\",\"callers\",\"callees\",\"diagnostics\",\"effects\",\"provenance\"],\"type\":\"object\"}},\"required\":[\"identity\",\"kind\",\"declaration\",\"sections\"],\"type\":\"object\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"definitions\":{\"minimum\":0,\"type\":\"integer\"},\"untracked\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"definitions\",\"untracked\"],\"type\":\"object\"},\"definition\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"$ref\":\"#/$defs/span\"},\"identity\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]}},\"required\":[\"identity\",\"kind\",\"declaration\"],\"type\":\"object\"},\"root\":{\"additionalProperties\":false,\"properties\":{\"compiler\":{\"type\":\"string\"},\"module\":{\"description\":\"The root module's durable key.\",\"type\":\"string\"}},\"required\":[\"module\",\"compiler\"],\"type\":\"object\"},\"span\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"}},\"$id\":\"nazm.delta-3.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What changed between a baseline `nazm.snapshot/3` and the current compilation of the same root, from `nazm delta --json` and the `nazm-mcp` tool `nazm.semantic_delta`. Definitions are matched by durable key only: a rename is a removal and an addition. A changed definition names exactly which recorded sections changed; `source` alone is a change in text the other recorded sections do not see. Nothing here claims behaviour is unchanged: `unsupported` lists what is not recorded. `status` is `available` with every section, or `unavailable` with a `reason` and no other section.\",\"properties\":{\"added\":{\"description\":\"In the current compilation and not the baseline, where each is declared now. Ordered by identity.\",\"items\":{\"$ref\":\"#/$defs/definition\"},\"type\":\"array\"},\"baseline\":{\"$ref\":\"#/$defs/counts\"},\"changed\":{\"description\":\"In both, with a different digest in at least one recorded section. Ordered by identity.\",\"items\":{\"$ref\":\"#/$defs/change\"},\"type\":\"array\"},\"current\":{\"$ref\":\"#/$defs/counts\"},\"reason\":{\"description\":\"Why there is no delta: the current compilation has no snapshot, or the baseline is not exactly a `nazm.snapshot/3` of this root by this compiler. A baseline is refused, never compared as well as it can be. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"incomplete_compilation\",\"no_durable_root\",\"baseline_wrong_schema\",\"baseline_unavailable\",\"baseline_malformed\",\"baseline_invalid_identity\",\"baseline_duplicate_identity\",\"baseline_invalid_digest\",\"baseline_wrong_root\",\"baseline_wrong_compiler\"]},\"removed\":{\"description\":\"In the baseline and not the current compilation, where each was declared. Ordered by identity.\",\"items\":{\"$ref\":\"#/$defs/definition\"},\"type\":\"array\"},\"root\":{\"$ref\":\"#/$defs/root\"},\"schema\":{\"const\":\"nazm.delta/3\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]},\"unchanged\":{\"description\":\"In both, with every recorded section's digest equal.\",\"minimum\":0,\"type\":\"integer\"},\"unsupported\":{\"const\":[\"capabilities\",\"tests\",\"semantic_history\",\"behavioural_equivalence\"],\"description\":\"Not recorded, so never reported as changed or unchanged.\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.delta/3\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_3() -> Str {
    "{\"name\":\"nazm.semantic_patch\",\"description\":\"Plan a semantic patch (nazm.patch/1) in the server's root compilation as it is on disk now: a rename (operation `rename`: file, byte_offset, new_name — locals and private definitions only; exported ones are refused) or a compiler-owned diagnostic fix (operation `diagnostic_fix`: file, byte_offset, fix). The result is minimal exact-byte edits bound to the root's snapshot digest, each file's digest and each edit's expected bytes, with a fix's applicability and precondition. It plans and never applies: nothing is written.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"What `nazm.semantic_patch` is asked, tagged by `operation`: typed, so its input schema is\\nthe SDK's derivation of it and an argument it does not define is refused.\",\"oneOf\":[{\"additionalProperties\":false,\"description\":\"Rename the entity declared or used at `byte_offset` of `file`: locals and private\\ndefinitions only, as the language service validates a rename.\",\"properties\":{\"byte_offset\":{\"description\":\"A UTF-8 byte offset into that file.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"},\"file\":{\"description\":\"A file of the root's compilation, relative to its source root or absolute.\",\"type\":\"string\"},\"new_name\":{\"description\":\"The new name: one identifier.\",\"type\":\"string\"},\"operation\":{\"const\":\"rename\",\"type\":\"string\"}},\"required\":[\"operation\",\"file\",\"byte_offset\",\"new_name\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"The fix at index `fix` among those the current diagnostics at `byte_offset` of\\n`file` carry, in the order the compiler attached them.\",\"properties\":{\"byte_offset\":{\"description\":\"A UTF-8 byte offset into that file: a diagnostic's primary span there.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"},\"file\":{\"description\":\"A file of the root's compilation, relative to its source root or absolute.\",\"type\":\"string\"},\"fix\":{\"description\":\"Which of the fixes at that position.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"},\"operation\":{\"const\":\"diagnostic_fix\",\"type\":\"string\"}},\"required\":[\"operation\",\"file\",\"byte_offset\",\"fix\"],\"type\":\"object\"}],\"title\":\"PatchRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"diagnostic_fix\":{\"additionalProperties\":false,\"properties\":{\"alternatives\":{\"minimum\":1,\"type\":\"integer\"},\"applicability\":{\"description\":\"Exactly as the compiler attached it. A `needs_review` patch is never safe to apply without review.\",\"enum\":[\"automatic\",\"needs_review\"]},\"description\":{\"description\":\"For presentation only: never identity, selection or validation.\",\"type\":\"string\"},\"diagnostic\":{\"additionalProperties\":false,\"description\":\"The current diagnostic the fix belongs to, by its code and primary span.\",\"properties\":{\"code\":{\"pattern\":\"^N[0-9]{4}$\",\"type\":\"string\"},\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"code\",\"file\",\"start\",\"end\"],\"type\":\"object\"},\"fix\":{\"description\":\"Which of the fixes at the requested position.\",\"minimum\":0,\"type\":\"integer\"},\"kind\":{\"const\":\"diagnostic_fix\"},\"precondition\":{\"description\":\"When the edit is the right one — the compiler's, present for every fix.\",\"type\":\"string\"}},\"required\":[\"kind\",\"diagnostic\",\"fix\",\"alternatives\",\"applicability\",\"precondition\",\"description\"],\"type\":\"object\"},\"digest\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"file\":{\"additionalProperties\":false,\"properties\":{\"digest\":{\"$ref\":\"#/$defs/digest\",\"description\":\"BLAKE3 of the file's exact bytes at planning.\"},\"edits\":{\"description\":\"Ordered by start, then end; disjoint; no two at one point. Serialisation order, not application order.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"expected\":{\"description\":\"The exact bytes at `start..end` the edit replaces.\",\"type\":\"string\"},\"replacement\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"start\",\"end\",\"expected\",\"replacement\"],\"type\":\"object\"},\"type\":\"array\"},\"path\":{\"type\":\"string\"}},\"required\":[\"path\",\"digest\",\"edits\"],\"type\":\"object\"},\"identity\":{\"additionalProperties\":false,\"properties\":{\"definition\":{\"description\":\"The durable definition key, `module::kind name`; null where the module has no durable key.\",\"type\":[\"string\",\"null\"]},\"member\":{\"description\":\"A field's, a variant's or (`Variant.field`) a payload field's name; null for the definition itself.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"definition\",\"member\"],\"type\":\"object\"},\"rename\":{\"additionalProperties\":false,\"properties\":{\"kind\":{\"const\":\"rename\"},\"new_name\":{\"type\":\"string\"},\"old_name\":{\"type\":\"string\"},\"target\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"$ref\":\"#/$defs/span\",\"description\":\"Where it is declared now: the source-linked identity every target has.\"},\"durable\":{\"description\":\"Whether `identity` is a durable definition key. A local's never is.\",\"type\":\"boolean\"},\"identity\":{\"$ref\":\"#/$defs/identity\",\"description\":\"Null for a local, which has no durable key and is not given one.\",\"type\":[\"object\",\"null\"]},\"kind\":{\"enum\":[\"function\",\"local\",\"record\",\"enum\",\"variant\",\"field\",\"payload_field\",\"constant\"]},\"within\":{\"description\":\"A local's declaring function's durable key; null otherwise.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"kind\",\"durable\",\"identity\",\"declaration\",\"within\"],\"type\":\"object\"}},\"required\":[\"kind\",\"target\",\"old_name\",\"new_name\"],\"type\":\"object\"},\"span\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"}},\"$id\":\"nazm.patch-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"A semantic patch plan, from `nazm patch rename|fix --json` and the `nazm-mcp` tool `nazm.semantic_patch`: an edit the compiler already validates — a rename (N18) or a fix a current diagnostic carries (N24) — as minimal exact-byte edits, bound to the root's semantic snapshot (N28), each edited file's digest and each edit's expected bytes. A patch is a proposal bound to exact source state, not permission to mutate files: nothing that produces one applies it. `status` is `available` with every section, or `unavailable` with a `reason` and no other section. Paths are relative to the source root and byte offsets are into the named file; nothing session-local is included, so the same sources and request give the same bytes.\",\"properties\":{\"baseline\":{\"additionalProperties\":false,\"properties\":{\"snapshot\":{\"$ref\":\"#/$defs/digest\",\"description\":\"BLAKE3 of the root's canonical `nazm.snapshot/3` (`/2` before N38, `/1` before N36) bytes — what `nazm snapshot --json` prints, without its newline — when the patch was planned.\"}},\"required\":[\"snapshot\"],\"type\":\"object\"},\"files\":{\"description\":\"Ordered by path; each file once.\",\"items\":{\"$ref\":\"#/$defs/file\"},\"type\":\"array\"},\"operation\":{\"oneOf\":[{\"$ref\":\"#/$defs/rename\"},{\"$ref\":\"#/$defs/diagnostic_fix\"}]},\"reason\":{\"description\":\"Why there is no patch. `exported`: no declared workspace, so one root compilation is not every module that may import it. `package_api`: part of a library package's API, which other packages import (N89). `incomplete_compilation`: syntax recovery or a missing module left no snapshot to bind to — which includes every fix of a syntax diagnostic. `no_such_fix`: no current diagnostic at the position carries a fix with that index. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"not_in_compilation\",\"out_of_range\",\"incomplete_compilation\",\"no_durable_root\",\"no_entity\",\"incomplete_coverage\",\"toolchain_owned\",\"exported\",\"package_api\",\"not_clean\",\"invalid_name\",\"unchanged\",\"rejected\",\"meaning_changed\",\"no_such_fix\",\"empty_edit\",\"duplicate_edit\",\"overlapping_edits\",\"internal\"]},\"root\":{\"additionalProperties\":false,\"properties\":{\"compiler\":{\"type\":\"string\"},\"module\":{\"description\":\"The root module's durable key, as `nazm.snapshot/3` (`/2` before N38, `/1` before N36) gives it.\",\"type\":\"string\"}},\"required\":[\"module\",\"compiler\"],\"type\":\"object\"},\"schema\":{\"const\":\"nazm.patch/1\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]},\"validation\":{\"description\":\"`reanalysed`: the candidate program was re-parsed and re-checked, clean, with its occurrences grouped into entities exactly as before (N18). `compiler_fix`: the edit is the compiler's own fix, governed by its applicability and precondition.\",\"enum\":[\"reanalysed\",\"compiler_fix\"]}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.patch/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_4() -> Str {
    "{\"name\":\"nazm.diagnostics\",\"description\":\"Every current diagnostic of the server's root compilation, from disk now, compactly (nazm.diagnostic-index/1): each one's id, code, severity, file and byte range, owning definition and fix counts — no message or help text. Ask nazm.diagnostic_detail for one in full. Syntax errors included.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"digest\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"owner\":{\"additionalProperties\":false,\"properties\":{\"identity\":{\"description\":\"The durable definition key, `module::kind name`.\",\"type\":\"string\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]},\"name\":{\"type\":\"string\"}},\"required\":[\"identity\",\"kind\",\"name\"],\"type\":\"object\"},\"root\":{\"additionalProperties\":false,\"properties\":{\"compiler\":{\"type\":\"string\"},\"module\":{\"description\":\"The root module's durable key.\",\"type\":\"string\"}},\"required\":[\"module\",\"compiler\"],\"type\":\"object\"},\"span\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"},\"state\":{\"additionalProperties\":false,\"properties\":{\"snapshot\":{\"description\":\"BLAKE3 of the root's `nazm.snapshot/3` (`/2` before N38, `/1` before N36) (N28); null where the compilation has none — after syntax recovery or a missing module.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"source\":{\"$ref\":\"#/$defs/digest\",\"description\":\"BLAKE3 over the root's identity and every loaded source file's root-relative path and exact bytes, in load order. Always present; a detail request names it.\"}},\"required\":[\"source\",\"snapshot\"],\"type\":\"object\"},\"summary\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"pattern\":\"^N[0-9]{4}$\",\"type\":\"string\"},\"fixes\":{\"additionalProperties\":false,\"description\":\"The compiler fixes it carries, by applicability. Not semantic patches: detail says which N29 can plan.\",\"properties\":{\"automatic\":{\"minimum\":0,\"type\":\"integer\"},\"needs_review\":{\"minimum\":0,\"type\":\"integer\"},\"total\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"total\",\"automatic\",\"needs_review\"],\"type\":\"object\"},\"id\":{\"description\":\"`code@file:start-end#n`: `n` counts earlier entries with the same code and primary place. Meaningful only within `state.source`.\",\"type\":\"string\"},\"owner\":{\"$ref\":\"#/$defs/owner\",\"description\":\"The durable function, record or enum whose declaration contains the primary span, in a compilation that needed no syntax recovery; null otherwise.\",\"type\":[\"object\",\"null\"]},\"primary\":{\"$ref\":\"#/$defs/span\",\"description\":\"Null for a diagnostic with no place.\",\"type\":[\"object\",\"null\"]},\"severity\":{\"enum\":[\"error\",\"warning\"]}},\"required\":[\"id\",\"code\",\"severity\",\"primary\",\"owner\",\"fixes\"],\"type\":\"object\"}},\"$id\":\"nazm.diagnostic-index-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"Every current diagnostic of one root compilation, compactly, from `nazm diagnostics --json` and the `nazm-mcp` tool `nazm.diagnostics`: each diagnostic's id, code, severity, place, owning definition and fix counts, read from structured fields the compiler set. No message, help, label text, fix description or precondition is included, and nothing is inferred from them: `nazm diagnostics --detail` returns one diagnostic in full. `nazm.diagnostic/1` is unchanged. Paths are relative to the source root and offsets are UTF-8 bytes into the named file; nothing session-local is included, so the same sources give the same bytes.\",\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"automatic_fixes\":{\"minimum\":0,\"type\":\"integer\"},\"error\":{\"description\":\"Diagnostics of severity `error`, the one severity the compiler has.\",\"minimum\":0,\"type\":\"integer\"},\"needs_review_fixes\":{\"minimum\":0,\"type\":\"integer\"},\"total\":{\"minimum\":0,\"type\":\"integer\"},\"with_fixes\":{\"description\":\"Diagnostics carrying at least one compiler fix.\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"total\",\"error\",\"with_fixes\",\"automatic_fixes\",\"needs_review_fixes\"],\"type\":\"object\"},\"diagnostics\":{\"description\":\"Ordered by primary file, start, end and code, then by secondary and fix places, then by the compiler's own order. Each id once.\",\"items\":{\"$ref\":\"#/$defs/summary\"},\"type\":\"array\"},\"reason\":{\"description\":\"Why there is no index. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"no_durable_root\",\"stale_state\",\"no_such_diagnostic\"]},\"root\":{\"$ref\":\"#/$defs/root\"},\"schema\":{\"const\":\"nazm.diagnostic-index/1\"},\"state\":{\"$ref\":\"#/$defs/state\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.diagnostic-index/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_5() -> Str {
    "{\"name\":\"nazm.diagnostic_detail\",\"description\":\"One current diagnostic in full (nazm.diagnostic-detail/1), by the id and state.source a nazm.diagnostics index gave it: the compiler's diagnostic exactly as nazm.diagnostic/1 publishes it, its places in their files, its owner, and for each fix the nazm.semantic_patch request that plans it where one exists. Refused as stale_state if the sources have changed since the index.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What `nazm.diagnostic_detail` is asked: one diagnostic, by the id and the state an index\\ngave it. Typed, so its input schema is the SDK's derivation of it.\",\"properties\":{\"id\":{\"description\":\"A diagnostic's `id`, from `nazm.diagnostics`.\",\"type\":\"string\"},\"state\":{\"description\":\"That index's `state.source`: the sources the id is of.\",\"type\":\"string\"}},\"required\":[\"id\",\"state\"],\"title\":\"DetailRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"span\":{\"additionalProperties\":false,\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":\"object\"}},\"$id\":\"nazm.diagnostic-detail-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"One current diagnostic in full, from `nazm diagnostics --detail ID --state DIGEST --json` and the `nazm-mcp` tool `nazm.diagnostic_detail`: the diagnostic exactly as `nazm.diagnostic/1` publishes it — the compiler's prose, unchanged — with its places in their own files, its owning definition, and for each compiler fix the `nazm.semantic_patch` request that plans it where N29 can. Refused as `stale_state` unless the sources are exactly the index's state, so an id never selects another diagnostic.\",\"properties\":{\"compiler_fixes\":{\"description\":\"How many fixes the compiler attached.\",\"minimum\":0,\"type\":\"integer\"},\"diagnostic\":{\"description\":\"The diagnostic as `nazm.diagnostic/1` publishes it, less its `schema` field: that schema defines every field, and its spans are offsets into the concatenation of the compilation's files.\",\"type\":\"object\"},\"facts\":{\"const\":\"unavailable\",\"description\":\"Typed expected/actual facts: the compiler records none for any diagnostic, and none is read from prose.\"},\"fixes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"applicability\":{\"enum\":[\"automatic\",\"needs_review\"]},\"fix\":{\"minimum\":0,\"type\":\"integer\"},\"semantic_patch\":{\"additionalProperties\":false,\"description\":\"The `diagnostic_fix` request that plans this fix with `nazm.semantic_patch` / `nazm patch fix` — a selector, not a plan. Null where N29 cannot plan it.\",\"properties\":{\"byte_offset\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"fix\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"byte_offset\",\"fix\"],\"type\":[\"object\",\"null\"]}},\"required\":[\"fix\",\"applicability\",\"semantic_patch\"],\"type\":\"object\"},\"type\":\"array\"},\"id\":{\"type\":\"string\"},\"locations\":{\"additionalProperties\":false,\"description\":\"`diagnostic`'s spans, each in its own root-relative file with UTF-8 byte offsets, in the same order; null for a span with no place.\",\"properties\":{\"fixes\":{\"items\":{\"$ref\":\"#/$defs/span\",\"type\":[\"object\",\"null\"]},\"type\":\"array\"},\"primary\":{\"$ref\":\"#/$defs/span\",\"type\":[\"object\",\"null\"]},\"secondary\":{\"items\":{\"$ref\":\"#/$defs/span\",\"type\":[\"object\",\"null\"]},\"type\":\"array\"}},\"required\":[\"primary\",\"secondary\",\"fixes\"],\"type\":\"object\"},\"owner\":{\"additionalProperties\":false,\"properties\":{\"identity\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"function\",\"record\",\"enum\"]},\"name\":{\"type\":\"string\"}},\"required\":[\"identity\",\"kind\",\"name\"],\"type\":[\"object\",\"null\"]},\"reason\":{\"description\":\"`stale_state`: the sources are not the state the id came from. `no_such_diagnostic`: no current diagnostic has that id. Present only when `status` is `unavailable`.\",\"enum\":[\"not_current\",\"no_durable_root\",\"stale_state\",\"no_such_diagnostic\"]},\"root\":{\"additionalProperties\":false,\"properties\":{\"compiler\":{\"type\":\"string\"},\"module\":{\"type\":\"string\"}},\"required\":[\"module\",\"compiler\"],\"type\":\"object\"},\"schema\":{\"const\":\"nazm.diagnostic-detail/1\"},\"semantic_patches\":{\"description\":\"How many of them N29 can plan — never more than `compiler_fixes`, and none for a compilation without a snapshot, such as any with a syntax error.\",\"minimum\":0,\"type\":\"integer\"},\"state\":{\"additionalProperties\":false,\"properties\":{\"snapshot\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"source\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"}},\"required\":[\"source\",\"snapshot\"],\"type\":\"object\"},\"status\":{\"enum\":[\"available\",\"unavailable\"]}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.diagnostic-detail/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_6() -> Str {
    "{\"name\":\"nazm.command_summary\",\"description\":\"What `nazm check` concludes for the server's root as it is on disk now, compactly (nazm.command-summary/1): its status and exit status, and a reference to every diagnostic it reports — code, place, fix counts and, where nazm.diagnostics indexes it, its id — including a program's missing `main`. No prose. operation: `check` only; building and testing write files and are not offered. Nothing is written.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"What `nazm.command_summary` is asked: one operation, from a finite set that is read-only\\n— only `check`. Typed, so its input schema is the SDK's derivation of it.\",\"oneOf\":[{\"additionalProperties\":false,\"description\":\"`nazm check` of the root, as it is on disk now, without the check cache.\",\"properties\":{\"operation\":{\"const\":\"check\",\"type\":\"string\"}},\"required\":[\"operation\"],\"type\":\"object\"}],\"title\":\"SummaryRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"reference\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"pattern\":\"^N[0-9]{4}$\",\"type\":\"string\"},\"fixes\":{\"additionalProperties\":false,\"description\":\"The compiler fixes it carries; not semantic patches, which N30's detail reports.\",\"properties\":{\"automatic\":{\"minimum\":0,\"type\":\"integer\"},\"needs_review\":{\"minimum\":0,\"type\":\"integer\"},\"total\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"total\",\"automatic\",\"needs_review\"],\"type\":\"object\"},\"id\":{\"description\":\"N30's diagnostic id, within `state`, where N30 indexes the diagnostic; null for a command reference.\",\"type\":[\"string\",\"null\"]},\"primary\":{\"additionalProperties\":false,\"description\":\"Root-relative file and UTF-8 byte range; null for a diagnostic with no place, or when `state` is null.\",\"properties\":{\"end\":{\"minimum\":0,\"type\":\"integer\"},\"file\":{\"type\":\"string\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"file\",\"start\",\"end\"],\"type\":[\"object\",\"null\"]},\"scope\":{\"description\":\"`index`: N30 indexes it, and `id` selects its detail. `command`: only the command reports it — a program's missing `main` (`N0204`), a backend's refusal — and it has no N30 id.\",\"enum\":[\"index\",\"command\"]},\"severity\":{\"enum\":[\"error\",\"warning\"]}},\"required\":[\"id\",\"scope\",\"code\",\"severity\",\"primary\",\"fixes\"],\"type\":\"object\"}},\"$id\":\"nazm.command-summary-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What a `nazm check` or `nazm build` concluded, compactly, from `--summary-json` and the `nazm-mcp` tool `nazm.command_summary`: the command's own outcome and exit status, and a reference to every diagnostic it reported — code, severity, place and fix counts, no prose. An additive view, not a replacement: `--json` gives every diagnostic in full, and `nazm.check-report/1` and `nazm.build-report/1` are unchanged. Absence of diagnostics does not imply command success: `status` is the command's outcome. No timing, timestamp or host path is included.\",\"properties\":{\"artifact\":{\"additionalProperties\":false,\"description\":\"The executable a build wrote; null for a check and for a build that wrote none.\",\"properties\":{\"path\":{\"description\":\"As `nazm build` prints it: `-o`'s path as given, or the source's stem, relative to the working directory.\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":[\"object\",\"null\"]},\"command\":{\"enum\":[\"check\",\"build\"]},\"counts\":{\"additionalProperties\":false,\"properties\":{\"automatic_fixes\":{\"minimum\":0,\"type\":\"integer\"},\"diagnostics\":{\"minimum\":0,\"type\":\"integer\"},\"error\":{\"minimum\":0,\"type\":\"integer\"},\"needs_review_fixes\":{\"minimum\":0,\"type\":\"integer\"},\"with_fixes\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"diagnostics\",\"error\",\"with_fixes\",\"automatic_fixes\",\"needs_review_fixes\"],\"type\":\"object\"},\"diagnostics\":{\"description\":\"Every diagnostic the command reported, in N30's canonical order.\",\"items\":{\"$ref\":\"#/$defs/reference\"},\"type\":\"array\"},\"exit_code\":{\"description\":\"The process exit status, exactly as without `--summary-json`.\",\"minimum\":0,\"type\":\"integer\"},\"root\":{\"description\":\"The root module's durable key; null where no compilation could be read.\",\"type\":[\"string\",\"null\"]},\"schema\":{\"const\":\"nazm.command-summary/1\"},\"state\":{\"description\":\"N30's `state.source` for the sources the command read: the state every `id` is of, for `nazm diagnostics --detail`. Null when the sources could not be read, or changed between the command's read and N30's, in which case no id is given.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"status\":{\"description\":\"`success`: checked clean, or the executable written. `rejected`: the program did not check or the backend refused a construct. `unreadable`: the input could not be read or loaded. `refused`: an action the command will not take, such as writing an executable over its source. `toolchain_failed`: the toolchain was missing or failed, or an output could not be written.\",\"enum\":[\"success\",\"rejected\",\"unreadable\",\"refused\",\"toolchain_failed\"]}},\"required\":[\"schema\",\"command\",\"status\",\"exit_code\",\"root\",\"state\",\"counts\",\"diagnostics\",\"artifact\"],\"title\":\"nazm.command-summary/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_7() -> Str {
    "{\"name\":\"nazm.docs_index\",\"description\":\"The index of Nazm's own documentation (nazm.docs-index/1), read from disk now: every document with its authority — normative (the spec), grammar, architecture, law, interface, evidence (what exists), planning (the roadmap), goal (aspiration, never evidence), research, operational, guide — and every section's stable id, title, parent and digest, with no body. Optionally one document's sections. Keep `state` and ask nazm.docs_section for a section's exact text. No search: ids are exact.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What `nazm.docs_index` is asked: the whole corpus, or one document of it by id.\",\"properties\":{\"document\":{\"default\":null,\"description\":\"A document's id, from an index: only its sections.\",\"type\":[\"string\",\"null\"]}},\"title\":\"DocsIndexRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"authority\":{\"description\":\"What the document is an authority for, as `docs/internal/master-architecture.md` §5 assigns it. A `goal` is aspiration and never evidence of what exists; `planning` is never a rule of the language; only `normative` and `grammar` say what a program means.\",\"enum\":[\"goal\",\"law\",\"architecture\",\"normative\",\"grammar\",\"guide\",\"interface\",\"evidence\",\"planning\",\"research\",\"operational\"]},\"available\":{\"additionalProperties\":false,\"properties\":{\"corpus\":{\"additionalProperties\":false,\"description\":\"The whole corpus, whichever documents are listed.\",\"properties\":{\"bytes\":{\"minimum\":0,\"type\":\"integer\"},\"documents\":{\"minimum\":0,\"type\":\"integer\"},\"sections\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"documents\",\"sections\",\"bytes\"],\"type\":\"object\"},\"documents\":{\"description\":\"In corpus order.\",\"items\":{\"$ref\":\"#/$defs/document\"},\"type\":\"array\"},\"schema\":{\"const\":\"nazm.docs-index/1\"},\"state\":{\"description\":\"BLAKE3 over a domain tag and, in corpus order, each document's id, repository-relative path and exact bytes. Pass it with a section request to bind it to this corpus.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"const\":\"available\"}},\"required\":[\"schema\",\"status\",\"state\",\"corpus\",\"documents\"],\"type\":\"object\"},\"document\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"$ref\":\"#/$defs/authority\"},\"bytes\":{\"minimum\":0,\"type\":\"integer\"},\"digest\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"format\":{\"enum\":[\"markdown\",\"ebnf\"]},\"id\":{\"type\":\"string\"},\"path\":{\"description\":\"From the repository root.\",\"type\":\"string\"},\"sections\":{\"description\":\"In source order.\",\"items\":{\"$ref\":\"#/$defs/section\"},\"type\":\"array\"}},\"required\":[\"id\",\"path\",\"authority\",\"format\",\"bytes\",\"digest\",\"sections\"],\"type\":\"object\"},\"not_found\":{\"additionalProperties\":false,\"properties\":{\"document\":{\"type\":\"string\"},\"schema\":{\"const\":\"nazm.docs-index/1\"},\"state\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"const\":\"not_found\"}},\"required\":[\"schema\",\"status\",\"state\",\"document\"],\"type\":\"object\"},\"problem\":{\"additionalProperties\":false,\"properties\":{\"document\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"missing_document\",\"unreadable_document\",\"no_title\",\"malformed_anchor\",\"misplaced_anchor\",\"unsupported_heading\",\"unclosed_fence\",\"unclosed_comment\",\"empty_identity\",\"duplicate_id\",\"broken_link\",\"generated_region\",\"broken_generated_from\",\"grammar_syntax\",\"detached_comment\",\"undefined_reference\"]},\"line\":{\"minimum\":1,\"type\":[\"integer\",\"null\"]},\"value\":{\"description\":\"The offending anchor, id, link or name.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"kind\",\"document\",\"line\",\"value\"],\"type\":\"object\"},\"section\":{\"additionalProperties\":false,\"properties\":{\"digest\":{\"description\":\"BLAKE3 over a domain tag, the document, the id and the section's exact body.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"id\":{\"description\":\"`document` for a document's root section, `document:local` otherwise: an explicit anchor, the heading's own label, or its text under its parent's id. Never a line, offset, ordinal or hash.\",\"type\":\"string\"},\"kind\":{\"enum\":[\"document\",\"heading\",\"production\"]},\"level\":{\"minimum\":1,\"type\":\"integer\"},\"parent\":{\"type\":[\"string\",\"null\"]},\"title\":{\"description\":\"The heading's text exactly, or a production's name; null for the grammar's header.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"id\",\"kind\",\"title\",\"level\",\"parent\",\"digest\"],\"type\":\"object\"},\"unavailable\":{\"additionalProperties\":false,\"properties\":{\"problems\":{\"items\":{\"$ref\":\"#/$defs/problem\"},\"type\":\"array\"},\"schema\":{\"const\":\"nazm.docs-index/1\"},\"status\":{\"const\":\"unavailable\"}},\"required\":[\"schema\",\"status\",\"problems\"],\"type\":\"object\"}},\"$id\":\"nazm.docs-index-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"The compact index of Nazm's own documentation, from `nazm docs --index --json` and the `nazm-mcp` tool `nazm.docs_index`: every document of the corpus with its authority, and every section's stable id, title, parent and digest — no body. The index is not a second source of documentation truth: the documents are, and `nazm.docs-section/1` returns a section's exact text. `unavailable` when the corpus cannot be sectioned, with every problem; `not_found` when a named document is not in the corpus.\",\"oneOf\":[{\"$ref\":\"#/$defs/available\"},{\"$ref\":\"#/$defs/not_found\"},{\"$ref\":\"#/$defs/unavailable\"}],\"properties\":{\"schema\":{\"const\":\"nazm.docs-index/1\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.docs-index/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_8() -> Str {
    "{\"name\":\"nazm.docs_section\",\"description\":\"One section of Nazm's own documentation (nazm.docs-section/1) by its exact id and the state a nazm.docs_index gave it: its document's authority, its parent and children, and its own canonical text byte for byte — never its subsections' and never a paraphrase. Refused as stale_state if the documentation changed since the index, and not_found for an id no section has. Ids only; no path is ever read.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What `nazm.docs_section` is asked: one section by its exact id, bound to the state of\\nthe index it came from. Never a path.\",\"properties\":{\"id\":{\"description\":\"A section's `id`, from `nazm.docs_index`.\",\"type\":\"string\"},\"state\":{\"description\":\"That index's `state`: the corpus the id is of.\",\"type\":\"string\"}},\"required\":[\"id\",\"state\"],\"title\":\"DocsSectionRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"available\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"description\":\"The section's document's authority, as `nazm.docs-index/1` defines it. A `goal` section is aspiration, never evidence of what exists.\",\"enum\":[\"goal\",\"law\",\"architecture\",\"normative\",\"grammar\",\"guide\",\"interface\",\"evidence\",\"planning\",\"research\",\"operational\"]},\"body\":{\"description\":\"A heading's line through the byte before the next heading of any level, or a production's attached comments through its `;`: exact bytes of the file.\",\"type\":\"string\"},\"children\":{\"description\":\"Direct subsections, in source order. Their text is not in `body`.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"digest\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"document\":{\"type\":\"string\"},\"format\":{\"enum\":[\"markdown\",\"ebnf\"]},\"id\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"document\",\"heading\",\"production\"]},\"level\":{\"minimum\":1,\"type\":\"integer\"},\"links\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"href\":{\"type\":[\"string\",\"null\"]},\"relation\":{\"description\":\"`link`: written in the text. `generated_from`: a guide section generated from a production. `references`: a nonterminal a production names — a grammar reference, not a semantic dependency.\",\"enum\":[\"link\",\"generated_from\",\"references\"]},\"scope\":{\"enum\":[\"corpus\",\"outside\",\"external\"]},\"target\":{\"description\":\"The section it resolves to, inside the corpus.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"relation\",\"href\",\"target\",\"scope\"],\"type\":\"object\"},\"type\":\"array\"},\"parent\":{\"type\":[\"string\",\"null\"]},\"production\":{\"additionalProperties\":false,\"properties\":{\"examples\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"text\":{\"description\":\"`name = … ;`, exactly.\",\"type\":\"string\"}},\"required\":[\"text\",\"examples\"],\"type\":[\"object\",\"null\"]},\"schema\":{\"const\":\"nazm.docs-section/1\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"lines\":{\"description\":\"The first and last line, from one. Location, never identity.\",\"items\":{\"minimum\":1,\"type\":\"integer\"},\"type\":\"array\"},\"path\":{\"description\":\"From the repository root.\",\"type\":\"string\"}},\"required\":[\"path\",\"lines\"],\"type\":\"object\"},\"state\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"const\":\"available\"},\"title\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"schema\",\"status\",\"state\",\"id\",\"document\",\"authority\",\"format\",\"kind\",\"title\",\"level\",\"parent\",\"children\",\"source\",\"body\",\"digest\",\"links\",\"production\"],\"type\":\"object\"},\"problem\":{\"additionalProperties\":false,\"properties\":{\"document\":{\"type\":\"string\"},\"kind\":{\"enum\":[\"missing_document\",\"unreadable_document\",\"no_title\",\"malformed_anchor\",\"misplaced_anchor\",\"unsupported_heading\",\"unclosed_fence\",\"unclosed_comment\",\"empty_identity\",\"duplicate_id\",\"broken_link\",\"generated_region\",\"broken_generated_from\",\"grammar_syntax\",\"detached_comment\",\"undefined_reference\"]},\"line\":{\"minimum\":1,\"type\":[\"integer\",\"null\"]},\"value\":{\"description\":\"The offending anchor, id, link or name.\",\"type\":[\"string\",\"null\"]}},\"required\":[\"kind\",\"document\",\"line\",\"value\"],\"type\":\"object\"},\"refused\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\"},\"schema\":{\"const\":\"nazm.docs-section/1\"},\"state\":{\"description\":\"The current corpus state.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"enum\":[\"not_found\",\"stale_state\"]}},\"required\":[\"schema\",\"status\",\"state\",\"id\"],\"type\":\"object\"},\"unavailable\":{\"additionalProperties\":false,\"properties\":{\"problems\":{\"items\":{\"$ref\":\"#/$defs/problem\"},\"type\":\"array\"},\"schema\":{\"const\":\"nazm.docs-section/1\"},\"status\":{\"const\":\"unavailable\"}},\"required\":[\"schema\",\"status\",\"problems\"],\"type\":\"object\"}},\"$id\":\"nazm.docs-section-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One section of Nazm's own documentation by its exact id, from `nazm docs --section ID --json` and the `nazm-mcp` tool `nazm.docs_section`: its document's authority, its place in the hierarchy, and its body — the canonical text byte for byte, its own and not its subsections', never paraphrased. `stale_state` when a state was given and the corpus is no longer it; `not_found` for an id no section has — never the nearest one; `unavailable` when the corpus cannot be sectioned.\",\"oneOf\":[{\"$ref\":\"#/$defs/available\"},{\"$ref\":\"#/$defs/refused\"},{\"$ref\":\"#/$defs/unavailable\"}],\"properties\":{\"schema\":{\"const\":\"nazm.docs-section/1\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.docs-section/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_9() -> Str {
    "{\"name\":\"nazm.repository_map\",\"description\":\"The repository context map (nazm.repository-map/1), read from disk now: every entity with a durable identity — Cargo packages and targets, Nazm source roots, compilation roots, modules and durable definitions, documents, published schemas, mutation profiles — with its authority, parent, structural relationships (Cargo dependencies, documentation a package declares, modules a compilation loads, the targets a profile says observe it) and how to retrieve more. No source body and no section text. Keep `state` and ask nazm.task_context for the context a task needs.\",\"inputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What `nazm.repository_map` is asked: nothing.\",\"title\":\"MapRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"available\":{\"additionalProperties\":false,\"properties\":{\"classes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"description\":\"The authority every entity of the kind is read from; a document carries its own.\",\"type\":\"string\"},\"count\":{\"minimum\":0,\"type\":\"integer\"},\"identity\":{\"description\":\"What the kind's ids are made of.\",\"type\":\"string\"},\"kind\":{\"$ref\":\"#/$defs/kind\"}},\"required\":[\"kind\",\"authority\",\"identity\",\"count\"],\"type\":\"object\"},\"type\":\"array\"},\"compiler\":{\"type\":\"string\"},\"delegated\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"type\":\"string\"},\"count\":{\"minimum\":0,\"type\":\"integer\"},\"kind\":{\"enum\":[\"section\",\"mutation\",\"test\",\"diagnostic\"]},\"retrieval\":{\"$ref\":\"#/$defs/retrieval\"}},\"required\":[\"kind\",\"authority\",\"count\",\"retrieval\"],\"type\":\"object\"},\"type\":\"array\"},\"entities\":{\"description\":\"In canonical order: by kind, in `classes` order, then by id in byte order. Each id once.\",\"items\":{\"$ref\":\"#/$defs/entity\"},\"type\":\"array\"},\"omitted\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"count\":{\"minimum\":0,\"type\":\"integer\"},\"kind\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"kind\",\"reason\"],\"type\":\"object\"},\"type\":\"array\"},\"schema\":{\"const\":\"nazm.repository-map/1\"},\"state\":{\"description\":\"BLAKE3 over every input the map is built from, each by its repository-relative path and exact bytes: the documentation corpus's state, every Cargo manifest and the targets Cargo would find, the mutation catalogue, every published schema and every `.nz` file directly in a source root. No absolute path, time, process or commit.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"const\":\"available\"}},\"required\":[\"schema\",\"status\",\"state\",\"compiler\",\"classes\",\"entities\",\"delegated\",\"omitted\"],\"type\":\"object\"},\"entity\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"description\":\"A document's N32 authority. A `goal` is aspiration and `planning` a plan: never evidence of what exists.\",\"enum\":[\"goal\",\"law\",\"architecture\",\"normative\",\"grammar\",\"guide\",\"interface\",\"evidence\",\"planning\",\"research\",\"operational\"]},\"detail\":{\"description\":\"A target's Cargo kind (`lib`, `bin`, `test`, `bench`, `example`), a definition's kind (`function`, `record`, `enum`), or whether a compilation is `complete` or `incomplete` — needed syntax recovery or lacks a module, so its definitions are not mapped.\",\"type\":\"string\"},\"diagnostics\":{\"description\":\"A compilation's current diagnostics.\",\"minimum\":0,\"type\":\"integer\"},\"id\":{\"description\":\"`kind:authority-id` — `package:nazm-docs`, `target:nazm-docs:test:corpus`, `sources:compiler`, `root:compiler:emit.nz`, `module:compiler:analyse.nz`, `def:compiler:analyse.nz::fn check` (a durable definition key under a source root), `doc:spec` (N32's document id), `schema:nazm.context/1`, `profile:checker`. Never a path, line, offset, time or commit.\",\"type\":\"string\"},\"kind\":{\"$ref\":\"#/$defs/kind\"},\"parent\":{\"type\":\"string\"},\"relations\":{\"description\":\"By kind, then target; each once.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"kind\":{\"description\":\"`depends_on`, `dev_depends_on`: a Cargo dependency on another member. `documented_by`: a section the package's `[package.metadata.nazm] docs` or the source root's manifest row names. `includes`: a module the compilation loaded. `observed_by`, `covers`: a profile's targets and the package or source root its `owns` names, from the mutation catalogue.\",\"enum\":[\"covers\",\"depends_on\",\"dev_depends_on\",\"documented_by\",\"includes\",\"observed_by\"]},\"target\":{\"description\":\"An entity of this map, or for `documented_by` an N32 section id prefixed `doc:`.\",\"type\":\"string\"}},\"required\":[\"kind\",\"target\"],\"type\":\"object\"},\"type\":\"array\"},\"retrieval\":{\"items\":{\"$ref\":\"#/$defs/retrieval\"},\"type\":\"array\"},\"source\":{\"description\":\"Where it is, from the repository root. A location, never its identity.\",\"type\":\"string\"}},\"required\":[\"id\",\"kind\"],\"type\":\"object\"},\"kind\":{\"enum\":[\"package\",\"target\",\"sources\",\"root\",\"module\",\"definition\",\"document\",\"schema\",\"profile\"]},\"problems\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"kind\":{\"type\":\"string\"},\"value\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"kind\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},\"retrieval\":{\"additionalProperties\":false,\"description\":\"The existing answer that holds more, and the arguments of the command or tool that gives it.\",\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"byte\":{\"minimum\":0,\"type\":\"integer\"},\"catalogue\":{\"type\":\"string\"},\"document\":{\"type\":\"string\"},\"file\":{\"description\":\"Relative to the compilation's source root.\",\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"root\":{\"description\":\"A compilation root, from the repository root.\",\"type\":\"string\"},\"state\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"}},\"type\":\"object\"},\"schema\":{\"enum\":[\"nazm.context/3\",\"nazm.diagnostic-detail/1\",\"nazm.diagnostic-index/1\",\"nazm.docs-index/1\",\"nazm.docs-section/1\",\"nazm.snapshot/3\",\"nazm.task-context/1\"]}},\"required\":[\"schema\",\"args\"],\"type\":\"object\"},\"unavailable\":{\"additionalProperties\":false,\"properties\":{\"problems\":{\"$ref\":\"#/$defs/problems\"},\"schema\":{\"const\":\"nazm.repository-map/1\"},\"status\":{\"const\":\"unavailable\"}},\"required\":[\"schema\",\"status\",\"problems\"],\"type\":\"object\"}},\"$id\":\"nazm.repository-map-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"The repository context map, from `nazm repo --map --json` and the `nazm-mcp` tool `nazm.repository_map`: every entity of the repository that has a durable identity — Cargo packages and targets, Nazm source roots, compilation roots, modules and durable definitions, documents, published schemas and mutation profiles — with its authority, its parent, its structural relationships and how to retrieve more, and never a source body or a section's text. Each relationship is read from a named authority: Cargo manifests, the compiler, the documentation corpus (N32) or the mutation catalogue. Entities another subsystem enumerates (documentation sections, mutations, catalogue tests, diagnostics) are counted in `delegated` with the answer that lists them; what has no durable identity is named in `omitted`. `unavailable` when an input cannot be read or the map does not validate — never a map with a broken or duplicate entity.\",\"oneOf\":[{\"$ref\":\"#/$defs/available\"},{\"$ref\":\"#/$defs/unavailable\"}],\"properties\":{\"schema\":{\"const\":\"nazm.repository-map/1\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.repository-map/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

fn mt_tool_10() -> Str {
    "{\"name\":\"nazm.task_context\",\"description\":\"The minimum context for a task (nazm.task-context/1): for seeds — repository entity ids from nazm.repository_map, never paths — and an intent (understand, edit, diagnose, test; default edit), the smallest set of entities the repository can justify, one relationship step from each seed: a definition's exact source and what it uses by shape, for an edit its callers or users and its catalogue tests, a section's exact text and what it links. Every item says why it is there, its priority class, its authority and how to retrieve it. A budget in entities and bytes (not tokens) is filled in priority order; what it cuts is listed and the answer is partial, and a budget the seeds do not fit is refused. Refused as stale_state if the repository changed since the map.\",\"inputSchema\":{\"$defs\":{\"TaskIntent\":{\"description\":\"What a task context is for.\",\"enum\":[\"understand\",\"edit\",\"diagnose\",\"test\"],\"type\":\"string\"}},\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"description\":\"What `nazm.task_context` is asked: seeds, an intent, the state they are of, and a\\nstructural budget. Never a path.\",\"properties\":{\"intent\":{\"anyOf\":[{\"$ref\":\"#/$defs/TaskIntent\"},{\"type\":\"null\"}],\"description\":\"`understand`, `edit`, `diagnose` or `test`; without it, `edit`, the widest.\"},\"max_doc_bytes\":{\"default\":null,\"description\":\"At most this many bytes of section text.\",\"format\":\"uint\",\"minimum\":0,\"type\":[\"integer\",\"null\"]},\"max_entities\":{\"default\":null,\"description\":\"At most this many items.\",\"format\":\"uint\",\"minimum\":0,\"type\":[\"integer\",\"null\"]},\"max_source_bytes\":{\"default\":null,\"description\":\"At most this many bytes of definition source.\",\"format\":\"uint\",\"minimum\":0,\"type\":[\"integer\",\"null\"]},\"seeds\":{\"description\":\"Repository entity ids, from `nazm.repository_map` or an earlier context: at most\\neight.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"state\":{\"description\":\"That map's `state`: the repository the ids are of.\",\"type\":\"string\"}},\"required\":[\"seeds\",\"state\"],\"title\":\"TaskRequest\",\"type\":\"object\"},\"outputSchema\":{\"$defs\":{\"available\":{\"additionalProperties\":false,\"properties\":{\"bounded\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"included\":{\"minimum\":0,\"type\":\"integer\"},\"known\":{\"minimum\":0,\"type\":\"integer\"},\"reason\":{\"$ref\":\"#/$defs/reason\"},\"via\":{\"type\":\"string\"}},\"required\":[\"via\",\"reason\",\"known\",\"included\"],\"type\":\"object\"},\"type\":\"array\"},\"budget\":{\"$ref\":\"#/$defs/budget\"},\"excluded\":{\"description\":\"Relationships known and deliberately not selected, by count.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"count\":{\"minimum\":0,\"type\":\"integer\"},\"reason\":{\"enum\":[\"not_selected_for_intent\",\"no_durable_identity\",\"no_durable_owner\"]},\"relation\":{\"type\":\"string\"},\"via\":{\"type\":\"string\"}},\"required\":[\"via\",\"relation\",\"count\",\"reason\"],\"type\":\"object\"},\"type\":\"array\"},\"intent\":{\"enum\":[\"understand\",\"edit\",\"diagnose\",\"test\"]},\"items\":{\"description\":\"The seeds in request order, then every other item once, by priority class, then documentation authority, then id.\",\"items\":{\"$ref\":\"#/$defs/item\"},\"type\":\"array\"},\"omitted\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"class\":{\"$ref\":\"#/$defs/class\"},\"dimension\":{\"description\":\"What it did not fit; `priority` when it would fit but an item before it did not.\",\"enum\":[\"entities\",\"source_bytes\",\"doc_bytes\",\"priority\"]},\"id\":{\"type\":\"string\"},\"reason\":{\"const\":\"budget_exhausted\"},\"via\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"id\",\"reason\",\"via\",\"class\",\"dimension\"],\"type\":\"object\"},\"type\":\"array\"},\"schema\":{\"const\":\"nazm.task-context/1\"},\"seeds\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"state\":{\"description\":\"The repository state, as `nazm.repository-map/1` defines it.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"status\":{\"enum\":[\"complete\",\"partial\"]},\"used\":{\"$ref\":\"#/$defs/used\"}},\"required\":[\"schema\",\"status\",\"state\",\"intent\",\"seeds\",\"budget\",\"used\",\"items\",\"omitted\",\"bounded\",\"excluded\"],\"type\":\"object\"},\"budget\":{\"additionalProperties\":false,\"properties\":{\"max_doc_bytes\":{\"minimum\":0,\"type\":[\"integer\",\"null\"]},\"max_entities\":{\"minimum\":0,\"type\":[\"integer\",\"null\"]},\"max_source_bytes\":{\"minimum\":0,\"type\":[\"integer\",\"null\"]}},\"required\":[\"max_entities\",\"max_source_bytes\",\"max_doc_bytes\"],\"type\":\"object\"},\"class\":{\"description\":\"The priority classes, in order. `authority`: normative, grammar, law, interface, architecture and evidence sections. `supporting`: guide and operational sections, and a section's children. `context`: planning, research and goal sections — never evidence of what exists.\",\"enum\":[\"seed\",\"correctness\",\"authority\",\"edit_safety\",\"test\",\"supporting\",\"context\"]},\"item\":{\"additionalProperties\":false,\"properties\":{\"authority\":{\"enum\":[\"compiler\",\"cargo\",\"repository_manifest\",\"mutation_catalogue\",\"interface\",\"goal\",\"law\",\"architecture\",\"normative\",\"grammar\",\"guide\",\"evidence\",\"planning\",\"research\",\"operational\"]},\"class\":{\"$ref\":\"#/$defs/class\"},\"compilation\":{\"description\":\"The compilation root a semantic fact was read from.\",\"type\":\"string\"},\"content\":{\"description\":\"What is included: a definition's kind, name, declaration and signature, fields or variants, and — for a seed, a diagnostic's owner or a mutated definition — its exact `source`; a caller's or user's `uses`; a section's title, location and — unless it is only pointed at — its exact `body`; a diagnostic's code, message, primary place and owner; a test's target and the mutations it kills.\",\"type\":\"object\"},\"doc_bytes\":{\"minimum\":1,\"type\":\"integer\"},\"id\":{\"description\":\"A repository entity id, as `nazm.repository-map/1` defines it, or `doc:` an N32 section id, `test:` a catalogue killer, `mutation:` a catalogue entry, or `diagnostic:source-root:root:` an N30 id within that compilation.\",\"type\":\"string\"},\"kind\":{\"enum\":[\"package\",\"target\",\"sources\",\"root\",\"module\",\"definition\",\"document\",\"section\",\"schema\",\"profile\",\"mutation\",\"test\",\"diagnostic\"]},\"reason\":{\"$ref\":\"#/$defs/reason\"},\"retrieval\":{\"$ref\":\"#/$defs/retrieval\"},\"source_bytes\":{\"minimum\":1,\"type\":\"integer\"},\"via\":{\"description\":\"The seed it was reached from.\",\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"reason\",\"class\",\"authority\"],\"type\":\"object\"},\"reason\":{\"enum\":[\"seed\",\"direct_dependency\",\"signature_type\",\"diagnostic_owner\",\"diagnostic_in_seed\",\"mutated_definition\",\"contained_definition\",\"included_module\",\"contained_root\",\"owner_package\",\"owner_target\",\"authoritative_doc\",\"linked_section\",\"generated_from\",\"grammar_reference\",\"child_section\",\"direct_caller\",\"direct_reference\",\"direct_dependent\",\"linking_section\",\"killer_test\",\"profile_target\",\"owned_target\",\"observed_target\",\"contained_test\",\"killed_mutation\"]},\"refused\":{\"additionalProperties\":false,\"properties\":{\"problems\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"kind\":{\"type\":\"string\"},\"value\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"kind\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},\"required\":{\"$ref\":\"#/$defs/used\"},\"schema\":{\"const\":\"nazm.task-context/1\"},\"seeds\":{\"description\":\"For `not_found` and `incomplete_compilation`: which seeds.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"state\":{\"description\":\"The current repository state, where it could be read.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":[\"string\",\"null\"]},\"status\":{\"enum\":[\"invalid_request\",\"unavailable\",\"stale_state\",\"not_found\",\"incomplete_compilation\",\"insufficient_budget\"]}},\"required\":[\"schema\",\"status\",\"state\"],\"type\":\"object\"},\"retrieval\":{\"additionalProperties\":false,\"description\":\"The existing answer that holds more, and the arguments of the command or tool that gives it.\",\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"byte\":{\"minimum\":0,\"type\":\"integer\"},\"catalogue\":{\"type\":\"string\"},\"document\":{\"type\":\"string\"},\"file\":{\"description\":\"Relative to the compilation's source root.\",\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"root\":{\"description\":\"A compilation root, from the repository root.\",\"type\":\"string\"},\"state\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"}},\"type\":\"object\"},\"schema\":{\"enum\":[\"nazm.context/3\",\"nazm.diagnostic-detail/1\",\"nazm.diagnostic-index/1\",\"nazm.docs-index/1\",\"nazm.docs-section/1\",\"nazm.snapshot/3\",\"nazm.task-context/1\"]}},\"required\":[\"schema\",\"args\"],\"type\":\"object\"},\"used\":{\"additionalProperties\":false,\"properties\":{\"doc_bytes\":{\"minimum\":0,\"type\":\"integer\"},\"entities\":{\"minimum\":0,\"type\":\"integer\"},\"source_bytes\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"entities\",\"source_bytes\",\"doc_bytes\"],\"type\":\"object\"}},\"$id\":\"nazm.task-context-1.json\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"The minimum context for a task, from `nazm repo --task --json` and the `nazm-mcp` tool `nazm.task_context`: for structured seeds (repository entity ids, never paths) and an intent (`understand`, `edit` — the default, `diagnose`, `test`), the smallest set of repository entities this repository can justify, one relationship step from each seed and cut at sixteen members per relationship. Every item says why it is there, which seed it was reached from, its priority class, its authority and how to retrieve it again; a definition seed carries its exact source, other definitions their shape, and a section its exact text. A structural budget — entities, bytes of definition source, bytes of section text; not tokens — takes items in priority order: seeds whole or `insufficient_budget`, then until one does not fit, which and everything after it are listed in `omitted`, and the context is `partial`. A relationship cut at its bound is in `bounded` and also makes it `partial`. `stale_state` when the repository is no longer the state named; `not_found` for an id no entity has; `incomplete_compilation` for a definition only compilations that needed syntax recovery load; `invalid_request` for a malformed seed or request; `unavailable` when the repository cannot be read.\",\"oneOf\":[{\"$ref\":\"#/$defs/available\"},{\"$ref\":\"#/$defs/refused\"}],\"properties\":{\"schema\":{\"const\":\"nazm.task-context/1\"}},\"required\":[\"schema\",\"status\"],\"title\":\"nazm.task-context/1\",\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}"
}

// The whole tool, as it is an element of `tools/list`.
pub fn mt_tool(i: Int) -> Str {
    if i == 0 { return mt_tool_0() }
    if i == 1 { return mt_tool_1() }
    if i == 2 { return mt_tool_2() }
    if i == 3 { return mt_tool_3() }
    if i == 4 { return mt_tool_4() }
    if i == 5 { return mt_tool_5() }
    if i == 6 { return mt_tool_6() }
    if i == 7 { return mt_tool_7() }
    if i == 8 { return mt_tool_8() }
    if i == 9 { return mt_tool_9() }
    if i == 10 { return mt_tool_10() }
    ""
}
