// The C host programs of `nazm accel` (R8 slice 11, task 10.2): the OpenCL provider's and the CPU provider's, as
// `crates/nazm-cli/src/accel.rs` holds them. Generated by toolchain/commands/tests/gen-accelc.sh from
// crates/nazm-cli/src/accel_host.c and accel_cpu.c; do not edit by hand.

pub fn ac_host_source() -> Str {
    let l = strs_new()
    strs_push(l, "// Written by nazm accel (N67, docs/internal/architecture.md §7.69): the host side of one kernel run.\n")
    strs_push(l, "// argv: kernel.cl output.bin input.bin [input2.bin] — one input for a map, two for a zip (N88).\n")
    strs_push(l, "// Every transfer and synchronisation is explicit and timed; one line of JSON on stdout says what\n")
    strs_push(l, "// happened. Built with NZ_SIZE, the bytes of one element, and for a float kernel (Gate 3) NZ_FLOAT,\n")
    strs_push(l, "// and for a Float64 one NZ_FP64, which the device must support.\n")
    strs_push(l, "#define CL_SILENCE_DEPRECATION\n")
    strs_push(l, "#include <OpenCL/opencl.h>\n")
    strs_push(l, "#include <stdint.h>\n")
    strs_push(l, "#include <stdio.h>\n")
    strs_push(l, "#include <stdlib.h>\n")
    strs_push(l, "#include <string.h>\n")
    strs_push(l, "#include <time.h>\n")
    strs_push(l, "\n")
    strs_push(l, "static double now_ms(void) {\n")
    strs_push(l, "    struct timespec t;\n")
    strs_push(l, "    clock_gettime(CLOCK_MONOTONIC, &t);\n")
    strs_push(l, "    return (double)t.tv_sec * 1e3 + (double)t.tv_nsec / 1e6;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "static char *slurp(const char *path, size_t *len) {\n")
    strs_push(l, "    FILE *f = fopen(path, \"rb\");\n")
    strs_push(l, "    if (!f) return NULL;\n")
    strs_push(l, "    fseek(f, 0, SEEK_END);\n")
    strs_push(l, "    long n = ftell(f);\n")
    strs_push(l, "    fseek(f, 0, SEEK_SET);\n")
    strs_push(l, "    char *b = malloc((size_t)n + 1);\n")
    strs_push(l, "    if (!b || fread(b, 1, (size_t)n, f) != (size_t)n) { fclose(f); return NULL; }\n")
    strs_push(l, "    b[n] = 0;\n")
    strs_push(l, "    fclose(f);\n")
    strs_push(l, "    *len = (size_t)n;\n")
    strs_push(l, "    return b;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "#define CHECK(what, e) if ((e) != CL_SUCCESS) { printf(\"{\\\"error\\\":\\\"%s\\\",\\\"code\\\":%d}\\n\", what, (int)(e)); return 3; }\n")
    strs_push(l, "\n")
    strs_push(l, "int main(int argc, char **argv) {\n")
    strs_push(l, "    if (argc != 4 && argc != 5) return 4;\n")
    strs_push(l, "    int zip = argc == 5;\n")
    strs_push(l, "    size_t src_len, in_len, in2_len = 0;\n")
    strs_push(l, "    char *src = slurp(argv[1], &src_len);\n")
    strs_push(l, "    char *in = slurp(argv[3], &in_len);\n")
    strs_push(l, "    char *in2 = zip ? slurp(argv[4], &in2_len) : NULL;\n")
    strs_push(l, "    if (!src || !in || (zip && (!in2 || in2_len != in_len))) { printf(\"{\\\"error\\\":\\\"unreadable input\\\"}\\n\"); return 3; }\n")
    strs_push(l, "    size_t n = in_len / NZ_SIZE;\n")
    strs_push(l, "    cl_int e;\n")
    strs_push(l, "    cl_platform_id p;\n")
    strs_push(l, "    CHECK(\"platform\", clGetPlatformIDs(1, &p, NULL));\n")
    strs_push(l, "    cl_device_id d;\n")
    strs_push(l, "    CHECK(\"device\", clGetDeviceIDs(p, CL_DEVICE_TYPE_GPU, 1, &d, NULL));\n")
    strs_push(l, "    char name[256] = {0}, driver[256] = {0}, version[256] = {0};\n")
    strs_push(l, "    clGetDeviceInfo(d, CL_DEVICE_NAME, sizeof name - 1, name, NULL);\n")
    strs_push(l, "    clGetDeviceInfo(d, CL_DRIVER_VERSION, sizeof driver - 1, driver, NULL);\n")
    strs_push(l, "    clGetDeviceInfo(d, CL_DEVICE_VERSION, sizeof version - 1, version, NULL);\n")
    strs_push(l, "#ifdef NZ_FP64\n")
    strs_push(l, "    // A Float64 kernel needs the device's double precision (Gate 3): refused, by name, without it.\n")
    strs_push(l, "    char extensions[8192] = {0};\n")
    strs_push(l, "    clGetDeviceInfo(d, CL_DEVICE_EXTENSIONS, sizeof extensions - 1, extensions, NULL);\n")
    strs_push(l, "    if (!strstr(extensions, \"cl_khr_fp64\")) {\n")
    strs_push(l, "        printf(\"{\\\"error\\\":\\\"no fp64\\\",\\\"device\\\":\\\"%s\\\"}\\n\", name);\n")
    strs_push(l, "        return 5;\n")
    strs_push(l, "    }\n")
    strs_push(l, "#endif\n")
    strs_push(l, "    cl_context c = clCreateContext(NULL, 1, &d, NULL, NULL, &e);\n")
    strs_push(l, "    CHECK(\"context\", e);\n")
    strs_push(l, "    cl_command_queue q = clCreateCommandQueue(c, d, 0, &e);\n")
    strs_push(l, "    CHECK(\"queue\", e);\n")
    strs_push(l, "\n")
    strs_push(l, "    double t0 = now_ms();\n")
    strs_push(l, "    const char *s = src;\n")
    strs_push(l, "    cl_program pr = clCreateProgramWithSource(c, 1, &s, &src_len, &e);\n")
    strs_push(l, "    CHECK(\"program\", e);\n")
    strs_push(l, "#ifdef NZ_FLOAT\n")
    strs_push(l, "    // Division and square root correctly rounded, as the language's are (Gate 3).\n")
    strs_push(l, "    e = clBuildProgram(pr, 1, &d, \"-cl-fp32-correctly-rounded-divide-sqrt\", NULL, NULL);\n")
    strs_push(l, "#else\n")
    strs_push(l, "    e = clBuildProgram(pr, 1, &d, \"\", NULL, NULL);\n")
    strs_push(l, "#endif\n")
    strs_push(l, "    if (e != CL_SUCCESS) {\n")
    strs_push(l, "        char log[8192] = {0};\n")
    strs_push(l, "        clGetProgramBuildInfo(pr, d, CL_PROGRAM_BUILD_LOG, sizeof log - 1, log, NULL);\n")
    strs_push(l, "        fprintf(stderr, \"%s\\n\", log);\n")
    strs_push(l, "        CHECK(\"build\", e);\n")
    strs_push(l, "    }\n")
    strs_push(l, "    cl_kernel k = clCreateKernel(pr, \"nz_kernel\", &e);\n")
    strs_push(l, "    CHECK(\"kernel\", e);\n")
    strs_push(l, "    double t1 = now_ms();\n")
    strs_push(l, "\n")
    strs_push(l, "    int fail = 0x7fffffff;\n")
    strs_push(l, "    cl_mem bin = clCreateBuffer(c, CL_MEM_READ_ONLY, n * NZ_SIZE + 8, NULL, &e);\n")
    strs_push(l, "    CHECK(\"input buffer\", e);\n")
    strs_push(l, "    cl_mem bin2 = NULL;\n")
    strs_push(l, "    if (zip) {\n")
    strs_push(l, "        bin2 = clCreateBuffer(c, CL_MEM_READ_ONLY, n * NZ_SIZE + 8, NULL, &e);\n")
    strs_push(l, "        CHECK(\"second input buffer\", e);\n")
    strs_push(l, "    }\n")
    strs_push(l, "    cl_mem bout = clCreateBuffer(c, CL_MEM_WRITE_ONLY, n * NZ_SIZE + 8, NULL, &e);\n")
    strs_push(l, "    CHECK(\"output buffer\", e);\n")
    strs_push(l, "    cl_mem bfail = clCreateBuffer(c, CL_MEM_READ_WRITE, 4, NULL, &e);\n")
    strs_push(l, "    CHECK(\"failure buffer\", e);\n")
    strs_push(l, "    // Host to device: the input and the failure word, then a synchronisation.\n")
    strs_push(l, "    CHECK(\"write input\", clEnqueueWriteBuffer(q, bin, CL_TRUE, 0, n * NZ_SIZE, in, 0, NULL, NULL));\n")
    strs_push(l, "    if (zip) CHECK(\"write second input\", clEnqueueWriteBuffer(q, bin2, CL_TRUE, 0, n * NZ_SIZE, in2, 0, NULL, NULL));\n")
    strs_push(l, "    CHECK(\"write failure\", clEnqueueWriteBuffer(q, bfail, CL_TRUE, 0, 4, &fail, 0, NULL, NULL));\n")
    strs_push(l, "    double t2 = now_ms();\n")
    strs_push(l, "    cl_uint a = 0;\n")
    strs_push(l, "    CHECK(\"arg input\", clSetKernelArg(k, a++, sizeof bin, &bin));\n")
    strs_push(l, "    if (zip) CHECK(\"arg second input\", clSetKernelArg(k, a++, sizeof bin2, &bin2));\n")
    strs_push(l, "    CHECK(\"arg output\", clSetKernelArg(k, a++, sizeof bout, &bout));\n")
    strs_push(l, "    CHECK(\"arg failure\", clSetKernelArg(k, a++, sizeof bfail, &bfail));\n")
    strs_push(l, "    if (n > 0) CHECK(\"launch\", clEnqueueNDRangeKernel(q, k, 1, NULL, &n, NULL, 0, NULL, NULL));\n")
    strs_push(l, "    // The one synchronisation point: every work item has finished before anything is read.\n")
    strs_push(l, "    CHECK(\"finish\", clFinish(q));\n")
    strs_push(l, "    double t3 = now_ms();\n")
    strs_push(l, "    char *out = malloc(n * NZ_SIZE + 8);\n")
    strs_push(l, "    // Device to host: the failure word, then the results.\n")
    strs_push(l, "    CHECK(\"read failure\", clEnqueueReadBuffer(q, bfail, CL_TRUE, 0, 4, &fail, 0, NULL, NULL));\n")
    strs_push(l, "    CHECK(\"read output\", clEnqueueReadBuffer(q, bout, CL_TRUE, 0, n * NZ_SIZE, out, 0, NULL, NULL));\n")
    strs_push(l, "    double t4 = now_ms();\n")
    strs_push(l, "    FILE *o = fopen(argv[2], \"wb\");\n")
    strs_push(l, "    if (!o || fwrite(out, NZ_SIZE, n, o) != n) { printf(\"{\\\"error\\\":\\\"unwritable output\\\"}\\n\"); return 3; }\n")
    strs_push(l, "    fclose(o);\n")
    strs_push(l, "    printf(\"{\\\"device\\\":\\\"%s\\\",\\\"driver\\\":\\\"%s\\\",\\\"version\\\":\\\"%s\\\",\\\"elements\\\":%zu,\"\n")
    strs_push(l, "           \"\\\"to_device_bytes\\\":%zu,\\\"from_device_bytes\\\":%zu,\"\n")
    strs_push(l, "           \"\\\"build_ms\\\":%.3f,\\\"to_device_ms\\\":%.3f,\\\"run_ms\\\":%.3f,\\\"from_device_ms\\\":%.3f,\\\"fail\\\":%d}\\n\",\n")
    strs_push(l, "           name, driver, version, n, n * NZ_SIZE * (zip ? 2 : 1) + 4, n * NZ_SIZE + 4, t1 - t0, t2 - t1, t3 - t2, t4 - t3, fail);\n")
    strs_push(l, "    return 0;\n")
    strs_push(l, "}\n")
    str_join(l, "")
}

pub fn ac_cpu_source() -> Str {
    let l = strs_new()
    strs_push(l, "// Written by nazm accel (Gate 3, docs/user/spec.md, *Providers*): the CPU provider. The kernel's one\n")
    strs_push(l, "// source text — the OpenCL C a device builds — compiled here as C, after a prelude that gives\n")
    strs_push(l, "// OpenCL's few words their C meaning, and its element function `nz_item` run over every element\n")
    strs_push(l, "// by a pool of threads, one per core, each taking a contiguous share.\n")
    strs_push(l, "// argv: kernel.cl output.bin input.bin [input2.bin]; built with NZ_T, the element's C type, and\n")
    strs_push(l, "// NZ_ZIP for a kernel of two.\n")
    strs_push(l, "// One line of JSON on stdout says what happened, in the OpenCL host's words where they apply.\n")
    strs_push(l, "#include <math.h>\n")
    strs_push(l, "#include <pthread.h>\n")
    strs_push(l, "#include <stddef.h>\n")
    strs_push(l, "#include <stdint.h>\n")
    strs_push(l, "#include <stdio.h>\n")
    strs_push(l, "#include <stdlib.h>\n")
    strs_push(l, "#include <string.h>\n")
    strs_push(l, "#include <time.h>\n")
    strs_push(l, "#include <unistd.h>\n")
    strs_push(l, "#ifdef _WIN32\n")
    strs_push(l, "#include <windows.h>\n")
    strs_push(l, "// OpenCL's `long` is 64 bits, and so is every kernel's `long` and `ulong`; Windows's C `long` is\n")
    strs_push(l, "// 32 (LLP64). Past the system headers, which want their own `long`, the word is `long long`.\n")
    strs_push(l, "#define long long long\n")
    strs_push(l, "#endif\n")
    strs_push(l, "\n")
    strs_push(l, "// OpenCL's words, in C. `long` is 64 bits on every host the CPU provider runs on (LP64), and on\n")
    strs_push(l, "// Windows through the definition above.\n")
    strs_push(l, "#define __kernel static\n")
    strs_push(l, "#define __global\n")
    strs_push(l, "#define __private\n")
    strs_push(l, "#define get_global_id(d) ((size_t)0)\n")
    strs_push(l, "typedef unsigned long ulong;\n")
    strs_push(l, "static inline int atomic_min(volatile int *p, int v) {\n")
    strs_push(l, "    return __atomic_fetch_min(p, v, __ATOMIC_SEQ_CST);\n")
    strs_push(l, "}\n")
    strs_push(l, "static inline long mul_hi(long a, long b) {\n")
    strs_push(l, "    return (long)(((__int128)a * (__int128)b) >> 64);\n")
    strs_push(l, "}\n")
    strs_push(l, "static inline float as_float(unsigned int b) {\n")
    strs_push(l, "    float f;\n")
    strs_push(l, "    memcpy(&f, &b, 4);\n")
    strs_push(l, "    return f;\n")
    strs_push(l, "}\n")
    strs_push(l, "static inline double as_double(unsigned long b) {\n")
    strs_push(l, "    double d;\n")
    strs_push(l, "    memcpy(&d, &b, 8);\n")
    strs_push(l, "    return d;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "#include \"kernel.cl\"\n")
    strs_push(l, "\n")
    strs_push(l, "static double now_ms(void) {\n")
    strs_push(l, "    struct timespec t;\n")
    strs_push(l, "    clock_gettime(CLOCK_MONOTONIC, &t);\n")
    strs_push(l, "    return (double)t.tv_sec * 1e3 + (double)t.tv_nsec / 1e6;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "static char *slurp(const char *path, size_t *len) {\n")
    strs_push(l, "    FILE *f = fopen(path, \"rb\");\n")
    strs_push(l, "    if (!f) return NULL;\n")
    strs_push(l, "    fseek(f, 0, SEEK_END);\n")
    strs_push(l, "    long n = ftell(f);\n")
    strs_push(l, "    fseek(f, 0, SEEK_SET);\n")
    strs_push(l, "    char *b = malloc((size_t)n + 1);\n")
    strs_push(l, "    if (!b || fread(b, 1, (size_t)n, f) != (size_t)n) { fclose(f); return NULL; }\n")
    strs_push(l, "    b[n] = 0;\n")
    strs_push(l, "    fclose(f);\n")
    strs_push(l, "    *len = (size_t)n;\n")
    strs_push(l, "    return b;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "static const NZ_T *in1, *in2;\n")
    strs_push(l, "static NZ_T *out;\n")
    strs_push(l, "static int fail = 0x7fffffff;\n")
    strs_push(l, "\n")
    strs_push(l, "struct share { size_t lo, hi; };\n")
    strs_push(l, "\n")
    strs_push(l, "// One thread's share, in index order; the element function inlined into the loop, which LLVM's\n")
    strs_push(l, "// vectoriser may turn into SIMD lanes.\n")
    strs_push(l, "static void *work(void *arg) {\n")
    strs_push(l, "    struct share *s = arg;\n")
    strs_push(l, "#ifdef NZ_ZIP\n")
    strs_push(l, "    for (size_t i = s->lo; i < s->hi; i++) out[i] = nz_item(in1[i], in2[i], &fail, i);\n")
    strs_push(l, "#else\n")
    strs_push(l, "    for (size_t i = s->lo; i < s->hi; i++) out[i] = nz_item(in1[i], &fail, i);\n")
    strs_push(l, "#endif\n")
    strs_push(l, "    return NULL;\n")
    strs_push(l, "}\n")
    strs_push(l, "\n")
    strs_push(l, "int main(int argc, char **argv) {\n")
    strs_push(l, "    if (argc != 4 && argc != 5) return 4;\n")
    strs_push(l, "    size_t in_len, in2_len = 0;\n")
    strs_push(l, "    in1 = (const NZ_T *)slurp(argv[3], &in_len);\n")
    strs_push(l, "    in2 = argc == 5 ? (const NZ_T *)slurp(argv[4], &in2_len) : NULL;\n")
    strs_push(l, "    if (!in1 || (argc == 5 && (!in2 || in2_len != in_len))) { printf(\"{\\\"error\\\":\\\"unreadable input\\\"}\\n\"); return 3; }\n")
    strs_push(l, "    size_t n = in_len / sizeof(NZ_T);\n")
    strs_push(l, "    out = malloc(n * sizeof(NZ_T) + 8);\n")
    strs_push(l, "#ifdef _WIN32\n")
    strs_push(l, "    SYSTEM_INFO si;\n")
    strs_push(l, "    GetSystemInfo(&si);\n")
    strs_push(l, "    long cores = (long)si.dwNumberOfProcessors;\n")
    strs_push(l, "#else\n")
    strs_push(l, "    long cores = sysconf(_SC_NPROCESSORS_ONLN);\n")
    strs_push(l, "#endif\n")
    strs_push(l, "    size_t threads = cores > 0 ? (size_t)cores : 1;\n")
    strs_push(l, "    if (threads > n) threads = n > 0 ? n : 1;\n")
    strs_push(l, "    pthread_t pool[256];\n")
    strs_push(l, "    struct share shares[256];\n")
    strs_push(l, "    if (threads > 256) threads = 256;\n")
    strs_push(l, "    double t0 = now_ms();\n")
    strs_push(l, "    for (size_t k = 0; k < threads; k++) {\n")
    strs_push(l, "        shares[k].lo = n * k / threads;\n")
    strs_push(l, "        shares[k].hi = n * (k + 1) / threads;\n")
    strs_push(l, "        if (pthread_create(&pool[k], NULL, work, &shares[k]) != 0) { printf(\"{\\\"error\\\":\\\"thread\\\"}\\n\"); return 3; }\n")
    strs_push(l, "    }\n")
    strs_push(l, "    // The one synchronisation: every share has finished before anything is read.\n")
    strs_push(l, "    for (size_t k = 0; k < threads; k++) pthread_join(pool[k], NULL);\n")
    strs_push(l, "    double t1 = now_ms();\n")
    strs_push(l, "    FILE *o = fopen(argv[2], \"wb\");\n")
    strs_push(l, "    if (!o || fwrite(out, sizeof(NZ_T), n, o) != n) { printf(\"{\\\"error\\\":\\\"unwritable output\\\"}\\n\"); return 3; }\n")
    strs_push(l, "    fclose(o);\n")
    strs_push(l, "    printf(\"{\\\"device\\\":\\\"the host's CPU, %zu threads\\\",\\\"driver\\\":\\\"%s\\\",\\\"version\\\":\\\"C, %s\\\",\"\n")
    strs_push(l, "           \"\\\"elements\\\":%zu,\\\"threads\\\":%zu,\\\"run_ms\\\":%.3f,\\\"fail\\\":%d}\\n\",\n")
    strs_push(l, "           threads, __VERSION__, NZ_VECTORISED, n, threads, t1 - t0, fail);\n")
    strs_push(l, "    return 0;\n")
    strs_push(l, "}\n")
    str_join(l, "")
}
