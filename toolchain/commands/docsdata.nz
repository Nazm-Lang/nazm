    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G99 — Final AI-Era Principle")
    strs_push(l, "")
    strs_push(l, "Future software engineering may increasingly shift from:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "human writes every line")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "toward:")
    strs_push(l, "")
    strs_push(l, "```text")
