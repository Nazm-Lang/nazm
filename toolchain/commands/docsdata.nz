    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 37. Explicit Non-Goals")
    strs_push(l, "")
    strs_push(l, "Nazm is NOT trying to:")
    strs_push(l, "")
    strs_push(l, "- copy every language feature;")
    strs_push(l, "- win every microbenchmark;")
    strs_push(l, "- eliminate every software bug;")
    strs_push(l, "- automatically parallelize every algorithm;")
    strs_push(l, "- remove all unsafe code from systems programming;")
    strs_push(l, "- replace every language immediately;")
    strs_push(l, "- make one runtime appropriate for every domain;")
    strs_push(l, "- make AI the correctness authority;")
    strs_push(l, "- certify software merely by compiling it;")
    strs_push(l, "- hide hardware when hardware matters;")
    strs_push(l, "- expose hardware complexity when it does not matter;")
    strs_push(l, "- optimize permanent syntax for one temporary tokenizer;")
    strs_push(l, "- minimize token count at the cost of human comprehension;")
    strs_push(l, "- turn blockchain concepts into mandatory semantics for ordinary programs;")
    strs_push(l, "- promise identical runtime libraries across native, embedded, WASM and Web3 targets;")
    strs_push(l, "- hide gas/compute/storage cost behind \"automatic\" abstractions when a profile meters them;")
    strs_push(l, "- claim smart-contract correctness merely because code compiled or passed static analysis;")
    strs_push(l, "- chase every blockchain VM or chain at the cost of semantic coherence.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 38. Anti-Bloat Constitution")
    strs_push(l, "")
    strs_push(l, "Before language expansion, prefer:")
