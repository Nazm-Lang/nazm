    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.6 Ada / SPARK — The High-Assurance Barrier")
    strs_push(l, "")
    strs_push(l, "### What this solved")
    strs_push(l, "")
    strs_push(l, "For critical systems, ordinary testing is insufficient.")
    strs_push(l, "")
    strs_push(l, "Developers may need evidence concerning:")
