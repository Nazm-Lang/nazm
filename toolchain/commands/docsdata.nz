    strs_push(l, "")
    strs_push(l, "**words**")
    strs_push(l, "")
    strs_push(l, "| language | variant | LOC | run median (ms) | run min–max (ms) | peak RSS (KiB) | binary (KiB) | build median (ms) |")
    strs_push(l, "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |")
    strs_push(l, "| Nazm | nazm build --opt-level 2 | 19 | 188.0 | 187.1–190.0 | 19696 | 103 | 1097 |")
    strs_push(l, "| Nazm | nazm run (interpreter) | 19 | 25868.2 | 25742.9–25901.6 | 35312 | — | — |")
    strs_push(l, "| C | clang -O2 | 41 | 73.9 | 73.6–74.2 | 15648 | 33 | 78 |")
