    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "before adding new fundamental syntax.")
    strs_push(l, "")
    strs_push(l, "New syntax is the most expensive option.")
    strs_push(l, "")
    strs_push(l, "Syntax survives for decades.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 39. The \"One Language Everywhere\" Interpretation")
