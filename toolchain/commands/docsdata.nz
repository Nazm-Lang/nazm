    strs_push(l, "`diagnostics` suite joined the `cli`, `semantics` and `checker` profiles. N13's use-after-free")
    strs_push(l, "survivor and the `nesting-unbounded` MUTANT CRASH were not re-run and are as they were.")
    strs_push(l, "")
    strs_push(l, "*N31 (2026-09-28) added fifteen,* on the frozen final source. Every killer of the fifteen, of the")
    strs_push(l, "sixteen N30 entries in `crates/nazm-service/src/diagnostics.rs` (whose canonical order N31 now")
