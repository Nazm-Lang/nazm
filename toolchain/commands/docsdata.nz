    strs_push(l, "Optimize verified task completion, not superficial source compression.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G85 — Token-to-Correctness Efficiency")
    strs_push(l, "")
    strs_push(l, "Nazm should research:")
