    strs_push(l, "| primes, W = 10 | 27.4 ms (6.32×), **#3** of 7, tied with Rust and C within 0.4 ms (Go 26.2) (31.8, 5.46×, #4) | 2.2 MiB, #4 of 7 | | | | | | #2 of 4 |")
