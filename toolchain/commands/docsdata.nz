    strs_push(l, "- generate tests;")
    strs_push(l, "- propose changes;")
    strs_push(l, "- investigate failures;")
    strs_push(l, "- produce patches;")
    strs_push(l, "- suggest optimizations.")
    strs_push(l, "")
    strs_push(l, "But verification authority remains deterministic tooling.")
    strs_push(l, "")
    strs_push(l, "Architecture:")
    strs_push(l, "")
    strs_push(l, "```text")
