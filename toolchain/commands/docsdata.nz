    strs_push(l, "The first AI-facing semantic unit. `nazm.context/1` is one function's, record's or enum's exact")
    strs_push(l, "source and compact links — identity, kind, name, place — to what it uses, the types it names, what")
    strs_push(l, "uses it, what it calls and what calls it, and its own diagnostics, all read from the layers that")
    strs_push(l, "already answer them; effects, capabilities, tests and semantic changes are marked unsupported.")
    strs_push(l, "Durable identities, source-root-relative paths, one deterministic serialisation. `nazm context`")
    strs_push(l, "prints it, and `nazm-mcp`, on the official Rust SDK, serves it as one read-only stdio tool that")
    strs_push(l, "reads the disk at every call. No language, interface, cache-key or bootstrap change:")
    strs_push(l, "`SEMANTIC_EPOCH` 7, `nazm.interface/5`, fixpoint `0e1a40e6…`; one new machine schema.")
    strs_push(l, "")
    strs_push(l, "| Settled | Where |")
    strs_push(l, "| --- | --- |")
    strs_push(l, "| the packet, `nazm.context/1`, from N17/N18/N20/N21/N22/N25 | `crates/nazm-service/src/context.rs`, `schema/nazm.context-3.json`, `architecture.md` §7.29 |")
    strs_push(l, "| `nazm context --root --file --byte --json` | `crates/nazm-cli/src/context.rs` |")
    strs_push(l, "| `nazm-mcp`: one read-only stdio tool, disk per call, no other file readable | `crates/nazm-mcp/src/main.rs`, `docs/user/mcp.md` |")
    strs_push(l, "| what it costs | `performance.md` |")
    strs_push(l, "")
    strs_push(l, "Mutation evidence: 13 new mutations, every killer verified; one targeted campaign of 24")
