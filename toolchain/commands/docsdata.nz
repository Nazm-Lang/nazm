    strs_push(l, "debug information")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Compiler input is adversarial input.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G47 — Differential Testing")
    strs_push(l, "")
    strs_push(l, "Where two implementations exist:")
