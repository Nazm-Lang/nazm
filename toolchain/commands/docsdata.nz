    strs_push(l, "Separating pure computation from effects provides enormous reasoning power.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Nazm does not need to become purely functional.")
    strs_push(l, "")
    strs_push(l, "But effects should become visible enough that the compiler can reason about them.")
    strs_push(l, "")
    strs_push(l, "Possible effects include:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "io")
    strs_push(l, "alloc")
    strs_push(l, "panic")
    strs_push(l, "spawn")
    strs_push(l, "block")
    strs_push(l, "network")
    strs_push(l, "filesystem")
    strs_push(l, "clock")
    strs_push(l, "random")
    strs_push(l, "ffi")
    strs_push(l, "unsafe")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The compiler should increasingly answer:")
    strs_push(l, "")
    strs_push(l, "> What can this function do beyond transforming its inputs?")
    strs_push(l, "")
    strs_push(l, "That information benefits:")
    strs_push(l, "")
    strs_push(l, "- humans;")
    strs_push(l, "- optimizers;")
    strs_push(l, "- security;")
    strs_push(l, "- critical systems;")
    strs_push(l, "- AI agents;")
    strs_push(l, "- testing.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.9 Java — The Portability, Robustness and Managed Runtime Barrier")
    strs_push(l, "")
    strs_push(l, "### What Java solved")
    strs_push(l, "")
    strs_push(l, "- portable binary representation;")
    strs_push(l, "- managed memory;")
    strs_push(l, "- removal of pointer arithmetic;")
    strs_push(l, "- runtime verification;")
    strs_push(l, "- large portable standard platform;")
    strs_push(l, "- multithreading support;")
    strs_push(l, "- safer application programming.")
    strs_push(l, "")
    strs_push(l, "### Trade-off")
    strs_push(l, "")
    strs_push(l, "Its traditional model depends heavily on:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "VM")
    strs_push(l, "managed runtime")
    strs_push(l, "garbage collector")
    strs_push(l, "runtime metadata")
    strs_push(l, "JIT or bytecode execution")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "These are excellent trade-offs for many applications, but inappropriate for some:")
    strs_push(l, "")
    strs_push(l, "- tiny embedded systems;")
    strs_push(l, "- kernels;")
    strs_push(l, "- hard real-time environments;")
    strs_push(l, "- extremely predictable latency requirements;")
    strs_push(l, "- certain native interoperability scenarios.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Portability must not require a mandatory VM.")
    strs_push(l, "")
    strs_push(l, "Nazm's portability model should primarily be:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "portable semantics")
    strs_push(l, "+")
    strs_push(l, "portable source/Core IR")
    strs_push(l, "+")
    strs_push(l, "target-specific native generation")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "A VM or JIT may exist as an optional execution tier.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.10 Python — The Human Productivity Barrier")
    strs_push(l, "")
    strs_push(l, "### What Python demonstrated")
    strs_push(l, "")
    strs_push(l, "Human time is often more expensive than machine time.")
    strs_push(l, "")
    strs_push(l, "A powerful language should minimize:")
    strs_push(l, "")
    strs_push(l, "- ceremony;")
    strs_push(l, "- visual noise;")
    strs_push(l, "- unnecessary declarations;")
    strs_push(l, "- boilerplate;")
    strs_push(l, "- incidental complexity.")
    strs_push(l, "")
    strs_push(l, "### Barrier remaining for systems work")
    strs_push(l, "")
    strs_push(l, "A highly dynamic runtime makes many low-level properties harder to guarantee statically:")
    strs_push(l, "")
    strs_push(l, "- exact representation;")
    strs_push(l, "- predictable allocation;")
    strs_push(l, "- native performance without specialization;")
    strs_push(l, "- static resource bounds;")
    strs_push(l, "- bare-metal execution.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Nazm must treat readability and development speed as first-class performance metrics.")
    strs_push(l, "")
    strs_push(l, "The language should pursue:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Python-like cognitive accessibility")
    strs_push(l, "without requiring Python-like runtime semantics.")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Readable syntax is not cosmetic.")
    strs_push(l, "")
    strs_push(l, "It is part of reliability.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.11 Go — The Large-Software and Concurrency Complexity Barrier")
    strs_push(l, "")
    strs_push(l, "### What Go solved particularly well")
    strs_push(l, "")
    strs_push(l, "- simple syntax;")
    strs_push(l, "- fast builds;")
    strs_push(l, "- explicit package dependencies;")
    strs_push(l, "- strong tooling;")
    strs_push(l, "- easy deployment;")
    strs_push(l, "- goroutines;")
    strs_push(l, "- channels;")
    strs_push(l, "- pragmatic server programming;")
    strs_push(l, "- standardized formatting.")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "Developer throughput is a language-design concern.")
    strs_push(l, "")
    strs_push(l, "A compiler that generates excellent code but takes excessive time or requires complex build orchestration has failed one dimension of performance.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Treat:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "compile time")
    strs_push(l, "incremental check time")
    strs_push(l, "tool startup")
    strs_push(l, "dependency resolution")
    strs_push(l, "diagnostics latency")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "as language-product performance.")
    strs_push(l, "")
    strs_push(l, "Concurrency must also be easier than raw threads.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.12 Rust — The Memory-Safety-without-GC Barrier")
    strs_push(l, "")
    strs_push(l, "### What Rust changed")
    strs_push(l, "")
    strs_push(l, "Rust demonstrated that many failures traditionally accepted as unavoidable in systems programming can be prevented statically.")
    strs_push(l, "")
    strs_push(l, "Examples include large classes of:")
    strs_push(l, "")
    strs_push(l, "- use-after-free;")
    strs_push(l, "- double free;")
    strs_push(l, "- invalid references;")
    strs_push(l, "- unsafe aliasing;")
    strs_push(l, "- data races.")
    strs_push(l, "")
    strs_push(l, "### Trade-off")
    strs_push(l, "")
    strs_push(l, "Exposing ownership and lifetime reasoning directly to programmers can introduce cognitive and type-system complexity.")
    strs_push(l, "")
    strs_push(l, "### Nazm research goal")
    strs_push(l, "")
    strs_push(l, "Investigate whether Nazm can retain similar safety power while making common ownership patterns more implicit or value-oriented.")
    strs_push(l, "")
    strs_push(l, "Potential direction:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "observe")
    strs_push(l, "exclusive mutation")
    strs_push(l, "move/consume")
    strs_push(l, "initialize")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "with richer compiler-internal region reasoning.")
    strs_push(l, "")
    strs_push(l, "The objective is not:")
    strs_push(l, "")
    strs_push(l, "> hide ownership until something breaks.")
    strs_push(l, "")
    strs_push(l, "The objective is:")
    strs_push(l, "")
    strs_push(l, "> make safe ownership correspond naturally to programmer intent.")
    strs_push(l, "")
    strs_push(l, "This remains a research problem until demonstrated.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.13 Zig — The Hidden-Cost and Toolchain Barrier")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "Performance problems frequently originate from invisible behaviour.")
    strs_push(l, "")
    strs_push(l, "A developer should be able to determine whether code may:")
    strs_push(l, "")
    strs_push(l, "- allocate;")
    strs_push(l, "- block;")
    strs_push(l, "- perform I/O;")
    strs_push(l, "- panic;")
    strs_push(l, "- synchronize;")
    strs_push(l, "- call foreign code;")
    strs_push(l, "- spawn work.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Nazm should pursue **semantic cost transparency**.")
    strs_push(l, "")
    strs_push(l, "This does not necessarily mean banning all abstraction.")
    strs_push(l, "")
    strs_push(l, "Instead, high-level syntax should lower to behaviour that compiler tooling can expose precisely.")
    strs_push(l, "")
    strs_push(l, "Example tooling:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "nazm explain-cost foo")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "could eventually report:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "allocations: 2 potential / 1 survives optimization")
    strs_push(l, "blocking: none")
    strs_push(l, "spawn: 4 tasks")
    strs_push(l, "dynamic dispatch: none")
    strs_push(l, "bounds checks: 3")
    strs_push(l, "copies: 1 surviving")
    strs_push(l, "FFI: none")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.14 CUDA — The Heterogeneous Parallelism Barrier")
    strs_push(l, "")
    strs_push(l, "### What CUDA solved")
    strs_push(l, "")
    strs_push(l, "CPU-centric language models do not naturally expose thousands of parallel execution lanes.")
    strs_push(l, "")
    strs_push(l, "### New complexity")
    strs_push(l, "")
    strs_push(l, "Heterogeneous computing introduces:")
    strs_push(l, "")
    strs_push(l, "- host/device memory;")
    strs_push(l, "- data transfer;")
    strs_push(l, "- kernels;")
    strs_push(l, "- synchronization;")
    strs_push(l, "- occupancy;")
    strs_push(l, "- divergent execution;")
    strs_push(l, "- memory hierarchy;")
    strs_push(l, "- architecture-specific optimization.")
    strs_push(l, "")
    strs_push(l, "### Nazm long-term goal")
    strs_push(l, "")
    strs_push(l, "Nazm should eventually support heterogeneous computation without splitting applications into unrelated programming languages.")
    strs_push(l, "")
    strs_push(l, "Potential conceptual direction:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "ordinary Nazm function")
    strs_push(l, "        ↓")
    strs_push(l, "compiler determines/accepts execution constraints")
    strs_push(l, "        ↓")
    strs_push(l, "CPU / SIMD / GPU / accelerator specialization")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This is a long-term research goal.")
    strs_push(l, "")
    strs_push(l, "The compiler must not pretend arbitrary code can automatically become efficient GPU code.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.15 Julia — The Two-Language Performance Barrier")
    strs_push(l, "")
    strs_push(l, "### Historical barrier")
    strs_push(l, "")
    strs_push(l, "Scientific developers often prototype in one language and rewrite performance-critical portions in another.")
    strs_push(l, "")
    strs_push(l, "That creates:")
    strs_push(l, "")
    strs_push(l, "- duplicated code;")
    strs_push(l, "- foreign interfaces;")
    strs_push(l, "- maintenance burden;")
    strs_push(l, "- optimization barriers;")
    strs_push(l, "- split expertise.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Avoid a compulsory two-language architecture.")
    strs_push(l, "")
    strs_push(l, "The code that expresses the algorithm should, where feasible, be the code that becomes the optimized implementation.")
    strs_push(l, "")
    strs_push(l, "This requires:")
    strs_push(l, "")
    strs_push(l, "- specialization;")
    strs_push(l, "- strong IR;")
    strs_push(l, "- escape analysis;")
    strs_push(l, "- vectorization;")
    strs_push(l, "- layout optimization;")
    strs_push(l, "- accelerator lowering.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.16 Swift — The Safe-Native-Ergonomics Barrier")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "Native languages do not need to present unsafe or highly technical syntax for ordinary application development.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Use progressive disclosure.")
    strs_push(l, "")
    strs_push(l, "Simple programs should look simple.")
    strs_push(l, "")
    strs_push(l, "Low-level complexity should become visible only when the programmer needs low-level control.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.17 Kotlin — The Adoption and Pragmatism Barrier")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "A technically superior language can fail if adoption requires rewriting the world.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Interoperability is part of language strategy.")
    strs_push(l, "")
    strs_push(l, "Nazm should eventually interoperate strongly with existing systems rather than demanding complete rewrites.")
    strs_push(l, "")
    strs_push(l, "Primary interoperability priorities should likely include:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "C ABI")
    strs_push(l, "native static/shared libraries")
    strs_push(l, "system libraries")
    strs_push(l, "LLVM ecosystem")
    strs_push(l, "existing OS APIs")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Higher-level ecosystem bridges may follow.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.18 ML / OCaml — The Typed-Abstraction and Compiler-Construction Barrier")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "Algebraic data types, exhaustive pattern matching, local type inference and compositional modules can make complex symbolic programs concise without surrendering static reasoning.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "User-defined product and sum types should be first-class, and pattern matching should make state machines, compilers, protocols and error handling explicit rather than encoding them through integer tags and parallel arrays.")
    strs_push(l, "")
    strs_push(l, "The lesson is semantic compression, not a mandate to reproduce the entire ML module/type system.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.19 TypeScript — The Large Dynamic-Ecosystem Tooling Barrier")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "A language can add powerful static tooling to a large existing ecosystem without requiring every boundary to become statically pure. Structural typing, editor services and gradual adoption show that tooling quality can drive language adoption.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Nazm should make semantic tooling, language-server services, migration and interoperability first-class, while avoiding a type system whose complexity exists mainly to model unrestricted dynamic-language patterns Nazm does not have.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.20 WebAssembly — The Portable Sandboxed Execution Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "Native machine code is efficient but tied to target ABIs and host authority. Browser and plugin environments require portable, sandbox-friendly execution with explicit host integration.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Portability should not require one heavyweight VM, and sandboxing should not require a separate source language.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "WebAssembly should become a first-class compilation target where the language subset and host capabilities are explicit. The same semantic source should be usable for browser, server, plugin and contract-oriented WASM environments where their host APIs permit it.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.21 Solidity / EVM — The Deterministic Smart-Contract Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "On-chain programs run under consensus. Ordinary assumptions about filesystem access, wall clock, networking, unrestricted loops and unmetered computation do not hold. Persistent state, external calls, ABI compatibility and resource cost become part of correctness.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "A smart-contract language is not merely a normal language with a different code generator. Determinism, persistent state, external-call boundaries, storage layout and resource metering must be visible to the compiler.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "A future Web3 profile should permit EVM-oriented smart contracts without making EVM-specific semantics part of General Nazm. ABI, storage and event artefacts should be generated from typed semantic definitions rather than duplicated handwritten descriptions.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.22 Move — The Digital-Asset Resource-Safety Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "Ordinary copy/discard semantics are dangerous for scarce digital assets. A token, capability or ownership resource may need to be impossible to duplicate or silently destroy.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Some values represent **resources**, not ordinary freely copyable data. Asset conservation is a type/resource-semantics problem, not merely a library convention.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Nazm should research an asset/resource kind that composes with its broader ownership constitution and can express “cannot duplicate”, “cannot silently discard”, “must transfer/store/explicitly consume”, without forcing resource semantics onto ordinary values.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.23 Solana / Account-Oriented On-Chain Execution — The High-Throughput State-Access Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "Some decentralized runtimes separate executable program code from mutable account/state objects and require programs to declare or receive the state they may access. Throughput depends on making access sets and resource budgets explicit enough for the runtime to schedule safely.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Explicit state authority can improve both security and parallel execution. A compiler that understands signer, writable/read-only state and cross-program call boundaries can reject mistakes before deployment.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "A future Web3 profile should be able to target account-oriented VMs such as sBPF/SVM-style environments through typed state and capability adapters, while keeping the source-language semantics chain-neutral where possible.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.24 Decentralized Systems — The Consensus and Ambient-Nondeterminism Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "A normal program can consult ambient time, randomness, filesystem state, process environment or the network. A consensus-executed program cannot permit each validator to observe a different world.")
    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Determinism is not merely a testing preference in decentralized systems. It is a correctness condition.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Effects and capabilities should eventually allow the compiler to prove that a contract profile has no undeclared nondeterministic authority. Time, randomness, oracle data and external state must arrive through explicit execution-environment capabilities whose semantics are defined by the target profile.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 3. Historical Barrier Compression")
    strs_push(l, "")
    strs_push(l, "The previous history can be reduced to a smaller set of root barriers.")
    strs_push(l, "")
    strs_push(l, "Nazm should attack these roots instead of copying each language.")
    strs_push(l, "")
    strs_push(l, "## B1 — Machine Control vs Portability")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "direct hardware control")
    strs_push(l, "↔")
    strs_push(l, "portable software")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "portable semantics with explicit target-specific escape hatches.")
    strs_push(l, "")
    strs_push(l, "## B2 — Abstraction vs Performance")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "high-level abstraction")
    strs_push(l, "↔")
    strs_push(l, "predictable native execution")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "zero-cost or explainable-cost abstractions.")
    strs_push(l, "")
    strs_push(l, "## B3 — Safety vs Runtime Overhead")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "manual memory")
    strs_push(l, "↔")
    strs_push(l, "managed GC runtime")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "static ownership/resource reasoning with no mandatory tracing GC.")
    strs_push(l, "")
    strs_push(l, "Optional managed allocation models may exist where appropriate.")
    strs_push(l, "")
    strs_push(l, "## B4 — Safety vs Ergonomics")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "strict ownership reasoning")
    strs_push(l, "↔")
    strs_push(l, "easy programming")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "compiler-internal sophistication with a simpler intent-oriented surface model.")
    strs_push(l, "")
    strs_push(l, "## B5 — Concurrency vs Understandability")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "threads/shared memory")
    strs_push(l, "↔")
    strs_push(l, "safe composable concurrency")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "structured tasks + ownership-aware transfer + higher-level messaging.")
    strs_push(l, "")
    strs_push(l, "## B6 — Concurrency Safety vs Fault Tolerance")
    strs_push(l, "")
    strs_push(l, "Preventing a data race does not explain how a service recovers when a component fails.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "combine task safety with explicit failure domains and supervision concepts where appropriate.")
    strs_push(l, "")
    strs_push(l, "## B7 — Productivity vs Execution Speed")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Python-like development")
    strs_push(l, "↔")
    strs_push(l, "C-like execution")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "high-level syntax compiled through strong specialization/optimization.")
    strs_push(l, "")
    strs_push(l, "## B8 — Portability vs Native Optimization")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "portable language semantics with machine-specific optimization chosen late in lowering.")
    strs_push(l, "")
    strs_push(l, "## B9 — CPU Generality vs Accelerator Throughput")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "one language with multiple lowering targets rather than mandatory separate accelerator languages.")
    strs_push(l, "")
    strs_push(l, "## B10 — Generality vs Verifiability")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "profiles and restrictions.")
    strs_push(l, "")
    strs_push(l, "General Nazm can remain expressive.")
    strs_push(l, "")
    strs_push(l, "Critical Nazm can reject constructs that defeat analyzability.")
    strs_push(l, "")
    strs_push(l, "## B11 — Rich Features vs Language Complexity")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "small semantic kernel.")
    strs_push(l, "")
    strs_push(l, "New surface features must preferably desugar into established primitives.")
    strs_push(l, "")
    strs_push(l, "## B12 — Human Readability vs Machine Readability")
    strs_push(l, "")
    strs_push(l, "Traditional source is designed mainly for humans.")
    strs_push(l, "")
    strs_push(l, "AI tools often infer semantics by reading text.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "both humans and machines receive first-class representations of program meaning.")
    strs_push(l, "")
    strs_push(l, "## B13 — Fast Execution vs Fast Development")
    strs_push(l, "")
    strs_push(l, "Nazm must optimize both:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "program runtime")
    strs_push(l, "and")
    strs_push(l, "compiler/developer latency.")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "## B14 — Optimization vs Predictability")
    strs_push(l, "")
    strs_push(l, "Aggressive optimization can make performance surprising.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "optimization observability.")
    strs_push(l, "")
    strs_push(l, "Compiler tooling should explain important transformations and surviving costs.")
    strs_push(l, "")
    strs_push(l, "## B15 — Security vs Ambient Authority")
    strs_push(l, "")
    strs_push(l, "Traditional programs often inherit broad OS authority.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "capability-aware software boundaries.")
    strs_push(l, "")
    strs_push(l, "## B16 — Reliability vs Testing Alone")
    strs_push(l, "")
    strs_push(l, "Testing cannot prove absence of every failure class.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "combine:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "types")
    strs_push(l, "static analysis")
    strs_push(l, "contracts")
    strs_push(l, "property tests")
    strs_push(l, "fuzzing")
    strs_push(l, "mutation testing")
    strs_push(l, "differential testing")
    strs_push(l, "formal verification where justified")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "## B17 — Evolution vs Compatibility")
    strs_push(l, "")
    strs_push(l, "Languages accumulate mistakes.")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "explicit language editions/versioning and migration tooling rather than indefinite semantic ambiguity.")
    strs_push(l, "")
    strs_push(l, "## B18 — Human/AI Intent vs Token Cost")
    strs_push(l, "")
    strs_push(l, "Traditional languages were designed primarily around human typing, compiler parsing and runtime performance.")
    strs_push(l, "")
    strs_push(l, "AI-era development adds a new cost dimension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "context tokens")
    strs_push(l, "generation tokens")
    strs_push(l, "repair tokens")
    strs_push(l, "tool-result tokens")
    strs_push(l, "repository-context tokens")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "maximize verified semantic value per unit of AI context while preserving human readability and compiler precision.")
    strs_push(l, "")
    strs_push(l, "## B19 — General Execution vs Consensus Determinism")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "ambient OS authority")
    strs_push(l, "↔")
    strs_push(l, "identical execution on independent validators")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "profile-controlled deterministic execution where nondeterministic inputs exist only through explicit target capabilities.")
    strs_push(l, "")
    strs_push(l, "## B20 — Ordinary Values vs Scarce Digital Assets")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "copy/discard convenience")
    strs_push(l, "↔")
    strs_push(l, "asset conservation and ownership integrity")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "resource/asset semantics that prevent accidental duplication or loss without infecting every ordinary value with affine restrictions.")
    strs_push(l, "")
    strs_push(l, "## B21 — General Computation vs Metered Computation")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "unbounded local computation")
    strs_push(l, "↔")
    strs_push(l, "consensus-executed gas / compute / storage budgets")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "make resource cost visible enough that profiles may meter, bound or statically reject execution without changing the meaning of ordinary operations.")
    strs_push(l, "")
    strs_push(l, "## B22 — Chain Portability vs Chain-Specific State Models")
    strs_push(l, "")
    strs_push(l, "Historical tension:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "one contract source")
    strs_push(l, "↔")
    strs_push(l, "EVM storage, WASM host APIs, account models, chain-specific ABI")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm goal:")
    strs_push(l, "")
    strs_push(l, "keep core semantics chain-neutral and isolate unavoidable chain semantics behind typed profile capabilities, standard libraries and backend adapters.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 4. Nazm Grand Mission")
    strs_push(l, "")
    strs_push(l, "Nazm aims to become:")
    strs_push(l, "")
    strs_push(l, "> A human-readable, machine-native, AI-native, memory-safe-by-default, concurrency-first, high-performance programming language and compiler platform capable of scaling from ordinary software to systems programming, servers, embedded computing, cybersecurity, AI/HPC, WebAssembly, decentralized/Web3 execution and restricted high-assurance environments while making machine cost, effects, authority, resource use, token cost and correctness evidence unusually visible.")
    strs_push(l, "")
    strs_push(l, "The ambition is **best-in-class by measured dimension**, not “one implementation choice wins every workload.” Native, embedded, critical, WASM and Web3 environments may use different runtimes and backends while preserving one semantic language.")
    strs_push(l, "")
    strs_push(l, "The objective is not merely to run programs.")
    strs_push(l, "")
    strs_push(l, "Nazm should increasingly be able to answer:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "What does this program mean?")
    strs_push(l, "")
    strs_push(l, "What can this function do?")
    strs_push(l, "")
    strs_push(l, "What resources does it require?")
    strs_push(l, "")
    strs_push(l, "What does it own?")
    strs_push(l, "")
    strs_push(l, "What may it mutate?")
    strs_push(l, "")
    strs_push(l, "Where can this data flow?")
    strs_push(l, "")
    strs_push(l, "What can fail?")
    strs_push(l, "")
    strs_push(l, "What hardware will execute it?")
    strs_push(l, "")
    strs_push(l, "What runtime costs remain?")
    strs_push(l, "")
    strs_push(l, "What AI-context cost does this structure create?")
    strs_push(l, "")
    strs_push(l, "Why is this program considered safe?")
    strs_push(l, "")
    strs_push(l, "What changed semantically after this patch?")
    strs_push(l, "")
    strs_push(l, "What evidence supports this release?")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 5. Non-Negotiable Grand Goals")
    strs_push(l, "")
    strs_push(l, "## G01 — Human Readability")
    strs_push(l, "")
    strs_push(l, "Nazm source should optimize for comprehension.")
    strs_push(l, "")
    strs_push(l, "Goals:")
    strs_push(l, "")
    strs_push(l, "- low visual noise;")
    strs_push(l, "- consistent grammar;")
    strs_push(l, "- limited special cases;")
    strs_push(l, "- predictable control flow;")
    strs_push(l, "- strong naming conventions;")
    strs_push(l, "- useful inference without semantic ambiguity;")
    strs_push(l, "- excellent diagnostics;")
    strs_push(l, "- canonical formatting;")
    strs_push(l, "- progressive disclosure.")
    strs_push(l, "")
    strs_push(l, "### Principle")
    strs_push(l, "")
    strs_push(l, "Clarity outranks clever brevity.")
    strs_push(l, "")
    strs_push(l, "Five readable characters are better than one obscure operator.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G02 — Machine-Native Execution")
    strs_push(l, "")
    strs_push(l, "Native AOT execution is a primary execution mode.")
    strs_push(l, "")
    strs_push(l, "Nazm must not require:")
    strs_push(l, "")
    strs_push(l, "- JVM;")
    strs_push(l, "- CLR;")
    strs_push(l, "- browser;")
    strs_push(l, "- tracing GC;")
    strs_push(l, "- heavy VM")
    strs_push(l, "")
    strs_push(l, "for basic native programs.")
    strs_push(l, "")
    strs_push(l, "Potential optional modes may include:")
    strs_push(l, "")
    strs_push(l, "- interpreter;")
    strs_push(l, "- JIT;")
    strs_push(l, "- REPL;")
    strs_push(l, "- VM;")
    strs_push(l, "- accelerator execution.")
    strs_push(l, "")
    strs_push(l, "But native execution remains foundational.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G03 — Performance Predictability")
    strs_push(l, "")
    strs_push(l, "\"Fast\" is not enough.")
    strs_push(l, "")
    strs_push(l, "Performance should be explainable.")
    strs_push(l, "")
    strs_push(l, "Compiler/tooling should eventually expose:")
    strs_push(l, "")
    strs_push(l, "- allocations;")
    strs_push(l, "- copies;")
    strs_push(l, "- dynamic dispatch;")
    strs_push(l, "- synchronization;")
    strs_push(l, "- bounds checks;")
    strs_push(l, "- reference-count operations if present;")
    strs_push(l, "- vectorization;")
    strs_push(l, "- inlining;")
    strs_push(l, "- stack/heap placement;")
    strs_push(l, "- host/device transfers.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G04 — Memory Safety Without Mandatory GC")
    strs_push(l, "")
    strs_push(l, "Safe Nazm should prevent major memory errors by construction.")
    strs_push(l, "")
    strs_push(l, "Target classes include:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "use-after-free")
    strs_push(l, "double free")
    strs_push(l, "invalid dereference")
    strs_push(l, "uninitialized read")
    strs_push(l, "invalid mutable aliasing")
    strs_push(l, "dangling references")
    strs_push(l, "data races")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Unsafe escape hatches will still be necessary for systems work.")
    strs_push(l, "")
    strs_push(l, "They must be:")
    strs_push(l, "")
    strs_push(l, "- explicit;")
    strs_push(l, "- local;")
    strs_push(l, "- auditable;")
    strs_push(l, "- capability-controlled where practical.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G05 — Intent-Oriented Ownership and Aliasing Ergonomics")
    strs_push(l, "")
    strs_push(l, "Nazm should make ownership, aliasing and reclamation safe without forcing ordinary code to carry lifetime syntax whose only purpose is to explain compiler internals.")
    strs_push(l, "")
    strs_push(l, "The goal is **not** to predetermine that every heap-backed value has value semantics. Different semantic kinds may legitimately exist when their observable behaviour demands it:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "immediate value")
    strs_push(l, "shared immutable value")
    strs_push(l, "owned/shared mutable handle")
    strs_push(l, "runtime-managed shared handle")
    strs_push(l, "future resource/asset value")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Assignment, parameter passing, return, mutation and task transfer must have explicit language meaning for each kind. Existing observable aliasing must not be rewritten merely to simplify implementation.")
    strs_push(l, "")
    strs_push(l, "User-defined records already have settled meaning: they are nominal value types, whose copy behaviour — including that of any shared handle they contain — the specification defines. Ownership research may still investigate copy elision, unique ownership, regions or new resource/value kinds where they solve new problems — hypotheses to test against real workloads, not a constitution imposed on every existing type — and none of it may silently change what an existing record value observably does.")
    strs_push(l, "")
    strs_push(l, "The surface objective remains intent-oriented:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "read / observe")
    strs_push(l, "mutate")
    strs_push(l, "share")
    strs_push(l, "transfer / consume")
    strs_push(l, "return / publish")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "with expensive ownership operations explainable by compiler tooling.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G06 — Deterministic Resource Lifetime")
    strs_push(l, "")
    strs_push(l, "Resources should have predictable ownership and cleanup.")
    strs_push(l, "")
    strs_push(l, "Applies to more than memory:")
    strs_push(l, "")
    strs_push(l, "- files;")
    strs_push(l, "- sockets;")
    strs_push(l, "- locks;")
    strs_push(l, "- devices;")
    strs_push(l, "- mappings;")
    strs_push(l, "- GPU resources;")
    strs_push(l, "- tasks;")
    strs_push(l, "- transactions.")
    strs_push(l, "")
    strs_push(l, "Resource ownership should become part of the semantic model.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G07 — Concurrency First")
    strs_push(l, "")
    strs_push(l, "Concurrency should not be an afterthought.")
    strs_push(l, "")
    strs_push(l, "Nazm must eventually support a coherent model spanning:")
    strs_push(l, "")
    strs_push(l, "- tasks;")
    strs_push(l, "- structured concurrency;")
    strs_push(l, "- ownership-safe communication;")
    strs_push(l, "- channels/messages;")
    strs_push(l, "- parallel loops;")
    strs_push(l, "- async I/O;")
    strs_push(l, "- task cancellation;")
    strs_push(l, "- task failure.")
    strs_push(l, "")
    strs_push(l, "Concurrency syntax should remain smaller than concurrency semantics.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G08 — Data-Race Safety")
    strs_push(l, "")
    strs_push(l, "Safe concurrent Nazm should prevent data races by default.")
    strs_push(l, "")
    strs_push(l, "This does NOT mean:")
    strs_push(l, "")
    strs_push(l, "- all race conditions disappear;")
    strs_push(l, "- all deadlocks disappear;")
    strs_push(l, "- distributed systems become deterministic.")
    strs_push(l, "")
    strs_push(l, "These must remain separately modeled problems.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G09 — Failure Isolation")
    strs_push(l, "")
    strs_push(l, "Long-running systems need more than memory safety.")
    strs_push(l, "")
    strs_push(l, "Nazm should research failure domains inspired by proven fault-tolerant architectures.")
    strs_push(l, "")
    strs_push(l, "Questions include:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Who owns a task?")
    strs_push(l, "Who observes its failure?")
    strs_push(l, "Can failure corrupt siblings?")
    strs_push(l, "What gets cancelled?")
    strs_push(l, "What restarts?")
    strs_push(l, "What state survives?")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G10 — Effect Awareness")
    strs_push(l, "")
    strs_push(l, "Important externally observable behaviour should become statically visible where practical.")
    strs_push(l, "")
    strs_push(l, "Candidate effects:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "io")
    strs_push(l, "alloc")
    strs_push(l, "panic")
    strs_push(l, "spawn")
    strs_push(l, "block")
    strs_push(l, "network")
    strs_push(l, "filesystem")
    strs_push(l, "clock")
    strs_push(l, "random")
    strs_push(l, "ffi")
    strs_push(l, "unsafe")
    strs_push(l, "device")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Effects should support:")
    strs_push(l, "")
    strs_push(l, "- reasoning;")
    strs_push(l, "- documentation;")
    strs_push(l, "- optimization;")
    strs_push(l, "- testing;")
    strs_push(l, "- sandboxing;")
    strs_push(l, "- AI analysis.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G11 — Capability-Oriented Authority")
    strs_push(l, "")
    strs_push(l, "Effect:")
    strs_push(l, "")
    strs_push(l, "> This code may perform file I/O.")
    strs_push(l, "")
    strs_push(l, "Capability:")
    strs_push(l, "")
    strs_push(l, "> This code possesses authority to read this resource.")
    strs_push(l, "")
    strs_push(l, "These are different.")
    strs_push(l, "")
    strs_push(l, "Nazm must preserve the distinction.")
    strs_push(l, "")
