    strs_push(l, "architecture decisions")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "AI agents can then implement against declared constraints rather than guessing architecture from existing source code.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G90 — Intent-to-Code Efficiency")
    strs_push(l, "")
    strs_push(l, "The ultimate token-efficiency target is not:")
