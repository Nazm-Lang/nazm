    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "A language can expose its own structure and become an environment for building abstractions rather than only executing instructions.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Nazm should support powerful abstraction and compile-time program generation, but avoid uncontrolled textual macro systems.")
    strs_push(l, "")
    strs_push(l, "Machine manipulation of code should preferably operate on structured syntax or semantic representations rather than arbitrary token substitution.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.4 C — The Portable Systems Programming Barrier")
    strs_push(l, "")
    strs_push(l, "### What C solved")
    strs_push(l, "")
