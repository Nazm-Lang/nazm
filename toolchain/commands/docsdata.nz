    strs_push(l, "- compiler performance benchmark;")
    strs_push(l, "- language expressiveness evidence.")
    strs_push(l, "")
    strs_push(l, "Self-hosting is a milestone, not the final goal.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G50 — Verified Self-Evolution")
    strs_push(l, "")
    strs_push(l, "Long-term Nazm may become unusually capable of improving itself using AI-assisted development.")
    strs_push(l, "")
    strs_push(l, "The acceptable model is:")
    strs_push(l, "")
    strs_push(l, "```text")
