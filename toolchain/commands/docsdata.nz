    strs_push(l, "| words | 103.8 ms, #6 of 16 (Zig 47.8, Rust 65.7, C 73.6, Fortran 85.3, Go 88.2) (115.4, #6) | 8.6 MiB, **#3** of 16 (C++ 2.3, Ada 3.0) | 87.9 KB, #5 of 11 | **352 ms, #6 of 12** (C 77, Fortran 171, Go 217, Rust 236; was 1,166, #10) | 370 ms, #6 of 12 (Go 62, C 78, Fortran 161, Rust 235; was 718, #7) | 11, #6 of 16 | 242, **#3** of 16 | #3 of 10 (Zig 53.8, Rust 66.7) |")
    strs_push(l, "| primes, W = 1 | 173.3 ms, **#3** of 7 (Go 144.5, Rust checked 167.0) (173.6, #3) | 2.0 MiB, #4 of 7 | 71.8 KB, #3 of 6 | 241 ms, #4 of 7 (was 464, #5) | 226 ms, **#3** of 7 (was 276, #4) | 43, #6 of 7 | 734, #6 of 7 | **#2** of 4 (Rust checked 167.0) |")
