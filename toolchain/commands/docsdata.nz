    strs_push(l, "Can it be copied?")
    strs_push(l, "Can it cross task boundaries?")
    strs_push(l, "Can it enter logs?")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Do not invent syntax before the semantic problem is defined.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G44 — Fault Injection and Resilience Testing")
    strs_push(l, "")
    strs_push(l, "Critical and distributed software should be testable under failure.")
    strs_push(l, "")
    strs_push(l, "Future tooling may inject:")
