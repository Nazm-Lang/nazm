    strs_push(l, "- dependency provenance;")
    strs_push(l, "- sandboxing;")
    strs_push(l, "- secure defaults.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G43 — Secret Handling")
    strs_push(l, "")
    strs_push(l, "Long-term security research should consider secret-aware values.")
    strs_push(l, "")
    strs_push(l, "Questions:")
    strs_push(l, "")
    strs_push(l, "```text")
