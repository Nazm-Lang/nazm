    strs_push(l, "")
    strs_push(l, "## Cybersecurity Profile")
    strs_push(l, "")
    strs_push(l, "Target:")
    strs_push(l, "")
    strs_push(l, "- hardened services;")
    strs_push(l, "- parsers;")
    strs_push(l, "- agents;")
    strs_push(l, "- cryptographic systems;")
    strs_push(l, "- security tooling.")
    strs_push(l, "")
    strs_push(l, "Needs:")
    strs_push(l, "")
    strs_push(l, "- memory safety;")
    strs_push(l, "- capability control;")
    strs_push(l, "- provenance;")
    strs_push(l, "- secret handling;")
    strs_push(l, "- hardened parsing;")
    strs_push(l, "- dependency trust.")
    strs_push(l, "")
    strs_push(l, "## AI/HPC Profile")
    strs_push(l, "")
    strs_push(l, "Target:")
    strs_push(l, "")
    strs_push(l, "- inference;")
    strs_push(l, "- training components;")
    strs_push(l, "- scientific computing;")
    strs_push(l, "- simulation;")
    strs_push(l, "- numerical systems.")
    strs_push(l, "")
    strs_push(l, "Needs:")
    strs_push(l, "")
    strs_push(l, "- SIMD;")
    strs_push(l, "- tensor/vector representation;")
    strs_push(l, "- accelerator memory;")
    strs_push(l, "- specialization;")
    strs_push(l, "- CPU/GPU interoperability;")
    strs_push(l, "- distributed computation.")
    strs_push(l, "")
    strs_push(l, "## Web3 / Decentralized Execution Profile")
    strs_push(l, "")
    strs_push(l, "Target:")
    strs_push(l, "")
    strs_push(l, "- smart contracts;")
    strs_push(l, "- decentralized applications;")
    strs_push(l, "- protocol state machines;")
    strs_push(l, "- token/asset systems;")
    strs_push(l, "- chain runtime programs;")
    strs_push(l, "- portable WASM contract environments.")
    strs_push(l, "")
    strs_push(l, "Requires, depending on target:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "deterministic execution")
    strs_push(l, "restricted capabilities")
    strs_push(l, "explicit persistent state")
    strs_push(l, "resource / gas / compute metering")
    strs_push(l, "checked and target-appropriate numerics")
    strs_push(l, "typed addresses / hashes / signatures")
    strs_push(l, "asset/resource safety")
    strs_push(l, "contract ABI generation")
    strs_push(l, "storage-layout/version discipline")
    strs_push(l, "external-call effect analysis")
    strs_push(l, "reproducible deployment artefacts")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Web3 is a **restriction profile and backend family**, never permission to fork Nazm semantics. Chain-specific state or host operations belong behind typed profile capabilities/adapters.")
    strs_push(l, "")
    strs_push(l, "## Critical Profile")
    strs_push(l, "")
    strs_push(l, "Target research domains:")
    strs_push(l, "")
    strs_push(l, "- aerospace;")
    strs_push(l, "- spacecraft;")
    strs_push(l, "- avionics;")
    strs_push(l, "- industrial control;")
    strs_push(l, "- safety-critical robotics;")
    strs_push(l, "- high-integrity infrastructure.")
    strs_push(l, "")
    strs_push(l, "Requires severe restrictions and evidence.")
    strs_push(l, "")
    strs_push(l, "Nazm must NEVER claim that ordinary Nazm is aerospace-certified.")
    strs_push(l, "")
    strs_push(l, "Certification is dependent on:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "language subset")
    strs_push(l, "toolchain qualification")
    strs_push(l, "development process")
    strs_push(l, "system architecture")
    strs_push(l, "testing")
    strs_push(l, "verification")
    strs_push(l, "regulatory evidence")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The goal is to eventually make Nazm capable of participating in such environments.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 11. Proposed Semantic Kernel")
    strs_push(l, "")
    strs_push(l, "The long-term language should attempt to derive many features from a small number of concepts.")
    strs_push(l, "")
    strs_push(l, "## 11.1 Value")
    strs_push(l, "")
    strs_push(l, "What data exists?")
    strs_push(l, "")
    strs_push(l, "## 11.2 Type")
    strs_push(l, "")
    strs_push(l, "What values and operations are valid?")
    strs_push(l, "")
    strs_push(l, "## 11.3 Place")
    strs_push(l, "")
    strs_push(l, "Where is a value stored or projected?")
    strs_push(l, "")
    strs_push(l, "## 11.4 Ownership")
    strs_push(l, "")
    strs_push(l, "Who is responsible for a resource?")
    strs_push(l, "")
    strs_push(l, "## 11.5 Region")
    strs_push(l, "")
    strs_push(l, "For what period/context may access exist?")
    strs_push(l, "")
    strs_push(l, "## 11.6 Effect")
    strs_push(l, "")
    strs_push(l, "What observable operation may occur?")
    strs_push(l, "")
    strs_push(l, "## 11.7 Capability")
    strs_push(l, "")
    strs_push(l, "What authority does code possess?")
    strs_push(l, "")
    strs_push(l, "## 11.8 Task")
    strs_push(l, "")
    strs_push(l, "What independently schedulable work exists?")
    strs_push(l, "")
    strs_push(l, "## 11.9 Message")
    strs_push(l, "")
    strs_push(l, "What ownership/information crosses concurrency boundaries?")
    strs_push(l, "")
    strs_push(l, "## 11.10 Contract")
    strs_push(l, "")
    strs_push(l, "What must be true before/after computation?")
    strs_push(l, "")
    strs_push(l, "## 11.11 Profile")
    strs_push(l, "")
    strs_push(l, "Which capabilities and semantic freedoms are permitted in this environment?")
    strs_push(l, "")
    strs_push(l, "## 11.12 Semantic Identity")
    strs_push(l, "")
    strs_push(l, "What stable machine identity represents this definition across edits?")
    strs_push(l, "")
    strs_push(l, "## 11.13 Context Packet")
    strs_push(l, "")
    strs_push(l, "What is the minimum semantic information required for an AI agent or tool to act correctly?")
    strs_push(l, "")
    strs_push(l, "## 11.14 Resource")
    strs_push(l, "")
    strs_push(l, "A value whose duplication, destruction or transfer carries semantic obligations. Ordinary values must not become resources merely because Web3 exists.")
    strs_push(l, "")
    strs_push(l, "## 11.15 Persistent State")
    strs_push(l, "")
    strs_push(l, "State whose lifetime exceeds one process/execution and whose reads/writes may require explicit authority, version/layout rules and metering. This may remain a profile/library abstraction if the core kernel does not need a new primitive.")
    strs_push(l, "")
    strs_push(l, "## 11.16 Execution Environment")
    strs_push(l, "")
    strs_push(l, "The explicitly supplied host capabilities, target facts and resource limits under which a program executes. This is the conceptual home for deterministic contract hosts without turning ambient process state into invisible semantics.")
    strs_push(l, "")
    strs_push(l, "## 11.17 Resource Cost Model")
    strs_push(l, "")
    strs_push(l, "A structured description of costs relevant to a profile: allocations, blocking, CPU work, storage access, gas/compute units, host calls or other metered operations. The cost model is an analysis/tooling concept unless a profile makes a limit semantic.")
    strs_push(l, "")
    strs_push(l, "These additions are **candidate semantic responsibilities**, not a command to add four new keywords or IR nodes. The Feature Admission Rule below still applies.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 12. Feature Admission Rule")
    strs_push(l, "")
    strs_push(l, "Before adding a language feature, answer:")
    strs_push(l, "")
    strs_push(l, "1. Which historical barrier does it solve?")
    strs_push(l, "2. Is the barrier still real?")
    strs_push(l, "3. Can existing primitives solve it?")
    strs_push(l, "4. What semantic complexity does it add?")
    strs_push(l, "5. What compile-time complexity does it add?")
    strs_push(l, "6. What runtime cost does it introduce?")
    strs_push(l, "7. What source-token cost does it introduce?")
    strs_push(l, "8. What AI-context cost does it introduce?")
    strs_push(l, "9. Can tooling explain that cost?")
    strs_push(l, "10. Does it hurt analyzability?")
    strs_push(l, "11. Does it affect Critical/Embedded profiles?")
    strs_push(l, "12. Can it be removed later?")
    strs_push(l, "13. How is it tested?")
    strs_push(l, "14. How will AI tools understand it?")
    strs_push(l, "")
    strs_push(l, "If these cannot be answered, the feature is not ready.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 13. Syntax Philosophy")
    strs_push(l, "")
    strs_push(l, "Nazm syntax should be:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "familiar")
    strs_push(l, "minimal")
    strs_push(l, "regular")
    strs_push(l, "searchable")
    strs_push(l, "parseable")
    strs_push(l, "machine-editable")
    strs_push(l, "human-readable")
    strs_push(l, "token-efficient")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Avoid unnecessary symbolic density.")
    strs_push(l, "")
    strs_push(l, "Avoid multiple unrelated ways to express the same fundamental operation unless use cases justify them.")
    strs_push(l, "")
    strs_push(l, "Surface convenience is welcome when desugaring is precise.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
