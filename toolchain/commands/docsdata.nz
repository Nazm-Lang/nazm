    strs_push(l, "")
    strs_push(l, "A profile may refuse constructs, authorities or nondeterministic operations. It must not reinterpret ordinary Nazm semantics. Web3 must therefore be a restricted execution profile and backend family, **not a forked language dialect**.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 2. Historical Barrier Ledger")
    strs_push(l, "")
    strs_push(l, "The following languages and programming models are not competitors to imitate.")
    strs_push(l, "")
    strs_push(l, "They are engineering evidence.")
    strs_push(l, "")
    strs_push(l, "Each emerged or became important because an earlier approach had a serious limitation.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.1 Assembly — The Machine-Control Barrier")
    strs_push(l, "")
    strs_push(l, "### Barrier")
    strs_push(l, "")
    strs_push(l, "Raw machine instructions were:")
    strs_push(l, "")
    strs_push(l, "- difficult for humans;")
    strs_push(l, "- tied closely to specific hardware;")
    strs_push(l, "- error-prone;")
    strs_push(l, "- difficult to maintain;")
    strs_push(l, "- difficult to reuse.")
    strs_push(l, "")
    strs_push(l, "Assembly introduced symbolic names and more manageable machine-level programming while retaining direct hardware control.")
    strs_push(l, "")
    strs_push(l, "### Lesson for Nazm")
    strs_push(l, "")
    strs_push(l, "Machine control matters.")
    strs_push(l, "")
    strs_push(l, "Nazm must eventually be capable of expressing:")
    strs_push(l, "")
    strs_push(l, "- exact layouts;")
    strs_push(l, "- calling conventions;")
    strs_push(l, "- registers/intrinsics where justified;")
