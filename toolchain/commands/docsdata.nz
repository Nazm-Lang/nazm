    strs_push(l, "")
    strs_push(l, "# 46. Runtime Philosophy")
    strs_push(l, "")
    strs_push(l, "Runtime functionality must be modular.")
    strs_push(l, "")
    strs_push(l, "Possible runtime components:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "allocator")
    strs_push(l, "task scheduler")
    strs_push(l, "reactor")
    strs_push(l, "panic machinery")
    strs_push(l, "threading")
    strs_push(l, "I/O")
    strs_push(l, "stack management")
    strs_push(l, "GC — if an optional managed mode is ever justified")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "A bare-metal program should not drag in server runtime features.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 47. Scheduler Principle")
    strs_push(l, "")
    strs_push(l, "Language task semantics should not be irreversibly tied to the first scheduler implementation.")
    strs_push(l, "")
    strs_push(l, "Potential runtime evolution:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "OS threads")
    strs_push(l, "        ↓")
    strs_push(l, "hybrid runtime")
    strs_push(l, "        ↓")
    strs_push(l, "M:N scheduler")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "if evidence justifies it.")
    strs_push(l, "")
    strs_push(l, "Semantics must remain stable while implementation improves.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 48. Automatic Parallelism Rule")
    strs_push(l, "")
    strs_push(l, "The compiler may parallelize only when it can preserve defined semantics.")
    strs_push(l, "")
    strs_push(l, "Nazm must not promise magical parallelization.")
    strs_push(l, "")
    strs_push(l, "Programmer-visible constructs for parallel intent may still be necessary.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 49. Data Layout Rule")
    strs_push(l, "")
    strs_push(l, "Compiler-selected layout is allowed only where representation is not part of observable semantics.")
    strs_push(l, "")
    strs_push(l, "FFI and explicit-layout types must remain stable.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 50. Unsafe Constitution")
    strs_push(l, "")
    strs_push(l, "Unsafe operations must never mean:")
    strs_push(l, "")
    strs_push(l, "> compiler stops caring.")
    strs_push(l, "")
    strs_push(l, "Unsafe means:")
    strs_push(l, "")
    strs_push(l, "> the programmer/compiler component assumes explicitly documented obligations that the type system cannot prove.")
    strs_push(l, "")
    strs_push(l, "Every unsafe primitive needs:")
    strs_push(l, "")
    strs_push(l, "- safety contract;")
    strs_push(l, "- allowed use;")
    strs_push(l, "- invalid use;")
    strs_push(l, "- tests;")
    strs_push(l, "- review.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 51. Ecosystem Adoption Goal")
    strs_push(l, "")
    strs_push(l, "Nazm should become adoptable incrementally.")
    strs_push(l, "")
    strs_push(l, "Desired migration pattern:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "existing C/C++/other native project")
