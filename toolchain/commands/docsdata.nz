    strs_push(l, "### N15 — Lossless CST and local error recovery — **complete, 2026-09-25**")
    strs_push(l, "")
    strs_push(l, "One lossless scan feeds the one parser, which builds the abstract tree and a lossless")
    strs_push(l, "concrete tree from the same decisions. The tree reproduces every input byte — whitespace,")
    strs_push(l, "comments, punctuation, refused characters — and a malformed statement no longer costs the")
