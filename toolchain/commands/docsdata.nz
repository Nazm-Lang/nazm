// Nazm's own documentation corpus, as the repository holds it (R8 slice 12): generated by
// `toolchain/commands/tests/gen-docsdata.py`, never edited. `nazm docs` with no `--root` reads these.

// The document at `path` (`docs/user/spec.md`), "" for a path the corpus does not hold.
pub fn dd_text(path: Str) -> Str {
    if path == "docs/internal/NAZM_LANGUAGE_GOALS.md" { return dd_doc0() }
    if path == "docs/internal/architecture.md" { return dd_doc1() }
    if path == "docs/internal/bootstrap.md" { return dd_doc2() }
    if path == "docs/internal/capability-matrix.md" { return dd_doc3() }
    if path == "docs/internal/master-architecture.md" { return dd_doc4() }
    if path == "docs/internal/performance-log.md" { return dd_doc5() }
    if path == "docs/internal/research-register.md" { return dd_doc6() }
    if path == "docs/internal/runbook.md" { return dd_doc7() }
    if path == "docs/user/diagnostics.md" { return dd_doc8() }
    if path == "docs/user/grammar.ebnf" { return dd_doc9() }
    if path == "docs/user/guide.md" { return dd_doc10() }
    if path == "docs/user/mcp.md" { return dd_doc11() }
    if path == "docs/user/roadmap.md" { return dd_doc12() }
    if path == "docs/user/spec.md" { return dd_doc13() }
    ""
}

fn dd_doc0() -> Str {
    let l = strs_new()
    strs_push(l, "# Nazm Language Grand Goals and Historical Barrier Constitution")
    strs_push(l, "")
    strs_push(l, "**File:** `NAZM_LANGUAGE_GOALS.md`  ")
    strs_push(l, "**Document class:** Long-term language constitution / goal document  ")
    strs_push(l, "**Purpose:** Define what Nazm is ultimately trying to solve and why.  ")
    strs_push(l, "**Status:** Authoritative long-term goals; not an implementation-status document.")
    strs_push(l, "")
    strs_push(l, "**Constitution revision — 2026-09-22.** This revision preserves the original historical-barrier and AI-era constitution, aligns the long-term memory ambition with the N7 memory constitution, and extends the domain ambition to best-in-class multi-profile compilation, WebAssembly and decentralized/Web3 execution. It does **not** upgrade any capability status; implementation truth remains owned by `capability-matrix.md`.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 0. Authority and Interpretation")
    strs_push(l, "")
    strs_push(l, "This document defines the long-term engineering ambition of the Nazm programming language.")
    strs_push(l, "")
    strs_push(l, "It exists to prevent Nazm from becoming a collection of fashionable language features.")
    strs_push(l, "")
    strs_push(l, "Nazm must instead understand the historical barriers that caused major programming languages and programming models to emerge, identify the deeper root problems behind those barriers, and attempt to solve as many of those root problems as possible through a small, coherent semantic foundation.")
    strs_push(l, "")
    strs_push(l, "The governing principle is:")
    strs_push(l, "")
    strs_push(l, "> **Nazm does not aim to contain every feature from every programming language. Nazm aims to understand why those features became necessary and solve the underlying problems with the smallest coherent set of semantic mechanisms possible.**")
    strs_push(l, "")
    strs_push(l, "This file expresses **GOALS**.")
    strs_push(l, "")
    strs_push(l, "Implementation truth belongs elsewhere, particularly in:")
    strs_push(l, "")
    strs_push(l, "- capability/status matrices;")
    strs_push(l, "- architecture records;")
    strs_push(l, "- specifications;")
    strs_push(l, "- test evidence;")
    strs_push(l, "- benchmark evidence;")
    strs_push(l, "- release provenance;")
    strs_push(l, "- research records.")
    strs_push(l, "")
    strs_push(l, "A future implementation must never be marked complete merely because this file says Nazm intends to support it.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 1. The Central Thesis")
    strs_push(l, "")
    strs_push(l, "The history of programming languages can be understood partly as a sequence of barriers.")
    strs_push(l, "")
    strs_push(l, "Developers repeatedly encountered a boundary:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "machine code is too difficult")
    strs_push(l, "        ↓")
    strs_push(l, "assembly")
    strs_push(l, "")
    strs_push(l, "assembly is too machine-specific")
    strs_push(l, "        ↓")
    strs_push(l, "higher-level compiled languages")
    strs_push(l, "")
    strs_push(l, "systems languages are unsafe")
    strs_push(l, "        ↓")
    strs_push(l, "managed runtimes / ownership systems")
    strs_push(l, "")
    strs_push(l, "shared-state concurrency is too difficult")
    strs_push(l, "        ↓")
    strs_push(l, "message passing / structured concurrency")
    strs_push(l, "")
    strs_push(l, "dynamic languages are productive but slower")
    strs_push(l, "        ↓")
    strs_push(l, "JIT / specialization / modern native languages")
    strs_push(l, "")
    strs_push(l, "CPUs are insufficient for massively parallel workloads")
    strs_push(l, "        ↓")
    strs_push(l, "GPU programming")
    strs_push(l, "")
    strs_push(l, "general languages are difficult to verify")
    strs_push(l, "        ↓")
    strs_push(l, "restricted high-assurance languages")
    strs_push(l, "")
    strs_push(l, "large codebases become too complex")
    strs_push(l, "        ↓")
    strs_push(l, "simpler languages + integrated tooling")
    strs_push(l, "")
    strs_push(l, "human-readable source is still opaque to machines and AI")
    strs_push(l, "        ↓")
    strs_push(l, "semantic compiler interfaces")
    strs_push(l, "")
    strs_push(l, "general-purpose execution assumes one trusted machine")
    strs_push(l, "        ↓")
    strs_push(l, "deterministic, capability-restricted and metered execution for decentralized systems")
    strs_push(l, "")
    strs_push(l, "one compiler/runtime model rarely fits every domain")
    strs_push(l, "        ↓")
    strs_push(l, "one semantic language with restriction profiles and multiple backends")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm's ambition is to attack these barriers together without simply stacking all historical solutions on top of each other.")
    strs_push(l, "")
    strs_push(l, "The target is:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "human clarity")
    strs_push(l, "+")
    strs_push(l, "machine control")
    strs_push(l, "+")
    strs_push(l, "native performance")
    strs_push(l, "+")
    strs_push(l, "memory safety")
    strs_push(l, "+")
    strs_push(l, "concurrency safety")
    strs_push(l, "+")
    strs_push(l, "failure isolation")
    strs_push(l, "+")
    strs_push(l, "predictable cost")
    strs_push(l, "+")
    strs_push(l, "high assurance")
    strs_push(l, "+")
    strs_push(l, "heterogeneous computing")
    strs_push(l, "+")
    strs_push(l, "AI-readable semantics")
    strs_push(l, "+")
    strs_push(l, "developer productivity")
    strs_push(l, "+")
    strs_push(l, "AI-era token efficiency")
    strs_push(l, "+")
    strs_push(l, "deterministic decentralized execution")
    strs_push(l, "+")
    strs_push(l, "portable sandboxed execution")
    strs_push(l, "+")
    strs_push(l, "resource-aware smart contracts")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "under one coherent language model.")
    strs_push(l, "")
    strs_push(l, "## 1.1 What “best of the best” means")
    strs_push(l, "")
    strs_push(l, "Nazm does not define “best” as winning one universal ranking. Programming-language goals conflict:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "maximum low-level freedom        ↔ strongest static guarantees")
    strs_push(l, "maximum clean-build optimization ↔ minimum development latency")
    strs_push(l, "fully automatic management       ↔ deterministic resource lifetime")
    strs_push(l, "ambient convenience              ↔ capability security")
    strs_push(l, "general OS execution             ↔ deterministic smart-contract execution")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The goal is therefore **Pareto excellence under explicit profiles**, not pretending the trade-offs do not exist.")
    strs_push(l, "")
    strs_push(l, "Nazm should aim to be best-in-class, with evidence, across independently measured dimensions:")
    strs_push(l, "")
    strs_push(l, "- semantic correctness;")
    strs_push(l, "- memory and concurrency safety;")
    strs_push(l, "- native runtime performance;")
    strs_push(l, "- predictable latency and resource use;")
    strs_push(l, "- compiler and incremental latency;")
    strs_push(l, "- binary size and startup;")
    strs_push(l, "- portability and cross compilation;")
    strs_push(l, "- embedded and systems control;")
    strs_push(l, "- server concurrency and fault isolation;")
    strs_push(l, "- high-assurance analyzability;")
    strs_push(l, "- WebAssembly portability;")
    strs_push(l, "- decentralized/Web3 determinism and resource metering;")
    strs_push(l, "- diagnostics and repair quality;")
    strs_push(l, "- interoperability and ecosystem adoption;")
    strs_push(l, "- reproducibility and provenance;")
    strs_push(l, "- AI semantic context efficiency;")
    strs_push(l, "- human and agent task-completion efficiency.")
    strs_push(l, "")
    strs_push(l, "A claim of superiority in one dimension never silently becomes a claim about another.")
    strs_push(l, "")
    strs_push(l, "## 1.2 One semantic language, many execution environments")
    strs_push(l, "")
    strs_push(l, "The long-term shape is:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "                         Nazm source")
    strs_push(l, "                              │")
    strs_push(l, "                     one semantic language")
    strs_push(l, "                              │")
    strs_push(l, "       ┌──────────────────────┼──────────────────────┐")
    strs_push(l, "       │                      │                      │")
    strs_push(l, "    General                Systems                Critical")
    strs_push(l, "       │                      │                      │")
    strs_push(l, "     Server                Embedded               Verified")
    strs_push(l, "       │                      │                      │")
    strs_push(l, "     AI/HPC                  WASM                  Web3")
    strs_push(l, "       └──────────────────────┼──────────────────────┘")
