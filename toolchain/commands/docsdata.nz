    strs_push(l, "")
    strs_push(l, "| language | variant | LOC | run median (ms) | run min–max (ms) | peak RSS (KiB) | binary (KiB) | build median (ms) |")
    strs_push(l, "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |")
    strs_push(l, "| Nazm | nazm build --opt-level 2 | 6 | 55.3 | 55.2–55.4 | 1744 | 35 | 207 |")
    strs_push(l, "| Nazm | nazm run (interpreter) | 6 | 5201.6 | 5186.2–5268.6 | 6864 | — | — |")
    strs_push(l, "| C | clang -O2 | 6 | 35.2 | 35.2–35.6 | 1712 | 33 | 69 |")
    strs_push(l, "| C++ | clang++ -O2 | 5 | 35.3 | 35.2–35.8 | 1728 | 35 | 514 |")
    strs_push(l, "| Go | go build | 11 | 39.6 | 39.4–40.0 | 4416 | 2373 | 61 |")
    strs_push(l, "| Rust | rustc -C opt-level=3 | 6 | 35.7 | 35.5–36.3 | 1888 | 459 | 142 |")
    strs_push(l, "| Zig | zig build-exe -O ReleaseFast | 10 | 35.9 | 35.9–36.1 | 1920 | 388 | 7344 |")
    strs_push(l, "| Java | javac + java | 8 | 59.9 | 59.6–60.9 | 39248 | — | 292 |")
    strs_push(l, "| C# | dotnet build -c Release | 2 | 79.9 | 79.7–81.7 | 41808 | 122 | 772 |")
    strs_push(l, "| Python | python3 | 3 | 1217.6 | 1215.7–1226.8 | 14272 | — | — |")
    strs_push(l, "| Ruby | ruby | 4 | 981.8 | 975.0–985.8 | 17792 | — | — |")
    strs_push(l, "| JavaScript | node | 4 | 135.8 | 135.4–137.4 | 48816 | — | — |")
    strs_push(l, "| TypeScript | bun | 4 | 66.9 | 66.7–67.6 | 26896 | — | — |")
    strs_push(l, "| Swift | swiftc -O | 4 | 44.7 | 44.6–45.1 | 2080 | 49 | 250 |")
    strs_push(l, "| Pascal | fpc -O3 | 8 | 74.3 | 74.2–74.8 | 2016 | 424 | 108 |")
