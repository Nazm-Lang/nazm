    strs_push(l, "- network interruption;")
    strs_push(l, "- timeout;")
    strs_push(l, "- cancellation;")
    strs_push(l, "- device error.")
    strs_push(l, "")
    strs_push(l, "Resilience must be measured rather than assumed.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G45 — Mutation Testing")
    strs_push(l, "")
    strs_push(l, "Mutation testing should remain a first-class compiler/toolchain verification technique.")
