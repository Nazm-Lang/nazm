    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 40. North-Star Domain Matrix")
    strs_push(l, "")
    strs_push(l, "| Capability | General | Systems | Embedded | Cyber | AI/HPC | Web3 | Critical |")
    strs_push(l, "|---|---:|---:|---:|---:|---:|---:|---:|")
    strs_push(l, "| Native AOT | Required | Required | Required | Required | Required | Target-dependent | Required |")
    strs_push(l, "| WASM | Useful | Useful | Useful | Useful | Useful | Major | Optional |")
    strs_push(l, "| Heap | Yes | Controlled | Optional | Controlled | Yes | Restricted/metered | Restricted |")
    strs_push(l, "| Unsafe | Restricted | Explicit | Explicit | Highly audited | Explicit | Normally unavailable/restricted | Strongly restricted |")
    strs_push(l, "| Concurrency | Yes | Yes | Profiled | Yes | Yes | Target-restricted/deterministic | Restricted/analyzable |")
    strs_push(l, "| SIMD | Useful | Useful | Target-specific | Useful | Required | Usually unavailable/target-specific | Controlled |")
    strs_push(l, "| GPU | Optional | Optional | Rare | Optional | Major | No ordinary ambient GPU | Usually restricted |")
    strs_push(l, "| Effects | Useful | Required | Required | Required | Useful | **Required** | Required |")
    strs_push(l, "| Capabilities | Useful | Useful | Useful | Required | Useful | **Required** | Required |")
    strs_push(l, "| Provenance | Optional | Useful | Optional | Major | Data lineage useful | Asset/state lineage useful | Major |")
    strs_push(l, "| Formal contracts | Optional | Useful | Useful | Useful | Useful | Major | Major |")
    strs_push(l, "| Resource metering | Useful | Useful | Major | Useful | Major | **Required** | Major |")
    strs_push(l, "| Determinism | Useful | Useful | Major | Useful | Workload-specific | **Consensus-critical** | Major |")
    strs_push(l, "| Persistent state model | Library/app | Library/app | Target-specific | Library/app | Library/app | **Major** | Profile-specific |")
    strs_push(l, "| Asset/resource semantics | Optional | Optional | Optional | Useful | Optional | **Major** | Useful |")
    strs_push(l, "| GC dependency | Optional future | No mandatory | No mandatory | No mandatory | Optional | No mandatory default | No mandatory |")
    strs_push(l, "| Dynamic allocation | Yes | Yes | Optional | Controlled | Yes | Restricted/metered | Restricted |")
    strs_push(l, "| FFI | Yes | Major | Major | Controlled | Major | Host capability only | Restricted |")
    strs_push(l, "| AI tooling | Yes | Yes | Yes | Yes | Yes | Yes/audit-controlled | Review-controlled |")
    strs_push(l, "| Token efficiency | Major | Major | Major | Major | Major | Major | Major |")
    strs_push(l, "")
    strs_push(l, "This table describes goals, not current implementation. A Web3 cell marked “Required” means required for that future profile to make the stated claim; it does not mean the feature exists today.")
    strs_push(l, "")
