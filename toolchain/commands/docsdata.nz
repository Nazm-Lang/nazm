    strs_push(l, "")
    strs_push(l, "This would make AI-era language efficiency measurable rather than rhetorical.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G86 — Semantic Tokens vs Text Tokens")
    strs_push(l, "")
