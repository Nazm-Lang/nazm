    strs_push(l, "Nazm should optimize the entire path.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G91 — No Token Efficiency at the Cost of Language Longevity")
    strs_push(l, "")
    strs_push(l, "Token prices, context-window sizes and model architectures will change.")
    strs_push(l, "")
    strs_push(l, "Nazm may live for decades.")
    strs_push(l, "")
    strs_push(l, "Therefore token efficiency must derive primarily from enduring principles:")
