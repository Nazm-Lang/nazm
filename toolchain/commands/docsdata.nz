    strs_push(l, "")
    strs_push(l, "Assembly still exposes enormous accidental complexity and weak portability.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Retain machine-level capability without making machine-level representation the ordinary programming model.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.2 FORTRAN — The Numerical Abstraction Barrier")
    strs_push(l, "")
    strs_push(l, "FORTRAN demonstrated that a high-level language could express mathematical computation while compilers generated efficient machine programs.")
    strs_push(l, "")
    strs_push(l, "### Lesson")
    strs_push(l, "")
    strs_push(l, "High abstraction and serious performance do not have to be opposites.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "Mathematical and numerical code should remain readable while lowering to efficient scalar, vector and accelerator execution.")
    strs_push(l, "")
    strs_push(l, "A future Nazm programmer should not need to abandon Nazm merely because a numerical kernel becomes performance-critical.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## 2.3 Lisp — The Symbolic and Metaprogramming Barrier")
    strs_push(l, "")
    strs_push(l, "Lisp demonstrated major ideas including:")
    strs_push(l, "")
    strs_push(l, "- symbolic computation;")
    strs_push(l, "- programs as manipulable structure;")
