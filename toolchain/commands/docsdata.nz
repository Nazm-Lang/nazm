    strs_push(l, "The `summary` suites joined the profiles. N13's use-after-free survivor and the `nesting-unbounded`")
    strs_push(l, "MUTANT CRASH were not re-run and are as they were.")
    strs_push(l, "")
    strs_push(l, "*N31's closure correction (2026-09-28) added seven,* one for each outcome it newly exercises: a build")
    strs_push(l, "that could not be started called `build_failed`, a program that could not be started called")
