    strs_push(l, "")
    strs_push(l, "### Nazm lesson")
    strs_push(l, "")
    strs_push(l, "Safety-critical capability cannot be created merely by adding a `safe` keyword.")
    strs_push(l, "")
    strs_push(l, "Nazm must eventually support a restricted Critical Profile where analyzability is more important than unrestricted expressiveness.")
    strs_push(l, "")
    strs_push(l, "### Nazm goal")
    strs_push(l, "")
    strs_push(l, "The language should eventually allow different assurance levels without becoming incompatible languages.")
    strs_push(l, "")
    strs_push(l, "Example:")
    strs_push(l, "")
    strs_push(l, "```text")
