    strs_push(l, "### N24 — Diagnostic-backed code actions and versioned fix plans — **complete, 2026-09-26**")
    strs_push(l, "")
    strs_push(l, "The fixes the compiler already attaches to its diagnostics now reach an editor as quick fixes:")
    strs_push(l, "each current diagnostic the requested range touches has one plan per fix — its applicability,")
    strs_push(l, "description and precondition, the generation, and one edit tied to the open document's version")
    strs_push(l, "with the bytes it replaces — held to the freshness law renames answer to, and sent as a")
    strs_push(l, "versioned `documentChanges` edit. Nothing is invented from a code or message, and the server")
