    strs_push(l, "21.0.0, Go 1.27.2, rustc 1.98.1, Zig 0.17.0, OpenJDK 27, .NET 10.0.402, Swift 6.4, Python 3.15.0, Ruby 4.0.7, Node 24.13.0,")
    strs_push(l, "Bun 1.3.10, Free Pascal 3.2.2, GNAT 16.1.0, GNU Fortran 16.2.0, GnuCOBOL 3.2.0, hyperfine 2.0.0; Erlang, Elixir, Kotlin,")
