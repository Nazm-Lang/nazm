    strs_push(l, "semantic operations")
    strs_push(l, "source lines")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Tokenizer-dependent benchmarking may include multiple representative tokenizers.")
    strs_push(l, "")
    strs_push(l, "No syntax decision should depend solely on one proprietary tokenizer's current segmentation behavior.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G82 — Multi-Tokenizer Benchmarking")
    strs_push(l, "")
