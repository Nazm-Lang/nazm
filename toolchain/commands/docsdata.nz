    strs_push(l, "`crates/nazm-service/src/` and runs the service's suites, and that one entry, re-run alone,")
    strs_push(l, "was caught at tier 2 by `nazm-cli --test source_root` — the suite that caught it before N16.")
    strs_push(l, "N13's use-after-free survivor and the `nesting-unbounded` MUTANT CRASH were not re-run and are")
    strs_push(l, "as they were.")
    strs_push(l, "")
    strs_push(l, "*N17 (2026-09-25) added sixteen and repointed one,* each killer verified by `--verify-killer`,")
