    strs_push(l, "- strong inference;")
    strs_push(l, "- structured tooling;")
    strs_push(l, "- incremental context;")
    strs_push(l, "- machine-readable semantics.")
    strs_push(l, "")
    strs_push(l, "Do not distort permanent language syntax to exploit temporary model economics.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G92 — Token Efficiency and Readability Conflict Rule")
    strs_push(l, "")
    strs_push(l, "When token count and human readability conflict, evaluate total cost.")
    strs_push(l, "")
