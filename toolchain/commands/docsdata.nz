    strs_push(l, "")
    strs_push(l, "# 15. Compiler Architecture Goal")
    strs_push(l, "")
    strs_push(l, "Long-term conceptual pipeline:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "UTF-8 Source")
    strs_push(l, "      ↓")
    strs_push(l, "CST")
    strs_push(l, "      ↓")
    strs_push(l, "HIR")
    strs_push(l, "      ↓")
    strs_push(l, "Typed Core")
    strs_push(l, "      ↓")
    strs_push(l, "MIR")
    strs_push(l, "      ↓")
    strs_push(l, "Monomorphised / profile-specialised MIR")
    strs_push(l, "      ↓")
    strs_push(l, "LIR / target contract")
    strs_push(l, "      ↓")
    strs_push(l, "┌───────────────┬───────────────┬────────────────────┐")
    strs_push(l, "│ Native        │ WebAssembly   │ Contract backends  │")
    strs_push(l, "│ LLVM/other    │               │ EVM / sBPF / ...  │")
    strs_push(l, "└───────────────┴───────────────┴────────────────────┘")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This is conceptual responsibility separation.")
    strs_push(l, "")
    strs_push(l, "Do NOT create empty layers merely to match the diagram.")
    strs_push(l, "")
    strs_push(l, "Each IR must earn existence.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 16. IR Responsibilities")
    strs_push(l, "")
    strs_push(l, "## CST")
