    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G97 — Token Constitution")
    strs_push(l, "")
    strs_push(l, "Nazm shall pursue:")
    strs_push(l, "")
    strs_push(l, "> **Maximum verified semantic value per unit of human attention, machine execution, and AI context.**")
    strs_push(l, "")
    strs_push(l, "The priority is not merely fewer characters.")
