    strs_push(l, "session, campaign `7ee57d2af9d3bb87`, targeted, P1, 767 s:** those seven, N32's seventeen, N32-H's")
    strs_push(l, "two and the twelve MCP entries — **38 of 38 caught at tier 1**, no survivor, crash, timeout,")
