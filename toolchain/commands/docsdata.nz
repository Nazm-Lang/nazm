    strs_push(l, "→ compile")
    strs_push(l, "→ verify")
    strs_push(l, "→ compare")
    strs_push(l, "→ approve")
    strs_push(l, "→ adopt")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The unacceptable model is uncontrolled autonomous compiler mutation.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "# 6. AI-Era Token Efficiency Constitution")
    strs_push(l, "")
    strs_push(l, "Token efficiency is a **first-class language, compiler, tooling and ecosystem property**.")
    strs_push(l, "")
    strs_push(l, "This requirement exists because software development is moving toward a model in which:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Humans")
    strs_push(l, "   ↓")
    strs_push(l, "intent")
    strs_push(l, "architecture")
    strs_push(l, "constraints")
    strs_push(l, "trade-offs")
    strs_push(l, "approval")
    strs_push(l, "")
    strs_push(l, "AI Agents")
    strs_push(l, "   ↓")
    strs_push(l, "implementation")
    strs_push(l, "refactoring")
    strs_push(l, "testing")
    strs_push(l, "migration")
    strs_push(l, "debugging")
    strs_push(l, "maintenance")
    strs_push(l, "documentation")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Source code is increasingly consumed not only by humans and compilers but repeatedly by:")
    strs_push(l, "")
    strs_push(l, "- coding agents;")
    strs_push(l, "- review agents;")
    strs_push(l, "- security agents;")
    strs_push(l, "- test-generation agents;")
    strs_push(l, "- documentation agents;")
    strs_push(l, "- compiler agents;")
    strs_push(l, "- architecture-analysis agents;")
    strs_push(l, "- retrieval systems;")
    strs_push(l, "- context-building systems.")
    strs_push(l, "")
    strs_push(l, "Therefore the future cost of a programming language includes:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "runtime cost")
    strs_push(l, "+")
    strs_push(l, "memory cost")
    strs_push(l, "+")
    strs_push(l, "compile cost")
    strs_push(l, "+")
    strs_push(l, "human cognitive cost")
    strs_push(l, "+")
    strs_push(l, "AI context cost")
    strs_push(l, "+")
    strs_push(l, "AI generation cost")
    strs_push(l, "+")
    strs_push(l, "AI repair cost")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm must optimize all of them.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G51 — AI-Era Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Nazm must treat token efficiency as a first-class language performance concern.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G52 — Semantic Density, Not Code Golf")
    strs_push(l, "")
    strs_push(l, "Token efficiency must NOT mean making Nazm cryptic.")
    strs_push(l, "")
    strs_push(l, "Rejected objective:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "maximum meaning")
    strs_push(l, "÷")
    strs_push(l, "minimum characters")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Actual objective:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "useful semantic information")
    strs_push(l, "──────────────────────────")
    strs_push(l, "human + machine interpretation cost")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Nazm should maximize **semantic density** while preserving:")
    strs_push(l, "")
    strs_push(l, "- readability;")
    strs_push(l, "- predictability;")
    strs_push(l, "- searchability;")
    strs_push(l, "- debuggability;")
    strs_push(l, "- structural clarity;")
    strs_push(l, "- deterministic parsing;")
    strs_push(l, "- AI comprehension.")
    strs_push(l, "")
    strs_push(l, "A shorter program that requires substantially more reasoning is not token-efficient in the meaningful sense.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G53 — Three-Way Optimization")
    strs_push(l, "")
    strs_push(l, "Nazm syntax must optimize simultaneously for:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Human readability")
    strs_push(l, "        ▲")
    strs_push(l, "       / \\")
    strs_push(l, "      /   \\")
    strs_push(l, "     /     \\")
    strs_push(l, "AI efficiency ─── Compiler precision")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "No corner may dominate the others absolutely.")
    strs_push(l, "")
    strs_push(l, "A syntax that is excellent for humans but extremely verbose for agents is undesirable.")
    strs_push(l, "")
    strs_push(l, "A syntax that is compact for LLM tokenizers but unreadable to humans is undesirable.")
    strs_push(l, "")
    strs_push(l, "A syntax that is convenient for the parser but creates unnecessary ceremony for humans and agents is undesirable.")
    strs_push(l, "")
    strs_push(l, "Nazm should seek the Pareto-efficient region among all three.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G54 — Token Efficiency Is Broader Than Source Syntax")
    strs_push(l, "")
    strs_push(l, "Nazm token efficiency must be designed across the entire development lifecycle.")
    strs_push(l, "")
    strs_push(l, "At least these layers must be measured separately:")
    strs_push(l, "")
    strs_push(l, "1. Source-code token efficiency")
    strs_push(l, "2. Type/signature token efficiency")
    strs_push(l, "3. Error-message token efficiency")
    strs_push(l, "4. Compiler diagnostic token efficiency")
    strs_push(l, "5. Agent semantic-query efficiency")
    strs_push(l, "6. Patch/edit token efficiency")
    strs_push(l, "7. Test-output efficiency")
    strs_push(l, "8. Build-output efficiency")
    strs_push(l, "9. Dependency-context efficiency")
    strs_push(l, "10. Documentation efficiency")
    strs_push(l, "11. Machine protocol efficiency")
    strs_push(l, "12. Repository-context efficiency")
    strs_push(l, "13. Incremental-change efficiency")
    strs_push(l, "14. AI reasoning iteration efficiency")
    strs_push(l, "")
    strs_push(l, "A language with concise source but extremely verbose compiler/tooling protocols is not fully token-efficient.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G55 — Source Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Common programming operations should require minimal unnecessary ceremony.")
    strs_push(l, "")
    strs_push(l, "Avoid repetitive patterns such as:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "type repeated where already known")
    strs_push(l, "module repeated where already known")
    strs_push(l, "namespace repeated unnecessarily")
    strs_push(l, "boilerplate constructors")
    strs_push(l, "boilerplate getters/setters")
    strs_push(l, "boilerplate resource cleanup")
    strs_push(l, "boilerplate async wrappers")
    strs_push(l, "boilerplate error propagation")
    strs_push(l, "boilerplate trait/interface forwarding")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Inference and defaults may remove redundancy where semantics remain unambiguous.")
    strs_push(l, "")
    strs_push(l, "The governing rule:")
    strs_push(l, "")
    strs_push(l, "> **Do not require a programmer or an AI agent to repeatedly state information the compiler can already prove.**")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G56 — Explicitness Budget")
    strs_push(l, "")
    strs_push(l, "Explicitness is valuable when it communicates information that matters.")
    strs_push(l, "")
    strs_push(l, "It is wasteful when it merely satisfies syntax.")
    strs_push(l, "")
    strs_push(l, "Nazm should distinguish:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "semantic explicitness")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "from:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "ceremonial explicitness")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Semantic explicitness examples:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "unsafe boundary")
    strs_push(l, "ownership transfer")
    strs_push(l, "capability grant")
    strs_push(l, "FFI")
    strs_push(l, "critical resource bound")
    strs_push(l, "meaningful effect")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "These may deserve explicit syntax.")
    strs_push(l, "")
    strs_push(l, "Ceremonial repetition should generally be eliminated.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G57 — Token-Efficient Type System")
    strs_push(l, "")
    strs_push(l, "A sophisticated type system can become extremely token-expensive.")
    strs_push(l, "")
    strs_push(l, "Nazm should therefore seek:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "strong static guarantees")
    strs_push(l, "+")
    strs_push(l, "low annotation burden")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "through sound inference where practical.")
    strs_push(l, "")
    strs_push(l, "Prefer:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "infer locally")
    strs_push(l, "declare at important boundaries")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Potential boundaries where explicit typing remains valuable:")
    strs_push(l, "")
    strs_push(l, "- public APIs;")
    strs_push(l, "- FFI;")
    strs_push(l, "- critical-system interfaces;")
    strs_push(l, "- ambiguous generic boundaries;")
    strs_push(l, "- capability/effect boundaries.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G58 — Token-Efficient Error Handling")
    strs_push(l, "")
    strs_push(l, "Error handling frequently creates significant source expansion.")
    strs_push(l, "")
    strs_push(l, "Nazm should seek a model that remains:")
    strs_push(l, "")
    strs_push(l, "- explicit enough to be safe;")
    strs_push(l, "- compact enough for ordinary propagation;")
    strs_push(l, "- visible to the type/effect system;")
    strs_push(l, "- easy for AI agents to reason about.")
    strs_push(l, "")
    strs_push(l, "Avoid forcing large repetitive error-propagation structures where the programmer's intent is simply:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "propagate this failure")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "But never compress error handling so aggressively that failure paths become invisible.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G59 — Token-Efficient Concurrency")
    strs_push(l, "")
    strs_push(l, "Concurrency syntax must avoid the historical pattern where a small logical operation requires large amounts of:")
    strs_push(l, "")
    strs_push(l, "- callback plumbing;")
    strs_push(l, "- promise chaining;")
    strs_push(l, "- async annotations;")
    strs_push(l, "- synchronization boilerplate;")
    strs_push(l, "- cancellation plumbing;")
    strs_push(l, "- cleanup code.")
    strs_push(l, "")
    strs_push(l, "Structured concurrency should allow the semantic structure itself to remove boilerplate.")
    strs_push(l, "")
    strs_push(l, "Example conceptual form:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "scope {")
    strs_push(l, "    spawn fetch_a()")
    strs_push(l, "    spawn fetch_b()")
    strs_push(l, "}")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "where scope semantics already define lifetime and joining behavior.")
    strs_push(l, "")
    strs_push(l, "Do not force agents to repeatedly generate lifecycle code the compiler/runtime can enforce.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G60 — Token-Efficient Resource Management")
    strs_push(l, "")
    strs_push(l, "Resource safety should reduce code rather than add large cleanup ceremonies.")
    strs_push(l, "")
    strs_push(l, "Ownership and deterministic cleanup should allow:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "acquire")
    strs_push(l, "use")
    strs_push(l, "scope ends")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "instead of repeatedly generating explicit cleanup paths for every exit route.")
    strs_push(l, "")
    strs_push(l, "The compiler should carry more of the proof burden than the source.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G61 — Token-Efficient Generics")
    strs_push(l, "")
    strs_push(l, "Generic systems can become extremely syntax-heavy.")
    strs_push(l, "")
    strs_push(l, "Nazm should avoid unnecessary repetition of:")
    strs_push(l, "")
    strs_push(l, "- generic constraints;")
    strs_push(l, "- lifetime-like annotations;")
    strs_push(l, "- capability requirements;")
    strs_push(l, "- associated type information")
    strs_push(l, "")
    strs_push(l, "when these can be inferred reliably.")
    strs_push(l, "")
    strs_push(l, "But hidden inference must remain inspectable.")
    strs_push(l, "")
    strs_push(l, "Tooling should be able to answer:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "What did the compiler infer here?")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G62 — Token-Efficient Imports and Modules")
    strs_push(l, "")
    strs_push(l, "AI agents regularly spend context tokens understanding module structure.")
    strs_push(l, "")
    strs_push(l, "Nazm should make module relationships:")
    strs_push(l, "")
    strs_push(l, "- explicit;")
    strs_push(l, "- simple;")
    strs_push(l, "- predictable;")
    strs_push(l, "- minimally repetitive.")
    strs_push(l, "")
    strs_push(l, "Avoid deep ceremonial namespace syntax.")
    strs_push(l, "")
    strs_push(l, "Imports should expose enough information for static analysis without forcing repetitive qualification everywhere.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G63 — Token-Efficient Standard Library API Design")
    strs_push(l, "")
    strs_push(l, "API design heavily affects generated-code token volume.")
    strs_push(l, "")
    strs_push(l, "Standard-library APIs should optimize for:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "small composable vocabulary")
    strs_push(l, "+")
    strs_push(l, "consistent naming")
    strs_push(l, "+")
    strs_push(l, "orthogonal operations")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "rather than hundreds of nearly overlapping APIs.")
    strs_push(l, "")
    strs_push(l, "A small number of predictable primitives improves:")
    strs_push(l, "")
    strs_push(l, "- human learning;")
    strs_push(l, "- AI generation;")
    strs_push(l, "- documentation retrieval;")
    strs_push(l, "- autocomplete;")
    strs_push(l, "- semantic search;")
    strs_push(l, "- maintenance.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G64 — Token-Efficient Naming Without Cryptic Naming")
    strs_push(l, "")
    strs_push(l, "Nazm should not encourage meaningless abbreviations merely to save tokens.")
    strs_push(l, "")
    strs_push(l, "Bad:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "mgr")
    strs_push(l, "ctx")
    strs_push(l, "cfg")
    strs_push(l, "x1")
    strs_push(l, "doit")
    strs_push(l, "proc2")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "when meaning is lost.")
    strs_push(l, "")
    strs_push(l, "But language-level concepts should also avoid unnecessarily long ceremonial names.")
    strs_push(l, "")
    strs_push(l, "Token efficiency means:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "short enough to repeat economically")
    strs_push(l, "+")
    strs_push(l, "clear enough to understand without explanation")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Canonical terminology is especially important for AI agents.")
    strs_push(l, "")
    strs_push(l, "One concept should preferably have one standard name.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G65 — Grammar Regularity Is Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Irregular syntax increases reasoning tokens.")
    strs_push(l, "")
    strs_push(l, "If an AI must remember many exceptions, the source may be short while inference becomes expensive.")
    strs_push(l, "")
    strs_push(l, "Therefore Nazm should prefer:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "regular grammar")
    strs_push(l, "consistent declarations")
    strs_push(l, "consistent control flow")
    strs_push(l, "consistent type construction")
    strs_push(l, "consistent resource rules")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "over special-case shorthand.")
    strs_push(l, "")
    strs_push(l, "Predictability reduces reasoning cost.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G66 — Semantic Compression")
    strs_push(l, "")
    strs_push(l, "The strongest form of token efficiency does not come from shorter keywords.")
    strs_push(l, "")
    strs_push(l, "It comes from enabling one construct to encode a large amount of verified meaning.")
    strs_push(l, "")
    strs_push(l, "Example:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "scope")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "may semantically imply:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "child lifetime containment")
    strs_push(l, "joining")
    strs_push(l, "cancellation boundary")
    strs_push(l, "resource cleanup")
    strs_push(l, "failure propagation policy")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "If those guarantees would otherwise require many lines of manual code, the semantic construct provides substantial token compression.")
    strs_push(l, "")
    strs_push(l, "Nazm should pursue this kind of **verified semantic compression**.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G67 — Compiler-Backed Semantic Compression")
    strs_push(l, "")
    strs_push(l, "Whenever the compiler can prove a property, source code should not need to repeatedly restate it.")
    strs_push(l, "")
    strs_push(l, "Candidate examples:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "ownership")
    strs_push(l, "lifetime")
    strs_push(l, "drop order")
    strs_push(l, "task joining")
    strs_push(l, "effect propagation")
    strs_push(l, "capability propagation")
    strs_push(l, "generic specialization")
    strs_push(l, "layout selection")
    strs_push(l, "bounds elimination")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The principle:")
    strs_push(l, "")
    strs_push(l, "> **Move repeatable proof work from source tokens into compiler semantics.**")
    strs_push(l, "")
    strs_push(l, "This is one of the major ways Nazm can become both safer and more token-efficient.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G68 — AI Context Efficiency")
    strs_push(l, "")
    strs_push(l, "For AI agents, repeatedly sending entire files is wasteful.")
    strs_push(l, "")
    strs_push(l, "Nazm tooling should eventually support semantic context retrieval.")
    strs_push(l, "")
    strs_push(l, "Instead of providing:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "50,000 tokens of source")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "an agent could request:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "definition Foo")
    strs_push(l, "callers of Foo")
    strs_push(l, "effects of Foo")
    strs_push(l, "types related to Foo")
    strs_push(l, "tests covering Foo")
    strs_push(l, "recent semantic changes to Foo")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "and receive only relevant context.")
    strs_push(l, "")
    strs_push(l, "Desired flow:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "Agent")
    strs_push(l, "   ↓")
    strs_push(l, "semantic query")
    strs_push(l, "   ↓")
    strs_push(l, "Nazm compiler database")
    strs_push(l, "   ↓")
    strs_push(l, "minimal sufficient context")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This may produce much larger token savings than syntax shortening.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G69 — Minimum Sufficient Context Principle")
    strs_push(l, "")
    strs_push(l, "Nazm AI tooling should attempt to provide the smallest context sufficient to perform a task correctly.")
    strs_push(l, "")
    strs_push(l, "For example:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "modify function X")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "should not automatically require sending:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "entire repository")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Instead the compiler may derive:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "X")
    strs_push(l, "types used by X")
    strs_push(l, "direct semantic dependencies")
    strs_push(l, "affected contracts")
    strs_push(l, "relevant callers")
    strs_push(l, "tests")
    strs_push(l, "capability/effect constraints")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This becomes the agent's task context.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G70 — Semantic Context Packets")
    strs_push(l, "")
    strs_push(l, "Nazm should research a compact machine representation for agent context.")
    strs_push(l, "")
    strs_push(l, "Conceptually:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "ContextPacket {")
    strs_push(l, "    task")
    strs_push(l, "    target_definitions")
    strs_push(l, "    relevant_types")
    strs_push(l, "    invariants")
    strs_push(l, "    effects")
    strs_push(l, "    capabilities")
    strs_push(l, "    dependencies")
    strs_push(l, "    tests")
    strs_push(l, "    diagnostics")
    strs_push(l, "}")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "These packets should be:")
    strs_push(l, "")
    strs_push(l, "- deterministic;")
    strs_push(l, "- versioned;")
    strs_push(l, "- compact;")
    strs_push(l, "- semantically sufficient;")
    strs_push(l, "- source-linked.")
    strs_push(l, "")
    strs_push(l, "An agent should not need to rediscover repository structure every session.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G71 — Semantic Delta Protocol")
    strs_push(l, "")
    strs_push(l, "AI development is usually incremental.")
    strs_push(l, "")
    strs_push(l, "If only one function changed, the next agent interaction should not require retransmitting everything.")
    strs_push(l, "")
    strs_push(l, "Nazm should eventually expose:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "semantic delta")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "such as:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "definitions changed: 2")
    strs_push(l, "types changed: 0")
    strs_push(l, "effects changed: 1")
    strs_push(l, "new callers affected: 3")
    strs_push(l, "tests invalidated: 5")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This can dramatically reduce agent context consumption.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G72 — Patch Token Efficiency")
    strs_push(l, "")
    strs_push(l, "AI agents should return structured edits rather than entire regenerated files whenever possible.")
    strs_push(l, "")
    strs_push(l, "Preferred:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "semantic edit / minimal patch")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "over:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "rewrite 4,000-line file")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Benefits:")
    strs_push(l, "")
    strs_push(l, "- fewer output tokens;")
    strs_push(l, "- fewer accidental regressions;")
    strs_push(l, "- easier review;")
    strs_push(l, "- lower merge conflict;")
    strs_push(l, "- lower inference cost;")
    strs_push(l, "- stronger stale-edit checking.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G73 — Stable Definition Identity")
    strs_push(l, "")
    strs_push(l, "AI context efficiency becomes much stronger if definitions have stable semantic identities.")
    strs_push(l, "")
    strs_push(l, "Instead of repeatedly locating:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "function by filename + textual search")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "tools may refer to:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "definition ID")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "A stable semantic identity can support:")
    strs_push(l, "")
    strs_push(l, "- compact patches;")
    strs_push(l, "- agent queries;")
    strs_push(l, "- caching;")
    strs_push(l, "- dependency graphs;")
    strs_push(l, "- semantic history.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G74 — Token-Efficient Diagnostics")
    strs_push(l, "")
    strs_push(l, "Diagnostics sent to humans and agents have different optimal representations.")
    strs_push(l, "")
    strs_push(l, "Nazm should support both.")
    strs_push(l, "")
    strs_push(l, "Human:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "clear explanation")
    strs_push(l, "source excerpt")
    strs_push(l, "help")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Machine:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "code")
    strs_push(l, "span")
    strs_push(l, "entity")
    strs_push(l, "expected")
    strs_push(l, "actual")
    strs_push(l, "fix")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Do not force an AI agent to parse hundreds of prose tokens if a compact structured representation conveys the same fact.")
    strs_push(l, "")
    strs_push(l, "Example:")
    strs_push(l, "")
    strs_push(l, "```json")
    strs_push(l, "{")
    strs_push(l, "  \"code\": \"E0412\",")
    strs_push(l, "  \"def\": \"D98A\",")
    strs_push(l, "  \"expected\": \"Int\",")
    strs_push(l, "  \"found\": \"Text\",")
    strs_push(l, "  \"span\": [128, 139]")
    strs_push(l, "}")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "The human-readable explanation can be generated separately.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G75 — Diagnostic Verbosity Levels")
    strs_push(l, "")
    strs_push(l, "Tooling should support modes such as:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "human")
    strs_push(l, "compact")
    strs_push(l, "machine")
    strs_push(l, "explain")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "This prevents CI and AI agents from paying token cost for decorative prose they do not need.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G76 — Token-Efficient Build and Test Output")
    strs_push(l, "")
    strs_push(l, "AI agents frequently consume enormous quantities of build logs.")
    strs_push(l, "")
    strs_push(l, "Nazm tooling should provide concise structured summaries by default.")
    strs_push(l, "")
    strs_push(l, "Example:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "FAIL 3/812")
    strs_push(l, "")
    strs_push(l, "E1042 src/net.nz:92")
    strs_push(l, "E3310 src/task.nz:140")
    strs_push(l, "")
    strs_push(l, "affected tests:")
    strs_push(l, "net.timeout")
    strs_push(l, "task.cancel")
    strs_push(l, "task.scope")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Full logs remain retrievable on demand.")
    strs_push(l, "")
    strs_push(l, "The default should communicate **signal, not volume**.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G77 — Progressive Error Disclosure")
    strs_push(l, "")
    strs_push(l, "Diagnostics can follow:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "summary")
    strs_push(l, "   ↓")
    strs_push(l, "relevant evidence")
    strs_push(l, "   ↓")
    strs_push(l, "full explanation on request")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "AI agents and humans should not receive every available detail automatically.")
    strs_push(l, "")
    strs_push(l, "This improves both cognitive and token efficiency.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G78 — Documentation Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Documentation should be structured for selective retrieval.")
    strs_push(l, "")
    strs_push(l, "Instead of forcing agents to consume entire manuals, language documentation should have stable machine-addressable sections for:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "syntax")
    strs_push(l, "semantics")
    strs_push(l, "examples")
    strs_push(l, "invariants")
    strs_push(l, "errors")
    strs_push(l, "profiles")
    strs_push(l, "version changes")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "Documentation should support semantic retrieval rather than only page-based retrieval.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G79 — Specification Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Language specifications should minimize duplicated normative rules.")
    strs_push(l, "")
    strs_push(l, "One rule should ideally have one canonical definition with references from dependent sections.")
    strs_push(l, "")
    strs_push(l, "Duplicated specification text creates:")
    strs_push(l, "")
    strs_push(l, "- token waste;")
    strs_push(l, "- contradictions;")
    strs_push(l, "- stale documentation;")
    strs_push(l, "- AI confusion.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G80 — Repository Token Efficiency")
    strs_push(l, "")
    strs_push(l, "Nazm project structure should help agents reason locally.")
    strs_push(l, "")
    strs_push(l, "Prefer:")
    strs_push(l, "")
    strs_push(l, "```text")
    strs_push(l, "cohesive modules")
    strs_push(l, "clear boundaries")
    strs_push(l, "small interfaces")
    strs_push(l, "explicit dependency direction")
    strs_push(l, "```")
    strs_push(l, "")
    strs_push(l, "over giant files and implicit coupling.")
    strs_push(l, "")
    strs_push(l, "Language architecture affects source token efficiency; repository architecture affects agent token efficiency.")
    strs_push(l, "")
    strs_push(l, "Both matter.")
    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G81 — Tokenizer Independence")
    strs_push(l, "")
    strs_push(l, "Nazm must NOT optimize itself for one company's current tokenizer.")
    strs_push(l, "")
    strs_push(l, "LLM tokenizers will change.")
    strs_push(l, "")
    strs_push(l, "Therefore measurements should include both tokenizer-independent and tokenizer-dependent metrics.")
    strs_push(l, "")
    strs_push(l, "Tokenizer-independent:")
    strs_push(l, "")
    strs_push(l, "```text")
