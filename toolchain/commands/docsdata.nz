    strs_push(l, "")
    strs_push(l, "---")
    strs_push(l, "")
    strs_push(l, "## G89 — Human Intent Artifacts")
    strs_push(l, "")
    strs_push(l, "If humans increasingly operate at architecture level, Nazm tooling should eventually make architectural intent machine-readable.")
