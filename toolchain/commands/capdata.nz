nterpreted\":true,\"compiled\":true},{\"name\":\"atomic_swap\",\"params\":[\"Atomic\",\"Int\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"atomic_compare_swap\",\"params\":[\"Atomic\",\"Int\",\"Int\"],\"returns\":\"Bool\",\"interpreted\":true,\"compiled\":true},{\"name\":\"box_new\",\"params\":[\"T\"],\"returns\":\"Box[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"box_get\",\"params\":[\"Box[T]\"],\"returns\":\"T\",\"interpreted\":true,\"compiled\":true},{\"name\":\"chain_from_vec\",\"params\":[\"Vec[T]\"],\"returns\":\"Chain[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"chain_empty\",\"params\":[],\"returns\":\"Chain[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"chain_len\",\"params\":[\"Chain[T]\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"chain_get\",\"params\":[\"Chain[T]\",\"Int\"],\"returns\":\"T\",\"interpreted\":true,\"compiled\":true},{\"name\":\"cell_new\",\"params\":[\"T\"],\"returns\":\"Cell[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"cell_get\",\"params\":[\"Cell[T]\"],\"returns\":\"T\",\"interpreted\":true,\"compiled\":true},{\"name\":\"cell_set\",\"params\":[\"Cell[T]\",\"T\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"checked_add\",\"params\":[\"T\",\"T\"],\"returns\":\"Option[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"checked_sub\",\"params\":[\"T\",\"T\"],\"returns\":\"Option[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"checked_mul\",\"params\":[\"T\",\"T\"],\"returns\":\"Option[T]\",\"interpreted\":true,\"compiled\":true},{\"name\":\"sel_new\",\"params\":[],\"returns\":\"Select\",\"interpreted\":true,\"compiled\":true},{\"name\":\"sel_recv\",\"params\":[\"Select\",\"Chan[T]\",\"Vec[T]\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"sel_send\",\"params\":[\"Select\",\"Chan[T]\",\"T\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"sel_wait\",\"params\":[\"Select\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true},{\"name\":\"sel_wait_until\",\"params\":[\"Select\",\"Int\"],\"returns\":\"Int\",\"interpreted\":true,\"compiled\":true}],\"constructs\":[{\"name\":\"functions, parameters and direct calls\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/build.rs\"},{\"name\":\"recursion, direct or mutual\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/usability.rs; a stack check on entry to every function in a call cycle, N0408 (docs/user/spec.md, Native recursion)\"},{\"name\":\"`if` in statement and value position\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/build.rs\"},{\"name\":\"`while`, `break`, `continue`, `return`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/build.rs\"},{\"name\":\"a block used as an expression: a `match` arm, an initialiser, an argument\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/value_blocks.rs; the Nazm-written compiler too (selfhost.rs)\"},{\"name\":\"`struct` records: named fields, construction, projection, replacement\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/records.rs, nazm-cli/tests/memory.rs\"},{\"name\":\"`enum` variants and exhaustive `match`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/enums.rs, nazm-cli/tests/memory.rs\"},{\"name\":\"first-order generics: generic records, enums and functions, `Vec[T]`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/generics.rs, nazm-cli/tests/generics.rs, nazm-cli/tests/memory.rs; natively monomorphised, polymorphic recursion refused (N0357)\"},{\"name\":\"`==` and `!=` derived on records, enums and concrete generic instances\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/equality.rs, nazm-cli/tests/equality.rs; none on a sequence, a `Vec` or a `Chan`, or on anything containing one\"},{\"name\":\"a type parameter that requires equality: `fn same[T: Equality]`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/constraints.rs, nazm-cli/tests/constraints.rs; functions only, nothing emitted at run time; the one built-in requirement, a trait the other\"},{\"name\":\"traits and methods: `trait`, `impl Trait for Type`, `x.m()`, `[T: Trait]`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/traits.rs; nominal and static, no trait objects (N0607) and no method values (N0608) (docs/user/spec.md, Traits and methods)\"},{\"name\":\"modules: `use`, relative resolution, diamonds, cycles\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/cli.rs; private by default, `pub` exports (docs/user/spec.md, Visibility)\"},{\"name\":\"re-exports: `pub use \\\"path\\\";` and `pub use \\\"path\\\" { a, b as c };`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/reexports.rs; one definition under another module's names (docs/user/spec.md, `pub use` offers another module's definitions)\"},{\"name\":\"structured concurrency: `scope`, `spawn`, `Chan`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-core/tests/concurrency.rs, nazm-cli/tests/concurrent.rs\"},{\"name\":\"checked arithmetic: overflow, division and remainder by zero\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/build.rs, at -O0 and -O2\"},{\"name\":\"string escapes: `\\\\n` `\\\\t` `\\\\r` `\\\\0` `\\\\\\\\` `\\\\\\\"` `\\\\xHH`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/usability.rs; decoded once, by the lexer (docs/user/spec.md, String escapes)\"},{\"name\":\"logical operators: `&&`, `||` (short-circuit) and `!`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/usability.rs; lowered to `if` in Core IR (docs/user/spec.md, Logical operators)\"},{\"name\":\"qualified names: `use \\\"path\\\" as m;` and `m::item`\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/usability.rs, nazm-service/tests/qualified.rs\"},{\"name\":\"function values: closures, named functions as values, indirect calls\",\"interpreted\":true,\"compiled\":true,\"evidence\":\"nazm-cli/tests/closures.rs; one closure object and calling convention under both backends (docs/user/spec.md, Function values and closures)\"},{\"name\":\"a call to a foreign (C) function\",\"interpreted\":false,\"compiled\":true,\"evidence\":\"deliberate: `nazm run` refuses a foreign call before running anything (N0385); nazm-cli/tests/ffi.rs\"},{\"name\":\"an iteration budget that stops a runaway loop\",\"interpreted\":true,\"compiled\":false,\"evidence\":\"docs/user/spec.md, The iteration and depth limits are the interpreter's: a compiled program has no budget and does not stop\"}]}"
}

// The `toolchain` member of `nazm inspect`: compact, its keys in order.
pub fn cd_toolchain() -> Str {
    "{\"boards\":[{\"emulator\":\"qemu-system-aarch64 -M virt -cpu cortex-a53 -nographic -nic none -semihosting -kernel\",\"hardware\":false,\"load_address\":\"0x40080000\",\"manifest\":\"name = \\\"QEMU virt, AArch64 (Cortex-A53)\\\"\\nisa = \\\"aarch64\\\"\\nload_address = 0x40080000\\nstack = 0x10000\\n\\n[uart]\\nkind = \\\"pl011\\\"\\naddress = 0x9000000\\n\\n[stop]\\nkind = \\\"semihosting\\\"\\n\",\"name\":\"QEMU virt, AArch64 (Cortex-A53)\",\"stop\":{\"kind\":\"arm-semihosting\"},\"triple\":\"aarch64-unknown-none\",\"uart\":\"0x9000000\"},{\"emulator\":\"qemu-system-riscv64 -M virt -bios none -nographic -nic none -kernel\",\"hardware\":false,\"load_address\":\"0x80000000\",\"manifest\":\"name = \\\"QEMU virt, RISC-V RV64GC, machine mode\\\"\\nisa = \\\"riscv64\\\"\\nload_address = 0x80000000\\nstack = 0x10000\\n\\n[uart]\\nkind = \\\"ns16550a\\\"\\naddress = 0x10000000\\n\\n[stop]\\nkind = \\\"sifive-test\\\"\\naddress = 0x100000\\n\",\"name\":\"QEMU virt, RISC-V RV64GC, machine mode\",\"stop\":{\"address\":\"0x100000\",\"kind\":\"sifive-test\"},\"triple\":\"riscv64gc-unknown-none-elf\",\"uart\":\"0x10000000\"},{\"emulator\":\"qemu-system-arm -M mps2-an385 -cpu cortex-m3 -nographic -nic none -semihosting -kernel\",\"hardware\":false,\"load_address\":\"0x0\",\"manifest\":\"name = \\\"QEMU MPS2 AN385, Cortex-M3\\\"\\nisa = \\\"thumbv7m\\\"\\nload_address = 0x0\\nstack = 0x10000\\n\\n[uart]\\nkind = \\\"cmsdk\\\"\\naddress = 0x40004000\\n\\n[stop]\\nkind = \\\"semihosting\\\"\\n\",\"name\":\"QEMU MPS2 AN385, Cortex-M3\",\"stop\":{\"kind\":\"arm-semihosting\"},\"triple\":\"thumbv7m-none-eabi\",\"uart\":\"0x40004000\"},{\"emulator\":\"qemu-system-arm -M mps2-an505 -cpu cortex-m33 -nographic -nic none -semihosting -kernel\",\"hardware\":false,\"load_address\":\"0x10000000\",\"manifest\":\"name = \\\"QEMU MPS2 AN505, Cortex-M33\\\"\\nisa = \\\"thumbv8m.main\\\"\\nload_address = 0x10000000\\nstack = 0x10000\\n\\n[uart]\\nkind = \\\"cmsdk\\\"\\naddress = 0x50200000\\n\\n[stop]\\nkind = \\\"semihosting\\\"\\n\\n[memory]\\nflash = { origin = 0x10000000, length = 0x400000 }\\nram = { origin = 0x38000000, length = 0x200000 }\\n\",\"name\":\"QEMU MPS2 AN505, Cortex-M33\",\"stop\":{\"kind\":\"arm-semihosting\"},\"triple\":\"thumbv8m.main-none-eabihf\",\"uart\":\"0x50200000\"},{\"emulator\":\"qemu-system-riscv32 -M virt -bios none -nographic -nic none -kernel\",\"hardware\":false,\"load_address\":\"0x80000000\",\"manifest\":\"name = \\\"QEMU virt, RISC-V RV32IMC, machine mode\\\"\\nisa = \\\"riscv32\\\"\\nload_address = 0x80000000\\nstack = 0x10000\\n\\n[uart]\\nkind = \\\"ns16550a\\\"\\naddress = 0x10000000\\n\\n[stop]\\nkind = \\\"sifive-test\\\"\\naddress = 0x100000\\n\\n[memory]\\nflash = { origin = 0x80000000, length = 0x100000 }\\nram = { origin = 0x80100000, length = 0x100000 }\\n\",\"name\":\"QEMU virt, RISC-V RV32IMC, machine mode\",\"stop\":{\"address\":\"0x100000\",\"kind\":\"sifive-test\"},\"triple\":\"riscv32imc-unknown-none-elf\",\"uart\":\"0x10000000\"}],\"compiler\":\"0.10.0\",\"cranelift\":\"0.136.1\",\"interface\":\"nazm.interface/13\",\"needs\":{\"link\":\"the C compiler driver links every executable\",\"runtime\":\"clang compiles the runtime's LLVM text, under both backends\"},\"non_goals\":[{\"what\":\"Windows with Microsoft's toolchain, and Windows ARM64\",\"why\":\"unsupported: `x86_64-pc-windows-msvc` needs Microsoft's SDK and C runtime, which are not downloaded or accepted here, and no Windows ARM64 machine or emulator is here; Windows x86_64 is `x86_64-pc-windows-gnu`, with MinGW-w64's\"},{\"what\":\"32-bit hosted targets\",\"why\":\"a non-goal: `Int` is 64-bit and every hosted layout assumes 64-bit pointers; wasm32 — freestanding, or with WASI's imports and its own heap — and the microcontroller boards (`thumbv7m-none-eabi`, `thumbv8m.main-none-eabihf`, `riscv32imc-unknown-none-elf`) are the 32-bit targets, where a C handle, a C string result and a callback are refused by name (`N0381`, Q1-A1-05) because a C pointer crosses as 64 bits\"},{\"what\":\"big-endian targets\",\"why\":\"a non-goal: no big-endian machine or image is here to run one, and the DWARF writer and layouts assume little-endian\"}],\"runtime_abi\":51,\"semantic_epoch\":91,\"support\":[{\"cranelift\":{\"cpu\":\"aarch64 baseline\",\"evidence\":\"a_debug_build_runs_as_an_ordinary_one_and_an_ordinary_one_carries_no_debug_information\",\"status\":\"run-verified\"},\"debugger\":\"lldb, breakpoints resolved statically, both backends\",\"llvm\":{\"cpu\":\"apple-m1\",\"evidence\":\"a_debug_build_runs_as_an_ordinary_one_and_an_ordinary_one_carries_no_debug_information\",\"status\":\"run-verified\"},\"triple\":\"aarch64-apple-darwin\"},{\"cranelift\":{\"cpu\":\"x86-64 baseline (SSE2)\",\"evidence\":\"a_program_for_the_other_macos_architecture_runs_where_rosetta_does\",\"status\":\"run-verified\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"penryn\",\"evidence\":\"a_program_for_the_other_macos_architecture_runs_where_rosetta_does\",\"status\":\"run-verified\"},\"triple\":\"x86_64-apple-darwin\"},{\"cranelift\":{\"cpu\":\"aarch64 baseline\",\"evidence\":\"cargo xtask contained tests\",\"status\":\"run-verified\"},\"debugger\":\"gdb, live, both backends (nazm-debug image)\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"cargo xtask contained tests\",\"status\":\"run-verified\"},\"triple\":\"aarch64-unknown-linux-gnu\"},{\"cranelift\":{\"cpu\":\"x86-64 baseline (SSE2)\",\"evidence\":\"every_target_is_built_by_both_backends_in_its_own_format\",\"status\":\"compile-only\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"x86-64\",\"evidence\":\"every_target_is_built_by_both_backends_in_its_own_format\",\"status\":\"compile-only\"},\"triple\":\"x86_64-unknown-linux-gnu\"},{\"cranelift\":{\"cpu\":\"x86-64 baseline (SSE2)\",\"evidence\":\"scripts/windows-host.sh\",\"status\":\"run-verified on a Windows host\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"x86-64\",\"evidence\":\"scripts/windows-host.sh\",\"status\":\"run-verified on a Windows host\"},\"triple\":\"x86_64-pc-windows-gnu\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"Cranelift's object writer has no format for a target without an operating system\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"the_image_boots_on_qemu_and_reports_on_the_uart\",\"status\":\"run-verified\"},\"triple\":\"aarch64-unknown-none\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"Cranelift's object writer has no format for a target without an operating system\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"generic-rv64\",\"evidence\":\"both_boards_boot_and_agree_under_qemu\",\"status\":\"run-verified\"},\"triple\":\"riscv64gc-unknown-none-elf\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"Cranelift's object writer has no format for a target without an operating system\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"cortex-m3\",\"evidence\":\"an_image_for_the_cortex_m_board_boots_under_qemu\",\"status\":\"run-verified\"},\"triple\":\"thumbv7m-none-eabi\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"Cranelift's object writer has no format for a target without an operating system\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"the_microcontroller_images_boot_and_agree_under_qemu\",\"status\":\"run-verified\"},\"triple\":\"thumbv8m.main-none-eabihf\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"Cranelift's object writer has no format for a target without an operating system\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"generic-rv32\",\"evidence\":\"the_microcontroller_images_boot_and_agree_under_qemu\",\"status\":\"run-verified\"},\"triple\":\"riscv32imc-unknown-none-elf\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"this Cranelift is built without a WebAssembly backend\",\"status\":\"unsupported\"},\"debugger\":\"DWARF sections present; a debugger not exercised\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"the_corpus_runs_as_webassembly_as_the_interpreter_runs_it\",\"status\":\"run-verified\"},\"triple\":\"wasm32-unknown-unknown\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"this Cranelift is built without a WebAssembly backend\",\"status\":\"unsupported\"},\"debugger\":\"DWARF sections present; a debugger not exercised\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"a_wasi_module_has_a_heap_streams_arguments_files_and_clocks\",\"status\":\"run-verified\"},\"triple\":\"wasm32-wasip1\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"the mobile targets are the LLVM backend's: Cranelift is not exercised for them\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"generic\",\"evidence\":\"a_static_bionic_executable_runs_a_nazm_library_and_a_whole_program_on_linux\",\"status\":\"run-verified on a Linux kernel\"},\"triple\":\"aarch64-linux-android\"},{\"cranelift\":{\"cpu\":\"none\",\"evidence\":\"the mobile targets are the LLVM backend's: Cranelift is not exercised for them\",\"status\":\"unsupported\"},\"debugger\":\"not exercised\",\"llvm\":{\"cpu\":\"apple-a7\",\"evidence\":\"an_ios_archive_and_program_link_against_the_ios_sdk\",\"status\":\"compile-only\"},\"triple\":\"aarch64-apple-ios\"}],\"target\":\"aarch64-apple-darwin\",\"targets\":[{\"output\":\"executable\",\"triple\":\"aarch64-apple-darwin\"},{\"output\":\"executable\",\"triple\":\"x86_64-apple-darwin\"},{\"output\":\"objects\",\"triple\":\"aarch64-unknown-linux-gnu\"},{\"output\":\"objects\",\"triple\":\"x86_64-unknown-linux-gnu\"},{\"output\":\"objects\",\"triple\":\"x86_64-pc-windows-gnu\"},{\"output\":\"objects\",\"triple\":\"aarch64-unknown-none\"},{\"output\":\"objects\",\"triple\":\"riscv64gc-unknown-none-elf\"},{\"output\":\"objects\",\"triple\":\"thumbv7m-none-eabi\"},{\"output\":\"objects\",\"triple\":\"thumbv8m.main-none-eabihf\"},{\"output\":\"objects\",\"triple\":\"riscv32imc-unknown-none-elf\"},{\"output\":\"objects\",\"triple\":\"wasm32-unknown-unknown\"},{\"output\":\"objects\",\"triple\":\"wasm32-wasip1\"},{\"output\":\"objects\",\"triple\":\"aarch64-linux-android\"},{\"output\":\"objects\",\"triple\":\"aarch64-apple-ios\"}]}"
}

// The text, a line to each push; every line ends in a line break.
pub fn cd_text() -> Str {
    let lines = strs_new()
    strs_push(lines, "nazm 0.10.0")
    strs_push(lines, "native target: verified on aarch64-apple-darwin with Apple clang; other targets are unverified rather than unsupported")
    strs_push(lines, "")
    strs_push(lines, "types: Int, Bool, Str, Ints, Strs, Chan, IoCap, SpawnCap, ForeignCap, VouchCap, TimeCap, MmioCap, OutCap, NetCap, RandomCap, ProcessCap, Int8, Int16, Int32, UInt8, UInt16, UInt32, UInt64, Float32, Float64, Bytes, Text, OsHandle, Atomic, Int128, UInt128, Select")
    strs_push(lines, "authority: IoCap, SpawnCap, ForeignCap, VouchCap, TimeCap, MmioCap, OutCap, NetCap, RandomCap, ProcessCap")
    strs_push(lines, "targets: aarch64-apple-darwin, x86_64-apple-darwin, aarch64-unknown-linux-gnu, x86_64-unknown-linux-gnu, x86_64-pc-windows-gnu, aarch64-unknown-none, riscv64gc-unknown-none-elf, thumbv7m-none-eabi, thumbv8m.main-none-eabihf, riscv32imc-unknown-none-elf, wasm32-unknown-unknown, wasm32-wasip1, aarch64-linux-android, aarch64-apple-ios")
    strs_push(lines, "commands: run, check, fix, context, snapshot, delta, diagnostics, docs, repo, patch, lsp, fmt, test, bench, repl, comptime, contract, accel, reload-check, resolve, references, interface, core-ir, trace, obligations, mir, runtime, lir, doc, bindgen, init, doctor, capabilities, build, inspect, profile, explain-cost, explain-flow, attest, lock, update, publish, yank")
    strs_push(lines, "")
    strs_push(lines, "  constructs                                                                 run    build  evidence")
    strs_push(lines, "  functions, parameters and direct calls                                     yes    yes    nazm-cli/tests/build.rs")
    strs_push(lines, "  recursion, direct or mutual                                                yes    yes    nazm-cli/tests/usability.rs; a stack check on entry to every function in a call cycle, N0408 (docs/user/spec.md, Native recursion)")
    strs_push(lines, "  `if` in statement and value position                                       yes    yes    nazm-cli/tests/build.rs")
    strs_push(lines, "  `while`, `break`, `continue`, `return`                                     yes    yes    nazm-cli/tests/build.rs")
    strs_push(lines, "  a block used as an expression: a `match` arm, an initialiser, an argument  yes    yes    nazm-cli/tests/value_blocks.rs; the Nazm-written compiler too (selfhost.rs)")
    strs_push(lines, "  `struct` records: named fields, construction, projection, replacement      yes    yes    nazm-core/tests/records.rs, nazm-cli/tests/memory.rs")
    strs_push(lines, "  `enum` variants and exhaustive `match`                                     yes    yes    nazm-core/tests/enums.rs, nazm-cli/tests/memory.rs")
    strs_push(lines, "  first-order generics: generic records, enums and functions, `Vec[T]`       yes    yes    nazm-core/tests/generics.rs, nazm-cli/tests/generics.rs, nazm-cli/tests/memory.rs; natively monomorphised, polymorphic recursion refused (N0357)")
    strs_push(lines, "  `==` and `!=` derived on records, enums and concrete generic instances     yes    yes    nazm-core/tests/equality.rs, nazm-cli/tests/equality.rs; none on a sequence, a `Vec` or a `Chan`, or on anything containing one")
    strs_push(lines, "  a type parameter that requires equality: `fn same[T: Equality]`            yes    yes    nazm-core/tests/constraints.rs, nazm-cli/tests/constraints.rs; functions only, nothing emitted at run time; the one built-in requirement, a trait the other")
    strs_push(lines, "  traits and methods: `trait`, `impl Trait for Type`, `x.m()`, `[T: Trait]`  yes    yes    nazm-cli/tests/traits.rs; nominal and static, no trait objects (N0607) and no method values (N0608) (docs/user/spec.md, Traits and methods)")
    strs_push(lines, "  modules: `use`, relative resolution, diamonds, cycles                      yes    yes    nazm-cli/tests/cli.rs; private by default, `pub` exports (docs/user/spec.md, Visibility)")
    strs_push(lines, "  re-exports: `pub use \"path\";` and `pub use \"path\" { a, b as c };`          yes    yes    nazm-cli/tests/reexports.rs; one definition under another module's names (docs/user/spec.md, `pub use` offers another module's definitions)")
    strs_push(lines, "  structured concurrency: `scope`, `spawn`, `Chan`                           yes    yes    nazm-core/tests/concurrency.rs, nazm-cli/tests/concurrent.rs")
    strs_push(lines, "  checked arithmetic: overflow, division and remainder by zero               yes    yes    nazm-cli/tests/build.rs, at -O0 and -O2")
    strs_push(lines, "  string escapes: `\\n` `\\t` `\\r` `\\0` `\\\\` `\\\"` `\\xHH`                       yes    yes    nazm-cli/tests/usability.rs; decoded once, by the lexer (docs/user/spec.md, String escapes)")
    strs_push(lines, "  logical operators: `&&`, `||` (short-circuit) and `!`                      yes    yes    nazm-cli/tests/usability.rs; lowered to `if` in Core IR (docs/user/spec.md, Logical operators)")
    strs_push(lines, "  qualified names: `use \"path\" as m;` and `m::item`                          yes    yes    nazm-cli/tests/usability.rs, nazm-service/tests/qualified.rs")
    strs_push(lines, "  function values: closures, named functions as values, indirect calls       yes    yes    nazm-cli/tests/closures.rs; one closure object and calling convention under both backends (docs/user/spec.md, Function values and closures)")
    strs_push(lines, "  a call to a foreign (C) function                                           no     yes    deliberate: `nazm run` refuses a foreign call before running anything (N0385); nazm-cli/tests/ffi.rs")
    strs_push(lines, "  an iteration budget that stops a runaway loop                              yes    no     docs/user/spec.md, The iteration and depth limits are the interpreter's: a compiled program has no budget and does not stop")
