// A reader for the subset of TOML the toolchain's own files are written in (R5, design D21; R8 slice 9 added the forms the
// repository's `Cargo.toml`s and mutation catalogue use): a package's `nazm.toml`, a `nazm.lock`, a registry's
// `index/NAME.toml`, a `Cargo.toml`. Comments, `[table]` and `[[array of tables]]` headers (dotted names), `key = value`
// with a bare, quoted or dotted key, and for values basic, literal and multi-line strings, booleans, decimal integers,
// arrays (on several lines too) and inline tables. Anything else — floats, dates, a multi-line string with a carriage
// return, a key given twice, a line the grammar cannot read — is not guessed at: the tree is marked unsupported with the
// reason, and the command refuses (the `toml` crate's own error text is what the reference prints for those).
//
// The tree keeps every table's keys in document order, which is the order serde's derived readers
// meet them — the first error a manifest gives is the first thing in the file that is wrong.

// Node kinds.
pub fn tm_string() -> Int { 1 }
pub fn tm_bool() -> Int { 2 }
pub fn tm_int() -> Int { 3 }
pub fn tm_array() -> Int { 4 }
pub fn tm_table() -> Int { 5 }

pub struct Toml {
    kind: Ints,
    // A string's bytes, an integer's text, "true" or "false".
    text: Strs,
    // Per node: its key in its table, its first child and its next sibling.
    key: Strs,
    first: Ints,
    next: Ints,
    last: Ints,
    // 1 where the node is a table that was written as an array of tables' element or a header's table
    // (so a later header may not define it again as a value).
    explicit: Ints,
    // Why the text is not read ("" when it is), and the cursor.
    why: Strs,
    // The `toml` crate's own words for a syntax error this reader knows them for ("" for none).
    msg: Strs,
    at: Ints,
    src: Strs,
}

fn tm_node(t: Toml, kind: Int, text: Str, key: Str) -> Int {
    ints_push(t.kind, kind)
    strs_push(t.text, text)
    strs_push(t.key, key)
    ints_push(t.first, 0 - 1)
    ints_push(t.next, 0 - 1)
    ints_push(t.last, 0 - 1)
    ints_push(t.explicit, 0)
    ints_len(t.kind) - 1
}

fn tm_add(t: Toml, parent: Int, child: Int) -> Int {
    if ints_get(t.first, parent) < 0 {
        ints_set(t.first, parent, child)
    } else {
        ints_set(t.next, ints_get(t.last, parent), child)
    }
    ints_set(t.last, parent, child)
    0
}

fn tm_unsupported(t: Toml, why: Str) -> Int {
    if strs_get(t.why, 0) == "" { strs_set(t.why, 0, why) }
    0 - 1
}

// A syntax error the `toml` crate words as `msg`.
fn tm_syntax(t: Toml, msg: Str) -> Int {
    if strs_get(t.why, 0) == "" {
        strs_set(t.why, 0, "a syntax error")
        strs_set(t.msg, 0, msg)
    }
    0 - 1
}

// The crate's message for the error, or "" where the text is merely not read by this reader.
pub fn tm_message(t: Toml) -> Str { strs_get(t.msg, 0) }

pub fn tm_ok(t: Toml) -> Bool { strs_get(t.why, 0) == "" }
pub fn tm_why(t: Toml) -> Str { strs_get(t.why, 0) }

// The member `key` of table `n`, or -1.
pub fn tm_get(t: Toml, n: Int, key: Str) -> Int {
    if n < 0 || ints_get(t.kind, n) != tm_table() { return 0 - 1 }
    let mut c = ints_get(t.first, n)
    while c >= 0 {
        if strs_get(t.key, c) == key { return c }
        c = ints_get(t.next, c)
    }
    0 - 1
}

pub fn tm_kind(t: Toml, n: Int) -> Int { if n < 0 { 0 - 1 } else { ints_get(t.kind, n) } }
pub fn tm_text(t: Toml, n: Int) -> Str { strs_get(t.text, n) }
pub fn tm_key(t: Toml, n: Int) -> Str { strs_get(t.key, n) }
pub fn tm_first(t: Toml, n: Int) -> Int { ints_get(t.first, n) }
pub fn tm_next(t: Toml, n: Int) -> Int { ints_get(t.next, n) }

fn is_bare(b: Int) -> Bool { (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 }

fn peek(t: Toml) -> Int {
    let s = strs_get(t.src, 0)
    let i = ints_get(t.at, 0)
    if i >= str_len(s) { 0 - 1 } else { str_byte(s, i) }
}

fn skip_blanks(t: Toml) -> Int {
    let s = strs_get(t.src, 0)
    let mut i = ints_get(t.at, 0)
    while i < str_len(s) && (str_byte(s, i) == 32 || str_byte(s, i) == 9) { i += 1 }
    ints_set(t.at, 0, i)
    0
}

fn hex_val(b: Int) -> Int {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 102 { return b - 87 }
    if b >= 65 && b <= 70 { return b - 55 }
    0 - 1
}

fn utf8_of(cp: Int) -> Str {
    if cp < 128 { return str_from_byte(cp) }
    if cp < 2048 { return str_from_byte(192 + cp / 64) + str_from_byte(128 + cp % 64) }
    if cp < 65536 { return str_from_byte(224 + cp / 4096) + str_from_byte(128 + (cp / 64) % 64) + str_from_byte(128 + cp % 64) }
    str_from_byte(240 + cp / 262144) + str_from_byte(128 + (cp / 4096) % 64) + str_from_byte(128 + (cp / 64) % 64) + str_from_byte(128 + cp % 64)
}

// The escape whose backslash is at `i` of `s`, decoded into `out`; the index after it, or -1 with the tree marked where it is bad.
fn read_escape(t: Toml, s: Str, i0: Int, out: Strs) -> Int {
    let mut i = i0
    if i + 1 >= str_len(s) {
        tm_syntax(t, "invalid basic string, expected `\"`")
        return 0 - 1
    }
    let e = str_byte(s, i + 1)
    i += 2
    if e == 34 { strs_push(out, "\"") } else if e == 92 { strs_push(out, "\\") } else if e == 98 { strs_push(out, str_from_byte(8)) }
            else if e == 102 { strs_push(out, str_from_byte(12)) } else if e == 110 { strs_push(out, str_from_byte(10)) }
            else if e == 114 { strs_push(out, str_from_byte(13)) } else if e == 116 { strs_push(out, str_from_byte(9)) }
            else if e == 101 { strs_push(out, str_from_byte(27)) }
            else if e == 117 || e == 85 {
        let n = if e == 117 { 4 } else { 8 }
        let mut cp = 0
        for k in 0..n {
            let h = if i + k < str_len(s) { hex_val(str_byte(s, i + k)) } else { 0 - 1 }
            if h < 0 {
                tm_unsupported(t, "a bad unicode escape")
                return 0 - 1
            }
            cp = cp * 16 + h
        }
        if cp > 1114111 || (cp >= 55296 && cp <= 57343) {
            tm_unsupported(t, "a bad unicode escape")
            return 0 - 1
        }
        i += n
        strs_push(out, utf8_of(cp))
    } else {
        tm_syntax(t, "missing escaped value, expected `b`, `e`, `f`, `n`, `r`, `\\`, `\"`, `x`, `u`, `U`")
        return 0 - 1
    }
    i
}

// A multi-line string (`"""…"""` or `'''…'''`) whose opening quotes begin at the cursor, decoded: a newline right after the opening
// quotes is dropped, a basic string's `\` at a line's end takes the whitespace after it, and up to two quotes may end the text.
// A carriage return is not read (the tree is marked unsupported).
fn read_multiline(t: Toml) -> Str {
    let s = strs_get(t.src, 0)
    let q = peek(t)
    let mut i = ints_get(t.at, 0) + 3
    if i < str_len(s) && str_byte(s, i) == 10 { i += 1 }
    let out = strs_new()
    let mut from = i
    while i < str_len(s) {
        let b = str_byte(s, i)
        if b == q {
            let mut n = 0
            while i + n < str_len(s) && str_byte(s, i + n) == q { n += 1 }
            if n >= 3 {
                if n > 5 {
                    tm_syntax(t, "invalid multi-line string")
                    return ""
                }
                strs_push(out, str_slice(s, from, i + n - 3))
                ints_set(t.at, 0, i + n)
                return str_join(out, "")
            }
            i += n
        } else if b == 13 || (b < 32 && b != 9 && b != 10) || b == 127 {
            tm_unsupported(t, "a multi-line string with a carriage return or a control character")
            return ""
        } else if q == 34 && b == 92 {
            strs_push(out, str_slice(s, from, i))
            let e = if i + 1 < str_len(s) { str_byte(s, i + 1) } else { 0 - 1 }
            if e == 32 || e == 9 || e == 10 {
                // A line-ending backslash: the whitespace after it, line breaks included, is dropped.
                let mut j = i + 1
                while j < str_len(s) && (str_byte(s, j) == 32 || str_byte(s, j) == 9) { j += 1 }
                if j >= str_len(s) || str_byte(s, j) != 10 {
                    tm_syntax(t, "missing escaped value, expected `b`, `e`, `f`, `n`, `r`, `\\`, `\"`, `x`, `u`, `U`")
                    return ""
                }
                while j < str_len(s) && (str_byte(s, j) == 32 || str_byte(s, j) == 9 || str_byte(s, j) == 10) { j += 1 }
                i = j
            } else {
                i = read_escape(t, s, i, out)
                if i < 0 { return "" }
            }
            from = i
        } else {
            i += 1
        }
    }
    tm_unsupported(t, "an unterminated multi-line string")
    ""
}

// A basic (`"…"`) or literal (`'…'`) string at the cursor, decoded; "" with the tree unsupported where
// it is anything else (a control character, a bad escape).
fn read_string(t: Toml) -> Str {
    let s = strs_get(t.src, 0)
    let q = peek(t)
    let mut i = ints_get(t.at, 0) + 1
    if i + 1 < str_len(s) && str_byte(s, i) == q && str_byte(s, i + 1) == q { return read_multiline(t) }
    let out = strs_new()
    let mut from = i
    while i < str_len(s) && str_byte(s, i) != q {
        let b = str_byte(s, i)
        if b == 10 || (b < 32 && b != 9) || b == 127 {
            if q == 34 && b == 10 { tm_syntax(t, "invalid basic string, expected `\"`") } else { tm_unsupported(t, "a string that ends at a line's end or holds a control character") }
            return ""
        }
        if q == 34 && b == 92 {
            strs_push(out, str_slice(s, from, i))
            i = read_escape(t, s, i, out)
            if i < 0 { return "" }
            from = i
        } else {
            i += 1
        }
    }
    if i >= str_len(s) {
        if q == 34 { tm_syntax(t, "invalid basic string, expected `\"`") } else { tm_unsupported(t, "an unterminated string") }
        return ""
    }
    strs_push(out, str_slice(s, from, i))
    ints_set(t.at, 0, i + 1)
    str_join(out, "")
}

fn read_key(t: Toml) -> Str {
    let s = strs_get(t.src, 0)
    let c = peek(t)
    if c == 34 || c == 39 { return read_string(t) }
    let from = ints_get(t.at, 0)
    let mut i = from
    while i < str_len(s) && is_bare(str_byte(s, i)) { i += 1 }
    if i == from {
        if c == 61 { tm_syntax(t, "unquoted keys cannot be empty, expected letters, numbers, `-`, `_`") } else { tm_unsupported(t, "a key this reader does not read") }
        return ""
    }
    ints_set(t.at, 0, i)
    str_slice(s, from, i)
}

// A value at the cursor, as a node (not yet in a table); -1 where unsupported.
fn read_value(t: Toml, key: Str) -> Int {
    skip_blanks(t)
    let s = strs_get(t.src, 0)
    let c = peek(t)
    let i = ints_get(t.at, 0)
    if c == 34 || c == 39 {
        let text = read_string(t)
        if !tm_ok(t) { return 0 - 1 }
        return tm_node(t, tm_string(), text, key)
    }
    if c == 91 {
        let n = tm_node(t, tm_array(), "", key)
        ints_set(t.at, 0, i + 1)
        skip_all(t)
        while peek(t) != 93 {
            let v = read_value(t, "")
            if v < 0 { return 0 - 1 }
            tm_add(t, n, v)
            skip_all(t)
            if peek(t) == 44 {
                ints_set(t.at, 0, ints_get(t.at, 0) + 1)
                skip_all(t)
            } else if peek(t) != 93 {
                return tm_unsupported(t, "an array this reader does not read")
            }
        }
        ints_set(t.at, 0, ints_get(t.at, 0) + 1)
        return n
    }
    if c == 123 {
        let n = tm_node(t, tm_table(), "", key)
        ints_set(t.at, 0, i + 1)
        skip_blanks(t)
        if peek(t) == 125 {
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            return n
        }
        while true {
            skip_blanks(t)
            let k = read_key(t)
            if !tm_ok(t) { return 0 - 1 }
            skip_blanks(t)
            if peek(t) != 61 { return tm_unsupported(t, "an inline table this reader does not read") }
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            let v = read_value(t, k)
            if v < 0 { return 0 - 1 }
            if tm_get(t, n, k) >= 0 { return tm_syntax(t, "duplicate key") }
            tm_add(t, n, v)
            skip_blanks(t)
            let p = peek(t)
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            if p == 125 { return n }
            if p != 44 { return tm_unsupported(t, "an inline table this reader does not read") }
        }
        return n
    }
    if str_len(s) >= i + 4 && str_slice(s, i, i + 4) == "true" && (i + 4 >= str_len(s) || !is_bare(str_byte(s, i + 4))) {
        ints_set(t.at, 0, i + 4)
        return tm_node(t, tm_bool(), "true", key)
    }
    if str_len(s) >= i + 5 && str_slice(s, i, i + 5) == "false" && (i + 5 >= str_len(s) || !is_bare(str_byte(s, i + 5))) {
        ints_set(t.at, 0, i + 5)
        return tm_node(t, tm_bool(), "false", key)
    }
    if c == 45 || c == 43 || (c >= 48 && c <= 57) {
        let mut e = i + 1
        while e < str_len(s) && str_byte(s, e) >= 48 && str_byte(s, e) <= 57 { e += 1 }
        if e < str_len(s) && (is_bare(str_byte(s, e)) || str_byte(s, e) == 46 || str_byte(s, e) == 58) { return tm_unsupported(t, "a number or date this reader does not read") }
        let text = str_slice(s, i, e)
        let sign = if c == 45 || c == 43 { 1 } else { 0 }
        if text == "-" || text == "+" || (str_len(text) > sign + 1 && str_byte(text, sign) == 48) { return tm_unsupported(t, "a number this reader does not read") }
        ints_set(t.at, 0, e)
        return tm_node(t, tm_int(), if c == 43 { str_slice(text, 1, str_len(text)) } else { text }, key)
    }
    let rest = i >= str_len(s) || c == 10 || c == 13 || c == 35 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    if rest { return tm_syntax(t, "string values must be quoted, expected literal string") }
    tm_unsupported(t, "a value this reader does not read")
}

// Whitespace, comments and line breaks inside an array.
fn skip_all(t: Toml) -> Int {
    let s = strs_get(t.src, 0)
    let mut i = ints_get(t.at, 0)
    while i < str_len(s) {
        let b = str_byte(s, i)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i += 1
        } else if b == 35 {
            while i < str_len(s) && str_byte(s, i) != 10 { i += 1 }
        } else {
            ints_set(t.at, 0, i)
            return 0
        }
    }
    ints_set(t.at, 0, i)
    0
}

// The rest of a line must be blank or a comment.
fn end_of_line(t: Toml) -> Bool {
    skip_blanks(t)
    let s = strs_get(t.src, 0)
    let mut i = ints_get(t.at, 0)
    if i < str_len(s) && str_byte(s, i) == 35 {
        while i < str_len(s) && str_byte(s, i) != 10 { i += 1 }
    }
    if i < str_len(s) && str_byte(s, i) == 13 && i + 1 < str_len(s) && str_byte(s, i + 1) == 10 { i += 1 }
    ints_set(t.at, 0, i)
    i >= str_len(s) || str_byte(s, i) == 10
}

// The table named by a header's path from the root, creating what is missing; the last one is an array
// element when `array`. -1 where unsupported.
fn descend(t: Toml, path: Strs, array: Bool) -> Int {
    let mut cur = 0
    for i in 0..strs_len(path) {
        let k = strs_get(path, i)
        let last = i + 1 == strs_len(path)
        let mut c = tm_get(t, cur, k)
        if c < 0 {
            c = tm_node(t, tm_table(), "", k)
            if last && array {
                // An array of tables: the array holds the elements, the cursor is the new element.
                let arr = tm_node(t, tm_array(), "", k)
                ints_set(t.explicit, arr, 2)
                tm_add(t, cur, arr)
                c = tm_node(t, tm_table(), "", "")
                tm_add(t, arr, c)
            } else {
                tm_add(t, cur, c)
            }
            ints_set(t.explicit, c, 1)
        } else if ints_get(t.kind, c) == tm_array() && ints_get(t.explicit, c) == 2 {
            if last && array {
                let e = tm_node(t, tm_table(), "", "")
                ints_set(t.explicit, e, 1)
                tm_add(t, c, e)
                c = e
            } else {
                // The latest element of an array of tables.
                c = ints_get(t.last, c)
            }
        } else if ints_get(t.kind, c) == tm_table() {
            if last && !array {
                if ints_get(t.explicit, c) == 1 || ints_get(t.explicit, c) == 3 { return tm_syntax(t, "duplicate key") }
                ints_set(t.explicit, c, 1)
            }
            if last && array { return tm_unsupported(t, "a table redefined as an array of tables") }
        } else {
            return tm_unsupported(t, "a header that names a value")
        }
        cur = c
    }
    cur
}

// The table a dotted key names by `key` in `holder`, made (marked 3, which a header may not define again) where there is none; -1 where
// `key` is already something else.
fn dotted_table(t: Toml, holder: Int, key: Str) -> Int {
    let c = tm_get(t, holder, key)
    if c < 0 {
        let n = tm_node(t, tm_table(), "", key)
        tm_add(t, holder, n)
        ints_set(t.explicit, n, 3)
        return n
    }
    if ints_get(t.kind, c) == tm_table() && ints_get(t.explicit, c) == 3 { return c }
    tm_syntax(t, "duplicate key")
    0 - 1
}

pub fn tm_parse(text: Str) -> Toml {
    let t = Toml(kind: ints_new(), text: strs_new(), key: strs_new(), first: ints_new(), next: ints_new(), last: ints_new(), explicit: ints_new(),
            why: strs_new(), msg: strs_new(), at: ints_new(), src: strs_new())
    strs_push(t.why, "")
    strs_push(t.msg, "")
    ints_push(t.at, 0)
    strs_push(t.src, text)
    tm_node(t, tm_table(), "", "")
    let s = text
    let mut cur = 0
    while ints_get(t.at, 0) < str_len(s) && tm_ok(t) {
        skip_blanks(t)
        let c = peek(t)
        if c < 0 { break }
        if c == 10 || c == 13 {
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            continue
        }
        if c == 35 {
            end_of_line(t)
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            continue
        }
        if c == 91 {
            let array = ints_get(t.at, 0) + 1 < str_len(s) && str_byte(s, ints_get(t.at, 0) + 1) == 91
            ints_set(t.at, 0, ints_get(t.at, 0) + (if array { 2 } else { 1 }))
            let path = strs_new()
            while true {
                skip_blanks(t)
                let k = read_key(t)
                if !tm_ok(t) { break }
                strs_push(path, k)
                skip_blanks(t)
                if peek(t) == 46 {
                    ints_set(t.at, 0, ints_get(t.at, 0) + 1)
                } else {
                    break
                }
            }
            if !tm_ok(t) { break }
            if peek(t) != 93 {
                if peek(t) == 10 || peek(t) == 13 || peek(t) < 0 { tm_syntax(t, "unclosed table, expected `]`") } else { tm_unsupported(t, "a header this reader does not read") }
                break
            }
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            if array {
                if peek(t) != 93 {
                    tm_unsupported(t, "a header this reader does not read")
                    break
                }
                ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            }
            if !end_of_line(t) {
                tm_unsupported(t, "text after a header")
                break
            }
            cur = descend(t, path, array)
            if cur < 0 { break }
            continue
        }
        let mut k = read_key(t)
        if !tm_ok(t) { break }
        skip_blanks(t)
        // A dotted key's tables, made as the keys are met, and the table the last key is in.
        let mut holder = cur
        while peek(t) == 46 {
            holder = dotted_table(t, holder, k)
            if holder < 0 { break }
            ints_set(t.at, 0, ints_get(t.at, 0) + 1)
            skip_blanks(t)
            k = read_key(t)
            if !tm_ok(t) { break }
            skip_blanks(t)
        }
        if holder < 0 || !tm_ok(t) { break }
        if peek(t) != 61 {
            tm_syntax(t, "key with no value, expected `=`")
            break
        }
        ints_set(t.at, 0, ints_get(t.at, 0) + 1)
        let v = read_value(t, k)
        if v < 0 { break }
        if tm_get(t, holder, k) >= 0 {
            tm_syntax(t, "duplicate key")
            break
        }
        tm_add(t, holder, v)
        if !end_of_line(t) {
            tm_syntax(t, "unexpected key or value, expected newline, `#`")
            break
        }
    }
    t
}
