// `nazm lsp`, written in Nazm (R5, `openspec/changes/r5-commands/`, design D15).
//
// `nazm lsp [--source-root DIR]`, run by the dispatcher (`nazm.nz`): the Language Server Protocol
// over standard input and output, a port of `crates/nazm-cli/src/lsp.rs` (and of what it asks of
// `lsp-server` and `nazm_service::LanguageService`) over R2's published facts
// (`compiler/facts.nz`).
//
// Carried: the framing (`Content-Length`, a blank line, the JSON body), the handshake —
// `initialize` answered with the reference's capabilities, then `initialized` — `shutdown` and
// `exit`, the end of input, a method the reference does not implement (`MethodNotFound`, which is
// `textDocument/formatting` too: the reference offers no formatting), the documents' lifecycle
// (`didOpen`, `didChange` applied range by range in UTF-16 positions, `didClose`) with each
// document's diagnostics published as the reference publishes them, its text standing for its file
// whether saved or not (`fx_check_over`); `hover` of a local of any type (`fx_show`) and of a call
// to a plain function (its signature and effects); `definition` of a local and of what the checker
// records a name refers to (`fx_declaration_at`: a function called or used as a value, a record
// built, a variant named), and in a compilation with no errors of anything the reference index
// (`fx_ref_*`) knows; `references`, `prepareRename` and `rename` (the candidate program checked again), `documentSymbol` and
// `workspace/symbol` (design D23); `--source-root`; and `null` where the reference answers nothing (no
// name, a built-in called, a function's own name where it is declared, a field or variant after
// `.`, a declaration in the standard library).
//
// Not carried, refused with status 6 on standard error (design D5) before anything else is
// written: more than one document open at once (the reference publishes them in a hash map's
// order), a compilation that does not load or that the front end stops at; hover of a method, a
// generic or foreign function or a call through a value, hover of a name the checker publishes no
// binding for, definition of what the facts index no declaration for in a compilation with errors the
// index is not promised for; completion, signature help, semantic tokens, code actions and call
// hierarchy; a rename of an exported name in a declared workspace; and any message the reference's
// parsers would read differently from this port's.
//
// Standard output is the protocol: nothing else is ever written there.

use "../../compiler/lex.nz"
use "../../compiler/syntax.nz"
use "../../compiler/diag.nz"
use "../../compiler/sema.nz"
use "../../compiler/package.nz"
use "../../compiler/facts.nz"
use "cli.nz"
use "front.nz"
use "jsonin.nz"
use "util.nz"
use "rename.nz"

fn nl() -> Str { str_from_byte(10) }
fn crlf() -> Str { str_from_byte(13) + str_from_byte(10) }

// The command line, as `crates/nazm-cli/src/cli.rs` declares `nazm lsp`.
pub fn lsp_cli() -> Cli {
    let c = cli_command("lsp", "Serve the Language Server Protocol to an editor, on stdin and stdout",
            "Serve the Language Server Protocol to an editor, on stdin and stdout." + nl() + nl()
            + "Started and owned by the editor; ends when it says `exit`. Diagnostics, definition and hover, from the same "
            + "loader and checker every other command uses, over the editor's unsaved buffers. `docs/internal/architecture.md` §7.18 "
            + "says what it does and does not do.")
    cli_option(c, "", "source-root", "SOURCE_ROOT", true, "", false, "Measure every module's durable identity from this directory, as "
            + "`nazm check --source-root` does. Without it, each open file's root is decided exactly as `nazm check` decides "
            + "it for that file", "")
    c
}

fn refuse(io: IoCap, why: Str) -> Int {
    eprint("lsp: not carried: " + why + nl())
    exit_with(6)
    0
}

// --- JSON in --------------------------------------------------------------------------------------

fn hex_digit(b: Int) -> Int {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 102 { return b - 87 }
    if b >= 65 && b <= 70 { return b - 55 }
    0 - 1
}

// --- the documents --------------------------------------------------------------------------------

struct Server {
    paths: Strs,
    versions: Ints,
    texts: Strs,
    // The facts of the one open document's current analysis (`facts` holds 0 or 1).
    facts: Vec[Facts],
    library: Strs,
    // `--source-root`, absolute, or "" to decide each document's root as `check` does.
    root: Strs,
    // What the client said it reads: versioned edits (`documentChanges`), nested symbols.
    flags: Ints,
}

// The open document the request being handled is about (set where its document is looked up: `doc_named`).
fn cur(s: Server) -> Int { ints_get(s.flags, 3) }

fn doc_index(s: Server, path: Str) -> Int {
    for i in 0..strs_len(s.paths) {
        if strs_get(s.paths, i) == path { return i }
    }
    0 - 1
}

// The open document `path` names, refused where another spelling names the same file: the
// reference keys documents by the file, this port by the path as written.
fn doc_named(io: IoCap, s: Server, path: Str) -> Int {
    let k = doc_index(s, path)
    if k >= 0 {
        ints_set(s.flags, 3, k)
        return k
    }
    let canon = fe_canonical(io, path)
    for i in 0..strs_len(s.paths) {
        let other = fe_canonical(io, strs_get(s.paths, i))
        if canon != "" && other == canon { refuse(io, "a document named by another spelling of its path") }
        if canon == "" && pk_normalise(path) == pk_normalise(strs_get(s.paths, i)) { refuse(io, "a document named by another spelling of its path") }
    }
    0 - 1
}

// --- positions: byte offsets and UTF-16 lines and columns (`LineIndex`) ----------------------------

fn line_starts(text: Str) -> Ints {
    let out = ints_new()
    ints_push(out, 0)
    let n = str_len(text)
    for i in 0..n {
        let b = str_byte(text, i)
        if b == 10 { ints_push(out, i + 1) }
        if b == 13 && (i + 1 >= n || str_byte(text, i + 1) != 10) { ints_push(out, i + 1) }
    }
    out
}

// The UTF-16 units of the character whose first byte is `b`.
fn units(b: Int) -> Int { if b >= 240 { 2 } else { 1 } }

fn char_len(b: Int) -> Int {
    if b >= 240 { return 4 }
    if b >= 224 { return 3 }
    if b >= 192 { return 2 }
    1
}

// `{"character":C,"line":L}` of byte `offset`, clamped to the text's end.
fn position(text: Str, starts: Ints, offset_in: Int) -> Str {
    let mut offset = offset_in
    if offset > str_len(text) { offset = str_len(text) }
    if offset < 0 { offset = 0 }
    let mut line = 0
    for k in 0..ints_len(starts) {
        if ints_get(starts, k) <= offset { line = k }
    }
    let mut col = 0
    let mut i = ints_get(starts, line)
    while i < offset {
        let b = str_byte(text, i)
        if b < 128 || b >= 192 { col += units(b) }
        i += 1
    }
    "{\"character\":" + int_to_str(col) + ",\"line\":" + int_to_str(line) + "}"
}

fn range(text: Str, starts: Ints, s: Int, e: Int) -> Str {
    "{\"end\":" + position(text, starts, e) + ",\"start\":" + position(text, starts, s) + "}"
}

// The byte offset of `line`, `character` (`LineIndex::offset`).
fn offset(text: Str, starts: Ints, line: Int, character: Int) -> Int {
    if line < 0 || line >= ints_len(starts) { return str_len(text) }
    let start = ints_get(starts, line)
    let mut end = if line + 1 < ints_len(starts) { ints_get(starts, line + 1) } else { str_len(text) }
    while end > start && (str_byte(text, end - 1) == 10 || str_byte(text, end - 1) == 13) { end -= 1 }
    let mut u = 0
    let mut byte = start
    while byte < end {
        let b = str_byte(text, byte)
        let next = u + units(b)
        if next > character { return byte }
        u = next
        byte += char_len(b)
    }
    byte
}

// --- URIs -------------------------------------------------------------------------------------------

// The path a `file:` URI names, percent-decoded; "" for none.
fn path_of(uri: Str) -> Str {
    if !fe_starts(uri, "file://") { return "" }
    let mut rest = str_slice(uri, 7, str_len(uri))
    if fe_starts(rest, "localhost") { rest = str_slice(rest, 9, str_len(rest)) }
    if !fe_starts(rest, "/") { return "" }
    let out = strs_new()
    let mut i = 0
    while i < str_len(rest) {
        let b = str_byte(rest, i)
        if b == 37 {
            if i + 3 > str_len(rest) { return "" }
            let h = hex_digit(str_byte(rest, i + 1))
            let l = hex_digit(str_byte(rest, i + 2))
            if h < 0 || l < 0 { return "" }
            strs_push(out, str_from_byte(h * 16 + l))
            i += 3
        } else {
            strs_push(out, str_from_byte(b))
            i += 1
        }
    }
    let p = str_join(out, "")
    if !valid_utf8(p) { return "" }
    p
}

// Whether a URI is one this port reads as the reference's `Uri` parser does: printable ASCII
// without the characters a URI may not hold, and every `%` followed by two hex digits.
fn plain_uri(uri: Str) -> Bool {
    for i in 0..str_len(uri) {
        let b = str_byte(uri, i)
        if b <= 32 || b >= 127 || b == 34 || b == 60 || b == 62 || b == 92 || b == 94 || b == 96 || b == 123 || b == 124
                || b == 125 || b == 35 || b == 63 || b == 91 || b == 93 { return false }
        if b == 37 && (i + 2 >= str_len(uri) || hex_digit(str_byte(uri, i + 1)) < 0 || hex_digit(str_byte(uri, i + 2)) < 0) { return false }
    }
    true
}

fn uri_of(path: Str) -> Str {
    let out = strs_new()
    strs_push(out, "file://")
    let digits = "0123456789ABCDEF"
    for i in 0..str_len(path) {
        let b = str_byte(path, i)
        if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 46 || b == 95 || b == 126 || b == 47 {
            strs_push(out, str_from_byte(b))
        } else {
            strs_push(out, "%" + str_slice(digits, b / 16, b / 16 + 1) + str_slice(digits, b % 16, b % 16 + 1))
        }
    }
    str_join(out, "")
}

fn valid_utf8(s: Str) -> Bool {
    let n = str_len(s)
    let mut i = 0
    while i < n {
        let b = str_byte(s, i)
        if b < 128 {
            i += 1
            continue
        }
        let mut need = 0
        let mut lo = 128
        let mut hi = 191
        if b >= 194 && b <= 223 { need = 1 } else if b == 224 {
            need = 2
            lo = 160
        } else if b >= 225 && b <= 236 { need = 2 } else if b == 237 {
            need = 2
            hi = 159
        } else if b >= 238 && b <= 239 { need = 2 } else if b == 240 {
            need = 3
            lo = 144
        } else if b >= 241 && b <= 243 { need = 3 } else if b == 244 {
            need = 3
            hi = 143
        } else { return false }
        if i + need >= n { return false }
        let c1 = str_byte(s, i + 1)
        if c1 < lo || c1 > hi { return false }
        for k in 2..need + 1 {
            let c = str_byte(s, i + k)
            if c < 128 || c > 191 { return false }
        }
        i += need + 1
    }
    true
}

// --- JSON out ---------------------------------------------------------------------------------------

fn send(io: IoCap, body: Str) -> Int {
    print("Content-Length: " + int_to_str(str_len(body)) + crlf() + crlf() + body)
    0
}

// The request's `id` as serde writes it back: a number or a string.
fn id_json(j: J, id: Int) -> Str {
    if j_kind(j, id) == 4 { return json_str(j_str(j, id)) }
    int_to_str(j_int(j, id))
}

fn respond(io: IoCap, id: Str, result: Str) -> Int { send(io, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}") }

fn respond_error(io: IoCap, id: Str, code: Int, message: Str) -> Int {
    send(io, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + int_to_str(code) + ",\"message\":" + json_str(message) + "}}")
}

fn capabilities() -> Str {
    "{\"capabilities\":{\"callHierarchyProvider\":true,\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"],\"resolveProvider\":false},"
            + "\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,"
            + "\"documentSymbolProvider\":true,\"hoverProvider\":true,\"positionEncoding\":\"utf-16\",\"referencesProvider\":true,"
            + "\"renameProvider\":{\"prepareProvider\":true},\"semanticTokensProvider\":{\"full\":true,\"legend\":{\"tokenModifiers\":"
            + "[\"declaration\",\"defaultLibrary\"],\"tokenTypes\":[\"type\",\"struct\",\"enum\",\"typeParameter\",\"parameter\","
            + "\"variable\",\"property\",\"enumMember\",\"function\",\"interface\",\"method\"]},\"range\":false},"
            + "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"textDocumentSync\":{\"change\":2,\"openClose\":true},"
            + "\"workspaceSymbolProvider\":{\"resolveProvider\":false}},\"serverInfo\":{\"name\":\"nazm\",\"version\":\"0.10.0\"}}"
}

// --- reading the protocol -----------------------------------------------------------------------------

// One line of standard input, its line break included; "" at the end.
fn read_line(io: IoCap, h: OsHandle) -> Str {
    let out = strs_new()
    let buf = bytes_new(4096)
    while true {
        let n = os_read_line(h, buf)
        if n <= 0 { return str_join(out, "") }
        let piece = bytes_to_str(bytes_slice(buf, 0, n))
        strs_push(out, piece)
        if str_byte(piece, n - 1) == 10 { return str_join(out, "") }
    }
    ""
}

// The next message's body; "" at the end of input before a message begins.
fn read_message(io: IoCap, h: OsHandle) -> Str {
    let mut length = 0 - 1
    let mut first = true
    while true {
        let line = read_line(io, h)
        if line == "" {
            if first { return "" }
            refuse(io, "input that ends inside a message's header")
        }
        first = false
        if line == crlf() { break }
        if !fe_starts(line, "Content-Length: ") || str_len(line) < 19 || str_byte(line, str_len(line) - 2) != 13 {
            refuse(io, "a header other than `Content-Length: N`")
        }
        let digits = str_slice(line, 16, str_len(line) - 2)
        if str_len(digits) == 0 || str_len(digits) > 9 { refuse(io, "a `Content-Length` this port does not read") }
        let mut v = 0
        for i in 0..str_len(digits) {
            let b = str_byte(digits, i)
            if b < 48 || b > 57 { refuse(io, "a `Content-Length` this port does not read") }
            v = v * 10 + b - 48
        }
        length = v
    }
    if length < 0 { refuse(io, "a message without `Content-Length`") }
    let out = strs_new()
    let mut got = 0
    while got < length {
        let buf = bytes_new(length - got)
        let n = os_read(h, buf)
        if n <= 0 { refuse(io, "input that ends inside a message") }
        strs_push(out, bytes_to_str(bytes_slice(buf, 0, n)))
        got += n
    }
    let body = str_join(out, "")
    if !valid_utf8(body) { refuse(io, "a message that is not UTF-8") }
    body
}

// A message the reference reads as this port does: a JSON object with `"jsonrpc":"2.0"`, a
// `method` string, and an integer or string `id` for a request; refused otherwise.
fn message(io: IoCap, body: Str) -> J {
    let j = j_parse(body)
    if !j_ok(j) || j_kind(j, 0) != 6 || j_twice(j, 0) { refuse(io, "a message this port does not parse as the reference does") }
    let v = j_get(j, 0, "jsonrpc")
    if j_kind(j, v) != 4 || j_str(j, v) != "2.0" { refuse(io, "a message that is not JSON-RPC 2.0") }
    let m = j_get(j, 0, "method")
    if j_kind(j, m) != 4 { refuse(io, "a response, or a message without a method") }
    let id = j_get(j, 0, "id")
    if id >= 0 && j_kind(j, id) != 4 && !j_int_in(j, id, 0 - 2147483648, 2147483647) { refuse(io, "an `id` this port does not read") }
    j
}

// --- diagnostics ---------------------------------------------------------------------------------------

fn file_at(d: Diags, i: Int, bases: Ints) -> Int {
    if ints_get(d.file, i) >= 0 { return ints_get(d.file, i) }
    let at = ints_get(d.start, i)
    let mut f = 0
    for k in 0..ints_len(bases) {
        if ints_get(bases, k) <= at { f = k }
    }
    f
}

fn diagnostic_json(d: Diags, i: Int, text: Str, starts: Ints) -> Str {
    let sev = if dg_severity(d, i) == "error" { "1" } else { "2" }
    "{\"code\":" + json_str(dg_code(d, i)) + ",\"message\":" + json_str(strs_get(d.message, i)) + ",\"range\":"
            + range(text, starts, ints_get(d.start, i), ints_get(d.end, i)) + ",\"severity\":" + sev + ",\"source\":\"nazm\"}"
}

fn publish(io: IoCap, path: Str, version: Str, diagnostics: Strs) -> Int {
    let v = if version == "" { "" } else { ",\"version\":" + version }
    send(io, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":[" + str_join(diagnostics, ",")
            + "],\"uri\":" + json_str(uri_of(path)) + v + "}}")
}

// `refresh`: every open document analysed again and its diagnostics published — its own file's
// errors, then its warnings (`own_diagnostics`).
fn refresh(io: IoCap, s: Server) -> Int {
    // The service's generation: bumped by every refresh (`LanguageService::refresh`).
    ints_set(s.flags, 2, ints_get(s.flags, 2) + 1)
    while vec_len(s.facts) > 0 { vec_pop(s.facts) }
    let n = strs_len(s.paths)
    // Every open document is analysed against the open buffers (`Overlaid`): each document's text stands for its file, saved or not
    // (`fx_check_over`); a compilation is checked as a module, so the program's missing `main` (`N0204`) is not among what is published.
    for k in 0..n {
        let f = fx_check_over(strs_get(s.paths, k), strs_get(s.root, 0), s.paths, s.texts, strs_get(s.library, 0), fe_host_os(), fe_host_arch(), io)
        if fx_refusal(f) != "" { refuse(io, "a source root the reference refuses") }
        if fe_load_failed(f) { refuse(io, "a compilation that does not load") }
        if !fx_carried(f) { refuse(io, fx_why(f)) }
        vec_push(s.facts, f)
    }
    // Published in the order of the documents' identity paths (the service keeps them in a `BTreeMap`).
    let order = ints_new()
    let keys = strs_new()
    for k in 0..n { strs_push(keys, identity_of(io, strs_get(s.paths, k))) }
    for k in 0..n {
        let mut at = ints_len(order)
        while at > 0 && fe_path_before(strs_get(keys, k), strs_get(keys, ints_get(order, at - 1))) { at -= 1 }
        ints_push(order, 0)
        let mut q = ints_len(order) - 1
        while q > at {
            ints_set(order, q, ints_get(order, q - 1))
            q -= 1
        }
        ints_set(order, at, k)
    }
    for r in 0..n {
        let k = ints_get(order, r)
        let f = vec_get(s.facts, k)
        let d = fx_diags(f)
        let bases = fe_bases(f)
        // Positions are in the text the compilation holds for the file: the loader ends it with a line
        // break where the file does not, and a diagnostic at its end is after that break.
        let held = fx_module_text(f, 0)
        let starts = line_starts(held)
        let out = strs_new()
        for i in 0..dg_len(d) {
            if dg_severity(d, i) == "error" && dg_code(d, i) != "N0204" && file_at(d, i, bases) == 0 { strs_push(out, diagnostic_json(d, i, held, starts)) }
        }
        // The checker's warnings are kept beside its errors (`Ck.w`) and published with them, as the service chains `nazm_core::warnings` after
        // the errors, after a syntax error too.
        let w = fx_checker(f).w
        for i in 0..dg_len(w) {
            if file_at(w, i, bases) == 0 { strs_push(out, diagnostic_json(w, i, held, starts)) }
        }
        publish(io, strs_get(s.paths, k), int_to_str(ints_get(s.versions, k)), out)
    }
    0
}

// --- the document's names ----------------------------------------------------------------------------

// The identifier at byte `at` of `text` (`name_at`): the one holding it, or the one ending there;
// `s` and `e` its span, or -1 for none.
fn name_at(io: IoCap, text: Str, at: Int) -> Ints {
    let kinds = ints_new()
    let starts = ints_new()
    let ends = ints_new()
    let texts = strs_new()
    let d = dg_new()
    lex_all(text, kinds, starts, ends, texts, d)
    let out = ints_new()
    for k in 0..ints_len(kinds) {
        if ints_get(starts, k) <= at && at < ints_get(ends, k) {
            if ints_get(kinds, k) == k_ident() {
                ints_push(out, ints_get(starts, k))
                ints_push(out, ints_get(ends, k))
                ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
                return out
            }
        }
    }
    for k in 0..ints_len(kinds) {
        if ints_get(kinds, k) == k_ident() && ints_get(ends, k) == at {
            ints_push(out, ints_get(starts, k))
            ints_push(out, ints_get(ends, k))
            ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
            return out
        }
    }
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    out
}

// The located request: the open document, its text, and the identifier there; refused where the
// reference may answer something this port does not know. -1 for `null`.
fn locate(io: IoCap, s: Server, j: J) -> Ints {
    let out = ints_new()
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let pos = j_get(j, p, "position")
    let line = j_get(j, pos, "line")
    let ch = j_get(j, pos, "character")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) || !j_int_in(j, line, 0, 4294967295) || !j_int_in(j, ch, 0, 4294967295) {
        refuse(io, "a request's parameters this port does not read as the reference does")
    }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || cur(s) >= vec_len(s.facts) {
        ints_push(out, 0 - 1)
        ints_push(out, 0 - 2)
        return out
    }
    let text = strs_get(s.texts, k)
    let at = offset(text, line_starts(text), j_int(j, line), j_int(j, ch))
    let span = name_at(io, text, at)
    ints_push(out, ints_get(span, 0))
    ints_push(out, ints_get(span, 1))
    ints_push(out, ints_get(span, 2))
    out
}

// Whether a name with no binding there might still be something the reference answers about: a
// function, a binding of that name elsewhere, or a call site.
fn might_mean(io: IoCap, f: Facts, name: Str, s: Int, e: Int) -> Bool {
    let c = fx_checker(f)
    if ck_site_at(c, s, e) >= 0 { return true }
    for i in 0..ck_fn_count(c) {
        if ck_fn_name(c, i) == name { return true }
    }
    for b in 0..ck_binding_count(c) {
        if ck_binding_name(c, b) == name { return true }
    }
    false
}

// An effect set as `EffectSet`'s `Display` writes it: `{}`, or `{ io, spawn }`.
fn effect_set(mask: Int) -> Str {
    let names = ck_effect_names(mask)
    if strs_len(names) == 0 { return "{}" }
    "{ " + str_join(names, ", ") + " }"
}

// What hover shows of a call to function `i` (`Signature::of_function`, rendered): `fn NAME(a: T,
// …) -> R`, then its declared effects after ` ! `, or, where it declares none, a line of the
// effects its body requires (`fn_label`); refused for a built-in and a call through a value, which have none.
fn call_label(io: IoCap, f: Facts, i: Int) -> Str {
    let c = fx_checker(f)
    if i < 0 { refuse(io, "hover of a call to a built-in or through a value") }
    let sig = fn_label(io, f, i)
    if ck_fn_foreign(c, i) != "" || ck_fn_declared(c, i) >= 0 { return sig }
    let required = ck_fn_required(c, i)
    if required < 0 { return sig }
    sig + nl() + "inferred effects: " + effect_set(required)
}

// Whether the mention at `at` is inside a function other than the one that declares binding `b`: a closure's.
fn captured_at(f: Facts, b: Int, at: Int) -> Bool {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let mut inner = 0 - 1
    let mut width = 0
    for i in 0..ck_fn_count(c) {
        let node = ck_fn_node(c, i)
        if node < 0 || ck_fn_module(c, i) != 0 { continue }
        let sp = sx_field(t, node, "span")
        let s = fx_start(f, sp)
        let e = fx_end(f, sp)
        if s <= at && at < e && (inner < 0 || e - s < width) {
            inner = i
            width = e - s
        }
    }
    inner >= 0 && inner != ck_binding_fn(c, b)
}

// Whether byte `at` of the document is inside one of its `use` items.
fn in_use_item(f: Facts, at: Int) -> Bool {
    let t = fx_tree(f)
    let imps = sx_items(t, sx_field(t, fx_module_program(f, 0), "imports"))
    for k in 0..ints_len(imps) {
        let sp = sx_field(t, ints_get(imps, k), "span")
        if fx_start(f, sp) <= at && at < fx_end(f, sp) { return true }
    }
    false
}

fn hover(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let en = ints_get(span, 1)
    let text = strs_get(s.texts, cur(s))
    let f = vec_get(s.facts, cur(s))
    let c = fx_checker(f)
    let name = str_slice(text, st, en)
    let site = ck_site_at(c, st, en)
    if site >= 0 && ck_site_fn(c, site) >= 0 {
        let shown = call_label(io, f, ck_site_fn(c, site))
        return "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
    }
    let b = ck_binding_at(c, st, en)
    // A refused capture is mentioned through the slot the captured binding has in its own function, which the reference reads in the closure's locals: what is in that
    // slot there (a local of the closure, or the copy of something it did capture), or nothing.
    if b >= 0 && ck_refused_capture_at(c, st, en) {
        let slot = ck_refused_slot(c, st, en)
        let table = ck_local_table(c, ck_refused_fn(c, st, en))
        if slot < 0 || slot >= ints_len(table) { return "null" }
        let ent = ints_get(table, slot)
        let shown = if ent >= 0 {
            (if ck_binding_mutable(c, ent) { "mut " } else { "" }) + ck_binding_name(c, ent) + ": " + fx_show(f, ck_binding_ty(c, ent))
        } else {
            let held = ck_capture_binding(c, 0 - 2 - ent)
            ck_binding_name(c, held) + ": " + fx_show(f, ck_binding_ty(c, held))
        }
        return "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
    }
    // A binding of a body no declared function holds (the method of an impl the checker refused) is no local of the reference's.
    if b >= 0 && ck_binding_fn(c, b) < 0 { return "null" }
    // A built-in called, where no local is named: the reference shows nothing; nor does a trait's method.
    if b < 0 && site >= 0 && (ck_site_builtin(c, site) >= 0 || ck_site_trait_method(c, site) >= 0) { return "null" }
    if b < 0 && site >= 0 { refuse(io, "hover of a call through a value") }
    if b < 0 {
        // After a `.` and not called, a name is a field or a variant: no local, no callee.
        let mut after = en
        while after < str_len(text) && (str_byte(text, after) == 32 || str_byte(text, after) == 9) { after += 1 }
        let called = after < str_len(text) && (str_byte(text, after) == 40 || str_byte(text, after) == 91)
        if st > 0 && str_byte(text, st - 1) == 46 && !called { return "null" }
        // A function's name where it is declared: no call is there, and no local.
        if ints_get(span, 2) == k_fn() { return "null" }
        // A local the facts publish no binding for cannot be shown; any other name is nothing hover shows.
        let e = entity_at(f, st, en)
        // A parameter is no use of itself where it is declared: the reference shows nothing there.
        if e >= 0 && fx_ref_kind(f, e) == "local" && fx_ref_decl_start(f, e) == st && fx_ref_decl_end(f, e) == en { return "null" }
        if e >= 0 && fx_ref_kind(f, e) == "local" { refuse(io, "hover of a local the facts publish no binding for") }
        // A function named in an import list is a use of it, and the checker's record of what a name calls covers that use.
        if e >= 0 && fx_ref_kind(f, e) == "function" && fx_ref_decl_start(f, e) >= 0 && in_use_item(f, st) {
            for i in 0..ck_fn_count(c) {
                if ck_fn_name_start(c, i) == fx_ref_decl_start(f, e) && !ck_fn_closure(c, i) {
                    let shown = call_label(io, f, i)
                    return "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
                }
            }
        }
        return "null"
    }
    let ty = fx_show(f, ck_binding_ty(c, b))
    // Seen from a closure the binding is its capture slot, which is not mutable.
    let shown = (if ck_binding_mutable(c, b) && !captured_at(f, b, st) { "mut " } else { "" }) + ck_binding_name(c, b) + ": " + ty
    "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
}

fn ident_byte(b: Int) -> Bool { (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128 }

// --- the reference index (`fx_ref_*`): definition, references, rename ----------------------------------

// The entity the identifier at `st..en` of the document (module 0, whose offsets are the compilation's)
// is of — its declaration or one of its uses — or -1 (`ReferenceIndex::target`).
fn entity_at(f: Facts, st: Int, en: Int) -> Int {
    let n = fx_ref_count(f)
    for i in 0..n {
        if fx_ref_decl_start(f, i) == st && fx_ref_decl_end(f, i) == en { return i }
    }
    for i in 0..n {
        for k in 0..fx_ref_use_count(f, i) {
            if fx_ref_use_start(f, i, k) == st && fx_ref_use_end(f, i, k) == en { return i }
        }
    }
    0 - 1
}

// Whether module `m` is a file an editor can open: not the core prelude and not the standard library.
fn module_file(f: Facts, m: Int) -> Bool { m >= 0 && !fe_starts(fx_module_name(f, m), "@") }

// A place in module `m` (local offsets) as a `Location`.
fn loc_json(io: IoCap, f: Facts, m: Int, s: Int, e: Int) -> Str {
    let name = pk_normalise(fx_module_name(f, m))
    if !fe_starts(name, "/") { refuse(io, "a location in a module this port does not name by its path") }
    let t = fx_module_text(f, m)
    "{\"range\":" + range(t, line_starts(t), s, e) + ",\"uri\":" + json_str(uri_of(name)) + "}"
}

fn definition(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let f = vec_get(s.facts, cur(s))
    let e = entity_at(f, st, ints_get(span, 1))
    if e < 0 { return "null" }
    let ds = fx_ref_decl_start(f, e)
    if ds < 0 { return "null" }
    let m = fx_module_at(f, ds)
    if !module_file(f, m) { return "null" }
    let base = fx_module_base(f, m)
    loc_json(io, f, m, ds - base, fx_ref_decl_end(f, e) - base)
}

// Whether location `(m1, s1, e1)` goes before `(m2, s2, e2)`: by path, then start and end.
fn loc_less(f: Facts, m1: Int, s1: Int, e1: Int, m2: Int, s2: Int, e2: Int) -> Bool {
    if m1 != m2 { return fe_path_before(pk_normalise(fx_module_name(f, m1)), pk_normalise(fx_module_name(f, m2))) }
    if s1 != s2 { return s1 < s2 }
    e1 < e2
}

fn references(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let inc = j_get(j, j_get(j, p, "context"), "includeDeclaration")
    if j_kind(j, inc) != 1 && j_kind(j, inc) != 2 { refuse(io, "a `references` request whose context this port does not read as the reference does") }
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let own = cur(s)
    let f = vec_get(s.facts, own)
    let e = entity_at(f, st, ints_get(span, 1))
    if e < 0 { return "null" }
    // The anchor: where the entity is declared (or, with no declaration in source, where it was asked about), as a place in a file.
    let ds = fx_ref_decl_start(f, e)
    let anchor_s = if ds >= 0 { ds } else { st }
    let anchor_e = if ds >= 0 { fx_ref_decl_end(f, e) } else { ints_get(span, 1) }
    let am = fx_module_at(f, anchor_s)
    let anchor_name = module_identity(io, fx_module_name(f, am))
    let anchor_text = fx_module_text(f, am)
    let anchor_ls = anchor_s - fx_module_base(f, am)
    let anchor_le = anchor_e - fx_module_base(f, am)
    // The uses, gathered from every current compilation that holds the declaring file as it was analysed, each reading its own index.
    let rows = strs_new()
    let keys = strs_new()
    let seen = strs_new()
    for dk in 0..vec_len(s.facts) {
        let g = vec_get(s.facts, dk)
        let mut gm = 0 - 1
        for m in 0..fx_modules(g) {
            if gm < 0 && module_identity(io, fx_module_name(g, m)) == anchor_name && fx_module_text(g, m) == anchor_text { gm = m }
        }
        if gm < 0 { continue }
        let ge = entity_at(g, fx_module_base(g, gm) + anchor_ls, fx_module_base(g, gm) + anchor_le)
        if ge < 0 { continue }
        for k in 0..fx_ref_use_count(g, ge) {
            let a = fx_ref_use_start(g, ge, k)
            let m = fx_module_at(g, a)
            if !module_file(g, m) { continue }
            let ls = a - fx_module_base(g, m)
            let le = fx_ref_use_end(g, ge, k) - fx_module_base(g, m)
            let path = pk_normalise(fx_module_name(g, m))
            let id = identity_of(io, path) + str_from_byte(0) + pad(ls) + pad(le)
            let mut dup = false
            for z in 0..strs_len(seen) {
                if strs_get(seen, z) == id { dup = true }
            }
            if dup { continue }
            strs_push(seen, id)
            strs_push(keys, path_key(path) + str_from_byte(0) + pad(ls) + pad(le))
            strs_push(rows, loc_json(io, g, m, ls, le))
        }
    }
    // The declaration, where asked for and there is one in a file an editor can open.
    if j_kind(j, inc) == 1 && ds >= 0 {
        let m = fx_module_at(f, ds)
        if module_file(f, m) {
            let ls = ds - fx_module_base(f, m)
            let le = fx_ref_decl_end(f, e) - fx_module_base(f, m)
            strs_push(keys, path_key(pk_normalise(fx_module_name(f, m))) + str_from_byte(0) + pad(ls) + pad(le))
            strs_push(rows, loc_json(io, f, m, ls, le))
        }
    }
    let order = ints_new()
    for i in 0..strs_len(keys) {
        let mut at = ints_len(order)
        while at > 0 && fe_str_less(strs_get(keys, i), strs_get(keys, ints_get(order, at - 1))) { at -= 1 }
        ints_push(order, 0)
        let mut k = ints_len(order) - 1
        while k > at {
            ints_set(order, k, ints_get(order, k - 1))
            k -= 1
        }
        ints_set(order, at, i)
    }
    let out = strs_new()
    for r in 0..ints_len(order) { strs_push(out, strs_get(rows, ints_get(order, r))) }
    "[" + str_join(out, ",") + "]"
}

// --- rename (`rename.rs`) ---------------------------------------------------------------------------------

fn pad(n: Int) -> Str {
    let t = int_to_str(n)
    let mut z = ""
    for i in 0..12 - str_len(t) { z = z + "0" }
    z + t
}

fn sort_places(xs: Strs) -> Strs { sort_strs(xs) }

fn sort_strs(xs: Strs) -> Strs {
    let n = strs_len(xs)
    if n < 2 { return xs }
    let mid = n / 2
    let left = strs_new()
    let right = strs_new()
    for i in 0..mid { strs_push(left, strs_get(xs, i)) }
    for i in mid..n { strs_push(right, strs_get(xs, i)) }
    let a = sort_strs(left)
    let b = sort_strs(right)
    let out = strs_new()
    let mut i = 0
    let mut k = 0
    while i < strs_len(a) && k < strs_len(b) {
        if fe_str_less(strs_get(b, k), strs_get(a, i)) {
            strs_push(out, strs_get(b, k))
            k += 1
        } else {
            strs_push(out, strs_get(a, i))
            i += 1
        }
    }
    while i < strs_len(a) {
        strs_push(out, strs_get(a, i))
        i += 1
    }
    while k < strs_len(b) {
        strs_push(out, strs_get(b, k))
        k += 1
    }
    out
}

fn sort_unique(xs: Strs) -> Strs {
    let sorted = sort_strs(xs)
    let out = strs_new()
    for i in 0..strs_len(sorted) {
        if i == 0 || strs_get(sorted, i) != strs_get(sorted, i - 1) { strs_push(out, strs_get(sorted, i)) }
    }
    out
}

fn same_strs(a: Strs, b: Strs) -> Bool {
    if strs_len(a) != strs_len(b) { return false }
    for i in 0..strs_len(a) {
        if strs_get(a, i) != strs_get(b, i) { return false }
    }
    true
}

fn failure(io: IoCap, id: Str, why: Str) -> Int { respond_error(io, id, 0 - 32803, "nazm cannot rename this: " + why) }

fn identity_of(io: IoCap, path: Str) -> Str { rn_identity_of(io, path) }

// What a file of a compilation is known by (`FileKey`): a path's identity, or the name of a module the toolchain owns.
fn module_identity(io: IoCap, name: Str) -> Str { rn_module_identity(io, name) }

// The open documents, as the rename engine takes them.
fn docs_of(s: Server) -> Docs { rn_docs(s.paths, s.texts, s.versions, s.facts, s.root, s.library) }

fn prepare_rename(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let r = rn_renameable(io, docs_of(s), cur(s), st, ints_get(span, 1))
    if rn_why(r) != "" { refuse(io, rn_why(r)) }
    if rn_code(r) != "" { return "null" }
    let text = strs_get(s.texts, cur(s))
    "{\"placeholder\":" + json_str(rn_old(r)) + ",\"range\":" + range(text, line_starts(text), st, ints_get(span, 1)) + "}"
}

// `textDocument/rename`: the validated plan as a versioned edit, or why there is none.
fn rename(io: IoCap, s: Server, j: J, id: Str) -> Int {
    let p = j_get(j, 0, "params")
    let name = j_get(j, p, "newName")
    if j_kind(j, name) != 4 { refuse(io, "a `rename` request without a `newName` string") }
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 && ints_get(span, 1) == 0 - 2 { return respond_error(io, id, 0 - 32803, "the document is not open") }
    if st < 0 { return failure(io, id, "nothing a program declared is named here") }
    let r = rn_plan(io, docs_of(s), cur(s), st, ints_get(span, 1), j_str(j, name))
    if rn_why(r) != "" { refuse(io, rn_why(r)) }
    if rn_code(r) != "" { return failure(io, id, rn_msg(r)) }
    // `plan_is_current`: every file the plan edits is, now, the text it was computed from: the open document's text, or the disk's. A file the loader ended with a line break
    // it did not have is not.
    for q in 0..rn_file_count(r) {
        let at = open_as(io, docs_of(s), rn_module_identity(io, rn_file_path(r, q)))
        let now = if at >= 0 { strs_get(s.texts, at) } else { read_file(rn_file_path(r, q)) }
        if now != rn_file_text(r, q) { return respond_error(io, id, 0 - 32803, "the program changed while the rename was being planned") }
    }
    // `workspace_edit`: versioned changes only, and only for files that are open documents.
    if ints_get(s.flags, 0) == 0 {
        return respond_error(io, id, 0 - 32803, "this client does not accept versioned edits, so a rename could be applied to a" + spaces(14)
                + "document that has since changed")
    }
    let changes = strs_new()
    for q in 0..rn_file_count(r) {
        if rn_file_version(r, q) < 0 {
            return respond_error(io, id, 0 - 32803, rn_file_path(r, q) + " must change and is not open; a closed file's content cannot be made a" + spaces(18)
                    + "condition of the edit, so open it and ask again")
        }
        let text = rn_file_text(r, q)
        let starts_of = line_starts(text)
        let edits = strs_new()
        for k in 0..rn_edit_count(r, q) {
            strs_push(edits, "{\"newText\":" + json_str(j_str(j, name)) + ",\"range\":" + range(text, starts_of, rn_edit_start(r, q, k), rn_edit_end(r, q, k)) + "}")
        }
        strs_push(changes, "{\"edits\":[" + str_join(edits, ",") + "],\"textDocument\":{\"uri\":" + json_str(uri_of(rn_file_path(r, q))) + ",\"version\":" + int_to_str(rn_file_version(r, q)) + "}}")
    }
    respond(io, id, "{\"documentChanges\":[" + str_join(changes, ",") + "]}")
}

fn spaces(n: Int) -> Str {
    let mut out = ""
    for i in 0..n { out = out + " " }
    out
}

// --- symbols (`symbols.rs`) -------------------------------------------------------------------------------

// The declarations of one file, with those it holds: kind (1 function, 2 record, 3 enum, 4 variant, 5 field,
// 6 payload field), name, its whole declaration and its name (local offsets), what it is (`detail`, with
// `has` saying there is one) and the symbol it is declared in (-1 for none).
struct Sy {
    kind: Ints,
    name: Strs,
    start: Ints,
    end: Ints,
    ns: Ints,
    ne: Ints,
    detail: Strs,
    has: Ints,
    parent: Ints,
}

fn sy_new() -> Sy {
    Sy(kind: ints_new(), name: strs_new(), start: ints_new(), end: ints_new(), ns: ints_new(), ne: ints_new(), detail: strs_new(), has: ints_new(), parent: ints_new())
}

fn sy_add(y: Sy, kind: Int, name: Str, s: Int, e: Int, ns: Int, ne: Int, detail: Str, has: Bool, parent: Int) -> Int {
    ints_push(y.kind, kind)
    strs_push(y.name, name)
    ints_push(y.start, s)
    ints_push(y.end, e)
    ints_push(y.ns, ns)
    ints_push(y.ne, ne)
    strs_push(y.detail, detail)
    ints_push(y.has, if has { 1 } else { 0 })
    ints_push(y.parent, parent)
    ints_len(y.kind) - 1
}

// The symbols declared in `parent` (-1 for the top level), in source order.
fn sy_kids(y: Sy, parent: Int) -> Ints {
    let out = ints_new()
    for i in 0..ints_len(y.kind) {
        if ints_get(y.parent, i) != parent { continue }
        let mut at = ints_len(out)
        while at > 0 && (ints_get(y.start, ints_get(out, at - 1)) > ints_get(y.start, i)
                || (ints_get(y.start, ints_get(out, at - 1)) == ints_get(y.start, i) && ints_get(y.ns, ints_get(out, at - 1)) > ints_get(y.ns, i))) { at -= 1 }
        ints_push(out, 0)
        let mut k = ints_len(out) - 1
        while k > at {
            ints_set(out, k, ints_get(out, k - 1))
            k -= 1
        }
        ints_set(out, at, i)
    }
    out
}

// `fn NAME[T: Equality](a: T) -> R ! { … }`: the declared signature of function `i`, as `Signature::render`
// spells it. Refused for a foreign function and for one with an effect parameter, whose labels the facts do
// not spell.
fn fn_label(io: IoCap, f: Facts, i: Int) -> Str {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let foreign = ck_fn_foreign(c, i)
    let node = ck_fn_node(c, i)
    let params = sx_items(t, sx_field(t, node, "params"))
    let tys = ck_fn_params(c, i)
    let shown = strs_new()
    // `main`'s `out` is written nowhere: the checker gives it first.
    let implicit = strs_len(tys) - ints_len(params)
    if implicit < 0 || implicit > 1 { refuse(io, "a function whose parameters the facts do not name") }
    if implicit == 1 { strs_push(shown, "out: " + strs_get(tys, 0)) }
    for k in 0..ints_len(params) {
        let p = sx_name(t, ints_get(params, k), "name")
        if p == "" { refuse(io, "a function whose parameters the facts do not name") }
        strs_push(shown, p + ": " + strs_get(tys, k + implicit))
    }
    let mut sig = (if foreign != "" { "extern \"C\" fn " } else { "fn " }) + ck_fn_name(c, i)
    let tps = sx_items(t, sx_field(t, node, "type_params"))
    if ints_len(tps) > 0 {
        let names = strs_new()
        for k in 0..ints_len(tps) {
            let tp = ints_get(tps, k)
            let req = sx_field(t, tp, "requires")
            strs_push(names, sx_name(t, tp, "name") + (if sx_is_some(t, req) && sx_name(t, sx_unwrap(t, req), "name") == "Equality" { ": Equality" } else { "" }))
        }
        sig = sig + "[" + str_join(names, ", ") + "]"
    }
    sig = sig + "(" + str_join(shown, ", ") + ") -> " + ck_fn_ret(c, i)
    if foreign != "" { return sig + " = \"" + foreign + "\"" }
    let declared = ck_fn_declared(c, i)
    if declared >= 0 { sig = sig + " ! " + effect_set(declared) }
    sig
}

// The symbols of module `m` (`declared_in`): functions, then records, then enums; each in source order
// within its parent. `details` asks for the labels (a document's outline), which the facts spell for fewer
// functions than they list.
fn symbols_of(io: IoCap, f: Facts, m: Int, details: Bool) -> Sy {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let y = sy_new()
    let base = fx_module_base(f, m)
    for i in 0..ck_fn_count(c) {
        if ck_fn_module(c, i) != m || ck_fn_closure(c, i) { continue }
        let node = ck_fn_node(c, i)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let sig = if details { fn_label(io, f, i) } else { "" }
        sy_add(y, 1, ck_fn_name(c, i), fx_start(f, span), fx_end(f, span), ck_fn_name_start(c, i) - base, ck_fn_name_end(c, i) - base, sig, details, 0 - 1)
    }
    for r in 0..ck_record_count(c) {
        if ck_record_module(c, r) != m { continue }
        let node = ck_record_node(c, r)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let at = sy_add(y, 2, ck_record_name(c, r), fx_start(f, span), fx_end(f, span), ck_record_name_start(c, r) - base, ck_record_name_end(c, r) - base, "", false, 0 - 1)
        let rt = fx_record_type(f, r)
        let fields = sx_items(t, sx_field(t, node, "fields"))
        // An opaque C handle (`extern "C" struct Box;`) has one hidden field the facts give and the text does not write: no symbol.
        if rt < 0 || (ck_record_arity(c, rt) != ints_len(fields) && !(ints_len(fields) == 0 && ck_record_arity(c, rt) == 1)) { refuse(io, "a record whose fields the facts do not publish") }
        for k in 0..ints_len(fields) {
            let fd = ints_get(fields, k)
            let fs = sx_field(t, fd, "span")
            let ns = sx_field(t, fd, "name_span")
            sy_add(y, 5, ck_record_field_name(c, rt, k), fx_start(f, fs), fx_end(f, fs), fx_start(f, ns), fx_end(f, ns),
                    fx_show(f, fx_record_field_ty(f, rt, k)), true, at)
        }
    }
    for e in 0..ck_enum_count(c) {
        if ck_enum_module(c, e) != m { continue }
        let node = ck_enum_node(c, e)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let at = sy_add(y, 3, ck_enum_name(c, e), fx_start(f, span), fx_end(f, span), ck_enum_name_start(c, e) - base, ck_enum_name_end(c, e) - base, "", false, 0 - 1)
        let et = fx_enum_type(f, e)
        let variants = sx_items(t, sx_field(t, node, "variants"))
        if et < 0 { refuse(io, "an enum whose variants the facts do not publish") }
        // A variant written twice is declared once, by the first: the facts' variants are found among the written ones by their names.
        for v in 0..ck_variant_count(c, et) {
            let mut vn = 0 - 1
            if ck_variant_count(c, et) == ints_len(variants) { vn = ints_get(variants, v) } else {
                for q in 0..ints_len(variants) {
                    if vn < 0 && sx_name(t, ints_get(variants, q), "name") == ck_variant_name(c, et, v) { vn = ints_get(variants, q) }
                }
            }
            if vn < 0 { refuse(io, "an enum whose variants the facts do not publish") }
            let vs = sx_field(t, vn, "span")
            let vns = sx_field(t, vn, "name_span")
            let written = sx_items(t, sx_field(t, vn, "fields"))
            let payload = ints_new()
            if ck_variant_arity(c, et, v) == ints_len(written) { for q in 0..ints_len(written) { ints_push(payload, ints_get(written, q)) } } else {
                for k in 0..ck_variant_arity(c, et, v) {
                    let mut pn = 0 - 1
                    for q in 0..ints_len(written) {
                        if pn < 0 && sx_name(t, ints_get(written, q), "name") == ck_payload_name(c, et, v, k) { pn = ints_get(written, q) }
                    }
                    if pn < 0 { refuse(io, "a variant whose payload the facts do not publish") }
                    ints_push(payload, pn)
                }
            }
            let listed = strs_new()
            for k in 0..ints_len(payload) { strs_push(listed, ck_payload_name(c, et, v, k) + ": " + fx_show(f, fx_payload_ty(f, et, v, k))) }
            let vname = ck_variant_name(c, et, v)
            let vat = sy_add(y, 4, vname, fx_start(f, vs), fx_end(f, vs), fx_start(f, vns), fx_end(f, vns), vname + "(" + str_join(listed, ", ") + ")", ints_len(payload) > 0, at)
            for k in 0..ints_len(payload) {
                let pn = ints_get(payload, k)
                let ps = sx_field(t, pn, "span")
                let pns = sx_field(t, pn, "name_span")
                sy_add(y, 6, ck_payload_name(c, et, v, k), fx_start(f, ps), fx_end(f, ps), fx_start(f, pns), fx_end(f, pns),
                        fx_show(f, fx_payload_ty(f, et, v, k)), true, vat)
            }
        }
    }
    y
}

// The protocol's `SymbolKind` of a symbol kind.
fn lsp_kind(kind: Int) -> Int {
    if kind == 1 { return 12 }
    if kind == 2 { return 23 }
    if kind == 3 { return 10 }
    if kind == 4 { return 22 }
    8
}

fn sy_nested(f: Facts, y: Sy, i: Int, text: Str, starts: Ints) -> Str {
    let kids = sy_kids(y, i)
    let parts = strs_new()
    if ints_len(kids) > 0 {
        let inner = strs_new()
        for k in 0..ints_len(kids) { strs_push(inner, sy_nested(f, y, ints_get(kids, k), text, starts)) }
        strs_push(parts, "\"children\":[" + str_join(inner, ",") + "]")
    }
    if ints_get(y.has, i) == 1 { strs_push(parts, "\"detail\":" + json_str(strs_get(y.detail, i))) }
    strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
    strs_push(parts, "\"name\":" + json_str(strs_get(y.name, i)))
    strs_push(parts, "\"range\":" + range(text, starts, ints_get(y.start, i), ints_get(y.end, i)))
    strs_push(parts, "\"selectionRange\":" + range(text, starts, ints_get(y.ns, i), ints_get(y.ne, i)))
    "{" + str_join(parts, ",") + "}"
}

fn sy_flat(y: Sy, i: Int, container: Str, has_container: Bool, uri: Str, text: Str, starts: Ints, out: Strs) -> Int {
    let mut parts = strs_new()
    if has_container { strs_push(parts, "\"containerName\":" + json_str(container)) }
    strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
    strs_push(parts, "\"location\":{\"range\":" + range(text, starts, ints_get(y.start, i), ints_get(y.end, i)) + ",\"uri\":" + json_str(uri) + "}")
    strs_push(parts, "\"name\":" + json_str(strs_get(y.name, i)))
    strs_push(out, "{" + str_join(parts, ",") + "}")
    let kids = sy_kids(y, i)
    for k in 0..ints_len(kids) { sy_flat(y, ints_get(kids, k), strs_get(y.name, i), true, uri, text, starts, out) }
    0
}

fn document_symbols(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) { refuse(io, "a request's parameters this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || cur(s) >= vec_len(s.facts) { return "null" }
    let f = vec_get(s.facts, cur(s))
    let y = symbols_of(io, f, 0, true)
    let text = fx_module_text(f, 0)
    let starts = line_starts(text)
    let top = sy_kids(y, 0 - 1)
    let out = strs_new()
    if ints_get(s.flags, 1) == 1 {
        for i in 0..ints_len(top) { strs_push(out, sy_nested(f, y, ints_get(top, i), text, starts)) }
    } else {
        for i in 0..ints_len(top) { sy_flat(y, ints_get(top, i), "", false, j_str(j, uri), text, starts, out) }
    }
    "[" + str_join(out, ",") + "]"
}

// `workspace/symbol`: every declaration of every file of the compilation whose name holds the query, by
// name, then file, then where its name is, then kind.
fn workspace_symbols(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let q = j_get(j, p, "query")
    if j_kind(j, q) != 4 { refuse(io, "a `workspace/symbol` request without a query") }
    let query = j_str(j, q)
    // One row per symbol: a sortable key, then the response object. A declaration the documents' compilations share is listed once.
    let rows = strs_new()
    let seen = strs_new()
    for dk in 0..vec_len(s.facts) {
        let f = vec_get(s.facts, dk)
        for m in 0..fx_modules(f) {
            if !module_file(f, m) { continue }
            let y = symbols_of(io, f, m, false)
            let text = fx_module_text(f, m)
            let starts = line_starts(text)
            for i in 0..ints_len(y.kind) {
                let id = path_key(pk_normalise(fx_module_name(f, m))) + str_from_byte(0) + pad(ints_get(y.ns, i)) + pad(ints_get(y.ne, i)) + int_to_str(ints_get(y.kind, i))
                let mut dup = false
                for z in 0..strs_len(seen) {
                    if strs_get(seen, z) == id { dup = true }
                }
                if dup { continue }
                strs_push(seen, id)
                let name = strs_get(y.name, i)
                if !ut_contains_text(name, query) { continue }
                let par = ints_get(y.parent, i)
                let mut container = ""
                if par >= 0 {
                    container = strs_get(y.name, par)
                    // A payload field is in its variant, which is in its enum.
                    if ints_get(y.kind, i) == 6 { container = strs_get(y.name, ints_get(y.parent, par)) + "." + strs_get(y.name, par) }
                }
                let mut parts = strs_new()
                if par >= 0 { strs_push(parts, "\"containerName\":" + json_str(container)) }
                strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
                strs_push(parts, "\"location\":" + loc_json(io, f, m, ints_get(y.ns, i), ints_get(y.ne, i)))
                strs_push(parts, "\"name\":" + json_str(name))
                // (name, path, where the name is, kind), in that order, each a fixed-width field.
                let key = name + str_from_byte(0) + path_key(pk_normalise(fx_module_name(f, m))) + str_from_byte(0) + pad(ints_get(y.ns, i)) + int_to_str(ints_get(y.kind, i))
                strs_push(rows, key + str_from_byte(1) + "{" + str_join(parts, ",") + "}")
            }
        }
    }
    let sorted = sort_strs(rows)
    let out = strs_new()
    for i in 0..strs_len(sorted) {
        let row = strs_get(sorted, i)
        let mut cut = 0
        while str_byte(row, cut) != 1 { cut += 1 }
        strs_push(out, str_slice(row, cut + 1, str_len(row)))
    }
    "[" + str_join(out, ",") + "]"
}

// A path as a string that sorts as `Path`'s order does: a component before the longer ones it begins.
fn path_key(p: Str) -> Str {
    let out = strs_new()
    for i in 0..str_len(p) {
        if str_byte(p, i) == 47 { strs_push(out, str_from_byte(2)) } else { strs_push(out, str_slice(p, i, i + 1)) }
    }
    str_join(out, "")
}

fn ut_contains_text(s: Str, p: Str) -> Bool {
    let n = str_len(p)
    let mut i = 0
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == p { return true }
        i += 1
    }
    false
}

// --- the messages ----------------------------------------------------------------------------------------

fn did_open(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let version = j_get(j, td, "version")
    let text = j_get(j, td, "text")
    let lang = j_get(j, td, "languageId")
    if j_twice(j, p) || j_twice(j, td) { refuse(io, "a duplicate field") }
    if j_kind(j, uri) != 4 || j_kind(j, text) != 4 || j_kind(j, lang) != 4 || !j_int_in(j, version, 0 - 2147483648, 2147483647) {
        refuse(io, "a `didOpen` this port does not read as the reference does")
    }
    if !plain_uri(j_str(j, uri)) { refuse(io, "a URI this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    if k >= 0 {
        ints_set(s.versions, k, j_int(j, version))
        strs_set(s.texts, k, j_str(j, text))
    } else {
        strs_push(s.paths, path)
        ints_push(s.versions, j_int(j, version))
        strs_push(s.texts, j_str(j, text))
    }
    refresh(io, s)
}

fn did_change(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let version = j_get(j, td, "version")
    let changes = j_get(j, p, "contentChanges")
    if j_kind(j, uri) != 4 || !j_int_in(j, version, 0 - 2147483648, 2147483647) || j_kind(j, changes) != 5 || !plain_uri(j_str(j, uri)) {
        refuse(io, "a `didChange` this port does not read as the reference does")
    }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    if k < 0 { return 0 }
    let mut text = strs_get(s.texts, k)
    let mut c = ints_get(j.first, changes)
    while c >= 0 {
        let r = j_get(j, c, "range")
        let t = j_get(j, c, "text")
        if j_kind(j, t) != 4 { refuse(io, "a change this port does not read") }
        let mut a = 0
        let mut b = str_len(text)
        if r >= 0 && j_kind(j, r) != 0 {
            let starts = line_starts(text)
            let rs = j_get(j, r, "start")
            let re = j_get(j, r, "end")
            let l0 = j_get(j, rs, "line")
            let c0 = j_get(j, rs, "character")
            let l1 = j_get(j, re, "line")
            let c1 = j_get(j, re, "character")
            if !j_int_in(j, l0, 0, 4294967295) || !j_int_in(j, c0, 0, 4294967295) || !j_int_in(j, l1, 0, 4294967295) || !j_int_in(j, c1, 0, 4294967295) {
                refuse(io, "a change's range this port does not read")
            }
            a = offset(text, starts, j_int(j, l0), j_int(j, c0))
            b = offset(text, starts, j_int(j, l1), j_int(j, c1))
        }
        if a > b {
            eprint("nazm lsp: a change outside the document; send it whole" + nl())
            return 0
        }
        text = str_slice(text, 0, a) + j_str(j, t) + str_slice(text, b, str_len(text))
        c = ints_get(j.next, c)
    }
    ints_set(s.versions, k, j_int(j, version))
    strs_set(s.texts, k, text)
    refresh(io, s)
}

fn did_close(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) { refuse(io, "a `didClose` this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    let paths = strs_new()
    let versions = ints_new()
    let texts = strs_new()
    for i in 0..strs_len(s.paths) {
        if i != k {
            strs_push(paths, strs_get(s.paths, i))
            ints_push(versions, ints_get(s.versions, i))
            strs_push(texts, strs_get(s.texts, i))
        }
    }
    while strs_len(s.paths) > 0 {
        strs_pop(s.paths)
        ints_pop(s.versions)
        strs_pop(s.texts)
    }
    for i in 0..strs_len(paths) {
        strs_push(s.paths, strs_get(paths, i))
        ints_push(s.versions, ints_get(versions, i))
        strs_push(s.texts, strs_get(texts, i))
    }
    refresh(io, s)
    if k >= 0 { publish(io, path, "", strs_new()) }
    0
}

// Every request method the reference implements, which this port refuses but for hover and
// definition; any other is `MethodNotFound`.
fn implemented(m: Str) -> Bool {
    let all = words("textDocument/definition textDocument/hover textDocument/references textDocument/completion "
            + "textDocument/signatureHelp textDocument/codeAction textDocument/documentSymbol workspace/symbol "
            + "textDocument/semanticTokens/full textDocument/prepareCallHierarchy callHierarchy/incomingCalls "
            + "callHierarchy/outgoingCalls textDocument/prepareRename textDocument/rename")
    for i in 0..strs_len(all) {
        if strs_get(all, i) == m { return true }
    }
    false
}

// The words of `s`, split at single spaces.
fn words(s: Str) -> Strs {
    let out = strs_new()
    let mut from = 0
    for i in 0..str_len(s) + 1 {
        if i == str_len(s) || str_byte(s, i) == 32 {
            strs_push(out, str_slice(s, from, i))
            from = i + 1
        }
    }
    out
}

// --- semantic tokens (`semantic.rs`, `encode_tokens`) ----------------------------------------------------

// The token type (the legend's index) and modifier bits (`declaration` 1, `defaultLibrary` 2) of the identifier at `st..en`, or nothing where
// the checker recorded nothing there: as `semantic::classify` decides it — the reference index first, then a call to a built-in, then a written type.
fn token_class(f: Facts, st: Int, en: Int) -> Ints {
    let c = fx_checker(f)
    let out = ints_new()
    let e = entity_at(f, st, en)
    if e >= 0 {
        let kind = fx_ref_kind(f, e)
        let mut ty = 5
        if kind == "function" { ty = 8 }
        if kind == "local" {
            let b = ck_ref_binding(c, e)
            let params = if b >= 0 { ck_fn_param_count(c, ck_binding_fn(c, b)) } else { 0 }
            ty = if b >= 0 && ck_binding_slot(c, b) < params { 4 } else { 5 }
            // A refused capture is the slot its binding has in the function declaring it, in the closure.
            if b < 0 && ck_refused_capture_at(c, st, en) {
                let slot = ck_refused_slot(c, st, en)
                ty = if slot >= 0 && slot < ck_fn_param_count(c, ck_refused_fn(c, st, en)) { 4 } else { 5 }
            }
        }
        if kind == "record" { ty = 1 }
        if kind == "enum" { ty = 2 }
        if kind == "variant" { ty = 7 }
        if kind == "field" || kind == "payload field" { ty = 6 }
        if kind == "trait" { ty = 9 }
        if kind == "trait method" { ty = 10 }
        ints_push(out, ty)
        ints_push(out, if fx_ref_decl_start(f, e) == st && fx_ref_decl_end(f, e) == en { 1 } else { 0 })
        return out
    }
    let site = ck_site_at(c, st, en)
    if site >= 0 && ck_site_builtin(c, site) >= 0 {
        ints_push(out, 8)
        ints_push(out, 2)
        return out
    }
    let w = ck_written_type_at(c, st, en)
    if w == 1 { ints_push(out, 0); ints_push(out, 2) }
    if w == 2 { ints_push(out, 3); ints_push(out, 0) }
    if w == 3 { ints_push(out, 3); ints_push(out, 1) }
    out
}

fn line_of(starts: Ints, offset: Int) -> Int {
    let mut line = 0
    for k in 0..ints_len(starts) {
        if ints_get(starts, k) <= offset { line = k }
    }
    line
}

// The UTF-16 column of byte `offset`.
fn column_of(text: Str, starts: Ints, offset: Int) -> Int {
    let mut col = 0
    let mut i = ints_get(starts, line_of(starts, offset))
    while i < offset {
        let b = str_byte(text, i)
        if b < 128 || b >= 192 { col += units(b) }
        i += 1
    }
    col
}

fn semantic_tokens(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) { refuse(io, "a request's parameters this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || cur(s) >= vec_len(s.facts) { return "null" }
    let f = vec_get(s.facts, cur(s))
    let text = fx_module_text(f, 0)
    let starts = line_starts(text)
    let kinds = ints_new()
    let sts = ints_new()
    let ens = ints_new()
    let texts = strs_new()
    lex_all(text, kinds, sts, ens, texts, dg_new())
    let data = strs_new()
    let mut pl = 0
    let mut pc = 0
    let mut first = true
    for i in 0..ints_len(kinds) {
        if ints_get(kinds, i) != k_ident() { continue }
        let st = ints_get(sts, i)
        let en = ints_get(ens, i)
        let cl = token_class(f, st, en)
        if ints_len(cl) == 0 { continue }
        let line = line_of(starts, st)
        let col = column_of(text, starts, st)
        let width = column_of(text, starts, en) - col
        let dl = if first { line } else { line - pl }
        let dc = if first || line != pl { col } else { col - pc }
        strs_push(data, int_to_str(dl) + "," + int_to_str(dc) + "," + int_to_str(width) + "," + int_to_str(ints_get(cl, 0)) + "," + int_to_str(ints_get(cl, 1)))
        first = false
        pl = line
        pc = col
    }
    "{\"data\":[" + str_join(data, ",") + "]}"
}

// --- code actions (`fixes.rs`, `code_actions`) -----------------------------------------------------------

// Whether the requested range `a..b` touches the span `s..e`, by the half-open rule of `fixes.rs`.
fn touches(s: Int, e: Int, a: Int, b: Int) -> Bool {
    if a == b { return s <= a && a <= e }
    if s == e { return a <= s && s <= b }
    a < e && s < b
}

// A position's line and character of a request's range, or refused where the reference's types would not read it.
fn range_end_offset(io: IoCap, j: J, text: Str, starts: Ints, pos: Int) -> Int {
    let line = j_get(j, pos, "line")
    let ch = j_get(j, pos, "character")
    if !j_int_in(j, line, 0, 4294967295) || !j_int_in(j, ch, 0, 4294967295) { refuse(io, "a request's parameters this port does not read as the reference does") }
    offset(text, starts, j_int(j, line), j_int(j, ch))
}

// `textDocument/codeAction`: a quick fix per fix of each current error the range touches.
fn code_actions(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let rg = j_get(j, p, "range")
    let ctx = j_get(j, p, "context")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) || j_kind(j, rg) != 6 || j_kind(j, ctx) != 6 || j_kind(j, j_get(j, ctx, "diagnostics")) != 5 {
        refuse(io, "a request's parameters this port does not read as the reference does")
    }
    let only = j_get(j, ctx, "only")
    if only >= 0 && j_kind(j, only) != 0 {
        if j_kind(j, only) != 5 { refuse(io, "a request's parameters this port does not read as the reference does") }
        let mut wanted = false
        let mut c = ints_get(j.first, only)
        while c >= 0 {
            if j_kind(j, c) != 4 { refuse(io, "a request's parameters this port does not read as the reference does") }
            if j_str(j, c) == "" || j_str(j, c) == "quickfix" { wanted = true }
            c = ints_get(j.next, c)
        }
        if !wanted { return "[]" }
    }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || cur(s) >= vec_len(s.facts) { return "null" }
    let f = vec_get(s.facts, cur(s))
    let text = strs_get(s.texts, cur(s))
    let starts = line_starts(text)
    let a = range_end_offset(io, j, text, starts, j_get(j, rg, "start"))
    let b = range_end_offset(io, j, text, starts, j_get(j, rg, "end"))
    let d = fx_diags(f)
    let bases = fe_bases(f)
    let held = fx_module_text(f, 0)
    let hstarts = line_starts(held)
    let out = strs_new()
    for i in 0..dg_len(d) {
        if dg_severity(d, i) != "error" || dg_code(d, i) == "N0204" || file_at(d, i, bases) != 0 { continue }
        if !touches(ints_get(d.start, i), ints_get(d.end, i), a, b) { continue }
        let ff = ints_get(d.fix_first, i)
        let n = ints_get(d.fix_count, i)
        for q in 0..n {
            let fs = ints_get(d.fix_start, ff + q)
            let fe = ints_get(d.fix_end, ff + q)
            if fs < 0 || fe < fs || fe > str_len(held) || fx_module_at(f, fs) != 0 { continue }
            if ints_get(s.flags, 0) == 0 { continue }
            let automatic = strs_get(d.fix_applicability, ff + q) == "automatic"
            let desc = strs_get(d.fix_description, ff + q)
            let title = if automatic { "Fix " + dg_code(d, i) + ": " + desc } else {
                "Review fix " + dg_code(d, i) + ": " + desc + " " + str_from_byte(226) + str_from_byte(128) + str_from_byte(148) + " right only if " + strs_get(d.fix_precondition, ff + q) }
            let edit = "{\"documentChanges\":[{\"edits\":[{\"newText\":" + json_str(strs_get(d.fix_replacement, ff + q)) + ",\"range\":" + range(text, starts, fs, fe)
                    + "}],\"textDocument\":{\"uri\":" + json_str(uri_of(strs_get(s.paths, cur(s)))) + ",\"version\":" + int_to_str(ints_get(s.versions, cur(s))) + "}}]}"
            strs_push(out, "{\"diagnostics\":[" + diagnostic_json(d, i, held, hstarts) + "],\"edit\":" + edit + (if automatic && n == 1 { ",\"isPreferred\":true" } else { "" })
                    + ",\"kind\":\"quickfix\",\"title\":" + json_str(title) + "}")
        }
    }
    "[" + str_join(out, ",") + "]"
}

// --- call hierarchy (`hierarchy.rs`) ----------------------------------------------------------------------

// Whether function `g` is a source function an editor can open (`function_symbol` and its file).
fn hier_ok(f: Facts, g: Int) -> Bool {
    let c = fx_checker(f)
    if ck_fn_closure(c, g) || ck_fn_node(c, g) < 0 { return false }
    module_file(f, ck_fn_module(c, g))
}

// Function `g` as a call hierarchy item, bound to the compilation of the open document at its version and the current generation.
fn hier_item(io: IoCap, s: Server, f: Facts, g: Int) -> Str {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let m = ck_fn_module(c, g)
    let base = fx_module_base(f, m)
    let mtext = fx_module_text(f, m)
    let mstarts = line_starts(mtext)
    let span = sx_field(t, ck_fn_node(c, g), "span")
    let ns = ck_fn_name_start(c, g) - base
    let ne = ck_fn_name_end(c, g) - base
    let name = pk_normalise(fx_module_name(f, m))
    "{\"data\":{\"end\":" + int_to_str(ne) + ",\"file\":" + json_str(identity_of(io, name)) + ",\"generation\":" + int_to_str(ints_get(s.flags, 2))
            + ",\"root\":" + json_str(identity_of(io, strs_get(s.paths, cur(s)))) + ",\"start\":" + int_to_str(ns) + ",\"version\":" + int_to_str(ints_get(s.versions, cur(s)))
            + "},\"detail\":" + json_str(fn_label(io, f, g)) + ",\"kind\":12,\"name\":" + json_str(ck_fn_name(c, g)) + ",\"range\":"
            + range(mtext, mstarts, fx_start(f, span), fx_end(f, span)) + ",\"selectionRange\":" + range(mtext, mstarts, ns, ne) + ",\"uri\":" + json_str(uri_of(name)) + "}"
}

fn prepare_hierarchy(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let f = vec_get(s.facts, cur(s))
    let e = entity_at(f, st, ints_get(span, 1))
    if e < 0 || fx_ref_kind(f, e) != "function" { return "null" }
    let g = ck_ref_function(fx_checker(f), e)
    if g < 0 || !hier_ok(f, g) { return "null" }
    "[" + hier_item(io, s, f, g) + "]"
}

// Whether function `a` goes before `b`: by the file it is declared in, then where its name is, then its name.
fn hier_before(f: Facts, a: Int, b: Int) -> Bool {
    let c = fx_checker(f)
    let ma = ck_fn_module(c, a)
    let mb = ck_fn_module(c, b)
    if ma != mb {
        let pa = pk_normalise(fx_module_name(f, ma))
        let pb = pk_normalise(fx_module_name(f, mb))
        if pa != pb { return fe_path_before(pa, pb) }
    }
    let na = ck_fn_name_start(c, a) - fx_module_base(f, ma)
    let nb = ck_fn_name_start(c, b) - fx_module_base(f, mb)
    if na != nb { return na < nb }
    fe_str_less(ck_fn_name(c, a), ck_fn_name(c, b))
}

// The `fromRanges` of the calls `from..to` (absolute, in module `m`): in source order, each once.
fn hier_ranges(f: Facts, m: Int, from: Ints, to: Ints) -> Str {
    let base = fx_module_base(f, m)
    let text = fx_module_text(f, m)
    let starts = line_starts(text)
    let order = ints_new()
    for i in 0..ints_len(from) {
        let mut at = ints_len(order)
        while at > 0 && (ints_get(from, i) < ints_get(from, ints_get(order, at - 1))
                || (ints_get(from, i) == ints_get(from, ints_get(order, at - 1)) && ints_get(to, i) < ints_get(to, ints_get(order, at - 1)))) { at -= 1 }
        ints_push(order, 0)
        let mut k = ints_len(order) - 1
        while k > at {
            ints_set(order, k, ints_get(order, k - 1))
            k -= 1
        }
        ints_set(order, at, i)
    }
    let out = strs_new()
    let mut last = 0 - 1
    for r in 0..ints_len(order) {
        let i = ints_get(order, r)
        if last >= 0 && ints_get(from, last) == ints_get(from, i) && ints_get(to, last) == ints_get(to, i) { continue }
        strs_push(out, range(text, starts, ints_get(from, i) - base, ints_get(to, i) - base))
        last = i
    }
    "[" + str_join(out, ",") + "]"
}

// The function an item's `data` binds, in the current analysis, or -1 (`bound`): refused where the request is not shaped as the reference reads it.
fn hier_bound(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let item = j_get(j, p, "item")
    if j_kind(j, item) != 6 || j_kind(j, j_get(j, item, "name")) != 4 || !j_int_in(j, j_get(j, item, "kind"), 0, 4294967295) || j_kind(j, j_get(j, item, "uri")) != 4
            || j_kind(j, j_get(j, item, "range")) != 6 || j_kind(j, j_get(j, item, "selectionRange")) != 6 {
        refuse(io, "a request's parameters this port does not read as the reference does")
    }
    let d = j_get(j, item, "data")
    if j_kind(j, d) != 6 { return 0 - 1 }
    let root = j_get(j, d, "root")
    let file = j_get(j, d, "file")
    let version = j_get(j, d, "version")
    let generation = j_get(j, d, "generation")
    let start = j_get(j, d, "start")
    let end = j_get(j, d, "end")
    if j_kind(j, root) != 4 || j_kind(j, file) != 4 || !j_int_in(j, version, 0 - 2147483648, 2147483647) || !j_int_in(j, generation, 0, 2147483647)
            || !j_int_in(j, start, 0, 2147483647) || !j_int_in(j, end, 0, 2147483647) || j_get(j, d, "root") < 0 { return 0 - 1 }
    if j_int(j, generation) != ints_get(s.flags, 2) { return 0 - 1 }
    // The open document whose identity the item names.
    let mut k = 0 - 1
    for i in 0..strs_len(s.paths) {
        if k < 0 && identity_of(io, strs_get(s.paths, i)) == j_str(j, root) { k = i }
    }
    if k < 0 || k >= vec_len(s.facts) { return 0 - 1 }
    ints_set(s.flags, 3, k)
    if ints_get(s.versions, k) != j_int(j, version) { return 0 - 1 }
    let f = vec_get(s.facts, k)
    let c = fx_checker(f)
    let mut m = 0 - 1
    for k in 0..fx_modules(f) {
        if m < 0 && fe_starts(fx_module_name(f, k), "/") && identity_of(io, pk_normalise(fx_module_name(f, k))) == j_str(j, file) { m = k }
    }
    if m < 0 { return 0 - 1 }
    let base = fx_module_base(f, m)
    for g in 0..ck_fn_count(c) {
        if ck_fn_module(c, g) == m && !ck_fn_closure(c, g) && ck_fn_name_start(c, g) - base == j_int(j, start) && ck_fn_name_end(c, g) - base == j_int(j, end) { return g }
    }
    0 - 1
}

fn incoming_calls(io: IoCap, s: Server, j: J) -> Str {
    let target = hier_bound(io, s, j)
    if target < 0 { return "null" }
    let f = vec_get(s.facts, cur(s))
    let c = fx_checker(f)
    let callers = ints_new()
    let cfrom = ints_new()
    let cto = ints_new()
    for q in 0..ck_fn_count(c) {
        if !hier_ok(f, q) { continue }
        for k in 0..fx_call_count(f, q) {
            if fx_call_kind(f, q, k) == "function" && fx_call_function(f, q, k) == target {
                ints_push(callers, q)
                ints_push(cfrom, fx_call_start(f, q, k))
                ints_push(cto, fx_call_end(f, q, k))
            }
        }
    }
    let rows = hier_rows(io, s, f, callers, cfrom, cto, "from", false)
    "[" + str_join(rows, ",") + "]"
}

fn outgoing_calls(io: IoCap, s: Server, j: J) -> Str {
    let caller = hier_bound(io, s, j)
    if caller < 0 { return "null" }
    let f = vec_get(s.facts, cur(s))
    let c = fx_checker(f)
    let callees = ints_new()
    let cfrom = ints_new()
    let cto = ints_new()
    for k in 0..fx_call_count(f, caller) {
        if fx_call_kind(f, caller, k) == "function" {
            let h = fx_call_function(f, caller, k)
            if h >= 0 && hier_ok(f, h) {
                ints_push(callees, h)
                ints_push(cfrom, fx_call_start(f, caller, k))
                ints_push(cto, fx_call_end(f, caller, k))
            }
        }
    }
    let rows = hier_rows(io, s, f, callees, cfrom, cto, "to", true)
    "[" + str_join(rows, ",") + "]"
}

// One row per distinct function of `others`, in the reference's order: the item and the ranges of its calls (`from` the callers' files, or
// the calling function's own for `outgoing`).
fn hier_rows(io: IoCap, s: Server, f: Facts, others: Ints, from: Ints, to: Ints, key: Str, outgoing: Bool) -> Strs {
    let c = fx_checker(f)
    let distinct = ints_new()
    for i in 0..ints_len(others) {
        let g = ints_get(others, i)
        let mut seen = false
        for k in 0..ints_len(distinct) {
            if ints_get(distinct, k) == g { seen = true }
        }
        if !seen { ints_push(distinct, g) }
    }
    let order = ints_new()
    for i in 0..ints_len(distinct) {
        let g = ints_get(distinct, i)
        let mut at = ints_len(order)
        while at > 0 && hier_before(f, g, ints_get(order, at - 1)) { at -= 1 }
        ints_push(order, 0)
        let mut k = ints_len(order) - 1
        while k > at {
            ints_set(order, k, ints_get(order, k - 1))
            k -= 1
        }
        ints_set(order, at, g)
    }
    let rows = strs_new()
    for r in 0..ints_len(order) {
        let g = ints_get(order, r)
        let sa = ints_new()
        let sb = ints_new()
        for i in 0..ints_len(others) {
            if ints_get(others, i) == g {
                ints_push(sa, ints_get(from, i))
                ints_push(sb, ints_get(to, i))
            }
        }
        // The calls are in the caller's file: the function itself for incoming, the item's own for outgoing.
        let m = if outgoing { fx_module_at(f, ints_get(sa, 0)) } else { ck_fn_module(c, g) }
        let item = hier_item(io, s, f, g)
        let ranges = hier_ranges(f, m, sa, sb)
        if outgoing { strs_push(rows, "{\"fromRanges\":" + ranges + ",\"" + key + "\":" + item + "}") } else { strs_push(rows, "{\"" + key + "\":" + item + ",\"fromRanges\":" + ranges + "}") }
    }
    rows
}

// --- signature help (`signature.rs`, `help_at`) ------------------------------------------------------------

// The byte offset a `TextDocumentPositionParams` request names in the open document, or -1 where it is not open or has no analysis.
fn request_offset(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let pos = j_get(j, p, "position")
    let line = j_get(j, pos, "line")
    let ch = j_get(j, pos, "character")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) || !j_int_in(j, line, 0, 4294967295) || !j_int_in(j, ch, 0, 4294967295) {
        refuse(io, "a request's parameters this port does not read as the reference does")
    }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || cur(s) >= vec_len(s.facts) { return 0 - 1 }
    let text = strs_get(s.texts, k)
    offset(text, line_starts(text), j_int(j, line), j_int(j, ch))
}

// The index of the token starting at or after byte `at`.
fn token_from(starts: Ints, at: Int) -> Int {
    for i in 0..ints_len(starts) {
        if ints_get(starts, i) >= at { return i }
    }
    ints_len(starts)
}

// The token index of the `)` closing the `(` at token `open`, or -1.
fn closing(kinds: Ints, open: Int) -> Int {
    let mut depth = 0
    let mut i = open
    while i < ints_len(kinds) {
        let k = ints_get(kinds, i)
        if k == k_lparen() || k == k_lbracket() || k == k_lbrace() { depth += 1 }
        if k == k_rparen() || k == k_rbracket() || k == k_rbrace() {
            depth -= 1
            if depth == 0 { return i }
        }
        i += 1
    }
    0 - 1
}

// The nodes of the tree under `root` that are structs or tuples named `name`.
fn nodes_named(t: Tree, root: Int, names: Strs) -> Ints {
    let out = ints_new()
    let stack = ints_new()
    ints_push(stack, root)
    while ints_len(stack) > 0 {
        let n = ints_pop(stack)
        let kind = sx_kind(t, n)
        if kind == tk_struct() || kind == tk_tuple() || kind == tk_list() {
            if kind == tk_struct() {
                for i in 0..strs_len(names) {
                    if sx_text(t, n) == strs_get(names, i) { ints_push(out, n) }
                }
            }
            for i in 0..sx_count(t, n) { ints_push(stack, sx_kid(t, n, i)) }
        }
    }
    out
}

// The layout order of `n` fields named `names` (declaration order): by name, unless `declared`.
fn layout_order(names: Strs, declared: Bool) -> Ints {
    let order = ints_new()
    for i in 0..strs_len(names) {
        let mut at = ints_len(order)
        while !declared && at > 0 && fe_str_less(strs_get(names, i), strs_get(names, ints_get(order, at - 1))) { at -= 1 }
        ints_push(order, 0)
        let mut k = ints_len(order) - 1
        while k > at {
            ints_set(order, k, ints_get(order, k - 1))
            k -= 1
        }
        ints_set(order, at, i)
    }
    order
}

// Signature help for a record or variant construction (`constructor_help`): its shape, the fields in the canonical order with their types, and the
// field whose initialiser holds the offset.
fn constructor_help(f: Facts, n: Int, at: Int) -> Str {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let variant_span = sx_field(t, n, "variant_span")
    let mut head = ""
    let names = strs_new()
    let tys = strs_new()
    let mut declared_index = ints_new()
    if variant_span >= 0 {
        // A variant is found by the name written after the type's.
        let et = ck_variant_at(c, fx_start(f, variant_span), fx_end(f, variant_span))
        let vi = ck_variant_index_at(c, fx_start(f, variant_span), fx_end(f, variant_span))
        if et < 0 || vi < 0 { return "null" }
        head = fx_show(f, et) + "." + ck_variant_name(c, et, vi)
        for k in 0..ck_variant_arity(c, et, vi) {
            strs_push(names, ck_payload_name(c, et, vi, k))
            strs_push(tys, fx_show(f, ck_payload_ty(c, et, vi, k)))
        }
        declared_index = layout_order(names, false)
    } else {
        // A qualified construction's first identifier is its qualifier, which no construction is recorded at.
        if sx_is_some(t, sx_field(t, n, "qualifier")) { return "null" }
        let ty_span = sx_field(t, n, "ty_span")
        let rt = ck_construction_at(c, fx_start(f, ty_span), fx_end(f, ty_span))
        if rt < 0 { return "null" }
        head = fx_show(f, rt)
        for k in 0..ck_record_arity(c, rt) {
            strs_push(names, ck_record_field_name(c, rt, k))
            strs_push(tys, fx_show(f, ck_record_field_ty(c, rt, k)))
        }
        declared_index = layout_order(names, ck_record_c_layout(c, rt))
    }
    let mut text = head + "("
    let marks = strs_new()
    for r in 0..ints_len(declared_index) {
        let k = ints_get(declared_index, r)
        if r > 0 { text = text + ", " }
        let st = str_len(text)
        text = text + strs_get(names, k) + ": " + strs_get(tys, k)
        strs_push(marks, "{\"label\":[" + int_to_str(column_of(text, line_starts(text), st)) + "," + int_to_str(column_of(text, line_starts(text), str_len(text))) + "]}")
    }
    text = text + ")"
    // The initialiser the offset is in, by its label's recorded field.
    let mut active = 0 - 1
    let inits = sx_items(t, sx_field(t, n, "fields"))
    let mut found = 0 - 1
    for q in 0..ints_len(inits) {
        let sp = sx_field(t, ints_get(inits, q), "span")
        if found < 0 && fx_start(f, sp) <= at && at <= fx_end(f, sp) { found = ints_get(inits, q) }
    }
    if found >= 0 && sx_name(t, found, "name") != "" {
        let ns = sx_field(t, found, "name_span")
        let d = ck_init_at(c, fx_start(f, ns), fx_end(f, ns))
        if d >= 0 {
            for r in 0..ints_len(declared_index) {
                if ints_get(declared_index, r) == d { active = r }
            }
        }
    }
    let a = if active >= 0 { "\"activeParameter\":" + int_to_str(active) + "," } else { "" }
    let params = if active >= 0 { ",\"parameters\":[" + str_join(marks, ",") + "]" } else { "" }
    "{" + a + "\"activeSignature\":0,\"signatures\":[{" + a + "\"label\":" + json_str(text) + params + "}]}"
}

fn signature_help(io: IoCap, s: Server, j: J) -> Str {
    let at = request_offset(io, s, j)
    if at < 0 { return "null" }
    let f = vec_get(s.facts, cur(s))
    let d = fx_diags(f)
    // A recovered syntax answers nothing (`RecoveredSyntax`, and no call or construction is found in a tree that lost its parts).
    for i in 0..dg_len(d) {
        // A syntax error, or an attribute the vocabulary does not have (its function is left out): no call is recorded for what used it.
        if (ints_get(d.file, i) >= 0 && dg_code(d, i) != "N0205") || (dg_code(d, i) == "N0619" && ut_contains_text(strs_get(d.message, i), "is not an attribute Nazm has")) { return "null" }
    }
    let c = fx_checker(f)
    let t = fx_tree(f)
    let text = fx_module_text(f, 0)
    let kinds = ints_new()
    let sts = ints_new()
    let ens = ints_new()
    let texts = strs_new()
    lex_all(text, kinds, sts, ens, texts, dg_new())
    let root = fx_module_program(f, 0)
    let calls = strs_new()
    strs_push(calls, "Call")
    strs_push(calls, "Spawn")
    let built = strs_new()
    strs_push(built, "Construct")
    strs_push(built, "Variant")
    // The innermost argument list holding the offset: the one whose `(` is latest.
    let mut best = 0 - 1
    let mut best_open = 0 - 1
    let mut best_close = 0 - 1
    let call_nodes = nodes_named(t, root, calls)
    // The short forms `Some(x)`, `Ok(x)`, `Err(e)` are variant nodes with no variant written: calls to the grammar, which no checked call is recorded for.
    let built_all = nodes_named(t, root, built)
    for q in 0..ints_len(built_all) {
        let n = ints_get(built_all, q)
        let vs = sx_field(t, n, "variant_span")
        if vs >= 0 && sx_field(t, n, "ty_span") >= 0 && fx_start(f, vs) == fx_start(f, sx_field(t, n, "ty_span")) { ints_push(call_nodes, n) }
    }
    for q in 0..ints_len(call_nodes) {
        let n = ints_get(call_nodes, q)
        let mut callee = sx_field(t, n, "callee_span")
        if callee < 0 { callee = sx_field(t, n, "ty_span") }
        if callee < 0 { continue }
        let from = token_from(sts, fx_end(f, callee))
        let mut open = from
        if open < ints_len(kinds) && ints_get(kinds, open) == k_lbracket() {
            let end = closing(kinds, open)
            if end < 0 { continue }
            open = end + 1
        }
        if open >= ints_len(kinds) || ints_get(kinds, open) != k_lparen() { continue }
        let close = closing(kinds, open)
        if close < 0 { continue }
        if ints_get(ens, open) <= at && at <= ints_get(sts, close) && ints_get(sts, open) > best_open {
            best = n
            best_open = ints_get(sts, open)
            best_close = close
        }
    }
    let built_nodes = built_all
    let mut cons = 0 - 1
    let mut cons_open = 0 - 1
    let mut cons_close = 0 - 1
    for q in 0..ints_len(built_nodes) {
        let n = ints_get(built_nodes, q)
        let sp = sx_field(t, n, "span")
        if sp < 0 || sx_field(t, n, "ty_span") < 0 { continue }
        let vs = sx_field(t, n, "variant_span")
        if vs >= 0 && fx_start(f, vs) == fx_start(f, sx_field(t, n, "ty_span")) { continue }
        // The parentheses of its initialisers, inside the construction.
        let mut o = token_from(sts, fx_start(f, sp))
        while o < ints_len(kinds) && ints_get(sts, o) < fx_end(f, sp) && ints_get(kinds, o) != k_lparen() { o += 1 }
        if o >= ints_len(kinds) || ints_get(sts, o) >= fx_end(f, sp) { continue }
        let close = closing(kinds, o)
        if close < 0 { continue }
        if ints_get(ens, o) <= at && at <= ints_get(sts, close) && ints_get(ens, o) > cons_open {
            cons = n
            cons_open = ints_get(ens, o)
            cons_close = close
        }
    }
    // A construction whose `(` comes after the call's callee is the innermost (`help_at`).
    if cons >= 0 && (best < 0 || cons_open > fx_start(f, sx_field(t, best, "callee_span"))) { return constructor_help(f, cons, at) }
    if best < 0 { return "null" }
    if sx_field(t, best, "callee_span") < 0 { return "null" }
    // A qualified call's first identifier is its qualifier, which no checked call is recorded at.
    let qual = sx_field(t, best, "qualifier")
    if qual >= 0 && sx_is_some(t, qual) { return "null" }
    let callee = sx_field(t, best, "callee_span")
    let site = ck_site_at(c, fx_start(f, callee), fx_end(f, callee))
    if site < 0 { return "null" }
    let lab = ck_site_label(c, site)
    if strs_len(lab) == 0 { return "null" }
    // Which argument: the argument list's own separators that end at or before the offset.
    let mut active = 0
    let mut depth = 0
    let mut k = token_from(sts, best_open) + 1
    while k < best_close {
        let kind = ints_get(kinds, k)
        if kind == k_lparen() || kind == k_lbracket() || kind == k_lbrace() { depth += 1 }
        if kind == k_rparen() || kind == k_rbracket() || kind == k_rbrace() { depth -= 1 }
        if kind == k_comma() && depth == 0 && ints_get(ens, k) <= at { active += 1 }
        k += 1
    }
    let n = (strs_len(lab) - 1) / 2
    if active >= n && n > 0 { return "null" }
    let shown = strs_get(lab, 0)
    let params = strs_new()
    for i in 0..n {
        strs_push(params, "{\"label\":[" + int_to_str(column_of(shown, line_starts(shown), parse_number(strs_get(lab, 1 + 2 * i)))) + ","
                + int_to_str(column_of(shown, line_starts(shown), parse_number(strs_get(lab, 2 + 2 * i)))) + "]}")
    }
    let a2 = if active < n { "\"activeParameter\":" + int_to_str(active) + "," } else { "" }
    "{" + a2 + "\"activeSignature\":0,\"signatures\":[{" + a2 + "\"label\":" + json_str(shown)
            + ",\"parameters\":[" + str_join(params, ",") + "]}]}"
}

fn parse_number(s: Str) -> Int {
    let mut n = 0
    for i in 0..str_len(s) { n = n * 10 + str_byte(s, i) - 48 }
    n
}

fn request(io: IoCap, s: Server, j: J, method: Str, id: Str) -> Int {
    if method == "textDocument/hover" { return respond(io, id, hover(io, s, j)) }
    if method == "textDocument/definition" { return respond(io, id, definition(io, s, j)) }
    if method == "textDocument/references" { return respond(io, id, references(io, s, j)) }
    if method == "textDocument/prepareRename" { return respond(io, id, prepare_rename(io, s, j)) }
    if method == "textDocument/rename" { return rename(io, s, j, id) }
    if method == "textDocument/documentSymbol" { return respond(io, id, document_symbols(io, s, j)) }
    if method == "workspace/symbol" { return respond(io, id, workspace_symbols(io, s, j)) }
    if method == "textDocument/prepareCallHierarchy" { return respond(io, id, prepare_hierarchy(io, s, j)) }
    if method == "callHierarchy/incomingCalls" { return respond(io, id, incoming_calls(io, s, j)) }
    if method == "callHierarchy/outgoingCalls" { return respond(io, id, outgoing_calls(io, s, j)) }
    if method == "textDocument/signatureHelp" { return respond(io, id, signature_help(io, s, j)) }
    if method == "textDocument/codeAction" { return respond(io, id, code_actions(io, s, j)) }
    if method == "textDocument/semanticTokens/full" { return respond(io, id, semantic_tokens(io, s, j)) }
    if implemented(method) { refuse(io, "`" + method + "`") }
    respond_error(io, id, 0 - 32601, "`" + method + "` is not implemented by nazm lsp")
}

// `nazm lsp`, its arguments read into `c` (`lsp_cli`) from where `cli_from` says.
pub fn lsp_command(io: IoCap, c: Cli) -> Int {
    cli_parse(io, c)
    let given = cli_value(c, 0)
    let root = if cli_present(c, 0) { fe_prefix(io, given) + given } else { "" }
    let library = os_env_get("NAZM_LIBRARY")
    let h = os_stdin()
    // `initialize_start`: the first message must be `initialize`.
    let first = read_message(io, h)
    if first == "" {
        eprint("nazm lsp: initialize: disconnected channel" + nl())
        exit_with(4)
    }
    let j0 = message(io, first)
    let id0 = j_get(j0, 0, "id")
    if id0 < 0 || j_str(j0, j_get(j0, 0, "method")) != "initialize" { refuse(io, "a first message that is not `initialize`") }
    if j_kind(j0, j_get(j0, 0, "params")) != 6 { refuse(io, "`initialize` without its parameters") }
    respond(io, id_json(j0, id0), capabilities())
    // `initialize_finish`: then `initialized`.
    let second = read_message(io, h)
    if second == "" { refuse(io, "input that ends before `initialized`") }
    let j1 = message(io, second)
    if j_get(j1, 0, "id") >= 0 || j_str(j1, j_get(j1, 0, "method")) != "initialized" { refuse(io, "a second message that is not `initialized`") }
    let libs = strs_new()
    strs_push(libs, library)
    let roots = strs_new()
    strs_push(roots, root)
    let flags = ints_new()
    let caps = j_get(j0, j_get(j0, 0, "params"), "capabilities")
    ints_push(flags, if j_kind(j0, j_get(j0, j_get(j0, j_get(j0, caps, "workspace"), "workspaceEdit"), "documentChanges")) == 1 { 1 } else { 0 })
    ints_push(flags, if j_kind(j0, j_get(j0, j_get(j0, j_get(j0, caps, "textDocument"), "documentSymbol"), "hierarchicalDocumentSymbolSupport")) == 1 { 1 } else { 0 })
    ints_push(flags, 0)
    ints_push(flags, 0)
    let s = Server(paths: strs_new(), versions: ints_new(), texts: strs_new(), facts: vec_new[Facts](), library: libs, root: roots, flags: flags)
    while true {
        let body = read_message(io, h)
        if body == "" { return 0 }
        let j = message(io, body)
        let method = j_str(j, j_get(j, 0, "method"))
        let id = j_get(j, 0, "id")
        if id >= 0 {
            let idj = id_json(j, id)
            if method == "shutdown" {
                respond(io, idj, "null")
                // `handle_shutdown`: then `exit`.
                let next = read_message(io, h)
                if next == "" { refuse(io, "input that ends after `shutdown`") }
                let jn = message(io, next)
                if j_get(jn, 0, "id") >= 0 || j_str(jn, j_get(jn, 0, "method")) != "exit" { refuse(io, "a message between `shutdown` and `exit`") }
                return 0
            }
            request(io, s, j, method, idj)
        } else if method == "exit" {
            // `lsp-server`'s reader stops at `exit`, whenever it comes: the connection is closed.
            return 0
        } else if method == "textDocument/didOpen" {
            did_open(io, s, j)
        } else if method == "textDocument/didChange" {
            did_change(io, s, j)
        } else if method == "textDocument/didClose" {
            did_close(io, s, j)
        }
    }
    0
}
