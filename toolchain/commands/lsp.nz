// `nazm lsp`, written in Nazm (R5, `openspec/changes/r5-commands/`, design D15).
//
// `nazm lsp [--source-root DIR]`, run by the dispatcher (`nazm.nz`): the Language Server Protocol
// over standard input and output, a port of `crates/nazm-cli/src/lsp.rs` (and of what it asks of
// `lsp-server` and `nazm_service::LanguageService`) over R2's published facts
// (`compiler/facts.nz`).
//
// Carried: the framing (`Content-Length`, a blank line, the JSON body), the handshake —
// `initialize` answered with the reference's capabilities, then `initialized` — `shutdown` and
// `exit`, the end of input, a method the reference does not implement (`MethodNotFound`, which is
// `textDocument/formatting` too: the reference offers no formatting), the documents' lifecycle
// (`didOpen`, `didChange` applied range by range in UTF-16 positions, `didClose`) with each
// document's diagnostics published as the reference publishes them, its text standing for its file
// whether saved or not (`fx_check_over`); `hover` of a local of any type (`fx_show`) and of a call
// to a plain function (its signature and effects); `definition` of a local and of what the checker
// records a name refers to (`fx_declaration_at`: a function called or used as a value, a record
// built, a variant named), and in a compilation with no errors of anything the reference index
// (`fx_ref_*`) knows; `references`, `prepareRename` and `rename` (the candidate program checked again), `documentSymbol` and
// `workspace/symbol` (design D23); `--source-root`; and `null` where the reference answers nothing (no
// name, a built-in called, a function's own name where it is declared, a field or variant after
// `.`, a declaration in the standard library).
//
// Not carried, refused with status 6 on standard error (design D5) before anything else is
// written: more than one document open at once (the reference publishes them in a hash map's
// order), a compilation that does not load or that the front end stops at; hover of a method, a
// generic or foreign function or a call through a value, hover of a name the checker publishes no
// binding for, definition of what the facts index no declaration for in a compilation with errors the
// index is not promised for; completion, signature help, semantic tokens, code actions and call
// hierarchy; a rename of an exported name in a declared workspace; and any message the reference's
// parsers would read differently from this port's.
//
// Standard output is the protocol: nothing else is ever written there.

use "../../compiler/lex.nz"
use "../../compiler/syntax.nz"
use "../../compiler/diag.nz"
use "../../compiler/sema.nz"
use "../../compiler/package.nz"
use "../../compiler/facts.nz"
use "cli.nz"
use "front.nz"
use "jsonin.nz"

fn nl() -> Str { str_from_byte(10) }
fn crlf() -> Str { str_from_byte(13) + str_from_byte(10) }

// The command line, as `crates/nazm-cli/src/cli.rs` declares `nazm lsp`.
pub fn lsp_cli() -> Cli {
    let c = cli_command("lsp", "Serve the Language Server Protocol to an editor, on stdin and stdout",
            "Serve the Language Server Protocol to an editor, on stdin and stdout." + nl() + nl()
            + "Started and owned by the editor; ends when it says `exit`. Diagnostics, definition and hover, from the same "
            + "loader and checker every other command uses, over the editor's unsaved buffers. `docs/internal/architecture.md` §7.18 "
            + "says what it does and does not do.")
    cli_option(c, "", "source-root", "SOURCE_ROOT", true, "", false, "Measure every module's durable identity from this directory, as "
            + "`nazm check --source-root` does. Without it, each open file's root is decided exactly as `nazm check` decides "
            + "it for that file", "")
    c
}

fn refuse(io: IoCap, why: Str) -> Int {
    eprint("lsp: not carried: " + why + nl())
    exit_with(6)
    0
}

// --- JSON in --------------------------------------------------------------------------------------

fn hex_digit(b: Int) -> Int {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 102 { return b - 87 }
    if b >= 65 && b <= 70 { return b - 55 }
    0 - 1
}

// --- the documents --------------------------------------------------------------------------------

struct Server {
    paths: Strs,
    versions: Ints,
    texts: Strs,
    // The facts of the one open document's current analysis (`facts` holds 0 or 1).
    facts: Vec[Facts],
    library: Strs,
    // `--source-root`, absolute, or "" to decide each document's root as `check` does.
    root: Strs,
    // What the client said it reads: versioned edits (`documentChanges`), nested symbols.
    flags: Ints,
}

fn doc_index(s: Server, path: Str) -> Int {
    for i in 0..strs_len(s.paths) {
        if strs_get(s.paths, i) == path { return i }
    }
    0 - 1
}

// The open document `path` names, refused where another spelling names the same file: the
// reference keys documents by the file, this port by the path as written.
fn doc_named(io: IoCap, s: Server, path: Str) -> Int {
    let k = doc_index(s, path)
    if k >= 0 { return k }
    let canon = fe_canonical(io, path)
    for i in 0..strs_len(s.paths) {
        let other = fe_canonical(io, strs_get(s.paths, i))
        if canon != "" && other == canon { refuse(io, "a document named by another spelling of its path") }
        if canon == "" && pk_normalise(path) == pk_normalise(strs_get(s.paths, i)) { refuse(io, "a document named by another spelling of its path") }
    }
    0 - 1
}

// --- positions: byte offsets and UTF-16 lines and columns (`LineIndex`) ----------------------------

fn line_starts(text: Str) -> Ints {
    let out = ints_new()
    ints_push(out, 0)
    let n = str_len(text)
    for i in 0..n {
        let b = str_byte(text, i)
        if b == 10 { ints_push(out, i + 1) }
        if b == 13 && (i + 1 >= n || str_byte(text, i + 1) != 10) { ints_push(out, i + 1) }
    }
    out
}

// The UTF-16 units of the character whose first byte is `b`.
fn units(b: Int) -> Int { if b >= 240 { 2 } else { 1 } }

fn char_len(b: Int) -> Int {
    if b >= 240 { return 4 }
    if b >= 224 { return 3 }
    if b >= 192 { return 2 }
    1
}

// `{"character":C,"line":L}` of byte `offset`, clamped to the text's end.
fn position(text: Str, starts: Ints, offset_in: Int) -> Str {
    let mut offset = offset_in
    if offset > str_len(text) { offset = str_len(text) }
    if offset < 0 { offset = 0 }
    let mut line = 0
    for k in 0..ints_len(starts) {
        if ints_get(starts, k) <= offset { line = k }
    }
    let mut col = 0
    let mut i = ints_get(starts, line)
    while i < offset {
        let b = str_byte(text, i)
        if b < 128 || b >= 192 { col += units(b) }
        i += 1
    }
    "{\"character\":" + int_to_str(col) + ",\"line\":" + int_to_str(line) + "}"
}

fn range(text: Str, starts: Ints, s: Int, e: Int) -> Str {
    "{\"end\":" + position(text, starts, e) + ",\"start\":" + position(text, starts, s) + "}"
}

// The byte offset of `line`, `character` (`LineIndex::offset`).
fn offset(text: Str, starts: Ints, line: Int, character: Int) -> Int {
    if line < 0 || line >= ints_len(starts) { return str_len(text) }
    let start = ints_get(starts, line)
    let mut end = if line + 1 < ints_len(starts) { ints_get(starts, line + 1) } else { str_len(text) }
    while end > start && (str_byte(text, end - 1) == 10 || str_byte(text, end - 1) == 13) { end -= 1 }
    let mut u = 0
    let mut byte = start
    while byte < end {
        let b = str_byte(text, byte)
        let next = u + units(b)
        if next > character { return byte }
        u = next
        byte += char_len(b)
    }
    byte
}

// --- URIs -------------------------------------------------------------------------------------------

// The path a `file:` URI names, percent-decoded; "" for none.
fn path_of(uri: Str) -> Str {
    if !fe_starts(uri, "file://") { return "" }
    let mut rest = str_slice(uri, 7, str_len(uri))
    if fe_starts(rest, "localhost") { rest = str_slice(rest, 9, str_len(rest)) }
    if !fe_starts(rest, "/") { return "" }
    let out = strs_new()
    let mut i = 0
    while i < str_len(rest) {
        let b = str_byte(rest, i)
        if b == 37 {
            if i + 3 > str_len(rest) { return "" }
            let h = hex_digit(str_byte(rest, i + 1))
            let l = hex_digit(str_byte(rest, i + 2))
            if h < 0 || l < 0 { return "" }
            strs_push(out, str_from_byte(h * 16 + l))
            i += 3
        } else {
            strs_push(out, str_from_byte(b))
            i += 1
        }
    }
    let p = str_join(out, "")
    if !valid_utf8(p) { return "" }
    p
}

// Whether a URI is one this port reads as the reference's `Uri` parser does: printable ASCII
// without the characters a URI may not hold, and every `%` followed by two hex digits.
fn plain_uri(uri: Str) -> Bool {
    for i in 0..str_len(uri) {
        let b = str_byte(uri, i)
        if b <= 32 || b >= 127 || b == 34 || b == 60 || b == 62 || b == 92 || b == 94 || b == 96 || b == 123 || b == 124
                || b == 125 || b == 35 || b == 63 || b == 91 || b == 93 { return false }
        if b == 37 && (i + 2 >= str_len(uri) || hex_digit(str_byte(uri, i + 1)) < 0 || hex_digit(str_byte(uri, i + 2)) < 0) { return false }
    }
    true
}

fn uri_of(path: Str) -> Str {
    let out = strs_new()
    strs_push(out, "file://")
    let digits = "0123456789ABCDEF"
    for i in 0..str_len(path) {
        let b = str_byte(path, i)
        if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 46 || b == 95 || b == 126 || b == 47 {
            strs_push(out, str_from_byte(b))
        } else {
            strs_push(out, "%" + str_slice(digits, b / 16, b / 16 + 1) + str_slice(digits, b % 16, b % 16 + 1))
        }
    }
    str_join(out, "")
}

fn valid_utf8(s: Str) -> Bool {
    let n = str_len(s)
    let mut i = 0
    while i < n {
        let b = str_byte(s, i)
        if b < 128 {
            i += 1
            continue
        }
        let mut need = 0
        let mut lo = 128
        let mut hi = 191
        if b >= 194 && b <= 223 { need = 1 } else if b == 224 {
            need = 2
            lo = 160
        } else if b >= 225 && b <= 236 { need = 2 } else if b == 237 {
            need = 2
            hi = 159
        } else if b >= 238 && b <= 239 { need = 2 } else if b == 240 {
            need = 3
            lo = 144
        } else if b >= 241 && b <= 243 { need = 3 } else if b == 244 {
            need = 3
            hi = 143
        } else { return false }
        if i + need >= n { return false }
        let c1 = str_byte(s, i + 1)
        if c1 < lo || c1 > hi { return false }
        for k in 2..need + 1 {
            let c = str_byte(s, i + k)
            if c < 128 || c > 191 { return false }
        }
        i += need + 1
    }
    true
}

// --- JSON out ---------------------------------------------------------------------------------------

fn send(io: IoCap, body: Str) -> Int {
    print("Content-Length: " + int_to_str(str_len(body)) + crlf() + crlf() + body)
    0
}

// The request's `id` as serde writes it back: a number or a string.
fn id_json(j: J, id: Int) -> Str {
    if j_kind(j, id) == 4 { return json_str(j_str(j, id)) }
    int_to_str(j_int(j, id))
}

fn respond(io: IoCap, id: Str, result: Str) -> Int { send(io, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}") }

fn respond_error(io: IoCap, id: Str, code: Int, message: Str) -> Int {
    send(io, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + int_to_str(code) + ",\"message\":" + json_str(message) + "}}")
}

fn capabilities() -> Str {
    "{\"capabilities\":{\"callHierarchyProvider\":true,\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"],\"resolveProvider\":false},"
            + "\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,"
            + "\"documentSymbolProvider\":true,\"hoverProvider\":true,\"positionEncoding\":\"utf-16\",\"referencesProvider\":true,"
            + "\"renameProvider\":{\"prepareProvider\":true},\"semanticTokensProvider\":{\"full\":true,\"legend\":{\"tokenModifiers\":"
            + "[\"declaration\",\"defaultLibrary\"],\"tokenTypes\":[\"type\",\"struct\",\"enum\",\"typeParameter\",\"parameter\","
            + "\"variable\",\"property\",\"enumMember\",\"function\",\"interface\",\"method\"]},\"range\":false},"
            + "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"textDocumentSync\":{\"change\":2,\"openClose\":true},"
            + "\"workspaceSymbolProvider\":{\"resolveProvider\":false}},\"serverInfo\":{\"name\":\"nazm\",\"version\":\"0.10.0\"}}"
}

// --- reading the protocol -----------------------------------------------------------------------------

// One line of standard input, its line break included; "" at the end.
fn read_line(io: IoCap, h: OsHandle) -> Str {
    let out = strs_new()
    let buf = bytes_new(4096)
    while true {
        let n = os_read_line(h, buf)
        if n <= 0 { return str_join(out, "") }
        let piece = bytes_to_str(bytes_slice(buf, 0, n))
        strs_push(out, piece)
        if str_byte(piece, n - 1) == 10 { return str_join(out, "") }
    }
    ""
}

// The next message's body; "" at the end of input before a message begins.
fn read_message(io: IoCap, h: OsHandle) -> Str {
    let mut length = 0 - 1
    let mut first = true
    while true {
        let line = read_line(io, h)
        if line == "" {
            if first { return "" }
            refuse(io, "input that ends inside a message's header")
        }
        first = false
        if line == crlf() { break }
        if !fe_starts(line, "Content-Length: ") || str_len(line) < 19 || str_byte(line, str_len(line) - 2) != 13 {
            refuse(io, "a header other than `Content-Length: N`")
        }
        let digits = str_slice(line, 16, str_len(line) - 2)
        if str_len(digits) == 0 || str_len(digits) > 9 { refuse(io, "a `Content-Length` this port does not read") }
        let mut v = 0
        for i in 0..str_len(digits) {
            let b = str_byte(digits, i)
            if b < 48 || b > 57 { refuse(io, "a `Content-Length` this port does not read") }
            v = v * 10 + b - 48
        }
        length = v
    }
    if length < 0 { refuse(io, "a message without `Content-Length`") }
    let out = strs_new()
    let mut got = 0
    while got < length {
        let buf = bytes_new(length - got)
        let n = os_read(h, buf)
        if n <= 0 { refuse(io, "input that ends inside a message") }
        strs_push(out, bytes_to_str(bytes_slice(buf, 0, n)))
        got += n
    }
    let body = str_join(out, "")
    if !valid_utf8(body) { refuse(io, "a message that is not UTF-8") }
    body
}

// A message the reference reads as this port does: a JSON object with `"jsonrpc":"2.0"`, a
// `method` string, and an integer or string `id` for a request; refused otherwise.
fn message(io: IoCap, body: Str) -> J {
    let j = j_parse(body)
    if !j_ok(j) || j_kind(j, 0) != 6 || j_twice(j, 0) { refuse(io, "a message this port does not parse as the reference does") }
    let v = j_get(j, 0, "jsonrpc")
    if j_kind(j, v) != 4 || j_str(j, v) != "2.0" { refuse(io, "a message that is not JSON-RPC 2.0") }
    let m = j_get(j, 0, "method")
    if j_kind(j, m) != 4 { refuse(io, "a response, or a message without a method") }
    let id = j_get(j, 0, "id")
    if id >= 0 && j_kind(j, id) != 4 && !j_int_in(j, id, 0 - 2147483648, 2147483647) { refuse(io, "an `id` this port does not read") }
    j
}

// --- diagnostics ---------------------------------------------------------------------------------------

fn file_at(d: Diags, i: Int, bases: Ints) -> Int {
    if ints_get(d.file, i) >= 0 { return ints_get(d.file, i) }
    let at = ints_get(d.start, i)
    let mut f = 0
    for k in 0..ints_len(bases) {
        if ints_get(bases, k) <= at { f = k }
    }
    f
}

fn diagnostic_json(d: Diags, i: Int, text: Str, starts: Ints) -> Str {
    let sev = if dg_severity(d, i) == "error" { "1" } else { "2" }
    "{\"code\":" + json_str(dg_code(d, i)) + ",\"message\":" + json_str(strs_get(d.message, i)) + ",\"range\":"
            + range(text, starts, ints_get(d.start, i), ints_get(d.end, i)) + ",\"severity\":" + sev + ",\"source\":\"nazm\"}"
}

fn publish(io: IoCap, path: Str, version: Str, diagnostics: Strs) -> Int {
    let v = if version == "" { "" } else { ",\"version\":" + version }
    send(io, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":[" + str_join(diagnostics, ",")
            + "],\"uri\":" + json_str(uri_of(path)) + v + "}}")
}

// `refresh`: every open document analysed again and its diagnostics published — its own file's
// errors, then its warnings (`own_diagnostics`).
fn refresh(io: IoCap, s: Server) -> Int {
    while vec_len(s.facts) > 0 { vec_pop(s.facts) }
    if strs_len(s.paths) > 1 { refuse(io, "more than one open document (the reference publishes them in a hash map's order)") }
    if strs_len(s.paths) == 0 { return 0 }
    let path = strs_get(s.paths, 0)
    let text = strs_get(s.texts, 0)
    // The document's text stands for its file, saved or not (`fx_check_over`); the compilation is
    // checked as a module, so the program's missing `main` (`N0204`) is not among what is published.
    let over_paths = strs_new()
    let over_texts = strs_new()
    strs_push(over_paths, path)
    strs_push(over_texts, text)
    let f = fx_check_over(path, strs_get(s.root, 0), over_paths, over_texts, strs_get(s.library, 0), fe_host_os(), fe_host_arch(), io)
    if fx_refusal(f) != "" { refuse(io, "a source root the reference refuses") }
    if fe_load_failed(f) { refuse(io, "a compilation that does not load") }
    if !fx_carried(f) { refuse(io, fx_why(f)) }
    let d = fx_diags(f)
    let bases = fe_bases(f)
    // Positions are in the text the compilation holds for the file: the loader ends it with a line
    // break where the file does not, and a diagnostic at its end is after that break.
    let held = fx_module_text(f, 0)
    let starts = line_starts(held)
    let out = strs_new()
    for i in 0..dg_len(d) {
        if dg_severity(d, i) == "error" && dg_code(d, i) != "N0204" && file_at(d, i, bases) == 0 { strs_push(out, diagnostic_json(d, i, held, starts)) }
    }
    // The checker's warnings are kept beside its errors (`Ck.w`) and published with them, as the
    // service chains `nazm_core::warnings` after the errors; after a syntax error they are not
    // carried.
    let w = fx_checker(f).w
    // A parser's (or the attributes') diagnostic is the one whose file its stage named.
    let mut syntax = false
    for i in 0..dg_len(d) {
        if ints_get(d.file, i) >= 0 { syntax = true }
    }
    for i in 0..dg_len(w) {
        if file_at(w, i, bases) == 0 {
            if syntax { refuse(io, "a warning beside a syntax error") }
            strs_push(out, diagnostic_json(w, i, held, starts))
        }
    }
    vec_push(s.facts, f)
    publish(io, path, int_to_str(ints_get(s.versions, 0)), out)
}

// --- the document's names ----------------------------------------------------------------------------

// The identifier at byte `at` of `text` (`name_at`): the one holding it, or the one ending there;
// `s` and `e` its span, or -1 for none.
fn name_at(io: IoCap, text: Str, at: Int) -> Ints {
    let kinds = ints_new()
    let starts = ints_new()
    let ends = ints_new()
    let texts = strs_new()
    let d = dg_new()
    lex_all(text, kinds, starts, ends, texts, d)
    if dg_len(d) > 0 { refuse(io, "a position in a document that does not lex") }
    let out = ints_new()
    for k in 0..ints_len(kinds) {
        if ints_get(starts, k) <= at && at < ints_get(ends, k) {
            if ints_get(kinds, k) == k_ident() {
                ints_push(out, ints_get(starts, k))
                ints_push(out, ints_get(ends, k))
                ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
                return out
            }
        }
    }
    for k in 0..ints_len(kinds) {
        if ints_get(kinds, k) == k_ident() && ints_get(ends, k) == at {
            ints_push(out, ints_get(starts, k))
            ints_push(out, ints_get(ends, k))
            ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
            return out
        }
    }
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    out
}

// The located request: the open document, its text, and the identifier there; refused where the
// reference may answer something this port does not know. -1 for `null`.
fn locate(io: IoCap, s: Server, j: J) -> Ints {
    let out = ints_new()
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let pos = j_get(j, p, "position")
    let line = j_get(j, pos, "line")
    let ch = j_get(j, pos, "character")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) || !j_int_in(j, line, 0, 4294967295) || !j_int_in(j, ch, 0, 4294967295) {
        refuse(io, "a request's parameters this port does not read as the reference does")
    }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || vec_len(s.facts) == 0 {
        ints_push(out, 0 - 1)
        ints_push(out, 0 - 2)
        return out
    }
    let text = strs_get(s.texts, k)
    let at = offset(text, line_starts(text), j_int(j, line), j_int(j, ch))
    let span = name_at(io, text, at)
    ints_push(out, ints_get(span, 0))
    ints_push(out, ints_get(span, 1))
    ints_push(out, ints_get(span, 2))
    out
}

// Whether a name with no binding there might still be something the reference answers about: a
// function, a binding of that name elsewhere, or a call site.
fn might_mean(io: IoCap, f: Facts, name: Str, s: Int, e: Int) -> Bool {
    let c = fx_checker(f)
    if ck_site_at(c, s, e) >= 0 { return true }
    for i in 0..ck_fn_count(c) {
        if ck_fn_name(c, i) == name { return true }
    }
    for b in 0..ck_binding_count(c) {
        if ck_binding_name(c, b) == name { return true }
    }
    false
}

// An effect set as `EffectSet`'s `Display` writes it: `{}`, or `{ io, spawn }`.
fn effect_set(mask: Int) -> Str {
    let names = ck_effect_names(mask)
    if strs_len(names) == 0 { return "{}" }
    "{ " + str_join(names, ", ") + " }"
}

// What hover shows of a call to function `i` (`Signature::of_function`, rendered): `fn NAME(a: T,
// …) -> R`, then its declared effects after ` ! `, or, where it declares none, a line of the
// effects its body requires. Refused for a method, a closure, a generic or foreign function, a
// built-in and a call through a value, whose signatures the facts do not spell.
fn call_label(io: IoCap, f: Facts, i: Int) -> Str {
    let c = fx_checker(f)
    if i < 0 { refuse(io, "hover of a call to a built-in or through a value") }
    if ck_fn_closure(c, i) || ck_fn_method(c, i) || ck_fn_generic(c, i) || ck_fn_foreign(c, i) != "" {
        refuse(io, "hover of a call to a method, closure, generic or foreign function")
    }
    let name = ck_fn_name(c, i)
    for k in 0..str_len(name) {
        if str_byte(name, k) == 47 { refuse(io, "hover of a call to an impl's method") }
    }
    let t = fx_tree(f)
    let params = sx_items(t, sx_field(t, ck_fn_node(c, i), "params"))
    let tys = ck_fn_params(c, i)
    if ints_len(params) != strs_len(tys) { refuse(io, "hover of a call whose parameters the facts do not name") }
    let shown = strs_new()
    for k in 0..ints_len(params) {
        let p = sx_name(t, ints_get(params, k), "name")
        if p == "" { refuse(io, "hover of a call whose parameters the facts do not name") }
        strs_push(shown, p + ": " + strs_get(tys, k))
    }
    let sig = "fn " + name + "(" + str_join(shown, ", ") + ") -> " + ck_fn_ret(c, i)
    let declared = ck_fn_declared(c, i)
    if declared >= 0 { return sig + " ! " + effect_set(declared) }
    let required = ck_fn_required(c, i)
    if required < 0 { refuse(io, "hover of a call whose required effects the facts do not know") }
    sig + nl() + "inferred effects: " + effect_set(required)
}

fn hover(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let en = ints_get(span, 1)
    let text = strs_get(s.texts, 0)
    let f = vec_get(s.facts, 0)
    let c = fx_checker(f)
    let name = str_slice(text, st, en)
    let site = ck_site_at(c, st, en)
    if site >= 0 && ck_site_fn(c, site) >= 0 {
        let shown = call_label(io, f, ck_site_fn(c, site))
        return "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
    }
    let b = ck_binding_at(c, st, en)
    // A built-in called, where no local is named: the reference shows nothing.
    if b < 0 && site >= 0 && ck_site_builtin(c, site) >= 0 { return "null" }
    if b < 0 && site >= 0 { refuse(io, "hover of a call through a value") }
    if b < 0 {
        // After a `.` and not called, a name is a field or a variant: no local, no callee.
        let mut after = en
        while after < str_len(text) && (str_byte(text, after) == 32 || str_byte(text, after) == 9) { after += 1 }
        let called = after < str_len(text) && (str_byte(text, after) == 40 || str_byte(text, after) == 91)
        if st > 0 && str_byte(text, st - 1) == 46 && !called { return "null" }
        // A function's name where it is declared: no call is there, and no local.
        if ints_get(span, 2) == k_fn() { return "null" }
        // A local the facts publish no binding for cannot be shown; any other name is nothing hover shows.
        let e = entity_at(f, st, en)
        // A parameter is no use of itself where it is declared: the reference shows nothing there.
        if e >= 0 && fx_ref_kind(f, e) == "local" && fx_ref_decl_start(f, e) == st && fx_ref_decl_end(f, e) == en { return "null" }
        if e >= 0 && fx_ref_kind(f, e) == "local" { refuse(io, "hover of a local the facts publish no binding for") }
        return "null"
    }
    let ty = fx_show(f, ck_binding_ty(c, b))
    let shown = (if ck_binding_mutable(c, b) { "mut " } else { "" }) + ck_binding_name(c, b) + ": " + ty
    "{\"contents\":{\"kind\":\"plaintext\",\"value\":" + json_str(shown) + "},\"range\":" + range(text, line_starts(text), st, en) + "}"
}

fn ident_byte(b: Int) -> Bool { (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128 }

// --- the reference index (`fx_ref_*`): definition, references, rename ----------------------------------

// The entity the identifier at `st..en` of the document (module 0, whose offsets are the compilation's)
// is of — its declaration or one of its uses — or -1 (`ReferenceIndex::target`).
fn entity_at(f: Facts, st: Int, en: Int) -> Int {
    let n = fx_ref_count(f)
    for i in 0..n {
        if fx_ref_decl_start(f, i) == st && fx_ref_decl_end(f, i) == en { return i }
    }
    for i in 0..n {
        for k in 0..fx_ref_use_count(f, i) {
            if fx_ref_use_start(f, i, k) == st && fx_ref_use_end(f, i, k) == en { return i }
        }
    }
    0 - 1
}

// Whether module `m` is a file an editor can open: not the core prelude and not the standard library.
fn module_file(f: Facts, m: Int) -> Bool { m >= 0 && !fe_starts(fx_module_name(f, m), "@") }

// A place in module `m` (local offsets) as a `Location`.
fn loc_json(io: IoCap, f: Facts, m: Int, s: Int, e: Int) -> Str {
    let name = pk_normalise(fx_module_name(f, m))
    if !fe_starts(name, "/") { refuse(io, "a location in a module this port does not name by its path") }
    let t = fx_module_text(f, m)
    "{\"range\":" + range(t, line_starts(t), s, e) + ",\"uri\":" + json_str(uri_of(name)) + "}"
}

fn definition(io: IoCap, s: Server, j: J) -> Str {
    if vec_len(s.facts) > 0 && unreliable(vec_get(s.facts, 0)) { return definition_failing(io, s, j) }
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let f = vec_get(s.facts, 0)
    let e = entity_at(f, st, ints_get(span, 1))
    if e < 0 { return "null" }
    let ds = fx_ref_decl_start(f, e)
    if ds < 0 { return "null" }
    let m = fx_module_at(f, ds)
    if !module_file(f, m) { return "null" }
    let base = fx_module_base(f, m)
    loc_json(io, f, m, ds - base, fx_ref_decl_end(f, e) - base)
}

// Whether location `(m1, s1, e1)` goes before `(m2, s2, e2)`: by path, then start and end.
fn loc_less(f: Facts, m1: Int, s1: Int, e1: Int, m2: Int, s2: Int, e2: Int) -> Bool {
    if m1 != m2 { return fe_path_before(pk_normalise(fx_module_name(f, m1)), pk_normalise(fx_module_name(f, m2))) }
    if s1 != s2 { return s1 < s2 }
    e1 < e2
}

fn references(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let inc = j_get(j, j_get(j, p, "context"), "includeDeclaration")
    if j_kind(j, inc) != 1 && j_kind(j, inc) != 2 { refuse(io, "a `references` request whose context this port does not read as the reference does") }
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let f = vec_get(s.facts, 0)
    if unreliable(f) { refuse(io, "references in a compilation whose errors leave the facts' index unlike the reference's") }
    let e = entity_at(f, st, ints_get(span, 1))
    if e < 0 { return "null" }
    // The facts record a trait's method as used in its own default methods' bodies, where the reference does not.
    if fx_ref_kind(f, e) == "trait method" { refuse(io, "the references of a trait's method") }
    // The uses in the files an editor can open, and the declaration where asked for and there is one.
    let ms = ints_new()
    let ss = ints_new()
    let es = ints_new()
    let ds = fx_ref_decl_start(f, e)
    for k in 0..fx_ref_use_count(f, e) {
        let a = fx_ref_use_start(f, e, k)
        let m = fx_module_at(f, a)
        if module_file(f, m) {
            ints_push(ms, m)
            ints_push(ss, a - fx_module_base(f, m))
            ints_push(es, fx_ref_use_end(f, e, k) - fx_module_base(f, m))
        }
    }
    if j_kind(j, inc) == 1 && ds >= 0 {
        let m = fx_module_at(f, ds)
        if module_file(f, m) {
            ints_push(ms, m)
            ints_push(ss, ds - fx_module_base(f, m))
            ints_push(es, fx_ref_decl_end(f, e) - fx_module_base(f, m))
        }
    }
    let order = ints_new()
    for i in 0..ints_len(ms) {
        let mut pos = 0
        while pos < ints_len(order) && !loc_less(f, ints_get(ms, i), ints_get(ss, i), ints_get(es, i), ints_get(ms, ints_get(order, pos)),
                ints_get(ss, ints_get(order, pos)), ints_get(es, ints_get(order, pos))) { pos += 1 }
        ints_push(order, 0)
        let mut k = ints_len(order) - 1
        while k > pos {
            ints_set(order, k, ints_get(order, k - 1))
            k -= 1
        }
        ints_set(order, pos, i)
    }
    let out = strs_new()
    for r in 0..ints_len(order) {
        let i = ints_get(order, r)
        strs_push(out, loc_json(io, f, ints_get(ms, i), ints_get(ss, i), ints_get(es, i)))
    }
    "[" + str_join(out, ",") + "]"
}

fn definition_failing(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let en = ints_get(span, 1)
    let text = strs_get(s.texts, 0)
    let f = vec_get(s.facts, 0)
    let c = fx_checker(f)
    let name = str_slice(text, st, en)
    let b = ck_binding_at(c, st, en)
    if b < 0 {
        // What the checker recorded the name refers to: a function called or used as a value, a
        // record built, a variant named — declared in its module's file, or in the standard
        // library's or the prelude's, which have no file to open. Anything else (a type in a
        // signature, a constant, a field) is not indexed by the facts.
        // A built-in called has no declaration to go to.
        let site = ck_site_at(c, st, en)
        if site >= 0 && ck_site_builtin(c, site) >= 0 { return "null" }
        let mut at = fx_declaration_at(f, 0, st, en)
        // A variant is recorded at its whole path, `Enum.Variant`.
        if ints_len(at) == 0 && st > 1 && str_byte(text, st - 1) == 46 {
            let mut q = st - 1
            while q > 0 && ident_byte(str_byte(text, q - 1)) { q -= 1 }
            if q < st - 1 { at = fx_declaration_at(f, 0, q, en) }
        }
        if ints_len(at) == 0 { refuse(io, "definition of what the facts index no declaration for") }
        let m = ints_get(at, 0)
        let mname = fx_module_name(f, m)
        if fe_starts(mname, "@") { return "null" }
        if !fe_starts(mname, "/") { refuse(io, "definition in a module this port does not name by its path") }
        let mtext = fx_module_text(f, m)
        return "{\"range\":" + range(mtext, line_starts(mtext), ints_get(at, 1), ints_get(at, 2)) + ",\"uri\":" + json_str(uri_of(mname)) + "}"
    }
    let ds = ck_binding_start(c, b)
    let de = ck_binding_end(c, b)
    if ds < 0 || de > str_len(text) { refuse(io, "definition of a binding declared elsewhere") }
    "{\"range\":" + range(text, line_starts(text), ds, de) + ",\"uri\":" + json_str(uri_of(strs_get(s.paths, 0))) + "}"
}

// --- rename (`rename.rs`) ---------------------------------------------------------------------------------

// Whether the entity's owning top-level definition is exported (`exported`): a function, record or enum with
// `pub`, or a field, variant or payload field of one; a local or a constant never. An entity the tables
// do not have is taken to be exported.
fn exported(f: Facts, kind: Str, ds: Int) -> Bool {
    let c = fx_checker(f)
    if kind == "local" || kind == "constant" { return false }
    let m = fx_module_at(f, ds)
    let local = ds - fx_module_base(f, m)
    if kind == "function" {
        for i in 0..ck_fn_count(c) {
            if ck_fn_name_start(c, i) == ds && !ck_fn_closure(c, i) { return ck_fn_public(c, i) }
        }
        return true
    }
    let t = fx_tree(f)
    if kind == "record" || kind == "field" {
        for r in 0..ck_record_count(c) {
            let node = ck_record_node(c, r)
            if ck_record_module(c, r) != m || node < 0 { continue }
            let span = sx_field(t, node, "span")
            if kind == "record" && ck_record_name_start(c, r) == ds { return ck_record_public(c, r) }
            if kind == "field" && fx_start(f, span) <= local && local < fx_end(f, span) { return ck_record_public(c, r) }
        }
        return true
    }
    for e in 0..ck_enum_count(c) {
        let node = ck_enum_node(c, e)
        if ck_enum_module(c, e) != m || node < 0 { continue }
        let span = sx_field(t, node, "span")
        if kind == "enum" && ck_enum_name_start(c, e) == ds { return ck_enum_public(c, e) }
        if kind != "enum" && fx_start(f, span) <= local && local < fx_end(f, span) { return ck_enum_public(c, e) }
    }
    true
}

// The reason a rename of the entity at `st..en` is not offered (`Refusal`'s words), "" where it is; then
// `out` holds the entity, where it is declared (its module and local offsets) and its name.
fn renameable(io: IoCap, s: Server, f: Facts, st: Int, en: Int, out: Strs) -> Str {
    let e = entity_at(f, st, en)
    if e < 0 { return "nothing a program declared is named here" }
    let kind = fx_ref_kind(f, e)
    if kind == "trait" || kind == "trait method" {
        return "not every occurrence is known: a trait's methods are written again in every impl of it"
    }
    let ds = fx_ref_decl_start(f, e)
    let toolchain = "this is the core prelude's, which the toolchain owns"
    if ds < 0 { return toolchain }
    let m = fx_module_at(f, ds)
    if fx_module_name(f, m) == "@core/prelude.nz" { return toolchain }
    if exported(f, kind, ds) {
        // Within a declared workspace every module that can name it is searched: not carried.
        let root = pk_decide(strs_get(s.paths, 0), io)
        if strs_get(s.root, 0) != "" || pk_root_how(root) != 0 { refuse(io, "a rename of an exported name within a declared workspace") }
        return "this is exported, and a module no open program loads may use it, so every occurrence cannot be known; declare a workspace (a `nazm.root` marker or `--source-root`) and every module under it is searched"
    }
    if first_error(f) >= 0 { return "a program containing this has errors, so its uses are not all known" }
    let base = fx_module_base(f, m)
    strs_push(out, int_to_str(e))
    strs_push(out, int_to_str(m))
    strs_push(out, int_to_str(ds - base))
    strs_push(out, int_to_str(fx_ref_decl_end(f, e) - base))
    strs_push(out, str_slice(fx_module_text(f, m), ds - base, fx_ref_decl_end(f, e) - base))
    ""
}

// Whether the facts' reference index may differ from the reference's for this compilation: a parser stage
// reported, or a diagnostic of a kind after which the checker leaves out what the reference still records (an
// item it refuses to declare, a closure it does not check, a trait it does not know).
fn unreliable(f: Facts) -> Bool {
    let d = fx_diags(f)
    for i in 0..dg_len(d) {
        if ints_get(d.file, i) >= 0 { return true }
        let c = dg_code(d, i)
        if c == "N0203" || c == "N0386" || c == "N0305" || c == "N0101" || c == "N0334" || c == "N0610" { return true }
    }
    false
}

// The first diagnostic of a module's analysis (the program's missing `main` is no part of it), or -1.
fn first_error(f: Facts) -> Int {
    let d = fx_diags(f)
    for i in 0..dg_len(d) {
        if dg_severity(d, i) == "error" && dg_code(d, i) != "N0204" { return i }
    }
    0 - 1
}

fn num(s: Str) -> Int {
    let mut n = 0
    for i in 0..str_len(s) { n = n * 10 + str_byte(s, i) - 48 }
    n
}

fn prepare_rename(io: IoCap, s: Server, j: J) -> Str {
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 { return "null" }
    let f = vec_get(s.facts, 0)
    if unreliable(f) { refuse(io, "a rename in a compilation whose errors leave the facts' index unlike the reference's") }
    let info = strs_new()
    if renameable(io, s, f, st, ints_get(span, 1), info) != "" { return "null" }
    let text = strs_get(s.texts, 0)
    "{\"placeholder\":" + json_str(strs_get(info, 4)) + ",\"range\":" + range(text, line_starts(text), st, ints_get(span, 1)) + "}"
}

// `valid_name`: the reason `name` is no identifier, "" where it is one.
fn invalid_name(name: Str) -> Str {
    if name == "" { return "is empty" }
    if name == "_" { return "is `_`, which discards rather than names" }
    let kinds = ints_new()
    let starts = ints_new()
    let ends = ints_new()
    let texts = strs_new()
    let d = dg_new()
    lex_all(name, kinds, starts, ends, texts, d)
    if dg_len(d) > 0 { return "is not a token" }
    let real = ints_len(kinds)
    let only = real - 1
    if real == 1 && ints_get(kinds, only) == k_ident() && ints_get(starts, only) == 0 && ints_get(ends, only) == str_len(name) { return "" }
    if real == 1 && ints_get(kinds, only) != k_ident() { return "is a keyword or a symbol, not an identifier" }
    "is not one identifier"
}

// How a compilation's occurrences group into entities: for each entity, its kind and the sorted places of
// its declaration and uses, the groups sorted and each once. `edits` (starts, ends, replacement lengths of
// module `shifted`, ordered) moves that module's offsets past a rename's edits.
fn partition(f: Facts, shifted: Int, e_start: Ints, e_end: Ints, e_len: Ints) -> Strs {
    let groups = strs_new()
    for i in 0..fx_ref_count(f) {
        let places = strs_new()
        let ds = fx_ref_decl_start(f, i)
        if ds >= 0 { strs_push(places, place_of(f, ds, fx_ref_decl_end(f, i), shifted, e_start, e_end, e_len)) }
        for k in 0..fx_ref_use_count(f, i) {
            strs_push(places, place_of(f, fx_ref_use_start(f, i, k), fx_ref_use_end(f, i, k), shifted, e_start, e_end, e_len))
        }
        strs_push(groups, fx_ref_kind(f, i) + "|" + str_join(sort_places(places), ";"))
    }
    sort_unique(groups)
}

// `moved`: a span's place after the edits (ordered, disjoint) are applied: `NAME:START-END`, zero-padded so
// that places sort as (name, start, end) do.
fn place_of(f: Facts, a: Int, b: Int, shifted: Int, e_start: Ints, e_end: Ints, e_len: Ints) -> Str {
    let m = fx_module_at(f, a)
    let base = fx_module_base(f, m)
    let mut s = a - base
    let mut e = b - base
    if m == shifted {
        let mut delta = 0
        let mut done = false
        for k in 0..ints_len(e_start) {
            if !done {
                let grew = ints_get(e_len, k) - ints_get(e_end, k) + ints_get(e_start, k)
                if ints_get(e_start, k) == s && ints_get(e_end, k) == e {
                    s = s + delta
                    e = s + ints_get(e_len, k)
                    done = true
                } else if ints_get(e_end, k) <= s {
                    delta += grew
                }
            }
        }
        if !done {
            s = s + delta
            e = e + delta
        }
    }
    fx_module_name(f, m) + str_from_byte(0) + pad(s) + "-" + pad(e)
}

fn pad(n: Int) -> Str {
    let t = int_to_str(n)
    let mut z = ""
    for i in 0..12 - str_len(t) { z = z + "0" }
    z + t
}

fn sort_places(xs: Strs) -> Strs { sort_strs(xs) }

fn sort_strs(xs: Strs) -> Strs {
    let n = strs_len(xs)
    if n < 2 { return xs }
    let mid = n / 2
    let left = strs_new()
    let right = strs_new()
    for i in 0..mid { strs_push(left, strs_get(xs, i)) }
    for i in mid..n { strs_push(right, strs_get(xs, i)) }
    let a = sort_strs(left)
    let b = sort_strs(right)
    let out = strs_new()
    let mut i = 0
    let mut k = 0
    while i < strs_len(a) && k < strs_len(b) {
        if fe_str_less(strs_get(b, k), strs_get(a, i)) {
            strs_push(out, strs_get(b, k))
            k += 1
        } else {
            strs_push(out, strs_get(a, i))
            i += 1
        }
    }
    while i < strs_len(a) {
        strs_push(out, strs_get(a, i))
        i += 1
    }
    while k < strs_len(b) {
        strs_push(out, strs_get(b, k))
        k += 1
    }
    out
}

fn sort_unique(xs: Strs) -> Strs {
    let sorted = sort_strs(xs)
    let out = strs_new()
    for i in 0..strs_len(sorted) {
        if i == 0 || strs_get(sorted, i) != strs_get(sorted, i - 1) { strs_push(out, strs_get(sorted, i)) }
    }
    out
}

fn same_strs(a: Strs, b: Strs) -> Bool {
    if strs_len(a) != strs_len(b) { return false }
    for i in 0..strs_len(a) {
        if strs_get(a, i) != strs_get(b, i) { return false }
    }
    true
}

fn failure(io: IoCap, id: Str, why: Str) -> Int { respond_error(io, id, 0 - 32803, "nazm cannot rename this: " + why) }

// `textDocument/rename`: the validated plan as a versioned edit, or why there is none.
fn rename(io: IoCap, s: Server, j: J, id: Str) -> Int {
    let p = j_get(j, 0, "params")
    let name = j_get(j, p, "newName")
    if j_kind(j, name) != 4 { refuse(io, "a `rename` request without a `newName` string") }
    let span = locate(io, s, j)
    let st = ints_get(span, 0)
    if st < 0 && ints_get(span, 1) == 0 - 2 { return respond_error(io, id, 0 - 32803, "the document is not open") }
    if st < 0 { return failure(io, id, "nothing a program declared is named here") }
    let f = vec_get(s.facts, 0)
    if unreliable(f) { refuse(io, "a rename in a compilation whose errors leave the facts' index unlike the reference's") }
    let info = strs_new()
    let why = renameable(io, s, f, st, ints_get(span, 1), info)
    if why != "" { return failure(io, id, why) }
    let bad = invalid_name(j_str(j, name))
    if bad != "" { return failure(io, id, "the new name " + bad) }
    let old = strs_get(info, 4)
    if j_str(j, name) == old { return failure(io, id, "the new name is the current one") }
    let e = num(strs_get(info, 0))
    let m = num(strs_get(info, 1))
    if m != 0 { refuse(io, "a rename that edits another file than the document") }
    // The declaration and every use, in the declaring file, ordered.
    let text = fx_module_text(f, m)
    let base = fx_module_base(f, m)
    let starts = ints_new()
    let ends = ints_new()
    ints_push(starts, num(strs_get(info, 2)))
    ints_push(ends, num(strs_get(info, 3)))
    for k in 0..fx_ref_use_count(f, e) {
        let a = fx_ref_use_start(f, e, k)
        if fx_module_at(f, a) != m { return failure(io, id, "refused: a use outside the declaring file") }
        let mut at = ints_len(starts)
        while at > 0 && (ints_get(starts, at - 1) > a - base || (ints_get(starts, at - 1) == a - base && ints_get(ends, at - 1) > fx_ref_use_end(f, e, k) - base)) { at -= 1 }
        ints_push(starts, 0)
        ints_push(ends, 0)
        let mut q = ints_len(starts) - 1
        while q > at {
            ints_set(starts, q, ints_get(starts, q - 1))
            ints_set(ends, q, ints_get(ends, q - 1))
            q -= 1
        }
        ints_set(starts, at, a - base)
        ints_set(ends, at, fx_ref_use_end(f, e, k) - base)
    }
    // Written under a name a re-export gave it, an occurrence keeps its spelling.
    let e_start = ints_new()
    let e_end = ints_new()
    let e_len = ints_new()
    for k in 0..ints_len(starts) {
        if str_slice(text, ints_get(starts, k), ints_get(ends, k)) != old { continue }
        if ints_len(e_end) > 0 && ints_get(e_end, ints_len(e_end) - 1) > ints_get(starts, k) { return failure(io, id, "refused: two occurrences overlap") }
        ints_push(e_start, ints_get(starts, k))
        ints_push(e_end, ints_get(ends, k))
        ints_push(e_len, str_len(j_str(j, name)))
    }
    // The candidate program: the document with the edits, checked as the document is.
    let parts = strs_new()
    let mut at = 0
    for k in 0..ints_len(e_start) {
        strs_push(parts, str_slice(text, at, ints_get(e_start, k)))
        strs_push(parts, j_str(j, name))
        at = ints_get(e_end, k)
    }
    strs_push(parts, str_slice(text, at, str_len(text)))
    let edited = str_join(parts, "")
    let over_paths = strs_new()
    let over_texts = strs_new()
    strs_push(over_paths, strs_get(s.paths, 0))
    strs_push(over_texts, edited)
    let g = fx_check_over(strs_get(s.paths, 0), strs_get(s.root, 0), over_paths, over_texts, strs_get(s.library, 0), fe_host_os(), fe_host_arch(), io)
    if fx_refusal(g) != "" { refuse(io, "a source root the reference refuses") }
    if fe_load_failed(g) { refuse(io, "a candidate program that does not load") }
    if !fx_carried(g) { refuse(io, fx_why(g)) }
    if first_error(g) >= 0 {
        return failure(io, id, "the renamed program would not check: " + strs_get(fx_diags(g).message, first_error(g)))
    }
    if !same_strs(partition(f, m, e_start, e_end, e_len), partition(g, 0 - 1, ints_new(), ints_new(), ints_new())) {
        return failure(io, id, "the renamed program would mean something else: a use would refer to a different definition")
    }
    // `plan_is_current`: the text the plan was made from is the document's.
    if strs_get(s.texts, 0) != text { return respond_error(io, id, 0 - 32803, "the program changed while the rename was being planned") }
    if ints_get(s.flags, 0) == 0 {
        return respond_error(io, id, 0 - 32803, "this client does not accept versioned edits, so a rename could be applied to a" + spaces(14)
                + "document that has since changed")
    }
    let starts_of = line_starts(text)
    let edits = strs_new()
    for k in 0..ints_len(e_start) {
        strs_push(edits, "{\"newText\":" + json_str(j_str(j, name)) + ",\"range\":" + range(text, starts_of, ints_get(e_start, k), ints_get(e_end, k)) + "}")
    }
    respond(io, id, "{\"documentChanges\":[{\"edits\":[" + str_join(edits, ",") + "],\"textDocument\":{\"uri\":" + json_str(uri_of(strs_get(s.paths, 0)))
            + ",\"version\":" + int_to_str(ints_get(s.versions, 0)) + "}}]}")
}

fn spaces(n: Int) -> Str {
    let mut out = ""
    for i in 0..n { out = out + " " }
    out
}

// --- symbols (`symbols.rs`) -------------------------------------------------------------------------------

// The declarations of one file, with those it holds: kind (1 function, 2 record, 3 enum, 4 variant, 5 field,
// 6 payload field), name, its whole declaration and its name (local offsets), what it is (`detail`, with
// `has` saying there is one) and the symbol it is declared in (-1 for none).
struct Sy {
    kind: Ints,
    name: Strs,
    start: Ints,
    end: Ints,
    ns: Ints,
    ne: Ints,
    detail: Strs,
    has: Ints,
    parent: Ints,
}

fn sy_new() -> Sy {
    Sy(kind: ints_new(), name: strs_new(), start: ints_new(), end: ints_new(), ns: ints_new(), ne: ints_new(), detail: strs_new(), has: ints_new(), parent: ints_new())
}

fn sy_add(y: Sy, kind: Int, name: Str, s: Int, e: Int, ns: Int, ne: Int, detail: Str, has: Bool, parent: Int) -> Int {
    ints_push(y.kind, kind)
    strs_push(y.name, name)
    ints_push(y.start, s)
    ints_push(y.end, e)
    ints_push(y.ns, ns)
    ints_push(y.ne, ne)
    strs_push(y.detail, detail)
    ints_push(y.has, if has { 1 } else { 0 })
    ints_push(y.parent, parent)
    ints_len(y.kind) - 1
}

// The symbols declared in `parent` (-1 for the top level), in source order.
fn sy_kids(y: Sy, parent: Int) -> Ints {
    let out = ints_new()
    for i in 0..ints_len(y.kind) {
        if ints_get(y.parent, i) != parent { continue }
        let mut at = ints_len(out)
        while at > 0 && (ints_get(y.start, ints_get(out, at - 1)) > ints_get(y.start, i)
                || (ints_get(y.start, ints_get(out, at - 1)) == ints_get(y.start, i) && ints_get(y.ns, ints_get(out, at - 1)) > ints_get(y.ns, i))) { at -= 1 }
        ints_push(out, 0)
        let mut k = ints_len(out) - 1
        while k > at {
            ints_set(out, k, ints_get(out, k - 1))
            k -= 1
        }
        ints_set(out, at, i)
    }
    out
}

// `fn NAME[T: Equality](a: T) -> R ! { … }`: the declared signature of function `i`, as `Signature::render`
// spells it. Refused for a foreign function and for one with an effect parameter, whose labels the facts do
// not spell.
fn fn_label(io: IoCap, f: Facts, i: Int) -> Str {
    let c = fx_checker(f)
    let t = fx_tree(f)
    if ck_fn_foreign(c, i) != "" { refuse(io, "a foreign function's signature") }
    let node = ck_fn_node(c, i)
    let params = sx_items(t, sx_field(t, node, "params"))
    let tys = ck_fn_params(c, i)
    let shown = strs_new()
    // `main`'s `out` is written nowhere: the checker gives it first.
    let implicit = strs_len(tys) - ints_len(params)
    if implicit < 0 || implicit > 1 { refuse(io, "a function whose parameters the facts do not name") }
    if implicit == 1 { strs_push(shown, "out: " + strs_get(tys, 0)) }
    for k in 0..ints_len(params) {
        let p = sx_name(t, ints_get(params, k), "name")
        if p == "" { refuse(io, "a function whose parameters the facts do not name") }
        strs_push(shown, p + ": " + strs_get(tys, k + implicit))
    }
    let mut sig = "fn " + ck_fn_name(c, i)
    let tps = sx_items(t, sx_field(t, node, "type_params"))
    if ints_len(tps) > 0 {
        let names = strs_new()
        for k in 0..ints_len(tps) {
            let tp = ints_get(tps, k)
            if sx_text(t, sx_field(t, tp, "effect")) == "true" { refuse(io, "a function with an effect parameter") }
            let req = sx_field(t, tp, "requires")
            strs_push(names, sx_name(t, tp, "name") + (if sx_is_some(t, req) && sx_name(t, sx_unwrap(t, req), "name") == "Equality" { ": Equality" } else { "" }))
        }
        sig = sig + "[" + str_join(names, ", ") + "]"
    }
    sig = sig + "(" + str_join(shown, ", ") + ") -> " + ck_fn_ret(c, i)
    let declared = ck_fn_declared(c, i)
    if declared >= 0 { sig = sig + " ! " + effect_set(declared) }
    sig
}

// The symbols of module `m` (`declared_in`): functions, then records, then enums; each in source order
// within its parent. `details` asks for the labels (a document's outline), which the facts spell for fewer
// functions than they list.
fn symbols_of(io: IoCap, f: Facts, m: Int, details: Bool) -> Sy {
    let c = fx_checker(f)
    let t = fx_tree(f)
    let y = sy_new()
    let base = fx_module_base(f, m)
    for i in 0..ck_fn_count(c) {
        if ck_fn_module(c, i) != m || ck_fn_closure(c, i) { continue }
        let node = ck_fn_node(c, i)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let sig = if details { fn_label(io, f, i) } else { "" }
        sy_add(y, 1, ck_fn_name(c, i), fx_start(f, span), fx_end(f, span), ck_fn_name_start(c, i) - base, ck_fn_name_end(c, i) - base, sig, details, 0 - 1)
    }
    for r in 0..ck_record_count(c) {
        if ck_record_module(c, r) != m { continue }
        let node = ck_record_node(c, r)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let at = sy_add(y, 2, ck_record_name(c, r), fx_start(f, span), fx_end(f, span), ck_record_name_start(c, r) - base, ck_record_name_end(c, r) - base, "", false, 0 - 1)
        let rt = fx_record_type(f, r)
        let fields = sx_items(t, sx_field(t, node, "fields"))
        if rt < 0 || ck_record_arity(c, rt) != ints_len(fields) { refuse(io, "a record whose fields the facts do not publish") }
        for k in 0..ints_len(fields) {
            let fd = ints_get(fields, k)
            let fs = sx_field(t, fd, "span")
            let ns = sx_field(t, fd, "name_span")
            sy_add(y, 5, ck_record_field_name(c, rt, k), fx_start(f, fs), fx_end(f, fs), fx_start(f, ns), fx_end(f, ns),
                    fx_show(f, fx_record_field_ty(f, rt, k)), true, at)
        }
    }
    for e in 0..ck_enum_count(c) {
        if ck_enum_module(c, e) != m { continue }
        let node = ck_enum_node(c, e)
        if node < 0 { continue }
        let span = sx_field(t, node, "span")
        let at = sy_add(y, 3, ck_enum_name(c, e), fx_start(f, span), fx_end(f, span), ck_enum_name_start(c, e) - base, ck_enum_name_end(c, e) - base, "", false, 0 - 1)
        let et = fx_enum_type(f, e)
        let variants = sx_items(t, sx_field(t, node, "variants"))
        if et < 0 || ck_variant_count(c, et) != ints_len(variants) { refuse(io, "an enum whose variants the facts do not publish") }
        for v in 0..ints_len(variants) {
            let vn = ints_get(variants, v)
            let vs = sx_field(t, vn, "span")
            let vns = sx_field(t, vn, "name_span")
            let payload = sx_items(t, sx_field(t, vn, "fields"))
            if ck_variant_arity(c, et, v) != ints_len(payload) { refuse(io, "a variant whose payload the facts do not publish") }
            let listed = strs_new()
            for k in 0..ints_len(payload) { strs_push(listed, ck_payload_name(c, et, v, k) + ": " + fx_show(f, fx_payload_ty(f, et, v, k))) }
            let vname = ck_variant_name(c, et, v)
            let vat = sy_add(y, 4, vname, fx_start(f, vs), fx_end(f, vs), fx_start(f, vns), fx_end(f, vns), vname + "(" + str_join(listed, ", ") + ")", ints_len(payload) > 0, at)
            for k in 0..ints_len(payload) {
                let pn = ints_get(payload, k)
                let ps = sx_field(t, pn, "span")
                let pns = sx_field(t, pn, "name_span")
                sy_add(y, 6, ck_payload_name(c, et, v, k), fx_start(f, ps), fx_end(f, ps), fx_start(f, pns), fx_end(f, pns),
                        fx_show(f, fx_payload_ty(f, et, v, k)), true, vat)
            }
        }
    }
    y
}

// The protocol's `SymbolKind` of a symbol kind.
fn lsp_kind(kind: Int) -> Int {
    if kind == 1 { return 12 }
    if kind == 2 { return 23 }
    if kind == 3 { return 10 }
    if kind == 4 { return 22 }
    8
}

fn sy_nested(f: Facts, y: Sy, i: Int, text: Str, starts: Ints) -> Str {
    let kids = sy_kids(y, i)
    let parts = strs_new()
    if ints_len(kids) > 0 {
        let inner = strs_new()
        for k in 0..ints_len(kids) { strs_push(inner, sy_nested(f, y, ints_get(kids, k), text, starts)) }
        strs_push(parts, "\"children\":[" + str_join(inner, ",") + "]")
    }
    if ints_get(y.has, i) == 1 { strs_push(parts, "\"detail\":" + json_str(strs_get(y.detail, i))) }
    strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
    strs_push(parts, "\"name\":" + json_str(strs_get(y.name, i)))
    strs_push(parts, "\"range\":" + range(text, starts, ints_get(y.start, i), ints_get(y.end, i)))
    strs_push(parts, "\"selectionRange\":" + range(text, starts, ints_get(y.ns, i), ints_get(y.ne, i)))
    "{" + str_join(parts, ",") + "}"
}

fn sy_flat(y: Sy, i: Int, container: Str, has_container: Bool, uri: Str, text: Str, starts: Ints, out: Strs) -> Int {
    let mut parts = strs_new()
    if has_container { strs_push(parts, "\"containerName\":" + json_str(container)) }
    strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
    strs_push(parts, "\"location\":{\"range\":" + range(text, starts, ints_get(y.start, i), ints_get(y.end, i)) + ",\"uri\":" + json_str(uri) + "}")
    strs_push(parts, "\"name\":" + json_str(strs_get(y.name, i)))
    strs_push(out, "{" + str_join(parts, ",") + "}")
    let kids = sy_kids(y, i)
    for k in 0..ints_len(kids) { sy_flat(y, ints_get(kids, k), strs_get(y.name, i), true, uri, text, starts, out) }
    0
}

// Whether a parser or the attributes reported (a stage that named the file): what the checker declares after
// is then not the text's items.
fn parse_failed(f: Facts) -> Bool {
    let d = fx_diags(f)
    for i in 0..dg_len(d) {
        if ints_get(d.file, i) >= 0 { return true }
    }
    false
}

fn document_symbols(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) { refuse(io, "a request's parameters this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    let k = if path == "" { 0 - 1 } else { doc_named(io, s, path) }
    if k < 0 || vec_len(s.facts) == 0 { return "null" }
    let f = vec_get(s.facts, 0)
    if parse_failed(f) { refuse(io, "the symbols of a document the parser read with recovery") }
    let y = symbols_of(io, f, 0, true)
    let text = fx_module_text(f, 0)
    let starts = line_starts(text)
    let top = sy_kids(y, 0 - 1)
    let out = strs_new()
    if ints_get(s.flags, 1) == 1 {
        for i in 0..ints_len(top) { strs_push(out, sy_nested(f, y, ints_get(top, i), text, starts)) }
    } else {
        for i in 0..ints_len(top) { sy_flat(y, ints_get(top, i), "", false, j_str(j, uri), text, starts, out) }
    }
    "[" + str_join(out, ",") + "]"
}

// `workspace/symbol`: every declaration of every file of the compilation whose name holds the query, by
// name, then file, then where its name is, then kind.
fn workspace_symbols(io: IoCap, s: Server, j: J) -> Str {
    let p = j_get(j, 0, "params")
    let q = j_get(j, p, "query")
    if j_kind(j, q) != 4 { refuse(io, "a `workspace/symbol` request without a query") }
    if vec_len(s.facts) == 0 { return "[]" }
    let f = vec_get(s.facts, 0)
    if parse_failed(f) { refuse(io, "the symbols of a document the parser read with recovery") }
    let query = j_str(j, q)
    // One row per symbol: a sortable key, then the response object.
    let rows = strs_new()
    for m in 0..fx_modules(f) {
        if !module_file(f, m) { continue }
        let y = symbols_of(io, f, m, false)
        let text = fx_module_text(f, m)
        let starts = line_starts(text)
        for i in 0..ints_len(y.kind) {
            let name = strs_get(y.name, i)
            if !ut_contains_text(name, query) { continue }
            let par = ints_get(y.parent, i)
            let mut container = ""
            if par >= 0 {
                container = strs_get(y.name, par)
                // A payload field is in its variant, which is in its enum.
                if ints_get(y.kind, i) == 6 { container = strs_get(y.name, ints_get(y.parent, par)) + "." + strs_get(y.name, par) }
            }
            let mut parts = strs_new()
            if par >= 0 { strs_push(parts, "\"containerName\":" + json_str(container)) }
            strs_push(parts, "\"kind\":" + int_to_str(lsp_kind(ints_get(y.kind, i))))
            strs_push(parts, "\"location\":" + loc_json(io, f, m, ints_get(y.ns, i), ints_get(y.ne, i)))
            strs_push(parts, "\"name\":" + json_str(name))
            // (name, path, where the name is, kind), in that order, each a fixed-width field.
            let key = name + str_from_byte(0) + path_key(pk_normalise(fx_module_name(f, m))) + str_from_byte(0) + pad(ints_get(y.ns, i)) + int_to_str(ints_get(y.kind, i))
            strs_push(rows, key + str_from_byte(1) + "{" + str_join(parts, ",") + "}")
        }
    }
    let sorted = sort_strs(rows)
    let out = strs_new()
    for i in 0..strs_len(sorted) {
        let row = strs_get(sorted, i)
        let mut cut = 0
        while str_byte(row, cut) != 1 { cut += 1 }
        strs_push(out, str_slice(row, cut + 1, str_len(row)))
    }
    "[" + str_join(out, ",") + "]"
}

// A path as a string that sorts as `Path`'s order does: a component before the longer ones it begins.
fn path_key(p: Str) -> Str {
    let out = strs_new()
    for i in 0..str_len(p) {
        if str_byte(p, i) == 47 { strs_push(out, str_from_byte(2)) } else { strs_push(out, str_slice(p, i, i + 1)) }
    }
    str_join(out, "")
}

fn ut_contains_text(s: Str, p: Str) -> Bool {
    let n = str_len(p)
    let mut i = 0
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == p { return true }
        i += 1
    }
    false
}

// --- the messages ----------------------------------------------------------------------------------------

fn did_open(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let version = j_get(j, td, "version")
    let text = j_get(j, td, "text")
    let lang = j_get(j, td, "languageId")
    if j_twice(j, p) || j_twice(j, td) { refuse(io, "a duplicate field") }
    if j_kind(j, uri) != 4 || j_kind(j, text) != 4 || j_kind(j, lang) != 4 || !j_int_in(j, version, 0 - 2147483648, 2147483647) {
        refuse(io, "a `didOpen` this port does not read as the reference does")
    }
    if !plain_uri(j_str(j, uri)) { refuse(io, "a URI this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    if k >= 0 {
        ints_set(s.versions, k, j_int(j, version))
        strs_set(s.texts, k, j_str(j, text))
    } else {
        strs_push(s.paths, path)
        ints_push(s.versions, j_int(j, version))
        strs_push(s.texts, j_str(j, text))
    }
    refresh(io, s)
}

fn did_change(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    let version = j_get(j, td, "version")
    let changes = j_get(j, p, "contentChanges")
    if j_kind(j, uri) != 4 || !j_int_in(j, version, 0 - 2147483648, 2147483647) || j_kind(j, changes) != 5 || !plain_uri(j_str(j, uri)) {
        refuse(io, "a `didChange` this port does not read as the reference does")
    }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    if k < 0 { return 0 }
    let mut text = strs_get(s.texts, k)
    let mut c = ints_get(j.first, changes)
    while c >= 0 {
        let r = j_get(j, c, "range")
        let t = j_get(j, c, "text")
        if j_kind(j, t) != 4 { refuse(io, "a change this port does not read") }
        let mut a = 0
        let mut b = str_len(text)
        if r >= 0 && j_kind(j, r) != 0 {
            let starts = line_starts(text)
            let rs = j_get(j, r, "start")
            let re = j_get(j, r, "end")
            let l0 = j_get(j, rs, "line")
            let c0 = j_get(j, rs, "character")
            let l1 = j_get(j, re, "line")
            let c1 = j_get(j, re, "character")
            if !j_int_in(j, l0, 0, 4294967295) || !j_int_in(j, c0, 0, 4294967295) || !j_int_in(j, l1, 0, 4294967295) || !j_int_in(j, c1, 0, 4294967295) {
                refuse(io, "a change's range this port does not read")
            }
            a = offset(text, starts, j_int(j, l0), j_int(j, c0))
            b = offset(text, starts, j_int(j, l1), j_int(j, c1))
        }
        if a > b {
            eprint("nazm lsp: a change outside the document; send it whole" + nl())
            return 0
        }
        text = str_slice(text, 0, a) + j_str(j, t) + str_slice(text, b, str_len(text))
        c = ints_get(j.next, c)
    }
    ints_set(s.versions, k, j_int(j, version))
    strs_set(s.texts, k, text)
    refresh(io, s)
}

fn did_close(io: IoCap, s: Server, j: J) -> Int {
    let p = j_get(j, 0, "params")
    let td = j_get(j, p, "textDocument")
    let uri = j_get(j, td, "uri")
    if j_kind(j, uri) != 4 || !plain_uri(j_str(j, uri)) { refuse(io, "a `didClose` this port does not read as the reference does") }
    let path = path_of(j_str(j, uri))
    if path == "" { return 0 }
    let k = doc_named(io, s, path)
    let paths = strs_new()
    let versions = ints_new()
    let texts = strs_new()
    for i in 0..strs_len(s.paths) {
        if i != k {
            strs_push(paths, strs_get(s.paths, i))
            ints_push(versions, ints_get(s.versions, i))
            strs_push(texts, strs_get(s.texts, i))
        }
    }
    while strs_len(s.paths) > 0 {
        strs_pop(s.paths)
        ints_pop(s.versions)
        strs_pop(s.texts)
    }
    for i in 0..strs_len(paths) {
        strs_push(s.paths, strs_get(paths, i))
        ints_push(s.versions, ints_get(versions, i))
        strs_push(s.texts, strs_get(texts, i))
    }
    refresh(io, s)
    if k >= 0 { publish(io, path, "", strs_new()) }
    0
}

// Every request method the reference implements, which this port refuses but for hover and
// definition; any other is `MethodNotFound`.
fn implemented(m: Str) -> Bool {
    let all = words("textDocument/definition textDocument/hover textDocument/references textDocument/completion "
            + "textDocument/signatureHelp textDocument/codeAction textDocument/documentSymbol workspace/symbol "
            + "textDocument/semanticTokens/full textDocument/prepareCallHierarchy callHierarchy/incomingCalls "
            + "callHierarchy/outgoingCalls textDocument/prepareRename textDocument/rename")
    for i in 0..strs_len(all) {
        if strs_get(all, i) == m { return true }
    }
    false
}

// The words of `s`, split at single spaces.
fn words(s: Str) -> Strs {
    let out = strs_new()
    let mut from = 0
    for i in 0..str_len(s) + 1 {
        if i == str_len(s) || str_byte(s, i) == 32 {
            strs_push(out, str_slice(s, from, i))
            from = i + 1
        }
    }
    out
}

fn request(io: IoCap, s: Server, j: J, method: Str, id: Str) -> Int {
    if method == "textDocument/hover" { return respond(io, id, hover(io, s, j)) }
    if method == "textDocument/definition" { return respond(io, id, definition(io, s, j)) }
    if method == "textDocument/references" { return respond(io, id, references(io, s, j)) }
    if method == "textDocument/prepareRename" { return respond(io, id, prepare_rename(io, s, j)) }
    if method == "textDocument/rename" { return rename(io, s, j, id) }
    if method == "textDocument/documentSymbol" { return respond(io, id, document_symbols(io, s, j)) }
    if method == "workspace/symbol" { return respond(io, id, workspace_symbols(io, s, j)) }
    if implemented(method) { refuse(io, "`" + method + "`") }
    respond_error(io, id, 0 - 32601, "`" + method + "` is not implemented by nazm lsp")
}

// `nazm lsp`, its arguments read into `c` (`lsp_cli`) from where `cli_from` says.
pub fn lsp_command(io: IoCap, c: Cli) -> Int {
    cli_parse(io, c)
    let given = cli_value(c, 0)
    let root = if cli_present(c, 0) { fe_prefix(io, given) + given } else { "" }
    let library = os_env_get("NAZM_LIBRARY")
    if library == "" { refuse(io, "the standard library's directory (set NAZM_LIBRARY)") }
    let h = os_stdin()
    // `initialize_start`: the first message must be `initialize`.
    let first = read_message(io, h)
    if first == "" {
        eprint("nazm lsp: initialize: disconnected channel" + nl())
        exit_with(4)
    }
    let j0 = message(io, first)
    let id0 = j_get(j0, 0, "id")
    if id0 < 0 || j_str(j0, j_get(j0, 0, "method")) != "initialize" { refuse(io, "a first message that is not `initialize`") }
    if j_kind(j0, j_get(j0, 0, "params")) != 6 { refuse(io, "`initialize` without its parameters") }
    respond(io, id_json(j0, id0), capabilities())
    // `initialize_finish`: then `initialized`.
    let second = read_message(io, h)
    if second == "" { refuse(io, "input that ends before `initialized`") }
    let j1 = message(io, second)
    if j_get(j1, 0, "id") >= 0 || j_str(j1, j_get(j1, 0, "method")) != "initialized" { refuse(io, "a second message that is not `initialized`") }
    let libs = strs_new()
    strs_push(libs, library)
    let roots = strs_new()
    strs_push(roots, root)
    let flags = ints_new()
    let caps = j_get(j0, j_get(j0, 0, "params"), "capabilities")
    ints_push(flags, if j_kind(j0, j_get(j0, j_get(j0, j_get(j0, caps, "workspace"), "workspaceEdit"), "documentChanges")) == 1 { 1 } else { 0 })
    ints_push(flags, if j_kind(j0, j_get(j0, j_get(j0, j_get(j0, caps, "textDocument"), "documentSymbol"), "hierarchicalDocumentSymbolSupport")) == 1 { 1 } else { 0 })
    let s = Server(paths: strs_new(), versions: ints_new(), texts: strs_new(), facts: vec_new[Facts](), library: libs, root: roots, flags: flags)
    while true {
        let body = read_message(io, h)
        if body == "" { return 0 }
        let j = message(io, body)
        let method = j_str(j, j_get(j, 0, "method"))
        let id = j_get(j, 0, "id")
        if id >= 0 {
            let idj = id_json(j, id)
            if method == "shutdown" {
                respond(io, idj, "null")
                // `handle_shutdown`: then `exit`.
                let next = read_message(io, h)
                if next == "" { refuse(io, "input that ends after `shutdown`") }
                let jn = message(io, next)
                if j_get(jn, 0, "id") >= 0 || j_str(jn, j_get(jn, 0, "method")) != "exit" { refuse(io, "a message between `shutdown` and `exit`") }
                return 0
            }
            request(io, s, j, method, idj)
        } else if method == "exit" {
            // `lsp-server`'s reader stops at `exit`, whenever it comes: the connection is closed.
            return 0
        } else if method == "textDocument/didOpen" {
            did_open(io, s, j)
        } else if method == "textDocument/didChange" {
            did_change(io, s, j)
        } else if method == "textDocument/didClose" {
            did_close(io, s, j)
        }
    }
    0
}
