// `nazm build`, written in Nazm: the driver (R8 slices 4, 5 and 6, `openspec/changes/r8-cut-over/design.md`,
// *Slice 4*, S4.1–S4.7, *Slice 5* and *Slice 6*).
//
// `nazm build [OPTIONS] FILE`, run by the dispatcher (`nazm.nz`). A port of
// `crates/nazm-cli/src/build/` for the kept targets (the two macOS ones and Windows x86_64), on the
// default LLVM backend and on Nazm's own code generator (`--backend nazm`):
//
//   the command line  `buildcli.nz`: clap's parser, usage errors and help (`cli.nz`);
//   the package       a package's directory stands for its `main`, held to `--locked` (`lockcheck.nz`);
//   the front end     in process, as `nazm check` runs it (R2's facts, `front.nz`): the diagnostics
//                     as the Rust build writes them, then the Core IR document to the working
//                     directory, and the facts let go;
//   the pipeline      a stage, `nazm-pipeline build` (R3): every unit's LIR; with `--llvm` (the
//                     default backend) each unit as LLVM text (`llvm.nz`, `lldebug.nz`, `llpost.nz`)
//                     and the runtime's units, else the units' LIR with the heap's renaming and the
//                     Nazm backend's runtime units; and the plan;
//   the generator     with `--backend nazm`, a stage, `nzcg` (R9), once over every unit;
//   clang             the LLVM text of every unit, or the runtime's units alone, and the link — or
//                     `--objects DIR` and `link.txt`.
//
// The stages are found by `NAZM_PIPELINE` and `NAZM_NZCG`, or in the directory `NAZM_LIBEXEC`
// names; the standard library by `NAZM_LIBRARY`. Each stage is admitted by `host-run`'s checks
// before it starts (the counted heap linked, one heap limit of at most 2 GiB), the stages run one
// at a time, and each one's peak is held to `host-run`'s withdrawal conditions (design S4.2).
//
// What this port does not carry — Cranelift, the targets the cut-over removes (Linux, WebAssembly, WASI,
// Android, iOS and the boards: the copyright holder's decision), a manifest's `heap-limit`, a
// restriction profile — it says so on standard error and exits 6 before writing anything (R5's
// convention); where the Rust build refuses a target, its refusal is word for word. With and without
// `--no-cache` each unit's object is looked up in the project's object store by its key and only the
// misses are generated, then filed (design S4.5); the runtime's units are compiled by clang or looked up
// likewise.

use "../../compiler/syntax.nz"
use "../../compiler/diag.nz"
use "../../compiler/package.nz"
use "../../compiler/facts.nz"
use "../../compiler/facts-core.nz"
use "front.nz"
use "util.nz"
use "buildcli.nz"
use "cli.nz"
use "summary.nz"
use "lockcheck.nz"
use "group.nz"
use "archive.nz"
use "buildrt.nz"
use "buildprov.nz"
use "harness.nz"
use "profile.nz"
use "runexe.nz"
use "@std/file"
use "@std/blake3"

fn nl() -> Str { str_from_byte(10) }

// --- how a build ends where it does -------------------------------------------------------------------

// The summary `--summary-json` prints in place of the build's own words (`summarized`): the build's outcome and
// the code it exits with, over a second compilation of the root module as the language service reads it; with
// the map when the program was loaded. The exit status is the build's.
fn bd_summary(io: IoCap, o: Opts, status: Str, code: Int, with_map: Bool, artifact: Str) -> Int {
    bd_summary_then(io, o, status, code, with_map, artifact, true)
}

// The same, going on afterwards (the provenance is written after a summary) unless `stop`.
fn bd_summary_then(io: IoCap, o: Opts, status: Str, code: Int, with_map: Bool, artifact: Str, stop: Bool) -> Int {
    let library = os_env_get("NAZM_LIBRARY")
    let abs = fe_prefix(io, o.file) + o.file
    let g = fx_check_module_in(abs, "", library, fe_host_os(), fe_host_arch(), io)
    if !fx_carried(g) {
        eprint("nazm: not carried: " + fx_why(g) + nl())
        exit_with(6)
    }
    print(sm_summary_for("build", artifact, g, g, ints_new(), status, code, bd_readable(io, abs), with_map) + nl())
    if stop { exit_with(code) }
    0
}

// Whether `read_to_string` reads `path` whole.
fn bd_readable(io: IoCap, path: Str) -> Bool {
    if ut_kind(io, path) != 0 { return false }
    let h = os_open_read(path)
    if os_status(h) != 0 { return false }
    os_close(h)
    ut_utf8_ok(read_file(path))
}

// What this port does not carry: said on standard error, status 6.
fn bd_refuse(io: IoCap, o: Opts, why: Str) -> Int {
    eprint("nazm: not carried: " + why + nl())
    if o.summary { bd_summary(io, o, "refused", 6, true, "null") }
    exit_with(6)
    0
}

// A build that stops: `text` on standard error, or the summary with `status`, and `code`.
fn bd_end(io: IoCap, o: Opts, status: Str, with_map: Bool, text: Str, code: Int) -> Int {
    if o.summary { bd_summary(io, o, status, code, with_map, "null") }
    eprint(text + nl())
    exit_with(code)
    0
}

// One after the program was loaded; the summary's status is the toolchain's for 4, a refusal otherwise.
fn bd_fail(io: IoCap, o: Opts, text: Str, code: Int) -> Int {
    // What a failing stage or write says goes to standard error whatever the summary: only a refusal before the
    // build began is silent under `--summary-json`.
    eprint(text + nl())
    if o.summary { bd_summary(io, o, if code == 4 { "toolchain_failed" } else { "refused" }, code, true, "null") }
    exit_with(code)
    0
}

// The same before it was: the summary names no source map.
fn bd_early(io: IoCap, o: Opts, text: Str, code: Int) -> Int {
    bd_end(io, o, "refused", false, text, code)
}

// --- where the time went (`--timings`) -----------------------------------------------------------------

// The phases of a build, each with the nanoseconds since the one before.
struct Clock {
    started: Int,
    last: Ints,
    names: Strs,
    spans: Ints,
}

fn bd_now(tm: TimeCap) -> Int { time_now_ns() }

fn bd_clock(tm: TimeCap) -> Clock {
    let now = bd_now(tm)
    let last = ints_new()
    ints_push(last, now)
    Clock(started: now, last: last, names: strs_new(), spans: ints_new())
}

fn bd_mark(tm: TimeCap, c: Clock, phase: Str) -> Int {
    let now = bd_now(tm)
    strs_push(c.names, phase)
    ints_push(c.spans, now - ints_get(c.last, 0))
    ints_set(c.last, 0, now)
    0
}

// Milliseconds with three decimals, from nanoseconds.
fn bd_ms(ns: Int) -> Str {
    let us = ns / 1000
    let frac = us % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    int_to_str(us / 1000) + "." + pad + int_to_str(frac)
}

// `nazm.timings/1`, one line.
fn bd_timings(tm: TimeCap, c: Clock) -> Str {
    let total = bd_now(tm) - c.started
    let phases = strs_new()
    for i in 0..strs_len(c.names) {
        strs_push(phases, "{\"phase\":\"" + strs_get(c.names, i) + "\",\"ms\":" + bd_ms(ints_get(c.spans, i)) + "}")
    }
    "{\"schema\":\"nazm.timings/1\",\"phases\":[" + str_join(phases, ",") + "],\"total_ms\":" + bd_ms(total) + "}"
}

// --- the target -------------------------------------------------------------------------------

// The host's triple, as `Target::host` names it.
fn bd_host() -> Str {
    let os = fe_host_os()
    let arch = fe_host_arch()
    if os == "macos" { return arch + "-apple-darwin" }
    if os == "windows" { return "x86_64-pc-windows-gnu" }
    arch + "-unknown-linux-gnu"
}

fn bd_os(t: Str) -> Str {
    if ut_contains(t, "-apple-darwin") { return "macos" }
    if ut_contains(t, "-windows-") { return "windows" }
    "linux"
}

fn bd_arch(t: Str) -> Str { if ut_starts(t, "x86_64") { "x86_64" } else { "aarch64" } }

// A triple the Rust compiler generates code for (`Target::parse`).
fn bd_known(t: Str) -> Bool {
    let all = text_split_spaces("aarch64-apple-darwin aarch64-unknown-linux-gnu x86_64-apple-darwin x86_64-unknown-linux-gnu x86_64-pc-windows-gnu aarch64-unknown-none wasm32-unknown-unknown wasm32-wasip1 aarch64-linux-android aarch64-apple-ios riscv64gc-unknown-none-elf thumbv7m-none-eabi thumbv8m.main-none-eabihf riscv32imc-unknown-none-elf")
    for i in 0..strs_len(all) {
        if strs_get(all, i) == t { return true }
    }
    false
}

// A board's target: freestanding and not WebAssembly (`Target::is_board`).
fn bd_is_board(t: Str) -> Bool {
    t == "aarch64-unknown-none" || t == "riscv64gc-unknown-none-elf" || t == "thumbv7m-none-eabi" || t == "thumbv8m.main-none-eabihf"
            || t == "riscv32imc-unknown-none-elf"
}

fn bd_is_wasm(t: Str) -> Bool { t == "wasm32-unknown-unknown" || t == "wasm32-wasip1" }

// No operating system under it, or WASI (`Os::None | Os::Wasi`).
fn bd_freestanding(t: Str) -> Bool { bd_is_board(t) || bd_is_wasm(t) }

fn bd_mobile(t: Str) -> Bool { t == "aarch64-linux-android" || t == "aarch64-apple-ios" }

// The refusal `Target::parse` words for a triple it does not know.
fn bd_unknown_target(t: Str) -> Str {
    "`" + t + "` is not a target this compiler generates code for; the targets are aarch64-apple-darwin, aarch64-unknown-linux-gnu, "
            + "x86_64-apple-darwin, x86_64-unknown-linux-gnu, x86_64-pc-windows-gnu and, freestanding, "
            + "aarch64-unknown-none, riscv64gc-unknown-none-elf, thumbv7m-none-eabi, "
            + "thumbv8m.main-none-eabihf, riscv32imc-unknown-none-elf and "
            + "wasm32-unknown-unknown, WebAssembly with WASI, wasm32-wasip1, and the mobile "
            + "targets aarch64-linux-android and aarch64-apple-ios"
}

// The targets this driver builds for: the two macOS ones and Windows on x86_64, which Nazm's code
// generator carries before 1.0; and Linux, inside the contained runner only, for the self-build
// (design S4.4; `docs/user/support.md`: not a supported target).
fn bd_carried(io: IoCap, t: Str) -> Bool {
    if t == "aarch64-apple-darwin" || t == "x86_64-apple-darwin" || t == "x86_64-pc-windows-gnu" { return true }
    (t == "aarch64-unknown-linux-gnu" || t == "x86_64-unknown-linux-gnu") && os_env_get("NAZM_CONTAINED") == "1"
}

// Whether the driver (`clang`) has a code generator for `arch` by its own list (`generates`).
fn bd_generates(io: IoCap, proc: ProcessCap, sp: SpawnCap, arch: Str) -> Bool {
    let r = bd_run(io, proc, sp, "clang", text_split_spaces("-print-targets"), true, strs_new())
    if !r.started || r.status != 0 { return false }
    for line in text_split(r.out, nl()) {
        let words = text_split_spaces(line)
        if strs_len(words) > 0 && strs_get(words, 0) == arch { return true }
    }
    false
}

// What is settled before anything is compiled, and every refusal that needs nothing more
// (`preflight`), in the Rust build's order and words; the target to build for. A target this driver does not
// carry that the Rust build would go on to build is refused by name last.
fn bd_preflight(io: IoCap, proc: ProcessCap, sp: SpawnCap, o: Opts) -> Str {
    let host = bd_host()
    let t = if o.has_target { o.target } else { host }
    if !bd_known(t) { bd_early(io, o, "nazm: " + bd_unknown_target(t), 5) }
    // A foreign object that is not there is refused before anything is compiled (N42).
    for i in 0..strs_len(o.links) {
        if ut_kind(io, strs_get(o.links, i)) != 0 {
            bd_early(io, o, "nazm: `--link " + strs_get(o.links, i) + "`: no such file; `--link` names an object or library that defines foreign functions", 3)
        }
    }
    // Cranelift builds no freestanding or mobile target.
    if o.backend == "cranelift" && bd_freestanding(t) {
        bd_early(io, o, "nazm: `--backend cranelift` builds no freestanding target; `" + t + "` is the LLVM backend's", 5)
    }
    if o.backend == "cranelift" && bd_mobile(t) {
        bd_early(io, o, "nazm: `--backend cranelift` builds no mobile target; `" + t + "` is the LLVM backend's", 5)
    }
    // Nazm's own code generator builds for the two macOS targets and Windows x86_64.
    // (The two Linux triples too inside the contained runner, for the self-build: the one difference from the Rust build.)
    if o.backend == "nazm" && !bd_carried(io, t) {
        bd_early(io, o, "nazm: `--backend nazm` builds for aarch64-apple-darwin, x86_64-apple-darwin and x86_64-pc-windows-gnu before 1.0; `" + t + "` is the LLVM backend's", 5)
    }
    // RISC-V is code generation the host's `clang` may not have.
    if ut_starts(t, "riscv64") && !bd_generates(io, proc, sp, "riscv64") {
        bd_early(io, o, "nazm: this host's `clang` has no RISC-V code generator, so it cannot build `" + t + "`; build where one does — the `nazm-qemu:n86` image's", 4)
    }
    if ut_starts(t, "riscv32") && !bd_generates(io, proc, sp, "riscv32") {
        bd_early(io, o, "nazm: this host's `clang` has no RISC-V code generator, so it cannot build `" + t + "`; build where one does — the `nazm-qemu:n86` image's, or LLVM's own `clang`", 4)
    }
    // The field-by-field layout (N68) is asked for by name.
    if o.layout != "aos" && o.layout != "soa" { bd_early(io, o, "nazm: `--layout " + o.layout + "` is not a layout; the layouts are `aos` and `soa`", 5) }
    // A DLL is not built for Windows.
    if o.shared && bd_os(t) == "windows" {
        bd_early(io, o, "nazm: `--shared` builds no DLL for `" + t + "`: a static library (`--lib`) is what Windows has from this compiler", 5)
    }
    if o.has_board && o.has_runtime {
        bd_early(io, o, "nazm: `--runtime` is a built-in board's runtime, and `--board` names another; build with one or the other", 5)
    }
    // A release build is a hardened macOS executable from the LLVM backend.
    if o.release {
        let mut why = ""
        if o.backend != "llvm" {
            why = "`--backend llvm`'s: Cranelift and Nazm's own code generator write no stack canary"
        } else if bd_os(t) != "macos" || t != host {
            why = "this host's macOS executable's: another target is not hardened yet"
        }
        if why != "" { bd_early(io, o, "nazm: `--release` hardens " + why, 5) }
    }
    // The watermark is the board's.
    if o.watermark && !bd_is_board(t) {
        bd_early(io, o, "nazm: `--stack-watermark` measures a board's stack; it needs `--target aarch64-unknown-none` or `--target riscv64gc-unknown-none-elf`", 5)
    }
    // A stack size is a hosted program's.
    if o.stack >= 0 && (bd_is_board(t) || bd_is_wasm(t)) {
        bd_early(io, o, "nazm: `--stack-size` sizes a hosted program's threads; a board's stack is its manifest's, and a WebAssembly module's is its host's", 5)
    }
    // A heap limit bounds a hosted program's heap.
    if o.heap >= 0 {
        let mut why = ""
        if bd_is_board(t) || bd_is_wasm(t) {
            why = "a board's heap is its manifest's, and a WebAssembly module's is its host's"
        } else if o.lib {
            why = "a library's heap is its C host's"
        } else if o.has_runtime {
            why = "a runtime artifact (`--runtime`) was built without the count"
        }
        if why != "" { bd_early(io, o, "nazm: a heap limit bounds a hosted program's heap; " + why, 5) }
    }
    // A target the host cannot link is built as objects, or refused before anything is compiled.
    let links_here = t == host || (bd_os(t) == "macos" && bd_os(host) == "macos")
    if !links_here && !o.has_objects && !o.lib {
        bd_early(io, o, "nazm: this host has no linker for `" + t + "`; build it with `--objects DIR`, which writes every object and `DIR/link.txt` for that target's own toolchain to link", 4)
    }
    // From here the Rust build builds; what this driver does not carry, it says so.
    if o.backend == "cranelift" {
        bd_refuse(io, o, "`nazm build --backend cranelift` (Cranelift is not ported: `rewrite-in-nazm` decision 3; the backends are `llvm`, the default, and `nazm`)")
    }
    if !bd_carried(io, t) {
        bd_refuse(io, o, "the target `" + t + "` (Nazm builds for aarch64-apple-darwin, x86_64-apple-darwin and x86_64-pc-windows-gnu; Linux, WebAssembly, WASI, Android, iOS and the boards are not built after the cut-over)")
    }
    t
}

// --- what the command settles before it sees its file (`prepare`) --------------------------------------------------

// The restriction profiles, in `Profile::ALL`'s order.
fn bd_profiles() -> Strs {
    text_split_spaces("general embedded critical cyber realtime web3 accounts authority kernel robotics automotive aerospace assurance industrial medical")
}

// `profile::unknown`: a name no profile has (`N0511`), status 1.
fn bd_unknown_profile(io: IoCap, name: Str, what: Str) -> Int {
    eprint("error[N0511]: " + what + " names the profile `" + name + "`, which does not exist" + nl())
    eprint("  = help: the profiles are " + str_join(bd_profiles(), ", ") + nl())
    exit_with(1)
    0
}

fn bd_known_profile(name: Str) -> Bool {
    let all = bd_profiles()
    for i in 0..strs_len(all) {
        if strs_get(all, i) == name { return true }
    }
    false
}

// `package::report` of a package diagnostic: its code and message, then the count; status 1.
fn bd_package_error(io: IoCap, code: Str, message: Str, help: Str) -> Int {
    eprint("error[" + code + "]: " + message + nl())
    if help != "" { eprint("  = help: " + help + nl()) }
    eprint("nazm: 1 error" + nl())
    exit_with(1)
    0
}

// `verify_locked`: the lockfile beside the root manifest, held to the resolution (`lockcheck.nz`).
fn bd_verify_locked(io: IoCap, o: Opts, packages: Packages) -> Int {
    let dir = fe_canonical(io, strs_get(packages.dirs, pk_root_package(packages)))
    let verdict = lk_verify(io, dir)
    if fe_starts(verdict, "R") { bd_refuse(io, o, str_slice(verdict, 1, str_len(verdict))) }
    if fe_starts(verdict, "E") {
        eprint(str_slice(verdict, 1, str_len(verdict)))
        exit_with(1)
    }
    0
}

// The profiles in force (`enforce`): `--profile`'s and each package manifest's.
pub fn bd_in_force(o: Opts, packages: Packages) -> Strs {
    let out = strs_new()
    if o.has_profile { strs_push(out, o.profile) }
    if pk_packages_state(packages) == 1 {
        for i in 0..pk_count(packages) {
            if pk_profile(packages, i) != "" { strs_push(out, pk_profile(packages, i)) }
        }
    }
    out
}

// A package's directory stands for its `main`; `--locked` holds the package to its lockfile; the profiles in
// force are named (an unknown one is refused) and held once the program has checked (`prepare`). `o.file` becomes the entry. What this port does not carry — a manifest
// it does not read, a restriction profile — is refused by name.
pub fn bd_prepare(io: IoCap, o: Opts, entry_out: Strs) -> Packages {
    let mut file = o.file
    let named = file
    let prefix = fe_prefix(io, file)
    let mut packaged = false
    let mut entry = false
    let mut packages = pk_none()
    if ut_kind(io, file) == 1 {
        if fe_stat_kind(io, file + "/nazm.toml") != 0 {
            if ut_kind(io, file + "/nazm.toml") >= 0 { bd_refuse(io, o, "a manifest that is not a file") }
            eprint("nazm: `" + file + "` is a directory with no `nazm.toml`, so it is not a package" + nl())
            exit_with(3)
        }
        let dir = pk_normalise(prefix + file)
        let m = pk_parse(read_file(pk_join(dir, "nazm.toml")))
        // A manifest that is not one: `resolve`'s diagnostic, the manifest named as given.
        if pk_state(m) == 0 {
            let shown = if str_byte(file, str_len(file) - 1) == 47 { file + "nazm.toml" } else { file + "/nazm.toml" }
            eprint("error[N0500]: `" + shown + "`: " + pk_why(m) + nl() + "nazm: 1 error" + nl())
            exit_with(1)
        }
        if pk_state(m) != 1 { bd_refuse(io, o, "a manifest that does not resolve here: " + pk_why(m)) }
        let declared = pk_normalise(pk_join(dir, strs_get(m.root, 0)))
        let source_root = fe_canonical(io, declared)
        if source_root == "" { bd_refuse(io, o, "a package without its source root") }
        packages = pk_context(declared, io)
        if pk_packages_state(packages) != 1 { bd_refuse(io, o, "a package that does not resolve here: " + pk_packages_why(packages)) }
        if o.locked { bd_verify_locked(io, o, packages) }
        if ints_get(m.has_main, 0) == 0 {
            bd_package_error(io, "N0509", "the package `" + strs_get(m.name, 0) + "` has no `main` to build or run", "`main = \"main.nz\"` under `[package]` names the entry module, relative to the root")
        }
        let main = strs_get(m.main, 0)
        file = if fe_starts(main, "/") { main } else { pk_join(source_root, main) }
        strs_push(entry_out, file)
        packaged = true
        entry = true
    }
    let abs = if entry { file } else { prefix + file }
    let root = pk_decide(abs, io)
    if pk_root_how(root) == 1 && !entry {
        packaged = true
        packages = pk_context(pk_root_path(root), io)
        if pk_packages_state(packages) != 1 { bd_refuse(io, o, "a package that does not resolve here: " + pk_packages_why(packages)) }
    }
    if packaged && pk_heap(packages, pk_root_package(packages)) >= 0 { bd_refuse(io, o, "a manifest's `heap-limit` (the build's heap limit is its own `--heap-limit`)") }
    if o.locked && !packaged {
        eprint("nazm: `--locked` holds a package build to its lockfile, and `" + named + "` is not in a package" + nl())
        exit_with(5)
    }
    if o.locked && !entry { bd_verify_locked(io, o, packages) }
    // `profile::enforce`: an unknown profile is refused before anything is checked; a package's own too; a
    // profile other than `general` is not carried.
    if o.has_profile {
        if !bd_known_profile(o.profile) { bd_unknown_profile(io, o.profile, "`--profile`") }
    }
    if packaged {
        for i in 0..pk_count(packages) {
            let p = pk_profile(packages, i)
            if p != "" {
                if !bd_known_profile(p) { bd_unknown_profile(io, p, "the package `" + pk_name(packages, i) + "`'s manifest") }

            }
        }
    }
    packages
}

// `Graph::enable` of a package that declares no features (the front end reads no `[features]`): each one asked for
// is refused, the messages sorted and each once, status 1.
pub fn bd_undeclared_features(io: IoCap, o: Opts, p: Packages) -> Int {
    let name = pk_name(p, pk_root_package(p))
    let out = strs_new()
    for i in 0..strs_len(o.features) {
        let m = "`--features` asks `" + name + "` for the feature `" + strs_get(o.features, i) + "`, which it does not declare"
        let mut at = 0
        while at < strs_len(out) && fe_str_less(strs_get(out, at), m) { at += 1 }
        if at == strs_len(out) || strs_get(out, at) != m {
            strs_push(out, "")
            let mut j = strs_len(out) - 1
            while j > at {
                strs_set(out, j, strs_get(out, j - 1))
                j -= 1
            }
            strs_set(out, at, m)
        }
    }
    for i in 0..strs_len(out) { eprint("error[N0500]: " + strs_get(out, i) + nl()) }
    exit_with(1)
    0
}

// --- the stages, admitted as `host-run` admits a program ----------------------------------------

// The stage `name` (`nazm-pipeline`, `nzcg`): its variable's path, or the one in `NAZM_LIBEXEC`.
fn bd_stage(io: IoCap, o: Opts, variable: Str, name: Str) -> Str {
    let named = os_env_get(variable)
    if named != "" {
        if ut_kind(io, named) != 0 {
            bd_fail(io, o, "nazm: `nazm build` runs " + name + ": `" + variable + "` names `" + named + "`, which is not a file", 4)
        }
        return named
    }
    let dir = ut_libexec(io)
    if dir == "" {
        bd_fail(io, o, "nazm: `nazm build` runs " + name + ": set `" + variable + "`, or `NAZM_LIBEXEC` to the directory holding it", 4)
    }
    let p = ut_join(dir, name)
    if ut_kind(io, p) != 0 { bd_fail(io, o, "nazm: `nazm build` runs " + name + ": it is not installed at `" + p + "`", 4) }
    p
}

// `host-run`'s reading of an image (`heap_limit_of`): the counted heap linked, one heap limit, at
// most 2 GiB. "" when it is admitted, else the refusal's name and why.
fn bd_admitted(image: Str) -> Str {
    if ut_find(image, "nz.heap_malloc", 0) < 0 {
        return "no-counted-heap: the executable does not link the counted heap (`nz.heap_malloc` is not in it): build it with `--heap-limit`"
    }
    let found = bd_limits(image)
    if strs_len(found) == 0 { return "no-heap-limit: the executable carries no heap limit (its `N0406` message is not in it)" }
    if strs_len(found) > 1 { return "ambiguous-heap-limit: the executable names several heap limits" }
    let limit = strs_get(found, 0)
    if str_len(limit) > 10 || bo_size(limit) > 2147483648 {
        return "heap-limit-too-large: its heap limit is " + limit + " bytes, over the 2 GiB (2147483648) a stage may have"
    }
    ""
}

// Every heap limit an image's `N0406` message names (`the heap limit of N bytes is reached`, N in
// digits), each once.
fn bd_limits(image: Str) -> Strs {
    let before = "the heap limit of "
    let after = " bytes is reached"
    let found = strs_new()
    let mut from = 0
    let mut at = ut_find(image, before, from)
    while at >= 0 {
        let start = at + str_len(before)
        let mut end = start
        while end < str_len(image) && str_byte(image, end) >= 48 && str_byte(image, end) <= 57 { end += 1 }
        if end > start && end + str_len(after) <= str_len(image) && str_slice(image, end, end + str_len(after)) == after {
            let n = str_slice(image, start, end)
            let mut seen = false
            for i in 0..strs_len(found) { if strs_get(found, i) == n { seen = true } }
            if !seen { strs_push(found, n) }
        }
        from = start
        at = ut_find(image, before, from)
    }
    found
}

// The one heap limit an admitted image names.
fn bd_limit_of(image: Str) -> Int { bo_size(strs_get(bd_limits(image), 0)) }

// `host-run`'s state directory: where its withdrawal marker is.
fn bd_state_dir(io: IoCap) -> Str {
    let d = os_env_get("NAZM_HOST_RUN_DIR")
    if d != "" { return d }
    os_env_get("HOME") + "/.cache/nazm-host-run"
}

fn bd_check_stage(io: IoCap, o: Opts, path: Str, name: Str) -> Int {
    let image = read_file(path)
    let why = bd_admitted(image)
    if why != "" { bd_fail(io, o, "nazm: " + name + " (`" + path + "`) is not admitted as a stage: " + why, 4) }
    bd_limit_of(image)
}

// A stage run to its end: whether it started, its status, its output and errors, and its peak.
struct Ran {
    started: Bool,
    status: Int,
    out: Str,
    err: Str,
    peak: Int,
}

fn bd_collect(from: OsHandle, into: Chan[Str]) -> Int ! { io } {
    let all = match file_read_rest(File(handle: from)) {
        Result.Ok(value: b) => bytes_to_str(b),
        Result.Err(error: e) => "",
    }
    chan_send_of(into, all)
    0
}

// `program` with `args`, its environment `env` (`NAME=value`) — this process's when `inherit` —
// its standard input empty; its output and errors collected, and its peak resident memory.
fn bd_run(io: IoCap, proc: ProcessCap, sp: SpawnCap, program: Str, args: Strs, inherit: Bool, env: Strs) -> Ran ! { io, spawn } {
    let all = strs_new()
    if inherit {
        for i in 0..os_env_count() { strs_push(all, os_env_at(i)) }
    } else {
        for i in 0..strs_len(env) { strs_push(all, strs_get(env, i)) }
    }
    let h = os_spawn_with(program, args, "", all, 2)
    if os_status(h) < 0 { return Ran(started: false, status: 0, out: "", err: ut_os_error(os_status(h)), peak: 0) }
    let errors = chan_new_of[Str](1)
    let out = os_child_pipe(h, 1)
    let err = os_child_pipe(h, 2)
    let got = vec_new[Str]()
    let mut stdout = ""
    scope {
        spawn bd_collect(err, errors)
        stdout = match file_read_rest(File(handle: out)) {
            Result.Ok(value: b) => bytes_to_str(b),
            Result.Err(error: e) => "",
        }
        chan_recv_of(errors, got);
    }
    os_close(out)
    os_close(err)
    let status = os_wait(h)
    let peak = os_child_rusage(h)
    os_close(h)
    Ran(started: true, status: status, out: stdout, err: if vec_len(got) > 0 { vec_get(got, 0) } else { "" }, peak: peak)
}

// A stage, run as `host-run` runs a program: refused while the rule is withdrawn; its peak and
// `N0406` held to the withdrawal conditions against its own limit (design S4.2).
fn bd_stage_run(io: IoCap, o: Opts, proc: ProcessCap, sp: SpawnCap, program: Str, limit: Int, args: Strs) -> Ran ! { io, spawn } {
    let marker = bd_state_dir(io) + "/withdrawn"
    if ut_kind(io, marker) >= 0 {
        bd_fail(io, o, "nazm: withdrawn: the rule is withdrawn: " + read_file(marker) + ". Host runs stay refused until it is investigated; then remove the marker file " + marker, 4)
    }
    let r = bd_run(io, proc, sp, program, args, true, strs_new())
    if !r.started { return r }
    let mut why = ""
    if r.peak > limit + 268435456 {
        why = "peak resident memory " + int_to_str(r.peak) + " bytes exceeds the heap limit " + int_to_str(limit) + " by more than 268435456"
    } else if ut_contains(r.err, "error[N0406]") && r.status != 2 {
        why = "an N0406 was written but the program did not stop with status 2 (it ended " + int_to_str(r.status) + ")"
    }
    if why != "" {
        let why_at = why + " (running " + program + ")"
        let made = strs_new()
        ut_make_dirs(io, bd_state_dir(io), made)
        write_file(marker, why_at)
        bd_fail(io, o, "nazm: WITHDRAWAL CONDITION: " + why + ". The host rule is withdrawn: only `cargo xtask contained` until it is investigated (marker: " + marker + ")", 70)
    }
    r
}

// --- the front end, in process ----------------------------------------------------------------

// `crate::emit` of the diagnostics `which` picks, into `out`.
fn bd_emit(f: Facts, names: Strs, which: Ints, json: Bool, out: Strs) -> Int {
    let d = fx_diags(f)
    let texts = fe_texts(f)
    let bases = fe_bases(f)
    for k in 0..ints_len(which) {
        let i = ints_get(which, k)
        if json { strs_push(out, dg_json(d, i) + nl()) } else { strs_push(out, dg_render(d, i, names, texts, bases)) }
    }
    0
}

// What the front end leaves the build: the Core IR document, the authority line and the files the
// program loads (which the output may not be written over).
struct Front {
    doc: Str,
    authority: Str,
    files: Strs,
    store: Str,
    modules: Int,
    how: Str,
}

// What `main` holds, read from its signature as the parser gives it (`authority::of_main`, `line`).
fn bd_reaches(c: Str) -> Str {
    if c == "OutCap" { return "prints to standard output and error" }
    if c == "IoCap" { return "files, arguments, the terminal and the process's exit" }
    if c == "NetCap" { return "the network" }
    if c == "ProcessCap" { return "other programs and the environment" }
    if c == "SpawnCap" { return "threads" }
    if c == "RandomCap" { return "the system's randomness" }
    if c == "TimeCap" { return "the clocks" }
    if c == "ForeignCap" { return "C functions" }
    if c == "VouchCap" { return "vouching for values' provenance" }
    if c == "MmioCap" { return "device memory" }
    "an authority this build does not describe"
}

fn bd_authority(text: Str) -> Str {
    let t = sx_tree()
    let program = sx_parse_source(text, t, dg_new())
    let fns = sx_items(t, sx_field(t, program, "functions"))
    for i in 0..ints_len(fns) {
        let f = ints_get(fns, i)
        if sx_name(t, f, "name") == "main" && !sx_is_some(t, sx_field(t, f, "method_of")) {
            let parts = strs_new()
            let params = sx_items(t, sx_field(t, f, "params"))
            for j in 0..ints_len(params) {
                let p = ints_get(params, j)
                let ty = sx_name(t, sx_field(t, p, "ty"), "name")
                if ut_ends(ty, "Cap") {
                    let span = sx_field(t, p, "span")
                    let given = if sx_s(t, span) == sx_e(t, span) { " (given to main)" } else { "" }
                    strs_push(parts, ty + given + ": " + bd_reaches(ty))
                }
            }
            if strs_len(parts) == 0 { return "authority: none" }
            return "authority: " + str_join(parts, "; ")
        }
    }
    ""
}

// The front end over the program, as `nazm check` runs it: every refusal, load failure, error and
// warning written as the Rust build writes them, ending the process where the build ends; else the
// document and what the link needs. The facts are this function's alone, and go when it returns.
// The summary of a build that stopped on diagnostics `which` of the facts `f`, which are the command's own.
fn bd_summary_facts(io: IoCap, o: Opts, f: Facts, which: Ints, status: Str, code: Int, with_map: Bool) -> Int {
    let library = os_env_get("NAZM_LIBRARY")
    let abs = fe_prefix(io, o.file) + o.file
    let g = fx_check_module_in(abs, "", library, fe_host_os(), fe_host_arch(), io)
    if !fx_carried(g) {
        eprint("nazm: not carried: " + fx_why(g) + nl())
        exit_with(6)
    }
    print(sm_summary_for("build", "null", f, g, which, status, code, bd_readable(io, abs), with_map) + nl())
    exit_with(code)
    0
}

// How the source root was chosen, as `How::as_str` writes it.
fn bd_how(root: Root) -> Str {
    let h = pk_root_how(root)
    if h == 1 { return "package" }
    if h == 2 { return "marker" }
    if h == 3 { return "given" }
    "derived"
}

fn bd_front(io: IoCap, proc: ProcessCap, sp: SpawnCap, o: Opts, packages: Packages, target: Str, output: Str) -> Front {
    let library = os_env_get("NAZM_LIBRARY")
    let file = o.file
    let prefix = fe_prefix(io, file)
    let abs = prefix + file
    let root = pk_decide(abs, io)
    let packaged = pk_packages_state(packages) == 1
    // A library has no `main` to require: it is checked as the module it is (`Entry::Absent`).
    // `--harness`: the entry is read as the harness makes it (`harness::loaded`).
    let over_paths = strs_new()
    let over_texts = strs_new()
    if o.has_harness {
        let original = if ut_kind(io, abs) == 0 { read_file(abs) } else { "" }
        match hs_text(original, hs_parse(o.harness)) {
            Ok(t) => {
                strs_push(over_paths, abs)
                strs_push(over_texts, t)
                0
            },
            Err(why) => {
                eprint(hs_missing(why, o.json))
                exit_with(1)
                0
            },
        }
    }
    let f = if o.lib { fx_check_module_in(abs, "", library, bd_os(target), bd_arch(target), io) } else { fx_check_over(abs, "", over_paths, over_texts, library, bd_os(target), bd_arch(target), io) }
    if fx_refusal(f) != "" {
        let why = fx_refusal(f)
        let unreadable = ut_starts(why, "could not read") || ut_ends(why, "is not a directory")
        let code = if unreadable { 3 } else { 1 }
        bd_end(io, o, if unreadable { "unreadable" } else { "refused" }, false, "nazm: " + why, code)
    }
    let d = fx_diags(f)
    fe_unprefix_diags(io, d, prefix, abs)
    let names = fe_names(f, prefix)
    let out = strs_new()
    if fe_load_failed(f) {
        if !fx_carried(f) { bd_refuse(io, o, fx_why(f)) }
        let all = ints_new()
        let mut missing = true
        for i in 0..dg_len(d) {
            if strs_get(d.code, i) != "N0205" { missing = false }
            ints_push(all, i)
        }
        if o.summary { bd_summary_facts(io, o, f, all, if missing { "unreadable" } else { "rejected" }, if missing { 3 } else { 1 }, true) }
        bd_emit(f, names, all, o.json, out)
        eprint(str_join(out, ""))
        exit_with(if missing { 3 } else { 1 })
    }
    // `profile::configuration`: the features asked of the root package, which declares none.
    if strs_len(o.features) > 0 {
        if packaged { bd_undeclared_features(io, o, packages) }
        eprint("nazm: `--features` enables a package's features, and this program is not in a package" + nl())
        exit_with(5)
    }
    if !fx_carried(f) { bd_refuse(io, o, fx_why(f)) }
    // `--profile general` holds no rule, but `@cfg(profile = …)` sees it: not carried there.
    if o.has_profile {
        for m in 0..fx_modules(f) {
            if ut_contains(fx_module_text(f, m), "@cfg") { bd_refuse(io, o, "`--profile` where a module asks `@cfg`") }
        }
    }
    // The rules of the profiles in force (`profile::enforce`), before the command says anything of its own.
    let in_force = bd_in_force(o, packages)
    if strs_len(in_force) > 0 && !o.lib {
        pf_enforce(io, proc, sp, f, abs, names, in_force, o.locked || (packaged && pf_lock_ok(io, packages)), false)
    }
    // The output may not be written over the program's own source or any module it loads.
    let files = strs_new()
    for m in 0..fx_modules(f) { strs_push(files, fx_module_name(f, m)) }
    bd_clobbers(io, o, abs, files, output)
    let warnings = ints_new()
    let errors = ints_new()
    let mut unsupported = false
    let mut native_only = false
    for i in 0..dg_len(d) {
        if strs_get(d.severity, i) == "warning" { ints_push(warnings, i) } else { ints_push(errors, i) }
        if strs_get(d.severity, i) != "warning" && strs_get(d.code, i) == "N0101" { unsupported = true }
        // `nazm run` falls back to nothing: a refusal only a native build makes says what runs the program instead.
        let code = strs_get(d.code, i)
        if o.run && strs_get(d.severity, i) != "warning" && (code == "N0101" || code == "N0357" || code == "N0358") {
            native_only = true
            strs_set(d.help, i, "`nazm run` compiles, with Nazm's code generator, and falls back to nothing; `nazm run --interpret` runs this program in the interpreter")
        }
    }
    if ints_len(errors) > 0 {
        if o.summary { bd_summary_facts(io, o, f, errors, "rejected", 1, true) }
        bd_emit(f, names, errors, o.json, out)
        eprint(str_join(out, ""))
        let n = ints_len(errors)
        if native_only {
            bd_fail(io, o, "nazm: " + int_to_str(n) + " error" + ut_plural(n) + " in compiling this program. Nothing ran; `nazm run --interpret` runs it in the interpreter.", 1)
        }
        if unsupported {
            bd_fail(io, o, "nazm: " + int_to_str(n) + " construct" + ut_plural(n) + " outside `nazm build`'s subset. Nothing was written; `nazm run --interpret` still executes this program.", 1)
        }
        bd_fail(io, o, "nazm: " + int_to_str(n) + " error" + ut_plural(n), 1)
    }
    if ints_len(warnings) > 0 && !o.run {
        let w = ints_len(warnings)
        if o.deny { eprint("nazm: " + int_to_str(w) + " warning" + ut_plural(w) + ", refused by --deny-warnings" + nl()) }
        if o.deny && o.summary { bd_summary_facts(io, o, f, warnings, "rejected", 1, true) }
        bd_emit(f, names, warnings, o.json, out)
        eprint(str_join(out, ""))
        if o.deny { bd_fail(io, o, "nazm: " + int_to_str(w) + " error" + ut_plural(w), 1) }
    }
    let doc = fx_core_document_with_sources(f)
    if doc == "" { bd_refuse(io, o, "a program whose Core IR the front end does not carry") }
    // The project's object store (`derived::objects`): `NAZM_CACHE_DIR`, or the source root's `.nazm`.
    let named = os_env_get("NAZM_CACHE_DIR")
    let store = if named != "" { named } else { pk_root_path(root) + "/.nazm" }
    Front(doc: doc, authority: bd_authority(fx_module_text(f, 0)), files: files, store: store, modules: fx_modules(f), how: bd_how(root))
}

// The front end run and its document written into a new working directory: the directory, the
// authority line, the object store, the number of modules and how the source root was chosen. The facts and the
// document are this function's, and go when it returns.
fn bd_started(io: IoCap, proc: ProcessCap, sp: SpawnCap, o: Opts, packages: Packages, target: Str, output: Str) -> Strs {
    let fr = bd_front(io, proc, sp, o, packages, target, output)
    let work = bd_workdir(io, o, output)
    if write_file(work + "/core.json", fr.doc) < 0 {
        bd_remove(io, work)
        bd_fail(io, o, "nazm: cannot write " + work + "/core.json", 4)
    }
    let out = strs_new()
    strs_push(out, work)
    strs_push(out, fr.authority)
    strs_push(out, fr.store)
    strs_push(out, int_to_str(fr.modules))
    strs_push(out, fr.how)
    out
}

// `same_file`: canonical paths when both exist, else the paths as written.
fn bd_same(io: IoCap, a: Str, b: Str) -> Bool {
    let ca = fe_canonical(io, a)
    let cb = fe_canonical(io, b)
    if ca != "" && cb != "" { return ca == cb }
    a == b
}

fn bd_clobbers(io: IoCap, o: Opts, abs: Str, files: Strs, output: Str) -> Int {
    let mut hit = bd_same(io, abs, output)
    for i in 0..strs_len(files) {
        if bd_same(io, strs_get(files, i), output) { hit = true }
    }
    if hit { bd_end(io, o, "refused", true, "nazm: refusing to write the executable over its own source (" + output + "). Pass -o with a different path.", 1) }
    0
}

// --- the working directory ----------------------------------------------------------------------

// `rm -r` of what this build made: every entry under `dir`, then `dir`.
fn bd_remove(io: IoCap, dir: Str) -> Int {
    let d = os_dir_open(dir)
    if os_status(d) < 0 { return 0 }
    let names = strs_new()
    let buf = bytes_new(1024)
    let mut n = os_dir_next(d, buf)
    while n > 0 {
        strs_push(names, bytes_to_str(bytes_slice(buf, 0, n)))
        n = os_dir_next(d, buf)
    }
    os_close(d)
    for i in 0..strs_len(names) {
        let p = dir + "/" + strs_get(names, i)
        if ut_kind(io, p) == 1 { bd_remove(io, p) } else { os_unlink(p) }
    }
    os_rmdir(dir)
    0
}

// `scratch::exclusive`: `PARENT/STEM<pid>`, or `-N` after it, made new with mode 0700.
fn bd_workdir(io: IoCap, o: Opts, output: Str) -> Str {
    let parent = ut_parent(output)
    let why = strs_new()
    if parent != "" && !ut_make_dirs(io, parent, why) {
        bd_fail(io, o, "nazm: cannot create " + parent + ": " + str_join(why, ""), 4)
    }
    let stem = ut_file_name(output) + ".nazm-"
    let pid = int_to_str(os_pid())
    for k in 0..64 {
        let name = if k == 0 { stem + pid } else { stem + pid + "-" + int_to_str(k) }
        let dir = if parent == "" { name } else { parent + "/" + name }
        let r = os_mkdir(dir)
        if r == 0 {
            os_chmod(dir, 448)
            return dir
        }
        if ut_kind(io, dir) < 0 { bd_fail(io, o, "nazm: cannot create " + dir + ": " + ut_os_error(r), 4) }
    }
    bd_fail(io, o, "nazm: cannot create a working directory beside " + output + ": no free scratch directory name", 4)
    ""
}

fn bd_copy(io: IoCap, from: Str, to: Str) -> Bool { write_file(to, read_file(from)) >= 0 }

// --- clang ----------------------------------------------------------------------------------------

// The driver's environment: nothing but what `backend::PASSED` hands over.
fn bd_passed(io: IoCap) -> Strs {
    let names = text_split_spaces("PATH LD_LIBRARY_PATH TMPDIR TMP TEMP SystemRoot DEVELOPER_DIR SDKROOT MACOSX_DEPLOYMENT_TARGET IPHONEOS_DEPLOYMENT_TARGET TVOS_DEPLOYMENT_TARGET WATCHOS_DEPLOYMENT_TARGET XROS_DEPLOYMENT_TARGET")
    let out = strs_new()
    for i in 0..strs_len(names) {
        let v = os_env_get(strs_get(names, i))
        if v != "" || bd_env_has(io, strs_get(names, i)) { strs_push(out, strs_get(names, i) + "=" + v) }
    }
    out
}

fn bd_env_has(io: IoCap, name: Str) -> Bool {
    for i in 0..os_env_count() {
        if ut_starts(os_env_at(i), name + "=") { return true }
    }
    false
}

fn text_split_spaces(s: Str) -> Strs {
    let out = strs_new()
    let mut from = 0
    for i in 0..str_len(s) + 1 {
        if i == str_len(s) || str_byte(s, i) == 32 {
            if i > from { strs_push(out, str_slice(s, from, i)) }
            from = i + 1
        }
    }
    out
}

// `-target T` for a target that is not the host's.
fn bd_target_args(cross: Str, out: Strs) -> Int {
    if cross != "" {
        strs_push(out, "-target")
        strs_push(out, cross)
    }
    0
}

// The object format whose linker strips what nothing reaches: "macho", "elf" or "".
fn bd_family(target: Str) -> Str {
    if ut_contains(target, "-apple-") { return "macho" }
    if ut_contains(target, "-linux-") { return "elf" }
    ""
}

// MinGW-w64's libraries (`windows_libraries`).
fn bd_windows_libraries(out: Strs) -> Int {
    strs_push(out, "-static")
    strs_push(out, "-pthread")
    strs_push(out, "-lws2_32")
    strs_push(out, "-lbcrypt")
    strs_push(out, "-Wl,--stack,8388608")
    strs_push(out, "-Wl,--no-insert-timestamp")
    0
}

// TLS's libraries (`tls::link_args`), or the reason they cannot be linked, after an `!`.
fn bd_tls_args(io: IoCap, target: Str) -> Strs {
    let out = strs_new()
    let named = os_env_get("NAZM_OPENSSL_DIR")
    if bd_os(target) == "macos" {
        let mut dir = ""
        if named != "" {
            if ut_kind(io, named + "/lib/libssl.3.dylib") != 0 && ut_kind(io, named + "/lib/libssl.dylib") != 0 {
                strs_push(out, "!NAZM_OPENSSL_DIR is " + named + ", which has no lib/libssl.3.dylib")
                return out
            }
            dir = named
        } else {
            let places = text_split_spaces("/opt/homebrew/opt/openssl@3 /usr/local/opt/openssl@3 /opt/local")
            for i in 0..strs_len(places) {
                let p = strs_get(places, i)
                if dir == "" && (ut_kind(io, p + "/lib/libssl.3.dylib") == 0 || ut_kind(io, p + "/lib/libssl.dylib") == 0) { dir = p }
            }
            if dir == "" {
                strs_push(out, "!this program uses TLS, which links OpenSSL 3, and none was found: install it with `brew install openssl@3`, or name an installation with NAZM_OPENSSL_DIR")
                return out
            }
        }
        strs_push(out, "-L" + dir + "/lib")
        strs_push(out, "-lssl")
        strs_push(out, "-lcrypto")
        strs_push(out, "-framework")
        strs_push(out, "Security")
        strs_push(out, "-framework")
        strs_push(out, "CoreFoundation")
        return out
    }
    if bd_os(target) == "linux" {
        if named != "" { strs_push(out, "-L" + named + "/lib") }
        strs_push(out, "-l:libssl.so.3")
        strs_push(out, "-l:libcrypto.so.3")
        return out
    }
    strs_push(out, "-lsecur32")
    strs_push(out, "-lcrypt32")
    strs_push(out, "-lncrypt")
    out
}

// Whether clang's own message says the link or the toolchain's setup failed (`toolchain_failure`).
fn bd_toolchain_failure(said: Str) -> Bool {
    let marks = strs_new()
    strs_push(marks, "linker command failed")
    strs_push(marks, "xcrun:")
    strs_push(marks, "ld: library")
    strs_push(marks, "ld: framework")
    strs_push(marks, "unable to find sdk")
    strs_push(marks, "cannot find -l")
    strs_push(marks, "xcode-select:")
    strs_push(marks, "Failed to determine realpath")
    strs_push(marks, "xcodebuild -sdk")
    for i in 0..strs_len(marks) {
        if ut_contains(said, strs_get(marks, i)) { return true }
    }
    false
}

// `report_clang` of a run of clang that failed: what it said and why, `kept` kept.
fn bd_report_clang(io: IoCap, o: Opts, r: Ran, kept: Str, work: Str, keep: Bool) -> Int {
    if !r.started {
        bd_remove(io, work)
        bd_fail(io, o, "nazm: `clang` was not found on PATH, and `nazm build` needs it to assemble the LLVM IR it generates.", 4)
    }
    if !keep { bd_remove(io, work) }
    eprint(r.err)
    let code = "Some(" + int_to_str(r.status) + ")"
    if bd_toolchain_failure(r.err) {
        bd_fail(io, o, "nazm: `clang` failed while linking or setting up (exit " + code + ") — its message above is about the toolchain or its environment, not about the generated IR. The IR has been kept at " + kept + " in case it is needed.", 4)
    }
    bd_fail(io, o, "nazm: `clang` rejected the generated IR (exit " + code + "). This is a bug in `nazm build`, not in your program — the IR has been kept at " + kept + " to report it with.", 4)
}

// --- the code generator's refusals --------------------------------------------------------------

// One `N0101` per construct the generator refused, as `nazm_codegen_nazm::refusals` makes them; a
// failure that names nothing, or any other, `N0900`.
fn bd_generator_failed(io: IoCap, o: Opts, r: Ran, work: Str) -> Int {
    bd_remove(io, work)
    let shown = strs_new()
    let mut n = 0
    let mut refused = false
    if r.status == 3 {
        for line in text_split(r.err, nl()) {
            if ut_starts(line, "nzcg: refused: ") {
                strs_push(shown, bd_synthetic("N0101", "the Nazm backend cannot build this: " + str_slice(line, 15, str_len(line)), "`nazm build --backend llvm` is the default backend", o.json))
                n += 1
                refused = true
            }
        }
    }
    if n == 0 {
        let what = if r.status == 3 { "Nazm's code generator refused without naming what: " + ut_trim_end(r.err) } else {
            "Nazm's code generator failed (status " + int_to_str(r.status) + "): " + ut_trim_end(r.err)
        }
        strs_push(shown, bd_synthetic("N0900", what, "", o.json))
        n = 1
    }
    eprint(str_join(shown, ""))
    if refused {
        bd_fail(io, o, "nazm: " + int_to_str(n) + " construct" + ut_plural(n) + " outside `nazm build`'s subset. Nothing was written; `nazm run --interpret` still executes this program.", 1)
    }
    bd_fail(io, o, "nazm: " + int_to_str(n) + " error" + ut_plural(n), 1)
}

// A diagnostic with no span, as `Diagnostic::render` and `to_json` write one (`Span::synthetic`).
fn bd_synthetic(code: Str, message: Str, help: Str, json: Bool) -> Str {
    if json {
        let h = if help == "" { "null" } else { bd_json_str(help) }
        return "{\"schema\":\"nazm.diagnostic/1\",\"code\":" + bd_json_str(code) + ",\"severity\":\"error\",\"message\":" + bd_json_str(message) + ",\"help\":" + h + "}" + nl()
    }
    let out = "error[" + code + "]: " + message + nl()
    if help == "" { out } else { out + "  = help: " + help + nl() }
}

fn bd_json_str(s: Str) -> Str {
    let out = strs_new()
    strs_push(out, "\"")
    for i in 0..str_len(s) {
        let b = str_byte(s, i)
        if b == 34 { strs_push(out, "\\\"") } else if b == 92 { strs_push(out, "\\\\") } else if b == 10 { strs_push(out, "\\n") } else if b == 9 { strs_push(out, "\\t") } else if b == 13 { strs_push(out, "\\r") } else if b < 32 {
            let hex = "0123456789abcdef"
            strs_push(out, "\\u00" + str_slice(hex, b / 16, b / 16 + 1) + str_slice(hex, b % 16, b % 16 + 1))
        } else {
            strs_push(out, str_slice(s, i, i + 1))
        }
    }
    strs_push(out, "\"")
    str_join(out, "")
}

// --- the command ----------------------------------------------------------------------------------

// The plan `nazm-pipeline build` wrote: lines `KEY VALUE`.
fn bd_plan(text: Str, key: Str) -> Strs {
    let out = strs_new()
    for line in text_split(text, nl()) {
        if ut_starts(line, key + " ") { strs_push(out, str_slice(line, str_len(key) + 1, str_len(line))) }
    }
    out
}

// `prog.exe` for a Windows executable named without an extension (`published_name`).
fn bd_published(output: Str, target: Str, library: Bool, objects: Bool) -> Str {
    if bd_os(target) == "windows" && !library && !objects && ut_extension(output) == "" && ut_file_name(output) != "" { return output + ".exe" }
    output
}

// --- the LLVM units' objects, from the object stores or from clang ----------------------------------------------------

// Where the user cache is (`derived::user_root`): the units every project shares are filed there. "" for none:
// `NAZM_USER_CACHE_DIR` set empty turns it off.
fn bd_user_root(io: IoCap) -> Str {
    if bd_env_has(io, "NAZM_USER_CACHE_DIR") { return os_env_get("NAZM_USER_CACHE_DIR") }
    let moved = os_env_get("NAZM_CACHE_DIR")
    if moved != "" { return moved }
    let home = os_env_get("HOME")
    if bd_os(bd_host()) == "macos" {
        if home == "" { return "" }
        return home + "/Library/Caches/nazm"
    }
    let xdg = os_env_get("XDG_CACHE_HOME")
    if xdg != "" && ut_starts(xdg, "/") { return xdg + "/nazm" }
    if home == "" { return "" }
    home + "/.cache/nazm"
}

// The arguments that turn one LLVM file into one object (`compile_args`), without the file names.
fn bd_compile_args(opt: Int, target: Str, cross: Str, whole: Bool) -> Strs {
    let a = strs_new()
    strs_push(a, "-O" + int_to_str(opt))
    strs_push(a, "-Wno-override-module")
    strs_push(a, "-c")
    bd_target_args(cross, a)
    if bd_family(target) == "elf" {
        strs_push(a, "-ffunction-sections")
        strs_push(a, "-fdata-sections")
    }
    if whole { strs_push(a, "-flto=thin") }
    a
}

// What the build is told of the stores' entries: `hit NAME`, `miss NAME`, `rejected NAME`, `stored NAME`, `failed NAME`
// lines of a pipeline stage, as the names of those lines with `word`.
fn bd_said(text: Str, word: Str) -> Strs {
    let out = strs_new()
    for line in text_split(text, nl()) {
        if ut_starts(line, word + " ") { strs_push(out, str_slice(line, str_len(word) + 1, str_len(line))) }
    }
    out
}

fn bd_in(xs: Strs, s: Str) -> Bool {
    for i in 0..strs_len(xs) {
        if strs_get(xs, i) == s { return true }
    }
    false
}

// The objects of the LLVM units `names` (each `work/NAME.ll`): looked up in the stores by their keys when the build
// caches, else, or on a miss, compiled by clang in order and then filed (`compiled`). `shared` names the units every
// project shares, which go to the user cache. `tally` counts: compiled, reused, rejected, stored, and of those the generic
// instances' compiled and reused.
fn bd_llvm_objects(io: IoCap, o: Opts, proc: ProcessCap, sp: SpawnCap, pipeline: Str, pipeline_limit: Int, work: Str, names: Strs, shared: Strs,
        store: Str, opt: Int, target: Str, cross: Str, whole: Bool, env: Strs, tally: Ints) -> Int {
    let mut tool = ""
    let mut config = ""
    let mut usable = false
    // The driver is asked what it is and what it would do, unless the build reuses nothing (`Backend::discover_whole`).
    if !o.no_cache {
        let probe = work + "/probe.ll"
        write_file(probe, "")
        let a = strs_new()
        strs_push(a, "-###")
        let flags = bd_compile_args(opt, target, cross, whole)
        for i in 0..strs_len(flags) { strs_push(a, strs_get(flags, i)) }
        strs_push(a, "-o")
        strs_push(a, work + "/probe.o")
        strs_push(a, probe)
        let r = bd_run(io, proc, sp, "clang", a, false, env)
        os_unlink(probe)
        if r.started && r.status == 0 && ut_contains(r.err, nl() + " \"") {
            write_file(work + "/probe.report", r.err)
            let b = strs_new()
            strs_push(b, "--target")
            strs_push(b, target)
            strs_push(b, "backend")
            strs_push(b, work + "/probe.report")
            strs_push(b, probe)
            strs_push(b, work + "/probe.o")
            let ran = bd_stage_run(io, o, proc, sp, pipeline, pipeline_limit, b)
            let words = text_split_spaces(ut_trim(ran.out))
            if ran.started && ran.status == 0 && strs_len(words) == 2 {
                tool = strs_get(words, 0)
                config = strs_get(words, 1)
                usable = true
            }
        }
    }
    let user = bd_user_root(io)
    let mut hits = strs_new()
    if usable {
        let g = strs_new()
        strs_push(g, "--target")
        strs_push(g, target)
        strs_push(g, "llvm-get")
        strs_push(g, tool)
        strs_push(g, config)
        strs_push(g, work)
        for i in 0..strs_len(names) {
            strs_push(g, if bd_in(shared, strs_get(names, i)) && user != "" { user } else { store })
            strs_push(g, strs_get(names, i))
        }
        let got = bd_stage_run(io, o, proc, sp, pipeline, pipeline_limit, g)
        if got.started && got.status == 0 {
            hits = bd_said(got.out, "hit")
            let bad = bd_said(got.out, "rejected")
            ints_set(tally, 2, ints_get(tally, 2) + strs_len(bad))
        }
    }
    let made = strs_new()
    for i in 0..strs_len(names) {
        let name = strs_get(names, i)
        let instance = ut_starts(name, "g")
        if bd_in(hits, name) {
            ints_set(tally, 1, ints_get(tally, 1) + 1)
            if instance { ints_set(tally, 5, ints_get(tally, 5) + 1) }
            continue
        }
        let r = bd_compile(io, proc, sp, opt, target, cross, whole, work + "/" + name + ".ll", work + "/" + name + ".o", env)
        if !r.started || r.status != 0 { bd_report_clang(io, o, r, work + "/" + name + ".ll", work, true) }
        ints_set(tally, 0, ints_get(tally, 0) + 1)
        if instance { ints_set(tally, 4, ints_get(tally, 4) + 1) }
        strs_push(made, name)
    }
    // Filed after they exist and from the bytes that were produced; a store that will not take an entry fails nothing.
    if usable && strs_len(made) > 0 {
        let p = strs_new()
        strs_push(p, "--target")
        strs_push(p, target)
        strs_push(p, "llvm-put")
        strs_push(p, tool)
        strs_push(p, config)
        strs_push(p, work)
        for i in 0..strs_len(made) {
            strs_push(p, if bd_in(shared, strs_get(made, i)) && user != "" { user } else { store })
            strs_push(p, strs_get(made, i))
        }
        let put = bd_stage_run(io, o, proc, sp, pipeline, pipeline_limit, p)
        if put.started && put.status == 0 { ints_set(tally, 3, ints_get(tally, 3) + strs_len(bd_said(put.out, "stored"))) }
    }
    ints_set(tally, 6, if usable { 1 } else { 0 })
    0
}

// --- `nazm runtime build` and `nazm runtime verify` ------------------------------------------------------------------

// The runtime's ABI revision and digest, asked of the pipeline: `[REVISION, DIGEST]`.
fn bd_runtime_abi(io: IoCap, o: Opts, proc: ProcessCap, sp: SpawnCap) -> Strs {
    let pipeline = bd_stage(io, o, "NAZM_PIPELINE", "nazm-pipeline")
    let limit = bd_check_stage(io, o, pipeline, "nazm-pipeline")
    let r = bd_stage_run(io, o, proc, sp, pipeline, limit, text_split_spaces("runtime-abi"))
    let words = text_split_spaces(ut_trim(r.out))
    if !r.started || r.status != 0 || strs_len(words) != 2 {
        bd_fail(io, o, "nazm: the runtime's identity could not be read from `" + pipeline + "`", 4)
    }
    words
}

// The target `target_of` reads: the host's, or the triple given; the refusal, in the Rust build's words.
fn rt_target(io: IoCap, c: Cli, at: Int) -> Str {
    let given = cli_present(c, at)
    let t = if given { cli_value(c, at) } else { bd_host() }
    if !bd_known(t) {
        eprint("nazm: " + bd_unknown_target(t) + nl())
        exit_with(if given { 5 } else { 4 })
    }
    t
}

fn rt_refuse(io: IoCap, why: Str, code: Int) -> Int {
    eprint("nazm: " + why + nl())
    exit_with(code)
    0
}

// `nazm runtime build`: the whole runtime for one target and profile compiled into `OUT/libnazmrt.a` with its manifest.
fn runtime_build(io: IoCap, proc: ProcessCap, sp: SpawnCap, c: Cli) -> Int {
    cli_parse(io, c)
    let o = bo_default()
    let target = rt_target(io, c, 0)
    let opt = bo_size(cli_value(c, 2))
    let out = cli_value(c, 3)
    // A `--profile` that is not this target's, or not a profile: the command line's.
    let own = rt_profile_of(target)
    let mut profile = own
    if cli_present(c, 1) {
        let p = cli_value(c, 1)
        if p != "hosted" && p != "board" && p != "wasm" {
            rt_refuse(io, "`" + p + "` is not a runtime profile; the profiles are hosted, board and wasm", 5)
        }
        if p != own { rt_refuse(io, "`" + target + "` links the `" + own + "` runtime, not `" + p + "`", 5) }
        profile = p
    }
    if profile != "hosted" || !bd_carried(io, target) {
        bd_refuse(io, o, "`nazm runtime build` for `" + target + "` (Nazm builds the runtime for aarch64-apple-darwin, x86_64-apple-darwin and x86_64-pc-windows-gnu; Linux, WebAssembly, WASI, Android, iOS and the boards are not built after the cut-over)")
    }
    let why = strs_new()
    if !ut_make_dirs(io, out, why) { rt_refuse(io, "cannot create " + out + ": " + str_join(why, ""), 4) }
    // The working files live beside the artifact, and go when it is written.
    let work = ut_join(out, ".nazm-runtime-work")
    if !ut_make_dirs(io, work, why) { rt_refuse(io, "cannot create " + work + ": " + str_join(why, ""), 4) }
    let pipeline = bd_stage(io, o, "NAZM_PIPELINE", "nazm-pipeline")
    let limit = bd_check_stage(io, o, pipeline, "nazm-pipeline")
    let pargs = strs_new()
    strs_push(pargs, "--target")
    strs_push(pargs, target)
    strs_push(pargs, "runtime-artifact")
    strs_push(pargs, work)
    let pr = bd_stage_run(io, o, proc, sp, pipeline, limit, pargs)
    if !pr.started || pr.status != 0 {
        bd_remove(io, work)
        rt_refuse(io, "the runtime's text could not be made: " + ut_trim_end(pr.err), 4)
    }
    let mut text_digest = ""
    let mut services = strs_new()
    let units = strs_new()
    for line in text_split(pr.out, nl()) {
        if ut_starts(line, "text ") { text_digest = str_slice(line, 5, str_len(line)) }
        if ut_starts(line, "unit ") { strs_push(units, str_slice(line, 5, str_len(line))) }
        if ut_starts(line, "services ") { services = text_split_spaces(str_slice(line, 9, str_len(line))) }
    }
    let host = bd_host()
    let cross = if target == host { "" } else { target }
    let env = bd_passed(io)
    // Every unit by clang, as `Backend::compile` does: the per-target ones first, then the runtime.
    let members = strs_new()
    strs_push(members, work + "/runtime.o")
    for i in 0..strs_len(units) {
        let name = strs_get(units, i)
        let r = bd_compile(io, proc, sp, opt, target, cross, false, work + "/" + name + ".ll", work + "/" + name + ".o", env)
        if !r.started || r.status != 0 {
            bd_remove(io, work)
            rt_refuse(io, "the toolchain refused the runtime's `" + name + "` unit", 4)
        }
        strs_push(members, work + "/" + name + ".o")
    }
    let r = bd_compile(io, proc, sp, opt, target, cross, false, work + "/runtime.ll", work + "/runtime.o", env)
    if !r.started {
        bd_remove(io, work)
        rt_refuse(io, "`clang` was not found", 4)
    }
    if r.status != 0 {
        bd_remove(io, work)
        rt_refuse(io, "the toolchain refused the runtime: " + ut_trim(r.err), 4)
    }
    let archive = ut_join(out, rt_archive_name())
    os_unlink(archive)
    // Written by nazm itself, not the system's `ar`: the same objects archive to the same bytes.
    let said = ar_write(io, archive, members)
    if said != "" {
        bd_remove(io, work)
        rt_refuse(io, "the runtime was not archived: " + said, 4)
    }
    let digest = blake3_hex(bytes_from_str(read_file(archive)))
    let abi = bd_runtime_abi(io, o, proc, sp)
    let version = bd_run(io, proc, sp, "clang", text_split_spaces("--version"), true, strs_new())
    let toolchain = if version.started && str_len(version.out) > 0 { strs_get(text_split(version.out, nl()), 0) } else { "unknown" }
    let names = strs_new()
    for i in 0..strs_len(services) { strs_push(names, "\"" + strs_get(services, i) + "\"") }
    let manifest = "{\"abi\":" + strs_get(abi, 0) + ",\"archive\":\"" + digest + "\",\"opt_level\":" + int_to_str(opt) + ",\"profile\":\"" + profile
            + "\",\"runtime\":\"" + strs_get(abi, 1) + "\",\"schema\":\"" + rt_schema() + "\",\"services\":[" + str_join(names, ",") + "],\"target\":\"" + target
            + "\",\"text\":\"" + text_digest + "\",\"toolchain\":" + bd_json_str(toolchain) + "}" + nl()
    if write_file(ut_join(out, rt_manifest_name()), manifest) < 0 {
        bd_remove(io, work)
        rt_refuse(io, "cannot write the manifest: could not write", 4)
    }
    print("nazm: built the " + profile + " runtime for " + target + " into " + archive + nl())
    bd_remove(io, work)
    0
}

// `nazm runtime verify`: the artifact in DIR is whole and fits this compiler and the target.
fn runtime_verify(io: IoCap, proc: ProcessCap, sp: SpawnCap, c: Cli) -> Int {
    cli_parse(io, c)
    let o = bo_default()
    let dir = cli_value(c, 0)
    let target = rt_target(io, c, 1)
    let abi = bd_runtime_abi(io, o, proc, sp)
    let fit = rt_fits(io, dir, target, bo_size(strs_get(abi, 0)), strs_get(abi, 1), strs_new(), false)
    if strs_get(fit, 0) == "refused" { bd_refuse(io, o, strs_get(fit, 1)) }
    if strs_get(fit, 0) == "err" { rt_refuse(io, strs_get(fit, 2), bo_size(strs_get(fit, 1))) }
    print("nazm: the runtime at " + dir + " fits this compiler for " + target + " (archive " + strs_get(fit, 2) + ")" + nl())
    0
}

// `nazm runtime`, the group's own commands read from the argument after its name.
pub fn runtime_command(io: IoCap, proc: ProcessCap, sp: SpawnCap, g: Group) -> Int {
    let i = grp_route(io, g, 1)
    let c = grp_kid(g, i)
    cli_from(c, 2)
    if i == 0 { runtime_build(io, proc, sp, c) } else { runtime_verify(io, proc, sp, c) }
}

// `nazm.build-report/1` (`timing::report`), one object: what was compiled, and what was reused.
fn bd_report(how: Str, modules: Int, units: Int, compiled: Int, reused: Int, rejected: Int, stored: Int, instances: Int,
        instances_compiled: Int, instances_reused: Int, linked: Bool) -> Str {
    "{\"schema\":\"nazm.build-report/1\",\"root\":\"" + how + "\",\"semantic\":{\"checked\":" + int_to_str(modules) + ",\"reused\":0},\"native\":{\"units\":"
            + int_to_str(units) + ",\"compiled\":" + int_to_str(compiled) + ",\"reused\":" + int_to_str(reused) + ",\"rejected\":" + int_to_str(rejected)
            + ",\"stored\":" + int_to_str(stored) + ",\"instances\":{\"units\":" + int_to_str(instances) + ",\"compiled\":" + int_to_str(instances_compiled)
            + ",\"reused\":" + int_to_str(instances_reused) + "}},\"link\":{\"performed\":" + (if linked { "true" } else { "false" }) + "}}"
}

pub fn build_command(io: IoCap, proc: ProcessCap, sp: SpawnCap, tm: TimeCap, v: VouchCap, c: Cli) -> Int {
    let o = bo_read(io, c)
    bd_build(io, proc, sp, tm, v, o)
}

// The build `o` asks for. `nazm run` (`o.run`) builds the program for running: the executable is run from the work directory
// and the build says nothing — no path, no authority line, no report, no checker warnings.
pub fn bd_build(io: IoCap, proc: ProcessCap, sp: SpawnCap, tm: TimeCap, v: VouchCap, o0: Opts) -> Int {
    let mut o = o0
    let clock = bd_clock(tm)
    let entry = strs_new()
    let packages = bd_prepare(io, o, entry)
    if strs_len(entry) > 0 { o.file = strs_get(entry, 0) }
    // The hidden `--harness` argument is `run`'s and `test`'s (slice 7): a malformed one is a usage error.
    if o.has_harness {
        if !bd_harness_ok(o.harness) {
            eprint("nazm: `--harness " + o.harness + "` is not `test:NAME`, `fuzz:NAME:CASES` or `bench:NAME:ITERATIONS`" + nl())
            exit_with(5)
        }
    }
    // A board's manifest is read before anything is compiled, for a board's target.
    if o.has_board {
        let t = if o.has_target { o.target } else { bd_host() }
        if !bd_is_board(t) {
            eprint("nazm: `--board` describes a board: it needs `--target aarch64-unknown-none` or `--target riscv64gc-unknown-none-elf`" + nl())
            exit_with(5)
        }
        if ut_kind(io, o.board) < 0 {
            eprint("nazm: `--board " + o.board + "`: No such file or directory (os error 2)" + nl())
            exit_with(3)
        }
    }
    let target = bd_preflight(io, proc, sp, o)
    let host = bd_host()
    let cross = if target == host { "" } else { target }
    let llvm = o.backend == "llvm"
    if !llvm && o.debug { bd_refuse(io, o, "`nazm build --debug` with `--backend nazm` (debug information is the LLVM backend's here)") }
    let pipeline = bd_stage(io, o, "NAZM_PIPELINE", "nazm-pipeline")
    let nzcg = if llvm { "" } else { bd_stage(io, o, "NAZM_NZCG", "nzcg") }
    let pipeline_limit = bd_check_stage(io, o, pipeline, "nazm-pipeline")
    let nzcg_limit = if llvm { 0 } else { bd_check_stage(io, o, nzcg, "nzcg") }
    let named = if o.out != "" { o.out } else { ut_stem(o.file) }
    let output = bd_published(named, target, o.lib, o.has_objects)
    bd_mark(tm, clock, "load")

    // The front end, in process; its facts gone before any stage starts.
    let started = bd_started(io, proc, sp, o, packages, target, output)
    let work = strs_get(started, 0)
    let authority = strs_get(started, 1)
    let store = strs_get(started, 2)
    let modules = text_parse_count(strs_get(started, 3))
    let how = strs_get(started, 4)
    bd_mark(tm, clock, "front_end")
    os_mkdir(work + "/rt")
    os_mkdir(work + "/obj")
    os_mkdir(work + "/units")

    // The pipeline: MIR, LIR and the runtime's units.
    let pargs = strs_new()
    strs_push(pargs, "--target")
    strs_push(pargs, target)
    if llvm { strs_push(pargs, "--llvm") }
    if o.layout == "soa" { strs_push(pargs, "--soa") }
    if llvm && o.debug { strs_push(pargs, "--debug") }
    if llvm && o.release { strs_push(pargs, "--release") }
    if o.lib { strs_push(pargs, "--lib") }
    // A foreign object may free what the program allocated: C's allocator stays.
    if strs_len(o.links) > 0 { strs_push(pargs, "--no-small") }
    // A runtime artifact is linked instead of a generated runtime: the program's units keep the failure state per thread.
    if o.has_runtime { strs_push(pargs, "--prebuilt") }
    strs_push(pargs, "build")
    strs_push(pargs, work + "/core.json")
    strs_push(pargs, work)
    strs_push(pargs, if o.stack >= 0 { int_to_str(o.stack) } else { "-" })
    strs_push(pargs, if o.heap >= 0 { int_to_str(o.heap) } else { "-" })
    // The object store (design S4.5), unless `--no-cache`: each unit's object is looked up by its
    // key, and only the misses are generated.
    if !o.no_cache && !llvm {
        strs_push(pargs, store)
        strs_push(pargs, nzcg)
    }
    let pr = bd_stage_run(io, o, proc, sp, pipeline, pipeline_limit, pargs)
    if !pr.started || pr.status != 0 {
        bd_remove(io, work)
        let said = if pr.started { ut_trim_end(pr.err) } else { "it did not start: " + pr.err }
        bd_refuse(io, o, "a program the pipeline does not lower (status " + int_to_str(pr.status) + "): " + said)
    }
    bd_mark(tm, clock, "pipeline")
    let plan = read_file(work + "/plan.txt")
    let units = bd_plan(plan, "unit")
    let runtime = bd_plan(plan, "runtime")
    let one_thread = strs_get(bd_plan(plan, "one-thread"), 0) == "yes"
    let tls = strs_get(bd_plan(plan, "tls"), 0) == "yes"
    let foreign = bd_plan(plan, "foreign")
    let cached = bd_plan(plan, "cached")
    // A runtime artifact (N82) is checked against this compiler, the target and everything the program reached before any
    // file is written: refused by name, never replaced by a generated runtime.
    let mut prebuilt = ""
    if o.has_runtime {
        let abi = bd_runtime_abi(io, o, proc, sp)
        let fit = rt_fits(io, o.runtime, target, bo_size(strs_get(abi, 0)), strs_get(abi, 1), text_split_spaces(strs_get(bd_plan(plan, "needs"), 0)), true)
        if strs_get(fit, 0) == "refused" {
            bd_remove(io, work)
            bd_refuse(io, o, strs_get(fit, 1))
        }
        if strs_get(fit, 0) == "err" {
            bd_remove(io, work)
            // Only a refusal before the file is written, so silent under `--summary-json` (as `bd_refuse`'s are).
            if o.summary { bd_summary(io, o, "refused", bo_size(strs_get(fit, 1)), true, "null") }
            eprint("nazm: " + strs_get(fit, 2) + nl())
            exit_with(bo_size(strs_get(fit, 1)))
        }
        prebuilt = strs_get(fit, 1)
    }
    let missed = strs_new()
    for k in 0..strs_len(units) {
        let mut hit = false
        for j in 0..strs_len(cached) { if strs_get(cached, j) == strs_get(units, k) { hit = true } }
        if !hit { strs_push(missed, strs_get(units, k)) }
    }

    // The code generator, once over every unit.
    let cargs = strs_new()
    strs_push(cargs, "--target")
    strs_push(cargs, target)
    if one_thread { strs_push(cargs, "--one-thread") }
    strs_push(cargs, work + "/lir.txt")
    strs_push(cargs, work + "/obj")
    if strs_len(missed) > 0 && !llvm {
        let cr = bd_stage_run(io, o, proc, sp, nzcg, nzcg_limit, cargs)
        if !cr.started {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: Nazm's code generator `" + nzcg + "` did not run: " + cr.err, 4)
        }
        if cr.status != 0 { bd_generator_failed(io, o, cr, work) }
    }
    for k in 0..(if llvm { 0 } else { strs_len(missed) }) {
        let from = work + "/obj/unit-" + int_to_str(k) + ".o"
        if ut_kind(io, from) != 0 || os_rename(from, work + "/" + strs_get(missed, k) + ".o") != 0 {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: Nazm's code generator wrote no object for unit " + strs_get(missed, k), 1)
        }
    }
    // What was generated is filed in the store; a store that will not take it fails nothing.
    let mut stored = 0
    if !o.no_cache && strs_len(missed) > 0 && !llvm {
        let put = strs_new()
        strs_push(put, "--target")
        strs_push(put, target)
        strs_push(put, "put")
        strs_push(put, store)
        strs_push(put, nzcg)
        strs_push(put, work)
        let pu = bd_stage_run(io, o, proc, sp, pipeline, pipeline_limit, put)
        if pu.started && pu.status == 0 { stored = strs_len(missed) }
    }
    bd_mark(tm, clock, "codegen")
    let objects = strs_new()
    for k in 0..strs_len(units) { strs_push(objects, work + "/" + strs_get(units, k) + ".o") }

    // The LLVM backend's executable at `-O2` and above on macOS is linked from bitcode and
    // optimised as one program (R1.5 3.4): not objects for another linker, not a debug build.
    let whole = llvm && !o.lib && !o.has_objects && !o.debug && bd_os(target) == "macos" && o.opt >= 2
    let env = bd_passed(io)
    // The LLVM units, program's and runtime's, in link order: each from the object stores or by clang.
    let tally = ints_new()
    for _ in 0..7 { ints_push(tally, 0) }
    let llvm_names = strs_new()
    if llvm {
        for k in 0..strs_len(units) { strs_push(llvm_names, strs_get(units, k)) }
    }
    for i in 0..strs_len(runtime) {
        let name = strs_get(runtime, i)
        os_rename(work + "/rt/" + name + ".ll", work + "/" + name + ".ll")
        strs_push(llvm_names, name)
        strs_push(objects, work + "/" + name + ".o")
    }
    // The runtime artifact after every object that calls it, and before the foreign inputs.
    if prebuilt != "" { strs_push(objects, prebuilt) }
    // Every unit of the runtime but the entry is every project's.
    let shared = bd_plan(plan, "shared")
    for i in 0..strs_len(runtime) {
        if strs_get(runtime, i) != "entry" { strs_push(shared, strs_get(runtime, i)) }
    }
    bd_llvm_objects(io, o, proc, sp, pipeline, pipeline_limit, work, llvm_names, shared, store, o.opt, target, cross, whole, env, tally)
    let mut compiled = ints_get(tally, 0)
    let mut compiled_instances = ints_get(tally, 4)
    let mut reused = ints_get(tally, 1)
    let mut reused_instances = ints_get(tally, 5)
    let rejected = ints_get(tally, 2)
    // A whole-program link keeps what it optimised beside the project's objects, where the build keeps objects.
    let lto = if whole && ints_get(tally, 6) == 1 { store + "/lto" } else { "" }
    stored += ints_get(tally, 3)
    // What the units were: every one, compiled here or reused; the generator's (`--backend nazm`) are counted
    // as the store gave them.
    let mut instances = 0
    for k in 0..strs_len(units) {
        if ut_starts(strs_get(units, k), "g") { instances += 1 }
    }
    if !llvm {
        compiled += strs_len(missed)
        reused += strs_len(cached)
        for k in 0..strs_len(missed) { if ut_starts(strs_get(missed, k), "g") { compiled_instances += 1 } }
        for k in 0..strs_len(cached) { if ut_starts(strs_get(cached, k), "g") { reused_instances += 1 } }
    }
    let tally_units = strs_len(units) + strs_len(runtime)
    bd_mark(tm, clock, "native_compile")
    let ir_names = strs_new()
    for k in 0..strs_len(units) { strs_push(ir_names, strs_get(units, k)) }
    for i in 0..strs_len(runtime) { strs_push(ir_names, strs_get(runtime, i)) }

    // `--objects DIR`: every object in link order and `link.txt`, for the target's own toolchain.
    if o.has_objects {
        if o.emit_ir { bd_write_ir(io, work, ir_names, output) }
        let why = strs_new()
        if !ut_make_dirs(io, o.objects, why) {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: cannot write " + o.objects + ": " + str_join(why, ""), 4)
        }
        let listed = strs_new()
        let all = strs_new()
        for i in 0..strs_len(objects) { strs_push(all, strs_get(objects, i)) }
        for i in 0..strs_len(o.links) { strs_push(all, strs_get(o.links, i)) }
        for i in 0..strs_len(all) {
            let num = if i < 10 { "0" + int_to_str(i) } else { int_to_str(i) }
            let to = num + "-" + ut_file_name(strs_get(all, i))
            if !bd_copy(io, strs_get(all, i), ut_join(o.objects, to)) {
                bd_remove(io, work)
                bd_fail(io, o, "nazm: cannot write " + o.objects, 4)
            }
            strs_push(listed, to)
        }
        let mut libs = if bd_os(target) == "linux" { "-lpthread -lm" } else if bd_os(target) == "windows" {
            "-static -pthread -lws2_32 -lbcrypt -Wl,--stack,8388608 -Wl,--no-insert-timestamp"
        } else { "" }
        let mut has_tls = false
        for i in 0..strs_len(runtime) { if strs_get(runtime, i) == "tls" { has_tls = true } }
        if has_tls {
            let t = bd_tls_args(io, target)
            if strs_len(t) > 0 && !ut_starts(strs_get(t, 0), "!") { libs = libs + " " + str_join(t, " ") }
        }
        let text = "# Written by nazm build --objects. Link these, in this order, with the target's toolchain." + nl()
                + "target " + target + nl() + "objects " + str_join(listed, " ") + nl() + "libraries " + libs + nl()
        if write_file(ut_join(o.objects, "link.txt"), text) < 0 {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: cannot write " + o.objects, 4)
        }
        bd_remove(io, work)
        if o.report {
            print(bd_report(how, modules, tally_units, compiled, reused, rejected, stored, instances, compiled_instances, reused_instances, false) + nl())
        }
        if !o.summary { eprint("nazm: wrote " + int_to_str(strs_len(all)) + " objects for " + target + " to " + o.objects + "; link them as " + o.objects + "/link.txt says" + nl()) }
        return bd_provenance(io, proc, sp, v, o, target, output, packages, nzcg)
    }

    // The link, in the working directory under the output's own name.
    let exe = work + "/" + ut_file_name(output)
    let mut linked = Ran(started: true, status: 0, out: "", err: "", peak: 0)
    if o.lib && !o.shared {
        // A static archive of the objects, and the foreign inputs after them, written by Nazm itself.
        let members = strs_new()
        for i in 0..strs_len(objects) { strs_push(members, strs_get(objects, i)) }
        for i in 0..strs_len(o.links) { strs_push(members, strs_get(o.links, i)) }
        let said = ar_write(io, exe, members)
        if said != "" {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: the static archive was not written: " + said, 4)
        }
    } else if o.lib {
        linked = bd_link_shared(io, proc, sp, target, cross, exe, objects, o.links, strs_new(), o.opt, ut_file_name(output))
    } else {
        linked = bd_link(io, proc, sp, target, cross, exe, objects, o.links, strs_new(), o.opt, whole, lto, o.release)
    }
    let mut result = linked
    if (!linked.started || linked.status != 0) && tls && !(o.lib && !o.shared) {
        let t = bd_tls_args(io, target)
        if strs_len(t) > 0 && ut_starts(strs_get(t, 0), "!") {
            eprint("nazm: " + str_slice(strs_get(t, 0), 1, str_len(strs_get(t, 0))) + nl())
        } else {
            result = if o.shared {
                bd_link_shared(io, proc, sp, target, cross, exe, objects, o.links, t, o.opt, ut_file_name(output))
            } else {
                bd_link(io, proc, sp, target, cross, exe, objects, o.links, t, o.opt, whole, lto, o.release)
            }
        }
    }
    if !result.started || result.status != 0 {
        if result.started && strs_len(foreign) > 0 {
            bd_remove(io, work)
            eprint(result.err)
            let shown = strs_new()
            for i in 0..strs_len(foreign) { strs_push(shown, "`" + strs_get(foreign, i) + "`") }
            bd_fail(io, o, "nazm: linking failed. This program calls the foreign function" + ut_plural(strs_len(foreign)) + " " + str_join(shown, ", ")
                    + "; each must be defined by an object or library passed with `--link FILE`", 4)
        }
        bd_report_clang(io, o, result, work, work, true)
    }
    // A release build is stripped and signed once it is linked.
    if o.release {
        let said = bd_finish_release(io, proc, sp, exe, env)
        if said != "" {
            bd_remove(io, work)
            bd_fail(io, o, "nazm: the release build was not finished: " + said, 4)
        }
    }
    if o.emit_ir { bd_write_ir(io, work, ir_names, output) }
    // On macOS the linker leaves debug information in the objects it read, which are about to go, so
    // a debug build gathers it into `OUTPUT.dSYM` first.
    if o.debug && bd_os(host) == "macos" {
        let a = strs_new()
        strs_push(a, exe)
        strs_push(a, "-o")
        strs_push(a, output + ".dSYM")
        let g = bd_run(io, proc, sp, "dsymutil", a, false, env)
        if !g.started || g.status != 0 {
            eprint("nazm: the debug information was not gathered: " + g.err + nl())
        }
    }
    // A library's header, beside it: written before the archive is published, so a published archive always has its header.
    if o.lib {
        let header = ut_with_extension(output, "h")
        if write_file(header, bd_c_header(output, bd_plan(plan, "export"))) < 0 {
            bd_remove(io, work)
            eprint("nazm: cannot write " + header + ": could not write" + nl())
            exit_with(4)
        }
    }
    // A build for `nazm run`: the program is run from the work directory, which is then removed, and `nazm` ends with its status.
    if o.run {
        rx_run(io, proc, sp, exe, o.run_args, work)
        return 0
    }
    // Published last, so an existing output survives every failure above.
    let moved = os_rename(exe, output)
    bd_remove(io, work)
    if moved != 0 { bd_fail(io, o, "nazm: cannot write " + output + ": " + ut_os_error(moved), 4) }
    let after = o.has_provenance || o.has_sbom
    if o.summary {
        bd_summary_then(io, o, "success", 0, true, "{\"path\":" + bd_json_str(output) + "}", !after)
        return bd_provenance(io, proc, sp, v, o, target, output, packages, nzcg)
    }
    bd_mark(tm, clock, "link")
    if o.report {
        print(bd_report(how, modules, tally_units, compiled, reused, rejected, stored, instances, compiled_instances, reused_instances, true) + nl())
    }
    if o.timings { eprint(bd_timings(tm, clock) + nl()) }
    if authority != "" { eprint(authority + nl()) }
    print(output + nl())
    bd_provenance(io, proc, sp, v, o, target, output, packages, nzcg)
}

// `provenance::write`: the record, the SBOM and the attestation, as asked, after a build that succeeded.
fn bd_provenance(io: IoCap, proc: ProcessCap, sp: SpawnCap, v: VouchCap, o: Opts, target: Str, output: Str, packages: Packages, nzcg: Str) -> Int {
    if !o.has_provenance && !o.has_sbom { return 0 }
    let root = if pk_packages_state(packages) == 1 { fe_canonical(io, strs_get(packages.dirs, pk_root_package(packages))) } else { "" }
    let abi = bd_runtime_abi(io, o, proc, sp)
    let code = bpv_write(io, proc, sp, v, o, target, output, root, abi, nzcg, version_text())
    if code != 0 { exit_with(code) }
    0
}

// The toolchain's version, as the record writes it.
fn version_text() -> Str { "0.10.0" }

// A library's C header (`c_header`): every export, by symbol, in `<stdint.h>` and `<stdbool.h>` types. `exports` are the
// plan's `SYMBOL RET PARAMS...` lines, by symbol.
fn bd_c_type(t: Str) -> Str {
    if t == "Bool" { return "bool" }
    if t == "Int8" { return "int8_t" }
    if t == "Int16" { return "int16_t" }
    if t == "Int32" { return "int32_t" }
    if t == "UInt8" { return "uint8_t" }
    if t == "UInt16" { return "uint16_t" }
    if t == "UInt32" { return "uint32_t" }
    if t == "UInt64" { return "uint64_t" }
    if t == "Float32" { return "float" }
    if t == "Float64" { return "double" }
    if t == "Int128" { return "__int128" }
    if t == "UInt128" { return "unsigned __int128" }
    "int64_t"
}

fn bd_c_header(output: Str, exports: Strs) -> Str {
    let stem = strs_new()
    let name = ut_stem(output)
    let mut i = 0
    while i < str_len(name) {
        let b = str_byte(name, i)
        let w = if b >= 240 { 4 } else if b >= 224 { 3 } else if b >= 192 { 2 } else { 1 }
        if w == 1 && ((b >= 48 && b <= 57) || (b >= 65 && b <= 90)) {
            strs_push(stem, str_slice(name, i, i + 1))
        } else if w == 1 && b >= 97 && b <= 122 {
            strs_push(stem, str_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", b - 97, b - 96))
        } else {
            strs_push(stem, "_")
        }
        i += w
    }
    let guard = "NAZM_" + str_join(stem, "") + "_H"
    let out = strs_new()
    strs_push(out, "/* Generated by nazm build --lib. Do not edit. */" + nl())
    strs_push(out, "#ifndef " + guard + nl() + "#define " + guard + nl() + nl())
    strs_push(out, "#include <stdbool.h>" + nl() + "#include <stdint.h>" + nl() + nl())
    strs_push(out, "#ifdef __cplusplus" + nl() + "extern \"C\" {" + nl() + "#endif" + nl() + nl())
    strs_push(out, "/* A Nazm failure inside any of these is reported on standard error and ends the" + nl()
            + "   process with status 2: nothing unwinds into C. */" + nl())
    for k in 0..strs_len(exports) {
        let words = text_split_spaces(strs_get(exports, k))
        let sym = strs_get(words, 0)
        let ret = strs_get(words, 1)
        let params = strs_new()
        for j in 2..strs_len(words) { strs_push(params, bd_c_type(strs_get(words, j)) + " a" + int_to_str(j - 2)) }
        let ps = if strs_len(params) == 0 { "void" } else { str_join(params, ", ") }
        strs_push(out, bd_c_type(ret) + " " + sym + "(" + ps + ");" + nl())
    }
    strs_push(out, nl() + "#ifdef __cplusplus" + nl() + "}" + nl() + "#endif" + nl() + nl() + "#endif" + nl())
    str_join(out, "")
}

// `Harness::parse`: `test:NAME`, `fuzz:NAME:CASES` or `bench:NAME:ITERATIONS`.
fn bd_harness_ok(spec: Str) -> Bool {
    let parts = text_split(spec, ":")
    if strs_len(parts) < 2 { return false }
    let kind = strs_get(parts, 0)
    let name = strs_get(parts, 1)
    if str_len(name) == 0 { return false }
    for i in 0..str_len(name) {
        let b = str_byte(name, i)
        if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) { return false }
    }
    if kind == "test" { return strs_len(parts) == 2 }
    if kind == "fuzz" || kind == "bench" {
        if strs_len(parts) < 3 { return false }
        // `splitn(3, ':')`: the count is everything after the second colon, a `u32`.
        let count = str_slice(spec, str_len(kind) + 1 + str_len(name) + 1, str_len(spec))
        if str_len(count) == 0 || str_len(count) > 10 { return false }
        let mut v = 0
        for i in 0..str_len(count) {
            let b = str_byte(count, i)
            if b < 48 || b > 57 { return false }
            v = v * 10 + (b - 48)
        }
        return v <= 4294967295
    }
    false
}

fn text_parse_count(s: Str) -> Int {
    let mut v = 0
    for i in 0..str_len(s) { v = v * 10 + (str_byte(s, i) - 48) }
    v
}

// The link: `clang` with the build's arguments, the objects in order, the foreign inputs, the
// system libraries, and the linker's dead-stripping (`Backend::link`); `extra` after the libraries
// (TLS's, on the second attempt).
fn bd_link(io: IoCap, proc: ProcessCap, sp: SpawnCap, target: Str, cross: Str, exe: Str, objects: Strs, links: Strs, extra: Strs, opt: Int, whole: Bool, lto: Str, release: Bool) -> Ran ! { io, spawn } {
    let a = strs_new()
    strs_push(a, "-O" + int_to_str(opt))
    strs_push(a, "-Wno-override-module")
    bd_target_args(cross, a)
    if whole {
        strs_push(a, "-flto=thin")
        // The CPU a separately optimised object is compiled for, which the linker's code generation
        // must name (`whole_program_cpu`).
        strs_push(a, "-Wl,-mcpu," + (if bd_arch(target) == "x86_64" { "penryn" } else { "apple-m1" }))
        // Where the linker keeps what it optimised, by content, for the next link of a whole-program build.
        if lto != "" { strs_push(a, "-Wl,-cache_path_lto," + lto) }
    }
    strs_push(a, "-o")
    strs_push(a, exe)
    for i in 0..strs_len(objects) { strs_push(a, strs_get(objects, i)) }
    for i in 0..strs_len(links) { strs_push(a, strs_get(links, i)) }
    for i in 0..strs_len(extra) { strs_push(a, strs_get(extra, i)) }
    if bd_os(target) == "linux" { strs_push(a, "-lm") }
    if bd_os(target) == "windows" { bd_windows_libraries(a) }
    if bd_family(target) == "macho" { strs_push(a, "-Wl,-dead_strip") }
    if bd_family(target) == "elf" { strs_push(a, "-Wl,--gc-sections") }
    if release { strs_push(a, "-Wl,-pie") }
    let env = bd_passed(io)
    strs_push(env, "ZERO_AR_DATE=1")
    bd_run(io, proc, sp, "clang", a, false, env)
}

// A shared library (`Backend::link_shared`): the link of an executable but for dead-stripping, then `-shared`, named
// to the loader by its own file name (`@rpath/NAME` on macOS).
fn bd_link_shared(io: IoCap, proc: ProcessCap, sp: SpawnCap, target: Str, cross: Str, exe: Str, objects: Strs, links: Strs, extra: Strs, opt: Int, name: Str) -> Ran ! { io, spawn } {
    let a = strs_new()
    strs_push(a, "-O" + int_to_str(opt))
    strs_push(a, "-Wno-override-module")
    bd_target_args(cross, a)
    strs_push(a, "-o")
    strs_push(a, exe)
    for i in 0..strs_len(objects) { strs_push(a, strs_get(objects, i)) }
    for i in 0..strs_len(links) { strs_push(a, strs_get(links, i)) }
    for i in 0..strs_len(extra) { strs_push(a, strs_get(extra, i)) }
    if bd_os(target) == "linux" { strs_push(a, "-lm") }
    if bd_os(target) == "windows" { bd_windows_libraries(a) }
    strs_push(a, "-shared")
    if bd_os(target) == "macos" { strs_push(a, "-Wl,-install_name,@rpath/" + name) } else { strs_push(a, "-Wl,-soname," + name) }
    let env = bd_passed(io)
    strs_push(env, "ZERO_AR_DATE=1")
    bd_run(io, proc, sp, "clang", a, false, env)
}

// One unit's LLVM text to its object, as `Backend::compile` does: the optimisation level, no target
// triple in the unit, a section per function and datum on ELF, and bitcode for a whole-program link.
fn bd_compile(io: IoCap, proc: ProcessCap, sp: SpawnCap, opt: Int, target: Str, cross: Str, whole: Bool, ll: Str, obj: Str, env: Strs) -> Ran ! { io, spawn } {
    let a = strs_new()
    strs_push(a, "-O" + int_to_str(opt))
    strs_push(a, "-Wno-override-module")
    strs_push(a, "-c")
    bd_target_args(cross, a)
    if bd_family(target) == "elf" {
        strs_push(a, "-ffunction-sections")
        strs_push(a, "-fdata-sections")
    }
    if whole { strs_push(a, "-flto=thin") }
    strs_push(a, "-o")
    strs_push(a, obj)
    strs_push(a, ll)
    bd_run(io, proc, sp, "clang", a, false, env)
}

// `--emit-ir`: beside the output, one file per unit that is LLVM text, named `OUTPUT.UNIT.ll`.
fn bd_write_ir(io: IoCap, work: Str, names: Strs, output: Str) -> Int {
    for i in 0..strs_len(names) {
        let from = work + "/" + strs_get(names, i) + ".ll"
        if ut_kind(io, from) == 0 {
            let to = output + "." + strs_get(names, i) + ".ll"
            if !bd_copy(io, from, to) { eprint("nazm: cannot write " + to + nl()) }
        }
    }
    0
}

// A release build, finished (`release::finish`): the executable stripped, then signed ad hoc with
// the hardened runtime. "" when it was, else what went wrong.
fn bd_finish_release(io: IoCap, proc: ProcessCap, sp: SpawnCap, exe: Str, env: Strs) -> Str ! { io, spawn } {
    let a = strs_new()
    strs_push(a, exe)
    let r = bd_run(io, proc, sp, "strip", a, false, env)
    if !r.started { return "`strip` could not be run: " + r.err }
    if r.status != 0 { return "`strip` failed: " + ut_trim(r.err) }
    let b = strs_new()
    strs_push(b, "--force")
    strs_push(b, "--sign")
    strs_push(b, "-")
    strs_push(b, "--options")
    strs_push(b, "runtime")
    strs_push(b, exe)
    let c = bd_run(io, proc, sp, "codesign", b, false, env)
    if !c.started { return "`codesign` could not be run: " + c.err }
    if c.status != 0 { return "`codesign` failed: " + ut_trim(c.err) }
    ""
}
