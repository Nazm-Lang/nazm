// `nazm check`, written in Nazm (R5, `openspec/changes/r5-commands/`, design D11).
//
// `nazm check [OPTIONS] FILE`, run by the dispatcher (`nazm.nz`).
//
// A port of `crates/nazm-cli/src/checking.rs` (`run`) and of what `prepare.rs` settles before it,
// over R2's front end, run whole through its published facts (`compiler/facts.nz`'s `fx_check`,
// R2 design D24) under the names the user gave (`front.nz`). The diagnostics are written as `crate::emit` writes them —
// `Diagnostic::render` over the whole compilation's source map, or one `nazm.diagnostic/1` line
// each with `--json` — the warnings first, then `ok` or `nazm: N errors`, with the reference's exit
// statuses.
//
// Where the reference would do something this port does not carry — the checker stops, a package,
// a `nazm.root` marker, `--profile`, `--profile-report`, `--cache-report` — it says so on standard
// error and exits 6 before writing anything else. `--summary-json` is `summary.nz`'s (design D23), `--locked`
// `lockcheck.nz`'s. The
// check cache (`.nazm/check/`) is derived data and is neither read nor written (design D11).
//
// The standard library is read from the directory `NAZM_LIBRARY` names: the reference compiles in
// the same files from its checkout.

use "../../compiler/syntax.nz"
use "../../compiler/diag.nz"
use "../../compiler/sema.nz"
use "../../compiler/package.nz"
use "../../compiler/facts.nz"
use "cli.nz"
use "util.nz"
use "front.nz"
use "summary.nz"
use "lockcheck.nz"
use "profile.nz"

fn nl() -> Str { str_from_byte(10) }

// The command line, as `crates/nazm-cli/src/cli.rs` declares `nazm check`.
pub fn check_cli() -> Cli {
    let c = cli_command("check", "Type-check without evaluating", "")
    cli_positional(c, "FILE", true, false, true, "", "")
    let json = cli_flag(c, "", "json", "", "")
    cli_option(c, "", "source-root", "DIR", true, "", false, "Where this project begins, for durable module identity",
            "Where this project begins, for durable module identity." + nl() + nl()
            + "Normally discovered: the nearest `nazm.root` marker at or above the file, and otherwise the file's own "
            + "directory. Naming it here is for a tree that cannot be written to, and for a caller that would rather state "
            + "it than rely on a search.")
    cli_flag(c, "", "no-cache", "Check every module, reusing nothing",
            "Check every module, reusing nothing." + nl() + nl()
            + "The cache is derived data and deleting it changes no program's meaning, so this exists to **establish** "
            + "that rather than to work around it: the equivalence tests compare a run with this flag against one without, "
            + "and require the same answer.")
    let report = cli_flag(c, "", "cache-report", "One `nazm.check-report/1` object on stdout: what was checked, and what was reused. Off by default, because a "
            + "compiler that reports on itself every time is a compiler whose output has to be filtered", "")
    let summary = cli_flag(c, "", "summary-json", "One `nazm.command-summary/1` object on stdout, and nothing else on either "
            + "stream: the outcome, and a reference to each diagnostic — no prose. The exit status is unchanged. `--json` "
            + "still gives every diagnostic in full", "")
    cli_conflicts(c, summary, json)
    cli_conflicts(c, summary, report)
    cli_flag(c, "", "locked", "Refuse to build unless the package's `nazm.lock` records exactly the packages this resolves "
            + "to, with their bytes unchanged (N46)", "")
    cli_option(c, "", "profile", "NAME", false, "", false, "A restriction profile to hold the program to (N47): `general`, "
            + "`embedded`, `critical`, `cyber`, `realtime`, `web3`, `accounts`, `authority`, `kernel`, `robotics`, "
            + "`automotive`, `aerospace`, `assurance`, `industrial` or `medical`. Added to any the packages' manifests "
            + "require; a profile only refuses, and never changes what an accepted program does", "")
    cli_list(c, "", "features", "NAMES", ",", "Features of the root package to enable beyond its `default`, "
            + "comma-separated (Gate 2, §22); each package's `@cfg(feature = …)` sees its own", "")
    cli_flag(c, "", "profile-report", "One `nazm.profile-report/1` object on stdout: every rule of the profiles in force, "
            + "its verdict and its witnesses", "")
    cli_flag(c, "", "deny-warnings", "Refuse a program the checker warns of (R1b, L15), as though each warning were an "
            + "error: for a build that must stay free of them", "")
    c
}

// What this port does not carry: said on standard error, status 6 (design D5).
fn refuse(io: IoCap, why: Str) -> Int {
    eprint("check: not carried: " + why + nl())
    exit_with(6)
    0
}

// --- paths ----------------------------------------------------------------------------------------

fn stat_kind(io: IoCap, p: Str) -> Int {
    let out = bytes_new(32)
    if os_stat(p, out) != 0 { return 0 - 1 }
    bytes_read_le[Int](out, 8)
}

fn is_dir(io: IoCap, p: Str) -> Bool { stat_kind(io, p) == 1 }

fn exists(io: IoCap, p: Str) -> Bool { stat_kind(io, p) >= 0 }

// Whether `read_to_string` reads `path` whole: it opens, it is not a directory, and it is UTF-8.
fn readable_text(io: IoCap, path: Str) -> Bool {
    if stat_kind(io, path) != 0 { return false }
    let h = os_open_read(path)
    if os_status(h) != 0 { return false }
    os_close(h)
    utf8_ok(read_file(path))
}

fn utf8_ok(s: Str) -> Bool {
    let n = str_len(s)
    let mut i = 0
    while i < n {
        let b = str_byte(s, i)
        if b < 128 {
            i += 1
            continue
        }
        let mut need = 0
        let mut lo = 128
        let mut hi = 191
        if b >= 194 && b <= 223 {
            need = 1
        } else if b == 224 {
            need = 2
            lo = 160
        } else if b >= 225 && b <= 236 {
            need = 2
        } else if b == 237 {
            need = 2
            hi = 159
        } else if b >= 238 && b <= 239 {
            need = 2
        } else if b == 240 {
            need = 3
            lo = 144
        } else if b >= 241 && b <= 243 {
            need = 3
        } else if b == 244 {
            need = 3
            hi = 143
        } else {
            return false
        }
        if i + need >= n { return false }
        let c1 = str_byte(s, i + 1)
        if c1 < lo || c1 > hi { return false }
        for k in 2..need + 1 {
            let c = str_byte(s, i + k)
            if c < 128 || c > 191 { return false }
        }
        i += need + 1
    }
    true
}

// --- the compilation, through R2's facts (`compiler/facts.nz`) ---------------------------------------

// `crate::emit` of the diagnostics `which` picks, into `out`.
fn emit(f: Facts, names: Strs, which: Ints, json: Bool, out: Strs) -> Int {
    let d = fx_diags(f)
    let texts = fe_texts(f)
    let bases = fe_bases(f)
    for k in 0..ints_len(which) {
        let i = ints_get(which, k)
        if json { strs_push(out, dg_json(d, i) + nl()) } else { strs_push(out, dg_render(d, i, names, texts, bases)) }
    }
    0
}

fn plural(n: Int) -> Str { if n == 1 { "" } else { "s" } }

// --- the command ----------------------------------------------------------------------------------

// The restriction profiles, in `Profile::ALL`'s order.
fn profiles() -> Strs {
    let out = strs_new()
    strs_push(out, "general")
    strs_push(out, "embedded")
    strs_push(out, "critical")
    strs_push(out, "cyber")
    strs_push(out, "realtime")
    strs_push(out, "web3")
    strs_push(out, "accounts")
    strs_push(out, "authority")
    strs_push(out, "kernel")
    strs_push(out, "robotics")
    strs_push(out, "automotive")
    strs_push(out, "aerospace")
    strs_push(out, "assurance")
    strs_push(out, "industrial")
    strs_push(out, "medical")
    out
}

// `profile::unknown`: a name no profile has (`N0511`), status 1.
fn unknown_profile(io: IoCap, name: Str) -> Int {
    eprint("error[N0511]: `--profile` names the profile `" + name + "`, which does not exist" + nl())
    eprint("  = help: the profiles are " + str_join(profiles(), ", ") + nl())
    exit_with(1)
    0
}

fn contains(s: Str, p: Str) -> Bool {
    let n = str_len(p)
    let mut i = 0
    while i + n <= str_len(s) {
        if str_slice(s, i, i + n) == p { return true }
        i += 1
    }
    false
}

// The file of diagnostic `i`: the one the stage named, else the last whose text begins at or before
// its offset (`dg_render`'s rule).
fn file_at(d: Diags, i: Int, bases: Ints) -> Int {
    if ints_get(d.file, i) >= 0 { return ints_get(d.file, i) }
    let at = ints_get(d.start, i)
    let mut f = 0
    for k in 0..ints_len(bases) {
        if ints_get(bases, k) <= at { f = k }
    }
    f
}

// `Graph::enable` of a package that declares no features (the front end reads no `[features]`):
// each one asked for is refused, the messages sorted and each once, status 1.
fn undeclared_features(io: IoCap, p: Packages, features: Strs) -> Int {
    let name = pk_name(p, pk_root_package(p))
    let out = strs_new()
    for i in 0..strs_len(features) {
        if ut_contains("," + pk_featured(p, pk_root_package(p)) + ",", "," + strs_get(features, i) + ",") {
            eprint("nazm: not carried: `--features` enabling a feature the package declares (`@cfg(feature ...)` is not evaluated)" + nl())
            exit_with(6)
        }
        let m = "`--features` asks `" + name + "` for the feature `" + strs_get(features, i) + "`, which it does not declare"
        let mut at = 0
        while at < strs_len(out) && fe_str_less(strs_get(out, at), m) { at += 1 }
        if at == strs_len(out) || strs_get(out, at) != m {
            strs_push(out, "")
            let mut j = strs_len(out) - 1
            while j > at {
                strs_set(out, j, strs_get(out, j - 1))
                j -= 1
            }
            strs_set(out, at, m)
        }
    }
    for i in 0..strs_len(out) { eprint("error[N0500]: " + strs_get(out, i) + nl()) }
    exit_with(1)
    0
}

// The profiles in force, sorted, each once (`configuration`).
fn profiles_sorted(xs: Strs) -> Strs {
    let out = strs_new()
    for i in 0..strs_len(xs) {
        let x = strs_get(xs, i)
        let mut seen = false
        for k in 0..strs_len(out) {
            if strs_get(out, k) == x { seen = true }
        }
        if seen { continue }
        let mut at = strs_len(out)
        while at > 0 && fe_str_less(x, strs_get(out, at - 1)) { at -= 1 }
        strs_push(out, "")
        let mut q = strs_len(out) - 1
        while q > at {
            strs_set(out, q, strs_get(out, q - 1))
            q -= 1
        }
        strs_set(out, at, x)
    }
    out
}

// `checking::library` (N74): each module of a library package's source root checked as a module,
// with what it imports, each error reported once however many modules reach it.
fn check_library(io: IoCap, modules: Strs, library: Str, json: Bool) -> Int {
    let seen = strs_new()
    let mut errors = 0
    for k in 0..strs_len(modules) {
        let path = strs_get(modules, k)
        let f = fx_check_module(path, library, fe_host_os(), fe_host_arch(), io)
        if fx_refusal(f) != "" { refuse(io, "a source root the reference refuses") }
        let d = fx_diags(f)
        let names = fe_names(f, "")
        let out = strs_new()
        if fe_load_failed(f) {
            if !fx_carried(f) { refuse(io, fx_why(f)) }
            let all = ints_new()
            let mut missing = true
            for i in 0..dg_len(d) {
                if strs_get(d.code, i) != "N0205" { missing = false }
                ints_push(all, i)
            }
            emit(f, names, all, json, out)
            eprint(str_join(out, ""))
            exit_with(if missing { 3 } else { 1 })
        }
        if !fx_carried(f) { refuse(io, fx_why(f)) }
        let bases = fe_bases(f)
        let fresh = ints_new()
        for i in 0..dg_len(d) {
            if dg_severity(d, i) == "error" {
                let m = file_at(d, i, bases)
                let base = ints_get(bases, m)
                let key = strs_get(names, m) + str_from_byte(0) + int_to_str(ints_get(d.start, i) - base) + ":"
                        + int_to_str(ints_get(d.end, i) - base) + ":" + strs_get(d.code, i)
                let mut known = false
                for s in 0..strs_len(seen) {
                    if strs_get(seen, s) == key { known = true }
                }
                if !known {
                    strs_push(seen, key)
                    ints_push(fresh, i)
                }
            }
        }
        errors += ints_len(fresh)
        emit(f, names, fresh, json, out)
        eprint(str_join(out, ""))
    }
    if errors == 0 {
        print("ok" + nl())
        return 0
    }
    eprint("nazm: " + int_to_str(errors) + " error" + plural(errors) + nl())
    exit_with(1)
    0
}

// `--summary-json`: the summary of what the command reached, in place of its rendering, and the status.
fn finish_summary(io: IoCap, f: Facts, abs: Str, given: Str, library: Str, which: Ints, status: Str, code: Int, with_map: Bool) -> Int {
    let g = fx_check_module_in(abs, given, library, fe_host_os(), fe_host_arch(), io)
    if !fx_carried(g) { refuse(io, fx_why(g)) }
    print(sm_summary(f, g, which, status, code, readable_text(io, abs), with_map) + nl())
    exit_with(code)
    0
}

// `nazm check`, its arguments read into `c` (`check_cli`) from where `cli_from` says.
pub fn check_command(io: IoCap, proc: ProcessCap, sp: SpawnCap, c: Cli) -> Int {
    cli_parse(io, c)
    let mut file = cli_value(c, 0)
    let named = file
    let json = cli_present(c, 1)
    let no_cache = cli_present(c, 3)
    let report = cli_present(c, 4)
    let locked = cli_present(c, 6)
    let profile = cli_value(c, 7)
    let features = cli_values(c, 8)
    let deny = cli_present(c, 10)
    let library = os_env_get("NAZM_LIBRARY")
    let prefix = fe_prefix(io, file)

    // `prepare`: a directory is a package or nothing; a library package — no `main` — is checked as
    // its modules before anything else is asked; a package's directory stands for its `main`.
    let mut packaged = false
    let mut entry = false
    let mut packages = pk_none()
    if is_dir(io, file) {
        if fe_stat_kind(io, file + "/nazm.toml") != 0 {
            if exists(io, file + "/nazm.toml") { refuse(io, "a manifest that is not a file") }
            eprint("nazm: `" + file + "` is a directory with no `nazm.toml`, so it is not a package" + nl())
            exit_with(3)
        }
        let dir = pk_normalise(prefix + file)
        let m = pk_parse(read_file(pk_join(dir, "nazm.toml")))
        // A manifest that is not one: `resolve`'s diagnostic, the manifest named as given.
        if pk_state(m) == 0 {
            let shown = if str_byte(file, str_len(file) - 1) == 47 { file + "nazm.toml" } else { file + "/nazm.toml" }
            eprint("error[N0500]: `" + shown + "`: " + pk_why(m) + nl() + "nazm: 1 error" + nl())
            exit_with(1)
        }
        if pk_state(m) != 1 { refuse(io, "a manifest that does not resolve here") }
        let declared = pk_normalise(pk_join(dir, strs_get(m.root, 0)))
        let source_root = fe_canonical(io, declared)
        if source_root == "" { refuse(io, "a package without its source root") }
        packages = pk_context(declared, io)
        if pk_packages_state(packages) != 1 { refuse(io, "a package that does not resolve here") }
        if ints_get(m.has_main, 0) == 0 {
            let found = strs_new()
            if !fe_walk(io, source_root, found) { refuse(io, "a source root that cannot be read") }
            check_library(io, fe_sort_paths(found), library, json)
            return 0
        }
        let main = strs_get(m.main, 0)
        file = if fe_starts(main, "/") { main } else { pk_join(source_root, main) }
        packaged = true
        entry = true
    }
    // `package::entry`: the package the file lies in, held to its lockfile when asked.
    let abs = if entry { file } else { prefix + file }
    let root = pk_decide(abs, io)
    if pk_root_how(root) == 1 && !entry {
        packaged = true
        packages = pk_context(pk_root_path(root), io)
        if pk_packages_state(packages) != 1 { refuse(io, "a package that does not resolve here") }
    }
    if locked && !packaged {
        eprint("nazm: `--locked` holds a package build to its lockfile, and `" + named + "` is not in a package" + nl())
        exit_with(5)
    }
    if locked {
        // `verify_locked`: the lockfile beside the root manifest, held to the resolution (`pkg.nz`).
        let dir = fe_canonical(io, strs_get(packages.dirs, pk_root_package(packages)))
        let verdict = lk_verify(io, dir)
        if fe_starts(verdict, "R") { refuse(io, str_slice(verdict, 1, str_len(verdict))) }
        if fe_starts(verdict, "E") {
            eprint(str_slice(verdict, 1, str_len(verdict)))
            exit_with(1)
        }
    }
    // `profile::enforce`: an unknown profile is refused before anything is checked; the rules of the profiles in force are held after the program
    // has checked (below), before the command says anything.
    let in_force = strs_new()
    if cli_present(c, 7) {
        if !pf_known(profile) { unknown_profile(io, profile) }
        strs_push(in_force, profile)
    }
    if packaged {
        for i in 0..pk_count(packages) {
            let p = pk_profile(packages, i)
            if p != "" {
                if !pf_known(p) { pf_unknown(io, p, "the package `" + pk_name(packages, i) + "`'s manifest") }
                strs_push(in_force, p)
            }
        }
    }
    let profile_report = cli_present(c, 9)
    // `--source-root`: the root as given (`root::decide`'s `given`), absolute as the reference makes
    // it, its refusal in the words the user wrote it in; not carried for a package's file, whose
    // packages the reference resolves under another root than it loads from.
    let given = cli_value(c, 2)
    let given_prefix = if cli_present(c, 2) { fe_prefix(io, given) } else { "" }
    if cli_present(c, 2) && packaged { refuse(io, "`--source-root` for a package's module") }
    let summary = cli_present(c, 5)
    if report && !no_cache { refuse(io, "`--cache-report` with the check cache") }
    if !entry && exists(io, file) && !readable_text(io, file) { refuse(io, "a root module that is not a readable UTF-8 file") }

    let f = fx_check_profiles(abs, if cli_present(c, 2) { given_prefix + given } else { "" }, library, fe_host_os(), fe_host_arch(), profiles_sorted(in_force), io)
    // `root::decide`'s refusal: a manifest that is not one, a marker that is not empty, a given root
    // that is not a directory.
    if fx_refusal(f) != "" {
        // `root::decide`'s refusal, in its words: 3 for what cannot be read, else 1 (`root_status`).
        let why = fe_unprefix(fx_refusal(f), given_prefix)
        if summary {
            let unreadable = fe_starts(why, "could not read")
                    || (str_len(why) >= 18 && str_slice(why, str_len(why) - 18, str_len(why)) == "is not a directory")
            finish_summary(io, f, abs, if cli_present(c, 2) { given_prefix + given } else { "" }, library, ints_new(),
                    if unreadable { "unreadable" } else { "refused" }, if unreadable { 3 } else { 1 }, false)
        }
        eprint("nazm: " + why + nl())
        let unreadable = fe_starts(why, "could not read")
                || (str_len(why) >= 18 && str_slice(why, str_len(why) - 18, str_len(why)) == "is not a directory")
        exit_with(if unreadable { 3 } else { 1 })
    }
    let d = fx_diags(f)
    let shown = if entry { "" } else { prefix }
    fe_unprefix_diags(io, d, shown, abs)
    let names = fe_names(f, shown)
    let out = strs_new()
    if fe_load_failed(f) {
        if !fx_carried(f) { refuse(io, fx_why(f)) }
        let all = ints_new()
        let mut missing = true
        for i in 0..dg_len(d) {
            if strs_get(d.code, i) != "N0205" { missing = false }
            ints_push(all, i)
        }
        if summary {
            finish_summary(io, f, abs, if cli_present(c, 2) { given_prefix + given } else { "" }, library, all,
                    if missing { "unreadable" } else { "rejected" }, if missing { 3 } else { 1 }, true)
        }
        emit(f, names, all, json, out)
        eprint(str_join(out, ""))
        exit_with(if missing { 3 } else { 1 })
    }
    if strs_len(features) > 0 {
        for i in 0..strs_len(features) {
            if strs_get(features, i) == "" { refuse(io, "an empty feature") }
        }
        if packaged { undeclared_features(io, packages, features) }
        eprint("nazm: `--features` enables a package's features, and this program is not in a package" + nl())
        exit_with(5)
    }
    if !fx_carried(f) { refuse(io, fx_why(f)) }
    if strs_len(in_force) > 0 || profile_report {
        // The report names a file as the loader did; `locked` is whether the package was held to its lockfile.
        pf_enforce(io, proc, sp, f, abs, names, in_force, locked || (packaged && pf_lock_ok(io, packages)), profile_report)
    }
    if report {
        let how = if cli_present(c, 2) { "given" } else if pk_root_how(root) == 1 { "package" } else { "derived" }
        let n = int_to_str(fx_modules(f))
        print("{\"schema\":\"nazm.check-report/1\",\"root\":\"" + how + "\",\"modules\":" + n + ",\"checked\":" + n
                + ",\"reused\":0,\"missed\":0,\"rejected\":0,\"declined\":0,\"stored\":0}" + nl())
    }

    let warnings = ints_new()
    let errors = ints_new()
    for i in 0..dg_len(d) {
        if strs_get(d.severity, i) == "warning" { ints_push(warnings, i) } else { ints_push(errors, i) }
    }
    if summary {
        let all = ints_new()
        for i in 0..ints_len(errors) { ints_push(all, ints_get(errors, i)) }
        for i in 0..ints_len(warnings) { ints_push(all, ints_get(warnings, i)) }
        let ok = ints_len(errors) == 0 && !(deny && ints_len(warnings) > 0)
        finish_summary(io, f, abs, if cli_present(c, 2) { given_prefix + given } else { "" }, library, all,
                if ok { "success" } else { "rejected" }, if ok { 0 } else { 1 }, true)
    }
    emit(f, names, warnings, json, out)
    let warned = str_join(out, "")
    let failed = strs_new()
    emit(f, names, errors, json, failed)
    eprint(warned)
    let denied = deny && ints_len(warnings) > 0
    if ints_len(errors) == 0 && !denied {
        print("ok" + nl())
        return 0
    }
    if ints_len(errors) == 0 {
        let w = ints_len(warnings)
        eprint("nazm: " + int_to_str(w) + " warning" + plural(w) + ", refused by --deny-warnings" + nl())
        exit_with(1)
    }
    eprint(str_join(failed, ""))
    let n = ints_len(errors)
    eprint("nazm: " + int_to_str(n) + " error" + plural(n) + nl())
    exit_with(1)
    0
}
