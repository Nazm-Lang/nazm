// `nazm run`, written in Nazm (R8 slice 7, `openspec/changes/r8-cut-over/design.md`, S7.2 and S7.3).
//
// `nazm run [OPTIONS] FILE [-- ARGS]`, run by the dispatcher (`nazm.nz`): `--interpret` evaluates the program in
// this process (`interpret.nz`); without it the program is built (`build.nz`'s `bd_build`, in run mode) and run.

use "cli.nz"
use "interpret.nz"
use "build.nz"
use "buildcli.nz"
use "harness.nz"
use "util.nz"

fn nl() -> Str { str_from_byte(10) }

// The command line, as `crates/nazm-cli/src/cli.rs` declares `nazm run`.
pub fn run_cli() -> Cli {
    let c = cli_command("run", "Build a program with Cranelift and run it, ending with its exit status; `--interpret` evaluates it in the "
            + "interpreter instead (R1.5, D11)", "")
    cli_positional(c, "FILE", true, false, true, "", "")
    let args = cli_positional(c, "ARGS", false, true, false, "Arguments for the program itself, after `--`",
            "Arguments for the program itself, after `--`." + nl() + nl()
            + "What `arg(i)` sees, **excluding** the program's own name — so `arg(0)` means the same thing here and in a compiled "
            + "executable, where `argv[0]` is a path nobody should depend on.")
    cli_last(c, args)
    cli_flag(c, "", "json", "Emit diagnostics as one JSON object per line",
            "Emit diagnostics as one JSON object per line." + nl() + nl()
            + "The machine-readable form is the contract; the rendered text is a view of it.")
    let interpret = cli_flag(c, "", "interpret", "Run the program in the interpreter, the oracle every equivalence test compares the backends against "
            + "(R1.5, D11). Without it the program is compiled and run, and a program the compiler refuses is refused: neither falls back "
            + "to the other", "")
    let iterations = cli_option(c, "", "max-iterations", "MAX_ITERATIONS", false, "10000000", true, "Stop after this many loop iterations. With `--interpret` only",
            "Stop after this many loop iterations. With `--interpret` only." + nl() + nl()
            + "An interpreter guard, not a language rule: with no `break` and no I/O a non-terminating program produces nothing, and a tool "
            + "that hangs is worse than one that reports. A compiled program has no such guard, so asking for one without `--interpret` "
            + "is refused rather than ignored.")
    cli_numeric_size(c, iterations)
    let depth = cli_option(c, "", "max-depth", "MAX_DEPTH", false, "512", true, "Stop after this many nested calls. With `--interpret` only",
            "Stop after this many nested calls. With `--interpret` only." + nl() + nl()
            + "The iteration budget does not bound recursion: `fn f(n: Int) -> Int { f(n) }` never loops. Without this the host stack runs out "
            + "and the process dies with no diagnostic at all." + nl() + nl()
            + "Raising it raises the stack the interpreter reserves, so the diagnostic is still reached before the stack is. What it costs is "
            + "stated below rather than left for someone to discover.")
    cli_vkind(c, depth, 7)
    cli_requires(c, iterations, interpret)
    cli_requires(c, depth, interpret)
    cli_flag(c, "", "locked", "Refuse to build unless the package's `nazm.lock` records exactly the packages this resolves to, with their bytes unchanged (N46)", "")
    cli_option(c, "", "profile", "NAME", false, "", false, "A restriction profile to hold the program to (N47): `general`, `embedded`, `critical`, `cyber`, "
            + "`realtime`, `web3`, `accounts`, `authority`, `kernel`, `robotics`, `automotive`, `aerospace`, `assurance`, `industrial` or `medical`. "
            + "Added to any the packages' manifests require; a profile only refuses, and never changes what an accepted program does", "")
    let harness = cli_option(c, "", "harness", "SPEC", false, "", false, "", "")
    cli_hidden(c, harness)
    cli_list(c, "", "features", "NAMES", ",", "Features of the root package to enable beyond its `default`, comma-separated (Gate 2, §22); each package's "
            + "`@cfg(feature = …)` sees its own", "")
    c
}

fn ru_int(raw: Str) -> Int {
    let mut v = 0
    for i in 0..str_len(raw) {
        let b = str_byte(raw, i)
        if b >= 48 && b <= 57 {
            // Past an `Int` the budget is as good as unbounded.
            if v > 922337203685477579 { v = 9223372036854775807 } else { v = v * 10 + (b - 48) }
        }
    }
    v
}

pub fn run_command(io: IoCap, out: OutCap, time: TimeCap, net: NetCap, proc: ProcessCap, sp: SpawnCap, v: VouchCap, rnd: RandomCap, c: Cli) -> Int {
    cli_parse(io, c)
    let mut o = bo_default()
    o.file = cli_value(c, 0)
    o.json = cli_present(c, 2)
    o.locked = cli_present(c, 6)
    o.has_profile = cli_present(c, 7)
    o.profile = cli_value(c, 7)
    o.features = cli_values(c, 9)
    // `prepare`: a package's directory stands for its `main`, `--locked` holds it to its lockfile, the profiles are held.
    let entry = strs_new()
    let packages = bd_prepare(io, o, entry)
    if strs_len(entry) > 0 { o.file = strs_get(entry, 0) }
    let harness = if cli_present(c, 8) { hs_require(io, cli_value(c, 8)) } else { strs_new() }
    if cli_present(c, 3) {
        let max_iterations = ru_int(cli_value(c, 4))
        let max_depth = ru_int(cli_value(c, 5))
        exit_with(ip_run(io, out, time, net, proc, sp, rnd, o, packages, o.json, cli_values(c, 1), max_iterations, max_depth, harness))
        return 0
    }
    // The build: for the host, with Nazm's own code generator (the fast-to-compile backend; Cranelift is not carried), no heap limit,
    // the object cache on, and `run` mode — nothing said of the build. The executable is run from the build's own work directory,
    // in the temporary directory, which is removed on every path out.
    o.run = true
    o.backend = "nazm"
    o.run_args = cli_values(c, 1)
    o.has_harness = cli_present(c, 8)
    o.harness = cli_value(c, 8)
    let stem = ut_stem(o.file)
    let tmp = os_env_get("TMPDIR")
    o.out = (if tmp == "" { "/tmp" } else { tmp }) + "/" + (if stem == "" { "program" } else { stem })
    exit_with(bd_build(io, proc, sp, time, v, o))
    0
}
