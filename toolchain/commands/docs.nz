// `nazm docs`, written in Nazm (R5, `openspec/changes/r5-commands/`, task 9.1, design D20).
//
// `nazm docs (--index [--document ID] | --section ID [--state STATE]) [--json] --root DIR`, run by the
// dispatcher (`nazm.nz`).
//
// A port of `crates/nazm-docs` (`lib.rs`, `markdown.rs`, `grammar.rs`, `manifest.rs`) and of
// `crates/nazm-cli/src/docs.rs`: Nazm's own documentation, read as it is on disk into sections — ATX
// headings with their anchors and labels, or one section per grammar production — each with its
// BLAKE3 digest, its links resolved against the corpus, and the corpus `state`; answered as the
// compact `nazm.docs-index/1` or `nazm.docs-section/1` line, the same object indented with its keys
// sorted, or (without `--json`) the index's ids and titles and a section's exact text.
//
// The default root is the repository the reference binary was built from, which a port cannot
// know: without `--root` the command says so and exits 6 (design D5). The reference classifies a
// heading's characters with Unicode tables (`char::is_alphanumeric`, `to_lowercase`); the port
// knows ASCII and the punctuation the corpus's headings use (— · – → …) and refuses a heading
// holding any other non-ASCII character rather than guess.

use "@std/blake3"
use "@std/hash"
use "@std/hashmap"
use "../../compiler/diag.nz"
use "cli.nz"
use "jsonin.nz"
use "util.nz"

fn nl() -> Str { str_from_byte(10) }

// The command line, as `crates/nazm-cli/src/cli.rs` declares `nazm docs`.
pub fn docs_cli() -> Cli {
    let c = cli_command("docs", "Retrieve Nazm's own documentation by section: a compact index, `nazm.docs-index/1`, or one section's exact "
            + "canonical text, `nazm.docs-section/1`",
            "Retrieve Nazm's own documentation by section: a compact index, `nazm.docs-index/1`, or one section's exact canonical "
            + "text, `nazm.docs-section/1`." + nl() + nl()
            + "The index lists every document of the corpus with its authority — normative, goal, planning, evidence and the rest — "
            + "and every section's stable id, title, parent and digest, with no body. `--section ID` returns that section's own text "
            + "byte for byte, never its subsections', and never a paraphrase; `--state` binds the request to the corpus an index "
            + "described. Read from the repository's documentation as it is now; ids are exact, with no search. "
            + "`docs/internal/architecture.md` §7.34.")
    let index = cli_flag(c, "", "index", "Print the index", "")
    let document = cli_option(c, "", "document", "DOCUMENT", false, "", false, "Only this document's sections, by its id", "")
    let section = cli_option(c, "", "section", "SECTION", false, "", false, "Print one section, by its exact id", "")
    let state = cli_option(c, "", "state", "STATE", false, "", false, "The index's `state`: refuse the section if the corpus has changed since", "")
    cli_flag(c, "", "json", "The one canonical compact serialisation. Without it, a section's text or the index's ids and titles", "")
    cli_option(c, "", "root", "ROOT", true, "", false, "The repository whose `docs/` to read. Without it, the one this binary was built from", "")
    cli_conflicts(c, document, section)
    cli_conflicts(c, state, index)
    cli_require_one(c, index, section)
    c
}

fn refuse(io: IoCap, why: Str) -> Int {
    eprint("docs: not carried: " + why + nl())
    exit_with(6)
    0
}

// --- the corpus -----------------------------------------------------------------------------------

pub struct Corp {
    d_id: Strs,
    d_path: Strs,
    d_auth: Strs,
    d_fmt: Strs,
    d_text: Strs,
    d_digest: Strs,
    s_doc: Ints,
    s_id: Strs,
    // 0 document, 1 heading, 2 production.
    s_kind: Ints,
    s_title: Strs,
    s_has_title: Ints,
    s_level: Ints,
    s_parent: Strs,
    s_has_parent: Ints,
    s_rs: Ints,
    s_re: Ints,
    s_l0: Ints,
    s_l1: Ints,
    s_digest: Strs,
    s_frag: Strs,
    s_has_frag: Ints,
    s_prod: Strs,
    s_has_prod: Ints,
    c_sec: Ints,
    c_id: Strs,
    k_sec: Ints,
    k_rel: Strs,
    k_href: Strs,
    k_has_href: Ints,
    k_target: Strs,
    k_has_target: Ints,
    k_scope: Strs,
    e_sec: Ints,
    e_text: Strs,
    p_kind: Strs,
    p_doc: Strs,
    p_line: Ints,
    p_value: Strs,
    state: Strs,
}

fn corp_new() -> Corp {
    Corp(d_id: strs_new(), d_path: strs_new(), d_auth: strs_new(), d_fmt: strs_new(), d_text: strs_new(), d_digest: strs_new(),
            s_doc: ints_new(), s_id: strs_new(), s_kind: ints_new(), s_title: strs_new(), s_has_title: ints_new(), s_level: ints_new(),
            s_parent: strs_new(), s_has_parent: ints_new(), s_rs: ints_new(), s_re: ints_new(), s_l0: ints_new(), s_l1: ints_new(),
            s_digest: strs_new(), s_frag: strs_new(), s_has_frag: ints_new(), s_prod: strs_new(), s_has_prod: ints_new(),
            c_sec: ints_new(), c_id: strs_new(), k_sec: ints_new(), k_rel: strs_new(), k_href: strs_new(), k_has_href: ints_new(),
            k_target: strs_new(), k_has_target: ints_new(), k_scope: strs_new(), e_sec: ints_new(), e_text: strs_new(),
            p_kind: strs_new(), p_doc: strs_new(), p_line: ints_new(), p_value: strs_new(), state: strs_new())
}

// The corpus read from the repository at `root` (`Corpus::load`): sections, links, digests and the corpus state, or its problems (`p_*`).
// What `nazm repo` reads it through (R8 slice 9).
pub fn dc_load(io: IoCap, root: Str) -> Corp { load(io, root) }

