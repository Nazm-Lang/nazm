// The language service's rename (`nazm_service::rename`, R5 design D24): the entity at a name of the document, whether it
// may be renamed, and the edits that rename it — checked as the reference checks them (the new name lexed as one
// identifier, the candidate program checked again with the edits applied, its occurrences partitioned into entities
// as the program's own were) — over R2's facts. Shared by `nazm patch rename` and the language server's rename.
//
// An answer is a code, `""` for a plan or one of the reference's refusals (`no_entity`, `incomplete_coverage`,
// `toolchain_owned`, `exported`, `not_clean`, `invalid_name`, `unchanged`, `rejected`, `meaning_changed`, `internal`)
// with the words `Refusal`'s `Display` gives it; where the facts cannot say what the reference would, `why`
// says so and the caller refuses.

use "../../compiler/lex.nz"
use "../../compiler/syntax.nz"
use "../../compiler/diag.nz"
use "../../compiler/sema.nz"
use "../../compiler/package.nz"
use "../../compiler/facts.nz"
use "front.nz"
use "util.nz"

// The entity the identifier at `st..en` of the document (module 0, whose offsets are the compilation's)
// is of — its declaration or one of its uses — or -1 (`ReferenceIndex::target`).
fn entity_at(f: Facts, st: Int, en: Int) -> Int {
    let n = fx_ref_count(f)
    for i in 0..n {
        if fx_ref_decl_start(f, i) == st && fx_ref_decl_end(f, i) == en { return i }
    }
    for i in 0..n {
        for k in 0..fx_ref_use_count(f, i) {
            if fx_ref_use_start(f, i, k) == st && fx_ref_use_end(f, i, k) == en { return i }
        }
    }
    0 - 1
}

pub fn rn_entity_at(f: Facts, st: Int, en: Int) -> Int { entity_at(f, st, en) }

// Whether the entity's owning top-level definition is exported (`exported`): a function, record or enum with
// `pub`, or a field, variant or payload field of one; a local or a constant never. An entity the tables
// do not have is taken to be exported.
fn exported(f: Facts, kind: Str, ds: Int) -> Bool {
    let c = fx_checker(f)
    if kind == "local" || kind == "constant" { return false }
    let m = fx_module_at(f, ds)
    let local = ds - fx_module_base(f, m)
    if kind == "function" {
        for i in 0..ck_fn_count(c) {
            if ck_fn_name_start(c, i) == ds && !ck_fn_closure(c, i) { return ck_fn_public(c, i) }
        }
        return true
    }
    let t = fx_tree(f)
    if kind == "record" || kind == "field" {
        for r in 0..ck_record_count(c) {
            let node = ck_record_node(c, r)
            if ck_record_module(c, r) != m || node < 0 { continue }
            let span = sx_field(t, node, "span")
            if kind == "record" && ck_record_name_start(c, r) == ds { return ck_record_public(c, r) }
            if kind == "field" && fx_start(f, span) <= local && local < fx_end(f, span) { return ck_record_public(c, r) }
        }
        return true
    }
    for e in 0..ck_enum_count(c) {
        let node = ck_enum_node(c, e)
        if ck_enum_module(c, e) != m || node < 0 { continue }
        let span = sx_field(t, node, "span")
        if kind == "enum" && ck_enum_name_start(c, e) == ds { return ck_enum_public(c, e) }
        if kind != "enum" && fx_start(f, span) <= local && local < fx_end(f, span) { return ck_enum_public(c, e) }
    }
    true
}

// `valid_name`: the reason `name` is no identifier, "" where it is one.
fn invalid_name(name: Str) -> Str {
    if name == "" { return "is empty" }
    if name == "_" { return "is `_`, which discards rather than names" }
    let kinds = ints_new()
    let starts = ints_new()
    let ends = ints_new()
    let texts = strs_new()
    let d = dg_new()
    lex_all(name, kinds, starts, ends, texts, d)
    if dg_len(d) > 0 { return "is not a token" }
    let real = ints_len(kinds)
    let only = real - 1
    if real == 1 && ints_get(kinds, only) == k_ident() && ints_get(starts, only) == 0 && ints_get(ends, only) == str_len(name) { return "" }
    if real == 1 && ints_get(kinds, only) != k_ident() { return "is a keyword or a symbol, not an identifier" }
    "is not one identifier"
}

fn pad(n: Int) -> Str {
    let t = int_to_str(n)
    let mut z = ""
    for i in 0..12 - str_len(t) { z = z + "0" }
    z + t
}

fn sort_strs(xs: Strs) -> Strs {
    let n = strs_len(xs)
    if n < 2 { return xs }
    let mid = n / 2
    let left = strs_new()
    let right = strs_new()
    for i in 0..mid { strs_push(left, strs_get(xs, i)) }
    for i in mid..n { strs_push(right, strs_get(xs, i)) }
    let a = sort_strs(left)
    let b = sort_strs(right)
    let out = strs_new()
    let mut i = 0
    let mut k = 0
    while i < strs_len(a) && k < strs_len(b) {
        if fe_str_less(strs_get(b, k), strs_get(a, i)) {
            strs_push(out, strs_get(b, k))
            k += 1
        } else {
            strs_push(out, strs_get(a, i))
            i += 1
        }
    }
    while i < strs_len(a) {
        strs_push(out, strs_get(a, i))
        i += 1
    }
    while k < strs_len(b) {
        strs_push(out, strs_get(b, k))
        k += 1
    }
    out
}

fn sort_unique(xs: Strs) -> Strs {
    let sorted = sort_strs(xs)
    let out = strs_new()
    for i in 0..strs_len(sorted) {
        if i == 0 || strs_get(sorted, i) != strs_get(sorted, i - 1) { strs_push(out, strs_get(sorted, i)) }
    }
    out
}

fn same_strs(a: Strs, b: Strs) -> Bool {
    if strs_len(a) != strs_len(b) { return false }
    for i in 0..strs_len(a) {
        if strs_get(a, i) != strs_get(b, i) { return false }
    }
    true
}

// The first diagnostic of a module's analysis (the program's missing `main` is no part of it), or -1.
fn first_error(f: Facts) -> Int {
    let d = fx_diags(f)
    for i in 0..dg_len(d) {
        if dg_severity(d, i) == "error" && dg_code(d, i) != "N0204" { return i }
    }
    0 - 1
}

fn num(s: Str) -> Int {
    let mut n = 0
    for i in 0..str_len(s) { n = n * 10 + str_byte(s, i) - 48 }
    n
}

fn sort_places(xs: Strs) -> Strs { sort_strs(xs) }

// --- the answer ---------------------------------------------------------------------------------------------------


// --- the open documents a rename is planned over --------------------------------------------------------------------------

// The documents a rename is planned in: each open document's path, text and version, the compilation rooted at each (the facts), the declared source root ("" for none) and
// the standard library's directory. The language server's open documents, or the one or two documents a patch opens.
pub struct Docs {
    paths: Strs,
    texts: Strs,
    versions: Ints,
    facts: Vec[Facts],
    root: Strs,
    library: Strs,
}

pub fn rn_docs(paths: Strs, texts: Strs, versions: Ints, facts: Vec[Facts], root: Strs, library: Strs) -> Docs {
    Docs(paths: paths, texts: texts, versions: versions, facts: facts, root: root, library: library)
}

// `service::identity`: the canonical path, or where the file is not there its directory's with its name.
pub fn rn_identity_of(io: IoCap, path: Str) -> Str {
    let c = fe_canonical(io, path)
    if c != "" { return c }
    let norm = pk_normalise(path)
    let dir = fe_canonical(io, ut_parent(norm))
    if dir == "" { return norm }
    if dir == "/" { return "/" + ut_file_name(norm) }
    dir + "/" + ut_file_name(norm)
}

fn identity_of(io: IoCap, path: Str) -> Str { rn_identity_of(io, path) }

// What a file of a compilation is known by (`FileKey`): a path's identity, or the name of a module the toolchain owns.
pub fn rn_module_identity(io: IoCap, name: Str) -> Str {
    if fe_starts(name, "@") { return name }
    identity_of(io, pk_normalise(name))
}

fn module_identity(io: IoCap, name: Str) -> Str { rn_module_identity(io, name) }

// The identity of each module of `f`.
fn module_ids(io: IoCap, f: Facts) -> Strs {
    let out = strs_new()
    for m in 0..fx_modules(f) { strs_push(out, module_identity(io, fx_module_name(f, m))) }
    out
}

// How a compilation's occurrences group into entities, as places: for each entity, its kind and the places of its declaration and uses, each a file's
// identity and local offsets. The groups are made, sorted and compared (`part_groups`) once the edits that move them are known.
struct Part {
    kind: Strs,
    first: Ints,
    count: Ints,
    pid: Strs,
    ps: Ints,
    pe: Ints,
}

// The identity of each module of `f` (`module_identity`).
fn part_of(io: IoCap, f: Facts) -> Part {
    let p = Part(kind: strs_new(), first: ints_new(), count: ints_new(), pid: strs_new(), ps: ints_new(), pe: ints_new())
    let ids = module_ids(io, f)
    for i in 0..fx_ref_count(f) {
        strs_push(p.kind, fx_ref_kind(f, i))
        ints_push(p.first, strs_len(p.pid))
        let mut n = 0
        let ds = fx_ref_decl_start(f, i)
        if ds >= 0 {
            let m = fx_module_at(f, ds)
            strs_push(p.pid, strs_get(ids, m))
            ints_push(p.ps, ds - fx_module_base(f, m))
            ints_push(p.pe, fx_ref_decl_end(f, i) - fx_module_base(f, m))
            n += 1
        }
        for k in 0..fx_ref_use_count(f, i) {
            let a = fx_ref_use_start(f, i, k)
            let m = fx_module_at(f, a)
            strs_push(p.pid, strs_get(ids, m))
            ints_push(p.ps, a - fx_module_base(f, m))
            ints_push(p.pe, fx_ref_use_end(f, i, k) - fx_module_base(f, m))
            n += 1
        }
        ints_push(p.count, n)
    }
    p
}

// The groups of `p` with the places of the files in `e_id` moved past the edits (`e_id`, `e_start`, `e_end`, `e_len`: each edit's file, bytes and
// replacement length, ordered within a file): sorted, each once.
fn part_groups(p: Part, e_id: Strs, e_start: Ints, e_end: Ints, e_len: Ints) -> Strs {
    let groups = strs_new()
    for i in 0..strs_len(p.kind) {
        let places = strs_new()
        for q in 0..ints_get(p.count, i) {
            let at = ints_get(p.first, i) + q
            let id = strs_get(p.pid, at)
            let mut s = ints_get(p.ps, at)
            let mut e = ints_get(p.pe, at)
            let mut delta = 0
            let mut done = false
            for k in 0..ints_len(e_start) {
                if !done && strs_get(e_id, k) == id {
                    let grew = ints_get(e_len, k) - ints_get(e_end, k) + ints_get(e_start, k)
                    if ints_get(e_start, k) == s && ints_get(e_end, k) == e {
                        s = s + delta
                        e = s + ints_get(e_len, k)
                        done = true
                    } else if ints_get(e_end, k) <= s {
                        delta += grew
                    }
                }
            }
            if !done {
                s = s + delta
                e = e + delta
            }
            strs_push(places, id + str_from_byte(0) + pad(s) + "-" + pad(e))
        }
        strs_push(groups, strs_get(p.kind, i) + "|" + str_join(sort_places(places), ";"))
    }
    sort_unique(groups)
}


// The open document whose identity is `key`, or -1.
pub fn open_as(io: IoCap, d: Docs, key: Str) -> Int {
    for i in 0..strs_len(d.paths) {
        if identity_of(io, strs_get(d.paths, i)) == key { return i }
    }
    0 - 1
}

fn open_version(io: IoCap, d: Docs, key: Str) -> Int {
    let at = open_as(io, d, key)
    if at < 0 { return 0 - 1 }
    ints_get(d.versions, at)
}

// Every open compilation that contains the file `key` with exactly `text`: its document and the file's module there, pairs.
fn containing(io: IoCap, d: Docs, key: Str, text: Str) -> Ints {
    let out = ints_new()
    for dk in 0..vec_len(d.facts) {
        let g = vec_get(d.facts, dk)
        let mut found = false
        for m in 0..fx_modules(g) {
            if !found && module_identity(io, fx_module_name(g, m)) == key && fx_module_text(g, m) == text {
                ints_push(out, dk)
                ints_push(out, m)
                found = true
            }
        }
    }
    out
}

// Whether the package whose source root is `root` is a library: its manifest names no `main` (`library_package`).
fn library_package(io: IoCap, root: Str) -> Bool {
    let mut dir = root
    while dir != "" {
        let manifest = pk_join(dir, "nazm.toml")
        if file_exists(manifest) {
            let m = pk_parse(read_file(manifest))
            if pk_state(m) == 1 && pk_normalise(pk_join(dir, strs_get(m.root, 0))) == root && ints_get(m.has_main, 0) == 0 { return true }
        }
        dir = pk_parent(dir)
    }
    false
}

// The workspace document `k` is in (`LanguageService::workspace`): its source root where that is declared — by `--source-root`, a `nazm.root` marker or a package's
// manifest — "" where the root is merely the file's directory, and "!" for a library package's, whose API other packages use.
fn workspace_root(io: IoCap, d: Docs, k: Int) -> Str {
    let given = strs_get(d.root, 0)
    if given != "" { return pk_normalise(given) }
    let r = pk_decide(strs_get(d.paths, k), io)
    let how = pk_root_how(r)
    if how == 2 { return pk_root_path(r) }
    if how == 1 {
        if library_package(io, pk_root_path(r)) { return "!" }
        return pk_root_path(r)
    }
    ""
}

// Every `.nz` file under `dir`, skipping hidden directories and `target`, following links as `Path::is_dir` does.
fn walk_workspace(io: IoCap, dir: Str, out: Strs) -> Int {
    let h = os_dir_open(dir)
    if os_status(h) < 0 { return 0 }
    let buf = bytes_new(1024)
    let mut n = os_dir_next(h, buf)
    let subdirs = strs_new()
    while n > 0 {
        let name = bytes_to_str(bytes_slice(buf, 0, n))
        let p = if dir == "/" { "/" + name } else { dir + "/" + name }
        if fe_stat_kind(io, p) == 1 {
            if !fe_starts(name, ".") && name != "target" { strs_push(subdirs, p) }
        } else if str_len(name) > 3 && str_slice(name, str_len(name) - 3, str_len(name)) == ".nz" {
            strs_push(out, p)
        }
        n = os_dir_next(h, buf)
    }
    os_close(h)
    for i in 0..strs_len(subdirs) { walk_workspace(io, strs_get(subdirs, i), out) }
    0
}

// --- the answer ---------------------------------------------------------------------------------------------------

// A rename's answer: a `code` ("" for a plan, else one of the reference's refusals: `no_entity`, `incomplete_coverage`, `toolchain_owned`, `exported`, `package_api`,
// `not_clean`, `invalid_name`, `unchanged`, `rejected`, `meaning_changed`, `internal`) with the words `Refusal`'s `Display` gives it in `msg`; where the facts cannot say what the
// reference would, `why` says so and the caller refuses. A plan holds the entity (`fx_ref_*`'s numbering in document `k`'s compilation), where it is declared (module and local offsets), its
// name, and the files it edits (as the protocol names them, the text each was computed from, the version of its open document or -1, and the edits).
pub struct Rn {
    code: Strs,
    msg: Strs,
    why: Strs,
    entity: Ints,
    decl: Ints,
    old: Strs,
    paths: Strs,
    texts: Strs,
    versions: Ints,
    first: Ints,
    count: Ints,
    starts: Ints,
    ends: Ints,
}

fn rn_new() -> Rn {
    let r = Rn(code: strs_new(), msg: strs_new(), why: strs_new(), entity: ints_new(), decl: ints_new(), old: strs_new(), paths: strs_new(), texts: strs_new(), versions: ints_new(),
            first: ints_new(), count: ints_new(), starts: ints_new(), ends: ints_new())
    strs_push(r.code, "")
    strs_push(r.msg, "")
    strs_push(r.why, "")
    ints_push(r.entity, 0 - 1)
    strs_push(r.old, "")
    r
}

pub fn rn_code(r: Rn) -> Str { strs_get(r.code, 0) }
pub fn rn_msg(r: Rn) -> Str { strs_get(r.msg, 0) }
pub fn rn_why(r: Rn) -> Str { strs_get(r.why, 0) }
pub fn rn_entity(r: Rn) -> Int { ints_get(r.entity, 0) }
pub fn rn_old(r: Rn) -> Str { strs_get(r.old, 0) }
pub fn rn_decl_module(r: Rn) -> Int { ints_get(r.decl, 0) }
pub fn rn_decl_start(r: Rn) -> Int { ints_get(r.decl, 1) }
pub fn rn_decl_end(r: Rn) -> Int { ints_get(r.decl, 2) }
pub fn rn_file_count(r: Rn) -> Int { strs_len(r.paths) }
pub fn rn_file_path(r: Rn, i: Int) -> Str { strs_get(r.paths, i) }
pub fn rn_file_text(r: Rn, i: Int) -> Str { strs_get(r.texts, i) }
pub fn rn_file_version(r: Rn, i: Int) -> Int { ints_get(r.versions, i) }
pub fn rn_edit_count(r: Rn, i: Int) -> Int { ints_get(r.count, i) }
pub fn rn_edit_start(r: Rn, i: Int, k: Int) -> Int { ints_get(r.starts, ints_get(r.first, i) + k) }
pub fn rn_edit_end(r: Rn, i: Int, k: Int) -> Int { ints_get(r.ends, ints_get(r.first, i) + k) }

fn rn_fail(r: Rn, code: Str, msg: Str) -> Rn {
    strs_set(r.code, 0, code)
    strs_set(r.msg, 0, msg)
    r
}

fn rn_unsure(r: Rn, why: Str) -> Rn {
    if strs_get(r.why, 0) == "" { strs_set(r.why, 0, why) }
    r
}

// The identifier of `text` holding byte `at` or ending there: its start and end and the kind of the token before it;
// -1 for none, and -2 where the text does not lex.
pub fn rn_name_at(text: Str, at: Int) -> Ints {
    let kinds = ints_new()
    let starts = ints_new()
    let ends = ints_new()
    let texts = strs_new()
    let d = dg_new()
    lex_all(text, kinds, starts, ends, texts, d)
    let out = ints_new()
    if dg_len(d) > 0 {
        ints_push(out, 0 - 2)
        ints_push(out, 0 - 2)
        ints_push(out, 0 - 2)
        return out
    }
    for k in 0..ints_len(kinds) {
        if ints_get(starts, k) <= at && at < ints_get(ends, k) {
            if ints_get(kinds, k) == k_ident() {
                ints_push(out, ints_get(starts, k))
                ints_push(out, ints_get(ends, k))
                ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
                return out
            }
        }
    }
    for k in 0..ints_len(kinds) {
        if ints_get(kinds, k) == k_ident() && ints_get(ends, k) == at {
            ints_push(out, ints_get(starts, k))
            ints_push(out, ints_get(ends, k))
            ints_push(out, if k > 0 { ints_get(kinds, k - 1) } else { 0 - 1 })
            return out
        }
    }
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    ints_push(out, 0 - 1)
    out
}

pub fn rn_first_error(f: Facts) -> Int { first_error(f) }

// Whether the entity at the name `st..en` of document `k` may be renamed, as `renameable` answers: every rule but the new name's.
pub fn rn_renameable(io: IoCap, d: Docs, k: Int, st: Int, en: Int) -> Rn {
    let r = rn_new()
    let f = vec_get(d.facts, k)
    let e = entity_at(f, st, en)
    if e < 0 { return rn_fail(r, "no_entity", "nothing a program declared is named here") }
    ints_set(r.entity, 0, e)
    let kind = fx_ref_kind(f, e)
    if kind == "trait" || kind == "trait method" {
        return rn_fail(r, "incomplete_coverage", "not every occurrence is known: a trait's methods are written again in every impl of it")
    }
    let ds = fx_ref_decl_start(f, e)
    let toolchain = "this is the core prelude's, which the toolchain owns"
    if ds < 0 { return rn_fail(r, "toolchain_owned", toolchain) }
    let m = fx_module_at(f, ds)
    if fx_module_name(f, m) == "@core/prelude.nz" { return rn_fail(r, "toolchain_owned", toolchain) }
    if exported(f, kind, ds) {
        // Within a declared workspace every module that can name it is searched (N89).
        let ws = workspace_root(io, d, k)
        if ws == "" {
            return rn_fail(r, "exported", "this is exported, and a module no open program loads may use it, so every occurrence cannot be known; "
                    + "declare a workspace (a `nazm.root` marker or `--source-root`) and every module under it is searched")
        }
        if ws == "!" {
            return rn_fail(r, "package_api", "this is part of a library package's API, which other packages import; no walk of this workspace finds their uses, so it is not renamed")
        }
    }
    // Every compilation that contains the declaring file must be clean: a resolution with errors in it is not a complete account of where anything is used.
    let held = containing(io, d, module_identity(io, fx_module_name(f, m)), fx_module_text(f, m))
    for q in 0..ints_len(held) / 2 {
        if first_error(vec_get(d.facts, ints_get(held, 2 * q))) >= 0 {
            return rn_fail(r, "not_clean", "a program containing this has errors, so its uses are not all known")
        }
    }
    let base = fx_module_base(f, m)
    ints_push(r.decl, m)
    ints_push(r.decl, ds - base)
    ints_push(r.decl, fx_ref_decl_end(f, e) - base)
    strs_set(r.old, 0, str_slice(fx_module_text(f, m), ds - base, fx_ref_decl_end(f, e) - base))
    r
}

// `text` with the edits `from..from+n` of (`starts`, `ends`) replaced by `new_name`.
fn apply_edits(text: Str, starts: Ints, ends: Ints, from: Int, n: Int, new_name: Str) -> Str {
    let parts = strs_new()
    let mut at = 0
    for k in 0..n {
        strs_push(parts, str_slice(text, at, ints_get(starts, from + k)))
        strs_push(parts, new_name)
        at = ints_get(ends, from + k)
    }
    strs_push(parts, str_slice(text, at, str_len(text)))
    str_join(parts, "")
}

// The open buffers with the files of (`ids`, `texts`) in their places: the paths and the texts, in the order `fx_check_over` takes them.
fn overlay(io: IoCap, d: Docs, ids: Strs, texts: Strs, out_paths: Strs, out_texts: Strs) -> Int {
    for i in 0..strs_len(d.paths) {
        strs_push(out_paths, strs_get(d.paths, i))
        strs_push(out_texts, strs_get(d.texts, i))
    }
    for k in 0..strs_len(ids) {
        let at = open_as(io, d, strs_get(ids, k))
        if at >= 0 { strs_set(out_texts, at, strs_get(texts, k)) } else {
            strs_push(out_paths, strs_get(ids, k))
            strs_push(out_texts, strs_get(texts, k))
        }
    }
    0
}

// The analysis of the compilation rooted at `path` over the buffers (`fx_check_over`), a refusal where the reference's would be one this port cannot read.
fn analyse_over(io: IoCap, d: Docs, r: Rn, path: Str, ps: Strs, ts: Strs) -> Facts {
    let g = fx_check_over(path, strs_get(d.root, 0), ps, ts, strs_get(d.library, 0), fe_host_os(), fe_host_arch(), io)
    if fx_refusal(g) != "" { rn_unsure(r, "a source root the reference refuses") }
    if fe_load_failed(g) { rn_unsure(r, "a candidate program that does not load") }
    if !fx_carried(g) { rn_unsure(r, fx_why(g)) }
    g
}

// The rename of the entity at `st..en` of document `k` to `new_name`: the files and edits, or the refusal.
pub fn rn_plan(io: IoCap, d: Docs, k: Int, st: Int, en: Int, new_name: Str) -> Rn {
    let r = rn_renameable(io, d, k, st, en)
    if rn_code(r) != "" || rn_why(r) != "" { return r }
    let bad = invalid_name(new_name)
    if bad != "" { return rn_fail(r, "invalid_name", "the new name " + bad) }
    let old = rn_old(r)
    if new_name == old { return rn_fail(r, "unchanged", "the new name is the current one") }
    let f = vec_get(d.facts, k)
    let e = entity_at(f, st, en)
    let m = rn_decl_module(r)
    let ds = rn_decl_start(r)
    let de = rn_decl_end(r)
    if exported(f, fx_ref_kind(f, e), fx_module_base(f, m) + ds) { return workspace_plan(io, d, k, r, f, m, ds, de, old, new_name, workspace_root(io, d, k)) }
    single_plan(io, d, r, f, e, m, ds, de, old, new_name)
}

// The plan renaming the entity `e` of `f`, declared in module `m` at `ds..de` (local), a private one: its declaration and uses, all in the declaring file, validated against every open
// compilation that contains it (`rename`, `validate`).
fn single_plan(io: IoCap, d: Docs, r: Rn, f: Facts, e: Int, m: Int, ds: Int, de: Int, old: Str, new_name: Str) -> Rn {
    let text = fx_module_text(f, m)
    let base = fx_module_base(f, m)
    let starts = ints_new()
    let ends = ints_new()
    ints_push(starts, ds)
    ints_push(ends, de)
    for k in 0..fx_ref_use_count(f, e) {
        let a = fx_ref_use_start(f, e, k)
        if fx_module_at(f, a) != m { return rn_fail(r, "internal", "refused: a use outside the declaring file") }
        let mut at = ints_len(starts)
        while at > 0 && (ints_get(starts, at - 1) > a - base || (ints_get(starts, at - 1) == a - base && ints_get(ends, at - 1) > fx_ref_use_end(f, e, k) - base)) { at -= 1 }
        ints_push(starts, 0)
        ints_push(ends, 0)
        let mut q = ints_len(starts) - 1
        while q > at {
            ints_set(starts, q, ints_get(starts, q - 1))
            ints_set(ends, q, ints_get(ends, q - 1))
            q -= 1
        }
        ints_set(starts, at, a - base)
        ints_set(ends, at, fx_ref_use_end(f, e, k) - base)
    }
    // Written under a name a re-export gave it, an occurrence keeps its spelling.
    for k in 0..ints_len(starts) {
        if str_slice(text, ints_get(starts, k), ints_get(ends, k)) != old { continue }
        if ints_len(r.ends) > 0 && ints_get(r.ends, ints_len(r.ends) - 1) > ints_get(starts, k) { return rn_fail(r, "internal", "refused: two occurrences overlap") }
        ints_push(r.starts, ints_get(starts, k))
        ints_push(r.ends, ints_get(ends, k))
    }
    let key = module_identity(io, fx_module_name(f, m))
    let edited = apply_edits(text, r.starts, r.ends, 0, ints_len(r.starts), new_name)
    // The candidate program, for every open compilation that contains the file: clean, and the same partition.
    let held = containing(io, d, key, text)
    let ids = strs_new()
    let etexts = strs_new()
    strs_push(ids, key)
    strs_push(etexts, edited)
    let ps = strs_new()
    let ts = strs_new()
    overlay(io, d, ids, etexts, ps, ts)
    let e_id = strs_new()
    let e_len = ints_new()
    for k in 0..ints_len(r.starts) {
        strs_push(e_id, key)
        ints_push(e_len, str_len(new_name))
    }
    let mut validated = 0
    for q in 0..ints_len(held) / 2 {
        let dk = ints_get(held, 2 * q)
        let g = analyse_over(io, d, r, strs_get(d.paths, dk), ps, ts)
        if rn_why(r) != "" { return r }
        if first_error(g) >= 0 { return rn_fail(r, "rejected", "the renamed program would not check: " + strs_get(fx_diags(g).message, first_error(g))) }
        let before = part_of(io, vec_get(d.facts, dk))
        let after = part_of(io, g)
        if !same_strs(part_groups(before, e_id, r.starts, r.ends, e_len), part_groups(after, strs_new(), ints_new(), ints_new(), ints_new())) {
            return rn_fail(r, "meaning_changed", "the renamed program would mean something else: a use would refer to a different definition")
        }
        validated += 1
    }
    if validated == 0 { return rn_fail(r, "internal", "refused: no compilation contains the edited file") }
    strs_push(r.paths, pk_normalise(fx_module_name(f, m)))
    strs_push(r.texts, text)
    ints_push(r.versions, open_version(io, d, key))
    ints_push(r.first, 0)
    ints_push(r.count, ints_len(r.starts))
    r
}

fn split_ids(joined: Str) -> Strs {
    let out = strs_new()
    let mut from = 0
    for i in 0..str_len(joined) + 1 {
        if i == str_len(joined) || str_byte(joined, i) == 1 {
            strs_push(out, str_slice(joined, from, i))
            from = i + 1
        }
    }
    out
}

// The plan renaming an exported entity across a workspace (`workspace_plan`): found in every compilation by its declaration's place, its occurrences across every file merged,
// the candidate workspace analysed again and required to mean what it meant.
fn workspace_plan(io: IoCap, d: Docs, k: Int, p: Rn, f: Facts, m: Int, ds: Int, de: Int, old: Str, new_name: Str, root: Str) -> Rn {
    if fe_starts(fx_module_name(f, m), "@") { return rn_fail_all(p, "this is the core prelude's, which the toolchain owns") }
    let key = module_identity(io, fx_module_name(f, m))
    let within = key == root || fe_starts(key, root + "/") || (root == "/" && fe_starts(key, "/"))
    let id_root = identity_of(io, root)
    if !within && !(key == id_root || fe_starts(key, id_root + "/")) {
        return rn_fail_all(p, "this is exported, and a module no open program loads may use it, so every occurrence cannot be known; declare a workspace (a `nazm.root` marker or `--source-root`) and every module under it is searched")
    }
    let files = strs_new()
    walk_workspace(io, root, files)
    let sorted = fe_sort_paths(files)
    let given = strs_get(d.root, 0)
    // Each compilation of the workspace, as a root over the open buffers: what files it holds, and how its occurrences group.
    let held = strs_new()
    let parts: Vec[Part] = vec_new()
    let per_ids = strs_new()
    let per_texts = strs_new()
    let per_ss: Vec[Ints] = vec_new()
    let per_es: Vec[Ints] = vec_new()
    let mut holding = 0
    let ps = strs_new()
    let ts = strs_new()
    overlay(io, d, strs_new(), strs_new(), ps, ts)
    let involved = ints_new()
    let mut compiled = 0
    for i in 0..strs_len(sorted) {
        let g = fx_check_over(strs_get(sorted, i), given, ps, ts, strs_get(d.library, 0), fe_host_os(), fe_host_arch(), io)
        compiled += 1
        // A root the reference cannot analyse is the one this port cannot either.
        if fx_refusal(g) != "" { return rn_unsure(p, "a source root the reference refuses") }
        if fe_load_failed(g) { return rn_unsure(p, "a workspace file that does not load") }
        if !fx_carried(g) { return rn_unsure(p, fx_why(g)) }
        let ids = module_ids(io, g)
        vec_push(parts, part_of(io, g))
        strs_push(held, str_join(ids, str_from_byte(1)))
        let mut at = 0 - 1
        for q in 0..strs_len(ids) {
            if at < 0 && strs_get(ids, q) == key { at = q }
        }
        if at < 0 { continue }
        if first_error(g) >= 0 { return rn_fail_all(p, "a program containing this has errors, so its uses are not all known") }
        let abs_s = fx_module_base(g, at) + ds
        let abs_e = fx_module_base(g, at) + de
        let ge = entity_at(g, abs_s, abs_e)
        if ge < 0 { return rn_fail_all(p, "refused: the declaration is no entity in a compilation that contains it") }
        holding += 1
        // The declaration, then the uses.
        for u in 0..fx_ref_use_count(g, ge) + 1 {
            let a = if u == 0 { fx_ref_decl_start(g, ge) } else { fx_ref_use_start(g, ge, u - 1) }
            let b = if u == 0 { fx_ref_decl_end(g, ge) } else { fx_ref_use_end(g, ge, u - 1) }
            if a < 0 { continue }
            let um = fx_module_at(g, a)
            if fe_starts(fx_module_name(g, um), "@") { return rn_fail_all(p, "this is the core prelude's, which the toolchain owns") }
            let uid = strs_get(ids, um)
            let mut slot = 0 - 1
            for z in 0..strs_len(per_ids) {
                if strs_get(per_ids, z) == uid { slot = z }
            }
            if slot < 0 {
                strs_push(per_ids, uid)
                strs_push(per_texts, fx_module_text(g, um))
                vec_push(per_ss, ints_new())
                vec_push(per_es, ints_new())
                slot = strs_len(per_ids) - 1
            }
            if strs_get(per_texts, slot) != fx_module_text(g, um) { return rn_fail_all(p, "the document is not at the version asked about") }
            let st = vec_get(per_ss, slot)
            let en = vec_get(per_es, slot)
            let ls = a - fx_module_base(g, um)
            let le = b - fx_module_base(g, um)
            let mut dup = false
            for z in 0..ints_len(st) {
                if ints_get(st, z) == ls && ints_get(en, z) == le { dup = true }
            }
            if !dup {
                // A set kept in order.
                let mut pos = ints_len(st)
                while pos > 0 && (ints_get(st, pos - 1) > ls || (ints_get(st, pos - 1) == ls && ints_get(en, pos - 1) > le)) { pos -= 1 }
                ints_push(st, 0)
                ints_push(en, 0)
                let mut w = ints_len(st) - 1
                while w > pos {
                    ints_set(st, w, ints_get(st, w - 1))
                    ints_set(en, w, ints_get(en, w - 1))
                    w -= 1
                }
                ints_set(st, pos, ls)
                ints_set(en, pos, le)
            }
        }
    }
    if holding == 0 { return rn_fail_all(p, "refused: no compilation of the workspace contains it") }
    // The files in path order, each with its edits.
    let order = ints_new()
    for z in 0..strs_len(per_ids) {
        let mut at = ints_len(order)
        while at > 0 && fe_path_before(strs_get(per_ids, z), strs_get(per_ids, ints_get(order, at - 1))) { at -= 1 }
        ints_push(order, 0)
        let mut w = ints_len(order) - 1
        while w > at {
            ints_set(order, w, ints_get(order, w - 1))
            w -= 1
        }
        ints_set(order, at, z)
    }
    let many_ids = strs_new()
    let many_texts = strs_new()
    let e_id = strs_new()
    let e_start = ints_new()
    let e_end = ints_new()
    let e_len = ints_new()
    for r in 0..ints_len(order) {
        let z = ints_get(order, r)
        let text = strs_get(per_texts, z)
        let st = vec_get(per_ss, z)
        let en = vec_get(per_es, z)
        let first = ints_len(p.starts)
        for k in 0..ints_len(st) {
            if str_slice(text, ints_get(st, k), ints_get(en, k)) != old { continue }
            if ints_len(p.ends) > first && ints_get(p.ends, ints_len(p.ends) - 1) > ints_get(st, k) { return rn_fail_all(p, "refused: two occurrences overlap") }
            ints_push(p.starts, ints_get(st, k))
            ints_push(p.ends, ints_get(en, k))
        }
        // A file whose every occurrence is written under a re-export's alias has nothing to change, and is no part of the plan.
        if ints_len(p.starts) == first { continue }
        let n = ints_len(p.starts) - first
        strs_push(many_ids, strs_get(per_ids, z))
        strs_push(many_texts, apply_edits(text, p.starts, p.ends, first, n, new_name))
        for k in 0..n {
            strs_push(e_id, strs_get(per_ids, z))
            ints_push(e_start, ints_get(p.starts, first + k))
            ints_push(e_end, ints_get(p.ends, first + k))
            ints_push(e_len, str_len(new_name))
        }
        strs_push(p.paths, strs_get(per_ids, z))
        strs_push(p.texts, text)
        ints_push(p.versions, open_version(io, d, strs_get(per_ids, z)))
        ints_push(p.first, first)
        ints_push(p.count, n)
    }
    // The candidate workspace: every compilation that holds an edited file, clean, with the same partition.
    let aps = strs_new()
    let ats = strs_new()
    overlay(io, d, many_ids, many_texts, aps, ats)
    for i in 0..strs_len(sorted) {
        let ids = split_ids(strs_get(held, i))
        let mut touches = false
        for q in 0..strs_len(ids) {
            for z in 0..strs_len(per_ids) {
                if strs_get(ids, q) == strs_get(per_ids, z) { touches = true }
            }
        }
        if !touches { continue }
        let a = fx_check_over(strs_get(sorted, i), given, aps, ats, strs_get(d.library, 0), fe_host_os(), fe_host_arch(), io)
        if fx_refusal(a) != "" { return rn_unsure(p, "a source root the reference refuses") }
        if fe_load_failed(a) { return rn_unsure(p, "a candidate program that does not load") }
        if !fx_carried(a) { return rn_unsure(p, fx_why(a)) }
        if first_error(a) >= 0 { return rn_fail_all(p, "the renamed program would not check: " + strs_get(fx_diags(a).message, first_error(a))) }
        if !same_strs(part_groups(vec_get(parts, i), e_id, e_start, e_end, e_len), part_groups(part_of(io, a), strs_new(), ints_new(), ints_new(), ints_new())) {
            return rn_fail_all(p, "the renamed program would mean something else: a use would refer to a different definition")
        }
    }
    p
}

// A refusal of the workspace plan: the codes the reference gives each, by the words it uses.
fn rn_fail_all(p: Rn, msg: Str) -> Rn {
    let mut code = "internal"
    if fe_starts(msg, "this is exported") { code = "exported" }
    if fe_starts(msg, "this is the core prelude") { code = "toolchain_owned" }
    if fe_starts(msg, "a program containing this") { code = "not_clean" }
    if fe_starts(msg, "the renamed program would not check") { code = "rejected" }
    if fe_starts(msg, "the renamed program would mean") { code = "meaning_changed" }
    if fe_starts(msg, "the document is not at the version") { code = "not_current" }
    rn_fail(p, code, msg)
}
