struct P { x: Int, y: Int }
fn mk(a: Int) -> P { P(x: a, y: a + 1) }
mk(3).y
pub fn getx(p: P) -> Int { p.x }
getx(mk(9))
enum Shape { Dot, Line(len: Int) }
fn size(s: Shape) -> Int { match s { Shape.Dot => 0, Shape.Line(len: n) => n } }
size(Shape.Line(len: 7))
size(Shape.Dot)
