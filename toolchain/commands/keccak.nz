// Keccak-256 (N70), in Nazm (R8 slice 11): `crates/nazm-service/src/keccak.rs` — the hash `nazm contract --accounts` derives each instruction's
// discriminator from — the original Keccak padding (`0x01`), not SHA-3's (`0x06`).

const KC_ROUNDS: [UInt64; 24] = [
    0x0000_0000_0000_0001, 0x0000_0000_0000_8082, 0x8000_0000_0000_808a, 0x8000_0000_8000_8000,
    0x0000_0000_0000_808b, 0x0000_0000_8000_0001, 0x8000_0000_8000_8081, 0x8000_0000_0000_8009,
    0x0000_0000_0000_008a, 0x0000_0000_0000_0088, 0x0000_0000_8000_8009, 0x0000_0000_8000_000a,
    0x0000_0000_8000_808b, 0x8000_0000_0000_008b, 0x8000_0000_0000_8089, 0x8000_0000_0000_8003,
    0x8000_0000_0000_8002, 0x8000_0000_0000_0080, 0x0000_0000_0000_800a, 0x8000_0000_8000_000a,
    0x8000_0000_8000_8081, 0x8000_0000_0000_8080, 0x0000_0000_8000_0001, 0x8000_0000_8000_8008,
];

const KC_ROTATIONS: [Int; 25] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14];

fn kc_permute(a: Vec[UInt64]) -> Int ! {} {
    let rounds = KC_ROUNDS;
    let rotations = KC_ROTATIONS;
    for round in 0..24 {
        // θ
        let mut c = [UInt64(0); 5];
        for x in 0..5 {
            c[x] = vec_get(a, x) ^ vec_get(a, x + 5) ^ vec_get(a, x + 10) ^ vec_get(a, x + 15) ^ vec_get(a, x + 20);
        }
        for x in 0..5 {
            let d = c[(x + 4) % 5] ^ rotate_left(c[(x + 1) % 5], 1);
            for y in 0..5 {
                vec_set(a, x + 5 * y, vec_get(a, x + 5 * y) ^ d);
            }
        }
        // ρ and π
        let mut b = [UInt64(0); 25];
        for x in 0..5 {
            for y in 0..5 {
                b[y + 5 * ((2 * x + 3 * y) % 5)] = rotate_left(vec_get(a, x + 5 * y), rotations[x + 5 * y]);
            }
        }
        // χ
        for x in 0..5 {
            for y in 0..5 {
                vec_set(a, x + 5 * y, b[x + 5 * y] ^ (~b[(x + 1) % 5 + 5 * y] & b[(x + 2) % 5 + 5 * y]));
            }
        }
        // ι
        vec_set(a, 0, vec_get(a, 0) ^ rounds[round]);
    }
    0
}

/// `keccak256(data)`: its 32 bytes as lowercase hexadecimal.
pub fn keccak256_hex(data: Str) -> Str ! {} {
    let rate = 136;
    let n = str_len(data);
    // The padded message: the data, 0x01, zeros to a multiple of the rate, the last byte or 0x80.
    let total = ((n + 1 + rate - 1) / rate) * rate;
    let padded = bytes_new(total);
    for i in 0..n { bytes_set(padded, i, UInt8(str_byte(data, i))); }
    bytes_set(padded, n, UInt8(1));
    // The last byte is 0 or 1 (the padding's own): or'd with 0x80.
    bytes_set(padded, total - 1, UInt8(Int(bytes_get(padded, total - 1)) + 128));
    let a = vec_new[UInt64]();
    for i in 0..25 { vec_push(a, UInt64(0)); }
    let mut off = 0;
    while off < total {
        for i in 0..17 {
            let mut w = UInt64(0);
            for k in 0..8 {
                w = w | (UInt64(Int(bytes_get(padded, off + 8 * i + k))) << (8 * k));
            }
            vec_set(a, i, vec_get(a, i) ^ w);
        }
        kc_permute(a);
        off += rate;
    }
    let digits = "0123456789abcdef";
    let out = strs_new();
    for i in 0..4 {
        let lane = vec_get(a, i);
        for k in 0..8 {
            let b = Int((lane >> (8 * k)) & UInt64(255));
            strs_push(out, str_slice(digits, b / 16, b / 16 + 1));
            strs_push(out, str_slice(digits, b % 16, b % 16 + 1));
        }
    }
    str_join(out, "")
}
