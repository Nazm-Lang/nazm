fn sender(io: IoCap, go: Chan[Int], c: Chan[Int]) -> Int ! { io } {
let g = vec_new[Int](); let r = chan_recv_of(go, g); chan_send_of(c, 42); 0 }
fn poller(io: IoCap, tm: TimeCap, go: Chan[Int], c: Chan[Int], done: Chan[Int]) -> Int ! { io } {
let cs = vec_new[Chan[Int]](); vec_push(cs, c); let out = vec_new[Int]();
chan_send_of(go, 1);
let mut spins = 0;
while chan_select_until(cs, out, 0) == 0 - 2 { spins = spins + 1; }
chan_send_of(done, vec_pop(out)); 0 }
fn main(io: IoCap, t: SpawnCap, tm: TimeCap) -> Int ! { io, spawn } {
let go = chan_new_of[Int](1); let c = chan_new_of[Int](1); let done = chan_new_of[Int](1); let got = vec_new[Int]();
scope { spawn poller(io, tm, go, c, done); spawn sender(io, go, c); let r = chan_recv_of(done, got); }
print(int_to_str(vec_get(got, 0))); 0 }
