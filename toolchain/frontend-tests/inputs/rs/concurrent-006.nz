
        fn add(out: Chan, n: Int) -> Int { chan_send(out, n); 0 }
        fn main(tasks: SpawnCap) -> Int {
            let inner = chan_new(4);
            let outer = chan_new(4);
            scope {
                scope {
                    spawn add(inner, 10);
                    spawn add(inner, 20);
                }
                chan_close(inner);
                let buf = ints_new();
                let mut stage = 0;
                while chan_recv(inner, buf) { stage = stage + ints_pop(buf); }
                spawn add(outer, stage);
            }
            chan_close(outer);
            let buf = ints_new();
            chan_recv(outer, buf);
            ints_pop(buf)
        }
        