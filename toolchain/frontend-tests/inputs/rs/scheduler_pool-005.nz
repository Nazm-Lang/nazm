fn leaf(c: Chan, v: Int) -> Int { chan_send(c, v); 0 }
fn branch(t: SpawnCap, c: Chan, v: Int) -> Int ! { spawn } { scope { spawn leaf(c, v); spawn leaf(c, v + 1); } 0 }
fn waiter(gate: Chan, started: Atomic) -> Int { atomic_add(started, 1); let buf = ints_new(); if chan_recv(gate, buf) { 1 } else { 0 } }
fn main(io: IoCap, tasks: SpawnCap, clock: TimeCap) {
let c = chan_new(64); let gate = chan_new(1); let started = atomic_new(0); let mut sum = 0;
scope { let mut i = 0; while i < 5000 { spawn waiter(gate, started); i += 1; }
let mut j = 0; while j < 500 { spawn branch(tasks, c, j); j += 1; }
let buf = ints_new(); let mut k = 0; while k < 1000 { if chan_recv(c, buf) { sum += ints_pop(buf); } k += 1; }
while atomic_load(started) < 5000 { time_sleep_ms(1); }
chan_close(gate); }
println(sum); println(atomic_load(started)) }
