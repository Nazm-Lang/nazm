fn pick(a: Str, b: Int) -> Int { str_len(a) + b }
fn main() -> Int {
    let mut i = 0;
    let mut total = 0;
    while i < 5 {
        i = i + 1;
        if i < 3 {
            total = total + pick(int_to_str(i), if i == 1 { continue; } else { break; });
        }
        total = total + 100;
    }
    total + i
}
