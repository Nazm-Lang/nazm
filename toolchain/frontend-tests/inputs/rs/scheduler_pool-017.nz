fn taker(io: IoCap, c: Chan, out: Chan, want: Int) -> Int ! { io } {
let got = ints_new();
if chan_recv(c, got) { let r = chan_send(out, if ints_pop(got) == want { 1 } else { 0 }); }
0 }
fn giver(io: IoCap, c: Chan) -> Int ! { io } {
let mut i = 1; while i < 4 { let s = chan_send(c, i); i = i + 1; } 0 }
fn main(io: IoCap, t: SpawnCap) -> Int ! { io, spawn } {
let c = chan_new(1); let out = chan_new(8);
scope {
let mut i = 1;
while i < 4 { spawn taker(io, c, out, i); i = i + 1; }
spawn giver(io, c);
}
let got = ints_new(); let mut k = 0; let mut s = 0;
while k < 3 { if chan_recv(out, got) { s = s + ints_pop(got); } k = k + 1; }
print(int_to_str(s)); 0 }
