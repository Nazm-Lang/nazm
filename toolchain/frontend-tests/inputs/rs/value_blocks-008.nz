fn worker(out: Chan, tag: Str) -> Int {
    let mut i = 0;
    let mut s = 0;
    while i < 200000 { s = s + i % 3; i = i + 1; }
    chan_send(out, str_len(tag));
    s
}
fn g(ok: Bool) -> Result[Int, Str] {
    if ok { return Result[Int, Str].Ok(value: 41); }
    Result[Int, Str].Err(error: int_to_str(404))
}
enum State {
    A,
    B,
}
fn f(s: State, ok: Bool, out: Chan, tasks: SpawnCap) -> Result[Int, Str] {
    let x = match s {
        State.A() => {
            let held = str_concat("held-", int_to_str(1));
            let mut n = 0;
            scope {
                spawn worker(out, held);
                let inner = int_to_str(99);
                n = g(ok)? + str_len(inner);
            }
            n + str_len(held)
        },
        State.B() => {
            0
        },
    };
    Result[Int, Str].Ok(value: x)
}
fn main(tasks: SpawnCap) -> Int {
    let out = chan_new(8);
    let a = f(State.A(), true, out, tasks);
    let b = f(State.A(), false, out, tasks);
    let c = f(State.B(), false, out, tasks);
    chan_close(out);
    let buf = ints_new();
    let got = chan_recv(out, buf);
    let more = chan_recv(out, buf);
    let rest = chan_recv(out, buf);
    churn();
    let va = match a { Result.Ok(value: v) => v, Result.Err(error: e) => 0 - 1, };
    let vb = match b { Result.Ok(value: v) => v, Result.Err(error: e) => str_len(e), };
    let vc = match c { Result.Ok(value: v) => v, Result.Err(error: e) => 0 - 1, };
    va * 10000 + vb * 1000 + vc * 100 + ints_len(buf) * 10 + ints_get(buf, 0)
}
