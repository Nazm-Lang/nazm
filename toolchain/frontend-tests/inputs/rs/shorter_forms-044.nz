enum Shape {
    Circle(r: Int),
    Rect(w: Int, h: Int),
    Dot,
}

fn area(s: Shape): Int {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w
            * h
        Dot => 0
    }
}

fn name(n: Int): Str {
    match n {
        0 => "zero",
        1 => "one"
        n if n < 0 => {
            "negative"
        }
        (_) => "many"
    }
}

fn main() {
    println(f"{area(Circle(2))} {area(Rect(3, 4))} {area(Dot)}")
    println(f"{name(0)} {name(1)} {name(-5)} {name(9)}")
}
