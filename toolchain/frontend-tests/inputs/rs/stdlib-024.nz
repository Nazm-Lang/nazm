use "@std/chan";
use "@std/option";
fn produce(c: Chan, n: Int) -> Int { let mut i = 1; while i <= n { chan_send(c, i); i = i + 1; } chan_close(c); 0 }
fn main(t: SpawnCap) -> Int { let c = chan_new(2); let mut total = 0; let mut more = true;
scope { spawn produce(c, 100); while more { match chan_take(c) { Option.Some(value: v) => { total = total + v; }, Option.None() => { more = false; } } } }
total }
