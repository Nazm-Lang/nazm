fn waiter(io: IoCap, tm: TimeCap, c: Chan[Int], res: Chan[Int]) -> Int ! { io } {
let cs = vec_new[Chan[Int]](); vec_push(cs, c); let out = vec_new[Int]();
chan_send_of(res, chan_select_until(cs, out, 30)); 0 }
fn main(io: IoCap, t: SpawnCap, tm: TimeCap) -> Int ! { io, spawn } {
let c = chan_new_of[Int](1); let res = chan_new_of[Int](1); let got = vec_new[Int]();
let before = time_now_ms();
scope { spawn waiter(io, tm, c, res); let r = chan_recv_of(res, got); }
let waited = time_now_ms() - before;
print(int_to_str(vec_get(got, 0))); print(if waited >= 30 { " waited" } else { " early" }); 0 }
