use "b.nz";
fn score(n: Int) -> Int {
    let base = match token(n) {
        Token.Word(text: s) => {
            let w = s;
            str_len(w)
        },
        Token.End() => {
            return 0;
        },
    };
    base + match find(n) {
        Option.None() => {
            0
        },
        Option.Some(value: f) => {
            let g = f;
            str_len(g)
        },
    }
}
fn main() -> Int { score(3) }
