enum E {
    Absent,
    Text(value: Str),
}
fn main() -> Int {
    let mut i = 0;
    let mut total = 0;
    while i < 3 {
        i = i + 1;
        total = total + match E.Text(value: int_to_str(i)) {
            E.Absent() => 0,
            E.Text(value: s) => if i == 1 { continue; } else { str_len(s) },
        };
    }
    total
}
