use "@std/ioerror";
use "@std/process";
fn line(out: OutCap, s: Str) -> Int { print(str_concat(s, "\n")) }
fn args(a: Str, b: Str) -> Strs { let x = strs_new(); strs_push(x, a); strs_push(x, b); x }
fn run(p: ProcessCap, s: SpawnCap, out: OutCap, script: Str, input: Str) -> Int ! { io, spawn } {
match process_run(p, s, "sh", args("-c", script), bytes_from_str(input)) {
Result.Ok(value: r) => {
line(out, int_to_str(r.status));
line(out, if str_len(r.stdout) > 40 { int_to_str(str_len(r.stdout)) } else { r.stdout });
line(out, if str_len(r.stderr) > 40 { int_to_str(str_len(r.stderr)) } else { r.stderr });
},
Result.Err(error: e) => { line(out, io_kind_name(e.kind)); },
};
0
}
fn main(p: ProcessCap, s: SpawnCap, out: OutCap) -> Int {
run(p, s, out, "cat; echo oops >&2; exit 3", "hello child|");
run(p, s, out, "head -c 300000 /dev/zero; head -c 200000 /dev/zero >&2", "");
run(p, s, out, "kill -9 $$", "");
match process_spawn(p, "no-such-program-nazm", strs_new()) {
Result.Ok(value: c) => { line(out, "started"); },
Result.Err(error: e) => { line(out, io_kind_name(e.kind)); },
};
0
}
