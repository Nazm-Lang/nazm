fn worker(io: IoCap, c: Chan, n: Int) -> Int ! { io } { chan_send(c, n * n); 0 }
fn main(io: IoCap, t: SpawnCap) -> Int ! { io, spawn } {
let c = chan_new(2); let got = ints_new();
scope { let mut i = 0; while i < 50 { spawn worker(io, c, i); i = i + 1; }
let mut k = 0; while k < 50 { let r = chan_recv(c, got); k = k + 1; } }
let mut s = 0; let mut j = 0; while j < 50 { s = s + ints_get(got, j); j = j + 1; }
print(int_to_str(s)); 0 }
