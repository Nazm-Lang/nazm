fn produce(c: Chan, n: Int) -> Int { let mut i = 0; while i < n { chan_send(c, i); i = i + 1; } 0 }
fn main(t: SpawnCap) -> Int { let c = chan_new(1024); let buf = ints_new(); let n = 1000000;
scope { spawn produce(c, n); let mut i = 0; while i < n { chan_recv(c, buf); i = i + 1; } } ints_len(buf) }
