pub struct ParseError {
    at: Int,
}
fn digit(s: Str, i: Int) -> Result[Int, ParseError] {
    let d = str_byte(s, i) - 48;
    if d < 0 { return Result[Int, ParseError].Err(error: ParseError(at: i)); }
    if d > 9 { return Result[Int, ParseError].Err(error: ParseError(at: i)); }
    Result[Int, ParseError].Ok(value: d)
}
pub fn parse(s: Str) -> Result[Int, ParseError] {
    let mut i = 0;
    let mut n = 0;
    while i < str_len(s) {
        let d = match digit(s, i) {
            Result.Ok(value: d) => d,
            Result.Err(error: e) => if true { return Result[Int, ParseError].Err(error: e); } else { return Result[Int, ParseError].Err(error: e); },
        };
        n = n * 10 + d;
        i = i + 1;
    }
    Result[Int, ParseError].Ok(value: n)
}
