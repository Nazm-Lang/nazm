
        fn slow(out: Chan, n: Int) -> Int {
            let mut i = 0;
            while i < 3000000 { i = i + 1; }
            chan_send(out, n);
            0
        }
        fn main(tasks: SpawnCap) -> Int {
            let out = chan_new(16);
            let mut round = 0;
            while round < 3 {
                scope {
                    spawn slow(out, 1);
                    spawn slow(out, 1);
                    if round == 1 { break; }
                }
                round = round + 1;
            }
            chan_close(out);
            let buf = ints_new();
            let mut total = 0;
            while chan_recv(out, buf) { total = total + ints_pop(buf); }
            total
        }
        