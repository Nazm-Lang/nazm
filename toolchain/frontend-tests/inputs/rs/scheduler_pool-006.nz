fn spin(stop: Atomic) -> Int { let mut x = 0; while atomic_load(stop) == 0 { x = (x + 1) % 1000; } x }
fn short(stop: Atomic, done: Atomic) -> Int { atomic_add(done, 1); if atomic_load(done) == 4 { atomic_store(stop, 1); } 0 }
fn main(io: IoCap, tasks: SpawnCap) {
let stop = atomic_new(0); let done = atomic_new(0);
scope { spawn spin(stop); spawn spin(stop); spawn short(stop, done); spawn short(stop, done); spawn short(stop, done); spawn short(stop, done); }
println(atomic_load(done)) }
