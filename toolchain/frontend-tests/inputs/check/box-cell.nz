// `Box`, `Chain` and `Cell` (R1a, R1b) and the layouts they make, as the checker refuses them.
enum Tree { Leaf, Node(left: Box[Tree], right: Box[Tree]), }
struct Loop { next: Cell[Option[Loop]], }
struct Pair[T] { a: T, b: Box[T], }
struct Owns { p: Pair[Owns], }
struct D0 { x: D1, }
struct D1 { x: D2, }
struct D2 { x: D3, }
struct D3 { x: D4, }
struct D4 { x: D5, }
struct D5 { x: D6, }
