fn work(b: Box[Int]) -> Int { box_get(b) }
fn bare(b: Box) -> Int { 0 }

fn main(s: SpawnCap) -> Int ! {spawn} {
    let a = box_new(1);
    let b = box_new(1);
    let same = a == b;
    let less = a < b;
    let c = cell_new("x");
    cell_set(c, 2);
    let k = chain_from_vec(vec_new[Int]());
    let n = k.len() + a.get();
    let mut f = cell_new(fn(x: Int) -> Int { x });
    let g = fn() -> Int { 0 };
    scope { spawn work(a); }
    0
}
