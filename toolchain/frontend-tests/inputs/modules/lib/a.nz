pub fn shared(x: Int) -> Int { x + 1 }
pub fn only_a() -> Int { 1 }
fn hidden() -> Int { 2 }
pub struct Point { x: Int, y: Int }
pub enum Shape { Dot, Circle(r: Int) }
struct Secret { n: Int }
pub fn noisy() -> Int {
    print("a");
    0
}
pub fn quiet() -> Int ! {} { 3 }
pub fn first[T](xs: Vec[T]) -> Option[T] {
    if vec_len(xs) == 0 { return None; }
    Some(vec_get(xs, 0))
}
