/// `pattern text want` triples.
fn captures_table() -> Strs ! {} {
    let t = strs_new();
    strs_push(t, "(a)(b)?");
    strs_push(t, "a");
    strs_push(t, "(0,1)(0,1)-");
    strs_push(t, "(a|ab)(c|bcd)(d*)");
    strs_push(t, "abcd");
    strs_push(t, "(0,4)(0,1)(1,4)(4,4)");
    strs_push(t, "(\\w+)@(\\w+)\\.com");
    strs_push(t, "mail bob@example.com now");
    strs_push(t, "(5,20)(5,8)(9,16)");
    strs_push(t, "(?:(a)|b)+");
    strs_push(t, "ab");
    strs_push(t, "(0,2)(0,1)");
    strs_push(t, "(?<y>\\d{4})-(?P<m>\\d{2})");
    strs_push(t, "on 2026-10 ok");
    strs_push(t, "(3,10)(3,7)(8,10)");
    strs_push(t, "(a*)+");
    strs_push(t, "b");
    strs_push(t, "(0,0)(0,0)");
    strs_push(t, "(?:x)(y)");
    strs_push(t, "zxy");
    strs_push(t, "(1,3)(2,3)");
    strs_push(t, "(é)(.)");
    strs_push(t, "aéb");
    strs_push(t, "(1,4)(1,3)(3,4)");
    strs_push(t, "x(y)");
    strs_push(t, "abc");
    strs_push(t, "no match");
    t
}

/// `pattern message` pairs.
fn malformed_table() -> Strs ! {} {
    let t = strs_new();
    strs_push(t, "(ab");
    strs_push(t, "an unclosed group at byte 0");
    strs_push(t, "ab)");
    strs_push(t, "an unmatched `)` at byte 2");
    strs_push(t, "x[ab");
    strs_push(t, "an unclosed class at byte 1");
    strs_push(t, "a{2,1}");
    strs_push(t, "a counted repetition whose most is below its least at byte 1");
    strs_push(t, "a{");
    strs_push(t, "a counted repetition needs a count at byte 1");
    strs_push(t, "a{2");
    strs_push(t, "an unclosed counted repetition at byte 1");
    strs_push(t, "*a");
    strs_push(t, "a repetition with nothing to repeat at byte 0");
    strs_push(t, "a|+");
    strs_push(t, "a repetition with nothing to repeat at byte 2");
    strs_push(t, "a**");
    strs_push(t, "a repetition of a repetition at byte 2");
    strs_push(t, "(a)\\1");
    strs_push(t, "backreferences are not supported at byte 3");
    strs_push(t, "(?<=a)b");
    strs_push(t, "lookbehind is not supported at byte 0");
    strs_push(t, "(?=ab)");
    strs_push(t, "a lookahead holds one character or class at byte 0");
    strs_push(t, "\\p{Greek}");
    strs_push(t, "an unknown Unicode class `Greek` at byte 0");
    strs_push(t, "[z-a]");
    strs_push(t, "a range whose end is before its start at byte 1");
    strs_push(t, "[\\w-z]");
    strs_push(t, "a class cannot begin a range at byte 3");
    strs_push(t, "[a-\\d]");
    strs_push(t, "a class cannot end a range at byte 3");
    strs_push(t, "a\\q");
    strs_push(t, "an unknown escape `\\q` at byte 1");
    strs_push(t, "(?x)a");
    strs_push(t, "an unknown group flag at byte 2");
    strs_push(t, "a\\");
    strs_push(t, "a `\\` at the end of the pattern at byte 1");
    strs_push(t, "[[:alpha:]]");
    strs_push(t, "POSIX classes are not supported at byte 1");
    strs_push(t, "[a[b]]");
    strs_push(t, "a `[` inside a class must be escaped at byte 2");
    strs_push(t, "[a&&b]");
    strs_push(t, "class set operations are not supported at byte 2");
    strs_push(t, "\\x{110000}");
    strs_push(t, "an escape that is not a Unicode scalar value at byte 0");
    strs_push(t, "\\xZ1");
    strs_push(t, "an escape needs 2 hex digits at byte 0");
    strs_push(t, "(a{1000}){1000}");
    strs_push(t, "a repetition too large once written out at byte 9");
    strs_push(t, "(?P<>a)");
    strs_push(t, "a group name is letters, digits and `_`, then `>` at byte 0");
    t
}

/// `s` as a Nazm string literal.
fn lit(s: Str) -> Str ! {} {
    let out = strs_new();
    strs_push(out, "\"");
    let mut run_from = 0;
    let mut i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        let esc = if b == 92 { "\\\\" } else { if b == 34 { "\\\"" } else { if b == 10 { "\\n" } else { if b == 9 { "\\t" } else { if b < 32 || b == 127 { f"\\x{hex2(b)}" } else { "" } } } } };
        if esc != "" {
            strs_push(out, str_slice(s, run_from, i));
            strs_push(out, esc);
            run_from = i + 1;
        }
        i = i + 1;
    }
    strs_push(out, str_slice(s, run_from, str_len(s)));
    strs_push(out, "\"");
    str_join(out, "")
}

fn hex2(b: Int) -> Str ! {} {
    let digits = "0123456789ABCDEF";
    f"{str_slice(digits, b / 16, b / 16 + 1)}{str_slice(digits, b % 16, b % 16 + 1)}"
}

/// A program printing `f(pattern, text)` for each pair of `cases`, a line each.
fn program(f: Str, cases: Strs) -> Str ! {} {
    let parts = strs_new();
    strs_push(parts, HEAD);
    strs_push(parts, "fn main(io: IoCap) -> Int ! {io} {\n");
    let mut i = 0;
    while i + 1 < strs_len(cases) {
        strs_push(parts, f"    print(str_concat({f}({lit(strs_get(cases, i))}, {lit(strs_get(cases, i + 1))}), \"\\n\"));\n");
        i = i + 2;
    }
    strs_push(parts, "    0\n}\n");
    str_join(parts, "")
}

/// Each case's line, under the interpreter.
fn lines_of(h: Caps, f: Str, cases: Strs) -> Result[Strs, Str] ! { io, spawn } {
    let d = prog_dir(h, "prog.nz", program(f, cases))?;
    let r = nazm(h, d, words("run --interpret prog.nz"));
    scratch_remove(h, d);
    check_that(r.code == 0, ran_show(r))?;
    Result[Strs, Str].Ok(value: text_lines(r.stdout))
}

/// `f` over each `pattern text want` triple of `table`: every line the one wanted.
fn check_table(h: Caps, f: Str, table: Strs) -> Result[Int, Str] ! { io, spawn } {
    let cases = strs_new();
    let mut i = 0;
    while i + 2 < strs_len(table) {
        strs_push(cases, strs_get(table, i));
        strs_push(cases, strs_get(table, i + 1));
        i = i + 3;
    }
    let got = lines_of(h, f, cases)?;
    let mut k = 0;
    while k * 3 + 2 < strs_len(table) {
        let line = if k < strs_len(got) { strs_get(got, k) } else { "<none>" };
        check_that(line == strs_get(table, k * 3 + 2), f"{lit(strs_get(table, k * 3))} on {lit(strs_get(table, k * 3 + 1))}: {line}")?;
        k = k + 1;
    }
    ok()
}

@test
fn every_pattern_finds_its_leftmost_first_matches(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    check_table(h, "all", leftmost_first_table())
}

@test
fn capture_groups_report_what_each_matched(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    check_table(h, "groups", captures_table())
}

@test
fn every_malformed_pattern_is_refused_with_its_offset(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let table = malformed_table();
    let cases = strs_new();
    let mut i = 0;
    while i + 1 < strs_len(table) {
        strs_push(cases, strs_get(table, i));
        strs_push(cases, "");
        i = i + 2;
    }
    let got = lines_of(h, "all", cases)?;
    let mut k = 0;
    while k * 2 + 1 < strs_len(table) {
        let line = if k < strs_len(got) { strs_get(got, k) } else { "<none>" };
        check_that(line == f"error: {strs_get(table, k * 2 + 1)}", f"{lit(strs_get(table, k * 2))}: {line}")?;
        k = k + 1;
    }
    ok()
}

fn pathological_want(n: Int) -> Str ! {} {
    f"(a*)*b: false none\n(a|aa)*c: false none\n(a+a+)+b: false none\n(a?){{40}}a{{40}}b: false none\n(?:a*)*$x: false none\n1 0 {n + 1}\n0\n"
}

/// What a backtracking matcher takes 2^40 steps or more for, on texts of 40 `a`s and of 200,000.
@test
fn pathological_patterns_take_linear_time(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", PATHOLOGICAL)?;
    let tc = h.t;
    let started = time_ms(tc);
    let r = nazm(h, d, words("run --interpret prog.nz"));
    let took = time_ms(tc) - started;
    check_that(r.code == 0, ran_show(r))?;
    check_that(r.stdout == pathological_want(40), r.stdout)?;
    check_that(took < 30000, f"{took} ms")?;
    // 200,000 `a`s, compiled.
    scratch_write(h, d, "prog.nz", text_replace(PATHOLOGICAL, "let n = 40;", "let n = 200000;"))?;
    let b = nazm(h, d, words(f"build --no-cache --backend llvm --opt-level 2 prog.nz -o {d}/long"));
    check_that(b.code == 0, b.stderr)?;
    let a = strs_new();
    strs_push(a, "-c");
    strs_push(a, bounded_script());
    strs_push(a, f"{d}/long");
    let x = run_within(h, "sh", a, d, suite_env(h), 30000);
    scratch_remove(h, d);
    check_that(x.code == 0, f"200,000 bytes searched within 30 seconds: {ran_show(x)}")?;
    check_that(x.stdout == pathological_want(200000), x.stdout)
}

@test
fn a_tokeniser_split_agrees_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", PROGRAM)?;
    let env = env_set(suite_env(h), "NAZM_MEMORY_REPORT", "1");
    let interp = run(h, nazm_bin(h.io), words("run --interpret prog.nz"), d, env);
    let oracle = run(h, nazm_bin(h.io), words("lir --run prog.nz"), d, env);
    check_that(interp.code == 0 && interp.stdout == EXPECTED, f"interpreter: {ran_show(interp)}")?;
    check_that(oracle.code == 0 && oracle.stdout == EXPECTED, f"lir oracle: {ran_show(oracle)}")?;
    check_that(all_live_zero(interp), f"interpreter: {interp.stderr}")?;
    for case in text_split("llvm -O0|llvm|0;llvm -O2|llvm|2;cranelift|cranelift|0", ";") {
        let f = text_split(case, "|");
        let which = strs_get(f, 0);
        let exe = f"{d}/{text_replace(text_replace(which, " ", ""), "-", "")}";
        let b = nazm(h, d, words(f"build --no-cache --backend {strs_get(f, 1)} --opt-level {strs_get(f, 2)} prog.nz -o {exe}"));
        check_that(b.code == 0, f"{which}: {b.stderr}")?;
        let r = bounded_exe(h, exe, d, env);
        check_that(r.code == 0, f"{which}: {ran_show(r)}")?;
        check_that(r.stdout == EXPECTED, f"{which}: {r.stdout}")?;
        check_that(all_live_zero(r), f"{which}: {r.stderr}")?;
    }
    scratch_remove(h, d);
    ok()
}

/// A memory report, and every `live=` on it `live=0`.
fn all_live_zero(r: Ran) -> Bool ! {} {
    let line = memory_line(r);
    if line == "" {
        return false;
    }
    for w in split_whitespace(line) {
        if text_starts_with(w, "live=") && w != "live=0" {
            return false;
        }
    }
    true
}
