// N73: semantic differential fuzzing — generated programs, one answer from every tier
// (`docs/internal/architecture.md` §7.75). A seeded generator writes well-typed programs that terminate by
// construction; each is run by the interpreter, built by LLVM at `-O0` and `-O2` and by
// Cranelift, and run on LIR's interpreter; every tier must print the same value or fail with the
// same code at the same place. A disagreement is shrunk and printed for the regression corpus
// (`tests/fuzz-corpus`), which every run replays first. Ported from
// `crates/nazm-cli/tests/fuzz_diff.rs` (R7): the generator is the Rust test's, step for step — the
// same xorshift on `UInt64`, the same draws in the same order — so a seed writes the same programs.

use "@std/text"
use "@std/env"
use "@std/file"
use "@std/sort"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/port.nz"
use "../lib/strings.nz"
use "../lib/tree.nz"
use "../lib/differential.nz"
use "../lib/gen.nz"

/// The first line holding `error[N04`, without its `nazm: `.
fn failure(stderr: Str) -> Str ! {} {
    for l in text_lines(stderr) {
        if text_contains(l, "error[N04") {
            return trim_start_matches(l, "nazm: ");
        }
    }
    ""
}

/// What each tier did with one program: `name`, `stdout`, `status`, `failure` — four entries a tier.
fn tiers(h: Caps, dir: Str, src: Str) -> Result[Strs, Str] ! { io, spawn } {
    scratch_write(h, dir, "prog.nz", src)?;
    let out = strs_new();
    let run_ = nazm(h, dir, words("run --interpret prog.nz"));
    // The interpreter names the place on the next line; the native tiers on the same one.
    let mut place = "";
    for l in text_lines(run_.stderr) {
        let t = trim_start_ws(l);
        if place == "" && text_starts_with(t, "--> ") {
            place = trim_start_matches(t, "--> ");
        }
    }
    let line = failure(run_.stderr);
    strs_push(out, "run");
    strs_push(out, run_.stdout);
    strs_push(out, int_to_str(run_.code));
    strs_push(out, if line == "" { "" } else { f"{line} at {place}" });
    let backends = words("llvm llvm cranelift");
    let opts = words("0 2 2");
    let mut i = 0;
    while i < 3 {
        let backend = strs_get(backends, i);
        let opt = strs_get(opts, i);
        let exe = f"{dir}/p-{backend}-{opt}";
        let a = words(f"build --backend {backend} --opt-level {opt} prog.nz -o");
        strs_push(a, exe);
        let b = nazm(h, dir, a);
        strs_push(out, f"{backend} -O{opt}");
        if b.code != 0 {
            strs_push(out, "build failed");
            strs_push(out, int_to_str(b.code));
            strs_push(out, failure(b.stderr));
        } else {
            let o = run(h, exe, strs_new(), "", suite_env(h));
            strs_push(out, o.stdout);
            strs_push(out, int_to_str(o.code));
            strs_push(out, failure(o.stderr));
        }
        i = i + 1;
    }
    // N105: the LIR both backends translate, run on LIR's own interpreter — the oracle.
    let o = nazm(h, dir, words("lir --run prog.nz"));
    strs_push(out, "lir oracle");
    strs_push(out, o.stdout);
    strs_push(out, int_to_str(o.code));
    strs_push(out, failure(o.stderr));
    Result[Strs, Str].Ok(value: out)
}

fn tiers_agree(t: Strs) -> Bool ! {} {
    let mut i = 4;
    while i < strs_len(t) {
        if strs_get(t, i + 1) != strs_get(t, 1) || strs_get(t, i + 2) != strs_get(t, 2) || strs_get(t, i + 3) != strs_get(t, 3) {
            return false;
        }
        i = i + 4;
    }
    true
}

fn shown(t: Strs) -> Str ! {} {
    let out = strs_new();
    let mut i = 0;
    while i < strs_len(t) {
        strs_push(out, f"{strs_get(t, i)}: stdout {strs_get(t, i + 1)} status {strs_get(t, i + 2)} failure {strs_get(t, i + 3)}");
        i = i + 4;
    }
    str_join(out, "\n")
}

fn checks(h: Caps, dir: Str, src: Str) -> Result[Bool, Str] ! { io, spawn } {
    scratch_write(h, dir, "prog.nz", src)?;
    Result[Bool, Str].Ok(value: nazm(h, dir, words("check prog.nz")).code == 0)
}

/// Remove lines while the program still checks and the tiers still disagree.
fn shrink(h: Caps, dir: Str, src: Str) -> Result[Str, Str] ! { io, spawn } {
    let mut lines = text_lines(src);
    let mut i = 0;
    while i < strs_len(lines) {
        let candidate = strs_new();
        let mut j = 0;
        while j < strs_len(lines) {
            if j != i {
                strs_push(candidate, strs_get(lines, j));
            }
            j = j + 1;
        }
        let text = f"{str_join(candidate, "\n")}\n";
        if checks(h, dir, text)? && !tiers_agree(tiers(h, dir, text)?) {
            lines = candidate;
        } else {
            i = i + 1;
        }
    }
    Result[Str, Str].Ok(value: f"{str_join(lines, "\n")}\n")
}

/// `src` checked and run on every tier: its tiers, or `Err` when it does not check or they disagree.
fn check_one(h: Caps, dir: Str, src: Str, lbl: Str) -> Result[Strs, Str] ! { io, spawn } {
    if !checks(h, dir, src)? {
        let why = nazm(h, dir, words("check prog.nz"));
        return Result[Strs, Str].Err(error: f"{lbl}: the generator wrote a program that does not check:\n{src}\n{why.stderr}");
    }
    let results = tiers(h, dir, src)?;
    if !tiers_agree(results) {
        let small = shrink(h, dir, src)?;
        let shrunk = tiers(h, dir, small)?;
        return Result[Strs, Str].Err(error: f"{lbl}: the tiers disagree. Shrunk, for tests/fuzz-corpus:\n---\n{small}---\n{shown(shrunk)}");
    }
    Result[Strs, Str].Ok(value: results)
}

fn env_int(h: Caps, name: Str, default: Int) -> Int ! { io } {
    match env_get(h.io, name) {
        Option.Some(value: s) => match text_parse_int(s) {
            Result.Ok(value: n) => n,
            Result.Err(error: e) => default,
        },
        Option.None() => default,
    }
}

@test
fn every_tier_gives_a_generated_program_the_same_answer(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = scratch_new(h);
    // The regression corpus first.
    let corpus = f"{repo_root(h)}/crates/nazm-cli/tests/fuzz-corpus";
    let names = match dir_list(h.io, corpus) { Result.Ok(value: xs) => xs, Result.Err(error: e) => strs_new(), };
    for name in strs_sort(names) {
        if text_ends_with(name, ".nz") {
            check_one(h, d, read_text(h, f"{corpus}/{name}")?, f"{corpus}/{name}")?;
        }
    }
    // `0x6e61_7a6d_0073`, the Rust test's seed.
    let seed = env_int(h, "NAZM_FUZZ_SEED", 121364944846963);
    let cases = env_int(h, "NAZM_FUZZ_CASES", 24);
    let r = rng_new(seed);
    let mut failing = 0;
    let mut c = 0;
    while c < cases {
        let src = program(r);
        let results = check_one(h, d, src, f"seed {seed} case {c}")?;
        if strs_get(results, 2) == "2" {
            failing = failing + 1;
        }
        c = c + 1;
    }
    scratch_remove(h, d);
    // The generator reaches failures as well as values: the edge literals see to it.
    check_that(cases < 10 || failing > 0, "no generated program failed: the edges are not reached")
}
