@test
fn resolved_units_and_references_match_the_published_schemas(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N77: the units a check entry stores, and an entity's occurrences read from them.
    let d = prog_dir(h, "nazm.root", "")?;
    scratch_write(h, d, "lib.nz", "pub fn helper(x: Int) -> Int { x + 1 }\npub struct P { a: Int, }\npub enum E { A, B(v: Int), }\n")?;
    scratch_write(h, d, "main.nz", "use \"lib.nz\" as l;\nfn main() -> Int { let p = l::P(a: l::helper(1)); match l::E.B(v: p.a) { l::E.A() => 0, l::E.B(v: x) => x } }\n")?;
    let units = nazm_in(h, d, "resolve main.nz")?;
    let u = objects_in(units.stdout);
    check_that(strs_len(u) >= 2, units.stdout)?;
    check_against(h, "nazm.resolved-1.json", u)?;
    let refs = strs_new();
    for def in text_split("lib.nz::fn helper|lib.nz::enum E.B|lib.nz::enum E.B.v|lib.nz::record P.a", "|") {
        let a = words("references");
        strs_push(a, def);
        strs_push(a, "main.nz");
        let o = nazm(h, d, a);
        check_that(o.code == 0, o.stderr)?;
        for x in objects_in(o.stdout) {
            strs_push(refs, x);
        }
    }
    scratch_remove(h, d);
    check_against(h, "nazm.references-1.json", refs)
}

@test
fn the_lir_tables_match_the_published_schema_on_every_target_class(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N81: one program with a record of three widths, an enum with a payload and a `Vec`, printed
    // for a 64-bit target and for wasm32.
    let d = prog_dir(h, "prog.nz", "struct Q { flag: Bool, name: Str, n: Int, xs: Ints }\nenum S { Num(n: Int), Pair(q: Q, k: Int), Empty }\nfn val(s: S) -> Int { match s { S.Num(n: n) => n, S.Pair(q: q, k: k) => q.n + k, S.Empty() => 0, } }\nfn main() -> Int { let v = vec_new[Str](); vec_push(v, \"a\"); val(S.Pair(q: Q(flag: true, name: \"x\", n: 1, xs: ints_new()), k: 2)) + vec_len(v) }\n")?;
    let objects = strs_new();
    for target in words("aarch64-apple-darwin wasm32-unknown-unknown") {
        let o = nazm(h, d, words(f"lir --target {target} {d}/prog.nz"));
        check_that(o.code == 0, o.stderr)?;
        for x in objects_in(o.stdout) {
            strs_push(objects, x);
        }
    }
    scratch_remove(h, d);
    check_that(strs_len(objects) == 2, f"{strs_len(objects)} objects")?;
    check_against(h, "nazm.lir-2.json", objects)
}

@test
fn an_obligation_census_matches_the_published_schema(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N87: contracts, a proved and a checked call, arithmetic, an index and a function value.
    let d = prog_dir(h, "prog.nz", "fn half(n: Int) -> Int ! {} requires n >= 0 ensures result * 2 <= n { n / 2 }\nfn ap(f: fn(Int) -> Int, x: Int) -> Int ! {} { f(x) }\nfn main() -> Int { half(8) + half(str_len(\"ab\")) + str_byte(\"a\", 0) + ap(half, 4) }\n")?;
    let o = nazm(h, d, words(f"obligations --json {d}/prog.nz"));
    scratch_remove(h, d);
    check_that(o.code == 0, o.stderr)?;
    let objects = objects_in(o.stdout);
    check_that(strs_len(objects) == 1, o.stdout)?;
    check_against(h, "nazm.obligations-1.json", objects)
}

@test
fn a_runtime_manifest_matches_the_published_schema_for_every_profile(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N82: a hosted, a board and a WebAssembly artifact.
    let d = scratch_new(h);
    let objects = strs_new();
    for case in text_split("hosted|;board| --target aarch64-unknown-none;wasm| --target wasm32-unknown-unknown", ";") {
        let f = text_split(case, "|");
        let name = strs_get(f, 0);
        let o = nazm(h, d, words(f"runtime build -o {name}{strs_get(f, 1)}"));
        check_that(o.code == 0, o.stderr)?;
        for x in objects_in(read_text(h, f"{d}/{name}/nazm-runtime.json")?) {
            strs_push(objects, x);
        }
    }
    scratch_remove(h, d);
    check_that(strs_len(objects) == 3, f"{strs_len(objects)} manifests")?;
    check_against(h, "nazm.runtime-1.json", objects)
}

/// Gate 2 (§18–§19): a test function's row, a fuzz target's, and a benchmark's, from real output.
@test
fn test_function_and_benchmark_rows_match_the_published_schemas(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "t.nz", "@test\nfn ok() -> Result[Int, Str] { Result[Int, Str].Ok(value: 0) }\n\n@fuzz\nfn f(input: Bytes) -> Result[Int, Str] { Result[Int, Str].Ok(value: bytes_len(input)) }\n\n@bench\nfn b() -> Int { 1 }\n")?;
    let tested = nazm(h, d, words("test --json --fuzz 5 t.nz"));
    let benched = nazm(h, d, words("bench --json --iterations 3 t.nz"));
    scratch_remove(h, d);
    let rows = objects_in(tested.stdout);
    check_that(strs_len(rows) == 2, tested.stderr)?;
    check_against(h, "nazm.test-1.json", rows)?;
    let brows = objects_in(benched.stdout);
    check_that(strs_len(brows) == 1, benched.stderr)?;
    check_against(h, "nazm.bench-1.json", brows)
}

/// G2-C1: an item's `deprecated`, from real `nazm doc` output.
@test
fn a_deprecated_items_api_doc_matches_the_published_schema(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "lib.nz", "@deprecated(\"use g\")\npub fn f() -> Int { 0 }\n@deprecated\npub struct S { x: Int, }\nfn main() -> Int { f() }\n")?;
    let o = nazm(h, d, words("doc lib.nz"));
    scratch_remove(h, d);
    let doc = jparse(o.stdout)?;
    let compact = jv(doc, "");
    check_that(text_contains(compact, "\"deprecated\":\"use g\""), compact)?;
    check_against(h, "nazm.api-doc-2.json", one(compact))
}

@test
fn trace_output_matches_its_schema(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
