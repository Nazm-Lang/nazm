    check_that(second.reused == second.units, did_show(second))
}

@test
fn a_private_enum_added_to_a_dependency_leaves_the_caller_s_object_reusable(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, a_uses_b_enum())?;
    build(h, d, "a.nz")?;
    scratch_write(h, d, "b.nz", "pub enum State {\n    Ready,\n    Done(code: Int),\n}\nenum Hidden {\n    A(n: Str),\n    B,\n}\nenum Another {\n    Only,\n}\nfn secret() -> Int { match Hidden.B() { Hidden.A(n: s) => str_len(s), Hidden.B() => 0, } + match Another.Only() { Another.Only() => 0, } }\npub fn start(n: Int) -> State { State.Done(code: n + secret()) }\n")?;
    let after = build(h, d, "a.nz")?;
    check_that(after.compiled == 1, "only b.nz's unit should have been compiled")?;
    check_that(after.reused == after.units - 1, did_show(after))?;
    let r = run_exe(h, d, "prog");
    scratch_remove(h, d);
    check_that(r.stdout == "4200", ran_show(r))
}

fn unused_enum(extra: Str) -> Str ! {} {
    let arm = if extra == "" { "" } else { " Unused.B(s: s) => str_len(s)," };
    f"pub enum Unused {{\n    A(x: Int),{extra}\n}}\npub fn plain() -> Int {{ match Unused.A(x: 1) {{ Unused.A(x: n) => n,{arm} }} }}\n"
}

@test
fn an_enum_a_unit_never_mentions_is_not_in_its_text(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, pairs("a.nz", "use \"b.nz\";\nfn main() -> Int { plain() }\n", "b.nz", unused_enum("")))?;
    let before = emitted(h, d, "a.nz", "prog")?;
    scratch_write(h, d, "b.nz", unused_enum("\n    B(s: Str),"))?;
    let after = emitted(h, d, "a.nz", "prog")?;
    scratch_remove(h, d);
    check_that(unit_of(before, "a.nz")? == unit_of(after, "a.nz")?, "a.nz's text moved")?;
    check_that(unit_of(before, "b.nz")? != unit_of(after, "b.nz")?, "b.nz's text did not move")
}

@test
fn reordering_an_enums_variants_changes_no_object(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let body = "fn main() -> Int { match E.Done(code: 1, why: \"ab\") { E.Ready() => 0, E.Done(code: c, why: w) => c + str_len(w), } }\n";
    let whats = words("variants payload-fields");
    let befores = strs_new();
    strs_push(befores, "enum E {\n    Ready,\n    Done(code: Int, why: Str),\n}\n");
    strs_push(befores, "enum E {\n    Ready,\n    Done(code: Int, why: Str),\n}\n");
    let afters = strs_new();
    strs_push(afters, "enum E {\n    Done(code: Int, why: Str),\n    Ready,\n}\n");
    strs_push(afters, "enum E {\n    Ready,\n    Done(why: Str, code: Int),\n}\n");
    let mut k = 0;
    while k < 2 {
        let d = project(h, pairs("m.nz", f"{strs_get(befores, k)}{body}", "", ""))?;
        let first = emitted(h, d, "m.nz", "prog")?;
        scratch_write(h, d, "m.nz", f"{strs_get(afters, k)}{body}")?;
        let second = emitted(h, d, "m.nz", "prog")?;
        scratch_remove(h, d);
        check_that(unit_of(first, "m.nz")? == unit_of(second, "m.nz")?, f"reordering {strs_get(whats, k)} changed the emitted text")?;
        k = k + 1;
    }
    ok()
}

@test
fn an_enum_type_is_named_from_its_durable_identity_and_not_its_position(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let f = pairs("main.nz", "use \"a.nz\";\nuse \"b.nz\";\nfn main() -> Int { from_a() + from_b() }\n", "a.nz", "enum Thing {\n    N(n: Str),\n}\npub fn from_a() -> Int { let t = Thing.N(n: int_to_str(1)); let u = t; match u { Thing.N(n: n) => str_len(n), } }\n");
    add(f, "b.nz", "enum Thing {\n    M(m: Str),\n}\npub fn from_b() -> Int { let t = Thing.M(m: int_to_str(22)); let u = t; match u { Thing.M(m: m) => str_len(m), } }\n");
    let d = project(h, f)?;
    let units = emitted(h, d, "main.nz", "prog")?;
    scratch_remove(h, d);
    helpers_apart(unit_of(units, "a.nz")?, unit_of(units, "b.nz")?)
}

/// What one build did with its generic instances: `units compiled reused`.
fn instances(h: Caps, dir: Str, root: Str) -> Result[Str, Str] ! { io, spawn } {
    let out = nazm(h, dir, words(f"build {root} -o prog --build-report"));
    check_that(out.code == 0, out.stderr)?;
    for l in text_lines(out.stdout) {
        if text_contains(l, "nazm.build-report/1") {
            let v = jparse(l)?;
            return Result[Str, Str].Ok(value: f"{jint(v, "native/instances/units")} {jint(v, "native/instances/compiled")} {jint(v, "native/instances/reused")}");
        }
    }
    Result[Str, Str].Err(error: "a report")
}

const GENERIC_B: Str = "pub fn identity[T](x: T) -> T { x }\npub fn count[T](xs: Vec[T]) -> Int { vec_len(xs) }\n";

fn generic_three() -> Strs ! {} {
    let f = pairs("b.nz", GENERIC_B, "c.nz", "use \"b.nz\";\npub fn from_c() -> Int { identity(2) }\n");
    add(f, "a.nz", "use \"b.nz\";\nuse \"c.nz\";\nfn main() -> Int { identity(40) + from_c() }\n")
}

@test
fn one_instance_requested_by_two_modules_is_one_unit_and_one_object(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, generic_three())?;
    // `identity[Int]` from `a` and from `c`: one instance.
    let i1 = instances(h, d, "a.nz")?;
    check_that(i1 == "1 1 0", i1)?;
    check_that(run_exe(h, d, "prog").stdout == "42", "42")?;
    // Warm, it is reused like any unit, and nothing is compiled at all.
    let warm = build(h, d, "a.nz")?;
    check_that(warm.compiled == 0, did_show(warm))?;
    let i2 = instances(h, d, "a.nz")?;
    check_that(i2 == "1 0 1", i2)?;
    // And it is defined once: exactly one unit carries its body.
    let units = emitted(h, d, "a.nz", "prog")?;
    scratch_remove(h, d);
    let mut defining = 0;
    let mut i = 1;
    while i < strs_len(units) {
        if text_contains(strs_get(units, i), "define hidden i64 @nz.m.b_2Enz.identity.g.Int(") {
            defining = defining + 1;
        }
        i = i + 2;
    }
    check_that(defining == 1, int_to_str(defining))
}

@test
fn two_instances_of_one_definition_are_two_symbols_even_where_their_code_coincides(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, pairs("b.nz", GENERIC_B, "a.nz", "use \"b.nz\";\nfn main() -> Int { if identity(true) { identity(3) } else { 0 } }\n"))?;
    let i = instances(h, d, "a.nz")?;
    check_that(text_starts_with(i, "2 "), i)?;
    let units = emitted(h, d, "a.nz", "prog")?;
    scratch_remove(h, d);
    let all = str_join(every_second(units, 1), "");
    check_that(text_contains(all, "@nz.m.b_2Enz.identity.g.Int("), "Int")?;
    check_that(text_contains(all, "@nz.m.b_2Enz.identity.g.Bool("), "Bool")
}

@test
fn a_callers_unit_never_carries_a_generic_body(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, pairs("b.nz", GENERIC_B, "a.nz", "use \"b.nz\";\nfn main() -> Int { identity(1) }\n"))?;
    let units = emitted(h, d, "a.nz", "prog")?;
    scratch_remove(h, d);
    let caller = unit_of(units, "a.nz")?;
    check_that(text_contains(caller, "declare i64 @nz.m.b_2Enz.identity.g.Int(i64)"), caller)?;
    check_that(!text_contains(caller, "define hidden i64 @nz.m.b_2Enz.identity"), caller)?;
    // Nor does the defining module's own unit (the `m` artefact).
    let modules = strs_new();
    let mut i = 0;
    while i + 1 < strs_len(units) {
        if text_starts_with(strs_get(units, i), "prog.m") {
            strs_push(modules, strs_get(units, i));
            strs_push(modules, strs_get(units, i + 1));
        }
        i = i + 2;
    }
    let definer = unit_of(modules, "b.nz")?;
    check_that(!text_contains(definer, "identity"), definer)
}

@test
fn one_new_instantiation_compiles_the_caller_and_the_new_instance_and_nothing_else(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, generic_three())?;
    let cold = build(h, d, "a.nz")?;
    check_that(cold.reused == 0, did_show(cold))?;
    scratch_write(h, d, "a.nz", "use \"b.nz\";\nuse \"c.nz\";\nfn main() -> Int { identity(40) + from_c() + str_len(identity(\"\")) }\n")?;
    let after = build(h, d, "a.nz")?;
    let i = instances(h, d, "a.nz")?;
    scratch_remove(h, d);
    check_that(text_starts_with(i, "2 "), i)?;
    // Compiled: `a`, `identity[Str]`, and the runtime.
    check_that(after.compiled == 3, did_show(after))?;
    check_that(after.units == cold.units + 1, did_show(after))
}

@test
fn a_generic_body_edit_recompiles_its_instances_and_no_caller(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let f = pairs("b.nz", "pub fn identity[T](x: T) -> T { x }\npub fn other() -> Int { 1 }\n", "c.nz", "use \"b.nz\";\npub fn from_c() -> Int { str_len(identity(\"cc\")) }\n");
    add(f, "a.nz", "use \"b.nz\";\nuse \"c.nz\";\nfn main() -> Int { identity(40) + from_c() + other() }\n");
    let d = project(h, f)?;
    let cold = build(h, d, "a.nz")?;
    check_that(run_exe(h, d, "prog").stdout == "43", "43")?;
    scratch_write(h, d, "b.nz", "pub fn identity[T](x: T) -> T { let y = x; y }\npub fn other() -> Int { 1 }\n")?;
    let after = build(h, d, "a.nz")?;
    let r = run_exe(h, d, "prog");
    scratch_remove(h, d);
    check_that(r.stdout == "43", ran_show(r))?;
    // Two instances recompile — `identity[Int]` and `identity[Str]` — and nothing else.
    check_that(after.compiled == 2, did_show(after))?;
    check_that(after.reused == cold.units - 2, did_show(after))
}

@test
fn renaming_a_type_parameter_changes_no_object(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, pairs("b.nz", "pub fn pick[A, B](x: A, y: B) -> A { x }\n", "a.nz", "use \"b.nz\";\nfn main() -> Int { pick(1, \"s\") }\n"))?;
    build(h, d, "a.nz")?;
    scratch_write(h, d, "b.nz", "pub fn pick[Left, Right](x: Left, y: Right) -> Left { x }\n")?;
    let after = build(h, d, "a.nz")?;
    scratch_remove(h, d);
    check_that(after.compiled == 0, f"a rename is not a change: {did_show(after)}")
}

@test
fn a_private_function_a_generic_body_calls_is_bindable_from_the_instance(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h, pairs("b.nz", "fn secret(n: Int) -> Int { n * 2 }\npub fn twice[T](x: T, n: Int) -> Int { secret(n) }\n", "a.nz", "use \"b.nz\";\nfn main() -> Int { twice(\"x\", 21) }\n"))?;
    build(h, d, "a.nz")?;
    let r = run_exe(h, d, "prog");
    scratch_remove(h, d);
    check_that(r.stdout == "42", ran_show(r))
}
