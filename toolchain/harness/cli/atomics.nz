// Gate 3, 3D-1: atomics (`docs/user/spec.md`, *Atomics*). Every operation answers as specified, every
// copy and every task reaches one cell, a sum outside `Int` stops the program as `+` does, and an
// atomic has no equality, is not plain data, and its names are the language's. Ported from
// `crates/nazm-cli/tests/atomics.rs` (R7).

use "@std/text"
use "../lib/run.nz"
use "../lib/native.nz"

const SHOW: Str = "fn show(out: OutCap, n: Int) -> Int ! {io} { print(str_concat(num_to_str(n), \"\\n\")) }\n";

@test
fn every_operation_answers_as_specified(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = f"""
{SHOW}fn main(out: OutCap) -> Int ! {{io}} {{
    let a = atomic_new(5);
    show(out, atomic_load(a));
    show(out, atomic_store(a, 6));
    show(out, atomic_load(a));
    show(out, atomic_add(a, 10));
    show(out, atomic_add(a, -20));
    show(out, atomic_load(a));
    show(out, atomic_swap(a, 40));
    show(out, if atomic_compare_swap(a, 41, 0) {{ 1 }} else {{ 0 }});
    show(out, atomic_load(a));
    show(out, if atomic_compare_swap(a, 40, 41) {{ 1 }} else {{ 0 }});
    show(out, atomic_load(a));
    0
}}

""";
    agrees_plain(h, src, "5\n0\n6\n6\n16\n-4\n-4\n0\n40\n1\n41\n")
}

@test
fn every_copy_and_every_task_reaches_one_cell(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = f"""
{SHOW}struct Counter {{ hits: Atomic, name: Int, }}

fn bump(c: Counter, n: Int) -> Int {{
    let mut i = 0;
    while i < n {{
        atomic_add(c.hits, 1);
        i = i + 1;
    }}
    0
}}

fn main(out: OutCap, tasks: SpawnCap) -> Int ! {{io, spawn}} {{
    let c = Counter(hits: atomic_new(0), name: 7);
    let copy = c;
    scope {{
        spawn bump(c, 2000);
        spawn bump(copy, 2000);
        spawn bump(c, 2000);
        spawn bump(copy, 2000);
    }}
    show(out, atomic_load(c.hits));
    show(out, atomic_load(copy.hits));
    0
}}

""";
    agrees_plain(h, src, "8000\n8000\n")
}

@test
fn a_sum_outside_int_stops_the_program_as_plus_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = f"""
{SHOW}fn main(out: OutCap) -> Int ! {{io}} {{
    let a = atomic_new(9223372036854775806);
    show(out, atomic_add(a, 1));
    atomic_add(a, 1);
    show(out, 0);
    0
}}

""";
    for r in everywhere_plain(h, src)? {
        check_that(r.ran.code == 2, f"{r.label}: {ran_show(r.ran)}")?;
        check_that(r.ran.stdout == "9223372036854775806\n", r.label)?;
        check_that(text_contains(r.ran.stderr, "N0400"), f"{r.label}: {r.ran.stderr}")?;
        check_that(text_contains(r.ran.stderr, "this addition overflows `Int`"), f"{r.label}: {r.ran.stderr}")?;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn an_atomic_has_no_equality_is_not_plain_data_and_its_names_are_the_languages(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    refused_with(h, "fn main() -> Int { let a = atomic_new(1); if a == a { 1 } else { 0 } }\n", "N0304")?;
    refused_with(h, "struct Pair { cells: [Atomic; 2], }\nfn main() -> Int { 0 }\n", "N0621")?;
    refused_with(h, "struct Atomic { x: Int, }\nfn main() -> Int { 0 }\n", "N0331")?;
    refused_with(h, "fn atomic_load(x: Int) -> Int { x }\nfn main() -> Int { 0 }\n", "N0203")
}
