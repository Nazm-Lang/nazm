// Identity and interfaces, across processes and across checkouts (N3, N11). Everything here is
// about two runs: a key survives a process, bytes do not depend on where a checkout sits, and the
// invalidation tables are what the fingerprint actually does. Ported from
// `crates/nazm-cli/tests/durable_identity.rs` (R7).
//
// The Rust tables of enums, generics and requirements hash the printed interface with
// `InterfaceHash::of`; the port asks the binary for the same fingerprint (`nazm interface
// --hash`), which `a_fingerprint_is_the_algorithm_and_the_digest` holds equal to it. That test,
// and the ten that check a dependent against a deserialised interface with the checker as a
// library, stay Rust (`tests/stays-rust.txt`).

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/port.nz"
use "../lib/differential.nz"

/// The published interface of the module at `root`, as the binary writes it.
fn interface_of(h: Caps, root: Str) -> Result[Str, Str] ! { io, spawn } {
    let a = words("interface");
    strs_push(a, root);
    let out = nazm(h, "", a);
    check_that(out.code == 0, f"nazm interface refused {root}: {out.stderr}")?;
    Result[Str, Str].Ok(value: text_trim(out.stdout))
}

/// Its fingerprint, as the binary reports it.
fn hash_of(h: Caps, root: Str) -> Result[Str, Str] ! { io, spawn } {
    let a = words("interface");
    strs_push(a, root);
    strs_push(a, "--hash");
    let out = nazm(h, "", a);
    check_that(out.code == 0, out.stderr)?;
    Result[Str, Str].Ok(value: text_trim(out.stdout))
}

/// A project in a fresh directory: `root.nz` importing `lib/util.nz`.
fn project(h: Caps, util_body: Str, util_exports: Str) -> Result[Str, Str] ! { io } {
    let dir = scratch_new(h);
    scratch_write(h, dir, "root.nz", "use \"lib/util.nz\";\n\npub fn parse(s: Str) -> Int { twice(str_len(s)) }\n\nfn secret() -> Int { 1 }\n\nfn main() -> Int { parse(\"abc\") + secret() }\n")?;
    scratch_write(h, dir, "lib/util.nz", f"{util_exports}\n\nfn hidden() -> Int {{ {util_body} }}\n")?;
    Result[Str, Str].Ok(value: dir)
}

const TWICE: Str = "pub fn twice(n: Int) -> Int { n * 2 }";

@test
fn the_same_project_gives_the_same_interface_in_two_processes(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = project(h, "5", TWICE)?;
    let root = f"{dir}/root.nz";
    // Two separate runs of the compiler: every session-local id inside each is an index into that
    // run; nothing about them is expected to agree, and the bytes are.
    let one = interface_of(h, root)?;
    let two = interface_of(h, root)?;
    check_that(one == two, "two runs, two interfaces")?;
    check_that(hash_of(h, root)? == hash_of(h, root)?, "two runs, two hashes")?;
    // And the key is the module's place in the project, not its place on this machine.
    check_that(text_contains(one, "\"module\":\"root.nz\""), one)?;
    check_that(text_contains(one, "\"lib/util.nz\""), one)?;
    check_that(!text_contains(one, dir), f"an absolute path reached the interface: {one}")?;
    scratch_remove(h, dir);
    ok()
}

@test
fn two_checkouts_in_different_directories_give_identical_bytes(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = project(h, "5", TWICE)?;
    let b = project(h, "5", TWICE)?;
    check_that(a != b, "one directory")?;
    check_that(interface_of(h, f"{a}/root.nz")? == interface_of(h, f"{b}/root.nz")?, "the interfaces differ")?;
    check_that(hash_of(h, f"{a}/root.nz")? == hash_of(h, f"{b}/root.nz")?, "the hashes differ")?;
    scratch_remove(h, a);
    scratch_remove(h, b);
    ok()
}

@test
fn a_private_body_change_does_not_move_the_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = project(h, "1", TWICE)?;
    let b = project(h, "999", TWICE)?;
    let one = f"{a}/lib/util.nz";
    let two = f"{b}/lib/util.nz";
    check_that(interface_of(h, one)? == interface_of(h, two)?, "the interfaces differ")?;
    check_that(hash_of(h, one)? == hash_of(h, two)?, "the hashes differ")?;
    scratch_remove(h, a);
    scratch_remove(h, b);
    ok()
}

@test
fn an_exported_body_change_does_not_move_the_interface_either(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = project(h, "1", TWICE)?;
    let b = project(h, "1", "pub fn twice(n: Int) -> Int { n + n }")?;
    let same = hash_of(h, f"{a}/lib/util.nz")? == hash_of(h, f"{b}/lib/util.nz")?;
    scratch_remove(h, a);
    scratch_remove(h, b);
    check_that(same, "the hashes differ")
}

@test
fn comments_and_layout_do_not_move_the_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = prog_dir(h, "m.nz", "pub fn f(n: Int) -> Int { n }\n")?;
    let b = prog_dir(h, "m.nz", "// what it does\n///   with documentation\npub    fn f( n : Int )   ->   Int {\n    n\n}\n")?;
    let same = interface_of(h, f"{a}/m.nz")? == interface_of(h, f"{b}/m.nz")?;
    scratch_remove(h, a);
    scratch_remove(h, b);
    check_that(same, "the interfaces differ")
}

/// One row of the invalidation table: the fingerprint of a module of this source.
fn fingerprint_of_module(h: Caps, source: Str) -> Result[Str, Str] ! { io, spawn } {
    let dir = prog_dir(h, "m.nz", source)?;
    let hash = hash_of(h, f"{dir}/m.nz");
    scratch_remove(h, dir);
    hash
}

/// Every source of `unchanged` has `base`'s fingerprint and every one of `changed` another;
/// `whats` names the rows, the unchanged first.
fn table(h: Caps, base: Str, whats: Strs, unchanged: Strs, changed: Strs) -> Result[Int, Str] ! { io, spawn } {
    let before = fingerprint_of_module(h, base)?;
    let mut i = 0;
    for after in unchanged {
        check_that(before == fingerprint_of_module(h, after)?, f"{strs_get(whats, i)}: the fingerprint moved, so every dependent would be re-checked for nothing")?;
        i = i + 1;
    }
    for after in changed {
        check_that(before != fingerprint_of_module(h, after)?, f"{strs_get(whats, i)}: the fingerprint did not move, so a dependent would keep a stale answer")?;
        i = i + 1;
    }
    ok()
}

@test
fn the_invalidation_table_is_what_the_fingerprint_actually_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let base = "pub fn shown(n: Int) -> Int { helper() + n }\nfn helper() -> Int { 1 }\n";
    let whats = text_split("a private body changes|a private signature changes|an exported body changes|a private function is added|a private function is removed|an exported signature changes|an exported return type changes|a private function becomes exported|an exported function becomes private|an exported function is renamed|an exported function is added|an exported function is removed", "|");
    let unchanged = strs_new();
    strs_push(unchanged, "pub fn shown(n: Int) -> Int { helper() + n }\nfn helper() -> Int { 999 }\n");
    strs_push(unchanged, "pub fn shown(n: Int) -> Int { helper(1) + n }\nfn helper(k: Int) -> Int { k }\n");
    strs_push(unchanged, "pub fn shown(n: Int) -> Int { helper() + n + 0 }\nfn helper() -> Int { 1 }\n");
    strs_push(unchanged, "pub fn shown(n: Int) -> Int { helper() + n }\nfn helper() -> Int { 1 }\nfn extra() -> Int { 2 }\n");
    strs_push(unchanged, "pub fn shown(n: Int) -> Int { n }\n");
    let changed = strs_new();
    strs_push(changed, "pub fn shown(n: Str) -> Int { helper() + str_len(n) }\nfn helper() -> Int { 1 }\n");
    strs_push(changed, "pub fn shown(n: Int) -> Str { \"x\" }\nfn helper() -> Int { 1 }\n");
    strs_push(changed, "pub fn shown(n: Int) -> Int { helper() + n }\npub fn helper() -> Int { 1 }\n");
    strs_push(changed, "fn shown(n: Int) -> Int { helper() + n }\nfn helper() -> Int { 1 }\n");
    strs_push(changed, "pub fn displayed(n: Int) -> Int { helper() + n }\nfn helper() -> Int { 1 }\n");
    strs_push(changed, "pub fn shown(n: Int) -> Int { helper() + n }\npub fn also(n: Int) -> Int { n }\nfn helper() -> Int { 1 }\n");
    strs_push(changed, "fn helper() -> Int { 1 }\npub fn other() -> Int { 2 }\n");
    table(h, base, whats, unchanged, changed)
}

@test
fn a_module_outside_the_source_root_declines_a_durable_identity(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Not an error: it checks, runs and compiles. It simply has no key.
    let dir = scratch_new(h);
    scratch_write(h, dir, "outside.nz", "pub fn v() -> Int { 1 }\n")?;
    scratch_write(h, dir, "app/main.nz", "use \"../outside.nz\";\nfn main() -> Int { v() }\n")?;
    let root = f"{dir}/app/main.nz";
    let a = words("run --interpret");
    strs_push(a, root);
    let ran = nazm(h, "", a);
    check_that(ran.code == 0, ran.stderr)?;
    check_that(text_trim(ran.stdout) == "1", ran.stdout)?;
    let b = words("interface");
    strs_push(b, root);
    let published = nazm(h, "", b);
    scratch_remove(h, dir);
    check_that(published.code != 0, ran_show(published))?;
    check_that(text_contains(published.stderr, "durable identity"), published.stderr)
}

@test
fn an_interface_names_only_its_direct_dependencies(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = scratch_new(h);
    scratch_write(h, dir, "c.nz", "pub fn deep() -> Int { 7 }\n")?;
    scratch_write(h, dir, "b.nz", "use \"c.nz\";\npub fn mid() -> Int { deep() }\n")?;
    scratch_write(h, dir, "a.nz", "use \"b.nz\";\npub fn top() -> Int { mid() }\n")?;
    let published = interface_of(h, f"{dir}/a.nz")?;
    scratch_remove(h, dir);
    // The core prelude is a dependency of every module, like any import.
    check_that(text_contains(published, "\"dependencies\":[\"@core/prelude\",\"b.nz\"]"), published)?;
    check_that(!text_contains(published, "c.nz"), published)
}

@test
fn the_entry_point_is_not_part_of_what_a_module_offers(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = prog_dir(h, "m.nz", "pub fn v() -> Int { 1 }\nfn main() -> Int { v() }\n")?;
    let published = interface_of(h, f"{dir}/m.nz")?;
    scratch_remove(h, dir);
    check_that(text_contains(published, "\"v\""), published)?;
    check_that(!text_contains(published, "main"), published)
}

@test
fn session_ids_differ_between_runs_where_durable_keys_do_not(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = scratch_new(h);
    scratch_write(h, dir, "lib/util.nz", "pub fn v() -> Int { 1 }\n")?;
    scratch_write(h, dir, "other.nz", "pub fn w() -> Int { 2 }\n")?;
    scratch_write(h, dir, "one.nz", "use \"lib/util.nz\";\nuse \"other.nz\";\nfn main() -> Int { v() + w() }\n")?;
    scratch_write(h, dir, "two.nz", "use \"other.nz\";\nuse \"lib/util.nz\";\nfn main() -> Int { v() + w() }\n")?;
    // `lib/util.nz` is module 1 in one compilation and module 2 in the other, and its interface
    // is the same bytes either way.
    for root in words("one.nz two.nz") {
        let a = words("check");
        strs_push(a, f"{dir}/{root}");
        let out = nazm(h, "", a);
        check_that(out.code == 0, out.stderr)?;
    }
    let same = interface_of(h, f"{dir}/lib/util.nz")? == interface_of(h, f"{dir}/lib/util.nz")?;
    scratch_remove(h, dir);
    check_that(same, "the interfaces differ")
}

@test
fn changing_which_modules_are_imported_changes_the_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = scratch_new(h);
    scratch_write(h, a, "dep.nz", "pub fn d() -> Int { 1 }\n")?;
    scratch_write(h, a, "m.nz", "pub fn v() -> Int { 1 }\n")?;
    let without = hash_of(h, f"{a}/m.nz")?;
    scratch_write(h, a, "m.nz", "use \"dep.nz\";\npub fn v() -> Int { d() }\n")?;
    let with = hash_of(h, f"{a}/m.nz")?;
    scratch_remove(h, a);
    check_that(without != with, "the import did not move the fingerprint")
}

@test
fn an_exported_record_is_published_with_its_fields_and_durable_identity(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = prog_dir(h, "m.nz", "pub struct Point {\n    y: Int,\n    x: Str,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at(p: Point) -> Point { p }\nfn secret() -> Int { Hidden(n: 1).n }\n")?;
    let json = interface_of(h, f"{dir}/m.nz")?;
    scratch_remove(h, dir);
    check_that(json == "{\"schema\":\"nazm.interface/13\",\"module\":\"m.nz\",\"dependencies\":[\"@core/prelude\"],\"records\":[{\"def\":\"m.nz::record Point\",\"name\":\"Point\",\"generics\":0,\"fields\":[{\"name\":\"x\",\"ty\":\"Str\"},{\"name\":\"y\",\"ty\":\"Int\"}]}],\"enums\":[],\"exports\":[{\"def\":\"m.nz::fn at\",\"name\":\"at\",\"kind\":\"fn\",\"generics\":0,\"params\":[{\"def\":\"m.nz::record Point\",\"args\":[]}],\"ret\":{\"def\":\"m.nz::record Point\",\"args\":[]}}]}", json)?;
    // A private record is not offered, and its name is not in the bytes.
    check_that(!text_contains(json, "Hidden"), json)
}

@test
fn moving_two_field_declarations_does_not_move_the_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let one = fingerprint_of_module(h, "pub struct Point {\n    x: Int,\n    y: Str,\n}\n")?;
    let other = fingerprint_of_module(h, "pub struct Point {\n    y: Str,\n    x: Int,\n}\n")?;
    check_that(one == other, "reordering fields moved the fingerprint")
}

@test
fn the_record_invalidation_table_is_what_the_fingerprint_actually_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let base = "pub struct Point {\n    x: Int,\n    y: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Point { Point(x: 1, y: 2) }\n";
    let whats = text_split("a private record's fields change|a private record is added|an exported record's fields are reordered|an exported field is added|an exported field is removed|an exported field changes type|an exported record is renamed|an exported record stops being exported", "|");
    let unchanged = strs_new();
    strs_push(unchanged, "pub struct Point {\n    x: Int,\n    y: Int,\n}\nstruct Hidden {\n    n: Str,\n    extra: Int,\n}\npub fn at() -> Point { Point(x: 1, y: 2) }\n");
    strs_push(unchanged, "pub struct Point {\n    x: Int,\n    y: Int,\n}\nstruct Hidden {\n    n: Int,\n}\nstruct Another {\n    m: Int,\n}\npub fn at() -> Point { Point(x: 1, y: 2) }\n");
    strs_push(unchanged, "pub struct Point {\n    y: Int,\n    x: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Point { Point(x: 1, y: 2) }\n");
    let changed = strs_new();
    strs_push(changed, "pub struct Point {\n    x: Int,\n    y: Int,\n    z: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Point { Point(x: 1, y: 2, z: 3) }\n");
    strs_push(changed, "pub struct Point {\n    x: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Point { Point(x: 1) }\n");
    strs_push(changed, "pub struct Point {\n    x: Str,\n    y: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Point { Point(x: \"a\", y: 2) }\n");
    strs_push(changed, "pub struct Place {\n    x: Int,\n    y: Int,\n}\nstruct Hidden {\n    n: Int,\n}\npub fn at() -> Place { Place(x: 1, y: 2) }\n");
    strs_push(changed, "struct Point {\n    x: Int,\n    y: Int,\n}\nstruct Hidden {\n    n: Int,\n}\nfn at() -> Point { Point(x: 1, y: 2) }\n");
    table(h, base, whats, unchanged, changed)
}

@test
fn an_exported_record_reaches_a_third_modules_shape_through_the_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = scratch_new(h);
    scratch_write(h, dir, "c.nz", "pub struct Inner {\n    n: Int,\n}\n")?;
    scratch_write(h, dir, "b.nz", "use \"c.nz\";\npub struct Wrapper {\n    inner: Inner,\n}\n")?;
    let json = interface_of(h, f"{dir}/b.nz")?;
    check_that(text_contains(json, "c.nz::record Inner"), json)?;
    check_that(text_contains(json, "b.nz::record Wrapper"), json)?;
    // Carrying a shape is not carrying a name: an importer of `b.nz` may not write `Inner`.
    scratch_write(h, dir, "a.nz", "use \"b.nz\";\nfn main() -> Int { Inner(n: 1).n }\n")?;
    let a = words("check");
    strs_push(a, f"{dir}/a.nz");
    let out = nazm(h, "", a);
    scratch_remove(h, dir);
    check_that(out.code == 1, ran_show(out))?;
    check_that(text_contains(out.stderr, "N0305"), out.stderr)
}

@test
fn an_exported_enum_is_published_with_its_variants_and_durable_identity(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = prog_dir(h, "m.nz", "pub enum State {\n    Ready,\n    Failed(why: Str, code: Int),\n    Done(code: Int),\n}\nenum Hidden {\n    Never,\n}\npub fn start() -> State { State.Ready() }\nfn secret() -> Int { match Hidden.Never() { Hidden.Never() => 1, } }\n")?;
    let json = interface_of(h, f"{dir}/m.nz")?;
    scratch_remove(h, dir);
    check_that(json == "{\"schema\":\"nazm.interface/13\",\"module\":\"m.nz\",\"dependencies\":[\"@core/prelude\"],\"records\":[],\"enums\":[{\"def\":\"m.nz::enum State\",\"name\":\"State\",\"generics\":0,\"variants\":[{\"name\":\"Done\",\"fields\":[{\"name\":\"code\",\"ty\":\"Int\"}]},{\"name\":\"Failed\",\"fields\":[{\"name\":\"code\",\"ty\":\"Int\"},{\"name\":\"why\",\"ty\":\"Str\"}]},{\"name\":\"Ready\",\"fields\":[]}]}],\"exports\":[{\"def\":\"m.nz::fn start\",\"name\":\"start\",\"kind\":\"fn\",\"generics\":0,\"params\":[],\"ret\":{\"def\":\"m.nz::enum State\",\"args\":[]}}]}", json)?;
    check_that(!text_contains(json, "Hidden"), json)?;
    // The numeric discriminant is representation, not meaning, and is nowhere in this.
    check_that(!text_contains(json, "tag"), json)
}

@test
fn the_enum_invalidation_table_is_what_the_fingerprint_actually_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let base = "pub enum State {\n    Ready,\n    Done(code: Int, why: Str),\n}\npub fn start() -> State { State.Ready() }\n";
    let whats = text_split("reordering variants|reordering payload fields|a private enum|a variant added|a variant renamed|a payload field added|a payload field retyped|a payload field removed", "|");
    let unchanged = strs_new();
    strs_push(unchanged, "pub enum State {\n    Done(code: Int, why: Str),\n    Ready,\n}\npub fn start() -> State { State.Ready() }\n");
    strs_push(unchanged, "pub enum State {\n    Ready,\n    Done(why: Str, code: Int),\n}\npub fn start() -> State { State.Ready() }\n");
    strs_push(unchanged, f"{base}enum Private {{\n    A,\n}}\n");
    let changed = strs_new();
    strs_push(changed, "pub enum State {\n    Ready,\n    Done(code: Int, why: Str),\n    Failed,\n}\npub fn start() -> State { State.Ready() }\n");
    strs_push(changed, "pub enum State {\n    Waiting,\n    Done(code: Int, why: Str),\n}\npub fn start() -> State { State.Waiting() }\n");
    strs_push(changed, "pub enum State {\n    Ready,\n    Done(code: Int, why: Str, at: Int),\n}\npub fn start() -> State { State.Ready() }\n");
    strs_push(changed, "pub enum State {\n    Ready,\n    Done(code: Str, why: Str),\n}\npub fn start() -> State { State.Ready() }\n");
    strs_push(changed, "pub enum State {\n    Ready,\n    Done(code: Int),\n}\npub fn start() -> State { State.Ready() }\n");
    table(h, base, whats, unchanged, changed)
}

const GENERIC_BASE: Str = "pub struct Pair[A, B] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> T { value }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n";

@test
fn a_generic_interface_carries_positions_and_no_parameter_names(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = prog_dir(h, "m.nz", GENERIC_BASE)?;
    let json = interface_of(h, f"{dir}/m.nz")?;
    scratch_remove(h, dir);
    check_that(json == "{\"schema\":\"nazm.interface/13\",\"module\":\"m.nz\",\"dependencies\":[\"@core/prelude\"],\"records\":[{\"def\":\"m.nz::record Pair\",\"name\":\"Pair\",\"generics\":2,\"fields\":[{\"name\":\"first\",\"ty\":{\"param\":0}},{\"name\":\"second\",\"ty\":{\"param\":1}}]}],\"enums\":[{\"def\":\"m.nz::enum Maybe\",\"name\":\"Maybe\",\"generics\":1,\"variants\":[{\"name\":\"None\",\"fields\":[]},{\"name\":\"Some\",\"fields\":[{\"name\":\"value\",\"ty\":{\"param\":0}}]}]}],\"exports\":[{\"def\":\"m.nz::fn first\",\"name\":\"first\",\"kind\":\"fn\",\"generics\":2,\"params\":[{\"def\":\"m.nz::record Pair\",\"args\":[{\"param\":0},{\"param\":1}]}],\"ret\":{\"param\":0}},{\"def\":\"m.nz::fn identity\",\"name\":\"identity\",\"kind\":\"fn\",\"generics\":1,\"params\":[{\"param\":0}],\"ret\":{\"param\":0}}]}", json)?;
    // The names written in the source are nowhere in the bytes.
    for name in words("\"A\" \"B\" \"T\"") {
        check_that(!text_contains(json, name), f"{name} leaked: {json}")?;
    }
    ok()
}

@test
fn the_generic_invalidation_table_is_what_the_fingerprint_actually_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let whats = text_split("every type parameter renamed|a generic body changes|a private generic definition is added|the parameter order changes|a record gains a parameter|a public generic field changes type|a public generic variant is added|a public generic signature changes|a function gains a type parameter", "|");
    let unchanged = strs_new();
    strs_push(unchanged, "pub struct Pair[Left, Right] {\n    first: Left,\n    second: Right,\n}\npub enum Maybe[Value] {\n    None,\n    Some(value: Value),\n}\npub fn identity[Value](value: Value) -> Value { value }\npub fn first[X, Y](p: Pair[X, Y]) -> X { p.first }\n");
    strs_push(unchanged, "pub struct Pair[A, B] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> T { let v = value; v }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n");
    strs_push(unchanged, f"{GENERIC_BASE}struct Hidden[T] {{ v: T, }}\nfn helper[T](x: T) -> T {{ x }}\n");
    let changed = strs_new();
    strs_push(changed, "pub struct Pair[B, A] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> T { value }\npub fn first[A, B](p: Pair[B, A]) -> A { p.first }\n");
    strs_push(changed, "pub struct Pair[A, B, C] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> T { value }\npub fn first[A, B](p: Pair[A, B, Int]) -> A { p.first }\n");
    strs_push(changed, "pub struct Pair[A, B] {\n    first: A,\n    second: Vec[B],\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> T { value }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n");
    strs_push(changed, "pub struct Pair[A, B] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n    Many(values: Vec[T]),\n}\npub fn identity[T](value: T) -> T { value }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n");
    strs_push(changed, "pub struct Pair[A, B] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T](value: T) -> Maybe[T] { Maybe[T].Some(value: value) }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n");
    strs_push(changed, "pub struct Pair[A, B] {\n    first: A,\n    second: B,\n}\npub enum Maybe[T] {\n    None,\n    Some(value: T),\n}\npub fn identity[T, U](value: T) -> T { value }\npub fn first[A, B](p: Pair[A, B]) -> A { p.first }\n");
    table(h, GENERIC_BASE, whats, unchanged, changed)
}

@test
fn a_requirement_is_part_of_the_interface_and_a_parameter_s_name_is_not(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let srcs = text_split("pub fn same[T: Equality](a: T, b: T) -> Bool { a == b }\n|pub fn same[Value: Equality](a: Value, b: Value) -> Bool { a == b }\n|pub fn same[T](a: T, b: T) -> Bool { true }\n", "|");
    let jsons = strs_new();
    let hashes = strs_new();
    for src in srcs {
        let dir = prog_dir(h, "m.nz", src)?;
        strs_push(jsons, interface_of(h, f"{dir}/m.nz")?);
        strs_push(hashes, hash_of(h, f"{dir}/m.nz")?);
        scratch_remove(h, dir);
    }
    check_that(strs_get(jsons, 0) == strs_get(jsons, 1) && strs_get(hashes, 0) == strs_get(hashes, 1), "renaming a parameter moved the interface")?;
    check_that(strs_get(jsons, 0) != strs_get(jsons, 2), "a requirement did not move the interface")?;
    check_that(strs_get(hashes, 0) != strs_get(hashes, 2), "a requirement did not move the fingerprint")
}
