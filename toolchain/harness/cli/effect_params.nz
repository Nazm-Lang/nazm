// N51: effect parameters, captured authority and the bounded bridge (`docs/internal/architecture.md` §7.53,
// the spec's *Effect parameters and captured authority*). Ported from
// `crates/nazm-cli/tests/effect_params.rs` (R7).
//
// An effect-polymorphic function does what the function it is handed does — in the interpreter
// and the backends alike — its callers are held to that, through a wrapper and across a module's
// interface, a profile sees it, and every refusal is one before anything runs.

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"

fn ok(r: Result[Str, Str]) -> Result[Int, Str] ! {} {
    r?;
    Result[Int, Str].Ok(value: 0)
}

fn holds(xs: Strs, x: Str) -> Bool ! {} {
    for y in xs {
        if y == x {
            return true;
        }
    }
    false
}

@test
fn an_effect_polymorphic_wrapper_does_what_its_function_does_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    ok(agrees(caps(io, p, sp, v, t), "\nuse \"@std/seq\";\nfn main(io: IoCap) -> Int ! { io } {\n    let xs = vec_new[Int]();\n    vec_push(xs, 1);\n    vec_push(xs, 2);\n    let shown = vec_map(xs, fn(x: Int) -> Int ! { io } { print(int_to_str(x)); x * 10 });\n    let pure = vec_map(xs, fn(x: Int) -> Int { x + 1 });\n    let kept = vec_filter(shown, fn(x: Int) -> Bool ! { io } { print(\"?\"); x > 10 });\n    let total = vec_fold(kept, 0, fn(a: Int, x: Int) -> Int { a + x });\n    print(int_to_str(total + vec_len(pure)));\n    0\n}\n", "12??220"))
}

@test
fn a_caller_is_held_to_what_the_function_it_passes_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    same_strs("a pure main", codes(h, "use \"@std/seq\";\nfn main(io: IoCap) -> Int ! {} { let xs = vec_new[Int](); vec_len(vec_map(xs, fn(x: Int) -> Int ! { io } { print(\"a\"); x })) }\n"), words("N0366"))?;
    // The same through a callee of this module, whose contract is read from its declaration.
    same_strs("through a callee", codes(h, "fn apply[effects E](f: fn() -> Int ! { E }) -> Int ! { E } { f() }\nfn main(io: IoCap) -> Int ! {} { apply(fn() -> Int ! { io } { print(\"a\"); 1 }) }\n"), words("N0366"))?;
    // A pure function passed to the same wrapper asks nothing of its caller.
    same_strs("a pure function", codes(h, "use \"@std/seq\";\nfn main() -> Int ! {} { let xs = vec_new[Int](); vec_len(vec_map(xs, fn(x: Int) -> Int { x })) }\n"), strs_new())
}

@test
fn a_function_may_forward_its_own_effect_parameter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, "\nuse \"@std/seq\";\nfn run[effects F](f: fn(Int) -> Int ! { F }) -> Int ! { F } {\n    let xs = vec_new[Int]();\n    vec_push(xs, 1);\n    vec_push(xs, 2);\n    vec_len(vec_map(xs, f))\n}\nfn twice[T, effects E](f: fn(T) -> T ! { E }, x: T) -> T ! { E } { f(f(x)) }\nfn main(io: IoCap) -> Int ! { io } {\n    let n = run(fn(x: Int) -> Int ! { io } { print(int_to_str(x)); x });\n    let m = twice(fn(s: Str) -> Str { str_concat(s, \"!\") }, \"hi\");\n    print(m);\n    n - 2\n}\n", "12hi!!0")?;
    // Forwarding performs the parameter, so the forwarder declares it.
    same_strs("the forwarder", codes(h, "use \"@std/seq\";\nfn run[effects F](f: fn(Int) -> Int ! { F }) -> Int ! {} { let xs = vec_new[Int](); vec_len(vec_map(xs, f)) }\nfn main() -> Int { 0 }\n"), words("N0366"))
}

@test
fn a_result_type_carries_the_binding(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    ok(agrees(caps(io, p, sp, v, t), "\nfn wrap[effects E](f: fn() -> Int ! { E }) -> fn() -> Int ! { E } ! { E } { f }\nfn main(io: IoCap) -> Int ! { io } {\n    let g = wrap(fn() -> Int ! { io } { print(\"w\"); 0 });\n    g()\n}\n", "w0"))
}

@test
fn one_parameter_is_one_set_of_effects(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    same_strs("two sets", codes(h, "fn both[effects E](f: fn() -> Int ! { E }, g: fn() -> Int ! { E }) -> Int ! { E } { f() + g() }\nfn main(io: IoCap) -> Int ! { io } { both(fn() -> Int ! { io } { print(\"a\"); 1 }, fn() -> Int { 2 }) }\n"), words("N0389"))?;
    // A parameter's named effects are its floor: an argument without them does not fit.
    same_strs("the floor", codes(h, "fn logged[effects E](f: fn() -> Int ! { io, E }) -> Int ! { io, E } { f() }\nfn main() -> Int { logged(fn() -> Int { 1 }) }\n"), words("N0300"))
}

@test
fn a_body_that_performs_its_parameter_declares_it_by_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "fn apply[effects E](f: fn() -> Int ! { E }) -> Int ! {} { f() }\nfn main() -> Int { 0 }\n")?;
    let r = nazm(h, d, words("check prog.nz"));
    scratch_remove(h, d);
    check_that(text_contains(r.stderr, "N0366"), ran_show(r))?;
    check_that(text_contains(r.stderr, "requires `E`"), ran_show(r))?;
    check_that(text_contains(r.stderr, "! { E }"), f"the fix names the parameter: {ran_show(r)}")
}

@test
fn an_effect_parameter_is_allowed_only_where_it_means_something(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    same_strs("two parameters", codes(h, "fn f[effects E, effects F](g: fn() -> Int ! { E }) -> Int ! { E } { g() }\nfn main() -> Int { 0 }\n"), words("N0388"))?;
    same_strs("not in the effects", codes(h, "fn f[effects E](g: fn() -> Int ! { E }) -> Int { g() }\nfn main() -> Int { 0 }\n"), words("N0388"))?;
    same_strs("on main", codes(h, "fn main[effects E]() -> Int ! { E } { 0 }\n"), words("N0388"))?;
    same_strs("inside a vector", codes(h, "fn f[effects E](xs: Vec[fn() -> Int ! { E }]) -> Int ! { E } { 0 }\nfn main() -> Int { 0 }\n"), words("N0388"))?;
    same_strs("on a record", codes(h, "struct R[effects E] { x: Int, }\nfn main() -> Int { 0 }\n"), words("N0100"))?;
    same_strs("as a value", codes(h, "fn apply[effects E](f: fn() -> Int ! { E }) -> Int ! { E } { f() }\nfn main() -> Int { let g = apply; 0 }\n"), words("N0387"))
}

@test
fn a_closure_holds_the_capabilities_it_captures(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, "\nfn helper(c: IoCap) -> Int ! { io } { print(\"h\"); 0 }\nfn main(io: IoCap) -> Int ! { io } {\n    let f = fn(x: Int) -> Int ! { io } { print(\"c\"); helper(io) + x };\n    let g = f;\n    g(0)\n}\n", "ch0")?;
    // Holding authority is not doing anything: a closure that performs `io` still says so.
    same_strs("a closure", codes(h, "fn main(io: IoCap) -> Int ! { io } { let f = fn(x: Int) -> Int { print(\"c\"); x }; f(0) }\n"), words("N0366"))
}

fn pair(a: Str, b: Str) -> Strs ! {} {
    let x = strs_new();
    strs_push(x, a);
    strs_push(x, b);
    x
}

@test
fn a_value_of_an_undeclared_import_needs_no_authority_of_its_maker(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N104: the function holds what it exercises, as a parameter, so making a value of it needs
    // nothing; the value's type still carries every effect, since the import declares none.
    let lib = "pub fn loud(x: Int, out: OutCap) -> Int { print(\"x\"); x }\n";
    same_strs("ok", check_codes(h, pair("main.nz", "lib.nz"), pair("use \"lib.nz\";\nfn main(io: IoCap) -> Int ! { io, spawn } { let f = loud; f(1, io) }\n", lib)), strs_new())?;
    let narrow = check_codes(h, pair("main.nz", "lib.nz"), pair("use \"lib.nz\";\nfn main(io: IoCap) -> Int ! { io } { let f = loud; f(1, io) }\n", lib));
    check_that(holds(narrow, "N0366") && !holds(narrow, "N0369"), str_join(narrow, ", "))
}

fn cached(h: Caps, d: Str, lib: Str, loud: Str) -> Result[Int, Str] ! { io, spawn } {
    scratch_write(h, d, "nazm.root", "")?;
    scratch_write(h, d, "lib.nz", lib)?;
    scratch_write(h, d, "main.nz", loud)?;
    let first = nazm(h, d, words("check main.nz"));
    check_that(first.code == 0, ran_show(first))?;
    scratch_write(h, d, "main.nz", "use \"lib.nz\";\nfn main(io: IoCap) -> Int ! {} { apply(fn(x: Int) -> Int ! { io } { print(\"in\"); x }, 4) }\n")?;
    let again = nazm(h, d, words("check main.nz --cache-report --json"));
    check_that(text_contains(again.stderr, "N0366"), ran_show(again))?;
    check_that(text_contains(again.stdout, "\"reused\":"), ran_show(again))
}

@test
fn an_effect_parameter_crosses_a_module_and_its_cached_interface(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let lib = "pub fn apply[effects E](f: fn(Int) -> Int ! { E }, x: Int) -> Int ! { E } { f(x) }\n";
    let loud = "use \"lib.nz\";\nfn main(io: IoCap) -> Int ! { io } { print(int_to_str(apply(fn(x: Int) -> Int ! { io } { print(\"in\"); x + 1 }, 4))); 0 }\n";
    agrees_on(h, pair("main.nz", "lib.nz"), pair(loud, lib), "in50", 0)?;
    // Checked twice, the second time from the library's cached interface.
    let d = scratch_new(h);
    let r = cached(h, d, lib, loud);
    scratch_remove(h, d);
    r
}

@test
fn a_profile_sees_an_effect_that_only_a_callback_performs(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "use \"@std/seq\";\nfn main(io: IoCap) -> Int ! { io } { let xs = vec_new[Int](); vec_len(vec_map(xs, fn(x: Int) -> Int ! { io } { print(\"a\"); x })) }\n")?;
    let r = nazm(h, d, words("check --profile embedded prog.nz"));
    scratch_remove(h, d);
    check_that(r.code != 0, ran_show(r))?;
    check_that(text_contains(r.stderr, "N0510"), ran_show(r))?;
    check_that(text_contains(r.stderr, "no-io"), ran_show(r))
}
