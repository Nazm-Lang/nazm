// N55: FFI v2 — C strings in, exported functions out. A `Str` crosses into C as a borrowed
// NUL-terminated copy under both backends, with identical results and a balanced memory report,
// and one holding a NUL is refused before C runs; an export is checked by its own rules; `nazm
// build --lib` writes an archive and a header a C program links against, under both backends, the
// same bytes on every build, with a Nazm failure inside an export ending the process instead of
// unwinding into C. Ported from `crates/nazm-cli/tests/ffi_v2.rs` (R7).

use "@std/json"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/port.nz"
use "../lib/jsonq.nz"
use "../lib/differential.nz"

/// The C side of the string tests: it reads what it is given and keeps nothing.
const C: Str = "\n#include <stdint.h>\n#include <string.h>\nint64_t c_strlen(const char *s) { return (int64_t)strlen(s); }\nint64_t c_byte_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\nint64_t c_cmp(const char *a, const char *b) { int r = strcmp(a, b); return r < 0 ? -1 : r > 0 ? 1 : 0; }\n";

/// `clang ARGS` in `d`.
fn clang(h: Caps, d: Str, args: Str) -> Result[Int, Str] ! { io, spawn } {
    let r = run(h, "clang", words(args), d, env_here(h.io));
    check_that(r.code == 0, r.stderr)
}

/// An executable under `bounded_exe`, with the memory report.
fn run_exe(h: Caps, exe: Str, args: Str) -> Ran ! { io, spawn } {
    let a = strs_new();
    strs_push(a, "-c");
    strs_push(a, bounded_script());
    strs_push(a, exe);
    for x in words(args) {
        strs_push(a, x);
    }
    run(h, "sh", a, "", env_set(suite_env(h), "NAZM_MEMORY_REPORT", "1"))
}

/// Every diagnostic code on a run's standard error, its JSON lines read.
fn codes_in(o: Ran) -> Str ! {} {
    let out = strs_new();
    for l in text_lines(o.stderr) {
        match jparse(l) {
            Result.Ok(value: v) => {
                if jq(v, "code") >= 0 && json_kind(v, jq(v, "code")) == "string" {
                    strs_push(out, jstr(v, "code"));
                }
            },
            Result.Err(error: e) => {},
        };
    }
    str_join(out, ",")
}

fn check_codes_of(h: Caps, src: Str) -> Str ! { io, spawn } {
    str_join(codes(h, src), ",")
}

fn built(h: Caps, d: Str, backend: Str) -> Result[Ran, Str] ! { io, spawn } {
    let b = nazm(h, d, words(f"build --no-cache --backend {backend} --link fixture.o prog.nz -o {d}/prog-{backend}"));
    check_that(b.code == 0, f"{backend}: {b.stderr}")?;
    Result[Ran, Str].Ok(value: run_exe(h, f"{d}/prog-{backend}", ""))
}

/// `prog.nz` built against the C fixture by both backends and run: they must agree exactly.
fn both(h: Caps, src: Str) -> Result[Ran, Str] ! { io, spawn } {
    let d = prog_dir(h, "prog.nz", src)?;
    scratch_write(h, d, "fixture.c", C)?;
    clang(h, d, "-c -O1 fixture.c -o fixture.o")?;
    let l = built(h, d, "llvm")?;
    let c = built(h, d, "cranelift")?;
    scratch_remove(h, d);
    check_that(l.code == c.code && l.stdout == c.stdout && l.stderr == c.stderr, f"LLVM and Cranelift disagree: {ran_show(l)} {ran_show(c)}")?;
    Result[Ran, Str].Ok(value: l)
}

const DECLS: Str = "extern \"C\" fn c_strlen(s: Str) -> Int = \"c_strlen\";\nextern \"C\" fn c_byte_at(s: Str, i: Int) -> Int = \"c_byte_at\";\nextern \"C\" fn c_cmp(a: Str, b: Str) -> Int = \"c_cmp\";\n";

@test
fn a_str_crosses_into_c_as_a_borrowed_c_string_under_both_backends(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = both(h, f"{DECLS}fn main(io: IoCap, f: ForeignCap) -> Int ! {{ io, foreign }} {{\n    let s = str_concat(\"hel\", \"lo\");\n    let mut i = 0;\n    let mut total = 0;\n    while i < 1000 {{ total = total + c_strlen(s); i = i + 1; }}\n    print(int_to_str(total)); print(\" \");\n    print(int_to_str(c_byte_at(str_slice(s, 1, 3), 1))); print(\" \");\n    print(int_to_str(c_strlen(\"\"))); print(\" \");\n    print(int_to_str(c_cmp(\"abc\", str_concat(\"ab\", \"d\"))));\n    0\n}}\n")?;
    check_that(r.code == 0, ran_show(r))?;
    // A slice is copied by its own length: `"el"`'s second byte is `l`, not the rest of `s`.
    check_that(r.stdout == "5000 108 0 -10\n", ran_show(r))?;
    let line = memory_line(r);
    check_that(text_contains(line, "strings allocated=6 reclaimed=6 live=0"), line)
}

@test
fn a_str_holding_a_nul_is_refused_before_c_runs(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = both(h, f"{DECLS}fn main(io: IoCap, f: ForeignCap) -> Int ! {{ io, foreign }} {{\n    print(\"before \");\n    let n = c_cmp(\"ok\", str_concat(\"a\", str_from_byte(0)));\n    print(\"after\");\n    n\n}}\n")?;
    check_that(r.code == 2, ran_show(r))?;
    check_that(r.stdout == "before ", ran_show(r))?;
    check_that(text_contains(r.stderr, "N0405") && text_contains(r.stderr, "NUL byte"), ran_show(r))
}

@test
fn a_str_result_from_c_is_a_copy_since_n85_and_a_sequence_result_is_still_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // N85: C keeps the string it returns and Nazm copies it. A sequence is still nothing C can
    // return.
    let a = check_codes_of(h, "extern \"C\" fn name() -> Str = \"c_name\";\nfn main() -> Int { 0 }\n");
    check_that(a == "", a)?;
    let b = check_codes_of(h, "extern \"C\" fn name() -> Ints = \"c_name\";\nfn main() -> Int { 0 }\n");
    check_that(b == "N0381", b)
}

@test
fn an_export_is_public_effect_free_scalar_and_not_generic(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let fine = check_codes_of(h, "pub extern \"C\" fn f(x: Int, b: Bool) -> Bool ! {} = \"nz_f\" { b && x > 0 }\nfn main() -> Int { if f(1, true) { 0 } else { 1 } }\n");
    check_that(fine == "", fine)?;
    let cases = text_split("extern \"C\" fn f(x: Int) -> Int ! {} = \"nz_f\" { x }\n|not public;pub extern \"C\" fn f(x: Int) -> Int = \"nz_f\" { x }\n|no effect set;pub extern \"C\" fn f(x: Int) -> Int ! { io } = \"nz_f\" { x }\n|an effect;pub extern \"C\" fn f[T](x: T) -> T ! {} = \"nz_f\" { x }\n|generic;pub extern \"C\" fn f(s: Str) -> Int ! {} = \"nz_f\" { str_len(s) }\n|a Str parameter;pub extern \"C\" fn f(x: Int) -> Str ! {} = \"nz_f\" { int_to_str(x) }\n|a Str result", ";");
    for case in cases {
        let f = text_split(case, "|");
        let got = codes(h, f"{strs_get(f, 0)}fn main() -> Int {{ 0 }}\n");
        check_that(strs_has(got, "N0391"), f"{strs_get(f, 1)}: {str_join(got, ",")}")?;
    }
    // The symbol rules are the foreign declaration's.
    let s1 = check_codes_of(h, "pub extern \"C\" fn f(x: Int) -> Int ! {} = \"9f\" { x }\nfn main() -> Int { 0 }\n");
    check_that(s1 == "N0382", s1)?;
    let s2 = check_codes_of(h, "pub extern \"C\" fn f(x: Int) -> Int ! {} = \"malloc\" { x }\nfn main() -> Int { 0 }\n");
    check_that(s2 == "N0383", s2)
}

@test
fn an_export_symbol_is_defined_once_in_a_program(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "pub extern \"C\" fn f(x: Int) -> Int ! {} = \"nz_same\" { x }\npub extern \"C\" fn g(x: Int) -> Int ! {} = \"nz_same\" { x + 1 }\nfn main() -> Int { f(1) + g(1) }\n")?;
    let o = nazm(h, d, words("build --json prog.nz -o prog"));
    scratch_remove(h, d);
    check_that(o.code != 0, ran_show(o))?;
    check_that(codes_in(o) == "N0383", o.stderr)
}

@test
fn an_export_is_an_ordinary_function_to_nazm_and_to_the_interpreter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "pub extern \"C\" fn triple(x: Int) -> Int ! {} = \"nz_triple\" { x * 3 }\nfn main(io: IoCap) -> Int ! { io } { print(int_to_str(triple(14))); 0 }\n")?;
    let r = nazm(h, d, words("run --interpret prog.nz"));
    check_that(r.stdout == "420\n", r.stderr)?;
    for backend in words("llvm cranelift") {
        let b = nazm(h, d, words(f"build --backend {backend} prog.nz -o {backend}"));
        check_that(b.code == 0, b.stderr)?;
        let x = run_exe(h, f"{d}/{backend}", "");
        check_that(x.stdout == "420\n", ran_show(x))?;
    }
    // And the formatter keeps the form.
    let f = nazm(h, d, words("fmt --check prog.nz"));
    scratch_remove(h, d);
    check_that(f.code == 0, f.stderr)
}

const LIB: Str = "fn square(x: Int) -> Int ! {} { x * x }\n\npub extern \"C\" fn sum_squares(a: Int, b: Int) -> Int ! {} = \"nazm_sum_squares\" {\n    square(a) + square(b)\n}\n\npub extern \"C\" fn is_even(n: Int) -> Bool ! {} = \"nazm_is_even\" { n % 2 == 0 }\n\npub extern \"C\" fn wrap(n: Int) -> Int ! {} = \"nazm_wrap\" { n * 9223372036854775807 }\n";

const HOST: Str = "\n#include <stdio.h>\n#include \"libnz.h\"\nint main(int argc, char **argv) {\n    printf(\"%lld %d %d\\n\", (long long)nazm_sum_squares(3, 4), nazm_is_even(10), nazm_is_even(7));\n    fflush(stdout);\n    if (argc > 1) { printf(\"%lld\\n\", (long long)nazm_wrap(2)); printf(\"not reached\\n\"); }\n    return 0;\n}\n";

const HEADER: Str = "/* Generated by nazm build --lib. Do not edit. */\n#ifndef NAZM_LIBNZ_H\n#define NAZM_LIBNZ_H\n\n#include <stdbool.h>\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n/* A Nazm failure inside any of these is reported on standard error and ends the\n   process with status 2: nothing unwinds into C. */\nbool nazm_is_even(int64_t a0);\nint64_t nazm_sum_squares(int64_t a0, int64_t a1);\nint64_t nazm_wrap(int64_t a0);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n";

@test
fn a_library_and_its_header_link_into_a_c_program_under_both_backends(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    for backend in words("llvm cranelift") {
        let d = prog_dir(h, "lib.nz", LIB)?;
        scratch_write(h, d, "main.c", HOST)?;
        let b = nazm(h, d, words(f"build --lib --no-cache --backend {backend} lib.nz -o libnz.a"));
        check_that(b.code == 0, f"{backend}: {b.stderr}")?;
        check_that(read_text(h, f"{d}/libnz.h")? == HEADER, backend)?;
        clang(h, d, "main.c libnz.a -o host")?;
        let r = run_exe(h, f"{d}/host", "");
        check_that(r.code == 0 && r.stdout == "25 1 0\n", f"{backend}: {ran_show(r)}")?;
        // A failure inside an export ends the process with Nazm's diagnostic and status 2, and C
        // never sees a value.
        let w = run_exe(h, f"{d}/host", "wrap");
        scratch_remove(h, d);
        check_that(w.code == 2, f"{backend}: {ran_show(w)}")?;
        check_that(w.stdout == "25 1 0\n", backend)?;
        check_that(text_contains(w.stderr, "N0400"), f"{backend}: {ran_show(w)}")?;
    }
    ok()
}

@test
fn a_library_is_the_same_bytes_on_every_build_and_needs_no_main(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "lib.nz", LIB)?;
    let seen = strs_new();
    for out in words("one.a two.a") {
        let b = nazm(h, d, words(f"build --lib --no-cache lib.nz -o {out}"));
        check_that(b.code == 0, b.stderr)?;
        strs_push(seen, read_raw(h, f"{d}/{out}")?);
    }
    check_that(strs_get(seen, 0) == strs_get(seen, 1), "two builds of one library differ")?;
    // Without `--lib`, a program with no `main` is still refused.
    let o = nazm(h, d, words("build lib.nz -o exe"));
    scratch_remove(h, d);
    check_that(o.code != 0, ran_show(o))?;
    check_that(text_contains(o.stderr, "no `main`"), o.stderr)
}
