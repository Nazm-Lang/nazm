// R1, 5b.5–5b.10: the conveniences for a first program — methods by name, `loop`, `while let`,
// block comments, `?` on an `Option`, an array literal where a sequence is wanted, `+` on strings —
// run alike everywhere; what they do not make valid is refused. Ported from
// `crates/nazm-cli/tests/conveniences.rs` (R7).

use "@std/text"
use "../lib/run.nz"
use "../lib/strings.nz"
use "../lib/differential.nz"

@test
fn the_conveniences_run_alike_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"/* A program /* with a nested */ block comment. */
struct Point { x: Int, y: Int }

impl Point {
    fn sum(self: Point) -> Int { self.x + self.y }
    fn scaled(self: Point, k: Int) -> Point { Point(x: self.x * k, y: self.y * k) }
}

fn empty() -> Vec[Int] { vec_new() }

fn popped(v: Vec[Int]) -> Option[Int] {
    if v.len() == 0 { None } else { Some(vec_pop(v)) }
}

fn main(out: OutCap) -> Int ! {io} {
    let p = Point(x: 2, y: 3)
    println(p.scaled(10).sum()) /* inline */
    let o: Option[Int] = None
    let n: UInt8 = 200
    let mut names: Vec[Str] = vec_new()
    names.push("x")
    match o {
        Some(x) => println(x),
        None => println(f"{n} {names.len()} {point_sum(p)}"),
    }
    let mut k = 0
    loop {
        k += 1
        if k == 4 { break }
    }
    println(k)
    let v = empty()
    v.push(1)
    v.push(2)
    v.push(3)
    while let Some(x) = popped(v) {
        println(x)
    }
    0
}
"#, "50\n200 1 5\n4\n3\n2\n1\n0")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_question_mark_on_an_option_returns_none_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"fn half(n: Int) -> Option[Int] { if n % 2 == 0 { Some(n / 2) } else { None } }

fn quarter(n: Int) -> Option[Int] {
    let h = half(n)?
    half(h)
}

fn name(n: Int) -> Option[Str] {
    let q = quarter(n)?
    Some(f"q{q}")
}

fn main(out: OutCap) -> Int ! {io} {
    println(match quarter(8) { Some(x) => x, None => 0 - 1 })
    println(match quarter(6) { Some(x) => x, None => 0 - 1 })
    println(match name(12) { Some(s) => s, None => "none" })
    println(match name(2) { Some(s) => s, None => "none" })
    0
}
"#, "2\n-1\nq3\nnone\n0")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn an_array_literal_is_a_sequence_where_one_is_wanted(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"fn total(xs: Vec[Int]) -> Int {
    let mut t = 0
    for x in xs { t += x }
    t
}

fn main(out: OutCap) -> Int ! {io} {
    let v: Vec[Int] = [1, 2, 3]
    v.push(4)
    println(f"{v.len()} {total(v)} {total([10, 20])}")
    let names: Vec[Str] = ["a", "b"]
    println(names[1])
    let none: Vec[Int] = []
    println(none.len())
    let fixed = [7, 8]
    println(fixed[1])
    0
}
"#, "4 10 30\nb\n0\n8\n0")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn strings_add_and_a_loop_of_adds_stays_linear(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let line = agrees(h, r#"fn main(out: OutCap) -> Int ! {io} {
    let name = "world"
    println("Hello, " + name + "!")
    let mut s = ""
    let mut i = 0
    while i < 20000 {
        s += "x"
        i += 1
    }
    let mut t = ""
    t = t + "ab"
    println(f"{str_len(s)} {t}")
    0
}
"#, "Hello, world!\n20000 ab\n0")?;
    let parts = split(line, "strings allocated=");
    let allocated = if strs_len(parts) > 1 {
        let ws = split_whitespace(strs_get(parts, 1));
        if strs_len(ws) > 0 { parse_usize(strs_get(ws, 0)) } else { 0 - 1 }
    } else { 0 - 1 };
    // Doubling: about log2(20000) strings, not one per append.
    check_that(allocated >= 0 && allocated < 64, line)
}

fn first_code_is(h: Caps, src: Str, code: Str, why: Str) -> Result[Int, Str] ! { io, spawn } {
    let got = codes(h, src);
    let first = if strs_len(got) > 0 { strs_get(got, 0) } else { "(none)" };
    let all = str_join(got, ", ");
    check_that(first == code, f"{why}: [{all}]")
}

@test
fn what_the_conveniences_do_not_make_valid_is_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    first_code_is(h, "fn main() -> Int { let s: Int = \"a\"; 0 }\n", "N0300", "a value that is not its written type")?;
    first_code_is(h, "fn main() -> Int { let v: Vec[Int] = [1, \"a\"]; 0 }\n", "N0300", "an element that is not the sequence's")?;
    first_code_is(h, "fn main() -> Int { let s = \"a\" + 1; 0 }\n", "N0304", "`+` on a `Str` and a number")?;
    first_code_is(h, "fn main() -> Int { let v = vec_new(); 0 }\n", "N0354", "a parameter nothing settles")?;
    first_code_is(h, "fn f(o: Option[Int]) -> Int { let x = o?; x }\nfn main() -> Int { f(None) }\n", "N0361", "`?` on an `Option` in a function that does not return one")?;
    first_code_is(h, "fn main() -> Int { /* never closed\n0 }\n", "N0007", "a block comment the file ends inside")?;
    first_code_is(h, "struct P { x: Int }\nimpl P { fn twice(self: P) -> Int { self.x * 2 } }\nfn p_twice(p: P) -> Int { 0 }\nfn main() -> Int { 0 }\n", "N0203", "an impl's method and a function of the name it is given")
}
