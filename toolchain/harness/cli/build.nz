// `nazm build`, end to end: source → executable → run it. Every case compiles a real `.nz` file
// with the real `nazm` binary and executes the result, checked against an explicitly written
// expected result and against the interpreter, at `-O0` and `-O2`. Ported from
// `crates/nazm-cli/tests/build.rs` (R7).
//
// The two tests that hold the backend and the interpreter to every built-in's *shape*
// (`nazm_core::Intrinsic::ALL` with each one's `Shape` and numeric class, to write a program per
// built-in) stay Rust (`tests/stays-rust.txt`): `nazm capabilities` prints the built-ins' names and
// spelled types, not the shapes the program generator needs.

use "@std/json"
use "@std/text"
use "@std/file"
use "@std/env"
use "@std/sort"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/port.nz"
use "../lib/strings.nz"
use "../lib/jsonq.nz"
use "../lib/tree.nz"
use "../lib/host.nz"
use "../lib/differential.nz"

/// How long any subprocess here may take before the test fails: what stops a compiled program
/// that does not terminate from holding the suite.
const DEADLINE_30: Int = 30000;

/// A build: whether it succeeded, its directory and executable, and its run when it failed.
struct Built {
    ok: Bool,
    dir: Str,
    exe: Str,
    out: Ran,
}

/// `prog.nz` holding `body`, in a new directory: the directory.
fn write_program(h: Caps, body: Str) -> Result[Str, Str] ! { io } {
    prog_dir(h, "prog.nz", body)
}

fn build_at(h: Caps, body: Str, opt: Int) -> Result[Built, Str] ! { io, spawn } {
    let dir = write_program(h, body)?;
    let exe = f"{dir}/prog";
    let a = words("build");
    strs_push(a, f"{dir}/prog.nz");
    strs_push(a, "-o");
    strs_push(a, exe);
    strs_push(a, "--opt-level");
    strs_push(a, int_to_str(opt));
    let out = run_within(h, nazm_bin(h.io), a, "", suite_env(h), DEADLINE_30);
    check_that(out.code != TIMED_OUT, "`nazm build` did not terminate within the deadline")?;
    Result[Built, Str].Ok(value: Built(ok: out.code == 0, dir: dir, exe: exe, out: out))
}

/// `build_at`, insisting that it succeeded.
fn built_at(h: Caps, body: Str, opt: Int) -> Result[Built, Str] ! { io, spawn } {
    let b = build_at(h, body, opt)?;
    check_that(b.ok, f"-O{opt} build failed: {ran_show(b.out)}")?;
    Result[Built, Str].Ok(value: b)
}

/// Run a built executable under `bounded_exe`, failing if it outlives the deadline.
fn run_exe(h: Caps, b: Built) -> Result[Ran, Str] ! { io, spawn } {
    let a = strs_new();
    strs_push(a, "-c");
    strs_push(a, bounded_script());
    strs_push(a, b.exe);
    let r = run_within(h, "sh", a, "", suite_env(h), DEADLINE_30);
    check_that(r.code != TIMED_OUT, "the compiled program did not terminate within 30s. A timeout is a failure, not a result — `nazm build` emits no iteration budget, so a miscompiled loop runs forever instead of reporting.")?;
    scratch_remove(h, b.dir);
    Result[Ran, Str].Ok(value: r)
}

fn interpret(h: Caps, body: Str) -> Result[Ran, Str] ! { io, spawn } {
    let dir = write_program(h, body)?;
    let a = words("run --interpret");
    strs_push(a, f"{dir}/prog.nz");
    let r = run_within(h, nazm_bin(h.io), a, "", suite_env(h), DEADLINE_30);
    scratch_remove(h, dir);
    check_that(r.code != TIMED_OUT, "`nazm run` did not terminate within the deadline")?;
    Result[Ran, Str].Ok(value: r)
}

fn program(body: Str) -> Str ! {} {
    f"fn main() -> Int {{\n{body}\n}}\n"
}

/// A program that must succeed, checked against its expected value and the interpreter, at both
/// optimisation levels.
fn expect_value(h: Caps, body: Str, expected: Str) -> Result[Int, Str] ! { io, spawn } {
    expect_source_value(h, program(body), expected)
}

/// `expect_value`, for a whole program rather than `main`'s body.
fn expect_source_value(h: Caps, src: Str, expected: Str) -> Result[Int, Str] ! { io, spawn } {
    let interp = interpret(h, src)?;
    check_that(interp.code == 0, f"the interpreter did not accept this program: {interp.stderr}")?;
    check_that(text_trim(interp.stdout) == expected, f"the *expectation* disagrees with the interpreter — one of them is wrong: {interp.stdout} vs {expected}")?;
    for opt in ints_of2(0, 2) {
        let built = built_at(h, src, opt)?;
        let ran = run_exe(h, built)?;
        check_that(ran.code == 0, f"-O{opt}: {ran_show(ran)}")?;
        check_that(text_trim(ran.stdout) == expected, f"-O{opt}: {ran_show(ran)}")?;
        check_that(text_trim(ran.stdout) == text_trim(interp.stdout), f"-O{opt}: the native program and the interpreter disagree")?;
    }
    ok()
}

fn ints_of2(a: Int, b: Int) -> Ints ! {} {
    let xs = ints_new();
    ints_push(xs, a);
    ints_push(xs, b);
    xs
}

/// A program that must fail at run time with a given code, at both optimisation levels.
fn expect_runtime_error(h: Caps, body: Str, code: Str, message: Str) -> Result[Int, Str] ! { io, spawn } {
    let src = program(body);
    let interp = interpret(h, src)?;
    check_that(interp.code == 2, f"the interpreter did not fail: {ran_show(interp)}")?;
    check_that(text_contains(interp.stderr, code) && text_contains(interp.stderr, message), f"the expectation disagrees with the interpreter: {interp.stderr}")?;
    for opt in ints_of2(0, 2) {
        let built = built_at(h, src, opt)?;
        let ran = run_exe(h, built)?;
        check_that(ran.code == 2, f"-O{opt}: a specified runtime failure must exit 2, not {ran.code}. stderr: {ran.stderr}")?;
        check_that(text_contains(ran.stderr, code), f"-O{opt}: missing diagnostic code {code}: {ran.stderr}")?;
        check_that(text_contains(ran.stderr, message), f"-O{opt}: missing message {message}: {ran.stderr}")?;
        check_that(text_contains(ran.stderr, "prog.nz:"), f"-O{opt}: a runtime error must say where: {ran.stderr}")?;
        check_that(ran.stdout == "", f"-O{opt}: nothing should be printed")?;
    }
    ok()
}

/// `nazm ARGS` (split at spaces), then `extra` appended whole.
fn nz(h: Caps, args: Str, extra: Strs) -> Ran ! { io, spawn } {
    let a = words(args);
    for x in extra {
        strs_push(a, x);
    }
    nazm(h, "", a)
}

fn list1(a: Str) -> Strs ! {} {
    let s = strs_new();
    strs_push(s, a);
    s
}

fn list2(a: Str, b: Str) -> Strs ! {} {
    let s = strs_new();
    strs_push(s, a);
    strs_push(s, b);
    s
}

fn list3(a: Str, b: Str, c: Str) -> Strs ! {} {
    let s = strs_new();
    strs_push(s, a);
    strs_push(s, b);
    strs_push(s, c);
    s
}

/// `nazm build SRC -o EXE` (with `flags` before `-o`), in an environment of `env`.
fn build_cmd(h: Caps, src: Str, flags: Str, exe: Str, env: Strs) -> Ran ! { io, spawn } {
    let a = words("build");
    strs_push(a, src);
    for f in words(flags) {
        strs_push(a, f);
    }
    strs_push(a, "-o");
    strs_push(a, exe);
    run(h, nazm_bin(h.io), a, "", env)
}

/// Every `.ll` file of `dir`, concatenated.
fn emitted_ir(h: Caps, dir: Str) -> Result[Str, Str] ! { io } {
    let parts = strs_new();
    for n in strs_sort(match dir_list(h.io, dir) { Result.Ok(value: xs) => xs, Result.Err(error: e) => strs_new(), }) {
        if text_ends_with(n, ".ll") {
            strs_push(parts, read_text(h, f"{dir}/{n}")?);
        }
    }
    let all = str_join(parts, "");
    check_that(all != "", "no IR was emitted")?;
    Result[Str, Str].Ok(value: all)
}

/// The program unit's own LLVM text.
fn unit_ir(h: Caps, dir: Str) -> Result[Str, Str] ! { io } {
    read_text(h, f"{dir}/prog.m0.ll")
}

/// How many `return` terminators the program's LIR has (N105).
fn lir_returns(h: Caps, path: Str) -> Result[Int, Str] ! { io, spawn } {
    let out = nz(h, "lir --ops", list1(path));
    check_that(out.code == 0, out.stderr)?;
    let mut n = 0;
    for l in text_lines(out.stdout) {
        let t = trim_start_ws(l);
        if text_starts_with(t, "return") || t == "fail" {
            n = n + 1;
        }
    }
    Result[Int, Str].Ok(value: n)
}

/// A file made executable.
fn set_executable(h: Caps, path: Str) -> Result[Int, Str] ! { io, spawn } {
    let a = words("755");
    strs_push(a, path);
    let r = run(h, "chmod", a, "", env_here(h.io));
    check_that(r.code == 0, ran_show(r))
}

// --- successful arithmetic ------------------------------------------------------------------------

@test
fn ordinary_arithmetic_agrees_with_the_interpreter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    1 + 2 * 3 - 4", "3")?;
    expect_value(h, "    (1 + 2) * (3 - 4)", "-3")?;
    expect_value(h, "    100 / 7", "14")?;
    expect_value(h, "    100 % 7", "2")?;
    expect_value(h, "    -(3 * 4)", "-12")
}

@test
fn boundary_values_survive_the_round_trip(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    9223372036854775807", "9223372036854775807")?;
    expect_value(h, "    -9223372036854775808", "-9223372036854775808")?;
    expect_value(h, "    9223372036854775807 - 1", "9223372036854775806")?;
    expect_value(h, "    -9223372036854775808 + 1", "-9223372036854775807")
}

@test
fn negative_division_and_remainder_truncate_toward_zero(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    -7 / 2", "-3")?;
    expect_value(h, "    -7 % 2", "-1")?;
    expect_value(h, "    7 / -2", "-3")?;
    expect_value(h, "    7 % -2", "1")?;
    expect_value(h, "    -7 / -2", "3")?;
    expect_value(h, "    -7 % -2", "-1")
}

@test
fn the_minimum_divided_into_by_minus_one_is_zero_for_remainder(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let a = -9223372036854775808;\n    let b = -1;\n    a % b", "0")
}

@test
fn local_bindings_resolve_and_nest(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let x = 10;\n    let y = 32;\n    x + y", "42")?;
    expect_value(h, "    let a = 2;\n    let b = a * 3;\n    let c = b + a;\n    c", "8")?;
    expect_value(h, "    let x = 1;\n    let y = x + 10;\n    y", "11")
}

// --- each exceptional case, separately -------------------------------------------------------------

@test
fn addition_overflow_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let m = 9223372036854775807;\n    m + 1", "N0400", "this addition overflows `Int`")
}

@test
fn subtraction_overflow_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let m = -9223372036854775808;\n    m - 1", "N0400", "this subtraction overflows `Int`")
}

@test
fn multiplication_overflow_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let m = 9223372036854775807;\n    m * 2", "N0400", "this multiplication overflows `Int`")
}

@test
fn negating_the_minimum_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let m = -9223372036854775808;\n    -m", "N0400", "this negation overflows `Int`")
}

@test
fn division_by_zero_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let z = 0;\n    7 / z", "N0401", "division by zero")
}

@test
fn remainder_by_zero_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let z = 0;\n    7 % z", "N0401", "division by zero")
}

@test
fn the_minimum_divided_by_minus_one_traps(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let a = -9223372036854775808;\n    let b = -1;\n    a / b", "N0400", "this division overflows `Int`")
}

@test
fn the_leftmost_failure_is_the_one_reported(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = program("    let z = 0;\n    let m = 9223372036854775807;\n    (m + 1) / z");
    let interp = interpret(h, src)?;
    check_that(text_contains(interp.stderr, "N0400"), interp.stderr)?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(text_contains(ran.stderr, "N0400"), f"-O{opt}: the right operand's failure was reported first: {ran.stderr}")?;
    }
    ok()
}

@test
fn the_two_implementations_report_the_same_source_position(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = "fn main() -> Int {\n    let z = 0;\n    7 / z\n}\n";
    let interp = interpret(h, src)?;
    check_that(interp.code == 2, ran_show(interp))?;
    check_that(text_contains(interp.stderr, "prog.nz:3:7"), f"the interpreter moved: {interp.stderr}")?;
    let ran = run_exe(h, built_at(h, src, 0)?)?;
    check_that(text_contains(ran.stderr, "prog.nz:3:7"), f"the compiled program points elsewhere: {ran.stderr}")
}

// --- refusals ---------------------------------------------------------------------------------------

/// Everything outside the subset, refused by name and with nothing written.
@test
fn constructs_outside_the_subset_are_refused_and_nothing_is_emitted(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // `main` must still return `Int`, even though `Str` is otherwise native.
    let src = "fn main() -> Str {\n    \"hi\"\n}\n";
    let expected = "a `main` that does not return `Int`";
    let dir = write_program(h, src)?;
    let path = f"{dir}/prog.nz";
    let exe = f"{dir}/prog";
    let out = build_cmd(h, path, "", exe, suite_env(h));
    check_that(out.code == 1, f"{expected}: {out.stderr}")?;
    check_that(text_contains(out.stderr, "N0101"), f"{expected}: {out.stderr}")?;
    check_that(text_contains(out.stderr, expected), f"expected {expected} in: {out.stderr}")?;
    check_that(text_contains(out.stderr, "nazm run"), f"{expected}: a refusal should say what still works: {out.stderr}")?;
    check_that(!file_exists(exe), f"{expected}: an unsupported program produced an executable")?;
    // And the same program still runs under the interpreter.
    let ran = nz(h, "run --interpret", list1(path));
    scratch_remove(h, dir);
    check_that(ran.code == 0, f"{expected}: `nazm run` should still accept it: {ran.stderr}")
}

@test
fn a_program_that_does_not_check_is_a_check_failure_not_a_subset_failure(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    undefined_name\n}\n")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "", f"{dir}/prog", suite_env(h));
    scratch_remove(h, dir);
    check_that(out.code == 1, ran_show(out))?;
    check_that(text_contains(out.stderr, "N0200"), out.stderr)?;
    check_that(!text_contains(out.stderr, "N0101"), f"reported as unsupported: {out.stderr}")
}

@test
fn build_diagnostics_are_available_as_json(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Bool {\n    true\n}\n")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "--json", f"{dir}/prog", suite_env(h));
    scratch_remove(h, dir);
    let first = first_line(out.stderr);
    check_that(text_starts_with(first, "{"), f"not JSON: {first}")?;
    check_that(text_contains(first, "N0101"), first)
}

// --- the toolchain, and the output path --------------------------------------------------------------

@test
fn a_missing_clang_is_reported_as_a_toolchain_problem_not_a_program_problem(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    1 + 1\n}\n")?;
    // Nothing on PATH, so `clang` cannot be found.
    let out = build_cmd(h, f"{dir}/prog.nz", "", f"{dir}/prog", env_set(suite_env(h), "PATH", ""));
    scratch_remove(h, dir);
    check_that(out.code == 4, f"a missing tool must not be reported as a bad program: {out.stderr}")?;
    check_that(text_contains(out.stderr, "clang"), out.stderr)?;
    check_that(text_contains(out.stderr, "nazm run"), f"it should say what still works without clang: {out.stderr}")
}

@test
fn a_failing_clang_is_reported_with_its_own_output(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    1 + 1\n}\n")?;
    scratch_write(h, dir, "bin/clang", "#!/bin/sh\necho 'stub: refusing' >&2\nexit 1\n")?;
    set_executable(h, f"{dir}/bin/clang")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "", f"{dir}/prog", env_set(suite_env(h), "PATH", f"{dir}/bin"));
    scratch_remove(h, dir);
    check_that(out.code == 4, out.stderr)?;
    check_that(text_contains(out.stderr, "stub: refusing"), f"clang's own output was lost: {out.stderr}")?;
    check_that(text_contains(out.stderr, "bug in `nazm build`"), f"IR the compiler generated being rejected is a compiler bug, and should say so: {out.stderr}")
}

@test
fn an_existing_executable_survives_a_failed_build(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    1 + 1\n}\n")?;
    scratch_write(h, dir, "prog", "an earlier, working build")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "", f"{dir}/prog", env_set(suite_env(h), "PATH", ""));
    let kept = read_text(h, f"{dir}/prog")?;
    scratch_remove(h, dir);
    check_that(out.code == 4, ran_show(out))?;
    check_that(kept == "an earlier, working build", "a failed build destroyed the previous executable")
}

@test
fn the_output_may_not_overwrite_the_input(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    1 + 1\n}\n")?;
    let src = f"{dir}/prog.nz";
    let before = read_text(h, src)?;
    let out = build_cmd(h, src, "", src, suite_env(h));
    let after = read_text(h, src)?;
    scratch_remove(h, dir);
    check_that(out.code != 0, out.stderr)?;
    check_that(text_contains(out.stderr, "own source"), out.stderr)?;
    check_that(after == before, "the build overwrote its own source")
}

@test
fn the_generated_ir_can_be_kept_for_inspection(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    1 + 1\n}\n")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "--emit-ir", f"{dir}/prog", suite_env(h));
    check_that(out.code == 0, ran_show(out))?;
    let ir = emitted_ir(h, dir)?;
    scratch_remove(h, dir);
    check_that(text_contains(ir, "@llvm.sadd.with.overflow.i64"), ir)?;
    check_that(!text_contains(ir, " nsw "), "emitted nsw")?;
    check_that(!text_contains(ir, "llvm.trap"), "emitted llvm.trap")
}

@test
fn run_and_check_are_unchanged_by_the_new_subcommand(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let files = words("examples/max.nz examples/sum.nz examples/primes.nz examples/search.nz examples/pipeline.nz");
    let expected = words("25 6074 1060 1723 42925");
    let mut k = 0;
    while k < 5 {
        let file = strs_get(files, k);
        let path = f"{repo_root(h)}/{file}";
        // As a user runs it (R1, 5b.3): each prints its answer and ends with status 0.
        let a = words("run --interpret");
        strs_push(a, path);
        let out = run(h, nazm_bin(h.io), a, "", env_unset(suite_env(h), "NAZM_RESULT_REPORT"));
        check_that(out.code == 0, file)?;
        check_that(out.stdout == f"{strs_get(expected, k)}\n", f"{file}: {out.stdout}")?;
        let c = nz(h, "check", list1(path));
        check_that(c.code == 0, file)?;
        k = k + 1;
    }
    ok()
}

/// The native toolchain is present, asserted separately and first.
@test
fn the_native_toolchain_is_available(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let out = run(h, "clang", words("--version"), "", env_here(h.io));
    check_that(out.code >= 0, f"`clang` is not usable ({out.stderr}). Every compiling test in this file needs it.")?;
    check_that(out.code == 0, f"`clang --version` exited {out.code}")
}

// --- M1b: Bool, comparisons, and value-position if/else -------------------------------------------

@test
fn every_comparison_operator_agrees_with_the_interpreter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Each of the six, with operands on either side of the answer and on it.
    let cases = "< 1 2 1|< 2 2 0|< 3 2 0|<= 1 2 1|<= 2 2 1|<= 3 2 0|> 3 2 1|> 2 2 0|> 1 2 0|>= 3 2 1|>= 2 2 1|>= 1 2 0|== 2 2 1|== 2 3 0|!= 2 3 1|!= 2 2 0";
    for c in text_split(cases, "|") {
        let w = text_split(c, " ");
        expect_value(h, f"    if {strs_get(w, 1)} {strs_get(w, 0)} {strs_get(w, 2)} {{ 1 }} else {{ 0 }}", strs_get(w, 3))?;
    }
    ok()
}

@test
fn comparisons_are_signed_at_the_boundaries(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    if -1 < 1 { 1 } else { 0 }", "1")?;
    expect_value(h, "    if -9223372036854775808 < 9223372036854775807 { 1 } else { 0 }", "1")?;
    expect_value(h, "    if -9223372036854775808 >= 0 { 1 } else { 0 }", "0")?;
    expect_value(h, "    let m = -9223372036854775808;\n    if m == -9223372036854775808 { 1 } else { 0 }", "1")
}

@test
fn bool_locals_and_bool_equality_work(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let t = true;\n    if t { 7 } else { 8 }", "7")?;
    expect_value(h, "    let f = false;\n    if f { 7 } else { 8 }", "8")?;
    expect_value(h, "    if true == true { 1 } else { 0 }", "1")?;
    expect_value(h, "    if true != false { 1 } else { 0 }", "1")?;
    expect_value(h, "    let a = 1 < 2;\n    let b = 3 < 2;\n    if a == b { 1 } else { 0 }", "0")
}

@test
fn both_branch_outcomes_are_reachable(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let n = 5;\n    if n > 0 { n * 2 } else { 0 - n }", "10")?;
    expect_value(h, "    let n = 0 - 5;\n    if n > 0 { n * 2 } else { 0 - n }", "5")
}

@test
fn conditionals_nest_in_conditions_and_in_branches(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let a = 12;\n    let b = 5;\n    if if a > b { a % b == 2 } else { false } { 1 } else { 0 }", "1")?;
    expect_value(h, "    let n = 7;\n    if n > 0 { if n > 5 { 2 } else { 1 } } else { 0 }", "2")?;
    expect_value(h, "    let n = 3;\n    if n > 0 { if n > 5 { 2 } else { 1 } } else { 0 }", "1")?;
    expect_value(h, "    let n = 9;\n    if n > 0 { if n > 5 { if n > 8 { 3 } else { 2 } } else { 1 } } else { 0 }", "3")
}

@test
fn branch_local_bindings_and_shadowing(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let n = 4;\n    if n > 0 { let double = n * 2; double + 1 } else { 0 }", "9")?;
    expect_value(h, "    let x = 1;\n    if true { let x = 100; x } else { x }", "100")?;
    expect_value(h, "    let x = 1;\n    if false { let x = 100; x } else { x }", "1")?;
    expect_value(h, "    let c = true;\n    if c { let v = 10; v } else { let v = 20; v }", "10")
}

@test
fn conditionals_compose_with_arithmetic_and_comparisons(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    1 + if true { 10 } else { 20 }", "11")?;
    expect_value(h, "    (if false { 10 } else { 20 }) * 2", "40")?;
    expect_value(h, "    if (if true { 3 } else { 4 }) < 4 { 1 } else { 0 }", "1")?;
    expect_value(h, "    let a = 6;\n    if a > 0 { a * 7 + 1 } else { 0 }", "43")
}

@test
fn a_failure_in_the_branch_not_taken_does_not_run(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    if true { 1 } else { 1 / 0 }", "1")?;
    expect_value(h, "    if false { 1 / 0 } else { 2 }", "2")?;
    expect_value(h, "    let m = 9223372036854775807;\n    if false { m + 1 } else { 5 }", "5")?;
    expect_value(h, "    let z = 0;\n    let m = -9223372036854775808;\n    if 1 > 2 { m / -1 } else { if 2 > 1 { 42 } else { 7 / z } }", "42")
}

@test
fn a_failure_in_the_branch_taken_reports_correctly(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    if true { 1 / 0 } else { 1 }", "N0401", "division by zero")?;
    expect_runtime_error(h, "    let m = 9223372036854775807;\n    if 1 < 2 { m + 1 } else { 0 }", "N0400", "this addition overflows `Int`")?;
    expect_runtime_error(h, "    let m = -9223372036854775808;\n    if false { 0 } else { m / -1 }", "N0400", "this division overflows `Int`")
}

@test
fn the_failing_branch_reports_its_own_source_position(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = "fn main() -> Int {\n    let z = 0;\n    if true {\n        7 / z\n    } else {\n        1\n    }\n}\n";
    let interp = interpret(h, src)?;
    check_that(interp.code == 2, ran_show(interp))?;
    check_that(text_contains(interp.stderr, "prog.nz:4:11"), interp.stderr)?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(ran.code == 2, f"-O{opt}: {ran_show(ran)}")?;
        check_that(text_contains(ran.stderr, "prog.nz:4:11"), f"-O{opt}: wrong position: {ran.stderr}")?;
    }
    ok()
}

@test
fn among_evaluated_operands_the_first_failure_still_wins(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = program("    let z = 0;\n    let m = 9223372036854775807;\n    if (m + 1) > 0 { 7 / z } else { 0 }");
    let interp = interpret(h, src)?;
    check_that(text_contains(interp.stderr, "N0400"), interp.stderr)?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(text_contains(ran.stderr, "N0400"), f"-O{opt}: the branch's failure was reported before the condition's: {ran.stderr}")?;
    }
    ok()
}

@test
fn the_condition_is_evaluated_exactly_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_runtime_error(h, "    let z = 0;\n    if (7 / z) > 0 { 1 } else { 2 }", "N0401", "division by zero")
}

@test
fn front_end_type_errors_are_not_reported_as_backend_limits(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let srcs = strs_new();
    strs_push(srcs, "fn main() -> Int {\n    if 1 { 2 } else { 3 }\n}\n");
    strs_push(srcs, "fn main() -> Int {\n    if true { 1 } else { false }\n}\n");
    let codes = words("N0301 N0302");
    let mut k = 0;
    while k < 2 {
        let code = strs_get(codes, k);
        let dir = write_program(h, strs_get(srcs, k))?;
        let out = build_cmd(h, f"{dir}/prog.nz", "", f"{dir}/prog", suite_env(h));
        scratch_remove(h, dir);
        check_that(out.code == 1, out.stderr)?;
        check_that(text_contains(out.stderr, code), f"expected {code}: {out.stderr}")?;
        check_that(!text_contains(out.stderr, "N0101"), f"a type error was reported as a backend limit: {out.stderr}")?;
        k = k + 1;
    }
    ok()
}

@test
fn recursion_reached_from_either_branch_compiles(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_source_value(h, "fn f(n: Int) -> Int { if n < 1 { 0 } else { f(n - 1) + 1 } }\nfn main() -> Int {\n    if true { f(3) } else { 0 }\n}\n", "3")?;
    expect_source_value(h, "fn f(n: Int) -> Int { if n < 1 { 0 } else { f(n - 1) + 1 } }\nfn main() -> Int {\n    if false { 0 } else { f(4) }\n}\n", "4")
}

@test
fn a_statement_position_if_compiles_but_other_expression_statements_do_not(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_value(h, "    let mut x = 1;\n    if x > 0 { x = 5; }\n    x", "5")?;
    expect_value(h, "    let mut x = 1;\n    if x > 9 { x = 5; }\n    x", "1")?;
    expect_value(h, "    1 + 1;\n    3", "3")?;
    expect_value(h, "    let mut x = 1;\n    { let y = 2; x = x + y; };\n    x", "3")?;
    expect_value(h, "    { 1 }", "1")
}

@test
fn the_emitted_ir_for_a_conditional_is_well_formed(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    let a = 6;\n    if a > 5 { a * 7 } else { 0 }\n}\n")?;
    let out = build_cmd(h, f"{dir}/prog.nz", "--emit-ir", f"{dir}/prog", suite_env(h));
    check_that(out.code == 0, out.stderr)?;
    let ir = emitted_ir(h, dir)?;
    scratch_remove(h, dir);
    check_that(text_contains(ir, "icmp sgt i64"), ir)?;
    check_that(text_contains(ir, "br i1 %"), ir)?;
    // Since N40 a value crosses MIR blocks in a slot, never a `phi`; the one `phi` is where an
    // invoke's landing pad rejoins its normal path (4.2).
    let mut stored = 0;
    for l in text_lines(ir) {
        check_that(!(text_contains(l, " = phi ") && !text_contains(l, ", %lp.")), l)?;
        if text_starts_with(text_trim(l), "store i64 %") {
            stored = stored + 1;
        }
    }
    check_that(stored >= 2, "each branch stores the value")?;
    check_that(!text_contains(ir, " nsw "), "nsw")?;
    check_that(!text_contains(ir, "llvm.trap"), "llvm.trap")
}

// --- stack safety, out of process -----------------------------------------------------------------

/// `nazm ARGS`, its run.
fn nz_ran(h: Caps, args: Strs) -> Ran ! { io, spawn } {
    nazm(h, "", args)
}

/// Exit 0, and no sign of a panic or a signal.
fn assert_ok(r: Ran, what: Str) -> Result[Int, Str] ! {} {
    assert_no_panic(r, what)?;
    check_that(r.code == 0, f"{what} should have succeeded: {r.stderr}")
}

/// Exit 1 carrying exactly this diagnostic code, and no sign of a panic or a signal.
fn assert_diagnostic(r: Ran, code: Str, what: Str) -> Result[Int, Str] ! {} {
    assert_no_panic(r, what)?;
    check_that(r.code == 1, f"{what} should have been refused with a diagnostic, not exited {r.code}: {r.stderr}")?;
    check_that(text_contains(r.stderr, code), f"{what} should have reported {code}: {r.stderr}")
}

/// A signal death or a Rust panic is never an acceptable outcome, whatever the exit code.
fn assert_no_panic(r: Ran, what: Str) -> Result[Int, Str] ! {} {
    check_that(ended_normally(r), f"{what} was killed by a signal — a depth bound that aborts is not a bound")?;
    check_that(!text_contains(r.stderr, "panicked at") && !text_contains(r.stderr, "RUST_BACKTRACE"), f"{what} panicked: {r.stderr}")?;
    check_that(r.code != 101, f"{what} exited with a panic status")
}

fn chain(n: Int) -> Str ! {} {
    let ones = strs_new();
    let mut i = 0;
    while i < n {
        strs_push(ones, "1");
        i = i + 1;
    }
    f"fn main() -> Int {{\n    {str_join(ones, " + ")}\n}}\n"
}

@test
fn deep_syntax_produces_exactly_the_expected_outcome(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Accepted, and it must *work*.
    let dir = write_program(h, chain(511))?;
    let src = f"{dir}/prog.nz";
    assert_ok(nz_ran(h, list2("check", src)), "`nazm check` on a 511-term chain")?;
    let exe = f"{dir}/prog";
    let b = words("build");
    strs_push(b, src);
    strs_push(b, "-o");
    strs_push(b, exe);
    assert_ok(nz_ran(h, b), "`nazm build` on a 511-term chain")?;
    check_that(file_exists(exe), "the accepted program produced no executable")?;
    let ran = run_exe(h, Built(ok: true, dir: dir, exe: exe, out: Ran(code: 0, stdout: "", stderr: "")))?;
    check_that(ran.code == 0, ran_show(ran))?;
    check_that(text_trim(ran.stdout) == "511", ran.stdout)?;
    // Over the limit: refused, with the nesting diagnostic and nothing else.
    for cmd in words("check build") {
        let d = write_program(h, chain(600))?;
        let s = f"{d}/prog.nz";
        let e = f"{d}/prog";
        let a = strs_new();
        strs_push(a, cmd);
        strs_push(a, s);
        if cmd == "build" {
            strs_push(a, "-o");
            strs_push(a, e);
        }
        let out = nz_ran(h, a);
        let made = file_exists(e);
        scratch_remove(h, d);
        assert_diagnostic(out, "N0102", f"`nazm {cmd}` on a 600-term chain")?;
        check_that(!made, "a refused program produced an executable")?;
    }
    ok()
}

fn nest(n: Int) -> Str ! {} {
    f"fn main() -> Int {{\n{text_repeat("{ ", n)}1{text_repeat(" }", n)}\n}}\n"
}

@test
fn deeply_nested_blocks_check_and_compile(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, nest(255))?;
    let src = f"{dir}/prog.nz";
    let c = strs_new();
    strs_push(c, "check");
    strs_push(c, src);
    assert_ok(nz_ran(h, c), "`nazm check` on 255 nested blocks")?;
    let exe = f"{dir}/prog";
    let b = words("build");
    strs_push(b, src);
    strs_push(b, "-o");
    strs_push(b, exe);
    assert_ok(nz_ran(h, b), "`nazm build` on 255 nested blocks")?;
    let ran = run(h, exe, strs_new(), "", suite_env(h));
    scratch_remove(h, dir);
    check_that(text_trim(ran.stdout) == "1", ran_show(ran))?;
    // Past the limit: the nesting diagnostic, from the parser, before anything else.
    let d2 = write_program(h, nest(400))?;
    let c2 = strs_new();
    strs_push(c2, "check");
    strs_push(c2, f"{d2}/prog.nz");
    let out = nz_ran(h, c2);
    scratch_remove(h, d2);
    assert_diagnostic(out, "N0102", "`nazm check` on 400 nested blocks")
}

/// `nazm check` must not need the native toolchain.
@test
fn check_does_not_need_clang(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_program(h, "fn main() -> Int {\n    if 1 < 2 { 3 } else { 4 }\n}\n")?;
    let a = words("check");
    strs_push(a, f"{dir}/prog.nz");
    let out = run(h, nazm_bin(h.io), a, "", env_set(suite_env(h), "PATH", ""));
    scratch_remove(h, dir);
    check_that(out.code == 0, f"`nazm check` failed with no toolchain on PATH: {out.stderr}")
}

// --- M1c: several functions, and non-recursive direct calls ---------------------------------------

/// A whole program, checked against an expected value and the interpreter at both levels; only the
/// entry wrapper prints.
fn expect_program(h: Caps, src: Str, expected: Str) -> Result[Int, Str] ! { io, spawn } {
    let interp = interpret(h, src)?;
    check_that(interp.code == 0, f"the interpreter did not accept this program: {interp.stderr}")?;
    check_that(text_trim(interp.stdout) == expected, "the expectation disagrees with the interpreter")?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(ran.code == 0, f"-O{opt}: {ran_show(ran)}")?;
        check_that(text_trim(ran.stdout) == expected, f"-O{opt}: {ran_show(ran)}")?;
        // Only the platform wrapper prints.
        check_that(strs_len(text_lines(ran.stdout)) == 1, f"-O{opt}: something other than the entry wrapper produced output: {ran.stdout}")?;
        check_that(ran.stderr == "", f"-O{opt}: unexpected stderr: {ran.stderr}")?;
    }
    ok()
}

@test
fn functions_of_zero_one_and_several_parameters(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "fn answer() -> Int { 42 }\nfn main() -> Int { answer() }\n", "42")?;
    expect_program(h, "fn double(n: Int) -> Int { n * 2 }\nfn main() -> Int { double(21) }\n", "42")?;
    expect_program(h, "fn clamp(v: Int, lo: Int, hi: Int) -> Int {\n    if v < lo { lo } else { if v > hi { hi } else { v } }\n}\nfn main() -> Int { clamp(150, 0, 100) }\n", "100")
}

@test
fn arguments_are_not_swapped(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "fn sub(a: Int, b: Int) -> Int { a - b }\nfn main() -> Int { sub(10, 3) }\n", "7")?;
    expect_program(h, "fn div(a: Int, b: Int) -> Int { a / b }\nfn main() -> Int { div(100, 7) }\n", "14")?;
    expect_program(h, "fn rem(a: Int, b: Int) -> Int { a % b }\nfn main() -> Int { rem(100, 7) }\n", "2")?;
    expect_program(h, "fn mix(a: Int, b: Int, c: Int) -> Int { a * 100 + b * 10 + c }\nfn main() -> Int { mix(1, 2, 3) }\n", "123")
}

@test
fn forward_references_and_shared_helpers(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
