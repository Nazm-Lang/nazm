}

// --- B4: modules ------------------------------------------------------------------------------------

/// A tree of files (name, text, …) in a new directory: the directory; its root is the first file.
fn write_tree(h: Caps, files: Strs) -> Result[Str, Str] ! { io } {
    let d = scratch_new(h);
    let mut i = 0;
    while i + 1 < strs_len(files) {
        scratch_write(h, d, strs_get(files, i), strs_get(files, i + 1))?;
        i = i + 2;
    }
    Result[Str, Str].Ok(value: d)
}

fn files2(a: Str, at: Str, b: Str, bt: Str) -> Strs ! {} {
    let f = strs_new();
    strs_push(f, a);
    strs_push(f, at);
    strs_push(f, b);
    strs_push(f, bt);
    f
}

fn run_root(h: Caps, root: Str) -> Result[Ran, Str] ! { io, spawn } {
    let r = run_within(h, nazm_bin(h.io), list3("run", "--interpret", root), "", suite_env(h), DEADLINE_30);
    check_that(r.code != TIMED_OUT, "the interpreter hung")?;
    Result[Ran, Str].Ok(value: r)
}

/// `nazm build ROOT -o DIR/prog`, then the executable run under `bounded_exe`.
fn build_and_run_root(h: Caps, dir: Str, root: Str) -> Result[Ran, Str] ! { io, spawn } {
    let exe = f"{dir}/prog";
    let a = list3("build", root, "-o");
    strs_push(a, exe);
    let out = run_within(h, nazm_bin(h.io), a, "", suite_env(h), DEADLINE_30);
    check_that(out.code != TIMED_OUT, "the build hung")?;
    check_that(out.code == 0, f"build: {ran_show(out)}")?;
    let sh = strs_new();
    strs_push(sh, "-c");
    strs_push(sh, bounded_script());
    strs_push(sh, exe);
    let r = run_within(h, "sh", sh, "", suite_env(h), DEADLINE_30);
    check_that(r.code != TIMED_OUT, "hung")?;
    Result[Ran, Str].Ok(value: r)
}

@test
fn a_program_can_span_several_files_and_a_diamond_loads_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let f = files2("main.nz", "use \"util.nz\";\nuse \"sub/deep.nz\";\n\nfn main() -> Int { quad(5) * 100 + str_len(greet()) + twice(1) }\n", "util.nz", "pub fn twice(n: Int) -> Int { n * 2 }\npub fn greet() -> Str { \"hello\" }\n");
    strs_push(f, "sub/deep.nz");
    strs_push(f, "use \"../util.nz\";\npub fn quad(n: Int) -> Int { twice(twice(n)) }\n");
    let dir = write_tree(h, f)?;
    let root = f"{dir}/main.nz";
    let interp = run_root(h, root)?;
    check_that(interp.code == 0, interp.stderr)?;
    check_that(text_trim(interp.stdout) == "2007", interp.stdout)?;
    let ran = build_and_run_root(h, dir, root)?;
    scratch_remove(h, dir);
    check_that(ran.code == 0, ran_show(ran))?;
    check_that(text_trim(ran.stdout) == "2007", "the compiled program disagrees")
}

@test
fn an_import_cycle_terminates_and_is_not_an_error(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let dir = write_tree(h, files2("a.nz", "use \"b.nz\";\nfn main() -> Int { from_b() + 1 }\n", "b.nz", "use \"a.nz\";\npub fn from_b() -> Int { 41 }\n"))?;
    let root = f"{dir}/a.nz";
    let interp = run_root(h, root)?;
    check_that(interp.code == 0, interp.stderr)?;
    check_that(text_trim(interp.stdout) == "42", interp.stdout)?;
    let ran = build_and_run_root(h, dir, root)?;
    scratch_remove(h, dir);
    check_that(text_trim(ran.stdout) == "42", ran_show(ran))
}

@test
fn a_diagnostic_in_an_imported_file_names_that_file_and_its_own_line(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
