@test
fn a_failure_inside_a_callee_reports_the_callees_own_position(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = "fn bad(n: Int) -> Int {\n    let z = 0;\n    n / z\n}\nfn main() -> Int {\n    bad(7)\n}\n";
    let interp = interpret(h, src)?;
    check_that(interp.code == 2, ran_show(interp))?;
    check_that(text_contains(interp.stderr, "prog.nz:3:7"), interp.stderr)?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(ran.code == 2, f"-O{opt}: {ran_show(ran)}")?;
        check_that(text_contains(ran.stderr, "N0401"), f"-O{opt}: {ran.stderr}")?;
        check_that(text_contains(ran.stderr, "prog.nz:3:7"), f"-O{opt}: reported the call site instead of the failing operator: {ran.stderr}")?;
        check_that(ran.stdout == "", f"-O{opt}: a failing program printed a result")?;
    }
    ok()
}

@test
fn an_earlier_failing_argument_stops_everything_after_it(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = "fn bad(n: Int) -> Int {\n    let z = 0;\n    n % z\n}\nfn two(a: Int, b: Int) -> Int { a + b }\nfn main() -> Int {\n    let z = 0;\n    let m = 9223372036854775807;\n    two(m + 1, 7 / z)\n}\n";
    let interp = interpret(h, src)?;
    check_that(interp.code == 2, ran_show(interp))?;
    check_that(text_contains(interp.stderr, "N0400"), f"the first argument's overflow should win: {interp.stderr}")?;
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(ran.code == 2, f"-O{opt}")?;
        check_that(text_contains(ran.stderr, "N0400"), f"-O{opt}: a later argument was evaluated first: {ran.stderr}")?;
        check_that(!text_contains(ran.stderr, "N0401"), f"-O{opt}: the second argument ran despite the first failing: {ran.stderr}")?;
    }
    ok()
}

@test
fn a_failing_argument_stops_the_callee_body(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let src = "fn bad(n: Int) -> Int {\n    let z = 0;\n    n / z\n}\nfn main() -> Int {\n    let m = 9223372036854775807;\n    bad(m + 1)\n}\n";
    for opt in ints_of2(0, 2) {
        let ran = run_exe(h, built_at(h, src, opt)?)?;
        check_that(ran.code == 2, f"-O{opt}")?;
        check_that(text_contains(ran.stderr, "N0400"), f"-O{opt}: {ran.stderr}")?;
        check_that(!text_contains(ran.stderr, "N0401"), f"-O{opt}: the callee body ran despite a failing argument: {ran.stderr}")?;
    }
    check_that(text_contains(interpret(h, src)?.stderr, "N0400"), "the interpreter")
}

@test
fn recursion_compiles_and_agrees_with_the_interpreter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
