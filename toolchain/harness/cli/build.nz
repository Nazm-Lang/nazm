}

@test
fn a_record_survives_construction_copy_replacement_and_return_at_both_levels(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "struct Inner {\n    text: Str,\n}\nstruct Outer {\n    inner: Inner,\n    count: Int,\n}\nfn make(n: Int) -> Outer { Outer(inner: Inner(text: int_to_str(n)), count: n) }\nfn returned(n: Int) -> Outer {\n    let o = make(n);\n    return o;\n}\nfn size(o: Outer) -> Int { str_len(o.inner.text) + o.count }\nfn main() -> Int {\n    let mut a = make(5);\n    let b = a;\n    a.inner.text = str_concat(a.inner.text, \"!\");\n    a.count = 6;\n    let c = returned(40);\n    size(a) + size(b) + size(c) + str_len(b.inner.text)\n}\n", "57")
}

@test
fn a_record_field_written_in_a_loop_keeps_the_right_value(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "struct Holder {\n    name: Str,\n    n: Int,\n}\nfn main() -> Int {\n    let mut total = 0;\n    let mut i = 0;\n    while i < 50 {\n        let mut h = Holder(name: int_to_str(i), n: i);\n        h.name = str_concat(h.name, \"x\");\n        total = total + str_len(h.name) + h.n;\n        i = i + 1;\n    }\n    total\n}\n", "1365")
}

// --- enums, at both optimisation levels -------------------------------------------------------------

@test
fn every_variant_shape_agrees_across_the_interpreter_and_both_levels(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "enum Token {\n    Pair(left: Int, right: Int),\n    Eof,\n    Number(value: Int),\n    Name(text: Str),\n}\nfn size(t: Token) -> Int {\n    match t {\n        Token.Eof() => 0,\n        Token.Number(value: n) => n,\n        Token.Name(text: s) => str_len(s),\n        Token.Pair(left: a, right: b) => a + b,\n    }\n}\nfn main() -> Int {\n    size(Token.Eof()) + size(Token.Number(value: 30))\n        + size(Token.Name(text: str_concat(\"ab\", \"cd\")))\n        + size(Token.Pair(left: 3, right: 5))\n}\n", "42")
}

@test
fn a_variant_built_in_a_loop_keeps_the_right_value(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "enum E {\n    Text(value: Str),\n    Count(n: Int),\n}\nfn size(e: E) -> Int { match e { E.Text(value: s) => str_len(s), E.Count(n: n) => n, } }\nfn main() -> Int {\n    let mut total = 0;\n    let mut i = 0;\n    while i < 50 {\n        let e = if i > 24 { E.Text(value: int_to_str(i)) } else { E.Count(n: i) };\n        total = total + size(e);\n        i = i + 1;\n    }\n    total\n}\n", "350")
}

@test
fn a_nested_match_and_a_record_payload_agree_at_both_levels(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "struct Point { x: Int, label: Str, }\nenum Inner { Some(n: Int), None, }\nenum Outer { Wrapped(value: Inner), At(p: Point), Empty, }\nfn depth(o: Outer) -> Int {\n    match o {\n        Outer.Empty() => 0,\n        Outer.At(p: p) => p.x + str_len(p.label),\n        Outer.Wrapped(value: v) => match v { Inner.None() => 1, Inner.Some(n: n) => n, },\n    }\n}\nfn main() -> Int {\n    depth(Outer.Empty()) + depth(Outer.Wrapped(value: Inner.None()))\n        + depth(Outer.Wrapped(value: Inner.Some(n: 30)))\n        + depth(Outer.At(p: Point(x: 9, label: \"ab\")))\n}\n", "42")
}

@test
fn a_payload_returned_from_an_arm_is_valid_at_both_levels(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "enum E {\n    Empty,\n    Text(value: Str),\n}\nfn take(e: E) -> Str { match e { E.Empty() => \"\", E.Text(value: s) => s, } }\nfn main() -> Int {\n    let held = take(E.Text(value: str_concat(\"abcde\", \"fghij\")));\n    let mut i = 0;\n    while i < 100 {\n        let churn = str_concat(\"xxxxxxxxxx\", int_to_str(i));\n        i = i + str_len(churn) - str_len(churn) + 1;\n    }\n    str_len(held) * 100 + str_byte(held, 0)\n}\n", "1097")
}

/// Q1-A1-07: `-o` naming any module of the program — not only the entry — is refused.
@test
fn an_output_over_any_module_of_the_program_is_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let f = files2("nazm.root", "", "util.nz", "pub fn two() -> Int { 2 }\n");
    strs_push(f, "main.nz");
    strs_push(f, "use \"util.nz\";\nfn main() -> Int { two() }\n");
    let d = write_tree(h, f)?;
    let o = nazm(h, d, words("build main.nz -o util.nz"));
    let kept = read_text(h, f"{d}/util.nz")?;
    scratch_remove(h, d);
    check_that(o.code != 0, ran_show(o))?;
    check_that(text_contains(o.stderr, "over its own source"), o.stderr)?;
    check_that(kept == "pub fn two() -> Int { 2 }\n", kept)
}

/// Q1-A1-06: a comma in a shared library's file name is refused.
@test
fn a_shared_library_name_with_a_comma_is_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "lib.nz", "extern \"C\" pub fn twice(n: Int) -> Int ! {} { n * 2 }\n")?;
    let o = nazm(h, d, words("build --lib --shared lib.nz -o libx,-Wl,-sectcreate.dylib"));
    let made = file_exists(f"{d}/libx,-Wl,-sectcreate.dylib");
    scratch_remove(h, d);
    check_that(o.code != 0, ran_show(o))?;
    check_that(text_contains(o.stderr, "may not contain a comma"), o.stderr)?;
    check_that(!made, "the library was written")
}

/// Q1-A1-01: every generated function asks for stack probes.
@test
fn every_generated_function_asks_for_stack_probes(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = write_program(h, "fn inc(n: Int) -> Int { n + 1 }\nfn main() -> Int { inc(1) }\n")?;
    let a = words("build --emit-ir");
    strs_push(a, f"{d}/prog.nz");
    strs_push(a, "-o");
    strs_push(a, "p");
    let o = nazm(h, d, a);
    check_that(o.code == 0, o.stderr)?;
    let mut defines = 0;
    for name in match dir_list(h.io, d) { Result.Ok(value: xs) => xs, Result.Err(error: e) => strs_new(), } {
        // The program's own units (`p.m0.ll`, …).
        let parts = text_split(name, ".");
        let unit = strs_len(parts) > 1 && text_starts_with(strs_get(parts, 1), "m");
        if text_ends_with(name, ".ll") && unit {
            for line in text_lines(read_text(h, f"{d}/{name}")?) {
                if text_starts_with(line, "define ") {
                    defines = defines + 1;
                    check_that(text_contains(line, "\"probe-stack\"=\"inline-asm\""), line)?;
                }
            }
        }
    }
    scratch_remove(h, d);
    check_that(defines > 0, "no definitions")
}

/// Gate 3: when clang fails in the link step because of its environment, the report says so.
/// (`#[cfg(target_os = "macos")]`: the Rust test exists only on macOS, as this one asks.)
@test
fn a_toolchain_environment_failure_is_not_blamed_on_the_ir(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    if uname(h, "-s") != "Darwin" {
        return ok();
    }
    let d = write_program(h, "fn main() -> Int { 0 }\n")?;
    let out = run(h, nazm_bin(h.io), words("build --no-cache prog.nz -o prog"), d, env_set(suite_env(h), "SDKROOT", "/nonexistent/nazm-sdk"));
    scratch_remove(h, d);
    check_that(out.code != 0, out.stderr)?;
    check_that(text_contains(out.stderr, "not about the generated IR"), out.stderr)?;
    check_that(!text_contains(out.stderr, "This is a bug in `nazm build`"), out.stderr)
}
