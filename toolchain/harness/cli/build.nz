    check_that(out.code == 0, out.stderr)?;
    let ir = emitted_ir(h, dir)?;
    scratch_remove(h, dir);
    for absent in text_split("define hidden { ptr, i64 } @nz.read_file|define hidden ptr @nz.cstr|@nz.argv = hidden|@.rb = private", "|") {
