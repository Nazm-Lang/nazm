}

@test
fn calls_nest_and_compose(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "fn inc(n: Int) -> Int { n + 1 }\nfn main() -> Int { inc(inc(inc(0))) }\n", "3")?;
    expect_program(h, "fn f(n: Int) -> Int { n * 3 }\nfn main() -> Int {\n    if f(2) > 5 { f(1) + f(2) } else { 0 }\n}\n", "9")?;
    expect_program(h, "fn add(a: Int, b: Int) -> Int { a + b }\nfn one() -> Int { 1 }\nfn main() -> Int { add(one(), add(one(), one())) }\n", "3")
}

@test
fn bool_travels_through_parameters_and_returns(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect_program(h, "fn is_negative(n: Int) -> Bool { n < 0 }\nfn main() -> Int { if is_negative(0 - 3) { 1 } else { 0 } }\n", "1")?;
    expect_program(h, "fn pick(flag: Bool, a: Int, b: Int) -> Int { if flag { a } else { b } }\nfn main() -> Int { pick(false, 10, 20) }\n", "20")?;
    expect_program(h, "fn gt(a: Int, b: Int) -> Bool { a > b }\nfn both(x: Bool, y: Bool) -> Bool { if x { y } else { false } }\nfn main() -> Int { if both(gt(3, 1), gt(5, 4)) { 7 } else { 8 } }\n", "7")
}

@test
fn calls_in_selected_and_unselected_branches(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
