@test
fn imports_resolve_relative_to_the_importing_file_not_the_working_directory(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let f = files2("app/main.nz", "use \"util.nz\";\nfn main() -> Int { answer() }\n", "app/util.nz", "pub fn answer() -> Int { 42 }\n");
    strs_push(f, "util.nz");
    strs_push(f, "pub fn answer() -> Int { 0 - 1 }\n");
    let dir = write_tree(h, f)?;
    let out = nazm(h, dir, list3("run", "--interpret", f"{dir}/app/main.nz"));
    scratch_remove(h, dir);
    check_that(out.code == 0, out.stderr)?;
    check_that(text_trim(out.stdout) == "42", out.stdout)
}

/// `examples/worker-pool.nz` is the spec's concurrency example, and it terminates with 90.
@test
fn the_spec_worker_pool_example_terminates_and_answers_ninety(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let root = repo_root(h);
    let src = read_text(h, f"{root}/examples/worker-pool.nz")?;
    let spec = read_text(h, f"{root}/docs/user/spec.md")?;
    let fence = "```nazm\nfn worker(jobs: Chan, results: Chan) -> Int {";
    let at = find(spec, fence);
    check_that(at >= 0, "docs/user/spec.md no longer shows the worker-pool example")?;
    let after = str_slice(spec, at + str_len("```nazm\n"), str_len(spec));
    let close = find(after, "```");
    check_that(close >= 0, "unclosed fence")?;
    let block = str_slice(after, 0, close);
    check_that(trim_end_ws(block) == trim_end_ws(src), "docs/user/spec.md and examples/worker-pool.nz have drifted. The spec is meant to show the program that is actually run.")?;
    // It prints 90 (R1, 5b.3); the result report the suite sets adds `main`'s 0.
    let ran = interpret(h, src)?;
    check_that(ran.code == 0, f"interpreted: {ran.stderr}")?;
    check_that(text_trim(ran.stdout) == "90\n0", "interpreted")?;
    for opt in ints_of2(0, 2) {
        let b = build_at(h, src, opt)?;
        check_that(b.ok, f"-O{opt} did not compile: {b.out.stderr}")?;
        let r = run_exe(h, b)?;
        check_that(r.code == 0, f"-O{opt}: {r.stderr}")?;
        check_that(text_trim(r.stdout) == "90\n0", f"-O{opt}")?;
    }
    ok()
}

