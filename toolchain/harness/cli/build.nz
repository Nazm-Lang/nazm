    expect_program(h, "fn ok(n: Int) -> Int { n + 1 }\nfn boom(n: Int) -> Int { n / 0 }\nfn main() -> Int { if 2 > 1 { ok(1) } else { boom(1) } }\n", "2")?;
    expect_program(h, "fn positive(n: Int) -> Bool { n > 0 }\nfn main() -> Int { if positive(3) { 1 } else { 0 } }\n", "1")
}

