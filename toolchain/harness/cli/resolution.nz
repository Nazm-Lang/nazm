// Name resolution happens once: what the checker resolved is what the backend lowers — shadowing,
// scopes, modules — each program run both ways and required to agree, or refused by the checker.
// Ported from `crates/nazm-cli/tests/resolution.rs` (R7).

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/differential.nz"

fn ok() -> Result[Int, Str] ! {} {
    Result[Int, Str].Ok(value: 0)
}

/// The files `files` names (name, text, name, text, …) in a fresh directory.
fn written(h: Caps, files: Strs) -> Result[Str, Str] ! { io } {
    let d = scratch_new(h);
    let mut i = 0;
    while i + 1 < strs_len(files) {
        scratch_write(h, d, strs_get(files, i), strs_get(files, i + 1))?;
        i = i + 2;
    }
    Result[Str, Str].Ok(value: d)
}

fn both_ways_in(h: Caps, d: Str, root: Str) -> Result[Str, Str] ! { io, spawn } {
    let interpreted = nazm(h, d, words(f"run --interpret {root}"));
    check_that(interpreted.code == 0, f"interpreted: {interpreted.stderr}")?;
    let built = nazm(h, d, words(f"build {root} -o {d}/prog"));
    check_that(built.code == 0, f"compiled: {built.stderr}")?;
    let ran = run(h, f"{d}/prog", strs_new(), d, suite_env(h));
    check_that(ran.code == 0, "the compiled program failed")?;
    let a = text_trim(interpreted.stdout);
    let b = text_trim(ran.stdout);
    check_that(a == b, f"the two consumers disagree about what a name means: {a} vs {b}")?;
    Result[Str, Str].Ok(value: a)
}

/// Run a program interpreted and compiled, and require one answer.
fn both_ways(h: Caps, files: Strs) -> Result[Str, Str] ! { io, spawn } {
    let d = written(h, files)?;
    let r = both_ways_in(h, d, f"{d}/{strs_get(files, 0)}");
    scratch_remove(h, d);
    r
}

/// Check a program; return its diagnostics and exit code.
fn check(h: Caps, files: Strs) -> Result[(Str, Int), Str] ! { io, spawn } {
    let d = written(h, files)?;
    let out = nazm(h, d, words(f"check {d}/{strs_get(files, 0)}"));
    scratch_remove(h, d);
    let code = if out.code >= 0 && out.code < 256 { out.code } else { 0 - 1 };
    Result[(Str, Int), Str].Ok(value: (out.stderr, code))
}

/// Check and require it to pass.
fn accepted(h: Caps, files: Strs) -> Result[Int, Str] ! { io, spawn } {
    let (stderr, code) = check(h, files)?;
    check_that(code == 0, stderr)
}

/// Check and require exactly this code, once.
fn refused(h: Caps, files: Strs, code_wanted: Str) -> Result[Str, Str] ! { io, spawn } {
    let (stderr, code) = check(h, files)?;
    check_that(code == 1, f"expected a refusal, got:\n{stderr}")?;
    check_that(text_contains(stderr, code_wanted), f"expected {code_wanted}, got:\n{stderr}")?;
    Result[Str, Str].Ok(value: stderr)
}

@test
fn a_shadowing_binding_is_a_different_slot_in_both(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The case where one slot allocator would be visibly wrong: the inner `x` must not
    // overwrite the outer one, so the answer is 1 and not 2.
    let l1 = strs_new();
    strs_push(l1, "main.nz");
    strs_push(l1, "fn main() -> Int {\n    let x = 1;\n    if true { let x = 2; x } else { 0 };\n    x\n}\n");
    let out = both_ways(h, l1)?;
    check_that(out == "1", "assert_eq!(out, \"1\");")?;
    ok()
}

@test
fn a_parameter_shadowed_by_a_let_keeps_the_parameters_slot_live(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // `let x = x + 1` reads the parameter and binds a new one. Sharing storage would
    // read the value being written.
    let l2 = strs_new();
    strs_push(l2, "main.nz");
    strs_push(l2, "fn f(x: Int) -> Int { let x = x + 1; x }\nfn main() -> Int { f(41) }\n");
    let out = both_ways(h, l2)?;
    check_that(out == "42", "assert_eq!(out, \"42\");")?;
    ok()
}

@test
fn a_forward_reference_resolves_in_both(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l3 = strs_new();
    strs_push(l3, "main.nz");
    strs_push(l3, "fn main() -> Int { later() }\nfn later() -> Int { 7 }\n");
    let out = both_ways(h, l3)?;
    check_that(out == "7", "assert_eq!(out, \"7\");")?;
    ok()
}

@test
fn a_call_into_an_imported_file_resolves_in_both(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l4 = strs_new();
    strs_push(l4, "main.nz");
    strs_push(l4, "use \"lib.nz\";\nfn main() -> Int { twice(3) }\n");
    strs_push(l4, "lib.nz");
    strs_push(l4, "pub fn twice(n: Int) -> Int { n + n }\n");
    let out = both_ways(h, l4)?;
    check_that(out == "6", "assert_eq!(out, \"6\");")?;
    ok()
}

@test
fn a_diamond_import_resolves_to_one_definition_in_both(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l5 = strs_new();
    strs_push(l5, "main.nz");
    strs_push(l5, "use \"left.nz\";\nuse \"right.nz\";\nfn main() -> Int { l() + r() }\n");
    strs_push(l5, "left.nz");
    strs_push(l5, "use \"shared.nz\";\npub fn l() -> Int { s() }\n");
    strs_push(l5, "right.nz");
    strs_push(l5, "use \"shared.nz\";\npub fn r() -> Int { s() }\n");
    strs_push(l5, "shared.nz");
    strs_push(l5, "pub fn s() -> Int { 21 }\n");
    let out = both_ways(h, l5)?;
    check_that(out == "42", "assert_eq!(out, \"42\");")?;
    ok()
}

@test
fn a_local_does_not_shadow_a_function_of_the_same_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Functions live in their own namespace. A local `f` must not make `f()` mean the
    // local — which is the rule the backend used to restate for itself.
    let l6 = strs_new();
    strs_push(l6, "main.nz");
    strs_push(l6, "fn f() -> Int { 5 }\nfn main() -> Int { let f = 1; f() + f }\n");
    let out = both_ways(h, l6)?;
    check_that(out == "6", "assert_eq!(out, \"6\");")?;
    ok()
}

@test
fn a_builtin_resolves_before_a_user_function_could(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Built-ins share the ordinary function namespace and are resolved first. Both
    // consumers read that decision rather than each applying the rule.
    let l7 = strs_new();
    strs_push(l7, "main.nz");
    strs_push(l7, "fn main() -> Int { str_len(\"abcd\") }\n");
    let out = both_ways(h, l7)?;
    check_that(out == "4", "assert_eq!(out, \"4\");")?;
    ok()
}

@test
fn redefining_a_builtin_is_refused_by_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l8 = strs_new();
    strs_push(l8, "main.nz");
    strs_push(l8, "fn str_len(s: Str) -> Int { 0 }\nfn main() -> Int { 1 }\n");
    let (stderr, code) = check(h, l8)?;
    check_that(code == 1, stderr)?;
    check_that(text_contains(stderr, "N0203"), stderr)?;
    check_that(text_contains(stderr, "built-in"), stderr)?;
    ok()
}

@test
fn two_functions_with_one_name_are_refused_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l9 = strs_new();
    strs_push(l9, "main.nz");
    strs_push(l9, "fn g() -> Int { 1 }\nfn g() -> Int { 2 }\nfn main() -> Int { g() }\n");
    let (stderr, code) = check(h, l9)?;
    check_that(code == 1, stderr)?;
    check_that(count_matches(stderr, "N0203") == 1, stderr)?;
    ok()
}

@test
fn two_lets_of_one_name_in_one_scope_are_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l10 = strs_new();
    strs_push(l10, "main.nz");
    strs_push(l10, "fn main() -> Int { let x = 1; let x = 2; x }\n");
    let (stderr, code) = check(h, l10)?;
    check_that(code == 1, stderr)?;
    check_that(text_contains(stderr, "N0202"), stderr)?;
    ok()
}

@test
fn two_modules_may_each_own_a_private_function_of_the_same_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Changed by N2, 2026-09-22. This was `a_duplicate_function_across_files_is_still_one
    // _conflict`, and it was right about the language it was written for: every top-level
    // name was in one namespace, so `dup` in two files was `N0203`. Owning your names is
    // the whole of what a module is, and a module system in which this failed would be a
    // naming convention.
    let l11 = strs_new();
    strs_push(l11, "main.nz");
    strs_push(l11, "use \"lib.nz\";\nfn dup() -> Int { 1 }\nfn main() -> Int { dup() + twice() }\n");
    strs_push(l11, "lib.nz");
    strs_push(l11, "pub fn twice() -> Int { dup() * 2 }\nfn dup() -> Int { 20 }\n");
    let out = both_ways(h, l11)?;
    // 1 from the root's `dup`, 40 from lib's — which is the point: `dup()` in lib.nz
    // means lib.nz's, and the root's call means the root's.
    check_that(out == "41", "assert_eq!(out, \"41\");")?;
    ok()
}

@test
fn a_duplicate_function_within_one_module_is_still_one_conflict(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let l12 = strs_new();
    strs_push(l12, "main.nz");
    strs_push(l12, "fn dup() -> Int { 1 }\nfn dup() -> Int { 2 }\nfn main() -> Int { dup() }\n");
    let (stderr, code) = check(h, l12)?;
    check_that(code == 1, stderr)?;
    check_that(text_contains(stderr, "N0203"), stderr)?;
    ok()
}

