@test
fn a_package_tool_edits_a_json_manifest_with_the_library_alone(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    representative(h, "pkgtool", words("extra"), "src/main.nz nz\nsrc/util/fmt.nz nz\nsrc/tool \n{\"name\":\"demo\",\"deps\":[\"core\",\"extra\"],\"modules\":[\"src/main.nz\",\"src/util/fmt.nz\",\"src/tool\"]}\n0\n")?;
    ok()
}

@test
fn every_public_standard_item_is_in_the_1_0_manifest(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The surface, regenerated from the modules exactly as `library/std/API-1.0` was written.
    let std_dir = f"{repo_root(h)}/library/std";
    let generated = surface(h, std_dir)?;
    let manifest = read_text(h, f"{std_dir}/API-1.0")?;
    let listed = strs_new();
    for l in lines(manifest) {
        if !text_starts_with(l, "#") && str_len(l) > 0 {
            strs_push(listed, l);
        }
    }
    check_that(str_join(listed, "\n") == str_join(generated, "\n"), "the public surface moved: 1.x may add a line to library/std/API-1.0, never remove or change one")?;
    check_that(strs_len(listed) >= 120, f"{strs_len(listed)}")?;
    ok()
}

