@test
fn entropy_needs_a_random_cap_and_a_seeded_generator_needs_none(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let a = codes_of(h, one_file(ENTROPY_UNHELD))?;
    check_that(a == "N0369", a)?;
    let b = codes_of(h, one_file(SEEDED_PURE))?;
    check_that(b == "", b)
}

@test
fn log_records_are_one_json_object_a_line_alike_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let want = f"{LOG_1}\n{LOG_2}\n{LOG_3}";
    for r in four(h, one_file(LOG), strs_new())? {
        check_that(r.ran.code == 0, f"{r.name}: {r.ran.stderr}")?;
        check_that(r.ran.stdout == "span written\n0\n", f"{r.name}: {r.ran.stdout}")?;
        // A span's duration is the clock's; everything else is the program's.
        let records = strs_new();
        for l in text_lines(r.ran.stderr) {
            if text_starts_with(l, "{") {
                let at = find(l, "\"ns\":");
                strs_push(records, if at >= 0 { f"{str_slice(l, 0, at)}\"ns\":N}}" } else { l });
            }
        }
        check_that(str_join(records, "\n") == want, f"{r.name}: {str_join(records, "\n")}")?;
    }
    ok()
}

