const ERRORS: Str = "use \"@std/ioerror\";\nuse \"@std/error\";\nuse \"@std/file\";\nfn load(io: IoCap, path: Str) -> Result[Int, Error] ! { io } {\n    let b = error_io_result(file_read_all(io, path))?;\n    Result[Int, Error].Ok(value: bytes_len(b))\n}\nfn config(io: IoCap) -> Result[Int, Error] ! { io } {\n    match load(io, \"missing.cfg\") {\n        Result.Ok(value: n) => Result[Int, Error].Ok(value: n),\n        Result.Err(error: e) => Result[Int, Error].Err(error: error_context(e, \"loading the configuration\")),\n    }\n}\nfn main(io: IoCap) -> Int {\n    match config(io) {\n        Result.Ok(value: n) => print(\"loaded\\n\"),\n        Result.Err(error: e) => print(str_concat(error_show(e), \"\\n\")),\n    };\n    print(str_concat(error_show(error_context(error_context(error_new(\"bad digit\"), \"line 3\"), \"reading the table\")), \"\\n\"));\n    print(str_concat(io_kind_name(io_error_from_errno(2).kind), \"\\n\"));\n    0\n}\n";
const ERRORS_WANT: Str = "loading the configuration: No such file or directory (NotFound)\nreading the table: line 3: bad digit\nNotFound\n0\n";
const JSON_FLOATS: Str = "use \"@std/json\";\nfn line(out: OutCap, s: Str) -> Int { print(str_concat(s, \"\\n\")) }\nfn main(out: OutCap) -> Int {\n    match json_parse(\"[1, 2.5]\") { Result.Ok(value: d) => line(out, \"accepted\"), Result.Err(error: e) => line(out, e) };\n    match json_parse_floats(\"{\\\"a\\\": [1, 2.5, -0.125e2, 1e400, 12345678901234567890], \\\"b\\\": {}, \\\"c\\\": []}\") {\n        Result.Ok(value: d) => {\n            line(out, json_encode(d));\n            line(out, json_encode_pretty(d));\n            let a = match json_get(d, json_root(d), \"a\") { Option.Some(value: n) => n, Option.None() => 0 - 1 };\n            let x = match json_at(d, a, 1) { Option.Some(value: n) => n, Option.None() => 0 - 1 };\n            line(out, match json_float(d, x) { Option.Some(value: f) => num_to_str(f), Option.None() => \"none\" });\n            line(out, match json_int(d, x) { Option.Some(value: i) => int_to_str(i), Option.None() => \"not an integer\" });\n            line(out, json_kind(d, x));\n        },\n        Result.Err(error: e) => line(out, e),\n    };\n    match json_parse_floats(\"[01.5]\") { Result.Ok(value: d) => line(out, \"accepted\"), Result.Err(error: e) => line(out, e) };\n    match json_parse_floats(\"[1.]\") { Result.Ok(value: d) => line(out, \"accepted\"), Result.Err(error: e) => line(out, e) };\n    let d = json_new();\n    let n = json_add_float(d, 3.0);\n    line(out, json_encode(json_with_root(d, n)));\n    0\n}\n";
const JSON_FLOATS_WANT: Str = "a number with a fraction or exponent is not supported at byte 5\n{\"a\":[1,2.5,-12.5,null,12345678901234567000.0],\"b\":{},\"c\":[]}\n{\n  \"a\": [\n    1,\n    2.5,\n    -12.5,\n    null,\n    12345678901234567000.0\n  ],\n  \"b\": {},\n  \"c\": []\n}\n2.5\nnot an integer\nnumber\na number with a leading zero at byte 3\nexpected a digit after the point at byte 3\n3.0\n0\n";
const BINARY: Str = "use \"@std/binary\";\nfn line(out: OutCap, s: Str) -> Int { print(str_concat(s, \"\\n\")) }\nfn hex(b: Bytes) -> Str {\n    let digits = \"0123456789abcdef\";\n    let mut out = \"\";\n    let mut i = 0;\n    while i < bytes_len(b) {\n        let v = Int(bytes_get(b, i));\n        out = str_concat(out, str_concat(str_slice(digits, v / 16, v / 16 + 1), str_slice(digits, v % 16, v % 16 + 1)));\n        i = i + 1;\n    }\n    out\n}\nfn main(out: OutCap) -> Int {\n    let w = binary_writer();\n    binary_put_u8(w, UInt8(255));\n    binary_put_u16_be(w, UInt16(0x1234));\n    binary_put_u32_le(w, UInt32(0xDEADBEEF));\n    binary_put_i64_be(w, 0 - 2);\n    binary_put_f64_le(w, 1.5);\n    binary_put_varint(w, UInt64(300));\n    binary_put_varint(w, UInt64(18446744073709551615));\n    binary_put_zigzag(w, 0 - 1);\n    binary_put_zigzag(w, 0 - 9223372036854775807 - 1);\n    binary_put_str(w, \"héllo\");\n    let b = binary_finish(w);\n    line(out, hex(b));\n    line(out, int_to_str(binary_len(w)));\n    let r = binary_reader(b);\n    line(out, match binary_get_u8(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_u16_be(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_u32_le(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_i64_be(r) { Result.Ok(value: v) => int_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_f64_le(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_varint(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_varint(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_zigzag(r) { Result.Ok(value: v) => int_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_zigzag(r) { Result.Ok(value: v) => int_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_str(r) { Result.Ok(value: v) => v, Result.Err(error: e) => e });\n    line(out, int_to_str(binary_remaining(r)));\n    line(out, match binary_get_u8(r) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    let bad = binary_reader(bytes_from_str(\"\\x7f\"));\n    let over = bytes_new(11);\n    let mut i = 0;\n    while i < 10 { bytes_set(over, i, UInt8(255)); i = i + 1; }\n    line(out, match binary_get_varint(binary_reader(over)) { Result.Ok(value: v) => num_to_str(v), Result.Err(error: e) => e });\n    line(out, match binary_get_bytes(bad) { Result.Ok(value: v) => \"bytes\", Result.Err(error: e) => e });\n    0\n}\n";
const BINARY_WANT: Str = "ff1234efbeaddefffffffffffffffe000000000000f83fac02ffffffffffffffffff0101ffffffffffffffffff010668c3a96c6c6f\n53\n255\n4660\n3735928559\n-2\n1.5\n300\n18446744073709551615\n-1\n-9223372036854775808\nhéllo\n0\na byte needs more bytes than are left at byte 53\na varint past 64 bits at byte 0\na length longer than the data at byte 1\n0\n";
const RANDOM: Str = "use \"@std/random\";\nfn line(out: OutCap, s: Str) -> Int { print(str_concat(s, \"\\n\")) }\nfn main(out: OutCap, rc: RandomCap) -> Int {\n    let r = random_new(UInt64(42));\n    line(out, num_to_str(random_u64(r)));\n    line(out, num_to_str(random_u64(r)));\n    line(out, num_to_str(random_u64(r)));\n    let mut counts = ints_new();\n    let mut k = 0;\n    while k < 6 { ints_push(counts, 0); k = k + 1; }\n    let mut i = 0;\n    while i < 6000 { let d = random_int(r, 0, 6); ints_set(counts, d, ints_get(counts, d) + 1); i = i + 1; }\n    let mut fair = true;\n    let mut j = 0;\n    while j < 6 { if ints_get(counts, j) < 850 || ints_get(counts, j) > 1150 { fair = false; } j = j + 1; }\n    line(out, if fair { \"fair\" } else { \"unfair\" });\n    let f = random_float(r);\n    line(out, if f >= 0.0 && f < 1.0 { \"in [0, 1)\" } else { \"out of range\" });\n    let v = vec_new[Int]();\n    let mut n = 0;\n    while n < 10 { vec_push(v, n); n = n + 1; }\n    random_shuffle(random_new(UInt64(7)), v);\n    let mut s = \"\";\n    let mut m = 0;\n    while m < 10 { s = str_concat(s, int_to_str(vec_get(v, m))); m = m + 1; }\n    line(out, s);\n    let a = random_seed(rc);\n    let b = random_seed(rc);\n    line(out, if a != b { \"two seeds differ\" } else { \"the same seed twice\" });\n    let buf = bytes_new(1000);\n    line(out, match random_bytes(rc, buf) { Result.Ok(value: k2) => int_to_str(k2), Result.Err(error: e) => e });\n    0\n}\n";
const RANDOM_WANT: Str = "1546998764402558742\n6990951692964543102\n12544586762248559009\nfair\nin [0, 1)\n8390721654\ntwo seeds differ\n1000\n0\n";
