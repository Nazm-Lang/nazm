// N45: the standard library — `use "@std/…"`. Each standard module is found by name and only by
// name; its functions behave as documented at their edges under the interpreter, both
// optimisation levels of the LLVM backend and the Cranelift backend, and reclaim everything; the
// ones reaching the outside world need the authority their signatures show and carry the origins
// of what they read; ordinary failure is a value; the spec's example runs; every public function
// is documented where the spec lists it. The cost measurement is `#[ignore]`d in Rust and stays
// there (design decision 10). Ported from `crates/nazm-cli/tests/stdlib.rs` (R7); the programs and
// expected lines are the Rust test's, carried over byte for byte.

use "@std/json"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/port.nz"
use "../lib/jsonq.nz"
use "../lib/tree.nz"
use "../lib/differential.nz"

const CACHED_PROG: Str = "use \"@std/text\";\nuse \"@std/seq\";\nfn main() -> Int { str_len(text_trim(\" a \")) }\n";
const SHOUT_LIB: Str = "use \"@std/text\";\npub fn shout(s: Str) -> Str ! {} { str_concat(text_trim(s), \"!\") }\n";
const SHOUT_PROG: Str = "use \"lib.nz\";\nuse \"@std/text\";\nfn main(io: IoCap) -> Int { print(shout(\"  hi \")); print(text_repeat(\"-\", 2)); 0 }\n";
const CLASH: Str = "use \"@std/text\";\nfn text_trim(s: Str) -> Str { s }\nfn main() -> Int { 0 }\n";
const COLLECTIONS: Str = "use \"@std/hash\";\nuse \"@std/hashmap\";\nuse \"@std/hashset\";\nuse \"@std/deque\";\n\nstruct Point { x: Int, y: Int, }\n\nimpl Hash for Point {\n    fn hash(self: Point) -> UInt64 ! {} { hash_combine(self.x.hash(), self.y.hash()) }\n    fn same(self: Point, other: Point) -> Bool ! {} { self == other }\n}\n\nfn show(out: OutCap, s: Str) -> Int ! {io} { print(str_concat(s, \"\\n\")) }\n\nfn get_or(m: HashMap[Str, Int], k: Str) -> Int {\n    match hashmap_get(m, k) {\n        Option.Some(value: v) => v,\n        Option.None() => 0 - 1,\n    }\n}\n\nfn main(out: OutCap) -> Int ! {io} {\n    let m = hashmap_new[Str, Int]();\n    hashmap_set(m, \"one\", 1);\n    hashmap_set(m, \"two\", 2);\n    if hashmap_set(m, \"one\", 11) { show(out, \"replaced\"); } else { show(out, \"new\"); };\n    show(out, int_to_str(get_or(m, \"one\") + get_or(m, \"two\") + get_or(m, \"three\")));\n    let big = hashmap_new[Int, Int]();\n    let mut i = 0;\n    while i < 1000 {\n        hashmap_set(big, i, i * i);\n        i = i + 1;\n    }\n    let mut j = 0;\n    while j < 1000 {\n        if j % 3 == 0 { hashmap_remove(big, j); };\n        j = j + 1;\n    }\n    let mut total = 0;\n    let vs = hashmap_values(big);\n    let mut k = 0;\n    while k < vec_len(vs) { total = total + vec_get(vs, k); k = k + 1; }\n    show(out, int_to_str(hashmap_len(big)));\n    show(out, int_to_str(total));\n    hashmap_set(big, 3, 7);\n    show(out, int_to_str(hashmap_len(big)));\n    let pts = hashset_new[Point]();\n    hashset_add(pts, Point(x: 1, y: 2));\n    if hashset_add(pts, Point(x: 1, y: 2)) { show(out, \"added twice\"); } else { show(out, \"already there\"); };\n    hashset_add(pts, Point(x: 2, y: 1));\n    show(out, int_to_str(hashset_len(pts)));\n    if hashset_has(pts, Point(x: 2, y: 1)) && !hashset_has(pts, Point(x: 3, y: 3)) { show(out, \"set ok\"); } else { show(out, \"set wrong\"); };\n    show(out, num_to_str(hash_bytes(\"\")));\n    show(out, num_to_str(hash_bytes(\"nazm\")));\n    show(out, num_to_str(UInt8(7).hash()));\n    let d = deque_new[Int]();\n    let mut n = 0;\n    while n < 10 {\n        deque_push_back(d, n);\n        deque_push_front(d, 0 - n);\n        n = n + 1;\n    }\n    let mut line = \"\";\n    let mut p = 0;\n    while p < deque_len(d) {\n        match deque_get(d, p) {\n            Option.Some(value: v) => { line = str_concat(line, str_concat(int_to_str(v), \" \")); },\n            Option.None() => {},\n        };\n        p = p + 1;\n    }\n    show(out, line);\n    match deque_pop_front(d) { Option.Some(value: v) => show(out, int_to_str(v)), Option.None() => show(out, \"empty\"), };\n    match deque_pop_back(d) { Option.Some(value: v) => show(out, int_to_str(v)), Option.None() => show(out, \"empty\"), };\n    show(out, int_to_str(deque_len(d)));\n    0\n}\n";
