const IO_PROG: Str = "use \"@std/io\";\nuse \"@std/process\";\nuse \"@std/result\";\nfn main(io: IoCap) -> Int {\n    io_println(io, result_unwrap_or(io_read(io, \"data.txt\"), \"missing\"));\n    match io_read(io, \"absent.txt\") { Result.Ok(value: v) => io_println(io, v), Result.Err(error: e) => io_eprintln(io, e) };\n    let args = process_args(io);\n    io_println(io, str_join(args, \"+\"));\n    strs_len(args)\n}\n";
const IO_UNDECLARED: Str = "use \"@std/io\";\nfn f(io: IoCap) -> Int ! {} { io_println(io, \"x\") }\nfn main(io: IoCap) -> Int { f(io) }\n";
const IO_UNHELD: Str = "use \"@std/process\";\nfn main() -> Int { strs_len(process_args(0)) }\n";
const ORIGIN_READ: Str = "use \"@std/io\";\nuse \"@std/result\";\nfn save(io: IoCap) -> Int ! { io } { let p = result_unwrap_or(io_read(io, \"cfg\"), \"out\"); write_file(p, \"x\") }\nfn main(io: IoCap) -> Int { save(io) }\n";
const ORIGIN_THROUGH: Str = "use \"@std/text\";\nfn save(io: IoCap) -> Int ! { io } { let p = text_trim(read_file(\"cfg\")); write_file(p, \"x\") }\nfn main(io: IoCap) -> Int { save(io) }\n";
const ORIGIN_COMPUTED: Str = "use \"@std/text\";\nfn save(io: IoCap) -> Int ! { io } { let p = text_trim(\"  out.txt \"); write_file(p, \"x\") }\nfn main(io: IoCap) -> Int { save(io) }\n";
const CHAN_PROG: Str = "use \"@std/chan\";\nuse \"@std/option\";\nfn produce(c: Chan, n: Int) -> Int { let mut i = 1; while i <= n { chan_send(c, i); i = i + 1; } chan_close(c); 0 }\nfn main(t: SpawnCap) -> Int { let c = chan_new(2); let mut total = 0; let mut more = true;\nscope { spawn produce(c, 100); while more { match chan_take(c) { Option.Some(value: v) => { total = total + v; }, Option.None() => { more = false; } } } }\ntotal }\n";

const MODULES: Str = "args binary bitset blake3 bytebuf chan deque env error file fmt fs hash hashmap hashset io ioerror json log map net num option ordmap path process random regex result seq sha256 show sort test text time toml";

/// A run's name and what it did.
struct Run {
    name: Str,
    ran: Ran,
}

/// `files` (name, text, …) written to a directory, `prog.nz` run by the interpreter and three
/// native builds, each given `args`.
fn four(h: Caps, files: Strs, args: Strs) -> Result[Vec[Run], Str] ! { io, spawn } {
    let d = scratch_new(h);
    let mut i = 0;
    while i + 1 < strs_len(files) {
        scratch_write(h, d, strs_get(files, i), strs_get(files, i + 1))?;
        i = i + 2;
    }
    let path = f"{d}/prog.nz";
    let out = vec_new[Run]();
    let a = words("run --interpret");
    strs_push(a, path);
    strs_push(a, "--");
    for x in args {
        strs_push(a, x);
    }
    vec_push(out, Run(name: "interpreter", ran: nazm(h, d, a)));
    for case in text_split("llvm -O0|llvm|0;llvm -O2|llvm|2;cranelift|cranelift|0", ";") {
        let f = text_split(case, "|");
        let which = strs_get(f, 0);
        let exe = f"{d}/{text_replace(text_replace(which, " ", ""), "-", "")}";
        let b = nazm(h, d, words(f"build --no-cache --backend {strs_get(f, 1)} --opt-level {strs_get(f, 2)} {path} -o {exe}"));
        if b.code != 0 {
            scratch_remove(h, d);
            return Result[Vec[Run], Str].Err(error: f"{which}: {b.stderr}");
        }
        let x = strs_new();
        strs_push(x, "-c");
        strs_push(x, bounded_script());
        strs_push(x, exe);
        for y in args {
            strs_push(x, y);
        }
        vec_push(out, Run(name: which, ran: run(h, "sh", x, d, env_set(suite_env(h), "NAZM_MEMORY_REPORT", "1"))));
    }
    scratch_remove(h, d);
    Result[Vec[Run], Str].Ok(value: out)
}

fn one_file(text: Str) -> Strs ! {} {
    let f = strs_new();
    strs_push(f, "prog.nz");
    strs_push(f, text);
    f
}

fn agrees4(h: Caps, files: Strs, expected: Str) -> Result[Int, Str] ! { io, spawn } {
    for r in four(h, files, strs_new())? {
        check_that(r.ran.code == 0, f"{r.name}: {r.ran.stderr}")?;
        check_that(r.ran.stdout == expected, f"{r.name}: {r.ran.stdout}")?;
        if r.name != "interpreter" {
            let report = memory_line(r.ran);
            check_that(report != "", f"{r.name}: {r.ran.stderr}")?;
            check_that(count_matches(report, "live=0") == 4, f"{r.name}: {report}")?;
        }
    }
    ok()
}

/// The codes `nazm check --json prog.nz` reports over `files`, joined by `,`.
fn codes_of(h: Caps, files: Strs) -> Result[Str, Str] ! { io, spawn } {
    let d = scratch_new(h);
    let mut i = 0;
    while i + 1 < strs_len(files) {
        scratch_write(h, d, strs_get(files, i), strs_get(files, i + 1))?;
        i = i + 2;
    }
    let o = nazm(h, d, words("check --json prog.nz"));
    scratch_remove(h, d);
    let found = strs_new();
    for l in text_lines(o.stderr) {
        match jparse(l) {
            Result.Ok(value: v) => {
                if jq(v, "code") >= 0 && json_kind(v, jq(v, "code")) == "string" {
                    strs_push(found, jstr(v, "code"));
                }
            },
            Result.Err(error: e) => {},
        };
    }
    Result[Str, Str].Ok(value: str_join(found, ","))
}

@test
fn every_standard_module_is_found_by_name_and_checks_cleanly(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    for m in words(MODULES) {
        let c = codes_of(h, one_file(f"use \"@std/{m}\";\nfn main() -> Int {{ 0 }}\n"))?;
        check_that(c == "", f"@std/{m}: {c}")?;
    }
    // Only by name: an unknown one or a file name is refused, and a path beginning with `@std/` is
    // never looked for on disk — a project file of that very name is there, and is not read.
    for bad in words("@std/nope @std/text.nz") {
        let d = prog_dir(h, "prog.nz", f"use \"{bad}\";\nfn main() -> Int {{ 0 }}\n")?;
        scratch_write(h, d, bad, "pub fn f() -> Int { 1 }\n")?;
        let o = nazm(h, d, words("check --json prog.nz"));
        scratch_remove(h, d);
        check_that(o.code != 0 && text_contains(o.stderr, "\"N0205\""), f"{bad}: {o.stderr}")?;
    }
    // Any other `@` path is an ordinary relative path, as it always was.
    let d = prog_dir(h, "prog.nz", "use \"@elsewhere/lib.nz\";\nfn main() -> Int { f() }\n")?;
    scratch_write(h, d, "@elsewhere/lib.nz", "pub fn f() -> Int { 1 }\n")?;
    let o = nazm(h, d, words("check prog.nz"));
    scratch_remove(h, d);
    check_that(o.code == 0, o.stderr)
}

/// `checked reused` of the run's `nazm.check-report/1` line.
fn report_of(o: Ran) -> Result[Str, Str] ! {} {
    for l in text_lines(o.stdout) {
        if text_contains(l, "nazm.check-report/1") {
            let v = jparse(l)?;
            return Result[Str, Str].Ok(value: f"{jint(v, "checked")} {jint(v, "reused")}");
        }
    }
    Result[Str, Str].Err(error: f"{o.stdout}{o.stderr}")
}

@test
fn a_standard_module_is_reused_from_the_cache_like_any_module(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Its key, `@std/text`, reads back from a stored entry as itself.
    let d = prog_dir(h, "nazm.root", "")?;
    scratch_write(h, d, "prog.nz", CACHED_PROG)?;
    let first = report_of(nazm(h, d, words("check prog.nz --cache-report")))?;
    let second = report_of(nazm(h, d, words("check prog.nz --cache-report")))?;
    scratch_remove(h, d);
    check_that(parse_usize(strs_get(words(first), 0)) >= 3, first)?;
    check_that(second == "0 4", f"the program, two standard modules and the prelude: {second}")
}

@test
fn a_standard_module_is_one_module_however_many_import_it(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let files = strs_new();
    strs_push(files, "lib.nz");
    strs_push(files, SHOUT_LIB);
    strs_push(files, "prog.nz");
    strs_push(files, SHOUT_PROG);
    agrees4(h, files, "hi!--0\n")?;
    // Its names are the importer's: defining one of them beside the import is a collision.
    let c = codes_of(h, one_file(CLASH))?;
    check_that(strs_has(text_split(c, ","), "N0208"), c)
}

