@test
fn io_and_process_need_the_authority_they_show(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Reading a file that is there and one that is not; a newline after each line; the arguments
    // without the program's name.
    let files = one_file(IO_PROG);
    strs_push(files, "data.txt");
    strs_push(files, "contents");
    let args = strs_new();
    strs_push(args, "x");
    strs_push(args, "y z");
    for r in four(h, files, args)? {
        check_that(r.ran.code == 0, f"{r.name}: {r.ran.stderr}")?;
        check_that(r.ran.stdout == "contents\nx+y z\n2\n", f"{r.name}: {r.ran.stdout}")?;
        check_that(text_contains(r.ran.stderr, "no such file: absent.txt\n"), f"{r.name}: {r.ran.stderr}")?;
    }
    // A function that calls one must declare `io`, and hold the capability to hand over.
    let a = codes_of(h, one_file(IO_UNDECLARED))?;
    check_that(strs_has(text_split(a, ","), "N0366"), a)?;
    let b = codes_of(h, one_file(IO_UNHELD))?;
    check_that(b != "", "process_args without the authority")
}

@test
fn what_a_standard_function_reads_keeps_its_origin(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A path read from a file, through `io_read`, is still a file's contents.
    let a = codes_of(h, one_file(ORIGIN_READ))?;
    check_that(a == "N0372", a)?;
    // A pure helper passes its arguments' origins through, like any function.
    let b = codes_of(h, one_file(ORIGIN_THROUGH))?;
    check_that(b == "N0372", b)?;
    let c = codes_of(h, one_file(ORIGIN_COMPUTED))?;
    check_that(c == "", c)
}

@test
fn chan_take_receives_one_value_at_a_time_across_tasks(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees4(h, one_file(CHAN_PROG), "5050\n")
}

/// The standard library section of `docs/user/spec.md`: from its marker to the next `### ` heading.
fn spec_from_marker(h: Caps) -> Result[Str, Str] ! { io } {
    let spec = read_text(h, f"{repo_root(h)}/docs/user/spec.md")?;
    let at = find(spec, "<!-- id: std -->");
    check_that(at >= 0, "the standard library section")?;
    Result[Str, Str].Ok(value: str_slice(spec, at, str_len(spec)))
}

@test
fn the_spec_s_example_runs_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let rest = spec_from_marker(h)?;
    let open = find(rest, "```nazm\n") + str_len("```nazm\n");
    let after = str_slice(rest, open, str_len(rest));
    let block = str_slice(after, 0, find(after, "```"));
    agrees4(h, one_file(block), "4\n42\n")
}

@test
fn every_public_standard_function_is_documented_and_listed(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let rest = spec_from_marker(h)?;
    let section = str_slice(rest, 0, find(rest, "\n### "));
    let mut seen = 0;
    for m in words(MODULES) {
        let text = read_text(h, f"{repo_root(h)}/library/std/{m}.nz")?;
        check_that(text_contains(section, f"`@std/{m}`"), f"@std/{m} is not in the spec's table")?;
        let ls = text_lines(text);
        let mut i = 0;
        while i < strs_len(ls) {
            let l = strs_get(ls, i);
            match strip_prefix(l, "pub fn ") {
                Option.Some(value: r) => {
                    let name = ident(r);
                    check_that(i > 0 && text_starts_with(strs_get(ls, i - 1), "///"), f"`{name}` in @std/{m} has no doc comment")?;
                    check_that(text_contains(section, f"`{name}"), f"`{name}` is not in the spec's table")?;
                    check_that(text_contains(l, " ! {"), f"`{name}` declares no effect set")?;
                    seen = seen + 1;
                },
                Option.None() => {},
            };
            i = i + 1;
        }
    }
    check_that(seen >= 30, f"{seen}")
}

// `what_the_standard_library_costs` is `#[ignore]`d in Rust "a measurement, run by the benchmark
// gate": it stays Rust (design decision 10).
