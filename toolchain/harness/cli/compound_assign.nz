// R1, 5b.12: `a op= b` writes what `a = a op b` writes, fails as its operator fails, and is one
// token the formatter keeps. Ported from `crates/nazm-cli/tests/compound_assign.rs` (R7).

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"

@test
fn every_operator_writes_what_its_long_form_writes_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"struct P { x: Int, y: Int }

fn main(out: OutCap) -> Int ! {io} {
    let mut a = 10
    a += 5
    a -= 3
    a *= 4
    a /= 3
    a %= 7
    let mut b = 12
    b &= 10
    b |= 1
    b ^= 3
    b <<= 2
    b >>= 1
    let mut w = UInt8(250)
    w -= UInt8(9)
    let mut p = P(x: 1, y: 2)
    p.x += 40
    p.y *= p.x
    let mut arr = [1, 2, 3]
    let i = 1
    arr[i] += 10
    arr[0] *= 7
    arr[2] -= arr[i]
    print(f"{a} {b} {w} {p.x} {p.y} {arr[0]} {arr[1]} {arr[2]}\n")
    0
}
"#, "2 20 241 41 82 7 12 -9\n0")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_compound_assignment_fails_as_its_operator_does(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    for r in everywhere_one(h, "fn main() -> Int {\n    let mut m = 9223372036854775807\n    m += 1\n    m\n}\n")? {
        check_that(r.ran.code == 2, f"{r.label}: {ran_show(r.ran)}")?;
        check_that(text_contains(r.ran.stderr, "error[N0400]"), f"{r.label}: {ran_show(r.ran)}")?;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn what_a_compound_assignment_cannot_mean_is_refused_by_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    same_strs("an index computed twice", codes(h, "fn k() -> Int { 0 }\nfn main() -> Int {\n    let mut v = [1, 2]\n    v[k()] += 1\n    0\n}\n"), words("N0100"))?;
    same_strs("an immutable binding", codes(h, "fn main() -> Int { let x = 1; x += 1; x }\n"), words("N0310"))?;
    same_strs("an operator written as two tokens", codes(h, "fn main() -> Int { let mut x = 1; x + = 1; x }\n"), words("N0100"))?;
    same_strs("an operator its operands do not have", codes(h, "fn main() -> Int { let mut s = \"a\"; s *= \"b\"; 0 }\n"), words("N0304"))
}

@test
fn each_operator_is_one_token_and_the_formatter_keeps_it(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "p.nz", "fn main() -> Int {\nlet mut a = 1\na<<=3\na>>=1\na+=a<=4\na\n}\n")?;
    let f = nazm(h, d, words("fmt p.nz"));
    let laid = read_text(h, f"{d}/p.nz")?;
    // `a <= 4` is a comparison, `Bool`, so adding it to an `Int` is refused: `<=` stayed `<=`.
    let r = nazm(h, d, words("check p.nz"));
    scratch_remove(h, d);
    check_that(f.code == 0, ran_show(f))?;
    check_that(text_contains(laid, "    a <<= 3\n    a >>= 1\n"), laid)?;
    check_that(text_contains(r.stderr, "N0304") || text_contains(r.stderr, "N0300"), ran_show(r))
}
