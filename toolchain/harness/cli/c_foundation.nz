// Gate 2, §13: a library's C interface — the header names every number's C type, and C (static and
// shared) and Python (`ctypes`) get the same answers at every width from both backends; an export
// still takes nothing C cannot hold by value. Ported from `crates/nazm-cli/tests/c_foundation.rs`
// (R7).

use "@std/file"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"

fn lib_src() -> Str ! {} {
    r#"pub extern "C" fn nz_scale(x: Float64, k: Int32) -> Float64 ! {} = "nz_scale" { x * Float64(k) }
pub extern "C" fn nz_mask(x: UInt8, y: UInt16) -> UInt32 ! {} = "nz_mask" { UInt32(x) | (UInt32(y) << 8) }
pub extern "C" fn nz_half(x: Float32) -> Float32 ! {} = "nz_half" { x / Float32(2.0) }
pub extern "C" fn nz_neg(n: Int8, m: Int16) -> Int32 ! {} = "nz_neg" { Int32(n) * Int32(m) }
pub extern "C" fn nz_top(x: UInt64) -> UInt64 ! {} = "nz_top" { x ^ UInt64(1) }
pub extern "C" fn nz_both(a: Int, b: Bool) -> Int ! {} = "nz_both" { if b { a } else { 0 - a } }
"#
}

fn main_c() -> Str ! {} {
    r#"#include <stdio.h>
#include "libnz.h"
int main(void) {
  printf("%g %u %g %d %llu %lld\n", nz_scale(1.5, -3), nz_mask(255, 65535), (double)nz_half(3.0f),
         nz_neg(-128, -32768), (unsigned long long)nz_top(18446744073709551615ULL), (long long)nz_both(7, false));
  return 0;
}
"#
}

fn python() -> Str ! {} {
    r#"import ctypes, sys
l = ctypes.CDLL(sys.argv[1])
l.nz_scale.restype = ctypes.c_double; l.nz_scale.argtypes = [ctypes.c_double, ctypes.c_int32]
l.nz_mask.restype = ctypes.c_uint32; l.nz_mask.argtypes = [ctypes.c_uint8, ctypes.c_uint16]
l.nz_half.restype = ctypes.c_float; l.nz_half.argtypes = [ctypes.c_float]
l.nz_neg.restype = ctypes.c_int32; l.nz_neg.argtypes = [ctypes.c_int8, ctypes.c_int16]
l.nz_top.restype = ctypes.c_uint64; l.nz_top.argtypes = [ctypes.c_uint64]
l.nz_both.restype = ctypes.c_int64; l.nz_both.argtypes = [ctypes.c_int64, ctypes.c_bool]
print('%g %d %g %d %d %d' % (l.nz_scale(1.5, -3), l.nz_mask(255, 65535), l.nz_half(3.0), l.nz_neg(-128, -32768), l.nz_top(2**64 - 1), l.nz_both(7, False)))
"#
}

const ANSWERS: Str = "-4.5 16777215 1.5 4194304 18446744073709551614 -7";

/// macOS's shared-library name: the harness runs where the 0.10.0 preview does.
const SHARED: Str = "libnz.dylib";

@test
fn the_header_names_every_numbers_c_type(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "lib.nz", lib_src())?;
    let b = nazm(h, d, words("build --lib lib.nz -o libnz.a"));
    let header = read_text(h, f"{d}/libnz.h");
    scratch_remove(h, d);
    check_that(b.code == 0, b.stderr)?;
    let text = header?;
    for decl in text_split("double nz_scale(double a0, int32_t a1);|uint32_t nz_mask(uint8_t a0, uint16_t a1);|float nz_half(float a0);|int32_t nz_neg(int8_t a0, int16_t a1);|uint64_t nz_top(uint64_t a0);|int64_t nz_both(int64_t a0, bool a1);", "|") {
        check_that(text_contains(text, decl), f"{decl}\n{text}")?;
    }
    Result[Int, Str].Ok(value: 0)
}

fn one_backend(h: Caps, backend: Str, has_python: Bool) -> Result[Int, Str] ! { io, spawn } {
    let io = h.io;
    let v = h.v;
    let d = prog_dir(h, "lib.nz", lib_src())?;
    scratch_write(h, d, "main.c", main_c())?;
    scratch_write(h, d, "bind.py", python())?;
    let env = suite_env(h);
    // The static archive, linked into a C program.
    let b = nazm(h, d, words(f"build --backend {backend} --lib lib.nz -o libnz.a"));
    let link = run(h, "clang", words("main.c libnz.a -o static"), d, env);
    let r = run(h, f"{d}/static", strs_new(), "", env);
    // The shared library, from C and from Python.
    match file_remove(io, str_vouch(f"{d}/libnz.a")) {
        Result.Ok(value: n) => n,
        Result.Err(error: e) => 0,
    };
    let s = nazm(h, d, words(f"build --backend {backend} --lib --shared lib.nz -o {SHARED}"));
    let dlink = run(h, "clang", words("main.c -L. -lnz -o dynamic"), d, env);
    let shared_env = env_set(env_set(env, "DYLD_LIBRARY_PATH", d), "LD_LIBRARY_PATH", d);
    let rd = run(h, f"{d}/dynamic", strs_new(), "", shared_env);
    let a = strs_new();
    strs_push(a, "bind.py");
    strs_push(a, f"{d}/{SHARED}");
    let py = if has_python { run(h, "python3", a, d, env) } else { Ran(code: 0, stdout: ANSWERS, stderr: "") };
    scratch_remove(h, d);
    check_that(b.code == 0, f"{backend}: {b.stderr}")?;
    check_that(link.code == 0, f"{backend}: {link.stderr}")?;
    check_that(text_trim_end(r.stdout) == ANSWERS, f"{backend} static: {ran_show(r)}")?;
    check_that(s.code == 0, f"{backend}: {s.stderr}")?;
    check_that(dlink.code == 0, f"{backend}: {dlink.stderr}")?;
    check_that(text_trim_end(rd.stdout) == ANSWERS, f"{backend} shared: {ran_show(rd)}")?;
    check_that(py.code == 0, f"{backend}: {py.stderr}")?;
    check_that(text_trim_end(py.stdout) == ANSWERS, f"{backend} python: {ran_show(py)}")
}

@test
fn c_and_python_get_the_same_answers_at_every_width_from_both_backends(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Where `python3` is not on `PATH`, `ctypes` is not tried, as the Rust test skips it.
    let has_python = run(h, "python3", words("--version"), "", env_here(io)).code == 0;
    for backend in words("llvm cranelift") {
        one_backend(h, backend, has_python)?;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn an_export_still_takes_nothing_c_cannot_hold_by_value(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    for ty in text_split("Str|Bytes|Vec[Int]|Text", "|") {
        let got = codes(h, f"pub extern \"C\" fn f(x: {ty}) -> Int ! {{}} = \"f\" {{ 0 }}\nfn main() -> Int {{ 0 }}\n");
        let mut has = false;
        for c in got {
            if c == "N0391" {
                has = true;
            }
        }
        let shown = str_join(got, ", ");
        check_that(has, f"{ty}: [{shown}]")?;
    }
    Result[Int, Str].Ok(value: 0)
}
