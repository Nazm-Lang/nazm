// N12: `Result`, `Option` and `?` — reclamation, ownership order, and cleanup on the way out, in
// both implementations. Ported from `crates/nazm-cli/tests/propagation.rs` (R7).
//
// Every case runs interpreted and compiled, and the two must agree on the value and on every
// memory counter, with nothing left live; a propagated error is a return, not a runtime failure,
// so neither writes anything but the memory report to standard error.

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/differential.nz"
use "../lib/memory_report.nz"

/// Interpret it, compile and run it, and require the two to agree about everything.
fn both(h: Caps, source: Str) -> Result[Counted, Str] ! { io, spawn } {
    let d = prog_dir(h, "m.nz", source)?;
    let r = both_in(h, d);
    scratch_remove(h, d);
    r
}

fn both_in(h: Caps, d: Str) -> Result[Counted, Str] ! { io, spawn } {
    let env = env_set(suite_env(h), "NAZM_MEMORY_REPORT", "1");
    let interpreted = run(h, nazm_bin(h.io), words("run --interpret m.nz"), d, env);
    check_that(interpreted.code == 0, f"interpreting failed: {interpreted.stderr}")?;
    check_that(strs_len(lines(interpreted.stderr)) == 1, f"unexpected stderr: {interpreted.stderr}")?;
    let a = counts(interpreted.stderr, text_trim(interpreted.stdout))?;
    let built = nazm(h, d, words("build m.nz -o prog"));
    check_that(built.code == 0, f"building failed: {built.stderr}")?;
    let native = run(h, f"{d}/prog", strs_new(), d, env);
    check_that(native.code == 0, f"the program failed: {native.stderr}")?;
    check_that(strs_len(lines(native.stderr)) == 1, f"unexpected stderr: {native.stderr}")?;
    let b = counts(native.stderr, text_trim(native.stdout))?;
    check_that(same_counted(a, b), f"the two implementations disagree: {counted_show(a)} vs {counted_show(b)}")?;
    Result[Counted, Str].Ok(value: a)
}

/// Everything allocated was reclaimed.
fn clean(r: Counted) -> Result[Int, Str] ! {} {
    check_that(r.sequences.live == 0 && r.sequences.allocated == r.sequences.reclaimed, f"sequences: {counted_show(r)}")?;
    check_that(r.strings.live == 0 && r.strings.allocated == r.strings.reclaimed, f"strings: {counted_show(r)}")?;
    check_that(r.channels.live == 0 && r.channels.allocated == r.channels.reclaimed, f"channels: {counted_show(r)}")
}

/// Small strings made and thrown away, so that a block released too early is reused.
const CHURN: Str = "fn churn() -> Int {\n    let mut noise = vec_new[Str]();\n    let mut k = 0;\n    while k < 64 {\n        vec_push(noise, str_concat(\"noise-\", int_to_str(k)));\n        k = k + 1;\n    }\n    noise = vec_new[Str]();\n    vec_len(noise)\n}\n";

/// The shared vocabulary: an owning record, an owning enum, and a diagnostic.
const TYPES: Str = "struct Item {\n    name: Str,\n    tags: Ints,\n}\nenum Shape {\n    Named(label: Str),\n    Plain,\n}\nstruct Diag {\n    code: Str,\n    start: Int,\n}\nfn item(n: Int) -> Item {\n    let tags = ints_new();\n    ints_push(tags, n);\n    Item(name: str_concat(\"item-\", int_to_str(n)), tags: tags)\n}\nfn diags(n: Int) -> Vec[Diag] {\n    let ds = vec_new[Diag]();\n    let mut i = 0;\n    while i < n {\n        vec_push(ds, Diag(code: str_concat(\"N0\", int_to_str(300 + i)), start: i));\n        i = i + 1;\n    }\n    ds\n}\n";

fn with(body: Str) -> Str ! {} {
    f"{TYPES}{CHURN}{body}"
}

fn valued(h: Caps, body: Str, want: Str) -> Result[Counted, Str] ! { io, spawn } {
    let r = both(h, with(body))?;
    check_that(r.value == want, f"{r.value}, expected {want}")?;
    clean(r)?;
    Result[Counted, Str].Ok(value: r)
}

@test
fn every_result_shape_is_constructed_copied_returned_and_reclaimed(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Five success shapes and five error shapes, each made in a function, returned, copied into a
    // second binding, and taken apart.
    let r = valued(h, "fn ok_int() -> Result[Int, Str] { Result[Int, Str].Ok(value: 1) }\nfn ok_str() -> Result[Str, Str] { Result[Str, Str].Ok(value: int_to_str(22)) }\nfn ok_rec() -> Result[Item, Str] { Result[Item, Str].Ok(value: item(3)) }\nfn ok_enum() -> Result[Shape, Str] { Result[Shape, Str].Ok(value: Shape.Named(label: int_to_str(444))) }\nfn ok_vec() -> Result[Vec[Item], Str] {\n    let xs = vec_new[Item]();\n    vec_push(xs, item(5));\n    Result[Vec[Item], Str].Ok(value: xs)\n}\nfn err_str() -> Result[Int, Str] { Result[Int, Str].Err(error: int_to_str(66)) }\nfn err_rec() -> Result[Int, Item] { Result[Int, Item].Err(error: item(7)) }\nfn err_enum() -> Result[Int, Shape] { Result[Int, Shape].Err(error: Shape.Named(label: int_to_str(8888))) }\nfn err_vec() -> Result[Int, Vec[Diag]] { Result[Int, Vec[Diag]].Err(error: diags(9)) }\nfn err_chan() -> Result[Int, Chan] { Result[Int, Chan].Err(error: chan_new(2)) }\nfn main() -> Int {\n    let a = ok_int();\n    let a2 = a;\n    let s = ok_str();\n    let s2 = s;\n    let r = ok_rec();\n    let r2 = r;\n    let e = ok_enum();\n    let e2 = e;\n    let v = ok_vec();\n    let v2 = v;\n    let t = 0\n        + match a2 { Result.Ok(value: n) => n, Result.Err(error: x) => 0, }\n        + match s2 { Result.Ok(value: x) => str_len(x), Result.Err(error: x) => 0, }\n        + match r2 { Result.Ok(value: i) => ints_get(i.tags, 0), Result.Err(error: x) => 0, }\n        + match e2 { Result.Ok(value: sh) => match sh { Shape.Named(label: l) => str_len(l), Shape.Plain() => 0, }, Result.Err(error: x) => 0, }\n        + match v2 { Result.Ok(value: xs) => vec_len(xs) * 5, Result.Err(error: x) => 0, };\n    let u = 0\n        + match err_str() { Result.Ok(value: n) => 0, Result.Err(error: x) => str_len(x), }\n        + match err_rec() { Result.Ok(value: n) => 0, Result.Err(error: i) => ints_get(i.tags, 0), }\n        + match err_enum() { Result.Ok(value: n) => 0, Result.Err(error: sh) => match sh { Shape.Named(label: l) => str_len(l), Shape.Plain() => 0, }, }\n        + match err_vec() { Result.Ok(value: n) => 0, Result.Err(error: ds) => vec_len(ds), }\n        + match err_chan() { Result.Ok(value: n) => 0, Result.Err(error: c) => chan_close(c) + 1, };\n    t * 100 + u\n}\n", "1423")?;
    check_that(r.strings.allocated >= 10, counted_show(r))?;
    check_that(r.channels.allocated == 1, counted_show(r))
}

@test
fn every_option_shape_is_constructed_copied_returned_and_reclaimed(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    valued(h, "fn none() -> Option[Str] { Option[Str].None() }\nfn some_int() -> Option[Int] { Option[Int].Some(value: 4) }\nfn some_str() -> Option[Str] { Option[Str].Some(value: int_to_str(55)) }\nfn some_rec() -> Option[Item] { Option[Item].Some(value: item(6)) }\nfn some_vec() -> Option[Vec[Str]] {\n    let xs = vec_new[Str]();\n    vec_push(xs, int_to_str(1));\n    vec_push(xs, int_to_str(2));\n    Option[Vec[Str]].Some(value: xs)\n}\nfn main() -> Int {\n    let n = none();\n    let n2 = n;\n    let s = some_str();\n    let s2 = s;\n    let v = some_vec();\n    let v2 = v;\n    match n2 { Option.None() => 1000, Option.Some(value: x) => 0, }\n        + match some_int() { Option.None() => 0, Option.Some(value: x) => x * 100, }\n        + match s2 { Option.None() => 0, Option.Some(value: x) => str_len(x) * 10, }\n        + match some_rec() { Option.None() => 0, Option.Some(value: i) => ints_get(i.tags, 0), }\n        + match v2 { Option.None() => 0, Option.Some(value: xs) => vec_len(xs) * 10000, }\n}\n", "21426")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_success_payload_outlives_the_result_it_came_out_of(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // "value-12345" = 11, "item-7" = 6, tag 7, "99" = 2
    valued(h, "fn text(n: Int) -> Result[Str, Str] { Result[Str, Str].Ok(value: str_concat(\"value-\", int_to_str(n))) }\nfn thing(n: Int) -> Result[Item, Str] { Result[Item, Str].Ok(value: item(n)) }\nfn many(n: Int) -> Result[Vec[Str], Str] {\n    let xs = vec_new[Str]();\n    vec_push(xs, int_to_str(n));\n    Result[Vec[Str], Str].Ok(value: xs)\n}\nfn f() -> Result[Int, Str] {\n    let s = text(12345)?;\n    let i = thing(7)?;\n    let xs = many(99)?;\n    churn();\n    Result[Int, Str].Ok(value: str_len(s) * 10000 + str_len(i.name) * 100 + ints_get(i.tags, 0) + str_len(vec_get(xs, 0)) * 1000000)\n}\nfn main() -> Int {\n    match f() { Result.Ok(value: v) => v, Result.Err(error: e) => 0 - 1, }\n}\n", "2110607")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn an_error_payload_outlives_every_frame_it_propagates_out_of(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // "broken-42" = 9 ; "item-31" = 7, tag 31 ; 5 diagnostics, "N0304" = 5
    valued(h, "fn leaf_s() -> Result[Int, Str] { Result[Int, Str].Err(error: str_concat(\"broken-\", int_to_str(42))) }\nfn leaf_r() -> Result[Int, Item] { Result[Int, Item].Err(error: item(31)) }\nfn leaf_v() -> Result[Int, Vec[Diag]] { Result[Int, Vec[Diag]].Err(error: diags(5)) }\nfn mid_s() -> Result[Int, Str] {\n    let n = leaf_s()?;\n    churn();\n    Result[Int, Str].Ok(value: n)\n}\nfn mid_r() -> Result[Int, Item] {\n    let n = leaf_r()?;\n    Result[Int, Item].Ok(value: n)\n}\nfn mid_v() -> Result[Str, Vec[Diag]] {\n    let n = leaf_v()?;\n    Result[Str, Vec[Diag]].Ok(value: int_to_str(n))\n}\nfn top_s() -> Result[Str, Str] {\n    let n = mid_s()?;\n    Result[Str, Str].Ok(value: int_to_str(n))\n}\nfn top_r() -> Result[Int, Item] {\n    let n = mid_r()?;\n    Result[Int, Item].Ok(value: n)\n}\nfn top_v() -> Result[Int, Vec[Diag]] {\n    let s = mid_v()?;\n    Result[Int, Vec[Diag]].Ok(value: str_len(s))\n}\nfn main() -> Int {\n    let a = top_s();\n    churn();\n    let b = top_r();\n    churn();\n    let c = top_v();\n    churn();\n    match a { Result.Ok(value: s) => 0, Result.Err(error: e) => str_len(e) * 10000, }\n        + match b { Result.Ok(value: n) => 0, Result.Err(error: i) => str_len(i.name) * 100 + ints_get(i.tags, 0), }\n        + match c { Result.Ok(value: n) => 0, Result.Err(error: ds) => vec_len(ds) * 1000000 + str_len(vec_get(ds, 4).code) * 10000000, }\n}\n", "55090731")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_vec_of_diagnostics_is_one_handle_through_three_returns(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The error is a handle: one vector, not a copy per frame, reclaimed once.
    let r = valued(h, "fn leaf(ds: Vec[Diag]) -> Result[Int, Vec[Diag]] { Result[Int, Vec[Diag]].Err(error: ds) }\nfn one(ds: Vec[Diag]) -> Result[Int, Vec[Diag]] {\n    let n = leaf(ds)?;\n    Result[Int, Vec[Diag]].Ok(value: n)\n}\nfn two(ds: Vec[Diag]) -> Result[Int, Vec[Diag]] {\n    let n = one(ds)?;\n    Result[Int, Vec[Diag]].Ok(value: n)\n}\nfn three(ds: Vec[Diag]) -> Result[Int, Vec[Diag]] {\n    let n = two(ds)?;\n    Result[Int, Vec[Diag]].Ok(value: n)\n}\nfn grow(ds: Vec[Diag]) -> Int {\n    vec_push(ds, Diag(code: \"N0999\", start: 9));\n    vec_len(ds)\n}\nfn main() -> Int {\n    let mine = diags(2);\n    let got = match three(mine) {\n        Result.Ok(value: n) => 0,\n        Result.Err(error: ds) => grow(ds),\n    };\n    got * 10 + vec_len(mine)\n}\n", "33")?;
    check_that(r.sequences.allocated == 1, counted_show(r))
}

@test
fn locals_are_released_once_when_an_error_propagates(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = valued(h, "fn fails() -> Result[Int, Str] { Result[Int, Str].Err(error: int_to_str(404)) }\nfn holder() -> Result[Int, Str] {\n    let s = str_concat(\"held-\", int_to_str(1));\n    let xs = vec_new[Item]();\n    vec_push(xs, item(2));\n    vec_push(xs, item(3));\n    let c = chan_new(3);\n    let sh = Shape.Named(label: int_to_str(77));\n    let n = fails()?;\n    Result[Int, Str].Ok(value: n + str_len(s) + vec_len(xs) + chan_close(c) + match sh { Shape.Named(label: l) => 1, Shape.Plain() => 0, })\n}\nfn main() -> Int {\n    let r = holder();\n    churn();\n    match r { Result.Ok(value: n) => n, Result.Err(error: e) => str_len(e) * 7, }\n}\n", "21")?;
    check_that(r.channels.allocated == 1 && r.channels.reclaimed == 1 && r.channels.live == 0, counted_show(r))
}

@test
fn an_earlier_argument_is_reclaimed_and_nothing_after_it_runs(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Odd i: consume runs, len(i * 1000) + i + 5; even i: -len(i). Only ten calls ran `later` and
    // `consume`, so the log has twenty entries.
    let mut odd = 0;
    let mut even = 0;
    let mut i = 0;
    while i < 20 {
        if i % 2 == 1 {
            odd = odd + str_len(int_to_str(i * 1000)) + i + 5;
        } else {
            even = even - str_len(int_to_str(i));
        }
        i = i + 1;
    }
    valued(h, "fn may_fail(n: Int) -> Result[Int, Str] {\n    if n % 2 == 0 { return Result[Int, Str].Err(error: int_to_str(n)); }\n    Result[Int, Str].Ok(value: n)\n}\nfn later(log: Ints) -> Str {\n    ints_push(log, 1);\n    str_concat(\"late\", \"r\")\n}\nfn consume(log: Ints, a: Str, b: Int, c: Str) -> Int {\n    ints_push(log, 2);\n    str_len(a) + b + str_len(c)\n}\nfn f(log: Ints, i: Int) -> Result[Int, Str] {\n    Result[Int, Str].Ok(value: consume(log, int_to_str(i * 1000), may_fail(i)?, later(log)))\n}\nfn main() -> Int {\n    let log = ints_new();\n    let mut i = 0;\n    let mut total = 0;\n    while i < 20 {\n        total = total + match f(log, i) { Result.Ok(value: n) => n, Result.Err(error: e) => 0 - str_len(e), };\n        i = i + 1;\n    }\n    churn();\n    total * 100 + ints_len(log)\n}\n", int_to_str((odd + even) * 100 + 20))?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_half_built_record_or_variant_is_released_when_an_initialiser_propagates(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // i = 0..2 succeed: 8, twice; i = 3..5 fail: 3 * (100 + 1000).
    let r = valued(h, "struct Three {\n    a: Str,\n    b: Int,\n    c: Ints,\n}\nenum Held {\n    Three(a: Str, b: Int, c: Ints),\n    Nothing,\n}\nfn may_fail(n: Int) -> Result[Int, Str] {\n    if n > 2 { return Result[Int, Str].Err(error: int_to_str(n)); }\n    Result[Int, Str].Ok(value: n)\n}\nfn rec(n: Int) -> Result[Three, Str] {\n    Result[Three, Str].Ok(value: Three(a: int_to_str(n * 11), b: may_fail(n)?, c: ints_new()))\n}\nfn var(n: Int) -> Result[Held, Str] {\n    Result[Held, Str].Ok(value: Held.Three(a: int_to_str(n * 11), b: may_fail(n)?, c: ints_new()))\n}\nfn main() -> Int {\n    let mut i = 0;\n    let mut t = 0;\n    while i < 6 {\n        t = t + match rec(i) { Result.Ok(value: r) => str_len(r.a) + r.b, Result.Err(error: e) => 100, };\n        t = t + match var(i) { Result.Ok(value: h) => match h { Held.Three(a: a, b: b, c: c) => str_len(a) + b, Held.Nothing() => 0, }, Result.Err(error: e) => 1000, };\n        i = i + 1;\n    }\n    churn();\n    t\n}\n", int_to_str(8 * 2 + 3 * 1100))?;
    // The three that succeeded built one `Ints` each, twice; `churn` makes the other two.
    check_that(r.sequences.allocated == 6 + 2, counted_show(r))
}

@test
fn a_match_on_a_propagated_value_consumes_one_result_layer(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    valued(h, "fn make(n: Int) -> Result[Shape, Str] {\n    if n == 0 { return Result[Shape, Str].Err(error: int_to_str(12345)); }\n    Result[Shape, Str].Ok(value: Shape.Named(label: str_concat(\"shape-\", int_to_str(n))))\n}\nfn f(n: Int) -> Result[Int, Str] {\n    let k = match make(n)? {\n        Shape.Named(label: l) => str_len(l),\n        Shape.Plain() => 0,\n    };\n    churn();\n    Result[Int, Str].Ok(value: k)\n}\nfn main() -> Int {\n    let a = match f(7) { Result.Ok(value: k) => k, Result.Err(error: e) => 0, };\n    let b = match f(0) { Result.Ok(value: k) => 0, Result.Err(error: e) => str_len(e), };\n    a * 10 + b\n}\n", "75")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn propagation_out_of_a_scope_joins_the_task_and_cleans_up(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The error "9", one delivered value, and it is len("task-1") = 6.
    valued(h, "fn worker(out: Chan, tag: Str) -> Int {\n    let mut i = 0;\n    let mut s = 0;\n    while i < 200000 { s = s + i % 3; i = i + 1; }\n    chan_send(out, str_len(tag));\n    s\n}\nfn fails() -> Result[Int, Str] { Result[Int, Str].Err(error: int_to_str(9)) }\nfn run(out: Chan, tasks: SpawnCap) -> Result[Int, Str] {\n    let tag = str_concat(\"task-\", int_to_str(1));\n    scope {\n        spawn worker(out, tag);\n        let held = int_to_str(555);\n        let x = fails()?;\n        chan_send(out, x + str_len(held));\n    }\n    Result[Int, Str].Ok(value: 0)\n}\nfn main(tasks: SpawnCap) -> Int {\n    let out = chan_new(4);\n    let r = run(out, tasks);\n    chan_close(out);\n    let buf = ints_new();\n    let got = chan_recv(out, buf);\n    let more = chan_recv(out, buf);\n    match r { Result.Ok(value: n) => 0, Result.Err(error: e) => str_len(e) * 1000, } + ints_len(buf) * 100 + ints_get(buf, 0)\n}\n", "1106")?;
    Result[Int, Str].Ok(value: 0)
}

fn spelled_as(spelled: Str) -> Str ! {} {
    with(f"fn leaf(n: Int) -> Result[Item, Vec[Diag]] {{\n    if n % 3 == 0 {{ return Result[Item, Vec[Diag]].Err(error: diags(n % 5 + 1)); }}\n    Result[Item, Vec[Diag]].Ok(value: item(n))\n}}\nfn step(n: Int) -> Result[Int, Vec[Diag]] {{\n    let i = {spelled};\n    Result[Int, Vec[Diag]].Ok(value: str_len(i.name) + ints_get(i.tags, 0))\n}}\nfn main() -> Int {{\n    let mut i = 0;\n    let mut t = 0;\n    while i < 30 {{\n        t = t + match step(i) {{ Result.Ok(value: n) => n, Result.Err(error: ds) => 0 - vec_len(ds), }};\n        i = i + 1;\n    }}\n    churn();\n    t\n}}\n")
}

@test
fn explicit_match_and_propagation_agree_on_value_and_on_every_counter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The same program twice, once spelled with `match` and `return`, once with `?`.
    let by_match = both(h, spelled_as("match leaf(n) {\n        Result.Ok(value: v) => v,\n        Result.Err(error: e) => if true { return Result[Int, Vec[Diag]].Err(error: e); } else { return Result[Int, Vec[Diag]].Err(error: e); },\n    }"))?;
    let by_question = both(h, spelled_as("leaf(n)?"))?;
    check_that(same_counted(by_match, by_question), f"{counted_show(by_match)} vs {counted_show(by_question)}")?;
    clean(by_question)
}

@test
fn a_generic_propagation_is_reclaimed_in_every_instance(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    valued(h, "fn pass[T, E](r: Result[T, E]) -> Result[T, E] {\n    let value = r?;\n    Result[T, E].Ok(value: value)\n}\nfn main() -> Int {\n    let a = match pass(Result[Int, Str].Err(error: int_to_str(123))) { Result.Ok(value: n) => n, Result.Err(error: s) => str_len(s), };\n    let b = match pass(Result[Item, Vec[Diag]].Ok(value: item(4))) { Result.Ok(value: i) => ints_get(i.tags, 0), Result.Err(error: ds) => 0, };\n    let c = match pass(Result[Vec[Item], Shape].Err(error: Shape.Named(label: int_to_str(55555)))) {\n        Result.Ok(value: xs) => 0,\n        Result.Err(error: sh) => match sh { Shape.Named(label: l) => str_len(l), Shape.Plain() => 0, },\n    };\n    churn();\n    a * 100 + b * 10 + c\n}\n", "345")?;
    Result[Int, Str].Ok(value: 0)
}
