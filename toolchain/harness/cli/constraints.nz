// N14: a generic function that requires equality of `T`, compiled by `nazm build` exactly as
// `nazm run` evaluates it. Ported from `crates/nazm-cli/tests/constraints.rs` (R7).
//
// A bounded body instantiated at `Int`, `Str`, a record, an enum, `Option`, `Result` and `Box`
// gives the stated answer at `-O0` and `-O2`, and the interpreter's; comparing through it observes
// its parameters, releasing every temporary once; and the native program carries no trace of the
// requirement.

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/differential.nz"
use "../lib/memory_report.nz"

const CHURN: Str = "fn churn() -> Int {\n    let mut noise = vec_new[Str]();\n    let mut k = 0;\n    while k < 64 {\n        vec_push(noise, str_concat(\"noise-\", int_to_str(k)));\n        k = k + 1;\n    }\n    noise = vec_new[Str]();\n    vec_len(noise)\n}\n";

const DECLS: Str = "fn same[T: Equality](a: T, b: T) -> Bool { a == b }\nfn wrap[T: Equality](a: T, b: T) -> Bool { same(a, b) }\nfn bit(b: Bool, n: Int) -> Int { if b { n } else { 0 } }\nfn text(n: Int) -> Str { str_concat(\"t-\", int_to_str(n)) }\nstruct Box[T] { value: T, }\nstruct Item { name: Str, n: Int, }\nenum Shape { Plain, Named(label: Str), Pair(left: Str, right: Str), }\nfn item(n: Int) -> Item { Item(name: text(n), n: n) }\nfn shape(k: Int) -> Shape { if k % 3 == 0 { return Shape.Plain(); } if k % 3 == 1 { return Shape.Named(label: text(k)); } Shape.Pair(left: text(k), right: text(k + 1)) }\nfn box_same[T: Equality](a: Box[T], b: Box[T]) -> Bool { a == b }\n";

fn with(body: Str) -> Str ! {} {
    f"{DECLS}{CHURN}{body}"
}

@test
fn a_bounded_body_compiles_to_the_answer_at_every_instance(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agree(h, with("struct Point { x: Int, y: Int, }\nfn main() -> Int {\n    bit(same(1, 1), 1) + bit(same[Int](1, 2), 2) + bit(same(text(1), \"t-1\"), 4)\n    + bit(same(Point(x: 1, y: 2), Point(x: 1, y: 2)), 8) + bit(same(Shape.Plain(), Shape.Named(label: text(1))), 16)\n    + bit(same(Option[Int].Some(value: 3), Option[Int].Some(value: 3)), 32)\n    + bit(same(Result[Int, Str].Err(error: text(2)), Result[Int, Str].Err(error: text(2))), 64)\n    + bit(same(Box[Int](value: 4), Box[Int](value: 5)), 128)\n    + bit(box_same(Box[Option[Str]](value: Option[Str].Some(value: text(9))), Box[Option[Str]](value: Option[Str].Some(value: text(9)))), 256)\n    + bit(wrap(Result[Box[Int], Str].Ok(value: Box[Int](value: 1)), Result[Box[Int], Str].Ok(value: Box[Int](value: 1))), 512)\n}\n"), "877")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_bounded_comparison_observes_owning_arguments_and_releases_its_temporaries_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = agree(h, with("fn main() -> Int {\n    let mut total = 0;\n    let mut i = 0;\n    while i < 6 {\n        total = total + bit(same(text(i), text(i)), 1) + bit(same(item(i), item(i + 1)), 10);\n        total = total + bit(same(shape(i), shape(i)), 100) + bit(wrap(Option[Str].Some(value: text(i)), Option[Str].Some(value: text(i))), 1000);\n        total = total + bit(same(Result[Str, Str].Ok(value: text(i)), Result[Str, Str].Ok(value: text(i))), 10000);\n        churn();\n        i = i + 1;\n    }\n    let a = item(4);\n    let b = item(4);\n    let s = same(a, b);\n    churn();\n    total + bit(s, 100000) + 1000000 * (str_len(a.name) + str_len(b.name))\n}\n"), "6166606")?;
    check_that(r.strings.allocated > 50, counted_show(r))
}

/// The lines after the first `define` naming `same`, up to its `}`.
fn body(ir: Str) -> Result[Str, Str] ! {} {
    let ls = lines(ir);
    let mut start = 0 - 1;
    let mut i = 0;
    while i < strs_len(ls) && start < 0 {
        let l = strs_get(ls, i);
        if text_starts_with(l, "define ") && text_contains(l, "same") {
            start = i;
        }
        i = i + 1;
    }
    check_that(start >= 0, f"no instance in:\n{ir}")?;
    let out = strs_new();
    let mut j = start + 1;
    while j < strs_len(ls) && strs_get(ls, j) != "}" {
        strs_push(out, strs_get(ls, j));
        j = j + 1;
    }
    Result[Str, Str].Ok(value: str_join(out, "\n"))
}

@test
fn a_requirement_leaves_no_trace_in_the_program(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The instance at `Int` is the concrete function, instruction for instruction; and no symbol,
    // global or argument in the program speaks of a capability.
    let generic = ir_of(h, "fn same[T: Equality](a: T, b: T) -> Bool { a == b }\nfn main() -> Int { if same(1, 2) { 1 } else { 0 } }\n")?;
    let concrete = ir_of(h, "fn same_int(a: Int, b: Int) -> Bool { a == b }\nfn main() -> Int { if same_int(1, 2) { 1 } else { 0 } }\n")?;
    let g = body(generic)?;
    let c = body(concrete)?;
    check_that(g == c, f"\n{generic}\n---\n{concrete}")?;
    for word in words("Equality equality dict vtable") {
        check_that(!text_contains(generic, word), f"`{word}` in:\n{generic}")?;
    }
    // A composite instance calls N13's helper, one per concrete type.
    let boxed = ir_of(h, "struct Box[T] { value: T, }\nfn same[T: Equality](a: T, b: T) -> Bool { a == b }\nfn main() -> Int { if same(Box[Int](value: 1), Box[Int](value: 1)) { if same(Box[Str](value: \"a\"), Box[Str](value: \"b\")) { 2 } else { 1 } } else { 0 } }\n")?;
    check_that(count_matches(boxed, "define internal i1 @nz.h.eq.") == 2, boxed)
}
