// The speed milestone (R1, 5b.9): an integer's text without the C library, an interpolation's
// integer written straight after the text before it, a hash map whose table holds positions, and
// the runtime's reference counting inlined where a hosted unit is optimised. Ported from
// `crates/nazm-cli/tests/speed_text.rs` (R7).
//
// Each is asked for the same bytes and the same memory report in every implementation, with
// nothing live; the map is held to a model of itself under a fixed sequence of operations.

use "@std/file"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"
use "../lib/strings.nz"

@test
fn every_integer_s_text_is_the_same_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"fn main(out: OutCap) -> Int ! {io} {
    let a = 0 - 9223372036854775807 - 1;
    let b = UInt64(18446744073709551615);
    let c = Int8(0 - 127) - Int8(1);
    let d = UInt32(4294967295);
    let e = Int16(0 - 7);
    let f = UInt8(255);
    print(f"a{a} b{b} c{c} d{d} e{e} f{f} z{0} n{0 - 42} m{9223372036854775807}\n");
    print(f"{a}{b}|{c}\n");
    print(str_concat(int_to_str(a), "\n"));
    0
}
"#, "a-9223372036854775808 b18446744073709551615 c-128 d4294967295 e-7 f255 z0 n-42 m9223372036854775807\n-922337203685477580818446744073709551615|-128\n-9223372036854775808\n0")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn an_interpolated_integer_costs_one_string_not_two(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A thousand `f"w{i}"`: the interpreter and each backend allocate the same strings — one
    // each, the digits written after the `w`.
    let line = agrees(h, r#"fn main() -> Int {
    let mut total = 0;
    let mut i = 0;
    while i < 1000 {
        total = total + str_len(f"w{i}");
        i = i + 1;
    }
    total
}
"#, "3890")?;
    let parts = split(line, "strings allocated=");
    let allocated = if strs_len(parts) > 1 { parse_usize(strs_get(split_whitespace(strs_get(parts, 1)), 0)) } else { 0 - 1 };
    check_that(allocated >= 0 && allocated <= 1010, line)
}

/// Three thousand operations from a fixed seed on keys from a small range, so that keys are set,
/// replaced, removed and set again, against two vectors searched from the start; then how many
/// disagreements, the counts, and the keys summed by table order.
fn map_program() -> Str ! {} {
    r#"use "@std/hash";
use "@std/hashmap";

fn find(keys: Vec[Int], k: Int) -> Int {
    let mut i = 0;
    let mut at = 0 - 1;
    while i < vec_len(keys) {
        if vec_get(keys, i) == k { at = i; }
        i = i + 1;
    }
    at
}

fn main(out: OutCap) -> Int ! {io} {
    let m = hashmap_new[Int, Int]();
    let keys = vec_new[Int]();
    let values = vec_new[Int]();
    let mut state = UInt64(7);
    let mut bad = 0;
    let mut step = 0;
    while step < 3000 {
        state = wrapping_add(wrapping_mul(state, UInt64(6364136223846793005)), UInt64(1442695040888963407));
        let k = Int((state >> 33) % UInt64(97));
        let op = Int((state >> 20) % UInt64(3));
        let at = find(keys, k);
        if op == 0 {
            let replaced = hashmap_set(m, k, step);
            if replaced != (at >= 0) { bad = bad + 1; }
            if at >= 0 { vec_set(values, at, step); } else { vec_push(keys, k); vec_push(values, step); }
        } else {
            if op == 1 {
                let got = hashmap_remove(m, k);
                match got {
                    Option.Some(value: v) => {
                        if at < 0 { bad = bad + 1; } else {
                            if vec_get(values, at) != v { bad = bad + 1; }
                            let last = vec_len(keys) - 1;
                            vec_set(keys, at, vec_get(keys, last));
                            vec_set(values, at, vec_get(values, last));
                            vec_pop(keys);
                            vec_pop(values);
                        }
                    },
                    Option.None() => { if at >= 0 { bad = bad + 1; } },
                };
            } else {
                match hashmap_get(m, k) {
                    Option.Some(value: v) => { if at < 0 || vec_get(values, at) != v { bad = bad + 1; } },
                    Option.None() => { if at >= 0 { bad = bad + 1; } },
                };
            }
        }
        if hashmap_len(m) != vec_len(keys) { bad = bad + 1; }
        step = step + 1;
    }
    let mut sum = 0;
    let all = hashmap_keys(m);
    let mut j = 0;
    while j < vec_len(all) {
        sum = sum + vec_get(all, j) * (j + 1);
        j = j + 1;
    }
    print(f"{bad} {hashmap_len(m)} {vec_len(hashmap_values(m))} {sum}\n");
    0
}
"#
}

fn position(keys: Ints, k: Int) -> Int ! {} {
    let mut i = 0;
    while i < ints_len(keys) {
        if ints_get(keys, i) == k {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

/// How many keys the program's operations leave, from the same sequence here.
fn model_keys() -> Int ! {} {
    let keys = ints_new();
    let mut state = UInt64(7);
    let mut step = 0;
    while step < 3000 {
        state = wrapping_add(wrapping_mul(state, UInt64(6364136223846793005)), UInt64(1442695040888963407));
        let k = Int((state >> 33) % UInt64(97));
        let op = Int((state >> 20) % UInt64(3));
        let at = position(keys, k);
        if op == 0 && at < 0 {
            ints_push(keys, k);
        }
        if op == 1 && at >= 0 {
            // `swap_remove`.
            let last = ints_len(keys) - 1;
            ints_set(keys, at, ints_get(keys, last));
            ints_pop(keys);
        }
        step = step + 1;
    }
    ints_len(keys)
}

@test
fn the_hash_map_agrees_with_a_model_of_itself(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let n = model_keys();
    // Table order is the map's own: the interpreter's sum is the one every backend must print.
    let d = prog_dir(h, "prog.nz", map_program())?;
    let r = nazm(h, d, words("run --interpret prog.nz"));
    scratch_remove(h, d);
    check_that(r.code == 0, ran_show(r))?;
    let fields = split_whitespace(r.stdout);
    check_that(strs_len(fields) > 3, ran_show(r))?;
    let sum = strs_get(fields, 3);
    agrees(h, map_program(), f"0 {n} {n} {sum}\n0")?;
    Result[Int, Str].Ok(value: 0)
}

fn inlined(h: Caps, d: Str) -> Result[Int, Str] ! { io, spawn } {
    let b = nazm(h, d, words("build --no-cache --emit-ir p.nz -o p"));
    check_that(b.code == 0, ran_show(b))?;
    let names = match dir_list(h.io, d) {
        Result.Ok(value: ns) => ns,
        Result.Err(error: e) => strs_new(),
    };
    let units = strs_new();
    for name in names {
        if text_ends_with(name, ".ll") && !text_contains(name, "entry") && !text_contains(name, "runtime") {
            strs_push(units, read_text(h, f"{d}/{name}")?);
        }
    }
    let all = str_join(units, "");
    check_that(text_contains(all, "define available_externally hidden void @nz.str_release("), all)?;
    check_that(!text_contains(all, "declare void @nz.str_release("), all)?;
    let r = bounded_exe(h, f"{d}/p", "", suite_env(h));
    check_that(r.code == 0 && r.stdout == "1\n", ran_show(r))
}

@test
fn a_hosted_unit_inlines_the_runtime_s_reference_counting(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "p.nz", "fn main() -> Int { let v = vec_new[Str](); vec_push(v, f\"a{1}\"); vec_len(v) }\n")?;
    let r = inlined(h, d);
    scratch_remove(h, d);
    r
}
