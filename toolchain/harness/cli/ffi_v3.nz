// N85: FFI v3 — handles, C-layout records, C strings returned, `errno`, callbacks and shared
// libraries. An opaque handle, a C struct laid out in declaration order, a string C keeps and Nazm
// copies, `errno` and an export passed as a C function pointer each cross under both backends with
// identical results and a balanced memory report; a null where a declaration promised a value
// fails the call with `N0409`; each refusal has its code; a handle and a C struct keep what they
// are across a module boundary and in the check cache; `nazm build --lib --shared` writes a shared
// library a C program links, whose only symbols are the exports. Ported from
// `crates/nazm-cli/tests/ffi_v3.rs` (R7); the C fixture and the programs are the Rust test's,
// carried over byte for byte.

use "@std/json"
use "@std/text"
use "@std/sort"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/strings.nz"
use "../lib/port.nz"
use "../lib/jsonq.nz"
use "../lib/differential.nz"

const C: Str = "\n#include <stdint.h>\n#include <stdbool.h>\n#include <stdlib.h>\n#include <errno.h>\n#include <pthread.h>\n#ifdef __APPLE__\n#include <malloc/malloc.h>\n#endif\ntypedef struct counter { int64_t n; } counter;\ncounter *counter_new(int64_t start) { counter *c = malloc(sizeof *c); c->n = start; return c; }\ncounter *counter_maybe(int64_t start) { return start < 0 ? NULL : counter_new(start); }\nint64_t counter_bump(counter *c, int64_t by) { c->n += by; return c->n; }\nint64_t counter_free(counter *c) { free(c); return 0; }\nconst char *greeting(int64_t which) { return which ? \"hello, C\" : NULL; }\ntypedef struct point { int64_t x; bool flag; int64_t y; } point;\nint64_t point_sum(const point *p) { return p->x * 1000 + p->y + (p->flag ? 100 : 0); }\ntypedef struct seg { point a; counter *owner; point b; int64_t tag; } seg;\nint64_t seg_score(const seg *s) {\n    return s->a.x * 1000000 + s->b.y * 100 + s->tag + (s->owner ? s->owner->n * 10 : 0);\n}\nint64_t point_offsets(const point *p) {\n    return (int64_t)((const char *)&p->flag - (const char *)p) * 100\n         + (int64_t)((const char *)&p->y - (const char *)p);\n}\nint64_t fail_with(int64_t e) { errno = (int)e; return -1; }\ntypedef int64_t (*cb)(int64_t);\nint64_t apply_twice(cb f, int64_t x) { return f(f(x)); }\nstruct job { cb f; int64_t x; int64_t r; };\nstatic void *runner(void *a) { struct job *j = a; j->r = j->f(j->x); return 0; }\nint64_t apply_on_thread(cb f, int64_t x) {\n    pthread_t t; struct job j = { f, x, 0 };\n    pthread_create(&t, 0, runner, &j); pthread_join(t, 0); return j.r;\n}\nint64_t apply_on_small_thread(cb f, int64_t x, int64_t bytes) {\n    pthread_attr_t at; pthread_attr_init(&at); pthread_attr_setstacksize(&at, (size_t)bytes);\n    pthread_t t; struct job j = { f, x, 0 };\n    pthread_create(&t, &at, runner, &j); pthread_join(t, 0); return j.r;\n}\nint64_t blocks_in_use(void) {\n#ifdef __APPLE__\n    malloc_statistics_t s; malloc_zone_statistics(NULL, &s); return (int64_t)s.blocks_in_use;\n#else\n    return 0;\n#endif\n}\n";
const DECLS: Str = "extern \"C\" struct Counter;\nextern \"C\" struct Point { x: Int, flag: Bool, y: Int }\nextern \"C\" struct Seg { a: Point, owner: Counter, b: Point, tag: Int }\nextern \"C\" fn counter_new(start: Int) -> Counter = \"counter_new\";\nextern \"C\" fn counter_maybe(start: Int) -> Option[Counter] = \"counter_maybe\";\nextern \"C\" fn counter_bump(c: Counter, by: Int) -> Int = \"counter_bump\";\nextern \"C\" fn counter_free(c: Counter) -> Int = \"counter_free\";\nextern \"C\" fn greeting(which: Int) -> Option[Str] = \"greeting\";\nextern \"C\" fn point_sum(p: Point) -> Int = \"point_sum\";\nextern \"C\" fn point_offsets(p: Point) -> Int = \"point_offsets\";\nextern \"C\" fn seg_score(s: Seg) -> Int = \"seg_score\";\nextern \"C\" fn fail_with(e: Int) -> Int = \"fail_with\";\nextern \"C\" fn apply_twice(f: fn(Int) -> Int, x: Int) -> Int = \"apply_twice\";\nextern \"C\" fn apply_on_thread(f: fn(Int) -> Int, x: Int) -> Int = \"apply_on_thread\";\nextern \"C\" fn blocks_in_use() -> Int = \"blocks_in_use\";\npub extern \"C\" fn triple(x: Int) -> Int ! {} = \"nz_triple\" { x * 3 }\n";
const CROSS_MAIN: Str = "struct Holder { c: Counter, label: Str }\nfn keep(c: Counter) -> Holder ! {} { Holder(c: c, label: \"kept\") }\nfn main(io: IoCap, f: ForeignCap) -> Int ! { io, foreign } {\n    let c = counter_new(5);\n    print(int_to_str(counter_bump(c, 2))); print(\",\");\n    let h = keep(c);\n    print(int_to_str(counter_bump(h.c, 10))); print(\",\"); print(h.label); print(\"|\");\n    let v = vec_new[Counter](); vec_push(v, c);\n    print(int_to_str(counter_bump(vec_get(v, 0), 1))); print(\"|\");\n    let none = match counter_maybe(-1) { Option.None() => \"none\", Option.Some(value: x) => \"some\" };\n    print(none); print(\"|\");\n    let some = match counter_maybe(9) { Option.None() => 0, Option.Some(value: x) => counter_bump(x, 1) };\n    print(int_to_str(some)); print(\"|\");\n    match greeting(1) { Option.None() => print(\"null\"), Option.Some(value: s) => print(str_concat(s, \"!\")) };\n    print(\"|\");\n    match greeting(0) { Option.None() => print(\"null\"), Option.Some(value: s) => print(s) };\n    print(\"|\");\n    print(int_to_str(point_sum(Point(x: 7, flag: true, y: 3)))); print(\",\");\n    print(int_to_str(point_offsets(Point(y: 4, x: 2, flag: false)))); print(\"|\");\n    let p = Point(y: 4, x: 2, flag: false);\n    print(int_to_str(seg_score(Seg(a: p, owner: c, b: Point(x: 0, flag: true, y: 5), tag: 6)))); print(\"|\");\n    let r = fail_with(34);\n    print(int_to_str(r)); print(\",\"); print(int_to_str(c_errno())); print(\"|\");\n    print(int_to_str(apply_twice(triple, 2))); print(\",\");\n    print(int_to_str(apply_on_thread(triple, 5))); print(\"|\");\n    print(int_to_str(counter_free(c)));\n    0\n}\n";
const CROSS_WANT: Str = "7,17,kept|18|none|10|hello, C!|null|7103,816|2000686|-1,34|18,15|00\n";
const SMALL_THREAD: Str = "extern \"C\" fn apply_on_small_thread(f: fn(Int) -> Int, x: Int, bytes: Int) -> Int = \"apply_on_small_thread\";\npub extern \"C\" fn deep(n: Int) -> Int ! {} = \"nz_deep\" { if n == 0 { 0 } else { deep(n - 1) + 1 } }\nfn main(io: IoCap, f: ForeignCap) -> Int ! { io, foreign } {\n    print(int_to_str(apply_on_small_thread(deep, 100, 131072))); print(\"|\");\n    print(int_to_str(apply_on_small_thread(deep, 10000000, 131072))); print(\"|\");\n    0\n}\n";
const FREED_MAIN: Str = "fn main(io: IoCap, f: ForeignCap) -> Int ! { io, foreign } {\n    let before = blocks_in_use();\n    let mut i = 0;\n    let mut t = 0;\n    while i < 10000 { t = t + point_sum(Point(x: i, flag: false, y: 1)); i = i + 1; }\n    let after = blocks_in_use();\n    print(int_to_str(t)); print(\" \");\n    print(if after - before < 16 { \"freed\" } else { int_to_str(after - before) });\n    0\n}\n";
const LIB_DECLS: Str = "pub extern \"C\" struct Counter;\npub extern \"C\" struct Point { x: Int, flag: Bool, y: Int }\npub extern \"C\" fn counter_new(start: Int) -> Counter = \"counter_new\";\npub extern \"C\" fn counter_bump(c: Counter, by: Int) -> Int = \"counter_bump\";\npub extern \"C\" fn point_sum(p: Point) -> Int = \"point_sum\";\n";
const LIB_PROG: Str = "use \"lib.nz\";\nfn main(io: IoCap, f: ForeignCap) -> Int ! { io, foreign } {\n    let c = counter_new(1);\n    print(int_to_str(counter_bump(c, 1) + point_sum(Point(y: 2, flag: true, x: 3))));\n    0\n}\n";
const LIB: Str = "fn square(x: Int) -> Int ! {} { x * x }\n\npub extern \"C\" fn sum_squares(a: Int, b: Int) -> Int ! {} = \"nazm_sum_squares\" {\n    square(a) + square(b)\n}\n\npub extern \"C\" fn is_even(n: Int) -> Bool ! {} = \"nazm_is_even\" { n % 2 == 0 }\n\npub extern \"C\" fn wrap(n: Int) -> Int ! {} = \"nazm_wrap\" { n * 9223372036854775807 }\n";
const HOST: Str = "\n#include <stdio.h>\n#include \"libnz.h\"\nint main(int argc, char **argv) {\n    printf(\"%lld %d %d\\n\", (long long)nazm_sum_squares(3, 4), nazm_is_even(10), nazm_is_even(7));\n    fflush(stdout);\n    if (argc > 1) { printf(\"%lld\\n\", (long long)nazm_wrap(2)); printf(\"not reached\\n\"); }\n    return 0;\n}\n";
const API_H: Str = "#include <stdint.h>\n#include <stdbool.h>\ntypedef struct db db;\nstruct counter;\nstruct point { int64_t x; bool flag; int64_t y; };\nstruct seg { struct point a; struct counter *owner; int64_t tag; };\nstruct grid { int64_t cells[4]; };\nunion u { int64_t a; };\ndb *db_open(const char *path);\nint64_t db_close(db *d);\nconst char *db_error(db *d);\nint64_t point_sum(const struct point *p);\nint64_t seg_score(const struct seg *s);\nstruct point point_make(int64_t x);\nint64_t apply(int64_t (*f)(int64_t), int64_t x);\nint64_t fill(int64_t *out);\n";

/// `clang ARGS` in `d`.
fn clang(h: Caps, d: Str, args: Str) -> Result[Int, Str] ! { io, spawn } {
    let r = run(h, "clang", words(args), d, env_here(h.io));
    check_that(r.code == 0, r.stderr)
}

/// Every diagnostic code on a run's standard error, sorted, each once, joined by `,`.
fn codes_in(o: Ran) -> Str ! {} {
    let found = strs_new();
    for l in text_lines(o.stderr) {
        match jparse(l) {
            Result.Ok(value: v) => {
                if jq(v, "code") >= 0 && json_kind(v, jq(v, "code")) == "string" && !strs_has(found, jstr(v, "code")) {
                    strs_push(found, jstr(v, "code"));
                }
            },
            Result.Err(error: e) => {},
        };
    }
    str_join(strs_sort(found), ",")
}

fn check_codes_of(h: Caps, src: Str) -> Result[Str, Str] ! { io, spawn } {
    let d = prog_dir(h, "prog.nz", src)?;
    let o = nazm(h, d, words("check --json prog.nz"));
    scratch_remove(h, d);
    Result[Str, Str].Ok(value: codes_in(o))
}

/// An executable under `bounded_exe`, with the memory report.
fn run_exe(h: Caps, exe: Str) -> Ran ! { io, spawn } {
    bounded_exe(h, exe, "", env_set(suite_env(h), "NAZM_MEMORY_REPORT", "1"))
}

fn built(h: Caps, d: Str, backend: Str) -> Result[Ran, Str] ! { io, spawn } {
    let b = nazm(h, d, words(f"build --no-cache --backend {backend} --link fixture.o prog.nz -o {d}/prog-{backend}"));
    check_that(b.code == 0, f"{backend}: {b.stderr}")?;
    Result[Ran, Str].Ok(value: run_exe(h, f"{d}/prog-{backend}"))
}

/// `prog.nz` built against the C fixture by both backends and run: they must agree exactly.
fn both(h: Caps, src: Str) -> Result[Ran, Str] ! { io, spawn } {
    let d = prog_dir(h, "prog.nz", src)?;
    scratch_write(h, d, "fixture.c", C)?;
    clang(h, d, "-c -O1 fixture.c -o fixture.o")?;
    let l = built(h, d, "llvm")?;
    let c = built(h, d, "cranelift")?;
    scratch_remove(h, d);
    check_that(l.code == c.code && l.stdout == c.stdout && l.stderr == c.stderr, f"LLVM and Cranelift disagree: {ran_show(l)} {ran_show(c)}")?;
    Result[Ran, Str].Ok(value: l)
}

fn balanced(r: Ran) -> Result[Int, Str] ! {} {
    let line = memory_line(r);
    check_that(line != "", f"no memory report: {ran_show(r)}")?;
    check_that(text_contains(line, "strings") && text_contains(line, "live=0 channels"), line)?;
    check_that(!text_contains(line, "live=1") && !text_contains(line, "live=2"), line)
}

@test
fn a_handle_a_c_struct_a_c_string_errno_and_a_callback_cross_under_both_backends(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = both(h, f"{DECLS}{CROSS_MAIN}")?;
    check_that(r.code == 0, ran_show(r))?;
    // The counter is one C object through a binding, a record field and a `Vec`; a null is
    // `None`; a C string is copied and owned; `Point`'s fields are where C's `struct point` has
    // them; `errno` is what `fail_with` left; an export is called by C inside the call and from
    // C's own thread. `main`'s result is printed last.
    check_that(r.stdout == CROSS_WANT, r.stdout)?;
    balanced(r)
}

/// Q1-A1-04: an export C calls on a thread with a small stack is budgeted from that thread's
/// stack, so recursion in it fails with `N0408` at the function, under both backends.
@test
fn an_export_recursing_on_a_small_c_thread_fails_with_n0408_rather_than_faulting(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let r = both(h, SMALL_THREAD)?;
    check_that(r.code == 2, ran_show(r))?;
    check_that(r.stdout == "100|", ran_show(r))?;
    check_that(text_contains(r.stderr, "error[N0408]") && text_contains(r.stderr, "prog.nz:2:"), ran_show(r))
}

/// The cases a 32-bit target refuses: `declaration|call|what`, joined by `;`.
const POINTER_CASES: Str = "fn h_open(n: Int) -> Counter = \"h_open\";|h_open(1);|return a C handle~fn h_maybe(n: Int) -> Option[Counter] = \"h_maybe\";|h_maybe(1);|return a C handle~fn s_name(n: Int) -> Str = \"s_name\";|s_name(1);|return a C string~fn s_maybe(n: Int) -> Option[Str] = \"s_maybe\";|s_maybe(1);|return a C string~fn h_use(c: Counter, n: Int) -> Int = \"h_use\";|0;|take a C handle~fn on_c(f: fn(Int) -> Int, x: Int) -> Int = \"on_c\";|on_c(triple, 1);|take a C function pointer~fn seg_score(s: Seg) -> Int = \"seg_score\";|0;|take a C struct holding a handle";

/// Q1-A1-05: a C pointer crosses as a 64-bit word, so on a target whose pointers are 32 bits every
/// crossing that is one is refused by name with `N0381` at the declaration.
@test
fn a_c_pointer_on_a_32_bit_target_is_refused_by_name(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    for target in words("wasm32-unknown-unknown wasm32-wasip1 thumbv7m-none-eabi") {
        for case in text_split(POINTER_CASES, "~") {
            let f = text_split(case, "|");
            let decl = strs_get(f, 0);
            let call = strs_get(f, 1);
            let what = strs_get(f, 2);
            let src = f"extern \"C\" struct Counter;\nextern \"C\" struct Point {{ x: Int, flag: Bool, y: Int }}\nextern \"C\" struct Seg {{ a: Point, owner: Counter, b: Point, tag: Int }}\npub extern \"C\" fn triple(x: Int) -> Int ! {{}} = \"nz_triple\" {{ x * 3 }}\nextern \"C\" {decl}\nfn main(f: ForeignCap) -> Int ! {{ foreign }} {{ {call} 0 }}\n";
            let d = prog_dir(h, "prog.nz", src)?;
            scratch_mkdir(h, d, "o")?;
            let o = nazm(h, d, words(f"build --target {target} --objects o prog.nz"));
            scratch_remove(h, d);
            check_that(o.code != 0, f"{target} {decl}: {o.stderr}")?;
            check_that(text_contains(o.stderr, "error[N0381]"), f"{target} {decl}: {o.stderr}")?;
            check_that(text_contains(o.stderr, what) && text_contains(o.stderr, target), f"{target} {decl}: {o.stderr}")?;
            check_that(text_contains(o.stderr, "prog.nz:5:"), f"{target} {decl}: {o.stderr}")?;
        }
    }
    // What does not cross as a pointer still builds where the target can call C at all.
    let d = prog_dir(h, "prog.nz", "extern \"C\" struct Point { x: Int, flag: Bool, y: Int }\nextern \"C\" fn point_sum(p: Point) -> Int = \"point_sum\";\nextern \"C\" fn twice(n: Int) -> Int = \"twice\";\nfn main(f: ForeignCap) -> Int ! { foreign } { point_sum(Point(x: 1, flag: true, y: 2)) + twice(3) }\n")?;
    scratch_mkdir(h, d, "o")?;
    let o = nazm(h, d, words("build --target wasm32-wasip1 --objects o prog.nz"));
    scratch_remove(h, d);
    check_that(o.code == 0, o.stderr)
}

@test
fn a_null_where_the_declaration_promised_a_value_fails_the_call_with_n0409(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let cases = text_split("extern \"C\" fn counter_maybe(start: Int) -> Counter = \"counter_maybe\";\n|counter_bump(counter_maybe(-1), 1)~extern \"C\" fn greeting(which: Int) -> Str = \"greeting\";\n|str_len(greeting(0))", "~");
    for case in cases {
        let f = text_split(case, "|");
        let r = both(h, f"extern \"C\" struct Counter;\nextern \"C\" fn counter_bump(c: Counter, by: Int) -> Int = \"counter_bump\";\n{strs_get(f, 0)}fn main(io: IoCap, f: ForeignCap) -> Int ! {{ io, foreign }} {{\n    print(\"before \");\n    let n = {strs_get(f, 1)};\n    print(\"after\");\n    n\n}}\n")?;
        check_that(r.code == 2, ran_show(r))?;
        check_that(r.stdout == "before ", ran_show(r))?;
        check_that(text_contains(r.stderr, "N0409") && text_contains(r.stderr, "returned null"), ran_show(r))?;
    }
    ok()
}

@test
fn a_struct_passed_to_c_is_a_copy_freed_after_every_call(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // Ten thousand calls leave the heap where they found it (macOS's allocator statistics; on other
    // hosts the fixture reports nothing and only the result is checked).
    let r = both(h, f"{DECLS}{FREED_MAIN}")?;
    check_that(r.code == 0, ran_show(r))?;
    // `main`'s result follows, as a native program prints it.
    check_that(r.stdout == "49995010000 freed0\n", r.stdout)
}

const H: Str = "extern \"C\" struct Db;\n";
const MAIN0: Str = "fn main() -> Int { 0 }\n";

@test
fn every_misuse_of_a_handle_a_c_struct_or_a_callback_is_refused_by_its_code(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let srcs = strs_new();
    let wants = strs_new();
    // A handle is built and read only by C (`N0611`), has no equality (`N0304`) and never crosses
    // into a task, by capture or by channel (`N0321`, `N0390`).
    strs_push(srcs, f"{H}fn f() -> Db ! {{}} {{ Db(x: 1) }}\n{MAIN0}");
    strs_push(wants, "N0611");
    strs_push(srcs, f"{H}fn f(d: Db) -> Int ! {{}} {{ d.x }}\n{MAIN0}");
    strs_push(wants, "N0611");
    strs_push(srcs, f"{H}fn f(d: Db) -> Bool ! {{}} {{ d == d }}\n{MAIN0}");
    strs_push(wants, "N0304");
    strs_push(srcs, f"{H}fn w(d: Db) -> Int ! {{}} {{ 0 }}\nfn g(d: Db, s: SpawnCap) -> Int ! {{ spawn }} {{ scope {{ spawn w(d); }} 0 }}\n{MAIN0}");
    strs_push(wants, "N0321");
    strs_push(srcs, f"{H}fn f(c: Chan[Db]) -> Int ! {{}} {{ 0 }}\n{MAIN0}");
    strs_push(wants, "N0390");
    // What crosses, by position (`N0381`).
    strs_push(srcs, f"{H}extern \"C\" fn g(d: Option[Db]) -> Int = \"g\";\n{MAIN0}");
    strs_push(wants, "N0381");
    strs_push(srcs, f"extern \"C\" struct S {{ s: Str }}\n{MAIN0}");
    strs_push(wants, "N0381");
    strs_push(srcs, f"struct P {{ x: Int }}\nextern \"C\" struct S {{ p: P }}\n{MAIN0}");
    strs_push(wants, "N0381");
    strs_push(srcs, f"extern \"C\" struct P {{ x: Int }}\nextern \"C\" fn g(x: Int) -> P = \"g\";\n{MAIN0}");
    strs_push(wants, "N0381");
    strs_push(srcs, f"extern \"C\" fn g(f: fn(Str) -> Int) -> Int = \"g\";\n{MAIN0}");
    strs_push(wants, "N0381");
    // The declaration's own shape.
    strs_push(srcs, f"extern \"C\" struct P[T] {{ x: Int }}\n{MAIN0}");
    strs_push(wants, "N0384");
    strs_push(srcs, f"extern \"Rust\" struct P {{ x: Int }}\n{MAIN0}");
    strs_push(wants, "N0380");
    // A callback is an export's name (`N0612`): not another function, not a closure.
    strs_push(srcs, "extern \"C\" fn ap(f: fn(Int) -> Int, x: Int) -> Int = \"ap\";\nfn dbl(x: Int) -> Int ! {} { x * 2 }\nfn main(f: ForeignCap) -> Int ! { foreign } { ap(dbl, 1) }\n");
    strs_push(wants, "N0612");
    strs_push(srcs, "extern \"C\" fn ap(f: fn(Int) -> Int, x: Int) -> Int = \"ap\";\nfn main(f: ForeignCap) -> Int ! { foreign } { ap(fn(x: Int) -> Int { x }, 1) }\n");
    strs_push(wants, "N0612");
    // `c_errno` is part of calling C: it needs a `ForeignCap`.
    strs_push(srcs, f"fn h() -> Int ! {{}} {{ c_errno() }}\n{MAIN0}");
    strs_push(wants, "N0366,N0369");
    let mut i = 0;
    while i < strs_len(srcs) {
        let got = check_codes_of(h, strs_get(srcs, i))?;
        check_that(got == strs_get(wants, i), f"{got}: {strs_get(srcs, i)}")?;
        i = i + 1;
    }
    ok()
}

@test
fn a_program_reading_errno_runs_only_natively_and_only_where_there_is_one(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "fn main(f: ForeignCap) -> Int ! { foreign } { c_errno() }\n")?;
    // `nazm run` cannot call C, and `errno` is C's (`N0385`).
    let o = nazm(h, d, words("run --interpret prog.nz"));
    check_that(o.code != 0, ran_show(o))?;
    check_that(text_contains(o.stderr, "N0385"), o.stderr)?;
    // A freestanding target has no C library keeping one (`N0613`); an ordinary foreign call
    // builds there.
    for target in words("aarch64-unknown-none wasm32-unknown-unknown") {
        let b = nazm(h, d, words(f"build --target {target} --objects o prog.nz"));
        check_that(b.code != 0, target)?;
        check_that(text_contains(b.stderr, "N0613"), f"{target}: {b.stderr}")?;
    }
    scratch_remove(h, d);
    let plain = prog_dir(h, "prog.nz", "extern \"C\" fn tick(x: Int) -> Int = \"tick\";\nfn main(f: ForeignCap) -> Int ! { foreign } { tick(1) }\n")?;
    for target in words("aarch64-unknown-none wasm32-unknown-unknown") {
        let b = nazm(h, plain, words(f"build --target {target} --objects o prog.nz"));
        check_that(b.code == 0, f"{target}: {b.stderr}")?;
    }
    scratch_remove(h, plain);
    ok()
}

@test
fn a_handle_and_a_c_struct_keep_what_they_are_across_a_module_boundary_and_in_the_cache(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "nazm.root", "")?;
    scratch_write(h, d, "lib.nz", LIB_DECLS)?;
    scratch_write(h, d, "prog.nz", LIB_PROG)?;
    scratch_write(h, d, "fixture.c", C)?;
    clang(h, d, "-c -O1 fixture.c -o fixture.o")?;
    for backend in words("llvm cranelift") {
        let mut k = 0;
        while k < 2 {
            // The second build reads the module's interface from the cache.
            let b = nazm(h, d, words(f"build --backend {backend} --link fixture.o prog.nz -o {d}/p-{backend}"));
            check_that(b.code == 0, f"{backend}: {b.stderr}")?;
            let x = run_exe(h, f"{d}/p-{backend}");
            check_that(x.stdout == "31040\n", f"{backend}: {ran_show(x)}")?;
            k = k + 1;
        }
    }
    // An importer cannot build what the interface says is a handle.
    scratch_write(h, d, "prog.nz", "use \"lib.nz\";\nfn f() -> Counter ! {} { Counter(x: 1) }\nfn main() -> Int { 0 }\n")?;
    let c = nazm(h, d, words("check --json prog.nz"));
    scratch_remove(h, d);
    check_that(codes_in(c) == "N0611", c.stderr)
}

/// The interface `nazm interface` prints for `src`: its canonical bytes.
fn interface_of(h: Caps, src: Str) -> Result[Str, Str] ! { io, spawn } {
    let d = prog_dir(h, "m.nz", src)?;
    let o = nazm(h, d, words("interface m.nz"));
    scratch_remove(h, d);
    check_that(o.code == 0, o.stderr)?;
    Result[Str, Str].Ok(value: o.stdout)
}

@test
fn a_c_struct_s_field_order_is_its_interface_and_an_ordinary_record_s_is_not(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let c_ab = interface_of(h, "pub extern \"C\" struct P { a: Int, b: Bool }\n")?;
    let c_ba = interface_of(h, "pub extern \"C\" struct P { b: Bool, a: Int }\n")?;
    check_that(c_ab != c_ba, "moving a C struct's fields moves where C reads them")?;
    let r_ab = interface_of(h, "pub struct P { a: Int, b: Bool }\n")?;
    let r_ba = interface_of(h, "pub struct P { b: Bool, a: Int }\n")?;
    check_that(r_ab == r_ba, "an ordinary record's order is not semantic")?;
    check_that(c_ab != r_ab, "a C struct is not an ordinary record of the same fields")?;
    let handle = interface_of(h, "pub extern \"C\" struct P;\n")?;
    check_that(handle != c_ab, "a handle is not a C struct")
}

/// Off macOS the Rust test is ignored, and this one passes without looking.
@test
fn a_shared_library_links_into_a_c_program_and_shows_only_its_exports(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    if !on_macos(h) {
        return ok();
    }
    for backend in words("llvm cranelift") {
        let d = prog_dir(h, "lib.nz", LIB)?;
        scratch_write(h, d, "main.c", HOST)?;
        let b = nazm(h, d, words(f"build --lib --shared --no-cache --backend {backend} lib.nz -o libnz.dylib"));
        check_that(b.code == 0, f"{backend}: {b.stderr}")?;
        // The same header a static library has.
        check_that(text_contains(read_text(h, f"{d}/libnz.h")?, "int64_t nazm_sum_squares(int64_t a0, int64_t a1);"), "the header")?;
        // Its interface is its exports and nothing of the compiler's or the runtime's.
        let nm = run(h, "nm", words("-gU libnz.dylib"), d, env_here(h.io));
        let symbols = strs_new();
        for l in text_lines(nm.stdout) {
            let ws = split_whitespace(l);
            if strs_len(ws) > 0 {
                strs_push(symbols, strs_get(ws, strs_len(ws) - 1));
            }
        }
        check_that(str_join(strs_sort(symbols), ",") == "_nazm_is_even,_nazm_sum_squares,_nazm_wrap", f"{backend}: {str_join(symbols, ",")}")?;
        clang(h, d, "main.c -L. -lnz -Wl,-rpath,@executable_path -o host")?;
        let fine = run(h, f"{d}/host", strs_new(), d, suite_env(h));
        check_that(fine.stdout == "25 1 0\n", f"{backend}: {ran_show(fine)}")?;
        // A failure inside an export ends the process; nothing unwinds into C.
        let f = run(h, f"{d}/host", words("x"), d, suite_env(h));
        scratch_remove(h, d);
        check_that(f.code == 2, f"{backend}: {ran_show(f)}")?;
        check_that(text_contains(f.stderr, "N0400"), f.stderr)?;
        check_that(!text_contains(f.stdout, "not reached"), f.stdout)?;
    }
    // `--shared` is a kind of library: without `--lib` it is refused by the command line.
    let d = prog_dir(h, "lib.nz", LIB)?;
    let o = nazm(h, d, words("build --shared lib.nz -o x"));
    scratch_remove(h, d);
    check_that(o.code != 0, ran_show(o))
}

/// What kind of object file `bytes` is, by its header: a shared library (ELF `ET_DYN`, Mach-O
/// `MH_DYLIB`), a static archive, or something else.
fn object_kind(bytes: Str) -> Str ! {} {
    let n = str_len(bytes);
    if text_starts_with(bytes, "!<arch>\n") {
        return "archive";
    }
    let elf = n >= 18 && str_byte(bytes, 0) == 127 && str_slice(bytes, 1, 4) == "ELF" && str_byte(bytes, 16) == 3 && str_byte(bytes, 17) == 0;
    let macho = n >= 16 && str_byte(bytes, 0) == 207 && str_byte(bytes, 1) == 250 && str_byte(bytes, 2) == 237 && str_byte(bytes, 3) == 254 && str_byte(bytes, 12) == 6 && str_byte(bytes, 13) == 0 && str_byte(bytes, 14) == 0 && str_byte(bytes, 15) == 0;
    if elf || macho { "shared library" } else { "other" }
}

/// N85 on every host: `--lib --shared` writes a shared library — an ELF `ET_DYN` on Linux, a
/// Mach-O dylib on macOS — and never a static archive under a shared library's name.
@test
fn a_shared_library_build_writes_a_shared_object_not_an_archive(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let name = if on_macos(h) { "libnz.dylib" } else { "libnz.so" };
    for backend in words("llvm cranelift") {
        let d = prog_dir(h, "lib.nz", LIB)?;
        let b = nazm(h, d, words(f"build --lib --shared --no-cache --backend {backend} lib.nz -o {name}"));
        check_that(b.code == 0, f"{backend}: {b.stderr}")?;
        check_that(object_kind(read_raw(h, f"{d}/{name}")?) == "shared library", backend)?;
        // And `--lib` alone is the archive: the two are told apart by the flag, not by the name.
        let s = nazm(h, d, words(f"build --lib --no-cache --backend {backend} lib.nz -o libnz.a"));
        check_that(s.code == 0, f"{backend}: {s.stderr}")?;
        let kind = object_kind(read_raw(h, f"{d}/libnz.a")?);
        scratch_remove(h, d);
        check_that(kind == "archive", backend)?;
    }
    ok()
}

/// The reason given for refusing the C text holding `c`, or `Err`.
fn refused_for(v: JsonDoc, c: Str) -> Result[Str, Str] ! {} {
    let mut i = 0;
    while i < jlen(v, "refused") {
        if text_contains(jstr(v, f"refused/{i}/c"), c) {
            return Result[Str, Str].Ok(value: jstr(v, f"refused/{i}/reason"));
        }
        i = i + 1;
    }
    Result[Str, Str].Err(error: f"{c} not refused: {jv(v, "")}")
}

@test
fn bindgen_reads_handles_structs_and_returned_strings_and_names_what_it_refuses(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "api.h", API_H)?;
    let o = nazm(h, d, words("bindgen api.h -o api.nz"));
    check_that(o.code == 1, "something was refused")?;
    let r = jparse(o.stdout)?;
    let translated = strs_new();
    let mut i = 0;
    while i < jlen(r, "translated") {
        strs_push(translated, jstr(r, f"translated/{i}/nazm"));
        i = i + 1;
    }
    same_strs("translated", translated, text_split("pub extern \"C\" struct db;|pub extern \"C\" struct counter;|pub extern \"C\" struct point { x: Int, flag: Bool, y: Int }|pub extern \"C\" struct seg { a: point, owner: counter, tag: Int }|pub extern \"C\" fn db_open(path: Str) -> Option[db] = \"db_open\";|pub extern \"C\" fn db_close(d: db) -> Int = \"db_close\";|pub extern \"C\" fn db_error(d: db) -> Option[Str] = \"db_error\";|pub extern \"C\" fn point_sum(p: point) -> Int = \"point_sum\";|pub extern \"C\" fn seg_score(s: seg) -> Int = \"seg_score\";", "|"))?;
    for case in text_split("struct grid|array;union u|union;point_make|by value;apply|function pointer;fill|buffer C writes into", ";") {
        let f = text_split(case, "|");
        let why = refused_for(r, strs_get(f, 0))?;
        check_that(text_contains(why, strs_get(f, 1)), f"{strs_get(f, 0)}: {why}")?;
    }
    // What it wrote checks.
    let module = read_text(h, f"{d}/api.nz")?;
    scratch_write(h, d, "prog.nz", f"{module}fn main() -> Int {{ 0 }}\n")?;
    let c = nazm(h, d, words("check prog.nz"));
    scratch_remove(h, d);
    check_that(c.code == 0, c.stderr)
}
