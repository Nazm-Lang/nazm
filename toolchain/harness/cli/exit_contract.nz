// The v1 command-line exit contract (Q1-C1, `docs/stability.md`, *Diagnostics and exit statuses*):
// six statuses, each meaning one thing, each reached here from real commands, and the machine
// summary carrying the same status the process returns. Ported from
// `crates/nazm-cli/tests/exit_contract.rs` (R7).
//
// | 0 | success | 1 | the source, program, package or request is invalid | 2 | the program ran and
// failed | 3 | a file or resource could not be found or read | 4 | the compiler, a tool it runs,
// or the machine failed | 5 | the command line itself is wrong |

use "@std/file"
use "@std/json"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/jsonq.nz"
use "../lib/strings.nz"
use "../lib/differential.nz"

fn project(h: Caps) -> Result[Str, Str] ! { io } {
    let d = scratch_new(h);
    check_that(str_len(d) > 0, "no scratch directory")?;
    scratch_write(h, d, "nazm.root", "")?;
    scratch_write(h, d, "ok.nz", "fn main() -> Int { 40 + 2 }\n")?;
    scratch_write(h, d, "wrong.nz", "fn main() -> Int { \"not an int\" }\n")?;
    scratch_write(h, d, "traps.nz", "fn sq(n: Int) -> Int { n * n }\nfn main() -> Int { sq(9223372036854775807) }\n")?;
    scratch_write(h, d, "uses_missing.nz", "use \"absent.nz\";\nfn main() -> Int { 0 }\n")?;
    Result[Str, Str].Ok(value: d)
}

/// Each command line of `cases` (`|`-separated) run in one project, with the status of the same
/// place in `wants`.
fn expect(h: Caps, cases: Str, wants: Str) -> Result[Int, Str] ! { io, spawn } {
    let d = project(h)?;
    let lines_ = text_split(cases, "|");
    let codes = words(wants);
    let mut i = 0;
    let mut out = Result[Int, Str].Ok(value: 0);
    while i < strs_len(lines_) {
        let args = strs_get(lines_, i);
        let want = parse_usize(strs_get(codes, i));
        let r = nazm(h, d, words(args));
        if r.code != want {
            out = Result[Int, Str].Err(error: f"nazm {args}: exit {r.code}, expected {want}: {r.stderr}");
            i = strs_len(lines_);
        }
        i = i + 1;
    }
    scratch_remove(h, d);
    out
}

@test
fn status_0_is_success(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect(h, "check ok.nz|run --interpret ok.nz|--help|--version|help check", "0 0 0 0 0")
}

@test
fn status_1_is_an_invalid_program_or_request(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A program that does not check; a request the command refuses (an executable over its own
    // source); a package name that is not one.
    expect(h, "check wrong.nz|run --interpret wrong.nz|build ok.nz -o ok.nz|init Not_A_Name", "1 1 1 1")
}

fn traps_built(h: Caps, d: Str) -> Result[Int, Str] ! { io, spawn } {
    let b = nazm(h, d, words("build traps.nz -o traps"));
    check_that(b.code == 0, b.stderr)?;
    let o = run(h, f"{d}/traps", strs_new(), "", suite_env(h));
    check_that(o.code == 2, ran_show(o))
}

@test
fn status_2_is_a_program_that_ran_and_failed(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    expect(h, "run --interpret traps.nz", "2")?;
    // The same program built: the executable's own status.
    let d = project(h)?;
    let r = traps_built(h, d);
    scratch_remove(h, d);
    r
}

@test
fn status_3_is_a_file_that_could_not_be_found_or_read(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A missing root; a module a `use` names; a foreign object `--link` names.
    expect(h, "check absent.nz|run --interpret absent.nz|check uses_missing.nz|build ok.nz --link absent.o -o out", "3 3 3 3")
}

@test
fn status_4_is_the_compiler_or_its_tools_failing(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // No `clang` on `PATH`: the machine cannot build a program that is fine.
    let d = project(h)?;
    let empty = scratch_new(h);
    let o = run(h, nazm_bin(io), words("build ok.nz -o out"), d, env_set(suite_env(h), "PATH", empty));
    let exists = file_exists_at(io, f"{d}/out");
    scratch_remove(h, d);
    scratch_remove(h, empty);
    check_that(o.code == 4, o.stderr)?;
    check_that(!exists, "a failed build left an executable")
}

@test
fn status_5_is_a_wrong_command_line(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A missing argument; an option value or combination the command line cannot take.
    expect(h, "--no-such-option|no-such-command||run|build ok.nz --layout sideways -o out|build ok.nz --target no-such-triple -o out|build ok.nz --stack-watermark -o out", "5 5 5 5 5 5 5")
}

/// A machine consumer reads the same status from the summary as from the process.
@test
fn the_summary_carries_the_status_the_process_returns(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = project(h)?;
    let cases = text_split("check ok.nz --summary-json|check wrong.nz --summary-json|check absent.nz --summary-json|build ok.nz -o ok.nz --summary-json|build ok.nz --layout sideways -o out --summary-json", "|");
    let wants = words("0 1 3 1 5");
    let states = words("success rejected unreadable refused refused");
    let mut i = 0;
    let mut out = Result[Int, Str].Ok(value: 0);
    while i < strs_len(cases) {
        let args = strs_get(cases, i);
        let want = parse_usize(strs_get(wants, i));
        let o = nazm(h, d, words(args));
        let r = summary_is(o, args, want, strs_get(states, i));
        match r {
            Result.Ok(value: n) => n,
            Result.Err(error: e) => {
                out = Result[Int, Str].Err(error: e);
                i = strs_len(cases);
                0
            },
        };
        i = i + 1;
    }
    scratch_remove(h, d);
    out
}

fn summary_is(o: Ran, args: Str, want: Int, state: Str) -> Result[Int, Str] ! {} {
    check_that(o.code == want, f"{args}: {ran_show(o)}")?;
    let v = match jparse(text_trim(o.stdout)) {
        Result.Ok(value: v) => v,
        Result.Err(error: e) => { return Result[Int, Str].Err(error: f"{args}: no summary ({e}): {o.stdout}"); },
    };
    check_that(jint(v, "exit_code") == want && jtext(v, "exit_code") == f"{want}", f"{args}: {o.stdout}")?;
    check_that(jstr(v, "status") == state, f"{args}: {o.stdout}")
}

/// A file of the two bytes `ff fe`, which are not UTF-8.
fn write_not_utf8(h: Caps, path: Str) -> Result[Int, Str] ! { io } {
    let v = h.v;
    let b = bytes_new(2);
    bytes_set(b, 0, 255);
    bytes_set(b, 1, 254);
    let f = match file_create(h.io, str_vouch(path)) {
        Result.Ok(value: f) => f,
        Result.Err(error: e) => { return Result[Int, Str].Err(error: path); },
    };
    let w = file_write(f, b);
    file_close(f);
    match w {
        Result.Ok(value: n) => Result[Int, Str].Ok(value: n),
        Result.Err(error: e) => Result[Int, Str].Err(error: path),
    }
}

fn unreadable_cases(h: Caps, d: Str) -> Result[Int, Str] ! { io, spawn } {
    write_not_utf8(h, f"{d}/bad.nz")?;
    for file in words("missing.nz bad.nz") {
        let lines_ = strs_new();
        strs_push(lines_, f"run --interpret {file}");
        strs_push(lines_, f"check {file}");
        strs_push(lines_, f"inspect {file}");
        strs_push(lines_, f"build {file} -o x");
        for args in lines_ {
            let o = nazm(h, d, words(args));
            check_that(o.code == 3, f"{args}: {o.stderr}")?;
            check_that(text_contains(o.stderr, "N0205"), f"{args}: {o.stderr}")?;
            check_that(text_contains(o.stderr, f"--> {file}:1:1"), f"{args}: {o.stderr}")?;
            check_that(!text_contains(o.stderr, "prelude"), f"{args}: {o.stderr}")?;
        }
        let o = nazm(h, d, words(f"check --json {file}"));
        let all = f"{o.stdout}{o.stderr}";
        let mut found = "";
        for l in lines(all) {
            if str_len(found) == 0 && text_contains(l, "\"N0205\"") {
                found = l;
            }
        }
        check_that(str_len(found) > 0, f"no N0205 line: {all}")?;
        let v = jparse(found)?;
        check_that(jstr(v, "code") == "N0205", found)?;
        // The span is the unreadable file's first byte, which it has none past.
        check_that(jtext(v, "primary/span/start") == "0", found)?;
    }
    // An imported file that exists but cannot be read is reported at itself too, not at the root
    // that imports it.
    scratch_write(h, d, "b.nz", "use \"bad.nz\";\nfn main() -> Int { 0 }\n")?;
    let o = nazm(h, d, words("check b.nz"));
    check_that(o.code == 3, o.stderr)?;
    check_that(text_contains(o.stderr, "--> bad.nz:1:1"), o.stderr)
}

/// Q1-D-09: a root file that cannot be read is reported at itself — exit 3, `N0205` — never at a
/// line of the core prelude; in text and in JSON, missing or not UTF-8, under every command that
/// loads a program.
@test
fn an_unreadable_root_is_reported_at_itself_not_at_the_prelude(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = scratch_new(h);
    let r = unreadable_cases(h, d);
    scratch_remove(h, d);
    r
}
