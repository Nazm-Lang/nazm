// Gate 3: the distributed foundation (`library/std/dist.nz`, `examples/apps/ledger/`,
// `docs/systems-domains.md` Part N). In one process, the `Local` transport; between two
// processes, over TCP, a ledger server stopped the moment a credit is logged and restarted on the
// same address, and a client whose retries carry it through — every credit applied exactly once.
// Ported from `crates/nazm-cli/tests/distributed.rs` (R7), with the harness's children left running
// (`lib/live.nz`) and a free port found with `@std/net` under a `NetCap`.

use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/port.nz"
use "../lib/live.nz"
use "../lib/tree.nz"
use "../lib/differential.nz"

@test
fn in_one_process_a_lost_answer_times_out_and_a_retry_is_applied_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = scratch_new(h);
    let src = f"{repo_root(h)}/crates/nazm-cli/tests/distributed/local.nz";
    let want = "1 -> 3\n2 -> 6\n3 -> 9\nagain 2 -> 6\na hello\na torn frame is refused\nframe bytes 28\n";
    let a = words("run --interpret");
    strs_push(a, src);
    let r = nazm(h, d, a);
    check_that(r.code == 0, r.stderr)?;
    check_that(r.stdout == f"{want}0\n", r.stdout)?;
    let exe = f"{d}/local";
    let b = words("build");
    strs_push(b, src);
    strs_push(b, "-o");
    strs_push(b, exe);
    let built = nazm(h, d, b);
    check_that(built.code == 0, built.stderr)?;
    let ran = run(h, exe, strs_new(), "", suite_env(h));
    scratch_remove(h, d);
    check_that(ran.code == 0, ran.stderr)?;
    check_that(ran.stdout == f"{want}0\n", "natively, the same")
}

fn args_of(a: Str, b: Str, c: Str) -> Strs ! {} {
    let s = strs_new();
    strs_push(s, a);
    strs_push(s, b);
    strs_push(s, c);
    s
}

@test
fn a_client_retries_through_a_server_restart_and_every_credit_is_applied_once(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap, net: NetCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = scratch_new(h);
    let exe = f"{d}/ledger";
    let b = words("build");
    strs_push(b, f"{repo_root(h)}/examples/apps/ledger/ledger.nz");
    strs_push(b, "-o");
    strs_push(b, exe);
    let built = nazm(h, d, b);
    check_that(built.code == 0, built.stderr)?;
    let addr = f"127.0.0.1:{free_port(net)?}";
    let log = f"{d}/log.txt";
    let env = suite_env(h);
    // The first server stops the moment credit 5 is in its log, before it answers.
    let sa = args_of("serve", addr, log);
    strs_push(sa, "die-after");
    strs_push(sa, "5");
    let first = start(h, exe, sa, "", env)?;
    // It is listening once it says so.
    let line = read_out(first, 9);
    check_that(line == "listening", line)?;
    let client = start(h, exe, args_of("client", addr, "8"), "", env)?;
    let first_code = wait_for(h, first, 30000);
    let why = rest_err(first);
    release(first);
    check_that(first_code == 9, f"the first server stopped: {first_code}")?;
    check_that(text_contains(why, "stopping after logging key 5"), why)?;
    // Restarted on the same address, it replays its log: credits 1 to 5, 150.
    let second = start(h, exe, args_of("serve", addr, log), "", env)?;
    let code = wait_for(h, client, 60000);
    kill(h, second);
    let said = rest_out(second);
    release(second);
    let out = rest_out(client);
    release(client);
    check_that(text_starts_with(said, "listening, balance 150\n"), said)?;
    check_that(code == 0, out)?;
    // Each credit's balance as of it: credit 5's answer is the log's, 150, not a second 50 on top.
    let want = strs_new();
    let mut k = 1;
    let mut sum = 0;
    while k <= 8 {
        sum = sum + k * 10;
        strs_push(want, f"{k} -> {sum}\n");
        k = k + 1;
    }
    check_that(out == f"{str_join(want, "")}balance 360\n0\n", out)?;
    // And the log holds each key once.
    let logged = read_text(h, log)?;
    scratch_remove(h, d);
    let keys = strs_new();
    for l in text_lines(logged) {
        strs_push(keys, strs_get(text_split(l, " "), 0));
    }
    check_that(str_join(keys, ",") == "1,2,3,4,5,6,7,8", str_join(keys, ","))
}
