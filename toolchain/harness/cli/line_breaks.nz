// R1, 5b.11 and 5b.19 (`docs/spec.md`, *`else if`, and a line break for `;`*): `else if` means
// `else { if … }`, and a line break — or a block's `}` — ends a statement where a `;` would.
// Ported from `crates/nazm-cli/tests/line_breaks.rs` (R7).
//
// Each program is asked of the interpreter and of each backend, with the same output and memory
// report; what still needs a `;` is refused by name; and `nazm fmt` lays a program without
// semicolons out as it lays one with them.

use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"

@test
fn else_if_chains_mean_nested_ifs_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, r#"fn size(n: Int) -> Int {
    if n < 10 { 1 } else if n < 100 { 2 } else if n < 1000 { 3 } else { 4 }
}

fn sign(o: Option[Int]) -> Int {
    if let Option.Some(value: v) = o {
        if v > 0 { 1 } else if v < 0 { 0 - 1 } else { 0 }
    } else if true {
        9
    } else {
        8
    }
}

fn pick(o: Option[Int]) -> Int {
    if false { 1 } else if let Option.Some(value: v) = o { v } else { 7 }
}

fn main(out: OutCap) -> Int ! {io} {
    let steps = size(5) * 1000 + size(50) * 100 + size(500) * 10 + size(5000);
    // As a statement: no value wanted, and no final `else`.
    if steps > 99999 { print("big\n"); } else if steps > 999 { print("mid\n"); }
    print(f"{steps} {sign(Option[Int].Some(value: 0 - 3))} {sign(Option[Int].None())} {pick(Option[Int].Some(value: 4))} {pick(Option[Int].None())}\n");
    0
}
"#, "mid\n1234 -1 9 4 7\n0")?;
    Result[Int, Str].Ok(value: 0)
}

fn without() -> Str ! {} {
    r#"use "@std/text"

const LIMIT: Int = 5

// Every statement on its own line, without a `;`.
fn total(n: Int) -> Int {
    let mut s = 0
    let mut i = 0
    while i < n {
        i = i + 1
        if i == 2 { continue }
        s = s +
            i
    }
    s
}

fn main(out: OutCap) -> Int ! {io} {
    let a = total(LIMIT) // a comment
    let b = a
        * 2
    let words = text_split("a b c", " ")
    print(f"{a} {b} {strs_len(words)}\n")
    let mut k = 0
    while true {
        k = k + 1
        if k == 3 { break }
    }
    let kind = if a > 10 { "big" } else if a > 5 { "mid" } else { "small" }
    print(kind); print("\n")
    k
}
"#
}

@test
fn a_program_without_semicolons_runs_alike_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    agrees(h, without(), "13 26 3\nbig\n3")?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_value_nobody_wants_is_discarded_and_reclaimed_everywhere(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // A loop body's last line, and the branches of an `if` that is a statement, ending in values
    // of different types or in none.
    agrees(h, r#"fn name(i: Int) -> Str { f"n{i}" }

fn main(out: OutCap) -> Int ! {io} {
    let mut i = 0
    while i < 3 {
        i = i + 1
        name(i)
    }
    for k in 0..3 {
        print(f"{k}")
        name(k)
    }
    print("\n")
    if i > 5 { name(1) } else if i > 1 { print("two\n") } else { name(2) }
    if i > 1 { name(3) } else if i > 0 { name(4) }
    i
}
"#, "012\ntwo\n3")?;
    // Where a value is wanted, the branches must still agree.
    same_strs("a value wanted", codes(h, "fn main() -> Int { let x = if true { 1 } else { \"a\" }; 0 }\n"), words("N0302"))?;
    same_strs("an if without else", codes(h, "fn f(c: Bool) -> Int { if c { 1 } else if !c { 2 } }\nfn main() -> Int { f(true) }\n"), words("N0302"))?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn what_a_line_break_does_not_end_is_still_refused(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    same_strs("two statements on one line", codes(h, "fn main() -> Int {\n    let a = 1 let b = 2;\n    b\n}\n"), words("N0100"))?;
    same_strs("a value after a `let`", codes(h, "fn main() -> Int {\n    let a = 1 a\n}\n"), words("N0100"))?;
    same_strs("a member's name on the next line", codes(h, "struct P { x: Int, }\nfn main() -> Int {\n    let p = P(x: 1);\n    let n = p.\n        x;\n    n\n}\n"), words("N0100"))?;
    Result[Int, Str].Ok(value: 0)
}

@test
fn the_formatter_lays_out_a_program_without_semicolons_and_keeps_it(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = scratch_new(h);
    let ugly = "fn main(out: OutCap) -> Int ! {io} {\nlet a = 1\n      let b = a +\n2\nif a > 0 { print(\"x\\n\") } else if b > 0 { print(\"y\\n\") }\nb\n}\n";
    scratch_write(h, d, "p.nz", ugly)?;
    let f = nazm(h, d, words("fmt p.nz"));
    if f.code != 0 {
        scratch_remove(h, d);
        return Result[Int, Str].Err(error: ran_show(f));
    }
    let once = read_text(h, f"{d}/p.nz")?;
    let want = "fn main(out: OutCap) -> Int ! { io } {\n    let a = 1\n    let b = a +\n            2\n    if a > 0 { print(\"x\\n\") } else if b > 0 { print(\"y\\n\") }\n    b\n}\n";
    let again = nazm(h, d, words("fmt --check p.nz"));
    let r = nazm(h, d, words("run --interpret p.nz"));
    scratch_remove(h, d);
    if once != want {
        return Result[Int, Str].Err(error: f"fmt wrote:\n{once}\nexpected:\n{want}");
    }
    if again.code != 0 {
        return Result[Int, Str].Err(error: ran_show(again));
    }
    if r.stdout != "x\n3\n" {
        return Result[Int, Str].Err(error: ran_show(r));
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_line_beginning_with_a_paren_or_bracket_is_a_new_statement(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // R1 close (epoch 75): a call's `(` and an index's `[` are on the line of what they apply to,
    // so the line after `let (a, b) = p` is not `p(b, a)`; and a pattern `let` ends at its line as
    // any `let` does.
    agrees(h, r#"fn swap(p: (Int, Str)) -> (Str, Int) {
    let (a, b) = p
    (b, a)
}

fn main(out: OutCap) -> Int ! {io} {
    let t = swap((1, "one"))
    println(f"{t.0} {t.1}")
    let xs: Ints = [1, 2]
    [3, 4]
    println(xs.len())
    0
}
"#, "one 1\n2\n0")?;
    Result[Int, Str].Ok(value: 0)
}
