// R1.5, D11: `nazm run` compiles with Cranelift and runs the executable; `nazm run --interpret`
// is the interpreter (`docs/user/spec.md`, *`nazm run` compiles*). Ported from
// `crates/nazm-cli/tests/run_compiled.rs` (R7).
//
// The two are asked the same questions and must give the same answers: each stream, the memory
// report, and the status. A program only a native build refuses is refused by `nazm run` with
// help naming `--interpret`, and runs under `--interpret`. Nothing `nazm` says about a build
// reaches the program's streams, the interpreter's limits are refused without the interpreter,
// and the temporary directory the executable is built in is gone afterwards.

use "@std/file"
use "@std/text"
use "../lib/run.nz"
use "../lib/scratch.nz"
use "../lib/differential.nz"

/// `nazm run` with `flags` before the file, `args` after `--` and `input` on standard input, with
/// the memory report on and `main`'s result as the exit status, `TMPDIR` set to `tmp`.
fn run_with(h: Caps, dir: Str, tmp: Str, flags: Strs, file: Str, args: Strs, input: Str) -> Ran ! { io, spawn } {
    let a = strs_new();
    strs_push(a, "run");
    for f in flags {
        strs_push(a, f);
    }
    strs_push(a, file);
    strs_push(a, "--");
    for x in args {
        strs_push(a, x);
    }
    let env = env_set(env_set(env_unset(env_here(h.io), "NAZM_RESULT_REPORT"), "NAZM_MEMORY_REPORT", "1"), "TMPDIR", tmp);
    run_input(h, nazm_bin(h.io), a, dir, env, input)
}

/// Two runs of one program: compiled, then interpreted.
struct Both {
    compiled: Ran,
    interpreted: Ran,
}

fn same_ran(a: Ran, b: Ran) -> Bool ! {} {
    a.code == b.code && a.stdout == b.stdout && a.stderr == b.stderr
}

/// The program `src` run both ways; `Err` when `nazm run` left anything in its `TMPDIR`.
fn both(h: Caps, src: Str, args: Strs, input: Str) -> Result[Both, Str] ! { io, spawn } {
    let d = prog_dir(h, "prog.nz", src)?;
    let tmp = scratch_new(h);
    let compiled = run_with(h, d, tmp, strs_new(), "prog.nz", args, input);
    let interpreted = run_with(h, d, tmp, words("--interpret"), "prog.nz", args, input);
    // The executable and the directory it was built in are removed, whatever the program did.
    let left = match dir_list(h.io, tmp) {
        Result.Ok(value: xs) => xs,
        Result.Err(error: e) => words("(unreadable)"),
    };
    scratch_remove(h, d);
    scratch_remove(h, tmp);
    check_that(strs_len(left) == 0, f"`nazm run` left {str_join(left, ", ")} behind")?;
    Result[Both, Str].Ok(value: Both(compiled: compiled, interpreted: interpreted))
}

fn echo() -> Str ! {} {
    r#"use "@std/io";
fn main(io: IoCap) -> Int ! { io } {
    let v = vec_new[Str]();
    vec_push(v, arg(0));
    println(str_concat("arg: ", vec_get(v, 0)));
    match io_stdin_read_line(io) {
        Result.Ok(value: o) => match o {
            Option.Some(value: s) => print(f"read {s}\n"),
            Option.None() => print("end\n"),
        },
        Result.Err(error: e) => print("error\n"),
    }
    eprintln("to stderr");
    7
}
"#
}

@test
fn a_compiled_run_and_the_interpreter_agree_on_every_stream_and_the_status(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let b = both(h, echo(), words("first"), "a line\n")?;
    let c = b.compiled;
    check_that(same_ran(c, b.interpreted), f"{ran_show(c)} vs {ran_show(b.interpreted)}")?;
    check_that(c.code == 7, ran_show(c))?;
    // Nothing about the build: no executable path on stdout, no authority line on stderr.
    check_that(c.stdout == "arg: first\nread a line\n", ran_show(c))?;
    check_that(text_starts_with(c.stderr, "to stderr\nnazm-memory: "), ran_show(c))
}

@test
fn the_exit_status_passes_through(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let bodies = text_split("0|3|255|exit_with(42)|let d = 0;\n    10 / d", "|");
    let codes = ints_new();
    for c in words("0 3 255 42 2") {
        ints_push(codes, parse_usize(c));
    }
    let mut i = 0;
    while i < strs_len(bodies) {
        let body = strs_get(bodies, i);
        let code = ints_get(codes, i);
        let src = f"fn main(io: IoCap) -> Int ! {{ io }} {{\n    {body}\n}}\n";
        let b = both(h, src, strs_new(), "")?;
        check_that(b.compiled.code == code, f"{body}: {ran_show(b.compiled)}")?;
        check_that(b.compiled.code == b.interpreted.code, f"{body}: {ran_show(b.interpreted)}")?;
        check_that(b.compiled.stdout == b.interpreted.stdout, body)?;
        i = i + 1;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_program_only_a_native_build_refuses_is_refused_with_help_naming_interpret(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let srcs = strs_new();
    // Outside the backend's subset (`N0101`).
    strs_push(srcs, "fn main() -> Bool {\n    true\n}\n");
    // Polymorphic recursion: native instances that would never end (`N0357`).
    strs_push(srcs, "fn grow[T](x: T, n: Int) -> Int {\n    if n == 0 { 0 } else {\n        let v = vec_new[T]();\n        vec_push(v, x);\n        grow(v, n - 1) + 1\n    }\n}\nfn main() -> Int {\n    print(\"ran\\n\");\n    grow(1, 3)\n}\n");
    let codes = words("N0101 N0357");
    let says = strs_new();
    strs_push(says, "true\n");
    strs_push(says, "ran\n");
    let mut i = 0;
    while i < 2 {
        let code = strs_get(codes, i);
        let b = both(h, strs_get(srcs, i), strs_new(), "")?;
        let c = b.compiled;
        check_that(c.code == 1, f"{code}: {ran_show(c)}")?;
        check_that(str_len(c.stdout) == 0, f"{code}: nothing ran")?;
        check_that(text_contains(c.stderr, code), f"{code}: {ran_show(c)}")?;
        check_that(text_contains(c.stderr, "help: `nazm run` compiles, with Cranelift, and falls back to nothing; `nazm run --interpret` runs this program in the interpreter"), f"{code}: {ran_show(c)}")?;
        // The interpreter runs it: neither path falls back to the other, and both exist.
        check_that(text_starts_with(b.interpreted.stdout, strs_get(says, i)), f"{code}: {ran_show(b.interpreted)}")?;
        i = i + 1;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn a_program_that_does_not_check_gets_no_interpret_help(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    // The interpreter would refuse it too, so naming `--interpret` would send the reader nowhere.
    let b = both(h, "fn main() -> Int {\n    nothing_here\n}\n", strs_new(), "")?;
    let c = b.compiled;
    check_that(c.code == 1, ran_show(c))?;
    check_that(c.code == b.interpreted.code, ran_show(b.interpreted))?;
    check_that(text_contains(c.stderr, "N0200"), ran_show(c))?;
    check_that(!text_contains(c.stderr, "--interpret"), ran_show(c))
}

fn limits(h: Caps, d: Str) -> Result[Int, Str] ! { io, spawn } {
    for flag in words("--max-iterations --max-depth") {
        let compiled = run_with(h, d, d, words(f"{flag} 100"), "prog.nz", strs_new(), "");
        check_that(compiled.code == 5, f"{flag}: {ran_show(compiled)}")?;
        check_that(text_contains(compiled.stderr, "--interpret"), f"{flag}: {ran_show(compiled)}")?;
        let interpreted = run_with(h, d, d, words(f"--interpret {flag} 100"), "prog.nz", strs_new(), "");
        check_that(interpreted.code == 0, f"{flag}: {ran_show(interpreted)}")?;
    }
    Result[Int, Str].Ok(value: 0)
}

@test
fn the_interpreters_limits_are_refused_without_the_interpreter(io: IoCap, p: ProcessCap, sp: SpawnCap, v: VouchCap, t: TimeCap) -> Result[Int, Str] ! { io, spawn } {
    let h = caps(io, p, sp, v, t);
    let d = prog_dir(h, "prog.nz", "fn main() -> Int { 0 }\n")?;
    let r = limits(h, d);
    scratch_remove(h, d);
    r
}
