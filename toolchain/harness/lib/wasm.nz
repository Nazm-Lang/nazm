// A WebAssembly binary's import section, read from its bytes (R7): what `wasm.rs` and
// `wasm_contract.rs` read with their own `imports`. A module's imports are what it can ask of its
// host.

/// A cursor over a binary's bytes.
pub struct Cursor {
    at: Ints,
}

fn leb(b: Str, c: Cursor) -> Int ! {} {
    let mut n = 0;
    let mut shift = 1;
    let mut going = true;
    while going {
        let at = ints_get(c.at, 0);
        let byte = str_byte(b, at);
        ints_set(c.at, 0, at + 1);
        n = n + (byte % 128) * shift;
        shift = shift * 128;
        going = byte >= 128;
    }
    n
}

fn wasm_name(b: Str, c: Cursor) -> Str ! {} {
    let n = leb(b, c);
    let at = ints_get(c.at, 0);
    ints_set(c.at, 0, at + n);
    str_slice(b, at, at + n)
}

/// `module.name` of every import a WebAssembly binary declares.
pub fn imports(bytes: Str) -> Strs ! {} {
    let out = strs_new();
    let c = Cursor(at: ints_new());
    ints_push(c.at, 8);
    while ints_get(c.at, 0) < str_len(bytes) {
        let at = ints_get(c.at, 0);
        let id = str_byte(bytes, at);
        ints_set(c.at, 0, at + 1);
        let size = leb(bytes, c);
        let end = ints_get(c.at, 0) + size;
        if id == 2 {
            let count = leb(bytes, c);
            let mut i = 0;
            while i < count {
                let module = wasm_name(bytes, c);
                let field = wasm_name(bytes, c);
                let p = ints_get(c.at, 0);
                let kind = str_byte(bytes, p);
                ints_set(c.at, 0, p + 1);
                if kind == 0 {
                    leb(bytes, c);
                } else {
                    if kind == 1 || kind == 2 {
                        if kind == 1 {
                            ints_set(c.at, 0, ints_get(c.at, 0) + 1);
                        }
                        let flags = leb(bytes, c);
                        leb(bytes, c);
                        if flags % 2 == 1 {
                            leb(bytes, c);
                        }
                    } else {
                        ints_set(c.at, 0, ints_get(c.at, 0) + 2);
                    }
                }
                strs_push(out, f"{module}.{field}");
                i = i + 1;
            }
        }
        ints_set(c.at, 0, end);
    }
    out
}

/// Whether `bytes` starts with WebAssembly's magic, `\0asm`.
pub fn is_wasm(bytes: Str) -> Bool ! {} {
    str_len(bytes) >= 4 && str_byte(bytes, 0) == 0 && str_slice(bytes, 1, 4) == "asm"
}
