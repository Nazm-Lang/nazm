// Reading a JSON document by path (R7): what a Rust test writes as `v["requirements"][0]["id"]`
// is `jq(doc, "requirements/0/id")` here — each segment a key, or an index where it is a number.

use "@std/json"
use "@std/text"

/// The document `text` is, or `Err` (JSON with fractions and exponents read too).
pub fn jparse(text: Str) -> Result[JsonDoc, Str] ! {} {
    json_parse_floats(text)
}

fn index_of(seg: Str) -> Int ! {} {
    if str_len(seg) == 0 {
        return 0 - 1;
    }
    let mut n = 0;
    let mut i = 0;
    while i < str_len(seg) {
        let c = str_byte(seg, i);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    n
}

/// The node at `path` under the root, `-1` where there is none (`Value::Null` in Rust).
pub fn jq(doc: JsonDoc, path: Str) -> Int ! {} {
    let mut node = json_root(doc);
    if str_len(path) == 0 {
        return node;
    }
    for seg in text_split(path, "/") {
        let i = index_of(seg);
        let next = if i >= 0 && json_kind(doc, node) == "array" { json_at(doc, node, i) } else if json_kind(doc, node) == "object" { json_get(doc, node, seg) } else { Option[Int].None() };
        node = match next {
            Option.Some(value: n) => n,
            Option.None() => { return 0 - 1; },
        };
    }
    node
}

/// The string at `path`, or `""`.
pub fn jstr(doc: JsonDoc, path: Str) -> Str ! {} {
    let n = jq(doc, path);
    if n < 0 {
        return "";
    }
    match json_str(doc, n) {
        Option.Some(value: s) => s,
        Option.None() => "",
    }
}

/// The integer at `path`, or `-1`.
pub fn jint(doc: JsonDoc, path: Str) -> Int ! {} {
    let n = jq(doc, path);
    if n < 0 {
        return 0 - 1;
    }
    match json_int(doc, n) {
        Option.Some(value: i) => i,
        Option.None() => 0 - 1,
    }
}

/// The node at `path` written as JSON, or `null` where there is none: for comparing two values
/// whole, as `assert_eq!` on `serde_json::Value`s does.
pub fn jtext(doc: JsonDoc, path: Str) -> Str ! {} {
    let n = jq(doc, path);
    if n < 0 { "null" } else { json_encode_node(doc, n) }
}

/// The length of the array at `path`, `-1` where there is none: `v[..].as_array().unwrap().len()`.
pub fn jlen(doc: JsonDoc, path: Str) -> Int ! {} {
    let n = jq(doc, path);
    if n < 0 || json_kind(doc, n) != "array" {
        return 0 - 1;
    }
    json_len(doc, n)
}

/// Whether the node `na` of `a` and the node `nb` of `b` are one JSON value, an object's keys in
/// any order: `serde_json::Value`'s `==` (a missing node, `-1`, is `null`).
pub fn jsame_at(a: JsonDoc, na: Int, b: JsonDoc, nb: Int) -> Bool ! {} {
    let ka = if na < 0 { "null" } else { json_kind(a, na) };
    let kb = if nb < 0 { "null" } else { json_kind(b, nb) };
    if ka != kb {
        return false;
    }
    if ka == "null" {
        return true;
    }
    if ka == "array" {
        if json_len(a, na) != json_len(b, nb) {
            return false;
        }
        let mut i = 0;
        while i < json_len(a, na) {
            let x = match json_at(a, na, i) { Option.Some(value: n) => n, Option.None() => 0 - 1, };
            let y = match json_at(b, nb, i) { Option.Some(value: n) => n, Option.None() => 0 - 1, };
            if !jsame_at(a, x, b, y) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if ka == "object" {
        if json_len(a, na) != json_len(b, nb) {
            return false;
        }
        let mut i = 0;
        while i < json_len(a, na) {
            let key = match json_key_at(a, na, i) { Option.Some(value: k) => k, Option.None() => "", };
            let x = match json_value_at(a, na, i) { Option.Some(value: n) => n, Option.None() => 0 - 1, };
            let y = match json_get(b, nb, key) {
                Option.Some(value: n) => n,
                Option.None() => { return false; },
            };
            if !jsame_at(a, x, b, y) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    json_encode_node(a, na) == json_encode_node(b, nb)
}

/// Whether the values at `pa` in `a` and `pb` in `b` are one JSON value (`jsame_at`).
pub fn jsame(a: JsonDoc, pa: Str, b: JsonDoc, pb: Str) -> Bool ! {} {
    jsame_at(a, jq(a, pa), b, jq(b, pb))
}

/// Whether the value at `path` of `doc` is the JSON `text` (`assert_eq!(v[..], json!(..))`).
pub fn jis(doc: JsonDoc, path: Str, text: Str) -> Bool ! {} {
    match jparse(text) {
        Result.Ok(value: want) => jsame(doc, path, want, ""),
        Result.Err(error: e) => false,
    }
}

/// The node at `path` written as JSON (`null` where there is none): a JSON value compared whole,
/// as `assert_eq!` on two `serde_json::Value`s compares them.
pub fn jv(doc: JsonDoc, path: Str) -> Str ! {} {
    jtext(doc, path)
}
