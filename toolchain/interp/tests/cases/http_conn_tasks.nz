// crates/nazm-cli/tests/http.rs, connections_served_in_tasks_of_their_own_answer_concurrent_clients.
use "@std/ioerror";
use "@std/net";
use "@std/http";
fn line(out: OutCap, s: Str) -> Int { print(str_concat(s, str_from_byte(10))) }
// `|` is CRLF, `~` a bare LF, `^` a bare CR, a backtick a NUL byte.
fn wire(s: Str) -> Str {
    let parts = strs_new();
    let mut i = 0;
    while i < str_len(s) {
        let b = str_byte(s, i);
        if b == 124 { strs_push(parts, str_concat(str_from_byte(13), str_from_byte(10))); } else {
            if b == 126 { strs_push(parts, str_from_byte(10)); } else {
                if b == 94 { strs_push(parts, str_from_byte(13)); } else {
                    if b == 96 { strs_push(parts, str_from_byte(0)); } else { strs_push(parts, str_from_byte(b)); }
                }
            }
        }
        i = i + 1;
    }
    str_join(parts, "")
}
fn hello(r: Request) -> Response ! {} {
http_text(200, str_concat(str_concat(r.method, " "), str_concat(str_concat(match http_param(r, "name") { Option.Some(value: n) => n, Option.None() => "?", }, " "), r.body)))
}
fn routes() -> fn(Request) -> Response ! { io } ! {} {
http_router_handler(http_router_post(http_router_get(http_router(), "/hello/{name}", hello), "/echo/{name}", hello))
}
fn shown(r: Result[Response, HttpError]) -> Str {
match r {
Result.Ok(value: x) => str_concat(str_concat(int_to_str(x.status), " "), x.body),
Result.Err(error: e) => str_concat("ERR ", http_error_show(e)),
}
}
fn quick() -> ServeOptions {
let d = http_serve_options();
ServeOptions(max_head: d.max_head, max_headers: d.max_headers, max_target: d.max_target, max_body: d.max_body, head_timeout_ms: 300, idle_timeout_ms: 2000, body_timeout_ms: 300, write_timeout_ms: 2000, max_requests: d.max_requests, max_connections: d.max_connections)
}
fn conn(s: HttpServer, c: HttpConn) -> Int ! { io } {
http_serve_conn(s, c, routes())
}
fn accept_all(t: SpawnCap, s: HttpServer) -> Int ! { io, spawn } {
let mut running = true;
scope {
while running {
match http_accept(s) {
Result.Ok(value: c) => { spawn conn(s, c); },
Result.Err(error: e) => { running = false; },
};
}
}
0
}
fn client(net: NetCap, base: Str, k: Int, done: Chan[Str]) -> Int ! { io } {
let mut ok = 0;
match http_connect(net, base, http_client_options()) {
Result.Ok(value: c) => {
let mut i = 0;
while i < 3 {
let want = str_concat(str_concat("POST c", int_to_str(k)), str_concat(" ", int_to_str(i)));
if shown(http_send(c, http_request("POST", str_concat("/echo/c", int_to_str(k)), int_to_str(i)))) == str_concat("200 ", want) { ok = ok + 1; }
i = i + 1;
}
http_close(c);
},
Result.Err(error: e) => {},
};
chan_send_of(done, int_to_str(ok));
0
}
fn main(net: NetCap, t: SpawnCap, out: OutCap) -> Int ! { io, spawn } {
match http_listen(net, "127.0.0.1:0", quick()) {
Result.Ok(value: s) => {
let base = str_concat("http://", http_server_addr(s));
let done = chan_new_of[Str](8);
let got = vec_new[Str]();
let mut total = 0;
scope {
spawn accept_all(t, s);
scope {
spawn client(net, base, 1, done);
spawn client(net, base, 2, done);
spawn client(net, base, 3, done);
spawn client(net, base, 4, done);
}
let mut k = 0;
while k < 4 { if chan_recv_of(done, got) { if vec_pop(got) == "3" { total = total + 1; } } k = k + 1; }
http_drain(s);
}
line(out, int_to_str(total));
line(out, str_concat(int_to_str(atomic_load(s.served)), str_concat(" on ", int_to_str(atomic_load(s.accepted)))));
},
Result.Err(error: e) => { line(out, io_error_show(e)); },
};
0
}
