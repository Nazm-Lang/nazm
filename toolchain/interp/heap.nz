// The heap and its counting (`openspec/changes/r4-interpreter/design.md`, D4): every handle is an
// object here, reference-counted explicitly at the points the Rust interpreter's `Clone` and `Drop`
// act, so the memory report's four classes agree with `crates/nazm-core/src/eval/value.rs`.

use "types.nz"

pub fn heap_new() -> Heap {
    let h = Heap(kind: ints_new(), rc: ints_new(), room: ints_new(), items: vec_new[Vec[V]](),
            free: ints_new(), counts: [0, 0, 0, 0, 0, 0, 0, 0], work: vec_new[V](), busy: [0], none: vec_new[V](),
            flag: ints_new(), sched: [0, 0, 0, 0, 1], reaped: ints_new())
            // Object 0 is never allocated: a `Str` whose `obj` is 0 is immortal.
            ints_push(h.kind, K_FREE)
    ints_push(h.rc, 0)
    ints_push(h.room, 0)
    ints_push(h.flag, 0)
    vec_push(h.items, h.none)
    h
}

/// The memory report's class of an object kind, or -1 for one it does not count.
fn class(kind: Int) -> Int {
    if kind == K_STR || kind == K_GROWN || kind == K_BYTES {
        C_STR
    } else if kind == K_SEQ {
        C_SEQ
    } else if kind == K_CHAN {
        C_CHAN
    } else if kind == K_FUNC {
        C_CLO
    } else {
        0 - 1
    }
}

/// A new object of `kind` with one reference, counted in its class.
pub fn alloc(h: Heap, kind: Int, room: Int) -> Int {
    let c = class(kind)
    if c >= 0 {
        ints_set(h.counts, c, ints_get(h.counts, c) + 1)
    }
    let items = if kind == K_SEQ || kind == K_FUNC || kind == K_CHAN { vec_new[V]() } else { h.none }
    if ints_len(h.free) > 0 {
        let id = ints_pop(h.free)
        ints_set(h.kind, id, kind)
        ints_set(h.rc, id, 1)
        ints_set(h.room, id, room)
        ints_set(h.flag, id, 0)
        vec_set(h.items, id, items)
        id
    } else {
        ints_push(h.kind, kind)
        ints_push(h.rc, 1)
        ints_push(h.room, room)
        ints_push(h.flag, 0)
        vec_push(h.items, items)
        ints_len(h.kind) - 1
    }
}

/// A sequence's storage.
pub fn items(h: Heap, obj: Int) -> Vec[V] {
    vec_get(h.items, obj)
}

/// A new string the program allocated: one counted backing.
pub fn heap_str(h: Heap, s: Str) -> V {
    V.Str(s: s, obj: alloc(h, K_STR, 0), start: 0)
}

// A record's or enum value's `def` packs three facts: whether one of its fields holds a reference
// (bit 0), its definition's interned name (bits 1 to 23), and — when it holds one — the heap
// object that counts the value's copies (above), so that copying a record of handles takes one
// reference and not one per field. A value of plain data is retained and released at no cost.

const NAME_SPAN: Int = 8388608

/// The interned name of a record's or enum value's type.
pub fn dname(d: Int) -> Int {
    (d / 2) % NAME_SPAN
}

/// The object that counts a record's or enum value's copies, or 0.
pub fn drid(d: Int) -> Int {
    d / (2 * NAME_SPAN)
}

/// A new value's `def`, for its type `name` and its `fields`: one count of its own when a field
/// holds a reference.
pub fn def_bits(h: Heap, name: Int, fields: Vec[V]) -> Int {
    for f in fields {
        if holds(f) { return alloc(h, K_AGG, 0) * 2 * NAME_SPAN + name * 2 + 1 }
    }
    name * 2
}

/// Take another reference to whatever `v` holds, given only the heap's counts — what the loop's
/// hot paths call, since passing the whole heap record costs a count of each of its handles.
pub fn inc(rc: Ints, v: V) {
    match v {
        V.Str(s: _, obj: o, start: _) => {
            if o > 0 { ints_set(rc, o, ints_get(rc, o) + 1) }
        },
        V.Ref(obj: o) => ints_set(rc, o, ints_get(rc, o) + 1),
        V.Byt(b: _, obj: o) => ints_set(rc, o, ints_get(rc, o) + 1),
        V.Rec(def: d, fields: _) => {
            if d % 2 == 1 { ints_set(rc, drid(d), ints_get(rc, drid(d)) + 1) }
        },
        V.Enm(def: d, variant: _, fields: _) => {
            if d % 2 == 1 { ints_set(rc, drid(d), ints_get(rc, drid(d)) + 1) }
        },
        V.Arr(items: fs) => {
            for f in fs { inc(rc, f) }
        },
        _ => { },
    }
}

/// Give up a reference to what `v` holds when that is not the last one, given only the counts:
/// whether it was done. When it was not, the caller releases `v` (`release`).
pub fn dec(rc: Ints, v: V) -> Bool {
    let o = match v {
        V.Str(s: _, obj: x, start: _) => x,
        V.Ref(obj: x) => x,
        V.Byt(b: _, obj: x) => x,
        V.Rec(def: d, fields: _) => if d % 2 == 1 { drid(d) } else { 0 },
        V.Enm(def: d, variant: _, fields: _) => if d % 2 == 1 { drid(d) } else { 0 },
        V.Arr(items: _) => { return false },
        _ => 0,
    }
    if o == 0 { return true }
    let n = ints_get(rc, o)
    if n <= 1 { return false }
    ints_set(rc, o, n - 1)
    true
}

/// Take another reference to whatever `v` holds.
pub fn retain(h: Heap, v: V) {
    inc(h.rc, v)
}

pub fn holds(v: V) -> Bool {
    match v {
        V.Str(s: _, obj: o, start: _) => o > 0,
        V.Ref(obj: o) => true,
        V.Byt(b: _, obj: o) => true,
        V.Rec(def: d, fields: _) => d % 2 == 1,
        V.Enm(def: d, variant: _, fields: _) => d % 2 == 1,
        V.Arr(items: _) => true,
        _ => false,
    }
}

/// Give up the references `v` holds. An object whose last reference goes is reclaimed, counted,
/// and gives up what it holds in turn — through a worklist, never by recursion through objects, so
/// a long chain of boxes is released in constant stack, as Rust's `release` does. An aggregate's
/// fields are released in place: their nesting is the type's, which is bounded.
pub fn release(h: Heap, v: V) {
    match v {
        V.Str(s: _, obj: o, start: _) => {
            if o > 0 { drop_ref(h, o); }
        },
        V.Ref(obj: o) => { drop_ref(h, o); },
        V.Byt(b: _, obj: o) => { drop_ref(h, o); },
        V.Rec(def: d, fields: fs) => {
            if d % 2 == 1 && last(h, drid(d)) {
                for f in fs { release(h, f) }
            }
        },
        V.Enm(def: d, variant: _, fields: fs) => {
            if d % 2 == 1 && last(h, drid(d)) {
                for f in fs { release(h, f) }
            }
        },
        V.Arr(items: fs) => {
            for f in fs { release(h, f) }
        },
        _ => { },
    }
}

/// Give up one reference to aggregate object `o`: whether it was the last, the object then free.
fn last(h: Heap, o: Int) -> Bool {
    let n = ints_get(h.rc, o) - 1
    ints_set(h.rc, o, n)
    if n > 0 { return false }
    ints_set(h.kind, o, K_FREE)
    ints_push(h.free, o)
    true
}

fn drop_ref(h: Heap, o: Int) {
    let n = ints_get(h.rc, o) - 1
    ints_set(h.rc, o, n)
    if n > 0 { return }
    let kind = ints_get(h.kind, o)
    let c = class(kind)
    if c >= 0 {
        ints_set(h.counts, c + 1, ints_get(h.counts, c + 1) + 1)
    }
    let held = vec_get(h.items, o)
    vec_set(h.items, o, h.none)
    ints_set(h.kind, o, K_FREE)
    ints_push(h.free, o)
    if vec_len(held) == 0 { return }
    for x in held {
        if holds(x) { vec_push(h.work, x) }
    }
    // The outermost reclamation empties the worklist; one nested in it only adds to it.
    if ints_get(h.busy, 0) == 1 { return }
    ints_set(h.busy, 0, 1)
    while vec_len(h.work) > 0 {
        release(h, vec_pop(h.work))
    }
    ints_set(h.busy, 0, 0)
}

/// Whether `obj` has exactly one reference.
pub fn unique(h: Heap, obj: Int) -> Bool {
    ints_get(h.rc, obj) == 1
}
