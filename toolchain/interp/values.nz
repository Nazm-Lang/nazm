// Operations on values beyond `Int`: comparison, equality, the derived order and hash by the
// language's law (`crates/nazm-core/src/eval/arith.rs`), numbers' failures, and strings' append.

use "types.nz"
use "heap.nz"
use "vm.nz"
use "num.nz"
use "numkinds.nz"
use "shapes.nz"

/// The failure a numeric operation stops the program with (`arith.rs`, `num_failure`).
pub fn num_failure(p: Prog, vm: Vm, pc: Int, err: Int, what: Str, kind: Int) -> V {
    if err == E_ZERO {
        return fail(p, vm, pc, "N0401", "division by zero",
                "guard the divisor, for example `if d != 0 { n / d } else { 0 }`")
    }
    if err == E_SHIFT {
        let bits = kind_bits(kind)
        return fail(p, vm, pc, "N0412", f"this shift amount is outside `0..{bits}`",
                "a shift by a negative amount, or by the width or more, stops the program")
    }
    let name = kind_name(kind)
    fail(p, vm, pc, "N0400", f"this {what} overflows `{name}`",
            "overflow stops the program rather than wrapping; `wrapping_add` and its kin wrap")
}

/// Built-in equality (`arith.rs`, `equal`): 1, 0, or -1 for what has none.
pub fn equal(h: Heap, a: V, b: V) -> Int {
    match (a, b) {
        (V.Int(v: x), V.Int(v: y)) => if x == y { 1 } else { 0 },
        (V.Bool(v: x), V.Bool(v: y)) => if x == y { 1 } else { 0 },
        (V.Str(s: x, obj: o, start: s1), V.Str(s: y, obj: q, start: s2)) => if x == y { 1 } else { 0 },
        (V.Num(kind: k, v: x), V.Num(kind: j, v: y)) => if x == y { 1 } else { 0 },
        // IEEE 754's: a NaN equals nothing.
        (V.Flt(kind: k, v: x), V.Flt(kind: j, v: y)) => if x == y { 1 } else { 0 },
        (V.Rec(def: d, fields: xs), V.Rec(def: e, fields: ys)) => all_equal(h, xs, ys),
        (V.Enm(def: d, variant: i, fields: xs), V.Enm(def: e, variant: j, fields: ys)) => {
            if i != j { 0 } else { all_equal(h, xs, ys) }
        },
        (V.Arr(items: xs), V.Arr(items: ys)) => all_equal(h, xs, ys),
        // A `Box` or `List`, which the interpreter holds as a sequence: by what it holds.
        (V.Ref(obj: x), V.Ref(obj: y)) => {
            if x == y { return 1 }
            let xs = items(h, x)
            let ys = items(h, y)
            if vec_len(xs) != vec_len(ys) { return 0 }
            for i in 0..vec_len(xs) {
                let e = equal(h, vec_get(xs, i), vec_get(ys, i))
                if e != 1 { return e }
            }
            1
        },
        _ => 0 - 1,
    }
}

fn all_equal(h: Heap, xs: List[V], ys: List[V]) -> Int {
    if list_len(xs) != list_len(ys) { return 0 - 1 }
    for i in 0..list_len(xs) {
        let e = equal(h, list_get(xs, i), list_get(ys, i))
        if e != 1 { return e }
    }
    1
}

/// Byte order of two strings: -1, 0 or 1.
fn str_order(a: Str, b: Str) -> Int {
    if a < b { 0 - 1 } else if a == b { 0 } else { 1 }
}

/// The derived order (`arith.rs`, `order`): -1, 0, 1, or -2 for what has none.
pub fn order(p: Prog, a: V, b: V) -> Int {
    match (a, b) {
        (V.Int(v: x), V.Int(v: y)) => if x < y { 0 - 1 } else if x > y { 1 } else { 0 },
        (V.Num(kind: k, v: x), V.Num(kind: j, v: y)) => {
            if compare(2, a, b) { 0 - 1 } else if compare(0, a, b) { 0 } else { 1 }
        },
        (V.Bool(v: x), V.Bool(v: y)) => if x == y { 0 } else if y { 0 - 1 } else { 1 },
        (V.Str(s: x, obj: o, start: s1), V.Str(s: y, obj: q, start: s2)) => str_order(x, y),
        (V.Rec(def: d, fields: xs), V.Rec(def: e, fields: ys)) => {
            let canon = record_order(p.shapes, strs_get(p.names, dname(d)), list_len(xs))
            fields_order(p, canon, xs, ys)
        },
        (V.Enm(def: d, variant: i, fields: xs), V.Enm(def: e, variant: j, fields: ys)) => {
            let ty = strs_get(p.names, dname(d))
            if i != j { return variant_rank(p.shapes, ty, i, j) }
            fields_order(p, payload_order(p.shapes, ty, i, list_len(xs)), xs, ys)
        },
        _ => 0 - 2,
    }
}

fn fields_order(p: Prog, canon: Ints, xs: List[V], ys: List[V]) -> Int {
    for i in canon {
        let o = order(p, list_get(xs, i), list_get(ys, i))
        if o != 0 { return o }
    }
    0
}

/// A comparison of anything but two `Int`s.
pub fn compare_values(p: Prog, vm: Vm, pc: Int, op: Int, l: V, r: V) -> V {
    match (l, r) {
        (V.Num(kind: k, v: x), V.Num(kind: j, v: y)) => { return V.Bool(v: compare(op, l, r)) },
        (V.Flt(kind: k, v: x), V.Flt(kind: j, v: y)) => { return V.Bool(v: compare(op, l, r)) },
        _ => { },
    }
    if op <= 1 {
        let e = equal(vm.heap, l, r)
        if e >= 0 {
            return V.Bool(v: if op == 0 { e == 1 } else { e == 0 })
        }
    } else {
        let o = order(p, l, r)
        if o > 0 - 2 {
            return V.Bool(v: if op == 2 { o < 0 } else if op == 3 { o <= 0 } else if op == 4 { o > 0 } else { o >= 0 })
        }
    }
    fail(p, vm, pc, "N0302", "a comparison of values the language does not compare", "")
}

/// Arithmetic on numbers other than `Int`.
pub fn num_arith(p: Prog, vm: Vm, pc: Int, op: Int, l: V, r: V) -> V {
    let (v, err) = arith(op, l, r)
    if err == 0 { return v }
    let what = if op == 0 { "addition" } else if op == 1 { "subtraction" } else if op == 2 { "multiplication" } else { "division" }
    num_failure(p, vm, pc, err, what, kind_of(l))
}

pub fn num_neg(p: Prog, vm: Vm, pc: Int, x: V) -> V {
    let (v, err) = neg(x)
    if err == 0 { v } else { num_failure(p, vm, pc, err, "negation", kind_of(x)) }
}

pub fn num_bits(p: Prog, vm: Vm, pc: Int, op: Int, l: V, r: V) -> V {
    let (v, err) = bits(op, l, r)
    if err == 0 { v } else { num_failure(p, vm, pc, err, "shift", kind_of(l)) }
}

pub fn num_convert(p: Prog, vm: Vm, pc: Int, to: Int, mode: Int, x: V) -> V {
    let (v, err) = convert(to, mode, x)
    if err == 0 { v } else { num_failure(p, vm, pc, err, "conversion", to) }
}

// --- the derived hash (`arith.rs`, `derived_hash`; `nazm_sema::fnv`) ---------------------------

const OFFSET: UInt64 = 14695981039346656037
const PRIME: UInt64 = 1099511628211
const MIX1: UInt64 = 13787848793156543929
const MIX2: UInt64 = 10723151780598845931

fn finish(x: UInt64) -> UInt64 {
    let a = wrapping_mul(x ^ (x >> 30), MIX1)
    let b = wrapping_mul(a ^ (a >> 27), MIX2)
    b ^ (b >> 31)
}

pub fn fnv_bytes(s: Str) -> UInt64 {
    let mut h = OFFSET
    for i in 0..str_len(s) {
        h = wrapping_mul(h ^ UInt64(str_byte(s, i)), PRIME)
    }
    finish(h)
}

pub fn fnv_word(x: UInt64) -> UInt64 {
    let mut h = OFFSET
    let mut w = x
    for i in 0..8 {
        h = wrapping_mul(h ^ (w & UInt64(255)), PRIME)
        w = w >> 8
    }
    finish(h)
}

pub fn fnv_combine(a: UInt64, b: UInt64) -> UInt64 {
    finish(wrapping_add(wrapping_mul(a, PRIME), b))
}

/// The derived hash of `v`, and whether it has one.
pub fn derived_hash(p: Prog, v: V) -> (UInt64, Bool) {
    match v {
        V.Int(v: x) => (fnv_word(wrap_convert[UInt64](x)), true),
        V.Num(kind: k, v: x) => {
            if kind_bits(k) == 128 {
                let lo = fnv_word(wrap_convert[UInt64](x))
                let hi = fnv_word(wrap_convert[UInt64](x >> 64))
                (fnv_combine(lo, hi), true)
            } else {
                (fnv_word(wrap_convert[UInt64](x)), true)
            }
        },
        V.Bool(v: b) => (fnv_word(if b { UInt64(1) } else { UInt64(0) }), true),
        V.Str(s: s, obj: o, start: st) => (fnv_bytes(s), true),
        V.Rec(def: d, fields: xs) => {
            fold(p, fnv_word(UInt64(0)), record_order(p.shapes, strs_get(p.names, dname(d)), list_len(xs)), xs)
        },
        V.Enm(def: d, variant: i, fields: xs) => {
            let ty = strs_get(p.names, dname(d))
            fold(p, fnv_bytes(variant_name(p.shapes, ty, i)), payload_order(p.shapes, ty, i, list_len(xs)), xs)
        },
        _ => (UInt64(0), false),
    }
}

fn fold(p: Prog, start: UInt64, canon: Ints, xs: List[V]) -> (UInt64, Bool) {
    let mut h = start
    for i in canon {
        let (x, ok) = derived_hash(p, list_get(xs, i))
        if !ok { return (UInt64(0), false) }
        h = fnv_combine(h, x)
    }
    (h, true)
}

/// The forms later slices fill in.
pub fn other_op(p: Prog, vm: Vm, pc: Int, op: Int) -> V {
    fail(p, vm, pc, "N0900", f"the interpreter met an instruction it cannot run yet ({op})", "")
}

/// `str_append` (`value.rs`, `Str::append`): `s` followed by `tail`, in place when `s` is the only
/// reference to storage an append made and the result fits its room; otherwise a copy into a new
/// allocation of `max(2n, 16)` bytes. Takes `s`'s reference.
pub fn str_append_value(h: Heap, s: V, tail: Str) -> V {
    match s {
        V.Str(s: x, obj: o, start: st) => {
            let n = str_len(x) + str_len(tail)
            if o > 0 && ints_get(h.kind, o) == K_GROWN && unique(h, o) && st + n <= ints_get(h.room, o) {
                return V.Str(s: x + tail, obj: o, start: st)
            }
            let room = if 2 * n > 16 { 2 * n } else { 16 }
            let made = alloc(h, K_GROWN, room)
            release(h, s)
            V.Str(s: x + tail, obj: made, start: 0)
        },
        _ => s,
    }
}
