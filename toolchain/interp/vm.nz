// The execution loop (`openspec/changes/r4-interpreter/design.md`, D3, D5): one loop over the
// flat code, with the task's frames, slots and operands in its own stacks. What each instruction
// does is what the Rust interpreter's statement or expression of the same Core IR form does
// (`crates/nazm-core/src/eval/exec.rs`), and every failure is its diagnostic.

use "types.nz"
use "ops.nz"
use "heap.nz"
use "names.nz"
use "builtins.nz"
use "values.nz"
use "num.nz"
use "numkinds.nz"
use "shapes.nz"
use "@std/hash"
use "@std/hashmap"
use "dispatch.nz"

/// A task's state with nothing on its stacks: `heap` shared by every task of the run.
pub fn vm_new(heap: Heap, max_iterations: Int, max_depth: Int, args: Strs) -> Vm {
    let st = ints_new()
    for i in 0..ST_SIZE { ints_push(st, 0) }
    ints_set(st, ST_ITER, max_iterations)
    ints_set(st, ST_MAXDEPTH, max_depth)
    Vm(ops: vec_new[V](), slots: vec_new[V](), frames: ints_new(), heap: heap,
            st: st, err: ["", "", ""], errat: [0 - 1, 0, 0], args: args, scopes: ints_new(),
            kids: ints_new(), res: vec_new[V]())
}

// What a turn of `exec` ended with.
pub const X_DONE: Int = 1
pub const X_FAILED: Int = 2
pub const X_BLOCKED: Int = 3
pub const X_YIELD: Int = 4
pub const X_SPAWN: Int = 5
pub const X_JOIN: Int = 6

/// Record a failure at instruction `pc`'s span.
pub fn fail(p: Prog, vm: Vm, pc: Int, code: Str, message: Str, help: Str) -> V {
    if ints_get(vm.st, ST_FAILED) == 0 {
        ints_set(vm.st, ST_FAILED, 1)
        strs_set(vm.err, 0, code)
        strs_set(vm.err, 1, message)
        strs_set(vm.err, 2, help)
        ints_set(vm.errat, 0, ints_get(p.smod, pc))
        ints_set(vm.errat, 1, ints_get(p.slo, pc))
        ints_set(vm.errat, 2, ints_get(p.shi, pc))
    }
    V.Unset
}

pub fn failed(vm: Vm) -> Bool {
    ints_get(vm.st, ST_FAILED) == 1
}

fn overflow(p: Prog, vm: Vm, pc: Int, what: Str) -> V {
    fail(p, vm, pc, "N0400", f"this {what} overflows `Int`",
            "`Int` is a 64-bit signed integer; overflow stops the program rather than wrapping")
}

fn by_zero(p: Prog, vm: Vm, pc: Int) -> V {
    fail(p, vm, pc, "N0401", "division by zero",
            "guard the divisor, for example `if d != 0 { n / d } else { 0 }`")
}

/// `Int` arithmetic, checked as `docs/user/spec.md` requires (`eval/arith.rs`, `arith`).
fn int_arith(p: Prog, vm: Vm, pc: Int, op: Int, a: Int, b: Int) -> V {
    if op == 0 {
        match checked_add(a, b) {
            Some(r) => V.Int(v: r),
            None => overflow(p, vm, pc, "addition"),
        }
    } else if op == 1 {
        match checked_sub(a, b) {
            Some(r) => V.Int(v: r),
            None => overflow(p, vm, pc, "subtraction"),
        }
    } else if op == 2 {
        match checked_mul(a, b) {
            Some(r) => V.Int(v: r),
            None => overflow(p, vm, pc, "multiplication"),
        }
    } else if b == 0 {
        by_zero(p, vm, pc)
    } else if op == 3 {
        if b == 0 - 1 && a == 0 - 9223372036854775807 - 1 {
            overflow(p, vm, pc, "division")
        } else {
            V.Int(v: a / b)
        }
    } else if b == 0 - 1 {
        // `i64::MIN % -1` is 0, and nothing overflows (`arith.rs`: `wrapping_rem`).
        V.Int(v: 0)
    } else {
        V.Int(v: a % b)
    }
}

fn int_compare(op: Int, a: Int, b: Int) -> Bool {
    if op == 0 { a == b } else if op == 1 { a != b } else if op == 2 { a < b } else if op == 3 { a <= b } else if op == 4 { a > b } else { a >= b }
}

/// Push the value of slot `slot` of the frame at `base`, taking a reference.
fn push_local(vm: Vm, base: Int, slot: Int) {
    let v = vec_get(vm.slots, base + slot)
    if holds(v) { retain(vm.heap, v) }
    vec_push(vm.ops, v)
}

fn store(vm: Vm, at: Int, v: V) {
    let old = vec_get(vm.slots, at)
    vec_set(vm.slots, at, v)
    release(vm.heap, old)
}

/// `main`'s frame: each capability parameter is handed one (`eval/mod.rs`, `run_main`).
pub fn start_main(p: Prog, vm: Vm) {
    let entry = p.entry
    for i in 0..ints_get(p.flocals, entry) {
        vec_push(vm.slots, if i < ints_get(p.fparams, entry) { V.Cap(kind: 0) } else { V.Unset })
    }
    ints_push(vm.frames, entry)
    ints_push(vm.frames, 0 - 1)
    ints_push(vm.frames, 0)
    ints_push(vm.frames, 0)
    ints_set(vm.st, ST_PC, ints_get(p.fentry, entry))
    ints_set(vm.st, ST_BASE, 0)
}

/// Run a task until it returns from its first frame, fails, waits, gives way, or reaches a `spawn`
/// or the end of a `scope` - which the scheduler carries out (`sched.nz`). The task resumes where
/// it stopped.
pub fn exec(p: Prog, vm: Vm, caps: Caps) -> Int {
    let h = vm.heap
    let ops = vm.ops
    let slots = vm.slots
    let frames = vm.frames
    let mut base = ints_get(vm.st, ST_BASE)
    let mut pc = ints_get(vm.st, ST_PC)
    let mut status = 0
    let mut steps = 0
    let code = p.op
    let pa = p.a
    let rc = h.rc
    loop {
        steps += 1
        let op = ints_get(code, pc)
        if op == OP_LOCAL {
            // Here and below, a value of plain data skips the call to `inc` or `dec`: the 0.10.0
            // code generator gives every call a prologue that costs more than the count does.
            let v = vec_get(slots, base + ints_get(pa, pc))
            match v {
                V.Int(v: _) => { },
                V.Bool(v: _) => { },
                V.Rec(def: _, obj: o) => { if o > 0 { ints_set(rc, o, ints_get(rc, o) + 1) } },
                V.Ref(obj: o) => ints_set(rc, o, ints_get(rc, o) + 1),
                _ => { inc(rc, v); },
            }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_BORROW {
            vec_push(ops, vec_get(slots, base + ints_get(pa, pc)))
            pc += 1
        } else if op == OP_LFIELD {
            let mut v = vec_get(slots, base + ints_get(pa, pc))
            let path = ints_get(p.b, pc)
            for i in 0..ints_get(p.aux, path) {
                v = match v {
                    V.Rec(def: _, obj: o) => vec_get(vec_get(h.items, o), ints_get(p.aux, path + 1 + i)),
                    _ => V.Unset,
                }
            }
            if ints_get(p.c, pc) == 0 { retain(h, v) }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_CONST {
            vec_push(ops, vec_get(p.consts, ints_get(pa, pc)))
            pc += 1
        } else if op == OP_ARITH {
            let r = vec_pop(ops)
            let l = vec_pop(ops)
            let v = match (l, r) {
                (V.Int(v: a), V.Int(v: b)) => int_arith(p, vm, pc, ints_get(pa, pc), a, b),
                _ => num_arith(p, vm, pc, ints_get(pa, pc), l, r),
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_CMP {
            let r = vec_pop(ops)
            let l = vec_pop(ops)
            let v = match (l, r) {
                (V.Int(v: a), V.Int(v: b)) => V.Bool(v: int_compare(ints_get(pa, pc), a, b)),
                _ => {
                    let c = compare_values(p, vm, pc, ints_get(pa, pc), l, r)
                    release(h, l)
                    release(h, r)
                    c
                },
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_JF {
            match vec_pop(ops) {
                V.Bool(v: b) => {
                    if b { pc += 1 } else { pc = ints_get(pa, pc) }
                },
                _ => {
                    let x = fail(p, vm, pc, "N0300", "a condition must be `Bool`", "")
                    break
                },
            }
        } else if op == OP_JMP {
            pc = ints_get(pa, pc)
        } else if op == OP_CALL {
            let f = ints_get(pa, pc)
            let n = ints_get(p.b, pc)
            let depth = ints_get(vm.st, ST_DEPTH) + 1
            if depth > ints_get(vm.st, ST_MAXDEPTH) {
                let name = strs_get(p.fname, f)
                let max = ints_get(vm.st, ST_MAXDEPTH)
                let x = fail(p, vm, pc, "N0403", f"`{name}` recursed deeper than {max}",
                        "the interpreter bounds call depth so runaway recursion reports instead of exhausting the stack, which would crash without a diagnostic. Raise it with `--max-depth`, or check the recursion has a base case")
                break
            }
            ints_set(vm.st, ST_DEPTH, depth)
            ints_set(vm.st, ST_CALLS, ints_get(vm.st, ST_CALLS) + 1)
            base = enter(p, vm, f, n, pc + 1, base, 0)
            pc = ints_get(p.fentry, f)
        } else if op == OP_RET {
            let v = vec_pop(ops)
            let fb = ints_len(frames) - 4
            let opbase = ints_get(frames, fb + 3)
            while vec_len(ops) > opbase {
                let x = vec_pop(ops)
                if !dec(rc, x) { release(h, x) }
            }
            while vec_len(slots) > base {
                let x = vec_pop(slots)
                match x {
                    V.Int(v: _) => { },
                    V.Bool(v: _) => { },
                    V.Unset => { },
                    _ => { if !dec(rc, x) { release(h, x); } },
                }
            }
            let ret = ints_get(frames, fb + 1)
            let x1 = ints_pop(frames)
            let x2 = ints_pop(frames)
            let x3 = ints_pop(frames)
            let x4 = ints_pop(frames)
            if ret < 0 {
                vec_push(vm.res, v)
                status = X_DONE
                break
            }
            ints_set(vm.st, ST_DEPTH, ints_get(vm.st, ST_DEPTH) - 1)
            base = ints_get(frames, ints_len(frames) - 2)
            vec_push(ops, v)
            pc = ret
        } else if op == OP_STORE {
            let at = base + ints_get(pa, pc)
            let old = vec_get(slots, at)
            vec_set(slots, at, vec_pop(ops))
            match old {
                V.Int(v: _) => { },
                V.Bool(v: _) => { },
                V.Unset => { },
                _ => { if !dec(rc, old) { release(h, old); } },
            }
            pc += 1
        } else if op == OP_RELEASE {
            let at = base + ints_get(pa, pc)
            let old = vec_get(slots, at)
            vec_set(slots, at, V.Unset)
            match old {
                V.Int(v: _) => { },
                V.Bool(v: _) => { },
                V.Unset => { },
                _ => { if !dec(rc, old) { release(h, old); } },
            }
            pc += 1
        } else if op == OP_POP {
            let x = vec_pop(ops)
            match x {
                V.Int(v: _) => { },
                V.Bool(v: _) => { },
                V.Unset => { },
                _ => { if !dec(rc, x) { release(h, x); } },
            }
            pc += 1
        } else if op == OP_ITER {
            let left = ints_get(vm.st, ST_ITER)
            if left <= 0 {
                let x = fail(p, vm, pc, "N0402", "this program exceeded the interpreter's iteration limit",
                        "Nazm does not bound iteration; `nazm run` does, so a non-terminating program reports instead of hanging. Raise it with `--max-iterations`, or check the loop's condition ever becomes false")
                break
            }
            ints_set(vm.st, ST_ITER, left - 1)
            pc += 1
            // Another task gets a turn now and then, so one that waits on this one by polling
            // proceeds, as it would on a thread of its own.
            let turns = ints_get(vm.st, ST_TURNS) + 1
            ints_set(vm.st, ST_TURNS, turns)
            if turns >= 1000 && ints_get(h.sched, SC_LIVE) > 1 {
                ints_set(vm.st, ST_TURNS, 0)
                status = X_YIELD
                break
            }
        } else if op == OP_BUILTIN {
            let n = ints_get(p.b, pc)
            let id = ints_get(pa, pc)
            // A sequence's length, element, push or write, in range, here; anything else, and any
            // failure, through `builtin`.
            let mut v = V.Unset
            let mut fast = false
            if id >= B_VEC_LEN && id <= B_VEC_PUSH {
                let top = vec_len(ops)
                let xs = match vec_get(ops, top - n) {
                    V.Ref(obj: o) => vec_get(h.items, o),
                    _ => h.none,
                }
                let len = vec_len(xs)
                if id == B_VEC_LEN {
                    v = V.Int(v: len)
                    fast = true
                } else if id == B_VEC_PUSH {
                    let x = vec_get(ops, top - 1)
                    inc(rc, x)
                    vec_push(xs, x)
                    v = V.Int(v: len + 1)
                    fast = true
                } else {
                    let i = match vec_get(ops, top - n + 1) {
                        V.Int(v: k) => k,
                        _ => 0 - 1,
                    }
                    if i >= 0 && i < len {
                        if id == B_VEC_GET {
                            v = vec_get(xs, i)
                            inc(rc, v)
                        } else {
                            let x = vec_get(ops, top - 1)
                            inc(rc, x)
                            let old = vec_get(xs, i)
                            vec_set(xs, i, x)
                            if !dec(rc, old) { release(h, old) }
                            v = V.Int(v: i)
                        }
                        fast = true
                    }
                }
            }
            // A byte of a string, in range, and the `UInt64` product the hashes take: here too.
            if id == B_STR_BYTE {
                let top = vec_len(ops)
                match (vec_get(ops, top - 2), vec_get(ops, top - 1)) {
                    (V.Str(s: s, obj: _, start: _), V.Int(v: i)) => {
                        if i >= 0 && i < str_len(s) {
                            v = V.Int(v: str_byte(s, i))
                            fast = true
                        }
                    },
                    _ => { },
                }
            } else if id == B_WRAPPING_MUL {
                let top = vec_len(ops)
                match (vec_get(ops, top - 2), vec_get(ops, top - 1)) {
                    (V.Num(kind: ka, v: x), V.Num(kind: kb, v: y)) => {
                        if ka == NK_U64 {
                            v = V.Num(kind: ka, v: Int128(wrapping_mul(wrap_convert[UInt64](x), wrap_convert[UInt64](y))))
                            fast = true
                        }
                    },
                    _ => { },
                }
            }
            if !fast {
                v = builtin(p, vm, pc, id, n, caps)
            }
            if ints_get(vm.st, ST_BLOCKED) == 1 {
                // Not yet: the task waits, and this instruction runs again when it resumes.
                ints_set(vm.st, ST_BLOCKED, 0)
                steps -= 1
                status = X_BLOCKED
                break
            }
            // The arguments: released, but for those lent (`OP_BORROW`).
            let lent = ints_get(p.d, pc)
            let mut bit = 1
            for i in 0..n { bit = bit * 2 }
            for i in 0..n {
                bit = bit / 2
                let x = vec_pop(ops)
                if (lent / bit) % 2 == 0 {
                    match x {
                        V.Int(v: _) => { },
                        V.Bool(v: _) => { },
                        _ => { if !dec(rc, x) { release(h, x); } },
                    }
                }
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
            if ints_get(vm.st, ST_GIVEWAY) == 1 {
                ints_set(vm.st, ST_GIVEWAY, 0)
                status = X_YIELD
                break
            }
        } else if op == OP_DROPN {
            for i in 0..ints_get(pa, pc) {
                let x = vec_pop(ops)
                if !dec(rc, x) { release(h, x) }
            }
            pc += 1
        } else if op == OP_NEG {
            let x = vec_pop(ops)
            let v = match x {
                V.Int(v: a) => {
                    if a == 0 - 9223372036854775807 - 1 {
                        fail(p, vm, pc, "N0400", "this negation overflows `Int`", "")
                    } else {
                        V.Int(v: 0 - a)
                    }
                },
                _ => num_neg(p, vm, pc, x),
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_MATCH {
            let top = vec_get(ops, vec_len(ops) - 1)
            let variant = match top {
                V.Enm(def: _, variant: k, obj: _) => k,
                _ => 0 - 1,
            }
            let t = ints_get(pa, pc)
            let mut target = 0 - 1
            for i in 0..ints_get(p.aux, t) {
                if ints_get(p.aux, t + 1 + 2 * i) == variant {
                    target = ints_get(p.aux, t + 2 + 2 * i)
                    break
                }
            }
            if target < 0 {
                let x = fail(p, vm, pc, "N0343", "no arm covers this value's variant",
                        "this is a bug in the compiler: exhaustiveness is checked")
                break
            }
            pc = target
        } else if op == OP_BIND {
            let top = vec_get(ops, vec_len(ops) - 1)
            match top {
                V.Enm(def: _, variant: _, obj: o) => {
                    let v = vec_get(vec_get(h.items, o), ints_get(pa, pc))
                    retain(h, v)
                    store(vm, base + ints_get(p.b, pc), v);
                },
                _ => { },
            }
            pc += 1
        } else if op == OP_SWAPDROP {
            let top = vec_pop(ops)
            release(h, vec_pop(ops))
            vec_push(ops, top)
            pc += 1
        } else if op == OP_FIELD {
            let r = vec_pop(ops)
            match r {
                V.Rec(def: _, obj: o) => {
                    let v = vec_get(vec_get(h.items, o), ints_get(pa, pc))
                    retain(h, v)
                    release(h, r)
                    vec_push(ops, v)
                },
                _ => {
                    let x = fail(p, vm, pc, "N0312", "this is not a record", "")
                    break
                },
            }
            pc += 1
        } else if op == OP_RECORD || op == OP_VARIANT {
            let n = ints_get(p.b, pc)
            let c = ints_get(p.c, pc)
            let arity = if op == OP_RECORD { n } else { ints_get(p.aux, c + 1) }
            let first = if op == OP_RECORD { c } else { c + 2 }
            let built = vec_new[V]()
            for i in 0..arity { vec_push(built, V.Unset) }
            let at = vec_len(ops) - n
            for i in 0..n {
                vec_set(built, ints_get(p.aux, first + i), vec_get(ops, at + i))
            }
            for i in 0..n {
                let x = vec_pop(ops)
            }
            if op == OP_RECORD {
                vec_push(ops, V.Rec(def: ints_get(pa, pc), obj: agg(h, built)))
            } else {
                vec_push(ops, V.Enm(def: ints_get(pa, pc), variant: ints_get(p.aux, c), obj: agg(h, built)))
            }
            pc += 1
        } else if op == OP_APPEND {
            append(vm, base + ints_get(pa, pc))
            pc += 1
        } else if op == OP_ASSIGN {
            assign_path(p, vm, pc, base + ints_get(pa, pc))
            if failed(vm) { break }
            pc += 1
        } else if op == OP_ARRAY {
            let n = ints_get(pa, pc)
            let built = vec_new[V]()
            let at = vec_len(ops) - n
            for i in 0..n { vec_push(built, vec_get(ops, at + i)) }
            for i in 0..n {
                let x = vec_pop(ops)
            }
            vec_push(ops, V.Arr(items: chain_from_vec(built)))
            pc += 1
        } else if op == OP_ARRAYREP {
            let v = vec_pop(ops)
            let n = ints_get(pa, pc)
            let built = vec_new[V]()
            for i in 0..n {
                if i > 0 { retain(h, v) }
                vec_push(built, v)
            }
            if n == 0 { release(h, v) }
            vec_push(ops, V.Arr(items: chain_from_vec(built)))
            pc += 1
        } else if op == OP_INDEX {
            let i = vec_pop(ops)
            let a = vec_pop(ops)
            match (a, i) {
                (V.Arr(items: xs), V.Int(v: k)) => {
                    if k < 0 || k >= chain_len(xs) {
                        let n = chain_len(xs)
                        let x = fail(p, vm, pc, "N0405", "this index is outside the array",
                                f"asked for element {k} of an array of {n}")
                        release(h, a)
                        break
                    }
                    let v = chain_get(xs, k)
                    retain(h, v)
                    release(h, a)
                    vec_push(ops, v)
                },
                _ => {
                    let x = fail(p, vm, pc, "N0302", "an index into a non-array", "")
                    break
                },
            }
            pc += 1
        } else if op == OP_SCOPE {
            ints_push(vm.scopes, ints_len(vm.kids))
            pc += 1
        } else if op == OP_SPAWN {
            status = X_SPAWN
            break
        } else if op == OP_JOIN {
            status = X_JOIN
            break
        } else if op == OP_DEFECT {
            let x = fail(p, vm, pc, "N0900", "the interpreter met an expression it cannot evaluate", "")
            break
        } else if op == OP_BITS {
            let r = vec_pop(ops)
            let l = vec_pop(ops)
            let k = ints_get(pa, pc)
            let v = match (l, r) {
                (V.Int(v: a), V.Int(v: b)) => {
                    if k == 0 { V.Int(v: a & b) } else if k == 1 { V.Int(v: a | b) } else if k == 2 { V.Int(v: a ^ b) } else { num_bits(p, vm, pc, k, l, r) }
                },
                // `&`, `|` and `^` of two values of one kind are in its range as they stand.
                (V.Num(kind: ka, v: a), V.Num(kind: kb, v: b)) => {
                    if k == 0 { V.Num(kind: ka, v: a & b) } else if k == 1 { V.Num(kind: ka, v: a | b) } else if k == 2 { V.Num(kind: ka, v: a ^ b) } else { num_bits(p, vm, pc, k, l, r) }
                },
                _ => num_bits(p, vm, pc, k, l, r),
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_COMPLEMENT {
            vec_push(ops, complement(vec_pop(ops)))
            pc += 1
        } else if op == OP_CONVERT {
            // A non-negative `Int` to an unsigned 64-bit or wider kind is exact, whatever the mode.
            let to = ints_get(p.b, pc)
            let x = vec_pop(ops)
            let v = match x {
                V.Int(v: a) => {
                    if a >= 0 && (to == NK_U64 || to == NK_U128 || to == NK_I128) { V.Num(kind: to, v: Int128(a)) } else { num_convert(p, vm, pc, to, ints_get(pa, pc), x) }
                },
                _ => num_convert(p, vm, pc, to, ints_get(pa, pc), x),
            }
            if failed(vm) { break }
            vec_push(ops, v)
            pc += 1
        } else if op == OP_FITS {
            let x = vec_pop(ops)
            let (v, err) = convert(ints_get(pa, pc), 0, x)
            vec_push(ops, V.Bool(v: err == 0))
            pc += 1
        } else if op == OP_CLOSURE || op == OP_FNVALUE {
            // One function value, counted as the native closure object is (`value.rs`, `FuncVal`):
            // the function, and copies of what it captures, in capture order.
            let obj = alloc(h, K_FUNC, ints_get(pa, pc))
            if op == OP_CLOSURE {
                let c = ints_get(p.c, pc)
                let carried = items(h, obj)
                for i in 0..ints_get(p.aux, c) {
                    let v = vec_get(slots, base + ints_get(p.aux, c + 1 + i))
                    retain(h, v)
                    vec_push(carried, v)
                }
            }
            vec_push(ops, V.Ref(obj: obj))
            pc += 1
        } else if op == OP_CALLI || op == OP_CALLTRAIT {
            let n = if op == OP_CALLI { ints_get(pa, pc) } else { ints_get(p.c, pc) }
            let mut f = 0 - 1
            if op == OP_CALLI {
                f = match vec_get(ops, vec_len(ops) - n - 1) {
                    V.Ref(obj: o) => ints_get(h.room, o),
                    _ => 0 - 1,
                }
            } else {
                let receiver = vec_get(ops, vec_len(ops) - n)
                f = impl_for(p, ints_get(pa, pc), receiver)
                if f < 0 {
                    // A derived `Hash` (L6): no impl, so the type's own walk (`exec.rs`).
                    let method = strs_get(p.names, ints_get(pa, pc))
                    if method == "@std/hash::trait Hash.hash" || method == "@std/hash::trait Hash.same" {
                        let v = if method == "@std/hash::trait Hash.hash" {
                            let (x, ok) = derived_hash(p, h, receiver)
                            V.Num(kind: NK_U64, v: Int128(x))
                        } else {
                            V.Bool(v: equal(h, receiver, vec_get(ops, vec_len(ops) - 1)) == 1)
                        }
                        for i in 0..n { release(h, vec_pop(ops)) }
                        vec_push(ops, v)
                        pc += 1
                        continue
                    }
                    let x = fail(p, vm, pc, "N0900", "a trait call whose receiver's type has no impl in the program", "")
                    break
                }
            }
            if f < 0 {
                let x = fail(p, vm, pc, "N0300", "a call through something that is not a function value", "")
                break
            }
            let depth = ints_get(vm.st, ST_DEPTH) + 1
            if depth > ints_get(vm.st, ST_MAXDEPTH) {
                let name = strs_get(p.fname, f)
                let max = ints_get(vm.st, ST_MAXDEPTH)
                let x = fail(p, vm, pc, "N0403", f"`{name}` recursed deeper than {max}",
                        "the interpreter bounds call depth so runaway recursion reports instead of exhausting the stack, which would crash without a diagnostic. Raise it with `--max-depth`, or check the recursion has a base case")
                break
            }
            ints_set(vm.st, ST_DEPTH, depth)
            ints_set(vm.st, ST_CALLS, ints_get(vm.st, ST_CALLS) + 1)
            let closure = ints_get(p.fclosure, f) == 1
            let nb = enter(p, vm, f, n, pc + 1, base, if closure { 1 } else { 0 })
            if op == OP_CALLI {
                // The function value under the arguments: a closure's body holds it as its first
                // slot and its captures where its body reads them (N50); a named function's value
                // is let go.
                let fv = vec_pop(ops)
                ints_set(frames, ints_len(frames) - 1, vec_len(ops))
                if closure {
                    vec_set(slots, nb, fv)
                    let obj = match fv {
                        V.Ref(obj: o) => o,
                        _ => 0,
                    }
                    let carried = items(h, obj)
                    let caps = ints_get(p.fcapt, f)
                    for i in 0..vec_len(carried) {
                        let v = vec_get(carried, i)
                        retain(h, v)
                        vec_set(slots, nb + ints_get(p.aux, caps + 1 + i), v)
                    }
                } else {
                    release(h, fv)
                }
            }
            base = nb
            pc = ints_get(p.fentry, f)
        } else {
            let x = other_op(p, vm, pc, op)
            if failed(vm) { break }
            pc += 1
        }
    }
    ints_set(vm.st, ST_PC, pc)
    ints_set(vm.st, ST_BASE, base)
    ints_set(vm.st, ST_STEPS, steps)
    if failed(vm) {
        unwind(vm)
        return X_FAILED
    }
    status
}

/// Enter function `f`: a fresh frame whose first `n` slots are the top `n` operands, in order.
/// `skip` leading slots are left for the caller to fill (a closure's own value). Returns the new
/// frame's slot base.
pub fn enter(p: Prog, vm: Vm, f: Int, n: Int, ret: Int, base: Int, skip: Int) -> Int {
    let ops = vm.ops
    let slots = vm.slots
    let nb = vec_len(slots)
    let total = ints_get(p.flocals, f)
    let from = vec_len(ops) - n
    for i in 0..skip { vec_push(slots, V.Unset) }
    for i in 0..n { vec_push(slots, vec_get(ops, from + i)) }
    for i in n + skip..total { vec_push(slots, V.Unset) }
    for i in 0..n {
        let x = vec_pop(ops)
    }
    let frames = vm.frames
    ints_push(frames, f)
    ints_push(frames, ret)
    ints_push(frames, nb)
    ints_push(frames, vec_len(ops))
    nb
}

/// A failure ends the run: every frame's slots and operands are released, as Rust's `Drop`
/// releases them while the error travels out.
pub fn unwind(vm: Vm) {
    let h = vm.heap
    while vec_len(vm.ops) > 0 { release(h, vec_pop(vm.ops)) }
    while vec_len(vm.slots) > 0 { release(h, vec_pop(vm.slots)) }
}

/// `local = str_append(local, tail)` (`exec.rs`, `append`): the tail, then the binding's string
/// taken out of its slot, so the slot's reference is the one the append weighs.
fn append(vm: Vm, at: Int) {
    let h = vm.heap
    let t = vec_pop(vm.ops)
    let s = vec_get(vm.slots, at)
    vec_set(vm.slots, at, V.Unset)
    let tail = match t {
        V.Str(s: x, obj: o, start: st) => x,
        _ => "",
    }
    vec_set(vm.slots, at, str_append_value(h, s, tail))
    release(h, t)
}

/// `local.path = value` (`exec.rs`, `assign`): the value and the indexes were evaluated first,
/// outermost index first; the aggregate along the path is rebuilt with the new value in place
/// and the old one released.
fn assign_path(p: Prog, vm: Vm, pc: Int, at: Int) {
    let h = vm.heap
    let start = ints_get(p.b, pc)
    let nidx = ints_get(p.c, pc)
    let steps = ints_get(p.aux, start)
    let indexes = ints_new()
    let top = vec_len(vm.ops)
    for i in 0..nidx {
        match vec_get(vm.ops, top - nidx + i) {
            V.Int(v: k) => ints_push(indexes, k),
            _ => ints_push(indexes, 0 - 1),
        }
    }
    for i in 0..nidx {
        let x = vec_pop(vm.ops)
    }
    let v = vec_pop(vm.ops)
    let old = vec_get(vm.slots, at)
    vec_set(vm.slots, at, V.Unset)
    let built = rebuild(p, vm, pc, old, start + 1, steps, indexes, 0, v)
    vec_set(vm.slots, at, built)
}

/// `whole` with the value at `steps` path steps from `aux[step]` replaced by `v`; a failure
/// leaves `whole` as it was and releases `v`.
fn rebuild(p: Prog, vm: Vm, pc: Int, whole: V, step: Int, steps: Int, indexes: Ints, k: Int, v: V) -> V {
    if steps == 0 {
        release(vm.heap, whole)
        return v
    }
    let kind = ints_get(p.aux, step)
    let which = ints_get(p.aux, step + 1)
    match whole {
        V.Rec(def: d, obj: o) => {
            // The only copy: the field is replaced in place. A copy shared with another binding:
            // the new value copies the fields, and this one is let go.
            let h = vm.heap
            if unique(h, o) {
                let fs = vec_get(h.items, o)
                let inner = rebuild(p, vm, pc, vec_get(fs, which), step + 2, steps - 1, indexes, k, v)
                vec_set(fs, which, inner)
                whole
            } else {
                let xs = vec_new[V]()
                for f in vec_get(h.items, o) {
                    retain(h, f)
                    vec_push(xs, f)
                }
                let inner = rebuild(p, vm, pc, vec_get(xs, which), step + 2, steps - 1, indexes, k, v)
                vec_set(xs, which, inner)
                release(h, whole)
                V.Rec(def: d, obj: agg(h, xs))
            }
        },
        V.Arr(items: fs) => {
            let i = ints_get(indexes, k)
            let n = chain_len(fs)
            if i < 0 || i >= n {
                release(vm.heap, v)
                return fail_keep(p, vm, pc, whole, i, n)
            }
            let xs = vec_new[V]()
            for f in fs { vec_push(xs, f) }
            let inner = rebuild(p, vm, pc, chain_get(fs, i), step + 2, steps - 1, indexes, k + 1, v)
            vec_set(xs, i, inner)
            V.Arr(items: chain_from_vec(xs))
        },
        _ => {
            release(vm.heap, v)
            let x = fail(p, vm, pc, "N0200", "this is not a place that can be written to", "")
            whole
        },
    }
}

fn fail_keep(p: Prog, vm: Vm, pc: Int, whole: V, i: Int, n: Int) -> V {
    let x = fail(p, vm, pc, "N0405", "this index is outside the array", f"asked for element {i} of an array of {n}")
    whole
}
