// The interpreter's data: values, the program it loaded, and the machine that runs it
// (`openspec/changes/r4-interpreter/design.md`, D2–D4).

use "@std/hash"
use "@std/hashmap"
use "shapes.nz"

/// A run-time value. `Unset` is a slot not yet bound, or bound in a region since left.
///
/// A record, an enum value and an array are immutable aggregates, as the language makes them;
/// a `Str` is a view (`s`) of a backing, `obj` the heap object that counts it (0 for an immortal
/// one: a literal or an argument) and `start` where the view begins in it. Every handle is
/// `Ref(obj)`, an index into the heap.
pub enum V {
    Unset,
    Int(v: Int),
    Bool(v: Bool),
    Str(s: Str, obj: Int, start: Int),
    Rec(def: Int, fields: List[V]),
    Enm(def: Int, variant: Int, fields: List[V]),
    Arr(items: List[V]),
    Ref(obj: Int),
    Cap(kind: Int),
    Num(kind: Int, v: Int128),
    Flt(kind: Int, v: Float64),
    // A `Bytes`: a view of a buffer, by reference (Gate 2), and the heap object that counts the
    // buffer.
    Byt(b: Bytes, obj: Int),
    // An `OsHandle` (Gate 2): the host's, which this interpreter's own runtime keeps.
    // A host handle; `sock` is its place in the heap's `socktime` when it is a socket, else 0.
    Osh(h: OsHandle, sock: Int),
    // An `Atomic` (Gate 3): one cell, by reference.
    Atm(a: Atomic),
}

/// The authority the interpreter holds and exercises for the program it runs (`design.md`, D10).
pub struct Caps {
    out: OutCap,
    io: IoCap,
    time: TimeCap,
    net: NetCap,
    proc: ProcessCap,
    rnd: RandomCap,
}

/// The loaded program: its code, as parallel arrays, and its tables.
pub struct Prog {
    // One instruction per index: an opcode and three operands, and the span it reports at.
    op: Ints,
    a: Ints,
    b: Ints,
    c: Ints,
    d: Ints,
    smod: Ints,
    slo: Ints,
    shi: Ints,
    // Operand lists the instructions point into: a record's field positions, a match's arms.
    aux: Ints,
    // Functions, by index: the name a diagnostic gives, the first instruction, the number of
    // locals and of parameters, whether it is a closure's body, and its captures' slots (a run of
    // `aux`: count, then slots).
    fname: Strs,
    fkey: Strs,
    fentry: Ints,
    flocals: Ints,
    fparams: Ints,
    fclosure: Ints,
    fcapt: Ints,
    // Constants, one table for the program.
    consts: Vec[V],
    // Interned strings: definition keys and types.
    names: Strs,
    // Module keys, by index; a span's module is one.
    mods: Strs,
    // The modules in the order their functions first appear: the order they were loaded in, which
    // a JSON diagnostic's offsets count through.
    morder: Strs,
    // The root's `main`, by function index.
    entry: Int,
    // Function keys to indices: what a trait call's impl is found by (D8).
    fmap: HashMap[Str, Int],
    // What each record and enum's names are, for the canonical orders (D8).
    shapes: Shapes,
    // A trait call's impl, once found: by `method * 1000003 + receiver type`, both interned.
    tcache: HashMap[Int, Int],
    // `/3`'s impl table: `METHOD|SELF` (the trait method's key and the impl's self type, without
    // type arguments) to the function that answers it, a trait's default method included.
    impls: HashMap[Str, Int],
    // What `nazm run` refuses before the program starts (`nazm_core::pipeline`), the first by
    // rank: code, message, label, help, and the name whose first occurrence from the span's start
    // is the span ("" when the span is already right) — and its rank, module, start and end.
    refusal: Strs,
    refat: Ints,
}

/// The heap: every object a handle names (D4). `kind` 0 is a free entry.
pub struct Heap {
    kind: Ints,
    rc: Ints,
    // A grown string's room; a function value's function.
    room: Ints,
    items: Vec[Vec[V]],
    free: Ints,
    // allocated and reclaimed, per class: sequences, strings, channels, closures.
    counts: Ints,
    // The release in progress: values whose references are being given up.
    work: Vec[V],
    busy: Ints,
    // The storage of every object that has none: one empty sequence, never written.
    none: Vec[V],
    // A channel's flag: 1 once closed.
    flag: Ints,
    // The scheduler's counts, `SC_` below.
    sched: Ints,
    // The children whose exit has been seen, by process id.
    reaped: Ints,
    // Each socket's deadline as the program set it (`os_set_timeout`), by its `sock`.
    socktime: Ints,
    // The host's clocks when the program first read them (`time_now_ms`, `time_now_ns`), or -1:
    // the Rust interpreter's clocks count from there (`intrinsic.rs`, `monotonic_ms`).
    clock: Ints,
}

/// One task's stacks (D3) and the run's state.
pub struct Vm {
    ops: Vec[V],
    slots: Vec[V],
    // Per frame: the function, the return address, the slot base and the operand base.
    frames: Ints,
    heap: Heap,
    // The task's state, by the `ST_` indices below.
    st: Ints,
    // A failure: code, message, help; and its span: module, start, end.
    err: Strs,
    errat: Ints,
    args: Strs,
    // Open `scope`s: where each one's tasks start in `kids`; and the tasks started, by number.
    scopes: Ints,
    kids: Ints,
    // `main`'s value, once it returns.
    res: Vec[V],
}

// Object kinds.
pub const K_FREE: Int = 0
pub const K_STR: Int = 1
pub const K_GROWN: Int = 2
pub const K_SEQ: Int = 3
pub const K_BYTES: Int = 4
pub const K_CHAN: Int = 5
pub const K_FUNC: Int = 6
pub const K_ATOMIC: Int = 7
pub const K_HANDLE: Int = 8
// A record or enum value that holds references: one count for all its copies (D4).
pub const K_AGG: Int = 9

// The counters of the memory report.
pub const C_SEQ: Int = 0
pub const C_STR: Int = 2
pub const C_CHAN: Int = 4
pub const C_CLO: Int = 6

// `Vm.st`.
pub const ST_ITER: Int = 0
pub const ST_MAXDEPTH: Int = 1
pub const ST_DEPTH: Int = 2
pub const ST_CALLS: Int = 3
pub const ST_FAILED: Int = 4
// Where the task resumes: its instruction and its frame's slot base.
pub const ST_PC: Int = 5
pub const ST_BASE: Int = 6
// Set by a built-in that cannot proceed yet: the task waits and the instruction runs again.
pub const ST_BLOCKED: Int = 7
// A waiting built-in's deadline on the monotonic clock, in milliseconds, or 0.
pub const ST_DEADLINE: Int = 8
// Whether the waiting built-in has begun: what it counts once is counted.
pub const ST_PENDING: Int = 9
// Instructions run in the last turn, and loop turns since the task last gave way.
pub const ST_STEPS: Int = 10
pub const ST_TURNS: Int = 11
/// When a task waiting on a socket gives up: the program's deadline, or -1 for none (0: not waiting).
pub const ST_IOWAIT: Int = 12
/// How long a task waiting on a socket waits before its next try, doubling from `POLL_MS`.
pub const ST_IOGAP: Int = 13
/// The connections made (`SC_CONNECTS`) when the task last tried its socket; and 1 when the task
/// gives way after the built-in it is running (a connection it made, which another may accept).
pub const ST_SEEN: Int = 14
pub const ST_GIVEWAY: Int = 15
pub const ST_SIZE: Int = 16

// `Heap.sched`: tasks started and joined, selects and their timeouts (`NAZM_SCHED_REPORT`), and
// how many tasks are live.
pub const SC_SPAWNED: Int = 0
pub const SC_JOINED: Int = 1
pub const SC_SELECTS: Int = 2
pub const SC_TIMEOUTS: Int = 3
pub const SC_LIVE: Int = 4
// Connections the program has made: a task waiting on a socket tries again at once after one.
pub const SC_CONNECTS: Int = 5
