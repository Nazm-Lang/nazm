// Instruction-level LIR (`nazm lir --ops`, N105): each unit as a module of symbols, data and
// functions in the text `crates/nazm-lir/src/op/print.rs` writes — what both backends translate.
// The rules are `crates/nazm-lir/src/op/` (`lower.rs`, `func.rs`, `prims.rs`, `helpers.rs`): every
// local in a variable, a frame slot or (a scalar temporary written once and read after, in one
// block) a value; every failure a guard to a block that records the message and leaves by the
// statement's failure edge; strings as `{ptr, len, owner}` triples whose owner is counted.
//
// Task 6.3 grows this by what the inputs need; a construct not ported yet is reported, not guessed.

use "cir.nz"
use "types.nz"
use "mir.nz"
use "lir.nz"
use "runtime.nz"
use "@std/hash"
use "@std/hashmap"
use "@std/json"
use "@std/text"
use "@std/blake3"

// --- the module ---------------------------------------------------------------------------------

/// One unit's module as it is built: its symbols (in first-use order), its data and functions as
/// text, and what the lowering remembers across functions.
struct Lo {
    lx: Lx,
    c: Cir,
    p: MirProgram,
    unit: UnitPlan,
    sym_name: Strs,
    sym_link: Strs,
    /// `func` or `data`; a function's signature text (`plain (i64) -> ptr`), its result class
    /// (`""` for none) and whether it fails the Nazm way; a datum's class (`bytes`).
    sym_kind: Strs,
    sym_sig: Strs,
    sym_ret: Strs,
    sym_fails: Ints,
    by_name: HashMap[Str, Int],
    datas: Strs,
    functions: Strs,
    anon: Ints,
    messages: HashMap[Str, Int],
    /// The type helpers asked for (`what|type`) and their symbols, in the order asked.
    helpers: HashMap[Str, Int],
    /// A static atomic's value datum, by `module.name`.
    cellvals: HashMap[Str, Int],
    pending: Strs,
    /// Each spawn site's trampoline: its symbol and callee, and the block's argument types
    /// and offsets; defined after the functions, between helpers.
    tramps: Ints,
    tramp_tys: Vec[Strs],
    tramp_offs: Vec[Ints],
    blobs: HashMap[Str, Int],
    strvals: HashMap[Str, Int],
    /// MIR function position -> its symbol, and -> its plain entry's.
    funcs: HashMap[Int, Int],
    plain: HashMap[Int, Int],
    runtime: HashMap[Str, Str],
    /// The runtime part of each registry entry, and the parts and services the units reach
    /// (`Needs`, by name), shared by every unit of the program.
    parts: HashMap[Str, Str],
    needs: HashMap[Str, Bool],
    /// `--debug`: positions and the variables a debugger shows (N48, N58, N91); each module's
    /// file index, and each index's name as the loader gave it.
    debug: Bool,
    files: HashMap[Str, Int],
    paths: HashMap[Int, Str],
    /// Each module's source text and line starts, by module name.
    sources: HashMap[Str, Str],
    errors: Strs,
}

fn defect(lo: Lo, what: Str) {
    strs_push(lo.errors, "LIR could not be lowered: " + what)
}

fn symbol(lo: Lo, name: Str, link: Str, kind: Str, sig: Str, ret: Str, fails: Bool) -> Int {
    match hashmap_get(lo.by_name, name) {
        Some(s) => { return s },
        None => {},
    }
    let id = strs_len(lo.sym_name)
    strs_push(lo.sym_name, name)
    strs_push(lo.sym_link, link)
    strs_push(lo.sym_kind, kind)
    strs_push(lo.sym_sig, sig)
    strs_push(lo.sym_ret, ret)
    ints_push(lo.sym_fails, if fails { 1 } else { 0 })
    hashmap_set(lo.by_name, name, id)
    id
}

fn anonymous(lo: Lo, what: Str) -> Str {
    let n = ints_get(lo.anon, 0)
    ints_set(lo.anon, 0, n + 1)
    "nz.l." + what + "." + int_to_str(n)
}

fn hex_of(bytes: Str) -> Str {
    let parts = strs_new()
    for i in 0..str_len(bytes) { strs_push(parts, hex_byte(str_byte(bytes, i))) }
    str_join(parts, "")
}

/// Little-endian bytes of `n` in `width` bytes, as hex.
fn le_hex(n: Int, width: Int) -> Str {
    let parts = strs_new()
    let mut x = n
    for i in 0..width {
        strs_push(parts, hex_byte(x % 256))
        x = x / 256
    }
    str_join(parts, "")
}

/// Little-endian two's complement bytes of `n` in `width` bytes, as hex.
fn le_hex_signed(n: Int, width: Int) -> Str {
    let parts = strs_new()
    let mut x = n
    for i in 0..width {
        let b = (x % 256 + 256) % 256
        strs_push(parts, hex_byte(b))
        x = (x - b) / 256
    }
    str_join(parts, "")
}

/// A JSON scalar's text: a string as itself, a number as its digits, a boolean as its word.
fn json_text_of(c: Cir, n: Int) -> Str {
    let k = json_kind(c.doc, n)
    if k == "string" { return str_of(c, n) }
    if k == "bool" || k == "boolean" { return match json_bool(c.doc, n) { Some(b) => if b { "true" } else { "false" }, None => "false" } }
    int_to_str(int_of(c, n))
}

/// A static's symbol (`NativeSymbol::of_static`).
fn static_symbol(module: Str, name: Str) -> Str {
    if str_len(module) > 0 && str_byte(module, 0) == 35 {
        return "nz.su." + str_slice(module, 1, str_len(module)) + "." + encode(name)
    }
    "nz.s." + encode(module) + "." + encode(name)
}

/// Every static the unit's module declares, as data (`define_statics`): an atomic's cell
/// writable, a constant's bytes read-only, each in its `@section`.
fn define_statics(lo: Lo) {
    if !lo.unit.owns { return }
    let c = lo.c
    let ss = kid(c, json_root(c.doc), "statics")
    for i in 0..count(c, ss) {
        let s = at(c, ss, i)
        if sval(c, s, "module") == lo.unit.module {
            let name = static_symbol(sval(c, s, "module"), sval(c, s, "name"))
            let t = sval(c, s, "type")
            let v = json_text_of(c, kid(c, s, "value"))
            let mut hex = ""
            let mut align = 8
            let cell = bval(c, s, "cell")
            if cell {
                hex = le_hex_signed(parse_int(v), 8)
            } else if t == "Bool" {
                hex = if v == "true" { "01" } else { "00" }
                align = 1
            } else if is_float(t) {
                let w = kind_bits(t) / 8
                hex = le_hex_signed(float_text_bits(t, v), w)
                align = w
            } else {
                let k = num_kind(t)
                let w = kind_bits(k) / 8
                let text = int_const_text(k, v)
                if w > 8 && (str_len(text) > 18) {
                    defect(lo, "a 128-bit static past 64 bits (not ported yet)");
                }
                hex = le_hex_signed(parse_int(text), w)
                align = w
            }
            symbol(lo, name, "hidden", "data", "bytes", "", false);
            let w = if cell { " writable" } else { "" }
            let sec = sval(c, s, "section")
            let placed = if sec == "" { "" } else { " section " + sec }
            strs_push(lo.datas, "data @" + name + " align " + int_to_str(align) + w + placed + " [" + hex + "]")
        }
    }
}

/// A static atomic's whole value — its cell's address, 8, a null owner — as read-only data
/// (`cell_value`): the cell this unit defines, or an import of its module's.
fn cell_value(fx: Fx, key: Str) -> Int {
    let lo = fx.lo
    let c = lo.c
    let ss = kid(c, json_root(c.doc), "statics")
    let mut found = 0 - 1
    for i in 0..count(c, ss) {
        let s = at(c, ss, i)
        if found < 0 && sval(c, s, "def") == key { found = s }
    }
    if found < 0 {
        defect(lo, "a static the program does not declare");
        return 0 - 1
    }
    let module = sval(c, found, "module")
    let name = sval(c, found, "name")
    match hashmap_get(lo.cellvals, key) {
        Some(d) => { return d },
        None => {},
    }
    let cell = symbol(lo, static_symbol(module, name), "import", "data", "bytes", "", false)
    let id = anonymous(lo, "c")
    let d = define_data(lo, id, le_hex(0, 8) + le_hex(8, 8) + le_hex(0, 8), 8, " 0:@" + strs_get(lo.sym_name, cell))
    hashmap_set(lo.cellvals, key, d)
    d
}

fn define_data(lo: Lo, name: Str, hex: Str, align: Int, relocs: Str) -> Int {
    let sym = symbol(lo, name, "local", "data", "bytes", "", false)
    strs_push(lo.datas, "data @" + name + " align " + int_to_str(align) + " [" + hex + "]" + relocs)
    sym
}

fn blob(lo: Lo, bytes: Str) -> Int {
    match hashmap_get(lo.blobs, bytes) {
        Some(d) => { return d },
        None => {},
    }
    let name = anonymous(lo, "s")
    let stored = if str_len(bytes) == 0 { "00" } else { hex_of(bytes) }
    let d = define_data(lo, name, stored, 1, "")
    hashmap_set(lo.blobs, bytes, d)
    d
}

/// A string literal's `{ptr, len, owner}` value, its owner null: a static nothing frees.
fn str_value(lo: Lo, bytes: Str) -> Int {
    match hashmap_get(lo.strvals, bytes) {
        Some(d) => { return d },
        None => {},
    }
    let b = blob(lo, bytes)
    let name = anonymous(lo, "v")
    let hex = le_hex(0, 8) + le_hex(str_len(bytes), 8) + le_hex(0, 8)
    let d = define_data(lo, name, hex, 8, " 0:@" + strs_get(lo.sym_name, b))
    hashmap_set(lo.strvals, bytes, d)
    d
}

/// Where span `at` (`FILE:START..END`) starts, as `FILE:LINE:COLUMN` (a column counts
/// characters, as `SourceMap::line_col` does).
fn position(lo: Lo, at: Str) -> Str {
    let lc = line_col(lo, at)
    if ints_len(lc) == 0 { return at }
    span_file(at) + ":" + int_to_str(ints_get(lc, 0)) + ":" + int_to_str(ints_get(lc, 1))
}

/// A span's file: its text before the last `:`.
fn span_file(at: Str) -> Str {
    let mut colon = 0 - 1
    for i in 0..str_len(at) { if str_byte(at, i) == 58 { colon = i } }
    if colon < 0 { "" } else { str_slice(at, 0, colon) }
}

/// Where a debugger says `at` is (`SourceNames::position`): `FILE LINE COLUMN`, the file by its
/// index; `""` for no position.
fn loc_of(lo: Lo, at: Str) -> Str {
    let lc = line_col(lo, at)
    if ints_len(lc) == 0 { return "" }
    match hashmap_get(lo.files, span_file(at)) {
        Some(f) => int_to_str(f) + " " + int_to_str(ints_get(lc, 0)) + " " + int_to_str(ints_get(lc, 1)),
        None => "",
    }
}

/// A span's start as its line and column, counted from 1 (columns by character); empty for a
/// span that names no place.
fn line_col(lo: Lo, at: Str) -> Ints {
    let out = ints_new()
    let mut colon = 0 - 1
    for i in 0..str_len(at) { if str_byte(at, i) == 58 { colon = i } }
    if colon < 0 { return out }
    let file = str_slice(at, 0, colon)
    let rest = str_slice(at, colon + 1, str_len(at))
    let dots = match text_find(rest, "..") { Some(i) => i, None => str_len(rest) }
    let start = match text_parse_int(str_slice(rest, 0, dots)) { Ok(v) => v, Err(e) => 0 }
    let text = match hashmap_get(lo.sources, file) { Some(t) => t, None => "" }
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < start && i < str_len(text) {
        let b = str_byte(text, i)
        if b == 10 {
            line += 1
            col = 1
        } else if b < 128 || b >= 192 {
            col += 1
        }
        i += 1
    }
    ints_push(out, line)
    ints_push(out, col)
    out
}

/// A failure's message datum and its length.
fn message(lo: Lo, code: Str, what: Str, at: Str) -> Ints {
    let text = "nazm: error[" + code + "]: " + what + " at " + position(lo, at) + "\n"
    let d = match hashmap_get(lo.messages, text) {
        Some(d) => d,
        None => {
            let name = anonymous(lo, "m")
            let d = define_data(lo, name, hex_of(text), 1, "")
            hashmap_set(lo.messages, text, d)
            d
        },
    }
    let out = ints_new()
    ints_push(out, d)
    ints_push(out, str_len(text))
    out
}

fn runtime_data(lo: Lo, name: Str, c: Str) -> Int {
    if name == "nz.argc" || name == "nz.argv" { hashmap_set(lo.needs, "io", true); }
    symbol(lo, name, "import", "data", c, "", false)
}

/// What calling the runtime's `name` makes the program reach (`Lw::runtime`): its part, the
/// second compiler's shims, the stack check, and the string part for `nz.strs_release`.
fn note_needs(lo: Lo, name: Str) {
    let part = match hashmap_get(lo.parts, name) { Some(p) => p, None => "" }
    let need = text_to_lower(part)
    if need != "" && need != "base" && need != "libc" && need != "heap" { hashmap_set(lo.needs, need, true); }
    hashmap_set(lo.needs, "shims", true)
    if name == "nz.stack_check" || name == "nz.stack_check_frame" { hashmap_set(lo.needs, "stack", true); }
    if name == "nz.strs_release" { hashmap_set(lo.needs, "strings", true); }
}

fn runtime_sym(lo: Lo, name: Str) -> Int {
    match hashmap_get(lo.runtime, name) {
        Some(sig) => {
            note_needs(lo, name)
            let arrow = match text_find(sig, " -> ") { Some(i) => str_slice(sig, i + 4, str_len(sig)), None => "" }
            symbol(lo, name, "import", "func", sig, arrow, false)
        },
        None => {
            defect(lo, "`" + name + "` is not in the runtime registry");
            0
        },
    }
}

// --- types --------------------------------------------------------------------------------------

/// Whether a value of `t` lives in memory: a `Str`, a record, an enum, an array.
fn in_memory(t: Str) -> Bool {
    let k = class(t)
    k == "str" || k == "record" || k == "enum" || k == "array"
}

/// The machine class of a scalar of `t`.
fn mclass(t: Str) -> Str {
    let k = class(t)
    if k == "int" { return "i64" }
    if k == "bool" { return "bit" }
    if k == "num" {
        if t == "Int8" || t == "UInt8" { return "i8" }
        if t == "Int16" || t == "UInt16" { return "i16" }
        if t == "Int32" || t == "UInt32" { return "i32" }
        if t == "Int128" || t == "UInt128" { return "i128" }
        if t == "Float32" { return "f32" }
        if t == "Float64" { return "f64" }
        return "i64"
    }
    "ptr"
}

/// A Nazm function's signature: an in-memory result through a first pointer; every in-memory
/// parameter by address.
fn nazm_sig(params: Strs, ret: Str, conv: Str) -> Str {
    let ps = strs_new()
    if in_memory(ret) { strs_push(ps, "ptr") }
    for t in params { strs_push(ps, if in_memory(t) { "ptr" } else { mclass(t) }) }
    let head = if conv == "" { "" } else { conv + " " }
    head + "(" + str_join(ps, ", ") + ")" + (if in_memory(ret) { "" } else { " -> " + mclass(ret) })
}

fn c_class(t: Str) -> Str {
    let k = class(t)
    if k == "bool" || k == "int" || k == "num" { mclass(t) } else { "ptr" }
}

fn c_sig(params: Strs, ret: Str) -> Str {
    let ps = strs_new()
    for t in params { strs_push(ps, c_class(t)) }
    "c (" + str_join(ps, ", ") + ") -> " + c_class(ret)
}

fn sig_ret(sig: Str) -> Str {
    match text_find(sig, " -> ") { Some(i) => str_slice(sig, i + 4, str_len(sig)), None => "" }
}

fn entered(lo: Lo, i: Int) -> Bool {
    let f = vec_get(lo.p.fns, i)
    if i == lo.p.entry { return true }
    if f.node < 0 { return false }
    let a = kid(lo.c, f.node, "attributes")
    sval(lo.c, a, "interrupt") != "" || kid(lo.c, a, "task") >= 0 || bval(lo.c, a, "on_failure")
}

/// Every function the unit defines or calls, declared in MIR order.
fn declare_functions(lo: Lo) {
    let wanted = ints_new()
    for i in 0..ints_len(lo.unit.fns) {
        let fi = ints_get(lo.unit.fns, i)
        ints_push(wanted, fi)
        let cs = callees_of(vec_get(lo.p.fns, fi))
        for j in 0..ints_len(cs) { ints_push(wanted, ints_get(cs, j)) }
    }
    for id in 0..vec_len(lo.p.fns) {
        if has(wanted, id) {
            let f = vec_get(lo.p.fns, id)
            let foreign = f.foreign != ""
            let own = has(lo.unit.fns, id) && !foreign
            let link = if !own { "import" } else if linkage(lo.lx, id) == "internal" { "local" } else { "hidden" }
            let sig = if foreign { c_sig(params_of(f), f.ret) } else { nazm_sig(params_of(f), f.ret, "") }
            let name = symbol_of(f)
            if entered(lo, id) && !foreign {
                if own {
                    let plain = nazm_sig(params_of(f), f.ret, "plain")
                    hashmap_set(lo.plain, id, symbol(lo, name, link, "func", plain, sig_ret(plain), false))
                }
                hashmap_set(lo.funcs, id, symbol(lo, name + ".body", link, "func", sig, sig_ret(sig), true))
            } else {
                hashmap_set(lo.funcs, id, symbol(lo, name, link, "func", sig, sig_ret(sig), !foreign))
            }
        }
    }
}

// --- a function as it is built ------------------------------------------------------------------

/// The function builder (`Fb`): blocks of instruction text and their terminators, the current
/// block, the value counter, the variables' classes and the slots.
struct Fb {
    insts: Vec[Strs],
    terms: Strs,
    reg: Ints,
    vars: Strs,
    slots: Strs,
    slot_sizes: Ints,
    slot_aligns: Ints,
    /// The last position emitted (`Fb::here`, a `loc` line, `""` for none), the function's own
    /// (`  at FILE LINE`, or none) and the variables a debugger shows.
    here: Strs,
    at_line: Strs,
    debug_lines: Strs,
}

fn fb_new() -> Fb {
    let reg = ints_new()
    ints_push(reg, 0 - 1)
    ints_push(reg, 0)
    let here = strs_new()
    strs_push(here, "")
    let fb = Fb(insts: vec_new(), terms: strs_new(), reg: reg, vars: strs_new(), slots: strs_new(), slot_sizes: ints_new(), slot_aligns: ints_new(),
        here: here, at_line: strs_new(), debug_lines: strs_new())
    let entry = new_lblock(fb)
    ints_set(fb.reg, 0, entry)
    fb
}

fn new_lblock(fb: Fb) -> Int {
    let b = vec_len(fb.insts)
    vec_push(fb.insts, strs_new())
    strs_push(fb.terms, "unreachable")
    b
}

/// Switch to block `b`; a block switched to before anything is in it restates the last position,
/// so it keeps its statement's position (N108).
fn switch_to(fb: Fb, b: Int) {
    ints_set(fb.reg, 0, b)
    let h = strs_get(fb.here, 0)
    if h != "" && strs_len(vec_get(fb.insts, b)) == 0 { strs_push(vec_get(fb.insts, b), h) }
}

fn value(fb: Fb) -> Int {
    let v = ints_get(fb.reg, 1)
    ints_set(fb.reg, 1, v + 1)
    v
}

fn emit(fb: Fb, line: Str) {
    if text_starts_with(line, "loc ") { strs_set(fb.here, 0, line) }
    let b = ints_get(fb.reg, 0)
    if b >= 0 { strs_push(vec_get(fb.insts, b), line) }
}

fn term(fb: Fb, t: Str) {
    let b = ints_get(fb.reg, 0)
    if b >= 0 {
        strs_set(fb.terms, b, t)
        ints_set(fb.reg, 0, 0 - 1)
    }
}

fn new_var(fb: Fb, c: Str) -> Int {
    strs_push(fb.vars, c)
    strs_len(fb.vars) - 1
}

fn new_slot(fb: Fb, size: Int, align: Int) -> Int {
    let s = if size < 1 { 1 } else { size }
    let a = if align < 1 { 1 } else { align }
    strs_push(fb.slots, int_to_str(s) + " align " + int_to_str(a))
    ints_push(fb.slot_sizes, s)
    ints_push(fb.slot_aligns, a)
    strs_len(fb.slots) - 1
}

fn finish(lo: Lo, fb: Fb, sym: Int, name: Str) -> Str { finish_in(lo, fb, sym, name, "") }

/// A function's text, placed in `section` (`@section`) unless that is `""`.
fn finish_in(lo: Lo, fb: Fb, sym: Int, name: Str, section: Str) -> Str {
    let lines = strs_new()
    let placed = if section == "" { "" } else { " section " + section }
    strs_push(lines, "\nfunction @" + strs_get(lo.sym_name, sym) + placed + " ; " + name)
    for a in fb.at_line { strs_push(lines, a) }
    for i in 0..strs_len(fb.vars) { strs_push(lines, "  var x" + int_to_str(i) + " " + strs_get(fb.vars, i)) }
    for i in 0..strs_len(fb.slots) { strs_push(lines, "  slot s" + int_to_str(i) + " " + strs_get(fb.slots, i)) }
    for d in fb.debug_lines { strs_push(lines, d) }
    for b in 0..vec_len(fb.insts) {
        strs_push(lines, "b" + int_to_str(b) + ":")
        for x in vec_get(fb.insts, b) { strs_push(lines, "  " + x) }
        strs_push(lines, "  " + strs_get(fb.terms, b))
    }
    str_join(lines, "\n") + "\n"
}

fn vn(v: Int) -> Str { "v" + int_to_str(v) }

// --- one function: the lowering state -----------------------------------------------------------

/// Where each local lives: `var` (variable `idx`), `value` (promoted: its current value in
/// `promoted`), `slot` (frame slot `idx`), `borrowed` (the address in value `idx`) or `tasks`.
struct Fx {
    lo: Lo,
    fb: Fb,
    f: MirFn,
    kinds: Strs,
    idx: Ints,
    tys: Strs,
    promoted: Ints,
    /// The LIR block of each MIR block.
    blocks: Ints,
    /// The in-memory result's address, the current failure edge, -1 for none.
    reg: Ints,
    at: Strs,
}

fn sret(fx: Fx) -> Int { ints_get(fx.reg, 0) }
fn unwind_block(fx: Fx) -> Int { ints_get(fx.reg, 1) }

fn param(fx: Fx, i: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = param " + int_to_str(i));
    v
}

fn iconst_c(fx: Fx, c: Str, k: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = const " + c + " " + int_to_str(k));
    v
}

fn iconst(fx: Fx, k: Int) -> Int { iconst_c(fx, "i64", k) }
fn null(fx: Fx) -> Int { iconst_c(fx, "ptr", 0) }

fn addr_of(fx: Fx, sym: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = addr @" + strs_get(fx.lo.sym_name, sym));
    v
}

fn slot_addr(fx: Fx, s: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = slot s" + int_to_str(s));
    v
}

fn load(fx: Fx, c: Str, a: Int, off: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = load " + c + " " + vn(a) + "+" + int_to_str(off));
    v
}

fn store(fx: Fx, a: Int, off: Int, x: Int) {
    emit(fx.fb, "store " + vn(a) + "+" + int_to_str(off) + ", " + vn(x));
}

fn bin(fx: Fx, op: Str, a: Int, b: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = " + op + " " + vn(a) + ", " + vn(b));
    v
}

fn add_imm(fx: Fx, a: Int, k: Int) -> Int {
    let c = iconst(fx, k)
    bin(fx, "add", a, c)
}

fn cmp(fx: Fx, op: Str, a: Int, b: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = cmp " + op + " " + vn(a) + ", " + vn(b));
    v
}

fn cmp_imm(fx: Fx, op: Str, a: Int, c: Str, k: Int) -> Int {
    let x = iconst_c(fx, c, k)
    cmp(fx, op, a, x)
}

fn is_null(fx: Fx, p: Int) -> Int {
    let z = null(fx)
    cmp(fx, "eq", p, z)
}

fn ptr_add(fx: Fx, base: Int, off: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = ptradd " + vn(base) + ", " + vn(off));
    v
}

fn ptr_off(fx: Fx, base: Int, k: Int) -> Int {
    if k == 0 { return base }
    let c = iconst(fx, k)
    ptr_add(fx, base, c)
}

fn get_var(fx: Fx, x: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = get x" + int_to_str(x));
    v
}

fn set_var(fx: Fx, x: Int, v: Int) { emit(fx.fb, "set x" + int_to_str(x) + ", " + vn(v)) }

fn args_text(args: Ints) -> Str {
    let out = strs_new()
    for i in 0..ints_len(args) { strs_push(out, vn(ints_get(args, i))) }
    str_join(out, ", ")
}

/// A call that is not checked for failure: its result, or -1.
fn call(fx: Fx, callee: Int, args: Ints) -> Int {
    let returns = strs_get(fx.lo.sym_ret, callee) != ""
    let dst = if returns { value(fx.fb) } else { 0 - 1 }
    let head = if returns { vn(dst) + " = " } else { "" }
    emit(fx.fb, head + "call @" + strs_get(fx.lo.sym_name, callee) + "(" + args_text(args) + ")");
    dst
}

/// A call returning its failure bit beside its result: `[result or -1, failed or -1]`.
fn call_failing(fx: Fx, callee: Int, args: Ints) -> Ints {
    let returns = strs_get(fx.lo.sym_ret, callee) != ""
    let dst = if returns { value(fx.fb) } else { 0 - 1 }
    let fails = ints_get(fx.lo.sym_fails, callee) == 1
    let failed = if fails { value(fx.fb) } else { 0 - 1 }
    let head = if returns && fails { vn(dst) + ", failed " + vn(failed) + " = " } else if returns { vn(dst) + " = " } else if fails { "failed " + vn(failed) + " = " } else { "" }
    emit(fx.fb, head + "call @" + strs_get(fx.lo.sym_name, callee) + "(" + args_text(args) + ")");
    let out = ints_new()
    ints_push(out, dst)
    ints_push(out, failed)
    out
}

fn rt(fx: Fx, name: Str, args: Ints) -> Int { call(fx, runtime_sym(fx.lo, name), args) }

fn rt_v(fx: Fx, name: Str, args: Ints, c: Str) -> Int {
    let r = rt(fx, name, args)
    if r >= 0 { r } else { iconst_c(fx, c, 0) }
}

fn ints_of(a: Int) -> Ints {
    let out = ints_new()
    ints_push(out, a)
    out
}

fn ints_of2(a: Int, b: Int) -> Ints {
    let out = ints_of(a)
    ints_push(out, b)
    out
}

fn ints_of3(a: Int, b: Int, c: Int) -> Ints {
    let out = ints_of2(a, b)
    ints_push(out, c)
    out
}

fn copy(fx: Fx, dst: Int, src: Int, n: Int) { emit(fx.fb, "copy " + vn(dst) + ", " + vn(src) + ", " + int_to_str(n)) }
fn zero(fx: Fx, dst: Int, n: Int) { emit(fx.fb, "zero " + vn(dst) + ", " + int_to_str(n)) }
fn jump(fx: Fx, b: Int) { term(fx.fb, "jump b" + int_to_str(b)) }
fn branch(fx: Fx, c: Int, a: Int, b: Int) { term(fx.fb, "branch " + vn(c) + ", b" + int_to_str(a) + ", b" + int_to_str(b)) }

fn size_of(fx: Fx, t: Str) -> Int { lay(fx.lo.lx, t).size }
fn owns_ty(fx: Fx, t: Str) -> Bool { owns(fx.lo.lx, t, 0) }

fn ty(fx: Fx, l: Int) -> Str { strs_get(fx.tys, l) }

fn addr(fx: Fx, l: Int) -> Int {
    let k = strs_get(fx.kinds, l)
    if k == "slot" { return slot_addr(fx, ints_get(fx.idx, l)) }
    if k == "borrowed" { return ints_get(fx.idx, l) }
    defect(fx.lo, "an address of a local held in a register");
    null(fx)
}

fn get(fx: Fx, l: Int) -> Int {
    let k = strs_get(fx.kinds, l)
    if k == "var" || k == "tasks" { return get_var(fx, ints_get(fx.idx, l)) }
    if k == "value" {
        let v = ints_get(fx.promoted, l)
        return if v >= 0 { v } else { iconst_c(fx, mclass(ty(fx, l)), 0) }
    }
    defect(fx.lo, "a scalar read of a local held in memory");
    iconst(fx, 0)
}

fn set(fx: Fx, l: Int, v: Int) {
    let k = strs_get(fx.kinds, l)
    if k == "var" || k == "tasks" { set_var(fx, ints_get(fx.idx, l), v) } else if k == "value" { ints_set(fx.promoted, l, v) } else { defect(fx.lo, "a scalar write of a local held in memory") }
}

fn clear(fx: Fx, l: Int) {
    let k = strs_get(fx.kinds, l)
    let c = if k == "var" || k == "value" { mclass(ty(fx, l)) } else { "ptr" }
    let z = iconst_c(fx, c, 0)
    set(fx, l, z);
}

fn const_ty(c: MConst) -> Str {
    match c {
        MConst.Int(v: _) => "Int",
        MConst.Bool(v: _) => "Bool",
        MConst.Str(bytes: _) => "Str",
        MConst.Num(text: _, kind: k) => k,
        MConst.Cell(name: _, key: _) => "Atomic",
    }
}

fn operand_ty(fx: Fx, o: Operand) -> Str {
    match o {
        Operand.Local(l: l) => ty(fx, l),
        Operand.Const(c: c) => const_ty(c),
    }
}

fn opvalue(fx: Fx, o: Operand) -> Int {
    match o {
        Operand.Local(l: l) => get(fx, l),
        Operand.Const(c: c) => match c {
            MConst.Int(v: v) => iconst(fx, v),
            MConst.Bool(v: b) => iconst_c(fx, "bit", if b { 1 } else { 0 }),
            MConst.Num(text: t, kind: k) => num_const(fx, k, t),
            _ => {
                defect(fx.lo, "a string literal or a static atomic read into a scalar");
                iconst(fx, 0)
            },
        },
    }
}

fn place(fx: Fx, o: Operand) -> Int {
    match o {
        Operand.Local(l: l) => addr(fx, l),
        Operand.Const(c: c) => match c {
            MConst.Str(bytes: b) => addr_of(fx, str_value(fx.lo, b)),
            // A static atomic (Gate 3): its cell's triple, as a literal's is.
            MConst.Cell(name: _, key: k) => {
                let d = cell_value(fx, k)
                if d >= 0 { addr_of(fx, d) } else { null(fx) }
            },
            _ => {
                defect(fx.lo, "the address of a constant this stage cannot place yet");
                null(fx)
            },
        },
    }
}

fn argument(fx: Fx, o: Operand) -> Int {
    if in_memory(operand_ty(fx, o)) { place(fx, o) } else { opvalue(fx, o) }
}

// --- failure ------------------------------------------------------------------------------------

/// The function's name span, for a stack check: the name after `fn` in its span.
fn name_at(fx: Fx) -> Str {
    let f = fx.f
    // A thunk (`NAME#value@HOME`) has its target's spans (`thunk_of`): the target's name.
    let mut node = f.node
    let mut fname = f.name
    let hash = match text_find(f.name, "#value@") { Some(i) => i, None => 0 - 1 }
    if node < 0 && hash >= 0 {
        let target = str_slice(f.name, hash + 7, str_len(f.name)) + "::fn " + str_slice(f.name, 0, hash)
        match hashmap_get(fx.lo.c.by_def, target) {
            Some(i) => {
                let g = vec_get(fx.lo.c.fns, i)
                node = g.node
                fname = g.name
            },
            None => {},
        }
    }
    if node < 0 { return "" }
    let span = sval(fx.lo.c, node, "at")
    let mut colon = 0 - 1
    for i in 0..str_len(span) { if str_byte(span, i) == 58 { colon = i } }
    let file = str_slice(span, 0, colon)
    let rest = str_slice(span, colon + 1, str_len(span))
    let dots = match text_find(rest, "..") { Some(i) => i, None => str_len(rest) }
    let start = match text_parse_int(str_slice(rest, 0, dots)) { Ok(v) => v, Err(e) => 0 }
    let text = match hashmap_get(fx.lo.sources, file) { Some(t) => t, None => "" }
    let mut name = fname
    match text_find(name, "/") {
        Some(_) => {
            let mut slash = 0
            for i in 0..str_len(name) { if str_byte(name, i) == 47 { slash = i + 1 } }
            name = str_slice(name, slash, str_len(name))
        },
        None => {},
    }
    let tail = str_slice(text, start, str_len(text))
    let at = match text_find(tail, "fn " + name) { Some(i) => start + i + 3, None => start }
    file + ":" + int_to_str(at) + ".." + int_to_str(at + str_len(name))
}

/// The function's own span (a thunk's is its target's).
fn fn_span(fx: Fx) -> Str {
    let f = fx.f
    let mut node = f.node
    let hash = match text_find(f.name, "#value@") { Some(i) => i, None => 0 - 1 }
    if node < 0 && hash >= 0 {
        let target = str_slice(f.name, hash + 7, str_len(f.name)) + "::fn " + str_slice(f.name, 0, hash)
        match hashmap_get(fx.lo.c.by_def, target) {
            Some(i) => { node = vec_get(fx.lo.c.fns, i).node },
            None => {},
        }
    }
    if node < 0 { "" } else { sval(fx.lo.c, node, "at") }
}

/// Where the statement being lowered comes from, for a debugger (`Fx::locate`).
fn locate(fx: Fx) {
    if !fx.lo.debug { return }
    let p = loc_of(fx.lo, here(fx))
    if p != "" { emit(fx.fb, "loc " + p) }
}

/// A variable a debugger can read (N58, `Fx::debug_var`): a parameter or a source binding of
/// an integer word, `Bool` or a string with a plain name, where it is kept, its line and scope.
fn debug_var(fx: Fx, i: Int, l: LocalDecl, borrowed_at: HashMap[Int, Int]) {
    // Its kind as LIR has it (`Ty::of`): a capability or handle is an `Int`, a `Bytes` a `Str`.
    let kind = class(l.ty)
    if kind != "int" && kind != "bool" && kind != "str" { return }
    let arg = if l.origin == "param" { i + 1 } else if l.origin == "temp" { 0 - 1 } else { 0 }
    if arg < 0 { return }
    let lat = if l.at == "@name" { name_at(fx) } else { l.at }
    let lc = line_col(fx.lo, lat)
    if ints_len(lc) == 0 { return }
    if str_len(l.name) == 0 { return }
    for k in 0..str_len(l.name) {
        let b = str_byte(l.name, k)
        if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) { return }
    }
    let kd = strs_get(fx.kinds, i)
    let storage = if kd == "var" { "x" + int_to_str(ints_get(fx.idx, i)) } else if kd == "slot" { "s" + int_to_str(ints_get(fx.idx, i)) } else if kd == "borrowed" {
        match hashmap_get(borrowed_at, i) { Some(v) => "x" + int_to_str(v) + "*", None => "" }
    } else { "" }
    if storage == "" { return }
    let mut lexical = "(0, 0, 0, 0)"
    if l.region != "" {
        let first = line_col(fx.lo, l.region)
        let file = span_file(l.region)
        let rest = str_slice(l.region, str_len(file) + 1, str_len(l.region))
        let end = match text_find(rest, "..") {
            Some(d) => match text_parse_int(str_slice(rest, d + 2, str_len(rest))) { Ok(v) => v, Err(_) => 0 },
            None => 0,
        }
        let last = line_col(fx.lo, file + ":" + int_to_str(if end > 0 { end - 1 } else { 0 }) + ".." + int_to_str(end))
        if ints_len(first) == 2 && ints_len(last) == 2 {
            lexical = "(" + int_to_str(ints_get(first, 0)) + ", " + int_to_str(ints_get(first, 1)) + ", " + int_to_str(ints_get(last, 0)) + ", " + int_to_str(ints_get(last, 1)) + ")"
        }
    }
    strs_push(fx.fb.debug_lines, "  debug " + storage + " " + int_to_str(arg) + " " + int_to_str(ints_get(lc, 0)) + " " + kind + " " + lexical + " " + l.name)
}

fn here(fx: Fx) -> Str {
    let a = strs_get(fx.at, 0)
    if a == "@name" { name_at(fx) } else { a }
}

fn leave(fx: Fx) {
    let u = unwind_block(fx)
    if u >= 0 {
        jump(fx, u);
    } else {
        defect(fx.lo, "a failure with no failure edge in MIR");
        term(fx.fb, "unreachable");
    }
}

fn fail_with(fx: Fx, code: Str, what: Str) {
    let m = message(fx.lo, code, what, here(fx))
    let p = addr_of(fx, ints_get(m, 0))
    let n = iconst(fx, ints_get(m, 1))
    rt(fx, "nz.fail", ints_of2(p, n))
    leave(fx);
}

fn guard(fx: Fx, bad: Int, code: Str, what: Str) {
    let failing = new_lblock(fx.fb)
    let cont = new_lblock(fx.fb)
    branch(fx, bad, failing, cont);
    switch_to(fx.fb, failing);
    fail_with(fx, code, what);
    switch_to(fx.fb, cont);
}

fn leave_if(fx: Fx, failed: Int) {
    let cont = new_lblock(fx.fb)
    let u = unwind_block(fx)
    if u >= 0 { branch(fx, failed, u, cont) } else {
        defect(fx.lo, "a failure check with no failure edge");
        jump(fx, cont);
    }
    switch_to(fx.fb, cont);
}

fn check_failed(fx: Fx) {
    let f = rt_v(fx, "nz.failed_now", ints_new(), "i32")
    let failed = cmp_imm(fx, "ne", f, "i32", 0)
    leave_if(fx, failed);
}

fn check_call(fx: Fx, failed: Int) {
    if failed >= 0 { leave_if(fx, failed) } else { check_failed(fx) }
}

// --- ownership ----------------------------------------------------------------------------------

fn retain_value(fx: Fx, v: Int, t: Str) {
    let s = spell(t)
    if t == "Ints" || t == "Strs" || s.kind == "vec" && s.head != "Chan" { rt(fx, "nz.arr_retain", ints_of(v)); return }
    if t == "Chan" || s.head == "Chan" { rt(fx, "nz.chan_retain", ints_of(v)); return }
    if s.kind == "unknown" { rt(fx, "nz.closure_retain", ints_of(v)); return }
}

fn retain_at(fx: Fx, a: Int, t: Str) {
    if !owns_ty(fx, t) { return }
    let k = class(t)
    if k == "str" {
        let o = load(fx, "ptr", a, 16)
        rt(fx, "nz.str_retain", ints_of(o))
    } else if k == "record" || k == "enum" || k == "array" {
        let h = helper(fx.lo, "ret", t)
        call(fx, h, ints_of(a));
    } else {
        let v = load(fx, "ptr", a, 0)
        retain_value(fx, v, t);
    }
}

fn release_value(fx: Fx, v: Int, t: Str) {
    let s = spell(t)
    if t == "Ints" { rt(fx, "nz.seq_release", ints_of(v)); return }
    if t == "Strs" { rt(fx, "nz.strs_release", ints_of(v)); return }
    if t == "Chan" { rt(fx, "nz.chan_release", ints_of(v)); return }
    if s.head == "Chan" && strs_len(s.args) > 0 { rt(fx, "nz.chanv_release", ints_of(v)); return }
    if s.kind == "unknown" { rt(fx, "nz.closure_release", ints_of(v)); return }
    if s.kind == "vec" {
        // `Ints` and `Strs` are `Vec[Int]` and `Vec[Str]` (R1, 5b.18): a vector of strings
        // releases each element as any vector of owned elements does.
        let elem = strs_get(s.args, 0)
        if owns_ty(fx, elem) {
            let h = helper(fx.lo, "vel", elem)
            let f = addr_of(fx, h)
            let stride = iconst(fx, size_of(fx, elem))
            let q = release_queue(fx)
            rt(fx, "nz.vec_release", ints_of4(v, f, stride, q));
        } else {
            rt(fx, "nz.seq_release", ints_of(v))
        }
    }
}

fn release_at(fx: Fx, a: Int, t: Str) {
    if !owns_ty(fx, t) { return }
    let k = class(t)
    if k == "str" {
        let o = load(fx, "ptr", a, 16)
        rt(fx, "nz.str_release", ints_of(o))
    } else if k == "record" || k == "enum" || k == "array" {
        let h = helper(fx.lo, "rel", t)
        let q = release_queue(fx)
        call(fx, h, ints_of2(a, q));
    } else {
        let v = load(fx, "ptr", a, 0)
        release_value(fx, v, t);
    }
}

fn move_into(fx: Fx, to: Int, from: Int) {
    let t = ty(fx, from)
    if in_memory(t) {
        let src = addr(fx, from)
        let n = size_of(fx, t)
        copy(fx, to, src, n);
        if owns_ty(fx, t) { zero(fx, src, n) }
    } else {
        let v = get(fx, from)
        store(fx, to, 0, v);
        if owns_ty(fx, t) { clear(fx, from) }
    }
}

// --- strings ------------------------------------------------------------------------------------

fn str_parts(fx: Fx, s: Int) -> Ints {
    let p = load(fx, "ptr", s, 0)
    let n = load(fx, "i64", s, 8)
    ints_of2(p, n)
}

fn write_str(fx: Fx, dst: Int, p: Int, n: Int, owner: Int) {
    let d = addr(fx, dst)
    store(fx, d, 0, p);
    store(fx, d, 8, n);
    store(fx, d, 16, owner);
}

/// A string backing of `bytes` usable bytes: `[owner, data]`.
fn string_backing(fx: Fx, bytes: Int) -> Ints {
    let owner = rt_v(fx, "nz.str_alloc", ints_of(bytes), "ptr")
    let none = is_null(fx, owner)
    guard(fx, none, "N0406", "out of memory");
    let data = ptr_off(fx, owner, 16)
    ints_of2(owner, data)
}

fn arg_place(fx: Fx, args: Vec[Operand], i: Int) -> Int {
    if i < vec_len(args) { place(fx, vec_get(args, i)) } else { null(fx) }
}

fn arg_value(fx: Fx, args: Vec[Operand], i: Int) -> Int {
    if i < vec_len(args) { opvalue(fx, vec_get(args, i)) } else { iconst(fx, 0) }
}

fn primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) {
    // Immutable indirection (R1a): a `Box[T]` and a `Chain[T]` are their `Vec[T]`, so each of
    // their operations is the `Vec` one it means.
    if op == "box_fresh" || op == "chain_empty" { primitive(fx, dst, "vec_new", elem, args); return }
    if op == "box_fill" || op == "chain_push" { primitive(fx, dst, "vec_push", elem, args); return }
    if op == "chain_len" { primitive(fx, dst, "vec_len", elem, args); return }
    if op == "chain_get" { primitive(fx, dst, "vec_get", elem, args); return }
    if op == "box_get" {
        let first: Vec[Operand] = vec_new()
        vec_push(first, if vec_len(args) > 0 { vec_get(args, 0) } else { Operand.Const(c: MConst.Int(v: 0)) })
        vec_push(first, Operand.Const(c: MConst.Int(v: 0)))
        primitive(fx, dst, "vec_get", elem, first);
        return
    }
    if num_primitive(fx, dst, op, elem, args) { return }
    if seq_primitive(fx, dst, op, elem, args) { return }
    if chan_primitive(fx, dst, op, elem, args) { return }
    if bytes_text(fx, dst, op, elem, args) { return }
    if files(fx, dst, op, args) { return }
    if atomics(fx, dst, op, args) { return }
    if text_primitive(fx, dst, op, elem, args) { return }
    if misc_primitive(fx, dst, op, elem, args) { return }
    primitive_base(fx, dst, op, elem, args);
}

fn primitive_base(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) {
    if op == "str_concat" {
        let a = arg_place(fx, args, 0)
        let b = arg_place(fx, args, 1)
        let pa = str_parts(fx, a)
        let pb = str_parts(fx, b)
        let n = bin(fx, "add", ints_get(pa, 1), ints_get(pb, 1))
        let room = add_imm(fx, n, 1)
        let ob = string_backing(fx, room)
        let buf = ints_get(ob, 1)
        rt(fx, "memcpy", ints_of3(buf, ints_get(pa, 0), ints_get(pa, 1)))
        let rest = ptr_add(fx, buf, ints_get(pa, 1))
        rt(fx, "memcpy", ints_of3(rest, ints_get(pb, 0), ints_get(pb, 1)))
        write_str(fx, dst, buf, n, ints_get(ob, 0));
    } else if op == "print" || op == "eprint" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        let fd = iconst_c(fx, "i32", if op == "print" { 1 } else { 2 })
        let w = rt_v(fx, "write", ints_of3(fd, ints_get(pn, 0), ints_get(pn, 1)), "i64")
        set(fx, dst, w);
    } else if op == "int_to_str" {
        let x = arg_value(fx, args, 0)
        let room = iconst(fx, 21)
        let ob = string_backing(fx, room)
        let n = rt_v(fx, "nz.format_int", ints_of2(ints_get(ob, 1), x), "i64")
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
    } else if op == "str_len" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        set(fx, dst, ints_get(pn, 1));
    } else if op == "str_byte" {
        let s = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let pn = str_parts(fx, s)
        let neg = cmp_imm(fx, "lt", i, "i64", 0)
        let past = cmp(fx, "ge", i, ints_get(pn, 1))
        let bad = bin(fx, "or", neg, past)
        guard(fx, bad, "N0405", "this byte index is outside the `Str`");
        let a = ptr_add(fx, ints_get(pn, 0), i)
        let byte = load(fx, "i8", a, 0)
        set(fx, dst, ext(fx, "i64", byte, false));
    } else if op == "str_from_byte" {
        let b = arg_value(fx, args, 0)
        let low = cmp_imm(fx, "lt", b, "i64", 0)
        let high = cmp_imm(fx, "gt", b, "i64", 255)
        let bad = bin(fx, "or", low, high)
        guard(fx, bad, "N0405", "this is not a byte value");
        let room = iconst(fx, 1)
        let ob = string_backing(fx, room)
        let narrow = trunc(fx, "i8", b)
        store(fx, ints_get(ob, 1), 0, narrow);
        let one = iconst(fx, 1)
        write_str(fx, dst, ints_get(ob, 1), one, ints_get(ob, 0));
    } else if op == "args_count" {
        set(fx, dst, argc(fx));
    } else if op == "arg" {
        let i = arg_value(fx, args, 0)
        let n = argc(fx)
        let neg = cmp_imm(fx, "lt", i, "i64", 0)
        let past = cmp(fx, "ge", i, n)
        let bad = bin(fx, "or", neg, past)
        guard(fx, bad, "N0405", "this index is outside the arguments");
        let d = runtime_data(fx.lo, "nz.argv", "ptr")
        let a = addr_of(fx, d)
        let base = load(fx, "ptr", a, 0)
        let shifted = add_imm(fx, i, 1)
        let width = iconst(fx, 8)
        let off = bin(fx, "mul", shifted, width)
        let slot = ptr_add(fx, base, off)
        let text = load(fx, "ptr", slot, 0)
        let len = rt_v(fx, "strlen", ints_of(text), "i64")
        let z = null(fx)
        write_str(fx, dst, text, len, z);
    } else if op == "ints_new" || op == "strs_new" || op == "vec_new" {
        let h = rt_v(fx, "nz.seq_new", ints_new(), "ptr")
        let none = is_null(fx, h)
        guard(fx, none, "N0406", "out of memory");
        set(fx, dst, h);
    } else if op == "ints_len" || op == "strs_len" || op == "vec_len" {
        let h = arg_value(fx, args, 0)
        set(fx, dst, load(fx, "i64", h, 0));
    } else {
        defect(fx.lo, "the primitive `" + op + "` (not ported yet)");
    }
}

// --- sequences ----------------------------------------------------------------------------------

/// A fresh slot of `size` bytes (at least 8, 8-aligned), its address.
fn scratch(fx: Fx, size: Int) -> Int {
    let s = new_slot(fx.fb, if size < 8 { 8 } else { size }, 8)
    slot_addr(fx, s)
}

fn select(fx: Fx, c: Int, a: Int, b: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = select " + vn(c) + ", " + vn(a) + ", " + vn(b));
    v
}

fn ptr_to_int(fx: Fx, p: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = ptrtoint " + vn(p));
    v
}

fn int_to_ptr(fx: Fx, x: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = inttoptr " + vn(x));
    v
}

fn bit(fx: Fx, b: Bool) -> Int { iconst_c(fx, "bit", if b { 1 } else { 0 }) }

/// The element type of a sequence built-in (`prims::element`).
fn element(op: Str, elem: Str) -> Str {
    if op == "ints_get" || op == "ints_set" || op == "ints_push" || op == "ints_pop" { return "Int" }
    if op == "strs_get" || op == "strs_set" || op == "strs_push" || op == "strs_pop" { return "Str" }
    if elem == "" { "Int" } else { elem }
}

/// The address of element `i` of sequence `h`, bounds-checked.
fn sequence_slot(fx: Fx, h: Int, i: Int, t: Str) -> Int {
    let len = load(fx, "i64", h, 0)
    let neg = cmp_imm(fx, "lt", i, "i64", 0)
    let past = cmp(fx, "ge", i, len)
    let bad = bin(fx, "or", neg, past)
    guard(fx, bad, "N0405", "this index is outside the sequence");
    let data = load(fx, "ptr", h, 16)
    let stride = iconst(fx, size_of(fx, t))
    let off = bin(fx, "mul", i, stride)
    ptr_add(fx, data, off)
}

fn read_element(fx: Fx, dst: Int, slot: Int, t: Str) {
    if in_memory(t) {
        let d = addr(fx, dst)
        copy(fx, d, slot, size_of(fx, t));
        retain_at(fx, d, t);
    } else {
        let v = load(fx, mclass(t), slot, 0)
        if owns_ty(fx, t) { retain_value(fx, v, t) }
        set(fx, dst, v);
    }
}

/// Store a borrowed operand into an element slot, taking a reference of the container's own;
/// with `replace`, the old element is released after.
fn store_element(fx: Fx, slot: Int, args: Vec[Operand], i: Int, t: Str, replace: Bool) {
    if i >= vec_len(args) {
        defect(fx.lo, "a sequence write with no value");
        return
    }
    let o = vec_get(args, i)
    if in_memory(t) {
        let n = size_of(fx, t)
        let src = place(fx, o)
        let mut old = 0 - 1
        if replace {
            // Kept aside so that a value sharing the old one's storage is safe.
            old = scratch(fx, n)
            copy(fx, old, slot, n);
        }
        retain_at(fx, src, t);
        copy(fx, slot, src, n);
        if old >= 0 { release_at(fx, old, t) }
    } else {
        let v = opvalue(fx, o)
        let old = if replace { load(fx, mclass(t), slot, 0) } else { 0 - 1 }
        if owns_ty(fx, t) { retain_value(fx, v, t) }
        store(fx, slot, 0, v);
        if old >= 0 && owns_ty(fx, t) { release_value(fx, old, t) }
    }
}

/// Append the element at `slot` to the sequence `h`, moving its reference.
fn push_moved(fx: Fx, h: Int, slot: Int, t: Str) {
    let stride = iconst(fx, size_of(fx, t))
    let data = rt_v(fx, "nz.arr_grow", ints_of2(h, stride), "ptr")
    let none = is_null(fx, data)
    guard(fx, none, "N0406", "out of memory");
    let len = load(fx, "i64", h, 0)
    let off = bin(fx, "mul", len, stride)
    let at_ = ptr_add(fx, data, off)
    copy(fx, at_, slot, size_of(fx, t));
    let grown = add_imm(fx, len, 1)
    store(fx, h, 0, grown);
}

fn seq_primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    if op == "ints_get" || op == "strs_get" || op == "vec_get" {
        let t = element(op, elem)
        let h = arg_value(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let slot = sequence_slot(fx, h, i, t)
        // Its own copy, by the element's law, before anything else can happen to the slot.
        read_element(fx, dst, slot, t);
        return true
    }
    if op == "ints_set" || op == "strs_set" || op == "vec_set" {
        let t = element(op, elem)
        let h = arg_value(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let slot = sequence_slot(fx, h, i, t)
        // The new value's reference is taken before the old one is released.
        store_element(fx, slot, args, 2, t, true);
        set(fx, dst, i);
        return true
    }
    if op == "ints_push" || op == "strs_push" || op == "vec_push" {
        let t = element(op, elem)
        let h = arg_value(fx, args, 0)
        let stride = iconst(fx, size_of(fx, t))
        // Growth first, and nothing taken until it has succeeded.
        let data = rt_v(fx, "nz.arr_grow", ints_of2(h, stride), "ptr")
        let none = is_null(fx, data)
        guard(fx, none, "N0406", "out of memory");
        let len = load(fx, "i64", h, 0)
        let off = bin(fx, "mul", len, stride)
        let slot = ptr_add(fx, data, off)
        store_element(fx, slot, args, 1, t, false);
        let grown = add_imm(fx, len, 1)
        store(fx, h, 0, grown);
        set(fx, dst, grown);
        return true
    }
    if op == "ints_pop" || op == "strs_pop" || op == "vec_pop" {
        let t = element(op, elem)
        let h = arg_value(fx, args, 0)
        let len = load(fx, "i64", h, 0)
        let empty = cmp_imm(fx, "le", len, "i64", 0)
        guard(fx, empty, "N0405", "this sequence is empty");
        let last = add_imm(fx, len, 0 - 1)
        let data = load(fx, "ptr", h, 16)
        let stride = iconst(fx, size_of(fx, t))
        let off = bin(fx, "mul", last, stride)
        let slot = ptr_add(fx, data, off)
        // A transfer: the sequence gives up its reference and the destination holds it.
        if in_memory(t) {
            let d = addr(fx, dst)
            copy(fx, d, slot, size_of(fx, t));
        } else {
            set(fx, dst, load(fx, mclass(t), slot, 0));
        }
        store(fx, h, 0, last);
        return true
    }
    if op == "str_join" {
        let h = arg_value(fx, args, 0)
        let sep = arg_place(fx, args, 1)
        let sp = str_parts(fx, sep)
        let d = addr(fx, dst)
        rt(fx, "nz.str_join_to", ints_of4(d, h, ints_get(sp, 0), ints_get(sp, 1)))
        let got = load(fx, "ptr", d, 0)
        let bad = is_null(fx, got)
        guard(fx, bad, "N0406", "out of memory");
        return true
    }
    if op == "ints_sum_from" {
        let start = arg_value(fx, args, 0)
        let v = arg_value(fx, args, 1)
        let flag = scratch(fx, 8)
        let z = iconst_c(fx, "i32", 0)
        store(fx, flag, 0, z);
        let t = rt_v(fx, "nz.ints_sum", ints_of3(v, start, flag), "i64")
        let raised = load(fx, "i32", flag, 0)
        let bad = cmp_imm(fx, "ne", raised, "i32", 0)
        guard(fx, bad, "N0400", "this addition overflows `Int`");
        set(fx, dst, t);
        return true
    }
    false
}

// --- numbers other than `Int` (`numeric.rs`) -----------------------------------------------------

/// A numeric type's kind, `Int` for anything else (`kind_of(…).unwrap_or(I64)`).
fn num_kind(t: Str) -> Str { if kind_of(t) == "" { "Int" } else { kind_of(t) } }

fn kconst(fx: Fx, c: Str, text: Str) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = const " + c + " " + text);
    v
}

/// `a - b` of two non-negative decimal texts, `a >= b`.
fn dec_sub(a: Str, b: Str) -> Str {
    let out = strs_new()
    let mut borrow = 0
    let la = str_len(a)
    let lb = str_len(b)
    let digits = ints_new()
    for i in 0..la {
        let da = str_byte(a, la - 1 - i) - 48
        let db = if i < lb { str_byte(b, lb - 1 - i) - 48 } else { 0 }
        let mut d = da - db - borrow
        if d < 0 {
            d += 10
            borrow = 1
        } else {
            borrow = 0
        }
        ints_push(digits, d)
    }
    let mut top = ints_len(digits) - 1
    while top > 0 && ints_get(digits, top) == 0 { top -= 1 }
    let mut i = top
    while i >= 0 {
        strs_push(out, int_to_str(ints_get(digits, i)))
        i -= 1
    }
    str_join(out, "")
}

/// Whether non-negative decimal `a` is at least `b`.
fn dec_ge(a: Str, b: Str) -> Bool {
    if str_len(a) != str_len(b) { return str_len(a) > str_len(b) }
    for i in 0..str_len(a) {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) > str_byte(b, i) }
    }
    true
}

fn parse_int(t: Str) -> Int { match text_parse_int(t) { Ok(v) => v, Err(e) => 0 } }

/// An integer of `bits` bits' value `text` (decimal), as its class's constant: two's complement
/// at the class's width, sign-extended (`num_const`).
fn int_const_text(k: Str, text: Str) -> Str {
    let c = mclass(k)
    let neg = str_len(text) > 0 && str_byte(text, 0) == 45
    if c == "i128" {
        if !neg && dec_ge(text, "170141183460469231731687303715884105728") {
            return "-" + dec_sub("340282366920938463463374607431768211456", text)
        }
        return text
    }
    if !neg && dec_ge(text, "9223372036854775808") {
        return "-" + dec_sub("18446744073709551616", text)
    }
    let v = parse_int(text)
    let w = if c == "i8" { 256 } else if c == "i16" { 65536 } else if c == "i32" { 4294967296 } else { 0 }
    if w == 0 { return int_to_str(v) }
    let mut low = v % w
    if low < 0 { low += w }
    int_to_str(if low >= w / 2 { low - w } else { low })
}

/// The IEEE 754 double bits of an exact integer `n` (|n| < 2^53), as an `Int`.
fn f64_bits_int(n: Int) -> Int {
    if n == 0 { return 0 }
    let neg = n < 0
    let m = if neg { 0 - n } else { n }
    let mut e = 0
    while e < 62 && m >= 2 * pow2i(e) { e += 1 }
    let frac = (m - pow2i(e)) * pow2i(52 - e)
    let pos = (1023 + e) * pow2i(52) + frac
    if neg { pos - 9223372036854775807 - 1 } else { pos }
}

fn pow2i(e: Int) -> Int {
    let mut r = 1
    for i in 0..e { r = r * 2 }
    r
}

/// The double bits of `2^e` (or `-2^e`).
fn f64_bits_pow2(e: Int, neg: Bool) -> Int {
    let pos = (1023 + e) * pow2i(52)
    if neg { pos - 9223372036854775807 - 1 } else { pos }
}

/// A float constant of `class` from its canonical decimal text.
fn float_text_bits(k: Str, text: Str) -> Int {
    let d = float_parse_raw(text)
    if k == "Float32" {
        let f = Float32(d)
        let b = wrap_convert[Int32](float32_to_bits(f))
        return Int(b)
    }
    wrap_convert[Int](float64_to_bits(d))
}

/// A constant of numeric kind `k`, from its canonical text (`num_const`).
fn num_const(fx: Fx, k: Str, text: Str) -> Int {
    if is_float(k) { return iconst_c(fx, mclass(k), float_text_bits(k, text)) }
    kconst(fx, mclass(k), int_const_text(k, text))
}

/// Kind `k`'s smallest and largest values, as decimal text.
fn kind_lo(k: Str) -> Str {
    if k == "Int8" { return "-128" }
    if k == "Int16" { return "-32768" }
    if k == "Int32" { return "-2147483648" }
    if k == "Int128" { return "-170141183460469231731687303715884105728" }
    if k == "Int" || k == "Int64" { return "-9223372036854775808" }
    "0"
}

fn kind_hi(k: Str) -> Str {
    if k == "Int8" { return "127" }
    if k == "Int16" { return "32767" }
    if k == "Int32" { return "2147483647" }
    if k == "Int128" { return "170141183460469231731687303715884105727" }
    if k == "UInt8" { return "255" }
    if k == "UInt16" { return "65535" }
    if k == "UInt32" { return "4294967295" }
    if k == "UInt64" { return "18446744073709551615" }
    if k == "UInt128" { return "340282366920938463463374607431768211455" }
    "9223372036854775807"
}

/// A bound as a constant of `class`: its value's low 128 bits read as an `i128` (`bound`).
fn bound(fx: Fx, c: Str, text: Str) -> Int {
    if text == "340282366920938463463374607431768211455" { return kconst(fx, c, "-1") }
    kconst(fx, c, text)
}

/// A bound as the `i64` the narrow paths compare with (`to_i128() as i64`).
fn bound64(text: Str) -> Int {
    if text == "18446744073709551615" { return 0 - 1 }
    parse_int(text)
}

fn un(fx: Fx, op: Str, a: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = " + op + " " + vn(a));
    v
}

fn overflows(k: Str, what: Str) -> Str { "this " + what + " overflows `" + k + "`" }

/// `x` and `y` stored to fresh slots, and a slot for the result: `[out, px, py]`.
fn wide_operands(fx: Fx, x: Int, y: Int) -> Ints {
    let out = scratch(fx, 16)
    let px = scratch(fx, 16)
    store(fx, px, 0, x);
    let mut py = px
    if y >= 0 {
        py = scratch(fx, 16)
        store(fx, py, 0, y);
    }
    ints_of3(out, px, py)
}

fn wide_divrem(fx: Fx, op: Str, x: Int, y: Int) -> Int {
    let w = wide_operands(fx, x, y)
    let code = iconst(fx, if op == "sdiv" { 0 } else if op == "srem" { 1 } else if op == "udiv" { 2 } else { 3 })
    rt(fx, "nz.i128_divrem", ints_of4(ints_get(w, 0), ints_get(w, 1), ints_get(w, 2), code))
    load(fx, "i128", ints_get(w, 0), 0)
}

/// `x * y` at 128 bits, wrapped, and whether the exact product overflowed: `[product, over]`.
fn wide_mul(fx: Fx, k: Str, x: Int, y: Int) -> Ints {
    let w = wide_operands(fx, x, y)
    let signed = iconst(fx, if is_signed(k) { 1 } else { 0 })
    let flag = rt_v(fx, "nz.i128_mul", ints_of4(ints_get(w, 0), ints_get(w, 1), ints_get(w, 2), signed), "i32")
    let over = cmp_imm(fx, "ne", flag, "i32", 0)
    let p = load(fx, "i128", ints_get(w, 0), 0)
    ints_of2(p, over)
}

fn num_neg(fx: Fx, k: Str, x: Int) -> Int {
    if is_float(k) { return un(fx, "fneg", x) }
    let z = iconst_c(fx, mclass(k), 0)
    checked(fx, if is_signed(k) { "sub.ovf" } else { "usub.ovf" }, z, x, overflows(k, "negation"))
}

fn num_arith(fx: Fx, op: Str, k: Str, x: Int, y: Int) -> Int {
    let c = mclass(k)
    if is_float(k) {
        if op == "+" { return bin(fx, "fadd", x, y) }
        if op == "-" { return bin(fx, "fsub", x, y) }
        if op == "*" { return bin(fx, "fmul", x, y) }
        if op == "/" { return bin(fx, "fdiv", x, y) }
        return rt_v(fx, if c == "f32" { "fmodf" } else { "fmod" }, ints_of2(x, y), c)
    }
    let signed = is_signed(k)
    if op == "+" { return checked(fx, if signed { "add.ovf" } else { "uadd.ovf" }, x, y, overflows(k, "addition")) }
    if op == "-" { return checked(fx, if signed { "sub.ovf" } else { "usub.ovf" }, x, y, overflows(k, "subtraction")) }
    if op == "*" {
        if c == "i128" {
            let pm = wide_mul(fx, k, x, y)
            guard(fx, ints_get(pm, 1), "N0400", overflows(k, "multiplication"));
            return ints_get(pm, 0)
        }
        return checked(fx, if signed { "mul.ovf" } else { "umul.ovf" }, x, y, overflows(k, "multiplication"))
    }
    let zero = cmp_imm(fx, "eq", y, c, 0)
    guard(fx, zero, "N0401", "division by zero");
    if !signed {
        let o = if op == "/" { "udiv" } else { "urem" }
        return if c == "i128" { wide_divrem(fx, o, x, y) } else { bin(fx, o, x, y) }
    }
    let min = bound(fx, c, kind_lo(k))
    let is_min = cmp(fx, "eq", x, min)
    let is_m1 = cmp_imm(fx, "eq", y, c, 0 - 1)
    let special = bin(fx, "and", is_min, is_m1)
    if op == "/" {
        guard(fx, special, "N0400", overflows(k, "division"));
        return if c == "i128" { wide_divrem(fx, "sdiv", x, y) } else { bin(fx, "sdiv", x, y) }
    }
    // `MIN % -1` is 0: divided by 1 instead, which the machine does not fault on.
    let one = iconst_c(fx, c, 1)
    let divisor = select(fx, special, one, y)
    if c == "i128" { wide_divrem(fx, "srem", x, divisor) } else { bin(fx, "srem", x, divisor) }
}

/// A shift or rotation amount checked against `0..bits` (a rotation only `>= 0`), in the
/// operand's class.
fn amount(fx: Fx, k: Str, n: Int, rotation: Bool) -> Int {
    let c = mclass(k)
    let w = kind_bits(k)
    let bad = if rotation { cmp_imm(fx, "lt", n, "i64", 0) } else { cmp_imm(fx, "uge", n, "i64", w) }
    guard(fx, bad, "N0412", "this shift amount is outside `0.." + int_to_str(w) + "`");
    let mut m = n
    if rotation {
        let mask = iconst(fx, w - 1)
        m = bin(fx, "and", n, mask)
    }
    if c == "i64" { return m }
    if c == "i128" { return ext(fx, c, m, false) }
    trunc(fx, c, m)
}

fn num_bits(fx: Fx, op: Str, k: Str, x: Int, y: Int) -> Int {
    if op == "&" { return bin(fx, "and", x, y) }
    if op == "|" { return bin(fx, "or", x, y) }
    if op == "^" { return bin(fx, "xor", x, y) }
    let n = amount(fx, k, y, false)
    if op == "<<" { return bin(fx, "shl", x, n) }
    bin(fx, if is_signed(k) { "ashr" } else { "lshr" }, x, n)
}

fn num_compare(fx: Fx, op: Str, k: Str, x: Int, y: Int) -> Int {
    let base = if op == "==" { "eq" } else if op == "!=" { "ne" } else if op == "<" { "lt" } else if op == "<=" { "le" } else if op == ">" { "gt" } else { "ge" }
    if is_float(k) { return cmp(fx, "f" + base, x, y) }
    if is_signed(k) || base == "eq" || base == "ne" { return cmp(fx, base, x, y) }
    cmp(fx, "u" + base, x, y)
}

fn widen(fx: Fx, from: Str, x: Int) -> Int {
    if mclass(from) == "i64" { x } else { ext(fx, "i64", x, is_signed(from)) }
}

fn resize(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    let fc = mclass(from)
    let tc = mclass(to)
    if fc == tc { return x }
    if kind_bits(from) > kind_bits(to) { return trunc(fx, tc, x) }
    ext(fx, tc, x, is_signed(from))
}

fn widen_wide(fx: Fx, from: Str, x: Int) -> Int {
    if mclass(from) == "i128" { x } else { ext(fx, "i128", x, is_signed(from)) }
}

fn wide_fits(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    if from == "UInt128" {
        if to == "UInt128" { return bit(fx, true) }
        let max = bound(fx, "i128", kind_hi(to))
        return cmp(fx, "ule", x, max)
    }
    let w = widen_wide(fx, from, x)
    let zero = iconst_c(fx, "i128", 0)
    if to == "UInt128" { return cmp(fx, "ge", w, zero) }
    let min = bound(fx, "i128", kind_lo(to))
    let max = bound(fx, "i128", kind_hi(to))
    let above = cmp(fx, "ge", w, min)
    let below = cmp(fx, "le", w, max)
    bin(fx, "and", above, below)
}

fn wide_saturate(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    let tc = mclass(to)
    if from == "UInt128" {
        if to == "UInt128" { return x }
        let max = bound(fx, "i128", kind_hi(to))
        let over = cmp(fx, "ugt", x, max)
        let clamped = select(fx, over, max, x)
        return resize(fx, "UInt128", to, clamped)
    }
    let w = widen_wide(fx, from, x)
    let zero = iconst_c(fx, "i128", 0)
    if to == "UInt128" {
        let neg = cmp(fx, "lt", w, zero)
        return select(fx, neg, zero, w)
    }
    let min = bound(fx, "i128", kind_lo(to))
    let max = bound(fx, "i128", kind_hi(to))
    let under = cmp(fx, "lt", w, min)
    let over = cmp(fx, "gt", w, max)
    let a = select(fx, under, min, w)
    let b = select(fx, over, max, a)
    if tc == "i128" { b } else { trunc(fx, tc, b) }
}

fn int_fits(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    if kind_bits(from) == 128 || kind_bits(to) == 128 { return wide_fits(fx, from, to, x) }
    let lo64 = bound64(kind_lo(to))
    let hi64 = bound64(kind_hi(to))
    if from == "UInt64" {
        if to == "UInt64" { return bit(fx, true) }
        return cmp_imm(fx, "ule", x, "i64", hi64)
    }
    let w = widen(fx, from, x)
    if to == "UInt64" { return cmp_imm(fx, "ge", w, "i64", 0) }
    let above = cmp_imm(fx, "ge", w, "i64", lo64)
    let below = cmp_imm(fx, "le", w, "i64", hi64)
    bin(fx, "and", above, below)
}

fn as_f64(fx: Fx, from: Str, x: Int) -> Int { if from == "Float32" { conv(fx, "fext", "f64", x) } else { x } }

/// Whether float `x` truncates to a value of integer kind `to`: finite, and inside the bounds,
/// which are powers of two and so compared exactly in `f64`.
fn float_fits(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    let d = as_f64(fx, from, x)
    let w = kind_bits(to)
    let signed = is_signed(to)
    // A signed lower bound is inclusive at 64 bits and wider, and exclusive of `MIN - 1` below.
    let lo = if signed && w < 64 {
        iconst_c(fx, "f64", f64_bits_int(0 - pow2i(w - 1) - 1))
    } else if signed {
        iconst_c(fx, "f64", f64_bits_pow2(w - 1, true))
    } else {
        iconst_c(fx, "f64", f64_bits_int(0 - 1))
    }
    let hi = iconst_c(fx, "f64", f64_bits_pow2(if signed { w - 1 } else { w }, false))
    let above = if signed && w >= 64 { cmp(fx, "fge", d, lo) } else { cmp(fx, "fgt", d, lo) }
    let below = cmp(fx, "flt", d, hi)
    bin(fx, "and", above, below)
}

fn num_fits(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    if is_float(to) { return bit(fx, true) }
    if is_float(from) { return float_fits(fx, from, to, x) }
    int_fits(fx, from, to, x)
}

fn float_to_int(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    if mclass(to) == "i128" {
        let d = as_f64(fx, from, x)
        let out = scratch(fx, 16)
        let signed = iconst(fx, if is_signed(to) { 1 } else { 0 })
        rt(fx, "nz.f64_to_i128", ints_of3(out, d, signed))
        return load(fx, "i128", out, 0)
    }
    conv(fx, if is_signed(to) { "ftos" } else { "ftou" }, mclass(to), x)
}

fn not_bit(fx: Fx, b: Int) -> Int {
    let t = bit(fx, true)
    bin(fx, "xor", b, t)
}

fn trunc_or_same(fx: Fx, c: Str, x: Int) -> Int { if c == "i64" { x } else { trunc(fx, c, x) } }

fn int_saturate(fx: Fx, from: Str, to: Str, x: Int) -> Int {
    if kind_bits(from) == 128 || kind_bits(to) == 128 { return wide_saturate(fx, from, to, x) }
    let lo64 = bound64(kind_lo(to))
    let hi64 = bound64(kind_hi(to))
    let tc = mclass(to)
    if from == "UInt64" {
        if to == "UInt64" { return x }
        let over = cmp_imm(fx, "ugt", x, "i64", hi64)
        let max = iconst_c(fx, tc, hi64)
        let low = trunc_or_same(fx, tc, x)
        return select(fx, over, max, low)
    }
    let w = widen(fx, from, x)
    if to == "UInt64" {
        let neg = cmp_imm(fx, "lt", w, "i64", 0)
        let zero = iconst(fx, 0)
        return select(fx, neg, zero, w)
    }
    let under = cmp_imm(fx, "lt", w, "i64", lo64)
    let over = cmp_imm(fx, "gt", w, "i64", hi64)
    let min = iconst(fx, lo64)
    let max = iconst(fx, hi64)
    let a = select(fx, under, min, w)
    let b = select(fx, over, max, a)
    trunc_or_same(fx, tc, b)
}

fn num_convert(fx: Fx, mode: Str, from: Str, to: Str, x: Int) -> Int {
    let tc = mclass(to)
    let ff = is_float(from)
    let tf = is_float(to)
    if !ff && tf {
        if mclass(from) == "i128" {
            // Rounded once, from the exact value, by the runtime (R1b, L13b).
            let w = wide_operands(fx, x, 0 - 1)
            let signed = iconst(fx, if is_signed(from) { 1 } else { 0 })
            return rt_v(fx, if tc == "f32" { "nz.i128_to_f32" } else { "nz.i128_to_f64" }, ints_of2(ints_get(w, 1), signed), tc)
        }
        return conv(fx, if is_signed(from) { "stof" } else { "utof" }, tc, x)
    }
    if ff && tf {
        if from == "Float32" && to == "Float64" { return conv(fx, "fext", tc, x) }
        if from == "Float64" && to == "Float32" { return conv(fx, "ftrunc", tc, x) }
        return x
    }
    if ff {
        if mode != "saturate" {
            let fits = float_fits(fx, from, to, x)
            let bad = not_bit(fx, fits)
            guard(fx, bad, "N0400", overflows(to, "conversion"));
        }
        return float_to_int(fx, from, to, x)
    }
    if mode == "wrap" { return resize(fx, from, to, x) }
    if mode == "saturate" { return int_saturate(fx, from, to, x) }
    let fits = int_fits(fx, from, to, x)
    let bad = not_bit(fx, fits)
    guard(fx, bad, "N0400", overflows(to, "conversion"));
    resize(fx, from, to, x)
}

fn saturating(fx: Fx, op: Str, k: Str, x: Int, y: Int) -> Int {
    let c = mclass(k)
    let min = bound(fx, c, kind_lo(k))
    let max = bound(fx, c, kind_hi(k))
    let signed = is_signed(k)
    let o = if op == "saturating_add" { "add" } else if op == "saturating_sub" { "sub" } else { "mul" }
    let ovf_op = (if signed { "" } else { "u" }) + o + ".ovf"
    let mut dst = 0
    let mut ovf = 0
    if c == "i128" && o == "mul" {
        let pm = wide_mul(fx, k, x, y)
        dst = ints_get(pm, 0)
        ovf = ints_get(pm, 1)
    } else {
        dst = value(fx.fb)
        ovf = value(fx.fb)
        emit(fx.fb, vn(dst) + ", " + vn(ovf) + " = " + ovf_op + " " + vn(x) + ", " + vn(y));
    }
    let mut which = 0
    if signed {
        let zero = iconst_c(fx, c, 0)
        let positive = if o == "add" { cmp(fx, "gt", y, zero) } else if o == "sub" { cmp(fx, "lt", y, zero) } else {
            let xn = cmp(fx, "lt", x, zero)
            let yn = cmp(fx, "lt", y, zero)
            let differ = bin(fx, "xor", xn, yn)
            not_bit(fx, differ)
        }
        which = select(fx, positive, max, min)
    } else {
        which = if o == "sub" { min } else { max }
    }
    select(fx, ovf, which, dst)
}

/// The libm entry for a float operation, `f`'s single-precision twin for a `Float32`.
fn libm(single: Bool, d: Str) -> Str { if single { d + "f" } else { d } }

/// A numeric built-in (Gate 2): `true` when `op` is one.
fn num_primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    let mut k = kind_of(elem)
    if k == "" && vec_len(args) > 0 { k = kind_of(operand_ty(fx, vec_get(args, 0))) }
    if k == "" { k = "Int" }
    let c = mclass(k)
    let single = c == "f32"
    if op == "wrapping_add" || op == "wrapping_sub" || op == "wrapping_mul" {
        let x = arg_value(fx, args, 0)
        let y = arg_value(fx, args, 1)
        set(fx, dst, bin(fx, if op == "wrapping_add" { "add" } else if op == "wrapping_sub" { "sub" } else { "mul" }, x, y));
        return true
    }
    if op == "saturating_add" || op == "saturating_sub" || op == "saturating_mul" {
        let x = arg_value(fx, args, 0)
        let y = arg_value(fx, args, 1)
        set(fx, dst, saturating(fx, op, k, x, y));
        return true
    }
    if op == "count_ones" || op == "leading_zeros" || op == "trailing_zeros" {
        let x = arg_value(fx, args, 0)
        let r = un(fx, if op == "count_ones" { "popcnt" } else if op == "leading_zeros" { "clz" } else { "ctz" }, x)
        set(fx, dst, if c == "i64" { r } else if c == "i128" { trunc(fx, "i64", r) } else { ext(fx, "i64", r, false) });
        return true
    }
    if op == "rotate_left" || op == "rotate_right" {
        let x = arg_value(fx, args, 0)
        let n0 = arg_value(fx, args, 1)
        let n = amount(fx, k, n0, true)
        set(fx, dst, bin(fx, if op == "rotate_left" { "rotl" } else { "rotr" }, x, n));
        return true
    }
    if op == "swap_bytes" || op == "to_big_endian" || op == "from_big_endian" {
        let x = arg_value(fx, args, 0)
        set(fx, dst, un(fx, "bswap", x));
        return true
    }
    if op == "to_little_endian" || op == "from_little_endian" {
        set(fx, dst, arg_value(fx, args, 0));
        return true
    }
    if op == "float_sqrt" || op == "float_abs" || op == "float_floor" || op == "float_ceil" || op == "float_trunc" {
        let x = arg_value(fx, args, 0)
        set(fx, dst, un(fx, "f" + str_slice(op, 6, str_len(op)), x));
        return true
    }
    if op == "float_round" || op == "float_sin" || op == "float_cos" || op == "float_tan" || op == "float_exp" || op == "float_ln" || op == "float_log2" || op == "float_log10" {
        let x = arg_value(fx, args, 0)
        let base = if op == "float_ln" { "log" } else { str_slice(op, 6, str_len(op)) }
        set(fx, dst, rt_v(fx, libm(single, base), ints_of(x), c));
        return true
    }
    if op == "float_pow" || op == "float_atan2" || op == "float_min" || op == "float_max" {
        let x = arg_value(fx, args, 0)
        let y = arg_value(fx, args, 1)
        let base = if op == "float_min" { "fmin" } else if op == "float_max" { "fmax" } else { str_slice(op, 6, str_len(op)) }
        set(fx, dst, rt_v(fx, libm(single, base), ints_of2(x, y), c));
        return true
    }
    if op == "float_is_nan" {
        let x = arg_value(fx, args, 0)
        set(fx, dst, cmp(fx, "fne", x, x));
        return true
    }
    if op == "float_is_infinite" || op == "float_is_finite" {
        let x = arg_value(fx, args, 0)
        let a = un(fx, "fabs", x)
        let inf = iconst_c(fx, c, if single { 2139095040 } else { 9218868437227405312 })
        set(fx, dst, cmp(fx, if op == "float_is_infinite" { "feq" } else { "flt" }, a, inf));
        return true
    }
    if op == "widening_mul" {
        let x0 = arg_value(fx, args, 0)
        let y0 = arg_value(fx, args, 1)
        let x = ext(fx, "i128", x0, false)
        let y = ext(fx, "i128", y0, false)
        set(fx, dst, bin(fx, "mul", x, y));
        return true
    }
    if op == "float64_to_bits" || op == "float32_to_bits" || op == "float64_from_bits" || op == "float32_from_bits" {
        let x = arg_value(fx, args, 0)
        let to = if op == "float64_to_bits" { "i64" } else if op == "float32_to_bits" { "i32" } else if op == "float64_from_bits" { "f64" } else { "f32" }
        set(fx, dst, conv(fx, "bits", to, x));
        return true
    }
    false
}

// --- numeric kinds ------------------------------------------------------------------------------

/// A type's numeric kind (`numeric::kind_of`): `Int` is the 64-bit signed kind; `""` for none.
fn kind_of(t: Str) -> Str {
    if t == "Int" { return "Int" }
    if is_num(t) { return t }
    ""
}

fn is_float(k: Str) -> Bool { k == "Float32" || k == "Float64" }

fn is_signed(k: Str) -> Bool {
    k == "Int" || k == "Int8" || k == "Int16" || k == "Int32" || k == "Int64" || k == "Int128" || is_float(k)
}

fn kind_bits(k: Str) -> Int {
    let c = mclass(k)
    if c == "i8" { return 8 }
    if c == "i16" { return 16 }
    if c == "i32" || c == "f32" { return 32 }
    if c == "i128" { return 128 }
    64
}

fn conv(fx: Fx, op: Str, to: Str, src: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = " + op + " " + to + " " + vn(src));
    v
}

/// A number of kind `k`'s text written at `buf`, which has 48 bytes: how many.
fn digits_into(fx: Fx, k: Str, x: Int, buf: Int) -> Int {
    if is_float(k) {
        let d = if k == "Float32" { conv(fx, "fext", "f64", x) } else { x }
        let single = bit(fx, k == "Float32")
        return rt_v(fx, "nz.format_float", ints_of3(buf, d, single), "i64")
    }
    if k == "UInt64" { return rt_v(fx, "nz.format_u64", ints_of2(buf, x), "i64") }
    if mclass(k) == "i128" {
        // By address (R1b, L13b): 39 digits and a sign fit the 48 bytes.
        let px = scratch(fx, 16)
        store(fx, px, 0, x);
        let signed = iconst(fx, if is_signed(k) { 1 } else { 0 })
        return rt_v(fx, "nz.format_i128", ints_of3(buf, px, signed), "i64")
    }
    let wide = if mclass(k) == "i64" { x } else { ext(fx, "i64", x, is_signed(k)) }
    rt_v(fx, "nz.format_int", ints_of2(buf, wide), "i64")
}

// --- text ---------------------------------------------------------------------------------------

fn str_owner(fx: Fx, s: Int) -> Int { load(fx, "ptr", s, 16) }

fn text_primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    if op == "num_to_str" {
        let k = if kind_of(elem) == "" { "Int" } else { kind_of(elem) }
        let x = arg_value(fx, args, 0)
        let room = iconst(fx, 48)
        let ob = string_backing(fx, room)
        let n = digits_into(fx, k, x, ints_get(ob, 1))
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    }
    if op == "str_concat_num" {
        // An interpolation's text then an integer (R1, 5b.9): one allocation, the digits
        // written after the text's bytes.
        let k = if kind_of(elem) == "" { "Int" } else { kind_of(elem) }
        let a = arg_place(fx, args, 0)
        let x = arg_value(fx, args, 1)
        let pa = str_parts(fx, a)
        let room = add_imm(fx, ints_get(pa, 1), 48)
        let ob = string_backing(fx, room)
        let buf = ints_get(ob, 1)
        rt(fx, "memcpy", ints_of3(buf, ints_get(pa, 0), ints_get(pa, 1)))
        let rest = ptr_add(fx, buf, ints_get(pa, 1))
        let d = digits_into(fx, k, x, rest)
        let n = bin(fx, "add", ints_get(pa, 1), d)
        write_str(fx, dst, buf, n, ints_get(ob, 0));
        return true
    }
    if op == "float_to_str_fixed" {
        let k = if kind_of(elem) == "" { "Float64" } else { kind_of(elem) }
        let x = arg_value(fx, args, 0)
        let digits = arg_value(fx, args, 1)
        let outside = cmp_imm(fx, "ugt", digits, "i64", 30)
        guard(fx, outside, "N0405", "a float is written with 0 to 30 decimals");
        let room = iconst(fx, 360)
        let ob = string_backing(fx, room)
        let d = if k == "Float32" { conv(fx, "fext", "f64", x) } else { x }
        let n = rt_v(fx, "nz.format_fixed", ints_of3(ints_get(ob, 1), d, digits), "i64")
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    }
    if op == "float_parses" || op == "float_parse_raw" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        let r = if op == "float_parses" {
            rt_v(fx, "nz.float_parses", ints_of2(ints_get(pn, 0), ints_get(pn, 1)), "bit")
        } else {
            rt_v(fx, "nz.float_parse", ints_of2(ints_get(pn, 0), ints_get(pn, 1)), "f64")
        }
        set(fx, dst, r);
        return true
    }
    if op == "str_vouch" {
        // Declassification is the checker's, and nothing at run time (N52).
        let s = arg_place(fx, args, 0)
        let d = addr(fx, dst)
        copy(fx, d, s, 24);
        retain_at(fx, d, "Str");
        return true
    }
    if op == "str_slice" {
        let s = arg_place(fx, args, 0)
        let from = arg_value(fx, args, 1)
        let to = arg_value(fx, args, 2)
        let pn = str_parts(fx, s)
        let neg = cmp_imm(fx, "lt", from, "i64", 0)
        let inverted = cmp(fx, "lt", to, from)
        let past = cmp(fx, "gt", to, ints_get(pn, 1))
        let a = bin(fx, "or", neg, inverted)
        let bad = bin(fx, "or", a, past)
        guard(fx, bad, "N0405", "this slice is not inside the `Str`");
        let start = ptr_add(fx, ints_get(pn, 0), from)
        let n = bin(fx, "sub", to, from)
        // The view keeps the allocation it was cut from alive: the same owner, retained.
        let owner = str_owner(fx, s)
        rt(fx, "nz.str_retain", ints_of(owner))
        write_str(fx, dst, start, n, owner);
        return true
    }
    if op == "str_append" {
        str_append(fx, dst, args);
        return true
    }
    if op == "str_pad_start" || op == "str_pad_end" {
        let s = arg_place(fx, args, 0)
        let ps = str_parts(fx, s)
        let ls = ints_get(ps, 1)
        let width = arg_value(fx, args, 1)
        let fill = arg_place(fx, args, 2)
        let pf = str_parts(fx, fill)
        let wrong = cmp_imm(fx, "ne", ints_get(pf, 1), "i64", 1)
        guard(fx, wrong, "N0405", "a padding's fill is one byte");
        let byte = load(fx, "i8", ints_get(pf, 0), 0)
        let wider = cmp(fx, "gt", width, ls)
        let n = select(fx, wider, width, ls)
        let pad = bin(fx, "sub", n, ls)
        let room = add_imm(fx, n, 1)
        let ob = string_backing(fx, room)
        let buf = ints_get(ob, 1)
        let mut fill_at = buf
        let mut text_at = buf
        if op == "str_pad_start" { text_at = ptr_add(fx, buf, pad) } else { fill_at = ptr_add(fx, buf, ls) }
        rt(fx, "memcpy", ints_of3(text_at, ints_get(ps, 0), ls))
        let i = new_var(fx.fb, "i64")
        let zero = iconst(fx, 0)
        set_var(fx, i, zero);
        let head = new_lblock(fx.fb)
        let body = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        jump(fx, head);
        switch_to(fx.fb, head);
        let iv = get_var(fx, i)
        let more = cmp(fx, "lt", iv, pad)
        branch(fx, more, body, done);
        switch_to(fx.fb, body);
        let iv2 = get_var(fx, i)
        let at_ = ptr_add(fx, fill_at, iv2)
        store(fx, at_, 0, byte);
        let step = add_imm(fx, iv2, 1)
        set_var(fx, i, step);
        jump(fx, head);
        switch_to(fx.fb, done);
        write_str(fx, dst, buf, n, ints_get(ob, 0));
        return true
    }
    if op == "read_file" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        let d = addr(fx, dst)
        rt(fx, "nz.read_file_to", ints_of3(d, ints_get(pn, 0), ints_get(pn, 1)))
        let got = load(fx, "ptr", d, 0)
        let bad = is_null(fx, got)
        guard(fx, bad, "N0407", "this file could not be read");
        return true
    }
    if op == "write_file" {
        let a = arg_place(fx, args, 0)
        let b = arg_place(fx, args, 1)
        let pp = str_parts(fx, a)
        let dp = str_parts(fx, b)
        let n = rt_v(fx, "nz.write_file", ints_of4(ints_get(pp, 0), ints_get(pp, 1), ints_get(dp, 0), ints_get(dp, 1)), "i64")
        let bad = cmp_imm(fx, "lt", n, "i64", 0)
        guard(fx, bad, "N0407", "this file could not be written");
        set(fx, dst, n);
        return true
    }
    if op == "file_exists" {
        let a = arg_place(fx, args, 0)
        let pp = str_parts(fx, a)
        let yes = rt_v(fx, "nz.file_exists", ints_of2(ints_get(pp, 0), ints_get(pp, 1)), "bit")
        set(fx, dst, yes);
        return true
    }
    false
}

/// `s = str_concat(s, t)` on a `let mut` (R1b, D2): in place where `s`'s storage is its own and
/// has room after `s`'s bytes; otherwise a copy into storage of twice the length.
fn str_append(fx: Fx, dst: Int, args: Vec[Operand]) {
    let a = arg_place(fx, args, 0)
    let b = arg_place(fx, args, 1)
    let pa = str_parts(fx, a)
    let owner = str_owner(fx, a)
    let pb = str_parts(fx, b)
    let la = ints_get(pa, 1)
    let lb = ints_get(pb, 1)
    let n = bin(fx, "add", la, lb)
    let alone_check = new_lblock(fx.fb)
    let room_check = new_lblock(fx.fb)
    let in_place = new_lblock(fx.fb)
    let copy_b = new_lblock(fx.fb)
    let done = new_lblock(fx.fb)
    let literal = is_null(fx, owner)
    branch(fx, literal, copy_b, alone_check);
    switch_to(fx.fb, alone_check);
    let count = load(fx, "i64", owner, 0)
    let alone = cmp_imm(fx, "eq", count, "i64", 1)
    branch(fx, alone, room_check, copy_b);
    switch_to(fx.fb, room_check);
    let cap = load(fx, "i64", owner, 8)
    let data = ptr_off(fx, owner, 16)
    let at_ = ptr_to_int(fx, ints_get(pa, 0))
    let base = ptr_to_int(fx, data)
    let start = bin(fx, "sub", at_, base)
    // Only storage an append made grows in place: its capacity carries the mark 2^62.
    let end = bin(fx, "add", start, n)
    let marked = add_imm(fx, end, 4611686018427387904)
    let fits = cmp(fx, "le", marked, cap)
    branch(fx, fits, in_place, copy_b);
    switch_to(fx.fb, in_place);
    let tail = ptr_add(fx, ints_get(pa, 0), la)
    rt(fx, "memcpy", ints_of3(tail, ints_get(pb, 0), lb))
    rt(fx, "nz.str_retain", ints_of(owner))
    write_str(fx, dst, ints_get(pa, 0), n, owner);
    jump(fx, done);
    switch_to(fx.fb, copy_b);
    let twice = bin(fx, "add", n, n)
    let small = cmp_imm(fx, "lt", twice, "i64", 16)
    let sixteen = iconst(fx, 16)
    let room = select(fx, small, sixteen, twice)
    let ob = string_backing(fx, room)
    let fresh = ints_get(ob, 0)
    let buf = ints_get(ob, 1)
    let growable = add_imm(fx, room, 4611686018427387904)
    store(fx, fresh, 8, growable);
    rt(fx, "memcpy", ints_of3(buf, ints_get(pa, 0), la))
    let rest = ptr_add(fx, buf, la)
    rt(fx, "memcpy", ints_of3(rest, ints_get(pb, 0), lb))
    write_str(fx, dst, buf, n, fresh);
    jump(fx, done);
    switch_to(fx.fb, done);
}

// --- the rest of the built-ins ------------------------------------------------------------------

fn misc_primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    if op == "contract_check" {
        // A contract clause (N87): its kind is the constant second argument.
        let cond = arg_value(fx, args, 0)
        let mut which = 0
        if vec_len(args) > 1 {
            match vec_get(args, 1) {
                Operand.Const(c: c) => match c {
                    MConst.Int(v: k) => { which = k },
                    _ => {},
                },
                _ => {},
            }
        }
        let f = bit(fx, false)
        let bad = cmp(fx, "eq", cond, f)
        if which == 0 {
            guard(fx, bad, "N0410", "this precondition does not hold");
        } else {
            guard(fx, bad, "N0411", "this postcondition does not hold");
        }
        set(fx, dst, iconst(fx, 0));
        return true
    }
    if op == "callback_address" {
        // An export's C entry as a function pointer (N85), named by the constant symbol.
        let mut name = ""
        if vec_len(args) > 0 {
            match vec_get(args, 0) {
                Operand.Const(c: c) => match c {
                    MConst.Str(bytes: b) => { name = b },
                    _ => {},
                },
                _ => {},
            }
        }
        if name == "" {
            defect(fx.lo, "a callback address with no symbol");
            return true
        }
        let mut target = 0 - 1
        for i in 0..vec_len(fx.lo.p.fns) { if target < 0 && vec_get(fx.lo.p.fns, i).export == name { target = i } }
        if target < 0 {
            defect(fx.lo, "`" + name + "` is not an export");
            return true
        }
        let g = vec_get(fx.lo.p.fns, target)
        let csig = c_sig(params_of(g), g.ret)
        let s = symbol(fx.lo, name, "import", "func", csig, sig_ret(csig), false)
        let a = addr_of(fx, s)
        set(fx, dst, ptr_to_int(fx, a));
        return true
    }
    if op == "c_errno" {
        set(fx, dst, rt_v(fx, "nz.errno_last", ints_new(), "i64"));
        return true
    }
    if op == "foreign_nonnull" {
        let a = arg_value(fx, args, 0)
        let null_ = cmp_imm(fx, "eq", a, "i64", 0)
        guard(fx, null_, "N0409", "a foreign function returned null where its declaration promised a value");
        set(fx, dst, a);
        return true
    }
    if op == "cstr_copy" {
        let raw = arg_value(fx, args, 0)
        let p = int_to_ptr(fx, raw)
        let n = rt_v(fx, "nz.cstr_len", ints_of(p), "i64")
        let room = add_imm(fx, n, 1)
        let ob = string_backing(fx, room)
        rt(fx, "memcpy", ints_of3(ints_get(ob, 1), p, n))
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    }
    if op == "time_now_ms" || op == "time_now_ns" || op == "time_wall_ns" || op == "watchdog_feed" {
        let name = if op == "watchdog_feed" { "nz.watchdog_feed" } else { "nz." + op }
        set(fx, dst, rt_v(fx, name, ints_new(), "i64"));
        return true
    }
    if op == "time_sleep_ms" {
        let ms = arg_value(fx, args, 0)
        set(fx, dst, rt_v(fx, "nz.time_sleep_ms", ints_of(ms), "i64"));
        return true
    }
    if op == "mmio_read8" || op == "mmio_read16" || op == "mmio_read32" || op == "mmio_read64" {
        let a = arg_value(fx, args, 0)
        set(fx, dst, rt_v(fx, "nz." + op, ints_of(a), "i64"));
        return true
    }
    if op == "mmio_write8" || op == "mmio_write16" || op == "mmio_write32" || op == "mmio_write64" {
        let a = arg_value(fx, args, 0)
        let v = arg_value(fx, args, 1)
        set(fx, dst, rt_v(fx, "nz." + op, ints_of2(a, v), "i64"));
        return true
    }
    false
}

// --- bytes and text (`bytes.rs`) ----------------------------------------------------------------

/// Stop with `N0405` unless `0 <= i` and `i + width <= len`.
fn within(fx: Fx, i: Int, width: Int, len: Int, what: Str) {
    let neg = cmp_imm(fx, "lt", i, "i64", 0)
    let last = add_imm(fx, len, 0 - width)
    let past = cmp(fx, "gt", i, last)
    let bad = bin(fx, "or", neg, past)
    guard(fx, bad, "N0405", what);
}

/// Stop with `N0405` unless `0 <= from <= to <= len`.
fn in_range(fx: Fx, from: Int, to: Int, len: Int, what: Str) {
    let neg = cmp_imm(fx, "lt", from, "i64", 0)
    let inverted = cmp(fx, "lt", to, from)
    let past = cmp(fx, "gt", to, len)
    let a = bin(fx, "or", neg, inverted)
    let bad = bin(fx, "or", a, past)
    guard(fx, bad, "N0405", what);
}

fn both(fx: Fx, a: Int, b: Int) -> Int {
    let no = bit(fx, false)
    select(fx, a, b, no)
}

/// Whether byte index `i` of `p[..len]` begins a scalar value or ends the text.
fn boundary(fx: Fx, p: Int, len: Int, i: Int) -> Int {
    let r = new_var(fx.fb, "bit")
    let end = cmp(fx, "eq", i, len)
    set_var(fx, r, end);
    let nonneg = cmp_imm(fx, "ge", i, "i64", 0)
    let below = cmp(fx, "lt", i, len)
    let inside = both(fx, nonneg, below)
    let look = new_lblock(fx.fb)
    let done = new_lblock(fx.fb)
    branch(fx, inside, look, done);
    switch_to(fx.fb, look);
    let at_ = ptr_add(fx, p, i)
    let byte = load(fx, "i8", at_, 0)
    let b = ext(fx, "i64", byte, false)
    let mask = iconst(fx, 192)
    let top = bin(fx, "and", b, mask)
    let lead = cmp_imm(fx, "ne", top, "i64", 128)
    set_var(fx, r, lead);
    jump(fx, done);
    switch_to(fx.fb, done);
    get_var(fx, r)
}

/// Whether `c` is a Unicode scalar value.
fn scalar_ok(fx: Fx, c: Int) -> Int {
    let nonneg = cmp_imm(fx, "ge", c, "i64", 0)
    let max = cmp_imm(fx, "le", c, "i64", 1114111)
    let inr = both(fx, nonneg, max)
    let lo = cmp_imm(fx, "ge", c, "i64", 55296)
    let hi = cmp_imm(fx, "le", c, "i64", 57343)
    let surrogate = both(fx, lo, hi)
    let yes = bit(fx, true)
    let no = bit(fx, false)
    let not_surrogate = select(fx, surrogate, no, yes)
    both(fx, inr, not_surrogate)
}

/// `dst` = the string at `s`, as one more reference to its bytes.
fn share(fx: Fx, dst: Int, s: Int) {
    let d = addr(fx, dst)
    copy(fx, d, s, 24);
    retain_at(fx, d, "Str");
}

/// `dst` = a new buffer holding a copy of `p[..len]`.
fn fresh_copy(fx: Fx, dst: Int, p: Int, len: Int) {
    let room = add_imm(fx, len, 1)
    let ob = string_backing(fx, room)
    rt(fx, "memcpy", ints_of3(ints_get(ob, 1), p, len))
    write_str(fx, dst, ints_get(ob, 1), len, ints_get(ob, 0));
}

fn bytes_text(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    if op == "bytes_new" {
        let n = arg_value(fx, args, 0)
        let neg = cmp_imm(fx, "lt", n, "i64", 0)
        guard(fx, neg, "N0405", "a buffer's length is never negative");
        let room = add_imm(fx, n, 1)
        let ob = string_backing(fx, room)
        rt(fx, "nz.mem_zero", ints_of2(ints_get(ob, 1), n))
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    }
    if op == "bytes_from_str" || op == "bytes_to_str" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        fresh_copy(fx, dst, ints_get(pn, 0), ints_get(pn, 1));
        return true
    }
    if op == "bytes_len" || op == "text_len" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        set(fx, dst, ints_get(pn, 1));
        return true
    }
    if op == "bytes_get" {
        let b = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let pn = str_parts(fx, b)
        within(fx, i, 1, ints_get(pn, 1), "this index is outside the `Bytes`");
        let at_ = ptr_add(fx, ints_get(pn, 0), i)
        set(fx, dst, load(fx, "i8", at_, 0));
        return true
    }
    if op == "bytes_set" {
        let b = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let v = arg_value(fx, args, 2)
        let pn = str_parts(fx, b)
        within(fx, i, 1, ints_get(pn, 1), "this index is outside the `Bytes`");
        let at_ = ptr_add(fx, ints_get(pn, 0), i)
        store(fx, at_, 0, v);
        set(fx, dst, iconst(fx, 0));
        return true
    }
    if op == "bytes_slice" {
        let b = arg_place(fx, args, 0)
        let from = arg_value(fx, args, 1)
        let to = arg_value(fx, args, 2)
        let pn = str_parts(fx, b)
        in_range(fx, from, to, ints_get(pn, 1), "this slice is not inside the `Bytes`");
        let start = ptr_add(fx, ints_get(pn, 0), from)
        let n = bin(fx, "sub", to, from)
        // The view keeps the buffer it was cut from alive: the same owner, retained.
        let owner = str_owner(fx, b)
        rt(fx, "nz.str_retain", ints_of(owner))
        write_str(fx, dst, start, n, owner);
        return true
    }
    if op == "bytes_copy" {
        let d = arg_place(fx, args, 0)
        let s = arg_place(fx, args, 1)
        let pd = str_parts(fx, d)
        let ps = str_parts(fx, s)
        let longer = cmp(fx, "gt", ints_get(ps, 1), ints_get(pd, 1))
        guard(fx, longer, "N0405", "the source is longer than the destination");
        // Two views of one buffer may overlap: a move, not a copy.
        rt(fx, "nz.mem_move", ints_of3(ints_get(pd, 0), ints_get(ps, 0), ints_get(ps, 1)))
        set(fx, dst, ints_get(ps, 1));
        return true
    }
    if op == "bytes_read_le" || op == "bytes_read_be" {
        let k = num_kind(elem)
        let w = kind_bits(k) / 8
        let b = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let pn = str_parts(fx, b)
        within(fx, i, w, ints_get(pn, 1), "this read is outside the `Bytes`");
        let base = ptr_add(fx, ints_get(pn, 0), i)
        // Assembled in a word, or in 128 bits for a 128-bit integer (R1b, L13b).
        let ac = if mclass(k) == "i128" { "i128" } else { "i64" }
        let mut acc = iconst_c(fx, ac, 0)
        for j in 0..w {
            let byte = load(fx, "i8", base, j)
            let mut wide = ext(fx, ac, byte, false)
            let shift = (if op == "bytes_read_le" { j } else { w - 1 - j }) * 8
            if shift > 0 {
                let s = iconst_c(fx, ac, shift)
                wide = bin(fx, "shl", wide, s)
            }
            acc = bin(fx, "or", acc, wide)
        }
        let v = if k == "Float64" { conv(fx, "bits", "f64", acc) } else if k == "Float32" {
            let narrow = trunc(fx, "i32", acc)
            conv(fx, "bits", "f32", narrow)
        } else if mclass(k) == ac { acc } else { trunc(fx, mclass(k), acc) }
        set(fx, dst, v);
        return true
    }
    if op == "bytes_write_le" || op == "bytes_write_be" {
        let k = num_kind(elem)
        let w = kind_bits(k) / 8
        let b = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let v = arg_value(fx, args, 2)
        let pn = str_parts(fx, b)
        within(fx, i, w, ints_get(pn, 1), "this write is outside the `Bytes`");
        let bits = if k == "Float64" { conv(fx, "bits", "i64", v) } else if k == "Float32" {
            let narrow = conv(fx, "bits", "i32", v)
            ext(fx, "i64", narrow, false)
        } else if mclass(k) == "i64" || mclass(k) == "i128" { v } else { ext(fx, "i64", v, false) }
        let ac = if mclass(k) == "i128" { "i128" } else { "i64" }
        let base = ptr_add(fx, ints_get(pn, 0), i)
        for j in 0..w {
            let shift = (if op == "bytes_write_le" { j } else { w - 1 - j }) * 8
            let part = if shift > 0 {
                let s = iconst_c(fx, ac, shift)
                bin(fx, "lshr", bits, s)
            } else { bits }
            let byte = trunc(fx, "i8", part)
            store(fx, base, j, byte);
        }
        set(fx, dst, iconst(fx, 0));
        return true
    }
    if op == "utf8_valid" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        set(fx, dst, rt_v(fx, "nz.utf8_valid", ints_of2(ints_get(pn, 0), ints_get(pn, 1)), "bit"));
        return true
    }
    if op == "text_from_str" {
        let s = arg_place(fx, args, 0)
        let pn = str_parts(fx, s)
        let ok = rt_v(fx, "nz.utf8_valid", ints_of2(ints_get(pn, 0), ints_get(pn, 1)), "bit")
        let bad = cmp_imm(fx, "eq", ok, "bit", 0)
        guard(fx, bad, "N0413", "this is not UTF-8");
        share(fx, dst, s);
        return true
    }
    if op == "text_assume" || op == "text_as_str" {
        let s = arg_place(fx, args, 0)
        share(fx, dst, s);
        return true
    }
    if op == "text_concat" {
        primitive(fx, dst, "str_concat", elem, args);
        return true
    }
    if op == "text_is_boundary" {
        let t = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let pn = str_parts(fx, t)
        set(fx, dst, boundary(fx, ints_get(pn, 0), ints_get(pn, 1), i));
        return true
    }
    if op == "text_slice" {
        let t = arg_place(fx, args, 0)
        let from = arg_value(fx, args, 1)
        let to = arg_value(fx, args, 2)
        let pn = str_parts(fx, t)
        in_range(fx, from, to, ints_get(pn, 1), "this slice is not inside the `Text`");
        let a = boundary(fx, ints_get(pn, 0), ints_get(pn, 1), from)
        let z = boundary(fx, ints_get(pn, 0), ints_get(pn, 1), to)
        let both_ = both(fx, a, z)
        let bad = cmp_imm(fx, "eq", both_, "bit", 0)
        guard(fx, bad, "N0413", "this is not UTF-8");
        primitive(fx, dst, "str_slice", elem, args);
        return true
    }
    if op == "text_scalar_at" || op == "text_next" {
        let t = arg_place(fx, args, 0)
        let i = arg_value(fx, args, 1)
        let pn = str_parts(fx, t)
        let p = ints_get(pn, 0)
        let len = ints_get(pn, 1)
        within(fx, i, 1, len, "this index is outside the `Text`");
        let at_ = boundary(fx, p, len, i)
        let bad = cmp_imm(fx, "eq", at_, "bit", 0)
        guard(fx, bad, "N0413", "this is not UTF-8");
        if op == "text_scalar_at" {
            set(fx, dst, rt_v(fx, "nz.utf8_decode", ints_of3(p, len, i), "i64"));
        } else {
            let lead = ptr_add(fx, p, i)
            let byte = load(fx, "i8", lead, 0)
            let b = ext(fx, "i64", byte, false)
            let one = iconst(fx, 1)
            let two = iconst(fx, 2)
            let three = iconst(fx, 3)
            let four = iconst(fx, 4)
            let below_f0 = cmp_imm(fx, "lt", b, "i64", 240)
            let w3 = select(fx, below_f0, three, four)
            let below_e0 = cmp_imm(fx, "lt", b, "i64", 224)
            let w2 = select(fx, below_e0, two, w3)
            let ascii = cmp_imm(fx, "lt", b, "i64", 128)
            let w = select(fx, ascii, one, w2)
            set(fx, dst, bin(fx, "add", i, w));
        }
        return true
    }
    if op == "text_scalar_count" {
        let t = arg_place(fx, args, 0)
        let pn = str_parts(fx, t)
        set(fx, dst, rt_v(fx, "nz.utf8_count", ints_of2(ints_get(pn, 0), ints_get(pn, 1)), "i64"));
        return true
    }
    if op == "scalar_valid" {
        let c = arg_value(fx, args, 0)
        set(fx, dst, scalar_ok(fx, c));
        return true
    }
    if op == "scalar_text" {
        let c = arg_value(fx, args, 0)
        let ok = scalar_ok(fx, c)
        let bad = cmp_imm(fx, "eq", ok, "bit", 0)
        guard(fx, bad, "N0413", "this is not a Unicode scalar value");
        let room = iconst(fx, 5)
        let ob = string_backing(fx, room)
        let n = rt_v(fx, "nz.utf8_encode", ints_of2(ints_get(ob, 1), c), "i64")
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    }
    false
}

// --- files and handles (`files.rs`) -------------------------------------------------------------

/// A path's (or buffer's) pointer and length, from argument `i`.
fn parts_of(fx: Fx, args: Vec[Operand], i: Int) -> Ints {
    let p = arg_place(fx, args, i)
    str_parts(fx, p)
}

fn files(fx: Fx, dst: Int, op: Str, args: Vec[Operand]) -> Bool {
    let mut v = 0 - 1
    if op == "os_open_read" || op == "os_dir_open" {
        let pp = parts_of(fx, args, 0)
        v = rt_v(fx, "nz." + op, pp, "i64")
    } else if op == "os_open_write" {
        let p = arg_place(fx, args, 0)
        let mode = arg_value(fx, args, 1)
        let pp = str_parts(fx, p)
        v = rt_v(fx, "nz.os_open_write", ints_of3(ints_get(pp, 0), ints_get(pp, 1), mode), "i64")
    } else if op == "os_stdin" || op == "os_family" || op == "os_env_count" || op == "os_pid" {
        v = rt_v(fx, "nz." + op, ints_new(), "i64")
    } else if op == "os_status" || op == "os_sync" || op == "os_close" || op == "os_tcp_accept" || op == "os_wait" || op == "os_kill" || op == "os_child_pid" || op == "os_try_wait" || op == "os_child_rusage" {
        let h = arg_value(fx, args, 0)
        v = rt_v(fx, "nz." + op, ints_of(h), "i64")
    } else if op == "os_unlock" {
        let h = arg_value(fx, args, 0)
        v = rt_v(fx, "nz.os_file_unlock", ints_of(h), "i64")
    } else if op == "os_read" || op == "os_read_line" || op == "os_write" || op == "os_dir_next" {
        let h = arg_value(fx, args, 0)
        let bp = parts_of(fx, args, 1)
        v = rt_v(fx, "nz." + op, ints_of3(h, ints_get(bp, 0), ints_get(bp, 1)), "i64")
    } else if op == "os_seek" {
        let h = arg_value(fx, args, 0)
        let offset = arg_value(fx, args, 1)
        let whence = arg_value(fx, args, 2)
        v = rt_v(fx, "nz.os_seek", ints_of3(h, offset, whence), "i64")
    } else if op == "os_stat" || op == "os_lstat" {
        let p = arg_place(fx, args, 0)
        let b = arg_place(fx, args, 1)
        let pp = str_parts(fx, p)
        let bp = str_parts(fx, b)
        let short = cmp_imm(fx, "lt", ints_get(bp, 1), "i64", if op == "os_stat" { 32 } else { 48 })
        guard(fx, short, "N0405", "this buffer is too short for the answer");
        v = rt_v(fx, "nz." + op, ints_of3(ints_get(pp, 0), ints_get(pp, 1), ints_get(bp, 0)), "i64")
    } else if op == "os_mkdir" || op == "os_rmdir" || op == "os_unlink" {
        let pp = parts_of(fx, args, 0)
        let which = iconst(fx, if op == "os_mkdir" { 0 } else if op == "os_rmdir" { 1 } else { 2 })
        v = rt_v(fx, "nz.os_path_op", ints_of3(ints_get(pp, 0), ints_get(pp, 1), which), "i64")
    } else if op == "os_rename" || op == "os_realpath" {
        let a = arg_place(fx, args, 0)
        let b = arg_place(fx, args, 1)
        let ap = str_parts(fx, a)
        let bp = str_parts(fx, b)
        v = rt_v(fx, "nz." + op, ints_of4(ints_get(ap, 0), ints_get(ap, 1), ints_get(bp, 0), ints_get(bp, 1)), "i64")
    } else if op == "os_error_text" {
        let status = arg_value(fx, args, 0)
        let room = iconst(fx, 256)
        let ob = string_backing(fx, room)
        let n = rt_v(fx, "nz.os_error_text", ints_of3(status, ints_get(ob, 1), room), "i64")
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    } else if op == "os_tcp_listen" || op == "os_udp_bind" {
        let ap = parts_of(fx, args, 0)
        v = rt_v(fx, "nz." + op, ap, "i64")
    } else if op == "os_tcp_connect" {
        let a = arg_place(fx, args, 0)
        let ms = arg_value(fx, args, 1)
        let ap = str_parts(fx, a)
        v = rt_v(fx, "nz.os_tcp_connect", ints_of3(ints_get(ap, 0), ints_get(ap, 1), ms), "i64")
    } else if op == "os_set_timeout" || op == "os_shutdown" || op == "os_child_pipe" || op == "os_kill_group" || op == "os_wait_until" {
        let h = arg_value(fx, args, 0)
        let k = arg_value(fx, args, 1)
        v = rt_v(fx, "nz." + op, ints_of2(h, k), "i64")
    } else if op == "os_udp_send_to" || op == "os_udp_recv_from" {
        let h = arg_value(fx, args, 0)
        let d = arg_place(fx, args, 1)
        let a = arg_place(fx, args, 2)
        let dp = str_parts(fx, d)
        let ap = str_parts(fx, a)
        let xs = ints_of3(h, ints_get(dp, 0), ints_get(dp, 1))
        ints_push(xs, ints_get(ap, 0))
        ints_push(xs, ints_get(ap, 1))
        v = rt_v(fx, "nz." + op, xs, "i64")
    } else if op == "os_resolve" {
        let name = arg_place(fx, args, 0)
        let port = arg_value(fx, args, 1)
        let out = arg_place(fx, args, 2)
        let np = str_parts(fx, name)
        let op_ = str_parts(fx, out)
        let xs = ints_of3(ints_get(np, 0), ints_get(np, 1), port)
        ints_push(xs, ints_get(op_, 0))
        ints_push(xs, ints_get(op_, 1))
        v = rt_v(fx, "nz.os_resolve", xs, "i64")
    } else if op == "os_tls_client_config" {
        // TLS (C1): an id is a word, every buffer a `Bytes`'s pointer and length.
        let ca = arg_place(fx, args, 0)
        let alpn = arg_place(fx, args, 1)
        let cp = str_parts(fx, ca)
        let ap = str_parts(fx, alpn)
        v = rt_v(fx, "nz.os_tls_client_config", ints_of4(ints_get(cp, 0), ints_get(cp, 1), ints_get(ap, 0), ints_get(ap, 1)), "i64")
    } else if op == "os_tls_server_config" {
        let cert = arg_place(fx, args, 0)
        let key = arg_place(fx, args, 1)
        let alpn = arg_place(fx, args, 2)
        let cp = str_parts(fx, cert)
        let kp = str_parts(fx, key)
        let ap = str_parts(fx, alpn)
        let xs = ints_of4(ints_get(cp, 0), ints_get(cp, 1), ints_get(kp, 0), ints_get(kp, 1))
        ints_push(xs, ints_get(ap, 0))
        ints_push(xs, ints_get(ap, 1))
        v = rt_v(fx, "nz.os_tls_server_config", xs, "i64")
    } else if op == "os_tls_connect" {
        let config = arg_value(fx, args, 0)
        let host = arg_place(fx, args, 1)
        let hp = str_parts(fx, host)
        v = rt_v(fx, "nz.os_tls_connect", ints_of3(config, ints_get(hp, 0), ints_get(hp, 1)), "i64")
    } else if op == "os_tls_accept" || op == "os_tls_handshake" {
        let id = arg_value(fx, args, 0)
        v = rt_v(fx, "nz." + op, ints_of(id), "i64")
    } else if op == "os_tls_push" || op == "os_tls_pull" || op == "os_tls_read" || op == "os_tls_write" || op == "os_tls_close" {
        let id = arg_value(fx, args, 0)
        let b = arg_place(fx, args, 1)
        let bp = str_parts(fx, b)
        v = rt_v(fx, "nz." + op, ints_of3(id, ints_get(bp, 0), ints_get(bp, 1)), "i64")
    } else if op == "os_tls_info" {
        let id = arg_value(fx, args, 0)
        let what = arg_value(fx, args, 1)
        let out = arg_place(fx, args, 2)
        let op_ = str_parts(fx, out)
        v = rt_v(fx, "nz.os_tls_info", ints_of4(id, what, ints_get(op_, 0), ints_get(op_, 1)), "i64")
    } else if op == "os_local_addr" || op == "os_peer_addr" {
        let h = arg_value(fx, args, 0)
        let peer = iconst(fx, if op == "os_peer_addr" { 1 } else { 0 })
        let room = iconst(fx, 80)
        let ob = string_backing(fx, room)
        let n = rt_v(fx, "nz.os_net_addr", ints_of4(h, peer, ints_get(ob, 1), room), "i64")
        write_str(fx, dst, ints_get(ob, 1), n, ints_get(ob, 0));
        return true
    } else if op == "os_env_get" || op == "os_env_has" {
        let name = arg_place(fx, args, 0)
        let np = str_parts(fx, name)
        let lenp = scratch(fx, 8)
        let p = rt_v(fx, "nz.os_env_find", ints_of3(ints_get(np, 0), ints_get(np, 1), lenp), "ptr")
        let len = load(fx, "i64", lenp, 0)
        if op == "os_env_has" {
            v = cmp_imm(fx, "ge", len, "i64", 0)
        } else {
            let zero = iconst(fx, 0)
            let absent = cmp_imm(fx, "lt", len, "i64", 0)
            let n = select(fx, absent, zero, len)
            fresh_copy(fx, dst, p, n);
            return true
        }
    } else if op == "os_random_bytes" {
        let bp = parts_of(fx, args, 0)
        v = rt_v(fx, "nz.os_random_bytes", bp, "i64")
    } else if op == "os_env_at" {
        let i = arg_value(fx, args, 0)
        let count = rt_v(fx, "nz.os_env_count", ints_new(), "i64")
        within(fx, i, 1, count, "this index is outside the environment");
        let lenp = scratch(fx, 8)
        let p = rt_v(fx, "nz.os_env_at", ints_of2(i, lenp), "ptr")
        let len = load(fx, "i64", lenp, 0)
        fresh_copy(fx, dst, p, len);
        return true
    } else if op == "os_spawn" {
        let prog = arg_place(fx, args, 0)
        let list = arg_value(fx, args, 1)
        let pp = str_parts(fx, prog)
        v = rt_v(fx, "nz.os_spawn", ints_of3(ints_get(pp, 0), ints_get(pp, 1), list), "i64")
    } else if op == "os_stdout" || op == "os_stderr" {
        let which = iconst(fx, if op == "os_stdout" { 1 } else { 2 })
        v = rt_v(fx, "nz.os_std_stream", ints_of(which), "i64")
    } else if op == "os_spawn_in" || op == "os_spawn_with" {
        let prog = arg_place(fx, args, 0)
        let list = arg_value(fx, args, 1)
        let dir = arg_place(fx, args, 2)
        let env = arg_value(fx, args, 3)
        let flags = if op == "os_spawn_with" { arg_value(fx, args, 4) } else { iconst(fx, 0) }
        let pp = str_parts(fx, prog)
        let dp = str_parts(fx, dir)
        let xs = ints_of4(ints_get(pp, 0), ints_get(pp, 1), list, ints_get(dp, 0))
        ints_push(xs, ints_get(dp, 1))
        ints_push(xs, env)
        ints_push(xs, flags)
        v = rt_v(fx, "nz.os_spawn_in", xs, "i64")
    } else if op == "os_chmod" {
        let p = arg_place(fx, args, 0)
        let mode = arg_value(fx, args, 1)
        let pp = str_parts(fx, p)
        v = rt_v(fx, "nz.os_chmod", ints_of3(ints_get(pp, 0), ints_get(pp, 1), mode), "i64")
    } else if op == "os_mkdtemp" {
        let pp = parts_of(fx, args, 0)
        let extra = iconst(fx, 18)
        let room = bin(fx, "add", ints_get(pp, 1), extra)
        let ob = string_backing(fx, room)
        let n = rt_v(fx, "nz.os_mkdtemp", ints_of4(ints_get(pp, 0), ints_get(pp, 1), ints_get(ob, 1), room), "i64")
        let zero = iconst(fx, 0)
        let failed = cmp_imm(fx, "lt", n, "i64", 0)
        let len = select(fx, failed, zero, n)
        write_str(fx, dst, ints_get(ob, 1), len, ints_get(ob, 0));
        return true
    } else if op == "os_lock" || op == "os_try_lock" {
        let h = arg_value(fx, args, 0)
        let exclusive = arg_value(fx, args, 1)
        let wait = iconst(fx, if op == "os_lock" { 1 } else { 0 })
        v = rt_v(fx, "nz.os_file_lock", ints_of3(h, exclusive, wait), "i64")
    } else {
        return false
    }
    set(fx, dst, v);
    true
}

// --- atomics (`atomics.rs`) ---------------------------------------------------------------------

fn atomics(fx: Fx, dst: Int, op: Str, args: Vec[Operand]) -> Bool {
    if op == "atomic_new" {
        // The runtime initialises the cell, in a backing a string's release frees without
        // counting it: an atomic is not a string (runtime ABI 38).
        let v = arg_value(fx, args, 0)
        let owner = rt_v(fx, "nz.atomic_cell", ints_of(v), "ptr")
        let none = is_null(fx, owner)
        guard(fx, none, "N0406", "out of memory");
        let cell = ptr_off(fx, owner, 16)
        let eight = iconst(fx, 8)
        write_str(fx, dst, cell, eight, owner);
        return true
    }
    if op == "atomic_load" {
        let cell = ints_get(parts_of(fx, args, 0), 0)
        set(fx, dst, rt_v(fx, "nz.atomic_load", ints_of(cell), "i64"));
        return true
    }
    if op == "atomic_store" {
        let cell = ints_get(parts_of(fx, args, 0), 0)
        let v = arg_value(fx, args, 1)
        rt(fx, "nz.atomic_store", ints_of2(cell, v))
        set(fx, dst, iconst(fx, 0));
        return true
    }
    if op == "atomic_swap" {
        let cell = ints_get(parts_of(fx, args, 0), 0)
        let v = arg_value(fx, args, 1)
        set(fx, dst, rt_v(fx, "nz.atomic_swap", ints_of2(cell, v), "i64"));
        return true
    }
    if op == "atomic_compare_swap" {
        let cell = ints_get(parts_of(fx, args, 0), 0)
        let expected = arg_value(fx, args, 1)
        let new = arg_value(fx, args, 2)
        set(fx, dst, rt_v(fx, "nz.atomic_cas", ints_of3(cell, expected, new), "bit"));
        return true
    }
    if op == "atomic_add" {
        // Read, add with the overflow check `+` has, and store only if nothing changed the
        // cell in between; otherwise again.
        let cell = ints_get(parts_of(fx, args, 0), 0)
        let d = arg_value(fx, args, 1)
        let again = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        jump(fx, again);
        switch_to(fx.fb, again);
        let old = rt_v(fx, "nz.atomic_load", ints_of(cell), "i64")
        let sum = checked(fx, "add.ovf", old, d, "this addition overflows `Int`")
        let stored = rt_v(fx, "nz.atomic_cas", ints_of3(cell, old, sum), "bit")
        branch(fx, stored, done, again);
        switch_to(fx.fb, done);
        set(fx, dst, old);
        return true
    }
    false
}

// --- channels -----------------------------------------------------------------------------------

fn chan_primitive(fx: Fx, dst: Int, op: Str, elem: Str, args: Vec[Operand]) -> Bool {
    if op == "chan_new" {
        let cap = arg_value(fx, args, 0)
        let bad = cmp_imm(fx, "lt", cap, "i64", 1)
        guard(fx, bad, "N0405", "a channel needs a capacity of at least 1");
        let c = rt_v(fx, "nz.chan_new", ints_of(cap), "ptr")
        let none = is_null(fx, c)
        guard(fx, none, "N0406", "out of memory");
        set(fx, dst, c);
        return true
    }
    if op == "chan_send" {
        let c = arg_value(fx, args, 0)
        let v = arg_value(fx, args, 1)
        set(fx, dst, rt_v(fx, "nz.chan_send", ints_of2(c, v), "bit"));
        return true
    }
    if op == "chan_recv" {
        let c = arg_value(fx, args, 0)
        let buf = arg_value(fx, args, 1)
        // The entry is shared and the position is not: this site's failure text.
        let m = message(fx.lo, "N0406", "out of memory", here(fx))
        let p = addr_of(fx, ints_get(m, 0))
        let len = iconst(fx, ints_get(m, 1))
        let ok = rt_v(fx, "nz.chan_recv", ints_of4(c, buf, p, len), "bit")
        check_failed(fx);
        set(fx, dst, ok);
        return true
    }
    if op == "chan_close" || op == "chan_close_of" {
        let c = arg_value(fx, args, 0)
        // The generic close also wakes a select (N54).
        rt(fx, if op == "chan_close" { "nz.chan_close" } else { "nz.chanv_close" }, ints_of(c))
        set(fx, dst, iconst(fx, 0));
        return true
    }
    if op == "chan_new_of" {
        let t = element(op, elem)
        let cap = arg_value(fx, args, 0)
        let bad = cmp_imm(fx, "lt", cap, "i64", 1)
        guard(fx, bad, "N0405", "a channel needs a capacity of at least 1");
        let stride = iconst(fx, size_of(fx, t))
        let release = if owns_ty(fx, t) { addr_of(fx, helper(fx.lo, "vel", t)) } else { null(fx) }
        let c = rt_v(fx, "nz.chanv_new", ints_of3(cap, stride, release), "ptr")
        let none = is_null(fx, c)
        guard(fx, none, "N0406", "out of memory");
        set(fx, dst, c);
        return true
    }
    if op == "chan_send_of" {
        let t = element(op, elem)
        let c = arg_value(fx, args, 0)
        let slot = scratch(fx, size_of(fx, t))
        // The channel's own reference, taken as the value goes into the slot.
        store_element(fx, slot, args, 1, t, false);
        let ok = rt_v(fx, "nz.chanv_send", ints_of2(c, slot), "bit")
        if owns_ty(fx, t) {
            let refused = new_lblock(fx.fb)
            let cont = new_lblock(fx.fb)
            branch(fx, ok, cont, refused);
            switch_to(fx.fb, refused);
            release_at(fx, slot, t);
            jump(fx, cont);
            switch_to(fx.fb, cont);
        }
        set(fx, dst, ok);
        return true
    }
    if op == "chan_recv_of" {
        let t = element(op, elem)
        let c = arg_value(fx, args, 0)
        let h = arg_value(fx, args, 1)
        let slot = scratch(fx, size_of(fx, t))
        let got = rt_v(fx, "nz.chanv_recv", ints_of2(c, slot), "bit")
        let take = new_lblock(fx.fb)
        let cont = new_lblock(fx.fb)
        branch(fx, got, take, cont);
        switch_to(fx.fb, take);
        push_moved(fx, h, slot, t);
        jump(fx, cont);
        switch_to(fx.fb, cont);
        set(fx, dst, got);
        return true
    }
    if op == "chan_select_of" || op == "chan_select_until" {
        // N54: at most one slot copied out, its reference moved onto the vector; `-3 - i` is
        // channel `i` closed and drained.
        let t = element(op, elem)
        let cs = arg_value(fx, args, 0)
        let h = arg_value(fx, args, 1)
        let mut ms = 0
        let mut timed = 0
        if op == "chan_select_until" {
            ms = arg_value(fx, args, 2)
            timed = iconst(fx, 1)
        } else {
            ms = iconst(fx, 0)
            timed = iconst(fx, 0)
        }
        let slot = scratch(fx, size_of(fx, t))
        let r = rt_v(fx, "nz.chanv_select", ints_of4(cs, slot, ms, timed), "i64")
        let oom = cmp_imm(fx, "eq", r, "i64", 0 - 9223372036854775807 - 1)
        guard(fx, oom, "N0406", "out of memory");
        let took = cmp_imm(fx, "ge", r, "i64", 0)
        let take = new_lblock(fx.fb)
        let cont = new_lblock(fx.fb)
        branch(fx, took, take, cont);
        switch_to(fx.fb, take);
        push_moved(fx, h, slot, t);
        jump(fx, cont);
        switch_to(fx.fb, cont);
        let shut = cmp_imm(fx, "le", r, "i64", 0 - 3)
        let minus3 = iconst(fx, 0 - 3)
        let index = bin(fx, "sub", minus3, r)
        set(fx, dst, select(fx, shut, index, r));
        return true
    }
    false
}

// --- records and enums --------------------------------------------------------------------------

/// The position of declaration index `d` in a canonical order.
fn position_of(order: Ints, d: Int) -> Int {
    for i in 0..ints_len(order) { if ints_get(order, i) == d { return i } }
    0
}

/// Field `d` (by declaration) of record `t`: `[offset, canonical position]`.
fn field_offset(fx: Fx, t: Str, d: Int) -> Ints {
    let lx = fx.lo.lx
    let pos = position_of(canonical_order(lx, def_node(lx, t)), d)
    let st = structure(lx, record_fields(lx, t))
    ints_of2(if pos < ints_len(st) - 2 { ints_get(st, pos) } else { 0 }, pos)
}

/// Variant `v`'s (by declaration) tag: its position in the enum's canonical order.
fn tag(fx: Fx, t: Str, v: Int) -> Int {
    position_of(enum_variants(fx.lo.lx, t), v)
}

/// Where field `f` (by declaration) of variant `v` sits in a value of enum `t`.
fn payload_offset(fx: Fx, t: Str, v: Int, f: Int) -> Int {
    let lx = fx.lo.lx
    let vn_ = at(lx.c, kid(lx.c, def_node(lx, t), "variants"), v)
    let pos = position_of(canonical_order(lx, vn_), f)
    let st = structure(lx, variant_fields(lx, t, v))
    8 + (if pos < ints_len(st) - 2 { ints_get(st, pos) } else { 0 })
}

fn read_borrowed(fx: Fx, dst: Int, a: Int, t: Str) {
    if in_memory(t) {
        let d = addr(fx, dst)
        copy(fx, d, a, size_of(fx, t));
    } else {
        set(fx, dst, load(fx, mclass(t), a, 0));
    }
}

fn read_owned(fx: Fx, dst: Int, a: Int, t: Str) {
    if in_memory(t) {
        let d = addr(fx, dst)
        copy(fx, d, a, size_of(fx, t));
        retain_at(fx, d, t);
    } else {
        let v = load(fx, mclass(t), a, 0)
        if owns_ty(fx, t) { retain_value(fx, v, t); }
        set(fx, dst, v);
    }
}

fn argc(fx: Fx) -> Int {
    let d = runtime_data(fx.lo, "nz.argc", "i64")
    let a = addr_of(fx, d)
    load(fx, "i64", a, 0)
}

fn ext(fx: Fx, to: Str, src: Int, signed: Bool) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = " + (if signed { "sext" } else { "zext" }) + " " + to + " " + vn(src))
    v
}

fn trunc(fx: Fx, to: Str, src: Int) -> Int {
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = trunc " + to + " " + vn(src))
    v
}

// --- statements ---------------------------------------------------------------------------------

fn checked(fx: Fx, op: Str, x: Int, y: Int, what: Str) -> Int {
    let dst = value(fx.fb)
    let ovf = value(fx.fb)
    emit(fx.fb, vn(dst) + ", " + vn(ovf) + " = " + op + " " + vn(x) + ", " + vn(y));
    guard(fx, ovf, "N0400", what);
    dst
}

fn min_over_minus_one(fx: Fx, x: Int, y: Int) -> Int {
    let a = cmp_imm(fx, "eq", x, "i64", 0 - 9223372036854775807 - 1)
    let b = cmp_imm(fx, "eq", y, "i64", 0 - 1)
    bin(fx, "and", a, b)
}

fn arith(fx: Fx, op: Str, x: Int, y: Int) -> Int {
    if op == "+" { return checked(fx, "add.ovf", x, y, "this addition overflows `Int`") }
    if op == "-" { return checked(fx, "sub.ovf", x, y, "this subtraction overflows `Int`") }
    if op == "*" { return checked(fx, "mul.ovf", x, y, "this multiplication overflows `Int`") }
    let zero = cmp_imm(fx, "eq", y, "i64", 0)
    guard(fx, zero, "N0401", "division by zero");
    let special = min_over_minus_one(fx, x, y)
    if op == "/" {
        guard(fx, special, "N0400", "this division overflows `Int`");
        return bin(fx, "sdiv", x, y)
    }
    let one = iconst(fx, 1)
    let v = value(fx.fb)
    emit(fx.fb, vn(v) + " = select " + vn(special) + ", " + vn(one) + ", " + vn(y));
    bin(fx, "srem", x, v)
}

fn direct_call(fx: Fx, dst: Int, callee: Int, args: Vec[Operand]) {
    let dt = ty(fx, dst)
    let fsym = match hashmap_get(fx.lo.funcs, callee) { Some(s) => s, None => 0 - 1 }
    if fsym < 0 {
        defect(fx.lo, "a call to an undeclared function");
        return
    }
    let g = vec_get(fx.lo.p.fns, callee)
    let foreign = g.foreign != ""
    let vals = ints_new()
    if in_memory(dt) && !foreign { ints_push(vals, addr(fx, dst)) }
    // A `Str` argument to C is a NUL-terminated copy C borrows, freed after the call (N55); a
    // C-layout record a copy of its bytes C borrows for the call.
    let copies = ints_new()
    for a in args {
        let v = argument(fx, a)
        let at_ = operand_ty(fx, a)
        if foreign && class(at_) == "record" {
            let size = iconst(fx, size_of(fx, at_))
            let m = rt_v(fx, "malloc", ints_of(size), "ptr")
            let oom = is_null(fx, m)
            foreign_guard(fx, oom, "N0406", "out of memory", copies);
            rt(fx, "memcpy", ints_of3(m, v, size))
            ints_push(copies, m)
            ints_push(vals, m)
        } else if foreign && at_ == "Str" {
            let p = load(fx, "ptr", v, 0)
            let n = load(fx, "i64", v, 8)
            let nul = rt_v(fx, "nz.cstr_has_nul", ints_of2(p, n), "bit")
            foreign_guard(fx, nul, "N0405", "a string holding a NUL byte cannot be passed to C", copies);
            let cs = rt_v(fx, "nz.cstr_borrow", ints_of2(p, n), "ptr")
            let oom = is_null(fx, cs)
            foreign_guard(fx, oom, "N0406", "out of memory", copies);
            ints_push(copies, cs)
            ints_push(vals, cs)
        } else {
            ints_push(vals, v)
        }
    }
    let rf = call_failing(fx, fsym, vals)
    // What C left in `errno`, before anything else can change it (N85).
    if foreign { rt(fx, "nz.errno_save", ints_new()) }
    for i in 0..ints_len(copies) { rt(fx, "free", ints_of(ints_get(copies, i))) }
    if !foreign { check_call(fx, ints_get(rf, 1)) }
    if !in_memory(dt) {
        if ints_get(rf, 0) >= 0 { set(fx, dst, ints_get(rf, 0)) }
    } else if foreign {
        defect(fx.lo, "a foreign function returning a value held in memory");
    }
}

/// A guard before a foreign call (N55): the copies already made for it freed on the failing
/// path.
fn foreign_guard(fx: Fx, bad: Int, code: Str, what: Str, copies: Ints) {
    let failing = new_lblock(fx.fb)
    let cont = new_lblock(fx.fb)
    branch(fx, bad, failing, cont);
    switch_to(fx.fb, failing);
    for i in 0..ints_len(copies) { rt(fx, "free", ints_of(ints_get(copies, i))) }
    fail_with(fx, code, what);
    switch_to(fx.fb, cont);
}

// --- arrays -------------------------------------------------------------------------------------

/// An array type's element and length, or a defect.
fn array_of(fx: Fx, t: Str) -> Strs {
    let s = spell(t)
    if s.kind != "array" {
        defect(fx.lo, "an array operation on something that is not an array");
        return strs_new()
    }
    s.args
}

fn array_len(parts: Strs) -> Int { match text_parse_int(strs_get(parts, 1)) { Ok(v) => v, Err(e) => 0 } }

fn element_at(fx: Fx, base: Int, i: Int, stride: Int) -> Int {
    let k = iconst(fx, stride)
    let off = bin(fx, "mul", i, k)
    ptr_add(fx, base, off)
}

fn check_index(fx: Fx, i: Int, len: Int) {
    let outside = cmp_imm(fx, "uge", i, "i64", len)
    guard(fx, outside, "N0405", "this index is outside the array");
}

/// Write operand `o`, an element of type `t`, at `a`: its bytes, and a reference of its own.
fn put_element(fx: Fx, a: Int, o: Operand, t: Str) {
    if in_memory(t) {
        let src = place(fx, o)
        copy(fx, a, src, size_of(fx, t));
    } else {
        let v = opvalue(fx, o)
        store(fx, a, 0, v);
    }
    retain_at(fx, a, t);
}

fn array_value(fx: Fx, dst: Int, elems: Vec[Operand]) {
    let parts = array_of(fx, ty(fx, dst))
    if strs_len(parts) < 2 { return }
    let elem = strs_get(parts, 0)
    let stride = size_of(fx, elem)
    let d = addr(fx, dst)
    for i in 0..vec_len(elems) {
        let a = ptr_off(fx, d, stride * i)
        put_element(fx, a, vec_get(elems, i), elem);
    }
}

fn array_repeat(fx: Fx, dst: Int, o: Operand, count: Int) {
    let parts = array_of(fx, ty(fx, dst))
    if strs_len(parts) < 2 { return }
    let elem = strs_get(parts, 0)
    let stride = size_of(fx, elem)
    let d = addr(fx, dst)
    // The value once, then a loop.
    let mem = in_memory(elem)
    let src = if mem { place(fx, o) } else { opvalue(fx, o) }
    let i = new_var(fx.fb, "i64")
    let zero = iconst(fx, 0)
    set_var(fx, i, zero);
    let head = new_lblock(fx.fb)
    let body = new_lblock(fx.fb)
    let done = new_lblock(fx.fb)
    jump(fx, head);
    switch_to(fx.fb, head);
    let iv = get_var(fx, i)
    let more = cmp_imm(fx, "lt", iv, "i64", count)
    branch(fx, more, body, done);
    switch_to(fx.fb, body);
    let iv2 = get_var(fx, i)
    let a = element_at(fx, d, iv2, stride)
    if mem { copy(fx, a, src, stride) } else { store(fx, a, 0, src) }
    // A reference per copy (L8).
    retain_at(fx, a, elem);
    let next = add_imm(fx, iv2, 1)
    set_var(fx, i, next);
    jump(fx, head);
    switch_to(fx.fb, done);
}

fn array_index(fx: Fx, dst: Int, base: Operand, index: Operand) {
    let parts = array_of(fx, operand_ty(fx, base))
    if strs_len(parts) < 2 { return }
    let elem = strs_get(parts, 0)
    let i = opvalue(fx, index)
    check_index(fx, i, array_len(parts));
    let stride = size_of(fx, elem)
    let b = place(fx, base)
    let a = element_at(fx, b, i, stride)
    if in_memory(elem) {
        let d = addr(fx, dst)
        copy(fx, d, a, size_of(fx, elem));
        // The copy out is a new reference to what it holds (L8).
        retain_at(fx, d, elem);
    } else {
        set(fx, dst, load(fx, mclass(elem), a, 0));
    }
}

/// `base.path = value` through array elements: each index checked, the old value released
/// (L8), then the value's bytes moved in.
fn set_element(fx: Fx, base: Int, path: Vec[PathRef], v: Int) {
    let mut a = addr(fx, base)
    let mut t = ty(fx, base)
    for step in path {
        match step {
            PathRef.Field(f: r) => {
                let fo = field_offset(fx, r.rec, r.field)
                a = ptr_off(fx, a, ints_get(fo, 0))
                t = field_ty(fx.lo.lx.tt, r.rec, int_to_str(r.field))
            },
            PathRef.Index(local: l, len: n) => {
                let parts = array_of(fx, t)
                if strs_len(parts) < 2 { return }
                let elem = strs_get(parts, 0)
                let i = get(fx, l)
                check_index(fx, i, n);
                a = element_at(fx, a, i, size_of(fx, elem))
                t = elem
            },
        }
    }
    release_at(fx, a, t);
    move_into(fx, a, v);
}

// --- scopes and tasks ---------------------------------------------------------------------------

fn spawn_task(fx: Fx, list: Int, callee: Int, args: Vec[Operand]) {
    // The block: the thread handle, the task's failure message and length, then each argument
    // at its alignment.
    let mut at_ = 24
    let tys = strs_new()
    let offs = ints_new()
    for a in args {
        let t = operand_ty(fx, a)
        let l = lay(fx.lo.lx, t)
        let al = if l.align < 1 { 1 } else { l.align }
        at_ = (at_ + al - 1) / al * al
        strs_push(tys, t)
        ints_push(offs, at_)
        at_ += l.size
    }
    let size = iconst(fx, if at_ < 24 { 24 } else { at_ })
    let blk = rt_v(fx, "malloc", ints_of(size), "ptr")
    let none = is_null(fx, blk)
    guard(fx, none, "N0406", "out of memory");
    let zp = null(fx)
    store(fx, blk, 8, zp);
    let zl = iconst(fx, 0)
    store(fx, blk, 16, zl);
    // The block takes a reference of its own to each argument; the task gives it back.
    for i in 0..vec_len(args) {
        let a = vec_get(args, i)
        let t = strs_get(tys, i)
        let d = ptr_off(fx, blk, ints_get(offs, i))
        if in_memory(t) {
            let src = place(fx, a)
            copy(fx, d, src, size_of(fx, t));
            retain_at(fx, d, t);
        } else {
            let v = opvalue(fx, a)
            if owns_ty(fx, t) { retain_value(fx, v, t) }
            store(fx, d, 0, v);
        }
    }
    let name = anonymous(fx.lo, "task")
    let tramp = symbol(fx.lo, name, "local", "func", "c (ptr) -> ptr", "ptr", false)
    ints_push(fx.lo.tramps, tramp)
    ints_push(fx.lo.tramps, callee)
    vec_push(fx.lo.tramp_tys, tys)
    vec_push(fx.lo.tramp_offs, offs)
    let fa = addr_of(fx, tramp)
    let tids = get(fx, list)
    let rc = rt_v(fx, "nz.spawn", ints_of3(tids, fa, blk), "i32")
    let started = cmp_imm(fx, "eq", rc, "i32", 0)
    let cleanup = new_lblock(fx.fb)
    let after = new_lblock(fx.fb)
    branch(fx, started, after, cleanup);
    switch_to(fx.fb, cleanup);
    // A task that never started owns nothing: give back what was packed for it.
    for i in 0..strs_len(tys) {
        let a = ptr_off(fx, blk, ints_get(offs, i))
        release_at(fx, a, strs_get(tys, i));
    }
    rt(fx, "free", ints_of(blk))
    jump(fx, after);
    switch_to(fx.fb, after);
    let oom = cmp_imm(fx, "eq", rc, "i32", 0 - 1)
    guard(fx, oom, "N0406", "out of memory");
    let bad = cmp_imm(fx, "gt", rc, "i32", 0)
    guard(fx, bad, "N0404", "this task could not be started");
    // Started (N54).
    rt(fx, "nz.sched_note_spawn", ints_new())
}

/// A spawn site's trampoline (`helpers::trampoline`): unpack the block, call, publish, release.
fn trampoline(lo: Lo, k: Int) -> Str {
    let sym = ints_get(lo.tramps, 2 * k)
    let callee = ints_get(lo.tramps, 2 * k + 1)
    let tys = vec_get(lo.tramp_tys, k)
    let offs = vec_get(lo.tramp_offs, k)
    let fx = helper_fx(lo)
    let a = param(fx, 0)
    let fsym = match hashmap_get(lo.funcs, callee) { Some(s) => s, None => 0 - 1 }
    if fsym < 0 {
        defect(lo, "a task running an undeclared function");
        return ""
    }
    let ret = vec_get(lo.p.fns, callee).ret
    let vals = ints_new()
    // A task's result is discarded, so an in-memory one needs somewhere to land.
    if in_memory(ret) { ints_push(vals, scratch(fx, size_of(fx, ret))) }
    for i in 0..strs_len(tys) {
        let t = strs_get(tys, i)
        let at_ = ptr_off(fx, a, ints_get(offs, i))
        if in_memory(t) { ints_push(vals, at_) } else { ints_push(vals, load(fx, mclass(t), at_, 0)) }
    }
    call(fx, fsym, vals);
    // A failure ends the task, not the process: the scope's join reports it.
    rt(fx, "nz.task_publish", ints_of(a))
    for i in 0..strs_len(tys) {
        let at_ = ptr_off(fx, a, ints_get(offs, i))
        release_at(fx, at_, strs_get(tys, i));
    }
    let z = null(fx)
    term(fx.fb, "return " + vn(z));
    finish(lo, fx.fb, sym, "a task trampoline")
}

// --- closures -----------------------------------------------------------------------------------

/// The types a closure's code carries: its capture locals' types, in order.
fn carried_of(lo: Lo, f: MirFn) -> Strs {
    let out = strs_new()
    for i in 0..ints_len(f.captures) { strs_push(out, vec_get(f.locals, ints_get(f.captures, i)).ty) }
    out
}

/// Where each capture sits in a closure object, after its 24-byte header, then the object's
/// size (N50): each in an 8-aligned slot of its own size.
fn closure_layout(fx: Fx, carried: Strs) -> Ints {
    let out = ints_new()
    let mut off = 24
    for t in carried {
        ints_push(out, off)
        off += (size_of(fx, t) + 7) / 8 * 8
    }
    ints_push(out, off)
    out
}

fn closure(fx: Fx, dst: Int, func: Int, captures: Vec[Operand]) {
    let fsym = match hashmap_get(fx.lo.funcs, func) { Some(s) => s, None => 0 - 1 }
    if fsym < 0 {
        defect(fx.lo, "a closure of an undeclared function");
        return
    }
    let carried = carried_of(fx.lo, vec_get(fx.lo.p.fns, func))
    let offs = closure_layout(fx, carried)
    let code = addr_of(fx, fsym)
    let mut any = false
    for t in carried { if owns_ty(fx, t) { any = true } }
    let release = if any { addr_of(fx, helper(fx.lo, "clo", int_to_str(func))) } else { null(fx) }
    let n = iconst(fx, ints_get(offs, strs_len(carried)))
    let c = rt_v(fx, "nz.closure_new", ints_of3(n, code, release), "ptr")
    let none = is_null(fx, c)
    guard(fx, none, "N0406", "out of memory");
    let k = if vec_len(captures) < strs_len(carried) { vec_len(captures) } else { strs_len(carried) }
    for i in 0..k {
        let o = vec_get(captures, i)
        let t = strs_get(carried, i)
        let at_ = ptr_off(fx, c, ints_get(offs, i))
        // The object's own reference to each capture.
        if in_memory(t) {
            let src = place(fx, o)
            copy(fx, at_, src, size_of(fx, t));
            retain_at(fx, at_, t);
        } else {
            let v = opvalue(fx, o)
            store(fx, at_, 0, v);
            if owns_ty(fx, t) { retain_value(fx, v, t) }
        }
    }
    set(fx, dst, c);
}

fn call_indirect(fx: Fx, dst: Int, callee: Operand, args: Vec[Operand]) {
    let dt = ty(fx, dst)
    let c = opvalue(fx, callee)
    let ft = operand_ty(fx, callee)
    if !(str_len(ft) > 4 && str_slice(ft, 0, 4) == "?fn(") {
        defect(fx.lo, "a call through something not a function value");
        return
    }
    let parts = fn_parts(ft, 1)
    let params = strs_new()
    strs_push(params, ft)
    for i in 2..strs_len(parts) { strs_push(params, strs_get(parts, i)) }
    let ret = strs_get(parts, 0)
    let sig = nazm_sig(params, ret, "")
    let code = load(fx, "ptr", c, 8)
    let vals = ints_new()
    if in_memory(dt) { ints_push(vals, addr(fx, dst)) }
    ints_push(vals, c)
    for a in args { ints_push(vals, argument(fx, a)) }
    let returns = sig_ret(sig) != ""
    let result = if returns { value(fx.fb) } else { 0 - 1 }
    // Every function value's code is a Nazm function's: its failure bit comes back.
    let failed = value(fx.fb)
    let head = if returns { vn(result) + ", failed " + vn(failed) + " = " } else { "failed " + vn(failed) + " = " }
    emit(fx.fb, head + "call_indirect " + sig + " " + vn(code) + "(" + args_text(vals) + ")");
    check_call(fx, failed);
    if !in_memory(dt) && result >= 0 { set(fx, dst, result) }
}

fn compare(fx: Fx, op: Str, t: Str, a: Operand, b: Operand) -> Int {
    let k = class(t)
    let ordering = !(op == "==" || op == "!=")
    let s = spell(t)
    // The derived order (L6): -1, 0 or 1 from the type's helper, against 0.
    if ordering && (k == "str" || k == "record" || k == "enum") {
        let x = place(fx, a)
        let y = place(fx, b)
        let h = helper(fx.lo, "ord", t)
        let o = call(fx, h, ints_of2(x, y))
        let cc = if op == "<" { "lt" } else if op == "<=" { "le" } else if op == ">" { "gt" } else { "ge" }
        return cmp_imm(fx, cc, o, "i64", 0)
    }
    // A `Box` or `Chain` compares by what it holds (L6), through the helper: each handle is
    // spilled, so the helper reads it through a pointer.
    if s.kind == "vec" && s.head != "Chan" {
        let x = opvalue(fx, a)
        let y = opvalue(fx, b)
        let pa = scratch(fx, 8)
        store(fx, pa, 0, x);
        let pb = scratch(fx, 8)
        store(fx, pb, 0, y);
        let h = helper(fx.lo, "eq", t)
        let eq = call(fx, h, ints_of2(pa, pb))
        return if op == "!=" { negate(fx, eq) } else { eq }
    }
    if k == "record" || k == "enum" || k == "array" {
        let x = place(fx, a)
        let y = place(fx, b)
        let h = helper(fx.lo, "eq", t)
        let eq = call(fx, h, ints_of2(x, y))
        return if op == "!=" { negate(fx, eq) } else { eq }
    }
    if k == "str" && (op == "==" || op == "!=") {
        let x = place(fx, a)
        let y = place(fx, b)
        let eq = string_equal(fx, x, y)
        return if op == "!=" { negate(fx, eq) } else { eq }
    }
    if k == "num" {
        let x = opvalue(fx, a)
        let y = opvalue(fx, b)
        return num_compare(fx, op, num_kind(t), x, y)
    }
    if k == "int" || k == "bool" {
        let x = opvalue(fx, a)
        let y = opvalue(fx, b)
        let bit = k == "bool"
        let cc = if op == "==" { "eq" } else if op == "!=" { "ne" } else if op == "<" { if bit { "ult" } else { "lt" } } else if op == "<=" { if bit { "ule" } else { "le" } } else if op == ">" { if bit { "ugt" } else { "gt" } } else { if bit { "uge" } else { "ge" } }
        return cmp(fx, cc, x, y)
    }
    defect(fx.lo, "a comparison of `" + t + "` (not ported yet)");
    iconst_c(fx, "bit", 0)
}

fn negate(fx: Fx, v: Int) -> Int {
    let one = iconst_c(fx, "bit", 1)
    bin(fx, "xor", v, one)
}

fn string_equal(fx: Fx, a: Int, b: Int) -> Int {
    let la = load(fx, "i64", a, 8)
    let lb = load(fx, "i64", b, 8)
    let same = cmp(fx, "eq", la, lb)
    let out = new_var(fx.fb, "bit")
    let no = iconst_c(fx, "bit", 0)
    set_var(fx, out, no);
    let compare_at = new_lblock(fx.fb)
    let join = new_lblock(fx.fb)
    branch(fx, same, compare_at, join);
    switch_to(fx.fb, compare_at);
    let pa = load(fx, "ptr", a, 0)
    let pb = load(fx, "ptr", b, 0)
    let diff = rt_v(fx, "memcmp", ints_of3(pa, pb, la), "i32")
    let eq = cmp_imm(fx, "eq", diff, "i32", 0)
    set_var(fx, out, eq);
    jump(fx, join);
    switch_to(fx.fb, join);
    get_var(fx, out)
}

fn assign(fx: Fx, dst: Int, v: Rvalue) {
    let dt = ty(fx, dst)
    match v {
        Rvalue.Use(o: o) => {
            if in_memory(dt) {
                let src = place(fx, o)
                let d = addr(fx, dst)
                copy(fx, d, src, size_of(fx, dt));
            } else {
                let x = opvalue(fx, o)
                set(fx, dst, x);
            }
        },
        Rvalue.Copy(l: l) => {
            if in_memory(dt) {
                let src = addr(fx, l)
                let d = addr(fx, dst)
                copy(fx, d, src, size_of(fx, dt));
                retain_at(fx, d, dt);
            } else {
                let x = get(fx, l)
                if owns_ty(fx, dt) { retain_value(fx, x, dt) }
                set(fx, dst, x);
            }
        },
        Rvalue.Move(l: l) => {
            if in_memory(dt) {
                let d = addr(fx, dst)
                move_into(fx, d, l);
            } else {
                let x = get(fx, l)
                clear(fx, l);
                set(fx, dst, x);
            }
        },
        Rvalue.Neg(o: o) => {
            if dt != "Int" {
                let x = opvalue(fx, o)
                set(fx, dst, num_neg(fx, num_kind(dt), x));
                return
            }
            let x = opvalue(fx, o)
            let z = iconst(fx, 0)
            let r = checked(fx, "sub.ovf", z, x, "this negation overflows `Int`")
            set(fx, dst, r);
        },
        Rvalue.Arith(op: op, a: a, b: b) => {
            let x = opvalue(fx, a)
            let y = opvalue(fx, b)
            let r = if dt != "Int" { num_arith(fx, op, num_kind(dt), x, y) } else { arith(fx, op, x, y) }
            set(fx, dst, r);
        },
        Rvalue.Bits(op: op, a: a, b: b) => {
            let x = opvalue(fx, a)
            let y = opvalue(fx, b)
            set(fx, dst, num_bits(fx, op, num_kind(dt), x, y));
        },
        Rvalue.Complement(o: o) => {
            let x = opvalue(fx, o)
            let ones = iconst_c(fx, mclass(num_kind(dt)), 0 - 1)
            set(fx, dst, bin(fx, "xor", x, ones));
        },
        Rvalue.Convert(mode: m, to: to, o: o) => {
            let from = kind_of(operand_ty(fx, o))
            let tk = kind_of(to)
            let x = opvalue(fx, o)
            if from == "" || tk == "" {
                defect(fx.lo, "a conversion between non-numbers");
                set(fx, dst, x);
                return
            }
            set(fx, dst, num_convert(fx, m, from, tk, x));
        },
        Rvalue.Fits(to: to, o: o) => {
            let from = kind_of(operand_ty(fx, o))
            let tk = kind_of(to)
            let x = opvalue(fx, o)
            let r = if from == "" || tk == "" { bit(fx, false) } else { num_fits(fx, from, tk, x) }
            set(fx, dst, r);
        },
        Rvalue.Compare(op: op, law: _, operand: t, a: a, b: b) => {
            let r = compare(fx, op, t, a, b)
            set(fx, dst, r);
        },
        Rvalue.Hash(operand: t, value: o) => {
            // The derived hash (L6), from the type's helper, of the value where it is held.
            let mut a = 0
            if in_memory(t) {
                a = place(fx, o)
            } else {
                let v = opvalue(fx, o)
                a = scratch(fx, 8)
                store(fx, a, 0, v);
            }
            let h = helper(fx.lo, "hash", t)
            set(fx, dst, call(fx, h, ints_of(a)));
        },
        Rvalue.Call(callee: g, args: args) => { direct_call(fx, dst, g, args); },
        Rvalue.Closure(func: g, captures: cs) => { closure(fx, dst, g, cs); },
        Rvalue.Array(elems: es) => { array_value(fx, dst, es); },
        Rvalue.ArrayRepeat(value: o, count: n) => { array_repeat(fx, dst, o, n); },
        Rvalue.Index(base: b, index: i) => { array_index(fx, dst, b, i); },
        Rvalue.Capture(env: e, index: i) => {
            let carried = carried_of(fx.lo, fx.f)
            if i >= strs_len(carried) {
                defect(fx.lo, "a capture the closure does not carry");
                return
            }
            let offs = closure_layout(fx, carried)
            let c = get(fx, e)
            let a = ptr_off(fx, c, ints_get(offs, i))
            read_owned(fx, dst, a, strs_get(carried, i));
        },
        Rvalue.CallIndirect(callee: c, args: args) => { call_indirect(fx, dst, c, args); },
        Rvalue.Primitive(op: op, elem: e, args: args) => { primitive(fx, dst, op, e, args); },
        Rvalue.Record(ty: t, fields: fs, names: _, locals: ls) => {
            let d = addr(fx, dst)
            for i in 0..ints_len(fs) {
                let fo = field_offset(fx, t, ints_get(fs, i))
                let a = ptr_off(fx, d, ints_get(fo, 0))
                move_into(fx, a, ints_get(ls, i));
            }
        },
        Rvalue.Variant(ty: t, variant: v, vname: _, fields: fs, names: _, locals: ls) => {
            let d = addr(fx, dst)
            let tg = tag(fx, t, v)
            let k = iconst(fx, tg)
            store(fx, d, 0, k);
            for i in 0..ints_len(fs) {
                let off = payload_offset(fx, t, v, ints_get(fs, i))
                let a = ptr_off(fx, d, off)
                move_into(fx, a, ints_get(ls, i));
            }
        },
        Rvalue.Field(base: b, f: r) => {
            let p = place(fx, b)
            let fo = field_offset(fx, r.rec, r.field)
            let a = ptr_off(fx, p, ints_get(fo, 0))
            read_owned(fx, dst, a, field_ty(fx.lo.lx.tt, r.rec, int_to_str(r.field)));
        },
        Rvalue.FieldBorrow(base: b, f: r) => {
            let p = place(fx, b)
            let fo = field_offset(fx, r.rec, r.field)
            let a = ptr_off(fx, p, ints_get(fo, 0))
            read_borrowed(fx, dst, a, field_ty(fx.lo.lx.tt, r.rec, int_to_str(r.field)));
        },
        Rvalue.Payload(base: b, ty: t, variant: v, vname: _, field: fi, fname: _) => {
            let p = addr(fx, b)
            let off = payload_offset(fx, t, v, fi)
            let a = ptr_off(fx, p, off)
            read_owned(fx, dst, a, field_ty(fx.lo.lx.tt, t, int_to_str(v) + "." + int_to_str(fi)));
        },
    }
}

fn statement(fx: Fx, s: Stmt) {
    match s {
        Stmt.Assign(dst: d, value: v, unwind: _) => { assign(fx, d, v); },
        Stmt.Drop(l: l) => {
            let t = ty(fx, l)
            if owns_ty(fx, t) {
                if in_memory(t) {
                    let a = addr(fx, l)
                    release_at(fx, a, t);
                    zero(fx, a, size_of(fx, t));
                } else {
                    let x = get(fx, l)
                    release_value(fx, x, t);
                    clear(fx, l);
                }
            }
        },
        Stmt.SetField(base: b, path: path, value: v) => {
            let mut a = addr(fx, b)
            let mut last = "Int"
            for r in path {
                let fo = field_offset(fx, r.rec, r.field)
                a = ptr_off(fx, a, ints_get(fo, 0))
                last = field_ty(fx.lo.lx.tt, r.rec, int_to_str(r.field))
            }
            // The new value already owns its reference, so the old one may go first.
            release_at(fx, a, last);
            move_into(fx, a, v);
        },
        Stmt.SetElement(base: b, path: path, value: v, unwind: _) => { set_element(fx, b, path, v); },
        Stmt.ScopeOpen(list: l, unwind: _) => {
            let t = rt_v(fx, "nz.arr_new", ints_new(), "ptr")
            let none = is_null(fx, t)
            guard(fx, none, "N0406", "out of memory");
            set(fx, l, t);
        },
        Stmt.Spawn(list: l, callee: g, args: args, unwind: _) => { spawn_task(fx, l, g, args); },
        Stmt.ScopeJoin(list: l) => {
            let t = get(fx, l)
            let z = null(fx)
            set(fx, l, z);
            let o = scratch(fx, 16)
            // Counted before the join, while the list still says how many (N54).
            rt(fx, "nz.sched_note_join", ints_of(t))
            rt(fx, "nz.scope_join_to", ints_of2(t, o))
            let msg = load(fx, "ptr", o, 0)
            let none = is_null(fx, msg)
            let take = new_lblock(fx.fb)
            let cont = new_lblock(fx.fb)
            branch(fx, none, cont, take);
            switch_to(fx.fb, take);
            let len = load(fx, "i64", o, 8)
            rt(fx, "nz.fail", ints_of2(msg, len))
            jump(fx, cont);
            switch_to(fx.fb, cont);
            // The list of task ids is the runtime's, dead once joined.
            rt(fx, "nz.arr_release", ints_of(t))
        },
        Stmt.CheckFailed(unwind: _) => { check_failed(fx); },
        Stmt.StackCheck(unwind: _) => {
            // The locals' slots are laid out before the first statement, so a large frame is
            // known here: the function's entry checks the whole frame (`frame_entry`).
            if frame_size(fx.fb) >= 4096 && strs_len(fx.at) > 1 { strs_set(fx.at, 1, here(fx)) }
            let past = rt_v(fx, "nz.stack_check", ints_new(), "i32")
            let bad = cmp_imm(fx, "ne", past, "i32", 0)
            guard(fx, bad, "N0408", "the native call stack is exhausted");
        },
    }
}

fn terminator(fx: Fx, t: Term) {
    match t {
        Term.Goto(b: b) => { jump(fx, ints_get(fx.blocks, b)); },
        Term.Branch(cond: c, then: a, other: b) => {
            let x = opvalue(fx, c)
            branch(fx, x, ints_get(fx.blocks, a), ints_get(fx.blocks, b));
        },
        Term.Return(l: l) => {
            if sret(fx) >= 0 {
                let src = addr(fx, l)
                copy(fx, sret(fx), src, size_of(fx, fx.f.ret));
                term(fx.fb, "return");
            } else {
                let x = get(fx, l)
                term(fx.fb, "return " + vn(x));
            }
        },
        Term.Unwind => { term(fx.fb, "fail"); },
        Term.Switch(scrutinee: s, ty: t, variants: vs, names: _, blocks: bs) => {
            let a = addr(fx, s)
            let tg = load(fx, "i64", a, 0)
            let cases = strs_new()
            let mut first = 0 - 1
            for i in 0..ints_len(vs) {
                let b = ints_get(fx.blocks, ints_get(bs, i))
                if first < 0 { first = b }
                strs_push(cases, int_to_str(tag(fx, t, ints_get(vs, i))) + ": b" + int_to_str(b))
            }
            let default = if first >= 0 { first } else { new_lblock(fx.fb) }
            term(fx.fb, "switch " + vn(tg) + " [" + str_join(cases, ", ") + "] else b" + int_to_str(default));
        },
        Term.Exit(o: o) => {
            let c = opvalue(fx, o)
            let bad = cmp_imm(fx, "ugt", c, "i64", 255)
            let failing = new_lblock(fx.fb)
            let fine = new_lblock(fx.fb)
            branch(fx, bad, failing, fine);
            switch_to(fx.fb, failing);
            let m = message(fx.lo, "N0416", "this exit status is outside 0 to 255", here(fx))
            let p = addr_of(fx, ints_get(m, 0))
            let n = iconst(fx, ints_get(m, 1))
            rt(fx, "nz.fail", ints_of2(p, n))
            rt(fx, "nz.report", ints_new())
            term(fx.fb, "unreachable");
            switch_to(fx.fb, fine);
            let narrow = trunc(fx, "i32", c)
            rt(fx, "exit", ints_of(narrow))
            term(fx.fb, "unreachable");
        },
    }
}

// --- which locals are values --------------------------------------------------------------------

fn operand_local(o: Operand, out: Ints) {
    match o {
        Operand.Local(l: l) => { ints_push(out, l); },
        _ => {},
    }
}

fn operands_locals(os: Vec[Operand], out: Ints) {
    for o in os { operand_local(o, out) }
}

fn rvalue_reads(v: Rvalue, out: Ints) {
    match v {
        Rvalue.Use(o: o) => { operand_local(o, out); },
        Rvalue.Neg(o: o) => { operand_local(o, out); },
        Rvalue.Complement(o: o) => { operand_local(o, out); },
        Rvalue.Convert(mode: _, to: _, o: o) => { operand_local(o, out); },
        Rvalue.Fits(to: _, o: o) => { operand_local(o, out); },
        Rvalue.Hash(operand: _, value: o) => { operand_local(o, out); },
        Rvalue.Copy(l: l) => { ints_push(out, l); },
        Rvalue.Move(l: l) => { ints_push(out, l); },
        Rvalue.Capture(env: l, index: _) => { ints_push(out, l); },
        Rvalue.Array(elems: es) => { operands_locals(es, out); },
        Rvalue.ArrayRepeat(value: o, count: _) => { operand_local(o, out); },
        Rvalue.Arith(op: _, a: a, b: b) => {
            operand_local(a, out);
            operand_local(b, out);
        },
        Rvalue.Bits(op: _, a: a, b: b) => {
            operand_local(a, out);
            operand_local(b, out);
        },
        Rvalue.Index(base: a, index: b) => {
            operand_local(a, out);
            operand_local(b, out);
        },
        Rvalue.Compare(op: _, law: _, operand: _, a: a, b: b) => {
            operand_local(a, out);
            operand_local(b, out);
        },
        Rvalue.Call(callee: _, args: args) => { operands_locals(args, out); },
        Rvalue.Primitive(op: _, elem: _, args: args) => { operands_locals(args, out); },
        Rvalue.CallIndirect(callee: c, args: args) => {
            operand_local(c, out);
            operands_locals(args, out);
        },
        Rvalue.Closure(func: _, captures: cs) => { operands_locals(cs, out); },
        Rvalue.Record(ty: _, fields: _, names: _, locals: ls) => { for i in 0..ints_len(ls) { ints_push(out, ints_get(ls, i)) } },
        Rvalue.Variant(ty: _, variant: _, vname: _, fields: _, names: _, locals: ls) => { for i in 0..ints_len(ls) { ints_push(out, ints_get(ls, i)) } },
        Rvalue.Field(base: o, f: _) => { operand_local(o, out); },
        Rvalue.FieldBorrow(base: o, f: _) => { operand_local(o, out); },
        Rvalue.Payload(base: l, ty: _, variant: _, vname: _, field: _, fname: _) => { ints_push(out, l); },
    }
}

fn mentions(s: Stmt) -> Ints {
    let out = ints_new()
    match s {
        Stmt.Assign(dst: _, value: v, unwind: _) => { rvalue_reads(v, out); },
        Stmt.SetField(base: b, path: _, value: v) => {
            ints_push(out, b)
            ints_push(out, v)
        },
        Stmt.SetElement(base: b, path: path, value: v, unwind: _) => {
            ints_push(out, b)
            for p in path {
                match p {
                    PathRef.Index(local: l, len: _) => { ints_push(out, l); },
                    _ => {},
                }
            }
            ints_push(out, v)
        },
        Stmt.Drop(l: l) => { ints_push(out, l); },
        Stmt.ScopeOpen(list: l, unwind: _) => { ints_push(out, l); },
        Stmt.ScopeJoin(list: l) => { ints_push(out, l); },
        Stmt.Spawn(list: l, callee: _, args: args, unwind: _) => {
            ints_push(out, l)
            operands_locals(args, out);
        },
        _ => {},
    }
    out
}

fn term_reads(t: Term) -> Ints {
    let out = ints_new()
    match t {
        Term.Branch(cond: c, then: _, other: _) => { operand_local(c, out); },
        Term.Switch(scrutinee: l, ty: _, variants: _, names: _, blocks: _) => { ints_push(out, l); },
        Term.Return(l: l) => { ints_push(out, l); },
        Term.Exit(o: o) => { operand_local(o, out); },
        _ => {},
    }
    out
}

/// Which locals are held as values: a scalar (`Int` or `Bool`) temporary assigned once, read
/// only after that assignment and in its block.
fn promotable(f: MirFn) -> Ints {
    let n = vec_len(f.locals)
    let defs = ints_new()
    let def_b = ints_new()
    let def_s = ints_new()
    let ok = ints_new()
    for i in 0..n {
        ints_push(defs, 0)
        ints_push(def_b, 0 - 1)
        ints_push(def_s, 0 - 1)
        ints_push(ok, 1)
    }
    // Definitions first, then every use against its local's one definition.
    for b in 0..vec_len(f.blocks) {
        let blk = vec_get(f.blocks, b)
        for s in 0..vec_len(blk.stmts) {
            match vec_get(blk.stmts, s) {
                Stmt.Assign(dst: d, value: _, unwind: _) => {
                    ints_set(defs, d, ints_get(defs, d) + 1)
                    ints_set(def_b, d, b)
                    ints_set(def_s, d, s)
                },
                _ => {},
            }
        }
    }
    for b in 0..vec_len(f.blocks) {
        let blk = vec_get(f.blocks, b)
        for s in 0..vec_len(blk.stmts) {
            let ms = mentions(vec_get(blk.stmts, s))
            for k in 0..ints_len(ms) {
                let l = ints_get(ms, k)
                if !(ints_get(def_b, l) == b && s > ints_get(def_s, l)) { ints_set(ok, l, 0) }
            }
        }
        if vec_len(blk.term) > 0 {
            let rs = term_reads(vec_get(blk.term, 0))
            for k in 0..ints_len(rs) {
                let l = ints_get(rs, k)
                if ints_get(def_b, l) != b { ints_set(ok, l, 0) }
            }
        }
    }
    let out = ints_new()
    for i in 0..n {
        let l = vec_get(f.locals, i)
        let k = class(l.ty)
        let scalar = l.ty != "Tasks" && (k == "int" || k == "bool")
        let temp = l.origin == "temp" && i >= f.params
        ints_push(out, if scalar && temp && ints_get(defs, i) == 1 && ints_get(ok, i) == 1 { 1 } else { 0 })
    }
    out
}

// --- functions and units ------------------------------------------------------------------------

// --- type helpers -------------------------------------------------------------------------------

/// A type's name in a helper's symbol (`Lw::type_name`): a record's or enum's native type name,
/// a vector's or a generic channel's element key, an array's length and element.
fn type_name(lo: Lo, t: Str) -> Str {
    let s = spell(t)
    if s.kind == "record" || s.kind == "enum" {
        let module = s.module
        let base = if str_len(module) > 0 && str_byte(module, 0) == 35 {
            "nz.tu." + str_slice(module, 1, str_len(module)) + "." + encode(s.name)
        } else {
            "nz.t." + encode(module) + "." + encode(s.name)
        }
        if strs_len(s.args) == 0 { return base }
        let keys = strs_new()
        for a in s.args { strs_push(keys, tkey(a)) }
        let joined = str_join(keys, ",")
        let spelled = encode(joined)
        return base + (if str_len(spelled) <= 512 { ".g." + spelled } else { ".d." + blake3_hex(bytes_from_str(joined)) })
    }
    if s.kind == "array" { return "arr" + strs_get(s.args, 1) + "." + type_name(lo, strs_get(s.args, 0)) }
    if s.kind == "vec" && s.head != "Chan" { return "vec." + encode(tkey(strs_get(s.args, 0))) }
    if s.kind == "unknown" { return "a function value" }
    // A generic channel's, by its element's key as a vector's is (6.3.6).
    if s.head == "Chan" && strs_len(s.args) > 0 { return "chan." + encode(tkey(strs_get(s.args, 0))) }
    let k = class(t)
    if k == "int" { return "Int" }
    if k == "str" { return "Str" }
    if k == "bool" || k == "num" { return t }
    if t == "Ints" || t == "Strs" || t == "Chan" { return t }
    t
}

/// A type as LIR's `Ty::name` says it, in a helper's comment.
fn ty_word(t: Str) -> Str {
    let s = spell(t)
    let k = class(t)
    if k == "record" { return "a record" }
    if k == "enum" { return "an enum" }
    if k == "array" { return "an array" }
    if k == "int" { return "Int" }
    if k == "str" { return "Str" }
    if k == "bool" || k == "num" { return t }
    if t == "Ints" || t == "Strs" || t == "Chan" { return t }
    if s.head == "Chan" { return "a `Chan[T]`" }
    if s.kind == "vec" { return "a `Vec`" }
    "a function value"
}

/// The helper `what` (`ret`, `rel`, `vel`) for `t`: its symbol, asked for once.
fn helper(lo: Lo, what: Str, t: Str) -> Int {
    // Keyed by its symbol: a `Box`, `Chain` or `Cell` is its `Vec`, one helper for all of them.
    let name = "nz.h." + what + "." + (if what == "clo" { t } else { type_name(lo, t) })
    match hashmap_get(lo.helpers, name) {
        Some(h) => { return h },
        None => {},
    }
    let params = if what == "ret" || what == "hash" || what == "clo" { "(ptr)" } else { "(ptr, ptr)" }
    let ret = if what == "eq" { " -> bit" } else if what == "ord" || what == "hash" { " -> i64" } else { "" }
    let sym = symbol(lo, name, "local", "func", "plain " + params + ret, sig_ret(ret), false)
    hashmap_set(lo.helpers, name, sym)
    strs_push(lo.pending, what + "|" + t)
    sym
}

fn release_queue(fx: Fx) -> Int {
    let q = ints_get(fx.reg, 2)
    if q >= 0 { q } else { null(fx) }
}

fn ints_of4(a: Int, b: Int, c: Int, d: Int) -> Ints {
    let out = ints_of3(a, b, c)
    ints_push(out, d)
    out
}

fn one_owned(fx: Fx, a: Int, t: Str, retain: Bool) {
    if retain { retain_at(fx, a, t); } else { release_at(fx, a, t); }
}

/// Retain or release what a value of `t` at `a` owns, field by field.
fn each_owned(fx: Fx, a: Int, t: Str, retain: Bool) {
    let lx = fx.lo.lx
    let k = class(t)
    if k == "record" {
        let fs = record_fields(lx, t)
        let st = structure(lx, fs)
        for i in 0..strs_len(fs) {
            let ft = strs_get(fs, i)
            if owns_ty(fx, ft) {
                let at_ = ptr_off(fx, a, ints_get(st, i))
                one_owned(fx, at_, ft, retain);
            }
        }
    } else if k == "enum" {
        let tg = load(fx, "i64", a, 0)
        let done = new_lblock(fx.fb)
        let cases = strs_new()
        let arms = ints_new()
        let arm_variants = ints_new()
        let order = enum_variants(lx, t)
        for tagno in 0..ints_len(order) {
            let v = ints_get(order, tagno)
            let mut any = false
            for f in variant_fields(lx, t, v) { if owns_ty(fx, f) { any = true } }
            if any {
                let blk = new_lblock(fx.fb)
                strs_push(cases, int_to_str(tagno) + ": b" + int_to_str(blk))
                ints_push(arms, blk)
                ints_push(arm_variants, v)
            }
        }
        term(fx.fb, "switch " + vn(tg) + " [" + str_join(cases, ", ") + "] else b" + int_to_str(done));
        for i in 0..ints_len(arms) {
            switch_to(fx.fb, ints_get(arms, i));
            let v = ints_get(arm_variants, i)
            let fs = variant_fields(lx, t, v)
            let st = structure(lx, fs)
            for j in 0..strs_len(fs) {
                let ft = strs_get(fs, j)
                if owns_ty(fx, ft) {
                    let at_ = ptr_off(fx, a, 8 + ints_get(st, j))
                    one_owned(fx, at_, ft, retain);
                }
            }
            jump(fx, done);
        }
        switch_to(fx.fb, done);
    } else if k == "array" {
        let s = spell(t)
        let elem = strs_get(s.args, 0)
        if !owns_ty(fx, elem) { return }
        let len = match text_parse_int(strs_get(s.args, 1)) { Ok(v) => v, Err(e) => 0 }
        let stride = size_of(fx, elem)
        let n = iconst(fx, len)
        let i = new_var(fx.fb, "i64")
        let z = iconst(fx, 0)
        set_var(fx, i, z);
        let head = new_lblock(fx.fb)
        let body = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        jump(fx, head);
        switch_to(fx.fb, head);
        let iv = get_var(fx, i)
        let more = cmp(fx, "lt", iv, n)
        branch(fx, more, body, done);
        switch_to(fx.fb, body);
        let iv2 = get_var(fx, i)
        let kk = iconst(fx, stride)
        let off = bin(fx, "mul", iv2, kk)
        let at_ = ptr_add(fx, a, off)
        one_owned(fx, at_, elem, retain);
        let iv3 = get_var(fx, i)
        let step = add_imm(fx, iv3, 1)
        set_var(fx, i, step);
        jump(fx, head);
        switch_to(fx.fb, done);
    } else {
        one_owned(fx, a, t, retain);
    }
}

// --- equality, order and hash (`helpers.rs`) ----------------------------------------------------

/// Continue if `same` holds; jump to `differ` if not.
fn next_if(fx: Fx, same: Int, differ: Int) {
    let cont = new_lblock(fx.fb)
    branch(fx, same, cont, differ);
    switch_to(fx.fb, cont);
}

fn variant_name_of(lx: Lx, t: Str, v: Int) -> Str {
    sval(lx.c, at(lx.c, kid(lx.c, def_node(lx, t), "variants"), v), "name")
}

/// Continue if the values of type `t` at `a` and `b` are equal; jump to `differ` if not.
fn equal(fx: Fx, a: Int, b: Int, t: Str, differ: Int) {
    let lx = fx.lo.lx
    let k = class(t)
    let s = spell(t)
    if k == "int" || k == "bool" {
        let x = load(fx, mclass(t), a, 0)
        let y = load(fx, mclass(t), b, 0)
        next_if(fx, cmp(fx, "eq", x, y), differ);
    } else if k == "num" {
        // A number's equality is its kind's: IEEE 754's for a float.
        let x = load(fx, mclass(t), a, 0)
        let y = load(fx, mclass(t), b, 0)
        next_if(fx, num_compare(fx, "==", t, x, y), differ);
    } else if k == "str" {
        next_if(fx, string_equal(fx, a, b), differ);
    } else if k == "record" {
        let fs = record_fields(lx, t)
        let st = structure(lx, fs)
        for i in 0..strs_len(fs) {
            let x = ptr_off(fx, a, ints_get(st, i))
            let y = ptr_off(fx, b, ints_get(st, i))
            field_equal(fx, x, y, strs_get(fs, i), differ);
        }
    } else if k == "enum" {
        let ta = load(fx, "i64", a, 0)
        let tb = load(fx, "i64", b, 0)
        next_if(fx, cmp(fx, "eq", ta, tb), differ);
        let equal_blk = new_lblock(fx.fb)
        let cases = strs_new()
        let arms = ints_new()
        let arm_v = ints_new()
        let order_ = enum_variants(lx, t)
        for tagno in 0..ints_len(order_) {
            let v = ints_get(order_, tagno)
            if strs_len(variant_fields(lx, t, v)) > 0 {
                let blk = new_lblock(fx.fb)
                strs_push(cases, int_to_str(tagno) + ": b" + int_to_str(blk))
                ints_push(arms, blk)
                ints_push(arm_v, v)
            }
        }
        term(fx.fb, "switch " + vn(ta) + " [" + str_join(cases, ", ") + "] else b" + int_to_str(equal_blk));
        for i in 0..ints_len(arms) {
            switch_to(fx.fb, ints_get(arms, i));
            let fs = variant_fields(lx, t, ints_get(arm_v, i))
            let st = structure(lx, fs)
            for j in 0..strs_len(fs) {
                let x = ptr_off(fx, a, 8 + ints_get(st, j))
                let y = ptr_off(fx, b, 8 + ints_get(st, j))
                field_equal(fx, x, y, strs_get(fs, j), differ);
            }
            jump(fx, equal_blk);
        }
        switch_to(fx.fb, equal_blk);
    } else if k == "array" {
        let elem = strs_get(s.args, 0)
        let len = array_len(s.args)
        let stride = size_of(fx, elem)
        let i = new_var(fx.fb, "i64")
        let zero = iconst(fx, 0)
        set_var(fx, i, zero);
        let head = new_lblock(fx.fb)
        let body = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        jump(fx, head);
        switch_to(fx.fb, head);
        let iv = get_var(fx, i)
        let more = cmp_imm(fx, "lt", iv, "i64", len)
        branch(fx, more, body, done);
        switch_to(fx.fb, body);
        let iv2 = get_var(fx, i)
        let kk = iconst(fx, stride)
        let off = bin(fx, "mul", iv2, kk)
        let x = ptr_add(fx, a, off)
        let y = ptr_add(fx, b, off)
        field_equal(fx, x, y, elem, differ);
        let iv3 = get_var(fx, i)
        let step = add_imm(fx, iv3, 1)
        set_var(fx, i, step);
        jump(fx, head);
        switch_to(fx.fb, done);
    } else if s.kind == "vec" && s.head != "Chan" {
        // A `Box` or `Chain`, a `Vec` underneath: one storage is equal to itself; otherwise the
        // lengths, then element by element.
        let elem = strs_get(s.args, 0)
        let ha = load(fx, "ptr", a, 0)
        let hb = load(fx, "ptr", b, 0)
        let done = new_lblock(fx.fb)
        let walk = new_lblock(fx.fb)
        let one = cmp(fx, "eq", ha, hb)
        branch(fx, one, done, walk);
        switch_to(fx.fb, walk);
        let la = load(fx, "i64", ha, 0)
        let lb = load(fx, "i64", hb, 0)
        next_if(fx, cmp(fx, "eq", la, lb), differ);
        let da = load(fx, "ptr", ha, 16)
        let db = load(fx, "ptr", hb, 16)
        let stride = size_of(fx, elem)
        let i = new_var(fx.fb, "i64")
        let zero = iconst(fx, 0)
        set_var(fx, i, zero);
        let head = new_lblock(fx.fb)
        let body = new_lblock(fx.fb)
        jump(fx, head);
        switch_to(fx.fb, head);
        let iv = get_var(fx, i)
        let more = cmp(fx, "lt", iv, la)
        branch(fx, more, body, done);
        switch_to(fx.fb, body);
        let iv2 = get_var(fx, i)
        let kk = iconst(fx, stride)
        let off = bin(fx, "mul", iv2, kk)
        let x = ptr_add(fx, da, off)
        let y = ptr_add(fx, db, off)
        field_equal(fx, x, y, elem, differ);
        let iv3 = get_var(fx, i)
        let step = add_imm(fx, iv3, 1)
        set_var(fx, i, step);
        jump(fx, head);
        switch_to(fx.fb, done);
    } else {
        // No equality exists for a handle; the checker refuses the comparison.
        jump(fx, differ);
        let dead = new_lblock(fx.fb)
        switch_to(fx.fb, dead);
    }
}

fn field_equal(fx: Fx, x: Int, y: Int, t: Str, differ: Int) {
    let k = class(t)
    if k == "record" || k == "enum" {
        let h = helper(fx.lo, "eq", t)
        next_if(fx, call(fx, h, ints_of2(x, y)), differ);
    } else {
        equal(fx, x, y, t, differ);
    }
}

/// To `less` if `lt`; then, in a block of its own, the caller computes `gt`.
fn split_less(fx: Fx, lt: Int, less: Int) {
    let not_less = new_lblock(fx.fb)
    branch(fx, lt, less, not_less);
    switch_to(fx.fb, not_less);
}

fn split_greater(fx: Fx, gt: Int, greater: Int) {
    let cont = new_lblock(fx.fb)
    branch(fx, gt, greater, cont);
    switch_to(fx.fb, cont);
}

/// Continue if the values of type `t` at `a` and `b` order equal; jump to `less` or `greater`
/// if not (L6): a walk of the layout, which is the canonical order.
fn order(fx: Fx, a: Int, b: Int, t: Str, less: Int, greater: Int) {
    let lx = fx.lo.lx
    let k = class(t)
    if k == "int" || k == "bool" {
        let x = load(fx, mclass(t), a, 0)
        let y = load(fx, mclass(t), b, 0)
        // `false` before `true`: unsigned, as a bit is.
        let bitwise = k == "bool"
        split_less(fx, cmp(fx, if bitwise { "ult" } else { "lt" }, x, y), less);
        split_greater(fx, cmp(fx, if bitwise { "ugt" } else { "gt" }, x, y), greater);
    } else if k == "num" {
        let x = load(fx, mclass(t), a, 0)
        let y = load(fx, mclass(t), b, 0)
        split_less(fx, num_compare(fx, "<", t, x, y), less);
        split_greater(fx, num_compare(fx, ">", t, x, y), greater);
    } else if k == "str" {
        // By bytes: the common prefix, then the shorter first.
        let la = load(fx, "i64", a, 8)
        let lb = load(fx, "i64", b, 8)
        let m = new_var(fx.fb, "i64")
        set_var(fx, m, la);
        let shorter = new_lblock(fx.fb)
        let measured = new_lblock(fx.fb)
        let b_short = cmp(fx, "lt", lb, la)
        branch(fx, b_short, shorter, measured);
        switch_to(fx.fb, shorter);
        set_var(fx, m, lb);
        jump(fx, measured);
        switch_to(fx.fb, measured);
        let n = get_var(fx, m)
        let pa = load(fx, "ptr", a, 0)
        let pb = load(fx, "ptr", b, 0)
        let diff = rt_v(fx, "memcmp", ints_of3(pa, pb, n), "i32")
        split_less(fx, cmp_imm(fx, "lt", diff, "i32", 0), less);
        split_greater(fx, cmp_imm(fx, "gt", diff, "i32", 0), greater);
        split_less(fx, cmp(fx, "lt", la, lb), less);
        split_greater(fx, cmp(fx, "gt", la, lb), greater);
    } else if k == "record" {
        let fs = record_fields(lx, t)
        let st = structure(lx, fs)
        for i in 0..strs_len(fs) {
            let x = ptr_off(fx, a, ints_get(st, i))
            let y = ptr_off(fx, b, ints_get(st, i))
            field_order(fx, x, y, strs_get(fs, i), less, greater);
        }
    } else if k == "enum" {
        // The tag is the canonical position, by name.
        let ta = load(fx, "i64", a, 0)
        let tb = load(fx, "i64", b, 0)
        split_less(fx, cmp(fx, "lt", ta, tb), less);
        split_greater(fx, cmp(fx, "gt", ta, tb), greater);
        let tied = new_lblock(fx.fb)
        let cases = strs_new()
        let arms = ints_new()
        let arm_v = ints_new()
        let order_ = enum_variants(lx, t)
        for tagno in 0..ints_len(order_) {
            let v = ints_get(order_, tagno)
            if strs_len(variant_fields(lx, t, v)) > 0 {
                let blk = new_lblock(fx.fb)
                strs_push(cases, int_to_str(tagno) + ": b" + int_to_str(blk))
                ints_push(arms, blk)
                ints_push(arm_v, v)
            }
        }
        term(fx.fb, "switch " + vn(ta) + " [" + str_join(cases, ", ") + "] else b" + int_to_str(tied));
        for i in 0..ints_len(arms) {
            switch_to(fx.fb, ints_get(arms, i));
            let fs = variant_fields(lx, t, ints_get(arm_v, i))
            let st = structure(lx, fs)
            for j in 0..strs_len(fs) {
                let x = ptr_off(fx, a, 8 + ints_get(st, j))
                let y = ptr_off(fx, b, 8 + ints_get(st, j))
                field_order(fx, x, y, strs_get(fs, j), less, greater);
            }
            jump(fx, tied);
        }
        switch_to(fx.fb, tied);
    }
}

fn field_order(fx: Fx, x: Int, y: Int, t: Str, less: Int, greater: Int) {
    let k = class(t)
    if k == "record" || k == "enum" {
        let h = helper(fx.lo, "ord", t)
        let r = call(fx, h, ints_of2(x, y))
        split_less(fx, cmp_imm(fx, "lt", r, "i64", 0), less);
        split_greater(fx, cmp_imm(fx, "gt", r, "i64", 0), greater);
    } else {
        order(fx, x, y, t, less, greater);
    }
}

/// FNV-1a's offset and prime and the finaliser's multipliers (`nazm_sema::fnv`), as `Int`s.
fn fnv_offset() -> Int { 0 - 3750763034362895579 }
fn fnv_prime() -> Int { 1099511628211 }

/// `fnv::finish` on 64-bit words, at compile time.
fn fnv_finish_u(x: UInt64) -> UInt64 {
    let m1: UInt64 = 13787848793156543929
    let m2: UInt64 = 10723151780598845931
    let a = wrapping_mul(x ^ (x >> 30), m1)
    let b = wrapping_mul(a ^ (a >> 27), m2)
    b ^ (b >> 31)
}

/// `fnv::bytes(s)`, at compile time, as an `Int`.
fn fnv_bytes(s: Str) -> Int {
    let mut h: UInt64 = 14695981039346656037
    let prime: UInt64 = 1099511628211
    for i in 0..str_len(s) {
        h = wrapping_mul(h ^ wrap_convert[UInt64](str_byte(s, i)), prime)
    }
    wrap_convert[Int](fnv_finish_u(h))
}

/// `fnv::word(x)`, at compile time, as an `Int`.
fn fnv_word(x: Int) -> Int {
    let mut h: UInt64 = 14695981039346656037
    let prime: UInt64 = 1099511628211
    let mut w = wrap_convert[UInt64](x)
    let byte: UInt64 = 255
    for i in 0..8 {
        h = wrapping_mul(h ^ (w & byte), prime)
        w = w >> 8
    }
    wrap_convert[Int](fnv_finish_u(h))
}

/// `hash_finish`, as instructions.
fn mix_finish(fx: Fx, x0: Int) -> Int {
    let mut x = x0
    let shifts = ints_of3(30, 27, 31)
    let muls = ints_of2(0 - 4658895280553007687, 0 - 7723592293110705685)
    for i in 0..3 {
        let s = iconst(fx, ints_get(shifts, i))
        let hi = bin(fx, "lshr", x, s)
        x = bin(fx, "xor", x, hi)
        if i < 2 {
            let m = iconst(fx, ints_get(muls, i))
            x = bin(fx, "mul", x, m)
        }
    }
    x
}

/// `hash_u64` of a 64-bit value, as instructions: eight bytes, least significant first.
fn hash_word(fx: Fx, x: Int) -> Int {
    let mut h = iconst(fx, fnv_offset())
    let prime = iconst(fx, fnv_prime())
    let byte = iconst(fx, 255)
    let eight = iconst(fx, 8)
    let mut w = x
    for i in 0..8 {
        let low = bin(fx, "and", w, byte)
        let mixed = bin(fx, "xor", h, low)
        h = bin(fx, "mul", mixed, prime)
        w = bin(fx, "lshr", w, eight)
    }
    mix_finish(fx, h)
}

fn mix_combine(fx: Fx, a: Int, b: Int) -> Int {
    let prime = iconst(fx, fnv_prime())
    let m = bin(fx, "mul", a, prime)
    let s = bin(fx, "add", m, b)
    mix_finish(fx, s)
}

/// The derived hash of the value of type `t` at `a` (L6).
fn hash_of(fx: Fx, a: Int, t: Str) -> Int {
    let lx = fx.lo.lx
    let k = class(t)
    if t == "Int" || k == "int" && t != "Bool" && !is_num(t) {
        return hash_word(fx, load(fx, "i64", a, 0))
    }
    if k == "bool" {
        let x = load(fx, "bit", a, 0)
        return hash_word(fx, ext(fx, "i64", x, false))
    }
    if k == "num" && mclass(t) == "i128" {
        // A 128-bit integer: its low word's hash and its high word's, combined.
        let lo0 = load(fx, "i64", a, 0)
        let hi0 = load(fx, "i64", a, 8)
        let lo = hash_word(fx, lo0)
        let hi = hash_word(fx, hi0)
        return mix_combine(fx, lo, hi)
    }
    if k == "num" {
        let x = load(fx, mclass(t), a, 0)
        let w = if mclass(t) == "i64" { x } else { ext(fx, "i64", x, is_signed(t)) }
        return hash_word(fx, w)
    }
    if k == "str" {
        let n = load(fx, "i64", a, 8)
        let p = load(fx, "ptr", a, 0)
        let h = new_var(fx.fb, "i64")
        let start = iconst(fx, fnv_offset())
        set_var(fx, h, start);
        let i = new_var(fx.fb, "i64")
        let zero = iconst(fx, 0)
        set_var(fx, i, zero);
        let head = new_lblock(fx.fb)
        let body = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        jump(fx, head);
        switch_to(fx.fb, head);
        let iv = get_var(fx, i)
        let more = cmp(fx, "lt", iv, n)
        branch(fx, more, body, done);
        switch_to(fx.fb, body);
        let iv2 = get_var(fx, i)
        let at_ = ptr_add(fx, p, iv2)
        let b0 = load(fx, "i8", at_, 0)
        let b = ext(fx, "i64", b0, false)
        let hv = get_var(fx, h)
        let mixed = bin(fx, "xor", hv, b)
        let prime = iconst(fx, fnv_prime())
        let next_h = bin(fx, "mul", mixed, prime)
        set_var(fx, h, next_h);
        let step = add_imm(fx, iv2, 1)
        set_var(fx, i, step);
        jump(fx, head);
        switch_to(fx.fb, done);
        let hv2 = get_var(fx, h)
        return mix_finish(fx, hv2)
    }
    if k == "record" {
        let mut h = iconst(fx, fnv_word(0))
        let fs = record_fields(lx, t)
        let st = structure(lx, fs)
        for i in 0..strs_len(fs) {
            let x = ptr_off(fx, a, ints_get(st, i))
            let fh = field_hash(fx, x, strs_get(fs, i))
            h = mix_combine(fx, h, fh)
        }
        return h
    }
    if k == "enum" {
        let out = new_var(fx.fb, "i64")
        let zero = iconst(fx, 0)
        set_var(fx, out, zero);
        let tag = load(fx, "i64", a, 0)
        let done = new_lblock(fx.fb)
        let cases = strs_new()
        let arms = ints_new()
        let order_ = enum_variants(lx, t)
        for tagno in 0..ints_len(order_) {
            let blk = new_lblock(fx.fb)
            strs_push(cases, int_to_str(tagno) + ": b" + int_to_str(blk))
            ints_push(arms, blk)
        }
        term(fx.fb, "switch " + vn(tag) + " [" + str_join(cases, ", ") + "] else b" + int_to_str(done));
        for tagno in 0..ints_len(order_) {
            switch_to(fx.fb, ints_get(arms, tagno));
            let v = ints_get(order_, tagno)
            let mut h = iconst(fx, fnv_bytes(variant_name_of(lx, t, v)))
            let fs = variant_fields(lx, t, v)
            let st = structure(lx, fs)
            for j in 0..strs_len(fs) {
                let x = ptr_off(fx, a, 8 + ints_get(st, j))
                let fh = field_hash(fx, x, strs_get(fs, j))
                h = mix_combine(fx, h, fh)
            }
            set_var(fx, out, h);
            jump(fx, done);
        }
        switch_to(fx.fb, done);
        return get_var(fx, out)
    }
    // Nothing else hashes by derivation; the checker refuses it.
    iconst(fx, 0)
}

fn field_hash(fx: Fx, x: Int, t: Str) -> Int {
    let k = class(t)
    if k == "record" || k == "enum" {
        let h = helper(fx.lo, "hash", t)
        return call(fx, h, ints_of(x))
    }
    hash_of(fx, x, t)
}

fn helper_fx(lo: Lo) -> Fx {
    let reg = ints_new()
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    let at = strs_new()
    strs_push(at, "")
    Fx(lo: lo, fb: fb_new(), f: vec_get(lo.p.fns, 0), kinds: strs_new(), idx: ints_new(), tys: strs_new(),
        promoted: ints_new(), blocks: ints_new(), reg: reg, at: at)
}

/// A helper's function (`helpers::define`).
fn define_helper(lo: Lo, key: Str) -> Str {
    let bar = match text_find(key, "|") { Some(i) => i, None => 0 }
    let what = str_slice(key, 0, bar)
    let t = str_slice(key, bar + 1, str_len(key))
    let sym = match hashmap_get(lo.helpers, "nz.h." + what + "." + (if what == "clo" { t } else { type_name(lo, t) })) { Some(h) => h, None => 0 }
    let fx = helper_fx(lo)
    let a = param(fx, 0)
    if what == "rel" || what == "vel" { ints_set(fx.reg, 2, param(fx, 1)) }
    let mut name = ""
    if what == "ret" || what == "rel" {
        let retain = what == "ret"
        each_owned(fx, a, t, retain);
        term(fx.fb, "return");
        name = (if retain { "retain" } else { "release" }) + " of " + ty_word(t)
    } else if what == "vel" {
        if in_memory(t) {
            release_at(fx, a, t);
        } else {
            let v = load(fx, "ptr", a, 0)
            release_value(fx, v, t);
        }
        term(fx.fb, "return");
        name = "release of one " + ty_word(t)
    } else if what == "eq" {
        let b = param(fx, 1)
        let differ = new_lblock(fx.fb)
        equal(fx, a, b, t, differ);
        let yes = bit(fx, true)
        term(fx.fb, "return " + vn(yes));
        switch_to(fx.fb, differ);
        let no = bit(fx, false)
        term(fx.fb, "return " + vn(no));
        name = "equality of " + ty_word(t)
    } else if what == "ord" {
        let b = param(fx, 1)
        let less = new_lblock(fx.fb)
        let greater = new_lblock(fx.fb)
        order(fx, a, b, t, less, greater);
        let zero = iconst(fx, 0)
        term(fx.fb, "return " + vn(zero));
        switch_to(fx.fb, less);
        let minus = iconst(fx, 0 - 1)
        term(fx.fb, "return " + vn(minus));
        switch_to(fx.fb, greater);
        let one = iconst(fx, 1)
        term(fx.fb, "return " + vn(one));
        name = "order of " + ty_word(t)
    } else if what == "hash" {
        let h = hash_of(fx, a, t)
        term(fx.fb, "return " + vn(h));
        name = "hash of " + ty_word(t)
    } else if what == "clo" {
        let f = vec_get(lo.p.fns, match text_parse_int(t) { Ok(v) => v, Err(e) => 0 })
        let carried = carried_of(lo, f)
        let offs = closure_layout(fx, carried)
        for i in 0..strs_len(carried) {
            let ct = strs_get(carried, i)
            if owns_ty(fx, ct) {
                let at_ = ptr_off(fx, a, ints_get(offs, i))
                release_at(fx, at_, ct);
            }
        }
        term(fx.fb, "return");
        name = "a closure object's release"
    } else {
        defect(lo, "the helper `" + what + "` (not ported yet)");
    }
    finish(lo, fx.fb, sym, name)
}

/// The blocks whose terminator closes a loop (performance leadership 6.3), as `loop_latches` in
/// `crates/nazm-lir/src/op/func.rs`: an edge to a block still on the depth-first path from the
/// entry; 1 for such a block. MIR's loops are structured, so the set does not depend on the order
/// successors are taken in.
fn loop_latches(f: MirFn) -> Ints {
    let n = vec_len(f.blocks)
    let latch = ints_new()
    let state = ints_new()
    for i in 0..n {
        ints_push(latch, 0)
        ints_push(state, 0)
    }
    if n == 0 { return latch }
    // The path: each block on it, and how many of its successors have been taken.
    let path = ints_new()
    let taken = ints_new()
    ints_push(path, 0)
    ints_push(taken, 0)
    ints_set(state, 0, 1)
    while ints_len(path) > 0 {
        let top = ints_len(path) - 1
        let b = ints_get(path, top)
        let k = ints_get(taken, top)
        let blk = vec_get(f.blocks, b)
        let succ = if vec_len(blk.term) > 0 { successors(vec_get(blk.term, 0)) } else { ints_new() }
        if k < ints_len(succ) {
            ints_set(taken, top, k + 1)
            let x = ints_get(succ, k)
            let st = ints_get(state, x)
            if st == 0 {
                ints_set(state, x, 1)
                ints_push(path, x)
                ints_push(taken, 0)
            } else if st == 1 {
                ints_set(latch, b, 1)
            }
        } else {
            ints_set(state, b, 2)
            let p1 = ints_pop(path)
            let t1 = ints_pop(taken)
        }
    }
    latch
}

fn lower_fn(lo: Lo, fi: Int, sym: Int) -> Str {
    let f = vec_get(lo.p.fns, fi)
    let reg = ints_new()
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    let at = strs_new()
    strs_push(at, "")
    // Where a large frame's check names, once a stack check finds the frame large.
    strs_push(at, "")
    let fx = Fx(lo: lo, fb: fb_new(), f: f, kinds: strs_new(), idx: ints_new(), tys: strs_new(), promoted: ints_new(),
        blocks: ints_new(), reg: reg, at: at)
    let prom = promotable(f)
    let borrowed_at: HashMap[Int, Int] = hashmap_new()
    let mut next_param = 0
    if in_memory(f.ret) {
        ints_set(fx.reg, 0, param(fx, 0))
        next_param = 1
    }
    for i in 0..vec_len(f.locals) {
        let l = vec_get(f.locals, i)
        let is_param = i < f.params
        strs_push(fx.tys, l.ty)
        ints_push(fx.promoted, 0 - 1)
        if l.ty == "Tasks" {
            let v = new_var(fx.fb, "ptr")
            let z = iconst_c(fx, "ptr", 0)
            set_var(fx, v, z);
            strs_push(fx.kinds, "tasks")
            ints_push(fx.idx, v)
        } else if in_memory(l.ty) {
            if is_param {
                let p = param(fx, next_param)
                next_param += 1
                // Where a debugger finds it: its address, in a variable of its own.
                if lo.debug {
                    let v = new_var(fx.fb, "ptr")
                    set_var(fx, v, p);
                    hashmap_set(borrowed_at, i, v)
                }
                strs_push(fx.kinds, "borrowed")
                ints_push(fx.idx, p)
            } else {
                let ly = lay(lo.lx, l.ty)
                let s = new_slot(fx.fb, ly.size, if ly.align < 8 { 8 } else { ly.align })
                if owns_ty(fx, l.ty) {
                    let a = slot_addr(fx, s)
                    zero(fx, a, ly.size);
                }
                strs_push(fx.kinds, "slot")
                ints_push(fx.idx, s)
            }
        } else if ints_get(prom, i) == 1 {
            strs_push(fx.kinds, "value")
            ints_push(fx.idx, 0 - 1)
        } else {
            let v = new_var(fx.fb, mclass(l.ty))
            let init = if is_param {
                let p = param(fx, next_param)
                next_param += 1
                p
            } else {
                iconst_c(fx, mclass(l.ty), 0)
            }
            set_var(fx, v, init);
            strs_push(fx.kinds, "var")
            ints_push(fx.idx, v)
        }
        if lo.debug { debug_var(fx, i, l, borrowed_at); }
    }
    for b in f.blocks { ints_push(fx.blocks, new_lblock(fx.fb)) }
    if ints_len(fx.blocks) > 0 { jump(fx, ints_get(fx.blocks, 0)) }
    let latches = loop_latches(f)
    for i in 0..vec_len(f.blocks) {
        let blk = vec_get(f.blocks, i)
        switch_to(fx.fb, ints_get(fx.blocks, i));
        for k in 0..vec_len(blk.stmts) {
            let s = vec_get(blk.stmts, k)
            strs_set(fx.at, 0, strs_get(blk.ats, k))
            locate(fx)
            let u = stmt_unwind(s)
            ints_set(fx.reg, 1, if u >= 0 { ints_get(fx.blocks, u) } else { 0 - 1 })
            statement(fx, s);
        }
        strs_set(fx.at, 0, if strs_len(blk.term_at) > 0 { strs_get(blk.term_at, 0) } else { "" })
        locate(fx)
        // A loop's back edge polls for preemption (performance leadership 6.3).
        if ints_get(latches, i) != 0 { rt(fx, "nz.preempt", ints_new()) }
        if vec_len(blk.term) > 0 { terminator(fx, vec_get(blk.term, 0)) }
    }
    if lo.debug {
        let p = loc_of(lo, fn_span(fx))
        if p != "" {
            let parts = text_split(p, " ")
            strs_push(fx.fb.at_line, "  at " + strs_get(parts, 0) + " " + strs_get(parts, 1))
        }
    }
    let frame_at = strs_get(fx.at, 1)
    let section = if f.node >= 0 { sval(lo.c, kid(lo.c, f.node, "attributes"), "section") } else { "" }
    if frame_at == "" { return finish_in(lo, fx.fb, sym, f.name, section) }
    // A large frame is checked before it exists (Q1-A1-01): the body moves to a symbol of its
    // own, and the function's symbol becomes an entry that asks for room for the body's frame.
    let frame = frame_size(fx.fb)
    let sig = strs_get(lo.sym_sig, sym)
    let body = symbol(lo, anonymous(lo, "frame"), "local", "func", sig, sig_ret(sig), true)
    let entry = frame_entry(lo, sym, body, frame, frame_at, section)
    entry + finish_in(lo, fx.fb, body, f.name, section)
}

/// The bytes a function's slots take, each rounded up to its alignment.
fn frame_size(fb: Fb) -> Int {
    let mut n = 0
    for i in 0..ints_len(fb.slot_sizes) {
        let a = ints_get(fb.slot_aligns, i)
        let s = ints_get(fb.slot_sizes, i)
        n += (s + a - 1) / a * a
    }
    n
}

/// A large frame's entry: its parameters passed on to its body once the thread's stack has room
/// for the body's frame, and `N0408` at the function's name when it has not.
fn frame_entry(lo: Lo, sym: Int, body: Int, frame: Int, at: Str, section: Str) -> Str {
    let fx = helper_fx(lo)
    strs_set(fx.at, 0, at)
    let sig = strs_get(lo.sym_sig, sym)
    let open_at = match text_find(sig, "(") { Some(i) => i, None => 0 }
    let close = match text_find(sig, ")") { Some(i) => i, None => 0 }
    let inner = str_slice(sig, open_at + 1, close)
    let n = if str_len(inner) == 0 { 0 } else { strs_len(text_split(inner, ", ")) }
    let args = ints_new()
    for i in 0..n { ints_push(args, param(fx, i)) }
    let need = iconst(fx, frame)
    let past = rt_v(fx, "nz.stack_check_frame", ints_of(need), "i32")
    let bad = cmp_imm(fx, "ne", past, "i32", 0)
    let failing = new_lblock(fx.fb)
    let enter = new_lblock(fx.fb)
    branch(fx, bad, failing, enter);
    switch_to(fx.fb, failing);
    let m = message(lo, "N0408", "the native call stack is exhausted", at)
    let p = addr_of(fx, ints_get(m, 0))
    let len = iconst(fx, ints_get(m, 1))
    rt(fx, "nz.fail", ints_of2(p, len))
    term(fx.fb, "fail");
    switch_to(fx.fb, enter);
    // The body's failure is the entry's (R1, 5b.8).
    let rf = call_failing(fx, body, args)
    let failed = ints_get(rf, 1)
    if failed >= 0 {
        let fails = new_lblock(fx.fb)
        let done = new_lblock(fx.fb)
        branch(fx, failed, fails, done);
        switch_to(fx.fb, fails);
        term(fx.fb, "fail");
        switch_to(fx.fb, done);
    }
    let r = ints_get(rf, 0)
    term(fx.fb, if r >= 0 { "return " + vn(r) } else { "return" });
    finish_in(lo, fx.fb, sym, "a large frame's entry", section)
}

/// An export's C entry (N55, §7.57): the C convention outside, the Nazm function inside, and a
/// failure reported and the process ended rather than a stand-in returned into C.
fn export_entry(lo: Lo, fi: Int, fsym: Int) -> Str {
    let g = vec_get(lo.p.fns, fi)
    let ps = params_of(g)
    let csig = c_sig(ps, g.ret)
    let sym = symbol(lo, g.export, "export", "func", csig, sig_ret(csig), false)
    let fx = helper_fx(lo)
    let args = ints_new()
    for i in 0..strs_len(ps) { ints_push(args, param(fx, i)) }
    let r = call(fx, fsym, args)
    let result = if r >= 0 { r } else { iconst_c(fx, c_class(g.ret), 0) }
    let f = rt_v(fx, "nz.failed_now", ints_new(), "i32")
    let bad = cmp_imm(fx, "ne", f, "i32", 0)
    let failing = new_lblock(fx.fb)
    let done = new_lblock(fx.fb)
    branch(fx, bad, failing, done);
    switch_to(fx.fb, failing);
    rt(fx, "nz.report", ints_new())
    term(fx.fb, "unreachable");
    switch_to(fx.fb, done);
    term(fx.fb, "return " + vn(result));
    finish(lo, fx.fb, sym, "an export's C entry")
}

fn plain_entry(lo: Lo, sym: Int, body: Int) -> Str {
    let reg = ints_new()
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    ints_push(reg, 0 - 1)
    let at = strs_new()
    strs_push(at, "")
    let fx = Fx(lo: lo, fb: fb_new(), f: vec_get(lo.p.fns, 0), kinds: strs_new(), idx: ints_new(), tys: strs_new(),
        promoted: ints_new(), blocks: ints_new(), reg: reg, at: at)
    let sig = strs_get(lo.sym_sig, sym)
    let open_at = match text_find(sig, "(") { Some(i) => i, None => 0 }
    let close = match text_find(sig, ")") { Some(i) => i, None => 0 }
    let inner = str_slice(sig, open_at + 1, close)
    let n = if str_len(inner) == 0 { 0 } else { strs_len(text_split(inner, ", ")) }
    let args = ints_new()
    for i in 0..n { ints_push(args, param(fx, i)) }
    let r = call(fx, body, args)
    term(fx.fb, if r >= 0 { "return " + vn(r) } else { "return" });
    finish(lo, fx.fb, sym, "a plain entry")
}

fn print_module(lo: Lo) -> Str {
    let lines = strs_new()
    strs_push(lines, "; unit " + lo.unit.module)
    for i in 0..strs_len(lo.sym_name) {
        let k = strs_get(lo.sym_kind, i)
        strs_push(lines, strs_get(lo.sym_link, i) + " " + k + " @" + strs_get(lo.sym_name, i) + " " + strs_get(lo.sym_sig, i))
    }
    for d in lo.datas { strs_push(lines, d) }
    str_join(lines, "\n") + "\n" + str_join(lo.functions, "")
}

fn lower_unit(c: Cir, lx: Lx, p: MirProgram, u: UnitPlan, runtime: HashMap[Str, Str], parts: HashMap[Str, Str], needs: HashMap[Str, Bool], sources: HashMap[Str, Str], debug: Bool, files: HashMap[Str, Int], paths: HashMap[Int, Str]) -> Result[Str, Str] {
    let anon = ints_new()
    ints_push(anon, 0)
    let lo = Lo(lx: lx, c: c, p: p, unit: u, sym_name: strs_new(), sym_link: strs_new(), sym_kind: strs_new(), sym_sig: strs_new(),
        sym_ret: strs_new(), sym_fails: ints_new(), by_name: hashmap_new(), datas: strs_new(), functions: strs_new(), anon: anon,
        messages: hashmap_new(), blobs: hashmap_new(), strvals: hashmap_new(), funcs: hashmap_new(), plain: hashmap_new(),
        runtime: runtime, parts: parts, needs: needs, debug: debug, files: files, paths: paths, sources: sources, errors: strs_new(), helpers: hashmap_new(), pending: strs_new(),
        tramps: ints_new(), tramp_tys: vec_new(), tramp_offs: vec_new(), cellvals: hashmap_new())
    declare_functions(lo)
    define_statics(lo)
    for i in 0..ints_len(u.fns) {
        let fi = ints_get(u.fns, i)
        match hashmap_get(lo.funcs, fi) {
            Some(sym) => {
                strs_push(lo.functions, lower_fn(lo, fi, sym))
                match hashmap_get(lo.plain, fi) {
                    Some(ps) => { strs_push(lo.functions, plain_entry(lo, ps, sym)); },
                    None => {},
                }
                // An export's C entry, beside the function it calls (N55).
                let g = vec_get(p.fns, fi)
                if g.export != "" { strs_push(lo.functions, export_entry(lo, fi, sym)); }
            },
            None => {},
        }
    }
    // Helpers ask for helpers, and trampolines for helpers: a worklist, each defined once,
    // every pending helper before the next trampoline.
    let mut done = 0
    let mut tdone = 0
    while done < strs_len(lo.pending) || tdone < vec_len(lo.tramp_tys) {
        if done < strs_len(lo.pending) {
            let key = strs_get(lo.pending, done)
            done += 1
            strs_push(lo.functions, define_helper(lo, key));
        } else {
            strs_push(lo.functions, trampoline(lo, tdone));
            tdone += 1
        }
    }
    if strs_len(lo.errors) > 0 { return Err(strs_get(lo.errors, 0)) }
    Ok(print_module(lo))
}

/// Every unit's instruction text, in `unit_plans` order.
pub fn lir_texts(c: Cir, tt: TypeTable, p: MirProgram) -> Result[Strs, Str] ! {} {
    lir_texts_needs(c, tt, p, hashmap_new())
}

/// `lir_texts`, noting what of the runtime the units reach.
pub fn lir_texts_needs(c: Cir, tt: TypeTable, p: MirProgram, needs: HashMap[Str, Bool]) -> Result[Strs, Str] ! {} {
    lir_texts_with(c, tt, p, needs, false)
}

/// `lir_texts`, noting in `needs` what of the runtime the units reach (`Needs`, by name); with
/// `debug`, as `nazm lir --ops --debug`, each unit followed by the names of the files its
/// positions name (`; file INDEX PATH`).
pub fn lir_texts_with(c: Cir, tt: TypeTable, p: MirProgram, needs: HashMap[Str, Bool], debug: Bool) -> Result[Strs, Str] ! {} {
    if p.entry < 0 { return Err("this program has no `main` to compile") }
    let lx = lx_new(c, tt, p)
    let runtime: HashMap[Str, Str] = hashmap_new()
    for row in text_split(runtime_table(), "\n") {
        match text_find(row, "|") {
            Some(i) => { hashmap_set(runtime, str_slice(row, 0, i), str_slice(row, i + 1, str_len(row))); },
            None => {},
        }
    }
    let parts: HashMap[Str, Str] = hashmap_new()
    for row in text_split(runtime_parts(), "\n") {
        match text_find(row, "|") {
            Some(i) => { hashmap_set(parts, str_slice(row, 0, i), str_slice(row, i + 1, str_len(row))); },
            None => {},
        }
    }
    let sources: HashMap[Str, Str] = hashmap_new()
    let files: HashMap[Str, Int] = hashmap_new()
    let paths: HashMap[Int, Str] = hashmap_new()
    let mods = kid(c, json_root(c.doc), "modules")
    for i in 0..count(c, mods) {
        let m = at(c, mods, i)
        hashmap_set(sources, sval(c, m, "name"), sval(c, m, "source"))
        let fi = ival(c, m, "file")
        hashmap_set(files, sval(c, m, "name"), fi)
        hashmap_set(paths, fi, sval(c, m, "path"))
    }
    let out = strs_new()
    for u in unit_plans(c, p) {
        match lower_unit(c, lx, p, u, runtime, parts, needs, sources, debug, files, paths) {
            Ok(t) => { strs_push(out, if debug { t + file_names(t, paths) } else { t }); },
            Err(e) => { return Err(e) },
        }
    }
    Ok(out)
}

/// The files a unit's positions name, by index, as the backends' debug information names them.
fn file_names(t: Str, paths: HashMap[Int, Str]) -> Str {
    let seen: HashMap[Int, Bool] = hashmap_new()
    let ids = ints_new()
    for line in text_lines(t) {
        let at = text_starts_with(line, "  at ")
        if at || text_starts_with(line, "  loc ") {
            let rest = str_slice(line, if at { 5 } else { 6 }, str_len(line))
            let sp = match text_find(rest, " ") { Some(k) => k, None => str_len(rest) }
            match text_parse_int(str_slice(rest, 0, sp)) {
                Ok(n) => {
                    if !hashmap_has(seen, n) {
                        hashmap_set(seen, n, true)
                        ints_push(ids, n)
                    }
                },
                Err(_) => {},
            }
        }
    }
    // In order of index (few: one per file a unit's functions come from).
    for i in 0..ints_len(ids) {
        for j in i + 1..ints_len(ids) {
            if ints_get(ids, j) < ints_get(ids, i) {
                let x = ints_get(ids, i)
                ints_set(ids, i, ints_get(ids, j))
                ints_set(ids, j, x)
            }
        }
    }
    let out = strs_new()
    for i in 0..ints_len(ids) {
        let n = ints_get(ids, i)
        strs_push(out, "; file " + int_to_str(n) + " " + (match hashmap_get(paths, n) { Some(p) => p, None => "" }) + "\n")
    }
    str_join(out, "")
}

/// `nazm lir --ops`: every unit's instruction text, each followed by an empty line.
pub fn lir_ops(c: Cir, tt: TypeTable, p: MirProgram) -> Result[Str, Str] ! {} {
    match lir_texts(c, tt, p) {
        Ok(ts) => {
            let out = strs_new()
            for t in ts { strs_push(out, t + "\n") }
            Ok(str_join(out, ""))
        },
        Err(e) => Err(e),
    }
}
