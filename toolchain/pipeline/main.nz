// The native pipeline in Nazm (R3): Core IR to MIR, and MIR to LIR.
//
//     pipeline mir CORE.json       print `nazm.mir/1`, as `nazm mir` does, once the validator
//                                  accepted it
//     pipeline verify CORE.json    lower and validate, and say so
//     pipeline mutants CORE.json   break one invariant at a time and check the validator says so
//     pipeline ops-debug CORE.json print `nazm lir --ops --debug`: positions, the variables a
//                                  debugger shows, the files the positions name
//     pipeline runtime CORE.json [STACK HEAP]
//                                  print the runtime's units the program links (`runtime`,
//                                  `entry`, the target's), each after a line `;;; unit NAME`:
//                                  what `nazm build` generates beside the program's units; STACK
//                                  and HEAP are `--stack-size` and `--heap-limit` in bytes, `-`
//                                  for none
//     pipeline runtime-digest      print the runtime's digest, as an object key carries it
//     pipeline objects ROOT SCRATCH TOOL CONFIG UNIT.ll ...
//                                  each LLVM unit's object key (with the backend identity TOOL
//                                  and configuration CONFIG), looked up in the store under ROOT;
//                                  a hit is published again under SCRATCH and compared with the
//                                  entry found, byte for byte
//     pipeline backend REPORT PROBE.ll PROBE.o
//                                  the backend identity and configuration a `clang -###` report
//                                  of compiling PROBE.ll describes, as the build keys objects
//     pipeline entry-check ROOT KEY
//                                  the entry filed under KEY, broken one way at a time: what the
//                                  store's reader says of each
//
// `--target TRIPLE` before any of these names the target (aarch64-apple-darwin, the default, or
// x86_64-apple-darwin), as `nazm lir --target` and `nazm build --target` do.
//
// CORE.json is `nazm core-ir --json FILE`. `openspec/changes/r3-pipeline/` is the design.

use "cir.nz"
use "types.nz"
use "program.nz"
use "text.nz"
use "verify.nz"
use "mutants.nz"
use "lir.nz"
use "ops.nz"
use "rtgen.nz"
use "objcache.nz"
use "mir.nz"
use "@std/hash"
use "@std/hashmap"
use "@std/text"
use "@std/fs"
use "@std/process"

/// The targets this pipeline lowers for: macOS on Apple silicon and on Intel (run under Rosetta
/// on an Apple silicon host), and Windows on x86_64 with MinGW (8.8). Linux, WebAssembly, WASI,
/// Android, iOS and the boards are deferred until after 1.0 by the copyright holder's decision
/// (`openspec/changes/r3-pipeline/design.md`).
fn target_supported(t: Str) -> Bool {
    t == "aarch64-apple-darwin" || t == "x86_64-apple-darwin" || t == "x86_64-pc-windows-gnu"
}

fn main(io: IoCap, v: VouchCap) -> Int ! { io } {
    let given = process_args(io)
    // `--target TRIPLE` first, as `nazm lir --target`; without it, Apple silicon's macOS.
    let mut target = "aarch64-apple-darwin"
    let mut from = 0
    if strs_len(given) >= 2 && strs_get(given, 0) == "--target" {
        target = strs_get(given, 1)
        from = 2
        if !target_supported(target) {
            eprint("pipeline: target `" + target + "` is not ported: only aarch64-apple-darwin, x86_64-apple-darwin and x86_64-pc-windows-gnu are, the others deferred until after 1.0\n")
            return 2
        }
    }
    let args = strs_new()
    for i in from..strs_len(given) { strs_push(args, strs_get(given, i)) }
    if strs_len(args) == 1 && strs_get(args, 0) == "runtime-digest" {
        print(runtime_digest() + "\n")
        return 0
    }
    if strs_len(args) >= 6 && strs_get(args, 0) == "objects" {
        return objects(io, v, args)
    }
    if strs_len(args) == 4 && strs_get(args, 0) == "backend" {
        let tc = backend_of(read_file(strs_get(args, 1)), strs_get(args, 2), strs_get(args, 3))
        print(strs_get(tc, 0) + " " + strs_get(tc, 1) + "\n")
        return 0
    }
    if strs_len(args) == 3 && strs_get(args, 0) == "entry-check" {
        return entry_check(io, v, strs_get(args, 1), strs_get(args, 2))
    }
    let first = if strs_len(args) > 0 { strs_get(args, 0) } else { "" }
    let mode = if strs_len(args) == 2 || (first == "runtime" && strs_len(args) == 4) { first } else { "" }
    if mode != "mir" && mode != "verify" && mode != "mutants" && mode != "lir" && mode != "ops" && mode != "tables" && mode != "runtime" && mode != "ops-debug" {
        eprint("usage: pipeline [--target TRIPLE] mir|lir|tables|ops|ops-debug|verify|mutants CORE.json | pipeline runtime CORE.json [STACK HEAP]\n")
        return 2
    }
    let text = match fs_read(io, strs_get(args, 1)) {
        Ok(t) => t,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    let c = match cir_read(text) {
        Ok(c) => c,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    let p = match lower_program(c) {
        Ok(p) => p,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    let tt = table_build(c)
    if mode == "mutants" {
        let lines = mutants(p, tt)
        for l in lines { print(l + "\n") }
        return if strs_len(lines) == 1 { 0 } else { 1 }
    }
    let errors = verify(p, tt)
    if strs_len(errors) > 0 {
        for e in errors { eprint("pipeline: MIR invalid: " + e + "\n") }
        return 1
    }
    if mode == "runtime" {
        let stack = if strs_len(args) == 4 { bytes_arg(strs_get(args, 2)) } else { -1 }
        let heap = if strs_len(args) == 4 { bytes_arg(strs_get(args, 3)) } else { -1 }
        let units = match runtime_of(c, tt, p, target, stack, heap) {
            Ok(u) => u,
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        let names = vec_get(units, 0)
        let texts = vec_get(units, 1)
        for i in 0..strs_len(names) { print(";;; unit " + strs_get(names, i) + "\n" + strs_get(texts, i)) }
        return 0
    }
    if mode == "ops-debug" {
        let names: HashMap[Str, Bool] = hashmap_new()
        match lir_texts_with(c, tt, p, names, true) {
            Ok(ts) => { for t in ts { print(t + "\n") } },
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        return 0
    }
    if mode == "lir" || mode == "ops" || mode == "tables" {
        let printed = if mode == "ops" { lir_ops(c, tt, p) } else if mode == "tables" { lir_document(c, tt, p, target, strs_new()) } else {
            match lir_texts(c, tt, p) {
                Ok(ts) => lir_document(c, tt, p, target, ts),
                Err(e) => Err(e),
            }
        }
        match printed {
            Ok(t) => print(if mode == "ops" { t } else { t + "\n" }),
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        return 0
    }
    if mode == "verify" {
        print(int_to_str(vec_len(p.fns)) + " functions, valid\n")
    } else {
        print(print_mir(p))
    }
    0
}

fn bytes_arg(a: Str) -> Int {
    if a == "-" { -1 } else { match text_parse_int(a) { Ok(n) => n, Err(_) => -1 } }
}

/// The runtime's units for the program (`runtime_units`): its needs are what its units reach,
/// `single` when `main` holds no authority to start a thread; the entry is `main`'s symbol with a
/// word per capability it takes, and calls C when any function does.
fn runtime_of(c: Cir, tt: TypeTable, p: MirProgram, target: Str, stack: Int, heap: Int) -> Result[Vec[Strs], Str] {
    let names: HashMap[Str, Bool] = hashmap_new()
    match lir_texts_needs(c, tt, p, names) {
        Ok(_) => {},
        Err(e) => { return Err(e) },
    }
    let main = vec_get(p.fns, p.entry)
    let mut roots = 0
    let mut single = true
    for t in params_of(main) {
        if t == "IoCap" || t == "SpawnCap" || t == "ForeignCap" || t == "VouchCap" || t == "TimeCap" || t == "MmioCap" || t == "OutCap" || t == "NetCap" || t == "RandomCap" || t == "ProcessCap" {
            roots += 1
        }
        if t == "SpawnCap" || t == "NetCap" || t == "ForeignCap" { single = false }
    }
    if single { hashmap_set(names, "single", true); }
    let mut calls_c = false
    for f in p.fns {
        if f.foreign == "" {
            let cs = callees_of(f)
            for j in 0..ints_len(cs) {
                if vec_get(p.fns, ints_get(cs, j)).foreign != "" { calls_c = true }
            }
        }
    }
    Ok(runtime_units(needs_of(names), target, "@" + symbol_of(main), roots, calls_c, stack, heap))
}

/// `pipeline objects`: each unit's key looked up, a hit published again and compared.
fn objects(io: IoCap, v: VouchCap, args: Strs) -> Int ! { io } {
    let root = strs_get(args, 1)
    let scratch = strs_get(args, 2)
    let tool = strs_get(args, 3)
    let config = strs_get(args, 4)
    let mut bad = 0
    for i in 5..strs_len(args) {
        let unit = strs_get(args, i)
        let key = object_key(llvm_input(read_file(unit)), tool, config)
        match store_get(io, v, root, key) {
            Ok(object) => {
                let mut verdict = "hit"
                match store_put(io, v, scratch, llvm_input(read_file(unit)), tool, config, object, "check") {
                    Ok(_) => {
                        if read_file(str_vouch(entry_path(scratch, key))) != read_file(str_vouch(entry_path(root, key))) {
                            verdict = "hit, but the entry written again differs"
                            bad += 1
                        }
                    },
                    Err(e) => {
                        verdict = "hit, but " + e
                        bad += 1
                    },
                }
                print(unit + " " + verdict + " " + key + "\n")
            },
            Err(e) => {
                print(unit + " " + e + " " + key + "\n")
                bad += 1
            },
        }
    }
    if bad == 0 { 0 } else { 1 }
}

/// `pipeline entry-check`: the entry under KEY, and each way of breaking it, read.
fn entry_check(io: IoCap, v: VouchCap, root: Str, key: Str) -> Int ! { io } {
    let raw = read_file(str_vouch(entry_path(root, key)))
    let nl = match text_find(raw, "\n") { Some(i) => i, None => 0 }
    let head = str_slice(raw, 0, nl)
    let body = str_slice(raw, nl, str_len(raw))
    let last = str_len(raw) - 1
    let flipped = str_slice(raw, 0, last) + (if str_byte(raw, last) == 65 { "B" } else { "A" })
    let cases = strs_new()
    let texts = strs_new()
    strs_push(cases, "whole")
    strs_push(texts, raw)
    strs_push(cases, "no header line")
    strs_push(texts, text_replace(raw, "\n", " "))
    strs_push(cases, "not JSON")
    strs_push(texts, "{" + raw)
    strs_push(cases, "another schema")
    strs_push(texts, text_replace(head, "nazm.object/1", "nazm.object/2") + body)
    strs_push(cases, "a key not in canonical form")
    strs_push(texts, text_replace(head, "\"key\":\"", "\"key\":\"X") + body)
    strs_push(cases, "a tool not its own")
    let at = match text_find(head, "\"tool\":\"") { Some(i) => i + 8, None => 0 }
    strs_push(texts, str_slice(head, 0, at) + llvm_input("another tool") + str_slice(head, at + 64, str_len(head)) + body)
    strs_push(cases, "an object one byte longer")
    strs_push(texts, raw + "x")
    strs_push(cases, "an object byte changed")
    strs_push(texts, flipped)
    for i in 0..strs_len(cases) {
        let verdict = match entry_read(strs_get(texts, i), key) {
            Ok(_) => "accepted",
            Err(e) => e,
        }
        print(strs_get(cases, i) + ": " + verdict + "\n")
    }
    let other = match entry_read(raw, object_key(key, key, key)) { Ok(_) => "accepted", Err(e) => e }
    print("asked for another key: " + other + "\n")
    0
}
