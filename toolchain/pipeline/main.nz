// The native pipeline in Nazm (R3): Core IR to MIR, and MIR to LIR.
//
//     pipeline mir CORE.json       print `nazm.mir/1`, as `nazm mir` does, once the validator
//                                  accepted it
//     pipeline mir-spans CORE.json print it with each function's and statement's position
//                                  (`nazm mir --spans`, R8 slice 11): CORE.json carries the sources
//     pipeline cost CORE.json      print what `nazm explain-cost` prints (`cost-json`: its `nazm.cost/2` line), R8 slice 11
//     pipeline profile-facts CORE.json
//                                  what the profile rules read off MIR, one `KIND\tAT\tNOTE` line each (R8 slice 11)
//     pipeline verify CORE.json    lower and validate, and say so
//     pipeline mutants CORE.json   break one invariant at a time and check the validator says so
//     pipeline ops-debug CORE.json print `nazm lir --ops --debug`: positions, the variables a
//                                  debugger shows, the files the positions name
//     pipeline runtime CORE.json [STACK HEAP]
//                                  print the runtime's units the program links (`runtime`,
//                                  `entry`, the target's), each after a line `;;; unit NAME`:
//                                  what `nazm build` generates beside the program's units; STACK
//                                  and HEAP are `--stack-size` and `--heap-limit` in bytes, `-`
//                                  for none
//     pipeline build CORE.json OUTDIR STACK HEAP [STORE GENERATOR]
//                                  what the Nazm `nazm build --backend nazm` hands its code
//                                  generator and clang (R8 slice 4): OUTDIR/lir.txt, every unit
//                                  with C's allocator renamed as the heap decides (the counted
//                                  heap under HEAP, the small-block heap for a program that calls
//                                  no C, else none), OUTDIR/rt/NAME.ll for each of the Nazm
//                                  backend's runtime units, and OUTDIR/plan.txt: `unit NAME` and
//                                  `runtime NAME` in link order, `one-thread`, `calls-c`, `tls`
//                                  (`yes` or `no`) and a `foreign SYMBOL` line for each C function;
//                                  with STORE (an object store's root) and GENERATOR (the `nzcg`
//                                  whose objects it keys), each unit found there is written as
//                                  OUTDIR/NAME.o, named `cached NAME`, and left out of lir.txt
//     pipeline put STORE GENERATOR OUTDIR
//                                  file what the generator made of `build`'s misses in the store
//     pipeline runtime-digest      print the runtime's digest, as an object key carries it
//     pipeline objects ROOT SCRATCH TOOL CONFIG UNIT.ll ...
//                                  each LLVM unit's object key (with the backend identity TOOL
//                                  and configuration CONFIG), looked up in the store under ROOT;
//                                  a hit is published again under SCRATCH and compared with the
//                                  entry found, byte for byte
//     pipeline backend REPORT PROBE.ll PROBE.o
//                                  the backend identity and configuration a `clang -###` report
//                                  of compiling PROBE.ll describes, as the build keys objects
//     pipeline llvm-get TOOL CONFIG DIR ROOT NAME [ROOT NAME]...
//                                  each LLVM unit DIR/NAME.ll looked up under ROOT by its key (R8
//                                  slice 6): `hit NAME` (its object published as DIR/NAME.o), `miss
//                                  NAME` or `rejected NAME`, one line each
//     pipeline llvm-put TOOL CONFIG DIR ROOT NAME [ROOT NAME]...
//                                  each unit's object DIR/NAME.o filed under ROOT by its unit's key:
//                                  `stored NAME`, or `failed NAME`
//     (`build` also takes `--lib` before it: a library, no `main` and no entry unit, one failure state per
//     thread; the plan then has an `export SYMBOL RET PARAMS...` line for each export, by symbol)
//     pipeline runtime-abi         print the runtime's ABI revision and digest
//     pipeline runtime-artifact DIR
//                                  for `nazm runtime build` (R8 slice 6): the hosted runtime's text for the
//                                  target, `DIR/runtime.ll`, and its per-target units (`switch`, `errno`, `os`,
//                                  `stack`, `tls`, `init`) as `DIR/NAME.ll`; `text DIGEST` (the manifest's), then
//                                  `unit NAME` for each unit but the runtime's and `services` and its names
//     pipeline entry-check ROOT KEY
//                                  the entry filed under KEY, broken one way at a time: what the
//                                  store's reader says of each
//
// `--target TRIPLE` before any of these names the target (aarch64-apple-darwin, the default, or
// x86_64-apple-darwin), as `nazm lir --target` and `nazm build --target` do.
//
// CORE.json is `nazm core-ir --json FILE`. `openspec/changes/r3-pipeline/` is the design.

use "cir.nz"
use "types.nz"
use "program.nz"
use "text.nz"
use "verify.nz"
use "mutants.nz"
use "lir.nz"
use "ops.nz"
use "rtgen.nz"
use "objcache.nz"
use "rtext.nz"
use "mir.nz"
use "cost.nz"
use "expand.nz"
use "bounds.nz"
use "vectorize.nz"
use "llvm.nz"
use "llpost.nz"
use "lldebug.nz"
use "@std/hash"
use "@std/blake3"
use "@std/hashmap"
use "@std/json"
use "@std/text"
use "@std/fs"
use "@std/process"

/// The targets this pipeline lowers for: macOS on Apple silicon and on Intel (run under Rosetta
/// on an Apple silicon host), and Windows on x86_64 with MinGW (8.8); and Linux on aarch64 and
/// x86_64 for one purpose only: the contained runner is Linux, and the toolchain builds itself
/// there (R6, `toolchain/selfbuild/selfbuild.sh`). Linux is still not a supported target
/// (`docs/user/support.md`); it, WebAssembly, WASI, Android, iOS and the boards are deferred until after
/// 1.0 by the copyright holder's decision (`openspec/changes/r3-pipeline/design.md`).
fn target_supported(t: Str) -> Bool {
    t == "aarch64-apple-darwin" || t == "x86_64-apple-darwin" || t == "x86_64-pc-windows-gnu"
            || t == "aarch64-unknown-linux-gnu" || t == "x86_64-unknown-linux-gnu"
}

fn main(io: IoCap, v: VouchCap) -> Int ! { io } {
    let given = process_args(io)
    // `--target TRIPLE` first, as `nazm lir --target`; without it, Apple silicon's macOS. Then the
    // LLVM backend's flags (`--llvm`, `--debug`, `--release`, `--no-small`), which `build` reads.
    let mut target = "aarch64-apple-darwin"
    let mut from = 0
    let mut fl = Flags(llvm: false, debug: false, release: false, small_ok: true, soa: false, prebuilt: false, lib: false)
    let mut more = true
    while more && from < strs_len(given) {
        let a = strs_get(given, from)
        if a == "--target" && from + 1 < strs_len(given) {
            target = strs_get(given, from + 1)
            from += 2
            if !target_supported(target) {
                eprint("pipeline: target `" + target + "` is not ported: only aarch64-apple-darwin, x86_64-apple-darwin and x86_64-pc-windows-gnu are (and Linux, for the self-build), the others deferred until after 1.0\n")
                return 2
            }
        } else if a == "--llvm" {
            fl.llvm = true
            from += 1
        } else if a == "--debug" {
            fl.debug = true
            from += 1
        } else if a == "--release" {
            fl.release = true
            from += 1
        } else if a == "--no-small" {
            fl.small_ok = false
            from += 1
        } else if a == "--soa" {
            fl.soa = true
            from += 1
        } else if a == "--prebuilt" {
            fl.prebuilt = true
            from += 1
        } else if a == "--lib" {
            fl.lib = true
            from += 1
        } else {
            more = false
        }
    }
    let args = strs_new()
    for i in from..strs_len(given) { strs_push(args, strs_get(given, i)) }
    if strs_len(args) == 1 && strs_get(args, 0) == "runtime-abi" {
        print(int_to_str(rt_abi_revision()) + " " + runtime_digest() + nl())
        return 0
    }
    if strs_len(args) == 2 && strs_get(args, 0) == "runtime-artifact" {
        return runtime_artifact(io, v, target, strs_get(args, 1))
    }
    if strs_len(args) == 1 && strs_get(args, 0) == "runtime-digest" {
        print(runtime_digest() + "\n")
        return 0
    }
    if strs_len(args) >= 6 && strs_get(args, 0) == "objects" {
        return objects(io, v, args)
    }
    if strs_len(args) == 4 && strs_get(args, 0) == "backend" {
        let tc = backend_of(read_file(strs_get(args, 1)), strs_get(args, 2), strs_get(args, 3))
        print(strs_get(tc, 0) + " " + strs_get(tc, 1) + "\n")
        return 0
    }
    if strs_len(args) == 4 && strs_get(args, 0) == "put" {
        return put(io, v, target, strs_get(args, 1), strs_get(args, 2), strs_get(args, 3))
    }
    if strs_len(args) >= 7 && (strs_get(args, 0) == "llvm-get" || strs_get(args, 0) == "llvm-put") {
        return llvm_store(io, v, args)
    }
    if strs_len(args) == 3 && strs_get(args, 0) == "entry-check" {
        return entry_check(io, v, strs_get(args, 1), strs_get(args, 2))
    }
    let first = if strs_len(args) > 0 { strs_get(args, 0) } else { "" }
    let mode = if strs_len(args) == 2 || (first == "runtime" && strs_len(args) == 4) || (first == "build" && (strs_len(args) == 5 || strs_len(args) == 7)) { first } else { "" }
    if mode != "mir" && mode != "mir-spans" && mode != "profile-facts" && mode != "cost" && mode != "cost-json" && mode != "verify" && mode != "mutants" && mode != "lir" && mode != "ops" && mode != "tables" && mode != "runtime" && mode != "ops-debug" && mode != "build" {
        eprint("usage: pipeline [--target TRIPLE] mir|mir-spans|cost|cost-json|profile-facts|lir|tables|ops|ops-debug|verify|mutants CORE.json | pipeline runtime CORE.json [STACK HEAP] | pipeline build CORE.json OUTDIR STACK HEAP\n")
        return 2
    }
    let text = match fs_read(io, strs_get(args, 1)) {
        Ok(t) => t,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    let c = match cir_read(text) {
        Ok(c) => c,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    // Polymorphic recursion (`N0357`): its diagnostics, rendered, on standard error and status 3.
    let expanding = expansions(c)
    if strs_len(expanding) > 0 {
        let ms = module_spans(c)
        for e in expanding {
            let parts = text_split(e, "\t")
            eprint(render_expansion(ms, strs_get(parts, 0), strs_get(parts, 1)))
        }
        return 3
    }
    // A native build's rewrite of Core IR (N66), as `nazm build` makes it before MIR.
    if mode == "build" { vectorize(c) }
    let p = match lower_program(c) {
        Ok(p) => p,
        Err(e) => {
            eprint("pipeline: " + e + "\n")
            return 1
        },
    }
    let tt = table_build(c)
    if mode == "mutants" {
        let lines = mutants(p, tt)
        for l in lines { print(l + "\n") }
        return if strs_len(lines) == 1 { 0 } else { 1 }
    }
    let errors = verify(p, tt)
    if strs_len(errors) > 0 {
        for e in errors { eprint("pipeline: MIR invalid: " + e + "\n") }
        return 1
    }
    if mode == "build" {
        let store = if strs_len(args) == 7 { strs_get(args, 5) } else { "-" }
        let generator = if strs_len(args) == 7 { strs_get(args, 6) } else { "-" }
        return build(io, v, c, tt, p, target, strs_get(args, 2), bytes_arg(strs_get(args, 3)), bytes_arg(strs_get(args, 4)), store, generator, fl)
    }
    if mode == "runtime" {
        let stack = if strs_len(args) == 4 { bytes_arg(strs_get(args, 2)) } else { -1 }
        let heap = if strs_len(args) == 4 { bytes_arg(strs_get(args, 3)) } else { -1 }
        let units = match runtime_of(c, tt, p, target, stack, heap) {
            Ok(u) => u,
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        let names = vec_get(units, 0)
        let texts = vec_get(units, 1)
        for i in 0..strs_len(names) { print(";;; unit " + strs_get(names, i) + "\n" + strs_get(texts, i)) }
        return 0
    }
    if mode == "ops-debug" {
        let names: HashMap[Str, Bool] = hashmap_new()
        match lir_texts_with(c, tt, p, names, true) {
            Ok(ts) => { for t in ts { print(t + "\n") } },
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        return 0
    }
    if mode == "lir" || mode == "ops" || mode == "tables" {
        let printed = if mode == "ops" { lir_ops(c, tt, p) } else if mode == "tables" { lir_document(c, tt, p, target, strs_new()) } else {
            match lir_texts(c, tt, p) {
                Ok(ts) => lir_document(c, tt, p, target, ts),
                Err(e) => Err(e),
            }
        }
        match printed {
            Ok(t) => print(if mode == "ops" { t } else { t + "\n" }),
            Err(e) => {
                eprint("pipeline: " + e + "\n")
                return 1
            },
        }
        return 0
    }
    if mode == "verify" {
        print(int_to_str(vec_len(p.fns)) + " functions, valid\n")
    } else if mode == "profile-facts" {
        print(profile_facts(c, tt, p, spans_of(c, p)) + str_join(loop_bounds(c), ""))
    } else if mode == "cost" || mode == "cost-json" {
        print(cost_report(c, tt, p, spans_of(c, p), mode == "cost-json"))
    } else if mode == "mir-spans" {
        let spans: Vec[MirSpans] = vec_new()
        vec_push(spans, spans_of(c, p))
        print(print_mir_at(p, spans))
    } else {
        print(print_mir(p))
    }
    0
}

/// What a position needs naming: each module's source and path, each function's span and name span (`mir-spans`, `cost`).
fn spans_of(c: Cir, p: MirProgram) -> MirSpans {
    let ms = module_spans(c)
    let sources = ms.sources
    let fn_ats = strs_new()
    let fn_names = strs_new()
    for f in p.fns {
        strs_push(fn_ats, fn_span_of(c, f))
        strs_push(fn_names, name_at_of(c, sources, f))
    }
    MirSpans(fn_ats: fn_ats, fn_names: fn_names, sources: sources, starts: ms.starts, paths: ms.paths)
}

fn module_spans(c: Cir) -> MirSpans {
    let sources: HashMap[Str, Str] = hashmap_new()
    let starts: HashMap[Str, Ints] = hashmap_new()
    let paths: HashMap[Str, Str] = hashmap_new()
    let mods = kid(c, json_root(c.doc), "modules")
    for i in 0..count(c, mods) {
        let m = at(c, mods, i)
        hashmap_set(sources, sval(c, m, "name"), sval(c, m, "source"))
        hashmap_set(starts, sval(c, m, "name"), text_line_starts(sval(c, m, "source")))
        hashmap_set(paths, sval(c, m, "name"), sval(c, m, "path"))
    }
    MirSpans(fn_ats: strs_new(), fn_names: strs_new(), sources: sources, starts: starts, paths: paths)
}

/// What the LLVM backend asks of `build`: its text rather than the code generator's, debug
/// information, a stack canary in every function, and whether the small-block heap is allowed.
struct Flags {
    llvm: Bool,
    debug: Bool,
    release: Bool,
    small_ok: Bool,
    soa: Bool,
    prebuilt: Bool,
    lib: Bool,
}

fn bytes_arg(a: Str) -> Int {
    if a == "-" { -1 } else { match text_parse_int(a) { Ok(n) => n, Err(_) => -1 } }
}

/// The runtime's units for the program (`runtime_units`): its needs are what its units reach,
/// `single` when `main` holds no authority to start a thread; the entry is `main`'s symbol with a
/// word per capability it takes, and calls C when any function does.
fn runtime_of(c: Cir, tt: TypeTable, p: MirProgram, target: Str, stack: Int, heap: Int) -> Result[Vec[Strs], Str] {
    let names: HashMap[Str, Bool] = hashmap_new()
    match lir_texts_needs(c, tt, p, names) {
        Ok(_) => {},
        Err(e) => { return Err(e) },
    }
    let main = vec_get(p.fns, p.entry)
    let mut roots = 0
    let mut single = true
    for t in params_of(main) {
        if t == "IoCap" || t == "SpawnCap" || t == "ForeignCap" || t == "VouchCap" || t == "TimeCap" || t == "MmioCap" || t == "OutCap" || t == "NetCap" || t == "RandomCap" || t == "ProcessCap" {
            roots += 1
        }
        if t == "SpawnCap" || t == "NetCap" || t == "ForeignCap" { single = false }
    }
    if single { hashmap_set(names, "single", true); }
    let mut calls_c = false
    for f in p.fns {
        if f.foreign == "" {
            let cs = callees_of(f)
            for j in 0..ints_len(cs) {
                if vec_get(p.fns, ints_get(cs, j)).foreign != "" { calls_c = true }
            }
        }
    }
    Ok(runtime_units(needs_of(names), target, "@" + symbol_of(main), roots, calls_c, stack, heap, true))
}

fn nl() -> Str { str_from_byte(10) }

/// The files a unit's debug text names: each `; file INDEX PATH` line.
fn llvm_files(t: Str) -> HashMap[Int, Str] {
    let out: HashMap[Int, Str] = hashmap_new()
    for line in text_split(t, nl()) {
        if text_starts_with(line, "; file ") {
            let rest = str_slice(line, 7, str_len(line))
            match text_find(rest, " ") {
                Some(sp) => {
                    match text_parse_int(str_slice(rest, 0, sp)) {
                        Ok(n) => { hashmap_set(out, n, str_slice(rest, sp + 1, str_len(rest))); },
                        Err(_) => {},
                    }
                },
                None => {},
            }
        }
    }
    out
}

/// One unit's text for the LLVM backend (`LlvmText::generate`): its LIR as LLVM text, with debug
/// information if asked, the one-thread state, the inlined reference counting, C's allocator made
/// the heap's (`renaming`), and a release build's canaries.
fn llvm_unit(t: Str, target: Str, single: Bool, renaming: Str, fl: Flags, defs: HashMap[Str, Str]) -> Result[Str, Str] {
    let windows = text_contains(target, "-windows-")
    let code = if text_contains(target, "-apple-") { "macho" } else if windows { "coff" } else { "plain" }
    match ll_module(t, !windows, windows, code) {
        Ok(ir) => {
            let mut x = ir
            if fl.debug { x = ld_attach(x, llvm_files(t)) }
            if single { x = lp_single_state(x) }
            x = lp_inline_counting(x, single, defs)
            if renaming == "heap" { x = count_heap(x) } else if renaming == "small" { x = small_heap(x) }
            if fl.release { x = lp_stack_protected(x) }
            Ok(x)
        },
        Err(e) => Err(e),
    }
}

fn yes(b: Bool) -> Str { if b { "yes" } else { "no" } }

/// Whether `a` is before `b`, byte by byte.
fn text_less(a: Str, b: Str) -> Bool {
    let n = if str_len(a) < str_len(b) { str_len(a) } else { str_len(b) }
    for i in 0..n {
        if str_byte(a, i) != str_byte(b, i) { return str_byte(a, i) < str_byte(b, i) }
    }
    str_len(a) < str_len(b)
}

/// Each service reached, by its stable name, in a fixed order (`Needs::names`).
fn needs_names(n: Needs) -> Strs {
    let out = strs_new()
    if n.tasks { strs_push(out, "tasks") }
    if n.channels { strs_push(out, "channels") }
    if n.sequences { strs_push(out, "sequences") }
    if n.io { strs_push(out, "io") }
    if n.join { strs_push(out, "join") }
    if n.strings { strs_push(out, "strings") }
    if n.shims { strs_push(out, "shims") }
    if n.stack { strs_push(out, "stack") }
    if n.closures { strs_push(out, "closures") }
    if n.foreign { strs_push(out, "foreign") }
    if n.numbers { strs_push(out, "numbers") }
    if n.files { strs_push(out, "files") }
    if n.net { strs_push(out, "net") }
    if n.wide { strs_push(out, "wide") }
    if n.tls { strs_push(out, "tls") }
    out
}

/// `line` with every whole symbol `@NAME` of C's allocator made `@nz.<heap>_NAME`: what
/// `nazm_lir::op::count_heap` and `small_heap` do to a module's imports, as the module prints.
fn renamed_line(line: Str, heap: Str) -> Str {
    if !text_contains(line, "@malloc") && !text_contains(line, "@realloc") && !text_contains(line, "@free") { return line }
    if text_starts_with(line, "data ") { return line }
    let out = strs_new()
    let n = str_len(line)
    let mut i = 0
    let mut from = 0
    while i < n {
        if str_byte(line, i) == 64 {
            let mut j = i + 1
            while j < n && symbol_byte(str_byte(line, j)) { j += 1 }
            let name = str_slice(line, i + 1, j)
            if name == "malloc" || name == "realloc" || name == "free" {
                strs_push(out, str_slice(line, from, i + 1))
                strs_push(out, "nz." + heap + "_" + name)
                from = j
            }
            i = j
        } else {
            i += 1
        }
    }
    strs_push(out, str_slice(line, from, n))
    str_join(out, "")
}

fn symbol_byte(b: Int) -> Bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 46 || b == 36
}

/// A unit's LIR text with C's allocator made the `heap` one's (`""`: unchanged).
fn heap_renamed(text: Str, heap: Str) -> Str {
    if heap == "" { return text }
    let out = strs_new()
    for line in text_split(text, nl()) { strs_push(out, renamed_line(line, heap)) }
    str_join(out, nl())
}

/// `pipeline build`: the program's units and the Nazm backend's runtime, written under `dir`, and
/// the plan the driver links them by (R8 slice 4, `openspec/changes/r8-cut-over/design.md`, S4.3).
fn build(io: IoCap, v: VouchCap, c: Cir, tt: TypeTable, p: MirProgram, target: Str, dir: Str, stack: Int, heap: Int, store: Str, generator: Str, fl: Flags) -> Int ! { io } {
    let names: HashMap[Str, Bool] = hashmap_new()
    // A build names a module outside the source root as the loader did (`SourceNames`).
    hashmap_set(names, "@display", true)
    // The LLVM text names the binding a variable holds beside it, which the LIR text carries then.
    if fl.llvm { hashmap_set(names, "@names", true) }
    // `--layout soa`: a `Vec` of records of `Int`s and `Bool`s one array per field.
    if fl.soa { hashmap_set(names, "@soa", true) }
    // A library has no `main`.
    if fl.lib { hashmap_set(names, "@lib", true) }
    let texts = match lir_texts_with(c, tt, p, names, fl.llvm && fl.debug) {
        Ok(ts) => ts,
        Err(e) => {
            eprint("pipeline: " + e + nl())
            return 1
        },
    }
    let main_params = if fl.lib { strs_new() } else { params_of(vec_get(p.fns, p.entry)) }
    let entry_name = if fl.lib { "@lib" } else { "@" + symbol_of(vec_get(p.fns, p.entry)) }
    let mut roots = 0
    let mut single = !fl.lib
    for t in main_params {
        if t == "IoCap" || t == "SpawnCap" || t == "ForeignCap" || t == "VouchCap" || t == "TimeCap" || t == "MmioCap" || t == "OutCap" || t == "NetCap" || t == "RandomCap" || t == "ProcessCap" {
            roots += 1
        }
        if t == "SpawnCap" || t == "NetCap" || t == "ForeignCap" { single = false }
    }
    let mut calls_c = false
    for f in p.fns {
        if f.foreign == "" {
            let cs = callees_of(f)
            for j in 0..ints_len(cs) {
                if vec_get(p.fns, ints_get(cs, j)).foreign != "" { calls_c = true }
            }
        }
    }
    // The Nazm backend's runtime is every part (`NazmCodegen::baseline`), TLS where a unit reaches
    // it, and the program's own `single`.
    // A runtime artifact's program may have more threads than its own `main` shows: the artifact keeps the failure
    // state per thread (`single_thread &= runtime.is_none()`).
    if fl.prebuilt { single = false }
    let all: HashMap[Str, Bool] = hashmap_new()
    for n in text_split("tasks channels sequences io join strings shims stack closures foreign numbers files net wide", " ") {
        hashmap_set(all, n, true)
    }
    let tls = hashmap_has(names, "tls")
    if tls { hashmap_set(all, "tls", true) }
    if single { hashmap_set(all, "single", true) }
    let small = fl.small_ok && !fl.lib && !fl.prebuilt && heap < 0 && switch_target(target) != "" && !calls_c
    let renaming = if heap >= 0 { "heap" } else if small { "small" } else { "" }
    // The LLVM backend's runtime is what its units reach, and the program's own `single`.
    if fl.llvm && single { hashmap_set(names, "single", true) }
    // What the program reaches of the runtime, by name, as a runtime artifact's manifest lists them.
    let reached = settled(needs_of(if fl.llvm { names } else { all }))
    let units = runtime_units(needs_of(if fl.llvm { names } else { all }), target, entry_name, roots, calls_c, stack, heap, fl.small_ok && !fl.prebuilt && !fl.lib)
    let mut rt_names = vec_get(units, 0)
    let mut rt_texts = vec_get(units, 1)
    // A library has no process entry: C's `main` is the caller's.
    if fl.lib {
        let kept_names = strs_new()
        let kept_texts = strs_new()
        for i in 0..strs_len(rt_names) {
            if strs_get(rt_names, i) != "entry" {
                strs_push(kept_names, strs_get(rt_names, i))
                strs_push(kept_texts, strs_get(rt_texts, i))
            }
        }
        rt_names = kept_names
        rt_texts = kept_texts
    }
    // A runtime artifact (`--runtime`) is linked instead of a generated runtime: the entry alone is the program's.
    if fl.prebuilt {
        let only_names = strs_new()
        let only_texts = strs_new()
        for i in 0..strs_len(rt_names) {
            if strs_get(rt_names, i) == "entry" {
                strs_push(only_names, strs_get(rt_names, i))
                strs_push(only_texts, strs_get(rt_texts, i))
            }
        }
        rt_names = only_names
        rt_texts = only_texts
    }
    // Each unit's object is looked up in the store by its key (design S4.5): a hit is written as
    // DIR/NAME.o and left out of lir.txt; a miss's text is kept as DIR/units/NAME.lir for `put`.
    let plans = unit_plans(c, p)
    let tool = if store == "-" { "" } else { generator_identity(io, v, generator, target) }
    let config = if store == "-" { "" } else { generator_config(target, single) }
    let lir = strs_new()
    let plan = strs_new()
    let mut k = 0
    let defs = lp_definitions()
    for t in texts {
        let name = vec_get(plans, k).artefact
        if fl.llvm {
            // The LLVM backend: each unit's text, as clang compiles it.
            match llvm_unit(t, target, single, renaming, fl, defs) {
                Ok(ir) => {
                    if write_file(str_vouch(dir + "/" + name + ".ll"), ir) < 0 {
                        eprint("pipeline: cannot write " + dir + "/" + name + ".ll" + nl())
                        return 1
                    }
                },
                Err(e) => {
                    eprint("pipeline: " + e + nl())
                    return 1
                },
            }
            strs_push(plan, "unit " + name)
            k += 1
            continue
        }
        let text = heap_renamed(t, renaming) + nl()
        strs_push(plan, "unit " + name)
        let mut hit = false
        if store != "-" {
            match store_get(io, v, store, object_key(llvm_input(text), tool, config)) {
                Ok(object) => {
                    if write_file(str_vouch(dir + "/" + name + ".o"), object) == str_len(object) { hit = true }
                },
                Err(_) => {},
            }
            if hit {
                strs_push(plan, "cached " + name)
            } else {
                write_file(str_vouch(dir + "/units/" + name + ".lir"), text)
            }
        }
        if !hit { strs_push(lir, text) }
        k += 1
    }
    if write_file(str_vouch(dir + "/lir.txt"), str_join(lir, "")) < 0 {
        eprint("pipeline: cannot write " + dir + "/lir.txt" + nl())
        return 1
    }
    for i in 0..strs_len(rt_names) {
        let name = strs_get(rt_names, i)
        let mut text = strs_get(rt_texts, i)
        // Windows' C library: MinGW's own `snprintf` and `strtod` (`c_library_for`).
        if name == "runtime" && target == "x86_64-pc-windows-gnu" {
            text = text_replace(text_replace(text, "@snprintf(", "@__mingw_snprintf("), "@strtod(", "@__mingw_strtod(")
        }
        // A release build: every function the runtime defines carries a stack canary too.
        if fl.llvm && fl.release { text = lp_stack_protected(text) }
        if write_file(str_vouch(dir + "/rt/" + name + ".ll"), text) < 0 {
            eprint("pipeline: cannot write " + dir + "/rt/" + name + ".ll" + nl())
            return 1
        }
        strs_push(plan, "runtime " + name)
    }
    strs_push(plan, "one-thread " + yes(single))
    strs_push(plan, "calls-c " + yes(calls_c))
    strs_push(plan, "tls " + yes(tls))
    strs_push(plan, "needs " + str_join(needs_names(reached), " "))
    // Each export, by symbol: its C signature's Nazm types, for a library's header.
    let sym_names = strs_new()
    let sym_lines = strs_new()
    for f in p.fns {
        if f.export != "" && f.foreign == "" {
            let line = "export " + f.export + " " + f.ret + (if strs_len(params_of(f)) > 0 { " " + str_join(params_of(f), " ") } else { "" })
            let mut at = 0
            while at < strs_len(sym_names) && text_less(strs_get(sym_names, at), f.export) { at += 1 }
            strs_push(sym_names, "")
            strs_push(sym_lines, "")
            let mut j = strs_len(sym_names) - 1
            while j > at {
                strs_set(sym_names, j, strs_get(sym_names, j - 1))
                strs_set(sym_lines, j, strs_get(sym_lines, j - 1))
                j -= 1
            }
            strs_set(sym_names, at, f.export)
            strs_set(sym_lines, at, line)
        }
    }
    for i in 0..strs_len(sym_lines) { strs_push(plan, strs_get(sym_lines, i)) }
    for k in 0..vec_len(plans) {
        let u = vec_get(plans, k)
        // A standard or prelude module's own unit is every project's: it is filed in the user cache.
        if u.owns && (u.module == "@core/prelude" || text_starts_with(u.module, "@std/")) { strs_push(plan, "shared " + u.artefact) }
    }
    for f in p.fns {
        if f.foreign != "" { strs_push(plan, "foreign " + f.foreign) }
    }
    if write_file(str_vouch(dir + "/plan.txt"), str_join(plan, nl()) + nl()) < 0 {
        eprint("pipeline: cannot write " + dir + "/plan.txt" + nl())
        return 1
    }
    0
}

/// The Nazm code generator's identity, as an object key carries it (design S4.5): the generator's
/// BLAKE3 digest and the target.
fn generator_identity(io: IoCap, v: VouchCap, generator: Str, target: Str) -> Str {
    backend_identity("nzcg", "nzcg-" + blake3_hex(bytes_from_str(read_file(str_vouch(generator)))) + " " + target)
}

/// How the generator was asked to generate: the target, whether the program has one thread, and
/// the runtime's contract.
fn generator_config(target: Str, single: Bool) -> Str {
    let a = strs_new()
    strs_push(a, target)
    strs_push(a, "one-thread=" + yes(single))
    strs_push(a, runtime_abi())
    codegen_config(a)
}

/// `pipeline put STORE GENERATOR DIR`: every unit `nazm build` generated (its `units/NAME.lir`
/// beside `NAME.o`, as `build` left them) filed in the store under its key.
fn put(io: IoCap, v: VouchCap, target: Str, store: Str, generator: Str, dir: Str) -> Int ! { io } {
    let plan = read_file(str_vouch(dir + "/plan.txt"))
    let single = text_contains(plan, "one-thread yes")
    let tool = generator_identity(io, v, generator, target)
    let config = generator_config(target, single)
    let mut bad = 0
    for line in text_split(plan, nl()) {
        if text_starts_with(line, "unit ") {
            let name = str_slice(line, 5, str_len(line))
            let source = str_vouch(dir + "/units/" + name + ".lir")
            if file_exists(source) {
                let object = read_file(str_vouch(dir + "/" + name + ".o"))
                match store_put(io, v, store, llvm_input(read_file(source)), tool, config, object, "nazm-build-" + int_to_str(os_pid())) {
                    Ok(_) => {},
                    Err(e) => { bad += 1 },
                }
            }
        }
    }
    if bad == 0 { 0 } else { 1 }
}

/// `pipeline runtime-artifact` (R8 slice 6): the texts `nazm runtime build` compiles for a hosted target
/// (`Profile::text`, and the units the archive carries beside it).
fn runtime_artifact(io: IoCap, v: VouchCap, target: Str, dir: Str) -> Int ! { io } {
    let t = switch_target(target)
    if t == "" {
        eprint("pipeline: no hosted runtime for " + target + nl())
        return 1
    }
    let engine = emit_tls(t)
    let all = Needs(
        tasks: true, channels: true, sequences: true, io: true, join: true, strings: true,
        shims: true, stack: true, closures: true, foreign: true, numbers: true, files: true,
        net: true, wide: true, tls: engine != "", single: false,
    )
    let mut text = emit_runtime(all)
    // Windows' C library: MinGW's own `snprintf` and `strtod` (`c_library_for`).
    if target == "x86_64-pc-windows-gnu" { text = text_replace(text_replace(text, "@snprintf(", "@__mingw_snprintf("), "@strtod(", "@__mingw_strtod(") }
    let switch = emit_switch(t)
    let errno = emit_errno(t)
    let units = strs_new()
    let names = strs_new()
    strs_push(names, "switch")
    strs_push(units, switch)
    strs_push(names, "errno")
    strs_push(units, errno)
    strs_push(names, "os")
    strs_push(units, emit_os(t))
    strs_push(names, "stack")
    strs_push(units, emit_stack(t))
    if engine != "" {
        strs_push(names, "tls")
        strs_push(units, engine)
    }
    let init = emit_init(t)
    if init != "" {
        strs_push(names, "init")
        strs_push(units, init)
    }
    if write_file(str_vouch(dir + "/runtime.ll"), text) < 0 {
        eprint("pipeline: cannot write " + dir + "/runtime.ll" + nl())
        return 1
    }
    let out = strs_new()
    strs_push(out, "text " + blake3_hex(bytes_from_str(text + switch + errno)))
    for i in 0..strs_len(names) {
        if write_file(str_vouch(dir + "/" + strs_get(names, i) + ".ll"), strs_get(units, i)) < 0 {
            eprint("pipeline: cannot write " + dir + "/" + strs_get(names, i) + ".ll" + nl())
            return 1
        }
        strs_push(out, "unit " + strs_get(names, i))
    }
    strs_push(out, "services " + str_join(needs_names(all), " "))
    print(str_join(out, nl()) + nl())
    0
}

/// `pipeline llvm-get` and `llvm-put` (R8 slice 6): the LLVM units' objects, looked up in the object stores
/// and filed there. `args` are the command, the backend identity and configuration a `clang -###` probe
/// described (`backend`), the directory the units are in, and then each unit's store root and name.
fn llvm_store(io: IoCap, v: VouchCap, args: Strs) -> Int ! { io } {
    let putting = strs_get(args, 0) == "llvm-put"
    let tool = strs_get(args, 1)
    let config = strs_get(args, 2)
    let dir = strs_get(args, 3)
    let mut bad = 0
    let mut i = 4
    while i + 1 < strs_len(args) {
        let root = strs_get(args, i)
        let name = strs_get(args, i + 1)
        i += 2
        let text = read_file(str_vouch(dir + "/" + name + ".ll"))
        if putting {
            let object = read_file(str_vouch(dir + "/" + name + ".o"))
            match store_put(io, v, root, llvm_input(text), tool, config, object, "nazm-build-" + int_to_str(os_pid())) {
                Ok(_) => { print("stored " + name + nl()) },
                Err(e) => { print("failed " + name + nl()) },
            }
        } else {
            match store_get(io, v, root, object_key(llvm_input(text), tool, config)) {
                Ok(object) => {
                    if write_file(str_vouch(dir + "/" + name + ".o"), object) == str_len(object) {
                        print("hit " + name + nl())
                    } else {
                        print("miss " + name + nl())
                    }
                },
                Err(e) => { print((if e == "miss" { "miss " } else { "rejected " }) + name + nl()) },
            }
        }
    }
    if bad == 0 { 0 } else { 1 }
}

/// `pipeline objects`: each unit's key looked up, a hit published again and compared.
fn objects(io: IoCap, v: VouchCap, args: Strs) -> Int ! { io } {
    let root = strs_get(args, 1)
    let scratch = strs_get(args, 2)
    let tool = strs_get(args, 3)
    let config = strs_get(args, 4)
    let mut bad = 0
    for i in 5..strs_len(args) {
        let unit = strs_get(args, i)
        let key = object_key(llvm_input(read_file(unit)), tool, config)
        match store_get(io, v, root, key) {
            Ok(object) => {
                let mut verdict = "hit"
                match store_put(io, v, scratch, llvm_input(read_file(unit)), tool, config, object, "check") {
                    Ok(_) => {
                        if read_file(str_vouch(entry_path(scratch, key))) != read_file(str_vouch(entry_path(root, key))) {
                            verdict = "hit, but the entry written again differs"
                            bad += 1
                        }
                    },
                    Err(e) => {
                        verdict = "hit, but " + e
                        bad += 1
                    },
                }
                print(unit + " " + verdict + " " + key + "\n")
            },
            Err(e) => {
                print(unit + " " + e + " " + key + "\n")
                bad += 1
            },
        }
    }
    if bad == 0 { 0 } else { 1 }
}

/// `pipeline entry-check`: the entry under KEY, and each way of breaking it, read.
fn entry_check(io: IoCap, v: VouchCap, root: Str, key: Str) -> Int ! { io } {
    let raw = read_file(str_vouch(entry_path(root, key)))
    let nl = match text_find(raw, "\n") { Some(i) => i, None => 0 }
    let head = str_slice(raw, 0, nl)
    let body = str_slice(raw, nl, str_len(raw))
    let last = str_len(raw) - 1
    let flipped = str_slice(raw, 0, last) + (if str_byte(raw, last) == 65 { "B" } else { "A" })
    let cases = strs_new()
    let texts = strs_new()
    strs_push(cases, "whole")
    strs_push(texts, raw)
    strs_push(cases, "no header line")
    strs_push(texts, text_replace(raw, "\n", " "))
    strs_push(cases, "not JSON")
    strs_push(texts, "{" + raw)
    strs_push(cases, "another schema")
    strs_push(texts, text_replace(head, "nazm.object/1", "nazm.object/2") + body)
    strs_push(cases, "a key not in canonical form")
    strs_push(texts, text_replace(head, "\"key\":\"", "\"key\":\"X") + body)
    strs_push(cases, "a tool not its own")
    let at = match text_find(head, "\"tool\":\"") { Some(i) => i + 8, None => 0 }
    strs_push(texts, str_slice(head, 0, at) + llvm_input("another tool") + str_slice(head, at + 64, str_len(head)) + body)
    strs_push(cases, "an object one byte longer")
    strs_push(texts, raw + "x")
    strs_push(cases, "an object byte changed")
    strs_push(texts, flipped)
    for i in 0..strs_len(cases) {
        let verdict = match entry_read(strs_get(texts, i), key) {
            Ok(_) => "accepted",
            Err(e) => e,
        }
        print(strs_get(cases, i) + ": " + verdict + "\n")
    }
    let other = match entry_read(raw, object_key(key, key, key)) { Ok(_) => "accepted", Err(e) => e }
    print("asked for another key: " + other + "\n")
    0
}
