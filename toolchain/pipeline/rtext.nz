pub fn rt_core_STACK_RUNTIME() -> Str ! {} {
    r#"
define hidden i32 @nz.stack_check() {
entry:
  %fp = call ptr @llvm.frameaddress.p0(i32 0)
  %sp = ptrtoint ptr %fp to i64
  %lim = load i64, ptr @nz.stack_limit
  %unset = icmp eq i64 %lim, 0
  br i1 %unset, label %init, label %compare
init:
  ; The stack this thread has left, as the platform's stack unit reports it (Gate 3) — its own
  ; stack, so a thread C started is budgeted from what it has (Q1-A1-04); 0 is unknown.
  %cur = call i64 @nz_os_stack_size()
  %ok = icmp ne i64 %cur, 0
  %sbc = load i64, ptr @nz.stack_bytes
  %sbcset = icmp ne i64 %sbc, 0
  %want = select i1 %sbcset, i64 %sbc, i64 8388608
  %cap = select i1 %ok, i64 %cur, i64 %want
  %small = icmp ult i64 %cap, %want
  %size = select i1 %small, i64 %cap, i64 %want
  %quarter = lshr i64 %size, 2
  %budget = sub i64 %size, %quarter
  %under = icmp ult i64 %sp, %budget
  %raw = sub i64 %sp, %budget
  %limit = select i1 %under, i64 1, i64 %raw
  store i64 %limit, ptr @nz.stack_limit
  br label %compare
compare:
  %l = phi i64 [ %lim, %entry ], [ %limit, %init ]
  %past = icmp ult i64 %sp, %l
  %r = zext i1 %past to i32
  ret i32 %r
}

; A function whose own frame is large asks this instead (Q1-A1-01): past the limit, or with less
; than `need` bytes between this frame and the limit, so the frame itself would cross it.
define hidden i32 @nz.stack_check_frame(i64 %need) {
entry:
  %past = call i32 @nz.stack_check()
  %fp = call ptr @llvm.frameaddress.p0(i32 0)
  %sp = ptrtoint ptr %fp to i64
  %lim = load i64, ptr @nz.stack_limit
  %room = sub i64 %sp, %lim
  %short = icmp ult i64 %room, %need
  %s = zext i1 %short to i32
  %r = or i32 %past, %s
  ret i32 %r
}
"#
}

pub fn rt_core_SHIM_RUNTIME() -> Str ! {} {
    r#"

define hidden i32 @nz.failed_now() {
entry:
  %f = load i1, ptr @nz.failed
  %r = zext i1 %f to i32
  ret i32 %r
}

; An Int's decimal digits, a `-` first when negative, into 21 bytes the caller owns: how many.
; Written here rather than through `snprintf` (R1, 5b.9): a C library's formatting parses its
; format and takes a lock on every call, and a program printing numbers spent a quarter of its
; time there. The magnitude is unsigned, so the most negative Int is exact.
define hidden i64 @nz.format_int(ptr %buf, i64 %v) {
entry:
  %tmp = alloca [24 x i8], align 1
  %neg = icmp slt i64 %v, 0
  %nv = sub i64 0, %v
  %m = select i1 %neg, i64 %nv, i64 %v
  %xs = alloca i64
  %ks = alloca i64
  %ss = alloca i64
  store i64 %m, ptr %xs
  store i64 24, ptr %ks
  br label %digit
digit:
  %x = load i64, ptr %xs
  %k = load i64, ptr %ks
  %q = udiv i64 %x, 10
  %qt = mul i64 %q, 10
  %r = sub i64 %x, %qt
  %ch = add i64 %r, 48
  %c8 = trunc i64 %ch to i8
  %k1 = sub i64 %k, 1
  %slot = getelementptr i8, ptr %tmp, i64 %k1
  store i8 %c8, ptr %slot
  store i64 %q, ptr %xs
  store i64 %k1, ptr %ks
  store i64 %k1, ptr %ss
  %more = icmp ne i64 %q, 0
  br i1 %more, label %digit, label %sign
sign:
  %km = sub i64 %k1, 1
  br i1 %neg, label %minus, label %copy
minus:
  %ms = getelementptr i8, ptr %tmp, i64 %km
  store i8 45, ptr %ms
  store i64 %km, ptr %ss
  br label %copy
copy:
  %start = load i64, ptr %ss
  %len = sub i64 24, %start
  %from = getelementptr i8, ptr %tmp, i64 %start
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %from, i64 %len, i1 false)
  ret i64 %len
}
"#
}

pub fn rt_core_SHIM_SEQUENCE_RUNTIME() -> Str ! {} {
    r#"
define hidden void @nz.vec_release(ptr %h, ptr %f, i64 %stride, ptr %q) {
entry:
  %own = alloca [3 x i64]
  %none = icmp eq ptr %h, null
  br i1 %none, label %done, label %drop
drop:
  %rcp = getelementptr i8, ptr %h, i64 24
  %rc = load i64, ptr %rcp
  %rc2 = sub i64 %rc, 1
  store i64 %rc2, ptr %rcp
  %last = icmp sle i64 %rc2, 0
  br i1 %last, label %which, label %done
which:
  %nested = icmp ne ptr %q, null
  br i1 %nested, label %enqueue, label %outer
enqueue:
  %ok = call i1 @nz.vec_enqueue(ptr %q, ptr %h, ptr %f, i64 %stride)
  br i1 %ok, label %done, label %now
now:
  call void @nz.vec_drain(ptr %h, ptr %f, i64 %stride, ptr %q)
  br label %done
outer:
  store ptr null, ptr %own
  %olen = getelementptr i8, ptr %own, i64 8
  store i64 0, ptr %olen
  %ocap = getelementptr i8, ptr %own, i64 16
  store i64 0, ptr %ocap
  call void @nz.vec_drain(ptr %h, ptr %f, i64 %stride, ptr %own)
  br label %loop
loop:
  %len = load i64, ptr %olen
  %empty = icmp eq i64 %len, 0
  br i1 %empty, label %finish, label %pop
pop:
  %top = sub i64 %len, 1
  store i64 %top, ptr %olen
  %buf = load ptr, ptr %own
  %off = mul i64 %top, 24
  %ent = getelementptr i8, ptr %buf, i64 %off
  %th = load ptr, ptr %ent
  %tfp = getelementptr i8, ptr %ent, i64 8
  %tf = load ptr, ptr %tfp
  %tsp = getelementptr i8, ptr %ent, i64 16
  %ts = load i64, ptr %tsp
  call void @nz.vec_drain(ptr %th, ptr %tf, i64 %ts, ptr %own)
  br label %loop
finish:
  %spent = load ptr, ptr %own
  call void @free(ptr %spent)
  br label %done
done:
  ret void
}

define hidden void @nz.vec_drain(ptr %h, ptr %f, i64 %stride, ptr %q) {
entry:
  %n = load i64, ptr %h
  %dp = getelementptr i8, ptr %h, i64 16
  %data = load ptr, ptr %dp
  br label %test
test:
  %i = phi i64 [ 0, %entry ], [ %next, %body ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %body, label %storage
body:
