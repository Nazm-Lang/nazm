pub fn rt_single_thread_state() -> Str ! {} {
    r#"nz.failed
nz.errmsg
nz.errlen
nz.stack_limit
nz.exc
"#
}

pub fn rt_plain_in_one_thread() -> Str ! {} {
    r#"nz.str_retain
nz.str_release
nz.closure_retain
nz.closure_release
nz.chan_retain
nz.chan_release
nz.chanv_release
"#
}

pub fn rt_abi_revision() -> Int ! {} { 43 }

pub fn rt_target_note() -> Str ! {} {
    r#"verified on aarch64-apple-darwin with Apple clang; other targets are unverified rather than unsupported"#
}
