other:
  ret i32 5
}

; The last Winsock failure put into `errno` (Linux's numbers pass the translation unchanged): it.
define internal i32 @nz.win.wsa_errno() {
entry:
  %w = call i32 @WSAGetLastError()
  %e = call i32 @nz.win.wsa_map(i32 %w)
  call void @nz.win.set_errno(i32 %e)
  ret i32 %e
}

; The socket descriptor `fd` stands for, or 0.
define internal i64 @nz.win.sock(i32 %fd) {
entry:
  %in = icmp ult i32 %fd, 4096
  br i1 %in, label %look, label %none
look:
  %i = zext i32 %fd to i64
  %p = getelementptr [4096 x i64], ptr @nz.win.socks, i64 0, i64 %i
  %s = load atomic i64, ptr %p acquire, align 8
  ret i64 %s
none:
  ret i64 0
}

; A descriptor for new socket `s`, which it now owns; -1 with errno set, `s` closed, when none.
define internal i32 @nz.win.adopt(i64 %s) {
entry:
  %fd = call i32 (ptr, i32, ...) @_open(ptr @.nz.win.nul, i32 128)
  %nofd = icmp slt i32 %fd, 0
  br i1 %nofd, label %fail, label %check
check:
  %in = icmp slt i32 %fd, 4096
  br i1 %in, label %keep, label %many
many:
  %c = call i32 @_close(i32 %fd)
  call void @nz.win.set_errno(i32 24)
  br label %fail
fail:
  %x = call i32 @closesocket(i64 %s)
  ret i32 -1
keep:
  %i = zext i32 %fd to i64
  %p = getelementptr [4096 x i64], ptr @nz.win.socks, i64 0, i64 %i
  store atomic i64 %s, ptr %p release, align 8
  ret i32 %fd
}

define internal void @nz.win.poke() {
entry:
  %one = alloca i8, align 1
  %w = load atomic i64, ptr @nz.win.wake acquire, align 8
  %none = icmp eq i64 %w, 0
  br i1 %none, label %done, label %send
send:
  store i8 1, ptr %one
  %r = call i32 @send(i64 %w, ptr %one, i32 1, i32 0)
  br label %done
done:
  ret void
}

; A descriptor closed: a socket's interest dropped, the reactor told, the socket closed, then its
; key.
define hidden i32 @nz_os_close(i32 %fd) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %sock = icmp ne i64 %s, 0
  br i1 %sock, label %forget, label %plain
plain:
  %in = icmp ult i32 %fd, 4096
  br i1 %in, label %unarm, label %shut
unarm:
  %pi = zext i32 %fd to i64
  call void @AcquireSRWLockExclusive(ptr @nz.win.lock)
  %pwp = getelementptr [4096 x i64], ptr @nz.win.want, i64 0, i64 %pi
  store i64 0, ptr %pwp
  call void @ReleaseSRWLockExclusive(ptr @nz.win.lock)
  br label %shut
shut:
  %r = call i32 @_close(i32 %fd)
  ret i32 %r
forget:
  %i = zext i32 %fd to i64
  call void @AcquireSRWLockExclusive(ptr @nz.win.lock)
  %sp = getelementptr [4096 x i64], ptr @nz.win.socks, i64 0, i64 %i
  store atomic i64 0, ptr %sp release, align 8
  %wp = getelementptr [4096 x i64], ptr @nz.win.want, i64 0, i64 %i
  store i64 0, ptr %wp
  call void @ReleaseSRWLockExclusive(ptr @nz.win.lock)
  call void @nz.win.poke()
  %c = call i32 @closesocket(i64 %s)
  %k = call i32 @_close(i32 %fd)
  %bad = icmp ne i32 %c, 0
  br i1 %bad, label %failed, label %closed
failed:
  %e = call i32 @nz.win.wsa_errno()
  ret i32 -1
closed:
  ret i32 0
}

define internal void @nz.win.nonblocking(i64 %s) {
entry:
  %one = alloca i32, align 4
  store i32 1, ptr %one
  %r = call i32 @ioctlsocket(i64 %s, i32 -2147195266, ptr %one)
  ret void
}

; Non-blocking: a socket by `FIONBIO`, a pipe by `PIPE_NOWAIT`. Winsock raises no signal for a
; peer that has gone, and neither is inherited unasked.
define hidden i32 @nz_net_prepare(i32 %fd) {
entry:
  %mode = alloca i32, align 4
  %s = call i64 @nz.win.sock(i32 %fd)
  %sock = icmp ne i64 %s, 0
  br i1 %sock, label %set, label %other
set:
  call void @nz.win.nonblocking(i64 %s)
  br label %done
other:
  %h = call i64 @_get_osfhandle(i32 %fd)
  %t = call i32 @GetFileType(i64 %h)
  %pipe = icmp eq i32 %t, 3
  br i1 %pipe, label %nowait, label %done
nowait:
  store i32 1, ptr %mode
  %r = call i32 @SetNamedPipeHandleState(i64 %h, ptr %mode, ptr null, ptr null)
  br label %done
done:
  ret i32 0
}

; A socket of `type` for the address at `sa`, prepared; or -1 with errno set. `reuse` is not
; asked of Windows: its `SO_REUSEADDR` lets a second listener take a port in use, and its default
; already rebinds a port a closed connection lingers on.
define hidden i32 @nz_net_open(ptr %sa, i64 %type, i64 %reuse) {
entry:
  %fh = load i16, ptr %sa
  %fam = zext i16 %fh to i32
  %t = trunc i64 %type to i32
  %s = call i64 @socket(i32 %fam, i32 %t, i32 0)
  %bad = icmp eq i64 %s, -1
  br i1 %bad, label %fail, label %ok
fail:
  %e = call i32 @nz.win.wsa_errno()
  ret i32 -1
ok:
  call void @nz.win.nonblocking(i64 %s)
  %fd = call i32 @nz.win.adopt(i64 %s)
  ret i32 %fd
}

; 0 connected, 1 under way, or -errno.
define hidden i64 @nz_net_connect(i32 %fd, ptr %sa, i64 %len) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %l = trunc i64 %len to i32
  %r = call i32 @connect(i64 %s, ptr %sa, i32 %l)
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %done, label %failed
done:
  ret i64 0
failed:
  %e = call i32 @nz.win.wsa_errno()
  %block = icmp eq i32 %e, 11
  %busy = icmp eq i32 %e, 115
  %under = or i1 %block, %busy
  br i1 %under, label %later, label %error
later:
  ret i64 1
error:
  %w = sext i32 %e to i64
  %neg = sub i64 0, %w
  ret i64 %neg
}

; The error a socket holds (`SO_ERROR`): 0, or its errno.
define hidden i64 @nz_net_error(i32 %fd) {
entry:
  %v = alloca i32, align 4
  %l = alloca i32, align 4
  store i32 0, ptr %v
  store i32 4, ptr %l
  %s = call i64 @nz.win.sock(i32 %fd)
  %r = call i32 @getsockopt(i64 %s, i32 65535, i32 4103, ptr %v, ptr %l)
  %w = load i32, ptr %v
  %none = icmp eq i32 %w, 0
  br i1 %none, label %clear, label %held
clear:
  ret i64 0
held:
  %e = call i32 @nz.win.wsa_map(i32 %w)
  %x = sext i32 %e to i64
  ret i64 %x
}

; Winsock counts in `int`: a request is cut to what one call carries, as a partial one allows.
define internal i32 @nz.win.count(i64 %n) {
entry:
  %big = icmp sgt i64 %n, 1073741824
  %m = select i1 %big, i64 1073741824, i64 %n
  %m32 = trunc i64 %m to i32
  ret i32 %m32
}

define internal i64 @nz.win.result(i32 %r) {
entry:
  %bad = icmp slt i32 %r, 0
  br i1 %bad, label %failed, label %done
failed:
  %e = call i32 @nz.win.wsa_errno()
  ret i64 -1
done:
  %w = sext i32 %r to i64
  ret i64 %w
}

define hidden i64 @nz_net_send(i32 %fd, ptr %p, i64 %n) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %m = call i32 @nz.win.count(i64 %n)
  %r = call i32 @send(i64 %s, ptr %p, i32 %m, i32 0)
  %w = call i64 @nz.win.result(i32 %r)
  ret i64 %w
}

define hidden i64 @nz_net_sendto(i32 %fd, ptr %p, i64 %n, ptr %sa, i64 %len) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %m = call i32 @nz.win.count(i64 %n)
  %l = trunc i64 %len to i32
  %r = call i32 @sendto(i64 %s, ptr %p, i32 %m, i32 0, ptr %sa, i32 %l)
  %w = call i64 @nz.win.result(i32 %r)
  ret i64 %w
}

define hidden i64 @nz_net_eagain() {
entry:
  ret i64 11
}

define hidden i64 @nz_net_etimedout() {
entry:
  ret i64 110
}

; A read from a socket, or from a pipe: a pipe with nothing in it would block (EAGAIN) and one
; whose writer has gone is at its end.
define hidden i64 @nz_net_read(i32 %fd, ptr %buf, i64 %n) {
entry:
  %got = alloca i32, align 4
  %s = call i64 @nz.win.sock(i32 %fd)
  %sock = icmp ne i64 %s, 0
  br i1 %sock, label %recv, label %plain
plain:
  %h = call i64 @_get_osfhandle(i32 %fd)
  %pm = call i32 @nz.win.count(i64 %n)
  store i32 0, ptr %got
  %ok = call i32 @ReadFile(i64 %h, ptr %buf, i32 %pm, ptr %got, ptr null)
  %fine = icmp ne i32 %ok, 0
  br i1 %fine, label %read, label %failed
read:
  %g = load i32, ptr %got
  %gw = zext i32 %g to i64
  ret i64 %gw
failed:
  %w = call i32 @GetLastError()
  switch i32 %w, label %other [
    i32 232, label %empty
    i32 109, label %ended
  ]
empty:
  call void @nz.win.set_errno(i32 11)
  ret i64 -1
ended:
  ret i64 0
other:
  %e = call i32 @nz.win.last_errno()
  call void @nz.win.set_errno(i32 %e)
  ret i64 -1
recv:
  %m = call i32 @nz.win.count(i64 %n)
  %r = call i32 @recv(i64 %s, ptr %buf, i32 %m, i32 0)
  %rw = call i64 @nz.win.result(i32 %r)
  ret i64 %rw
}

define hidden i32 @nz_net_bind(i32 %fd, ptr %sa, i32 %len) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %r = call i32 @bind(i64 %s, ptr %sa, i32 %len)
  %w = call i64 @nz.win.result(i32 %r)
  %x = trunc i64 %w to i32
  ret i32 %x
}

define hidden i32 @nz_net_listen(i32 %fd) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %r = call i32 @listen(i64 %s, i32 128)
  %w = call i64 @nz.win.result(i32 %r)
  %x = trunc i64 %w to i32
  ret i32 %x
}

define hidden i32 @nz_net_accept(i32 %fd) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %c = call i64 @accept(i64 %s, ptr null, ptr null)
  %bad = icmp eq i64 %c, -1
  br i1 %bad, label %fail, label %ok
fail:
  %e = call i32 @nz.win.wsa_errno()
  ret i32 -1
ok:
  %nfd = call i32 @nz.win.adopt(i64 %c)
  ret i32 %nfd
}

; A datagram, cut to `n` as POSIX cuts it (Winsock fills the buffer and says `WSAEMSGSIZE`); an
; unreachable port an earlier datagram met is not this socket's failure (Winsock's
; `WSAECONNRESET` on an unconnected socket), so it is passed over.
define hidden i64 @nz_net_recvfrom(i32 %fd, ptr %buf, i64 %n, ptr %sa, ptr %slen) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %m = call i32 @nz.win.count(i64 %n)
  %len0 = load i32, ptr %slen
  br label %try
try:
  store i32 %len0, ptr %slen
  %r = call i32 @recvfrom(i64 %s, ptr %buf, i32 %m, i32 0, ptr %sa, ptr %slen)
  %bad = icmp slt i32 %r, 0
  br i1 %bad, label %failed, label %done
failed:
  %w = call i32 @WSAGetLastError()
  %cut = icmp eq i32 %w, 10040
  br i1 %cut, label %whole, label %reset
whole:
  %mw = sext i32 %m to i64
  ret i64 %mw
reset:
  %gone = icmp eq i32 %w, 10054
  br i1 %gone, label %try, label %error
error:
  %e = call i32 @nz.win.wsa_map(i32 %w)
  call void @nz.win.set_errno(i32 %e)
  ret i64 -1
done:
  %x = sext i32 %r to i64
  ret i64 %x
}

define hidden i32 @nz_net_shutdown(i32 %fd, i32 %how) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %r = call i32 @shutdown(i64 %s, i32 %how)
  %w = call i64 @nz.win.result(i32 %r)
  %x = trunc i64 %w to i32
  ret i32 %x
}

define hidden i32 @nz_net_name(i32 %fd, i32 %peer, ptr %sa, ptr %slen) {
entry:
  %s = call i64 @nz.win.sock(i32 %fd)
  %want = icmp ne i32 %peer, 0
  br i1 %want, label %theirs, label %ours
theirs:
  %p = call i32 @getpeername(i64 %s, ptr %sa, ptr %slen)
  br label %done
ours:
  %o = call i32 @getsockname(i64 %s, ptr %sa, ptr %slen)
  br label %done
done:
  %r = phi i32 [ %p, %theirs ], [ %o, %ours ]
  %w = call i64 @nz.win.result(i32 %r)
  %x = trunc i64 %w to i32
  ret i32 %x
}

; The reactor's poller: the wake socket, made once; the queue number itself is not used.
define hidden i32 @nz_net_poller() {
entry:
  %sa = alloca [16 x i8], align 8
  %len = alloca i32, align 4
  %w = call i64 @socket(i32 2, i32 2, i32 0)
  %bad = icmp eq i64 %w, -1
  br i1 %bad, label %done, label %bind
bind:
  call void @llvm.memset.p0.i64(ptr %sa, i8 0, i64 16, i1 false)
  store i16 2, ptr %sa
  %ap = getelementptr i8, ptr %sa, i64 4
  store i32 16777343, ptr %ap
  %b = call i32 @bind(i64 %w, ptr %sa, i32 16)
  %bok = icmp eq i32 %b, 0
  br i1 %bok, label %name, label %drop
name:
  store i32 16, ptr %len
  %g = call i32 @getsockname(i64 %w, ptr %sa, ptr %len)
  %gok = icmp eq i32 %g, 0
  br i1 %gok, label %join, label %drop
join:
  %c = call i32 @connect(i64 %w, ptr %sa, i32 16)
  %cok = icmp eq i32 %c, 0
  br i1 %cok, label %keep, label %drop
keep:
  call void @nz.win.nonblocking(i64 %w)
  store atomic i64 %w, ptr @nz.win.wake release, align 8
  br label %done
drop:
  %x = call i32 @closesocket(i64 %w)
  br label %done
done:
  ret i32 0
}

; Interest in `fd`'s directions `mask`, for one event, which wakes handle `udata`.
define hidden i32 @nz_net_arm(i32 %q, i32 %fd, i64 %mask, i64 %udata) {
entry:
  %in = icmp ult i32 %fd, 4096
  br i1 %in, label %arm, label %done
arm:
  %i = zext i32 %fd to i64
  call void @AcquireSRWLockExclusive(ptr @nz.win.lock)
  %wp = getelementptr [4096 x i64], ptr @nz.win.want, i64 0, i64 %i
  store i64 %mask, ptr %wp
  %up = getelementptr [4096 x i64], ptr @nz.win.udata, i64 0, i64 %i
  store i64 %udata, ptr %up
  %top = load i64, ptr @nz.win.top
  %next = add i64 %i, 1
  %above = icmp ugt i64 %next, %top
  %top2 = select i1 %above, i64 %next, i64 %top
  store i64 %top2, ptr @nz.win.top
  call void @ReleaseSRWLockExclusive(ptr @nz.win.lock)
  call void @nz.win.poke()
  br label %done
done:
  ret i32 0
}

; Wait for events; each armed descriptor that has one is disarmed and its handle put in `out`
; (at most 64): the count. A pipe cannot be waited for with `WSAPoll`: one armed to read is ready
; when `PeekNamedPipe` sees bytes or a closed writer, one armed to write is ready at once (a full
; pipe takes nothing and is armed again), and while a pipe waits the reactor looks every 10 ms.
define hidden i64 @nz_net_poll(i32 %q, ptr %out) {
entry:
  %junk = alloca [64 x i8], align 8
  %avail = alloca i32, align 4
  %wake = load atomic i64, ptr @nz.win.wake acquire, align 8
  %haswake = icmp ne i64 %wake, 0
  call void @AcquireSRWLockExclusive(ptr @nz.win.lock)
  br i1 %haswake, label %first, label %gather
first:
  store i64 %wake, ptr @nz.win.fds
  %e0 = getelementptr i8, ptr @nz.win.fds, i64 8
  store i16 256, ptr %e0
  %r0 = getelementptr i8, ptr @nz.win.fds, i64 10
  store i16 0, ptr %r0
  store i32 -1, ptr @nz.win.idx
  br label %gather
gather:
  %n0 = select i1 %haswake, i64 1, i64 0
  %top = load i64, ptr @nz.win.top
  br label %scan
scan:
  %fd = phi i64 [ 0, %gather ], [ %fd1, %next ]
  %n = phi i64 [ %n0, %gather ], [ %nn, %next ]
  %k = phi i64 [ 0, %gather ], [ %kn, %next ]
  %piped = phi i1 [ false, %gather ], [ %pn, %next ]
  %more = icmp ult i64 %fd, %top
  %room = icmp ult i64 %k, 64
  %go = and i1 %more, %room
  br i1 %go, label %look, label %wait
look:
  %fd1 = add i64 %fd, 1
  %wp = getelementptr [4096 x i64], ptr @nz.win.want, i64 0, i64 %fd
  %m = load i64, ptr %wp
  %armed = icmp ne i64 %m, 0
  br i1 %armed, label %which, label %next
which:
  %sp = getelementptr [4096 x i64], ptr @nz.win.socks, i64 0, i64 %fd
  %s = load atomic i64, ptr %sp acquire, align 8
  %live = icmp ne i64 %s, 0
  br i1 %live, label %add, label %pipe
pipe:
  %wr0 = and i64 %m, 2
  %towrite = icmp ne i64 %wr0, 0
  br i1 %towrite, label %ready, label %peek
peek:
  %fd32p = trunc i64 %fd to i32
  %ph = call i64 @_get_osfhandle(i32 %fd32p)
  store i32 0, ptr %avail
  %pk = call i32 @PeekNamedPipe(i64 %ph, ptr null, i32 0, ptr null, ptr %avail, ptr null)
  %pfail = icmp eq i32 %pk, 0
  %av = load i32, ptr %avail
  %some = icmp ne i32 %av, 0
  %pready = or i1 %pfail, %some
  br i1 %pready, label %ready, label %later
ready:
  store i64 0, ptr %wp
  %rup = getelementptr [4096 x i64], ptr @nz.win.udata, i64 0, i64 %fd
  %ru = load i64, ptr %rup
  %rop = getelementptr i64, ptr %out, i64 %k
  store i64 %ru, ptr %rop
  %k1 = add i64 %k, 1
  br label %next
later:
  br label %next
add:
  %rd = and i64 %m, 1
  %wr = and i64 %m, 2
  %wantr = icmp ne i64 %rd, 0
  %wantw = icmp ne i64 %wr, 0
  %er = select i1 %wantr, i16 256, i16 0
  %ew = select i1 %wantw, i16 16, i16 0
  %ev = or i16 %er, %ew
  %off = mul i64 %n, 16
  %pf = getelementptr i8, ptr @nz.win.fds, i64 %off
  store i64 %s, ptr %pf
  %pe = getelementptr i8, ptr %pf, i64 8
  store i16 %ev, ptr %pe
  %pr = getelementptr i8, ptr %pf, i64 10
  store i16 0, ptr %pr
  %ip = getelementptr i32, ptr @nz.win.idx, i64 %n
  %fd32 = trunc i64 %fd to i32
  store i32 %fd32, ptr %ip
  %n1 = add i64 %n, 1
  br label %next
next:
  %nn = phi i64 [ %n, %look ], [ %n, %ready ], [ %n, %later ], [ %n1, %add ]
  %kn = phi i64 [ %k, %look ], [ %k1, %ready ], [ %k, %later ], [ %k, %add ]
  %pn = phi i1 [ %piped, %look ], [ %piped, %ready ], [ true, %later ], [ %piped, %add ]
  br label %scan
wait:
  call void @ReleaseSRWLockExclusive(ptr @nz.win.lock)
  %pipes = icmp ne i64 %k, 0
  br i1 %pipes, label %quick, label %sockets
quick:
  ret i64 %k
sockets:
  %empty = icmp eq i64 %n, 0
  br i1 %empty, label %idle, label %poll
idle:
  %nap = select i1 %piped, i32 10, i32 20
  call void @Sleep(i32 %nap)
  ret i64 0
poll:
  %t0 = select i1 %haswake, i32 -1, i32 20
  %timeout = select i1 %piped, i32 10, i32 %t0
  %n32 = trunc i64 %n to i32
  %r = call i32 @WSAPoll(ptr @nz.win.fds, i32 %n32, i32 %timeout)
  %fired = icmp sgt i32 %r, 0
  br i1 %fired, label %collect, label %none
none:
  %err = icmp slt i32 %r, 0
  br i1 %err, label %rest, label %quiet
rest:
  call void @Sleep(i32 1)
  br label %quiet
quiet:
  ret i64 0
collect:
  call void @AcquireSRWLockExclusive(ptr @nz.win.lock)
  br label %each
each:
  %i = phi i64 [ 0, %collect ], [ %i1, %step ]
  %c = phi i64 [ 0, %collect ], [ %c2, %step ]
  %left = icmp ult i64 %i, %n
  %space = icmp ult i64 %c, 64
  %more2 = and i1 %left, %space
  br i1 %more2, label %one, label %finish
one:
  %i1 = add i64 %i, 1
  %eoff = mul i64 %i, 16
  %ef = getelementptr i8, ptr @nz.win.fds, i64 %eoff
  %erp = getelementptr i8, ptr %ef, i64 10
  %rev = load i16, ptr %erp
  %hit = icmp ne i16 %rev, 0
  br i1 %hit, label %whose, label %step
whose:
  %eip = getelementptr i32, ptr @nz.win.idx, i64 %i
  %f = load i32, ptr %eip
  %iswake = icmp slt i32 %f, 0
  br i1 %iswake, label %drain, label %event
drain:
  %d = call i32 @recv(i64 %wake, ptr %junk, i32 64, i32 0)
  %again = icmp sgt i32 %d, 0
  br i1 %again, label %drain, label %step
event:
  %fi = zext i32 %f to i64
  %ewp = getelementptr [4096 x i64], ptr @nz.win.want, i64 0, i64 %fi
  %em = load i64, ptr %ewp
  %esp = getelementptr [4096 x i64], ptr @nz.win.socks, i64 0, i64 %fi
  %es = load atomic i64, ptr %esp acquire, align 8
  %polled = load i64, ptr %ef
  %still = icmp ne i64 %em, 0
  %same = icmp eq i64 %es, %polled
  %fire = and i1 %still, %same
  br i1 %fire, label %report, label %step
report:
  store i64 0, ptr %ewp
  %eup = getelementptr [4096 x i64], ptr @nz.win.udata, i64 0, i64 %fi
  %u = load i64, ptr %eup
  %op = getelementptr i64, ptr %out, i64 %c
  store i64 %u, ptr %op
  %cr = add i64 %c, 1
  br label %step
step:
  %c2 = phi i64 [ %c, %one ], [ %c, %drain ], [ %c, %event ], [ %cr, %report ]
  br label %each
finish:
  call void @ReleaseSRWLockExclusive(ptr @nz.win.lock)
  ret i64 %c
}

; A write to a socket, or to a pipe: a full pipe takes nothing (EAGAIN), and one whose reader has
; gone is a broken pipe (EPIPE), never a signal.
define hidden i64 @nz_net_write(i32 %fd, ptr %buf, i64 %n) {
entry:
  %put = alloca i32, align 4
  %s = call i64 @nz.win.sock(i32 %fd)
  %m = call i32 @nz.win.count(i64 %n)
  %sock = icmp ne i64 %s, 0
  br i1 %sock, label %send, label %plain
send:
  %r = call i32 @send(i64 %s, ptr %buf, i32 %m, i32 0)
  %rw = call i64 @nz.win.result(i32 %r)
  ret i64 %rw
plain:
  %h = call i64 @_get_osfhandle(i32 %fd)
  store i32 0, ptr %put
  %ok = call i32 @WriteFile(i64 %h, ptr %buf, i32 %m, ptr %put, ptr null)
  %fine = icmp ne i32 %ok, 0
  br i1 %fine, label %wrote, label %failed
wrote:
  %p = load i32, ptr %put
  %none = icmp eq i32 %p, 0
  %asked = icmp ne i32 %m, 0
  %full = and i1 %none, %asked
  br i1 %full, label %block, label %done
block:
  call void @nz.win.set_errno(i32 11)
  ret i64 -1
done:
  %pw = zext i32 %p to i64
  ret i64 %pw
failed:
  %w = call i32 @GetLastError()
  %closing = icmp eq i32 %w, 232
  %broken = icmp eq i32 %w, 109
  %gone = or i1 %closing, %broken
  br i1 %gone, label %pipe, label %other
pipe:
  call void @nz.win.set_errno(i32 32)
  ret i64 -1
other:
  %e = call i32 @nz.win.last_errno()
  call void @nz.win.set_errno(i32 %e)
  ret i64 -1
}

; Children are started one at a time: between making a child's inheritable pipe ends and closing
; them, no other child may be started to inherit them too.
@nz.win.spawning = internal global ptr null

; `arg` (a C string) onto `dst` as the C runtime's command-line parser reads it back: bare when it
; is not empty and holds no blank or quote, else quoted, a backslash doubled where a quote or the
; closing quote follows it. At most twice its length and three more; the end.
define internal ptr @nz.win.quote(ptr %dst, ptr %arg) {
entry:
  %c0 = load i8, ptr %arg
  %empty = icmp eq i8 %c0, 0
  br i1 %empty, label %quoted, label %scan
scan:
  %sp = phi ptr [ %arg, %entry ], [ %sp1, %plainch ]
  %sc = load i8, ptr %sp
  switch i8 %sc, label %plainch [
    i8 0, label %bare
    i8 32, label %quoted
    i8 9, label %quoted
    i8 10, label %quoted
    i8 11, label %quoted
    i8 34, label %quoted
  ]
plainch:
  %sp1 = getelementptr i8, ptr %sp, i64 1
  br label %scan
bare:
  %len = call i64 @strlen(ptr %arg)
  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %arg, i64 %len, i1 false)
  %bend = getelementptr i8, ptr %dst, i64 %len
  ret ptr %bend
quoted:
  store i8 34, ptr %dst
  %d1 = getelementptr i8, ptr %dst, i64 1
  br label %char
char:
  %p = phi ptr [ %arg, %quoted ], [ %pn, %emitted ]
  %d = phi ptr [ %d1, %quoted ], [ %dn, %emitted ]
  %slashes = phi i64 [ 0, %quoted ], [ %sl, %emitted ]
  %c = load i8, ptr %p
  %pn = getelementptr i8, ptr %p, i64 1
  switch i8 %c, label %ordinary [
    i8 0, label %close
    i8 92, label %slash
    i8 34, label %quote
  ]
slash:
  store i8 92, ptr %d
  %ds = getelementptr i8, ptr %d, i64 1
  %sl1 = add i64 %slashes, 1
  br label %emitted
quote:
  %qn = add i64 %slashes, 1
  %dq = call ptr @nz.win.slashes(ptr %d, i64 %qn)
  store i8 34, ptr %dq
  %dq1 = getelementptr i8, ptr %dq, i64 1
  br label %emitted
ordinary:
  store i8 %c, ptr %d
  %do = getelementptr i8, ptr %d, i64 1
  br label %emitted
emitted:
  %dn = phi ptr [ %ds, %slash ], [ %dq1, %quote ], [ %do, %ordinary ]
  %sl = phi i64 [ %sl1, %slash ], [ 0, %quote ], [ 0, %ordinary ]
  br label %char
close:
  %dc = call ptr @nz.win.slashes(ptr %d, i64 %slashes)
  store i8 34, ptr %dc
  %dend = getelementptr i8, ptr %dc, i64 1
  ret ptr %dend
}

; `n` backslashes onto `dst`: the end.
define internal ptr @nz.win.slashes(ptr %dst, i64 %n) {
entry:
  call void @llvm.memset.p0.i64(ptr %dst, i8 92, i64 %n, i1 false)
  %end = getelementptr i8, ptr %dst, i64 %n
  ret ptr %end
}

; Three pipes and the child (`CreateProcessW`, the command line `argv` quoted), with `envp` (null:
; this environment) as a UTF-16 block, in `dir` (null: here), by `flags` — 1 a new process group
; (`CREATE_NEW_PROCESS_GROUP`), 2 its standard input `NUL` and the input pipe's end at `ends` -1;
; the parent's ends as descriptors at `ends`, the process handle at `pid`; 0 or an errno.
define hidden i32 @nz_os_spawn_in(ptr %pid, ptr %prog, ptr %av, ptr %envp, ptr %dir, i64 %flags, ptr %ends) {
entry:
  %sa = alloca [24 x i8], align 8
  %si = alloca [104 x i8], align 8
  %pi = alloca [24 x i8], align 8
  %hs = alloca [6 x i64], align 8
  br label %measure
measure:
  %i = phi i64 [ 0, %entry ], [ %i1, %count ]
  %total = phi i64 [ 1, %entry ], [ %t1, %count ]
  %ap = getelementptr ptr, ptr %av, i64 %i
  %a = load ptr, ptr %ap
  %end = icmp eq ptr %a, null
  br i1 %end, label %alloc, label %count
count:
  %l = call i64 @strlen(ptr %a)
  %l2 = mul i64 %l, 2
  %l3 = add i64 %l2, 4
  %t1 = add i64 %total, %l3
  %i1 = add i64 %i, 1
  br label %measure
alloc:
  %line = call ptr @malloc(i64 %total)
  %noline = icmp eq ptr %line, null
  br i1 %noline, label %oom, label %write
oom:
  ret i32 12
write:
  %j = phi i64 [ 0, %alloc ], [ %j1, %wrote ]
  %d = phi ptr [ %line, %alloc ], [ %dn, %wrote ]
  %bp = getelementptr ptr, ptr %av, i64 %j
  %b = load ptr, ptr %bp
  %last = icmp eq ptr %b, null
  br i1 %last, label %terminated, label %arg
arg:
  %first = icmp eq i64 %j, 0
  br i1 %first, label %quote, label %space
space:
  store i8 32, ptr %d
  %d2 = getelementptr i8, ptr %d, i64 1
  br label %quote
quote:
  %dd = phi ptr [ %d, %arg ], [ %d2, %space ]
  %dn = call ptr @nz.win.quote(ptr %dd, ptr %b)
  br label %wrote
wrote:
  %j1 = add i64 %j, 1
  br label %write
terminated:
  store i8 0, ptr %d
  %cmd = call ptr @nz.win.wide(ptr %line)
  call void @free(ptr %line)
  %nocmd = icmp eq ptr %cmd, null
  br i1 %nocmd, label %badcmd, label %block
badcmd:
  ret i32 84
block:
  %hasenv = icmp ne ptr %envp, null
  br i1 %hasenv, label %makeenv, label %where
makeenv:
  %eb = call ptr @nz.win.env_block(ptr %envp)
  %noeb = icmp eq ptr %eb, null
  br i1 %noeb, label %badenv, label %where
badenv:
  call void @free(ptr %cmd)
  ret i32 84
where:
  %envblock = phi ptr [ null, %block ], [ %eb, %makeenv ]
  %hasdir = icmp ne ptr %dir, null
  br i1 %hasdir, label %widedir, label %pipes
widedir:
  %wd = call ptr @nz.win.wide(ptr %dir)
  %nowd = icmp eq ptr %wd, null
  br i1 %nowd, label %baddir, label %pipes
baddir:
  call void @free(ptr %cmd)
  call void @free(ptr %envblock)
  ret i32 84
pipes:
  %wdir = phi ptr [ null, %where ], [ %wd, %widedir ]
  call void @llvm.memset.p0.i64(ptr %sa, i8 0, i64 24, i1 false)
  store i32 24, ptr %sa
  %inh = getelementptr i8, ptr %sa, i64 16
  store i32 1, ptr %inh
  call void @AcquireSRWLockExclusive(ptr @nz.win.spawning)
  %h0 = getelementptr i64, ptr %hs, i64 0
  %h1 = getelementptr i64, ptr %hs, i64 1
  %h2 = getelementptr i64, ptr %hs, i64 2
  %h3 = getelementptr i64, ptr %hs, i64 3
  %h4 = getelementptr i64, ptr %hs, i64 4
  %h5 = getelementptr i64, ptr %hs, i64 5
  call void @llvm.memset.p0.i64(ptr %hs, i8 0, i64 48, i1 false)
  %c0 = call i32 @CreatePipe(ptr %h0, ptr %h1, ptr %sa, i32 0)
  %c1 = call i32 @CreatePipe(ptr %h2, ptr %h3, ptr %sa, i32 0)
  %c2 = call i32 @CreatePipe(ptr %h4, ptr %h5, ptr %sa, i32 0)
  %ok01 = and i32 %c0, %c1
  %ok012 = and i32 %ok01, %c2
  %made = icmp ne i32 %ok012, 0
  br i1 %made, label %nulcheck, label %nopipe
nopipe:
  %pe = call i32 @nz.win.last_errno()
  call void @nz.win.close_all(ptr %hs)
  call void @ReleaseSRWLockExclusive(ptr @nz.win.spawning)
  call void @free(ptr %cmd)
  call void @free(ptr %envblock)
  call void @free(ptr %wdir)
  ret i32 %pe
nulcheck:
  %nullbit = and i64 %flags, 2
  %nullin = icmp ne i64 %nullbit, 0
  br i1 %nullin, label %opennul, label %start
opennul:
  %nf = call i64 @CreateFileW(ptr @.nz.win.wnul, i32 -2147483648, i32 3, ptr %sa, i32 3, i32 0, i64 0)
  %nulbad = icmp eq i64 %nf, -1
  br i1 %nulbad, label %nonul, label %start
nonul:
  %ne = call i32 @nz.win.last_errno()
  call void @nz.win.close_all(ptr %hs)
  call void @ReleaseSRWLockExclusive(ptr @nz.win.spawning)
  call void @free(ptr %cmd)
  call void @free(ptr %envblock)
  call void @free(ptr %wdir)
  ret i32 %ne
start:
  %nulh = phi i64 [ 0, %nulcheck ], [ %nf, %opennul ]
  ; The child's ends: input's read (0) or `NUL`, output's write (3), errors' write (5).
  %in0 = load i64, ptr %h0
  %in1 = load i64, ptr %h1
  %out0 = load i64, ptr %h2
  %out1 = load i64, ptr %h3
  %err0 = load i64, ptr %h4
  %err1 = load i64, ptr %h5
  %x0 = call i32 @SetHandleInformation(i64 %in1, i32 1, i32 0)
  %x1 = call i32 @SetHandleInformation(i64 %out0, i32 1, i32 0)
  %x2 = call i32 @SetHandleInformation(i64 %err0, i32 1, i32 0)
  call void @llvm.memset.p0.i64(ptr %si, i8 0, i64 104, i1 false)
  store i32 104, ptr %si
  %sflags = getelementptr i8, ptr %si, i64 60
  store i32 256, ptr %sflags
  %childin = select i1 %nullin, i64 %nulh, i64 %in0
  %sin = getelementptr i8, ptr %si, i64 80
  store i64 %childin, ptr %sin
  %sout = getelementptr i8, ptr %si, i64 88
  store i64 %out1, ptr %sout
  %serr = getelementptr i8, ptr %si, i64 96
  store i64 %err1, ptr %serr
  call void @llvm.memset.p0.i64(ptr %pi, i8 0, i64 24, i1 false)
  %groupbit = and i64 %flags, 1
  %group = icmp ne i64 %groupbit, 0
  %cg = select i1 %group, i32 512, i32 0
  %ce = select i1 %hasenv, i32 1024, i32 0
  %creation = or i32 %cg, %ce
  %r = call i32 @CreateProcessW(ptr null, ptr %cmd, ptr null, ptr null, i32 1, i32 %creation, ptr %envblock, ptr %wdir, ptr %si, ptr %pi)
  %re = call i32 @nz.win.last_errno()
  %k0 = call i32 @CloseHandle(i64 %in0)
  %k1 = call i32 @CloseHandle(i64 %out1)
  %k2 = call i32 @CloseHandle(i64 %err1)
  br i1 %nullin, label %closenul, label %released
closenul:
  %kn = call i32 @CloseHandle(i64 %nulh)
  br label %released
released:
  call void @ReleaseSRWLockExclusive(ptr @nz.win.spawning)
  call void @free(ptr %cmd)
  call void @free(ptr %envblock)
  call void @free(ptr %wdir)
  %started = icmp ne i32 %r, 0
  br i1 %started, label %adopt, label %undo
undo:
  %u0 = call i32 @CloseHandle(i64 %in1)
  %u1 = call i32 @CloseHandle(i64 %out0)
  %u2 = call i32 @CloseHandle(i64 %err0)
  ret i32 %re
adopt:
  %proc = load i64, ptr %pi
  %thp = getelementptr i8, ptr %pi, i64 8
  %th = load i64, ptr %thp
  %kt = call i32 @CloseHandle(i64 %th)
  store i64 %proc, ptr %pid
  %f1 = call i32 @_open_osfhandle(i64 %out0, i32 32768)
  %f2 = call i32 @_open_osfhandle(i64 %err0, i32 32768)
  br i1 %nullin, label %noinput, label %input
noinput:
  %u3 = call i32 @CloseHandle(i64 %in1)
  store i32 -1, ptr %ends
  br label %rest
input:
  %f0 = call i32 @_open_osfhandle(i64 %in1, i32 32769)
  store i32 %f0, ptr %ends
  br label %rest
rest:
  %e1 = getelementptr i32, ptr %ends, i64 1
  store i32 %f1, ptr %e1
  %e2 = getelementptr i32, ptr %ends, i64 2
  store i32 %f2, ptr %e2
  ret i32 0
}

@.nz.win.wnul = private unnamed_addr constant [4 x i16] [i16 78, i16 85, i16 76, i16 0]

; A child's environment block: each entry of `envp` (UTF-8, already ordered by name) as UTF-16 and
; NUL-terminated, then one more NUL; null when an entry is not UTF-8 or memory is refused.
define internal ptr @nz.win.env_block(ptr %envp) {
entry:
  br label %measure
measure:
  %i = phi i64 [ 0, %entry ], [ %i1, %counted ]
  %total = phi i64 [ 0, %entry ], [ %t1, %counted ]
  %ep = getelementptr ptr, ptr %envp, i64 %i
  %e = load ptr, ptr %ep
  %end = icmp eq ptr %e, null
  br i1 %end, label %alloc, label %count
count:
  %n = call i32 @MultiByteToWideChar(i32 65001, i32 8, ptr %e, i32 -1, ptr null, i32 0)
  %bad = icmp eq i32 %n, 0
  br i1 %bad, label %fail, label %counted
counted:
  %nw = zext i32 %n to i64
  %t1 = add i64 %total, %nw
  %i1 = add i64 %i, 1
  br label %measure
fail:
  ret ptr null
alloc:
  %slots = add i64 %total, 2
  %bytes = mul i64 %slots, 2
  %blk = call ptr @malloc(i64 %bytes)
  %none = icmp eq ptr %blk, null
  br i1 %none, label %fail, label %zero
zero:
  call void @llvm.memset.p0.i64(ptr %blk, i8 0, i64 %bytes, i1 false)
  br label %fill
fill:
  %k = phi i64 [ 0, %zero ], [ %k1, %put ]
  %at = phi i64 [ 0, %zero ], [ %at1, %put ]
  %fp = getelementptr ptr, ptr %envp, i64 %k
  %f = load ptr, ptr %fp
  %done = icmp eq ptr %f, null
  br i1 %done, label %finish, label %put
put:
  %room = sub i64 %slots, %at
  %room32 = trunc i64 %room to i32
  %off = mul i64 %at, 2
  %dst = getelementptr i8, ptr %blk, i64 %off
  %w = call i32 @MultiByteToWideChar(i32 65001, i32 8, ptr %f, i32 -1, ptr %dst, i32 %room32)
  %ww = zext i32 %w to i64
  %at1 = add i64 %at, %ww
  %k1 = add i64 %k, 1
  br label %fill
finish:
  ret ptr %blk
}

define internal void @nz.win.close_all(ptr %hs) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %next ]
  %p = getelementptr i64, ptr %hs, i64 %i
  %h = load i64, ptr %p
  %some = icmp ne i64 %h, 0
  br i1 %some, label %close, label %next
close:
  %c = call i32 @CloseHandle(i64 %h)
  br label %next
next:
  %i1 = add i64 %i, 1
  %more = icmp ult i64 %i1, 6
  br i1 %more, label %loop, label %done
done:
  ret void
}

; The child's exit code once it has ended, its peak working set at `rss` and its process handle
; closed; with `block` 0 and the child running, -EAGAIN.
define hidden i64 @nz_os_reap(i64 %pid, i32 %block, ptr %rss) {
entry:
  %code = alloca i32, align 4
  %pmc = alloca [72 x i8], align 8
  %waits = icmp ne i32 %block, 0
  %ms = select i1 %waits, i32 -1, i32 0
  %w = call i32 @WaitForSingleObject(i64 %pid, i32 %ms)
  %waited = icmp eq i32 %w, 0
  br i1 %waited, label %ended, label %notyet
notyet:
  %running = icmp eq i32 %w, 258
  br i1 %running, label %again, label %failed
again:
  ret i64 -11
failed:
  %e = call i32 @nz.win.last_errno()
  %ew = zext i32 %e to i64
  %neg = sub i64 0, %ew
  ret i64 %neg
ended:
  call void @llvm.memset.p0.i64(ptr %pmc, i8 0, i64 72, i1 false)
  store i32 72, ptr %pmc
  %m = call i32 @K32GetProcessMemoryInfo(i64 %pid, ptr %pmc, i32 72)
  %peakp = getelementptr i8, ptr %pmc, i64 8
  %peak = load i64, ptr %peakp
  store i64 %peak, ptr %rss
  store i32 0, ptr %code
  %g = call i32 @GetExitCodeProcess(i64 %pid, ptr %code)
  %c = load i32, ptr %code
  %k = call i32 @CloseHandle(i64 %pid)
  %cw = zext i32 %c to i64
  ret i64 %cw
}

; `TerminateProcess` with exit code 1 (`docs/spec.md` *Windows x86_64*: there are no signals); a
; child that has already ended is not an error, as `kill` on one not yet waited for is not.
define hidden i32 @nz_os_terminate(i64 %pid) {
entry:
  %code = alloca i32, align 4
  %r = call i32 @TerminateProcess(i64 %pid, i32 1)
  %ok = icmp ne i32 %r, 0
  br i1 %ok, label %done, label %check
check:
  %e = call i32 @nz.win.last_errno()
  store i32 259, ptr %code
  %g = call i32 @GetExitCodeProcess(i64 %pid, ptr %code)
  %c = load i32, ptr %code
  %gone = icmp ne i32 %c, 259
  br i1 %gone, label %done, label %fail
fail:
  call void @nz.win.set_errno(i32 %e)
  ret i32 -1
done:
  ret i32 0
}

define hidden i32 @nz_os_key() {
entry:
  %fd = call i32 (ptr, i32, ...) @_open(ptr @.nz.win.nul, i32 128)
  ret i32 %fd
}

; The child's process id, from its handle.
define hidden i64 @nz_os_child_id(i64 %pid) {
entry:
  %id = call i32 @GetProcessId(i64 %pid)
  %w = zext i32 %id to i64
  ret i64 %w
}

define hidden i64 @nz_os_pid() {
entry:
  %id = call i32 @GetCurrentProcessId()
  %w = zext i32 %id to i64
  ret i64 %w
}

; There are no process groups (`docs/spec.md`, *The platform, further*): the process `pgid` itself,
; asked whether it exists (`sig` 0) or ended with exit code 1; ESRCH for one there is not.
define hidden i32 @nz_os_signal_group(i64 %pgid, i64 %sig) {
entry:
  %id = trunc i64 %pgid to i32
  %ask = icmp eq i64 %sig, 0
  %access = select i1 %ask, i32 4096, i32 1
  %h = call i64 @OpenProcess(i32 %access, i32 0, i32 %id)
  %none = icmp eq i64 %h, 0
  br i1 %none, label %missing, label %found
missing:
  %w = call i32 @GetLastError()
  %invalid = icmp eq i32 %w, 87
  br i1 %invalid, label %nosuch, label %other
nosuch:
  call void @nz.win.set_errno(i32 3)
  ret i32 -1
other:
  %e = call i32 @nz.win.last_errno()
  call void @nz.win.set_errno(i32 %e)
  ret i32 -1
found:
  br i1 %ask, label %close, label %end
end:
  %t = call i32 @TerminateProcess(i64 %h, i32 1)
  %ok = icmp ne i32 %t, 0
  br i1 %ok, label %close, label %refused
refused:
  %re = call i32 @nz.win.last_errno()
  %k1 = call i32 @CloseHandle(i64 %h)
  call void @nz.win.set_errno(i32 %re)
  ret i32 -1
close:
  %k = call i32 @CloseHandle(i64 %h)
  ret i32 0
}

define hidden void @nz_os_nap(i64 %ms) {
entry:
  %m = trunc i64 %ms to i32
  call void @Sleep(i32 %m)
  ret void
}
"#
}

pub fn rt_platform_WINDOWS_FS() -> Str ! {} {
    r#"
declare i64 @CreateFileW(ptr, i32, i32, ptr, i32, i32, i64)
declare i32 @GetFileInformationByHandle(i64, ptr)
declare i32 @GetFinalPathNameByHandleW(i64, ptr, i32, i32)
declare i32 @LockFileEx(i64, i32, i32, i32, i32, ptr)
declare i32 @UnlockFileEx(i64, i32, i32, i32, ptr)
declare i32 @_wchmod(ptr, i32)
declare i32 @GetProcessId(i64)
declare i32 @GetCurrentProcessId()
declare i64 @OpenProcess(i32, i32, i32)
declare i32 @K32GetProcessMemoryInfo(i64, ptr, i32)

; `path` itself, opened for its facts only (FILE_FLAG_BACKUP_SEMANTICS and, with `follow` 0,
; FILE_FLAG_OPEN_REPARSE_POINT); -1 with errno set when it cannot be.
define internal i64 @nz.win.open_facts(ptr %path, i32 %follow) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i64 -1
go:
  %follows = icmp ne i32 %follow, 0
  %flags = select i1 %follows, i32 33554432, i32 35651584
  %h = call i64 @CreateFileW(ptr %w, i32 0, i32 7, ptr null, i32 3, i32 %flags, i64 0)
  %e = call i32 @nz.win.last_errno()
  call void @free(ptr %w)
  %bad = icmp eq i64 %h, -1
  br i1 %bad, label %err, label %done
err:
  call void @nz.win.set_errno(i32 %e)
  ret i64 -1
done:
  ret i64 %h
}

; Size, kind (0 a file, 1 a directory, 3 any reparse point), modification time in nanoseconds since
; the Unix epoch, permission bits (0o444 read-only or 0o666, and 0o111 more for a directory), the
; volume's serial number and the file index, as six i64s at `out`; 0, or -1 with errno set.
; `BY_HANDLE_FILE_INFORMATION`: attributes at 0, the last write at 20, the serial at 28, the size
; high and low at 32 and 36, the index high and low at 44 and 48.
define hidden i32 @nz_os_lstat(ptr %path, ptr %out) {
entry:
  %info = alloca [52 x i8], align 8
  %h = call i64 @nz.win.open_facts(ptr %path, i32 0)
  %bad = icmp eq i64 %h, -1
  br i1 %bad, label %fail, label %ask
fail:
  ret i32 -1
ask:
  %ok = call i32 @GetFileInformationByHandle(i64 %h, ptr %info)
  %e = call i32 @nz.win.last_errno()
  %k = call i32 @CloseHandle(i64 %h)
  %got = icmp ne i32 %ok, 0
  br i1 %got, label %facts, label %err
err:
  call void @nz.win.set_errno(i32 %e)
  ret i32 -1
facts:
  %attrs = load i32, ptr %info
  %shp = getelementptr i8, ptr %info, i64 32
  %sh = load i32, ptr %shp
  %slp = getelementptr i8, ptr %info, i64 36
  %sl = load i32, ptr %slp
  %shw = zext i32 %sh to i64
  %slw = zext i32 %sl to i64
  %shs = shl i64 %shw, 32
  %size = or i64 %shs, %slw
  store i64 %size, ptr %out
  %rp = and i32 %attrs, 1024
  %isreparse = icmp ne i32 %rp, 0
  %dp = and i32 %attrs, 16
  %isdir = icmp ne i32 %dp, 0
  %k1 = select i1 %isdir, i64 1, i64 0
  %kind = select i1 %isreparse, i64 3, i64 %k1
  %kindp = getelementptr i8, ptr %out, i64 8
  store i64 %kind, ptr %kindp
  %flp = getelementptr i8, ptr %info, i64 20
  %fl = load i32, ptr %flp
  %fhp = getelementptr i8, ptr %info, i64 24
  %fh = load i32, ptr %fhp
  %flw = zext i32 %fl to i64
  %fhw = zext i32 %fh to i64
  %fhs = shl i64 %fhw, 32
  %ft = or i64 %fhs, %flw
  %unix = sub i64 %ft, 116444736000000000
  %mtime = mul i64 %unix, 100
  %mtimep = getelementptr i8, ptr %out, i64 16
  store i64 %mtime, ptr %mtimep
  %ro = and i32 %attrs, 1
  %readonly = icmp ne i32 %ro, 0
  %base = select i1 %readonly, i64 292, i64 438
  %exec = select i1 %isdir, i64 73, i64 0
  %perm = or i64 %base, %exec
  %permp = getelementptr i8, ptr %out, i64 24
  store i64 %perm, ptr %permp
  %serp = getelementptr i8, ptr %info, i64 28
  %ser = load i32, ptr %serp
  %serw = zext i32 %ser to i64
  %devp = getelementptr i8, ptr %out, i64 32
  store i64 %serw, ptr %devp
  %ihp = getelementptr i8, ptr %info, i64 44
  %ih = load i32, ptr %ihp
  %ilp = getelementptr i8, ptr %info, i64 48
  %il = load i32, ptr %ilp
  %ihw = zext i32 %ih to i64
  %ilw = zext i32 %il to i64
  %ihs = shl i64 %ihw, 32
  %ino = or i64 %ihs, %ilw
  %inop = getelementptr i8, ptr %out, i64 40
  store i64 %ino, ptr %inop
  ret i32 0
}

define hidden i32 @nz_os_chmod(ptr %path, i64 %mode) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  %m = trunc i64 %mode to i32
  %r = call i32 @_wchmod(ptr %w, i32 %m)
  call void @free(ptr %w)
  ret i32 %r
}

; The final path of what `path` names, UTF-8, `\\?\` dropped before a drive: its length, copied
; to `out` when it fits in `cap` bytes; or -1 with errno set.
define hidden i64 @nz_os_realpath(ptr %path, ptr %out, i64 %cap) {
entry:
  %h = call i64 @nz.win.open_facts(ptr %path, i32 1)
  %bad = icmp eq i64 %h, -1
  br i1 %bad, label %fail, label %room
fail:
  ret i64 -1
room:
  %buf = call ptr @malloc(i64 65536)
  %nobuf = icmp eq ptr %buf, null
  br i1 %nobuf, label %nomem, label %ask
nomem:
  %k0 = call i32 @CloseHandle(i64 %h)
  call void @nz.win.set_errno(i32 12)
  ret i64 -1
ask:
  %n = call i32 @GetFinalPathNameByHandleW(i64 %h, ptr %buf, i32 32767, i32 0)
  %e = call i32 @nz.win.last_errno()
  %k = call i32 @CloseHandle(i64 %h)
  %zero = icmp eq i32 %n, 0
  %over = icmp sgt i32 %n, 32766
  %failed = or i1 %zero, %over
  br i1 %failed, label %err, label %prefix
err:
  call void @free(ptr %buf)
  call void @nz.win.set_errno(i32 %e)
  ret i64 -1
prefix:
  ; `\\?\C:` — a backslash at 0, 1 and 3, a question mark at 2, a colon at 5.
  %long = icmp sgt i32 %n, 5
  br i1 %long, label %check, label %whole
check:
  %c0 = load i16, ptr %buf
  %p2 = getelementptr i8, ptr %buf, i64 4
  %c2 = load i16, ptr %p2
  %p5 = getelementptr i8, ptr %buf, i64 10
  %c5 = load i16, ptr %p5
  %s0 = icmp eq i16 %c0, 92
  %q2 = icmp eq i16 %c2, 63
  %d5 = icmp eq i16 %c5, 58
  %a = and i1 %s0, %q2
  %drive = and i1 %a, %d5
  br i1 %drive, label %strip, label %whole
strip:
  %from = getelementptr i8, ptr %buf, i64 8
  %n4 = sub i32 %n, 4
  br label %convert
whole:
  br label %convert
convert:
  %src = phi ptr [ %from, %strip ], [ %buf, %whole ]
  %len = phi i32 [ %n4, %strip ], [ %n, %whole ]
  %need = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %src, i32 %len, ptr null, i32 0, ptr null, ptr null)
  %bad8 = icmp eq i32 %need, 0
  br i1 %bad8, label %notutf16, label %fits
notutf16:
  call void @free(ptr %buf)
  call void @nz.win.set_errno(i32 42)
  ret i64 -1
fits:
  %needw = sext i32 %need to i64
  %small = icmp sle i64 %needw, %cap
  br i1 %small, label %copy, label %done
copy:
  %wrote = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %src, i32 %len, ptr %out, i32 %need, ptr null, ptr null)
  br label %done
done:
  call void @free(ptr %buf)
  ret i64 %needw
}

; `flock`'s operation by `LockFileEx` over the whole file: 1 shared, 2 exclusive, 8 unlocked, 4
; not waiting (LOCKFILE_FAIL_IMMEDIATELY), its refusal EAGAIN; unlocking what is not locked is not
; an error, as for `flock`.
define hidden i32 @nz_os_flock(i32 %fd, i32 %op) {
entry:
  %ov = alloca [32 x i8], align 8
  call void @llvm.memset.p0.i64(ptr %ov, i8 0, i64 32, i1 false)
  %h = call i64 @_get_osfhandle(i32 %fd)
  %un = and i32 %op, 8
  %unlock = icmp ne i32 %un, 0
  br i1 %unlock, label %release, label %take
release:
  %ru = call i32 @UnlockFileEx(i64 %h, i32 0, i32 -1, i32 -1, ptr %ov)
  %rok = icmp ne i32 %ru, 0
  br i1 %rok, label %done, label %rfail
rfail:
  %rw = call i32 @GetLastError()
  %notlocked = icmp eq i32 %rw, 158
  br i1 %notlocked, label %done, label %error
take:
  %ex = and i32 %op, 2
  %nb = and i32 %op, 4
  %exf = icmp ne i32 %ex, 0
  %nbf = icmp ne i32 %nb, 0
  %f1 = select i1 %exf, i32 2, i32 0
  %f2 = select i1 %nbf, i32 1, i32 0
  %flags = or i32 %f1, %f2
  %rl = call i32 @LockFileEx(i64 %h, i32 %flags, i32 0, i32 -1, i32 -1, ptr %ov)
  %lok = icmp ne i32 %rl, 0
  br i1 %lok, label %done, label %lfail
lfail:
  %lw = call i32 @GetLastError()
  %held = icmp eq i32 %lw, 33
  br i1 %held, label %busy, label %error
busy:
  call void @nz.win.set_errno(i32 11)
  ret i32 -1
error:
  %e = call i32 @nz.win.last_errno()
  call void @nz.win.set_errno(i32 %e)
  ret i32 -1
done:
  ret i32 0
}
"#
}

pub fn rt_platform_WINDOWS_INIT() -> Str ! {} {
    r#"; Generated by nazm build. Do not edit.
source_filename = "init"

declare i32 @_setmode(i32, i32)
declare i32 @WSAStartup(i16, ptr)
declare i32 @__wgetmainargs(ptr, ptr, ptr, i32, ptr)
declare i32 @WideCharToMultiByte(i32, i32, ptr, i32, ptr, i32, ptr, ptr)
declare ptr @malloc(i64)

@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 101, ptr @nz.win.init, ptr null }]

define internal void @nz.win.init() {
entry:
  %wsa = alloca [408 x i8], align 8
  %w = call i32 @WSAStartup(i16 514, ptr %wsa)
  %a = call i32 @_setmode(i32 0, i32 32768)
  %b = call i32 @_setmode(i32 1, i32 32768)
  %c = call i32 @_setmode(i32 2, i32 32768)
  ret void
}

; The arguments again, from the C runtime's wide parse of the command line (the same splitting as
; its ANSI one), each converted to UTF-8: an argument that is not valid UTF-16 is skipped rather
; than mangled. `argv[0]`, the program's own name, is never visible and is kept as it is. When the
; wide parse is refused, the ANSI arguments stand.
define hidden void @nz_os_args(i32 %argc, ptr %argv, ptr %countp, ptr %vectorp) {
entry:
  %wc = alloca i32, align 4
  %wv = alloca ptr, align 8
  %we = alloca ptr, align 8
  %si = alloca i32, align 4
  store i32 0, ptr %si
  store ptr null, ptr %wv
  %r = call i32 @__wgetmainargs(ptr %wc, ptr %wv, ptr %we, i32 0, ptr %si)
  %wargs = load ptr, ptr %wv
  %none = icmp eq ptr %wargs, null
  br i1 %none, label %ansi, label %count
count:
  %n32 = load i32, ptr %wc
  %n = sext i32 %n32 to i64
  %slots = add i64 %n, 1
  %bytes = mul i64 %slots, 8
  %arr = call ptr @malloc(i64 %bytes)
  %noarr = icmp eq ptr %arr, null
  br i1 %noarr, label %ansi, label %fill
ansi:
  %a64 = sext i32 %argc to i64
  %an = sub i64 %a64, 1
  store i64 %an, ptr %countp
  store ptr %argv, ptr %vectorp
  ret void
fill:
  %name = load ptr, ptr %argv
  store ptr %name, ptr %arr
  br label %each
each:
  %i = phi i64 [ 1, %fill ], [ %i1, %next ]
  %k = phi i64 [ 0, %fill ], [ %k1, %next ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %one, label %done
one:
  %i1 = add i64 %i, 1
  %wp = getelementptr ptr, ptr %wargs, i64 %i
  %w = load ptr, ptr %wp
  %len = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %w, i32 -1, ptr null, i32 0, ptr null, ptr null)
  %bad = icmp eq i32 %len, 0
  br i1 %bad, label %skip, label %convert
convert:
  %lw = zext i32 %len to i64
  %u = call ptr @malloc(i64 %lw)
  %nou = icmp eq ptr %u, null
  br i1 %nou, label %skip, label %write
write:
  %c = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %w, i32 -1, ptr %u, i32 %len, ptr null, ptr null)
  %at = add i64 %k, 1
  %up = getelementptr ptr, ptr %arr, i64 %at
  store ptr %u, ptr %up
  %kk = add i64 %k, 1
  br label %next
skip:
  br label %next
next:
  %k1 = phi i64 [ %kk, %write ], [ %k, %skip ]
  br label %each
done:
  %endp0 = add i64 %k, 1
  %endp = getelementptr ptr, ptr %arr, i64 %endp0
  store ptr null, ptr %endp
  store i64 %k, ptr %countp
  store ptr %arr, ptr %vectorp
  ret void
}
"#
}

pub fn rt_platform_POSIX_STACK() -> Str ! {} {
    r#"
declare i32 @clock_gettime(i32, ptr)
declare i32 @getpagesize()
declare i32 @posix_memalign(ptr, i64, i64)
declare i32 @mprotect(ptr, i64, i32)
declare i32 @getrlimit(i32, ptr)
declare void @free(ptr)

; Clock 4 is CLOCK_MONOTONIC_RAW, and 0 CLOCK_REALTIME, on Linux and macOS; their `timespec` is
; two 64-bit words.
define hidden i32 @nz_os_clock(i32 %which, ptr %ts) {
entry:
  %r = call i32 @clock_gettime(i32 %which, ptr %ts)
  ret i32 %r
}

define hidden i64 @nz_os_page_size() {
entry:
  %p = call i32 @getpagesize()
  %w = sext i32 %p to i64
  ret i64 %w
}

define hidden ptr @nz_os_stack_alloc(i64 %total, i64 %page) {
entry:
  %slot = alloca ptr, align 8
  %rc = call i32 @posix_memalign(ptr %slot, i64 %page, i64 %total)
  %bad = icmp ne i32 %rc, 0
  br i1 %bad, label %none, label %guard
guard:
  %base = load ptr, ptr %slot
  %g = call i32 @mprotect(ptr %base, i64 %page, i32 0)
  %gok = icmp eq i32 %g, 0
  br i1 %gok, label %done, label %unguarded
unguarded:
  call void @free(ptr %base)
  br label %none
none:
  ret ptr null
done:
  ret ptr %base
}

; What a thread's own bounds cannot say is `RLIMIT_STACK`'s: the main thread's stack. RLIMIT_STACK
; is 3 on every POSIX target here, and struct rlimit is two 64-bit words.
define internal i64 @nz_os_stack_rlimit() {
entry:
  %rl = alloca [2 x i64], align 8
  %rc = call i32 @getrlimit(i32 3, ptr %rl)
  %cur = load i64, ptr %rl
  %ok = icmp eq i32 %rc, 0
  %size = select i1 %ok, i64 %cur, i64 0
  ret i64 %size
}

declare ptr @llvm.frameaddress.p0(i32)
declare ptr @pthread_self()
"#
}

pub fn rt_platform_DARWIN_STACK_SIZE() -> Str ! {} {
    r#"
declare ptr @pthread_get_stackaddr_np(ptr)
declare i64 @pthread_get_stacksize_np(ptr)

define hidden i64 @nz_os_stack_size() {
entry:
  %fp = call ptr @llvm.frameaddress.p0(i32 0)
  %sp = ptrtoint ptr %fp to i64
  %self = call ptr @pthread_self()
  %top = call ptr @pthread_get_stackaddr_np(ptr %self)
  %size = call i64 @pthread_get_stacksize_np(ptr %self)
  %hi = ptrtoint ptr %top to i64
  %lo = sub i64 %hi, %size
  %above = icmp ugt i64 %sp, %lo
  %below = icmp ule i64 %sp, %hi
  %known = icmp ne i64 %size, 0
  %in = and i1 %above, %below
  %ok = and i1 %in, %known
  br i1 %ok, label %room, label %limit
room:
  %left = sub i64 %sp, %lo
  ret i64 %left
limit:
  %r = call i64 @nz_os_stack_rlimit()
  ret i64 %r
}
"#
}

pub fn rt_platform_LINUX_STACK_SIZE() -> Str ! {} {
    r#"
declare i32 @pthread_getattr_np(ptr, ptr)
declare i32 @pthread_attr_getstack(ptr, ptr, ptr)
declare i32 @pthread_attr_destroy(ptr)

define hidden i64 @nz_os_stack_size() {
entry:
  %attr = alloca [128 x i8], align 16
  %addr = alloca ptr, align 8
  %size = alloca i64, align 8
  %fp = call ptr @llvm.frameaddress.p0(i32 0)
  %sp = ptrtoint ptr %fp to i64
  %self = call ptr @pthread_self()
  %rc = call i32 @pthread_getattr_np(ptr %self, ptr %attr)
  %got = icmp eq i32 %rc, 0
  br i1 %got, label %ask, label %limit
ask:
  %rs = call i32 @pthread_attr_getstack(ptr %attr, ptr %addr, ptr %size)
  %d = call i32 @pthread_attr_destroy(ptr %attr)
  %said = icmp eq i32 %rs, 0
  br i1 %said, label %measure, label %limit
measure:
  %lop = load ptr, ptr %addr
  %lo = ptrtoint ptr %lop to i64
  %n = load i64, ptr %size
  %hi = add i64 %lo, %n
  %above = icmp ugt i64 %sp, %lo
  %below = icmp ule i64 %sp, %hi
  %in = and i1 %above, %below
  br i1 %in, label %room, label %limit
room:
  %left = sub i64 %sp, %lo
  ret i64 %left
limit:
  %r = call i64 @nz_os_stack_rlimit()
  ret i64 %r
}
"#
}

pub fn rt_platform_WINDOWS_STACK() -> Str ! {} {
    r#"
declare void @GetSystemInfo(ptr)
declare ptr @VirtualAlloc(ptr, i64, i32, i32)
declare i32 @VirtualProtect(ptr, i64, i32, ptr)
declare i32 @VirtualFree(ptr, i64, i32)
declare void @GetCurrentThreadStackLimits(ptr, ptr)
declare void @GetSystemTimePreciseAsFileTime(ptr)
declare i32 @QueryPerformanceCounter(ptr)
declare i32 @QueryPerformanceFrequency(ptr)

; 0 the wall clock (`GetSystemTimePreciseAsFileTime`, 100 ns since 1601), anything else the
; monotonic one (`QueryPerformanceCounter`), as two 64-bit words, seconds and nanoseconds.
define hidden i32 @nz_os_clock(i32 %which, ptr %ts) {
entry:
  %v = alloca i64, align 8
  %f = alloca i64, align 8
  %np = getelementptr i8, ptr %ts, i64 8
  %wall = icmp eq i32 %which, 0
  br i1 %wall, label %system, label %counter
system:
  call void @GetSystemTimePreciseAsFileTime(ptr %v)
  %ft = load i64, ptr %v
  %since = sub i64 %ft, 116444736000000000
  %ns = mul i64 %since, 100
  %s = sdiv i64 %ns, 1000000000
  %n = srem i64 %ns, 1000000000
  store i64 %s, ptr %ts
  store i64 %n, ptr %np
  ret i32 0
counter:
  %c0 = call i32 @QueryPerformanceCounter(ptr %v)
  %q0 = call i32 @QueryPerformanceFrequency(ptr %f)
  %c = load i64, ptr %v
  %hz = load i64, ptr %f
  %cs = udiv i64 %c, %hz
  %rest = urem i64 %c, %hz
  %scaled = mul i64 %rest, 1000000000
  %cn = udiv i64 %scaled, %hz
  store i64 %cs, ptr %ts
  store i64 %cn, ptr %np
  ret i32 0
}

define hidden i64 @nz_os_page_size() {
entry:
  ; SYSTEM_INFO is 48 bytes; dwPageSize is the 32-bit word at offset 4.
  %si = alloca [48 x i8], align 8
  call void @GetSystemInfo(ptr %si)
  %pp = getelementptr i8, ptr %si, i64 4
  %p = load i32, ptr %pp
  %w = zext i32 %p to i64
  ret i64 %w
}

; The processors the system has, for the pool's default worker count; dwNumberOfProcessors is the
; 32-bit word at offset 32 of SYSTEM_INFO.
define hidden i64 @nz.os_cpus() {
entry:
  %si = alloca [48 x i8], align 8
  call void @GetSystemInfo(ptr %si)
  %np = getelementptr i8, ptr %si, i64 32
  %n = load i32, ptr %np
  %w = zext i32 %n to i64
  ret i64 %w
}

define hidden ptr @nz_os_stack_alloc(i64 %total, i64 %page) {
entry:
  %old = alloca i32, align 4
  ; MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE.
  %base = call ptr @VirtualAlloc(ptr null, i64 %total, i32 12288, i32 4)
  %none = icmp eq ptr %base, null
  br i1 %none, label %fail, label %guard
guard:
  ; PAGE_NOACCESS.
  %g = call i32 @VirtualProtect(ptr %base, i64 %page, i32 1, ptr %old)
  %gok = icmp ne i32 %g, 0
  br i1 %gok, label %done, label %unguarded
unguarded:
  ; MEM_RELEASE, with a size of 0 as it requires.
  %r = call i32 @VirtualFree(ptr %base, i64 0, i32 32768)
  br label %fail
fail:
  ret ptr null
done:
  ret ptr %base
}

; The calling thread's reservation, so what is left of it below this frame (Q1-A1-04).
define hidden i64 @nz_os_stack_size() {
entry:
  %lo = alloca i64, align 8
  %hi = alloca i64, align 8
  call void @GetCurrentThreadStackLimits(ptr %lo, ptr %hi)
  %l = load i64, ptr %lo
  %h = load i64, ptr %hi
  %fp = call ptr @llvm.frameaddress.p0(i32 0)
  %sp = ptrtoint ptr %fp to i64
  %above = icmp ugt i64 %sp, %l
  %below = icmp ule i64 %sp, %h
  %in = and i1 %above, %below
  %left = sub i64 %sp, %l
  %size = select i1 %in, i64 %left, i64 0
  ret i64 %size
}

declare ptr @llvm.frameaddress.p0(i32)
"#
}

pub fn rt_heap_HEAP_RUNTIME() -> Str ! {} {
    r#"
declare ptr @malloc(i64)
declare ptr @realloc(ptr, i64)
declare void @free(ptr)
declare i64 @write(i32, ptr, i64)
declare void @exit(i32) noreturn

; Reserve `n` more live bytes, or end the process: the first thread past the limit writes the
; message and exits with status 2; any other waits for that exit.
define hidden void @nz.heap_reserve(i64 %n) {
entry:
  %limit = load i64, ptr @nz.heap_limit
  %huge = icmp ugt i64 %n, %limit
  br i1 %huge, label %over, label %add
add:
  %old = atomicrmw add ptr @nz.heap_live, i64 %n seq_cst
  %new = add i64 %old, %n
  %past = icmp ugt i64 %new, %limit
  br i1 %past, label %over, label %ok
ok:
  ret void
over:
  %first = atomicrmw xchg ptr @nz.heap_over, i32 1 seq_cst
  %alone = icmp eq i32 %first, 0
  br i1 %alone, label %report, label %wait
report:
  %w = call i64 @write(i32 2, ptr @.nz.heap_message, i64 {LEN})
  call void @exit(i32 2)
  unreachable
wait:
  br label %wait
}

; `n` bytes the caller owns behind a 16-byte header holding `n`, counted; null when the C library
; refuses, with nothing counted.
define hidden ptr @nz.heap_malloc(i64 %n) {
entry:
  call void @nz.heap_reserve(i64 %n)
  %total = add i64 %n, 16
  %h = call ptr @malloc(i64 %total)
  %none = icmp eq ptr %h, null
  br i1 %none, label %refused, label %got
refused:
  %undo = atomicrmw sub ptr @nz.heap_live, i64 %n seq_cst
  ret ptr null
got:
  store i64 %n, ptr %h
  %p = getelementptr i8, ptr %h, i64 16
  ret ptr %p
}

; Gives a counted block back; null is a no-op.
define hidden void @nz.heap_free(ptr %p) {
entry:
  %none = icmp eq ptr %p, null
  br i1 %none, label %done, label %give
give:
  %h = getelementptr i8, ptr %p, i64 -16
  %n = load i64, ptr %h
  %undo = atomicrmw sub ptr @nz.heap_live, i64 %n seq_cst
  call void @free(ptr %h)
  br label %done
done:
  ret void
}

; A counted block of `n` bytes holding what `p` held, as C's `realloc`: growth is reserved first,
; and a refusal leaves `p` as it was, counted as it was.
define hidden ptr @nz.heap_realloc(ptr %p, i64 %n) {
entry:
  %fresh = icmp eq ptr %p, null
  br i1 %fresh, label %new, label %resize
new:
  %m = call ptr @nz.heap_malloc(i64 %n)
  ret ptr %m
resize:
  %h = getelementptr i8, ptr %p, i64 -16
  %old = load i64, ptr %h
  %grows = icmp ugt i64 %n, %old
  %more = sub i64 %n, %old
  br i1 %grows, label %reserve, label %move
reserve:
  call void @nz.heap_reserve(i64 %more)
  br label %move
move:
  %total = add i64 %n, 16
  %q = call ptr @realloc(ptr %h, i64 %total)
  %none = icmp eq ptr %q, null
  br i1 %none, label %refused, label %got
refused:
  %back = select i1 %grows, i64 %more, i64 0
  %undo = atomicrmw sub ptr @nz.heap_live, i64 %back seq_cst
  ret ptr null
got:
  store i64 %n, ptr %q
  %less = sub i64 %old, %n
  %freed = select i1 %grows, i64 0, i64 %less
  %give = atomicrmw sub ptr @nz.heap_live, i64 %freed seq_cst
  %r = getelementptr i8, ptr %q, i64 16
  ret ptr %r
}
"#
}

pub fn rt_heap_SMALL_RUNTIME() -> Str ! {} {
    r#"
@nz.small_lists = internal {TLS}global [66 x ptr] zeroinitializer

declare ptr @malloc(i64)
declare ptr @realloc(ptr, i64)
declare void @free(ptr)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)

; `n` bytes the caller owns behind a 16-byte header holding the block's class, or null when C
; refuses: a block of up to 512 bytes from this thread's list of its class when the list has one,
; else from C.
define hidden ptr @nz.small_malloc(i64 %n) {
entry:
  %big = icmp ugt i64 %n, 512
  br i1 %big, label %large, label %small
small:
  %n15 = add i64 %n, 15
  %c0 = lshr i64 %n15, 4
  %zero = icmp eq i64 %c0, 0
  %c = select i1 %zero, i64 1, i64 %c0
  %slot = getelementptr [66 x ptr], ptr @nz.small_lists, i64 0, i64 %c
  %head = load ptr, ptr %slot
  %empty = icmp eq ptr %head, null
  br i1 %empty, label %fresh, label %pop
pop:
  %next = load ptr, ptr %head
  store ptr %next, ptr %slot
  %ci = add i64 %c, 33
  %cnt = getelementptr [66 x i64], ptr @nz.small_lists, i64 0, i64 %ci
  %k = load i64, ptr %cnt
  %k1 = sub i64 %k, 1
  store i64 %k1, ptr %cnt
  ret ptr %head
fresh:
  %bytes = shl i64 %c, 4
  %total = add i64 %bytes, 16
  %h = call ptr @malloc(i64 %total)
  %none = icmp eq ptr %h, null
  br i1 %none, label %refused, label %mark
mark:
  store i64 %c, ptr %h
  %p = getelementptr i8, ptr %h, i64 16
  ret ptr %p
large:
  %huge = icmp ugt i64 %n, -17
  br i1 %huge, label %refused, label %alloc
alloc:
  %ltotal = add i64 %n, 16
  %lh = call ptr @malloc(i64 %ltotal)
  %lnone = icmp eq ptr %lh, null
  br i1 %lnone, label %refused, label %lmark
lmark:
  store i64 0, ptr %lh
  %lp = getelementptr i8, ptr %lh, i64 16
  ret ptr %lp
refused:
  ret ptr null
}

; Gives a block back: a small one to this thread's list of its class while that holds fewer than
; {KEPT}, any other to C; null is a no-op.
define hidden void @nz.small_free(ptr %p) {
entry:
  %none = icmp eq ptr %p, null
  br i1 %none, label %done, label %give
give:
  %h = getelementptr i8, ptr %p, i64 -16
  %c = load i64, ptr %h
  %large = icmp eq i64 %c, 0
  br i1 %large, label %back, label %keep
keep:
  %ci = add i64 %c, 33
  %cnt = getelementptr [66 x i64], ptr @nz.small_lists, i64 0, i64 %ci
  %k = load i64, ptr %cnt
  %full = icmp uge i64 %k, {KEPT}
  br i1 %full, label %back, label %push
push:
  %slot = getelementptr [66 x ptr], ptr @nz.small_lists, i64 0, i64 %c
  %head = load ptr, ptr %slot
  store ptr %head, ptr %p
  store ptr %p, ptr %slot
  %k1 = add i64 %k, 1
  store i64 %k1, ptr %cnt
  br label %done
back:
  call void @free(ptr %h)
  br label %done
done:
  ret void
}

; A block of `n` bytes holding what `p` held, as C's `realloc`: a small block that already holds
; `n` is kept, a smaller one moved, a large one resized by C; a refusal leaves `p` as it was.
define hidden ptr @nz.small_realloc(ptr %p, i64 %n) {
entry:
  %fresh = icmp eq ptr %p, null
  br i1 %fresh, label %new, label %resize
new:
  %m = call ptr @nz.small_malloc(i64 %n)
  ret ptr %m
resize:
  %h = getelementptr i8, ptr %p, i64 -16
  %c = load i64, ptr %h
  %large = icmp eq i64 %c, 0
  br i1 %large, label %grow, label %small
grow:
  %huge = icmp ugt i64 %n, -17
  br i1 %huge, label %refused, label %re
re:
  %total = add i64 %n, 16
  %q = call ptr @realloc(ptr %h, i64 %total)
  %qnone = icmp eq ptr %q, null
  br i1 %qnone, label %refused, label %qok
qok:
  %qp = getelementptr i8, ptr %q, i64 16
  ret ptr %qp
small:
  %cap = shl i64 %c, 4
  %fits = icmp ule i64 %n, %cap
  br i1 %fits, label %same, label %move
same:
  ret ptr %p
move:
  %r = call ptr @nz.small_malloc(i64 %n)
  %rnone = icmp eq ptr %r, null
  br i1 %rnone, label %refused, label %copy
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %r, ptr %p, i64 %cap, i1 false)
  call void @nz.small_free(ptr %p)
  ret ptr %r
refused:
  ret ptr null
}
"#
}

pub fn rt_board_HEAP_RUNTIME() -> Str ! {} {
    r#"
@__heap_start = external global i8
@__heap_end = external global i8
@nz.heap_next = internal global i64 0

define ptr @malloc(i64 %n) {
entry:
  %padded = add i64 %n, 31
  %need = and i64 %padded, -16
  %start = ptrtoint ptr @__heap_start to i64
  %end = ptrtoint ptr @__heap_end to i64
  %huge = icmp ugt i64 %n, %end
  br i1 %huge, label %none, label %retry
retry:
  %seen = load atomic i64, ptr @nz.heap_next seq_cst, align 8
  %fresh = icmp eq i64 %seen, 0
  %cur = select i1 %fresh, i64 %start, i64 %seen
  %next = add i64 %cur, %need
  %over = icmp ugt i64 %next, %end
  br i1 %over, label %none, label %claim
claim:
  %r = cmpxchg ptr @nz.heap_next, i64 %seen, i64 %next seq_cst seq_cst
  %ok = extractvalue { i64, i1 } %r, 1
  br i1 %ok, label %got, label %retry
got:
  %h = inttoptr i64 %cur to ptr
  store i64 %n, ptr %h
  %p = getelementptr i8, ptr %h, i64 16
  ret ptr %p
none:
  ret ptr null
}

define void @free(ptr %p) {
entry:
  ret void
}

define ptr @realloc(ptr %p, i64 %n) {
entry:
  %q = call ptr @malloc(i64 %n)
  %absent = icmp eq ptr %p, null
  %failed = icmp eq ptr %q, null
  %skip = or i1 %absent, %failed
  br i1 %skip, label %done, label %copy
copy:
  %h = getelementptr i8, ptr %p, i64 -16
  %old = load i64, ptr %h
  %less = icmp ult i64 %old, %n
  %m = select i1 %less, i64 %old, i64 %n
  %c = call ptr @memcpy(ptr %q, ptr %p, i64 %m)
  br label %done
done:
  ret ptr %q
}
"#
}

pub fn rt_board_MEMORY_RUNTIME() -> Str ! {} {
    r#"
define ptr @memcpy(ptr %d, ptr %s, i64 %n) "no-builtins" {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i64 %i, %n
  br i1 %more, label %body, label %done
body:
  %sp = getelementptr i8, ptr %s, i64 %i
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i64 %i
  store i8 %b, ptr %dp
  %j = add i64 %i, 1
  br label %loop
done:
  ret ptr %d
}

define ptr @memmove(ptr %d, ptr %s, i64 %n) "no-builtins" {
entry:
  %di = ptrtoint ptr %d to i64
  %si = ptrtoint ptr %s to i64
  %forward = icmp ule i64 %di, %si
  br i1 %forward, label %fwd, label %back
fwd:
  %c = call ptr @memcpy(ptr %d, ptr %s, i64 %n)
  ret ptr %d
back:
  br label %loop
loop:
  %i = phi i64 [ %n, %back ], [ %k, %body ]
  %more = icmp ugt i64 %i, 0
  br i1 %more, label %body, label %done
body:
  %k = sub i64 %i, 1
  %sp = getelementptr i8, ptr %s, i64 %k
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i64 %k
  store i8 %b, ptr %dp
  br label %loop
done:
  ret ptr %d
}

define ptr @memset(ptr %d, i32 %v, i64 %n) "no-builtins" {
entry:
  %b = trunc i32 %v to i8
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i64 %i, %n
  br i1 %more, label %body, label %done
body:
  %dp = getelementptr i8, ptr %d, i64 %i
  store i8 %b, ptr %dp
  %j = add i64 %i, 1
  br label %loop
done:
  ret ptr %d
}

define i32 @memcmp(ptr %a, ptr %b, i64 %n) "no-builtins" {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %j, %same ]
  %more = icmp ult i64 %i, %n
  br i1 %more, label %body, label %equal
body:
  %ap = getelementptr i8, ptr %a, i64 %i
  %x = load i8, ptr %ap
  %bp = getelementptr i8, ptr %b, i64 %i
  %y = load i8, ptr %bp
  %eq = icmp eq i8 %x, %y
  br i1 %eq, label %same, label %differ
same:
  %j = add i64 %i, 1
  br label %loop
differ:
  %xw = zext i8 %x to i32
  %yw = zext i8 %y to i32
  %d = sub i32 %xw, %yw
  ret i32 %d
equal:
  ret i32 0
}

define i32 @bcmp(ptr %a, ptr %b, i64 %n) "no-builtins" {
entry:
  %r = call i32 @memcmp(ptr %a, ptr %b, i64 %n)
  ret i32 %r
}
"#
}

pub fn rt_board_MMIO_RUNTIME() -> Str ! {} {
    r#"
define hidden i64 @nz.mmio_read8(i64 %addr) {
entry:
  %p = inttoptr i64 %addr to ptr
  %v = load volatile i8, ptr %p
  %r = zext i8 %v to i64
  ret i64 %r
}

define hidden i64 @nz.mmio_write8(i64 %addr, i64 %value) {
entry:
  %p = inttoptr i64 %addr to ptr
  %t = trunc i64 %value to i8
  store volatile i8 %t, ptr %p
  ret i64 0
}

define hidden i64 @nz.mmio_read16(i64 %addr) {
entry:
  %p = inttoptr i64 %addr to ptr
  %v = load volatile i16, ptr %p
  %r = zext i16 %v to i64
  ret i64 %r
}

define hidden i64 @nz.mmio_write16(i64 %addr, i64 %value) {
entry:
  %p = inttoptr i64 %addr to ptr
  %t = trunc i64 %value to i16
  store volatile i16 %t, ptr %p
  ret i64 0
}

define hidden i64 @nz.mmio_read32(i64 %addr) {
entry:
  %p = inttoptr i64 %addr to ptr
  %v = load volatile i32, ptr %p
  %r = zext i32 %v to i64
  ret i64 %r
}

define hidden i64 @nz.mmio_write32(i64 %addr, i64 %value) {
entry:
  %p = inttoptr i64 %addr to ptr
  %t = trunc i64 %value to i32
  store volatile i32 %t, ptr %p
  ret i64 0
}

define hidden i64 @nz.mmio_read64(i64 %addr) {
entry:
  %p = inttoptr i64 %addr to ptr
  %v = load volatile i64, ptr %p
  ret i64 %v
}

define hidden i64 @nz.mmio_write64(i64 %addr, i64 %value) {
entry:
  %p = inttoptr i64 %addr to ptr
  store volatile i64 %value, ptr %p
  ret i64 0
}

@nz.wd_reload = hidden global i64 0
@nz.wd_left = hidden global i64 0

define hidden i64 @nz.watchdog_feed() {
entry:
  %n = load atomic i64, ptr @nz.wd_reload seq_cst, align 8
  store atomic i64 %n, ptr @nz.wd_left seq_cst, align 8
  ret i64 0
}
"#
}

pub fn rt_board_THUMB_RUNTIME() -> Str ! {} {
    r#"
define internal i32 @nz.mask() {
entry:
  %m = call i32 asm sideeffect "mrs $0, primask\0Acpsid i", "=r,~{memory}"()
  ret i32 %m
}

define internal void @nz.unmask(i32 %m) {
entry:
  call void asm sideeffect "msr primask, $0", "r,~{memory}"(i32 %m)
  ret void
}

define i64 @__atomic_load_8(ptr %p, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %v = load volatile i64, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %v
}

define void @__atomic_store_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  store volatile i64 %v, ptr %p
  call void @nz.unmask(i32 %m)
  ret void
}

define i64 @__atomic_exchange_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  store volatile i64 %v, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

define zeroext i1 @__atomic_compare_exchange_8(ptr %p, ptr %e, i64 %d, i32 %s, i32 %f) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %want = load i64, ptr %e
  %same = icmp eq i64 %old, %want
  br i1 %same, label %swap, label %differ
swap:
  store volatile i64 %d, ptr %p
  br label %done
differ:
  store i64 %old, ptr %e
  br label %done
done:
  call void @nz.unmask(i32 %m)
  ret i1 %same
}

define i64 @__atomic_fetch_add_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %new = add i64 %old, %v
  store volatile i64 %new, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

define i64 @__atomic_fetch_sub_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %new = sub i64 %old, %v
  store volatile i64 %new, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

; The EABI's memory functions (sizes are 32 bits here), which LLVM calls to copy and clear what
; a value occupies: byte loops LLVM may not turn back into calls to themselves. `memset`'s value
; comes after its length, as the EABI orders them.
define void @__aeabi_memcpy(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %sp = getelementptr i8, ptr %s, i32 %i
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i32 %i
  store i8 %b, ptr %dp
  %j = add i32 %i, 1
  br label %loop
done:
  ret void
}

define void @__aeabi_memcpy4(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memcpy(ptr %d, ptr %s, i32 %n)
  ret void
}

define void @__aeabi_memcpy8(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memcpy(ptr %d, ptr %s, i32 %n)
  ret void
}

define void @__aeabi_memmove(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  %di = ptrtoint ptr %d to i32
  %si = ptrtoint ptr %s to i32
  %forward = icmp ule i32 %di, %si
  br i1 %forward, label %fwd, label %loop
fwd:
  call void @__aeabi_memcpy(ptr %d, ptr %s, i32 %n)
  ret void
loop:
  %i = phi i32 [ %n, %entry ], [ %k, %body ]
  %more = icmp ugt i32 %i, 0
  br i1 %more, label %body, label %done
body:
  %k = sub i32 %i, 1
  %sp = getelementptr i8, ptr %s, i32 %k
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i32 %k
  store i8 %b, ptr %dp
  br label %loop
done:
  ret void
}

define void @__aeabi_memmove4(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memmove(ptr %d, ptr %s, i32 %n)
  ret void
}

define void @__aeabi_memmove8(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memmove(ptr %d, ptr %s, i32 %n)
  ret void
}

define void @__aeabi_memset(ptr %d, i32 %n, i32 %c) "no-builtins" {
entry:
  %b = trunc i32 %c to i8
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %dp = getelementptr i8, ptr %d, i32 %i
  store i8 %b, ptr %dp
  %j = add i32 %i, 1
  br label %loop
done:
  ret void
}

define void @__aeabi_memset4(ptr %d, i32 %n, i32 %c) "no-builtins" {
entry:
  call void @__aeabi_memset(ptr %d, i32 %n, i32 %c)
  ret void
}

define void @__aeabi_memset8(ptr %d, i32 %n, i32 %c) "no-builtins" {
entry:
  call void @__aeabi_memset(ptr %d, i32 %n, i32 %c)
  ret void
}

define void @__aeabi_memclr(ptr %d, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memset(ptr %d, i32 %n, i32 0)
  ret void
}

define void @__aeabi_memclr4(ptr %d, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memset(ptr %d, i32 %n, i32 0)
  ret void
}

define void @__aeabi_memclr8(ptr %d, i32 %n) "no-builtins" {
entry:
  call void @__aeabi_memset(ptr %d, i32 %n, i32 0)
  ret void
}

define { i64, i64 } @__aeabi_uldivmod(i64 %n, i64 %d) {
entry:
  br label %loop
loop:
  %i = phi i32 [ 64, %entry ], [ %i1, %next ]
  %q = phi i64 [ 0, %entry ], [ %q2, %next ]
  %r = phi i64 [ 0, %entry ], [ %r2, %next ]
  %more = icmp ugt i32 %i, 0
  br i1 %more, label %step, label %done
step:
  %i1 = sub i32 %i, 1
  %sh = zext i32 %i1 to i64
  %bit = lshr i64 %n, %sh
  %b1 = and i64 %bit, 1
  %rs = shl i64 %r, 1
  %r1 = or i64 %rs, %b1
  %qs = shl i64 %q, 1
  %fits = icmp uge i64 %r1, %d
  br i1 %fits, label %take, label %keep
take:
  %rt = sub i64 %r1, %d
  %qt = or i64 %qs, 1
  br label %next
keep:
  br label %next
next:
  %r2 = phi i64 [ %rt, %take ], [ %r1, %keep ]
  %q2 = phi i64 [ %qt, %take ], [ %qs, %keep ]
  br label %loop
done:
  %a = insertvalue { i64, i64 } undef, i64 %q, 0
  %b = insertvalue { i64, i64 } %a, i64 %r, 1
  ret { i64, i64 } %b
}

define { i64, i64 } @__aeabi_ldivmod(i64 %n, i64 %d) {
entry:
  %nneg = icmp slt i64 %n, 0
  %dneg = icmp slt i64 %d, 0
  %nm = sub i64 0, %n
  %dm = sub i64 0, %d
  %na = select i1 %nneg, i64 %nm, i64 %n
  %da = select i1 %dneg, i64 %dm, i64 %d
  %u = call { i64, i64 } @__aeabi_uldivmod(i64 %na, i64 %da)
  %uq = extractvalue { i64, i64 } %u, 0
  %ur = extractvalue { i64, i64 } %u, 1
  %flip = xor i1 %nneg, %dneg
  %qn = sub i64 0, %uq
  %q = select i1 %flip, i64 %qn, i64 %uq
  %rn = sub i64 0, %ur
  %r = select i1 %nneg, i64 %rn, i64 %ur
  %a = insertvalue { i64, i64 } undef, i64 %q, 0
  %b = insertvalue { i64, i64 } %a, i64 %r, 1
  ret { i64, i64 } %b
}
"#
}

pub fn rt_board_THUMBV8M_FLOAT_RUNTIME() -> Str ! {} {
    r#"
declare i64 @llvm.ctlz.i64(i64, i1)

define arm_aapcscc float @__aeabi_ul2f(i64 %x) "no-builtins" {
entry:
  %zero = icmp eq i64 %x, 0
  br i1 %zero, label %none, label %some
none:
  ret float 0.0
some:
  %lz = call i64 @llvm.ctlz.i64(i64 %x, i1 true)
  %n = shl i64 %x, %lz
  %top = lshr i64 %n, 40
  %rest = shl i64 %n, 24
  %above = icmp ugt i64 %rest, -9223372036854775808
  %tie = icmp eq i64 %rest, -9223372036854775808
  %low = and i64 %top, 1
  %odd = icmp ne i64 %low, 0
  %even = and i1 %tie, %odd
  %up = or i1 %above, %even
  %inc = zext i1 %up to i64
  %m = add i64 %top, %inc
  %e = sub i64 189, %lz
  %eb = shl i64 %e, 23
  %bits = add i64 %eb, %m
  %b32 = trunc i64 %bits to i32
  %f = bitcast i32 %b32 to float
  ret float %f
}

define arm_aapcscc float @__aeabi_l2f(i64 %x) "no-builtins" {
entry:
  %neg = icmp slt i64 %x, 0
  %flip = sub i64 0, %x
  %mag = select i1 %neg, i64 %flip, i64 %x
  %f = call arm_aapcscc float @__aeabi_ul2f(i64 %mag)
  %b = bitcast float %f to i32
  %sign = select i1 %neg, i32 -2147483648, i32 0
  %o = or i32 %b, %sign
  %r = bitcast i32 %o to float
  ret float %r
}

; The magnitude of a float that is at least 1 and below 2^64, truncated: its biased exponent and
; its bits.
define internal i64 @nz.f2u64(i32 %ex, i32 %b) {
entry:
  %frac = and i32 %b, 8388607
  %m32 = or i32 %frac, 8388608
  %m = zext i32 %m32 to i64
  %up = icmp uge i32 %ex, 150
  br i1 %up, label %left, label %right
left:
  %l = sub i32 %ex, 150
  %l64 = zext i32 %l to i64
  %v = shl i64 %m, %l64
  ret i64 %v
right:
  %r = sub i32 150, %ex
  %r64 = zext i32 %r to i64
  %w = lshr i64 %m, %r64
  ret i64 %w
}

define arm_aapcscc i64 @__aeabi_f2ulz(float %f) "no-builtins" {
entry:
  %b = bitcast float %f to i32
  %sh = lshr i32 %b, 23
  %ex = and i32 %sh, 255
  %frac = and i32 %b, 8388607
  %special = icmp eq i32 %ex, 255
  %some = icmp ne i32 %frac, 0
  %nan = and i1 %special, %some
  %neg = icmp slt i32 %b, 0
  %small = icmp ult i32 %ex, 127
  %n0 = or i1 %nan, %neg
  %nothing = or i1 %n0, %small
  br i1 %nothing, label %zero, label %sized
zero:
  ret i64 0
sized:
  %huge = icmp uge i32 %ex, 191
  br i1 %huge, label %max, label %fits
max:
  ret i64 -1
fits:
  %v = call i64 @nz.f2u64(i32 %ex, i32 %b)
  ret i64 %v
}

define arm_aapcscc i64 @__aeabi_f2lz(float %f) "no-builtins" {
entry:
  %b = bitcast float %f to i32
  %sh = lshr i32 %b, 23
  %ex = and i32 %sh, 255
  %frac = and i32 %b, 8388607
  %special = icmp eq i32 %ex, 255
  %some = icmp ne i32 %frac, 0
  %nan = and i1 %special, %some
  %small = icmp ult i32 %ex, 127
  %nothing = or i1 %nan, %small
  %neg = icmp slt i32 %b, 0
  br i1 %nothing, label %zero, label %sized
zero:
  ret i64 0
sized:
  %huge = icmp uge i32 %ex, 190
  br i1 %huge, label %bound, label %fits
bound:
  %edge = select i1 %neg, i64 -9223372036854775808, i64 9223372036854775807
  ret i64 %edge
fits:
  %v = call i64 @nz.f2u64(i32 %ex, i32 %b)
  %nv = sub i64 0, %v
  %r = select i1 %neg, i64 %nv, i64 %v
  ret i64 %r
}

declare i32 @llvm.ctlz.i32(i32, i1)

define arm_aapcscc double @__aeabi_f2d(float %f) "no-builtins" {
entry:
  %b = bitcast float %f to i32
  %s32 = and i32 %b, -2147483648
  %s64 = zext i32 %s32 to i64
  %sign = shl i64 %s64, 32
  %sh = lshr i32 %b, 23
  %ex = and i32 %sh, 255
  %frac = and i32 %b, 8388607
  %f64 = zext i32 %frac to i64
  %special = icmp eq i32 %ex, 255
  br i1 %special, label %inf, label %finite
inf:
  %im = shl i64 %f64, 29
  %ib = or i64 %im, 9218868437227405312
  %ir = or i64 %ib, %sign
  %id = bitcast i64 %ir to double
  ret double %id
finite:
  %sub = icmp eq i32 %ex, 0
  br i1 %sub, label %small, label %normal
normal:
  %e32 = add i32 %ex, 896
  %e64 = zext i32 %e32 to i64
  %eb = shl i64 %e64, 52
  %nm = shl i64 %f64, 29
  %nb = or i64 %eb, %nm
  %nr = or i64 %nb, %sign
  %nd = bitcast i64 %nr to double
  ret double %nd
small:
  %zero = icmp eq i32 %frac, 0
  br i1 %zero, label %signed_zero, label %subnormal
signed_zero:
  %zd = bitcast i64 %sign to double
  ret double %zd
subnormal:
  ; The value is frac * 2^-149: its top bit, at p, is 2^(p - 149), a double's exponent p + 874.
  %lz = call i32 @llvm.ctlz.i32(i32 %frac, i1 true)
  %p = sub i32 31, %lz
  %se = add i32 %p, 874
  %se64 = zext i32 %se to i64
  %seb = shl i64 %se64, 52
  %up = sub i32 52, %p
  %up64 = zext i32 %up to i64
  %sm0 = shl i64 %f64, %up64
  %sm = and i64 %sm0, 4503599627370495
  %sb = or i64 %seb, %sm
  %sr = or i64 %sb, %sign
  %sd = bitcast i64 %sr to double
  ret double %sd
}

; Two doubles' order, IEEE 754's: 2 when either is a NaN, else -1, 0 or 1. Each is mapped to an
; integer that orders as it does — its magnitude, negated when its sign is set — so both zeros are 0.
define internal i32 @nz.dorder(double %a, double %b) "no-builtins" {
entry:
  %x = bitcast double %a to i64
  %y = bitcast double %b to i64
  %xm = and i64 %x, 9223372036854775807
  %ym = and i64 %y, 9223372036854775807
  %xn = icmp ugt i64 %xm, 9218868437227405312
  %yn = icmp ugt i64 %ym, 9218868437227405312
  %nan = or i1 %xn, %yn
  br i1 %nan, label %unordered, label %ordered
unordered:
  ret i32 2
ordered:
  %xs = icmp slt i64 %x, 0
  %ys = icmp slt i64 %y, 0
  %xneg = sub i64 0, %xm
  %yneg = sub i64 0, %ym
  %xk = select i1 %xs, i64 %xneg, i64 %xm
  %yk = select i1 %ys, i64 %yneg, i64 %ym
  %lt = icmp slt i64 %xk, %yk
  %gt = icmp sgt i64 %xk, %yk
  %l = select i1 %lt, i32 -1, i32 0
  %r = select i1 %gt, i32 1, i32 %l
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmpeq(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %t = icmp eq i32 %o, 0
  %r = zext i1 %t to i32
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmplt(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %t = icmp eq i32 %o, -1
  %r = zext i1 %t to i32
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmple(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %t = icmp sle i32 %o, 0
  %r = zext i1 %t to i32
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmpge(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %ge = icmp sge i32 %o, 0
  %num = icmp ne i32 %o, 2
  %t = and i1 %ge, %num
  %r = zext i1 %t to i32
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmpgt(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %t = icmp eq i32 %o, 1
  %r = zext i1 %t to i32
  ret i32 %r
}

define arm_aapcscc i32 @__aeabi_dcmpun(double %a, double %b) "no-builtins" {
entry:
  %o = call i32 @nz.dorder(double %a, double %b)
  %t = icmp eq i32 %o, 2
  %r = zext i1 %t to i32
  ret i32 %r
}
"#
}

pub fn rt_board_RISCV32_RUNTIME() -> Str ! {} {
    r#"
define internal i32 @nz.mask() {
entry:
  %m = call i32 asm sideeffect "csrrci $0, mstatus, 8", "=r,~{memory}"()
  ret i32 %m
}

define internal void @nz.unmask(i32 %m) {
entry:
  %mie = and i32 %m, 8
  call void asm sideeffect "csrs mstatus, $0", "r,~{memory}"(i32 %mie)
  ret void
}

define i64 @__atomic_load_8(ptr %p, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %v = load volatile i64, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %v
}

define void @__atomic_store_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  store volatile i64 %v, ptr %p
  call void @nz.unmask(i32 %m)
  ret void
}

define i64 @__atomic_exchange_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  store volatile i64 %v, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

define zeroext i1 @__atomic_compare_exchange_8(ptr %p, ptr %e, i64 %d, i32 %s, i32 %f) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %want = load i64, ptr %e
  %same = icmp eq i64 %old, %want
  br i1 %same, label %swap, label %differ
swap:
  store volatile i64 %d, ptr %p
  br label %done
differ:
  store i64 %old, ptr %e
  br label %done
done:
  call void @nz.unmask(i32 %m)
  ret i1 %same
}

define i64 @__atomic_fetch_add_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %new = add i64 %old, %v
  store volatile i64 %new, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

define i64 @__atomic_fetch_sub_8(ptr %p, i64 %v, i32 %o) {
entry:
  %m = call i32 @nz.mask()
  %old = load volatile i64, ptr %p
  %new = sub i64 %old, %v
  store volatile i64 %new, ptr %p
  call void @nz.unmask(i32 %m)
  ret i64 %old
}

define ptr @memcpy(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %sp = getelementptr i8, ptr %s, i32 %i
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i32 %i
  store i8 %b, ptr %dp
  %j = add i32 %i, 1
  br label %loop
done:
  ret ptr %d
}

define ptr @memmove(ptr %d, ptr %s, i32 %n) "no-builtins" {
entry:
  %di = ptrtoint ptr %d to i32
  %si = ptrtoint ptr %s to i32
  %forward = icmp ule i32 %di, %si
  br i1 %forward, label %fwd, label %loop
fwd:
  %c = call ptr @memcpy(ptr %d, ptr %s, i32 %n)
  ret ptr %d
loop:
  %i = phi i32 [ %n, %entry ], [ %k, %body ]
  %more = icmp ugt i32 %i, 0
  br i1 %more, label %body, label %done
body:
  %k = sub i32 %i, 1
  %sp = getelementptr i8, ptr %s, i32 %k
  %b = load i8, ptr %sp
  %dp = getelementptr i8, ptr %d, i32 %k
  store i8 %b, ptr %dp
  br label %loop
done:
  ret ptr %d
}

define ptr @memset(ptr %d, i32 %v, i32 %n) "no-builtins" {
entry:
  %b = trunc i32 %v to i8
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %j, %body ]
  %more = icmp ult i32 %i, %n
  br i1 %more, label %body, label %done
body:
  %dp = getelementptr i8, ptr %d, i32 %i
  store i8 %b, ptr %dp
  %j = add i32 %i, 1
  br label %loop
done:
  ret ptr %d
}

define internal { i64, i64 } @nz.udivmod64(i64 %n, i64 %d) {
entry:
  br label %loop
loop:
  %i = phi i32 [ 64, %entry ], [ %i1, %next ]
  %q = phi i64 [ 0, %entry ], [ %q2, %next ]
  %r = phi i64 [ 0, %entry ], [ %r2, %next ]
  %more = icmp ugt i32 %i, 0
  br i1 %more, label %step, label %done
step:
  %i1 = sub i32 %i, 1
  %sh = zext i32 %i1 to i64
  %bit = lshr i64 %n, %sh
  %b1 = and i64 %bit, 1
  %rs = shl i64 %r, 1
  %r1 = or i64 %rs, %b1
  %qs = shl i64 %q, 1
  %fits = icmp uge i64 %r1, %d
  br i1 %fits, label %take, label %keep
take:
  %rt = sub i64 %r1, %d
  %qt = or i64 %qs, 1
  br label %next
keep:
  br label %next
next:
  %r2 = phi i64 [ %rt, %take ], [ %r1, %keep ]
  %q2 = phi i64 [ %qt, %take ], [ %qs, %keep ]
  br label %loop
done:
  %a = insertvalue { i64, i64 } undef, i64 %q, 0
  %b = insertvalue { i64, i64 } %a, i64 %r, 1
  ret { i64, i64 } %b
}

define i64 @__udivdi3(i64 %n, i64 %d) {
entry:
  %u = call { i64, i64 } @nz.udivmod64(i64 %n, i64 %d)
  %q = extractvalue { i64, i64 } %u, 0
  ret i64 %q
}

define i64 @__umoddi3(i64 %n, i64 %d) {
entry:
  %u = call { i64, i64 } @nz.udivmod64(i64 %n, i64 %d)
  %r = extractvalue { i64, i64 } %u, 1
  ret i64 %r
}

define i64 @__divdi3(i64 %n, i64 %d) {
entry:
  %nneg = icmp slt i64 %n, 0
  %dneg = icmp slt i64 %d, 0
  %nm = sub i64 0, %n
  %dm = sub i64 0, %d
  %na = select i1 %nneg, i64 %nm, i64 %n
  %da = select i1 %dneg, i64 %dm, i64 %d
  %u = call { i64, i64 } @nz.udivmod64(i64 %na, i64 %da)
  %uq = extractvalue { i64, i64 } %u, 0
  %flip = xor i1 %nneg, %dneg
  %qn = sub i64 0, %uq
  %q = select i1 %flip, i64 %qn, i64 %uq
  ret i64 %q
}

define i64 @__moddi3(i64 %n, i64 %d) {
entry:
  %nneg = icmp slt i64 %n, 0
  %dneg = icmp slt i64 %d, 0
  %nm = sub i64 0, %n
  %dm = sub i64 0, %d
  %na = select i1 %nneg, i64 %nm, i64 %n
  %da = select i1 %dneg, i64 %dm, i64 %d
  %u = call { i64, i64 } @nz.udivmod64(i64 %na, i64 %da)
  %ur = extractvalue { i64, i64 } %u, 1
  %rn = sub i64 0, %ur
  %r = select i1 %nneg, i64 %rn, i64 %ur
  ret i64 %r
}
"#
}

pub fn rt_board_PREEMPT_NONE() -> Str ! {} {
    r#"
@nz.preempt_req = hidden global i64 0

define hidden void @nz.preempt() {
entry:
  ret void
}
"#
}

pub fn rt_board_ATOMIC_RUNTIME() -> Str ! {} {
    r#"
define hidden i64 @nz.atomic_load(ptr %cell) {
entry:
  %v = load atomic i64, ptr %cell seq_cst, align 8
  ret i64 %v
}

define hidden void @nz.atomic_store(ptr %cell, i64 %v) {
entry:
  store atomic i64 %v, ptr %cell seq_cst, align 8
  ret void
}

define hidden i64 @nz.atomic_swap(ptr %cell, i64 %v) {
entry:
  %old = atomicrmw xchg ptr %cell, i64 %v seq_cst, align 8
  ret i64 %old
}

define hidden i1 @nz.atomic_cas(ptr %cell, i64 %expected, i64 %new) {
entry:
  %r = cmpxchg ptr %cell, i64 %expected, i64 %new seq_cst seq_cst, align 8
  %ok = extractvalue { i64, i1 } %r, 1
  ret i1 %ok
}
"#
}

pub fn rt_tls_TLS_RUNTIME() -> Str ! {} {
    r#"
; TLS (C1): 65 535 slots of { object, generation, kind, held }, made on first use. Kind 0 is free,
; -1 being taken, 1 a client configuration, 2 a server's, 3 a session. An id is the generation
; above 16 bits and the slot's index below; index 0 is never a slot, so no id is 0.
@nz.tls_slots = hidden global ptr null
@nz.tls_hint = hidden global i64 1

declare ptr @nz_tls_config(i64, ptr, i64, ptr, i64, ptr, i64, ptr)
declare void @nz_tls_config_free(ptr)
declare ptr @nz_tls_session(ptr, ptr, i64, ptr)
declare i64 @nz_tls_handshake(ptr)
declare i64 @nz_tls_push(ptr, ptr, i64)
declare i64 @nz_tls_pull(ptr, ptr, i64)
declare i64 @nz_tls_read(ptr, ptr, i64)
declare i64 @nz_tls_write(ptr, ptr, i64)
declare i64 @nz_tls_close(ptr, ptr, i64)
declare i64 @nz_tls_info(ptr, i64, ptr, i64)

; The table, made zeroed by the first caller that needs it; null when memory is refused.
define hidden ptr @nz.tls_table() {
entry:
  %t = load atomic ptr, ptr @nz.tls_slots acquire, align 8
  %none = icmp eq ptr %t, null
  br i1 %none, label %make, label %have
have:
  ret ptr %t
make:
  %m = call ptr @malloc(i64 2097152)
  %nm = icmp eq ptr %m, null
  br i1 %nm, label %fail, label %zero
fail:
  ret ptr null
zero:
  call void @llvm.memset.p0.i64(ptr %m, i8 0, i64 2097152, i1 false)
  %pair = cmpxchg ptr @nz.tls_slots, ptr null, ptr %m acq_rel acquire
  %won = extractvalue { ptr, i1 } %pair, 1
  br i1 %won, label %mine, label %theirs
mine:
  ret ptr %m
theirs:
  call void @free(ptr %m)
  %o = extractvalue { ptr, i1 } %pair, 0
  ret ptr %o
}

; A free slot for `obj` of `kind`: its id; -24 (too many open) when every slot is taken, -12 when
; the table cannot be made.
define hidden i64 @nz.tls_put(ptr %obj, i64 %kind) {
entry:
  %table = call ptr @nz.tls_table()
  %nt = icmp eq ptr %table, null
  br i1 %nt, label %nomem, label %start
nomem:
  ret i64 -12
start:
  %h = load atomic i64, ptr @nz.tls_hint monotonic, align 8
  br label %loop
loop:
  %n = phi i64 [ 0, %start ], [ %n1, %next ]
  %i0 = phi i64 [ %h, %start ], [ %i1, %next ]
  %done = icmp eq i64 %n, 65535
  br i1 %done, label %full, label %try
try:
  %low = icmp ult i64 %i0, 1
  %high = icmp ugt i64 %i0, 65535
  %wrap = or i1 %low, %high
  %i = select i1 %wrap, i64 1, i64 %i0
  %s = getelementptr [4 x i64], ptr %table, i64 %i
  %kp = getelementptr i64, ptr %s, i64 2
  %pair = cmpxchg ptr %kp, i64 0, i64 -1 acq_rel monotonic
  %won = extractvalue { i64, i1 } %pair, 1
  br i1 %won, label %take, label %next
next:
  %n1 = add i64 %n, 1
  %i1 = add i64 %i, 1
  br label %loop
take:
  %gp = getelementptr i64, ptr %s, i64 1
  %g = load atomic i64, ptr %gp monotonic, align 8
  %g1 = add i64 %g, 1
  store atomic i64 %g1, ptr %gp monotonic, align 8
  store ptr %obj, ptr %s
  %after = add i64 %i, 1
  store atomic i64 %after, ptr @nz.tls_hint monotonic, align 8
  store atomic i64 %kind, ptr %kp release, align 8
  %hi = shl i64 %g1, 16
  %id = or i64 %hi, %i
  ret i64 %id
full:
  ret i64 -24
}

; `id`'s slot, or null for an id no slot has.
define hidden ptr @nz.tls_slot(i64 %id) {
entry:
  %i = and i64 %id, 65535
  %some = icmp ne i64 %i, 0
  %pos = icmp sgt i64 %id, 65535
  %ok = and i1 %some, %pos
  br i1 %ok, label %table, label %no
table:
  %t = load atomic ptr, ptr @nz.tls_slots acquire, align 8
  %made = icmp ne ptr %t, null
  br i1 %made, label %yes, label %no
yes:
  %s = getelementptr [4 x i64], ptr %t, i64 %i
  ret ptr %s
no:
  ret ptr null
}

; Hold slot `s` for `id`: its object when the id is live and of `kind` (0: any kind), the slot
; then held until `nz.tls_let_go`; null, and nothing held, otherwise.
define hidden ptr @nz.tls_hold(ptr %s, i64 %id, i64 %kind) {
entry:
  %bp = getelementptr i64, ptr %s, i64 3
  br label %spin
spin:
  %pair = cmpxchg ptr %bp, i64 0, i64 1 acquire monotonic
  %won = extractvalue { i64, i1 } %pair, 1
  br i1 %won, label %check, label %spin
check:
  %gp = getelementptr i64, ptr %s, i64 1
  %g = load atomic i64, ptr %gp monotonic, align 8
  %want = lshr i64 %id, 16
  %same = icmp eq i64 %g, %want
  %kp = getelementptr i64, ptr %s, i64 2
  %k = load atomic i64, ptr %kp acquire, align 8
  %live = icmp sgt i64 %k, 0
  %any = icmp eq i64 %kind, 0
  %match = icmp eq i64 %k, %kind
  %kok = or i1 %any, %match
  %a = and i1 %same, %live
  %b = and i1 %a, %kok
  br i1 %b, label %yes, label %no
yes:
  %o = load ptr, ptr %s
  ret ptr %o
no:
  store atomic i64 0, ptr %bp release, align 8
  ret ptr null
}

define hidden void @nz.tls_let_go(ptr %s) {
entry:
  %bp = getelementptr i64, ptr %s, i64 3
  store atomic i64 0, ptr %bp release, align 8
  ret void
}

; A configuration of `kind` from the engine, put in a slot: its id, or the engine's status.
define hidden i64 @nz.tls_configure(i64 %kind, ptr %a, i64 %an, ptr %b, i64 %bn, ptr %p, i64 %pn) {
entry:
  %st = alloca i64, align 8
  store i64 -65604, ptr %st
  %o = call ptr @nz_tls_config(i64 %kind, ptr %a, i64 %an, ptr %b, i64 %bn, ptr %p, i64 %pn, ptr %st)
  %none = icmp eq ptr %o, null
  br i1 %none, label %bad, label %put
bad:
  %s = load i64, ptr %st
  ret i64 %s
put:
  %id = call i64 @nz.tls_put(ptr %o, i64 %kind)
  %full = icmp slt i64 %id, 0
  br i1 %full, label %drop, label %ok
drop:
  call void @nz_tls_config_free(ptr %o)
  ret i64 %id
ok:
  ret i64 %id
}

define hidden i64 @nz.os_tls_client_config(ptr %ca, i64 %can, ptr %p, i64 %pn) {
entry:
  %r = call i64 @nz.tls_configure(i64 1, ptr %ca, i64 %can, ptr null, i64 0, ptr %p, i64 %pn)
  ret i64 %r
}

define hidden i64 @nz.os_tls_server_config(ptr %c, i64 %cn, ptr %k, i64 %kn, ptr %p, i64 %pn) {
entry:
  %r = call i64 @nz.tls_configure(i64 2, ptr %c, i64 %cn, ptr %k, i64 %kn, ptr %p, i64 %pn)
  ret i64 %r
}

; A session from configuration `cfg` of `kind`, verifying `host` for a client: its id or a status.
define hidden i64 @nz.tls_open(i64 %cfg, i64 %kind, ptr %h, i64 %hn) {
entry:
  %st = alloca i64, align 8
  store i64 -65604, ptr %st
  %s = call ptr @nz.tls_slot(i64 %cfg)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %closed, label %hold
hold:
  %c = call ptr @nz.tls_hold(ptr %s, i64 %cfg, i64 %kind)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %closed, label %make
make:
  %e = call ptr @nz_tls_session(ptr %c, ptr %h, i64 %hn, ptr %st)
  call void @nz.tls_let_go(ptr %s)
  %ne = icmp eq ptr %e, null
  br i1 %ne, label %bad, label %put
bad:
  %why = load i64, ptr %st
  ret i64 %why
put:
  %id = call i64 @nz.tls_put(ptr %e, i64 3)
  %full = icmp slt i64 %id, 0
  br i1 %full, label %drop, label %ok
drop:
  %z = call i64 @nz_tls_close(ptr %e, ptr null, i64 0)
  ret i64 %id
ok:
  ret i64 %id
closed:
  ret i64 -65536
}

define hidden i64 @nz.os_tls_connect(i64 %cfg, ptr %h, i64 %hn) {
entry:
  %r = call i64 @nz.tls_open(i64 %cfg, i64 1, ptr %h, i64 %hn)
  ret i64 %r
}

define hidden i64 @nz.os_tls_accept(i64 %cfg) {
entry:
  %r = call i64 @nz.tls_open(i64 %cfg, i64 2, ptr null, i64 0)
  ret i64 %r
}

; One engine call on session `id`, with its slot held: 0 the handshake, 1 push, 2 pull, 3 read,
; 4 write, 5 a fact (`what`). -65536 for an id that is not a live session.
define hidden i64 @nz.tls_call(i64 %id, i64 %op, ptr %p, i64 %n, i64 %what) {
entry:
  %s = call ptr @nz.tls_slot(i64 %id)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %closed, label %hold
hold:
  %e = call ptr @nz.tls_hold(ptr %s, i64 %id, i64 3)
  %ne = icmp eq ptr %e, null
  br i1 %ne, label %closed, label %pick
pick:
  switch i64 %op, label %info [ i64 0, label %hs
                                i64 1, label %push
                                i64 2, label %pull
                                i64 3, label %read
                                i64 4, label %write ]
hs:
  %r0 = call i64 @nz_tls_handshake(ptr %e)
  br label %done
push:
  %r1 = call i64 @nz_tls_push(ptr %e, ptr %p, i64 %n)
  br label %done
pull:
  %r2 = call i64 @nz_tls_pull(ptr %e, ptr %p, i64 %n)
  br label %done
read:
  %r3 = call i64 @nz_tls_read(ptr %e, ptr %p, i64 %n)
  br label %done
write:
  %r4 = call i64 @nz_tls_write(ptr %e, ptr %p, i64 %n)
  br label %done
info:
  %r5 = call i64 @nz_tls_info(ptr %e, i64 %what, ptr %p, i64 %n)
  br label %done
done:
  %r = phi i64 [ %r0, %hs ], [ %r1, %push ], [ %r2, %pull ], [ %r3, %read ], [ %r4, %write ], [ %r5, %info ]
  call void @nz.tls_let_go(ptr %s)
  ret i64 %r
closed:
  ret i64 -65536
}

define hidden i64 @nz.os_tls_handshake(i64 %id) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 0, ptr null, i64 0, i64 0)
  ret i64 %r
}

define hidden i64 @nz.os_tls_push(i64 %id, ptr %p, i64 %n) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 1, ptr %p, i64 %n, i64 0)
  ret i64 %r
}

define hidden i64 @nz.os_tls_pull(i64 %id, ptr %p, i64 %n) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 2, ptr %p, i64 %n, i64 0)
  ret i64 %r
}

define hidden i64 @nz.os_tls_read(i64 %id, ptr %p, i64 %n) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 3, ptr %p, i64 %n, i64 0)
  ret i64 %r
}

define hidden i64 @nz.os_tls_write(i64 %id, ptr %p, i64 %n) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 4, ptr %p, i64 %n, i64 0)
  ret i64 %r
}

define hidden i64 @nz.os_tls_info(i64 %id, i64 %what, ptr %p, i64 %n) {
entry:
  %r = call i64 @nz.tls_call(i64 %id, i64 5, ptr %p, i64 %n, i64 %what)
  ret i64 %r
}

; Close `id`, a session or a configuration: a session's last ciphertext (its close_notify) into
; `p`, and the id dead from now on. A configuration's sessions keep what they took from it.
define hidden i64 @nz.os_tls_close(i64 %id, ptr %p, i64 %n) {
entry:
  %s = call ptr @nz.tls_slot(i64 %id)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %closed, label %hold
hold:
  %o = call ptr @nz.tls_hold(ptr %s, i64 %id, i64 0)
  %no = icmp eq ptr %o, null
  br i1 %no, label %closed, label %which
which:
  %kp = getelementptr i64, ptr %s, i64 2
  %k = load atomic i64, ptr %kp acquire, align 8
  %session = icmp eq i64 %k, 3
  br i1 %session, label %end, label %config
end:
  %r = call i64 @nz_tls_close(ptr %o, ptr %p, i64 %n)
  br label %free
config:
  call void @nz_tls_config_free(ptr %o)
  br label %free
free:
  %out = phi i64 [ %r, %end ], [ 0, %config ]
  store ptr null, ptr %s
  store atomic i64 0, ptr %kp release, align 8
  call void @nz.tls_let_go(ptr %s)
  ret i64 %out
closed:
  ret i64 -65536
}
"#
}

pub fn rt_tls_OPENSSL() -> Str ! {} {
    r#"
; The TLS engine (C1): OpenSSL 3, over memory BIOs. Generated by nazm build. Do not edit.
declare ptr @calloc(i64, i64)
declare ptr @malloc(i64)
declare void @free(ptr)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)
declare ptr @TLS_client_method()
declare ptr @TLS_server_method()
declare ptr @SSL_CTX_new(ptr)
declare void @SSL_CTX_free(ptr)
declare i64 @SSL_CTX_ctrl(ptr, i32, i64, ptr)
declare void @SSL_CTX_set_verify(ptr, i32, ptr)
declare void @SSL_CTX_set_alpn_select_cb(ptr, ptr, ptr)
declare i32 @SSL_CTX_set_alpn_protos(ptr, ptr, i32)
declare i32 @SSL_CTX_use_certificate(ptr, ptr)
declare i32 @SSL_CTX_use_PrivateKey(ptr, ptr)
declare i32 @SSL_CTX_check_private_key(ptr)
declare ptr @BIO_new_mem_buf(ptr, i32)
declare ptr @BIO_new(ptr)
declare ptr @BIO_s_mem()
declare i32 @BIO_free(ptr)
declare i32 @BIO_read(ptr, ptr, i32)
declare i32 @BIO_write(ptr, ptr, i32)
declare ptr @PEM_read_bio_X509(ptr, ptr, ptr, ptr)
declare ptr @PEM_read_bio_PrivateKey(ptr, ptr, ptr, ptr)
declare void @X509_free(ptr)
declare void @EVP_PKEY_free(ptr)
declare void @ERR_clear_error()
declare i64 @ERR_peek_last_error()
declare void @ERR_error_string_n(i64, ptr, i64)
declare ptr @SSL_new(ptr)
declare void @SSL_free(ptr)
declare i32 @SSL_set_ex_data(ptr, i32, ptr)
declare ptr @SSL_get_ex_data(ptr, i32)
declare void @SSL_set_bio(ptr, ptr, ptr)
declare i64 @SSL_ctrl(ptr, i32, i64, ptr)
declare void @SSL_set_connect_state(ptr)
declare void @SSL_set_accept_state(ptr)
declare i32 @SSL_do_handshake(ptr)
declare i32 @SSL_get_error(ptr, i32)
declare i32 @SSL_read(ptr, ptr, i32)
declare i32 @SSL_write(ptr, ptr, i32)
declare ptr @SSL_get_rbio(ptr)
declare ptr @SSL_get_wbio(ptr)
declare i32 @SSL_shutdown(ptr)
declare i32 @SSL_is_init_finished(ptr)
declare void @SSL_get0_alpn_selected(ptr, ptr, ptr)
declare ptr @SSL_get_version(ptr)
declare ptr @SSL_get1_peer_certificate(ptr)
declare ptr @X509_get_subject_name(ptr)
declare ptr @X509_NAME_oneline(ptr, ptr, i32)
declare i32 @SSL_select_next_proto(ptr, ptr, ptr, i32, ptr, i32)
declare i64 @strlen(ptr)

; A password callback that has none: an encrypted key is refused, never asked for on a terminal.
define hidden i32 @nz_tls_nopass(ptr %b, i32 %n, i32 %rw, ptr %u) {
entry:
  ret i32 0
}

; Whether `p[0..n]` is ALPN's wire form: one or more names, each a length byte of 1 to 255 and
; that many bytes.
define hidden i1 @nz_tls_alpn_ok(ptr %p, i64 %n) {
entry:
  %some = icmp sgt i64 %n, 0
  br i1 %some, label %loop, label %no
loop:
  %at = phi i64 [ 0, %entry ], [ %next, %more ]
  %lp = getelementptr i8, ptr %p, i64 %at
  %lb = load i8, ptr %lp
  %l = zext i8 %lb to i64
  %empty = icmp eq i64 %l, 0
  br i1 %empty, label %no, label %step
step:
  %after = add i64 %at, 1
  %next = add i64 %after, %l
  %over = icmp sgt i64 %next, %n
  br i1 %over, label %no, label %fits
fits:
  %end = icmp eq i64 %next, %n
  br i1 %end, label %yes, label %more
more:
  br label %loop
yes:
  ret i1 true
no:
  ret i1 false
}

; The server's choice among what the client offers: the first of its own, in its order, that the
; client offers too; none when they share none, and the handshake goes on without one.
define hidden i32 @nz_tls_alpn_select(ptr %ssl, ptr %out, ptr %outlen, ptr %in, i32 %inlen, ptr %arg) {
entry:
  %e = call ptr @SSL_get_ex_data(ptr %ssl, i32 0)
  %ne = icmp eq ptr %e, null
  br i1 %ne, label %none, label %have
have:
  %app = getelementptr i8, ptr %e, i64 40
  %a = load ptr, ptr %app
  %anp = getelementptr i8, ptr %e, i64 48
  %an = load i64, ptr %anp
  %zero = icmp eq i64 %an, 0
  br i1 %zero, label %none, label %pick
pick:
  %an32 = trunc i64 %an to i32
  %r = call i32 @SSL_select_next_proto(ptr %out, ptr %outlen, ptr %a, i32 %an32, ptr %in, i32 %inlen)
  %agreed = icmp eq i32 %r, 1
  br i1 %agreed, label %ok, label %none
ok:
  ret i32 0
none:
  ret i32 3
}

; A copy of `p[0..n]` in memory of its own, NUL-terminated; null when memory is refused.
define hidden ptr @nz_tls_copy(ptr %p, i64 %n) {
entry:
  %m = add i64 %n, 1
  %c = call ptr @calloc(i64 %m, i64 1)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %out, label %fill
fill:
  call void @llvm.memcpy.p0.p0.i64(ptr %c, ptr %p, i64 %n, i1 false)
  br label %out
out:
  ret ptr %c
}

; A configuration of `kind` (1 a client's: `a` its anchors, none for the system's; 2 a server's:
; `a` its certificate chain, `b` its key, both PEM), offering the ALPN names `p` (wire form, or
; none). Null with the status in `st` when anything is refused.
define hidden ptr @nz_tls_config(i64 %kind, ptr %a, i64 %an, ptr %b, i64 %bn, ptr %p, i64 %pn, ptr %st) {
entry:
  call void @ERR_clear_error()
  %has = icmp sgt i64 %pn, 0
  br i1 %has, label %check, label %sizes
check:
  %good = call i1 @nz_tls_alpn_ok(ptr %p, i64 %pn)
  br i1 %good, label %sizes, label %invalid
sizes:
  %big = icmp sgt i64 %an, 1073741824
  %big2 = icmp sgt i64 %bn, 1073741824
  %big3 = icmp sgt i64 %pn, 65535
  %b12 = or i1 %big, %big2
  %toobig = or i1 %b12, %big3
  br i1 %toobig, label %invalid, label %make
make:
  %c = call ptr @calloc(i64 1, i64 40)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %nomem, label %method
method:
  %client = icmp eq i64 %kind, 1
  br i1 %client, label %cm, label %sm
cm:
  %mc = call ptr @TLS_client_method()
  br label %ctx
sm:
  %ms = call ptr @TLS_server_method()
  br label %ctx
ctx:
  %m = phi ptr [ %mc, %cm ], [ %ms, %sm ]
  %x = call ptr @SSL_CTX_new(ptr %m)
  %nx = icmp eq ptr %x, null
  br i1 %nx, label %nomem1, label %set
set:
  store ptr %x, ptr %c
  %kp = getelementptr i8, ptr %c, i64 8
  store i64 %kind, ptr %kp
  ; TLS 1.2 at least (SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION).
  %v = call i64 @SSL_CTX_ctrl(ptr %x, i32 123, i64 771, ptr null)
  br i1 %has, label %alpn, label %side
alpn:
  %ac = call ptr @nz_tls_copy(ptr %p, i64 %pn)
  %nac = icmp eq ptr %ac, null
  br i1 %nac, label %nomem2, label %kept
kept:
  %app = getelementptr i8, ptr %c, i64 24
  store ptr %ac, ptr %app
  %anp = getelementptr i8, ptr %c, i64 32
  store i64 %pn, ptr %anp
  br label %side
side:
  br i1 %client, label %trust, label %identity
trust:
  ; Verification is always on: a client refuses a chain or a name it cannot verify.
  call void @SSL_CTX_set_verify(ptr %x, i32 1, ptr null)
  %t = call i32 @nz_tls_trust(ptr %c, ptr %x, ptr %a, i64 %an)
  %tok = icmp eq i32 %t, 0
  br i1 %tok, label %offer, label %badkey
offer:
  br i1 %has, label %offer1, label %done
offer1:
  %pn32 = trunc i64 %pn to i32
  %o = call i32 @SSL_CTX_set_alpn_protos(ptr %x, ptr %p, i32 %pn32)
  br label %done
identity:
  %an32 = trunc i64 %an to i32
  %cb = call ptr @BIO_new_mem_buf(ptr %a, i32 %an32)
  %leaf = call ptr @PEM_read_bio_X509(ptr %cb, ptr null, ptr @nz_tls_nopass, ptr null)
  %nl = icmp eq ptr %leaf, null
  br i1 %nl, label %badcert, label %use
use:
  %u = call i32 @SSL_CTX_use_certificate(ptr %x, ptr %leaf)
  call void @X509_free(ptr %leaf)
  %uok = icmp eq i32 %u, 1
  br i1 %uok, label %chain, label %badcert
chain:
  %more = call ptr @PEM_read_bio_X509(ptr %cb, ptr null, ptr @nz_tls_nopass, ptr null)
  %nm = icmp eq ptr %more, null
  br i1 %nm, label %key, label %extra
extra:
  ; SSL_CTRL_EXTRA_CHAIN_CERT: the context takes the certificate.
  %ec = call i64 @SSL_CTX_ctrl(ptr %x, i32 14, i64 0, ptr %more)
  br label %chain
key:
  %f1 = call i32 @BIO_free(ptr %cb)
  call void @ERR_clear_error()
  %bn32 = trunc i64 %bn to i32
  %kb = call ptr @BIO_new_mem_buf(ptr %b, i32 %bn32)
  %k = call ptr @PEM_read_bio_PrivateKey(ptr %kb, ptr null, ptr @nz_tls_nopass, ptr null)
  %f2 = call i32 @BIO_free(ptr %kb)
  %nk = icmp eq ptr %k, null
  br i1 %nk, label %badkey, label %usekey
usekey:
  %uk = call i32 @SSL_CTX_use_PrivateKey(ptr %x, ptr %k)
  call void @EVP_PKEY_free(ptr %k)
  %ukok = icmp eq i32 %uk, 1
  br i1 %ukok, label %pair, label %badkey
pair:
  %pk = call i32 @SSL_CTX_check_private_key(ptr %x)
  %pkok = icmp eq i32 %pk, 1
  br i1 %pkok, label %select, label %badkey
select:
  call void @SSL_CTX_set_alpn_select_cb(ptr %x, ptr @nz_tls_alpn_select, ptr null)
  br label %done
done:
  call void @ERR_clear_error()
  ret ptr %c
badcert:
  %f3 = call i32 @BIO_free(ptr %cb)
  br label %badkey
badkey:
  call void @nz_tls_config_free(ptr %c)
  call void @ERR_clear_error()
  store i64 -65605, ptr %st
  ret ptr null
nomem2:
  call void @nz_tls_config_free(ptr %c)
  br label %nomem
nomem1:
  call void @free(ptr %c)
  br label %nomem
nomem:
  call void @ERR_clear_error()
  store i64 -12, ptr %st
  ret ptr null
invalid:
  store i64 -22, ptr %st
  ret ptr null
}

define hidden void @nz_tls_config_free(ptr %c) {
entry:
  %x = load ptr, ptr %c
  %nx = icmp eq ptr %x, null
  br i1 %nx, label %rest, label %ctx
ctx:
  call void @SSL_CTX_free(ptr %x)
  br label %rest
rest:
  %anc = getelementptr i8, ptr %c, i64 16
  call void @nz_tls_unanchor(ptr %anc)
  %app = getelementptr i8, ptr %c, i64 24
  %a = load ptr, ptr %app
  call void @free(ptr %a)
  call void @free(ptr %c)
  ret void
}

; Whether `h[0..n]` is an IP address literal, which a client never sends as its server name.
define hidden i1 @nz_tls_is_ip(ptr %h, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %next ]
  %end = icmp eq i64 %i, %n
  br i1 %end, label %yes, label %one
one:
  %cp = getelementptr i8, ptr %h, i64 %i
  %c = load i8, ptr %cp
  %colon = icmp eq i8 %c, 58
  br i1 %colon, label %yes, label %digit
digit:
  %dot = icmp eq i8 %c, 46
  %ge = icmp uge i8 %c, 48
  %le = icmp ule i8 %c, 57
  %d = and i1 %ge, %le
  %ok = or i1 %d, %dot
  br i1 %ok, label %next, label %no
next:
  %i1 = add i64 %i, 1
  br label %loop
yes:
  ret i1 true
no:
  ret i1 false
}

; A session of configuration `c`: a client's verifying `h[0..n]`. Null with the status in `st`.
define hidden ptr @nz_tls_session(ptr %c, ptr %h, i64 %n, ptr %st) {
entry:
  call void @ERR_clear_error()
  %kp = getelementptr i8, ptr %c, i64 8
  %kind = load i64, ptr %kp
  %client = icmp eq i64 %kind, 1
  br i1 %client, label %name, label %make
name:
  ; A client names the server it verifies: not empty, no NUL, at most 253 bytes.
  %empty = icmp slt i64 %n, 1
  %long = icmp sgt i64 %n, 253
  %bad = or i1 %empty, %long
  br i1 %bad, label %invalid, label %nul
nul:
  br label %scan
scan:
  %i = phi i64 [ 0, %nul ], [ %i1, %step ]
  %done = icmp eq i64 %i, %n
  br i1 %done, label %make, label %look
look:
  %bp = getelementptr i8, ptr %h, i64 %i
  %b = load i8, ptr %bp
  %z = icmp eq i8 %b, 0
  br i1 %z, label %invalid, label %step
step:
  %i1 = add i64 %i, 1
  br label %scan
make:
  %e = call ptr @calloc(i64 1, i64 256)
  %ne = icmp eq ptr %e, null
  br i1 %ne, label %nomem, label %ssl
ssl:
  %x = load ptr, ptr %c
  %s = call ptr @SSL_new(ptr %x)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %nomem1, label %bios
bios:
  store ptr %s, ptr %e
  %xd = call i32 @SSL_set_ex_data(ptr %s, i32 0, ptr %e)
  %mm = call ptr @BIO_s_mem()
  %rb = call ptr @BIO_new(ptr %mm)
  %wb = call ptr @BIO_new(ptr %mm)
  call void @SSL_set_bio(ptr %s, ptr %rb, ptr %wb)
  %nr = icmp eq ptr %rb, null
  %nw = icmp eq ptr %wb, null
  %nb = or i1 %nr, %nw
  br i1 %nb, label %nomem2, label %anchors
anchors:
  ; The session keeps its own reference to the anchors and its own copy of the ALPN names, so a
  ; configuration closed meanwhile leaves it whole.
  %canp = getelementptr i8, ptr %c, i64 16
  %ean = getelementptr i8, ptr %e, i64 8
  call void @nz_tls_anchor(ptr %ean, ptr %canp)
  %capp = getelementptr i8, ptr %c, i64 24
  %ca = load ptr, ptr %capp
  %canlp = getelementptr i8, ptr %c, i64 32
  %can = load i64, ptr %canlp
  %hasa = icmp sgt i64 %can, 0
  br i1 %hasa, label %copya, label %side
copya:
  %ac = call ptr @nz_tls_copy(ptr %ca, i64 %can)
  %nac = icmp eq ptr %ac, null
  br i1 %nac, label %nomem2, label %kepta
kepta:
  %eap = getelementptr i8, ptr %e, i64 40
  store ptr %ac, ptr %eap
  %eanp = getelementptr i8, ptr %e, i64 48
  store i64 %can, ptr %eanp
  br label %side
side:
  br i1 %client, label %connect, label %accept
connect:
  %hc = call ptr @nz_tls_copy(ptr %h, i64 %n)
  %nhc = icmp eq ptr %hc, null
  br i1 %nhc, label %nomem2, label %named
named:
  %ehp = getelementptr i8, ptr %e, i64 24
  store ptr %hc, ptr %ehp
  %ehn = getelementptr i8, ptr %e, i64 32
  store i64 %n, ptr %ehn
  %ip = call i1 @nz_tls_is_ip(ptr %h, i64 %n)
  br i1 %ip, label %check, label %sni
sni:
  ; SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_host_name.
  %sn = call i64 @SSL_ctrl(ptr %s, i32 55, i64 0, ptr %hc)
  br label %check
check:
  call void @nz_tls_name(ptr %s, ptr %hc)
  call void @SSL_set_connect_state(ptr %s)
  br label %ok
accept:
  call void @SSL_set_accept_state(ptr %s)
  br label %ok
ok:
  call void @ERR_clear_error()
  ret ptr %e
nomem2:
  %z2 = call i64 @nz_tls_close(ptr %e, ptr null, i64 0)
  br label %nomem
nomem1:
  call void @free(ptr %e)
  br label %nomem
nomem:
  call void @ERR_clear_error()
  store i64 -12, ptr %st
  ret ptr null
invalid:
  store i64 -22, ptr %st
  ret ptr null
}

; What a failed call of the engine means: the wait for more ciphertext; 0, the peer's close; a
; verdict on the peer's certificate; or a protocol failure, its text kept for `os_tls_info`.
define hidden i64 @nz_tls_failed(ptr %e, i32 %r) {
entry:
  %s = load ptr, ptr %e
  %err = call i32 @SSL_get_error(ptr %s, i32 %r)
  %want = icmp eq i32 %err, 2
  br i1 %want, label %more, label %zero
more:
  ret i64 -65600
zero:
  %closed = icmp eq i32 %err, 6
  br i1 %closed, label %end, label %verdict
end:
  ret i64 0
verdict:
  %v = call i64 @nz_tls_verdict(ptr %e)
  %some = icmp ne i64 %v, 0
  br i1 %some, label %refused, label %protocol
refused:
  ret i64 %v
protocol:
  %dp = getelementptr i8, ptr %e, i64 56
  %d0 = load i8, ptr %dp
  %said = icmp ne i8 %d0, 0
  br i1 %said, label %out, label %text
text:
  %q = call i64 @ERR_peek_last_error()
  %nq = icmp eq i64 %q, 0
  br i1 %nq, label %out, label %write
write:
  call void @ERR_error_string_n(i64 %q, ptr %dp, i64 200)
  br label %out
out:
  ret i64 -65604
}

define hidden i64 @nz_tls_handshake(ptr %e) {
entry:
  call void @ERR_clear_error()
  %s = load ptr, ptr %e
  %r = call i32 @SSL_do_handshake(ptr %s)
  %ok = icmp eq i32 %r, 1
  br i1 %ok, label %done, label %failed
done:
  ret i64 1
failed:
  %f = call i64 @nz_tls_failed(ptr %e, i32 %r)
  ; A handshake the peer ended is not finished: a protocol failure, not the end of the data.
  %z = icmp eq i64 %f, 0
  %g = select i1 %z, i64 -65604, i64 %f
  ret i64 %g
}

; At most 2^30 bytes at a time: the engine counts in C's `int`.
define hidden i32 @nz_tls_clamp(i64 %n) {
entry:
  %big = icmp sgt i64 %n, 1073741824
  %m = select i1 %big, i64 1073741824, i64 %n
  %r = trunc i64 %m to i32
  ret i32 %r
}

define hidden i64 @nz_tls_push(ptr %e, ptr %p, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %zero, label %go
zero:
  ret i64 0
go:
  %s = load ptr, ptr %e
  %b = call ptr @SSL_get_rbio(ptr %s)
  br label %loop
loop:
  %at = phi i64 [ 0, %go ], [ %at1, %wrote ]
  %left = sub i64 %n, %at
  %done = icmp eq i64 %left, 0
  br i1 %done, label %all, label %one
one:
  %c = call i32 @nz_tls_clamp(i64 %left)
  %q = getelementptr i8, ptr %p, i64 %at
  %w = call i32 @BIO_write(ptr %b, ptr %q, i32 %c)
  %ok = icmp sgt i32 %w, 0
  br i1 %ok, label %wrote, label %nomem
wrote:
  %w64 = sext i32 %w to i64
  %at1 = add i64 %at, %w64
  br label %loop
all:
  ret i64 %n
nomem:
  call void @ERR_clear_error()
  ret i64 -12
}

define hidden i64 @nz_tls_pull(ptr %e, ptr %p, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %zero, label %go
go:
  %s = load ptr, ptr %e
  %b = call ptr @SSL_get_wbio(ptr %s)
  %c = call i32 @nz_tls_clamp(i64 %n)
  %r = call i32 @BIO_read(ptr %b, ptr %p, i32 %c)
  %some = icmp sgt i32 %r, 0
  br i1 %some, label %got, label %zero
got:
  %r64 = sext i32 %r to i64
  ret i64 %r64
zero:
  call void @ERR_clear_error()
  ret i64 0
}

define hidden i64 @nz_tls_read(ptr %e, ptr %p, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %invalid, label %go
invalid:
  ret i64 -22
go:
  call void @ERR_clear_error()
  %s = load ptr, ptr %e
  %c = call i32 @nz_tls_clamp(i64 %n)
  %r = call i32 @SSL_read(ptr %s, ptr %p, i32 %c)
  %some = icmp sgt i32 %r, 0
  br i1 %some, label %got, label %failed
got:
  %r64 = sext i32 %r to i64
  ret i64 %r64
failed:
  %f = call i64 @nz_tls_failed(ptr %e, i32 %r)
  ret i64 %f
}

define hidden i64 @nz_tls_write(ptr %e, ptr %p, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %zero, label %go
zero:
  ret i64 0
go:
  call void @ERR_clear_error()
  %s = load ptr, ptr %e
  %c = call i32 @nz_tls_clamp(i64 %n)
  %r = call i32 @SSL_write(ptr %s, ptr %p, i32 %c)
  %some = icmp sgt i32 %r, 0
  br i1 %some, label %got, label %failed
got:
  %r64 = sext i32 %r to i64
  ret i64 %r64
failed:
  %f = call i64 @nz_tls_failed(ptr %e, i32 %r)
  ; A session the peer closed takes nothing more.
  %z = icmp eq i64 %f, 0
  %g = select i1 %z, i64 -65536, i64 %f
  ret i64 %g
}

; The end of session `e`: its close_notify, once the handshake is done, into `p`, then everything
; it holds freed. A null `p` frees without writing.
define hidden i64 @nz_tls_close(ptr %e, ptr %p, i64 %n) {
entry:
  call void @ERR_clear_error()
  %s = load ptr, ptr %e
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %rest, label %bye
bye:
  %fin = call i32 @SSL_is_init_finished(ptr %s)
  %up = icmp ne i32 %fin, 0
  %np = icmp eq ptr %p, null
  %write = xor i1 %np, true
  %both = and i1 %up, %write
  br i1 %both, label %notify, label %drop
notify:
  %sd = call i32 @SSL_shutdown(ptr %s)
  %r = call i64 @nz_tls_pull(ptr %e, ptr %p, i64 %n)
  br label %drop
drop:
  %out = phi i64 [ 0, %bye ], [ %r, %notify ]
  call void @SSL_free(ptr %s)
  br label %rest
rest:
  %res = phi i64 [ 0, %entry ], [ %out, %drop ]
  %anc = getelementptr i8, ptr %e, i64 8
  call void @nz_tls_unanchor(ptr %anc)
  %hp = getelementptr i8, ptr %e, i64 24
  %h = load ptr, ptr %hp
  call void @free(ptr %h)
  %ap = getelementptr i8, ptr %e, i64 40
  %a = load ptr, ptr %ap
  call void @free(ptr %a)
  call void @free(ptr %e)
  call void @ERR_clear_error()
  ret i64 %res
}

; `n` bytes of `src` into `p`, at most `cap`: how many.
define hidden i64 @nz_tls_give(ptr %src, i64 %n, ptr %p, i64 %cap) {
entry:
  %fits = icmp slt i64 %n, %cap
  %m = select i1 %fits, i64 %n, i64 %cap
  %pos = icmp sgt i64 %m, 0
  br i1 %pos, label %copy, label %none
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %src, i64 %m, i1 false)
  ret i64 %m
none:
  ret i64 0
}

; A fact about session `e`, into `p`: 0 the ALPN name agreed, 1 the protocol's version, 2 the
; peer certificate's subject, 3 why the last call failed. Its length; empty when there is none.
define hidden i64 @nz_tls_info(ptr %e, i64 %what, ptr %p, i64 %cap) {
entry:
  %s = load ptr, ptr %e
  switch i64 %what, label %invalid [ i64 0, label %alpn
                                     i64 1, label %version
                                     i64 2, label %peer
                                     i64 3, label %detail ]
alpn:
  %ap = alloca ptr, align 8
  %al = alloca i32, align 4
  store ptr null, ptr %ap
  store i32 0, ptr %al
  call void @SSL_get0_alpn_selected(ptr %s, ptr %ap, ptr %al)
  %a = load ptr, ptr %ap
  %l = load i32, ptr %al
  %l64 = zext i32 %l to i64
  %na = icmp eq ptr %a, null
  br i1 %na, label %empty, label %givea
givea:
  %ga = call i64 @nz_tls_give(ptr %a, i64 %l64, ptr %p, i64 %cap)
  ret i64 %ga
version:
  %v = call ptr @SSL_get_version(ptr %s)
  %vl = call i64 @strlen(ptr %v)
  %gv = call i64 @nz_tls_give(ptr %v, i64 %vl, ptr %p, i64 %cap)
  ret i64 %gv
peer:
  %x = call ptr @SSL_get1_peer_certificate(ptr %s)
  %nx = icmp eq ptr %x, null
  br i1 %nx, label %empty, label %name
name:
  %buf = alloca [256 x i8], align 1
  %nm = call ptr @X509_get_subject_name(ptr %x)
  %t = call ptr @X509_NAME_oneline(ptr %nm, ptr %buf, i32 256)
  call void @X509_free(ptr %x)
  %nt = icmp eq ptr %t, null
  br i1 %nt, label %empty, label %givep
givep:
  %tl = call i64 @strlen(ptr %buf)
  %gp = call i64 @nz_tls_give(ptr %buf, i64 %tl, ptr %p, i64 %cap)
  ret i64 %gp
detail:
  %dp = getelementptr i8, ptr %e, i64 56
  %dl = call i64 @strlen(ptr %dp)
  %gd = call i64 @nz_tls_give(ptr %dp, i64 %dl, ptr %p, i64 %cap)
  ret i64 %gd
empty:
  ret i64 0
invalid:
  ret i64 -22
}
"#
}

pub fn rt_tls_SECTRUST() -> Str ! {} {
    r#"
@kCFTypeArrayCallBacks = external global i8
declare ptr @CFArrayCreateMutable(ptr, i64, ptr)
declare void @CFArrayAppendValue(ptr, ptr)
declare i64 @CFArrayGetCount(ptr)
declare ptr @CFDataCreate(ptr, ptr, i64)
declare ptr @CFStringCreateWithBytes(ptr, ptr, i64, i32, i8 zeroext)
declare void @CFRelease(ptr)
declare ptr @CFRetain(ptr)
declare i64 @CFErrorGetCode(ptr)
declare ptr @CFErrorCopyDescription(ptr)
declare zeroext i8 @CFStringGetCString(ptr, ptr, i64, i32)
declare ptr @SecCertificateCreateWithData(ptr, ptr)
declare ptr @SecPolicyCreateSSL(i8 zeroext, ptr)
declare i32 @SecTrustCreateWithCertificates(ptr, ptr, ptr)
declare i32 @SecTrustSetAnchorCertificates(ptr, ptr)
declare i32 @SecTrustSetAnchorCertificatesOnly(ptr, i8 zeroext)
declare i32 @SecTrustSetNetworkFetchAllowed(ptr, i8 zeroext)
declare zeroext i1 @SecTrustEvaluateWithError(ptr, ptr)
declare void @SSL_CTX_set_cert_verify_callback(ptr, ptr, ptr)
declare i32 @SSL_get_ex_data_X509_STORE_CTX_idx()
declare ptr @X509_STORE_CTX_get_ex_data(ptr, i32)
declare ptr @X509_STORE_CTX_get0_untrusted(ptr)
declare i32 @OPENSSL_sk_num(ptr)
declare ptr @OPENSSL_sk_value(ptr, i32)
declare i32 @i2d_X509(ptr, ptr)

; A certificate as the Security framework holds it, from its DER encoding; null if refused.
define hidden ptr @nz_tls_sec(ptr %x) {
entry:
  %n = call i32 @i2d_X509(ptr %x, ptr null)
  %pos = icmp sgt i32 %n, 0
  br i1 %pos, label %der, label %none
der:
  %n64 = sext i32 %n to i64
  %b = call ptr @malloc(i64 %n64)
  %nb = icmp eq ptr %b, null
  br i1 %nb, label %none, label %encode
encode:
  %q = alloca ptr, align 8
  store ptr %b, ptr %q
  %w = call i32 @i2d_X509(ptr %x, ptr %q)
  %d = call ptr @CFDataCreate(ptr null, ptr %b, i64 %n64)
  call void @free(ptr %b)
  %nd = icmp eq ptr %d, null
  br i1 %nd, label %none, label %cert
cert:
  %c = call ptr @SecCertificateCreateWithData(ptr null, ptr %d)
  call void @CFRelease(ptr %d)
  ret ptr %c
none:
  ret ptr null
}

; The verdict OpenSSL asks for: the chain the server sent, judged by SecTrust for the session's
; host. A refusal records its kind and the framework's sentence in the session.
define hidden i32 @nz_tls_verify(ptr %xs, ptr %arg) {
entry:
  %idx = call i32 @SSL_get_ex_data_X509_STORE_CTX_idx()
  %ssl = call ptr @X509_STORE_CTX_get_ex_data(ptr %xs, i32 %idx)
  %e = call ptr @SSL_get_ex_data(ptr %ssl, i32 0)
  %fp = getelementptr i8, ptr %e, i64 16
  store i64 -65601, ptr %fp
  %chain = call ptr @X509_STORE_CTX_get0_untrusted(ptr %xs)
  %nch = icmp eq ptr %chain, null
  br i1 %nch, label %refuse, label %count
count:
  %n = call i32 @OPENSSL_sk_num(ptr %chain)
  %certs = call ptr @CFArrayCreateMutable(ptr null, i64 0, ptr @kCFTypeArrayCallBacks)
  br label %each
each:
  %i = phi i32 [ 0, %count ], [ %i1, %added ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %one, label %judge
one:
  %x = call ptr @OPENSSL_sk_value(ptr %chain, i32 %i)
  %c = call ptr @nz_tls_sec(ptr %x)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %drop, label %add
add:
  call void @CFArrayAppendValue(ptr %certs, ptr %c)
  call void @CFRelease(ptr %c)
  br label %added
added:
  %i1 = add i32 %i, 1
  br label %each
judge:
  %some = icmp sgt i32 %n, 0
  br i1 %some, label %policy, label %drop
policy:
  %hp = getelementptr i8, ptr %e, i64 24
  %h = load ptr, ptr %hp
  %hnp = getelementptr i8, ptr %e, i64 32
  %hn = load i64, ptr %hnp
  ; kCFStringEncodingUTF8.
  %hs = call ptr @CFStringCreateWithBytes(ptr null, ptr %h, i64 %hn, i32 134217984, i8 zeroext 0)
  %pol = call ptr @SecPolicyCreateSSL(i8 zeroext 1, ptr %hs)
  %tp = alloca ptr, align 8
  store ptr null, ptr %tp
  %made = call i32 @SecTrustCreateWithCertificates(ptr %certs, ptr %pol, ptr %tp)
  %t = load ptr, ptr %tp
  %mok = icmp eq i32 %made, 0
  br i1 %mok, label %anchored, label %release
anchored:
  %ap = getelementptr i8, ptr %e, i64 8
  %a = load ptr, ptr %ap
  %na = icmp eq ptr %a, null
  br i1 %na, label %evaluate, label %only
only:
  %s1 = call i32 @SecTrustSetAnchorCertificates(ptr %t, ptr %a)
  %s2 = call i32 @SecTrustSetAnchorCertificatesOnly(ptr %t, i8 zeroext 1)
  br label %evaluate
evaluate:
  %s3 = call i32 @SecTrustSetNetworkFetchAllowed(ptr %t, i8 zeroext 0)
  %ep = alloca ptr, align 8
  store ptr null, ptr %ep
  %ok = call i1 @SecTrustEvaluateWithError(ptr %t, ptr %ep)
  br i1 %ok, label %trusted, label %why
trusted:
  store i64 0, ptr %fp
  br label %freet
why:
  %err = load ptr, ptr %ep
  %nerr = icmp eq ptr %err, null
  br i1 %nerr, label %freet, label %code
code:
  %k = call i64 @CFErrorGetCode(ptr %err)
  ; errSecCertificateExpired, errSecCertificateNotValidYet: a certificate out of its dates.
  %exp = icmp eq i64 %k, -67818
  %young = icmp eq i64 %k, -67819
  %dated = or i1 %exp, %young
  ; errSecHostNameMismatch: valid, but for another name.
  %host = icmp eq i64 %k, -67602
  %v1 = select i1 %host, i64 -65603, i64 -65601
  %v = select i1 %dated, i64 -65602, i64 %v1
  store i64 %v, ptr %fp
  %desc = call ptr @CFErrorCopyDescription(ptr %err)
  %nd = icmp eq ptr %desc, null
  br i1 %nd, label %freee, label %text
text:
  %dp = getelementptr i8, ptr %e, i64 56
  %gs = call i8 @CFStringGetCString(ptr %desc, ptr %dp, i64 200, i32 134217984)
  call void @CFRelease(ptr %desc)
  br label %freee
freee:
  call void @CFRelease(ptr %err)
  br label %freet
freet:
  call void @CFRelease(ptr %t)
  br label %release
release:
  call void @CFRelease(ptr %pol)
  call void @CFRelease(ptr %hs)
  br label %drop
drop:
  call void @CFRelease(ptr %certs)
  br label %refuse
refuse:
  %f = load i64, ptr %fp
  %good = icmp eq i64 %f, 0
  %r = zext i1 %good to i32
  ret i32 %r
}

; A client's trust: SecTrust as the verifier, and the anchors `a[0..n]` names, if any, kept in
; the configuration. 0, or 1 when `a` holds no certificate.
define hidden i32 @nz_tls_trust(ptr %c, ptr %x, ptr %a, i64 %n) {
entry:
  call void @SSL_CTX_set_cert_verify_callback(ptr %x, ptr @nz_tls_verify, ptr null)
  %none = icmp slt i64 %n, 1
  br i1 %none, label %ok, label %read
read:
  %arr = call ptr @CFArrayCreateMutable(ptr null, i64 0, ptr @kCFTypeArrayCallBacks)
  %anp = getelementptr i8, ptr %c, i64 16
  store ptr %arr, ptr %anp
  %n32 = trunc i64 %n to i32
  %b = call ptr @BIO_new_mem_buf(ptr %a, i32 %n32)
  br label %each
each:
  %x509 = call ptr @PEM_read_bio_X509(ptr %b, ptr null, ptr @nz_tls_nopass, ptr null)
  %end = icmp eq ptr %x509, null
  br i1 %end, label %counted, label %one
one:
  %s = call ptr @nz_tls_sec(ptr %x509)
  call void @X509_free(ptr %x509)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %each, label %keep
keep:
  call void @CFArrayAppendValue(ptr %arr, ptr %s)
  call void @CFRelease(ptr %s)
  br label %each
counted:
  %f = call i32 @BIO_free(ptr %b)
  call void @ERR_clear_error()
  %k = call i64 @CFArrayGetCount(ptr %arr)
  %empty = icmp eq i64 %k, 0
  br i1 %empty, label %bad, label %ok
ok:
  ret i32 0
bad:
  ret i32 1
}

; The session's own reference to its configuration's anchors (`to` from `from`).
define hidden void @nz_tls_anchor(ptr %to, ptr %from) {
entry:
  %a = load ptr, ptr %from
  %na = icmp eq ptr %a, null
  br i1 %na, label %done, label %keep
keep:
  %r = call ptr @CFRetain(ptr %a)
  store ptr %a, ptr %to
  br label %done
done:
  ret void
}

define hidden void @nz_tls_unanchor(ptr %at) {
entry:
  %a = load ptr, ptr %at
  %na = icmp eq ptr %a, null
  br i1 %na, label %done, label %drop
drop:
  call void @CFRelease(ptr %a)
  store ptr null, ptr %at
  br label %done
done:
  ret void
}

; SecTrust names the host itself.
define hidden void @nz_tls_name(ptr %s, ptr %h) {
entry:
  ret void
}

; The verifier's verdict, recorded in the session: 0 when it refused nothing.
define hidden i64 @nz_tls_verdict(ptr %e) {
entry:
  %fp = getelementptr i8, ptr %e, i64 16
  %f = load i64, ptr %fp
  ret i64 %f
}
"#
}

pub fn rt_tls_OPENSSL_TRUST() -> Str ! {} {
    r#"
declare i32 @SSL_CTX_set_default_verify_paths(ptr)
declare ptr @SSL_CTX_get_cert_store(ptr)
declare i32 @X509_STORE_add_cert(ptr, ptr)
declare i32 @SSL_set1_host(ptr, ptr)
declare i64 @SSL_get_verify_result(ptr)
declare ptr @X509_verify_cert_error_string(i64)

define hidden i32 @nz_tls_trust(ptr %c, ptr %x, ptr %a, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %system, label %read
system:
  %d = call i32 @SSL_CTX_set_default_verify_paths(ptr %x)
  ret i32 0
read:
  %store = call ptr @SSL_CTX_get_cert_store(ptr %x)
  %n32 = trunc i64 %n to i32
  %b = call ptr @BIO_new_mem_buf(ptr %a, i32 %n32)
  br label %each
each:
  %k = phi i64 [ 0, %read ], [ %k1, %one ]
  %x509 = call ptr @PEM_read_bio_X509(ptr %b, ptr null, ptr @nz_tls_nopass, ptr null)
  %end = icmp eq ptr %x509, null
  br i1 %end, label %counted, label %one
one:
  %r = call i32 @X509_STORE_add_cert(ptr %store, ptr %x509)
  call void @X509_free(ptr %x509)
  %k1 = add i64 %k, 1
  br label %each
counted:
  %f = call i32 @BIO_free(ptr %b)
  call void @ERR_clear_error()
  %empty = icmp eq i64 %k, 0
  %bad = zext i1 %empty to i32
  ret i32 %bad
}

define hidden void @nz_tls_anchor(ptr %to, ptr %from) {
entry:
  ret void
}

define hidden void @nz_tls_unanchor(ptr %at) {
entry:
  ret void
}

define hidden void @nz_tls_name(ptr %s, ptr %h) {
entry:
  %r = call i32 @SSL_set1_host(ptr %s, ptr %h)
  ret void
}

; OpenSSL's verdict: X509_V_ERR_CERT_NOT_YET_VALID (9) and _HAS_EXPIRED (10) are dates,
; _HOSTNAME_MISMATCH (62) and _IP_ADDRESS_MISMATCH (64) the name, any other an untrusted chain.
define hidden i64 @nz_tls_verdict(ptr %e) {
entry:
  %s = load ptr, ptr %e
  %v = call i64 @SSL_get_verify_result(ptr %s)
  %ok = icmp eq i64 %v, 0
  br i1 %ok, label %none, label %why
none:
  ret i64 0
why:
  %t = call ptr @X509_verify_cert_error_string(i64 %v)
  %tl = call i64 @strlen(ptr %t)
  %dp = getelementptr i8, ptr %e, i64 56
  %w = call i64 @nz_tls_give(ptr %t, i64 %tl, ptr %dp, i64 199)
  %young = icmp eq i64 %v, 9
  %old = icmp eq i64 %v, 10
  %dated = or i1 %young, %old
  %h1 = icmp eq i64 %v, 62
  %h2 = icmp eq i64 %v, 64
  %host = or i1 %h1, %h2
  %k1 = select i1 %host, i64 -65603, i64 -65601
  %k = select i1 %dated, i64 -65602, i64 %k1
  ret i64 %k
}
"#
}

pub fn rt_tls_SCHANNEL() -> Str ! {} {
    r#"
; The TLS engine (C1b): SChannel through SSPI, buffer in and buffer out. Generated by nazm build.
; Do not edit. A configuration is { refs, CredHandle[16], kind, anchors store, certificate, key
; name, ALPN buffer, its size, key handle, has credentials } (96 bytes); a session is
; { configuration, CtxtHandle[16], state, in[ptr,len,cap], out[ptr,len,cap],
; plain[ptr,start,len,cap], stream sizes[20], host, host length, failure, detail[96] } (256 bytes).
; State: 0 nothing sent, 1 handshaking, 2 established, 3 failed, 4 the peer closed.
declare ptr @calloc(i64, i64)
declare ptr @malloc(i64)
declare ptr @realloc(ptr, i64)
declare void @free(ptr)
declare i64 @strlen(ptr)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)
declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)
declare i32 @AcquireCredentialsHandleA(ptr, ptr, i32, ptr, ptr, ptr, ptr, ptr, ptr)
declare i32 @FreeCredentialsHandle(ptr)
declare i32 @InitializeSecurityContextA(ptr, ptr, ptr, i32, i32, i32, ptr, i32, ptr, ptr, ptr, ptr)
declare i32 @AcceptSecurityContext(ptr, ptr, ptr, i32, i32, ptr, ptr, ptr, ptr)
declare i32 @DeleteSecurityContext(ptr)
declare i32 @FreeContextBuffer(ptr)
declare i32 @QueryContextAttributesA(ptr, i32, ptr)
declare i32 @DecryptMessage(ptr, ptr, i32, ptr)
declare i32 @EncryptMessage(ptr, i32, ptr, i32)
declare i32 @ApplyControlToken(ptr, ptr)
declare ptr @CertOpenStore(ptr, i32, i64, i32, ptr)
declare i32 @CertCloseStore(ptr, i32)
declare i32 @CertAddEncodedCertificateToStore(ptr, i32, ptr, i32, i32, ptr)
declare ptr @CertCreateCertificateContext(i32, ptr, i32)
declare i32 @CertFreeCertificateContext(ptr)
declare i32 @CertSetCertificateContextProperty(ptr, i32, i32, ptr)
declare i32 @CertCreateCertificateChainEngine(ptr, ptr)
declare void @CertFreeCertificateChainEngine(ptr)
declare i32 @CertGetCertificateChain(ptr, ptr, ptr, ptr, ptr, i32, ptr, ptr)
declare void @CertFreeCertificateChain(ptr)
declare i32 @CertVerifyCertificateChainPolicy(ptr, ptr, ptr, ptr)
declare i32 @CertGetNameStringA(ptr, i32, i32, ptr, ptr, i32)
declare i32 @CryptStringToBinaryA(ptr, i32, i32, ptr, ptr, ptr, ptr)
declare i32 @NCryptOpenStorageProvider(ptr, ptr, i32)
declare i32 @NCryptImportKey(i64, i64, ptr, ptr, ptr, ptr, i32, i32)
declare i32 @NCryptDeleteKey(i64, i32)
declare i32 @NCryptFreeObject(i64)
declare i32 @MultiByteToWideChar(i32, i32, ptr, i32, ptr, i32)
declare i32 @GetCurrentProcessId()

; UNISP_NAME_A, the OIDs of server authentication and of a common name.
@nz_tls_unisp = private unnamed_addr constant [45 x i8] c"Microsoft Unified Security Protocol Provider\00"
@nz_tls_server_auth = private unnamed_addr constant [18 x i8] c"1.3.6.1.5.5.7.3.1\00"
@nz_tls_cn = private unnamed_addr constant [8 x i8] c"2.5.4.3\00"
; MS_KEY_STORAGE_PROVIDER and NCRYPT_PKCS8_PRIVATE_KEY_BLOB, as UTF-16.
@nz_tls_ksp = private unnamed_addr constant [40 x i16] [i16 77, i16 105, i16 99, i16 114, i16 111, i16 115, i16 111, i16 102, i16 116, i16 32, i16 83, i16 111, i16 102, i16 116, i16 119, i16 97, i16 114, i16 101, i16 32, i16 75, i16 101, i16 121, i16 32, i16 83, i16 116, i16 111, i16 114, i16 97, i16 103, i16 101, i16 32, i16 80, i16 114, i16 111, i16 118, i16 105, i16 100, i16 101, i16 114, i16 0], align 2
@nz_tls_pkcs8 = private unnamed_addr constant [17 x i16] [i16 80, i16 75, i16 67, i16 83, i16 56, i16 95, i16 80, i16 82, i16 73, i16 86, i16 65, i16 84, i16 69, i16 75, i16 69, i16 89, i16 0], align 2
@nz_tls_begin = private unnamed_addr constant [11 x i8] c"-----BEGIN "
@nz_tls_end = private unnamed_addr constant [8 x i8] c"-----END"
@nz_tls_dashes = private unnamed_addr constant [5 x i8] c"-----"
@nz_tls_certificate = private unnamed_addr constant [16 x i8] c"CERTIFICATE-----"
@nz_tls_private_key = private unnamed_addr constant [16 x i8] c"PRIVATE KEY-----"
@nz_tls_v12 = private unnamed_addr constant [8 x i8] c"TLSv1.2\00"
@nz_tls_v13 = private unnamed_addr constant [8 x i8] c"TLSv1.3\00"
@nz_tls_vtls = private unnamed_addr constant [4 x i8] c"TLS\00"
@nz_tls_slash_cn = private unnamed_addr constant [4 x i8] c"/CN="
@nz_tls_why_untrusted = private unnamed_addr constant [40 x i8] c"the certificate chain is not trusted\00\00\00\00"
@nz_tls_why_expired = private unnamed_addr constant [40 x i8] c"a certificate is outside its dates\00\00\00\00\00\00"
@nz_tls_why_host = private unnamed_addr constant [40 x i8] c"the certificate is for another name\00\00\00\00\00"
@nz_tls_why_protocol = private unnamed_addr constant [40 x i8] c"SChannel refused the TLS exchange\00\00\00\00\00\00\00"
@nz_tls_keys = hidden global i64 0

; Whether `p[0..n]` is ALPN's wire form (as the OpenSSL unit's).
define hidden i1 @nz_tls_alpn_ok(ptr %p, i64 %n) {
entry:
  %some = icmp sgt i64 %n, 0
  br i1 %some, label %loop, label %no
loop:
  %at = phi i64 [ 0, %entry ], [ %next, %more ]
  %lp = getelementptr i8, ptr %p, i64 %at
  %lb = load i8, ptr %lp
  %l = zext i8 %lb to i64
  %empty = icmp eq i64 %l, 0
  br i1 %empty, label %no, label %step
step:
  %after = add i64 %at, 1
  %next = add i64 %after, %l
  %over = icmp sgt i64 %next, %n
  br i1 %over, label %no, label %fits
fits:
  %end = icmp eq i64 %next, %n
  br i1 %end, label %yes, label %more
more:
  br label %loop
yes:
  ret i1 true
no:
  ret i1 false
}

; A copy of `p[0..n]`, NUL-terminated; null when memory is refused.
define hidden ptr @nz_tls_copy(ptr %p, i64 %n) {
entry:
  %m = add i64 %n, 1
  %c = call ptr @calloc(i64 %m, i64 1)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %out, label %fill
fill:
  call void @llvm.memcpy.p0.p0.i64(ptr %c, ptr %p, i64 %n, i1 false)
  br label %out
out:
  ret ptr %c
}

; `n` bytes of `src` into `p`, at most `cap`: how many.
define hidden i64 @nz_tls_give(ptr %src, i64 %n, ptr %p, i64 %cap) {
entry:
  %fits = icmp slt i64 %n, %cap
  %m = select i1 %fits, i64 %n, i64 %cap
  %pos = icmp sgt i64 %m, 0
  br i1 %pos, label %copy, label %none
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %src, i64 %m, i1 false)
  ret i64 %m
none:
  ret i64 0
}

; `d[0..n]` appended to the growable buffer `{ ptr, len, cap }` at `b`: false when memory is refused.
define hidden i1 @nz_tls_append(ptr %b, ptr %d, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %ok, label %go
go:
  %lp = getelementptr i8, ptr %b, i64 8
  %cp = getelementptr i8, ptr %b, i64 16
  %len = load i64, ptr %lp
  %cap = load i64, ptr %cp
  %need = add i64 %len, %n
  %fits = icmp sle i64 %need, %cap
  br i1 %fits, label %copy, label %grow
grow:
  %twice = shl i64 %cap, 1
  %more = icmp sgt i64 %twice, %need
  %c0 = select i1 %more, i64 %twice, i64 %need
  %small = icmp slt i64 %c0, 4096
  %c1 = select i1 %small, i64 4096, i64 %c0
  %old = load ptr, ptr %b
  %new = call ptr @realloc(ptr %old, i64 %c1)
  %nn = icmp eq ptr %new, null
  br i1 %nn, label %fail, label %keep
keep:
  store ptr %new, ptr %b
  store i64 %c1, ptr %cp
  br label %copy
copy:
  %base = load ptr, ptr %b
  %at = getelementptr i8, ptr %base, i64 %len
  call void @llvm.memcpy.p0.p0.i64(ptr %at, ptr %d, i64 %n, i1 false)
  store i64 %need, ptr %lp
  br label %ok
ok:
  ret i1 true
fail:
  ret i1 false
}

; The first `n` bytes of the buffer at `b` taken away; what follows moves to its start.
define hidden void @nz_tls_drop(ptr %b, i64 %n) {
entry:
  %lp = getelementptr i8, ptr %b, i64 8
  %len = load i64, ptr %lp
  %rest = sub i64 %len, %n
  %base = load ptr, ptr %b
  %from = getelementptr i8, ptr %base, i64 %n
  %some = icmp sgt i64 %rest, 0
  br i1 %some, label %move, label %done
move:
  call void @llvm.memmove.p0.p0.i64(ptr %base, ptr %from, i64 %rest, i1 false)
  br label %done
done:
  %left = select i1 %some, i64 %rest, i64 0
  store i64 %left, ptr %lp
  ret void
}

; Where `needle[0..m]` first is in `h[from..n]`, or -1.
define hidden i64 @nz_tls_find(ptr %h, i64 %n, i64 %from, ptr %needle, i64 %m) {
entry:
  br label %loop
loop:
  %i = phi i64 [ %from, %entry ], [ %i1, %next ]
  %end = add i64 %i, %m
  %past = icmp sgt i64 %end, %n
  br i1 %past, label %none, label %look
look:
  %at = getelementptr i8, ptr %h, i64 %i
  %c = call i32 @memcmp(ptr %at, ptr %needle, i64 %m)
  %same = icmp eq i32 %c, 0
  br i1 %same, label %found, label %next
next:
  %i1 = add i64 %i, 1
  br label %loop
found:
  ret i64 %i
none:
  ret i64 -1
}
declare i32 @memcmp(ptr, ptr, i64)

; The next PEM block labelled `label` (16 bytes, `NAME-----`) in `p[*at..n]`, as DER in memory of its
; own (its length into `len`), `*at` moved past it; null when there is none or it does not decode.
define hidden ptr @nz_tls_pem(ptr %p, i64 %n, ptr %atp, ptr %label, ptr %len) {
entry:
  %size = alloca i32, align 4
  %from = load i64, ptr %atp
  br label %seek
seek:
  %f = phi i64 [ %from, %entry ], [ %past, %other ]
  %b = call i64 @nz_tls_find(ptr %p, i64 %n, i64 %f, ptr @nz_tls_begin, i64 11)
  %nob = icmp slt i64 %b, 0
  br i1 %nob, label %none, label %label_at
label_at:
  %lab = add i64 %b, 11
  %labend = add i64 %lab, 16
  %short = icmp sgt i64 %labend, %n
  br i1 %short, label %none, label %compare
compare:
  %lp = getelementptr i8, ptr %p, i64 %lab
  %c = call i32 @memcmp(ptr %lp, ptr %label, i64 16)
  %e = call i64 @nz_tls_find(ptr %p, i64 %n, i64 %labend, ptr @nz_tls_end, i64 8)
  %noe = icmp slt i64 %e, 0
  br i1 %noe, label %none, label %close
close:
  %e8 = add i64 %e, 8
  %d = call i64 @nz_tls_find(ptr %p, i64 %n, i64 %e8, ptr @nz_tls_dashes, i64 5)
  %nod = icmp slt i64 %d, 0
  br i1 %nod, label %none, label %ends
ends:
  %past = add i64 %d, 5
  store i64 %past, ptr %atp
  %mine = icmp eq i32 %c, 0
  br i1 %mine, label %decode, label %other
other:
  br label %seek
decode:
  %bp = getelementptr i8, ptr %p, i64 %b
  %bl = sub i64 %past, %b
  %bl32 = trunc i64 %bl to i32
  store i32 0, ptr %size
  ; CRYPT_STRING_BASE64HEADER: the block with its BEGIN and END lines.
  %r1 = call i32 @CryptStringToBinaryA(ptr %bp, i32 %bl32, i32 0, ptr null, ptr %size, ptr null, ptr null)
  %s = load i32, ptr %size
  %ok1 = icmp ne i32 %r1, 0
  %pos = icmp ugt i32 %s, 0
  %ok = and i1 %ok1, %pos
  br i1 %ok, label %alloc, label %none
alloc:
  %s64 = zext i32 %s to i64
  %der = call ptr @malloc(i64 %s64)
  %nd = icmp eq ptr %der, null
  br i1 %nd, label %none, label %fill
fill:
  %r2 = call i32 @CryptStringToBinaryA(ptr %bp, i32 %bl32, i32 0, ptr %der, ptr %size, ptr null, ptr null)
  %got = load i32, ptr %size
  %got64 = zext i32 %got to i64
  store i64 %got64, ptr %len
  %ok2 = icmp ne i32 %r2, 0
  br i1 %ok2, label %done, label %bad
bad:
  call void @free(ptr %der)
  br label %none
done:
  ret ptr %der
none:
  ret ptr null
}

; Credentials for configuration `c`: SCHANNEL_CRED for TLS 1.2, a server's with its certificate,
; a client's verified by this unit (SCH_CRED_MANUAL_CRED_VALIDATION, SCH_CRED_NO_DEFAULT_CREDS).
; 0, or SSPI's status.
define hidden i32 @nz_tls_credentials(ptr %c) {
entry:
  %sc = alloca [80 x i8], align 8
  %certs = alloca ptr, align 8
  %expiry = alloca i64, align 8
  call void @llvm.memset.p0.i64(ptr %sc, i8 0, i64 80, i1 false)
  ; SCHANNEL_CRED_VERSION.
  store i32 4, ptr %sc
  %kp = getelementptr i8, ptr %c, i64 24
  %kind = load i64, ptr %kp
  %client = icmp eq i64 %kind, 1
  %protop = getelementptr i8, ptr %sc, i64 56
  %flagsp = getelementptr i8, ptr %sc, i64 72
  br i1 %client, label %outbound, label %inbound
outbound:
  store i32 2048, ptr %protop
  store i32 24, ptr %flagsp
  br label %acquire
inbound:
  store i32 1024, ptr %protop
  %certp = getelementptr i8, ptr %c, i64 40
  %cert = load ptr, ptr %certp
  store ptr %cert, ptr %certs
  %ccp = getelementptr i8, ptr %sc, i64 4
  store i32 1, ptr %ccp
  %pacp = getelementptr i8, ptr %sc, i64 8
  store ptr %certs, ptr %pacp
  br label %acquire
acquire:
  ; SECPKG_CRED_OUTBOUND (2) for a client, SECPKG_CRED_INBOUND (1) for a server.
  %use = select i1 %client, i32 2, i32 1
  %cred = getelementptr i8, ptr %c, i64 8
  %r = call i32 @AcquireCredentialsHandleA(ptr null, ptr @nz_tls_unisp, i32 %use, ptr null, ptr %sc, ptr null, ptr null, ptr %cred, ptr %expiry)
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %have, label %done
have:
  %hp = getelementptr i8, ptr %c, i64 80
  store i64 1, ptr %hp
  br label %done
done:
  ret i32 %r
}
declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)

; A server's key, PKCS #8 DER, imported under a name of its own into the user's key storage
; provider — SChannel cannot use a key that is not persisted — and named on its certificate. 0,
; or nonzero when anything is refused. The key is deleted when the configuration goes.
define hidden i32 @nz_tls_key(ptr %c, ptr %der, i64 %n) {
entry:
  %prov = alloca i64, align 8
  %key = alloca i64, align 8
  %buf = alloca [16 x i8], align 8
  %desc = alloca [16 x i8], align 8
  %kpi = alloca [48 x i8], align 8
  store i64 0, ptr %prov
  store i64 0, ptr %key
  ; The key's name: `nazm-tls-`, the process's id and a counter, as UTF-16, 64 units.
  %name = call ptr @calloc(i64 64, i64 2)
  %nn = icmp eq ptr %name, null
  br i1 %nn, label %fail, label %named
named:
  %np = getelementptr i8, ptr %c, i64 48
  store ptr %name, ptr %np
  %pid = call i32 @GetCurrentProcessId()
  %pid64 = zext i32 %pid to i64
  %count = atomicrmw add ptr @nz_tls_keys, i64 1 seq_cst
  %hi = shl i64 %pid64, 24
  %mix = or i64 %hi, %count
  ; `nazm-tls-`
  store i16 110, ptr %name
  %n1 = getelementptr i16, ptr %name, i64 1
  store i16 97, ptr %n1
  %n2 = getelementptr i16, ptr %name, i64 2
  store i16 122, ptr %n2
  %n3 = getelementptr i16, ptr %name, i64 3
  store i16 109, ptr %n3
  %n4 = getelementptr i16, ptr %name, i64 4
  store i16 45, ptr %n4
  %n5 = getelementptr i16, ptr %name, i64 5
  store i16 116, ptr %n5
  %n6 = getelementptr i16, ptr %name, i64 6
  store i16 108, ptr %n6
  %n7 = getelementptr i16, ptr %name, i64 7
  store i16 115, ptr %n7
  %n8 = getelementptr i16, ptr %name, i64 8
  store i16 45, ptr %n8
  br label %hex
hex:
  %i = phi i64 [ 0, %named ], [ %i1, %hex ]
  %shift = sub i64 60, %i
  %nib0 = lshr i64 %mix, %shift
  %nib = and i64 %nib0, 15
  %letter = icmp ugt i64 %nib, 9
  %base = select i1 %letter, i64 87, i64 48
  %ch = add i64 %nib, %base
  %ch16 = trunc i64 %ch to i16
  %slot = add i64 %i, 36
  %pos = udiv i64 %slot, 4
  %cp = getelementptr i16, ptr %name, i64 %pos
  store i16 %ch16, ptr %cp
  %i1 = add i64 %i, 4
  %more = icmp ult i64 %i1, 64
  br i1 %more, label %hex, label %open
open:
  %o = call i32 @NCryptOpenStorageProvider(ptr %prov, ptr @nz_tls_ksp, i32 0)
  %ook = icmp eq i32 %o, 0
  br i1 %ook, label %import, label %fail
import:
  ; NCRYPTBUFFER_PKCS_KEY_NAME: 25 UTF-16 units and their NUL.
  store i32 52, ptr %buf
  %bt = getelementptr i8, ptr %buf, i64 4
  store i32 45, ptr %bt
  %bv = getelementptr i8, ptr %buf, i64 8
  store ptr %name, ptr %bv
  store i32 0, ptr %desc
  %dc = getelementptr i8, ptr %desc, i64 4
  store i32 1, ptr %dc
  %db = getelementptr i8, ptr %desc, i64 8
  store ptr %buf, ptr %db
  %pv = load i64, ptr %prov
  %n32 = trunc i64 %n to i32
  ; NCRYPT_OVERWRITE_KEY_FLAG.
  %im = call i32 @NCryptImportKey(i64 %pv, i64 0, ptr @nz_tls_pkcs8, ptr %desc, ptr %key, ptr %der, i32 %n32, i32 128)
  %fo = call i32 @NCryptFreeObject(i64 %pv)
  %iok = icmp eq i32 %im, 0
  br i1 %iok, label %link, label %fail
link:
  %kv = load i64, ptr %key
  %khp = getelementptr i8, ptr %c, i64 72
  store i64 %kv, ptr %khp
  call void @llvm.memset.p0.i64(ptr %kpi, i8 0, i64 48, i1 false)
  store ptr %name, ptr %kpi
  %kpn = getelementptr i8, ptr %kpi, i64 8
  store ptr @nz_tls_ksp, ptr %kpn
  %certp = getelementptr i8, ptr %c, i64 40
  %cert = load ptr, ptr %certp
  ; CERT_KEY_PROV_INFO_PROP_ID.
  %set = call i32 @CertSetCertificateContextProperty(ptr %cert, i32 2, i32 0, ptr %kpi)
  %sok = icmp ne i32 %set, 0
  br i1 %sok, label %done, label %fail
done:
  ret i32 0
fail:
  ret i32 1
}

; A configuration of `kind` (1 a client's: `a` its anchors, PEM, none for the system's store; 2 a
; server's: `a` its certificate, `b` its key, PKCS #8 PEM), offering the ALPN names `p`. Null with
; the status in `st` when anything is refused.
define hidden ptr @nz_tls_config(i64 %kind, ptr %a, i64 %an, ptr %b, i64 %bn, ptr %p, i64 %pn, ptr %st) {
entry:
  %at = alloca i64, align 8
  %len = alloca i64, align 8
  %has = icmp sgt i64 %pn, 0
  br i1 %has, label %check, label %sizes
check:
  %good = call i1 @nz_tls_alpn_ok(ptr %p, i64 %pn)
  br i1 %good, label %sizes, label %invalid
sizes:
  %big = icmp sgt i64 %an, 1073741824
  %big2 = icmp sgt i64 %bn, 1073741824
  %big3 = icmp sgt i64 %pn, 65535
  %b12 = or i1 %big, %big2
  %toobig = or i1 %b12, %big3
  br i1 %toobig, label %invalid, label %make
make:
  %c = call ptr @calloc(i64 1, i64 96)
  %nc = icmp eq ptr %c, null
  br i1 %nc, label %nomem, label %set
set:
  store i64 1, ptr %c
  %kp = getelementptr i8, ptr %c, i64 24
  store i64 %kind, ptr %kp
  br i1 %has, label %alpn, label %side
alpn:
  ; SEC_APPLICATION_PROTOCOLS: its lists' size, ALPN's extension (2), the list's size, the list.
  %size = add i64 %pn, 10
  %ab = call ptr @calloc(i64 %size, i64 1)
  %nab = icmp eq ptr %ab, null
  br i1 %nab, label %nomem1, label %fill
fill:
  %lists = add i64 %pn, 6
  %l32 = trunc i64 %lists to i32
  store i32 %l32, ptr %ab
  %ext = getelementptr i8, ptr %ab, i64 4
  store i32 2, ptr %ext
  %ls = getelementptr i8, ptr %ab, i64 8
  %pn16 = trunc i64 %pn to i16
  store i16 %pn16, ptr %ls, align 1
  %list = getelementptr i8, ptr %ab, i64 10
  call void @llvm.memcpy.p0.p0.i64(ptr %list, ptr %p, i64 %pn, i1 false)
  %abp = getelementptr i8, ptr %c, i64 56
  store ptr %ab, ptr %abp
  %abn = getelementptr i8, ptr %c, i64 64
  store i64 %size, ptr %abn
  br label %side
side:
  store i64 0, ptr %at
  %client = icmp eq i64 %kind, 1
  br i1 %client, label %anchors, label %identity
anchors:
  %none = icmp slt i64 %an, 1
  br i1 %none, label %credentials, label %store
store:
  ; CERT_STORE_PROV_MEMORY.
  %s = call ptr @CertOpenStore(ptr inttoptr (i64 2 to ptr), i32 0, i64 0, i32 0, ptr null)
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %bad, label %kept
kept:
  %sp = getelementptr i8, ptr %c, i64 32
  store ptr %s, ptr %sp
  br label %each
each:
  %k = phi i64 [ 0, %kept ], [ %k1, %added ]
  %der = call ptr @nz_tls_pem(ptr %a, i64 %an, ptr %at, ptr @nz_tls_certificate, ptr %len)
  %end = icmp eq ptr %der, null
  br i1 %end, label %counted, label %add
add:
  %dl = load i64, ptr %len
  %dl32 = trunc i64 %dl to i32
  ; X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, CERT_STORE_ADD_ALWAYS.
  %r = call i32 @CertAddEncodedCertificateToStore(ptr %s, i32 65537, ptr %der, i32 %dl32, i32 4, ptr null)
  call void @free(ptr %der)
  %one = icmp ne i32 %r, 0
  %inc = zext i1 %one to i64
  %k1 = add i64 %k, %inc
  br label %added
added:
  br label %each
counted:
  %zero = icmp eq i64 %k, 0
  br i1 %zero, label %bad, label %credentials
identity:
  %cder = call ptr @nz_tls_pem(ptr %a, i64 %an, ptr %at, ptr @nz_tls_certificate, ptr %len)
  %ncd = icmp eq ptr %cder, null
  br i1 %ncd, label %bad, label %context
context:
  %cl = load i64, ptr %len
  %cl32 = trunc i64 %cl to i32
  %ctx = call ptr @CertCreateCertificateContext(i32 65537, ptr %cder, i32 %cl32)
  call void @free(ptr %cder)
  %nctx = icmp eq ptr %ctx, null
  br i1 %nctx, label %bad, label %cert
cert:
  %certp = getelementptr i8, ptr %c, i64 40
  store ptr %ctx, ptr %certp
  store i64 0, ptr %at
  %kder = call ptr @nz_tls_pem(ptr %b, i64 %bn, ptr %at, ptr @nz_tls_private_key, ptr %len)
  %nkd = icmp eq ptr %kder, null
  br i1 %nkd, label %bad, label %key
key:
  %kl = load i64, ptr %len
  %kr = call i32 @nz_tls_key(ptr %c, ptr %kder, i64 %kl)
  call void @free(ptr %kder)
  %kok = icmp eq i32 %kr, 0
  br i1 %kok, label %credentials, label %bad
credentials:
  %cr = call i32 @nz_tls_credentials(ptr %c)
  %crok = icmp eq i32 %cr, 0
  br i1 %crok, label %done, label %refused
done:
  ret ptr %c
refused:
  ; A client whose credentials SSPI refuses meets a protocol failure; a server's, a key or
  ; certificate it cannot use.
  call void @nz_tls_config_free(ptr %c)
  %why = select i1 %client, i64 -65604, i64 -65605
  store i64 %why, ptr %st
  ret ptr null
bad:
  call void @nz_tls_config_free(ptr %c)
  store i64 -65605, ptr %st
  ret ptr null
nomem1:
  call void @free(ptr %c)
  br label %nomem
nomem:
  store i64 -12, ptr %st
  ret ptr null
invalid:
  store i64 -22, ptr %st
  ret ptr null
}

; One reference fewer to configuration `c`; the last frees its credentials, store, certificate
; and key (the persisted key deleted).
define hidden void @nz_tls_config_free(ptr %c) {
entry:
  %old = atomicrmw sub ptr %c, i64 1 acq_rel
  %last = icmp eq i64 %old, 1
  br i1 %last, label %free, label %done
free:
  %hp = getelementptr i8, ptr %c, i64 80
  %h = load i64, ptr %hp
  %has = icmp ne i64 %h, 0
  br i1 %has, label %cred, label %store
cred:
  %cr = getelementptr i8, ptr %c, i64 8
  %f = call i32 @FreeCredentialsHandle(ptr %cr)
  br label %store
store:
  %sp = getelementptr i8, ptr %c, i64 32
  %s = load ptr, ptr %sp
  %ns = icmp eq ptr %s, null
  br i1 %ns, label %cert, label %close
close:
  %cs = call i32 @CertCloseStore(ptr %s, i32 0)
  br label %cert
cert:
  %kp = getelementptr i8, ptr %c, i64 72
  %k = load i64, ptr %kp
  %hk = icmp ne i64 %k, 0
  br i1 %hk, label %delete, label %context
delete:
  %dk = call i32 @NCryptDeleteKey(i64 %k, i32 0)
  br label %context
context:
  %ctp = getelementptr i8, ptr %c, i64 40
  %ct = load ptr, ptr %ctp
  %nct = icmp eq ptr %ct, null
  br i1 %nct, label %rest, label %fc
fc:
  %fcc = call i32 @CertFreeCertificateContext(ptr %ct)
  br label %rest
rest:
  %np = getelementptr i8, ptr %c, i64 48
  %n = load ptr, ptr %np
  call void @free(ptr %n)
  %ap = getelementptr i8, ptr %c, i64 56
  %a = load ptr, ptr %ap
  call void @free(ptr %a)
  call void @free(ptr %c)
  br label %done
done:
  ret void
}

; A session of configuration `c`: a client's verifying `h[0..n]`. Null with the status in `st`.
define hidden ptr @nz_tls_session(ptr %c, ptr %h, i64 %n, ptr %st) {
entry:
  %kp = getelementptr i8, ptr %c, i64 24
  %kind = load i64, ptr %kp
  %client = icmp eq i64 %kind, 1
  br i1 %client, label %name, label %make
name:
  %empty = icmp slt i64 %n, 1
  %long = icmp sgt i64 %n, 253
  %bad = or i1 %empty, %long
  br i1 %bad, label %invalid, label %scan
scan:
  %i = phi i64 [ 0, %name ], [ %i1, %step ]
  %done = icmp eq i64 %i, %n
  br i1 %done, label %make, label %look
look:
  %bp = getelementptr i8, ptr %h, i64 %i
  %b = load i8, ptr %bp
  %z = icmp eq i8 %b, 0
  br i1 %z, label %invalid, label %step
step:
  %i1 = add i64 %i, 1
  br label %scan
make:
  %e = call ptr @calloc(i64 1, i64 256)
  %ne = icmp eq ptr %e, null
  br i1 %ne, label %nomem, label %hold
hold:
  %r = atomicrmw add ptr %c, i64 1 acq_rel
  store ptr %c, ptr %e
  br i1 %client, label %host, label %ok
host:
  %hc = call ptr @nz_tls_copy(ptr %h, i64 %n)
  %nhc = icmp eq ptr %hc, null
  br i1 %nhc, label %nomem1, label %named
named:
  %hp = getelementptr i8, ptr %e, i64 136
  store ptr %hc, ptr %hp
  %hn = getelementptr i8, ptr %e, i64 144
  store i64 %n, ptr %hn
  br label %ok
ok:
  ret ptr %e
nomem1:
  %z1 = call i64 @nz_tls_close(ptr %e, ptr null, i64 0)
  br label %nomem
nomem:
  store i64 -12, ptr %st
  ret ptr null
invalid:
  store i64 -22, ptr %st
  ret ptr null
}

; The session failed with `why` (a status) and the sentence `text`: it is over.
define hidden i64 @nz_tls_fail(ptr %e, i64 %why, ptr %text) {
entry:
  %sp = getelementptr i8, ptr %e, i64 24
  store i64 3, ptr %sp
  %fp = getelementptr i8, ptr %e, i64 152
  store i64 %why, ptr %fp
  %dp = getelementptr i8, ptr %e, i64 160
  call void @llvm.memcpy.p0.p0.i64(ptr %dp, ptr %text, i64 40, i1 false)
  ret i64 %why
}

; The server's chain judged for the session's host: CertGetCertificateChain against the user's
; roots, or an engine whose only roots are the configuration's anchors, with no URL fetched; then
; CertVerifyCertificateChainPolicy's SSL policy. 0, or the status of the refusal.
define hidden i64 @nz_tls_verify(ptr %e) {
entry:
  %certp = alloca ptr, align 8
  %enginep = alloca ptr, align 8
  %chainp = alloca ptr, align 8
  %ecfg = alloca [88 x i8], align 8
  %para = alloca [32 x i8], align 8
  %oids = alloca ptr, align 8
  %wide = alloca [512 x i8], align 2
  %extra = alloca [24 x i8], align 8
  %pp = alloca [16 x i8], align 8
  %ps = alloca [24 x i8], align 8
  store ptr null, ptr %certp
  store ptr null, ptr %enginep
  store ptr null, ptr %chainp
  %ctx = getelementptr i8, ptr %e, i64 8
  ; SECPKG_ATTR_REMOTE_CERT_CONTEXT.
  %q = call i32 @QueryContextAttributesA(ptr %ctx, i32 83, ptr %certp)
  %cert = load ptr, ptr %certp
  %qok = icmp eq i32 %q, 0
  %nn = icmp ne ptr %cert, null
  %have = and i1 %qok, %nn
  br i1 %have, label %engine, label %untrusted
engine:
  %c = load ptr, ptr %e
  %ap = getelementptr i8, ptr %c, i64 32
  %anchors = load ptr, ptr %ap
  %own = icmp ne ptr %anchors, null
  br i1 %own, label %exclusive, label %chain
exclusive:
  call void @llvm.memset.p0.i64(ptr %ecfg, i8 0, i64 88, i1 false)
  store i32 88, ptr %ecfg
  %xr = getelementptr i8, ptr %ecfg, i64 64
  store ptr %anchors, ptr %xr
  %made = call i32 @CertCreateCertificateChainEngine(ptr %ecfg, ptr %enginep)
  %mok = icmp ne i32 %made, 0
  br i1 %mok, label %chain, label %free_cert
chain:
  call void @llvm.memset.p0.i64(ptr %para, i8 0, i64 32, i1 false)
  store i32 32, ptr %para
  store ptr @nz_tls_server_auth, ptr %oids
  %uc = getelementptr i8, ptr %para, i64 16
  store i32 1, ptr %uc
  %ur = getelementptr i8, ptr %para, i64 24
  store ptr %oids, ptr %ur
  %eng = load ptr, ptr %enginep
  %sp = getelementptr i8, ptr %cert, i64 32
  %store = load ptr, ptr %sp
  ; CERT_CHAIN_CACHE_ONLY_URL_RETRIEVAL: nothing fetched over the network.
  %got = call i32 @CertGetCertificateChain(ptr %eng, ptr %cert, ptr null, ptr %store, ptr %para, i32 4, ptr null, ptr %chainp)
  %gok = icmp ne i32 %got, 0
  br i1 %gok, label %policy, label %free_engine
policy:
  %hp = getelementptr i8, ptr %e, i64 136
  %host = load ptr, ptr %hp
  ; CP_UTF8.
  %w = call i32 @MultiByteToWideChar(i32 65001, i32 0, ptr %host, i32 -1, ptr %wide, i32 256)
  call void @llvm.memset.p0.i64(ptr %extra, i8 0, i64 24, i1 false)
  store i32 24, ptr %extra
  %at = getelementptr i8, ptr %extra, i64 4
  ; AUTHTYPE_SERVER.
  store i32 2, ptr %at
  %sn = getelementptr i8, ptr %extra, i64 16
  store ptr %wide, ptr %sn
  call void @llvm.memset.p0.i64(ptr %pp, i8 0, i64 16, i1 false)
  store i32 16, ptr %pp
  %px = getelementptr i8, ptr %pp, i64 8
  store ptr %extra, ptr %px
  call void @llvm.memset.p0.i64(ptr %ps, i8 0, i64 24, i1 false)
  store i32 24, ptr %ps
  %ch = load ptr, ptr %chainp
  ; CERT_CHAIN_POLICY_SSL.
  %v = call i32 @CertVerifyCertificateChainPolicy(ptr inttoptr (i64 4 to ptr), ptr %ch, ptr %pp, ptr %ps)
  %erp = getelementptr i8, ptr %ps, i64 4
  %err = load i32, ptr %erp
  call void @CertFreeCertificateChain(ptr %ch)
  %vok = icmp ne i32 %v, 0
  br i1 %vok, label %judge, label %free_engine
judge:
  %clean = icmp eq i32 %err, 0
  ; CERT_E_EXPIRED, CERT_E_VALIDITYPERIODNESTING; CERT_E_CN_NO_MATCH.
  %exp = icmp eq i32 %err, -2146762495
  %nest = icmp eq i32 %err, -2146762494
  %dated = or i1 %exp, %nest
  %name = icmp eq i32 %err, -2146762481
  %k1 = select i1 %name, i64 -65603, i64 -65601
  %k2 = select i1 %dated, i64 -65602, i64 %k1
  %verdict = select i1 %clean, i64 0, i64 %k2
  br label %free_engine
free_engine:
  %result = phi i64 [ -65601, %chain ], [ -65601, %policy ], [ %verdict, %judge ]
  %eg = load ptr, ptr %enginep
  %ne = icmp eq ptr %eg, null
  br i1 %ne, label %free_cert2, label %drop_engine
drop_engine:
  call void @CertFreeCertificateChainEngine(ptr %eg)
  br label %free_cert2
free_cert2:
  %fc2 = call i32 @CertFreeCertificateContext(ptr %cert)
  ret i64 %result
free_cert:
  %fc = call i32 @CertFreeCertificateContext(ptr %cert)
  br label %untrusted
untrusted:
  ret i64 -65601
}

; SSPI's output tokens in `out` (a SecBuffer array of two, the token and the alert) appended to
; the session's ciphertext to send, and freed.
define hidden void @nz_tls_emit(ptr %e, ptr %out) {
entry:
  br label %each
each:
  %i = phi i64 [ 0, %entry ], [ %i1, %next ]
  %b = getelementptr [16 x i8], ptr %out, i64 %i
  %cb = load i32, ptr %b
  %pvp = getelementptr i8, ptr %b, i64 8
  %pv = load ptr, ptr %pvp
  %some = icmp ne ptr %pv, null
  br i1 %some, label %send, label %next
send:
  %pos = icmp ugt i32 %cb, 0
  br i1 %pos, label %append, label %release
append:
  %n = zext i32 %cb to i64
  %ob = getelementptr i8, ptr %e, i64 56
  %ok = call i1 @nz_tls_append(ptr %ob, ptr %pv, i64 %n)
  br label %release
release:
  %f = call i32 @FreeContextBuffer(ptr %pv)
  store ptr null, ptr %pvp
  br label %next
next:
  %i1 = add i64 %i, 1
  %more = icmp ult i64 %i1, 2
  br i1 %more, label %each, label %done
done:
  ret void
}

; One step of SSPI's handshake: InitializeSecurityContextA for a client, AcceptSecurityContext for a
; server, over what has been pushed. 1 once established, the wait for more ciphertext, or a status.
define hidden i64 @nz_tls_handshake(ptr %e) {
entry:
  %inb = alloca [48 x i8], align 8
  %ind = alloca [16 x i8], align 8
  %outb = alloca [32 x i8], align 8
  %outd = alloca [16 x i8], align 8
  %attr = alloca i32, align 4
  %sp = getelementptr i8, ptr %e, i64 24
  br label %step
step:
  %state = load i64, ptr %sp
  %up = icmp eq i64 %state, 2
  br i1 %up, label %established, label %live
live:
  %over = icmp sgt i64 %state, 2
  br i1 %over, label %finished, label %which
which:
  %c = load ptr, ptr %e
  %kp = getelementptr i8, ptr %c, i64 24
  %kind = load i64, ptr %kp
  %client = icmp eq i64 %kind, 1
  %first = icmp eq i64 %state, 0
  %inp = getelementptr i8, ptr %e, i64 32
  %in = load ptr, ptr %inp
  %inlp = getelementptr i8, ptr %e, i64 40
  %inl = load i64, ptr %inlp
  %nothing = icmp eq i64 %inl, 0
  %opens = and i1 %client, %first
  %starve = xor i1 %opens, true
  %wait = and i1 %starve, %nothing
  br i1 %wait, label %want, label %buffers
buffers:
  ; Input: the ciphertext as a token, an empty buffer for SSPI's extra, and on a first call the
  ; ALPN names. Output: a token and an alert, each SSPI's memory.
  call void @llvm.memset.p0.i64(ptr %inb, i8 0, i64 48, i1 false)
  %in32 = trunc i64 %inl to i32
  store i32 %in32, ptr %inb
  %t0 = getelementptr i8, ptr %inb, i64 4
  store i32 2, ptr %t0
  %p0 = getelementptr i8, ptr %inb, i64 8
  store ptr %in, ptr %p0
  %abp = getelementptr i8, ptr %c, i64 56
  %ab = load ptr, ptr %abp
  %hasab = icmp ne ptr %ab, null
  %offer = and i1 %hasab, %first
  br i1 %offer, label %alpn, label %described
alpn:
  %abnp = getelementptr i8, ptr %c, i64 64
  %abn = load i64, ptr %abnp
  %abn32 = trunc i64 %abn to i32
  %b2 = getelementptr i8, ptr %inb, i64 32
  store i32 %abn32, ptr %b2
  %t2 = getelementptr i8, ptr %inb, i64 36
  ; SECBUFFER_APPLICATION_PROTOCOLS.
  store i32 18, ptr %t2
  %p2 = getelementptr i8, ptr %inb, i64 40
  store ptr %ab, ptr %p2
  br label %described
described:
  %count = select i1 %offer, i32 3, i32 2
  %only = select i1 %offer, i32 1, i32 0
  %n_in = select i1 %opens, i32 %only, i32 %count
  %alpnbuf = getelementptr i8, ptr %inb, i64 32
  %bufs_in = select i1 %opens, ptr %alpnbuf, ptr %inb
  store i32 0, ptr %ind
  %ic = getelementptr i8, ptr %ind, i64 4
  store i32 %n_in, ptr %ic
  %ibp = getelementptr i8, ptr %ind, i64 8
  store ptr %bufs_in, ptr %ibp
  call void @llvm.memset.p0.i64(ptr %outb, i8 0, i64 32, i1 false)
  %to = getelementptr i8, ptr %outb, i64 4
  store i32 2, ptr %to
  %ta = getelementptr i8, ptr %outb, i64 20
  ; SECBUFFER_ALERT.
  store i32 17, ptr %ta
  store i32 0, ptr %outd
  %oc = getelementptr i8, ptr %outd, i64 4
  store i32 2, ptr %oc
  %obp = getelementptr i8, ptr %outd, i64 8
  store ptr %outb, ptr %obp
  %cred = getelementptr i8, ptr %c, i64 8
  %ctx = getelementptr i8, ptr %e, i64 8
  %old = select i1 %first, ptr null, ptr %ctx
  %new = select i1 %first, ptr %ctx, ptr null
  br i1 %client, label %initiate, label %accept
initiate:
  %hp = getelementptr i8, ptr %e, i64 136
  %host = load ptr, ptr %hp
  ; A first call sends the hello, with no input but the ALPN names when there are some.
  %inarg = select i1 %first, ptr null, ptr %ind
  %alpnonly = and i1 %first, %hasab
  %inarg2 = select i1 %alpnonly, ptr %ind, ptr %inarg
  ; ISC_REQ_SEQUENCE_DETECT | REPLAY_DETECT | CONFIDENTIALITY | ALLOCATE_MEMORY | STREAM |
  ; EXTENDED_ERROR | MANUAL_CRED_VALIDATION.
  %ri = call i32 @InitializeSecurityContextA(ptr %cred, ptr %old, ptr %host, i32 573724, i32 0, i32 0, ptr %inarg2, i32 0, ptr %new, ptr %outd, ptr %attr, ptr null)
  br label %called
accept:
  ; ASC_REQ_SEQUENCE_DETECT | REPLAY_DETECT | CONFIDENTIALITY | ALLOCATE_MEMORY | STREAM |
  ; EXTENDED_ERROR.
  %ra = call i32 @AcceptSecurityContext(ptr %cred, ptr %old, ptr %ind, i32 98588, i32 0, ptr %new, ptr %outd, ptr %attr, ptr null)
  br label %called
called:
  %r = phi i32 [ %ri, %initiate ], [ %ra, %accept ]
  call void @nz_tls_emit(ptr %e, ptr %outb)
  ; SEC_E_INCOMPLETE_MESSAGE: more ciphertext first, nothing consumed.
  %incomplete = icmp eq i32 %r, -2146893032
  br i1 %incomplete, label %want, label %result
result:
  %ok = icmp eq i32 %r, 0
  %cont = icmp eq i32 %r, 590610
  %going = or i1 %ok, %cont
  br i1 %going, label %consume, label %refused
consume:
  store i64 1, ptr %sp
  %t1 = getelementptr i8, ptr %inb, i64 20
  %t1v = load i32, ptr %t1
  %extra = icmp eq i32 %t1v, 5
  %x1 = getelementptr i8, ptr %inb, i64 16
  %xn = load i32, ptr %x1
  %xn64 = zext i32 %xn to i64
  %keep = select i1 %extra, i64 %xn64, i64 0
  %fed = select i1 %opens, i64 0, i64 %inl
  %used = sub i64 %fed, %keep
  %ib = getelementptr i8, ptr %e, i64 32
  call void @nz_tls_drop(ptr %ib, i64 %used)
  br i1 %ok, label %up_now, label %again
again:
  %left = load i64, ptr %inlp
  %anything = icmp sgt i64 %left, 0
  br i1 %anything, label %step, label %want
up_now:
  ; SECPKG_ATTR_STREAM_SIZES.
  %sz = getelementptr i8, ptr %e, i64 112
  %qs = call i32 @QueryContextAttributesA(ptr %ctx, i32 4, ptr %sz)
  br i1 %client, label %verify, label %mark
verify:
  %v = call i64 @nz_tls_verify(ptr %e)
  %trusted = icmp eq i64 %v, 0
  br i1 %trusted, label %mark, label %distrust
distrust:
  %fu = icmp eq i64 %v, -65602
  %fh = icmp eq i64 %v, -65603
  %t_e = select i1 %fu, ptr @nz_tls_why_expired, ptr @nz_tls_why_untrusted
  %t_h = select i1 %fh, ptr @nz_tls_why_host, ptr %t_e
  %vf = call i64 @nz_tls_fail(ptr %e, i64 %v, ptr %t_h)
  ret i64 %vf
mark:
  store i64 2, ptr %sp
  br label %established
established:
  ret i64 1
refused:
  %pf = call i64 @nz_tls_fail(ptr %e, i64 -65604, ptr @nz_tls_why_protocol)
  ret i64 %pf
finished:
  %fp = getelementptr i8, ptr %e, i64 152
  %f = load i64, ptr %fp
  %clean = icmp eq i64 %f, 0
  %g = select i1 %clean, i64 -65604, i64 %f
  ret i64 %g
want:
  ret i64 -65600
}

define hidden i64 @nz_tls_push(ptr %e, ptr %p, i64 %n) {
entry:
  %none = icmp slt i64 %n, 1
  br i1 %none, label %zero, label %go
zero:
  ret i64 0
go:
  %ib = getelementptr i8, ptr %e, i64 32
  %ok = call i1 @nz_tls_append(ptr %ib, ptr %p, i64 %n)
  %r = select i1 %ok, i64 %n, i64 -12
  ret i64 %r
}

define hidden i64 @nz_tls_pull(ptr %e, ptr %p, i64 %n) {
entry:
  %ob = getelementptr i8, ptr %e, i64 56
  %olp = getelementptr i8, ptr %e, i64 64
  %ol = load i64, ptr %olp
  %o = load ptr, ptr %ob
  %g = call i64 @nz_tls_give(ptr %o, i64 %ol, ptr %p, i64 %n)
  call void @nz_tls_drop(ptr %ob, i64 %g)
  ret i64 %g
}

; Plaintext: what an earlier record left, else one record decrypted from what has been pushed
; (DecryptMessage over a data buffer and three empty ones). 0 once the peer has closed TLS.
define hidden i64 @nz_tls_read(ptr %e, ptr %p, i64 %n) {
entry:
  %bufs = alloca [64 x i8], align 8
  %desc = alloca [16 x i8], align 8
  %view = alloca [24 x i8], align 8
  %none = icmp slt i64 %n, 1
  br i1 %none, label %invalid, label %start
invalid:
  ret i64 -22
start:
  %sp = getelementptr i8, ptr %e, i64 24
  %state = load i64, ptr %sp
  %closed = icmp eq i64 %state, 4
  br i1 %closed, label %eof, label %ready
ready:
  %up = icmp eq i64 %state, 2
  br i1 %up, label %loop, label %shake
shake:
  %h = call i64 @nz_tls_handshake(ptr %e)
  %hup = icmp eq i64 %h, 1
  br i1 %hup, label %loop, label %early
early:
  ret i64 %h
loop:
  %pb = getelementptr i8, ptr %e, i64 80
  %plp = getelementptr i8, ptr %e, i64 96
  %pl = load i64, ptr %plp
  %have = icmp sgt i64 %pl, 0
  br i1 %have, label %serve, label %decrypt
serve:
  %pspp = getelementptr i8, ptr %e, i64 88
  %ps = load i64, ptr %pspp
  %pbase = load ptr, ptr %pb
  %from = getelementptr i8, ptr %pbase, i64 %ps
  %g = call i64 @nz_tls_give(ptr %from, i64 %pl, ptr %p, i64 %n)
  %ps1 = add i64 %ps, %g
  %pl1 = sub i64 %pl, %g
  %gone = icmp eq i64 %pl1, 0
  %ps2 = select i1 %gone, i64 0, i64 %ps1
  store i64 %ps2, ptr %pspp
  store i64 %pl1, ptr %plp
  ret i64 %g
decrypt:
  %inp = getelementptr i8, ptr %e, i64 32
  %in = load ptr, ptr %inp
  %inlp = getelementptr i8, ptr %e, i64 40
  %inl = load i64, ptr %inlp
  %nothing = icmp eq i64 %inl, 0
  br i1 %nothing, label %want, label %call
call:
  call void @llvm.memset.p0.i64(ptr %bufs, i8 0, i64 64, i1 false)
  %in32 = trunc i64 %inl to i32
  store i32 %in32, ptr %bufs
  %t0 = getelementptr i8, ptr %bufs, i64 4
  ; SECBUFFER_DATA.
  store i32 1, ptr %t0
  %p0 = getelementptr i8, ptr %bufs, i64 8
  store ptr %in, ptr %p0
  store i32 0, ptr %desc
  %dc = getelementptr i8, ptr %desc, i64 4
  store i32 4, ptr %dc
  %dbp = getelementptr i8, ptr %desc, i64 8
  store ptr %bufs, ptr %dbp
  %ctx = getelementptr i8, ptr %e, i64 8
  %r = call i32 @DecryptMessage(ptr %ctx, ptr %desc, i32 0, ptr null)
  %incomplete = icmp eq i32 %r, -2146893032
  br i1 %incomplete, label %want, label %result
result:
  ; SEC_I_CONTEXT_EXPIRED: the peer's close_notify.
  %expired = icmp eq i32 %r, 590615
  br i1 %expired, label %peer_closed, label %decrypted
decrypted:
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %scan, label %refused
scan:
  br label %each
each:
  %i = phi i64 [ 0, %scan ], [ %i1, %next ]
  %keep = phi i64 [ 0, %scan ], [ %keep1, %next ]
  %b = getelementptr [16 x i8], ptr %bufs, i64 %i
  %cb = load i32, ptr %b
  %cb64 = zext i32 %cb to i64
  %tp = getelementptr i8, ptr %b, i64 4
  %t = load i32, ptr %tp
  %pvp = getelementptr i8, ptr %b, i64 8
  %pv = load ptr, ptr %pvp
  %data = icmp eq i32 %t, 1
  br i1 %data, label %plain, label %extra_q
plain:
  %pbuf = getelementptr i8, ptr %e, i64 80
  %pl0 = getelementptr i8, ptr %e, i64 96
  %pbl = getelementptr i8, ptr %e, i64 104
  ; The plain buffer's { ptr, len, cap } is at 80, 96 and 104 with its start at 88: appended
  ; through a view whose length and capacity are its own.
  %pbase0 = load ptr, ptr %pbuf
  store ptr %pbase0, ptr %view
  %vl = getelementptr i8, ptr %view, i64 8
  %curl = load i64, ptr %pl0
  store i64 %curl, ptr %vl
  %vc = getelementptr i8, ptr %view, i64 16
  %curc = load i64, ptr %pbl
  store i64 %curc, ptr %vc
  %apok = call i1 @nz_tls_append(ptr %view, ptr %pv, i64 %cb64)
  %nb = load ptr, ptr %view
  store ptr %nb, ptr %pbuf
  %nl = load i64, ptr %vl
  store i64 %nl, ptr %pl0
  %nc = load i64, ptr %vc
  store i64 %nc, ptr %pbl
  br label %next
extra_q:
  %isextra = icmp eq i32 %t, 5
  %k = select i1 %isextra, i64 %cb64, i64 %keep
  br label %next
next:
  %keep1 = phi i64 [ %keep, %plain ], [ %k, %extra_q ]
  %i1 = add i64 %i, 1
  %more = icmp ult i64 %i1, 4
  br i1 %more, label %each, label %compact
compact:
  %used = sub i64 %inl, %keep1
  %ib = getelementptr i8, ptr %e, i64 32
  call void @nz_tls_drop(ptr %ib, i64 %used)
  br label %loop
peer_closed:
  store i64 4, ptr %sp
  br label %eof
eof:
  ret i64 0
refused:
  %pf = call i64 @nz_tls_fail(ptr %e, i64 -65604, ptr @nz_tls_why_protocol)
  ret i64 %pf
want:
  ret i64 -65600
}

; One record of plaintext, at most the stream's largest message: EncryptMessage over a header, the
; data and a trailer, laid end to end, appended to the ciphertext to send. How much was taken.
define hidden i64 @nz_tls_write(ptr %e, ptr %p, i64 %n) {
entry:
  %bufs = alloca [64 x i8], align 8
  %desc = alloca [16 x i8], align 8
  %none = icmp slt i64 %n, 1
  br i1 %none, label %zero, label %start
zero:
  ret i64 0
start:
  %sp = getelementptr i8, ptr %e, i64 24
  %state = load i64, ptr %sp
  %closed = icmp eq i64 %state, 4
  br i1 %closed, label %gone, label %ready
gone:
  ret i64 -65536
ready:
  %up = icmp eq i64 %state, 2
  br i1 %up, label %sizes, label %shake
shake:
  %h = call i64 @nz_tls_handshake(ptr %e)
  %hup = icmp eq i64 %h, 1
  br i1 %hup, label %sizes, label %early
early:
  ret i64 %h
sizes:
  %hdp = getelementptr i8, ptr %e, i64 112
  %hd = load i32, ptr %hdp
  %trp = getelementptr i8, ptr %e, i64 116
  %tr = load i32, ptr %trp
  %mxp = getelementptr i8, ptr %e, i64 120
  %mx = load i32, ptr %mxp
  %hd64 = zext i32 %hd to i64
  %tr64 = zext i32 %tr to i64
  %mx64 = zext i32 %mx to i64
  %fits = icmp slt i64 %n, %mx64
  %chunk = select i1 %fits, i64 %n, i64 %mx64
  %t1 = add i64 %hd64, %chunk
  %total = add i64 %t1, %tr64
  %rec = call ptr @malloc(i64 %total)
  %nr = icmp eq ptr %rec, null
  br i1 %nr, label %nomem, label %fill
fill:
  %dat = getelementptr i8, ptr %rec, i64 %hd64
  call void @llvm.memcpy.p0.p0.i64(ptr %dat, ptr %p, i64 %chunk, i1 false)
  %trl = getelementptr i8, ptr %rec, i64 %t1
  call void @llvm.memset.p0.i64(ptr %bufs, i8 0, i64 64, i1 false)
  store i32 %hd, ptr %bufs
  %t0 = getelementptr i8, ptr %bufs, i64 4
  ; SECBUFFER_STREAM_HEADER, DATA, STREAM_TRAILER, EMPTY.
  store i32 7, ptr %t0
  %p0 = getelementptr i8, ptr %bufs, i64 8
  store ptr %rec, ptr %p0
  %c1 = getelementptr i8, ptr %bufs, i64 16
  %ch32 = trunc i64 %chunk to i32
  store i32 %ch32, ptr %c1
  %tt1 = getelementptr i8, ptr %bufs, i64 20
  store i32 1, ptr %tt1
  %p1 = getelementptr i8, ptr %bufs, i64 24
  store ptr %dat, ptr %p1
  %c2 = getelementptr i8, ptr %bufs, i64 32
  store i32 %tr, ptr %c2
  %tt2 = getelementptr i8, ptr %bufs, i64 36
  store i32 6, ptr %tt2
  %p2 = getelementptr i8, ptr %bufs, i64 40
  store ptr %trl, ptr %p2
  store i32 0, ptr %desc
  %dc = getelementptr i8, ptr %desc, i64 4
  store i32 4, ptr %dc
  %dbp = getelementptr i8, ptr %desc, i64 8
  store ptr %bufs, ptr %dbp
  %ctx = getelementptr i8, ptr %e, i64 8
  %r = call i32 @EncryptMessage(ptr %ctx, i32 0, ptr %desc, i32 0)
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %send, label %refused
send:
  %h0 = load i32, ptr %bufs
  %d0 = load i32, ptr %c1
  %r0 = load i32, ptr %c2
  %h064 = zext i32 %h0 to i64
  %d064 = zext i32 %d0 to i64
  %r064 = zext i32 %r0 to i64
  %s1 = add i64 %h064, %d064
  %s2 = add i64 %s1, %r064
  %ob = getelementptr i8, ptr %e, i64 56
  %aok = call i1 @nz_tls_append(ptr %ob, ptr %rec, i64 %s2)
  call void @free(ptr %rec)
  br i1 %aok, label %took, label %nomem
took:
  ret i64 %chunk
refused:
  call void @free(ptr %rec)
  %pf = call i64 @nz_tls_fail(ptr %e, i64 -65604, ptr @nz_tls_why_protocol)
  ret i64 %pf
nomem:
  ret i64 -12
}

; The end of session `e`: once established, SCHANNEL_SHUTDOWN applied and the close_notify SSPI
; then writes, into `p`; then everything it holds freed and its configuration let go. A null `p`
; frees without writing.
define hidden i64 @nz_tls_close(ptr %e, ptr %p, i64 %n) {
entry:
  %token = alloca i32, align 4
  %tb = alloca [16 x i8], align 8
  %td = alloca [16 x i8], align 8
  %outb = alloca [32 x i8], align 8
  %outd = alloca [16 x i8], align 8
  %attr = alloca i32, align 4
  %sp = getelementptr i8, ptr %e, i64 24
  %state = load i64, ptr %sp
  %c = load ptr, ptr %e
  %ctx = getelementptr i8, ptr %e, i64 8
  %up = icmp eq i64 %state, 2
  %np = icmp eq ptr %p, null
  %write = xor i1 %np, true
  %notify = and i1 %up, %write
  br i1 %notify, label %shutdown, label %drop
shutdown:
  store i32 1, ptr %token
  store i32 4, ptr %tb
  %tt = getelementptr i8, ptr %tb, i64 4
  store i32 2, ptr %tt
  %tp = getelementptr i8, ptr %tb, i64 8
  store ptr %token, ptr %tp
  store i32 0, ptr %td
  %tc = getelementptr i8, ptr %td, i64 4
  store i32 1, ptr %tc
  %tbp = getelementptr i8, ptr %td, i64 8
  store ptr %tb, ptr %tbp
  %a = call i32 @ApplyControlToken(ptr %ctx, ptr %td)
  call void @llvm.memset.p0.i64(ptr %outb, i8 0, i64 32, i1 false)
  %to = getelementptr i8, ptr %outb, i64 4
  store i32 2, ptr %to
  %ta = getelementptr i8, ptr %outb, i64 20
  store i32 17, ptr %ta
  store i32 0, ptr %outd
  %oc = getelementptr i8, ptr %outd, i64 4
  store i32 2, ptr %oc
  %obp = getelementptr i8, ptr %outd, i64 8
  store ptr %outb, ptr %obp
  %cred = getelementptr i8, ptr %c, i64 8
  %kp = getelementptr i8, ptr %c, i64 24
  %kind = load i64, ptr %kp
  %client = icmp eq i64 %kind, 1
  br i1 %client, label %initiate, label %accept
initiate:
  %hp = getelementptr i8, ptr %e, i64 136
  %host = load ptr, ptr %hp
  %ri = call i32 @InitializeSecurityContextA(ptr %cred, ptr %ctx, ptr %host, i32 573724, i32 0, i32 0, ptr null, i32 0, ptr null, ptr %outd, ptr %attr, ptr null)
  br label %emitted
accept:
  %ra = call i32 @AcceptSecurityContext(ptr %cred, ptr %ctx, ptr null, i32 98588, i32 0, ptr null, ptr %outd, ptr %attr, ptr null)
  br label %emitted
emitted:
  call void @nz_tls_emit(ptr %e, ptr %outb)
  %r = call i64 @nz_tls_pull(ptr %e, ptr %p, i64 %n)
  br label %drop
drop:
  %out = phi i64 [ 0, %entry ], [ %r, %emitted ]
  %started = icmp ne i64 %state, 0
  br i1 %started, label %delete, label %rest
delete:
  %d = call i32 @DeleteSecurityContext(ptr %ctx)
  br label %rest
rest:
  %ip = getelementptr i8, ptr %e, i64 32
  %i = load ptr, ptr %ip
  call void @free(ptr %i)
  %opp = getelementptr i8, ptr %e, i64 56
  %o = load ptr, ptr %opp
  call void @free(ptr %o)
  %pp = getelementptr i8, ptr %e, i64 80
  %pl = load ptr, ptr %pp
  call void @free(ptr %pl)
  %hp2 = getelementptr i8, ptr %e, i64 136
  %h = load ptr, ptr %hp2
  call void @free(ptr %h)
  call void @nz_tls_config_free(ptr %c)
  call void @free(ptr %e)
  ret i64 %out
}

; A fact about session `e`, into `p`: 0 the ALPN name agreed, 1 the version, 2 the peer
; certificate's common name as `/CN=…`, 3 why it failed. Its length; empty when there is none.
define hidden i64 @nz_tls_info(ptr %e, i64 %what, ptr %p, i64 %cap) {
entry:
  %ap = alloca [264 x i8], align 8
  %ci = alloca [28 x i8], align 8
  %certp = alloca ptr, align 8
  %name = alloca [256 x i8], align 1
  %sp = getelementptr i8, ptr %e, i64 24
  %state = load i64, ptr %sp
  %ctx = getelementptr i8, ptr %e, i64 8
  %up = icmp eq i64 %state, 2
  %detail = icmp eq i64 %what, 3
  %known = icmp ult i64 %what, 4
  br i1 %known, label %which, label %invalid
which:
  br i1 %detail, label %why, label %live
live:
  br i1 %up, label %pick, label %empty
pick:
  switch i64 %what, label %empty [ i64 0, label %alpn
                                   i64 1, label %version
                                   i64 2, label %peer ]
alpn:
  call void @llvm.memset.p0.i64(ptr %ap, i8 0, i64 264, i1 false)
  ; SECPKG_ATTR_APPLICATION_PROTOCOL; SecApplicationProtocolNegotiationStatus_Success.
  %qa = call i32 @QueryContextAttributesA(ptr %ctx, i32 35, ptr %ap)
  %st = load i32, ptr %ap
  %qok = icmp eq i32 %qa, 0
  %agreed = icmp eq i32 %st, 1
  %both = and i1 %qok, %agreed
  br i1 %both, label %give_alpn, label %empty
give_alpn:
  %szp = getelementptr i8, ptr %ap, i64 8
  %sz = load i8, ptr %szp
  %sz64 = zext i8 %sz to i64
  %idp = getelementptr i8, ptr %ap, i64 9
  %ga = call i64 @nz_tls_give(ptr %idp, i64 %sz64, ptr %p, i64 %cap)
  ret i64 %ga
version:
  call void @llvm.memset.p0.i64(ptr %ci, i8 0, i64 28, i1 false)
  ; SECPKG_ATTR_CONNECTION_INFO: SP_PROT_TLS1_2 (0xC00), SP_PROT_TLS1_3 (0x3000).
  %qc = call i32 @QueryContextAttributesA(ptr %ctx, i32 90, ptr %ci)
  %proto = load i32, ptr %ci
  %v12b = and i32 %proto, 3072
  %v13b = and i32 %proto, 12288
  %is12 = icmp ne i32 %v12b, 0
  %is13 = icmp ne i32 %v13b, 0
  %t12 = select i1 %is12, ptr @nz_tls_v12, ptr @nz_tls_vtls
  %t = select i1 %is13, ptr @nz_tls_v13, ptr %t12
  %tl = call i64 @strlen(ptr %t)
  %gv = call i64 @nz_tls_give(ptr %t, i64 %tl, ptr %p, i64 %cap)
  ret i64 %gv
peer:
  store ptr null, ptr %certp
  %qp = call i32 @QueryContextAttributesA(ptr %ctx, i32 83, ptr %certp)
  %cert = load ptr, ptr %certp
  %pok = icmp eq i32 %qp, 0
  %has = icmp ne ptr %cert, null
  %got = and i1 %pok, %has
  br i1 %got, label %cn, label %empty
cn:
  ; CERT_NAME_ATTR_TYPE with the common name's OID.
  %nl = call i32 @CertGetNameStringA(ptr %cert, i32 3, i32 0, ptr @nz_tls_cn, ptr %name, i32 256)
  %fc = call i32 @CertFreeCertificateContext(ptr %cert)
  %sl = call i64 @strlen(ptr %name)
  %g1 = call i64 @nz_tls_give(ptr @nz_tls_slash_cn, i64 4, ptr %p, i64 %cap)
  %rest = getelementptr i8, ptr %p, i64 %g1
  %room = sub i64 %cap, %g1
  %g2 = call i64 @nz_tls_give(ptr %name, i64 %sl, ptr %rest, i64 %room)
  %gp = add i64 %g1, %g2
  ret i64 %gp
why:
  %dp = getelementptr i8, ptr %e, i64 160
  %dl = call i64 @strlen(ptr %dp)
  %gd = call i64 @nz_tls_give(ptr %dp, i64 %dl, ptr %p, i64 %cap)
  ret i64 %gd
empty:
  ret i64 0
invalid:
  ret i64 -22
}
"#
}

pub fn rt_platform_OS_FORMAT() -> Str ! {} {
    r#"; Generated by nazm build. Do not edit.
source_filename = "os"

declare i32 @open(ptr, i32, ...)
declare i32 @mkdir(ptr, {mode_ty})
declare i32 @{stat}(ptr, ptr)
declare ptr @{opendir}(ptr)
declare ptr @{readdir}(ptr)
declare i32 @{strerror_r}(i32, ptr, i64)
declare i64 @strlen(ptr)
declare ptr @nz_errno_location()
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)

; `mode` -1 opens to read; 0 to 3 are `os_open_write`'s modes, checked by the caller.
define hidden i32 @nz_os_open(ptr %path, i64 %mode) {{
entry:
  switch i64 %mode, label %r [
    i64 0, label %w0
    i64 1, label %w1
    i64 2, label %w2
    i64 3, label %w3
  ]
r:
  %fr = call i32 (ptr, i32, ...) @open(ptr %path, i32 {read}, i32 438)
  ret i32 %fr
w0:
  %f0 = call i32 (ptr, i32, ...) @open(ptr %path, i32 {m0}, i32 438)
  ret i32 %f0
w1:
  %f1 = call i32 (ptr, i32, ...) @open(ptr %path, i32 {m1}, i32 438)
  ret i32 %f1
w2:
  %f2 = call i32 (ptr, i32, ...) @open(ptr %path, i32 {m2}, i32 438)
  ret i32 %f2
w3:
  %f3 = call i32 (ptr, i32, ...) @open(ptr %path, i32 {m3}, i32 438)
  ret i32 %f3
}}

define hidden i32 @nz_os_mkdir(ptr %path) {{
entry:
  %r = call i32 @mkdir(ptr %path, {mode_ty} 511)
  ret i32 %r
}}

; Size, kind (0 a file, 1 a directory, 2 anything else), modification time in
; nanoseconds and permission bits, as four i64s at `out`; 0, or -1 with errno set.
define hidden i32 @nz_os_stat(ptr %path, ptr %out) {{
entry:
  %st = alloca [{stat_size} x i8], align 16
  %r = call i32 @{stat}(ptr %path, ptr %st)
  %bad = icmp ne i32 %r, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i32 -1
ok:
  %sizep = getelementptr i8, ptr %st, i64 {size_at}
  %size = load i64, ptr %sizep
  store i64 %size, ptr %out
  %modep = getelementptr i8, ptr %st, i64 {mode_at}
  %moden = load {mode_ty}, ptr %modep
  %mode = zext {mode_ty} %moden to i64
  %fmt = and i64 %mode, 61440
  %isfile = icmp eq i64 %fmt, 32768
  %isdir = icmp eq i64 %fmt, 16384
  %k1 = select i1 %isdir, i64 1, i64 2
  %kind = select i1 %isfile, i64 0, i64 %k1
  %kindp = getelementptr i8, ptr %out, i64 8
  store i64 %kind, ptr %kindp
  %secp = getelementptr i8, ptr %st, i64 {mtime_at}
  %sec = load i64, ptr %secp
  %nsecp = getelementptr i8, ptr %st, i64 {mtime_nsec}
  %nsec = load i64, ptr %nsecp
  %ns = mul i64 %sec, 1000000000
  %mtime = add i64 %ns, %nsec
  %mtimep = getelementptr i8, ptr %out, i64 16
  store i64 %mtime, ptr %mtimep
  %perm = and i64 %mode, 4095
  %permp = getelementptr i8, ptr %out, i64 24
  store i64 %perm, ptr %permp
  ret i32 0
}}

define hidden ptr @nz_os_opendir(ptr %path) {{
entry:
  %d = call ptr @{opendir}(ptr %path)
  ret ptr %d
}}

; The next entry's name, other than `.` and `..`, into `buf`: its length, 0 after the
; last, -errno on failure, and -EINVAL for a name longer than `cap`.
define hidden i64 @nz_os_readdir(ptr %dir, ptr %buf, i64 %cap) {{
entry:
  %errp = call ptr @nz_errno_location()
  br label %next
next:
  store i32 0, ptr %errp
  %e = call ptr @{readdir}(ptr %dir)
  %end = icmp eq ptr %e, null
  br i1 %end, label %ended, label %entry1
ended:
  %err = load i32, ptr %errp
  %errw = sext i32 %err to i64
  %neg = sub i64 0, %errw
  ret i64 %neg
entry1:
  %name = getelementptr i8, ptr %e, i64 {name_at}
  %n = call i64 @strlen(ptr %name)
  %c0 = load i8, ptr %name
  %dot = icmp eq i8 %c0, 46
  %one = icmp eq i64 %n, 1
  %two = icmp eq i64 %n, 2
  %p1 = getelementptr i8, ptr %name, i64 1
  %c1 = load i8, ptr %p1
  %dot1 = icmp eq i8 %c1, 46
  %dotdot = and i1 %two, %dot1
  %short = or i1 %one, %dotdot
  %skip = and i1 %dot, %short
  br i1 %skip, label %next, label %take
take:
  %long = icmp sgt i64 %n, %cap
  br i1 %long, label %toolong, label %copy
toolong:
  ret i64 -22
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %name, i64 %n, i1 false)
  ret i64 %n
}}

define hidden i64 @nz_os_family() {{
entry:
  ret i64 {family}
}}

; The system's message for `status` into `buf`, its length; nothing for a status that
; is not negative.
define hidden i64 @nz_os_error_text(i64 %status, ptr %buf, i64 %cap) {{
entry:
  %neg = icmp slt i64 %status, 0
  %fits = icmp sgt i64 %status, -2147483648
  %ask = and i1 %neg, %fits
  br i1 %ask, label %text, label %none
none:
  ret i64 0
text:
  store i8 0, ptr %buf
  %errno = sub i64 0, %status
  %e = trunc i64 %errno to i32
  %r = call i32 @{strerror_r}(i32 %e, ptr %buf, i64 %cap)
  %n = call i64 @strlen(ptr %buf)
  ret i64 %n
}}
"#
}

