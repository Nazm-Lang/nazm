pub fn rt_platform_POSIX_FS_CALLS() -> Str ! {} {
    r#"
declare i32 @{LSTAT}(ptr, ptr)
declare i32 @chmod(ptr, {MODE_TY})
declare ptr @realpath(ptr, ptr)
declare i32 @flock(i32, i32)

define hidden i32 @nz_os_lstat(ptr %path, ptr %out) {
entry:
  %st = alloca [{STAT_SIZE} x i8], align 16
  %r = call i32 @{LSTAT}(ptr %path, ptr %st)
  %bad = icmp ne i32 %r, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i32 -1
ok:
  %sizep = getelementptr i8, ptr %st, i64 {SIZE_AT}
  %size = load i64, ptr %sizep
  store i64 %size, ptr %out
  %modep = getelementptr i8, ptr %st, i64 {MODE_AT}
  %moden = load {MODE_TY}, ptr %modep
  %mode = zext {MODE_TY} %moden to i64
  %fmt = and i64 %mode, 61440
  %isfile = icmp eq i64 %fmt, 32768
  %isdir = icmp eq i64 %fmt, 16384
  %islink = icmp eq i64 %fmt, 40960
  %k2 = select i1 %islink, i64 3, i64 2
  %k1 = select i1 %isdir, i64 1, i64 %k2
  %kind = select i1 %isfile, i64 0, i64 %k1
  %kindp = getelementptr i8, ptr %out, i64 8
  store i64 %kind, ptr %kindp
  %secp = getelementptr i8, ptr %st, i64 {MTIME_AT}
  %sec = load i64, ptr %secp
  %nsecp = getelementptr i8, ptr %st, i64 {MTIME_NSEC}
  %nsec = load i64, ptr %nsecp
  %ns = mul i64 %sec, 1000000000
  %mtime = add i64 %ns, %nsec
  %mtimep = getelementptr i8, ptr %out, i64 16
  store i64 %mtime, ptr %mtimep
  %perm = and i64 %mode, 4095
  %permp = getelementptr i8, ptr %out, i64 24
  store i64 %perm, ptr %permp
{DEV}
  %devp = getelementptr i8, ptr %out, i64 32
  store i64 %dev, ptr %devp
  %inop = getelementptr i8, ptr %st, i64 8
  %ino = load i64, ptr %inop
  %inoout = getelementptr i8, ptr %out, i64 40
  store i64 %ino, ptr %inoout
  ret i32 0
}

define hidden i32 @nz_os_chmod(ptr %path, i64 %mode) {
entry:
  %m = trunc i64 %mode to {MODE_TY}
  %r = call i32 @chmod(ptr %path, {MODE_TY} %m)
  ret i32 %r
}

define hidden i64 @nz_os_realpath(ptr %path, ptr %out, i64 %cap) {
entry:
  %buf = alloca [4096 x i8], align 16
  %r = call ptr @realpath(ptr %path, ptr %buf)
  %none = icmp eq ptr %r, null
  br i1 %none, label %fail, label %got
fail:
  ret i64 -1
got:
  %n = call i64 @strlen(ptr %buf)
  %fits = icmp sle i64 %n, %cap
  br i1 %fits, label %copy, label %done
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %out, ptr %buf, i64 %n, i1 false)
  br label %done
done:
  ret i64 %n
}

define hidden i32 @nz_os_flock(i32 %fd, i32 %op) {
entry:
  %r = call i32 @flock(i32 %fd, i32 %op)
  ret i32 %r
}
"#
}

pub fn rt_platform_NET_ADDR() -> Str ! {} {
    r#"
declare i32 @inet_pton(i32, ptr, ptr)
declare ptr @inet_ntop(i32, ptr, ptr, i32)
declare i32 @snprintf(ptr, i64, ptr, ...)
declare i32 @getaddrinfo(ptr, ptr, ptr, ptr)
declare void @freeaddrinfo(ptr)
declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
declare i16 @llvm.bswap.i16(i16)

@.nzf4 = private unnamed_addr constant [6 x i8] c"%s:%u\00"
@.nzf6 = private unnamed_addr constant [8 x i8] c"[%s]:%u\00"

; A socket address for `host` (a C string) and `port` in the caller's 128 bytes: its length, or
; -1 when `host` is not a literal address of the family asked for (`v6` nonzero for IPv6).
define hidden i64 @nz_net_fill(ptr %host, i64 %port, i64 %v6, ptr %out) {
entry:
  call void @llvm.memset.p0.i64(ptr %out, i8 0, i64 128, i1 false)
  %p16 = trunc i64 %port to i16
  %pbe = call i16 @llvm.bswap.i16(i16 %p16)
  %pp = getelementptr i8, ptr %out, i64 2
  store i16 %pbe, ptr %pp
  %isv6 = icmp ne i64 %v6, 0
  br i1 %isv6, label %six, label %four
four:
  %a4 = getelementptr i8, ptr %out, i64 4
  %r4 = call i32 @inet_pton(i32 2, ptr %host, ptr %a4)
  %ok4 = icmp eq i32 %r4, 1
  br i1 %ok4, label %fam4, label %bad
fam4:
{SETFAM4}
  ret i64 16
six:
  %a6 = getelementptr i8, ptr %out, i64 8
  %r6 = call i32 @inet_pton(i32 {AF6}, ptr %host, ptr %a6)
  %ok6 = icmp eq i32 %r6, 1
  br i1 %ok6, label %fam6, label %bad
fam6:
{SETFAM6}
  ret i64 28
bad:
  ret i64 -1
}

; `HOST:PORT`, IPv6 bracketed, into `out`: its length; 0 for an address of no family it knows.
define hidden i64 @nz_net_format(ptr %sa, ptr %out, i64 %cap) {
entry:
  %ip = alloca [64 x i8], align 8
{GETFAM}
  %pp = getelementptr i8, ptr %sa, i64 2
  %pbe = load i16, ptr %pp
  %p = call i16 @llvm.bswap.i16(i16 %pbe)
  %port = zext i16 %p to i32
  %is4 = icmp eq i32 %fam, 2
  br i1 %is4, label %four, label %other
four:
  %a4 = getelementptr i8, ptr %sa, i64 4
  %t4 = call ptr @inet_ntop(i32 2, ptr %a4, ptr %ip, i32 64)
  %n4 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %out, i64 %cap, ptr @.nzf4, ptr %ip, i32 %port)
  br label %done
other:
  %is6 = icmp eq i32 %fam, {AF6}
  br i1 %is6, label %six, label %none
six:
  %a6 = getelementptr i8, ptr %sa, i64 8
  %t6 = call ptr @inet_ntop(i32 {AF6}, ptr %a6, ptr %ip, i32 64)
  %n6 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %out, i64 %cap, ptr @.nzf6, ptr %ip, i32 %port)
  br label %done
none:
  ret i64 0
done:
  %n = phi i32 [ %n4, %four ], [ %n6, %six ]
  %w = sext i32 %n to i64
  %room = sub i64 %cap, 1
  %over = icmp sgt i64 %w, %room
  %len = select i1 %over, i64 %room, i64 %w
  ret i64 %len
}

; The addresses the resolver answers for `host` (a C string), each with `port`, one per line, into
; `out`: the length; -65537 for a name it did not answer; -22 when `out` is too short.
define hidden i64 @nz_net_resolve(ptr %host, i64 %port, ptr %out, i64 %cap) {
entry:
  %hints = alloca [64 x i8], align 8
  %res = alloca ptr, align 8
  %tmp = alloca [128 x i8], align 8
  %txt = alloca [80 x i8], align 8
  call void @llvm.memset.p0.i64(ptr %hints, i8 0, i64 64, i1 false)
  %st = getelementptr i8, ptr %hints, i64 8
  store i32 1, ptr %st
  %r = call i32 @getaddrinfo(ptr %host, ptr null, ptr %hints, ptr %res)
  %bad = icmp ne i32 %r, 0
  br i1 %bad, label %unknown, label %start
unknown:
  ret i64 -65537
start:
  %first = load ptr, ptr %res
  %p16 = trunc i64 %port to i16
  %pbe = call i16 @llvm.bswap.i16(i16 %p16)
  br label %walk
walk:
  %cur = phi ptr [ %first, %start ], [ %next, %copied ]
  %used = phi i64 [ 0, %start ], [ %used2, %copied ]
  %end = icmp eq ptr %cur, null
  br i1 %end, label %done, label %one
one:
  %lenp = getelementptr i8, ptr %cur, i64 16
  %len32 = load i32, ptr %lenp
  %len = zext i32 %len32 to i64
  %small = icmp ult i64 %len, 128
  %clen = select i1 %small, i64 %len, i64 128
  %sap = getelementptr i8, ptr %cur, i64 {AIADDR}
  %sa = load ptr, ptr %sap
  call void @llvm.memset.p0.i64(ptr %tmp, i8 0, i64 128, i1 false)
  call void @llvm.memcpy.p0.p0.i64(ptr %tmp, ptr %sa, i64 %clen, i1 false)
  %tp = getelementptr i8, ptr %tmp, i64 2
  store i16 %pbe, ptr %tp
  %n = call i64 @nz_net_format(ptr %tmp, ptr %txt, i64 80)
  %some = icmp sgt i64 %used, 0
  %sep = zext i1 %some to i64
  %need0 = add i64 %used, %sep
  %need = add i64 %need0, %n
  %over = icmp sgt i64 %need, %cap
  br i1 %over, label %short, label %copy
short:
  call void @freeaddrinfo(ptr %first)
  ret i64 -22
copy:
  br i1 %some, label %newline, label %text
newline:
  %nlp = getelementptr i8, ptr %out, i64 %used
  store i8 10, ptr %nlp
  br label %text
text:
  %at = getelementptr i8, ptr %out, i64 %need0
  call void @llvm.memcpy.p0.p0.i64(ptr %at, ptr %txt, i64 %n, i1 false)
  br label %copied
copied:
  %used2 = add i64 %need0, %n
  %nextp = getelementptr i8, ptr %cur, i64 40
  %next = load ptr, ptr %nextp
  br label %walk
done:
  call void @freeaddrinfo(ptr %first)
  ret i64 %used
}
"#
}

pub fn rt_platform_NET_SOCK() -> Str ! {} {
    r#"
declare i32 @fcntl(i32, i32, ...)
declare i32 @socket(i32, i32, i32)
declare i32 @setsockopt(i32, i32, i32, ptr, i32)
declare i32 @getsockopt(i32, i32, i32, ptr, ptr)
declare i32 @connect(i32, ptr, i32)
declare i64 @send(i32, ptr, i64, i32)
declare i64 @sendto(i32, ptr, i64, i32, ptr, i32)

; Close on exec, non-blocking, and never a signal for a peer that has gone.
define hidden i32 @nz_net_prepare(i32 %fd) {
entry:
  %one = alloca i32, align 4
  store i32 1, ptr %one
  %c = call i32 (i32, i32, ...) @fcntl(i32 %fd, i32 2, i32 1)
  %fl = call i32 (i32, i32, ...) @fcntl(i32 %fd, i32 3)
  %nb = or i32 %fl, {NONBLOCK}
  %s = call i32 (i32, i32, ...) @fcntl(i32 %fd, i32 4, i32 %nb)
{NOSIGPIPE}
  ret i32 0
}

; A socket of `type` (1 a stream, 2 datagrams) for the address at `sa`, prepared, its address
; reused when `reuse` is nonzero; or -1 with errno set.
define hidden i32 @nz_net_open(ptr %sa, i64 %type, i64 %reuse) {
entry:
  %one = alloca i32, align 4
  store i32 1, ptr %one
{GETFAM}
  %t = trunc i64 %type to i32
  %fd = call i32 @socket(i32 %fam, i32 %t, i32 0)
  %bad = icmp slt i32 %fd, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i32 -1
ok:
  %p = call i32 @nz_net_prepare(i32 %fd)
  %r = icmp ne i64 %reuse, 0
  br i1 %r, label %reused, label %done
reused:
  %s = call i32 @setsockopt(i32 %fd, i32 {SOLSOCKET}, i32 {REUSE}, ptr %one, i32 4)
  br label %done
done:
  ret i32 %fd
}

; 0 connected, 1 under way, or -errno.
define hidden i64 @nz_net_connect(i32 %fd, ptr %sa, i64 %len) {
entry:
  %l = trunc i64 %len to i32
  %r = call i32 @connect(i32 %fd, ptr %sa, i32 %l)
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %done, label %failed
done:
  ret i64 0
failed:
  %ep = call ptr @nz_errno_location()
  %e = load i32, ptr %ep
  %busy = icmp eq i32 %e, {EINPROGRESS}
  br i1 %busy, label %under, label %error
under:
  ret i64 1
error:
  %w = sext i32 %e to i64
  %neg = sub i64 0, %w
  ret i64 %neg
}

; The error a socket holds (`SO_ERROR`): 0, or its errno.
define hidden i64 @nz_net_error(i32 %fd) {
entry:
  %v = alloca i32, align 4
  %l = alloca i32, align 4
  store i32 0, ptr %v
  store i32 4, ptr %l
  %r = call i32 @getsockopt(i32 %fd, i32 {SOLSOCKET}, i32 {SOERROR}, ptr %v, ptr %l)
  %e = load i32, ptr %v
  %w = sext i32 %e to i64
  ret i64 %w
}

define hidden i64 @nz_net_send(i32 %fd, ptr %p, i64 %n) {
entry:
  %r = call i64 @send(i32 %fd, ptr %p, i64 %n, i32 {SENDFLAGS})
  ret i64 %r
}

define hidden i64 @nz_net_sendto(i32 %fd, ptr %p, i64 %n, ptr %sa, i64 %len) {
entry:
  %l = trunc i64 %len to i32
  %r = call i64 @sendto(i32 %fd, ptr %p, i64 %n, i32 {SENDFLAGS}, ptr %sa, i32 %l)
  ret i64 %r
}

define hidden i64 @nz_net_eagain() {
entry:
  ret i64 {EAGAIN}
}

define hidden i64 @nz_net_etimedout() {
entry:
  ret i64 {ETIMEDOUT}
}

"#
}

pub fn rt_platform_POSIX_NET_CALLS() -> Str ! {} {
    r#"
declare i32 @bind(i32, ptr, i32)
declare i32 @listen(i32, i32)
declare i32 @accept(i32, ptr, ptr)
declare i64 @recvfrom(i32, ptr, i64, i32, ptr, ptr)
declare i32 @getsockname(i32, ptr, ptr)
declare i32 @getpeername(i32, ptr, ptr)
declare i32 @shutdown(i32, i32)

define hidden i64 @nz_net_read(i32 %fd, ptr %buf, i64 %n) {
entry:
  %r = call i64 @read(i32 %fd, ptr %buf, i64 %n)
  ret i64 %r
}

define hidden i32 @nz_net_bind(i32 %fd, ptr %sa, i32 %len) {
entry:
  %r = call i32 @bind(i32 %fd, ptr %sa, i32 %len)
  ret i32 %r
}

define hidden i32 @nz_net_listen(i32 %fd) {
entry:
  %r = call i32 @listen(i32 %fd, i32 128)
  ret i32 %r
}

define hidden i32 @nz_net_accept(i32 %fd) {
entry:
  %r = call i32 @accept(i32 %fd, ptr null, ptr null)
  ret i32 %r
}

define hidden i64 @nz_net_recvfrom(i32 %fd, ptr %buf, i64 %n, ptr %sa, ptr %slen) {
entry:
  %r = call i64 @recvfrom(i32 %fd, ptr %buf, i64 %n, i32 0, ptr %sa, ptr %slen)
  ret i64 %r
}

define hidden i32 @nz_net_shutdown(i32 %fd, i32 %how) {
entry:
  %r = call i32 @shutdown(i32 %fd, i32 %how)
  ret i32 %r
}

; A socket's own address (`peer` 0) or its peer's (1).
define hidden i32 @nz_net_name(i32 %fd, i32 %peer, ptr %sa, ptr %slen) {
entry:
  %want = icmp ne i32 %peer, 0
  br i1 %want, label %theirs, label %ours
theirs:
  %p = call i32 @getpeername(i32 %fd, ptr %sa, ptr %slen)
  ret i32 %p
ours:
  %o = call i32 @getsockname(i32 %fd, ptr %sa, ptr %slen)
  ret i32 %o
}
"#
}

pub fn rt_platform_POSIX_PROC_CALLS() -> Str ! {} {
    r#"
declare i32 @pipe(ptr)
declare i32 @posix_spawnp(ptr, ptr, ptr, ptr, ptr, ptr)
declare i32 @posix_spawn_file_actions_init(ptr)
declare i32 @posix_spawn_file_actions_adddup2(ptr, i32, i32)
declare i32 @posix_spawn_file_actions_addopen(ptr, i32, ptr, i32, {MODE_TY})
declare extern_weak i32 @posix_spawn_file_actions_addchdir_np(ptr, ptr)
declare i32 @posix_spawn_file_actions_destroy(ptr)
declare i32 @posix_spawnattr_init(ptr)
declare i32 @posix_spawnattr_setflags(ptr, i16)
declare i32 @posix_spawnattr_setpgroup(ptr, i32)
declare i32 @posix_spawnattr_destroy(ptr)
declare i32 @wait4(i32, ptr, i32, ptr)
declare i32 @kill(i32, i32)
declare i32 @getpid()
declare i32 @nanosleep(ptr, ptr)
declare ptr @signal(i32, ptr)

@.nz.devnull = private unnamed_addr constant [10 x i8] c"/dev/null\00"

define hidden i32 @nz_os_spawn_in(ptr %pid, ptr %prog, ptr %av, ptr %envp, ptr %dir, i64 %flags, ptr %ends) {
entry:
  %fa = alloca [256 x i8], align 16
  %attr = alloca [512 x i8], align 16
  %fds = alloca [6 x i32], align 4
  %cpid = alloca i32, align 4
  %hasdir = icmp ne ptr %dir, null
  %nochdir = icmp eq ptr @posix_spawn_file_actions_addchdir_np, null
  %cannot = and i1 %hasdir, %nochdir
  br i1 %cannot, label %nosys, label %make
nosys:
  ret i32 {ENOSYS}
make:
  %in = getelementptr i32, ptr %fds, i64 0
  %out = getelementptr i32, ptr %fds, i64 2
  %err = getelementptr i32, ptr %fds, i64 4
  %p0 = call i32 @pipe(ptr %in)
  %p1 = call i32 @pipe(ptr %out)
  %p2 = call i32 @pipe(ptr %err)
  br label %cloexec
cloexec:
  %j = phi i64 [ 0, %make ], [ %j1, %cloexec ]
  %fp = getelementptr i32, ptr %fds, i64 %j
  %f = load i32, ptr %fp
  %ce = call i32 (i32, i32, ...) @fcntl(i32 %f, i32 2, i32 1)
  %j1 = add i64 %j, 1
  %again = icmp slt i64 %j1, 6
  br i1 %again, label %cloexec, label %actions
actions:
  %ai = call i32 @posix_spawn_file_actions_init(ptr %fa)
  %in0p = getelementptr i32, ptr %fds, i64 0
  %in0 = load i32, ptr %in0p
  %in1p = getelementptr i32, ptr %fds, i64 1
  %in1 = load i32, ptr %in1p
  %out0p = getelementptr i32, ptr %fds, i64 2
  %out0 = load i32, ptr %out0p
  %out1p = getelementptr i32, ptr %fds, i64 3
  %out1 = load i32, ptr %out1p
  %err0p = getelementptr i32, ptr %fds, i64 4
  %err0 = load i32, ptr %err0p
  %err1p = getelementptr i32, ptr %fds, i64 5
  %err1 = load i32, ptr %err1p
  %nullbit = and i64 %flags, 2
  %nullin = icmp ne i64 %nullbit, 0
  br i1 %nullin, label %devnull, label %inpipe
devnull:
  %o0 = call i32 @posix_spawn_file_actions_addopen(ptr %fa, i32 0, ptr @.nz.devnull, i32 0, {MODE_TY} 0)
  br label %outputs
inpipe:
  %d0 = call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %in0, i32 0)
  br label %outputs
outputs:
  %d1 = call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %out1, i32 1)
  %d2 = call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %err1, i32 2)
  br i1 %hasdir, label %chdir, label %attrs
chdir:
  %cd = call i32 @posix_spawn_file_actions_addchdir_np(ptr %fa, ptr %dir)
  br label %attrs
attrs:
  %ti = call i32 @posix_spawnattr_init(ptr %attr)
  %groupbit = and i64 %flags, 1
  %group = icmp ne i64 %groupbit, 0
  br i1 %group, label %setgroup, label %spawn
setgroup:
  %sf = call i32 @posix_spawnattr_setflags(ptr %attr, i16 2)
  %sg = call i32 @posix_spawnattr_setpgroup(ptr %attr, i32 0)
  br label %spawn
spawn:
  %given = icmp ne ptr %envp, null
  %own = call ptr @nz_os_environ()
  %env = select i1 %given, ptr %envp, ptr %own
  %r = call i32 @posix_spawnp(ptr %cpid, ptr %prog, ptr %fa, ptr %attr, ptr %av, ptr %env)
  %ad = call i32 @posix_spawn_file_actions_destroy(ptr %fa)
  %td = call i32 @posix_spawnattr_destroy(ptr %attr)
  %c0 = call i32 @close(i32 %in0)
  %c1 = call i32 @close(i32 %out1)
  %c2 = call i32 @close(i32 %err1)
  %failed = icmp ne i32 %r, 0
  br i1 %failed, label %undo, label %started
undo:
  %u0 = call i32 @close(i32 %in1)
  %u1 = call i32 @close(i32 %out0)
  %u2 = call i32 @close(i32 %err0)
  ret i32 %r
started:
  %ign = inttoptr i64 1 to ptr
  %old = call ptr @signal(i32 13, ptr %ign)
  br i1 %nullin, label %noinput, label %input
noinput:
  %u3 = call i32 @close(i32 %in1)
  store i32 -1, ptr %ends
  br label %rest
input:
  store i32 %in1, ptr %ends
  br label %rest
rest:
  %e1 = getelementptr i32, ptr %ends, i64 1
  store i32 %out0, ptr %e1
  %e2 = getelementptr i32, ptr %ends, i64 2
  store i32 %err0, ptr %e2
  %pidv = load i32, ptr %cpid
  %pidw = sext i32 %pidv to i64
  store i64 %pidw, ptr %pid
  ret i32 0
}

define hidden i64 @nz_os_reap(i64 %pid, i32 %block, ptr %rss) {
entry:
  %st = alloca i32, align 4
  %ru = alloca [144 x i8], align 8
  %p = trunc i64 %pid to i32
  %waits = icmp ne i32 %block, 0
  %opt = select i1 %waits, i32 0, i32 1
  br label %wait
wait:
  %r = call i32 @wait4(i32 %p, ptr %st, i32 %opt, ptr %ru)
  %bad = icmp slt i32 %r, 0
  br i1 %bad, label %error, label %got
error:
  %ep = call ptr @nz_errno_location()
  %e = load i32, ptr %ep
  %intr = icmp eq i32 %e, 4
  br i1 %intr, label %wait, label %give
give:
  %w = sext i32 %e to i64
  %neg = sub i64 0, %w
  ret i64 %neg
got:
  %none = icmp eq i32 %r, 0
  br i1 %none, label %running, label %decode
running:
  ret i64 -{EAGAIN}
decode:
  %maxp = getelementptr i8, ptr %ru, i64 32
  %max = load i64, ptr %maxp
  %bytes = mul i64 %max, {RSS_SCALE}
  store i64 %bytes, ptr %rss
  %s = load i32, ptr %st
  %sig = and i32 %s, 127
  %exited = icmp eq i32 %sig, 0
  %hi = lshr i32 %s, 8
  %code = and i32 %hi, 255
  %codew = zext i32 %code to i64
  %sigw = zext i32 %sig to i64
  %bysig = add i64 %sigw, 256
  %out = select i1 %exited, i64 %codew, i64 %bysig
  ret i64 %out
}

define hidden i32 @nz_os_terminate(i64 %pid) {
entry:
  %p = trunc i64 %pid to i32
  %r = call i32 @kill(i32 %p, i32 9)
  ret i32 %r
}

define hidden i32 @nz_os_key() {
entry:
  %fd = call i32 (ptr, i32, ...) @open(ptr @.nz.devnull, i32 {RDONLY_CLOEXEC})
  ret i32 %fd
}

define hidden i64 @nz_os_child_id(i64 %pid) {
entry:
  ret i64 %pid
}

define hidden i64 @nz_os_pid() {
entry:
  %p = call i32 @getpid()
  %w = sext i32 %p to i64
  ret i64 %w
}

define hidden i32 @nz_os_signal_group(i64 %pgid, i64 %sig) {
entry:
  %g = trunc i64 %pgid to i32
  %neg = sub i32 0, %g
  %s = trunc i64 %sig to i32
  %r = call i32 @kill(i32 %neg, i32 %s)
  ret i32 %r
}

define hidden void @nz_os_nap(i64 %ms) {
entry:
  %ts = alloca [16 x i8], align 8
  %sec = udiv i64 %ms, 1000
  %rem = urem i64 %ms, 1000
  %ns = mul i64 %rem, 1000000
  store i64 %sec, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  store i64 %ns, ptr %np
  %r = call i32 @nanosleep(ptr %ts, ptr null)
  ret void
}

define hidden i64 @nz_net_write(i32 %fd, ptr %buf, i64 %n) {
entry:
  %r = call i64 @write(i32 %fd, ptr %buf, i64 %n)
  ret i64 %r
}
"#
}

pub fn rt_platform_KQUEUE() -> Str ! {} {
    r#"
declare i32 @kqueue()
declare i32 @kevent(i32, ptr, i32, ptr, i32, ptr)

define hidden i32 @nz_net_poller() {
entry:
  %q = call i32 @kqueue()
  %c = call i32 (i32, i32, ...) @fcntl(i32 %q, i32 2, i32 1)
  ret i32 %q
}

; Arm `fd` once for reading (mask bit 1) and writing (bit 2), the event carrying `udata`.
define hidden i32 @nz_net_arm(i32 %q, i32 %fd, i64 %mask, i64 %udata) {
entry:
  %ev = alloca [32 x i8], align 8
  %id = sext i32 %fd to i64
  %rd = and i64 %mask, 1
  %wantr = icmp ne i64 %rd, 0
  br i1 %wantr, label %armr, label %checkw
armr:
  call void @llvm.memset.p0.i64(ptr %ev, i8 0, i64 32, i1 false)
  store i64 %id, ptr %ev
  %fr = getelementptr i8, ptr %ev, i64 8
  store i16 -1, ptr %fr
  %flr = getelementptr i8, ptr %ev, i64 10
  store i16 17, ptr %flr
  %ur = getelementptr i8, ptr %ev, i64 24
  store i64 %udata, ptr %ur
  %rr = call i32 @kevent(i32 %q, ptr %ev, i32 1, ptr null, i32 0, ptr null)
  br label %checkw
checkw:
  %wr = and i64 %mask, 2
  %wantw = icmp ne i64 %wr, 0
  br i1 %wantw, label %armw, label %done
armw:
  call void @llvm.memset.p0.i64(ptr %ev, i8 0, i64 32, i1 false)
  store i64 %id, ptr %ev
  %fw = getelementptr i8, ptr %ev, i64 8
  store i16 -2, ptr %fw
  %flw = getelementptr i8, ptr %ev, i64 10
  store i16 17, ptr %flw
  %uw = getelementptr i8, ptr %ev, i64 24
  store i64 %udata, ptr %uw
  %rw = call i32 @kevent(i32 %q, ptr %ev, i32 1, ptr null, i32 0, ptr null)
  br label %done
done:
  ret i32 0
}

; Wait for events: each one's `udata` into `out`, at most 64; how many.
define hidden i64 @nz_net_poll(i32 %q, ptr %out) {
entry:
  %evs = alloca [2048 x i8], align 8
  %n = call i32 @kevent(i32 %q, ptr null, i32 0, ptr %evs, i32 64, ptr null)
  %none = icmp slt i32 %n, 1
  br i1 %none, label %zero, label %start
zero:
  ret i64 0
start:
  %count = sext i32 %n to i64
  br label %loop
loop:
  %i = phi i64 [ 0, %start ], [ %i1, %loop ]
  %off = mul i64 %i, 32
  %off2 = add i64 %off, 24
  %up = getelementptr i8, ptr %evs, i64 %off2
  %u = load i64, ptr %up
  %op = getelementptr i64, ptr %out, i64 %i
  store i64 %u, ptr %op
  %i1 = add i64 %i, 1
  %more = icmp slt i64 %i1, %count
  br i1 %more, label %loop, label %done
done:
  ret i64 %count
}
"#
}

pub fn rt_platform_EPOLL() -> Str ! {} {
    r#"
declare i32 @epoll_create1(i32)
declare i32 @epoll_ctl(i32, i32, i32, ptr)
declare i32 @epoll_wait(i32, ptr, i32, i32)

define hidden i32 @nz_net_poller() {
entry:
  %e = call i32 @epoll_create1(i32 524288)
  ret i32 %e
}

define hidden i32 @nz_net_arm(i32 %ep, i32 %fd, i64 %mask, i64 %udata) {
entry:
  %ev = alloca [16 x i8], align 8
  call void @llvm.memset.p0.i64(ptr %ev, i8 0, i64 16, i1 false)
  %rd = and i64 %mask, 1
  %wr = and i64 %mask, 2
  %wantr = icmp ne i64 %rd, 0
  %wantw = icmp ne i64 %wr, 0
  %er = select i1 %wantr, i32 8193, i32 0
  %ew = select i1 %wantw, i32 4, i32 0
  %e0 = or i32 %er, %ew
  %events = or i32 %e0, 1073741824
  store i32 %events, ptr %ev
  %dp = getelementptr i8, ptr %ev, i64 {EPDATA}
  store i64 %udata, ptr %dp, align 4
  %m = call i32 @epoll_ctl(i32 %ep, i32 3, i32 %fd, ptr %ev)
  %ok = icmp eq i32 %m, 0
  br i1 %ok, label %done, label %add
add:
  %a = call i32 @epoll_ctl(i32 %ep, i32 1, i32 %fd, ptr %ev)
  br label %done
done:
  ret i32 0
}

define hidden i64 @nz_net_poll(i32 %ep, ptr %out) {
entry:
  %evs = alloca [1024 x i8], align 8
  %n = call i32 @epoll_wait(i32 %ep, ptr %evs, i32 64, i32 -1)
  %none = icmp slt i32 %n, 1
  br i1 %none, label %zero, label %start
zero:
  ret i64 0
start:
  %count = sext i32 %n to i64
  br label %loop
loop:
  %i = phi i64 [ 0, %start ], [ %i1, %loop ]
  %off = mul i64 %i, {EPSIZE}
  %off2 = add i64 %off, {EPDATA}
  %up = getelementptr i8, ptr %evs, i64 %off2
  %u = load i64, ptr %up, align 4
  %op = getelementptr i64, ptr %out, i64 %i
  store i64 %u, ptr %op
  %i1 = add i64 %i, 1
  %more = icmp slt i64 %i1, %count
  br i1 %more, label %loop, label %done
done:
  ret i64 %count
}
"#
}

pub fn rt_platform_WINDOWS_FILES() -> Str ! {} {
    r#"
declare ptr @GetEnvironmentStringsW()
declare i32 @FreeEnvironmentStringsW(ptr)
declare ptr @_errno()
declare i32 @GetLastError()
declare i32 @MultiByteToWideChar(i32, i32, ptr, i32, ptr, i32)
declare i32 @WideCharToMultiByte(i32, i32, ptr, i32, ptr, i32, ptr, ptr)
declare i64 @wcslen(ptr)
declare i32 @_wopen(ptr, i32, ...)
declare i32 @_open(ptr, i32, ...)
declare i32 @_wmkdir(ptr)
declare i32 @_wstat64(ptr, ptr)
declare ptr @_wopendir(ptr)
declare ptr @_wreaddir(ptr)
declare i32 @_wclosedir(ptr)
declare i32 @_close(i32)
declare i32 @_read(i32, ptr, i32)
declare i32 @_write(i32, ptr, i32)
declare i64 @_lseeki64(i32, i64, i32)
declare i32 @_commit(i32)
declare i32 @_wunlink(ptr)
declare i32 @_wrmdir(ptr)
declare i32 @MoveFileExW(ptr, ptr, i32)
declare i32 @BCryptGenRandom(ptr, ptr, i32, i32)
declare ptr @strerror(i32)
declare i64 @strlen(ptr)
declare ptr @malloc(i64)
declare void @free(ptr)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)

@.nz.win.nul = private unnamed_addr constant [4 x i8] c"NUL\00"

define hidden i64 @nz_os_family() {
entry:
  ret i64 2
}

@nz.win.environ = internal global ptr null

; The environment as `char **`, NULL-terminated, UTF-8 (Gate 3): built once from the system's
; UTF-16 block. An entry that is not valid UTF-16 is skipped rather than mangled, and so is each
; of Windows' hidden per-drive entries, which begin with `=`.
define hidden ptr @nz_os_environ() {
entry:
  %have = load ptr, ptr @nz.win.environ
  %cached = icmp ne ptr %have, null
  br i1 %cached, label %done, label %build
done:
  ret ptr %have
build:
  %block = call ptr @GetEnvironmentStringsW()
  br label %count
count:
  %cp = phi ptr [ %block, %build ], [ %cnext, %counted ]
  %cn = phi i64 [ 0, %build ], [ %cn1, %counted ]
  %cc = load i16, ptr %cp
  %cend = icmp eq i16 %cc, 0
  br i1 %cend, label %alloc, label %counted
counted:
  %clen = call i64 @wcslen(ptr %cp)
  %cbytes = mul i64 %clen, 2
  %cskip = add i64 %cbytes, 2
  %cnext = getelementptr i8, ptr %cp, i64 %cskip
  %cn1 = add i64 %cn, 1
  br label %count
alloc:
  %slots = add i64 %cn, 1
  %abytes = mul i64 %slots, 8
  %arr = call ptr @malloc(i64 %abytes)
  br label %walk
walk:
  %p = phi ptr [ %block, %alloc ], [ %next, %advance ]
  %i = phi i64 [ 0, %alloc ], [ %i2, %advance ]
  %c = load i16, ptr %p
  %end = icmp eq i16 %c, 0
  br i1 %end, label %finish, label %entry1
entry1:
  %len = call i64 @wcslen(ptr %p)
  %hidden = icmp eq i16 %c, 61
  br i1 %hidden, label %skip, label %size
size:
  %need = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %p, i32 -1, ptr null, i32 0, ptr null, ptr null)
  %bad = icmp eq i32 %need, 0
  br i1 %bad, label %skip, label %convert
convert:
  %needw = sext i32 %need to i64
  %str = call ptr @malloc(i64 %needw)
  %wrote = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %p, i32 -1, ptr %str, i32 %need, ptr null, ptr null)
  %slot = getelementptr ptr, ptr %arr, i64 %i
  store ptr %str, ptr %slot
  %i1 = add i64 %i, 1
  br label %advance
skip:
  br label %advance
advance:
  %i2 = phi i64 [ %i1, %convert ], [ %i, %skip ]
  %bytes = mul i64 %len, 2
  %step = add i64 %bytes, 2
  %next = getelementptr i8, ptr %p, i64 %step
  br label %walk
finish:
  %last = getelementptr ptr, ptr %arr, i64 %i
  store ptr null, ptr %last
  %f = call i32 @FreeEnvironmentStringsW(ptr %block)
  store ptr %arr, ptr @nz.win.environ
  ret ptr %arr
}

; Set the C runtime's errno, in its own numbering.
define internal void @nz.win.set_errno(i32 %e) {
entry:
  %p = call ptr @_errno()
  store i32 %e, ptr %p
  ret void
}

; The last Win32 error as the C runtime's errno number.
define internal i32 @nz.win.last_errno() {
entry:
  %w = call i32 @GetLastError()
  switch i32 %w, label %io [
    i32 2, label %noent
    i32 3, label %noent
    i32 5, label %acces
    i32 32, label %acces
    i32 80, label %exist
    i32 183, label %exist
    i32 145, label %notempty
    i32 123, label %inval
    i32 87, label %inval
    i32 17, label %xdev
  ]
noent:
  ret i32 2
acces:
  ret i32 13
exist:
  ret i32 17
notempty:
  ret i32 41
inval:
  ret i32 22
xdev:
  ret i32 18
io:
  ret i32 5
}

; `s`, UTF-8 and NUL-terminated, as a new UTF-16 string; null with errno set when it is not UTF-8
; (EILSEQ) or memory is refused.
define internal ptr @nz.win.wide(ptr %s) {
entry:
  %n = call i32 @MultiByteToWideChar(i32 65001, i32 8, ptr %s, i32 -1, ptr null, i32 0)
  %zero = icmp eq i32 %n, 0
  br i1 %zero, label %notutf8, label %alloc
notutf8:
  call void @nz.win.set_errno(i32 42)
  ret ptr null
alloc:
  %nw = zext i32 %n to i64
  %bytes = mul i64 %nw, 2
  %buf = call ptr @malloc(i64 %bytes)
  %none = icmp eq ptr %buf, null
  br i1 %none, label %nomem, label %convert
nomem:
  call void @nz.win.set_errno(i32 12)
  ret ptr null
convert:
  %m = call i32 @MultiByteToWideChar(i32 65001, i32 8, ptr %s, i32 -1, ptr %buf, i32 %n)
  ret ptr %buf
}

; `mode` -1 opens to read; 0 to 3 are `os_open_write`'s: create or truncate, append, create
; new, read and write. Every one binary and not inherited by a child.
define hidden i32 @nz_os_open(ptr %path, i64 %mode) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  switch i64 %mode, label %r [
    i64 0, label %w0
    i64 1, label %w1
    i64 2, label %w2
    i64 3, label %w3
  ]
r:
  br label %open
w0:
  br label %open
w1:
  br label %open
w2:
  br label %open
w3:
  br label %open
open:
  %flags = phi i32 [ 32896, %r ], [ 33665, %w0 ], [ 33161, %w1 ], [ 34177, %w2 ], [ 32898, %w3 ]
  %fd = call i32 (ptr, i32, ...) @_wopen(ptr %w, i32 %flags, i32 384)
  call void @free(ptr %w)
  ret i32 %fd
}

define hidden i32 @nz_os_mkdir(ptr %path) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  %r = call i32 @_wmkdir(ptr %w)
  call void @free(ptr %w)
  ret i32 %r
}

; Size, kind (0 a file, 1 a directory, 2 anything else), modification time in nanoseconds and
; permission bits, as four i64s at `out`; 0, or -1 with errno set. `struct _stat64`: `st_mode` a
; 16-bit word at 6, `st_size` at 24, `st_mtime` (seconds) at 40, 56 bytes in all.
define hidden i32 @nz_os_stat(ptr %path, ptr %out) {
entry:
  %st = alloca [56 x i8], align 8
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  %r = call i32 @_wstat64(ptr %w, ptr %st)
  call void @free(ptr %w)
  %bad = icmp ne i32 %r, 0
  br i1 %bad, label %fail, label %ok
ok:
  %sizep = getelementptr i8, ptr %st, i64 24
  %size = load i64, ptr %sizep
  store i64 %size, ptr %out
  %modep = getelementptr i8, ptr %st, i64 6
  %moden = load i16, ptr %modep
  %mode = zext i16 %moden to i64
  %fmt = and i64 %mode, 61440
  %isfile = icmp eq i64 %fmt, 32768
  %isdir = icmp eq i64 %fmt, 16384
  %k1 = select i1 %isdir, i64 1, i64 2
  %kind = select i1 %isfile, i64 0, i64 %k1
  %kindp = getelementptr i8, ptr %out, i64 8
  store i64 %kind, ptr %kindp
  %secp = getelementptr i8, ptr %st, i64 40
  %sec = load i64, ptr %secp
  %mtime = mul i64 %sec, 1000000000
  %mtimep = getelementptr i8, ptr %out, i64 16
  store i64 %mtime, ptr %mtimep
  %perm = and i64 %mode, 4095
  %permp = getelementptr i8, ptr %out, i64 24
  store i64 %perm, ptr %permp
  ret i32 0
}

; A directory: { _WDIR*, a descriptor of NUL as its key }.
define hidden ptr @nz_os_opendir(ptr %path) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret ptr null
go:
  %d = call ptr @_wopendir(ptr %w)
  call void @free(ptr %w)
  %nod = icmp eq ptr %d, null
  br i1 %nod, label %fail, label %key
key:
  %fd = call i32 (ptr, i32, ...) @_open(ptr @.nz.win.nul, i32 128)
  %nofd = icmp slt i32 %fd, 0
  br i1 %nofd, label %nokey, label %rec
nokey:
  %c = call i32 @_wclosedir(ptr %d)
  ret ptr null
rec:
  %obj = call ptr @malloc(i64 16)
  %noobj = icmp eq ptr %obj, null
  br i1 %noobj, label %nomem, label %fill
nomem:
  %c2 = call i32 @_wclosedir(ptr %d)
  %c3 = call i32 @_close(i32 %fd)
  call void @nz.win.set_errno(i32 12)
  ret ptr null
fill:
  store ptr %d, ptr %obj
  %fdp = getelementptr i8, ptr %obj, i64 8
  store i32 %fd, ptr %fdp
  ret ptr %obj
}

define hidden i32 @nz_os_dirfd(ptr %obj) {
entry:
  %fdp = getelementptr i8, ptr %obj, i64 8
  %fd = load i32, ptr %fdp
  ret i32 %fd
}

define hidden i32 @nz_os_closedir(ptr %obj) {
entry:
  %d = load ptr, ptr %obj
  %r = call i32 @_wclosedir(ptr %d)
  %fdp = getelementptr i8, ptr %obj, i64 8
  %fd = load i32, ptr %fdp
  %c = call i32 @_close(i32 %fd)
  call void @free(ptr %obj)
  ret i32 %r
}

; The next entry's name, other than `.` and `..`, into `buf` as UTF-8: its length, 0 after the
; last, a negative Linux errno on failure, -EINVAL for a name longer than `cap`. `_wdirent`'s
; name is UTF-16 at offset 8.
define hidden i64 @nz_os_readdir(ptr %obj, ptr %buf, i64 %cap) {
entry:
  %d = load ptr, ptr %obj
  br label %next
next:
  call void @nz.win.set_errno(i32 0)
  %e = call ptr @_wreaddir(ptr %d)
  %end = icmp eq ptr %e, null
  br i1 %end, label %ended, label %got
ended:
  %ep = call ptr @nz_errno_location()
  %err = load i32, ptr %ep
  %errw = sext i32 %err to i64
  %neg = sub i64 0, %errw
  ret i64 %neg
got:
  %name = getelementptr i8, ptr %e, i64 8
  %wn = call i64 @wcslen(ptr %name)
  %c0 = load i16, ptr %name
  %dot = icmp eq i16 %c0, 46
  %one = icmp eq i64 %wn, 1
  %two = icmp eq i64 %wn, 2
  %p1 = getelementptr i8, ptr %name, i64 2
  %c1 = load i16, ptr %p1
  %dot1 = icmp eq i16 %c1, 46
  %dotdot = and i1 %two, %dot1
  %short = or i1 %one, %dotdot
  %skip = and i1 %dot, %short
  br i1 %skip, label %next, label %take
take:
  %wn32 = trunc i64 %wn to i32
  %need = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %name, i32 %wn32, ptr null, i32 0, ptr null, ptr null)
  %bad = icmp eq i32 %need, 0
  br i1 %bad, label %notutf16, label %fits
notutf16:
  ret i64 -84
fits:
  %needw = sext i32 %need to i64
  %long = icmp sgt i64 %needw, %cap
  br i1 %long, label %toolong, label %copy
toolong:
  ret i64 -22
copy:
  %wrote = call i32 @WideCharToMultiByte(i32 65001, i32 128, ptr %name, i32 %wn32, ptr %buf, i32 %need, ptr null, ptr null)
  %wrotew = sext i32 %wrote to i64
  ret i64 %wrotew
}

declare ptr @nz_errno_location()

; `nz_os_close` is the network part's: a descriptor may be a socket's key.

; The C runtime counts in `int`: a request is cut to what one call can carry, which a partial
; read or write already allows.
define hidden i64 @nz_os_read(i32 %fd, ptr %buf, i64 %n) {
entry:
  %big = icmp sgt i64 %n, 1073741824
  %m = select i1 %big, i64 1073741824, i64 %n
  %m32 = trunc i64 %m to i32
  %r = call i32 @_read(i32 %fd, ptr %buf, i32 %m32)
  %w = sext i32 %r to i64
  ret i64 %w
}

define hidden i64 @nz_os_write(i32 %fd, ptr %buf, i64 %n) {
entry:
  %big = icmp sgt i64 %n, 1073741824
  %m = select i1 %big, i64 1073741824, i64 %n
  %m32 = trunc i64 %m to i32
  %r = call i32 @_write(i32 %fd, ptr %buf, i32 %m32)
  %w = sext i32 %r to i64
  ret i64 %w
}

define hidden i64 @nz_os_lseek(i32 %fd, i64 %off, i32 %whence) {
entry:
  %r = call i64 @_lseeki64(i32 %fd, i64 %off, i32 %whence)
  ret i64 %r
}

define hidden i32 @nz_os_fsync(i32 %fd) {
entry:
  %r = call i32 @_commit(i32 %fd)
  ret i32 %r
}

define hidden i32 @nz_os_unlink(ptr %path) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  %r = call i32 @_wunlink(ptr %w)
  call void @free(ptr %w)
  ret i32 %r
}

define hidden i32 @nz_os_rmdir(ptr %path) {
entry:
  %w = call ptr @nz.win.wide(ptr %path)
  %none = icmp eq ptr %w, null
  br i1 %none, label %fail, label %go
fail:
  ret i32 -1
go:
  %r = call i32 @_wrmdir(ptr %w)
  call void @free(ptr %w)
  ret i32 %r
}

; As POSIX `rename`: an existing destination is replaced (MOVEFILE_REPLACE_EXISTING).
define hidden i32 @nz_os_rename(ptr %from, ptr %to) {
entry:
  %wa = call ptr @nz.win.wide(ptr %from)
  %na = icmp eq ptr %wa, null
  br i1 %na, label %fail, label %second
fail:
  ret i32 -1
second:
  %wb = call ptr @nz.win.wide(ptr %to)
  %nb = icmp eq ptr %wb, null
  br i1 %nb, label %faila, label %go
faila:
  call void @free(ptr %wa)
  ret i32 -1
go:
  %ok = call i32 @MoveFileExW(ptr %wa, ptr %wb, i32 1)
  %failed = icmp eq i32 %ok, 0
  br i1 %failed, label %err, label %done
err:
  %e = call i32 @nz.win.last_errno()
  call void @free(ptr %wa)
  call void @free(ptr %wb)
  call void @nz.win.set_errno(i32 %e)
  ret i32 -1
done:
  call void @free(ptr %wa)
  call void @free(ptr %wb)
  ret i32 0
}

; The system's preferred generator (BCRYPT_USE_SYSTEM_PREFERRED_RNG).
define hidden i32 @nz_os_entropy(ptr %buf, i64 %n) {
entry:
  %n32 = trunc i64 %n to i32
  %st = call i32 @BCryptGenRandom(ptr null, ptr %buf, i32 %n32, i32 2)
  %ok = icmp eq i32 %st, 0
  br i1 %ok, label %done, label %fail
fail:
  call void @nz.win.set_errno(i32 5)
  ret i32 -1
done:
  ret i32 0
}

; The C runtime's message for a status, its Linux number taken back to the C runtime's first.
define hidden i64 @nz_os_error_text(i64 %status, ptr %buf, i64 %cap) {
entry:
  %neg = icmp slt i64 %status, 0
  %fits = icmp sgt i64 %status, -2147483648
  %ask = and i1 %neg, %fits
  br i1 %ask, label %text, label %none
none:
  ret i64 0
text:
  %l = sub i64 0, %status
  %l32 = trunc i64 %l to i32
  switch i32 %l32, label %same [
    i32 35, label %deadlk
    i32 36, label %nametoolong
    i32 37, label %nolck
    i32 38, label %nosys
    i32 39, label %notempty
    i32 84, label %ilseq
  ]
deadlk:
  br label %ask2
nametoolong:
  br label %ask2
nolck:
  br label %ask2
nosys:
  br label %ask2
notempty:
  br label %ask2
ilseq:
  br label %ask2
same:
  br label %ask2
ask2:
  %c = phi i32 [ 36, %deadlk ], [ 38, %nametoolong ], [ 39, %nolck ], [ 40, %nosys ], [ 41, %notempty ], [ 42, %ilseq ], [ %l32, %same ]
  %msg = call ptr @strerror(i32 %c)
  %n = call i64 @strlen(ptr %msg)
  %long = icmp sgt i64 %n, %cap
  %take = select i1 %long, i64 %cap, i64 %n
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %msg, i64 %take, i1 false)
  ret i64 %take
}
"#
}

pub fn rt_platform_WINDOWS_NET() -> Str ! {} {
    r#"
declare i64 @socket(i32, i32, i32)
declare i32 @ioctlsocket(i64, i32, ptr)
declare i32 @getsockopt(i64, i32, i32, ptr, ptr)
declare i32 @connect(i64, ptr, i32)
declare i32 @send(i64, ptr, i32, i32)
declare i32 @sendto(i64, ptr, i32, i32, ptr, i32)
declare i32 @recv(i64, ptr, i32, i32)
declare i32 @recvfrom(i64, ptr, i32, i32, ptr, ptr)
declare i32 @bind(i64, ptr, i32)
declare i32 @listen(i64, i32)
declare i64 @accept(i64, ptr, ptr)
declare i32 @shutdown(i64, i32)
declare i32 @getsockname(i64, ptr, ptr)
declare i32 @getpeername(i64, ptr, ptr)
declare i32 @closesocket(i64)
declare i32 @WSAGetLastError()
declare i32 @WSAPoll(ptr, i32, i32)
declare void @AcquireSRWLockExclusive(ptr)
declare void @ReleaseSRWLockExclusive(ptr)
declare void @Sleep(i32)
declare i64 @_get_osfhandle(i32)
declare i32 @_open_osfhandle(i64, i32)
declare i32 @GetFileType(i64)
declare i32 @SetNamedPipeHandleState(i64, ptr, ptr, ptr)
declare i32 @PeekNamedPipe(i64, ptr, i32, ptr, ptr, ptr)
declare i32 @ReadFile(i64, ptr, i32, ptr, ptr)
declare i32 @WriteFile(i64, ptr, i32, ptr, ptr)
declare i32 @CreatePipe(ptr, ptr, ptr, i32)
declare i32 @SetHandleInformation(i64, i32, i32)
declare i32 @CreateProcessW(ptr, ptr, ptr, ptr, i32, i32, ptr, ptr, ptr, ptr)
declare i32 @CloseHandle(i64)
declare i32 @WaitForSingleObject(i64, i32)
declare i32 @GetExitCodeProcess(i64, ptr)
declare i32 @TerminateProcess(i64, i32)

; A socket descriptor's socket: a descriptor of `NUL` is the key (as a directory's is), this table
; the socket it stands for, 0 for none. The C runtime holds at most a few thousand descriptors.
@nz.win.socks = internal global [4096 x i64] zeroinitializer
; The reactor's interest, one-shot as epoll's: each descriptor's directions (1 read, 2 write), 0
; once it has fired, and the handle its event wakes; `top` bounds the descriptors ever armed.
@nz.win.want = internal global [4096 x i64] zeroinitializer
@nz.win.udata = internal global [4096 x i64] zeroinitializer
@nz.win.top = internal global i64 0
@nz.win.lock = internal global ptr null
; A UDP socket connected to itself: a byte sent to it wakes the reactor out of `WSAPoll` to see a
; new interest. 0 when it could not be made, and the reactor looks again every 20 ms instead.
@nz.win.wake = internal global i64 0
; The reactor's own `WSAPOLLFD`s (16 bytes each) and the descriptor each stands for, -1 the wake.
@nz.win.fds = internal global [65552 x i8] zeroinitializer, align 8
@nz.win.idx = internal global [4097 x i32] zeroinitializer

; Winsock's error `w` in Linux's numbering.
define internal i32 @nz.win.wsa_map(i32 %w) {
entry:
  switch i32 %w, label %other [
    i32 8, label %e12
    i32 10004, label %e4
    i32 10009, label %e9
    i32 10013, label %e13
    i32 10014, label %e14
    i32 10022, label %e22
    i32 10024, label %e24
    i32 10035, label %e11
    i32 10036, label %e115
    i32 10037, label %e114
    i32 10038, label %e88
    i32 10039, label %e89
    i32 10040, label %e90
    i32 10041, label %e91
    i32 10042, label %e92
    i32 10043, label %e93
    i32 10045, label %e95
    i32 10047, label %e97
    i32 10048, label %e98
    i32 10049, label %e99
    i32 10050, label %e100
    i32 10051, label %e101
    i32 10052, label %e102
    i32 10053, label %e103
    i32 10054, label %e104
    i32 10055, label %e105
    i32 10056, label %e106
    i32 10057, label %e107
    i32 10058, label %e32
    i32 10060, label %e110
    i32 10061, label %e111
    i32 10064, label %e112
    i32 10065, label %e113
  ]
e12:
  ret i32 12
e4:
  ret i32 4
e9:
  ret i32 9
e13:
  ret i32 13
e14:
  ret i32 14
e22:
  ret i32 22
e24:
  ret i32 24
e11:
  ret i32 11
e115:
  ret i32 115
e114:
  ret i32 114
e88:
  ret i32 88
e89:
  ret i32 89
e90:
  ret i32 90
e91:
  ret i32 91
e92:
  ret i32 92
e93:
  ret i32 93
e95:
  ret i32 95
e97:
  ret i32 97
e98:
  ret i32 98
e99:
  ret i32 99
e100:
  ret i32 100
e101:
  ret i32 101
e102:
  ret i32 102
e103:
  ret i32 103
e104:
  ret i32 104
e105:
  ret i32 105
e106:
  ret i32 106
e107:
  ret i32 107
e32:
  ret i32 32
e110:
  ret i32 110
e111:
  ret i32 111
e112:
  ret i32 112
e113:
