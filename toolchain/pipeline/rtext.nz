pub fn rt_core_JOIN_RUNTIME() -> Str ! {} {
    r#"
define hidden { ptr, i64, ptr } @nz.str_join(ptr %h, ptr %sp, i64 %sn) {
entry:
  %n = load i64, ptr %h
  %dp = getelementptr i8, ptr %h, i64 16
  %data = load ptr, ptr %dp
  br label %sum
sum:
  %i = phi i64 [ 0, %entry ], [ %i2, %sumbody ]
  %acc = phi i64 [ 0, %entry ], [ %acc2, %sumbody ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %sumbody, label %alloc
sumbody:
  %e = getelementptr { ptr, i64, ptr }, ptr %data, i64 %i
  %lp = getelementptr i8, ptr %e, i64 8
  %li = load i64, ptr %lp
  %acc2 = add i64 %acc, %li
  %i2 = add i64 %i, 1
  br label %sum
alloc:
  ; One separator between each pair, so n-1 of them, and none for an empty sequence.
  %less = sub i64 %n, 1
  %neg = icmp slt i64 %less, 0
  %gaps = select i1 %neg, i64 0, i64 %less
  %sepbytes = mul i64 %gaps, %sn
  %total = add i64 %acc, %sepbytes
  ; One byte more, so an empty result still owns storage and its pointer stays valid.
  %room = add i64 %total, 1
  %own = call ptr @nz.str_alloc(i64 %room)
  %bad = icmp eq ptr %own, null
  br i1 %bad, label %fail, label %copy
copy:
  %buf = getelementptr i8, ptr %own, i64 16
  br label %loop
loop:
  %j = phi i64 [ 0, %copy ], [ %j2, %tail ]
  %off = phi i64 [ 0, %copy ], [ %off3, %tail ]
  %more2 = icmp slt i64 %j, %n
  br i1 %more2, label %body, label %done
body:
  %first = icmp eq i64 %j, 0
  br i1 %first, label %tail, label %gap
gap:
  %d1 = getelementptr i8, ptr %buf, i64 %off
  call void @llvm.memcpy.p0.p0.i64(ptr %d1, ptr %sp, i64 %sn, i1 false)
  %off1 = add i64 %off, %sn
  br label %tail
tail:
  %off2 = phi i64 [ %off, %body ], [ %off1, %gap ]
  %e2 = getelementptr { ptr, i64, ptr }, ptr %data, i64 %j
  %p2 = load ptr, ptr %e2
  %l2p = getelementptr i8, ptr %e2, i64 8
  %l2 = load i64, ptr %l2p
  %d2 = getelementptr i8, ptr %buf, i64 %off2
  call void @llvm.memcpy.p0.p0.i64(ptr %d2, ptr %p2, i64 %l2, i1 false)
  %off3 = add i64 %off2, %l2
  %j2 = add i64 %j, 1
  br label %loop
done:
  %a = insertvalue { ptr, i64, ptr } undef, ptr %buf, 0
  %b = insertvalue { ptr, i64, ptr } %a, i64 %total, 1
  %b2 = insertvalue { ptr, i64, ptr } %b, ptr %own, 2
  ret { ptr, i64, ptr } %b2
fail:
  %z = insertvalue { ptr, i64, ptr } undef, ptr null, 0
  %z2 = insertvalue { ptr, i64, ptr } %z, i64 0, 1
  %z3 = insertvalue { ptr, i64, ptr } %z2, ptr null, 2
  ret { ptr, i64, ptr } %z3
}
"#
}

pub fn rt_core_IO_RUNTIME() -> Str ! {} {
    r#"
define hidden ptr @nz.cstr(ptr %p, i64 %n) {
entry:
  %room = add i64 %n, 1
  %buf = call ptr @malloc(i64 %room)
  %bad = icmp eq ptr %buf, null
  br i1 %bad, label %fail, label %ok
fail:
  ret ptr null
ok:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %p, i64 %n, i1 false)
  %end = getelementptr i8, ptr %buf, i64 %n
  store i8 0, ptr %end
  ret ptr %buf
}

define hidden i1 @nz.file_exists(ptr %p, i64 %n) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %no, label %open
open:
  %f = call ptr @fopen(ptr %path, ptr @.rb)
  ; The terminated copy has done its job the moment `fopen` returns. Until N8 every file
  ; operation leaked one of these.
  call void @free(ptr %path)
  %missing = icmp eq ptr %f, null
  br i1 %missing, label %no, label %yes
yes:
  %ignored = call i32 @fclose(ptr %f)
  ret i1 true
no:
  ret i1 false
}

define hidden { ptr, i64, ptr } @nz.read_file(ptr %p, i64 %n) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %fail, label %open
open:
  %f = call ptr @fopen(ptr %path, ptr @.rb)
  call void @free(ptr %path)
  %missing = icmp eq ptr %f, null
  br i1 %missing, label %fail, label %measure
measure:
  ; SEEK_END is 2 and SEEK_SET is 0 on every target this is verified against.
  %e = call i32 @fseek(ptr %f, i64 0, i32 2)
  %len = call i64 @ftell(ptr %f)
  %unmeasurable = icmp slt i64 %len, 0
  br i1 %unmeasurable, label %closefail, label %reserve
reserve:
  %s = call i32 @fseek(ptr %f, i64 0, i32 0)
  ; One byte more than the file, so an empty file still owns storage and its pointer
  ; stays valid to compare.
  %room = add i64 %len, 1
  %own = call ptr @nz.str_alloc(i64 %room)
  %nobuf = icmp eq ptr %own, null
  br i1 %nobuf, label %closefail, label %read
read:
  %buf = getelementptr i8, ptr %own, i64 16
  %got = call i64 @fread(ptr %buf, i64 1, i64 %len, ptr %f)
  %c = call i32 @fclose(ptr %f)
  %short = icmp ne i64 %got, %len
  br i1 %short, label %partial, label %done
partial:
  ; A short read is a failure, and the storage it was going to fill is released rather
  ; than abandoned.
  call void @nz.str_release(ptr %own)
  br label %fail
done:
  %a = insertvalue { ptr, i64, ptr } undef, ptr %buf, 0
  %b = insertvalue { ptr, i64, ptr } %a, i64 %len, 1
  %b2 = insertvalue { ptr, i64, ptr } %b, ptr %own, 2
  ret { ptr, i64, ptr } %b2
closefail:
  %c2 = call i32 @fclose(ptr %f)
  br label %fail
fail:
  %z = insertvalue { ptr, i64, ptr } undef, ptr null, 0
  %z2 = insertvalue { ptr, i64, ptr } %z, i64 0, 1
  %z3 = insertvalue { ptr, i64, ptr } %z2, ptr null, 2
  ret { ptr, i64, ptr } %z3
}

define hidden i64 @nz.write_file(ptr %pp, i64 %pn, ptr %dp, i64 %dn) {
entry:
  %path = call ptr @nz.cstr(ptr %pp, i64 %pn)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %fail, label %open
open:
  %f = call ptr @fopen(ptr %path, ptr @.wb)
  call void @free(ptr %path)
  %missing = icmp eq ptr %f, null
  br i1 %missing, label %fail, label %write
write:
  %got = call i64 @fwrite(ptr %dp, i64 1, i64 %dn, ptr %f)
  %c = call i32 @fclose(ptr %f)
  %short = icmp ne i64 %got, %dn
  br i1 %short, label %fail, label %done
done:
  ret i64 %got
fail:
  ret i64 -1
}
"#
}

pub fn rt_core_SEQUENCE_RUNTIME() -> Str ! {} {
    r#"
define hidden ptr @nz.arr_new() {
entry:
  %h = call ptr @malloc(i64 32)
  %bad = icmp eq ptr %h, null
  br i1 %bad, label %fail, label %ok
fail:
  ret ptr null
ok:
  store i64 0, ptr %h
  %capp = getelementptr i8, ptr %h, i64 8
  store i64 0, ptr %capp
  %datap = getelementptr i8, ptr %h, i64 16
  store ptr null, ptr %datap
  ; Born with one reference: the expression that produced it. Whoever consumes that
  ; expression either takes the reference over or releases it.
  %rcp = getelementptr i8, ptr %h, i64 24
  store i64 1, ptr %rcp
  ret ptr %h
}

define hidden void @nz.arr_retain(ptr %h) {
entry:
  %none = icmp eq ptr %h, null
  br i1 %none, label %done, label %bump
bump:
  %rcp = getelementptr i8, ptr %h, i64 24
  %rc = load i64, ptr %rcp
  %rc2 = add i64 %rc, 1
  store i64 %rc2, ptr %rcp
  br label %done
done:
  ret void
}

define hidden i1 @nz.arr_release(ptr %h) {
entry:
  %none = icmp eq ptr %h, null
  br i1 %none, label %kept, label %drop
drop:
  %rcp = getelementptr i8, ptr %h, i64 24
  %rc = load i64, ptr %rcp
  %rc2 = sub i64 %rc, 1
  store i64 %rc2, ptr %rcp
  %last = icmp sle i64 %rc2, 0
  br i1 %last, label %free, label %kept
free:
  ; The data buffer first, then the header: after the header is freed its `data` field
  ; may not be read, and reading it is how this would become a use-after-free of its own.
  %datap = getelementptr i8, ptr %h, i64 16
  %data = load ptr, ptr %datap
  call void @free(ptr %data)
  call void @free(ptr %h)
  ret i1 true
kept:
  ret i1 false
}

; The counted pair. `@nz.arr_new` and `@nz.arr_release` are the allocator; these two are
; the allocator plus the bookkeeping that makes reclamation checkable. The scope machinery
; uses the uncounted pair for its list of task ids, which is not a Nazm value and must not
; appear in a report about the program's sequences.
define hidden ptr @nz.seq_new() {
entry:
  %h = call ptr @nz.arr_new()
  %bad = icmp eq ptr %h, null
  br i1 %bad, label %done, label %count
count:
  ; Atomic, unlike the reference count beside it: a *task* may create a sequence of its
  ; own, so two threads can reach this counter even though `N0321` stops them reaching
  ; one sequence. Until N8 this was an ordinary load-add-store and a concurrent program
  ; could under-report what it had allocated.
  %c = atomicrmw add ptr @nz.seq_allocated, i64 1 monotonic
  br label %done
done:
  ret ptr %h
}

define hidden void @nz.seq_release(ptr %h) {
entry:
  %freed = call i1 @nz.arr_release(ptr %h)
  br i1 %freed, label %count, label %done
count:
  %c = atomicrmw add ptr @nz.seq_reclaimed, i64 1 monotonic
  br label %done
done:
  ret void
}

define hidden ptr @nz.arr_grow(ptr %h, i64 %elem) {
entry:
  %len = load i64, ptr %h
  %capp = getelementptr i8, ptr %h, i64 8
  %cap = load i64, ptr %capp
  %datap = getelementptr i8, ptr %h, i64 16
  %full = icmp sge i64 %len, %cap
  br i1 %full, label %grow, label %done
grow:
  ; Doubling, with a floor of four. `realloc(null, n)` is `malloc(n)`, so the first
  ; growth needs no special case. Both products are checked: an element may be a record
  ; or an enum of any size since N11, and a wrapped size would allocate less than the
  ; caller is about to write.
  %twice.r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %cap, i64 2)
  %twice = extractvalue {i64, i1} %twice.r, 0
  %twice.o = extractvalue {i64, i1} %twice.r, 1
  %tiny = icmp slt i64 %twice, 4
  %want = select i1 %tiny, i64 4, i64 %twice
  %bytes.r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %want, i64 %elem)
  %bytes = extractvalue {i64, i1} %bytes.r, 0
  %bytes.o = extractvalue {i64, i1} %bytes.r, 1
  %over = or i1 %twice.o, %bytes.o
  br i1 %over, label %oom, label %sized
sized:
  %old = load ptr, ptr %datap
  %new = call ptr @realloc(ptr %old, i64 %bytes)
  %failed = icmp eq ptr %new, null
  br i1 %failed, label %oom, label %kept
kept:
  ; The header is updated only after the allocation succeeded, so a failed growth
  ; leaves the sequence exactly as it was rather than half-resized.
  store ptr %new, ptr %datap
  store i64 %want, ptr %capp
  br label %done
oom:
  ret ptr null
done:
  %data = load ptr, ptr %datap
  ret ptr %data
}
"#
}

pub fn rt_core_STRING_RUNTIME() -> Str ! {} {
    r#"
define hidden ptr @nz.str_alloc(i64 %n) {
entry:
  ; Checked, because a length that overflows here would allocate less than the caller is
  ; about to write. `docs/spec.md` reports it as N0406 at the call site.
  %r = call {i64, i1} @llvm.uadd.with.overflow.i64(i64 %n, i64 16)
  %over = extractvalue {i64, i1} %r, 1
  br i1 %over, label %fail, label %ask
ask:
  %room = extractvalue {i64, i1} %r, 0
  %b = call ptr @malloc(i64 %room)
  %bad = icmp eq ptr %b, null
  br i1 %bad, label %fail, label %ok
fail:
  ret ptr null
ok:
  store i64 1, ptr %b
  %lenp = getelementptr i8, ptr %b, i64 8
  store i64 %n, ptr %lenp
  %c = atomicrmw add ptr @nz.str_allocated, i64 1 monotonic
  ret ptr %b
}

define hidden void @nz.str_retain(ptr %b) {
entry:
  ; Null is immortal or external storage: a literal, or a process argument. Nothing to
  ; count, and nothing this program may ever free.
  %none = icmp eq ptr %b, null
  br i1 %none, label %done, label %bump
bump:
  %old = atomicrmw add ptr %b, i64 1 monotonic
  br label %done
done:
  ret void
}

define hidden void @nz.str_release(ptr %b) {
entry:
  %none = icmp eq ptr %b, null
  br i1 %none, label %done, label %drop
drop:
  %old = atomicrmw sub ptr %b, i64 1 release
  %last = icmp eq i64 %old, 1
  br i1 %last, label %free, label %done
free:
  fence acquire
  ; An atomic's cell (`nz.atomic_cell`) marks its length -1: it is not a string, and the
  ; memory report does not count it.
  %lenp = getelementptr i8, ptr %b, i64 8
  %len = load i64, ptr %lenp
  call void @free(ptr %b)
  %cell = icmp slt i64 %len, 0
  br i1 %cell, label %done, label %count
count:
  %c = atomicrmw add ptr @nz.str_reclaimed, i64 1 monotonic
  br label %done
done:
  ret void
}

; An `Atomic`'s cell (`docs/spec.md`, *Atomics*): a backing of the string's shape, so it is
; retained and released as a `Str`'s is, holding `v` in its 8 bytes, with its length -1 so that
; `nz.str_release` frees it uncounted. An atomic is not a string: the memory report counts
; neither its allocation nor its reclamation, as the interpreter does not (runtime ABI 38).
define hidden ptr @nz.atomic_cell(i64 %v) {
entry:
  %b = call ptr @malloc(i64 24)
  %bad = icmp eq ptr %b, null
  br i1 %bad, label %fail, label %ok
fail:
  ret ptr null
ok:
  store i64 1, ptr %b
  %lenp = getelementptr i8, ptr %b, i64 8
  store i64 -1, ptr %lenp
  %cellp = getelementptr i8, ptr %b, i64 16
  store i64 %v, ptr %cellp
  ret ptr %b
}

; A `Strs` owns a reference to every string in it, so its storage cannot be released by
; the helper an `Ints` uses. Elements first, then the array, then the header — the order
; matters, because reading an element out of a buffer that has already been freed is the
; use-after-free this whole milestone exists to make impossible.
define hidden void @nz.strs_release(ptr %h) {
entry:
  %none = icmp eq ptr %h, null
  br i1 %none, label %done, label %drop
drop:
  %rcp = getelementptr i8, ptr %h, i64 24
  %rc = load i64, ptr %rcp
  %rc2 = sub i64 %rc, 1
  store i64 %rc2, ptr %rcp
  %last = icmp sle i64 %rc2, 0
  br i1 %last, label %contents, label %done
contents:
  %n = load i64, ptr %h
  %dp = getelementptr i8, ptr %h, i64 16
  %data = load ptr, ptr %dp
  br label %test
test:
  %i = phi i64 [ 0, %contents ], [ %next, %body ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %body, label %storage
body:
  %e = getelementptr { ptr, i64, ptr }, ptr %data, i64 %i
  %op = getelementptr i8, ptr %e, i64 16
  %owner = load ptr, ptr %op
  call void @nz.str_release(ptr %owner)
  %next = add i64 %i, 1
  br label %test
storage:
  call void @free(ptr %data)
  call void @free(ptr %h)
  %c = atomicrmw add ptr @nz.seq_reclaimed, i64 1 monotonic
  br label %done
done:
  ret void
}
"#
}

pub fn rt_core_TASK_RUNTIME() -> Str ! {} {
    r#"
define hidden i32 @nz.spawn(ptr %h, ptr %fn, ptr %blk) {
entry:
  ; Every task thread has 8 MiB of stack (N49): the size `nz.stack_check` budgets from, and
  ; Linux's default already. The attribute object is opaque; 128 bytes covers every v1 target.
  %attr = alloca [128 x i8], align 16
  %data = call ptr @nz.arr_grow(ptr %h, i64 8)
  %oom = icmp eq ptr %data, null
  br i1 %oom, label %nomem, label %record
nomem:
  ret i32 -1
record:
  %len = load i64, ptr %h
  %slot = getelementptr i64, ptr %data, i64 %len
  %raw = ptrtoint ptr %blk to i64
  store i64 %raw, ptr %slot
  %next = add i64 %len, 1
  store i64 %next, ptr %h
  %ai = call i32 @pthread_attr_init(ptr %attr)
  %sbt = load i64, ptr @nz.stack_bytes
  %sbtset = icmp ne i64 %sbt, 0
  %sbtsize = select i1 %sbtset, i64 %sbt, i64 8388608
  %as = call i32 @pthread_attr_setstacksize(ptr %attr, i64 %sbtsize)
  %rc = call i32 @pthread_create(ptr %blk, ptr %attr, ptr %fn, ptr %blk)
  %ad = call i32 @pthread_attr_destroy(ptr %attr)
  %bad = icmp ne i32 %rc, 0
  br i1 %bad, label %undo, label %ok
undo:
  store i64 %len, ptr %h
  ret i32 1
ok:
  ret i32 0
}

; Joins every task and reports the first failure any of them had, as { message, length },
; or { null, 0 } if none did.
;
; **Every** task is joined before anything is reported, including after one has been found
; to have failed — returning at the first would leave the rest running, and a scope that
; does not contain its tasks is not a scope. The failure taken is the earliest by position
; in the list, which is the order the tasks were spawned in, so which one is reported does
; not depend on which thread happened to finish first.
;
; No lock is needed. A task writes its own diagnostic into its own argument block before
; its thread ends, and this reads that block only after `pthread_join` has returned for
; it, which is a happens-before edge.
define hidden { ptr, i64 } @nz.scope_join(ptr %h) {
entry:
  ; The count is read once. Nothing can be added while this runs: the scope's body has
  ; finished by every path that reaches here, and a task cannot spawn into its parent.
  %n = load i64, ptr %h
  %dp = getelementptr i8, ptr %h, i64 16
  %data = load ptr, ptr %dp
  br label %test
test:
  %i = phi i64 [ 0, %entry ], [ %next, %after ]
  %msg = phi ptr [ null, %entry ], [ %msg2, %after ]
  %len = phi i64 [ 0, %entry ], [ %len2, %after ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %body, label %done
body:
  %ep = getelementptr i64, ptr %data, i64 %i
  %raw = load i64, ptr %ep
  %blk = inttoptr i64 %raw to ptr
  %tid = load ptr, ptr %blk
  %rc = call i32 @pthread_join(ptr %tid, ptr null)
  ; Joined, so the thread has ended and nothing will read this block again. Its arguments
  ; were released by the trampoline on its way out; this is the block itself, one
  ; `malloc` per `spawn` that until N8 nothing ever gave back.
  ; The task's own diagnostic, at a fixed offset in the block it was given.
  %emp = getelementptr i8, ptr %blk, i64 8
  %em = load ptr, ptr %emp
  %elp = getelementptr i8, ptr %blk, i64 16
  %el = load i64, ptr %elp
  %none = icmp eq ptr %msg, null
  %this = icmp ne ptr %em, null
  %take = and i1 %none, %this
  ; Read before the block is freed, and the message itself is a constant in the object's
  ; read-only data rather than anything the block owns — so what is carried out stays
  ; valid after the free below.
  call void @free(ptr %blk)
  br i1 %take, label %first, label %after
first:
  br label %after
after:
  %msg2 = phi ptr [ %em, %first ], [ %msg, %body ]
  %len2 = phi i64 [ %el, %first ], [ %len, %body ]
  %next = add i64 %i, 1
  br label %test
done:
  %r0 = insertvalue { ptr, i64 } undef, ptr %msg, 0
  %r1 = insertvalue { ptr, i64 } %r0, i64 %len, 1
  ret { ptr, i64 } %r1
}
"#
}

pub fn rt_core_SELECT_RUNTIME() -> Str ! {} {
    r#"
@nz.sel_gen = hidden global i64 0
@nz.sel_waiters = hidden global i64 0
@nz.sel_sync = hidden global ptr null

define hidden ptr @nz.sel_sync_get() {
entry:
  %s = load atomic ptr, ptr @nz.sel_sync acquire, align 8
  %unmade = icmp eq ptr %s, null
  br i1 %unmade, label %make, label %have
have:
  ret ptr %s
make:
  %fresh = call ptr @malloc(i64 256)
  %oom = icmp eq ptr %fresh, null
  br i1 %oom, label %nomem, label %init
nomem:
  ret ptr null
init:
  %mi = call i32 @pthread_mutex_init(ptr %fresh, ptr null)
  %fcv = getelementptr i8, ptr %fresh, i64 128
  %ci = call i32 @pthread_cond_init(ptr %fcv, ptr null)
  %pair = cmpxchg ptr @nz.sel_sync, ptr null, ptr %fresh acq_rel acquire
  %won = extractvalue {ptr, i1} %pair, 1
  br i1 %won, label %mine, label %theirs
mine:
  ret ptr %fresh
theirs:
  %md = call i32 @pthread_mutex_destroy(ptr %fresh)
  %cd = call i32 @pthread_cond_destroy(ptr %fcv)
  call void @free(ptr %fresh)
  %other = extractvalue {ptr, i1} %pair, 0
  ret ptr %other
}

; Called after a typed channel changed in a way a selector waits for: a value queued, or a close.
define hidden void @nz.sel_signal() {
entry:
  %gen = atomicrmw add ptr @nz.sel_gen, i64 1 seq_cst
  %who = load atomic i64, ptr @nz.sel_waiters seq_cst, align 8
  %any = icmp sgt i64 %who, 0
  br i1 %any, label %wake, label %quiet
wake:
  %s = call ptr @nz.sel_sync_get()
  %lost = icmp eq ptr %s, null
  br i1 %lost, label %quiet, label %tell
tell:
  %l = call i32 @pthread_mutex_lock(ptr %s)
  %scv = getelementptr i8, ptr %s, i64 128
  %bc = call i32 @pthread_cond_broadcast(ptr %scv)
  %u = call i32 @pthread_mutex_unlock(ptr %s)
  br label %quiet
quiet:
  ret void
}

; `chan_close_of`: the `Int` channel's close, then the event a selector waits for.
define hidden void @nz.chanv_close(ptr %c) {
entry:
  call void @nz.chan_close(ptr %c)
  call void @nz.sel_signal()
  ret void
}

; One look at one channel, without waiting: 1 and the oldest slot copied out to `%dst` (its
; reference handed over), 2 when closed and drained, 0 when neither.
define hidden i64 @nz.chanv_try(ptr %c, ptr %dst) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %lenp = getelementptr i8, ptr %c, i64 8
  %headp = getelementptr i8, ptr %c, i64 16
  %closedp = getelementptr i8, ptr %c, i64 24
  %datap = getelementptr i8, ptr %c, i64 32
  %sp = getelementptr i8, ptr %c, i64 64
  %stride = load i64, ptr %sp
  %l = call i32 @pthread_mutex_lock(ptr %m)
  %queued = load i64, ptr %lenp
  %has = icmp sgt i64 %queued, 0
  br i1 %has, label %take, label %ask
ask:
  %shut = load i64, ptr %closedp
  %isshut = icmp ne i64 %shut, 0
  %why = select i1 %isshut, i64 2, i64 0
  %u1 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i64 %why
take:
  %head = load i64, ptr %headp
  %cap = load i64, ptr %c
  %data = load ptr, ptr %datap
  %off = mul i64 %head, %stride
  %slot = getelementptr i8, ptr %data, i64 %off
  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %slot, i64 %stride, i1 false)
  %h1 = add i64 %head, 1
  %nh = urem i64 %h1, %cap
  store i64 %nh, ptr %headp
  %left = sub i64 %queued, 1
  store i64 %left, ptr %lenp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u2 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i64 1
}

; `%h` is a `Vec[Chan[T]]`; `%timed` nonzero gives up after `%ms` milliseconds. The result:
; `i` a value from channel `i` in `%dst`, `-3 - i` channel `i` closed and drained, `-1` no
; channels, `-2` timed out, and the most negative `i64` out of memory — which no `-3 - i`
; can be. The lowest ready index wins.
define hidden i64 @nz.chanv_select(ptr %h, ptr %dst, i64 %ms, i64 %timed) {
entry:
  %ts = alloca [2 x i64], align 8
  %now = alloca [2 x i64], align 8
  %count = load i64, ptr %h
  %nothing = icmp sle i64 %count, 0
  br i1 %nothing, label %none, label %setup
none:
  ret i64 -1
setup:
  %s = call ptr @nz.sel_sync_get()
  %oom = icmp eq ptr %s, null
  br i1 %oom, label %nomem, label %counted
nomem:
  ret i64 -9223372036854775808
counted:
  %sel = atomicrmw add ptr @nz.sched_selects, i64 1 monotonic
  %in = atomicrmw add ptr @nz.sel_waiters, i64 1 seq_cst
  %istimed = icmp ne i64 %timed, 0
  br i1 %istimed, label %deadline, label %look
deadline:
  ; `nz_os_clock` 4 is the monotonic clock: a deadline no step of the wall clock moves (Q1-M-12).
  %r0 = call i32 @nz_os_clock(i32 4, ptr %ts)
  %sec0 = load i64, ptr %ts
  %tsn = getelementptr i8, ptr %ts, i64 8
  %nsec0 = load i64, ptr %tsn
  %pos = icmp sgt i64 %ms, 0
  %wait_ms = select i1 %pos, i64 %ms, i64 0
  %addsec = sdiv i64 %wait_ms, 1000
  %addms = srem i64 %wait_ms, 1000
  %addns = mul i64 %addms, 1000000
  %ns1 = add i64 %nsec0, %addns
  %carry = icmp sge i64 %ns1, 1000000000
  %ns2 = sub i64 %ns1, 1000000000
  %nsf = select i1 %carry, i64 %ns2, i64 %ns1
  %sec1 = add i64 %sec0, %addsec
  %sec2 = add i64 %sec1, 1
  %secf = select i1 %carry, i64 %sec2, i64 %sec1
  store i64 %secf, ptr %ts
  store i64 %nsf, ptr %tsn
  br label %look
look:
  %g0 = load atomic i64, ptr @nz.sel_gen seq_cst, align 8
  %cdp = getelementptr i8, ptr %h, i64 16
  %cdata = load ptr, ptr %cdp
  br label %scan
scan:
  %i = phi i64 [ 0, %look ], [ %inext, %onward ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %probe, label %idle
probe:
  %coff = mul i64 %i, 8
  %cpp = getelementptr i8, ptr %cdata, i64 %coff
  %ch = load ptr, ptr %cpp
  %got = call i64 @nz.chanv_try(ptr %ch, ptr %dst)
  %took = icmp eq i64 %got, 1
  br i1 %took, label %value, label %closedq
closedq:
  %drained = icmp eq i64 %got, 2
  br i1 %drained, label %ended, label %onward
onward:
  %inext = add i64 %i, 1
  br label %scan
value:
  %o1 = atomicrmw sub ptr @nz.sel_waiters, i64 1 seq_cst
  ret i64 %i
ended:
  %o2 = atomicrmw sub ptr @nz.sel_waiters, i64 1 seq_cst
  %enc = sub i64 -3, %i
  ret i64 %enc
idle:
  br i1 %istimed, label %check, label %wait
check:
  %r1 = call i32 @nz_os_clock(i32 4, ptr %now)
  %nsec = load i64, ptr %now
  %nwn = getelementptr i8, ptr %now, i64 8
  %nnsec = load i64, ptr %nwn
  %dsec = load i64, ptr %ts
  %dtn = getelementptr i8, ptr %ts, i64 8
  %dnsec = load i64, ptr %dtn
  %later = icmp sgt i64 %nsec, %dsec
  %samesec = icmp eq i64 %nsec, %dsec
  %nslate = icmp sge i64 %nnsec, %dnsec
  %atlast = and i1 %samesec, %nslate
  %past = or i1 %later, %atlast
  br i1 %past, label %timeout, label %wait
timeout:
  %o3 = atomicrmw sub ptr @nz.sel_waiters, i64 1 seq_cst
  %to = atomicrmw add ptr @nz.sched_timeouts, i64 1 monotonic
  ret i64 -2
wait:
  %wl = call i32 @pthread_mutex_lock(ptr %s)
  %wcv = getelementptr i8, ptr %s, i64 128
  br label %recheck
recheck:
  %g1 = load atomic i64, ptr @nz.sel_gen seq_cst, align 8
  %still = icmp eq i64 %g1, %g0
  br i1 %still, label %sleep, label %woke
sleep:
  br i1 %istimed, label %tsleep, label %fsleep
tsleep:
  ; Woken, timed out or spurious alike: look again, and the deadline check decides. Through
  ; `nz.ctimedwait`, which takes the monotonic deadline (Q1-M-12).
  %tw = call i32 @nz.ctimedwait(ptr %wcv, ptr %s, ptr %ts)
  br label %woke
fsleep:
  %fw = call i32 @pthread_cond_wait(ptr %wcv, ptr %s)
  br label %recheck
woke:
  %wu = call i32 @pthread_mutex_unlock(ptr %s)
  br label %look
}

; A monotonic clock in milliseconds: `nz_os_clock` 4, the platform's monotonic clock (Gate 3).
define hidden i64 @nz.time_now_ms() {
entry:
  %tp = alloca [2 x i64], align 8
  %r = call i32 @nz_os_clock(i32 4, ptr %tp)
  %sec = load i64, ptr %tp
  %tpn = getelementptr i8, ptr %tp, i64 8
  %nsec = load i64, ptr %tpn
  %msec = mul i64 %sec, 1000
  %frac = sdiv i64 %nsec, 1000000
  %t = add i64 %msec, %frac
  ret i64 %t
}

; Gate 2 (§11): the same monotonic clock, and the wall clock, in nanoseconds.
define hidden i64 @nz.time_now_ns() {
entry:
  %tp = alloca [2 x i64], align 8
  %r = call i32 @nz_os_clock(i32 4, ptr %tp)
  %sec = load i64, ptr %tp
  %tpn = getelementptr i8, ptr %tp, i64 8
  %nsec = load i64, ptr %tpn
  %ns = mul i64 %sec, 1000000000
  %t = add i64 %ns, %nsec
  ret i64 %t
}

define hidden i64 @nz.time_wall_ns() {
entry:
  %tp = alloca [2 x i64], align 8
  %r = call i32 @nz_os_clock(i32 0, ptr %tp)
  %sec = load i64, ptr %tp
  %tpn = getelementptr i8, ptr %tp, i64 8
  %nsec = load i64, ptr %tpn
  %ns = mul i64 %sec, 1000000000
  %t = add i64 %ns, %nsec
  ret i64 %t
}
"#
}

pub fn rt_core_SLEEP_RUNTIME() -> Str ! {} {
    r#"
define hidden i64 @nz.time_sleep_ms(i64 %ms) {
entry:
  %some = icmp sgt i64 %ms, 0
  br i1 %some, label %start, label %done
start:
  %m = alloca [64 x i8], align 16
  %cv = alloca [64 x i8], align 16
  %ts = alloca [2 x i64], align 8
  %t = alloca [2 x i64], align 8
  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)
  %ci = call i32 @pthread_cond_init(ptr %cv, ptr null)
  ; The monotonic clock, as `nz.ctimedwait` takes it (Q1-M-12).
  %r0 = call i32 @nz_os_clock(i32 4, ptr %ts)
  %s0 = load i64, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  %n0 = load i64, ptr %np
  %sn = mul i64 %s0, 1000000000
  %now = add i64 %sn, %n0
  %wait = mul i64 %ms, 1000000
  %deadline = add i64 %now, %wait
  %sec = sdiv i64 %deadline, 1000000000
  %nsec = srem i64 %deadline, 1000000000
  store i64 %sec, ptr %ts
  store i64 %nsec, ptr %np
  %l = call i32 @pthread_mutex_lock(ptr %m)
  br label %loop
loop:
  %c = call i32 @nz.ctimedwait(ptr %cv, ptr %m, ptr %ts)
  %r1 = call i32 @nz_os_clock(i32 4, ptr %t)
  %s1 = load i64, ptr %t
  %tn = getelementptr i8, ptr %t, i64 8
  %n1 = load i64, ptr %tn
  %sn1 = mul i64 %s1, 1000000000
  %now1 = add i64 %sn1, %n1
  %early = icmp slt i64 %now1, %deadline
  br i1 %early, label %loop, label %woke
woke:
  %u = call i32 @pthread_mutex_unlock(ptr %m)
  %md = call i32 @pthread_mutex_destroy(ptr %m)
  %cd = call i32 @pthread_cond_destroy(ptr %cv)
  br label %done
done:
  ret i64 0
}
"#
}

pub fn rt_core_TEXT_RUNTIME() -> Str ! {} {
    r#"
define hidden i1 @nz.utf8_valid(ptr %p, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %end, %ok ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %lead, label %yes
lead:
  %bp = getelementptr i8, ptr %p, i64 %i
  %b8 = load i8, ptr %bp
  %b = zext i8 %b8 to i32
  %is1 = icmp ult i32 %b, 128
  %ge2 = icmp uge i32 %b, 194
  %le2 = icmp ule i32 %b, 223
  %is2 = and i1 %ge2, %le2
  %ge3 = icmp uge i32 %b, 224
  %le3 = icmp ule i32 %b, 239
  %is3 = and i1 %ge3, %le3
  %ge4 = icmp uge i32 %b, 240
  %le4 = icmp ule i32 %b, 244
  %is4 = and i1 %ge4, %le4
  %l4 = select i1 %is4, i32 4, i32 0
  %l3 = select i1 %is3, i32 3, i32 %l4
  %l2 = select i1 %is2, i32 2, i32 %l3
  %len = select i1 %is1, i32 1, i32 %l2
  %e0 = icmp eq i32 %b, 224
  %f0 = icmp eq i32 %b, 240
  %lo1 = select i1 %f0, i32 144, i32 128
  %lo = select i1 %e0, i32 160, i32 %lo1
  %ed = icmp eq i32 %b, 237
  %f4 = icmp eq i32 %b, 244
  %hi1 = select i1 %f4, i32 143, i32 191
  %hi = select i1 %ed, i32 159, i32 %hi1
  %none = icmp eq i32 %len, 0
  %len64 = zext i32 %len to i64
  %end = add i64 %i, %len64
  %over = icmp sgt i64 %end, %n
  %bad = or i1 %none, %over
  br i1 %bad, label %no, label %check
check:
  %need1 = icmp uge i32 %len, 2
  br i1 %need1, label %c1, label %ok
c1:
  %p1 = getelementptr i8, ptr %bp, i64 1
  %x1 = load i8, ptr %p1
  %y1 = zext i8 %x1 to i32
  %a1 = icmp uge i32 %y1, %lo
  %z1 = icmp ule i32 %y1, %hi
  %in1 = and i1 %a1, %z1
  %need2 = icmp uge i32 %len, 3
  br i1 %in1, label %t2, label %no
t2:
  br i1 %need2, label %c2, label %ok
c2:
  %p2 = getelementptr i8, ptr %bp, i64 2
  %x2 = load i8, ptr %p2
  %y2 = zext i8 %x2 to i32
  %m2 = and i32 %y2, 192
  %in2 = icmp eq i32 %m2, 128
  %need3 = icmp uge i32 %len, 4
  br i1 %in2, label %t3, label %no
t3:
  br i1 %need3, label %c3, label %ok
c3:
  %p3 = getelementptr i8, ptr %bp, i64 3
  %x3 = load i8, ptr %p3
  %y3 = zext i8 %x3 to i32
  %m3 = and i32 %y3, 192
  %in3 = icmp eq i32 %m3, 128
  br i1 %in3, label %ok, label %no
ok:
  br label %loop
yes:
  ret i1 true
no:
  ret i1 false
}

define hidden i64 @nz.utf8_count(ptr %p, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %step ]
  %c = phi i64 [ 0, %entry ], [ %c1, %step ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %step, label %done
step:
  %bp = getelementptr i8, ptr %p, i64 %i
  %b8 = load i8, ptr %bp
  %b = zext i8 %b8 to i32
  %m = and i32 %b, 192
  %cont = icmp eq i32 %m, 128
  %add = select i1 %cont, i64 0, i64 1
  %c1 = add i64 %c, %add
  %i1 = add i64 %i, 1
  br label %loop
done:
  ret i64 %c
}

define hidden i64 @nz.utf8_decode(ptr %p, i64 %n, i64 %i) {
entry:
  %bp = getelementptr i8, ptr %p, i64 %i
  %b8 = load i8, ptr %bp
  %b = zext i8 %b8 to i64
  %one = icmp ult i64 %b, 128
  br i1 %one, label %r1, label %multi
r1:
  ret i64 %b
multi:
  %p1 = getelementptr i8, ptr %bp, i64 1
  %x1 = load i8, ptr %p1
  %y1 = zext i8 %x1 to i64
  %k1 = and i64 %y1, 63
  %two = icmp ult i64 %b, 224
  br i1 %two, label %r2, label %more
r2:
  %h2 = and i64 %b, 31
  %s2 = shl i64 %h2, 6
  %v2 = or i64 %s2, %k1
  ret i64 %v2
more:
  %p2 = getelementptr i8, ptr %bp, i64 2
  %x2 = load i8, ptr %p2
  %y2 = zext i8 %x2 to i64
  %k2 = and i64 %y2, 63
  %three = icmp ult i64 %b, 240
  br i1 %three, label %r3, label %r4
r3:
  %h3 = and i64 %b, 15
  %s3 = shl i64 %h3, 12
  %t3 = shl i64 %k1, 6
  %u3 = or i64 %s3, %t3
  %v3 = or i64 %u3, %k2
  ret i64 %v3
r4:
  %p3 = getelementptr i8, ptr %bp, i64 3
  %x3 = load i8, ptr %p3
  %y3 = zext i8 %x3 to i64
  %k3 = and i64 %y3, 63
  %h4 = and i64 %b, 7
  %s4 = shl i64 %h4, 18
  %t4 = shl i64 %k1, 12
  %w4 = shl i64 %k2, 6
  %u4 = or i64 %s4, %t4
  %z4 = or i64 %u4, %w4
  %v4 = or i64 %z4, %k3
  ret i64 %v4
}

define hidden i64 @nz.utf8_encode(ptr %buf, i64 %c) {
entry:
  %one = icmp ult i64 %c, 128
  br i1 %one, label %e1, label %m2
e1:
  %b1 = trunc i64 %c to i8
  store i8 %b1, ptr %buf
  ret i64 1
m2:
  %lo6 = and i64 %c, 63
  %cont0 = or i64 %lo6, 128
  %c0 = trunc i64 %cont0 to i8
  %sh6 = lshr i64 %c, 6
  %two = icmp ult i64 %c, 2048
  br i1 %two, label %e2, label %m3
e2:
  %l2 = or i64 %sh6, 192
  %a2 = trunc i64 %l2 to i8
  store i8 %a2, ptr %buf
  %q2 = getelementptr i8, ptr %buf, i64 1
  store i8 %c0, ptr %q2
  ret i64 2
m3:
  %mid = and i64 %sh6, 63
  %cont1 = or i64 %mid, 128
  %c1 = trunc i64 %cont1 to i8
  %sh12 = lshr i64 %c, 12
  %three = icmp ult i64 %c, 65536
  br i1 %three, label %e3, label %e4
e3:
  %l3 = or i64 %sh12, 224
  %a3 = trunc i64 %l3 to i8
  store i8 %a3, ptr %buf
  %q31 = getelementptr i8, ptr %buf, i64 1
  store i8 %c1, ptr %q31
  %q32 = getelementptr i8, ptr %buf, i64 2
  store i8 %c0, ptr %q32
  ret i64 3
e4:
  %hi = and i64 %sh12, 63
  %cont2 = or i64 %hi, 128
  %c2 = trunc i64 %cont2 to i8
  %sh18 = lshr i64 %c, 18
  %l4 = or i64 %sh18, 240
  %a4 = trunc i64 %l4 to i8
  store i8 %a4, ptr %buf
  %q41 = getelementptr i8, ptr %buf, i64 1
  store i8 %c2, ptr %q41
  %q42 = getelementptr i8, ptr %buf, i64 2
  store i8 %c1, ptr %q42
  %q43 = getelementptr i8, ptr %buf, i64 3
  store i8 %c0, ptr %q43
  ret i64 4
}

define hidden void @nz.mem_zero(ptr %p, i64 %n) {
entry:
  call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 %n, i1 false)
  ret void
}

define hidden void @nz.mem_move(ptr %d, ptr %s, i64 %n) {
entry:
  call void @llvm.memmove.p0.p0.i64(ptr %d, ptr %s, i64 %n, i1 false)
  ret void
}
"#
}

pub fn rt_core_FOREIGN_STRING_RUNTIME() -> Str ! {} {
    r#"
define hidden i1 @nz.cstr_has_nul(ptr %p, i64 %n) {
entry:
  br label %scan
scan:
  %i = phi i64 [ 0, %entry ], [ %inext, %look ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %look_at, label %clean
look_at:
  %at = getelementptr i8, ptr %p, i64 %i
  %byte = load i8, ptr %at
  %nul = icmp eq i8 %byte, 0
  br i1 %nul, label %found, label %look
look:
  %inext = add i64 %i, 1
  br label %scan
found:
  ret i1 true
clean:
  ret i1 false
}

define hidden i64 @nz.cstr_len(ptr %p) {
entry:
  br label %scan
scan:
  %i = phi i64 [ 0, %entry ], [ %inext, %more ]
  %at = getelementptr i8, ptr %p, i64 %i
  %byte = load i8, ptr %at
  %nul = icmp eq i8 %byte, 0
  br i1 %nul, label %done, label %more
more:
  %inext = add i64 %i, 1
  br label %scan
done:
  ret i64 %i
}

define hidden ptr @nz.cstr_borrow(ptr %p, i64 %n) {
entry:
  %room = add i64 %n, 1
  %buf = call ptr @malloc(i64 %room)
  %oom = icmp eq ptr %buf, null
  br i1 %oom, label %nomem, label %fill
nomem:
  ret ptr null
fill:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %p, i64 %n, i1 false)
  %stop = getelementptr i8, ptr %buf, i64 %n
  store i8 0, ptr %stop
  ret ptr %buf
}
"#
}

pub fn rt_core_ERRNO_RUNTIME() -> Str ! {} {
    r#"
@nz.errno_saved = hidden thread_local global i64 0

define hidden void @nz.errno_save() {
entry:
  %p = call ptr @nz_errno_location()
  %e = load i32, ptr %p
  %w = sext i32 %e to i64
  store i64 %w, ptr @nz.errno_saved
  ret void
}

define hidden i64 @nz.errno_last() {
entry:
  %v = load i64, ptr @nz.errno_saved
  ret i64 %v
}
"#
}

pub fn rt_core_POOL_RUNTIME() -> Str ! {} {
    r#"
@nz.pool_mode = hidden global i64 0
@nz.pool_workers = hidden global ptr null
@nz.pool_count = hidden global i64 0
@nz.pool_next = hidden global i64 0
@nz.pool_stack = hidden global i64 0
@nz.pool_page = hidden global i64 0
@nz.pool_live = hidden global i64 0
@nz.pool_peak = hidden global i64 0
@nz.pool_wait = hidden global ptr null
@nz.pool_buckets = hidden global ptr null
@nz.pool_join = hidden global ptr null
@nz.pool_joiners = hidden global i64 0
@nz.pool_mon = hidden global i64 0
@nz.cur_task = hidden thread_local global ptr null
@.pool.env.sched = private unnamed_addr constant [15 x i8] c"NAZM_SCHEDULER\00"
@.pool.env.workers = private unnamed_addr constant [13 x i8] c"NAZM_WORKERS\00"
@.pool.env.stack = private unnamed_addr constant [16 x i8] c"NAZM_TASK_STACK\00"
@.pool.word = private unnamed_addr constant [5 x i8] c"pool\00"
@.pool.threads = private unnamed_addr constant [8 x i8] c"threads\00"
; The program's policy (N106, §7.107): 2 the pool, 1 a thread per task. The platform entry of a
; program that calls C stores 1 before `main` runs; a library, which has no entry, keeps the pool.
@nz.pool_policy = hidden global i64 2
@.pool.fmt = private unnamed_addr constant [46 x i8] c"nazm-pool: workers=%lld peak=%lld stack=%lld\0A\00"
@.pool.nomem = private unnamed_addr constant [69 x i8] c"nazm: out of memory: the frames of a parked task could not be saved\0A\00"

declare void @nz_ctx_switch(ptr, ptr)
declare ptr @nz_ctx_prepare(ptr, ptr)
declare i64 @nz.os_cpus()

; The scheduler this process runs (N83, §7.84; the default N106's, §7.107): 1 one OS thread per
; task, 2 the pool, 4 a pool that could not start or a NAZM_SCHEDULER that names neither — no
; task starts. Decided once, at the first question; 3 while deciding.
define hidden i64 @nz.pool_mode_get() {
entry:
  br label %top
top:
  %m = load atomic i64, ptr @nz.pool_mode acquire, align 8
  %settled = icmp eq i64 %m, 0
  br i1 %settled, label %decide, label %known
known:
  %deciding = icmp eq i64 %m, 3
  br i1 %deciding, label %spin, label %done
done:
  ret i64 %m
spin:
  br label %top
decide:
  %pair = cmpxchg ptr @nz.pool_mode, i64 0, i64 3 acq_rel acquire
  %won = extractvalue {i64, i1} %pair, 1
  br i1 %won, label %ask, label %top
ask:
  %v = call ptr @getenv(ptr @.pool.env.sched)
  %unset = icmp eq ptr %v, null
  br i1 %unset, label %policy, label %len
policy:
  ; Unset: the program's policy.
  %pol = load i64, ptr @nz.pool_policy
  %onthreads = icmp eq i64 %pol, 1
  br i1 %onthreads, label %threads, label %start
len:
  %n = call i64 @strlen(ptr %v)
  %four = icmp eq i64 %n, 4
  br i1 %four, label %cmp, label %seven
cmp:
  %c = call i32 @memcmp(ptr %v, ptr @.pool.word, i64 4)
  %is = icmp eq i32 %c, 0
  br i1 %is, label %start, label %refused
seven:
  %sev = icmp eq i64 %n, 7
  br i1 %sev, label %cmpt, label %refused
cmpt:
  %ct = call i32 @memcmp(ptr %v, ptr @.pool.threads, i64 7)
  %ist = icmp eq i32 %ct, 0
  br i1 %ist, label %threads, label %refused
refused:
  store atomic i64 4, ptr @nz.pool_mode release, align 8
  ret i64 4
threads:
  store atomic i64 1, ptr @nz.pool_mode release, align 8
  ret i64 1
start:
  %ok = call i1 @nz.pool_start()
  %mode = select i1 %ok, i64 2, i64 4
  store atomic i64 %mode, ptr @nz.pool_mode release, align 8
  ret i64 %mode
}

; A positive count from the environment variable at `%v`, or `%dflt`.
define hidden i64 @nz.pool_env(ptr %name, i64 %dflt) {
entry:
  %v = call ptr @getenv(ptr %name)
  %unset = icmp eq ptr %v, null
  br i1 %unset, label %default, label %parse
parse:
  %n = call i64 @atoll(ptr %v)
  %pos = icmp sgt i64 %n, 0
  br i1 %pos, label %have, label %default
have:
  ret i64 %n
default:
  ret i64 %dflt
}

; The waiter table's locks (6.4): 64 mutexes, 128 bytes apart, bucket `b`'s at `b mod 64`; or null.
define hidden ptr @nz.pool_locks() {
entry:
  %ls = call ptr @malloc(i64 8192)
  %oom = icmp eq ptr %ls, null
  br i1 %oom, label %none, label %loop
none:
  ret ptr null
loop:
  %i = phi i64 [ 0, %entry ], [ %inext, %body ]
  %more = icmp slt i64 %i, 64
  br i1 %more, label %body, label %done
body:
  %off = mul i64 %i, 128
  %m = getelementptr i8, ptr %ls, i64 %off
  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)
  %inext = add i64 %i, 1
  br label %loop
done:
  ret ptr %ls
}

; The lock of the bucket a condition variable hashes to (6.4).
define hidden ptr @nz.pool_lock_of(ptr %cv) {
entry:
  %a = ptrtoint ptr %cv to i64
  %h = lshr i64 %a, 4
  %i = and i64 %h, 63
  %off = mul i64 %i, 128
  %wl = load ptr, ptr @nz.pool_wait
  %m = getelementptr i8, ptr %wl, i64 %off
  ret ptr %m
}

; A mutex at 0 and a condition variable at 128, in 256 bytes, or null.
define hidden ptr @nz.pool_sync() {
entry:
  %s = call ptr @malloc(i64 256)
  %oom = icmp eq ptr %s, null
  br i1 %oom, label %none, label %init
none:
  ret ptr null
init:
  %mi = call i32 @pthread_mutex_init(ptr %s, ptr null)
  %cv = getelementptr i8, ptr %s, i64 128
  %ci = call i32 @pthread_cond_init(ptr %cv, ptr null)
  ret ptr %s
}

; Start the pool: its waiter table, its join lock, and its workers. False if any of it could not be
; made; the workers already started then wait for tasks that never come.
define hidden i1 @nz.pool_start() {
entry:
  %attr = alloca [128 x i8], align 16
  %pg = call i64 @nz_os_page_size()
  store i64 %pg, ptr @nz.pool_page
  ; One worker per processor online unless NAZM_WORKERS says otherwise; four where the system will
  ; not say (performance leadership, 2026-10-15: four on ten processors left six idle).
  %cpus = call i64 @nz.os_cpus()
  %known = icmp sgt i64 %cpus, 0
  %dflt = select i1 %known, i64 %cpus, i64 4
  %wanted = call i64 @nz.pool_env(ptr @.pool.env.workers, i64 %dflt)
  %big = icmp sgt i64 %wanted, 64
  %count = select i1 %big, i64 64, i64 %wanted
  %sbp = load i64, ptr @nz.stack_bytes
  %sbpset = icmp ne i64 %sbp, 0
  %sbpsize = select i1 %sbpset, i64 %sbp, i64 262144
  %asked = call i64 @nz.pool_env(ptr @.pool.env.stack, i64 %sbpsize)
  %min = mul i64 %pg, 4
  %small = icmp slt i64 %asked, %min
  %raw = select i1 %small, i64 %min, i64 %asked
  %pm1 = sub i64 %pg, 1
  %up = add i64 %raw, %pm1
  %pages = udiv i64 %up, %pg
  %stack = mul i64 %pages, %pg
  store i64 %stack, ptr @nz.pool_stack
  %wl = call ptr @nz.pool_locks()
  %bk = call ptr @malloc(i64 2048)
  %js = call ptr @nz.pool_sync()
  %wsz = mul i64 %count, 8
  %arr = call ptr @malloc(i64 %wsz)
  %n1 = icmp eq ptr %wl, null
  %n2 = icmp eq ptr %bk, null
  %n3 = icmp eq ptr %js, null
  %n4 = icmp eq ptr %arr, null
  %o1 = or i1 %n1, %n2
  %o2 = or i1 %n3, %n4
  %any = or i1 %o1, %o2
  br i1 %any, label %fail, label %tables
fail:
  ret i1 false
tables:
  call void @llvm.memset.p0.i64(ptr %bk, i8 0, i64 2048, i1 false)
  store ptr %wl, ptr @nz.pool_wait
  store ptr %bk, ptr @nz.pool_buckets
  store ptr %js, ptr @nz.pool_join
  br label %make
make:
  %i = phi i64 [ 0, %tables ], [ %inext, %made ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %one, label %publish
one:
  %w = call ptr @malloc(i64 448)
  %wnull = icmp eq ptr %w, null
  br i1 %wnull, label %fail, label %winit
winit:
  call void @llvm.memset.p0.i64(ptr %w, i8 0, i64 448, i1 false)
  %wmi = call i32 @pthread_mutex_init(ptr %w, ptr null)
  %wcv = getelementptr i8, ptr %w, i64 128
  %wci = call i32 @pthread_cond_init(ptr %wcv, ptr null)
  %ip = getelementptr i8, ptr %w, i64 288
  store i64 %i, ptr %ip
  ; The worker's run stack (performance leadership 6.2): every task of this worker runs on it, at
  ; the same addresses, from the platform's stack unit — page-aligned, its lowest page a guard.
  %rtotal = add i64 %stack, %pg
  %run = call ptr @nz_os_stack_alloc(i64 %rtotal, i64 %pg)
  %norun = icmp eq ptr %run, null
  br i1 %norun, label %fail, label %runstack
runstack:
  %rbp = getelementptr i8, ptr %w, i64 320
  store ptr %run, ptr %rbp
  %rtp = getelementptr i8, ptr %w, i64 328
  store i64 %rtotal, ptr %rtp
  %slot = getelementptr ptr, ptr %arr, i64 %i
  store ptr %w, ptr %slot
  br label %made
made:
  %inext = add i64 %i, 1
  br label %make
publish:
  store ptr %arr, ptr @nz.pool_workers
  store i64 %count, ptr @nz.pool_count
  br label %spawnw
spawnw:
  %j = phi i64 [ 0, %publish ], [ %jnext, %started ]
  %jmore = icmp slt i64 %j, %count
  br i1 %jmore, label %thread, label %ok
thread:
  %wp = getelementptr ptr, ptr %arr, i64 %j
  %ww = load ptr, ptr %wp
  %th = getelementptr i8, ptr %ww, i64 296
  %ai = call i32 @pthread_attr_init(ptr %attr)
  %as = call i32 @pthread_attr_setstacksize(ptr %attr, i64 1048576)
  %rc = call i32 @pthread_create(ptr %th, ptr %attr, ptr @nz.worker_main, ptr %ww)
  %ad = call i32 @pthread_attr_destroy(ptr %attr)
  %bad = icmp ne i32 %rc, 0
  br i1 %bad, label %fail, label %started
started:
  %jnext = add i64 %j, 1
  br label %spawnw
ok:
  ; Preemption (6.3): with more than one worker, a monitor asks a task that has held its worker
  ; for a time slice to yield it when others wait. One worker keeps its order: no monitor.
  %several = icmp sgt i64 %count, 1
  br i1 %several, label %monitor, label %done
monitor:
  store atomic ptr @nz.pool_preempt, ptr @nz.preempt_hook release, align 8
  %mai = call i32 @pthread_attr_init(ptr %attr)
  %mas = call i32 @pthread_attr_setstacksize(ptr %attr, i64 1048576)
  %mrc = call i32 @pthread_create(ptr @nz.pool_mon, ptr %attr, ptr @nz.pool_monitor, ptr null)
  %mad = call i32 @pthread_attr_destroy(ptr %attr)
  br label %done
done:
  ret i1 true
}

; The monitor (6.3): every 10 ms, look at the workers.
define hidden ptr @nz.pool_monitor(ptr %arg) {
entry:
  %ts = alloca [2 x i64], align 8
  %nap = alloca [2 x i64], align 8
  %s = call ptr @nz.pool_sync()
  %none = icmp eq ptr %s, null
  br i1 %none, label %quit, label %start
quit:
  ret ptr null
start:
  %l = call i32 @pthread_mutex_lock(ptr %s)
  %cv = getelementptr i8, ptr %s, i64 128
  %tsn = getelementptr i8, ptr %ts, i64 8
  br label %tick
tick:
  %now = call i64 @nz.pool_now()
  %due = add i64 %now, 10000000
  %sec = sdiv i64 %due, 1000000000
  %ns = srem i64 %due, 1000000000
  store i64 %sec, ptr %ts
  store i64 %ns, ptr %tsn
  call void @nz.timed_nap(ptr %ts, ptr %nap)
  %w = call i32 @pthread_cond_timedwait(ptr %cv, ptr %s, ptr %nap)
  call void @nz.pool_watch()
  br label %tick
}

; A worker that has run one task since the last look (its switch count unmoved, a task in) while
; others wait in its queues is asked to yield: its flag, then the process's. The process's flag is
; set while any worker's is, and cleared when none is.
define hidden void @nz.pool_watch() {
entry:
  %count = load i64, ptr @nz.pool_count
  %arr = load ptr, ptr @nz.pool_workers
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %inext, %keep ]
  %any = phi i1 [ false, %entry ], [ %any2, %keep ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %body, label %done
body:
  %wp = getelementptr ptr, ptr %arr, i64 %i
  %w = load ptr, ptr %wp
  %runp = getelementptr i8, ptr %w, i64 408
  %run = load atomic i64, ptr %runp monotonic, align 8
  %cntp = getelementptr i8, ptr %w, i64 392
  %cnt = load atomic i64, ptr %cntp monotonic, align 8
  %lastp = getelementptr i8, ptr %w, i64 400
  %last = load i64, ptr %lastp
  store i64 %cnt, ptr %lastp
  %same = icmp eq i64 %cnt, %last
  %running = icmp ne i64 %run, 0
  %stuck = and i1 %same, %running
  br i1 %stuck, label %check, label %keep
check:
  %rp = getelementptr i8, ptr %w, i64 256
  %r = load atomic ptr, ptr %rp monotonic, align 8
  %fp = getelementptr i8, ptr %w, i64 352
  %f = load atomic ptr, ptr %fp monotonic, align 8
  %rq = icmp ne ptr %r, null
  %fq = icmp ne ptr %f, null
  %queued = or i1 %rq, %fq
  br i1 %queued, label %ask, label %keep
ask:
  %askp = getelementptr i8, ptr %w, i64 416
  store atomic i64 1, ptr %askp monotonic, align 8
  br label %keep
keep:
  %flagp = getelementptr i8, ptr %w, i64 416
  %fl = load atomic i64, ptr %flagp monotonic, align 8
  %set = icmp ne i64 %fl, 0
  %any2 = or i1 %any, %set
  %inext = add i64 %i, 1
  br label %loop
done:
  %req = zext i1 %any to i64
  store atomic i64 %req, ptr @nz.preempt_req monotonic, align 8
  ret void
}

; The pool's preemption hook, on the thread whose loop found the flag (6.3): a task its worker was
; asked to give up yields it; and the process's flag is cleared when no worker's is set.
define hidden void @nz.pool_preempt() {
entry:
  %t = load ptr, ptr @nz.cur_task
  %none = icmp eq ptr %t, null
  br i1 %none, label %calm, label %mine
mine:
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %flagp = getelementptr i8, ptr %w, i64 416
  %old = atomicrmw xchg ptr %flagp, i64 0 monotonic
  %asked = icmp ne i64 %old, 0
  call void @nz.pool_calm()
  br i1 %asked, label %yield, label %out
yield:
  call void @nz.task_yield()
  br label %out
calm:
  call void @nz.pool_calm()
  br label %out
out:
  ret void
}

; Clear the process's preemption flag unless some worker's is set (6.3). A request that races
; this is set again by the monitor's next look.
define hidden void @nz.pool_calm() {
entry:
  %count = load i64, ptr @nz.pool_count
  %arr = load ptr, ptr @nz.pool_workers
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %inext, %next ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %body, label %clear
body:
  %wp = getelementptr ptr, ptr %arr, i64 %i
  %w = load ptr, ptr %wp
  %flagp = getelementptr i8, ptr %w, i64 416
  %fl = load atomic i64, ptr %flagp monotonic, align 8
  %set = icmp ne i64 %fl, 0
  %inext = add i64 %i, 1
  br i1 %set, label %stay, label %next
next:
  br label %loop
stay:
  ret void
clear:
  store atomic i64 0, ptr @nz.preempt_req monotonic, align 8
  ret void
}

; Queue a runnable task at its worker's tail, the lock held (6.3): a task that has never run on the
; worker's unstarted queue, which other workers may steal from; one that has, on its resumed queue,
; since its frames are on this worker's run stack. The worker is signalled only when it sleeps: a
; worker that is running or spinning finds the task itself.
define hidden void @nz.pool_push(ptr %w, ptr %t) {
entry:
  %np = getelementptr i8, ptr %t, i64 48
  store ptr null, ptr %np
  ; Its place in this worker's order: the two queues are taken from oldest first.
  %sqp = getelementptr i8, ptr %w, i64 384
  %sq = load i64, ptr %sqp
  %sq1 = add i64 %sq, 1
  store i64 %sq1, ptr %sqp
  %tqp = getelementptr i8, ptr %t, i64 168
  store i64 %sq, ptr %tqp
  %stp = getelementptr i8, ptr %t, i64 160
  %started = load i64, ptr %stp
  %fresh = icmp eq i64 %started, 0
  %hoff = select i1 %fresh, i64 352, i64 256
  %toff = select i1 %fresh, i64 360, i64 264
  %hp = getelementptr i8, ptr %w, i64 %hoff
  %tp = getelementptr i8, ptr %w, i64 %toff
  %tail = load ptr, ptr %tp
  %empty = icmp eq ptr %tail, null
  br i1 %empty, label %first, label %append
first:
  store atomic ptr %t, ptr %hp monotonic, align 8
  br label %linked
append:
  %tn = getelementptr i8, ptr %tail, i64 48
  store ptr %t, ptr %tn
  br label %linked
linked:
  store ptr %t, ptr %tp
  br i1 %fresh, label %count, label %wake
count:
  %cp = getelementptr i8, ptr %w, i64 368
  %c = load atomic i64, ptr %cp monotonic, align 8
  %c1 = add i64 %c, 1
  store atomic i64 %c1, ptr %cp monotonic, align 8
  br label %wake
wake:
  %slp = getelementptr i8, ptr %w, i64 376
  %sl = load i64, ptr %slp
  %asleep = icmp ne i64 %sl, 0
  br i1 %asleep, label %signal, label %out
signal:
  %cv = getelementptr i8, ptr %w, i64 128
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  br label %out
out:
  ret void
}

; The next task this worker runs, its lock held, or null: the head of its two queues queued first,
; so its runnable tasks still run first in, first out (§7.84).
define hidden ptr @nz.pool_take(ptr %w) {
entry:
  %rp = getelementptr i8, ptr %w, i64 256
  %r = load atomic ptr, ptr %rp monotonic, align 8
  %fp = getelementptr i8, ptr %w, i64 352
  %f = load atomic ptr, ptr %fp monotonic, align 8
  %rnone = icmp eq ptr %r, null
  %fnone = icmp eq ptr %f, null
  %both = and i1 %rnone, %fnone
  br i1 %both, label %none, label %order
none:
  ret ptr null
order:
  %either = or i1 %rnone, %fnone
  br i1 %either, label %pick, label %compare
compare:
  %rqp = getelementptr i8, ptr %r, i64 168
  %rq = load i64, ptr %rqp
  %fqp = getelementptr i8, ptr %f, i64 168
  %fq = load i64, ptr %fqp
  %older = icmp ult i64 %fq, %rq
  br label %pick
pick:
  %usef = phi i1 [ %rnone, %order ], [ %older, %compare ]
  %hp = select i1 %usef, ptr %fp, ptr %rp
  %h = select i1 %usef, ptr %f, ptr %r
  %toff = select i1 %usef, i64 360, i64 264
  %np = getelementptr i8, ptr %h, i64 48
  %n = load ptr, ptr %np
  store atomic ptr %n, ptr %hp monotonic, align 8
  store ptr null, ptr %np
  %last = icmp eq ptr %n, null
  br i1 %last, label %cleartail, label %counted
cleartail:
  %tp = getelementptr i8, ptr %w, i64 %toff
  store ptr null, ptr %tp
  br label %counted
counted:
  br i1 %usef, label %fewer, label %out
fewer:
  %cp = getelementptr i8, ptr %w, i64 368
  %c = load atomic i64, ptr %cp monotonic, align 8
  %c1 = sub i64 %c, 1
  store atomic i64 %c1, ptr %cp monotonic, align 8
  br label %out
out:
  ret ptr %h
}

; With nothing of its own to run, take half (at most 64) of the first other worker's unstarted tasks
; that has any, looking from the next worker on. Entered and left with this worker's lock held, but
; never holding two workers' locks at once. True when tasks were taken.
define hidden i1 @nz.pool_steal(ptr %w) {
entry:
  %count = load i64, ptr @nz.pool_count
  %solo = icmp sle i64 %count, 1
  br i1 %solo, label %nothing, label %let
nothing:
  ret i1 false
let:
  %u0 = call i32 @pthread_mutex_unlock(ptr %w)
  %ip = getelementptr i8, ptr %w, i64 288
  %me = load i64, ptr %ip
  %arr = load ptr, ptr @nz.pool_workers
  br label %scan
scan:
  %i = phi i64 [ 1, %let ], [ %inext, %pass ], [ %inext, %gone ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %probe, label %empty
empty:
  %l0 = call i32 @pthread_mutex_lock(ptr %w)
  ret i1 false
probe:
  %inext = add i64 %i, 1
  %vi0 = add i64 %me, %i
  %vi = urem i64 %vi0, %count
  %vp = getelementptr ptr, ptr %arr, i64 %vi
  %v = load ptr, ptr %vp
  %vcp = getelementptr i8, ptr %v, i64 368
  %seen = load atomic i64, ptr %vcp monotonic, align 8
  %has = icmp sgt i64 %seen, 0
  br i1 %has, label %lockv, label %pass
pass:
  br label %scan
lockv:
  %lv = call i32 @pthread_mutex_lock(ptr %v)
  %c = load atomic i64, ptr %vcp monotonic, align 8
  %still = icmp sgt i64 %c, 0
  br i1 %still, label %cut, label %gone
gone:
  %uv0 = call i32 @pthread_mutex_unlock(ptr %v)
  br label %scan
cut:
  %c1 = add i64 %c, 1
  %half = udiv i64 %c1, 2
  %big = icmp sgt i64 %half, 64
  %want = select i1 %big, i64 64, i64 %half
  %vhp = getelementptr i8, ptr %v, i64 352
  %first = load atomic ptr, ptr %vhp monotonic, align 8
  br label %walk
walk:
  %t = phi ptr [ %first, %cut ], [ %tnext, %step ]
  %k = phi i64 [ 1, %cut ], [ %knext, %step ]
  %tw = getelementptr i8, ptr %t, i64 40
  store ptr %w, ptr %tw
  %tnp = getelementptr i8, ptr %t, i64 48
  %tnext = load ptr, ptr %tnp
  %enough = icmp sge i64 %k, %want
  %atend = icmp eq ptr %tnext, null
  %stop = or i1 %enough, %atend
  %knext = add i64 %k, 1
  br i1 %stop, label %detach, label %step
step:
  br label %walk
detach:
  store atomic ptr %tnext, ptr %vhp monotonic, align 8
  store ptr null, ptr %tnp
  br i1 %atend, label %vclear, label %vcount
vclear:
  %vtp = getelementptr i8, ptr %v, i64 360
  store ptr null, ptr %vtp
  br label %vcount
vcount:
  %left = sub i64 %c, %k
  store atomic i64 %left, ptr %vcp monotonic, align 8
  %uv = call i32 @pthread_mutex_unlock(ptr %v)
  %l1 = call i32 @pthread_mutex_lock(ptr %w)
  %whp = getelementptr i8, ptr %w, i64 352
  %wtp = getelementptr i8, ptr %w, i64 360
  %wtail = load ptr, ptr %wtp
  %wempty = icmp eq ptr %wtail, null
  br i1 %wempty, label %own, label %join
own:
  store atomic ptr %first, ptr %whp monotonic, align 8
  br label %joined
join:
  %wtn = getelementptr i8, ptr %wtail, i64 48
  store ptr %first, ptr %wtn
  br label %joined
joined:
  store ptr %t, ptr %wtp
  %wcp = getelementptr i8, ptr %w, i64 368
  %wc = load atomic i64, ptr %wcp monotonic, align 8
  %wc1 = add i64 %wc, %k
  store atomic i64 %wc1, ptr %wcp monotonic, align 8
  ret i1 true
}

; Before sleeping, look for work for up to 50 microseconds without the lock (6.3): a task queued for
; this worker, or unstarted tasks on another. Entered and left with the lock held; true when there
; may be something to run. Not with one worker, whose program has no one else to wait for.
define hidden i1 @nz.pool_spin(ptr %w) {
entry:
  %count = load i64, ptr @nz.pool_count
  %solo = icmp sle i64 %count, 1
  br i1 %solo, label %no, label %let
no:
  ret i1 false
let:
  %u0 = call i32 @pthread_mutex_unlock(ptr %w)
  %start = call i64 @nz.pool_now()
  %rp = getelementptr i8, ptr %w, i64 256
  %fp = getelementptr i8, ptr %w, i64 352
  %arr = load ptr, ptr @nz.pool_workers
  br label %round
round:
  %n = phi i64 [ 0, %let ], [ %nnext, %clock ]
  %r = load atomic ptr, ptr %rp monotonic, align 8
  %f = load atomic ptr, ptr %fp monotonic, align 8
  %rs = icmp ne ptr %r, null
  %fs = icmp ne ptr %f, null
  %mine = or i1 %rs, %fs
  br i1 %mine, label %found, label %others
others:
  br label %scan
scan:
  %i = phi i64 [ 0, %others ], [ %inext, %next ]
  %more = icmp slt i64 %i, %count
  br i1 %more, label %probe, label %clock
probe:
  %vp = getelementptr ptr, ptr %arr, i64 %i
  %v = load ptr, ptr %vp
  %vcp = getelementptr i8, ptr %v, i64 368
  %c = load atomic i64, ptr %vcp monotonic, align 8
  %has = icmp sgt i64 %c, 1
  %inext = add i64 %i, 1
  br i1 %has, label %found, label %next
next:
  br label %scan
clock:
  %nnext = add i64 %n, 1
  %now = call i64 @nz.pool_now()
  %spent = sub i64 %now, %start
  %over = icmp sgt i64 %spent, 50000
  br i1 %over, label %give, label %round
give:
  %l1 = call i32 @pthread_mutex_lock(ptr %w)
  ret i1 false
found:
  %l2 = call i32 @pthread_mutex_lock(ptr %w)
  ret i1 true
}

; The monotonic clock in nanoseconds, which every deadline is on (Q1-M-12).
define hidden i64 @nz.pool_now() {
entry:
  %ts = alloca [2 x i64], align 8
  %r = call i32 @nz_os_clock(i32 4, ptr %ts)
  %s = load i64, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  %n = load i64, ptr %np
  %sn = mul i64 %s, 1000000000
  %t = add i64 %sn, %n
  ret i64 %t
}

; Every parked task on this worker whose deadline has passed is queued again; entries for tasks no
; longer parked with a deadline leave the list. The worker's lock is held. Writes the soonest
; remaining deadline into `%ts` and says whether there is one.
define hidden i1 @nz.pool_timers(ptr %w, ptr %ts) {
entry:
  %now = call i64 @nz.pool_now()
  %headp = getelementptr i8, ptr %w, i64 280
  %first = load ptr, ptr %headp
  store ptr null, ptr %headp
  br label %walk
walk:
  %t = phi ptr [ %first, %entry ], [ %next, %keep ], [ %next, %drop ]
  %soon = phi i64 [ 0, %entry ], [ %soon2, %keep ], [ %soon, %drop ]
  %atend = icmp eq ptr %t, null
  br i1 %atend, label %finish, label %look
look:
  %nxp = getelementptr i8, ptr %t, i64 136
  %next = load ptr, ptr %nxp
  %stp = getelementptr i8, ptr %t, i64 24
  %st = load i64, ptr %stp
  %dp = getelementptr i8, ptr %t, i64 112
  %d = load i64, ptr %dp
  %parked = icmp eq i64 %st, 3
  %timed = icmp ne i64 %d, 0
  %live = and i1 %parked, %timed
  br i1 %live, label %due, label %drop
due:
  %passed = icmp sle i64 %d, %now
  br i1 %passed, label %fire, label %keep
fire:
  store i64 0, ptr %dp
  store i64 0, ptr %stp
  call void @nz.pool_push(ptr %w, ptr %t)
  br label %drop
drop:
  %inp = getelementptr i8, ptr %t, i64 144
  store i64 0, ptr %inp
  store ptr null, ptr %nxp
  br label %walk
keep:
  %h = load ptr, ptr %headp
  store ptr %h, ptr %nxp
  store ptr %t, ptr %headp
  %none = icmp eq i64 %soon, 0
  %earlier = icmp slt i64 %d, %soon
  %take = or i1 %none, %earlier
  %soon2 = select i1 %take, i64 %d, i64 %soon
  br label %walk
finish:
  %have = icmp ne i64 %soon, 0
  br i1 %have, label %fill, label %out
fill:
  %sec = sdiv i64 %soon, 1000000000
  %nsec = srem i64 %soon, 1000000000
  store i64 %sec, ptr %ts
  %tn = getelementptr i8, ptr %ts, i64 8
  store i64 %nsec, ptr %tn
  br label %out
out:
  ret i1 %have
}

; Into a task: it becomes this thread's current task, with its own failure state and stack limit.
define hidden void @nz.task_enter(ptr %t) {
entry:
  store ptr %t, ptr @nz.cur_task
  %fp = getelementptr i8, ptr %t, i64 80
  %f = load i64, ptr %fp
  %fb = trunc i64 %f to i1
  store i1 %fb, ptr @nz.failed
  %mp = getelementptr i8, ptr %t, i64 88
  %m = load ptr, ptr %mp
  store ptr %m, ptr @nz.errmsg
  %lp = getelementptr i8, ptr %t, i64 96
  %l = load i64, ptr %lp
  store i64 %l, ptr @nz.errlen
{RESTORE_LIMIT}
  ret void
}

; Out of a task: its failure state and stack limit are saved into it, and the worker's are clean.
define hidden void @nz.task_leave(ptr %t) {
entry:
  %fb = load i1, ptr @nz.failed
  %f = zext i1 %fb to i64
  %fp = getelementptr i8, ptr %t, i64 80
  store i64 %f, ptr %fp
  %m = load ptr, ptr @nz.errmsg
  %mp = getelementptr i8, ptr %t, i64 88
  store ptr %m, ptr %mp
  %l = load i64, ptr @nz.errlen
  %lp = getelementptr i8, ptr %t, i64 96
  store i64 %l, ptr %lp
{SAVE_LIMIT}
  store i1 false, ptr @nz.failed
  store ptr null, ptr @nz.errmsg
  store i64 0, ptr @nz.errlen
  store ptr null, ptr @nz.cur_task
  ret void
}

; A worker: run its tasks first in, first out, each until it parks, yields or ends; with none, steal
; unstarted ones, spin a little, then sleep (6.3).
define hidden ptr @nz.worker_main(ptr %w) {
entry:
  %ts = alloca [2 x i64], align 8
  %nap = alloca [2 x i64], align 8
  %l0 = call i32 @pthread_mutex_lock(ptr %w)
  br label %look
look:
  %timed = call i1 @nz.pool_timers(ptr %w, ptr %ts)
  %h = call ptr @nz.pool_take(ptr %w)
  %empty = icmp eq ptr %h, null
  br i1 %empty, label %idle, label %go
idle:
  %stole = call i1 @nz.pool_steal(ptr %w)
  br i1 %stole, label %look, label %spin
spin:
  %maybe = call i1 @nz.pool_spin(ptr %w)
  br i1 %maybe, label %look, label %recheck
recheck:
  ; Under the lock again: a task queued while it spun is seen here, and one queued after this
  ; finds the worker marked sleeping and signals it.
  %h2 = call ptr @nz.pool_take(ptr %w)
  %none = icmp eq ptr %h2, null
  br i1 %none, label %sleep, label %back
back:
  call void @nz.pool_push(ptr %w, ptr %h2)
  br label %look
sleep:
  %slp = getelementptr i8, ptr %w, i64 376
  store i64 1, ptr %slp
  %cv = getelementptr i8, ptr %w, i64 128
  br i1 %timed, label %tw, label %fw
tw:
  ; The soonest deadline is monotonic; the wait measures the wall clock (Q1-M-12).
  call void @nz.timed_nap(ptr %ts, ptr %nap)
  %a = call i32 @pthread_cond_timedwait(ptr %cv, ptr %w, ptr %nap)
  store i64 0, ptr %slp
  br label %look
fw:
  %b = call i32 @pthread_cond_wait(ptr %cv, ptr %w)
  store i64 0, ptr %slp
  br label %look
go:
  %sp = getelementptr i8, ptr %h, i64 24
  store i64 1, ptr %sp
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  %placed = call i1 @nz.task_place(ptr %w, ptr %h)
  br i1 %placed, label %enter, label %nomem
nomem:
  ; The frames in place could not be saved, so neither task can run: the program ends, as it
  ; does when a thread cannot be had for `main`.
  %nm = call i64 @write(i32 2, ptr @.pool.nomem, i64 68)
  call void @exit(i32 2)
  unreachable
enter:
  call void @nz.task_enter(ptr %h)
  ; What the monitor reads (6.3): a switch count, a task in, and no request left from the last.
  %askp = getelementptr i8, ptr %w, i64 416
  store atomic i64 0, ptr %askp monotonic, align 8
  %cntp = getelementptr i8, ptr %w, i64 392
  %cnt = load atomic i64, ptr %cntp monotonic, align 8
  %cnt1 = add i64 %cnt, 1
  store atomic i64 %cnt1, ptr %cntp monotonic, align 8
  %runp = getelementptr i8, ptr %w, i64 408
  store atomic i64 1, ptr %runp monotonic, align 8
  %wsp = getelementptr i8, ptr %w, i64 272
  %tsp = load ptr, ptr %h
  call void @nz_ctx_switch(ptr %wsp, ptr %tsp)
  store atomic i64 0, ptr %runp monotonic, align 8
  call void @nz.task_leave(ptr %h)
  %st = load i64, ptr %sp
  %ended = icmp eq i64 %st, 4
  br i1 %ended, label %finish, label %relock
relock:
  %l2 = call i32 @pthread_mutex_lock(ptr %w)
  %parking = icmp eq i64 %st, 2
  br i1 %parking, label %park, label %yielded
park:
  %wk = getelementptr i8, ptr %h, i64 32
  %woken = load i64, ptr %wk
  %was = icmp ne i64 %woken, 0
  br i1 %was, label %requeue, label %rest
requeue:
  store i64 0, ptr %wk
  store i64 0, ptr %sp
  call void @nz.pool_push(ptr %w, ptr %h)
  br label %look
rest:
  store i64 3, ptr %sp
  %dp = getelementptr i8, ptr %h, i64 112
  %d = load i64, ptr %dp
  %inp = getelementptr i8, ptr %h, i64 144
  %in = load i64, ptr %inp
  %hasd = icmp ne i64 %d, 0
  %notin = icmp eq i64 %in, 0
  %add = and i1 %hasd, %notin
  br i1 %add, label %addtimer, label %look
addtimer:
  store i64 1, ptr %inp
  %th = getelementptr i8, ptr %w, i64 280
  %old = load ptr, ptr %th
  %tnx = getelementptr i8, ptr %h, i64 136
  store ptr %old, ptr %tnx
  store ptr %h, ptr %th
  br label %look
yielded:
  store i64 0, ptr %sp
  call void @nz.pool_push(ptr %w, ptr %h)
  br label %look
finish:
  ; Its frames on the run stack are dead and its saved copy goes; then it is marked done, last:
  ; a joiner may free its record at once.
  %ownp = getelementptr i8, ptr %w, i64 336
  store ptr null, ptr %ownp
  %bufp = getelementptr i8, ptr %h, i64 8
  %buf = load ptr, ptr %bufp
  call void @free(ptr %buf)
  store ptr null, ptr %bufp
  ; Done, then a wake only when a joiner waits (6.3): a joiner counts itself before it looks, so
  ; one that looked too early is counted by the time this reads the count.
  %donep = getelementptr i8, ptr %h, i64 72
  store atomic i64 1, ptr %donep seq_cst, align 8
  %joiners = load atomic i64, ptr @nz.pool_joiners seq_cst, align 8
  %waits = icmp sgt i64 %joiners, 0
  br i1 %waits, label %tell, label %told
tell:
  %js = load ptr, ptr @nz.pool_join
  %jl = call i32 @pthread_mutex_lock(ptr %js)
  %jcv = getelementptr i8, ptr %js, i64 128
  call void @nz.cwake(ptr %jcv)
  %ju = call i32 @pthread_mutex_unlock(ptr %js)
  br label %told
told:
  %l3 = call i32 @pthread_mutex_lock(ptr %w)
  br label %look
}

; Start a task on the pool: a record, a worker by round robin, and its place in the argument block's
; head, where a thread's handle goes otherwise. No stack: the task will run on its worker's (6.2).
; 0, or 1 when no record could be had.
define hidden i32 @nz.task_start(ptr %fn, ptr %blk) {
entry:
  %t = call ptr @malloc(i64 192)
  %tnull = icmp eq ptr %t, null
  br i1 %tnull, label %nothread, label %zero
nothread:
  ret i32 1
zero:
  call void @llvm.memset.p0.i64(ptr %t, i8 0, i64 192, i1 false)
  %fp = getelementptr i8, ptr %t, i64 56
  store ptr %fn, ptr %fp
  %blp = getelementptr i8, ptr %t, i64 64
  store ptr %blk, ptr %blp
  ; A task's own tasks start on its worker, which other workers steal from (6.3); `main`'s go
  ; round robin.
  %cur = load ptr, ptr @nz.cur_task
  %intask = icmp ne ptr %cur, null
  br i1 %intask, label %local, label %rr
local:
  %cwp = getelementptr i8, ptr %cur, i64 40
  %cw = load ptr, ptr %cwp
  br label %placed
rr:
  %k = atomicrmw add ptr @nz.pool_next, i64 1 monotonic
  %count = load i64, ptr @nz.pool_count
  %idx = urem i64 %k, %count
  %arr = load ptr, ptr @nz.pool_workers
  %wp = getelementptr ptr, ptr %arr, i64 %idx
  %rw = load ptr, ptr %wp
  br label %placed
placed:
  %w = phi ptr [ %cw, %local ], [ %rw, %rr ]
  %wfield = getelementptr i8, ptr %t, i64 40
  store ptr %w, ptr %wfield
  store ptr %t, ptr %blk
  %live = atomicrmw add ptr @nz.pool_live, i64 1 monotonic
  %now = add i64 %live, 1
  %pk = atomicrmw max ptr @nz.pool_peak, i64 %now monotonic
  %l = call i32 @pthread_mutex_lock(ptr %w)
  call void @nz.pool_push(ptr %w, ptr %t)
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  ret i32 0
}

; Put a task's frames on its worker's run stack (6.2), on the worker's own thread, its lock not held.
; The task whose frames are there already costs nothing. Otherwise the frames in place, from that
; task's saved stack pointer to the top, are copied into a buffer it owns, and this task's copy is
; put back at the same addresses — or, on its first run, its first frame is laid out at the top and
; its stack limit set from the run stack. False when the frames in place could not be saved.
define hidden i1 @nz.task_place(ptr %w, ptr %t) {
entry:
  %ownp = getelementptr i8, ptr %w, i64 336
  %own = load ptr, ptr %ownp
  %here = icmp eq ptr %own, %t
  br i1 %here, label %done, label %swap
swap:
  %rbp = getelementptr i8, ptr %w, i64 320
  %base = load ptr, ptr %rbp
  %rtp = getelementptr i8, ptr %w, i64 328
  %total = load i64, ptr %rtp
  %top = getelementptr i8, ptr %base, i64 %total
  %topi = ptrtoint ptr %top to i64
  %vacant = icmp eq ptr %own, null
  br i1 %vacant, label %bring, label %save
save:
  %osp = load ptr, ptr %own
  %ospi = ptrtoint ptr %osp to i64
  %n = sub i64 %topi, %ospi
  %obufp = getelementptr i8, ptr %own, i64 8
  %ocapp = getelementptr i8, ptr %own, i64 16
  %ocap = load i64, ptr %ocapp
  %fits = icmp ule i64 %n, %ocap
  br i1 %fits, label %copyout, label %grow
grow:
  %old = load ptr, ptr %obufp
  %nb = call ptr @realloc(ptr %old, i64 %n)
  %oom = icmp eq ptr %nb, null
  br i1 %oom, label %nomem, label %grown
nomem:
  ret i1 false
grown:
  store ptr %nb, ptr %obufp
  store i64 %n, ptr %ocapp
  br label %copyout
copyout:
  %obuf = load ptr, ptr %obufp
  call void @llvm.memcpy.p0.p0.i64(ptr %obuf, ptr %osp, i64 %n, i1 false)
  %olenp = getelementptr i8, ptr %own, i64 152
  store i64 %n, ptr %olenp
  br label %bring
bring:
  %startedp = getelementptr i8, ptr %t, i64 160
  %started = load i64, ptr %startedp
  %fresh = icmp eq i64 %started, 0
  br i1 %fresh, label %first, label %restore
first:
  %sp = call ptr @nz_ctx_prepare(ptr %top, ptr %t)
  store ptr %sp, ptr %t
  store i64 1, ptr %startedp
  %pg = load i64, ptr @nz.pool_page
  %size = load i64, ptr @nz.pool_stack
{SET_LIMIT}
  br label %placed
restore:
  %tsp = load ptr, ptr %t
  %tbufp = getelementptr i8, ptr %t, i64 8
  %tbuf = load ptr, ptr %tbufp
  %tlenp = getelementptr i8, ptr %t, i64 152
  %tlen = load i64, ptr %tlenp
  call void @llvm.memcpy.p0.p0.i64(ptr %tsp, ptr %tbuf, i64 %tlen, i1 false)
  br label %placed
placed:
  store ptr %t, ptr %ownp
  br label %done
done:
  ret i1 true
}

; What the entry stub calls, on the task's own stack: the task's start routine, then the end.
define hidden void @nz_task_main(ptr %t) {
entry:
  %fp = getelementptr i8, ptr %t, i64 56
  %fn = load ptr, ptr %fp
  %bp = getelementptr i8, ptr %t, i64 64
  %blk = load ptr, ptr %bp
  %r = call ptr %fn(ptr %blk)
  %live = atomicrmw sub ptr @nz.pool_live, i64 1 monotonic
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %l = call i32 @pthread_mutex_lock(ptr %w)
  %sp = getelementptr i8, ptr %t, i64 24
  store i64 4, ptr %sp
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  %wsp = getelementptr i8, ptr %w, i64 272
  %back = load ptr, ptr %wsp
  call void @nz_ctx_switch(ptr %t, ptr %back)
  unreachable
}

; Back to the worker, the task's state already set under its worker's lock.
define hidden void @nz.task_suspend(ptr %t) {
entry:
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %wsp = getelementptr i8, ptr %w, i64 272
  %back = load ptr, ptr %wsp
  call void @nz_ctx_switch(ptr %t, ptr %back)
  ret void
}

; Make a parked task runnable, or note that it was woken while still running or parking.
define hidden void @nz.task_wake(ptr %t) {
entry:
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %l = call i32 @pthread_mutex_lock(ptr %w)
  %sp = getelementptr i8, ptr %t, i64 24
  %st = load i64, ptr %sp
  %parked = icmp eq i64 %st, 3
  br i1 %parked, label %run, label %busy
run:
  %dp = getelementptr i8, ptr %t, i64 112
  store i64 0, ptr %dp
  store i64 0, ptr %sp
  call void @nz.pool_push(ptr %w, ptr %t)
  br label %out
busy:
  %running = icmp eq i64 %st, 1
  %parking = icmp eq i64 %st, 2
  %either = or i1 %running, %parking
  br i1 %either, label %note, label %out
note:
  %wk = getelementptr i8, ptr %t, i64 32
  store i64 1, ptr %wk
  br label %out
out:
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  ret void
}

define hidden ptr @nz.pool_bucket(ptr %cv) {
entry:
  %a = ptrtoint ptr %cv to i64
  %h = lshr i64 %a, 4
  %i = and i64 %h, 255
  %bk = load ptr, ptr @nz.pool_buckets
  %slot = getelementptr ptr, ptr %bk, i64 %i
  ret ptr %slot
}

; Take `%t` off the waiters of whatever it waits on, if it is still on them.
define hidden void @nz.pool_unwait(ptr %t) {
entry:
  ; On no list: nothing to lock (6.4). A waker clears this under the bucket's lock, after
  ; unlinking the task, so null means off the list; otherwise the bucket is the one it names.
  %cvp = getelementptr i8, ptr %t, i64 128
  %cv0 = load atomic ptr, ptr %cvp monotonic, align 8
  %off = icmp eq ptr %cv0, null
  br i1 %off, label %quiet, label %lock
quiet:
  ret void
lock:
  %wl = call ptr @nz.pool_lock_of(ptr %cv0)
  %l = call i32 @pthread_mutex_lock(ptr %wl)
  %cv = load atomic ptr, ptr %cvp monotonic, align 8
  %none = icmp eq ptr %cv, null
  br i1 %none, label %out, label %find
find:
  %slot = call ptr @nz.pool_bucket(ptr %cv)
  br label %walk
walk:
  %link = phi ptr [ %slot, %find ], [ %nlink, %next ]
  %cur = load ptr, ptr %link
  %end = icmp eq ptr %cur, null
  br i1 %end, label %clear, label %test
test:
  %hit = icmp eq ptr %cur, %t
  %nlink = getelementptr i8, ptr %cur, i64 120
  br i1 %hit, label %unlink, label %next
next:
  br label %walk
unlink:
  %after = load ptr, ptr %nlink
  store atomic ptr %after, ptr %link monotonic, align 8
  br label %clear
clear:
  store atomic ptr null, ptr %cvp monotonic, align 8
  %np = getelementptr i8, ptr %t, i64 120
  store ptr null, ptr %np
  br label %out
out:
  %u = call i32 @pthread_mutex_unlock(ptr %wl)
  ret void
}

; Wait on a condition variable, its mutex held. On a pool task the task parks and its worker runs
; others; anywhere else the thread waits. Either way the mutex is held again on return, and the
; caller looks at its condition again, as with any condition variable.
define hidden i32 @nz.cwait(ptr %cv, ptr %m) {
entry:
  %t = load ptr, ptr @nz.cur_task
  %isthread = icmp eq ptr %t, null
  br i1 %isthread, label %thread, label %task
thread:
  %r = call i32 @pthread_cond_wait(ptr %cv, ptr %m)
  ret i32 %r
task:
  call void @nz.pool_park(ptr %t, ptr %cv, ptr %m, i64 0)
  ret i32 0
}

; As `nz.cwait`, giving up at the **monotonic** time `%ts` (Q1-M-12): a task parks until the pool's
; monotonic clock passes it; a thread naps on the wall clock `pthread_cond_timedwait` measures, at
; most 100 ms at a time, and its caller looks again — every caller loops on its own deadline check.
define hidden i32 @nz.ctimedwait(ptr %cv, ptr %m, ptr %ts) {
entry:
  %nap = alloca [2 x i64], align 8
  %t = load ptr, ptr @nz.cur_task
  %isthread = icmp eq ptr %t, null
  br i1 %isthread, label %thread, label %task
thread:
  call void @nz.timed_nap(ptr %ts, ptr %nap)
  %r = call i32 @pthread_cond_timedwait(ptr %cv, ptr %m, ptr %nap)
  ret i32 %r
task:
  %s = load i64, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  %n = load i64, ptr %np
  ; Past i64's nanoseconds the deadline is "never", not a wrapped time in the past that wakes
  ; the task at once and forever (Q1-M-11): seconds above 9223372035 saturate.
  %sn = mul i64 %s, 1000000000
  %d0 = add i64 %sn, %n
  %far = icmp sgt i64 %s, 9223372035
  %d1 = select i1 %far, i64 9223372036854775807, i64 %d0
  %zero = icmp eq i64 %d1, 0
  %d = select i1 %zero, i64 1, i64 %d1
  call void @nz.pool_park(ptr %t, ptr %cv, ptr %m, i64 %d)
  ret i32 0
}

; A monotonic deadline as the wall-clock time `pthread_cond_timedwait` measures (Q1-M-12): the wall
; clock now, plus what is left of the deadline, at most 100 ms. A wall clock stepped forward ends a
; nap early and the caller, looking again on the monotonic clock, naps once more; one stepped back
; costs at most the 100 ms. Never a deadline on the wall clock itself.
define hidden void @nz.timed_nap(ptr %deadline, ptr %nap) {
entry:
  %mono = alloca [2 x i64], align 8
  %r0 = call i32 @nz_os_clock(i32 4, ptr %mono)
  %ms = load i64, ptr %mono
  %mnp = getelementptr i8, ptr %mono, i64 8
  %mn = load i64, ptr %mnp
  %msn = mul i64 %ms, 1000000000
  %now = add i64 %msn, %mn
  %ds = load i64, ptr %deadline
  %dnp = getelementptr i8, ptr %deadline, i64 8
  %dn = load i64, ptr %dnp
  ; Past i64's nanoseconds the deadline is "never" (as `nz.ctimedwait`'s task path saturates).
  %far = icmp sgt i64 %ds, 9223372035
  %dsn = mul i64 %ds, 1000000000
  %d0 = add i64 %dsn, %dn
  %d = select i1 %far, i64 9223372036854775807, i64 %d0
  %left0 = sub i64 %d, %now
  %past = icmp slt i64 %left0, 0
  %left = select i1 %past, i64 0, i64 %left0
  %long = icmp sgt i64 %left, 100000000
  %step = select i1 %long, i64 100000000, i64 %left
  %r1 = call i32 @nz_os_clock(i32 0, ptr %nap)
  %ws = load i64, ptr %nap
  %wnp = getelementptr i8, ptr %nap, i64 8
  %wn = load i64, ptr %wnp
  %wn1 = add i64 %wn, %step
  %carry = sdiv i64 %wn1, 1000000000
  %wn2 = srem i64 %wn1, 1000000000
  %ws1 = add i64 %ws, %carry
  store i64 %ws1, ptr %nap
  store i64 %wn2, ptr %wnp
  ret void
}

; Register as a waiter on `%cv`, mark the task parking under its worker's lock, let go of `%m`,
; and switch to the worker; on resuming, take `%m` again and leave the waiters if still there.
; The order makes a wake-up between the caller's last look and the switch impossible to lose: a
; waker needs `%m` to change anything, and finds the task registered and parking.
define hidden void @nz.pool_park(ptr %t, ptr %cv, ptr %m, i64 %deadline) {
entry:
  %wl = call ptr @nz.pool_lock_of(ptr %cv)
  %l = call i32 @pthread_mutex_lock(ptr %wl)
  %slot = call ptr @nz.pool_bucket(ptr %cv)
  %head = load ptr, ptr %slot
  %np = getelementptr i8, ptr %t, i64 120
  store ptr %head, ptr %np
  %cvp = getelementptr i8, ptr %t, i64 128
  store atomic ptr %cv, ptr %cvp monotonic, align 8
  store atomic ptr %t, ptr %slot monotonic, align 8
  %u = call i32 @pthread_mutex_unlock(ptr %wl)
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %wlk = call i32 @pthread_mutex_lock(ptr %w)
  %dp = getelementptr i8, ptr %t, i64 112
  store i64 %deadline, ptr %dp
  %sp = getelementptr i8, ptr %t, i64 24
  store i64 2, ptr %sp
  %wu = call i32 @pthread_mutex_unlock(ptr %w)
  %mu = call i32 @pthread_mutex_unlock(ptr %m)
  call void @nz.task_suspend(ptr %t)
  call void @nz.pool_unwait(ptr %t)
  %ml = call i32 @pthread_mutex_lock(ptr %m)
  ret void
}

; Wake every waiter on a condition variable: threads, by the variable, and pool tasks registered
; on it.
define hidden void @nz.cwake(ptr %cv) {
entry:
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %mode = load atomic i64, ptr @nz.pool_mode acquire, align 8
  %pool = icmp eq i64 %mode, 2
  br i1 %pool, label %tasks, label %out
tasks:
  ; An empty bucket has no task waiting on `%cv` (6.4): a waiter registers under the lock its
  ; caller holds while it looks at its condition, and a waker changes that condition under the
  ; same lock before it wakes, so a registration this wake must see is already visible.
  %slot = call ptr @nz.pool_bucket(ptr %cv)
  %first = load atomic ptr, ptr %slot monotonic, align 8
  %vacant = icmp eq ptr %first, null
  br i1 %vacant, label %out, label %lockit
lockit:
  %wl = call ptr @nz.pool_lock_of(ptr %cv)
  %l = call i32 @pthread_mutex_lock(ptr %wl)
  br label %walk
walk:
  %link = phi ptr [ %slot, %lockit ], [ %nlink, %skip ], [ %link, %woke ]
  %cur = load ptr, ptr %link
  %end = icmp eq ptr %cur, null
  br i1 %end, label %done, label %test
test:
  %cvp = getelementptr i8, ptr %cur, i64 128
  %on = load ptr, ptr %cvp
  %mine = icmp eq ptr %on, %cv
  %nlink = getelementptr i8, ptr %cur, i64 120
  br i1 %mine, label %take, label %skip
skip:
  br label %walk
take:
  %after = load ptr, ptr %nlink
  store atomic ptr %after, ptr %link monotonic, align 8
  store ptr null, ptr %nlink
  store atomic ptr null, ptr %cvp monotonic, align 8
  call void @nz.task_wake(ptr %cur)
  br label %woke
woke:
  br label %walk
done:
  %u = call i32 @pthread_mutex_unlock(ptr %wl)
  br label %out
out:
  ret void
}

; A pool task that looked and did not wait lets the rest of its worker's tasks run first.
define hidden void @nz.task_yield() {
entry:
  %t = load ptr, ptr @nz.cur_task
  %none = icmp eq ptr %t, null
  br i1 %none, label %out, label %yield
yield:
  %wp = getelementptr i8, ptr %t, i64 40
  %w = load ptr, ptr %wp
  %l = call i32 @pthread_mutex_lock(ptr %w)
  %sp = getelementptr i8, ptr %t, i64 24
  store i64 5, ptr %sp
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  call void @nz.task_suspend(ptr %t)
  br label %out
out:
  ret void
}

; With the schedule report asked for, the pool's line: its workers, the most tasks alive at once,
; and each task's stack — only where the pool ran.
define hidden void @nz.pool_report() {
entry:
  %buf = alloca [128 x i8], align 8
  %mode = load atomic i64, ptr @nz.pool_mode acquire, align 8
  %pool = icmp eq i64 %mode, 2
  br i1 %pool, label %say, label %out
say:
  %w = load i64, ptr @nz.pool_count
  %p = load i64, ptr @nz.pool_peak
  %s = load i64, ptr @nz.pool_stack
  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 128, ptr @.pool.fmt, i64 %w, i64 %p, i64 %s)
  %len = sext i32 %n to i64
  %wr = call i64 @write(i32 2, ptr %buf, i64 %len)
  br label %out
out:
  ret void
}

; Wait for one task to end: its thread joined, or its pool record marked done and freed.
define hidden i32 @nz.join_one(ptr %tid) {
entry:
  %mode = load atomic i64, ptr @nz.pool_mode acquire, align 8
  %pool = icmp eq i64 %mode, 2
  br i1 %pool, label %wait, label %thread
thread:
  %rc = call i32 @pthread_join(ptr %tid, ptr null)
  ret i32 %rc
wait:
  ; Already done: no lock (6.3).
  %dp = getelementptr i8, ptr %tid, i64 72
  %d0 = load atomic i64, ptr %dp acquire, align 8
  %early = icmp ne i64 %d0, 0
  br i1 %early, label %freed, label %count
count:
  %in = atomicrmw add ptr @nz.pool_joiners, i64 1 seq_cst
  %js = load ptr, ptr @nz.pool_join
  %jcv = getelementptr i8, ptr %js, i64 128
  %l = call i32 @pthread_mutex_lock(ptr %js)
  br label %check
check:
  %d = load atomic i64, ptr %dp seq_cst, align 8
  %done = icmp ne i64 %d, 0
  br i1 %done, label %free, label %sleep
sleep:
  %w = call i32 @nz.cwait(ptr %jcv, ptr %js)
  br label %check
free:
  %u = call i32 @pthread_mutex_unlock(ptr %js)
  %out = atomicrmw sub ptr @nz.pool_joiners, i64 1 seq_cst
  br label %freed
freed:
  call void @free(ptr %tid)
  ret i32 0
}
"#
}

pub fn rt_core_POOL_SPAWN() -> Str ! {} {
    r#"  ; The pool (N83, §7.84), when the environment asked for it; a pool that could not start
  ; starts nothing, as a thread that could not be created does.
  %mode = call i64 @nz.pool_mode_get()
  %pooled = icmp eq i64 %mode, 2
  br i1 %pooled, label %pool, label %nopool
pool:
  %prc = call i32 @nz.task_start(ptr %fn, ptr %blk)
  %pbad = icmp ne i32 %prc, 0
  br i1 %pbad, label %undo, label %ok
nopool:
  %broken = icmp eq i64 %mode, 4
  br i1 %broken, label %undo, label %thread
thread:
"#
}

pub fn rt_core_POOL_YIELD() -> Str ! {} {
    r#"  call void @nz.task_yield()
"#
}

pub fn rt_core_SCHED_RUNTIME() -> Str ! {} {
    r#"
define hidden void @nz.sched_note_spawn() {
entry:
  %n = atomicrmw add ptr @nz.sched_spawned, i64 1 monotonic
  ret void
}

; `%h` is the scope's task list; every task in it is about to be joined.
define hidden void @nz.sched_note_join(ptr %h) {
entry:
  %tasks = load i64, ptr %h
  %n = atomicrmw add ptr @nz.sched_joined, i64 %tasks monotonic
  ret void
}
"#
}

pub fn rt_core_GENERIC_CHANNEL_RUNTIME() -> Str ! {} {
    r#"
define hidden ptr @nz.chanv_new(i64 %cap, i64 %stride, ptr %release) {
entry:
  %c = call ptr @malloc(i64 80)
  %bad = icmp eq ptr %c, null
  br i1 %bad, label %fail, label %ring
fail:
  ret ptr null
freec:
  call void @free(ptr %c)
  ret ptr null
freed:
  call void @free(ptr %d)
  call void @free(ptr %c)
  ret ptr null
freem:
  call void @free(ptr %m)
  call void @free(ptr %d)
  call void @free(ptr %c)
  ret ptr null
ring:
  %r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %cap, i64 %stride)
  %over = extractvalue {i64, i1} %r, 1
  br i1 %over, label %freec, label %ask
ask:
  %bytes = extractvalue {i64, i1} %r, 0
  %room = add i64 %bytes, 8
  %d = call ptr @malloc(i64 %room)
  %badd = icmp eq ptr %d, null
  br i1 %badd, label %freec, label %lock
lock:
  %m = call ptr @malloc(i64 128)
  %badm = icmp eq ptr %m, null
  br i1 %badm, label %freed, label %cond
cond:
  %v = call ptr @malloc(i64 128)
  %badv = icmp eq ptr %v, null
  br i1 %badv, label %freem, label %init
init:
  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)
  %vi = call i32 @pthread_cond_init(ptr %v, ptr null)
  store i64 %cap, ptr %c
  %lenp = getelementptr i8, ptr %c, i64 8
  store i64 0, ptr %lenp
  %headp = getelementptr i8, ptr %c, i64 16
  store i64 0, ptr %headp
  %closedp = getelementptr i8, ptr %c, i64 24
  store i64 0, ptr %closedp
  %datap = getelementptr i8, ptr %c, i64 32
  store ptr %d, ptr %datap
  %mp = getelementptr i8, ptr %c, i64 40
  store ptr %m, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  store ptr %v, ptr %vp
  %refs = getelementptr i8, ptr %c, i64 56
  store i64 1, ptr %refs
  %sp = getelementptr i8, ptr %c, i64 64
  store i64 %stride, ptr %sp
  %relp = getelementptr i8, ptr %c, i64 72
  store ptr %release, ptr %relp
  %n = atomicrmw add ptr @nz.chan_allocated, i64 1 monotonic
  ret ptr %c
}

; The last reference releases what is still queued, slot by slot, by the element's own release
; function — then everything `nz.chan_release` frees for an `Int` channel.
define hidden void @nz.chanv_release(ptr %c) {
entry:
  %none = icmp eq ptr %c, null
  br i1 %none, label %done, label %drop
drop:
  %refs = getelementptr i8, ptr %c, i64 56
  %old = atomicrmw sub ptr %refs, i64 1 release
  %last = icmp eq i64 %old, 1
  br i1 %last, label %contents, label %done
contents:
  fence acquire
  %relp = getelementptr i8, ptr %c, i64 72
  %rel = load ptr, ptr %relp
  %norel = icmp eq ptr %rel, null
  br i1 %norel, label %destroy, label %walk
walk:
  %lenp = getelementptr i8, ptr %c, i64 8
  %len = load i64, ptr %lenp
  %headp = getelementptr i8, ptr %c, i64 16
  %head = load i64, ptr %headp
  %cap = load i64, ptr %c
  %sp = getelementptr i8, ptr %c, i64 64
  %stride = load i64, ptr %sp
  %datap0 = getelementptr i8, ptr %c, i64 32
  %data0 = load ptr, ptr %datap0
  br label %test
test:
  %i = phi i64 [ 0, %walk ], [ %next, %body ]
  %more = icmp slt i64 %i, %len
  br i1 %more, label %body, label %destroy
body:
  %sum = add i64 %head, %i
  %idx = urem i64 %sum, %cap
  %off = mul i64 %idx, %stride
  %slot = getelementptr i8, ptr %data0, i64 %off
  call void %rel(ptr %slot, ptr null)
  %next = add i64 %i, 1
  br label %test
destroy:
  %vp = getelementptr i8, ptr %c, i64 48
  %v = load ptr, ptr %vp
  %dv = call i32 @pthread_cond_destroy(ptr %v)
  call void @free(ptr %v)
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %dm = call i32 @pthread_mutex_destroy(ptr %m)
  call void @free(ptr %m)
  %datap = getelementptr i8, ptr %c, i64 32
  %data = load ptr, ptr %datap
  call void @free(ptr %data)
  call void @free(ptr %c)
  %n = atomicrmw add ptr @nz.chan_reclaimed, i64 1 monotonic
  br label %done
done:
  ret void
}

; Copies one slot in from `%src` — the sender's own reference, which the channel now holds —
; or refuses, copying nothing, when closed.
define hidden i1 @nz.chanv_send(ptr %c, ptr %src) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %lenp = getelementptr i8, ptr %c, i64 8
  %headp = getelementptr i8, ptr %c, i64 16
  %closedp = getelementptr i8, ptr %c, i64 24
  %datap = getelementptr i8, ptr %c, i64 32
  %sp = getelementptr i8, ptr %c, i64 64
  %stride = load i64, ptr %sp
  %l = call i32 @pthread_mutex_lock(ptr %m)
  br label %check
check:
  %closed = load i64, ptr %closedp
  %isclosed = icmp ne i64 %closed, 0
  br i1 %isclosed, label %refuse, label %space
space:
  %len = load i64, ptr %lenp
  %cap = load i64, ptr %c
  %full = icmp sge i64 %len, %cap
  br i1 %full, label %wait, label %store
wait:
  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)
  br label %check
refuse:
  %u1 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 false
store:
  %head = load i64, ptr %headp
  %sum = add i64 %head, %len
  %idx = urem i64 %sum, %cap
  %data = load ptr, ptr %datap
  %off = mul i64 %idx, %stride
  %slot = getelementptr i8, ptr %data, i64 %off
  call void @llvm.memcpy.p0.p0.i64(ptr %slot, ptr %src, i64 %stride, i1 false)
  %grown = add i64 %len, 1
  store i64 %grown, ptr %lenp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u2 = call i32 @pthread_mutex_unlock(ptr %m)
  call void @nz.sel_signal()
  ret i1 true
}

; Copies the oldest slot out to `%dst` — the reference moves to the receiver — or reports the
; channel closed and drained.
define hidden i1 @nz.chanv_recv(ptr %c, ptr %dst) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %lenp = getelementptr i8, ptr %c, i64 8
  %headp = getelementptr i8, ptr %c, i64 16
  %closedp = getelementptr i8, ptr %c, i64 24
  %datap = getelementptr i8, ptr %c, i64 32
  %sp = getelementptr i8, ptr %c, i64 64
  %stride = load i64, ptr %sp
  %l = call i32 @pthread_mutex_lock(ptr %m)
  br label %check
check:
  %len = load i64, ptr %lenp
  %nothing = icmp sle i64 %len, 0
  br i1 %nothing, label %maybe, label %take
maybe:
  %closed = load i64, ptr %closedp
  %isclosed = icmp ne i64 %closed, 0
  br i1 %isclosed, label %drained, label %wait
wait:
  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)
  br label %check
drained:
  %u1 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 false
take:
  %head = load i64, ptr %headp
  %cap = load i64, ptr %c
  %data = load ptr, ptr %datap
  %off = mul i64 %head, %stride
  %slot = getelementptr i8, ptr %data, i64 %off
  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %slot, i64 %stride, i1 false)
  %h1 = add i64 %head, 1
  %nh = urem i64 %h1, %cap
  store i64 %nh, ptr %headp
  %grown = sub i64 %len, 1
  store i64 %grown, ptr %lenp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u2 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 true
}
"#
}

pub fn rt_core_CHANNEL_RUNTIME() -> Str ! {} {
    r#"
define hidden ptr @nz.chan_new(i64 %cap) {
entry:
  %c = call ptr @malloc(i64 64)
  %bad = icmp eq ptr %c, null
  br i1 %bad, label %fail, label %ring
fail:
  ret ptr null
; A channel is four allocations, and a failure part-way through must not leave the earlier
; ones behind. One label per stage, each freeing exactly what has been taken by then —
; which is `docs/spec.md`'s failure law applied to the runtime's own storage, not only to
; the program's.
freec:
  call void @free(ptr %c)
  ret ptr null
freed:
  call void @free(ptr %d)
  call void @free(ptr %c)
  ret ptr null
freem:
  call void @free(ptr %m)
  call void @free(ptr %d)
  call void @free(ptr %c)
  ret ptr null
ring:
  ; Checked: a capacity large enough to overflow this product would allocate a ring
  ; smaller than the channel then believes it has.
  %r = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %cap, i64 8)
  %over = extractvalue {i64, i1} %r, 1
  br i1 %over, label %freec, label %ask
ask:
  %bytes = extractvalue {i64, i1} %r, 0
  %d = call ptr @malloc(i64 %bytes)
  %badd = icmp eq ptr %d, null
  br i1 %badd, label %freec, label %lock
lock:
  ; Sized generously on purpose: pthread_mutex_t and pthread_cond_t are opaque and
  ; differently sized on every platform, and there is no header to ask from here.
  ; Over-allocating is what makes this portable without a size to get wrong.
  %m = call ptr @malloc(i64 128)
  %badm = icmp eq ptr %m, null
  br i1 %badm, label %freed, label %cond
cond:
  %v = call ptr @malloc(i64 128)
  %badv = icmp eq ptr %v, null
  br i1 %badv, label %freem, label %init
init:
  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)
  %vi = call i32 @pthread_cond_init(ptr %v, ptr null)
  store i64 %cap, ptr %c
  %lenp = getelementptr i8, ptr %c, i64 8
  store i64 0, ptr %lenp
  %headp = getelementptr i8, ptr %c, i64 16
  store i64 0, ptr %headp
  %closedp = getelementptr i8, ptr %c, i64 24
  store i64 0, ptr %closedp
  %datap = getelementptr i8, ptr %c, i64 32
  store ptr %d, ptr %datap
  %mp = getelementptr i8, ptr %c, i64 40
  store ptr %m, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  store ptr %v, ptr %vp
  ; Born with one reference, held by the expression that created it.
  %rcp = getelementptr i8, ptr %c, i64 56
  store i64 1, ptr %rcp
  %n = atomicrmw add ptr @nz.chan_allocated, i64 1 monotonic
  ret ptr %c
}

define hidden void @nz.chan_retain(ptr %c) {
entry:
  %none = icmp eq ptr %c, null
  br i1 %none, label %done, label %bump
bump:
  %rcp = getelementptr i8, ptr %c, i64 56
  %old = atomicrmw add ptr %rcp, i64 1 monotonic
  br label %done
done:
  ret void
}

; The whole of a channel goes at once: the condition variable, the mutex, the ring and the
; header. Destroying the two primitives is not optional — `pthread_mutex_destroy` releases
; what the platform allocated behind an opaque handle, and freeing the memory without it
; leaks whatever that was. Neither can be in use: nothing holds a reference, so no thread
; is inside a send, a receive or a close.
define hidden void @nz.chan_release(ptr %c) {
entry:
  %none = icmp eq ptr %c, null
  br i1 %none, label %done, label %drop
drop:
  %rcp = getelementptr i8, ptr %c, i64 56
  %old = atomicrmw sub ptr %rcp, i64 1 release
  %last = icmp eq i64 %old, 1
  br i1 %last, label %destroy, label %done
destroy:
  fence acquire
  %vp = getelementptr i8, ptr %c, i64 48
  %v = load ptr, ptr %vp
  %dv = call i32 @pthread_cond_destroy(ptr %v)
  call void @free(ptr %v)
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %dm = call i32 @pthread_mutex_destroy(ptr %m)
  call void @free(ptr %m)
  %datap = getelementptr i8, ptr %c, i64 32
  %data = load ptr, ptr %datap
  call void @free(ptr %data)
  call void @free(ptr %c)
  %n = atomicrmw add ptr @nz.chan_reclaimed, i64 1 monotonic
  br label %done
done:
  ret void
}

define hidden i1 @nz.chan_send(ptr %c, i64 %v) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %lenp = getelementptr i8, ptr %c, i64 8
  %headp = getelementptr i8, ptr %c, i64 16
  %closedp = getelementptr i8, ptr %c, i64 24
  %datap = getelementptr i8, ptr %c, i64 32
  %l = call i32 @pthread_mutex_lock(ptr %m)
  br label %check
check:
  ; Closed is tested first and on every pass, so a channel closed while this sender
  ; waited refuses rather than queueing into something nobody will drain.
  %closed = load i64, ptr %closedp
  %isclosed = icmp ne i64 %closed, 0
  br i1 %isclosed, label %refuse, label %space
space:
  %len = load i64, ptr %lenp
  %cap = load i64, ptr %c
  %full = icmp sge i64 %len, %cap
  br i1 %full, label %wait, label %store
wait:
  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)
  br label %check
refuse:
  %u1 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 false
store:
  %head = load i64, ptr %headp
  %sum = add i64 %head, %len
  %idx = urem i64 %sum, %cap
  %data = load ptr, ptr %datap
  %slot = getelementptr i64, ptr %data, i64 %idx
  store i64 %v, ptr %slot
  %n1 = add i64 %len, 1
  store i64 %n1, ptr %lenp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u2 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 true
}

define hidden i1 @nz.chan_recv(ptr %c, ptr %seq, ptr %msg, i64 %mn) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %lenp = getelementptr i8, ptr %c, i64 8
  %headp = getelementptr i8, ptr %c, i64 16
  %closedp = getelementptr i8, ptr %c, i64 24
  %datap = getelementptr i8, ptr %c, i64 32
  %l = call i32 @pthread_mutex_lock(ptr %m)
  br label %check
check:
  ; A queued value wins over the close flag, which is what makes closing end a channel
  ; rather than discard what is in it.
  %len = load i64, ptr %lenp
  %empty = icmp sle i64 %len, 0
  br i1 %empty, label %maybe, label %take
maybe:
  %closed = load i64, ptr %closedp
  %isclosed = icmp ne i64 %closed, 0
  br i1 %isclosed, label %drained, label %wait
wait:
  %w = call i32 @pthread_cond_wait(ptr %cv, ptr %m)
  br label %check
drained:
  %u1 = call i32 @pthread_mutex_unlock(ptr %m)
  ret i1 false
take:
  %head = load i64, ptr %headp
  %cap = load i64, ptr %c
  %data = load ptr, ptr %datap
  %slot = getelementptr i64, ptr %data, i64 %head
  %val = load i64, ptr %slot
  %h1 = add i64 %head, 1
  %nh = urem i64 %h1, %cap
  store i64 %nh, ptr %headp
  %n1 = sub i64 %len, 1
  store i64 %n1, ptr %lenp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u2 = call i32 @pthread_mutex_unlock(ptr %m)
  ; The push happens after the unlock. Growing a sequence may call `realloc`, and holding
  ; a channel's mutex across an allocation would make every other task on it wait for the
  ; allocator.
  %grown = call ptr @nz.arr_grow(ptr %seq, i64 8)
  %oom = icmp eq ptr %grown, null
  br i1 %oom, label %nomem, label %push
nomem:
  ; Records and returns, like every other failure. `false` is the stand-in `chan_recv`
  ; hands back while unwinding; the caller checks the flag before it reads it.
  call void @nz.fail(ptr %msg, i64 %mn)
  ret i1 false
push:
  %sn = load i64, ptr %seq
  %sslot = getelementptr i64, ptr %grown, i64 %sn
  store i64 %val, ptr %sslot
  %sn1 = add i64 %sn, 1
  store i64 %sn1, ptr %seq
  ret i1 true
}

define hidden void @nz.chan_close(ptr %c) {
entry:
  %mp = getelementptr i8, ptr %c, i64 40
  %m = load ptr, ptr %mp
  %vp = getelementptr i8, ptr %c, i64 48
  %cv = load ptr, ptr %vp
  %l = call i32 @pthread_mutex_lock(ptr %m)
  %closedp = getelementptr i8, ptr %c, i64 24
  store i64 1, ptr %closedp
  %b = call i32 @pthread_cond_broadcast(ptr %cv)
  %u = call i32 @pthread_mutex_unlock(ptr %m)
  ret void
}
"#
}

pub fn rt_core_WIDE_RUNTIME() -> Str ! {} {
    r#"
define hidden void @nz.i128_divrem(ptr %out, ptr %pa, ptr %pb, i64 %op) {
entry:
  %a = load i128, ptr %pa, align 8
  %b = load i128, ptr %pb, align 8
  switch i64 %op, label %urem [ i64 0, label %sdiv i64 1, label %srem i64 2, label %udiv ]
sdiv:
  %q = sdiv i128 %a, %b
  store i128 %q, ptr %out, align 8
  ret void
srem:
  %r = srem i128 %a, %b
  store i128 %r, ptr %out, align 8
  ret void
udiv:
  %uq = udiv i128 %a, %b
  store i128 %uq, ptr %out, align 8
  ret void
urem:
  %ur = urem i128 %a, %b
  store i128 %ur, ptr %out, align 8
  ret void
}

define hidden i32 @nz.i128_mul(ptr %out, ptr %pa, ptr %pb, i64 %signed) {
entry:
  %a = load i128, ptr %pa, align 8
  %b = load i128, ptr %pb, align 8
  %p = mul i128 %a, %b
  store i128 %p, ptr %out, align 8
  %s = icmp ne i64 %signed, 0
  br i1 %s, label %sgn, label %uns
uns:
  %u = call {i128, i1} @llvm.umul.with.overflow.i128(i128 %a, i128 %b)
  %uo = extractvalue {i128, i1} %u, 1
  %ur = zext i1 %uo to i32
  ret i32 %ur
sgn:
  %an = icmp slt i128 %a, 0
  %na = sub i128 0, %a
  %ma = select i1 %an, i128 %na, i128 %a
  %bn = icmp slt i128 %b, 0
  %nb = sub i128 0, %b
  %mb = select i1 %bn, i128 %nb, i128 %b
  %m = call {i128, i1} @llvm.umul.with.overflow.i128(i128 %ma, i128 %mb)
  %mo = extractvalue {i128, i1} %m, 1
  %mv = extractvalue {i128, i1} %m, 0
  %neg = xor i1 %an, %bn
  %limit = select i1 %neg, i128 170141183460469231731687303715884105728, i128 170141183460469231731687303715884105727
  %past = icmp ugt i128 %mv, %limit
  %bad = or i1 %mo, %past
  %r = zext i1 %bad to i32
  ret i32 %r
}

define hidden double @nz.i128_to_f64(ptr %pa, i64 %signed) {
entry:
  %a = load i128, ptr %pa, align 8
  %s = icmp ne i64 %signed, 0
  br i1 %s, label %sgn, label %uns
sgn:
  %f = sitofp i128 %a to double
  ret double %f
uns:
  %g = uitofp i128 %a to double
  ret double %g
}

define hidden float @nz.i128_to_f32(ptr %pa, i64 %signed) {
entry:
  %a = load i128, ptr %pa, align 8
  %s = icmp ne i64 %signed, 0
  br i1 %s, label %sgn, label %uns
sgn:
  %f = sitofp i128 %a to float
  ret float %f
uns:
  %g = uitofp i128 %a to float
  ret float %g
}

define hidden void @nz.f64_to_i128(ptr %out, double %x, i64 %signed) {
entry:
  %s = icmp ne i64 %signed, 0
  br i1 %s, label %sgn, label %uns
sgn:
  %a = call i128 @llvm.fptosi.sat.i128.f64(double %x)
  store i128 %a, ptr %out, align 8
  ret void
uns:
  %b = call i128 @llvm.fptoui.sat.i128.f64(double %x)
  store i128 %b, ptr %out, align 8
  ret void
}

; Digits from the right into 40 bytes of its own — `UInt128::MAX` has 39 — then a sign and a
; copy to the front of the caller's.
define hidden i64 @nz.format_i128(ptr %buf, ptr %pa, i64 %signed) {
entry:
  %v = load i128, ptr %pa, align 8
  %s = icmp ne i64 %signed, 0
  %lt = icmp slt i128 %v, 0
  %neg = and i1 %s, %lt
  %nv = sub i128 0, %v
  %mag = select i1 %neg, i128 %nv, i128 %v
  %tmp = alloca [40 x i8], align 1
  br label %loop
loop:
  %m = phi i128 [ %mag, %entry ], [ %q, %loop ]
  %i = phi i64 [ 40, %entry ], [ %j, %loop ]
  %q = udiv i128 %m, 10
  %r = urem i128 %m, 10
  %d = trunc i128 %r to i8
  %c = add i8 %d, 48
  %j = sub i64 %i, 1
  %at = getelementptr i8, ptr %tmp, i64 %j
  store i8 %c, ptr %at
  %more = icmp ne i128 %q, 0
  br i1 %more, label %loop, label %done
done:
  %len = sub i64 40, %j
  %sl = zext i1 %neg to i64
  br i1 %neg, label %minus, label %copy
minus:
  store i8 45, ptr %buf
  br label %copy
copy:
  %dst = getelementptr i8, ptr %buf, i64 %sl
  %src = getelementptr i8, ptr %tmp, i64 %j
  br label %byte
byte:
  %k = phi i64 [ 0, %copy ], [ %k1, %byte ]
  %from = getelementptr i8, ptr %src, i64 %k
  %ch = load i8, ptr %from
  %to = getelementptr i8, ptr %dst, i64 %k
  store i8 %ch, ptr %to
  %k1 = add i64 %k, 1
  %again = icmp ult i64 %k1, %len
  br i1 %again, label %byte, label %end
end:
  %total = add i64 %len, %sl
  ret i64 %total
}
"#
}

pub fn rt_core_NUMBER_RUNTIME() -> Str ! {} {
    r#"
@.fmt.e = private unnamed_addr constant [5 x i8] c"%.*e\00"
@.fmt.f = private unnamed_addr constant [5 x i8] c"%.*f\00"
@.fmt.lld = private unnamed_addr constant [5 x i8] c"%lld\00"

; A UInt64's decimal digits into 21 bytes the caller owns: how many (as `nz.format_int`).
define hidden i64 @nz.format_u64(ptr %buf, i64 %v) {
entry:
  %tmp = alloca [24 x i8], align 1
  %neg = icmp ne i64 0, 0
  %m = add i64 %v, 0
  %xs = alloca i64
  %ks = alloca i64
  %ss = alloca i64
  store i64 %m, ptr %xs
  store i64 24, ptr %ks
  br label %digit
digit:
  %x = load i64, ptr %xs
  %k = load i64, ptr %ks
  %q = udiv i64 %x, 10
  %qt = mul i64 %q, 10
  %r = sub i64 %x, %qt
  %ch = add i64 %r, 48
  %c8 = trunc i64 %ch to i8
  %k1 = sub i64 %k, 1
  %slot = getelementptr i8, ptr %tmp, i64 %k1
  store i8 %c8, ptr %slot
  store i64 %q, ptr %xs
  store i64 %k1, ptr %ks
  store i64 %k1, ptr %ss
  %more = icmp ne i64 %q, 0
  br i1 %more, label %digit, label %sign
sign:
  %km = sub i64 %k1, 1
  br i1 %neg, label %minus, label %copy
minus:
  %ms = getelementptr i8, ptr %tmp, i64 %km
  store i8 45, ptr %ms
  store i64 %km, ptr %ss
  br label %copy
copy:
  %start = load i64, ptr %ss
  %len = sub i64 24, %start
  %from = getelementptr i8, ptr %tmp, i64 %start
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %from, i64 %len, i1 false)
  ret i64 %len
}

; A float with exactly `digits` decimals (R1a, L4), C's `%.*f`, into 360 bytes the caller owns:
; `nan`, `inf` and `-inf` as `nz.format_float` spells them, so neither depends on a C library's.
define hidden i64 @nz.format_fixed(ptr %buf, double %x, i64 %digits) {
entry:
  %isnan = fcmp uno double %x, %x
  br i1 %isnan, label %nan, label %number
nan:
  store i8 110, ptr %buf
  %a1 = getelementptr i8, ptr %buf, i64 1
  store i8 97, ptr %a1
  %a2 = getelementptr i8, ptr %buf, i64 2
  store i8 110, ptr %a2
  ret i64 3
number:
  %ax = call double @llvm.fabs.f64(double %x)
  %isinf = fcmp oeq double %ax, 0x7FF0000000000000
  br i1 %isinf, label %inf, label %finite
inf:
  %neg = fcmp olt double %x, 0.0
  %signlen = zext i1 %neg to i64
  br i1 %neg, label %minus, label %word
minus:
  store i8 45, ptr %buf
  br label %word
word:
  %out = getelementptr i8, ptr %buf, i64 %signlen
  store i8 105, ptr %out
  %b1 = getelementptr i8, ptr %out, i64 1
  store i8 110, ptr %b1
  %b2 = getelementptr i8, ptr %out, i64 2
  store i8 102, ptr %b2
  %li = add i64 %signlen, 3
  ret i64 %li
finite:
  %d = trunc i64 %digits to i32
  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 360, ptr @.fmt.f, i32 %d, double %x)
  %n = sext i32 %w to i64
  ret i64 %n
}

define hidden i64 @nz.format_float(ptr %buf, double %x, i1 %single) {
entry:
  %tmp = alloca [48 x i8]
  %dig = alloca [32 x i8]
  %isnan = fcmp uno double %x, %x
  br i1 %isnan, label %nan, label %number
nan:
  store i8 110, ptr %buf
  %n1 = getelementptr i8, ptr %buf, i64 1
  store i8 97, ptr %n1
  %n2 = getelementptr i8, ptr %buf, i64 2
  store i8 110, ptr %n2
  ret i64 3
number:
  %bits = bitcast double %x to i64
  %neg = icmp slt i64 %bits, 0
  %signlen = zext i1 %neg to i64
  br i1 %neg, label %minus, label %magnitude
minus:
  store i8 45, ptr %buf
  br label %magnitude
magnitude:
  %out = getelementptr i8, ptr %buf, i64 %signlen
  %ax = call double @llvm.fabs.f64(double %x)
  %isinf = fcmp oeq double %ax, 0x7FF0000000000000
  br i1 %isinf, label %inf, label %finite
inf:
  store i8 105, ptr %out
  %i1 = getelementptr i8, ptr %out, i64 1
  store i8 110, ptr %i1
  %i2 = getelementptr i8, ptr %out, i64 2
  store i8 102, ptr %i2
  %li = add i64 %signlen, 3
  ret i64 %li
finite:
  %iszero = fcmp oeq double %ax, 0.0
  br i1 %iszero, label %zero, label %try
zero:
  store i8 48, ptr %out
  %lz = add i64 %signlen, 1
  ret i64 %lz
try:
  %p = phi i32 [ 0, %finite ], [ %p1, %try.next ]
  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %tmp, i64 48, ptr @.fmt.e, i32 %p, double %ax)
  br i1 %single, label %try.f, label %try.d
try.f:
  %vf = call float @strtof(ptr %tmp, ptr null)
  %xf = fptrunc double %ax to float
  %okf = fcmp oeq float %vf, %xf
  br label %try.check
try.d:
  %vd = call double @strtod(ptr %tmp, ptr null)
  %okd = fcmp oeq double %vd, %ax
  br label %try.check
try.check:
  %ok = phi i1 [ %okf, %try.f ], [ %okd, %try.d ]
  %last = icmp sge i32 %p, 17
  %stop = or i1 %ok, %last
  %p1 = add i32 %p, 1
  br i1 %stop, label %scan, label %try.next
try.next:
  br label %try
scan:
  %i = phi i64 [ 0, %try.check ], [ %i.next, %scan.keep ]
  %k = phi i64 [ 0, %try.check ], [ %k.next, %scan.keep ]
  %cp = getelementptr i8, ptr %tmp, i64 %i
  %c = load i8, ptr %cp
  %ise = icmp eq i8 %c, 101
  br i1 %ise, label %exponent, label %scan.keep
scan.keep:
  %isdot = icmp eq i8 %c, 46
  %dp = getelementptr i8, ptr %dig, i64 %k
  store i8 %c, ptr %dp
  %step = select i1 %isdot, i64 0, i64 1
  %k.next = add i64 %k, %step
  %i.next = add i64 %i, 1
  br label %scan
exponent:
  %ep = getelementptr i8, ptr %tmp, i64 %i
  %ep1 = getelementptr i8, ptr %ep, i64 1
  %e = call i64 @atoll(ptr %ep1)
  %n = add i64 %e, 1
  %len = call i64 @nz.fmt_layout(ptr %out, ptr %dig, i64 %k, i64 %n)
  %total = add i64 %len, %signlen
  ret i64 %total
}

define hidden i64 @nz.fmt_layout(ptr %out, ptr %dig, i64 %k, i64 %n) {
entry:
  %le21 = icmp sle i64 %n, 21
  %kle = icmp sle i64 %k, %n
  %whole = and i1 %kle, %le21
  br i1 %whole, label %int, label %t2
int:
  call void @llvm.memcpy.p0.p0.i64(ptr %out, ptr %dig, i64 %k, i1 false)
  %zeros = sub i64 %n, %k
  %zp = getelementptr i8, ptr %out, i64 %k
  call void @llvm.memset.p0.i64(ptr %zp, i8 48, i64 %zeros, i1 false)
  ret i64 %n
t2:
  %pos = icmp sgt i64 %n, 0
  %mid = and i1 %pos, %le21
  br i1 %mid, label %frac, label %t3
frac:
  call void @llvm.memcpy.p0.p0.i64(ptr %out, ptr %dig, i64 %n, i1 false)
  %dot = getelementptr i8, ptr %out, i64 %n
  store i8 46, ptr %dot
  %rest = getelementptr i8, ptr %dig, i64 %n
  %rl = sub i64 %k, %n
  %after = getelementptr i8, ptr %dot, i64 1
  call void @llvm.memcpy.p0.p0.i64(ptr %after, ptr %rest, i64 %rl, i1 false)
  %lf = add i64 %k, 1
  ret i64 %lf
t3:
  %gtm6 = icmp sgt i64 %n, -6
  %le0 = icmp sle i64 %n, 0
  %small = and i1 %gtm6, %le0
  br i1 %small, label %tiny, label %sci
tiny:
  store i8 48, ptr %out
  %o1 = getelementptr i8, ptr %out, i64 1
  store i8 46, ptr %o1
  %nz = sub i64 0, %n
  %o2 = getelementptr i8, ptr %out, i64 2
  call void @llvm.memset.p0.i64(ptr %o2, i8 48, i64 %nz, i1 false)
  %o3 = getelementptr i8, ptr %o2, i64 %nz
  call void @llvm.memcpy.p0.p0.i64(ptr %o3, ptr %dig, i64 %k, i1 false)
  %lt0 = add i64 %nz, 2
  %lt = add i64 %lt0, %k
  ret i64 %lt
sci:
  %d0 = load i8, ptr %dig
  store i8 %d0, ptr %out
  %one = icmp eq i64 %k, 1
  br i1 %one, label %sci.e, label %sci.frac
sci.frac:
  %s1 = getelementptr i8, ptr %out, i64 1
  store i8 46, ptr %s1
  %s2 = getelementptr i8, ptr %out, i64 2
  %d1 = getelementptr i8, ptr %dig, i64 1
  %km1 = sub i64 %k, 1
  call void @llvm.memcpy.p0.p0.i64(ptr %s2, ptr %d1, i64 %km1, i1 false)
  %kp1 = add i64 %k, 1
  br label %sci.e
sci.e:
  %at = phi i64 [ 1, %sci ], [ %kp1, %sci.frac ]
  %ech = getelementptr i8, ptr %out, i64 %at
  store i8 101, ptr %ech
  %e1 = sub i64 %n, 1
  %eneg = icmp slt i64 %e1, 0
  %sign = select i1 %eneg, i8 45, i8 43
  %sch = getelementptr i8, ptr %ech, i64 1
  store i8 %sign, ptr %sch
  %eabs.n = sub i64 0, %e1
  %eabs = select i1 %eneg, i64 %eabs.n, i64 %e1
  %edig = getelementptr i8, ptr %sch, i64 1
  %ew = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %edig, i64 8, ptr @.fmt.lld, i64 %eabs)
  %ewl = sext i32 %ew to i64
  %ls0 = add i64 %at, 2
  %ls = add i64 %ls0, %ewl
  ret i64 %ls
}

define hidden i64 @nz.digits_from(ptr %p, i64 %i, i64 %n) {
entry:
  br label %loop
loop:
  %j = phi i64 [ %i, %entry ], [ %j1, %more ]
  %inside = icmp slt i64 %j, %n
  br i1 %inside, label %look, label %done
look:
  %cp = getelementptr i8, ptr %p, i64 %j
  %c = load i8, ptr %cp
  %ge0 = icmp uge i8 %c, 48
  %le9 = icmp ule i8 %c, 57
  %d = and i1 %ge0, %le9
  br i1 %d, label %more, label %done
more:
  %j1 = add i64 %j, 1
  br label %loop
done:
  ret i64 %j
}

define hidden i1 @nz.float_parses(ptr %p, i64 %n) {
entry:
  %has = icmp sgt i64 %n, 0
  br i1 %has, label %first, label %no
first:
  %c0 = load i8, ptr %p
  %plus = icmp eq i8 %c0, 43
  %minus = icmp eq i8 %c0, 45
  %signed = or i1 %plus, %minus
  %start = zext i1 %signed to i64
  %left = sub i64 %n, %start
  %three = icmp eq i64 %left, 3
  br i1 %three, label %word, label %digits
word:
  %wp = getelementptr i8, ptr %p, i64 %start
  %w0 = load i8, ptr %wp
  %wp1 = getelementptr i8, ptr %wp, i64 1
  %w1 = load i8, ptr %wp1
  %wp2 = getelementptr i8, ptr %wp, i64 2
  %w2 = load i8, ptr %wp2
  %i0 = icmp eq i8 %w0, 105
  %i1 = icmp eq i8 %w1, 110
  %i2 = icmp eq i8 %w2, 102
  %ia = and i1 %i0, %i1
  %inf = and i1 %ia, %i2
  %a0 = icmp eq i8 %w0, 110
  %a1 = icmp eq i8 %w1, 97
  %a2 = icmp eq i8 %w2, 110
  %aa = and i1 %a0, %a1
  %nan = and i1 %aa, %a2
  %named = or i1 %inf, %nan
  br i1 %named, label %yes, label %digits
digits:
  %w.end = call i64 @nz.digits_from(ptr %p, i64 %start, i64 %n)
  %whole = sub i64 %w.end, %start
  %in1 = icmp slt i64 %w.end, %n
  br i1 %in1, label %dot.look, label %after.frac
dot.look:
  %dcp = getelementptr i8, ptr %p, i64 %w.end
  %dc = load i8, ptr %dcp
  %isdot = icmp eq i8 %dc, 46
  br i1 %isdot, label %fraction, label %after.frac
fraction:
  %f.start = add i64 %w.end, 1
  %f.end = call i64 @nz.digits_from(ptr %p, i64 %f.start, i64 %n)
  %frac.n = sub i64 %f.end, %f.start
  br label %after.frac
after.frac:
  %at = phi i64 [ %w.end, %digits ], [ %w.end, %dot.look ], [ %f.end, %fraction ]
  %fr = phi i64 [ 0, %digits ], [ 0, %dot.look ], [ %frac.n, %fraction ]
  %mant = add i64 %whole, %fr
  %some = icmp sgt i64 %mant, 0
  br i1 %some, label %exp.look, label %no
exp.look:
  %in2 = icmp slt i64 %at, %n
  br i1 %in2, label %exp.char, label %end
exp.char:
  %ecp = getelementptr i8, ptr %p, i64 %at
  %ec = load i8, ptr %ecp
  %e.lo = icmp eq i8 %ec, 101
  %e.up = icmp eq i8 %ec, 69
  %ise = or i1 %e.lo, %e.up
  br i1 %ise, label %exp.sign, label %end
exp.sign:
  %e1 = add i64 %at, 1
  %in3 = icmp slt i64 %e1, %n
  br i1 %in3, label %exp.sign.look, label %no
exp.sign.look:
  %scp = getelementptr i8, ptr %p, i64 %e1
  %sc = load i8, ptr %scp
  %sp = icmp eq i8 %sc, 43
  %sm = icmp eq i8 %sc, 45
  %ss = or i1 %sp, %sm
  %skip = zext i1 %ss to i64
  %e.start = add i64 %e1, %skip
  %e.end = call i64 @nz.digits_from(ptr %p, i64 %e.start, i64 %n)
  %e.n = sub i64 %e.end, %e.start
  %e.some = icmp sgt i64 %e.n, 0
  br i1 %e.some, label %end.exp, label %no
end.exp:
  %all.e = icmp eq i64 %e.end, %n
  ret i1 %all.e
end:
  %all = icmp eq i64 %at, %n
  ret i1 %all
yes:
  ret i1 true
no:
  ret i1 false
}

define hidden double @nz.float_parse(ptr %p, i64 %n) {
entry:
  %ok = call i1 @nz.float_parses(ptr %p, i64 %n)
  br i1 %ok, label %copy, label %nan
copy:
  %room = add i64 %n, 1
  %c = call ptr @malloc(i64 %room)
  %none = icmp eq ptr %c, null
  br i1 %none, label %nan, label %read
read:
  call void @llvm.memcpy.p0.p0.i64(ptr %c, ptr %p, i64 %n, i1 false)
  %end = getelementptr i8, ptr %c, i64 %n
  store i8 0, ptr %end
  %v = call double @strtod(ptr %c, ptr null)
  call void @free(ptr %c)
  ret double %v
nan:
  ret double 0x7FF8000000000000
}
"#
}

pub fn rt_files_FILES_RUNTIME() -> Str ! {} {
    r#"
@nz.os_lock = hidden global i32 0
@nz.os_slots = hidden global ptr null
@nz.os_cap = hidden global i64 0
@nz.os_stdin_h = hidden global i64 0
@nz.os_in_buf = hidden global ptr null
@nz.os_in_at = hidden global i64 0
@nz.os_in_end = hidden global i64 0
@nz.os_in_lock = hidden global i32 0
@nz.os_stdout_h = hidden global i64 0
@nz.os_stderr_h = hidden global i64 0

declare i32 @nz_os_open(ptr, i64)
declare i32 @nz_os_mkdir(ptr)
declare i32 @nz_os_stat(ptr, ptr)
declare ptr @nz_os_opendir(ptr)
declare i64 @nz_os_readdir(ptr, ptr, i64)
declare i64 @nz_os_family()
declare i64 @nz_os_error_text(i64, ptr, i64)

define hidden void @nz.os_acquire() {
entry:
  br label %spin
spin:
  %old = atomicrmw xchg ptr @nz.os_lock, i32 1 acquire
  %free = icmp eq i32 %old, 0
  br i1 %free, label %held, label %spin
held:
  ret void
}

define hidden void @nz.os_release() {
entry:
  store atomic i32 0, ptr @nz.os_lock release, align 4
  ret void
}

; -errno, read the moment a system call has failed.
define hidden i64 @nz.os_errno() {
entry:
  %p = call ptr @nz_errno_location()
  %e = load i32, ptr %p
  %w = sext i32 %e to i64
  %neg = sub i64 0, %w
  ret i64 %neg
}

; The slot for descriptor `fd`, growing the table to hold it; null when memory is refused. The
; lock is held.
define hidden ptr @nz.os_slot(i64 %fd) {
entry:
  %cap = load i64, ptr @nz.os_cap
  %fits = icmp slt i64 %fd, %cap
  br i1 %fits, label %at, label %grow
grow:
  %twice = shl i64 %cap, 1
  %need = add i64 %fd, 1
  %more = icmp sgt i64 %need, %twice
  %want = select i1 %more, i64 %need, i64 %twice
  %small = icmp slt i64 %want, 64
  %new = select i1 %small, i64 64, i64 %want
  %bytes = mul i64 %new, 64
  %old = load ptr, ptr @nz.os_slots
  %p = call ptr @realloc(ptr %old, i64 %bytes)
  %none = icmp eq ptr %p, null
  br i1 %none, label %refused, label %zero
refused:
  ret ptr null
zero:
  %from = mul i64 %cap, 64
  %start = getelementptr i8, ptr %p, i64 %from
  %rest = sub i64 %bytes, %from
  call void @llvm.memset.p0.i64(ptr %start, i8 0, i64 %rest, i1 false)
  store ptr %p, ptr @nz.os_slots
  store i64 %new, ptr @nz.os_cap
  br label %at
at:
  %slots = load ptr, ptr @nz.os_slots
  %off = mul i64 %fd, 64
  %slot = getelementptr i8, ptr %slots, i64 %off
  ret ptr %slot
}

; A new handle for `fd`, of state `kind`, holding `obj`; -ENOMEM when the table cannot grow. The
; lock is held.
define hidden i64 @nz.os_register(i64 %fd, i64 %kind, ptr %obj) {
entry:
  %slot = call ptr @nz.os_slot(i64 %fd)
  %none = icmp eq ptr %slot, null
  br i1 %none, label %refused, label %fill
refused:
  ret i64 -12
fill:
  %g = load i64, ptr %slot
  %gen = add i64 %g, 1
  store i64 %gen, ptr %slot
  %usersp = getelementptr i8, ptr %slot, i64 8
  store i64 0, ptr %usersp
  %statep = getelementptr i8, ptr %slot, i64 16
  store i64 %kind, ptr %statep
  %objp = getelementptr i8, ptr %slot, i64 24
  store ptr %obj, ptr %objp
  %deadlinep = getelementptr i8, ptr %slot, i64 40
  store i64 0, ptr %deadlinep
  %hi = shl i64 %gen, 32
  %h = or i64 %hi, %fd
  ret i64 %h
}

; The live slot `h` names, or null. The lock is held.
define hidden ptr @nz.os_live(i64 %h) {
entry:
  %neg = icmp slt i64 %h, 0
  br i1 %neg, label %dead, label %look
look:
  %fd = and i64 %h, 4294967295
  %gen = lshr i64 %h, 32
  %cap = load i64, ptr @nz.os_cap
  %fits = icmp slt i64 %fd, %cap
  br i1 %fits, label %slot, label %dead
slot:
  %slots = load ptr, ptr @nz.os_slots
  %off = mul i64 %fd, 64
  %s = getelementptr i8, ptr %slots, i64 %off
  %g = load i64, ptr %s
  %same = icmp eq i64 %g, %gen
  %statep = getelementptr i8, ptr %s, i64 16
  %state = load i64, ptr %statep
  %open = icmp ne i64 %state, 0
  %closing = and i64 %state, 256
  %staying = icmp eq i64 %closing, 0
  %a = and i1 %same, %open
  %live = and i1 %a, %staying
  br i1 %live, label %found, label %dead
found:
  ret ptr %s
dead:
  ret ptr null
}

; Pin `h`: its state (1 a file, 2 a directory, 3 standard input), or its status — -65536 for a
; handle that is closed, a number no system gives an error.
define hidden i64 @nz.os_pin(i64 %h) {
entry:
  %neg = icmp slt i64 %h, 0
  br i1 %neg, label %failed, label %lock
failed:
  ret i64 %h
lock:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  %dead = icmp eq ptr %s, null
  br i1 %dead, label %closed, label %pin
closed:
  call void @nz.os_release()
  ret i64 -65536
pin:
  %usersp = getelementptr i8, ptr %s, i64 8
  %u = load i64, ptr %usersp
  %u1 = add i64 %u, 1
  store i64 %u1, ptr %usersp
  %statep = getelementptr i8, ptr %s, i64 16
  %kind = load i64, ptr %statep
  call void @nz.os_release()
  ret i64 %kind
}

; Close what `fd` or `obj` holds: 0, or -errno. Standard output and errors (R1d) stay open: the
; handle is closed, the stream is not, and `print` keeps writing.
define hidden i64 @nz.os_shut(i64 %fd, i64 %kind, ptr %obj) {
entry:
  %stream = icmp eq i64 %kind, 10
  br i1 %stream, label %ok, label %which
which:
  %dir = icmp eq i64 %kind, 2
  br i1 %dir, label %closedir, label %close
closedir:
  %rd = call i32 @nz_os_closedir(ptr %obj)
  br label %done
close:
  %d = trunc i64 %fd to i32
  %rf = call i32 @nz_os_close(i32 %d)
  br label %done
done:
  %r = phi i32 [ %rd, %closedir ], [ %rf, %close ]
  %bad = icmp slt i32 %r, 0
  br i1 %bad, label %fail, label %ok
fail:
  %e = call i64 @nz.os_errno()
  ret i64 %e
ok:
  ret i64 0
}

; Unpin `h`; the last unpin of a handle closed meanwhile closes it.
define hidden void @nz.os_unpin(i64 %h) {
entry:
  call void @nz.os_acquire()
  %fd = and i64 %h, 4294967295
  %slots = load ptr, ptr @nz.os_slots
  %off = mul i64 %fd, 64
  %s = getelementptr i8, ptr %slots, i64 %off
  %usersp = getelementptr i8, ptr %s, i64 8
  %u = load i64, ptr %usersp
  %u1 = sub i64 %u, 1
  store i64 %u1, ptr %usersp
  %statep = getelementptr i8, ptr %s, i64 16
  %state = load i64, ptr %statep
  %closing = and i64 %state, 256
  %waiting = icmp ne i64 %closing, 0
  %last = icmp eq i64 %u1, 0
  %shut = and i1 %waiting, %last
  br i1 %shut, label %close, label %keep
keep:
  call void @nz.os_release()
  ret void
close:
  %kind = and i64 %state, 255
  %objp = getelementptr i8, ptr %s, i64 24
  %obj = load ptr, ptr %objp
  store i64 0, ptr %statep
  call void @nz.os_release()
  %r = call i64 @nz.os_shut(i64 %fd, i64 %kind, ptr %obj)
  ret void
}

define hidden i64 @nz.os_close(i64 %h) {
entry:
  %neg = icmp slt i64 %h, 0
  br i1 %neg, label %failed, label %lock
failed:
  ret i64 %h
lock:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  %dead = icmp eq ptr %s, null
  br i1 %dead, label %closed, label %live
closed:
  call void @nz.os_release()
  ret i64 -65536
live:
  %usersp = getelementptr i8, ptr %s, i64 8
  %u = load i64, ptr %usersp
  %statep = getelementptr i8, ptr %s, i64 16
  %state = load i64, ptr %statep
  %busy = icmp sgt i64 %u, 0
  br i1 %busy, label %later, label %now
later:
  %marked = or i64 %state, 256
  store i64 %marked, ptr %statep
  ; A socket's waiters wake, find the handle closing, and answer `Closed`; the last of them
  ; to let go closes the descriptor.
  %waitp = getelementptr i8, ptr %s, i64 32
  %wait = load ptr, ptr %waitp
  call void @nz.os_release()
  call void @nz.net_wake(ptr %wait)
  ret i64 0
now:
  %objp = getelementptr i8, ptr %s, i64 24
  %obj = load ptr, ptr %objp
  store i64 0, ptr %statep
  call void @nz.os_release()
  %fd = and i64 %h, 4294967295
  %r = call i64 @nz.os_shut(i64 %fd, i64 %state, ptr %obj)
  ret i64 %r
}

; A handle for descriptor `fd` just opened as `kind`; on a table that cannot grow, the
; descriptor is closed and the status answered.
define hidden i64 @nz.os_adopt(i32 %fd, i64 %kind, ptr %obj) {
entry:
  %w = sext i32 %fd to i64
  call void @nz.os_acquire()
  %h = call i64 @nz.os_register(i64 %w, i64 %kind, ptr %obj)
  call void @nz.os_release()
  %bad = icmp slt i64 %h, 0
  br i1 %bad, label %undo, label %ok
undo:
  %r = call i64 @nz.os_shut(i64 %w, i64 %kind, ptr %obj)
  ret i64 %h
ok:
  ret i64 %h
}

define hidden i64 @nz.os_open_read(ptr %p, i64 %n) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %open
oom:
  ret i64 -12
open:
  %fd = call i32 @nz_os_open(ptr %path, i64 -1)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %bad = icmp slt i32 %fd, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i64 %e
ok:
  %h = call i64 @nz.os_adopt(i32 %fd, i64 1, ptr null)
  ret i64 %h
}

define hidden i64 @nz.os_open_write(ptr %p, i64 %n, i64 %mode) {
entry:
  %valid = icmp ult i64 %mode, 4
  br i1 %valid, label %copy, label %invalid
invalid:
  ret i64 -22
copy:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %open
oom:
  ret i64 -12
open:
  %fd = call i32 @nz_os_open(ptr %path, i64 %mode)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %bad = icmp slt i32 %fd, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i64 %e
ok:
  %h = call i64 @nz.os_adopt(i32 %fd, i64 1, ptr null)
  ret i64 %h
}

define hidden i64 @nz.os_dir_open(ptr %p, i64 %n) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %open
oom:
  ret i64 -12
open:
  %d = call ptr @nz_os_opendir(ptr %path)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %bad = icmp eq ptr %d, null
  br i1 %bad, label %fail, label %ok
fail:
  ret i64 %e
ok:
  %fd = call i32 @nz_os_dirfd(ptr %d)
  %h = call i64 @nz.os_adopt(i32 %fd, i64 2, ptr %d)
  ret i64 %h
}

define hidden i64 @nz.os_stdin() {
entry:
  call void @nz.os_acquire()
  %had = load i64, ptr @nz.os_stdin_h
  %known = icmp ne i64 %had, 0
  br i1 %known, label %old, label %new
old:
  call void @nz.os_release()
  ret i64 %had
new:
  %h = call i64 @nz.os_register(i64 0, i64 3, ptr null)
  %ok = icmp sgt i64 %h, 0
  br i1 %ok, label %keep, label %done
keep:
  store i64 %h, ptr @nz.os_stdin_h
  br label %done
done:
  call void @nz.os_release()
  ret i64 %h
}

; Standard output (`which` 1) or errors (2), R1d: one handle each, made the first time.
define hidden i64 @nz.os_std_stream(i64 %which) {
entry:
  %errors = icmp eq i64 %which, 2
  %slot = select i1 %errors, ptr @nz.os_stderr_h, ptr @nz.os_stdout_h
  %fd = select i1 %errors, i64 2, i64 1
  call void @nz.os_acquire()
  %had = load i64, ptr %slot
  %known = icmp ne i64 %had, 0
  br i1 %known, label %old, label %new
old:
  call void @nz.os_release()
  ret i64 %had
new:
  %h = call i64 @nz.os_register(i64 %fd, i64 10, ptr null)
  %ok = icmp sgt i64 %h, 0
  br i1 %ok, label %keep, label %done
keep:
  store i64 %h, ptr %slot
  br label %done
done:
  call void @nz.os_release()
  ret i64 %h
}

define hidden i64 @nz.os_status(i64 %h) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i64 %k
ok:
  call void @nz.os_unpin(i64 %h)
  ret i64 0
}

define hidden i64 @nz.os_read(i64 %h, ptr %buf, i64 %n) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %fail, label %pinned
fail:
  ret i64 %k
pinned:
  switch i64 %k, label %read [
    i64 2, label %isdir
    i64 3, label %stdin
    i64 4, label %socket
    i64 5, label %einval
    i64 6, label %einval
    i64 7, label %socket
    i64 8, label %einval
    i64 9, label %einval
    i64 10, label %writeonly
  ]
isdir:
  call void @nz.os_unpin(i64 %h)
  ret i64 -21
writeonly:
  call void @nz.os_unpin(i64 %h)
  ret i64 -9
einval:
  call void @nz.os_unpin(i64 %h)
  ret i64 -22
stdin:
  %ir = call i64 @nz.os_in_read(ptr %buf, i64 %n)
  call void @nz.os_unpin(i64 %h)
  ret i64 %ir
socket:
  %sr = call i64 @nz.net_recv(i64 %h, ptr %buf, i64 %n)
  call void @nz.os_unpin(i64 %h)
  ret i64 %sr
read:
  %fd = trunc i64 %h to i32
  %r = call i64 @nz_os_read(i32 %fd, ptr %buf, i64 %n)
  %e = call i64 @nz.os_errno()
  call void @nz.os_unpin(i64 %h)
  %failed = icmp slt i64 %r, 0
  %out = select i1 %failed, i64 %e, i64 %r
  ret i64 %out
}

; A line of standard input (R1d, P3) into the caller's buffer: `nz.os_in_line`'s answer. Any other
; handle is -EINVAL, a directory -EISDIR, as a read of one is.
define hidden i64 @nz.os_read_line(i64 %h, ptr %buf, i64 %n) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %fail, label %pinned
fail:
  ret i64 %k
pinned:
  %stdin = icmp eq i64 %k, 3
  br i1 %stdin, label %line, label %other
other:
  %dir = icmp eq i64 %k, 2
  %code = select i1 %dir, i64 -21, i64 -22
  call void @nz.os_unpin(i64 %h)
  ret i64 %code
line:
  %r = call i64 @nz.os_in_line(ptr %buf, i64 %n)
  call void @nz.os_unpin(i64 %h)
  ret i64 %r
}

; Standard input's buffer (R1d, P3), 16 KiB: bytes read from descriptor 0 and not yet handed
; out, shared by `os_read` and `os_read_line`, so a line read never loses what follows its line.
; Made on the first line read; its lock is held across the system call, so standard input has
; one reader at a time.
define hidden void @nz.os_in_acquire() {
entry:
  br label %spin
spin:
  %old = atomicrmw xchg ptr @nz.os_in_lock, i32 1 acquire
  %free = icmp eq i32 %old, 0
  br i1 %free, label %held, label %spin
held:
  ret void
}

define hidden void @nz.os_in_release() {
entry:
  store atomic i32 0, ptr @nz.os_in_lock release, align 4
  ret void
}

; At most `n` bytes of standard input into `buf`: what the buffer holds first, and only when it
; holds nothing one read of the descriptor straight into `buf`. A count, 0 at the end, or -errno.
define hidden i64 @nz.os_in_read(ptr %buf, i64 %n) {
entry:
  call void @nz.os_in_acquire()
  %at = load i64, ptr @nz.os_in_at
  %end = load i64, ptr @nz.os_in_end
  %held = sub i64 %end, %at
  %some = icmp sgt i64 %held, 0
  br i1 %some, label %take, label %direct
take:
  %less = icmp slt i64 %n, %held
  %k = select i1 %less, i64 %n, i64 %held
  %base = load ptr, ptr @nz.os_in_buf
  %from = getelementptr i8, ptr %base, i64 %at
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %from, i64 %k, i1 false)
  %next = add i64 %at, %k
  store i64 %next, ptr @nz.os_in_at
  call void @nz.os_in_release()
  ret i64 %k
direct:
  %r = call i64 @nz_os_read(i32 0, ptr %buf, i64 %n)
  %e = call i64 @nz.os_errno()
  call void @nz.os_in_release()
  %failed = icmp slt i64 %r, 0
  %out = select i1 %failed, i64 %e, i64 %r
  ret i64 %out
}

; Standard input up to and including its next newline into `buf`, stopping sooner at `n` bytes or
; at the end; what follows stays in the buffer. The count, 0 at the end; a failure of the system
; (or -ENOMEM for the buffer) is answered only when nothing was read, and otherwise met again by
; the next read.
define hidden i64 @nz.os_in_line(ptr %buf, i64 %n) {
entry:
  %gotp = alloca i64, align 8
  store i64 0, ptr %gotp
  call void @nz.os_in_acquire()
  br label %loop
loop:
  %got = load i64, ptr %gotp
  %full = icmp sge i64 %got, %n
  br i1 %full, label %done, label %have
have:
  %at = load i64, ptr @nz.os_in_at
  %end = load i64, ptr @nz.os_in_end
  %empty = icmp sge i64 %at, %end
  br i1 %empty, label %fill, label %scan
fill:
  %old = load ptr, ptr @nz.os_in_buf
  %none = icmp eq ptr %old, null
  br i1 %none, label %make, label %refill
make:
  %fresh = call ptr @malloc(i64 16384)
  %oom = icmp eq ptr %fresh, null
  br i1 %oom, label %nomem, label %keep
keep:
  store ptr %fresh, ptr @nz.os_in_buf
  br label %refill
refill:
  %into = load ptr, ptr @nz.os_in_buf
  %r = call i64 @nz_os_read(i32 0, ptr %into, i64 16384)
  %e = call i64 @nz.os_errno()
  %bad = icmp slt i64 %r, 0
  br i1 %bad, label %failed, label %read
read:
  store i64 0, ptr @nz.os_in_at
  store i64 %r, ptr @nz.os_in_end
  %eof = icmp eq i64 %r, 0
  br i1 %eof, label %done, label %loop
scan:
  %base = load ptr, ptr @nz.os_in_buf
  %held = sub i64 %end, %at
  %room = sub i64 %n, %got
  %less = icmp slt i64 %room, %held
  %k = select i1 %less, i64 %room, i64 %held
  br label %look
look:
  %j = phi i64 [ 0, %scan ], [ %j1, %next ]
  %stop = icmp sge i64 %j, %k
  br i1 %stop, label %copy, label %test
test:
  %pos = add i64 %at, %j
  %bp = getelementptr i8, ptr %base, i64 %pos
  %b = load i8, ptr %bp
  %nl = icmp eq i8 %b, 10
  %j1 = add i64 %j, 1
  br i1 %nl, label %copy, label %next
next:
  br label %look
copy:
  %len = phi i64 [ %k, %look ], [ %j1, %test ]
  %ended = phi i1 [ false, %look ], [ true, %test ]
  %from = getelementptr i8, ptr %base, i64 %at
  %to = getelementptr i8, ptr %buf, i64 %got
  call void @llvm.memcpy.p0.p0.i64(ptr %to, ptr %from, i64 %len, i1 false)
  %after = add i64 %at, %len
  store i64 %after, ptr @nz.os_in_at
  %more = add i64 %got, %len
  store i64 %more, ptr %gotp
  br i1 %ended, label %done, label %loop
nomem:
  br label %failed
failed:
  %status = phi i64 [ -12, %nomem ], [ %e, %refill ]
  %some = icmp sgt i64 %got, 0
  br i1 %some, label %done, label %refused
refused:
  call void @nz.os_in_release()
  ret i64 %status
done:
  call void @nz.os_in_release()
  %total = load i64, ptr %gotp
  ret i64 %total
}

define hidden i64 @nz.os_write(i64 %h, ptr %buf, i64 %n) {
entry:
