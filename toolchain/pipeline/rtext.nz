  %zero = icmp eq i64 %cap, 0
  %cap2 = select i1 %zero, i64 16, i64 %twice
  %bytes = mul i64 %cap2, 24
  %old = load ptr, ptr %q
  %new = call ptr @realloc(ptr %old, i64 %bytes)
  %fail = icmp eq ptr %new, null
  br i1 %fail, label %no, label %grown
grown:
  store ptr %new, ptr %q
  store i64 %cap2, ptr %capp
