define hidden i64 @nz.os_seek(i64 %h, i64 %offset, i64 %whence) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %fail, label %pinned
fail:
  ret i64 %k
pinned:
  switch i64 %k, label %check [
    i64 2, label %isdir
    i64 3, label %isstdin
    i64 4, label %isstdin
    i64 5, label %isstdin
    i64 6, label %isstdin
    i64 7, label %isstdin
    i64 8, label %isstdin
    i64 9, label %isstdin
    i64 10, label %isstdin
  ]
isdir:
  call void @nz.os_unpin(i64 %h)
  ret i64 -21
isstdin:
  call void @nz.os_unpin(i64 %h)
  ret i64 -29
check:
  %range = icmp ugt i64 %whence, 2
  %start = icmp eq i64 %whence, 0
  %before = icmp slt i64 %offset, 0
  %negstart = and i1 %start, %before
  %invalid = or i1 %range, %negstart
  br i1 %invalid, label %einval, label %seek
einval:
  call void @nz.os_unpin(i64 %h)
  ret i64 -22
seek:
  %fd = trunc i64 %h to i32
  %w = trunc i64 %whence to i32
  %r = call i64 @nz_os_lseek(i32 %fd, i64 %offset, i32 %w)
  %e = call i64 @nz.os_errno()
  call void @nz.os_unpin(i64 %h)
  %failed = icmp slt i64 %r, 0
  %out = select i1 %failed, i64 %e, i64 %r
  ret i64 %out
}

define hidden i64 @nz.os_sync(i64 %h) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %fail, label %pinned
fail:
  ret i64 %k
pinned:
  switch i64 %k, label %sync [
    i64 2, label %isdir
    i64 3, label %isstdin
    i64 4, label %isstdin
    i64 5, label %isstdin
    i64 6, label %isstdin
    i64 7, label %isstdin
    i64 8, label %isstdin
    i64 9, label %isstdin
    i64 10, label %isstdin
  ]
isdir:
  call void @nz.os_unpin(i64 %h)
  ret i64 -21
isstdin:
  call void @nz.os_unpin(i64 %h)
  ret i64 -22
sync:
  %fd = trunc i64 %h to i32
  %r = call i32 @nz_os_fsync(i32 %fd)
  %e = call i64 @nz.os_errno()
  call void @nz.os_unpin(i64 %h)
  %failed = icmp slt i32 %r, 0
  %out = select i1 %failed, i64 %e, i64 0
  ret i64 %out
}

define hidden i64 @nz.os_dir_next(i64 %h, ptr %buf, i64 %n) {
entry:
  %neg = icmp slt i64 %h, 0
  br i1 %neg, label %failed, label %lock
failed:
  ret i64 %h
lock:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  %dead = icmp eq ptr %s, null
  br i1 %dead, label %closed, label %live
closed:
  call void @nz.os_release()
  ret i64 -65536
live:
  %statep = getelementptr i8, ptr %s, i64 16
  %state = load i64, ptr %statep
  %dir = icmp eq i64 %state, 2
  br i1 %dir, label %list, label %notdir
notdir:
  call void @nz.os_release()
  ret i64 -20
list:
  %objp = getelementptr i8, ptr %s, i64 24
  %d = load ptr, ptr %objp
  %r = call i64 @nz_os_readdir(ptr %d, ptr %buf, i64 %n)
  call void @nz.os_release()
  ret i64 %r
}

define hidden i64 @nz.os_stat(ptr %p, i64 %n, ptr %out) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %stat
oom:
  ret i64 -12
stat:
  %r = call i32 @nz_os_stat(ptr %path, ptr %out)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %failed = icmp slt i32 %r, 0
  %res = select i1 %failed, i64 %e, i64 0
  ret i64 %res
}

; `op` 0 makes a directory, 1 removes one, 2 removes a file.
define hidden i64 @nz.os_path_op(ptr %p, i64 %n, i64 %op) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %go
oom:
  ret i64 -12
go:
  switch i64 %op, label %unlink [
    i64 0, label %mkdir
    i64 1, label %rmdir
  ]
mkdir:
  %rm = call i32 @nz_os_mkdir(ptr %path)
  br label %done
rmdir:
  %rr = call i32 @nz_os_rmdir(ptr %path)
  br label %done
unlink:
  %ru = call i32 @nz_os_unlink(ptr %path)
  br label %done
done:
  %r = phi i32 [ %rm, %mkdir ], [ %rr, %rmdir ], [ %ru, %unlink ]
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %failed = icmp slt i32 %r, 0
  %res = select i1 %failed, i64 %e, i64 0
  ret i64 %res
}

define hidden i64 @nz.os_rename(ptr %ap, i64 %an, ptr %bp, i64 %bn) {
entry:
  %a = call ptr @nz.cstr(ptr %ap, i64 %an)
  %noa = icmp eq ptr %a, null
  br i1 %noa, label %oom, label %second
oom:
  ret i64 -12
second:
  %b = call ptr @nz.cstr(ptr %bp, i64 %bn)
  %nob = icmp eq ptr %b, null
  br i1 %nob, label %oomb, label %go
oomb:
  call void @free(ptr %a)
  ret i64 -12
go:
  %r = call i32 @nz_os_rename(ptr %a, ptr %b)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %a)
  call void @free(ptr %b)
  %failed = icmp slt i32 %r, 0
  %res = select i1 %failed, i64 %e, i64 0
  ret i64 %res
}

define hidden i64 @nz.os_family() {
entry:
  %f = call i64 @nz_os_family()
  ret i64 %f
}

@.closed = private unnamed_addr constant [21 x i8] c"the handle is closed\00"
@.unnamed = private unnamed_addr constant [23 x i8] c"the name was not found\00"

define hidden i64 @nz.os_error_text(i64 %status, ptr %buf, i64 %cap) {
entry:
  %closed = icmp eq i64 %status, -65536
  br i1 %closed, label %ours, label %name
ours:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr @.closed, i64 20, i1 false)
  ret i64 20
name:
  %unknown = icmp eq i64 %status, -65537
  br i1 %unknown, label %unnamed, label %system
unnamed:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr @.unnamed, i64 22, i1 false)
  ret i64 22
system:
  %n = call i64 @nz_os_error_text(i64 %status, ptr %buf, i64 %cap)
  ret i64 %n
}

declare ptr @nz_os_environ()

; Whether entry `e` is one: an `=` after its first byte. Its name's length then, or -1.
define hidden i64 @nz.os_env_split(ptr %e) {
entry:
  %n = call i64 @strlen(ptr %e)
  br label %scan
scan:
  %i = phi i64 [ 1, %entry ], [ %i1, %next ]
  %end = icmp sge i64 %i, %n
  br i1 %end, label %none, label %look
look:
  %cp = getelementptr i8, ptr %e, i64 %i
  %c = load i8, ptr %cp
  %eq = icmp eq i8 %c, 61
  br i1 %eq, label %found, label %next
next:
  %i1 = add i64 %i, 1
  br label %scan
found:
  ret i64 %i
none:
  ret i64 -1
}

; The `i`th entry of the environment that is one, `NAME=value`, its length through `lenp`; null
; past the last. `i` -1 counts them instead, returning null and the count through `lenp`.
define hidden ptr @nz.os_env_nth(i64 %want, ptr %lenp) {
entry:
  %env = call ptr @nz_os_environ()
  br label %walk
walk:
  %k = phi i64 [ 0, %entry ], [ %k1, %skip ], [ %k2, %counted ]
  %seen = phi i64 [ 0, %entry ], [ %seen, %skip ], [ %seen1, %counted ]
  %ep = getelementptr ptr, ptr %env, i64 %k
  %e = load ptr, ptr %ep
  %end = icmp eq ptr %e, null
  br i1 %end, label %done, label %test
test:
  %at = call i64 @nz.os_env_split(ptr %e)
  %is = icmp sgt i64 %at, 0
  %k1 = add i64 %k, 1
  br i1 %is, label %valid, label %skip
skip:
  br label %walk
valid:
  %this = icmp eq i64 %seen, %want
  br i1 %this, label %hit, label %counted
counted:
  %seen1 = add i64 %seen, 1
  %k2 = add i64 %k, 1
  br label %walk
hit:
  %len = call i64 @strlen(ptr %e)
  store i64 %len, ptr %lenp
  ret ptr %e
done:
  store i64 %seen, ptr %lenp
  ret ptr null
}

define hidden i64 @nz.os_env_count() {
entry:
  %n = alloca i64, align 8
  %p = call ptr @nz.os_env_nth(i64 -1, ptr %n)
  %c = load i64, ptr %n
  ret i64 %c
}

define hidden ptr @nz.os_env_at(i64 %i, ptr %lenp) {
entry:
  %p = call ptr @nz.os_env_nth(i64 %i, ptr %lenp)
  ret ptr %p
}

; `n` bytes of the system's entropy into `buf`, 256 at a time as `getentropy` allows: `n`, or -errno.
define hidden i64 @nz.os_random_bytes(ptr %buf, i64 %n) {
entry:
  br label %loop
loop:
  %at = phi i64 [ 0, %entry ], [ %at1, %got ]
  %left = sub i64 %n, %at
  %done = icmp sle i64 %left, 0
  br i1 %done, label %finish, label %chunk
chunk:
  %big = icmp sgt i64 %left, 256
  %take = select i1 %big, i64 256, i64 %left
  %p = getelementptr i8, ptr %buf, i64 %at
  %r = call i32 @nz_os_entropy(ptr %p, i64 %take)
  %bad = icmp ne i32 %r, 0
  br i1 %bad, label %fail, label %got
got:
  %at1 = add i64 %at, %take
  br label %loop
fail:
  %e = call i64 @nz.os_errno()
  ret i64 %e
finish:
  ret i64 %n
}

; The value of the first entry named `name` (`n` bytes), its length through `lenp`; when there is
; none, an empty string and -1.
define hidden ptr @nz.os_env_find(ptr %name, i64 %n, ptr %lenp) {
entry:
  %env = call ptr @nz_os_environ()
  br label %walk
walk:
  %k = phi i64 [ 0, %entry ], [ %k1, %next ]
  %ep = getelementptr ptr, ptr %env, i64 %k
  %e = load ptr, ptr %ep
  %end = icmp eq ptr %e, null
  br i1 %end, label %none, label %test
test:
  %k1 = add i64 %k, 1
  %at = call i64 @nz.os_env_split(ptr %e)
  %same = icmp eq i64 %at, %n
  br i1 %same, label %compare, label %next
compare:
  %d = call i32 @memcmp(ptr %e, ptr %name, i64 %n)
  %eq = icmp eq i32 %d, 0
  br i1 %eq, label %hit, label %next
next:
  br label %walk
hit:
  %start = add i64 %n, 1
  %v = getelementptr i8, ptr %e, i64 %start
  %len = call i64 @strlen(ptr %v)
  store i64 %len, ptr %lenp
  ret ptr %v
none:
  store i64 -1, ptr %lenp
  ret ptr @.nz.empty
}

@.nz.empty = private unnamed_addr constant [1 x i8] c"\00"
"#
}

pub fn rt_files_FS_RUNTIME() -> Str ! {} {
    r#"
declare i32 @nz_os_lstat(ptr, ptr)
declare i32 @nz_os_chmod(ptr, i64)
declare i64 @nz_os_realpath(ptr, ptr, i64)
declare i32 @nz_os_flock(i32, i32)

define hidden i64 @nz.os_lstat(ptr %p, i64 %n, ptr %out) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %stat
oom:
  ret i64 -12
stat:
  %r = call i32 @nz_os_lstat(ptr %path, ptr %out)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %failed = icmp slt i32 %r, 0
  %res = select i1 %failed, i64 %e, i64 0
  ret i64 %res
}

; Permission bits `mode`, `0..=0o7777`; 0 or -errno.
define hidden i64 @nz.os_chmod(ptr %p, i64 %n, i64 %mode) {
entry:
  %bits = icmp ult i64 %mode, 4096
  br i1 %bits, label %copy, label %invalid
invalid:
  ret i64 -22
copy:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %go
oom:
  ret i64 -12
go:
  %r = call i32 @nz_os_chmod(ptr %path, i64 %mode)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %failed = icmp slt i32 %r, 0
  %res = select i1 %failed, i64 %e, i64 0
  ret i64 %res
}

; The canonical path into the caller's `cap` bytes: its length, -EINVAL when it does not fit, or
; -errno.
define hidden i64 @nz.os_realpath(ptr %p, i64 %n, ptr %out, i64 %cap) {
entry:
  %path = call ptr @nz.cstr(ptr %p, i64 %n)
  %nopath = icmp eq ptr %path, null
  br i1 %nopath, label %oom, label %go
oom:
  ret i64 -12
go:
  %r = call i64 @nz_os_realpath(ptr %path, ptr %out, i64 %cap)
  %e = call i64 @nz.os_errno()
  call void @free(ptr %path)
  %failed = icmp slt i64 %r, 0
  br i1 %failed, label %fail, label %got
fail:
  ret i64 %e
got:
  %long = icmp sgt i64 %r, %cap
  %res = select i1 %long, i64 -22, i64 %r
  ret i64 %res
}

@.nz.tmpname = private unnamed_addr constant [5 x i8] c"nazm-"

; A new directory in `parent` named `nazm-` and twelve random lowercase letters and digits, made
; by this call, its permissions 0o700; its path into the caller's `cap` bytes and the path's
; length. -EINVAL for an empty parent or a path that would not fit, before anything is made;
; -EEXIST after 64 names were all taken; or -errno.
define hidden i64 @nz.os_mkdtemp(ptr %p, i64 %n, ptr %out, i64 %cap) {
entry:
  %rand = alloca [16 x i8], align 8
  %empty = icmp eq i64 %n, 0
  br i1 %empty, label %invalid, label %measure
invalid:
  ret i64 -22
measure:
  %lastp = getelementptr i8, ptr %p, i64 %n
  %lastq = getelementptr i8, ptr %lastp, i64 -1
  %last = load i8, ptr %lastq
  %ends = icmp eq i8 %last, 47
  %sep = select i1 %ends, i64 0, i64 1
  %head = add i64 %n, %sep
  %total = add i64 %head, 17
  %long = icmp sgt i64 %total, %cap
  br i1 %long, label %invalid, label %alloc
alloc:
  %room = add i64 %total, 1
  %buf = call ptr @malloc(i64 %room)
  %none = icmp eq ptr %buf, null
  br i1 %none, label %oom, label %fill
oom:
  ret i64 -12
fill:
  call void @llvm.memcpy.p0.p0.i64(ptr %buf, ptr %p, i64 %n, i1 false)
  %slashp = getelementptr i8, ptr %buf, i64 %n
  store i8 47, ptr %slashp
  %prefixp = getelementptr i8, ptr %buf, i64 %head
  call void @llvm.memcpy.p0.p0.i64(ptr %prefixp, ptr @.nz.tmpname, i64 5, i1 false)
  %endp = getelementptr i8, ptr %buf, i64 %total
  store i8 0, ptr %endp
  %namep = getelementptr i8, ptr %prefixp, i64 5
  br label %attempt
attempt:
  %tries = phi i64 [ 0, %fill ], [ %tries1, %taken ]
  %more = icmp slt i64 %tries, 64
  br i1 %more, label %draw, label %exhausted
exhausted:
  call void @free(ptr %buf)
  ret i64 -17
draw:
  %got = call i32 @nz_os_entropy(ptr %rand, i64 12)
  %noent = icmp ne i32 %got, 0
  br i1 %noent, label %fail, label %letters
letters:
  %i = phi i64 [ 0, %draw ], [ %i1, %letters ]
  %rp = getelementptr i8, ptr %rand, i64 %i
  %rb = load i8, ptr %rp
  %rw = zext i8 %rb to i64
  %c = urem i64 %rw, 36
  %digit = icmp ult i64 %c, 10
  %dch = add i64 %c, 48
  %lch = add i64 %c, 87
  %ch = select i1 %digit, i64 %dch, i64 %lch
  %ch8 = trunc i64 %ch to i8
  %np = getelementptr i8, ptr %namep, i64 %i
  store i8 %ch8, ptr %np
  %i1 = add i64 %i, 1
  %named = icmp eq i64 %i1, 12
  br i1 %named, label %make, label %letters
make:
  %m = call i32 @nz_os_mkdir(ptr %buf)
  %made = icmp eq i32 %m, 0
  br i1 %made, label %private, label %why
why:
  %e = call i64 @nz.os_errno()
  %exists = icmp eq i64 %e, -17
  br i1 %exists, label %taken, label %give
taken:
  %tries1 = add i64 %tries, 1
  br label %attempt
give:
  call void @free(ptr %buf)
  ret i64 %e
private:
  %pm = call i32 @nz_os_chmod(ptr %buf, i64 448)
  %pe = call i64 @nz.os_errno()
  %refused = icmp ne i32 %pm, 0
  %kept = icmp ne i64 %pe, -38
  %open = and i1 %refused, %kept
  br i1 %open, label %undo, label %done
undo:
  %u = call i32 @nz_os_rmdir(ptr %buf)
  call void @free(ptr %buf)
  ret i64 %pe
done:
  call void @llvm.memcpy.p0.p0.i64(ptr %out, ptr %buf, i64 %total, i1 false)
  call void @free(ptr %buf)
  ret i64 %total
fail:
  %fe = call i64 @nz.os_errno()
  call void @free(ptr %buf)
  ret i64 %fe
}

; An advisory whole-file lock on file `h`, exclusive or shared, waited for when `wait` is 1, or
; tried once; 0, or a status: -EISDIR for a directory, -EINVAL for any handle but a file's, and
; the system's -EWOULDBLOCK while another holds it.
define hidden i64 @nz.os_file_lock(i64 %h, i1 %exclusive, i64 %wait) {
entry:
  %kind = select i1 %exclusive, i32 2, i32 1
  %waits = icmp ne i64 %wait, 0
  %nb = select i1 %waits, i32 0, i32 4
  %op = or i32 %kind, %nb
  %r = call i64 @nz.os_flock_handle(i64 %h, i32 %op, i1 %waits)
  ret i64 %r
}

define hidden i64 @nz.os_file_unlock(i64 %h) {
entry:
  %r = call i64 @nz.os_flock_handle(i64 %h, i32 8, i1 false)
  ret i64 %r
}

; `flock` operation `op` on file `h`, pinned while it runs; a wait the system interrupts is
; resumed when `resume` is set.
define hidden i64 @nz.os_flock_handle(i64 %h, i32 %op, i1 %resume) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %failed, label %pinned
failed:
  ret i64 %k
pinned:
  switch i64 %k, label %einval [
    i64 1, label %lock
    i64 2, label %isdir
  ]
isdir:
  call void @nz.os_unpin(i64 %h)
  ret i64 -21
einval:
  call void @nz.os_unpin(i64 %h)
  ret i64 -22
lock:
  %fd = trunc i64 %h to i32
  %r = call i32 @nz_os_flock(i32 %fd, i32 %op)
  %ok = icmp eq i32 %r, 0
  br i1 %ok, label %held, label %refused
held:
  call void @nz.os_unpin(i64 %h)
  ret i64 0
refused:
  %e = call i64 @nz.os_errno()
  %intr = icmp eq i64 %e, -4
  %again = and i1 %intr, %resume
  br i1 %again, label %lock, label %give
give:
  call void @nz.os_unpin(i64 %h)
  ret i64 %e
}
"#
}

pub fn rt_files_NET_STUBS() -> Str ! {} {
    r#"
define hidden i64 @nz.net_recv(i64 %h, ptr %buf, i64 %n) {
entry:
  ret i64 -22
}

define hidden i64 @nz.net_send(i64 %h, ptr %buf, i64 %n) {
entry:
  ret i64 -22
}

define hidden void @nz.net_wake(ptr %w) {
entry:
  ret void
}

define hidden i64 @nz.net_pipe_write(i64 %h, ptr %buf, i64 %n) {
entry:
  ret i64 -22
}
"#
}

pub fn rt_net_NET_RUNTIME() -> Str ! {} {
    r#"
@nz.net_state = hidden global i64 0
@nz.net_poller = hidden global i64 0
@nz.net_thread = hidden global i64 0

declare i32 @nz_net_poller()
declare i32 @nz_net_arm(i32, i32, i64, i64)
declare i64 @nz_net_poll(i32, ptr)
declare i64 @nz_net_fill(ptr, i64, i64, ptr)
declare i64 @nz_net_format(ptr, ptr, i64)
declare i32 @nz_net_prepare(i32)
declare i32 @nz_net_open(ptr, i64, i64)
declare i64 @nz_net_connect(i32, ptr, i64)
declare i64 @nz_net_error(i32)
declare i64 @nz_net_send(i32, ptr, i64)
declare i64 @nz_net_sendto(i32, ptr, i64, ptr, i64)
declare i64 @nz_net_eagain()
declare i64 @nz_net_etimedout()
declare i64 @nz_net_resolve(ptr, i64, ptr, i64)
declare i64 @nz_net_read(i32, ptr, i64)
declare i32 @nz_net_bind(i32, ptr, i32)
declare i32 @nz_net_listen(i32)
declare i32 @nz_net_accept(i32)
declare i64 @nz_net_recvfrom(i32, ptr, i64, ptr, ptr)
declare i32 @nz_net_shutdown(i32, i32)
declare i32 @nz_net_name(i32, i32, ptr, ptr)
declare i64 @nz_net_write(i32, ptr, i64)
declare i32 @nz_os_spawn_in(ptr, ptr, ptr, ptr, ptr, i64, ptr)
declare i64 @nz_os_reap(i64, i32, ptr)
declare i32 @nz_os_terminate(i64)
declare i32 @nz_os_key()
declare i64 @nz_os_child_id(i64)
declare i64 @nz_os_pid()
declare i32 @nz_os_signal_group(i64, i64)
declare void @nz_os_nap(i64)

; The monotonic clock in nanoseconds: what `nz.ctimedwait`'s deadline is measured against
; (Q1-M-12). A wall-clock deadline there is decades ahead of the monotonic clock: a thread waited
; out the nap's 100 ms cap on every wait however little was left, and a pool task never timed out.
define hidden i64 @nz.net_now() {
entry:
  %ts = alloca [16 x i8], align 8
  call void @llvm.memset.p0.i64(ptr %ts, i8 0, i64 16, i1 false)
  %r = call i32 @nz_os_clock(i32 4, ptr %ts)
  %s = load i64, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  %n = load i64, ptr %np
  %sn = mul i64 %s, 1000000000
  %t = add i64 %sn, %n
  ret i64 %t
}

; Start the reactor once: the first caller makes the poller and the thread, the rest wait for it.
define hidden void @nz.net_start() {
entry:
  %st = load atomic i64, ptr @nz.net_state acquire, align 8
  %ready = icmp eq i64 %st, 2
  br i1 %ready, label %done, label %race
race:
  %pair = cmpxchg ptr @nz.net_state, i64 0, i64 1 acq_rel acquire
  %won = extractvalue { i64, i1 } %pair, 1
  br i1 %won, label %make, label %spin
make:
  %q = call i32 @nz_net_poller()
  %qw = sext i32 %q to i64
  store i64 %qw, ptr @nz.net_poller
  %c = call i32 @pthread_create(ptr @nz.net_thread, ptr null, ptr @nz.net_reactor, ptr null)
  store atomic i64 2, ptr @nz.net_state release, align 8
  br label %done
spin:
  %again = load atomic i64, ptr @nz.net_state acquire, align 8
  %up = icmp eq i64 %again, 2
  br i1 %up, label %done, label %spin
done:
  ret void
}

; The reactor: forever, wait for events and wake each one's handle.
define hidden ptr @nz.net_reactor(ptr %arg) {
entry:
  %buf = alloca [64 x i64], align 8
  %qw = load i64, ptr @nz.net_poller
  %q = trunc i64 %qw to i32
  br label %wait
wait:
  %n = call i64 @nz_net_poll(i32 %q, ptr %buf)
  br label %each
each:
  %i = phi i64 [ 0, %wait ], [ %i1, %woke ]
  %more = icmp slt i64 %i, %n
  br i1 %more, label %one, label %wait
one:
  %hp = getelementptr i64, ptr %buf, i64 %i
  %h = load i64, ptr %hp
  call void @nz.net_event(i64 %h)
  br label %woke
woke:
  %i1 = add i64 %i, 1
  br label %each
}

; An event for handle `h`: wake its waiters, if its descriptor is still that generation's.
define hidden void @nz.net_event(i64 %h) {
entry:
  %fd = and i64 %h, 4294967295
  %gen = lshr i64 %h, 32
  call void @nz.os_acquire()
  %cap = load i64, ptr @nz.os_cap
  %fits = icmp slt i64 %fd, %cap
  br i1 %fits, label %slot, label %none
slot:
  %slots = load ptr, ptr @nz.os_slots
  %off = mul i64 %fd, 64
  %s = getelementptr i8, ptr %slots, i64 %off
  %g = load i64, ptr %s
  %same = icmp eq i64 %g, %gen
  br i1 %same, label %found, label %none
found:
  %wp = getelementptr i8, ptr %s, i64 32
  %w = load ptr, ptr %wp
  call void @nz.os_release()
  call void @nz.net_wake(ptr %w)
  ret void
none:
  call void @nz.os_release()
  ret void
}

; Wake everyone waiting on record `w` (null: nobody ever has).
define hidden void @nz.net_wake(ptr %w) {
entry:
  %none = icmp eq ptr %w, null
  br i1 %none, label %done, label %wake
wake:
  %l = call i32 @pthread_mutex_lock(ptr %w)
  %seqp = getelementptr i8, ptr %w, i64 128
  %seq = load i64, ptr %seqp
  %seq1 = add i64 %seq, 1
  store i64 %seq1, ptr %seqp
  %interestp = getelementptr i8, ptr %w, i64 136
  store i64 0, ptr %interestp
  %u = call i32 @pthread_mutex_unlock(ptr %w)
  %cv = getelementptr i8, ptr %w, i64 64
  call void @nz.cwake(ptr %cv)
  br label %done
done:
  ret void
}

; The wait record of live handle `h`, made the first time; null for a handle that is not live.
define hidden ptr @nz.net_waitrec(i64 %h) {
entry:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  %dead = icmp eq ptr %s, null
  br i1 %dead, label %none, label %live
none:
  call void @nz.os_release()
  ret ptr null
live:
  %wp = getelementptr i8, ptr %s, i64 32
  %w = load ptr, ptr %wp
  %fresh = icmp eq ptr %w, null
  br i1 %fresh, label %make, label %have
have:
  call void @nz.os_release()
  ret ptr %w
make:
  %m = call ptr @malloc(i64 256)
  %oom = icmp eq ptr %m, null
  br i1 %oom, label %none, label %init
init:
  call void @llvm.memset.p0.i64(ptr %m, i8 0, i64 256, i1 false)
  %mi = call i32 @pthread_mutex_init(ptr %m, ptr null)
  %cv = getelementptr i8, ptr %m, i64 64
  %ci = call i32 @pthread_cond_init(ptr %cv, ptr null)
  store ptr %m, ptr %wp
  call void @nz.os_release()
  ret ptr %m
}

; Whether `h` is no longer live — closed, or closing.
define hidden i1 @nz.net_closing(i64 %h) {
entry:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  call void @nz.os_release()
  %gone = icmp eq ptr %s, null
  ret i1 %gone
}

; When a wait on `h` gives up, as the wall clock's nanoseconds; 0 for never.
define hidden i64 @nz.net_deadline(i64 %h) {
entry:
  call void @nz.os_acquire()
  %s = call ptr @nz.os_live(i64 %h)
  %dead = icmp eq ptr %s, null
  br i1 %dead, label %never, label %read
read:
  %mp = getelementptr i8, ptr %s, i64 40
  %ms = load i64, ptr %mp
  call void @nz.os_release()
  %some = icmp sgt i64 %ms, 0
  br i1 %some, label %at, label %none
at:
  %now = call i64 @nz.net_now()
  %ns = mul i64 %ms, 1000000
  %d = add i64 %now, %ns
  ret i64 %d
never:
  call void @nz.os_release()
  br label %none
none:
  ret i64 0
}

; Wait until `h` may be ready in direction `dir` (1 reading, 2 writing): 0 to try again, the
; status of a deadline that passed (-ETIMEDOUT), or -65536 for a handle closed meanwhile.
define hidden i64 @nz.net_wait(i64 %h, i64 %dir, i64 %deadline) {
entry:
  %ts = alloca [16 x i8], align 8
  %w = call ptr @nz.net_waitrec(i64 %h)
  %none = icmp eq ptr %w, null
  br i1 %none, label %gone, label %arm
gone:
  ret i64 -65536
arm:
  call void @nz.net_start()
  %l = call i32 @pthread_mutex_lock(ptr %w)
  %seqp = getelementptr i8, ptr %w, i64 128
  %seq0 = load i64, ptr %seqp
  %interestp = getelementptr i8, ptr %w, i64 136
  %was = load i64, ptr %interestp
  %interest = or i64 %was, %dir
  store i64 %interest, ptr %interestp
  %qw = load i64, ptr @nz.net_poller
  %q = trunc i64 %qw to i32
  %fd = trunc i64 %h to i32
  %a = call i32 @nz_net_arm(i32 %q, i32 %fd, i64 %interest, i64 %h)
  %cv = getelementptr i8, ptr %w, i64 64
  br label %check
check:
  %seq = load i64, ptr %seqp
  %moved = icmp ne i64 %seq, %seq0
  br i1 %moved, label %ready, label %open
open:
  %closing = call i1 @nz.net_closing(i64 %h)
  br i1 %closing, label %closed, label %clock
clock:
  %bounded = icmp ne i64 %deadline, 0
  br i1 %bounded, label %timed, label %forever
forever:
  %r0 = call i32 @nz.cwait(ptr %cv, ptr %w)
  br label %check
timed:
  %now = call i64 @nz.net_now()
  %past = icmp sge i64 %now, %deadline
  br i1 %past, label %expired, label %sleep
sleep:
  %sec = sdiv i64 %deadline, 1000000000
  %nsec = srem i64 %deadline, 1000000000
  store i64 %sec, ptr %ts
  %np = getelementptr i8, ptr %ts, i64 8
  store i64 %nsec, ptr %np
  %r1 = call i32 @nz.ctimedwait(ptr %cv, ptr %w, ptr %ts)
  br label %check
ready:
  %u0 = call i32 @pthread_mutex_unlock(ptr %w)
  ret i64 0
closed:
  %u1 = call i32 @pthread_mutex_unlock(ptr %w)
  ret i64 -65536
expired:
  %u2 = call i32 @pthread_mutex_unlock(ptr %w)
  %t = call i64 @nz_net_etimedout()
  %neg = sub i64 0, %t
  ret i64 %neg
}

; Whether the failure just reported is "would block".
define hidden i1 @nz.net_would_block() {
entry:
  %ep = call ptr @nz_errno_location()
  %e = load i32, ptr %ep
  %w = sext i32 %e to i64
  %again = call i64 @nz_net_eagain()
  %is = icmp eq i64 %w, %again
  ret i1 %is
}

; A read from connected socket `h`, pinned by the caller, waiting at most its deadline.
define hidden i64 @nz.net_recv(i64 %h, ptr %buf, i64 %n) {
entry:
  %deadline = call i64 @nz.net_deadline(i64 %h)
  %fd = trunc i64 %h to i32
  br label %try
try:
  %r = call i64 @nz_net_read(i32 %fd, ptr %buf, i64 %n)
  %ok = icmp sge i64 %r, 0
  br i1 %ok, label %done, label %failed
done:
  ret i64 %r
failed:
  %e = call i64 @nz.os_errno()
  %block = call i1 @nz.net_would_block()
  br i1 %block, label %wait, label %error
error:
  ret i64 %e
wait:
  %w = call i64 @nz.net_wait(i64 %h, i64 1, i64 %deadline)
  %go = icmp eq i64 %w, 0
  br i1 %go, label %try, label %stop
stop:
  ret i64 %w
}

; A write to connected socket `h`, pinned by the caller: the bytes the system took.
define hidden i64 @nz.net_send(i64 %h, ptr %buf, i64 %n) {
entry:
  %deadline = call i64 @nz.net_deadline(i64 %h)
  %fd = trunc i64 %h to i32
  br label %try
try:
  %r = call i64 @nz_net_send(i32 %fd, ptr %buf, i64 %n)
  %ok = icmp sge i64 %r, 0
  br i1 %ok, label %done, label %failed
done:
  ret i64 %r
failed:
  %e = call i64 @nz.os_errno()
  %block = call i1 @nz.net_would_block()
  br i1 %block, label %wait, label %error
error:
  ret i64 %e
wait:
  %w = call i64 @nz.net_wait(i64 %h, i64 2, i64 %deadline)
  %go = icmp eq i64 %w, 0
  br i1 %go, label %try, label %stop
stop:
  ret i64 %w
}

; `HOST:PORT` (IPv6 bracketed) into the caller's 128 bytes: its length, or -22.
define hidden i64 @nz.net_parse(ptr %p, i64 %n, ptr %out) {
entry:
  br label %scan
scan:
  %i = phi i64 [ %n, %entry ], [ %i1, %step ]
  %any = icmp sgt i64 %i, 0
  br i1 %any, label %look, label %bad
look:
  %i1 = sub i64 %i, 1
  %cp = getelementptr i8, ptr %p, i64 %i1
  %c = load i8, ptr %cp
  %colon = icmp eq i8 %c, 58
  br i1 %colon, label %port, label %step
step:
  br label %scan
port:
  %first = add i64 %i1, 1
  %plen = sub i64 %n, %first
  %some = icmp sgt i64 %plen, 0
  %few = icmp sle i64 %plen, 5
  %shape = and i1 %some, %few
  br i1 %shape, label %digits, label %bad
digits:
  %j = phi i64 [ %first, %port ], [ %j1, %digit ]
  %v = phi i64 [ 0, %port ], [ %v1, %digit ]
  %end = icmp eq i64 %j, %n
  br i1 %end, label %ranged, label %next
next:
  %dp = getelementptr i8, ptr %p, i64 %j
  %d = load i8, ptr %dp
  %lo = icmp uge i8 %d, 48
  %hi = icmp ule i8 %d, 57
  %isd = and i1 %lo, %hi
  br i1 %isd, label %digit, label %bad
digit:
  %dz = zext i8 %d to i64
  %dv = sub i64 %dz, 48
  %v10 = mul i64 %v, 10
  %v1 = add i64 %v10, %dv
  %j1 = add i64 %j, 1
  br label %digits
ranged:
  %fits = icmp ule i64 %v, 65535
  br i1 %fits, label %host, label %bad
host:
  %c0 = load i8, ptr %p
  %bracket = icmp eq i8 %c0, 91
  br i1 %bracket, label %six, label %four
six:
  %close = sub i64 %i1, 1
  %long = icmp sgt i64 %close, 1
  br i1 %long, label %six2, label %bad
six2:
  %cbp = getelementptr i8, ptr %p, i64 %close
  %cb = load i8, ptr %cbp
  %closed = icmp eq i8 %cb, 93
  br i1 %closed, label %six3, label %bad
six3:
  %hp6 = getelementptr i8, ptr %p, i64 1
  %hn6 = sub i64 %close, 1
  br label %fill
four:
  %nonempty = icmp sgt i64 %i1, 0
  br i1 %nonempty, label %fill, label %bad
fill:
  %hp = phi ptr [ %hp6, %six3 ], [ %p, %four ]
  %hn = phi i64 [ %hn6, %six3 ], [ %i1, %four ]
  %v6 = phi i64 [ 1, %six3 ], [ 0, %four ]
  %cs = call ptr @nz.cstr(ptr %hp, i64 %hn)
  %nocopy = icmp eq ptr %cs, null
  br i1 %nocopy, label %bad, label %filled
filled:
  %len = call i64 @nz_net_fill(ptr %cs, i64 %v, i64 %v6, ptr %out)
  call void @free(ptr %cs)
  %ok = icmp sgt i64 %len, 0
  br i1 %ok, label %good, label %bad
good:
  ret i64 %len
bad:
  ret i64 -22
}

define hidden i64 @nz.os_tcp_listen(ptr %p, i64 %n) {
entry:
  %sa = alloca [128 x i8], align 8
  %len = call i64 @nz.net_parse(ptr %p, i64 %n, ptr %sa)
  %bad = icmp slt i64 %len, 0
  br i1 %bad, label %invalid, label %open
invalid:
  ret i64 %len
open:
  %fd = call i32 @nz_net_open(ptr %sa, i64 1, i64 1)
  %nofd = icmp slt i32 %fd, 0
  br i1 %nofd, label %fail, label %bind
fail:
  %e = call i64 @nz.os_errno()
  ret i64 %e
bind:
  %l = trunc i64 %len to i32
  %b = call i32 @nz_net_bind(i32 %fd, ptr %sa, i32 %l)
  %bfail = icmp slt i32 %b, 0
  br i1 %bfail, label %undo, label %listen
listen:
  %li = call i32 @nz_net_listen(i32 %fd)
  %lfail = icmp slt i32 %li, 0
  br i1 %lfail, label %undo, label %adopt
undo:
  %ue = call i64 @nz.os_errno()
  %c = call i32 @nz_os_close(i32 %fd)
  ret i64 %ue
adopt:
  %h = call i64 @nz.os_adopt(i32 %fd, i64 5, ptr null)
  ret i64 %h
}

define hidden i64 @nz.os_tcp_accept(i64 %h) {
entry:
  %k = call i64 @nz.os_pin(i64 %h)
  %bad = icmp slt i64 %k, 0
  br i1 %bad, label %failed, label %pinned
failed:
  ret i64 %k
pinned:
  %listener = icmp eq i64 %k, 5
  br i1 %listener, label %start, label %invalid
invalid:
  call void @nz.os_unpin(i64 %h)
  ret i64 -22
start:
  %deadline = call i64 @nz.net_deadline(i64 %h)
  %fd = trunc i64 %h to i32
  br label %try
try:
  %c = call i32 @nz_net_accept(i32 %fd)
  %got = icmp sge i32 %c, 0
  br i1 %got, label %adopt, label %none
adopt:
  %p = call i32 @nz_net_prepare(i32 %c)
  call void @nz.os_unpin(i64 %h)
  %nh = call i64 @nz.os_adopt(i32 %c, i64 4, ptr null)
  ret i64 %nh
none:
  %e = call i64 @nz.os_errno()
  %block = call i1 @nz.net_would_block()
  br i1 %block, label %wait, label %error
error:
  call void @nz.os_unpin(i64 %h)
  ret i64 %e
wait:
  %w = call i64 @nz.net_wait(i64 %h, i64 1, i64 %deadline)
  %go = icmp eq i64 %w, 0
  br i1 %go, label %try, label %stop
stop:
  call void @nz.os_unpin(i64 %h)
  ret i64 %w
}

define hidden i64 @nz.os_tcp_connect(ptr %p, i64 %n, i64 %ms) {
entry:
  %sa = alloca [128 x i8], align 8
  %len = call i64 @nz.net_parse(ptr %p, i64 %n, ptr %sa)
  %bad = icmp slt i64 %len, 0
  br i1 %bad, label %invalid, label %open
invalid:
  ret i64 %len
open:
  %fd = call i32 @nz_net_open(ptr %sa, i64 1, i64 0)
  %nofd = icmp slt i32 %fd, 0
  br i1 %nofd, label %fail, label %adopt
fail:
  %e = call i64 @nz.os_errno()
  ret i64 %e
adopt:
  %h = call i64 @nz.os_adopt(i32 %fd, i64 4, ptr null)
  %noh = icmp slt i64 %h, 0
  br i1 %noh, label %nohandle, label %connect
nohandle:
  ret i64 %h
connect:
  %r = call i64 @nz_net_connect(i32 %fd, ptr %sa, i64 %len)
  switch i64 %r, label %refused [
    i64 0, label %connected
    i64 1, label %under
  ]
connected:
  ret i64 %h
refused:
  %c0 = call i64 @nz.os_close(i64 %h)
  ret i64 %r
under:
  %bounded = icmp sgt i64 %ms, 0
  %now = call i64 @nz.net_now()
  %ns = mul i64 %ms, 1000000
  %at = add i64 %now, %ns
  %deadline = select i1 %bounded, i64 %at, i64 0
  br label %wait
wait:
  %w = call i64 @nz.net_wait(i64 %h, i64 2, i64 %deadline)
  %go = icmp eq i64 %w, 0
  br i1 %go, label %settled, label %gaveup
gaveup:
  %c1 = call i64 @nz.os_close(i64 %h)
  ret i64 %w
settled:
  %err = call i64 @nz_net_error(i32 %fd)
  %ok = icmp eq i64 %err, 0
  br i1 %ok, label %connected, label %failed
failed:
  %c2 = call i64 @nz.os_close(i64 %h)
  %neg = sub i64 0, %err
  ret i64 %neg
}

define hidden i64 @nz.os_udp_bind(ptr %p, i64 %n) {
entry:
  %sa = alloca [128 x i8], align 8
