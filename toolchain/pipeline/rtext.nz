  %ent = getelementptr i8, ptr %buf, i64 %off
  store ptr %h, ptr %ent
  %fp = getelementptr i8, ptr %ent, i64 8
  store ptr %f, ptr %fp
  %sp = getelementptr i8, ptr %ent, i64 16
  store i64 %stride, ptr %sp
  %len1 = add i64 %len, 1
  store i64 %len1, ptr %lenp
