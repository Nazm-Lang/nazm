// A call through a trait bound, resolved at a concrete type through Core IR /3's impl table:
// the row for the method's trait whose `self` is the concrete type (or, for a generic impl, its
// definition), and that row's function for the method. A generic impl's method takes the type
// arguments its `Self` parameter binds against the concrete type; a trait's default body takes
// the row's `type_args` with the impl's `self` read as the concrete type. A trait with no row
// for the type may be the derived `Hash` (`derived_hash`).

use "cir.nz"
use "types.nz"
use "@std/json"
use "@std/text"

/// Where a trait method lands: a function of `c.fns` (or -1) and its type arguments.
pub struct Target {
    index: Int,
    args: Strs,
}

/// Match a spelling with parameters against a concrete one, binding `$N` in `binds`.
fn unify(pattern: Str, concrete: Str, binds: Strs) -> Bool {
    let p = spell(pattern)
    if p.kind == "param" {
        let n = match text_parse_int(str_slice(p.head, 1, str_len(p.head))) { Ok(v) => v, Err(e) => 0 - 1 }
        if n < 0 { return false }
        while strs_len(binds) <= n { strs_push(binds, "") }
        let have = strs_get(binds, n)
        if have == "" {
            strs_set(binds, n, concrete)
            return true
        }
        return have == concrete
    }
    let q = spell(concrete)
    if p.head != q.head || strs_len(p.args) != strs_len(q.args) { return false }
    for i in 0..strs_len(p.args) {
        if !unify(strs_get(p.args, i), strs_get(q.args, i), binds) { return false }
    }
    true
}

/// The trait's key and the method's name, from `MODULE::trait NAME.method`.
pub fn trait_parts(method: Str) -> Strs ! {} {
    let out = strs_new()
    let start = match text_find(method, "::trait ") { Some(i) => i + 8, None => 0 }
    let rest = str_slice(method, start, str_len(method))
    let dot = match text_find(rest, ".") { Some(i) => i, None => str_len(rest) }
    strs_push(out, str_slice(method, 0, start + dot))
    strs_push(out, if dot < str_len(rest) { str_slice(rest, dot + 1, str_len(rest)) } else { "" })
    out
}

/// `t` with every spelling equal to `from` (a generic impl's `self`) read as `to`.
fn replace_ty(t: Str, from: Str, to: Str) -> Str {
    if t == from { return to }
    let s = spell(t)
    if strs_len(s.args) == 0 { return t }
    let out = strs_new()
    for a in s.args { strs_push(out, replace_ty(a, from, to)) }
    unspell(Spelled(kind: s.kind, head: s.head, module: s.module, name: s.name, args: out))
}

/// The function a call of `method` (`MODULE::trait NAME.method`) reaches at `concrete`.
pub fn method_target(c: Cir, method: Str, concrete: Str) -> Target ! {} {
    let tr = strs_get(trait_parts(method), 0)
    let head = spell(concrete).head
    let rows = kid(c, json_root(c.doc), "impls")
    for i in 0..count(c, rows) {
        let row = at(c, rows, i)
        let self_ty = tval(c, row, "self")
        if sval(c, row, "trait") == tr && (self_ty == concrete || self_ty == head) {
            let ms = kid(c, row, "methods")
            for j in 0..count(c, ms) {
                let m = at(c, ms, j)
                if sval(c, m, "method") == method {
                    let fi = fn_index(c, sval(c, m, "function"))
                    if fi < 0 { return Target(index: 0 - 1, args: strs_new()) }
                    let f = vec_get(c.fns, fi)
                    let args = strs_new()
                    let ta = kid(c, m, "type_args")
                    if count(c, ta) > 0 {
                        for k in 0..count(c, ta) { strs_push(args, replace_ty(tof(c, at(c, ta, k)), self_ty, concrete)) }
                    } else if f.type_params > 0 && f.params > 0 {
                        if !unify(vec_get(f.locals, 0).ty, concrete, args) || strs_len(args) != f.type_params { return Target(index: 0 - 1, args: strs_new()) }
                    }
                    return Target(index: fi, args: args)
                }
            }
        }
    }
    Target(index: 0 - 1, args: strs_new())
}

/// Whether `method` is the derived `Hash`'s: 1 for `hash`, 2 for `same`, 0 otherwise.
pub fn derived_hash(c: Cir, method: Str) -> Int ! {} {
    let d = kid(c, json_root(c.doc), "derived_hash")
    if d < 0 || json_kind(c.doc, d) != "object" { return 0 }
    if sval(c, d, "hash") == method { 1 } else if sval(c, d, "same") == method { 2 } else { 0 }
}
