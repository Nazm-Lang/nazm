// Core IR, read: `nazm core-ir --json` (`nazm.core-ir/3`, or `/2`) in the arena `@std/json` parses it
// into.
//
// An expression, statement or block is a node of the document, read through the accessors below;
// a function's header is decoded once into a `CirFn`. `docs/architecture.md` §7.41 is what the
// format means; `openspec/changes/r3-pipeline/design.md`, *The data model*, why it stays an arena.

use "@std/json"
use "@std/hash"
use "@std/hashmap"

/// One local of a function, as Core IR declares it.
pub struct CirLocal {
    name: Str,
    ty: Str,
    /// `param`, `let`, `let mut` or `temp WHAT`.
    origin: Str,
}

/// One literal: its type (`Int`, `Bool`, `Str`, a numeric kind, `Atomic`) and its value's text.
pub struct CirConst {
    ty: Str,
    int: Int,
    flag: Bool,
    text: Str,
}

/// One function's header; its body stays a node of the document.
pub struct CirFn {
    def: Str,
    module: Str,
    name: Str,
    type_params: Int,
    params: Int,
    ret: Str,
    published: Strs,
    locals: Vec[CirLocal],
    consts: Vec[CirConst],
    /// The body block's node, or -1 for a foreign function.
    body: Int,
    /// The C symbol of a foreign function, or `""`.
    foreign: Str,
    /// The function's object in the document (its `pub`, `closure` and `attributes`), or -1 for
    /// a thunk this stage writes.
    node: Int,
    /// A closure's code: the locals its captures arrive in, in order.
    captures: Ints,
    /// The C symbol `@export` names, or `""`.
    export: Str,
}

/// A program's Core IR.
pub struct Cir {
    doc: JsonDoc,
    entry: Str,
    fns: Vec[CirFn],
    /// A definition key's position in `fns`.
    by_def: HashMap[Str, Int],
}

// --- the document, by node ----------------------------------------------------------------------

/// The node `key` names in object `n`, or -1.
pub fn kid(c: Cir, n: Int, key: Str) -> Int ! {} {
    if n < 0 { return 0 - 1 }
    match json_get(c.doc, n, key) {
        Some(k) => if json_kind(c.doc, k) == "null" { 0 - 1 } else { k },
        None => 0 - 1,
    }
}

/// The string `key` names in object `n`, or `""`.
pub fn sval(c: Cir, n: Int, key: Str) -> Str ! {} {
    let k = kid(c, n, key)
    if k < 0 { return "" }
    match json_str(c.doc, k) { Some(s) => s, None => "" }
}

/// The integer `key` names in object `n`, or 0.
pub fn ival(c: Cir, n: Int, key: Str) -> Int ! {} {
    let k = kid(c, n, key)
    if k < 0 { return 0 }
    match json_int(c.doc, k) { Some(v) => v, None => 0 }
}

/// How many elements array node `n` has.
pub fn count(c: Cir, n: Int) -> Int ! {} {
    if n < 0 { 0 } else { json_len(c.doc, n) }
}

/// Element `i` of array node `n`.
pub fn at(c: Cir, n: Int, i: Int) -> Int ! {} {
    match json_at(c.doc, n, i) { Some(k) => k, None => 0 - 1 }
}

/// An integer node's value.
pub fn int_of(c: Cir, n: Int) -> Int ! {} {
    match json_int(c.doc, n) { Some(v) => v, None => 0 }
}

/// A string node's value.
pub fn str_of(c: Cir, n: Int) -> Str ! {} {
    match json_str(c.doc, n) { Some(s) => s, None => "" }
}

/// An expression's or statement's `op`.
pub fn op(c: Cir, e: Int) -> Str ! {} {
    sval(c, e, "op")
}

/// An expression's type, `never` for one that produces no value.
pub fn ety(c: Cir, e: Int) -> Str ! {} {
    tval(c, e, "type")
}

/// The type `key` names in object `n`, as [`read_ty`] reads it.
pub fn tval(c: Cir, n: Int, key: Str) -> Str ! {} {
    read_ty(sval(c, n, key))
}

/// A string node that is a type, as [`read_ty`] reads it.
pub fn tof(c: Cir, n: Int) -> Str ! {} {
    read_ty(str_of(c, n))
}

/// Where the first byte `want` at bracket depth 0 is in `t` between `from` and `to`, or -1.
fn top_level(t: Str, from: Int, to: Int, want: Int) -> Int {
    let mut depth = 0
    let mut i = from
    while i < to {
        let b = str_byte(t, i)
        if depth == 0 && b == want { return i }
        if b == 91 || b == 40 || b == 123 { depth += 1 }
        if b == 93 || b == 41 || b == 125 { depth -= 1 }
        i += 1
    }
    0 - 1
}

/// A type as `nazm.core-ir/3` spells it, read the way this stage has read types since `/2`: a
/// function type (`fn(Int) -> Str`) as `?`, which `/2` printed and MIR still prints, and an array
/// (`[Int; 4]`) as `?array[Int, 4]`, the spelling `refine.nz` recovers one under from `/2`. Every
/// other spelling is itself, its arguments read the same way; a `/2` spelling reads as itself.
pub fn read_ty(t: Str) -> Str ! {} {
    let n = str_len(t)
    if n < 3 || str_byte(t, 0) == 63 { return t }
    if str_slice(t, 0, 3) == "fn(" { return "?" }
    if str_byte(t, n - 1) != 93 { return t }
    if str_byte(t, 0) == 91 {
        let semi = top_level(t, 1, n - 1, 59)
        if semi < 0 { return t }
        return "?array[" + read_ty(str_slice(t, 1, semi)) + ", " + str_slice(t, semi + 2, n - 1) + "]"
    }
    let b = top_level(t, 0, n, 91)
    if b < 0 { return t }
    let mut out = str_slice(t, 0, b + 1)
    let mut start = b + 1
    let mut first = true
    while start < n - 1 {
        let comma = top_level(t, start, n - 1, 44)
        let end = if comma < 0 { n - 1 } else { comma }
        if !first { out = out + ", " }
        out = out + read_ty(str_slice(t, start, end))
        first = false
        start = if comma < 0 { n - 1 } else { comma + 2 }
    }
    out + "]"
}

// --- reading ------------------------------------------------------------------------------------

/// A string literal's bytes. Core IR writes valid UTF-8 as itself unless it contains `\x`, and
/// anything else as `\xNN` for every byte.
fn literal_bytes(s: Str) -> Str {
    let mut has = false
    let mut i = 0
    while i + 1 < str_len(s) {
        if str_byte(s, i) == 92 && str_byte(s, i + 1) == 120 { has = true }
        i += 1
    }
    if !has { return s }
    let out = bytes_new(str_len(s) / 4)
    let mut j = 0
    while j * 4 + 3 < str_len(s) {
        let hi = hex(str_byte(s, j * 4 + 2))
        let lo = hex(str_byte(s, j * 4 + 3))
        bytes_set(out, j, UInt8(hi * 16 + lo))
        j += 1
    }
    bytes_to_str(out)
}

fn hex(b: Int) -> Int {
    if b >= 48 && b <= 57 { b - 48 } else if b >= 97 && b <= 102 { b - 87 } else { b - 55 }
}

fn read_fn(c: Cir, n: Int) -> CirFn {
    let locals: Vec[CirLocal] = vec_new()
    let ls = kid(c, n, "locals")
    for i in 0..count(c, ls) {
        let l = at(c, ls, i)
        vec_push(locals, CirLocal(name: sval(c, l, "name"), ty: tval(c, l, "type"), origin: sval(c, l, "origin")))
    }
    let consts: Vec[CirConst] = vec_new()
    let cs = kid(c, n, "consts")
    for i in 0..count(c, cs) {
        let k = at(c, cs, i)
        let ty = sval(c, k, "type")
        let v = kid(c, k, "value")
        let kind = json_kind(c.doc, v)
        let cst = if kind == "number" {
            CirConst(ty: ty, int: int_of(c, v), flag: false, text: "")
        } else if kind == "bool" {
            CirConst(ty: ty, int: 0, flag: match json_bool(c.doc, v) { Some(b) => b, None => false }, text: "")
        } else if ty == "Str" {
            CirConst(ty: ty, int: 0, flag: false, text: literal_bytes(str_of(c, v)))
        } else {
            CirConst(ty: ty, int: 0, flag: false, text: str_of(c, v))
        }
        vec_push(consts, cst)
    }
    let captures = ints_new()
    let cs2 = kid(c, n, "captures")
    for i in 0..count(c, cs2) { ints_push(captures, int_of(c, at(c, cs2, i))) }
    let published = strs_new()
    let pub_ = kid(c, kid(c, n, "effects"), "published")
    for i in 0..count(c, pub_) {
        strs_push(published, str_of(c, at(c, pub_, i)))
    }
    CirFn(
        def: sval(c, n, "def"),
        module: sval(c, n, "module"),
        name: sval(c, n, "name"),
        type_params: ival(c, n, "type_params"),
        params: ival(c, n, "params"),
        ret: tval(c, n, "ret"),
        published: published,
        locals: locals,
        consts: consts,
        body: kid(c, n, "body"),
        foreign: sval(c, n, "foreign"),
        node: n,
        captures: captures,
        export: sval(c, kid(c, n, "attributes"), "export"),
    )
}

/// Boolean `key` of object `n`, false when absent.
pub fn bval(c: Cir, n: Int, key: Str) -> Bool ! {} {
    let k = kid(c, n, key)
    if k < 0 { return false }
    match json_bool(c.doc, k) { Some(b) => b, None => false }
}

/// Read a Core IR document, or say why it is not one.
pub fn cir_read(text: Str) -> Result[Cir, Str] ! {} {
    let doc = match json_parse(text) {
        Ok(d) => d,
        Err(e) => { return Err("not JSON: " + e) },
    }
    let c0 = Cir(doc: doc, entry: "", fns: vec_new(), by_def: hashmap_new())
    let root = json_root(doc)
    let schema = sval(c0, root, "schema")
    if schema != "nazm.core-ir/3" {
        return Err("not nazm.core-ir/3 but `" + schema + "`")
    }
    let c = Cir(doc: doc, entry: sval(c0, root, "entry"), fns: vec_new(), by_def: hashmap_new())
    let fs = kid(c, root, "functions")
    for i in 0..count(c, fs) {
        let f = read_fn(c, at(c, fs, i))
        hashmap_set(c.by_def, f.def, vec_len(c.fns))
        vec_push(c.fns, f)
    }
    Ok(c)
}

/// The function a definition key names, as a position in `c.fns`, or -1.
pub fn fn_index(c: Cir, def: Str) -> Int ! {} {
    match hashmap_get(c.by_def, def) { Some(i) => i, None => 0 - 1 }
}
