// The runtime generator (R3, `rewrite-in-nazm` task 4.1): the hosted runtime's LLVM units for a
// program — what `crates/nazm-runtime` emits and `nazm build` links beside the program's own
// units: the runtime itself, the platform entry, and the per-target units (the task switch, the
// task stacks and stack budget, `errno`'s location, the files part's system facts, Windows'
// start-up) and the counted heap. The texts are the runtime crate's (`rtext.nz`, generated by
// `tests/runtime_text.py`); the rules that choose and join them are these, as the crate's
// (`core.rs`, `entry.rs`, `switch.rs`, `platform.rs`, `heap.rs`, `lib.rs`).

use "rtext.nz"
use "@std/hash"
use "@std/hashmap"
use "@std/text"

/// Which runtime parts a program reaches (`Needs`): each service by its stable name, and
/// `single`, a program of one thread.
pub struct Needs {
    tasks: Bool,
    channels: Bool,
    sequences: Bool,
    io: Bool,
    join: Bool,
    strings: Bool,
    shims: Bool,
    stack: Bool,
    closures: Bool,
    foreign: Bool,
    numbers: Bool,
    files: Bool,
    net: Bool,
    wide: Bool,
    single: Bool,
}

/// The needs named in `names` (`Needs::by_names`, `single` among them).
pub fn needs_of(names: HashMap[Str, Bool]) -> Needs ! {} {
    Needs(
        tasks: hashmap_has(names, "tasks"),
        channels: hashmap_has(names, "channels"),
        sequences: hashmap_has(names, "sequences"),
        io: hashmap_has(names, "io"),
        join: hashmap_has(names, "join"),
        strings: hashmap_has(names, "strings"),
        shims: hashmap_has(names, "shims"),
        stack: hashmap_has(names, "stack"),
        closures: hashmap_has(names, "closures"),
        foreign: hashmap_has(names, "foreign"),
        numbers: hashmap_has(names, "numbers"),
        files: hashmap_has(names, "files"),
        net: hashmap_has(names, "net"),
        wide: hashmap_has(names, "wide"),
        single: hashmap_has(names, "single"),
    )
}

/// What the parts imply about each other (`Needs::settled`).
pub fn settled(n: Needs) -> Needs ! {} {
    Needs(
        tasks: n.tasks || n.net,
        channels: n.channels,
        sequences: n.sequences || n.tasks || n.channels || n.net,
        io: n.io || n.files || n.net,
        join: n.join,
        strings: n.strings || n.join || n.io || n.files || n.net,
        shims: n.shims,
        stack: n.stack,
        closures: n.closures,
        foreign: n.foreign,
        numbers: n.numbers,
        files: n.files || n.net,
        net: n.net,
        wide: n.wide,
        single: n.single,
    )
}

/// `n` with `foreign` as given: the entry's needs (`calls_c`).
fn with_foreign(n: Needs, foreign: Bool) -> Needs {
    Needs(
        tasks: n.tasks, channels: n.channels, sequences: n.sequences, io: n.io, join: n.join,
        strings: n.strings, shims: n.shims, stack: n.stack, closures: n.closures,
        foreign: foreign, numbers: n.numbers, files: n.files, net: n.net, wide: n.wide,
        single: n.single,
    )
}

// --- text ---------------------------------------------------------------------------------------

fn hex_digit(d: Int) -> Str {
    str_slice("0123456789ABCDEF", d, d + 1)
}

/// LLVM's constant-string escaping (`escape`): `\XX` for a quote, a backslash or anything not
/// printable ASCII.
fn escape(s: Str) -> Str {
    let out = strs_new()
    let mut start = 0
    for i in 0..str_len(s) {
        let b = str_byte(s, i)
        if b == 34 || b == 92 || b < 32 || b >= 127 {
            strs_push(out, str_slice(s, start, i))
            strs_push(out, "\\" + hex_digit(b / 16) + hex_digit(b % 16))
            start = i + 1
        }
    }
    strs_push(out, str_slice(s, start, str_len(s)))
    str_join(out, "")
}

/// `s` with its first `from` replaced by `to` (`replacen(.., 1)`).
fn replace_first(s: Str, from: Str, to: Str) -> Str {
    match text_find(s, from) {
        Some(i) => str_slice(s, 0, i) + to + str_slice(s, i + str_len(from), str_len(s)),
        None => s,
    }
}

/// A Rust format string's named holes filled (`{name}` from `keys`/`vals`), `{{` and `}}` one
/// brace each.
fn fill(template: Str, keys: Strs, vals: Strs) -> Str {
    let out = strs_new()
    let n = str_len(template)
    let mut start = 0
    let mut i = 0
    while i < n {
        let b = str_byte(template, i)
        if (b == 123 || b == 125) && i + 1 < n && str_byte(template, i + 1) == b {
            strs_push(out, str_slice(template, start, i + 1))
            i += 2
            start = i
        } else if b == 123 {
            strs_push(out, str_slice(template, start, i))
            let mut j = i + 1
            while str_byte(template, j) != 125 { j += 1 }
            let name = str_slice(template, i + 1, j)
            for k in 0..strs_len(keys) {
                if strs_get(keys, k) == name { strs_push(out, strs_get(vals, k)) }
            }
            i = j + 1
            start = i
        } else {
            i += 1
        }
    }
    strs_push(out, str_slice(template, start, n))
    str_join(out, "")
}

/// The header every generated artefact carries (`preamble`).
fn preamble(source: Str) -> Str {
    "; Generated by nazm build. Do not edit.\n; " + rt_target_note() + "\nsource_filename = \"" + source + "\"\n\n"
}

/// The runtime's own surface as a unit that does not define it sees it
/// (`runtime_declarations`): its globals, plain in a program of one thread, and its declared
/// functions.
fn runtime_declarations(single: Bool) -> Str {
    let plain = text_lines(rt_single_thread_state())
    let out = strs_new()
    for d in text_lines(rt_globals()) {
        let mut line = d
        if single {
            for g in plain {
                if text_starts_with(d, "@" + g + " = ") { line = replace_first(d, " thread_local ", " ") }
            }
        }
        strs_push(out, line + "\n")
    }
    strs_push(out, rt_inventory_declarations())
    str_join(out, "")
}

// --- the runtime --------------------------------------------------------------------------------

/// The thread model's texts joined to the pool (`pool_hooked`).
fn pool_hooked(text: Str) -> Str {
    let out = strs_new()
    let wake = " = call i32 @pthread_cond_broadcast("
    for line in text_lines(text) {
        let trimmed = text_trim_start(line)
        match text_find(trimmed, wake) {
            Some(i) => {
                strs_push(out, "  call void @nz.cwake(")
                strs_push(out, str_slice(trimmed, i + str_len(wake), str_len(trimmed)))
            },
            None => {
                if text_contains(line, "call i32 @pthread_cond_wait(") {
                    strs_push(out, text_replace(line, "@pthread_cond_wait(", "@nz.cwait("))
                } else if text_contains(line, "call i32 @pthread_cond_timedwait(") {
                    strs_push(out, text_replace(line, "@pthread_cond_timedwait(", "@nz.ctimedwait("))
                } else if line == "  %rc = call i32 @pthread_join(ptr %tid, ptr null)" {
                    strs_push(out, "  %rc = call i32 @nz.join_one(ptr %tid)")
                } else if line == "  %ai = call i32 @pthread_attr_init(ptr %attr)" {
                    strs_push(out, rt_core_POOL_SPAWN())
                    strs_push(out, line)
                } else if line == "  ret i64 -2" {
                    strs_push(out, rt_core_POOL_YIELD())
                    strs_push(out, line)
                } else {
                    strs_push(out, line)
                }
            },
        }
        strs_push(out, "\n")
    }
    str_join(out, "")
}

/// One count's atomic step as three plain instructions (`plain_count`), or `None` for any other
/// line: `  %r = atomicrmw add|sub ptr P, i64 1 monotonic|release`.
fn plain_count(line: Str) -> Option[Str] {
    if !text_starts_with(line, "  %") { return None }
    let rest = str_slice(line, 3, str_len(line))
    let i = match text_find(rest, " = atomicrmw ") { Some(i) => i, None => { return None } }
    let result = str_slice(rest, 0, i)
    let tail = str_slice(rest, i + 13, str_len(rest))
    let j = match text_find(tail, " ptr ") { Some(j) => j, None => { return None } }
    let op = str_slice(tail, 0, j)
    let step = str_slice(tail, j + 5, str_len(tail))
    let k = match text_find(step, ", i64 1 ") { Some(k) => k, None => { return None } }
    let at = str_slice(step, 0, k)
    let order = str_slice(step, k + 8, str_len(step))
    if !(op == "add" || op == "sub") || !(order == "monotonic" || order == "release") { return None }
    Some("  %" + result + " = load i64, ptr " + at + "\n  %" + result + ".plain = " + op + " i64 %" + result + ", 1\n  store i64 %" + result + ".plain, ptr " + at)
}

/// `text` with the counts of `PLAIN_IN_ONE_THREAD`'s functions made plain, for a program of one
/// thread (`plain_reference_counts`): inside those functions only, from the `define` line to its
/// closing `}`, each atomic count becomes a load, the same step and a store (`plain_count`), and
/// `  fence acquire` goes; every other line is kept byte for byte.
fn plain_reference_counts(text: Str) -> Str {
    let names = text_lines(rt_plain_in_one_thread())
    let out = strs_new()
    let mut inside = false
    for line in text_split(text, "\n") {
        if text_starts_with(line, "define ") {
            inside = false
            for n in names {
                if text_contains(line, " @" + n + "(") { inside = true }
            }
        } else if line == "}" {
            inside = false
        }
        if inside && line == "  fence acquire" {
            // dropped, with its line break
        } else if inside {
            match plain_count(line) {
                Some(p) => strs_push(out, p),
                None => strs_push(out, line),
            }
        } else {
            strs_push(out, line)
        }
    }
    str_join(out, "\n")
}

/// The program's runtime, defined once for the whole executable (`emit_runtime`).
pub fn emit_runtime(needs: Needs) -> Str ! {} {
    let n = settled(needs)
    let out = strs_new()
    strs_push(out, preamble("<nazm runtime>"))
    strs_push(out, rt_os_declarations())
    strs_push(out, "\n")
    if n.io {
        strs_push(out, "@nz.argc = hidden global i64 0\n")
        strs_push(out, "@nz.argv = hidden global ptr null\n")
        strs_push(out, "@.rb = private unnamed_addr constant [3 x i8] c\"rb\\00\"\n")
        strs_push(out, "@.wb = private unnamed_addr constant [3 x i8] c\"wb\\00\"\n")
    }
    let tls = if n.single { "" } else { "thread_local " }
    strs_push(out, "@nz.failed = hidden " + tls + "global i1 false\n")
    strs_push(out, "@nz.errmsg = hidden " + tls + "global ptr null\n")
    strs_push(out, "@nz.errlen = hidden " + tls + "global i64 0\n")
    strs_push(out, "@nz.stack_bytes = hidden global i64 0\n")
    if n.stack { strs_push(out, "@nz.stack_limit = hidden " + tls + "global i64 0\n") }
    strs_push(out, "\n")
    for c in text_split("seq_allocated seq_reclaimed str_allocated str_reclaimed chan_allocated chan_reclaimed clo_allocated clo_reclaimed sched_spawned sched_joined sched_selects sched_timeouts", " ") {
        strs_push(out, "@nz." + c + " = hidden global i64 0\n")
    }
    strs_push(out, "\n")
    strs_push(out, "define hidden void @nz.fail(ptr %m, i64 %n) {\nentry:\n  %had = load i1, ptr @nz.failed\n  br i1 %had, label %done, label %record\nrecord:\n  store i1 true, ptr @nz.failed\n  store ptr %m, ptr @nz.errmsg\n  store i64 %n, ptr @nz.errlen\n  br label %done\ndone:\n  ret void\n}\n")
    strs_push(out, "\n")
    strs_push(out, "define hidden void @nz.report() noreturn {\nentry:\n  %m = load ptr, ptr @nz.errmsg\n  %n = load i64, ptr @nz.errlen\n  %w = call i64 @write(i32 2, ptr %m, i64 %n)\n  call void @exit(i32 2)\n  unreachable\n}\n")
    if n.stack { strs_push(out, rt_core_STACK_RUNTIME()) }
    strs_push(out, rt_board_MMIO_RUNTIME())
    strs_push(out, rt_board_ATOMIC_RUNTIME())
    if n.sequences {
        strs_push(out, rt_core_SEQUENCE_RUNTIME())
        strs_push(out, rt_core_SUM_RUNTIME())
        strs_push(out, rt_core_SOA_RUNTIME())
    }
    if n.strings { strs_push(out, rt_core_STRING_RUNTIME()) }
    if n.io { strs_push(out, rt_core_IO_RUNTIME()) }
    if n.join { strs_push(out, rt_core_JOIN_RUNTIME()) }
    let pooled = n.tasks || n.channels
    if pooled {
        let restore = if n.stack { "  %slp = getelementptr i8, ptr %t, i64 104\n  %sl = load i64, ptr %slp\n  store i64 %sl, ptr @nz.stack_limit" } else { "" }
        let save = if n.stack { "  %sl = load i64, ptr @nz.stack_limit\n  %slp = getelementptr i8, ptr %t, i64 104\n  store i64 %sl, ptr %slp\n  store i64 0, ptr @nz.stack_limit" } else { "" }
        let set = if n.stack { "  %quarter = lshr i64 %size, 2\n  %lo = getelementptr i8, ptr %base, i64 %pg\n  %loi = ptrtoint ptr %lo to i64\n  %lim = add i64 %loi, %quarter\n  %limp = getelementptr i8, ptr %t, i64 104\n  store i64 %lim, ptr %limp" } else { "" }
        let pool = text_replace(text_replace(text_replace(rt_core_POOL_RUNTIME(), "{RESTORE_LIMIT}", restore), "{SAVE_LIMIT}", save), "{SET_LIMIT}", set)
        strs_push(out, pool)
    }
    if n.tasks {
        strs_push(out, if pooled { pool_hooked(rt_core_TASK_RUNTIME()) } else { rt_core_TASK_RUNTIME() })
        strs_push(out, rt_core_SCHED_RUNTIME())
    }
    if n.channels {
        strs_push(out, pool_hooked(rt_core_CHANNEL_RUNTIME()))
        strs_push(out, pool_hooked(rt_core_GENERIC_CHANNEL_RUNTIME()))
        strs_push(out, pool_hooked(rt_core_SELECT_RUNTIME()))
    }
    if n.strings {
        strs_push(out, rt_core_FOREIGN_STRING_RUNTIME())
        strs_push(out, rt_core_TEXT_RUNTIME())
    }
    if n.foreign || n.files { strs_push(out, "\ndeclare ptr @nz_errno_location()\n") }
    if n.foreign { strs_push(out, rt_core_ERRNO_RUNTIME()) }
    if n.tasks { strs_push(out, rt_core_SLEEP_RUNTIME()) }
    if n.files {
        strs_push(out, rt_files_FILES_RUNTIME())
        strs_push(out, rt_files_FS_RUNTIME())
        if n.net {
            strs_push(out, rt_net_NET_RUNTIME())
            strs_push(out, rt_net_PROCESS_RUNTIME())
        } else {
            strs_push(out, rt_files_NET_STUBS())
        }
    }
    if n.numbers { strs_push(out, rt_core_NUMBER_RUNTIME()) }
    if n.wide { strs_push(out, rt_core_WIDE_RUNTIME()) }
    if n.closures { strs_push(out, rt_core_CLOSURE_RUNTIME()) }
    if n.shims {
        strs_push(out, rt_core_SHIM_RUNTIME())
        if n.sequences { strs_push(out, rt_core_SHIM_SEQUENCE_RUNTIME()) }
        if n.io { strs_push(out, rt_core_SHIM_IO_RUNTIME()) }
        if n.join { strs_push(out, rt_core_SHIM_JOIN_RUNTIME()) }
        if n.tasks { strs_push(out, rt_core_SHIM_TASK_RUNTIME()) }
    }
    strs_push(out, "\n")
    // A program of one thread: its strings', closures' and channels' counts are plain.
    if n.single { plain_reference_counts(str_join(out, "")) } else { str_join(out, "") }
}

// --- the platform entry -------------------------------------------------------------------------

/// The scheduler a program runs when the environment does not say (`policy`): 1, a thread per
/// task, for a program that calls C; else 2, the pool.
fn policy(n: Needs) -> Int {
    if n.foreign { 1 } else { 2 }
}

fn constant(name: Str, len: Int, text: Str, tail: Str) -> Str {
    "@" + name + " = private unnamed_addr constant [" + int_to_str(len) + " x i8] c\"" + escape(text) + tail + "\"\n"
}

/// The process's `main` (`emit_entry_for`): stores the arguments, calls the program's `main`
/// with a word per capability, reports, and ends the process. `args` is the platform's argument
/// hook (`""` for none); `stack` the bytes `--stack-size` asked for (`-1` for none).
pub fn emit_entry(entry: Str, roots: Int, needs: Needs, args: Str, stack: Int) -> Str ! {} {
    let n = settled(needs)
    let out = strs_new()
    strs_push(out, preamble("<nazm entry>"))
    strs_push(out, rt_os_declarations())
    strs_push(out, runtime_declarations(n.single))
    let tys = strs_new()
    let zeros = strs_new()
    for _ in 0..roots {
        strs_push(tys, "i64")
        strs_push(zeros, "i64 0")
    }
    let root_types = str_join(tys, ", ")
    let root_args = str_join(zeros, ", ")
    strs_push(out, "declare i64 " + entry + "(" + root_types + ")\n")
    strs_push(out, "\n")
    strs_push(out, "@.fmt = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"\n")
    strs_push(out, constant(".memvar", str_len(rt_core_MEMORY_VARIABLE()) + 1, rt_core_MEMORY_VARIABLE(), "\\00"))
    strs_push(out, constant(".memfmt", str_len(rt_core_MEMORY_FORMAT()) + 2, rt_core_MEMORY_FORMAT(), "\\0A\\00"))
    strs_push(out, "@.membuf = private global [512 x i8] zeroinitializer\n")
    strs_push(out, constant(".resultvar", str_len(rt_core_RESULT_VARIABLE()) + 1, rt_core_RESULT_VARIABLE(), "\\00"))
    strs_push(out, constant(".resultmsg", str_len(rt_core_RESULT_STATUS()) + 1, rt_core_RESULT_STATUS(), "\\0A"))
    strs_push(out, constant(".schedvar", str_len(rt_core_SCHED_VARIABLE()) + 1, rt_core_SCHED_VARIABLE(), "\\00"))
    strs_push(out, constant(".schedfmt", str_len(rt_core_SCHED_FORMAT()) + 2, rt_core_SCHED_FORMAT(), "\\0A\\00"))
    strs_push(out, "\n")
    let pooled = n.tasks || n.channels
    if pooled { strs_push(out, "declare void @nz.pool_report()\n") }
    let hooked = n.io && args != ""
    if hooked { strs_push(out, "declare void " + args + "(i32, ptr, ptr, ptr)\n") }
    if stack >= 0 {
        strs_push(out, "@nz.main_result = internal global i64 0\n@nz.main_failed = internal global i1 false\n@nz.main_errmsg = internal global ptr null\n@nz.main_errlen = internal global i64 0\n")
        strs_push(out, "define internal ptr @nz.main_thread(ptr %unused) {\nentry:\n")
        strs_push(out, "  %r = call i64 " + entry + "(" + root_args + ")\n")
        strs_push(out, "  store i64 %r, ptr @nz.main_result\n  %tf = load i1, ptr @nz.failed\n  store i1 %tf, ptr @nz.main_failed\n  %tm = load ptr, ptr @nz.errmsg\n  store ptr %tm, ptr @nz.main_errmsg\n  %tl = load i64, ptr @nz.errlen\n  store i64 %tl, ptr @nz.main_errlen\n  ret ptr null\n}\n")
        strs_push(out, "\n")
    }
    strs_push(out, "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n")
    if pooled && policy(n) == 1 { strs_push(out, "  store i64 1, ptr @nz.pool_policy\n") }
    if hooked {
        strs_push(out, "  call void " + args + "(i32 %argc, ptr %argv, ptr @nz.argc, ptr @nz.argv)\n")
    } else if n.io {
        strs_push(out, "  %argc64 = sext i32 %argc to i64\n  %nargs = sub i64 %argc64, 1\n  store i64 %nargs, ptr @nz.argc\n  store ptr %argv, ptr @nz.argv\n")
    }
    if stack < 0 {
        strs_push(out, "  %result = call i64 " + entry + "(" + root_args + ")\n")
    } else {
        let bytes = int_to_str(stack)
        strs_push(out, "  store i64 " + bytes + ", ptr @nz.stack_bytes\n  %mattr = alloca [128 x i8], align 16\n  %mtid = alloca ptr, align 8\n  %mai = call i32 @pthread_attr_init(ptr %mattr)\n")
        strs_push(out, "  %mas = call i32 @pthread_attr_setstacksize(ptr %mattr, i64 " + bytes + ")\n")
        strs_push(out, "  %mrc = call i32 @pthread_create(ptr %mtid, ptr %mattr, ptr @nz.main_thread, ptr null)\n  %mad = call i32 @pthread_attr_destroy(ptr %mattr)\n  %mbad = icmp ne i32 %mrc, 0\n  br i1 %mbad, label %nz.inline, label %nz.join\nnz.inline:\n")
        strs_push(out, "  %minline = call i64 " + entry + "(" + root_args + ")\n")
        strs_push(out, "  store i64 %minline, ptr @nz.main_result\n  br label %nz.ran\nnz.join:\n  %mt = load ptr, ptr %mtid\n  %mjn = call i32 @pthread_join(ptr %mt, ptr null)\n  %jf = load i1, ptr @nz.main_failed\n  store i1 %jf, ptr @nz.failed\n  %jm = load ptr, ptr @nz.main_errmsg\n  store ptr %jm, ptr @nz.errmsg\n  %jl = load i64, ptr @nz.main_errlen\n  store i64 %jl, ptr @nz.errlen\n  br label %nz.ran\nnz.ran:\n  %result = load i64, ptr @nz.main_result\n")
    }
    strs_push(out, "  %want = call ptr @getenv(ptr @.memvar)\n  %quiet = icmp eq ptr %want, null\n  br i1 %quiet, label %nz.checked, label %nz.memreport\nnz.memreport:\n")
    let fields = strs_new()
    for kind in text_split("seq str chan clo", " ") {
        strs_push(out, "  %" + kind + "a = load i64, ptr @nz." + kind + "_allocated\n")
        strs_push(out, "  %" + kind + "r = load i64, ptr @nz." + kind + "_reclaimed\n")
        strs_push(out, "  %" + kind + "l = sub i64 %" + kind + "a, %" + kind + "r\n")
        strs_push(fields, "i64 %" + kind + "a, i64 %" + kind + "r, i64 %" + kind + "l")
    }
    strs_push(out, "  %memout = call i32 (ptr, i64, ptr, ...) @snprintf(ptr @.membuf, i64 512, ptr @.memfmt, " + str_join(fields, ", ") + ")\n")
    strs_push(out, "  %memlen = sext i32 %memout to i64\n  %memwrote = call i64 @write(i32 2, ptr @.membuf, i64 %memlen)\n  br label %nz.checked\nnz.checked:\n  %swant = call ptr @getenv(ptr @.schedvar)\n  %squiet = icmp eq ptr %swant, null\n  br i1 %squiet, label %nz.scheduled, label %nz.schedreport\nnz.schedreport:\n")
    let counts = strs_new()
    for c in text_split("spawned joined selects timeouts", " ") {
        strs_push(out, "  %sch" + c + " = load i64, ptr @nz.sched_" + c + "\n")
        strs_push(counts, "i64 %sch" + c)
    }
    strs_push(out, "  %schout = call i32 (ptr, i64, ptr, ...) @snprintf(ptr @.membuf, i64 512, ptr @.schedfmt, " + str_join(counts, ", ") + ")\n")
    strs_push(out, "  %schlen = sext i32 %schout to i64\n  %schwrote = call i64 @write(i32 2, ptr @.membuf, i64 %schlen)\n")
    if pooled { strs_push(out, "  call void @nz.pool_report()\n") }
    strs_push(out, "  br label %nz.scheduled\nnz.scheduled:\n")
    strs_push(out, "  %failed = load i1, ptr @nz.failed\n  br i1 %failed, label %nz.reported, label %nz.finished\nnz.reported:\n  call void @nz.report()\n  unreachable\nnz.finished:\n  %rwant = call ptr @getenv(ptr @.resultvar)\n  %rquiet = icmp eq ptr %rwant, null\n  br i1 %rquiet, label %nz.status, label %nz.printresult\nnz.printresult:\n  %print = call i32 (ptr, ...) @printf(ptr @.fmt, i64 %result)\n  ret i32 0\nnz.status:\n  %rinside = icmp ule i64 %result, 255\n  br i1 %rinside, label %nz.exitstatus, label %nz.badstatus\nnz.exitstatus:\n  %rcode = trunc i64 %result to i32\n  ret i32 %rcode\nnz.badstatus:\n")
    strs_push(out, "  %rwrote = call i64 @write(i32 2, ptr @.resultmsg, i64 " + int_to_str(str_len(rt_core_RESULT_STATUS()) + 1) + ")\n")
    strs_push(out, "  ret i32 2\n}\n")
    str_join(out, "")
}

// --- the per-target units -----------------------------------------------------------------------

/// The hosted target a triple names (`switch_target`), or `""` for one with no task switch:
/// `aarch64-darwin`, `aarch64-linux`, `x86_64-darwin`, `x86_64-linux`, `x86_64-windows`,
/// `aarch64-android`.
pub fn switch_target(triple: Str) -> Str ! {} {
    let arch = if text_starts_with(triple, "aarch64-") || text_starts_with(triple, "arm64-") { "aarch64" } else if text_starts_with(triple, "x86_64-") { "x86_64" } else { "" }
    if arch == "" { return "" }
    if text_contains(triple, "-android") { return if arch == "aarch64" { "aarch64-android" } else { "" } }
    if text_contains(triple, "-ios") { return if arch == "aarch64" { "aarch64-darwin" } else { "" } }
    if text_contains(triple, "-darwin") || text_contains(triple, "-macos") { return arch + "-darwin" }
    if text_contains(triple, "-linux") { return arch + "-linux" }
    if text_contains(triple, "-windows") { return if arch == "x86_64" { "x86_64-windows" } else { "" } }
    ""
}

fn darwin(t: Str) -> Bool {
    t == "aarch64-darwin" || t == "x86_64-darwin"
}

fn module_asm(source: Str, asm: Str) -> Str {
    let out = strs_new()
    strs_push(out, preamble(source))
    for line in text_lines(asm) { strs_push(out, "module asm \"" + escape(line) + "\"\n") }
    str_join(out, "")
}

/// The task pool's context switch for `t` (`emit_switch`): module-level assembly.
pub fn emit_switch(t: Str) -> Str ! {} {
    if t == "x86_64-windows" { return module_asm("<nazm task switch>", rt_switch_X86_64_WINDOWS()) }
    let a64 = t == "aarch64-darwin" || t == "aarch64-linux" || t == "aarch64-android"
    let body = if a64 { rt_switch_AARCH64() } else { rt_switch_X86_64() }
    let d = darwin(t)
    let kind = if a64 { "%function" } else { "@function" }
    let ty_switch = if d { "" } else { ".type nz_ctx_switch," + kind }
    let ty_prepare = if d { "" } else { ".type nz_ctx_prepare," + kind }
    let mut asm = text_replace(body, "{GLOBAL}", ".globl")
    asm = text_replace(asm, "{HIDDEN}", if d { ".private_extern" } else { ".hidden" })
    asm = text_replace(asm, "{TYPE_SWITCH}", ty_switch)
    asm = text_replace(asm, "{TYPE_PREPARE}", ty_prepare)
    asm = text_replace(asm, "{L}", if d { "L" } else { ".L" })
    asm = text_replace(asm, "{P}", if d { "_" } else { "" })
    module_asm("<nazm task switch>", asm)
}

/// Where `errno` is on `t` (`emit_errno`).
pub fn emit_errno(t: Str) -> Str ! {} {
    if t == "x86_64-windows" { return rt_switch_WINDOWS_ERRNO() }
    let location = if darwin(t) { "__error" } else if t == "aarch64-android" { "__errno" } else { "__errno_location" }
    "; Generated by nazm build. Do not edit.\nsource_filename = \"errno\"\n\ndeclare ptr @" + location + "()\n\ndefine hidden ptr @nz_errno_location() {\nentry:\n  %p = call ptr @" + location + "()\n  ret ptr %p\n}\n"
}

/// The platform function the entry hands `argc` and `argv` to (`args_hook`), or `""`.
pub fn args_hook(t: Str) -> Str ! {} {
    if t == "x86_64-windows" { "@nz_os_args" } else { "" }
}

/// What `t` does before `main` (`emit_init`), or `""` for nothing.
pub fn emit_init(t: Str) -> Str ! {} {
    if t == "x86_64-windows" { rt_platform_WINDOWS_INIT() } else { "" }
}

/// The task stacks, the stack budget and the clocks for `t` (`emit_stack`).
pub fn emit_stack(t: Str) -> Str ! {} {
    let head = "; Generated by nazm build. Do not edit.\nsource_filename = \"stack\"\n\n"
    if t == "x86_64-windows" { return head + rt_platform_WINDOWS_STACK() }
    let size = if darwin(t) { rt_platform_DARWIN_STACK_SIZE() } else { rt_platform_LINUX_STACK_SIZE() }
    // `_SC_NPROCESSORS_ONLN` is the system's own number: 58 on Darwin, 84 in glibc and musl, 0x61
    // in Android's Bionic (runtime ABI 35).
    let name = if darwin(t) { "58" } else if t == "aarch64-android" { "97" } else { "84" }
    head + rt_platform_POSIX_STACK() + size + posix_cpus(name)
}

/// `nz.os_cpus` on a POSIX target (`posix_cpus`): the processors online by `sysconf`, 0 when the
/// system will not say — the pool's default worker count.
fn posix_cpus(name: Str) -> Str ! {} {
    "\ndeclare i64 @sysconf(i32)\n\n; The processors online, for the pool's default worker count; 0 when the system will not say.\ndefine hidden i64 @nz.os_cpus() {\nentry:\n  %n = call i64 @sysconf(i32 " + name + ")\n  %some = icmp sgt i64 %n, 0\n  %w = select i1 %some, i64 %n, i64 0\n  ret i64 %w\n}\n"
}

/// A target's C facts (`facts`): the `open` bits, `struct stat`'s and `struct dirent`'s
/// offsets, and the 64-bit-inode and `strerror_r` symbols.
struct Facts {
    linux: Bool,
    wronly: Int,
    rdwr: Int,
    append: Int,
    creat: Int,
    trunc: Int,
    excl: Int,
    cloexec: Int,
    stat_size: Int,
    mode_at: Int,
    mode_bits: Int,
    size_at: Int,
    mtime_at: Int,
    name_at: Int,
    stat: Str,
    lstat: Str,
    opendir: Str,
    readdir: Str,
    strerror_r: Str,
}

fn facts(t: Str) -> Facts {
    if darwin(t) {
        let x86 = t == "x86_64-darwin"
        return Facts(
            linux: false, wronly: 1, rdwr: 2, append: 8, creat: 512, trunc: 1024, excl: 2048,
            cloexec: 16777216, stat_size: 144, mode_at: 4, mode_bits: 16, size_at: 96,
            mtime_at: 48, name_at: 21,
            stat: if x86 { "\"stat$INODE64\"" } else { "stat" },
            lstat: if x86 { "\"lstat$INODE64\"" } else { "lstat" },
            opendir: if x86 { "\"opendir$INODE64\"" } else { "opendir" },
            readdir: if x86 { "\"readdir$INODE64\"" } else { "readdir" },
            strerror_r: "strerror_r",
        )
    }
    // Linux's (x86-64's layout); AArch64 and Android the generic layout; Android's XSI
    // `strerror_r` under its own name. Windows never reads them.
    let generic = t == "aarch64-linux" || t == "aarch64-android"
    Facts(
        linux: true, wronly: 1, rdwr: 2, append: 1024, creat: 64, trunc: 512, excl: 128,
        cloexec: 524288, stat_size: if generic { 128 } else { 144 }, mode_at: if generic { 16 } else { 24 },
        mode_bits: 32, size_at: 48, mtime_at: 88, name_at: 19,
        stat: "stat", lstat: "lstat", opendir: "opendir", readdir: "readdir",
        strerror_r: if t == "aarch64-android" { "strerror_r" } else { "__xpg_strerror_r" },
    )
}

fn bits_or(a: Int, b: Int) -> Int {
    // The flags are distinct single bits, so `|` is a sum of those not already set.
    let mut out = a
    let mut bit = 1
    while bit <= b {
        if (b / bit) % 2 == 1 && (a / bit) % 2 == 0 { out += bit }
        bit = bit * 2
    }
    out
}

fn ors(xs: Ints) -> Int {
    let mut out = 0
    for i in 0..ints_len(xs) { out = bits_or(out, ints_get(xs, i)) }
    out
}

fn ints4(a: Int, b: Int, c: Int, d: Int) -> Ints {
    let xs = ints_new()
    ints_push(xs, a)
    ints_push(xs, b)
    ints_push(xs, c)
    ints_push(xs, d)
    xs
}

/// The network part of `t`'s `os` unit (`net_part`).
fn net_part(t: Str) -> Str {
    let d = darwin(t)
    let windows = t == "x86_64-windows"
    let get_family = if d { "  %fp = getelementptr i8, ptr %sa, i64 1\n  %fb = load i8, ptr %fp\n  %fam = zext i8 %fb to i32" } else { "  %fh = load i16, ptr %sa\n  %fam = zext i16 %fh to i32" }
    let set4 = if d { "  store i8 16, ptr %out\n  %f4 = getelementptr i8, ptr %out, i64 1\n  store i8 2, ptr %f4" } else { "  store i16 2, ptr %out" }
    let set6 = if d { "  store i8 28, ptr %out\n  %f6 = getelementptr i8, ptr %out, i64 1\n  store i8 30, ptr %f6" } else if windows { "  store i16 23, ptr %out" } else { "  store i16 10, ptr %out" }
    let af6 = if d { "30" } else if windows { "23" } else { "10" }
    let mut addr = text_replace(rt_platform_NET_ADDR(), "{SETFAM4}", set4)
    addr = text_replace(addr, "{SETFAM6}", set6)
    addr = text_replace(addr, "{GETFAM}", get_family)
    addr = text_replace(addr, "{AF6}", af6)
    addr = text_replace(addr, "{AIADDR}", if d || windows { "32" } else { "24" })
    if windows { return addr + rt_platform_WINDOWS_NET() }
    let nosigpipe = if d { "  %ns = call i32 @setsockopt(i32 %fd, i32 65535, i32 4130, ptr %one, i32 4)" } else { "" }
    let mut sock = text_replace(rt_platform_NET_SOCK(), "{GETFAM}", get_family)
    sock = text_replace(sock, "{NOSIGPIPE}", nosigpipe)
    sock = text_replace(sock, "{NONBLOCK}", if d { "4" } else { "2048" })
    sock = text_replace(sock, "{SOLSOCKET}", if d { "65535" } else { "1" })
    sock = text_replace(sock, "{REUSE}", if d { "4" } else { "2" })
    sock = text_replace(sock, "{SOERROR}", if d { "4103" } else { "4" })
    sock = text_replace(sock, "{SENDFLAGS}", if d { "0" } else { "16384" })
    sock = text_replace(sock, "{EAGAIN}", if d { "35" } else { "11" })
    sock = text_replace(sock, "{ETIMEDOUT}", if d { "60" } else { "110" })
    sock = text_replace(sock, "{EINPROGRESS}", if d { "36" } else { "115" })
    // epoll's event is packed on x86-64 (12 bytes, data at 4) and natural on aarch64.
    let x86l = t == "x86_64-linux"
    let poller = if d { rt_platform_KQUEUE() } else {
        text_replace(text_replace(rt_platform_EPOLL(), "{EPDATA}", if x86l { "4" } else { "8" }), "{EPSIZE}", if x86l { "12" } else { "16" })
    }
    let f = facts(t)
    let mut procs = text_replace(rt_platform_POSIX_PROC_CALLS(), "{RDONLY_CLOEXEC}", int_to_str(f.cloexec))
    procs = text_replace(procs, "{MODE_TY}", if f.mode_bits == 16 { "i16" } else { "i32" })
    procs = text_replace(procs, "{ENOSYS}", if d { "78" } else { "38" })
    procs = text_replace(procs, "{EAGAIN}", if d { "35" } else { "11" })
    procs = text_replace(procs, "{RSS_SCALE}", if d { "1" } else { "1024" })
    addr + sock + rt_platform_POSIX_NET_CALLS() + procs + poller
}

/// What `t`'s C library says about files and the network (`emit_os`).
pub fn emit_os(t: Str) -> Str ! {} {
    if t == "x86_64-windows" {
        return "; Generated by nazm build. Do not edit.\nsource_filename = \"os\"\n" + rt_platform_WINDOWS_FILES() + net_part(t) + rt_platform_WINDOWS_FS()
    }
    let f = facts(t)
    let mode_ty = if f.mode_bits == 16 { "i16" } else { "i32" }
    let keys = text_split("mode_ty stat opendir readdir strerror_r read m0 m1 m2 m3 stat_size size_at mode_at mtime_at mtime_nsec name_at family", " ")
    let vals = strs_new()
    strs_push(vals, mode_ty)
    strs_push(vals, f.stat)
    strs_push(vals, f.opendir)
    strs_push(vals, f.readdir)
    strs_push(vals, f.strerror_r)
    strs_push(vals, int_to_str(f.cloexec))
    strs_push(vals, int_to_str(ors(ints4(f.wronly, f.creat, f.trunc, f.cloexec))))
    strs_push(vals, int_to_str(ors(ints4(f.wronly, f.append, f.creat, f.cloexec))))
    strs_push(vals, int_to_str(ors(ints4(f.wronly, f.creat, f.excl, f.cloexec))))
    strs_push(vals, int_to_str(ors(ints4(f.rdwr, f.cloexec, 0, 0))))
    strs_push(vals, int_to_str(f.stat_size))
    strs_push(vals, int_to_str(f.size_at))
    strs_push(vals, int_to_str(f.mode_at))
    strs_push(vals, int_to_str(f.mtime_at))
    strs_push(vals, int_to_str(f.mtime_at + 8))
    strs_push(vals, int_to_str(f.name_at))
    strs_push(vals, if f.linux { "1" } else { "0" })
    let out = strs_new()
    strs_push(out, fill(rt_platform_OS_FORMAT(), keys, vals))
    strs_push(out, rt_platform_POSIX_FILE_CALLS())
    let dev = if f.linux { "  %dev = load i64, ptr %st" } else { "  %devn = load i32, ptr %st\n  %dev = zext i32 %devn to i64" }
    let mut fs = text_replace(rt_platform_POSIX_FS_CALLS(), "{LSTAT}", f.lstat)
    fs = text_replace(fs, "{MODE_TY}", mode_ty)
    fs = text_replace(fs, "{STAT_SIZE}", int_to_str(f.stat_size))
    fs = text_replace(fs, "{SIZE_AT}", int_to_str(f.size_at))
    fs = text_replace(fs, "{MODE_AT}", int_to_str(f.mode_at))
    fs = text_replace(fs, "{MTIME_AT}", int_to_str(f.mtime_at))
    fs = text_replace(fs, "{MTIME_NSEC}", int_to_str(f.mtime_at + 8))
    fs = text_replace(fs, "{DEV}", dev)
    strs_push(out, fs)
    strs_push(out, net_part(t))
    strs_push(out, if darwin(t) {
        "\ndeclare ptr @_NSGetEnviron()\n\ndefine hidden ptr @nz_os_environ() {\nentry:\n  %p = call ptr @_NSGetEnviron()\n  %e = load ptr, ptr %p\n  ret ptr %e\n}\n"
    } else {
        "\n@environ = external global ptr\n\ndefine hidden ptr @nz_os_environ() {\nentry:\n  %e = load ptr, ptr @environ\n  ret ptr %e\n}\n"
    })
    str_join(out, "")
}

// --- the counted heap ---------------------------------------------------------------------------

/// `text` with every call and declaration of C's `malloc`, `realloc` and `free` made the counted
/// heap's (`count_heap`), a line holding a constant string left as it is.
pub fn count_heap(text: Str) -> Str ! {} {
    let out = strs_new()
    let n = str_len(text)
    let mut start = 0
    while start < n {
        let mut end = start
        while end < n && str_byte(text, end) != 10 { end += 1 }
        if end < n { end += 1 }
        let line = str_slice(text, start, end)
        let counted = text_contains(line, "@malloc(") || text_contains(line, "@realloc(") || text_contains(line, "@free(")
        if text_contains(line, " c\"") || !counted {
            strs_push(out, line)
        } else {
            strs_push(out, text_replace(text_replace(text_replace(line, "@malloc(", "@nz.heap_malloc("), "@realloc(", "@nz.heap_realloc("), "@free(", "@nz.heap_free("))
        }
        start = end
    }
    str_join(out, "")
}

/// The counted heap's unit for a program of at most `limit` live heap bytes (`emit_heap`).
pub fn emit_heap(limit: Int) -> Str ! {} {
    let text = "nazm: error[N0406]: out of memory: the heap limit of " + int_to_str(limit) + " bytes is reached\n"
    let len = int_to_str(str_len(text))
    "; Generated by nazm build. Do not edit.\nsource_filename = \"heap\"\n\n"
        + "@nz.heap_limit = internal global i64 " + int_to_str(limit) + "\n"
        + "@nz.heap_live = internal global i64 0\n@nz.heap_over = internal global i32 0\n"
        + "@.nz.heap_message = private unnamed_addr constant [" + len + " x i8] c\"" + escape(text) + "\"\n"
        + text_replace(rt_heap_HEAP_RUNTIME(), "{LEN}", len) + "\n"
}

// --- a program's units --------------------------------------------------------------------------

/// The runtime's units for a hosted program, in the order `nazm build` links them, as
/// `NAME\tTEXT` pairs: `runtime`, then the target's `switch`, `init`, `stack`, `errno` and `os`
/// where they are reached, `heap` under a heap limit (every unit but the stack's counted), and
/// `entry`. `heap` is the limit in bytes, `stack` the stack size (`-1` for none of either).
pub fn runtime_units(needs: Needs, triple: Str, entry: Str, roots: Int, calls_c: Bool, stack: Int, heap: Int) -> Vec[Strs] ! {} {
    let names = strs_new()
    let texts = strs_new()
    let t = switch_target(triple)
    let n = settled(needs)
    strs_push(names, "runtime")
    strs_push(texts, emit_runtime(needs))
    if t != "" {
        if n.tasks || n.channels {
            strs_push(names, "switch")
            strs_push(texts, emit_switch(t))
        }
        let init = emit_init(t)
        if init != "" {
            strs_push(names, "init")
            strs_push(texts, init)
        }
        if n.stack || n.tasks || n.channels {
            strs_push(names, "stack")
            strs_push(texts, emit_stack(t))
        }
        if n.foreign || n.files {
            strs_push(names, "errno")
            strs_push(texts, emit_errno(t))
        }
        if n.files {
            strs_push(names, "os")
            strs_push(texts, emit_os(t))
        }
    }
    if heap >= 0 {
        for i in 0..strs_len(texts) {
            if strs_get(names, i) != "stack" { strs_set(texts, i, count_heap(strs_get(texts, i))) }
        }
        strs_push(names, "heap")
        strs_push(texts, emit_heap(heap))
    }
    let e = emit_entry(entry, roots, with_foreign(needs, calls_c), args_hook(t), stack)
    strs_push(names, "entry")
    strs_push(texts, if heap >= 0 { count_heap(e) } else { e })
    let out: Vec[Strs] = vec_new()
    vec_push(out, names)
    vec_push(out, texts)
    out
}
